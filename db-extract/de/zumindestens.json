                                "target_senses": [
                                    {
                                        "sense_id": "51c0334b-e936-35ca-96a1-4545bd726ceb",
                                        "entry_id": "345c9e86-626c-3f0b-8fe6-339f92565e68",
                                        "glosses": [
                                            "At a minimum or lower limit."
                                        ],
                                        "tags": [
                                            "focus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "261cd5c8-d591-47fb-ad53-2bc6caa8205c",
                                                "sense_id": "51c0334b-e936-35ca-96a1-4545bd726ceb",
                                                "text": "I couldn't count them all, but I think there must have been at least 500 people in attendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3470122-d787-372b-83fc-25361b57c09d",
                                        "entry_id": "345c9e86-626c-3f0b-8fe6-339f92565e68",
                                        "glosses": [
                                            "In any event; anyway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2877d2e1-2da4-42ec-a4f8-bb25e38f36b5",
                                                "sense_id": "d3470122-d787-372b-83fc-25361b57c09d",
                                                "text": "You could even be discovered, become a movie star, or at least see one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ec6084f-82fb-45d0-99c4-2d1346c4f8f9",
                        "source_entry_id": "36a7e924-32da-3aff-9f84-567441683f47",
                        "source_sense_id": "a05d909b-d7b9-3c3e-a90a-641fdfdc1330",
                        "source_sense_description": "umgangssprachlich: wenigstens, mindestens",
                        "target_lang_word": "au moins",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au moins",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "406aa570-a482-349c-a548-377b400ae1df",
                                        "entry_id": "55c2e569-3893-330c-98a5-98c810c8c9eb",
                                        "glosses": [
                                            "Au minimum ; selon la plus petite estimation que l’on peut fournir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9ad4c5c-a6ab-4900-8bb1-7ae53b74191f",
                                                "sense_id": "406aa570-a482-349c-a548-377b400ae1df",
                                                "text": "Si les pièces qu'on y insère n'ont pas toutes le même mérite, au moins est-on sûr de n'y jamais rencontrer de ces fades et plattes rimailles qui, tant de fois ont servi de prétexte à calomnier la Poésie."
                                            },
                                            {
                                                "example_id": "ca82b292-2d8f-4a89-b7ac-61d901d03624",
                                                "sense_id": "406aa570-a482-349c-a548-377b400ae1df",
                                                "text": "Le parfait gentleman qu’est mon vieil ami Jacques arborait ce soir-là une suave écharpe de soie, d’impeccables chaussures vernies, un pardessus du bon faiseur et un chapeau d’au moins vingt louis."
                                            },
                                            {
                                                "example_id": "d5c67297-62a0-4142-925a-a7d2cfbbb527",
                                                "sense_id": "406aa570-a482-349c-a548-377b400ae1df",
                                                "text": "Mais une fois établis les principes de la comptabilité, n’importe quel scribe s'en serait tiré au moins aussi bien que moi."
                                            },
                                            {
                                                "example_id": "3c6f4c24-ba00-458c-bc89-7b1f3590a1ba",
                                                "sense_id": "406aa570-a482-349c-a548-377b400ae1df",
                                                "text": "Si Dimitri ne voulait pas épouser Phoebe, il aurait au moins dû avoir le courage de l'avouer et de rompre formellement sa promesse. Au lieu de cela, il avait opté pour le silence et l'hypocrisie, […]."
                                            },
                                            {
                                                "example_id": "872d0c68-e572-4219-8e3e-aec00a1df13d",
                                                "sense_id": "406aa570-a482-349c-a548-377b400ae1df",
                                                "text": "Il faut au moins 4 heures pour aller de Rennes à Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e250235-322e-3b18-a9db-58ee6ca7173c",
                                        "entry_id": "55c2e569-3893-330c-98a5-98c810c8c9eb",
                                        "glosses": [
                                            "Tous autres griefs mis à part."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b030dcd3-c6ce-43c1-914b-2c425735fd38",
                                                "sense_id": "2e250235-322e-3b18-a9db-58ee6ca7173c",
                                                "text": "Tu critiques beaucoup ta femme mais elle te plaît au moins ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
