                ],
                "translations": [
                    {
                        "translation_id": "3cfbce47-d59a-44d7-ad2d-730620c75888",
                        "source_entry_id": "6cbc0932-6792-30e0-828c-d313b874d26e",
                        "source_sense_id": "3e85fba9-4cdd-3bef-8766-4926acfe08bb",
                        "target_lang_word": "Martha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Martha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a578bcba-ab49-3b73-8e8b-34fbbee105a9",
                                        "entry_id": "d70666c2-bf16-328e-9fde-da25b47c4321",
                                        "glosses": [
                                            "A female given name from Aramaic of biblical origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2547ca72-9f44-4082-b77f-1e46bac1800a",
                                                "sense_id": "a578bcba-ab49-3b73-8e8b-34fbbee105a9",
                                                "text": "They wanted to call her Helen, but I did put my foot down there. Knowing what her mother and father looked like! I tried hard for Martha or Dorcas or something sensible - but it was no good - waste of breath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dadff7a0-c0fc-363e-82eb-614968918847",
                                        "entry_id": "d70666c2-bf16-328e-9fde-da25b47c4321",
                                        "glosses": [
                                            "The sister of Lazarus and Mary in the New Testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "352d9bfe-b0af-4c91-a6ee-c2aff1fa23dd",
                                                "sense_id": "dadff7a0-c0fc-363e-82eb-614968918847",
                                                "text": "But Martha was cumbered about much serving, and came to him, and said, Lord, dost thou not care that my sister hath left me to serve alone? Bid her therefore that she help me. And Jesus answered and said unto her, Martha, Martha, thou art careful and troubled about many things: But one thing is needful."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Martha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9810bfe-df43-3b72-9264-57e05da82848",
                                        "entry_id": "43ec8a5e-9939-37d9-8491-a85fbab8f397",
                                        "glosses": [
                                            "A miniature greenhouse with a humidifier, used for growing mushrooms."
                                        ],
