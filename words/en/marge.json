{
    "word_family": [
        "margarine",
        "margin"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c841d0f-34ce-3f36-bcfb-44231a597ce4",
                    "sense_definition": "An informal shortened form of margarine, a butter substitute.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "butter_substitute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spread a thick layer of <w>marge</w> onto the warm toast.",
                            "target_lang_translations": {
                                "zh": "他在温热的吐司上抹了厚厚一层<w>人造黄油</w>。"
                            }
                        },
                        {
                            "text": "During the war, many families had to use <w>marge</w> instead of butter.",
                            "target_lang_translations": {
                                "zh": "战争期间，许多家庭不得不使用<w>植物黄油</w>来代替天然黄油。"
                            }
                        }
                    ],
                    "synonyms": [
                        "margarine",
                        "oleo"
                    ],
                    "antonyms": [
                        "butter"
                    ],
                    "common_phrases": [
                        "bread and marge"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal British usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "人造黄油（margarine的非正式口语缩写）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "人造黄油",
                                "target_lang_sense_clarification": "黄油替代品"
                            },
                            {
                                "target_lang_word": "植物黄油",
                                "target_lang_sense_clarification": "植物油制黄油替代品"
                            },
                            {
                                "target_lang_word": "麦淇淋",
                                "target_lang_sense_clarification": "音译，人造奶油/黄油"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1ecb685-0a1e-34b7-90bb-55b52e341aac",
                    "sense_definition": "A margin, border, edge, or brink, especially of a body of water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat peacefully by the river <w>marge</w> and watched the water flow.",
                            "target_lang_translations": {
                                "zh": "他们平静地坐在河<w>岸边</w>，看着流水潺潺。"
                            }
                        },
                        {
                            "text": "Wild irises grew along the damp <w>marge</w> of the lake.",
                            "target_lang_translations": {
                                "zh": "野生鸢尾花沿着潮湿的湖<w>边沿</w>生长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brink",
                        "edge",
                        "margin",
                        "verge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Primarily found in poetry and literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "边缘，边界；尤指水体边缘或岸边（多用于诗歌文学中）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "岸边",
                                "target_lang_sense_clarification": "水体边缘"
                            },
                            {
                                "target_lang_word": "边缘",
                                "target_lang_sense_clarification": "物体或区域边界"
                            },
                            {
                                "target_lang_word": "边沿",
                                "target_lang_sense_clarification": "边际"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4662fb29-01c6-3722-8dd4-5e203b301e9e",
                    "sense_definition": "A mother.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a new coat for his <w>marge</w> with his first paycheck.",
                            "target_lang_translations": {
                                "zh": "他用第一笔薪水为自己的<w>老妈</w>买了一件新外套。"
                            }
                        },
                        {
                            "text": "I spoke to my <w>marge</w> on the phone yesterday afternoon.",
                            "target_lang_translations": {
                                "zh": "我昨天下午和我的<w>妈妈</w>通了电话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ma",
                        "mam",
                        "mom",
                        "mother",
                        "mum"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal slang term"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "母亲，妈妈（俚语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "妈妈",
                                "target_lang_sense_clarification": "母亲的通俗口语"
                            },
                            {
                                "target_lang_word": "老妈",
                                "target_lang_sense_clarification": "非正式口语，母亲"
                            },
                            {
                                "target_lang_word": "母亲",
                                "target_lang_sense_clarification": "直系血亲尊亲属"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b3312de4-a5fb-36b0-aca8-ac332d739cd3",
                    "sense_definition": "A diminutive form of the female given names Marjorie or Margaret.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Aunt <w>Marge</w> came over for tea every Sunday afternoon.",
                            "target_lang_translations": {
                                "zh": "<w>玛琦</w>姑妈每个周日下午都会过来喝茶。"
                            }
                        },
                        {
                            "text": "Her full name is Margaret, but everyone calls her <w>Marge</w>.",
                            "target_lang_translations": {
                                "zh": "她的全名叫玛格丽特，但大家都叫她<w>玛姬</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "女子名Marjorie或Margaret的昵称/简称。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "玛琦",
                                "target_lang_sense_clarification": "常见女子人名译名"
                            },
                            {
                                "target_lang_word": "玛姬",
                                "target_lang_sense_clarification": "女子人名常见译名"
                            },
                            {
                                "target_lang_word": "玛芝",
                                "target_lang_sense_clarification": "女子人名译名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d305b83-04b4-3538-81be-f3ec34f7aa23",
                    "sense_definition": "To spread or add margarine onto food.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "butter_substitute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She quickly <w>marged</w> the toast before placing it on the table.",
                            "target_lang_translations": {
                                "zh": "把吐司端上桌之前，她迅速往上面<w>抹了人造黄油</w>。"
                            }
                        },
                        {
                            "text": "He asked her not to <w>marge</w> his bread because he prefers dry toast.",
                            "target_lang_translations": {
                                "zh": "他让她不要在面包上<w>涂人造黄油</w>，因为他更喜欢干吃烤面包。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（在食物上）涂抹人造黄油。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抹人造黄油于",
                                "target_lang_sense_clarification": "在食物表面涂抹人造黄油"
                            },
                            {
                                "target_lang_word": "涂人造黄油",
                                "target_lang_sense_clarification": "涂抹人造黄油"
                            }
                        ]
                    }
                }
            ]
        }
    ]
