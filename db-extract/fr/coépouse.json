                            {
                                "example_id": "4bd87945-6a88-4dbd-ad46-f895b2bc7d29",
                                "sense_id": "ba15a5f4-30f1-3935-9d95-8e186229d99b",
                                "text": "En terme de parenté, il est dit qu’un homme ne peut pas épouser la fille de sa sœur, ni la sœur d’une marâtre (coépouse de sa mère)."
                            },
                            {
                                "example_id": "0e328a25-d727-45dc-8ed4-e6d78b359537",
                                "sense_id": "ba15a5f4-30f1-3935-9d95-8e186229d99b",
                                "text": "C’était une jeune femme. Sa coépouse et elle vivaient ensemble."
                            },
                            {
                                "example_id": "60cdeb48-0e2b-4448-95d5-4823f843da88",
                                "sense_id": "ba15a5f4-30f1-3935-9d95-8e186229d99b",
                                "text": "Elle accuse à tour de rôle ses trois coépouses, dont les enfants sont d’une insolence intolérable, de hâter la fin de ses jours."
                            }
                        ]
                    }
