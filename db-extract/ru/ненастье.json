                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intempéries",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff13091c-7b94-35e4-92f9-3eed303b69b5",
                                        "entry_id": "5bc4ebfe-2f1d-3075-9027-d779d81ab569",
                                        "glosses": [
                                            "Pluriel de intempérie."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37fe7987-a26a-4e8b-91b0-f61ebe9113d0",
                                                "sense_id": "ff13091c-7b94-35e4-92f9-3eed303b69b5",
                                                "text": "La construction, qui avait sans doute connu ses heures de gloire, se désagrégeait année après année sous les assauts des intempéries."
                                            },
                                            {
                                                "example_id": "8d5b0d5a-378e-40cb-b3a9-ddacf46fbd13",
                                                "sense_id": "ff13091c-7b94-35e4-92f9-3eed303b69b5",
                                                "text": "Les caméras placées dans protections chez le douanier sont exposées aux intempéries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
