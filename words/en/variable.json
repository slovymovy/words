{
    "word_family": [
        "vary",
        "variation",
        "variant",
        "variability",
        "variance",
        "invariably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f6b712ff-e15e-3efd-b661-5cd8dcf58db4",
                    "sense_definition": "Likely to change often; not consistent or steady.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "changeable_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather in this region is highly <w>variable</w>, so bring both sunglasses and an umbrella.",
                            "target_lang_translations": {
                                "ru": "Погода в этом регионе очень <w>изменчивая</w>, поэтому возьмите с собой и солнечные очки, и зонт.",
                                "zh": "这个地区的天气非常<w>多变</w>，所以既要带太阳镜也要带雨伞。"
                            }
                        },
                        {
                            "text": "Due to <w>variable</w> winds, the sailing competition was postponed until the afternoon.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>переменных</w> ветров соревнования по парусному спорту были отложены до второй половины дня.",
                                "zh": "由于风向<w>多变</w>，帆船比赛被推迟到了下午。"
                            }
                        }
                    ],
                    "synonyms": [
                        "changeable",
                        "unstable",
                        "fluctuating",
                        "inconstant",
                        "unpredictable",
                        "fickle"
                    ],
                    "antonyms": [
                        "constant",
                        "invariable",
                        "unchanging",
                        "unalterable"
                    ],
                    "common_phrases": [
                        "highly variable",
                        "variable weather",
                        "variable quality",
                        "variable winds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к частым изменениям; непоследовательный или неустойчивый.",
                        "zh": "容易发生变化；不一致或不稳定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменчивый",
                                "target_lang_sense_clarification": "о погоде, настроении"
                            },
                            {
                                "target_lang_word": "непостоянный",
                                "target_lang_sense_clarification": "о характере, качестве"
                            },
                            {
                                "target_lang_word": "переменный",
                                "target_lang_sense_clarification": "о ветре, облачности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多变",
                                "target_lang_sense_clarification": "指天气、情况等经常变化"
                            },
                            {
                                "target_lang_word": "不稳定",
                                "target_lang_sense_clarification": "指状态或质量不固定"
                            },
                            {
                                "target_lang_word": "可变",
                                "target_lang_sense_clarification": "指性质上可以改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab28f7e5-55a4-3e92-a033-a31d74b66ac9",
                    "sense_definition": "Able to be changed or adapted to meet different needs.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "adjustable_technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine features a <w>variable</w> speed control to handle different types of materials.",
                            "target_lang_translations": {
                                "ru": "Машина оснащена системой управления <w>регулируемой</w> скоростью для работы с различными типами материалов.",
                                "zh": "这台机器具有<w>可调节</w>速度控制功能，以处理不同类型的材料。"
                            }
                        },
                        {
                            "text": "We decided to take out a loan with a <w>variable</w> interest rate rather than a fixed one.",
                            "target_lang_translations": {
                                "ru": "Мы решили взять кредит с <w>плавающей</w> процентной ставкой, а не с фиксированной.",
                                "zh": "我们决定申请一笔<w>浮动</w>利率贷款，而不是固定利率的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adjustable",
                        "flexible",
                        "modifiable"
                    ],
                    "antonyms": [
                        "constant",
                        "invariable",
                        "immutable",
                        "unalterable"
                    ],
                    "common_phrases": [
                        "variable speed",
                        "variable rate",
                        "variable geometry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный изменяться или адаптироваться под различные нужды.",
                        "zh": "能够改变或调整以满足不同需求。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регулируемый",
                                "target_lang_sense_clarification": "настраиваемый"
                            },
                            {
                                "target_lang_word": "переменный",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "плавающий",
                                "target_lang_sense_clarification": "о финансовой ставке, графике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可调节",
                                "target_lang_sense_clarification": "指设备或参数可以设置"
                            },
                            {
                                "target_lang_word": "浮动",
                                "target_lang_sense_clarification": "指利率或价格随市场变动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a0d884a-7e10-3f29-947d-93962b2057c9",
                    "sense_definition": "An element, feature, or factor that is liable to vary or change.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "factor_element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Price is a major <w>variable</w> that influences consumer behavior.",
                            "target_lang_translations": {
                                "ru": "Цена — это основная <w>переменная</w>, влияющая на поведение потребителей.",
                                "zh": "价格是影响消费者行为的一个主要<w>变量</w>。"
                            }
                        },
                        {
                            "text": "With so many unknown <w>variables</w>, it is difficult to predict the outcome of the election.",
                            "target_lang_translations": {
                                "ru": "С таким количеством неизвестных <w>переменных</w> трудно предсказать исход выборов.",
                                "zh": "有这么多未知的<w>变量</w>，很难预测选举结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "factor",
                        "element"
                    ],
                    "antonyms": [
                        "constant"
                    ],
                    "common_phrases": [
                        "key variable",
                        "unknown variable",
                        "confounding variable",
                        "random variable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Элемент, особенность или фактор, который может изменяться.",
                        "zh": "可能发生变化或变动的要素、特征或因素。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переменная",
                                "target_lang_sense_clarification": "изменяемый фактор"
                            },
                            {
                                "target_lang_word": "фактор",
                                "target_lang_sense_clarification": "обстоятельство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变量",
                                "target_lang_sense_clarification": "指可变动的因素"
                            },
                            {
                                "target_lang_word": "因素",
                                "target_lang_sense_clarification": "指影响结果的条件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9889b37b-5bac-3219-ba5e-5f22c96ab547",
                    "sense_definition": "A mathematical quantity or symbol that can represent any one of a set of values.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "math_symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the equation, the letter X represents the unknown <w>variable</w>.",
                            "target_lang_translations": {
                                "ru": "В уравнении буква X обозначает неизвестную <w>переменную</w>.",
                                "zh": "在方程中，字母X代表那个<w>未知数</w>。"
                            }
                        },
                        {
                            "text": "Students learned how to plot the independent <w>variable</w> on the horizontal axis of the graph.",
                            "target_lang_translations": {
                                "ru": "Студенты учились отмечать независимую <w>переменную</w> на горизонтальной оси графика.",
                                "zh": "学生们学习了如何在图表的横轴上标出自<w>变量</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parameter"
                    ],
                    "antonyms": [
                        "constant"
                    ],
                    "common_phrases": [
                        "independent variable",
                        "dependent variable",
                        "solve for the variable"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическая величина или символ, который может принимать любое значение из множества.",
                        "zh": "数学中可以代表一组值中任何一个的量或符号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переменная",
                                "target_lang_sense_clarification": "математика"
                            },
                            {
                                "target_lang_word": "неизвестное",
                                "target_lang_sense_clarification": "искомая величина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变量",
                                "target_lang_sense_clarification": "数学术语"
                            },
                            {
                                "target_lang_word": "未知数",
                                "target_lang_sense_clarification": "方程中待求的量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c7f232e-f5aa-3d43-a6e4-6c70a88ab3a9",
                    "sense_definition": "A named memory location in a computer program where data can be stored and changed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must declare the <w>variable</w> before you can assign a value to it in the code.",
                            "target_lang_translations": {
                                "ru": "Вы должны объявить <w>переменную</w>, прежде чем сможете присвоить ей значение в коде.",
                                "zh": "在代码中，你必须先声明<w>变量</w>，然后才能为其赋值。"
                            }
                        },
                        {
                            "text": "Using a global <w>variable</w> can sometimes lead to errors if it is modified unexpectedly.",
                            "target_lang_translations": {
                                "ru": "Использование глобальной <w>переменной</w> иногда может привести к ошибкам, если она будет неожиданно изменена.",
                                "zh": "如果全局<w>变量</w>被意外修改，有时会导致错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "declare a variable",
                        "global variable",
                        "local variable",
                        "environment variable"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Именованная область памяти в компьютерной программе для хранения и изменения данных.",
                        "zh": "计算机程序中用于存储和修改数据的命名内存位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переменная",
                                "target_lang_sense_clarification": "информатика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变量",
                                "target_lang_sense_clarification": "编程术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}