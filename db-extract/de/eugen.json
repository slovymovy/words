                "translations": [
                    {
                        "translation_id": "d0cbd529-26a4-42dc-8bf8-0423a18760ce",
                        "source_entry_id": "98a7bd4c-1dc3-3743-bfb8-0ed45e04aa0b",
                        "source_sense_id": "68b4dcbe-f6a0-38e9-9ea5-f3d2c666f5d0",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Eugene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eugene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7524a04-b003-3b31-89ca-5a6c0f220306",
                                        "entry_id": "99a89158-c8cd-3a86-aec9-5e57ef34433a",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef30ef3-602b-4df1-a091-82289612d1af",
                                                "sense_id": "f7524a04-b003-3b31-89ca-5a6c0f220306",
                                                "text": "\"Great praise the Duke of Marlb'ro' won / And our good Prince Eugene.\" / \"Why 'twas a very wicked thing!\" / Said little Wilhelmine"
                                            },
                                            {
                                                "example_id": "e1068688-7215-44d2-8604-9606d6ffcc89",
                                                "sense_id": "f7524a04-b003-3b31-89ca-5a6c0f220306",
                                                "text": "Eoghan (Owen) is frequently Eugene, and our own O'Curry, though he plucked up courage to prefix the O' to his name in later life, never discarded the Eugene, which, however, is far from being a monstrosity like most of our West-Britonized names"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9399fc98-34b6-33c3-be02-67832781521f",
                                        "entry_id": "99a89158-c8cd-3a86-aec9-5e57ef34433a",
                                        "glosses": [
                                            "A city, the county seat of Lane County, Oregon, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b0fa34f-9100-446f-9092-9b107de835ad",
                        "source_entry_id": "98a7bd4c-1dc3-3743-bfb8-0ed45e04aa0b",
                        "source_sense_id": "68b4dcbe-f6a0-38e9-9ea5-f3d2c666f5d0",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Eugène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eugène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                        "entry_id": "33bfd2a0-8439-3f60-b8b5-eebcc792c254",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "126dc104-20e1-4c5d-8caf-a81b38f9a32a",
                                                "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                                "text": "En attendant, Eugène conjecturait sur le départ de Dimitri, dont la disparition soudaine restait mystérieuse."
                                            },
                                            {
                                                "example_id": "ef6de8d3-3a7f-4417-951f-ebb3a1fd1ba3",
                                                "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                                "text": "J’allais oublier qu’Eugène croit aux soldats laboureurs !"
                                            },
                                            {
                                                "example_id": "bceb35ea-2ddc-4137-aa3c-76202b3c4e80",
                                                "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                                "text": "À cette époque, l’aîné, Eugène, avait près de quarante ans. C’était un garçon de taille moyenne, légèrement chauve, tournant déjà à l’obésité."
                                            },
                                            {
                                                "example_id": "80f2a7fe-5915-4776-9a13-cd981707611b",
                                                "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                                "text": "— Vous ne pouvez pas épouser un Eugène Duthoit. D’abord, « Eugène », c’est un nom ridicule !"
                                            },
                                            {
                                                "example_id": "d37e09b2-2c9c-4104-9d71-75fda00a2718",
                                                "sense_id": "4fb0c08f-f97c-3d25-a46c-8fa21359c094",
                                                "text": "Mais aussi Yvon Fauconnier, Mike Birch, le futur vainqueur, ou encore Eugène Riguidel, marin haut en couleur à qui il doit sa participation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1a3760e-9f29-4989-bcaf-7196612124dd",
                        "source_entry_id": "98a7bd4c-1dc3-3743-bfb8-0ed45e04aa0b",
