                                    },
                                    {
                                        "sense_id": "fabdaaa0-ede9-3989-8aa8-eecfeff44dd8",
                                        "entry_id": "59e532b5-55ed-38a3-ba1e-16f5d7f9668e",
                                        "glosses": [
                                            "Any of several similar coins in Southeast and East Asia, particularly the imperial Chinese copper coin."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b485b96-b7b5-4842-805f-076e73360936",
                                                "sense_id": "fabdaaa0-ede9-3989-8aa8-eecfeff44dd8",
                                                "text": "Shentzŭ is the Chinese name for what we would call a mule litter. As this conveyance can go over almost any kind of road, I decided on it, and engaged two mules for the litter, and a donkey for the baggage: the three animals with the shentzŭ and a man cost 1300 cash per day when we travelled, and 700 cash per day when we rested from any cause."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cash",
                                "target_lang_code": "en",
                                "target_senses": [
