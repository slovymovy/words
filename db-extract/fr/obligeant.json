                    {
                        "form_id": "5fe48442-2008-485c-bfe7-c8111807fb8f",
                        "entry_id": "784ca68f-095a-33bf-b3c9-042acd8a36e7",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "obligeantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34274e30-3667-37d6-bcf4-e68100af34b9",
                        "entry_id": "784ca68f-095a-33bf-b3c9-042acd8a36e7",
                        "glosses": [
                            "Qui aime à obliger, à faire plaisir."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "030a7859-dd69-4b3c-807d-93df9ba3ef8c",
                                "sense_id": "34274e30-3667-37d6-bcf4-e68100af34b9",
                                "text": "C’est un homme fort obligeant, extrêmement obligeant, tout à fait obligeant."
                            },
                            {
                                "example_id": "2d0b52cd-c650-4e7e-b6b5-7d6f5b1d8497",
                                "sense_id": "34274e30-3667-37d6-bcf4-e68100af34b9",
                                "text": "[Il] était de ces gens que l'on appelle \"bons garçons\" ; de ces gens qui passent pour obligeants parce qu'ils aiment à se mêler, à se fourrer dans la vie, dans les affaires d'autrui."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e9750f1-8f7b-33f0-a3b7-2017ea7397b7",
                        "entry_id": "784ca68f-095a-33bf-b3c9-042acd8a36e7",
                        "glosses": [
                            "Paroles et actes qui dénotent un désir d’obliger, de faire plaisir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b77186f-c145-4b7c-b589-54565b655224",
                                "sense_id": "5e9750f1-8f7b-33f0-a3b7-2017ea7397b7",
                                "text": "D’abord, il y eut à peine des saluts, les voisins étaient très fiers, très graves, menant leur pauvre vie dans une sorte de discrétion farouche. Puis, des rapports obligeants se nouèrent, le jeune homme procura à l’ancien professeur quelques articles à rédiger, pour une nouvelle encyclopédie."
                            },
                            {
                                "example_id": "c272d9c0-f136-490d-b5f8-8db223ee9a22",
                                "sense_id": "5e9750f1-8f7b-33f0-a3b7-2017ea7397b7",
                                "text": "Une humeur obligeante."
                            },
                            {
                                "example_id": "2db0a9f1-0902-47de-b2c8-78504f539564",
                                "sense_id": "5e9750f1-8f7b-33f0-a3b7-2017ea7397b7",
                                "text": "Il a des manières obligeantes."
                            },
                            {
                                "example_id": "e7594d26-535a-4dcf-b6ae-5ff7e74bb246",
                                "sense_id": "5e9750f1-8f7b-33f0-a3b7-2017ea7397b7",
                                "text": "Elle lui parle d’un ton fort obligeant."
                            },
                            {
                                "example_id": "40e71d8a-cd7b-4941-89af-dd0c9bc27d6a",
                                "sense_id": "5e9750f1-8f7b-33f0-a3b7-2017ea7397b7",
                                "text": "Un accueil, un sourire obligeant."
                            },
                            {
                                "example_id": "deff626c-8d19-44bb-add7-3136a906b978",
                                "sense_id": "5e9750f1-8f7b-33f0-a3b7-2017ea7397b7",
                                "text": "Faire une réponse obligeante."
                            },
                            {
                                "example_id": "29a46088-f599-4cbb-a989-fc55e56db862",
                                "sense_id": "5e9750f1-8f7b-33f0-a3b7-2017ea7397b7",
                                "text": "Il ne lui a pas dit seulement une parole obligeante."
                            },
                            {
                                "example_id": "3ee6210a-b352-4b48-ae61-72d9979330f9",
                                "sense_id": "5e9750f1-8f7b-33f0-a3b7-2017ea7397b7",
                                "text": "Ce que vous me dites n’est pas obligeant."
                            }
                        ]
                    }
