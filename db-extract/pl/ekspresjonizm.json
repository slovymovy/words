                        "entry_id": "b7b9b435-ae01-3e7b-bce7-7649409fa54e",
                        "glosses": [
                            "kierunek w sztuce, który miał na celu wyrażenie uczuć artysty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98490539-1d52-42ea-bdb3-69b0be4df89d",
                                "sense_id": "1a568e79-a7f9-35b6-9553-94dbdc760dfc",
                                "text": "Także w liryce ekspresjonizmu znajdujemy sonety, tam miały odzwierciedlać upadek starych wartości albo groteskowość i dziwność."
                            }
                        ],
