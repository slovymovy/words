    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1ab9190b-da2e-3bed-b072-4936130f25e1",
                "word": "nightmarish",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6dfaa0ee-336e-4fb7-9f6e-0209230a6a7f",
