                ],
                "senses": [
                    {
                        "sense_id": "d2c2bc77-f402-33c7-803d-953245a5c580",
                        "entry_id": "bda84f67-460b-3a78-b78a-5ed495a77b7f",
                        "glosses": [
                            "Gesamtheit der Möbel und Gerät in einer Wohnung; Möbelstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94eb3ca4-e572-4d43-b9df-ec2ec49391e0",
                                "sense_id": "d2c2bc77-f402-33c7-803d-953245a5c580",
                                "text": "„Die Hausratversicherung springt ein, wenn ein Brand die Wohnungseinrichtung zerstört, Einbrecher zuschlagen oder ein Wasserschaden den Teppichboden und die Möbel ruiniert.“"
                            },
                            {
                                "example_id": "b80e0629-ecfd-4852-9e7b-35420fa3f9b6",
                                "sense_id": "d2c2bc77-f402-33c7-803d-953245a5c580",
                                "text": "„Pop-Star Elton John hat am Dienstag in London seine Wohnungseinrichtung versteigern lassen.“"
                            },
                            {
                                "example_id": "22f499d7-e90a-4233-9e76-09ce097a2246",
                                "sense_id": "d2c2bc77-f402-33c7-803d-953245a5c580",
                                "text": "„Streitig war im jüngsten Fall des Bundesfinanzhofs, inwiefern die Kosten für die Wohnungseinrichtung zu den Unterkunftskosten gehören, deren Abzug auf 1000 Euro im Monat begrenzt ist, oder ob diese uneingeschränkt abzugsfähig sind.“"
                            },
                            {
                                "example_id": "f675d46a-67f8-430a-aa31-8f27fa3a7078",
                                "sense_id": "d2c2bc77-f402-33c7-803d-953245a5c580",
                                "text": "„Er könne ganze Wohnungseinrichtungen reparieren, entgegnet er dem Mann vom Amt, aber mit Computern habe er nie etwas zu tun gehabt.“"
                            },
                            {
                                "example_id": "ac37de0f-ba5f-442d-836d-4d85cf4c5d7a",
                                "sense_id": "d2c2bc77-f402-33c7-803d-953245a5c580",
                                "text": "„Umzugswagen fahren die Wohnungseinrichtungen entweder in die neuen Siedlungen an den Stadträndern - oder nach Westdeutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
