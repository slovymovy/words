                    }
                ],
                "translations": [
                    {
                        "translation_id": "032e898d-0869-4c13-aa65-5c6f3e8c8395",
                        "source_entry_id": "1d4cd84b-7ae7-3f3b-ad09-65152ae3412a",
                        "source_sense_description": "соединять в целое",
                        "target_lang_word": "synthétiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synthétiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1c468d4-da5c-3ad4-af4a-480c425e2958",
                                        "entry_id": "27bd98e7-d2fe-3d9e-af68-73fb83d97062",
                                        "glosses": [
                                            "Faire la synthèse de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7281f43-021d-4a69-97ba-174879aac187",
                                                "sense_id": "e1c468d4-da5c-3ad4-af4a-480c425e2958",
                                                "text": "Les lichens produisent les acides lichéniques, substances dues aux filaments du champignon, mais qui ne sont synthétisées qu’en présence de l’algue."
                                            },
                                            {
                                                "example_id": "c5c2b6cb-73ec-4971-a4f6-d9e15c638f9c",
                                                "sense_id": "e1c468d4-da5c-3ad4-af4a-480c425e2958",
                                                "text": "La plupart des enzymes protéolytiques sont habituellement synthétisées sous forme de précurseurs inactifs plus longs appelés zymogènes."
                                            },
                                            {
                                                "example_id": "5c20521a-abb2-43db-bdd1-f59f7e8bbad1",
                                                "sense_id": "e1c468d4-da5c-3ad4-af4a-480c425e2958",
                                                "text": "Un nanotube de carbone, c’est aussi une usine. Des chercheurs finlandais (université Aalto) ont synthétisé des nanorubans de graphène - autre variété de carbone - à l’intérieur de nanotubes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "920a1eab-0d78-314e-b11d-7140bf7ee9df",
                                        "entry_id": "27bd98e7-d2fe-3d9e-af68-73fb83d97062",
                                        "glosses": [
                                            "Résumer, faire la synthèse de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3225ab81-f659-478d-9fcd-090ca38132f0",
                                                "sense_id": "920a1eab-0d78-314e-b11d-7140bf7ee9df",
                                                "text": "Dans ce dernier cours, plusieurs équipes s'étaient partagé la tâche de synthétiser des informations concernant diverses périodes de l'histoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
