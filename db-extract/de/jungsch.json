                ],
                "senses": [
                    {
                        "sense_id": "b4e7d67c-8355-3aa5-9a33-a78d08623fbf",
                        "entry_id": "c63a8af9-a4e1-3af6-a904-a2ff56bbef86",
                        "glosses": [
                            "niedrigen Alters"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2f917d7e-1871-496b-8aa8-5b48d77d623c",
                                "sense_id": "b4e7d67c-8355-3aa5-9a33-a78d08623fbf",
                                "text": "„Doch einmal ist er mit einer gekommen, die kam aus Wiesbaden. Son Kleiderständer mit lauter Fummelkram dran. Sollte mich befreunden mit ihr, hat er gesagt. War so ne jungsche, patente, hieß Inge.“"
                            },
                            {
                                "example_id": "62e33785-629e-47d0-b133-ed1023dfc0c3",
                                "sense_id": "b4e7d67c-8355-3aa5-9a33-a78d08623fbf",
                                "text": "„Ich laß mir doch von so ’ner jungschen Göre nichts erzählen.“"
                            },
                            {
                                "example_id": "6bf1d324-cae4-4499-ab5d-1554a112535c",
                                "sense_id": "b4e7d67c-8355-3aa5-9a33-a78d08623fbf",
                                "text": "„Durch seinen zielstrebigen Schritt hebt sich der jungsche Kerl noch mehr von der Masse ab.“"
                            },
                            {
                                "example_id": "47cbd55a-0ccc-4dab-8b1d-2598b2cabcce",
                                "sense_id": "b4e7d67c-8355-3aa5-9a33-a78d08623fbf",
