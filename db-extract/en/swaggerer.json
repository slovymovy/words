                                                "sense_id": "11dc2126-7f09-3dde-a708-2c70ab65e6ec",
                                                "text": "Lass Dich nicht von dem neuen Trainee einwickeln, der ist ein Prahler und Blender."
                                            },
                                            {
                                                "example_id": "68768373-9508-4eef-af11-7d1d160c538a",
                                                "sense_id": "11dc2126-7f09-3dde-a708-2c70ab65e6ec",
                                                "text": "„Welche Spezies Mensch gehört zu den größten Prahlern?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
