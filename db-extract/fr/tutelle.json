                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f18dd90-1470-3abc-b7eb-7307e1d9035c",
                                        "entry_id": "db0a2cb8-1b0e-343a-acb0-8b1e82d56dd0",
                                        "glosses": [
                                            "The act of guarding, protecting, or guiding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27e299c1-d27f-41ab-b62e-783546599da5",
                                                "sense_id": "4f18dd90-1470-3abc-b7eb-7307e1d9035c",
                                                "text": "the king's right of seigniory and tutelage"
                                            },
                                            {
                                                "example_id": "f9971071-3a3a-4149-a231-be81c12725f3",
                                                "sense_id": "4f18dd90-1470-3abc-b7eb-7307e1d9035c",
                                                "text": "The childhood of the European nations was passed under the tutelage of the clergy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d508ec2-d73e-3031-a0b6-27ca91836c59",
                                        "entry_id": "db0a2cb8-1b0e-343a-acb0-8b1e82d56dd0",
                                        "glosses": [
                                            "The state of being under a guardian or a tutor; care or protection enjoyed; being a ward or a tutee."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6402a729-d29e-336c-a781-311b4a04f6cd",
                                        "entry_id": "db0a2cb8-1b0e-343a-acb0-8b1e82d56dd0",
                                        "glosses": [
                                            "Instruction; teaching; guidance; being a tutor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332c0e46-83c9-48ea-a4cf-e768201452d9",
                                                "sense_id": "6402a729-d29e-336c-a781-311b4a04f6cd",
                                                "text": "Taught from their cradle-bed to know\nThe bitter tutelage of wo,\nNo idle fears in their bosoms glow,\nBut pride and wrath in their dark eyes glance,\nAs they lift their martyr'd fathers' lance."
                                            },
                                            {
                                                "example_id": "1e9e88f6-4f58-4ce8-8e05-fa0c5cf8a3a6",
                                                "sense_id": "6402a729-d29e-336c-a781-311b4a04f6cd",
                                                "text": "Kirk has attempted to write the definitive explanation of myth, but he too has overlooked von Dechend and, therefore, cannot make much sense concerning \"Inanna's Descent into the Nether World.\" But when from von Dechend's tutelage we realize that Inanna is identified with the planet Venus, then we understand that there is more going on in the myth than a dramatization of the empty storehouse in winter."
                                            },
                                            {
                                                "example_id": "a476c69c-e6f8-456e-8f2a-adeee7c905ca",
                                                "sense_id": "6402a729-d29e-336c-a781-311b4a04f6cd",
                                                "text": "But when asked which of his achievements he is most proud of, he says: “Actually those of others hypermilers behind the wheel, thanks to my tutelage or simply inspiration.”"
                                            },
                                            {
                                                "example_id": "f23dd6e6-7190-4887-a32b-18fddb2dde9d",
                                                "sense_id": "6402a729-d29e-336c-a781-311b4a04f6cd",
                                                "text": "The High Level station was quickly overwhelmed by the volume of traffic, and a full rebuild under the tutelage of architect James Miller was initiated just two years after opening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
