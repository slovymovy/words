                "senses": [
                    {
                        "sense_id": "37316478-50fb-3bda-a46c-efbc1303b836",
                        "entry_id": "675aab5b-d0bb-396e-89f5-2c0b505af26a",
                        "glosses": [
                            "To move (a growing plant) from one pot to a larger one to allow for further growth."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "00e72ed7-cbe8-34a0-8ddf-738938e69a80",
                        "entry_id": "675aab5b-d0bb-396e-89f5-2c0b505af26a",
                        "glosses": [
                            "To give (oneself) new challenges or environments as a means of personal growth."
                        ],
                        "tags": [
                            "broadly",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5e62db64-ce01-4247-a219-c58ff9d12b24",
                                "sense_id": "00e72ed7-cbe8-34a0-8ddf-738938e69a80",
                                "text": "There's no limit to the number of times you can repot yourself. Every season offers opportunities for new growth, and what's fulfilling to you now may not answer your needs in a future stage of life."
                            },
                            {
                                "example_id": "a655b442-387b-4e96-9757-d735901650ff",
                                "sense_id": "00e72ed7-cbe8-34a0-8ddf-738938e69a80",
                                "text": "The impulse to repot yourself may be set in motion by a change in your life. This can be an event beyond your control, or it may be a happening over which you have some control."
                            },
                            {
                                "example_id": "a14ba86e-9253-4297-910a-c079865d184b",
                                "sense_id": "00e72ed7-cbe8-34a0-8ddf-738938e69a80",
                                "text": "One way to “pay attention to your life” is to “repot yourself.” American writer John Gardner pushed people to think about “repotting” themselves every 10 to 15 years, throwing themselves into challenges that extract hidden strengths."
                            }
                        ]
                    }
                ],
