                "senses": [
                    {
                        "sense_id": "0a53ff22-13e1-3411-ba2c-a4deae1430d5",
                        "entry_id": "81caad89-5a52-3bec-aa68-39a9e8843d38",
                        "glosses": [
                            "zur Gattung der Kiefern gehörender Nadelbaum mit typischer schirmartiger Krone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca2ae6a-3c9e-4a20-90cf-e7a73ed4a664",
                                "sense_id": "0a53ff22-13e1-3411-ba2c-a4deae1430d5",
                                "text": "Die Villa, die wir übers Internet gebucht hatten, lag wunderschön am Meer und hatte eine von Pinien gesäumte Auffahrt."
                            },
                            {
                                "example_id": "ce2684b6-e8c2-43bc-aa24-67d700bee54c",
                                "sense_id": "0a53ff22-13e1-3411-ba2c-a4deae1430d5",
                                "text": "„Doch von Pinien eingerahmte Meeresbuchten sind nach wie vor ein Markenzeichen dieses Teils der Mittelmeerküste.“"
                            },
                            {
                                "example_id": "5af688d2-b37e-4073-b877-11a0b46682f7",
                                "sense_id": "0a53ff22-13e1-3411-ba2c-a4deae1430d5",
                                "text": "„Almuth riss ihn unter das Dach einer Pinie, deren Schirme über eine Gartenmauer ragten.“"
                            },
                            {
                                "example_id": "08795274-d983-458e-a9ff-23e7de65ef77",
                                "sense_id": "0a53ff22-13e1-3411-ba2c-a4deae1430d5",
                                "text": "„Nach einer Weile entdeckte Harbert eine Pinie, die ausgereifte Früchte trug.“"
                            },
                            {
                                "example_id": "c7b85f71-4093-42bb-b84e-e4a0af20a6e5",
                                "sense_id": "0a53ff22-13e1-3411-ba2c-a4deae1430d5",
                                "text": "„Ich konnte das Harz der Pinien neben dem Bootshaus riechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
