                "senses": [
                    {
                        "sense_id": "66758270-2325-3d6e-a8b5-a63bc138c218",
                        "entry_id": "f0d9084e-3149-3e47-a72b-7a1a8f384530",
                        "glosses": [
                            "eine der mittelrheinischen jüdischen Gemeinden (darunter Mainz, Speyer, Worms)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0300553a-4b72-4f94-8feb-8388ecedda98",
                                "sense_id": "66758270-2325-3d6e-a8b5-a63bc138c218",
                                "text": "„Dennoch lässt sich das Westjiddische nicht unmittelbar auf das Frankfurter Deutsch zurückführen - schon allein deshalb nicht, weil das Frankfurter Jiddisch in seiner Aussprache anfänglich zum Teil stärker durch die jiddischen Dialekte der SchUM-Gemeinden geprägt war als durch das Frankfurterisch der Nicht-Juden."
                            },
                            {
                                "example_id": "47db8e4c-5bf4-4a37-b6c3-bf7f4772479c",
                                "sense_id": "66758270-2325-3d6e-a8b5-a63bc138c218",
                                "text": "„Römer und Franken, Altartafeln und Dürer Kopien von Adam und Eva, das calvinistische Bilderverbot in Holland und der barocke Marstall der Kurfürsten von Mainz, der »Verein für Literatur und Kunst« und Werke der Düsseldorfer sowie Münchner Schule, Mainz als SchUM-Gemeinde und 45.000 Blätter in der Graphischen Sammlung, Künstlervereinigungen und Stilvielfalt, Modern Style und Jugendstil, Lovis Corinth und Picasso sind hier zu sehen: Stadtgeschichte wird reflektiert und in Bezug zur allgemeinen Kunst- und Kulturgeschichte gesetzt. “"
                            },
                            {
                                "example_id": "7d19e171-f322-4950-8ad1-0e94e1644987",
                                "sense_id": "66758270-2325-3d6e-a8b5-a63bc138c218",
                                "text": "„Er ist das einzige materielle Erbe der SchUM-Gemeinde in Mainz und soll für den Besucher erfahrbar sein. “"
                            },
                            {
                                "example_id": "c4c030d0-fca1-4cf8-8ce0-bb2eaf9ba581",
                                "sense_id": "66758270-2325-3d6e-a8b5-a63bc138c218",
                                "text": "„Zudem soll die Ausstellung den Antrag des Landes Rheinland-Pfalz unterstützen, die SchUM-Gemeinden in die deutsche Unesco-Welterbevorschlagsliste aufzunehmen.“"
                            },
                            {
                                "example_id": "6100d900-3038-4d49-bbe5-b91ace227a99",
                                "sense_id": "66758270-2325-3d6e-a8b5-a63bc138c218",
                                "text": "„Die stilistisch sehr unterschiedlichen Arbeiten verwiesen auf die bis in unsere Zeit wirkende Tradition der SchUM-Gemeinden und veranschaulichten die gegenwärtige Präsenz des jüdischen Lebens in den drei Städten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
