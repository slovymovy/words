                ],
                "senses": [
                    {
                        "sense_id": "1f7d0e26-3a6a-33b3-a3eb-40ba95ba3d31",
                        "entry_id": "bb9ff757-4cde-3f69-8a74-ab0a89c714f0",
                        "glosses": [
                            "Quotient aus vermiedenen zu ursprünglich vorhandenen Geruchsemissionen; Maßgeblicher Hundertsatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da48ccb-845d-41bc-b957-fc3fa5a1dd14",
                                "sense_id": "1f7d0e26-3a6a-33b3-a3eb-40ba95ba3d31",
                                "text": "„Folglich müssen Abluftbehandlungsanlagen einen Geruchsminderungsgrad von weit über 90% aufweisen, um eine deutliche Verbesserung der Geruchssituation zu erreichen.“"
                            },
                            {
                                "example_id": "d7a0f04d-113d-442b-887d-67701041a77a",
                                "sense_id": "1f7d0e26-3a6a-33b3-a3eb-40ba95ba3d31",
                                "text": "„Wie die Untersuchungsergebnisse zeigten,erreichen Biofilter die höchsten Geruchsminderungsgrade und besitzen zudem eine Geruchscharakteristik,die sich nur unwesentlich vom natürlichen Hintergrund unterscheidet.“"
                            },
                            {
                                "example_id": "529d6ad9-e6b5-4311-8324-c562d4e2cd21",
                                "sense_id": "1f7d0e26-3a6a-33b3-a3eb-40ba95ba3d31",
                                "text": "„Bauliche Anlagen, in denen mehr als zehn Großvieheinheiten der zuvor genannten Tierarten gehalten beziehungsweise aufgezogen werden und mit den dazugehörigen Lagerstätten (Behälter) für die tierischen Ausscheidungen (Festmist, Gülle und Jauche) sind als geschlossene Systeme mit Unterdruckentlüftung und einer Abluftreinigung, die einen Geruchsminderungsgrad von 95% dauerhaft gewährleistet, auszubilden."
                            },
                            {
                                "example_id": "90136308-87e3-4a92-b7d4-5c831f13743e",
                                "sense_id": "1f7d0e26-3a6a-33b3-a3eb-40ba95ba3d31",
                                "text": "„Wir bestimmen den Geruchsminderungsgrad von Abluftreinigungsanlagen durch Messung von Roh- und Reingas auch bei Pilot- und Versuchsanlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
