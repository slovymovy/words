                "senses": [
                    {
                        "sense_id": "29178cbb-447e-3132-bab5-de7ddb62c9ba",
                        "entry_id": "80ae7b0d-4c21-31e4-b1ac-9cc6796d4f1e",
                        "glosses": [
                            "See-, Raum- oder Luftschiff, das kleinere Fortbewegungsmittel mit sich führen sowie diese reparieren und versorgen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aca3c04d-f7f9-4afc-b895-a10f6468a7a0",
                                "sense_id": "29178cbb-447e-3132-bab5-de7ddb62c9ba",
                                "text": "„Es war mir eine besondere Ehre, als Admiral Carfax mich mit dem Kommando über unseren Spähgleiter betraute, dessen Einzelteile aus dem Bauch des riesigen Mutterschiffs entladen und für den Vor-Ort-Einsatz zusammengefügt wurden.“"
                            },
                            {
                                "example_id": "c9bd8e1d-25f9-47ac-b545-f25f69b16d44",
                                "sense_id": "29178cbb-447e-3132-bab5-de7ddb62c9ba",
                                "text": "„Nicht, dass sie die dicksten Freunde gewesen wären. Sie waren eher wie zwei Raumfahrer, die bei einem Einsatz im All den Kontakt zum Mutterschiff verloren hatten.“"
                            },
                            {
                                "example_id": "eec1e4f6-52f7-4070-8bd0-d0c5e6b64011",
                                "sense_id": "29178cbb-447e-3132-bab5-de7ddb62c9ba",
                                "text": "„Zu seiner Überraschung entdeckte er eines der beiden Beiboot der Tai Chin VI keine 40 Meter hinter sich; es war aufs felsige Ufer gegenüber der Triadenbar aufgelaufen, etwa 180 Meter vom Mutterschiff entfernt, und außer dem leichten Schaukeln in der Dünung bewegte sich in und an dem Boot nichts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
