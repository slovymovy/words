                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "familie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakanties met pa en <w>moe</w> maken langzaam plaats voor reizen met vrienden.",
