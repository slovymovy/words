                        "entry_id": "24e83f1c-1df1-395d-8006-9e5dfc52a2cd",
                        "glosses": [
                            "Qui est en forme de croix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fcc076c-4ed1-444c-8bd3-2710c1d011be",
                                "sense_id": "dfaaa8f5-b126-3cd8-9a27-d659958a89a6",
                                "text": "Incision cruciale."
                            }
                        ]
                    },
                    {
                        "sense_id": "90e02e05-cbbd-3ee8-b939-fd5f054ddfe9",
                        "entry_id": "24e83f1c-1df1-395d-8006-9e5dfc52a2cd",
                        "glosses": [
                            "Qui est très important, sensible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a65c6a0-de7e-4fb2-8315-c6b6433dd032",
                                "sense_id": "90e02e05-cbbd-3ee8-b939-fd5f054ddfe9",
                                "text": "La question cruciale est bien entendu la suivante : quelles sont les mesures valables à suivre pour parvenir à une croyance ?"
                            },
                            {
                                "example_id": "76c8ca07-536d-4cb5-aa7c-5035241b5b59",
                                "sense_id": "90e02e05-cbbd-3ee8-b939-fd5f054ddfe9",
                                "text": "Un point crucial est l’éclatement du revenu mixte d’exploitation des indépendants entre une part salariale et une part allant au capital."
                            },
                            {
                                "example_id": "20bb74a0-1567-48b4-bb9b-c4c3a520b8fa",
                                "sense_id": "90e02e05-cbbd-3ee8-b939-fd5f054ddfe9",
                                "text": "Si les données stockées dans les sites sont cruciales, vous ne pouvez attribuer l'autorisation de contrôle total aux utilisateurs."
                            },
                            {
                                "example_id": "509d8d4e-a658-4685-bbfd-29b1e2cce889",
                                "sense_id": "90e02e05-cbbd-3ee8-b939-fd5f054ddfe9",
                                "text": "Mais ses détracteurs l'accusent de passer trop de temps à cultiver son image publique au détriment des questions politiques cruciales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68b559bc-981c-458a-b076-cbe12759ffed",
                        "source_entry_id": "24e83f1c-1df1-395d-8006-9e5dfc52a2cd",
                        "source_sense_description": "Très important, sensible",
                        "target_lang_word": "lebenswichtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lebenswichtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3237d014-71cf-3cab-9915-0297065e8f63",
                                        "entry_id": "833c5a6c-965e-3320-9d57-6457d806e09f",
                                        "glosses": [
                                            "für das Weiterleben sehr wichtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27e2b859-5d8f-4224-ae64-64485adf123e",
                                                "sense_id": "3237d014-71cf-3cab-9915-0297065e8f63",
                                                "text": "Kenntnisse über die Essbarkeit der einzelnen Sorten waren dort lebenswichtig."
                                            },
                                            {
                                                "example_id": "7e10b99d-b9bc-4063-ae07-3b6e1c41c2ea",
                                                "sense_id": "3237d014-71cf-3cab-9915-0297065e8f63",
                                                "text": "„Im heißen Indien ist der Verzehr von Salz lebenswichtig.“"
                                            },
                                            {
                                                "example_id": "5719c238-2b28-41f0-87be-527adcfe6867",
                                                "sense_id": "3237d014-71cf-3cab-9915-0297065e8f63",
                                                "text": "„Sie sicherten die für Simbabwe lebenswichtige Route von der Hafenstadt Beira zur Grenze und konnten die RENAMO in ihre Bewegungsfreiheit einschränken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c725481-106a-4146-b0e0-901eb1f15d01",
                        "source_entry_id": "24e83f1c-1df1-395d-8006-9e5dfc52a2cd",
