        "fr-extract.jsonl": [
            {
                "entry_id": "493a44fe-bd04-3338-91df-5699cccf8080",
                "word": "sophistique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e9873829-03cb-48a6-9b00-5b0227239df5",
                        "entry_id": "493a44fe-bd04-3338-91df-5699cccf8080",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "sophistiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2f3d019-ffdd-306e-af9d-977363157a31",
                        "entry_id": "493a44fe-bd04-3338-91df-5699cccf8080",
                        "glosses": [
                            "Qui concerne les sophistes antiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e4d1f8-8726-46f5-b069-a992d2bfcaff",
                                "sense_id": "d2f3d019-ffdd-306e-af9d-977363157a31",
                                "text": "Philosophie sophistique."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d1e8215-5eda-3935-9493-611219ca480d",
                        "entry_id": "493a44fe-bd04-3338-91df-5699cccf8080",
                        "glosses": [
                            "Qui est de la nature du sophisme, qui contient des sophismes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d045a626-11fa-478e-a581-b3e2c90a197d",
                                "sense_id": "8d1e8215-5eda-3935-9493-611219ca480d",
                                "text": "Je ne donne jamais au mot \"philosophie\", dans le cours de cet ouvrage, le sens que ses détracteurs ont voulu lui donner de nos jours, soit en opposant la philosophie aux idées religieuses, soit en appelant \"philosophiques\" des systèmes purement sophistiques."
                            },
                            {
                                "example_id": "c75a17bc-07a3-499d-9e49-66a18e191f77",
                                "sense_id": "8d1e8215-5eda-3935-9493-611219ca480d",
                                "text": "Je vis à sa honte et à sa tristesse qu’il était bien inutile de rétorquer les arguments sophistiques de son désordre."
                            },
                            {
                                "example_id": "c436977b-8129-46f0-8c78-ee852d19d999",
                                "sense_id": "8d1e8215-5eda-3935-9493-611219ca480d",
                                "text": "Sous l’impression des sentiments qu’il éprouvait en ce moment, Ulric s’épouvanta lui-même en voyant dégagé de tout raisonnement sophistique, le monstrueux égoïsme qui lui servait de mobile."
                            },
                            {
                                "example_id": "5ca82155-df30-41a8-b51e-e4c6a6625fad",
                                "sense_id": "8d1e8215-5eda-3935-9493-611219ca480d",
                                "text": "On arrivera toujours à un cas où l’induction repose sur une telle probabilité, que la raison ne conserve pas le moindre doute, en dépit de toute objection sophistique."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7e50c57-60ce-3703-9d00-214a8dcf4847",
                        "entry_id": "493a44fe-bd04-3338-91df-5699cccf8080",
                        "glosses": [
                            "Qui fait usage du sophisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81625c4a-c48e-4597-a4ed-62df9e6a84d7",
                                "sense_id": "e7e50c57-60ce-3703-9d00-214a8dcf4847",
                                "text": "Un esprit sophistique."
                            },
                            {
                                "example_id": "03781540-5c46-40b6-9644-0793d13a05d0",
                                "sense_id": "e7e50c57-60ce-3703-9d00-214a8dcf4847",
                                "text": "Un écrivain sophistique."
                            },
                            {
                                "example_id": "612b93b4-743a-41a1-868d-c24c0075ae41",
                                "sense_id": "e7e50c57-60ce-3703-9d00-214a8dcf4847",
                                "text": "Une éloquence sophistique."
                            },
                            {
                                "example_id": "322eb72b-c328-4e10-80d0-b313b7a873d8",
                                "sense_id": "e7e50c57-60ce-3703-9d00-214a8dcf4847",
                                "text": "Le caractère sophistique de tous ces empereurs philosophes et rhéteurs tient à leurs liaisons avec la Gaule, au moins autant qu’à leur prédilection pour la Grèce."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f080dbb3-872b-43b2-b08d-ea438ac621c7",
                        "source_entry_id": "493a44fe-bd04-3338-91df-5699cccf8080",
                        "target_lang_word": "sophistical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sophistical",
