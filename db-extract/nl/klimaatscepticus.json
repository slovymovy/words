                    {
                        "translation_id": "e3cb4ca8-d73f-42cc-a53e-771afebf3e76",
                        "source_entry_id": "e153c327-4578-35f5-9c17-66294d3af68a",
                        "target_lang_word": "climatosceptique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "climatosceptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ded85e0-bf07-3a4a-8c24-e3b5ecee9574",
                                        "entry_id": "c87df690-a1e5-35a0-ad00-421dfa1d38eb",
                                        "glosses": [
                                            "Variante orthographique de climato-sceptique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8efc2e9-4658-4198-8ad6-cd58df9d84c8",
                                                "sense_id": "5ded85e0-bf07-3a4a-8c24-e3b5ecee9574",
                                                "text": "Robert Brulle a d’abord identifié quatre-vingt-onze organisations qui portent dans les médias ou sur le Net un discours climatosceptique ou systématiquement opposé à toute action politique pour contrer le réchauffement."
                                            },
                                            {
                                                "example_id": "aa13d072-8419-477f-aaa1-a9a09f39ad4b",
                                                "sense_id": "5ded85e0-bf07-3a4a-8c24-e3b5ecee9574",
                                                "text": "Avoir élu un président climatosceptique aura coûté cher aux États-Unis, et ce, à bien des égards."
                                            },
                                            {
                                                "example_id": "1a95d0a0-65b7-46d0-8462-9d30ffaec322",
                                                "sense_id": "5ded85e0-bf07-3a4a-8c24-e3b5ecee9574",
                                                "text": "Dans leur livre Les Marchands de doute, Naomi Oreskes (université d’Harvard) et Erik Conway (Jet Propulsion Laboratory/Nasa), ont montré que l’argumentaire climatosceptique avait été fabriqué de toutes pièces, à la fin des années 1980, dans les cercles néoconservateurs américains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "climatosceptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c00d7df4-f9c6-3850-8ade-a32f5a9b9f23",
                                        "entry_id": "179fa505-6e7c-3b1e-bd4b-170b782ae3da",
                                        "glosses": [
                                            "Variante orthographique de climato-sceptique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55bfe431-ea7f-4af5-b296-01435415ed31",
                                                "sense_id": "c00d7df4-f9c6-3850-8ade-a32f5a9b9f23",
                                                "text": "« Où sont vos preuves ? répliquent, narquois, les climatosceptiques. Pour nous, la science, c’est des faits certains. »"
                                            },
                                            {
                                                "example_id": "e4c656fc-a5c8-4385-9360-cab05914a3a2",
                                                "sense_id": "c00d7df4-f9c6-3850-8ade-a32f5a9b9f23",
                                                "text": "N’en déplaise aux climatosceptiques, l’équipe insiste sur la forte corrélation entre le taux de dioxyde de carbone et la température pendant toute la période."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
