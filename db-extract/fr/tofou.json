                        "glosses": [
                            "Variante orthographique de tofu."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e38ac336-fb17-4865-8030-34dd2e012c1f",
                                "sense_id": "cf5a453f-e5e4-3717-814c-926ce79622dc",
                                "text": "M. le docteur Mourier adresse d’Yoko Hama (Japon) plusieurs boîtes renfermant : … nᵒ 3 Aka-adzeuki ; nᵒ 4 Kouro adzeuki ; nᵒ 5 Shiro mamé ; nᵒ 6 Kouro mamé ; ces quatre graines servent à fabriquer le miso et le tofou ; […]"
                            },
                            {
                                "example_id": "842a9053-860c-486c-a159-3df67a4243cd",
                                "sense_id": "cf5a453f-e5e4-3717-814c-926ce79622dc",
                                "text": "3ᵉ le tofou, fromage obtenu par la coagulation du suc provenant de l’expression de soja."
                            },
                            {
                                "example_id": "b551e18e-8c07-4db6-94a4-9909cb7ae74f",
                                "sense_id": "cf5a453f-e5e4-3717-814c-926ce79622dc",
                                "text": "La friture change les caractéristiques du tofou et le rend souple et masticable."
                            },
                            {
                                "example_id": "10772941-14b7-4217-b60e-8ff21bc75403",
                                "sense_id": "cf5a453f-e5e4-3717-814c-926ce79622dc",
                                "text": "Si on veut manger du tofou avec appétit, il faudrait du bon kimchi."
                            }
                        ]
                    }
