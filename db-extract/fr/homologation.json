            {
                "entry_id": "1aafa5a2-f114-337b-bdcd-d17e0db152d8",
                "word": "homologation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2dc444c4-5fec-4a2f-8373-d6af4fb48e0a",
                        "entry_id": "1aafa5a2-f114-337b-bdcd-d17e0db152d8",
                        "tags": [
                            "plural"
