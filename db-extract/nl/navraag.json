        "nl-extract.jsonl": [
            {
                "entry_id": "8f11fa93-7c7f-3a7e-b7b7-90ee19bcc588",
                "word": "navraag",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5c0c97d5-d099-34f6-9ad7-c76e849f86ae",
                        "entry_id": "8f11fa93-7c7f-3a7e-b7b7-90ee19bcc588",
                        "glosses": [
                            "het navragen, het vragen naar iets, het inwinnen van informatie"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0323f4c2-cb72-4f2c-a2a3-2650897c5e7d",
                        "source_entry_id": "8f11fa93-7c7f-3a7e-b7b7-90ee19bcc588",
                        "source_sense_id": "5c0c97d5-d099-34f6-9ad7-c76e849f86ae",
                        "target_lang_word": "question",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "question",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a103a3cb-40b3-3193-902a-346159ed5e1c",
                                        "entry_id": "00a3c24f-1ce1-3521-8bac-98335361d164",
                                        "glosses": [
                                            "A worded or expressed sentence, phrase, or only a word on its own, which asks for information, a reply, or a response; an interrogative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e8433a-570b-45d6-b122-e98163a90999",
                                                "sense_id": "a103a3cb-40b3-3193-902a-346159ed5e1c",
                                                "text": "What is your question?"
                                            },
                                            {
                                                "example_id": "2bf6237b-cc6a-4d0e-851c-5675668d5b99",
                                                "sense_id": "a103a3cb-40b3-3193-902a-346159ed5e1c",
                                                "text": "I told him about everything I could think of; and what I couldn't think of he did. He asked about six questions during my yarn, but every question had a point to it. At the end he bowed and thanked me once more. As a thanker he was main-truck high; I never see anybody so polite."
                                            },
                                            {
                                                "example_id": "1cc55cf9-cb4a-4de6-91eb-afa45b5d7faf",
                                                "sense_id": "a103a3cb-40b3-3193-902a-346159ed5e1c",
                                                "text": "Can I ask you two a question? / Please, Christ, yes. / How can you two live like this? / How can... / Don't google the question, Moss!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49fc6ea4-b555-33d6-8f37-c5c301085db5",
                                        "entry_id": "00a3c24f-1ce1-3521-8bac-98335361d164",
                                        "glosses": [
                                            "A subject or topic for consideration or investigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac81468c-ccbd-4df5-9173-10293b741500",
                                                "sense_id": "49fc6ea4-b555-33d6-8f37-c5c301085db5",
                                                "text": "The question of seniority will be discussed at the meeting."
                                            },
                                            {
                                                "example_id": "da43a2db-d128-4919-aa21-8a7e057920db",
                                                "sense_id": "49fc6ea4-b555-33d6-8f37-c5c301085db5",
                                                "text": "There was a question of which material to use."
                                            },
                                            {
                                                "example_id": "9f2a0792-c5f8-4b53-9456-43de5d133eef",
                                                "sense_id": "49fc6ea4-b555-33d6-8f37-c5c301085db5",
                                                "text": "I've ordered it all, but there’s still the question of who’s going to pay."
                                            },
                                            {
                                                "example_id": "093b8208-10b4-41ac-94c2-d48959c9ddef",
                                                "sense_id": "49fc6ea4-b555-33d6-8f37-c5c301085db5",
                                                "text": "The question of the plausibility of the counter-factual is seen as key in all three discussions of allohistorical fiction (as it is in Demandt's and Ferguson's examinations of allohistory) (cf. Rodiek 25–26; Ritter 15–16; Helbig 32)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6767c2f-ddbc-3cb7-989d-3a2806a9e913",
                                        "entry_id": "00a3c24f-1ce1-3521-8bac-98335361d164",
                                        "glosses": [
                                            "A doubt or challenge about the truth, accuracy, or validity of a matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6ad1673-2efd-456e-87a4-62e408e3dfe9",
                                                "sense_id": "d6767c2f-ddbc-3cb7-989d-3a2806a9e913",
                                                "text": "His claim to the property has come under question."
                                            },
                                            {
                                                "example_id": "72f0a175-2518-4b19-bf6c-b5df054ac47e",
                                                "sense_id": "d6767c2f-ddbc-3cb7-989d-3a2806a9e913",
                                                "text": "The story is true beyond question."
                                            },
                                            {
                                                "example_id": "e96225fa-3a29-4927-94bb-933d7d74a7f3",
                                                "sense_id": "d6767c2f-ddbc-3cb7-989d-3a2806a9e913",
                                                "text": "He obeyed without question."
                                            },
                                            {
                                                "example_id": "c5ef3e1e-c583-41dd-8862-65ad6731738b",
                                                "sense_id": "d6767c2f-ddbc-3cb7-989d-3a2806a9e913",
                                                "text": "There arose a question between some of John's disciples and the Jews about purifying."
                                            },
                                            {
                                                "example_id": "c309dd1d-fad7-4e68-85d1-4326b5c2e3c2",
                                                "sense_id": "d6767c2f-ddbc-3cb7-989d-3a2806a9e913",
                                                "text": "It is to be to question, whether it be lawful for Christian princes or states to make an invasive war, only and simply for the propagation of the faith."
                                            },
                                            {
                                                "example_id": "8adb3af7-a613-4e3f-a9ab-9cb634d033d9",
                                                "sense_id": "d6767c2f-ddbc-3cb7-989d-3a2806a9e913",
                                                "text": "The pandemic has not only caused an immediate fall in ticket revenues for the world’s public transit networks—rail ridership in Barcelona, Moscow, Beijing and New York City at times plummeting 80%—in some cities it also has thrown into question the future of mass urban transportation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8412247-6d0e-3aee-a7f0-9a8477bdb145",
                                        "entry_id": "00a3c24f-1ce1-3521-8bac-98335361d164",
                                        "glosses": [
                                            "A proposal to a meeting as a topic for deliberation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ae0136-671e-41c6-b7d7-04e5919c8789",
                                                "sense_id": "f8412247-6d0e-3aee-a7f0-9a8477bdb145",
                                                "text": "I move that the question be put to a vote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d8ac383-0a0b-31bf-b1b8-6e3a6a3af669",
                                        "entry_id": "00a3c24f-1ce1-3521-8bac-98335361d164",
                                        "glosses": [
                                            "Interrogation by torture."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c142cf45-ed82-4ec8-9ccb-4dcbd8d2aa87",
                                                "sense_id": "6d8ac383-0a0b-31bf-b1b8-6e3a6a3af669",
                                                "text": "I, not at all ambitious of the crown of martyrdom, resolved to temporize: so that, when I was brought to the question the second time, I made a solemn recantation […]"
                                            },
                                            {
                                                "example_id": "a3187062-5ce2-4bad-959a-ec3b80d5730d",
                                                "sense_id": "6d8ac383-0a0b-31bf-b1b8-6e3a6a3af669",
                                                "text": "The Scottish privy council had power to put state prisoners to the question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb6c180-595e-30e0-8c99-35580855699f",
                                        "entry_id": "00a3c24f-1ce1-3521-8bac-98335361d164",
                                        "glosses": [
                                            "Talk; conversation; speech."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec9d4a9f-a37c-433a-8789-7787498d4e55",
                                                "sense_id": "9eb6c180-595e-30e0-8c99-35580855699f",
                                                "text": "Made she no verbal question?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "question",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f05a93d3-ff88-3367-bd27-3fd68e0c1a65",
                                        "entry_id": "8f41ffce-6a7d-3aad-a950-261a726a0b67",
                                        "glosses": [
                                            "To ask questions of; to interrogate; to ask for information."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f656ad53-8b92-438e-9e44-38d0abd707f2",
                                                "sense_id": "f05a93d3-ff88-3367-bd27-3fd68e0c1a65",
                                                "text": "Yet he lingered in Perryville with the determination of seeing Ruth, and questioning her about Helen Murray's letters."
                                            },
                                            {
                                                "example_id": "6ca29912-a872-4ab6-9ffa-913cfff47361",
                                                "sense_id": "f05a93d3-ff88-3367-bd27-3fd68e0c1a65",
                                                "text": "However, a Carlisle newspaper got hold of the story, and at the half-yearly meeting of the Caledonian Railway Company, held on March 17, 1863, a shareholder, Mr. Meiklem, questioned the Chairman, Lt.-Col. Salkeld, regarding a \"Chase of Engines,\" described in the newspaper article. The Chairman admitted that the statements made in the article were perfectly true."
                                            },
                                            {
                                                "example_id": "1e9c56ee-f42f-412e-8f82-50edf390f54c",
                                                "sense_id": "f05a93d3-ff88-3367-bd27-3fd68e0c1a65",
                                                "text": "Another former resident noticed the car because it was new and upscale and no one ever came back to question him. This points to serious flaws in the investigation from the beginning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c363e8e8-8870-3491-bb62-a633471299fc",
                                        "entry_id": "8f41ffce-6a7d-3aad-a950-261a726a0b67",
                                        "glosses": [
                                            "To raise doubts about; have doubts about."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb7db171-9648-4972-bcc3-ab00db65f42c",
                                                "sense_id": "c363e8e8-8870-3491-bb62-a633471299fc",
                                                "text": "Question things. I have the most fun when I'm writing questioning things that people do not question- the assumptions that everybody knows are true."
                                            },
                                            {
                                                "example_id": "79dfc51c-4fd2-4686-a087-792da953f43d",
                                                "sense_id": "c363e8e8-8870-3491-bb62-a633471299fc",
                                                "text": "He questioned South Korean claims that China is a major source of its pollution."
                                            },
                                            {
                                                "example_id": "44153681-2dec-4815-9fc1-eb0a484a81fc",
                                                "sense_id": "c363e8e8-8870-3491-bb62-a633471299fc",
                                                "text": "Isaacson reports that Musk’s fractured relationship with Jenna, who is trans, partly led to Musk’s rightward turn toward libertarianism and questioning what he considers the “woke-mind-virus, which is fundamentally antiscience, antimerit, and antihuman.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7efc53eb-3fed-3bc8-8926-1e956ce86fb0",
                                        "entry_id": "8f41ffce-6a7d-3aad-a950-261a726a0b67",
                                        "glosses": [
                                            "To ask a question or questions; inquire or seek to know; examine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9405c6ca-5b13-4198-9158-f128452200bf",
                                                "sense_id": "7efc53eb-3fed-3bc8-8926-1e956ce86fb0",
                                                "text": "He that questioneth much shall learn much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb48d31-dfa0-3b72-98fe-b04196703851",
                                        "entry_id": "8f41ffce-6a7d-3aad-a950-261a726a0b67",
                                        "glosses": [
                                            "To argue; to converse; to dispute."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843e279c-5c61-49ac-b0d0-46e5378cd0e6",
                                                "sense_id": "adb48d31-dfa0-3b72-98fe-b04196703851",
                                                "text": "I pray you, think you question with the Jew."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
