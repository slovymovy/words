                        ],
                        "examples": [
                            {
                                "example_id": "d371016f-954a-4202-90d1-33dee14a5690",
                                "sense_id": "c8a3652c-7553-3249-8972-11ba693ea169",
                                "text": "„Dann gab er ihm zweihundert Dinar, wohl wissend, dass das viel zu viel war.“"
                            },
                            {
                                "example_id": "48b952cc-2319-4668-89f2-3313fe619023",
                                "sense_id": "c8a3652c-7553-3249-8972-11ba693ea169",
                                "text": "„Er gab jedem jungen Aktivisten fünf jordanische Dinar, genug für ein neues Paar weiße Nikes, mit denen es sich im israelischen Kugelhagel gut laufen ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
