                "senses": [
                    {
                        "sense_id": "37fcc9bd-4fb2-343b-bf3e-80fea38b3e84",
                        "entry_id": "3cfd2a63-de13-3042-822f-b94bb18356ff",
                        "glosses": [
                            "To make feeble; to weaken."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7d8af4b3-cd21-49f0-bb16-018c4a21e8dc",
                                "sense_id": "37fcc9bd-4fb2-343b-bf3e-80fea38b3e84",
                                "text": "The American Dream suffered a debilitating effect after the subprime crisis."
                            },
                            {
                                "example_id": "7c1c35da-0ba0-4d47-9421-5651097b139e",
                                "sense_id": "37fcc9bd-4fb2-343b-bf3e-80fea38b3e84",
                                "text": "Twice, they found themselves behind, seemingly on their way out, and on both occasions they absolutely refused to let their lack of numbers debilitate them."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed6acbef-e1ce-4fc8-860e-6877ddf89945",
                        "source_entry_id": "3cfd2a63-de13-3042-822f-b94bb18356ff",
                        "source_sense_id": "37fcc9bd-4fb2-343b-bf3e-80fea38b3e84",
                        "source_sense_description": "to make feeble; to weaken",
