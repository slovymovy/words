                        "examples": [
                            {
                                "example_id": "c37edc24-e2db-4955-bc6b-4882efa130cd",
                                "sense_id": "669a83a1-465b-315d-bc96-11747e50c6fc",
                                "text": "W dzień jej skóra stawała się czerwonawobrązowa, a w nocy jasnopopielata"
                            },
                            {
                                "example_id": "b8420f86-311d-4861-9b4c-d8e21281c1f9",
                                "sense_id": "669a83a1-465b-315d-bc96-11747e50c6fc",
                                "text": "Spodnie jasnopopielate, szerokie, brudne i pomięte, buty jaskrawożółte i skarpetki kolorowe przesadnie"
                            }
                        ],
