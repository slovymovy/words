                                                "sense_id": "6a26ece7-ff7d-336d-9658-a507b7894133",
                                                "text": "Zavolejte mi na pevnou linku po osmé večer, to již budu doma."
                                            },
                                            {
                                                "example_id": "7d05a3c2-329a-40f1-8216-3440205fd383",
                                                "sense_id": "6a26ece7-ff7d-336d-9658-a507b7894133",
                                                "text": "Co mi zase chceš?"
                                            },
                                            {
                                                "example_id": "b5076437-f92c-405c-a262-b185f17001cb",
                                                "sense_id": "6a26ece7-ff7d-336d-9658-a507b7894133",
                                                "text": "Včera mi bylo málo, dneska je mi moc, jak se to stalo, nevím - každopádně jsem zas v blbým věku."
                                            },
                                            {
                                                "example_id": "478f456a-6a74-4696-aadf-24c2db73e32c",
                                                "sense_id": "6a26ece7-ff7d-336d-9658-a507b7894133",
                                                "text": "To je mi ale náhodička."
                                            }
                                        ]
                                    }
                                ]
                            }
