                    {
                        "sense_id": "303d5b08-b955-3af4-81e8-d3076d5706ce",
                        "entry_id": "6ea07205-382b-33b4-ab0e-368400833452",
                        "glosses": [
                            "A domestic rooster or cock, especially in fables and fairy tales."
                        ],
                        "tags": [
                            "archaic",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "b379b6d3-0274-4497-8537-a91a8b5485af",
                                "sense_id": "303d5b08-b955-3af4-81e8-d3076d5706ce",
                                "text": "When I did hear / The motley fool, thus moral on the time, / My lungs began to crow like chanticleer, / That fools should be so deep-contemplative[…]."
                            },
                            {
                                "example_id": "6e317728-7ac3-40be-b13d-edb88f9def2a",
                                "sense_id": "303d5b08-b955-3af4-81e8-d3076d5706ce",
                                "text": "It is happily some particular sense that unto cockes or chanticleares discovereth the morning and midnight houre, and moveth them to crow[…]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
