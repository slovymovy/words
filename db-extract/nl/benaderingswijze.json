                        "sense_id": "e2fd3fa4-ab69-315c-8b86-0266c40b8d7c",
                        "entry_id": "130fe11d-711e-395a-90ef-2a0b39c7ac0a",
                        "glosses": [
                            "manier waarop men iets op een voldoende nauwkeurige manier kan berekenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "998bd306-d424-490d-ba69-44ce5872c528",
                                "sense_id": "e2fd3fa4-ab69-315c-8b86-0266c40b8d7c",
                                "text": "Een paar jaar geleden ontdekten Richard Montgomery van ucsc en Alain Chenciner van l'Université Paris vn-Denis Diderot nog een stabiele periodieke oplossing voor het drielichamenprobleem, gebruikmakend van een afwijkende benaderingswijze."
                            }
                        ]
                    },
                    {
                        "sense_id": "b143545f-dd11-3346-a68f-6358ab51408c",
                        "entry_id": "130fe11d-711e-395a-90ef-2a0b39c7ac0a",
                        "glosses": [
                            "manier waarop men een zaak kan aanpakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0191584-545d-4d19-ab17-93b3e38c1c1c",
                                "sense_id": "b143545f-dd11-3346-a68f-6358ab51408c",
                                "text": "Veel van de benaderingswijzen die in dit boek de revue passeren, tonen in feite verschillende pogingen om deze blik op de geschiedenis te nuanceren."
                            },
                            {
                                "example_id": "442da667-3ddd-4772-bf08-998bd503279f",
                                "sense_id": "b143545f-dd11-3346-a68f-6358ab51408c",
                                "text": "\"We hebben nog twee motoren. Een motor waarmee drie races zijn gereden en een splinternieuwe motor. We zullen alles in het werk stellen om ze controleren voor de komende races. Dat gezegd zijnde hanteren we die benaderingswijze echter al. We controleren echt alles. We zullen alles doen om het probleem te onderzoeken en een herhaling ervan te voorkomen, aldus Toto Wolff."
                            }
                        ]
                    }
