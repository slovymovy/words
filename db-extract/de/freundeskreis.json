                ],
                "senses": [
                    {
                        "sense_id": "0d296d43-0a24-3d13-bf72-e4db0263473e",
                        "entry_id": "2b5f3766-a52e-33c5-859a-d78b292c89b9",
                        "glosses": [
                            "Kreis von Menschen, mit denen man eine Freundschaft hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3545a3b7-408a-4e84-b973-4d54139b6fb0",
                                "sense_id": "0d296d43-0a24-3d13-bf72-e4db0263473e",
                                "text": "Die Feier fand im engsten Freundeskreis statt."
                            },
                            {
                                "example_id": "b9db19a6-869c-4e70-874a-1e7f1d1cbe5d",
                                "sense_id": "0d296d43-0a24-3d13-bf72-e4db0263473e",
                                "text": "„Die Gemeinschaft hatte ihren Mittelpunkt verloren, die schöpferische Atmosphäre, die den Freundeskreis verbunden hatte, war unwiederbringlich.“"
                            },
                            {
                                "example_id": "04184b77-bdd0-4803-ba7f-1d73f61948fb",
                                "sense_id": "0d296d43-0a24-3d13-bf72-e4db0263473e",
                                "text": "„Im Freundeskreis werden wir uns von diesem Tag erzählen.“"
                            },
                            {
                                "example_id": "3a241e6e-42aa-47c7-b4e0-7ffde7ab6b10",
                                "sense_id": "0d296d43-0a24-3d13-bf72-e4db0263473e",
                                "text": "„Ich habe das Thema Sprache schon öfter im Freundeskreis diskutiert, nicht nur mit Hakan, sondern auch mit Ranjid und Francesco.“"
                            },
                            {
                                "example_id": "7e18f056-c88d-4641-ad45-33a93ea6d66b",
                                "sense_id": "0d296d43-0a24-3d13-bf72-e4db0263473e",
                                "text": "„Mein männlicher Freundeskreis bestand einzig und allein aus George, vielleicht weil die Klasse der Männer, zu der wir gehören, ohnehin nur sehr klein ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
