                                "target_senses": [
                                    {
                                        "sense_id": "dba8c40d-74c8-3838-a9ab-94141d873ebb",
                                        "entry_id": "47712073-f6e0-34af-83f8-51b3e13d5158",
                                        "glosses": [
                                            "bequem und gemütlich machen, indem eine weiche Schicht (Polster) hinzugefügt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0837fb6c-e913-4473-8a9f-241491edb63f",
                                                "sense_id": "dba8c40d-74c8-3838-a9ab-94141d873ebb",
                                                "text": "Der Polsterer polstert den Sessel."
                                            },
                                            {
                                                "example_id": "5b85266d-4ef7-48fa-8519-b3d680342bb0",
                                                "sense_id": "dba8c40d-74c8-3838-a9ab-94141d873ebb",
                                                "text": "Der Vogel polstert sein Nest mit Moos."
                                            },
                                            {
                                                "example_id": "599468f8-76eb-45d3-81b7-2d07a73be069",
                                                "sense_id": "dba8c40d-74c8-3838-a9ab-94141d873ebb",
                                                "text": "„Dann konnte Shanna um die Mittagszeit draußen auf dem umgefallenen Baum sitzen, den die Männer stets vorsorglich mit einem Fell polsterten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5d3544f-d006-32e0-8d0b-764ee69946ea",
                                        "entry_id": "47712073-f6e0-34af-83f8-51b3e13d5158",
                                        "glosses": [
                                            "mit einer Sicherung, einem Puffer (Polster) versehen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd214c85-3431-4dbb-9720-368261257b2f",
                                                "sense_id": "c5d3544f-d006-32e0-8d0b-764ee69946ea",
                                                "text": "„Obwohl ich in der Sprachschule Colón nahe der Alster und des Jungfernstiegs Englisch, Deutsch und Spanisch unterrichtete, um mich finanziell etwas zu polstern, legte ich es hauptsächlich über Stipendien darauf an, meinen Vater von Kosten zu entlasten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
