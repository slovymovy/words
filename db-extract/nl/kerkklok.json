                ],
                "senses": [
                    {
                        "sense_id": "e660fdae-6b6c-3e7f-ab77-0ebc5e0574a4",
                        "entry_id": "d1ad87f3-f7b4-398d-a572-6e0385046342",
                        "glosses": [
                            "een bel in de toren van een kerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e822167-47fe-4d15-a264-f23bfd1c30cc",
                                "sense_id": "e660fdae-6b6c-3e7f-ab77-0ebc5e0574a4",
                                "text": "Je kan de kerkklok zelfs hier helemaal horen."
                            },
                            {
                                "example_id": "28dfe61c-6a62-40f8-aec0-e1780ccfe1b5",
                                "sense_id": "e660fdae-6b6c-3e7f-ab77-0ebc5e0574a4",
                                "text": "Op zondagochtend fietste ik richting onbekende kerkklokken om te zien of de gemeente en de sfeer daar iets voor mij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d76e04d-eff8-3737-9141-5141eae14153",
                        "entry_id": "d1ad87f3-f7b4-398d-a572-6e0385046342",
                        "glosses": [
                            "uurwerk op een klokkentoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc7cad11-de42-48c4-b9d7-5bba4c5807a2",
                                "sense_id": "3d76e04d-eff8-3737-9141-5141eae14153",
                                "text": "Door de ramen van de gang kan ik juist op de kerkklok kijken, en tot m'n grote verlichting zie ik dat 't nog maar vijf minuten voor drie meer is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a705db69-84ac-4caa-ae89-e45f41aa4818",
                        "source_entry_id": "d1ad87f3-f7b4-398d-a572-6e0385046342",
                        "source_sense_id": "e660fdae-6b6c-3e7f-ab77-0ebc5e0574a4",
                        "source_sense_description": "een bel in de toren van een kerk",
                        "target_lang_word": "Kirchenglocke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirchenglocke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                                        "entry_id": "bbb25d9b-b4dd-39d1-99ce-80d21c171343",
                                        "glosses": [
                                            "Glocke, die zum Geläut einer Kirche gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "125195a8-5eae-4003-8a0e-7cc0426045ca",
                                                "sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                                                "text": "„Außerdem hatte Schneedorf ja seine mächtig tönenden Kirchenglocken, deren Ruf, wenn es zum Beispiel irgendwo brannte, auch noch im entferntesten Einödhof gehört wurde.“"
                                            },
                                            {
                                                "example_id": "162d85d9-17ed-45f6-b17f-bcf306bc74e5",
                                                "sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                                                "text": "„Entfernt nahm ich die Schläge einer Kirchenglocke wahr.“"
                                            },
                                            {
                                                "example_id": "0fd343a2-a19a-450d-a34c-005b1196e11e",
                                                "sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                                                "text": "„In der Ferne läuten Kirchenglocken.“"
                                            },
                                            {
                                                "example_id": "6fa19f07-3d15-490e-8697-51ed3521334b",
                                                "sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                                                "text": "„Die Kirchenglocke schlägt sechs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "593a3440-1730-4799-ab7d-7b76f222cf05",
                        "source_entry_id": "d1ad87f3-f7b4-398d-a572-6e0385046342",
