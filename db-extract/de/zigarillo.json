                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cigarillo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "251b484f-60a4-32a0-b408-4d76255fcdb3",
                                        "entry_id": "87115f8e-9a5d-3373-a860-83311998a861",
                                        "glosses": [
                                            "A thin cigar, differing from a cigarette in being wrapped with tobacco leaves rather than paper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baf6a819-ba3c-4905-956f-7934ef5f563f",
                        "source_entry_id": "754d537e-40c5-383d-89b1-182c1448eba1",
                        "source_sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                        "source_sense_description": "kurze, dünne Zigarre",
                        "target_lang_word": "cigarillo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cigarillo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                                        "entry_id": "181e9ab6-7ce6-3e20-98d0-ad4e821fb835",
                                        "glosses": [
                                            "Petit cigare d’une taille proche de celle de la cigarette, cigarette où le papier est remplacé par une feuille de tabac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96709026-86ce-4c47-a359-7779a8d355a1",
                                                "sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                                                "text": "Le brun à tête de bélier alluma un cigarillo dont il tirait des bouffées nerveuses. Il se tourna vers nous.\n— Excusez-moi… Le bébé…\nIl nous désignait en souriant le cigarillo qu’il écrasa dans le cendrier.\n— La fumée, c’est mauvais pour les bébés, nous dit-il."
                                            },
                                            {
                                                "example_id": "8478b2a6-153b-4541-b81c-f6e3b5b725b1",
                                                "sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                                                "text": "L'amertume un rien vénéneuse du cigarillo est une chose à lui."
                                            },
                                            {
                                                "example_id": "cb5aab6c-47e9-437e-b411-f9a7f69acebf",
                                                "sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                                                "text": "Le cigarillo, c’est la vraie solitude, une façon sournoise de se montrer bougon dans le plaisir."
                                            },
                                            {
                                                "example_id": "4600646c-3361-4da3-8f66-b5b7802f0d6d",
                                                "sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                                                "text": "L’entourage trouve l’odeur infecte, et l’on pense de même quand quelqu’un fume le cigare ou le cigarillo devant soi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a26f19dc-5bab-4c4c-9495-07569926beed",
                        "source_entry_id": "754d537e-40c5-383d-89b1-182c1448eba1",
