                ],
                "senses": [
                    {
                        "sense_id": "91581205-cd67-3bd6-8901-f1397c122f69",
                        "entry_id": "e5421b08-ed64-39db-b8e0-718ffa27179d",
                        "glosses": [
                            "Faire perdre son statut noble à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f5de896-c3b1-4e74-92fa-c85f9345c5c1",
                                "sense_id": "91581205-cd67-3bd6-8901-f1397c122f69",
                                "text": "Louis XIV a désannobli un comte lyonnais parce que le grand-père de ce comte n’avait pas été fidèle à Louis XIII."
                            },
                            {
                                "example_id": "c48926af-32ec-4d7b-8ecd-57cf45fec033",
                                "sense_id": "91581205-cd67-3bd6-8901-f1397c122f69",
                                "text": "Ainsi la clause de rétention de foi, pour être régulière, pour désannoblir le domaine aliéné, pour opérer un véritable jeu de fief, doit avoir deux parties; l’une, qui est la plus essentielle, relative à la foi; l’autre, qui est plus de précaution & de style, relative à l’hommage."
                            }
                        ]
                    }
                ],
