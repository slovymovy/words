                "senses": [
                    {
                        "sense_id": "08a4f8da-2ec1-391b-b1fd-11bd52d9db37",
                        "entry_id": "48c90bf4-021e-39f6-80ef-29b1a4385207",
                        "glosses": [
                            "van of over de tijd nadat de communistische partij de baas was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28ee5628-3cfa-4f21-bbe5-368d38319b87",
                                "sense_id": "08a4f8da-2ec1-391b-b1fd-11bd52d9db37",
                                "text": "Ik zou voor het oog van de wereld het gordijn wegtrekken dat de toekomst verborg die de reactionairen voor Rusland in petto hadden. Een postcommunistisch land zou worden omgevormd tot een fel-nationalistisch land, met als gevolg dat de ontluikende democratie in Rusland zou worden vertrapt en de Koude Oorlog alle kansen kreeg weer op te laaien."
                            },
                            {
                                "example_id": "69c47954-1317-4066-ac49-a745dafdf960",
                                "sense_id": "08a4f8da-2ec1-391b-b1fd-11bd52d9db37",
                                "text": "Wij willen de omwenteling nu realiseren en niet blijven hangen in een post-communistisch bestel. Een door de verkiezingsuitslag niet gerechtvaardigde positie van de communisten brengt instabiliteit."
                            }
                        ]
                    },
                    {
                        "sense_id": "abe3ab70-c59d-3eb8-a610-98f8da74cf67",
                        "entry_id": "48c90bf4-021e-39f6-80ef-29b1a4385207",
                        "glosses": [
                            "met linkse opvattingen die verder gaan dan het communisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dec831b-89aa-4e89-b5e8-0bbb5e1a5fe2",
                                "sense_id": "abe3ab70-c59d-3eb8-a610-98f8da74cf67",
                                "text": "De PSOE (Renovado) van Félipe Gonzalez stort zich alleen in de verkiezingsstrijd. De Fede la Jons, extreem rechts, zit in de Allianza Nacional del 18 de Julio, een puur francistische coalitie; de Fe de la Jons (Autentica), een onlangs gelegaliseerde extreemlinkse partij, die zichzelf als postcommunistisch ziet, gaat ook los van alle partijen de verkiezingsstrijd in."
                            }
                        ]
                    }
