                    {
                        "translation_id": "c53b6f99-3298-4533-b191-c9ef2053561c",
                        "source_entry_id": "a9edb8a6-3d1b-3e89-be59-247f896f7422",
                        "target_lang_word": "Pergament",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pergament",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc8e245a-ff49-3311-8819-1b14f4e05911",
                                        "entry_id": "e2c4fb6b-622d-328e-99f8-bb76db8873aa",
                                        "glosses": [
                                            "zum Schreiben bearbeitete Tierhaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f205f820-426c-4380-9239-d28880c6d422",
                                                "sense_id": "cc8e245a-ff49-3311-8819-1b14f4e05911",
                                                "text": "Sehr wertvolle Bücher wurden früher mit Pergament eingebunden."
                                            },
                                            {
                                                "example_id": "4e797efc-ab1e-49ed-a3e2-7917b5f3fd02",
                                                "sense_id": "cc8e245a-ff49-3311-8819-1b14f4e05911",
                                                "text": "„Das Pergament der Handschriften wurde aus Kalbs- oder Schafsleder gewonnen.“"
                                            },
                                            {
                                                "example_id": "db1d7fe7-11c8-4a3b-9c0a-73c1289d1b5c",
                                                "sense_id": "cc8e245a-ff49-3311-8819-1b14f4e05911",
                                                "text": "„Er feuchtete mit der Zunge die Fingerspitze und mit der Fingerspitze vorsichtig eine Stelle des Pergaments der Fensterfüllung an, bis sich die Stelle erweichte und zum Guckloch auftat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b5688118-f188-32be-9cd5-8284be2bdad0",
                                        "entry_id": "e2c4fb6b-622d-328e-99f8-bb76db8873aa",
                                        "glosses": [
                                            "beschriebene Tierhaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdcbf007-c3a2-410e-96aa-902f7300aa4d",
                                                "sense_id": "b5688118-f188-32be-9cd5-8284be2bdad0",
                                                "text": "In der Bibliothek werden auch alte Pergamente ausgestellt."
                                            },
                                            {
                                                "example_id": "5e362cab-cb95-4f77-9549-1349c65ad386",
                                                "sense_id": "b5688118-f188-32be-9cd5-8284be2bdad0",
                                                "text": "„Die angebliche Kraft des Pergamentes bestand darin, dem Träger die Herzen aller Frauen zuzuwenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
