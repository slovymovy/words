        "fr-extract.jsonl": [
            {
                "entry_id": "9e6f341b-5cf2-38d8-88a5-0497eb091231",
                "word": "praxis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b10e6f87-c867-35e2-ba02-ec4c12a59299",
                        "entry_id": "9e6f341b-5cf2-38d8-88a5-0497eb091231",
                        "glosses": [
                            "Activité codifiée, manière générique de penser la transformation de l'environnement."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e111d701-71f6-341d-bec5-49b95904b2bc",
                        "entry_id": "9e6f341b-5cf2-38d8-88a5-0497eb091231",
                        "glosses": [
                            "Ensemble des activités matérielles et intellectuelles des hommes qui contribuent à la transformation de la réalité sociale."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "95afd6ce-de79-34af-a3f8-7ecea186f583",
                        "entry_id": "9e6f341b-5cf2-38d8-88a5-0497eb091231",
                        "glosses": [
                            "Pratique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3dc4a0-70c1-416d-8b31-73cedc0212bf",
                                "sense_id": "95afd6ce-de79-34af-a3f8-7ecea186f583",
                                "text": "Un ami qui … m'a renvoyé à mes vraies forces. Ces forces qui logent davantage dans le monde intellectuel que dans la praxis."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2235e0b-fd66-37c9-9bea-8719d30ec609",
                        "entry_id": "9e6f341b-5cf2-38d8-88a5-0497eb091231",
                        "glosses": [
                            "Action dont l'objet est le sujet lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad77e7bc-5501-46e2-9efa-3240dc7cc567",
                                "sense_id": "f2235e0b-fd66-37c9-9bea-8719d30ec609",
                                "text": "… la finalité, toute mystique, de la praxis monastique consiste à faire dès maintenant l'expérience de la vie céleste."
                            }
                        ]
                    },
                    {
                        "sense_id": "07af76dd-2d0b-3f9b-90d2-5dc2e1dc1b38",
                        "entry_id": "9e6f341b-5cf2-38d8-88a5-0497eb091231",
                        "glosses": [
                            "Activité psychique tournée vers un but, pratiquée pendant une psychanalyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad12c2fe-6ee5-4495-9379-2d61cd9e4311",
                                "sense_id": "07af76dd-2d0b-3f9b-90d2-5dc2e1dc1b38",
                                "text": "[…] l'art de l'analyse n'est pas vain ou gratuit. Il doit au contraire faire appel à une capacité à laisser se construire la liberté psychique du patient dans une autonomie entourée de bienveillance critique. Je ne suis pas analyste ni analysant, mais je n'ai nulle peine à imaginer les années de pratique éclairée que la maturation d'une telle praxis peut nécessiter. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 433)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed1ecea6-9666-48ef-a675-4b326ea65136",
                        "source_entry_id": "9e6f341b-5cf2-38d8-88a5-0497eb091231",
                        "target_lang_word": "Praxis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Praxis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4957b9a8-84d3-3471-b61a-80948b23c690",
                                        "entry_id": "f00252f7-a821-38a9-8324-31d1d85bbbb0",
                                        "glosses": [
                                            "tatsächliche, angewandte Ausübung; Summe von (sozialen, kulturellen) Handlungen und Handlungsgewohnheiten"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0addff6a-e23a-42ec-8560-b3fb95088a60",
                                                "sense_id": "4957b9a8-84d3-3471-b61a-80948b23c690",
                                                "text": "Die Praxis hat gezeigt, dass nicht alle Theorien nützlich sind."
                                            },
                                            {
                                                "example_id": "6d72a349-7523-479f-96f2-f3e943e20a27",
                                                "sense_id": "4957b9a8-84d3-3471-b61a-80948b23c690",
                                                "text": "Die Untersuchung sozialer Praktiken gehört zum Aufgabenbereich der Kulturwissenschaften."
                                            },
                                            {
                                                "example_id": "591da9a3-f0c9-4b11-9a41-f16fd743c973",
                                                "sense_id": "4957b9a8-84d3-3471-b61a-80948b23c690",
                                                "text": "„Er konnte sich sogar über einen Misserfolg freuen, denn da der Misserfolg ja nur daher rührte, dass man sich in der Praxis nicht streng genug an seine Theorie gehalten hatte, so war er auch nur ein Beweis für die Richtigkeit seiner Theorie.“"
                                            },
                                            {
                                                "example_id": "238e071c-65d8-42ca-9c87-94e4662e3b5b",
                                                "sense_id": "4957b9a8-84d3-3471-b61a-80948b23c690",
                                                "text": "„Hier zeigt sich das Dilemma in der Implementierung von Leitlinien, häufig ist die Umsetzung in der Praxis nur sehr zögerlich, trotz eines hohen Maßes an Akzeptanz.“"
                                            },
                                            {
                                                "example_id": "c9bd2b94-18b4-447f-8dc2-15579e529d30",
                                                "sense_id": "4957b9a8-84d3-3471-b61a-80948b23c690",
                                                "text": "„In der Arztpraxis ist das übliche Praxis, vor der Praxis ist das strafbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd64add1-fa0c-33d1-9bbb-07db28115168",
                                        "entry_id": "f00252f7-a821-38a9-8324-31d1d85bbbb0",
                                        "glosses": [
                                            "eingeführte Vorgehensweise; Art und Weise, wie etwas Bestimmtes getan wird, wie mit einer Sache umgegangen wird"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2addbdc-b323-481e-87eb-36a23dd06aab",
                                                "sense_id": "cd64add1-fa0c-33d1-9bbb-07db28115168",
                                                "text": "„Im indischen Kulturraum ist es gängige Praxis, besonders verehrten Personen, aber auch Tieren, Pflanzen oder Phänomenen in der Natur ‚göttliche‘ oder ‚überirdische‘ Attribute zuzusprechen.“"
                                            },
                                            {
                                                "example_id": "2b6c47a6-d05a-43fc-97c5-04d327822cf4",
                                                "sense_id": "cd64add1-fa0c-33d1-9bbb-07db28115168",
                                                "text": "„Nicht nur in der Politik, sondern auch in der geschäftlichen Praxis lautet das Motto: ‚zuerst versuchen, möglichst alles intern zu regeln‘.“"
                                            },
                                            {
                                                "example_id": "13d8ee9e-6a10-4d99-9d39-9b589cd6de7b",
                                                "sense_id": "cd64add1-fa0c-33d1-9bbb-07db28115168",
                                                "text": "„Das war noch vor der Einführung von Speicheltests und anderen Methoden, mit denen künstlich aufgeputschte Pferde entlarvt werden sollten, zu einer Zeit, als Doping noch eine weitverbreitete Praxis war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "07533b9c-d6f6-36a9-87b5-527b16af51c9",
                                        "entry_id": "f00252f7-a821-38a9-8324-31d1d85bbbb0",
                                        "glosses": [
                                            "(Berufs-)Erfahrung, die durch [1] gewonnen oder errungen wird/wurde"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71e75a75-ea3f-4ab9-8e75-0b7bbc1dfd92",
                                                "sense_id": "07533b9c-d6f6-36a9-87b5-527b16af51c9",
                                                "text": "Bei deiner Praxis sollte dich der Betrieb auf jeden Fall einstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "000a9432-fd44-3b5f-984c-c94a40224853",
                                        "entry_id": "f00252f7-a821-38a9-8324-31d1d85bbbb0",
                                        "glosses": [
                                            "Geschäftsräume eines Arztes oder Juristen"
                                        ],
                                        "tags": [
                                            "Plural „Praxen“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "156d0ff0-02d4-445a-80ad-f984d5941ef2",
                                                "sense_id": "000a9432-fd44-3b5f-984c-c94a40224853",
                                                "text": "„Angehende Supervisoren haben ein Studium hinter sich, langjährige Praxis und methodische Fortbildung.“"
                                            },
                                            {
                                                "example_id": "d07118a1-3e09-4589-a252-7407a7c17097",
                                                "sense_id": "000a9432-fd44-3b5f-984c-c94a40224853",
                                                "text": "Patienten warteten im Wartezimmer der Praxis des Arztes auf ihre Behandlung."
                                            },
                                            {
                                                "example_id": "cdb268dc-32b3-49ab-8af6-efdc6b8ad371",
                                                "sense_id": "000a9432-fd44-3b5f-984c-c94a40224853",
                                                "text": "„Bis zu 80 Stunden pro Woche ist sie in der Praxis.“"
                                            },
                                            {
                                                "example_id": "592a76c9-6fb1-404e-ae4d-e180a4041c2d",
                                                "sense_id": "000a9432-fd44-3b5f-984c-c94a40224853",
                                                "text": "„Es ist so still wie die Praxis eines Arztes.“"
                                            },
                                            {
                                                "example_id": "c837904c-4caa-425a-8f76-126e6ccb013d",
                                                "sense_id": "000a9432-fd44-3b5f-984c-c94a40224853",
                                                "text": "„In der Arztpraxis ist das übliche Praxis, vor der Praxis ist das strafbar.“"
                                            },
                                            {
                                                "example_id": "12ed071c-41d9-4e60-a6ed-4a1ee36671c0",
                                                "sense_id": "000a9432-fd44-3b5f-984c-c94a40224853",
                                                "text": "„Seine Praxis hatte er längst an einen anderen Arzt abgeben müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5868674f-c762-3c68-b98e-8822b13dfd02",
                                        "entry_id": "f00252f7-a821-38a9-8324-31d1d85bbbb0",
                                        "glosses": [
                                            "Geschäftszeiten eines Arztes oder Juristen; Sprechstunde"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "930bdf8f-2a38-486b-8ebe-d5b5e67d70c2",
                                                "sense_id": "5868674f-c762-3c68-b98e-8822b13dfd02",
                                                "text": "Wir öffnen eine halbe Stunde vor Beginn der Praxis."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
