                        "glosses": [
                            "относящийся к излучению (чаще ультрафиолетовому или инфракрасному)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "255a674a-d65b-45c1-9e5b-b62f5863eff0",
                        "source_entry_id": "3250c18f-21d0-39f4-8d19-4e16b08a75e6",
                        "source_sense_id": "b5f0bf3f-f48d-30b4-ac4f-3c7ac358f0c9",
                        "target_lang_word": "actinic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actinic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "247ceea4-c2dd-35de-ba1c-0f2fea226821",
                                        "entry_id": "a2a4bb6f-4574-350a-b99a-f6540f03065d",
                                        "glosses": [
                                            "Related to radiation; used most often in reference to light, especially in the ultraviolet range."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5237729-6c34-3cef-8702-d7f8cdf5401f",
                                        "entry_id": "a2a4bb6f-4574-350a-b99a-f6540f03065d",
                                        "glosses": [
                                            "Harsh and bright, especially blindingly so."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0077cbf2-3fe2-4d18-a4c3-a73e899348a7",
                                                "sense_id": "a5237729-6c34-3cef-8702-d7f8cdf5401f",
                                                "text": "He bounded over cresting waves that shone in the actinic glare."
                                            },
                                            {
                                                "example_id": "153277ea-4e5f-4d73-af9e-93fdd45d7c2f",
                                                "sense_id": "a5237729-6c34-3cef-8702-d7f8cdf5401f",
                                                "text": "And what actinic, mind-wrenching form could the countermeme take? How could human hands assemble something so devastatingly powerful and hold it steady; what human mind could wield it without exploding from the inside out?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6302bc4a-69d9-37b1-8b13-5786f80c4065",
                                        "entry_id": "a2a4bb6f-4574-350a-b99a-f6540f03065d",
                                        "glosses": [
                                            "Caused by extensive exposure to ultraviolet light."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d124516b-020a-4518-bc65-4ea678602b0f",
                                                "sense_id": "6302bc4a-69d9-37b1-8b13-5786f80c4065",
                                                "text": "In medicine, actinic keratoses usually occur in sundamaged skin and exhibit hyperkeratosis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14551305-291b-31b4-b1c7-f63431f751e2",
                                        "entry_id": "a2a4bb6f-4574-350a-b99a-f6540f03065d",
                                        "glosses": [
                                            "Of or relating to actinism, the range of photochemical effects produced by exposure to electromagnetic radiation, particularly sunlight."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e39787ab-7be1-48de-95a4-6bf8b5bd9865",
                                                "sense_id": "14551305-291b-31b4-b1c7-f63431f751e2",
                                                "text": "It should be borne in mind that the actinic power of the sun is subject to considerable variations, due to its elevation above the horizon."
                                            },
                                            {
                                                "example_id": "e80903a6-ac8f-4fcb-9b28-a6208b69af2b",
                                                "sense_id": "14551305-291b-31b4-b1c7-f63431f751e2",
                                                "text": "I got my picture, and it turned out quite a good one, despite the rather poor light which at that time of day, 7 p.m., was lacking in actinic value."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db2b27eb-3766-334d-999d-a0f0d7c72762",
                                        "entry_id": "a2a4bb6f-4574-350a-b99a-f6540f03065d",
                                        "glosses": [
                                            "Composed of actin."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
