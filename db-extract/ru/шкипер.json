                        "sense_id": "83624373-0e16-325d-89a0-bea45b60e38d",
                        "entry_id": "aea17fb4-da62-3e37-8426-0641926cd0de",
                        "glosses": [
                            "skipper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "896147a8-b0eb-4ee4-8dab-8604719d9ca4",
                                "sense_id": "83624373-0e16-325d-89a0-bea45b60e38d",
                                "text": "Мы посиде́ли до ве́чера в оте́ле, бесе́дуя с седы́м америка́нским шки́пером, кото́рый подсе́л к нам и разговори́лся о себе́.",
                                "translation": "We sat in the hotel all evening, chatting with a gray-haired American sea captain who sat down next to us and talked about himself.",
                                "english": "We sat in the hotel all evening, chatting with a gray-haired American sea captain who sat down next to us and talked about himself."
                            }
                        ]
                    }
