                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chemikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f19007fb-d53e-3e74-925a-36ccaa4f928e",
                                        "entry_id": "0b62a451-465a-38f1-9fb5-fbd83457f1a2",
                                        "glosses": [
                                            "weibliche Person, die (Fach-)Kenntnisse im Bereich Chemie besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd76ccf7-b258-4de0-acbd-0af6912643d1",
                                                "sense_id": "f19007fb-d53e-3e74-925a-36ccaa4f928e",
                                                "text": "„Die von Ida Rolf, früher Chemikerin am Rockefeller Institute, entwickelte Technik der »strukturellen Integration« wird heute allgemein kurz »Rolfing« genannt.“"
                                            },
                                            {
                                                "example_id": "5d5f8f36-926b-4b87-921a-4f95b95b9626",
                                                "sense_id": "f19007fb-d53e-3e74-925a-36ccaa4f928e",
                                                "text": "„Diese Temperatur halten Milben ebenso wenig aus wie ein trockenes Raumklima: «Halten Sie die Luftfeuchtigkeit im Schlafzimmer möglichst unter 50 Prozent», empfiehlt Silvia Frank, Chemikerin beim Ortsverband des Deutschen Hausfrauenbunds in Karlsruhe.“"
                                            },
                                            {
                                                "example_id": "79535a46-8390-44cb-9eb0-538084e70330",
                                                "sense_id": "f19007fb-d53e-3e74-925a-36ccaa4f928e",
                                                "text": "„Bei einem internationalen Forschungskongreß hielt eine charmante französische Chemikerin das Hauptreferat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
