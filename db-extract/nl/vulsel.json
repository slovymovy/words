                "senses": [
                    {
                        "sense_id": "61f1d0df-3ab3-3191-aa18-45aec4d3be54",
                        "entry_id": "01b1cc53-1eb9-3848-ade4-10d303445d37",
                        "glosses": [
                            "materiaal waarmee men een hol voorwerp (omhulsel) vol kan maken, maar wat zelf vaak zonder veel belang is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "251dc5ff-5571-4aba-97e4-ceac8e3cdd91",
                                "sense_id": "61f1d0df-3ab3-3191-aa18-45aec4d3be54",
                                "text": "Ten Cate gaat samenwerken met GreenFields om een nieuw kunstgrassysteem te ontwikkelen. Deze ‘vierde generatie kunstgras’ bestaat niet meer uit losse componenten (vezel, rug, vulsel en onderlaag) maar is volledig geïntegreerd. Voor dit kunstgras is geen instrooisel meer nodig om voldoende schokabsorberend te zijn."
                            },
                            {
                                "example_id": "be9923fa-9485-4aa2-887b-865617077482",
                                "sense_id": "61f1d0df-3ab3-3191-aa18-45aec4d3be54",
                                "text": "Maar in elk gedicht zijn er dan weer één of twee regels die je door hun formulering onherroepelijk bijblijven. „Soms lijkt het of al dat vulsel er bij hem alleen maar is om die ene regel te stutten. Of hij speciaal maar wat aanbroddelt om een paar mooie regels beter te laten uitkomen. Bloem kan genadeloos grossieren in gemeenplaatsen en ouwewijventheewatergeleuter...”"
                            },
                            {
                                "example_id": "ada5a5b1-6a17-480e-8d05-f1718bac459a",
                                "sense_id": "61f1d0df-3ab3-3191-aa18-45aec4d3be54",
                                "text": "Een groeiend aantal commentatoren moppert dat de nieuwe continenten volledig gestagneerd zijn. Exotisch en verfrissend zijn ze niet meer, ze zijn het vulsel in afwachting van de volgende ronde met de échte voetballanden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91adb352-b6c7-4c62-94a2-0bc77941d6a9",
                        "source_entry_id": "01b1cc53-1eb9-3848-ade4-10d303445d37",
                        "source_sense_id": "61f1d0df-3ab3-3191-aa18-45aec4d3be54",
                        "target_lang_word": "filler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
