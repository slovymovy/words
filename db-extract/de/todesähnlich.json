                ],
                "senses": [
                    {
                        "sense_id": "a15d935a-aa18-3fae-b109-92822ef7f0e8",
                        "entry_id": "37da4d85-a5ef-3c49-b75b-53f8ab06cd65",
                        "glosses": [
                            "dem Tod ähnlich, vom Tod kaum unterscheidbar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8aaf909-3d19-4f34-8688-2dc2ddfe4c8a",
                                "sense_id": "a15d935a-aa18-3fae-b109-92822ef7f0e8",
                                "text": "„Dann sank ich ausgestreckt auf den Steinboden nieder, mein Verstand entflammt von einzigartigen Überlegungen, die selbst meine todesähnliche Erschöpfung nicht zu bannen vermochte.“"
                            },
                            {
                                "example_id": "0b868b9f-dfd5-498c-8b46-6ff7c5eb2ab9",
                                "sense_id": "a15d935a-aa18-3fae-b109-92822ef7f0e8",
                                "text": "„Zeitweise versank er in eine todesähnliche Ohnmacht: Ein schwarzes Leichentuch schien sich auf ihn herabzusenken, doch noch immer peinigte die vernichtende, sengende Strahlung seine umnachteten Sinne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
