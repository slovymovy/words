                "forms": [],
                "senses": [
                    {
                        "sense_id": "134ea065-68b4-3da0-a754-5fbb1dcbb544",
                        "entry_id": "561c78f5-3c7e-331b-8f60-3066332e6b4f",
                        "glosses": [
                            "überall"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "05986ccf-d35e-47dc-8d6c-1b0e57883c69",
                                "sense_id": "134ea065-68b4-3da0-a754-5fbb1dcbb544",
                                "text": "Allenthalben regt sich der Wunsch nach nationaler Selbstbestimmung."
                            },
                            {
                                "example_id": "e0ad8a61-b91f-459d-8118-63032c43cc44",
                                "sense_id": "134ea065-68b4-3da0-a754-5fbb1dcbb544",
                                "text": "„In der Kinderaufzucht, bei der Disziplinierung der Soldaten und dem Gefügigmachen der Zuchthäusler setze es allenthalben Hiebe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75611437-33ec-4ff4-b779-76aeda171f4e",
                        "source_entry_id": "561c78f5-3c7e-331b-8f60-3066332e6b4f",
                        "source_sense_id": "134ea065-68b4-3da0-a754-5fbb1dcbb544",
                        "source_sense_description": "veraltend: überall",
                        "target_lang_word": "everywhere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "everywhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a90421b6-1db3-3478-96e3-3b12b330b2e0",
                                        "entry_id": "b1f81fe1-fbee-38af-8ddf-babb3d612977",
                                        "glosses": [
                                            "In or to all locations under discussion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62881220-2dfb-47e1-8ea5-ccb1d001883a",
                                                "sense_id": "a90421b6-1db3-3478-96e3-3b12b330b2e0",
                                                "text": "He delivers the mail everywhere on this street."
                                            },
                                            {
                                                "example_id": "6350fdc7-f341-444f-89f6-7f77487f0560",
                                                "sense_id": "a90421b6-1db3-3478-96e3-3b12b330b2e0",
                                                "text": "We went everywhere at the school - we talked to all the teachers in their classrooms."
                                            },
                                            {
                                                "example_id": "98056876-0cc8-4a02-8480-c090511c813c",
                                                "sense_id": "a90421b6-1db3-3478-96e3-3b12b330b2e0",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins. For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31c13dd6-4a6d-34c1-8427-c0518a08cf6a",
                                        "entry_id": "b1f81fe1-fbee-38af-8ddf-babb3d612977",
                                        "glosses": [
                                            "In or to a few or more locations."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "excessive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab4ebc7d-fcc9-47fb-9584-b26bed8918f9",
                                                "sense_id": "31c13dd6-4a6d-34c1-8427-c0518a08cf6a",
                                                "text": "We went to Europe last year and went everywhere: Berlin, Paris, London, and Madrid."
                                            },
                                            {
                                                "example_id": "26833b4b-36e4-44d9-9a2f-26d5873c59dc",
                                                "sense_id": "31c13dd6-4a6d-34c1-8427-c0518a08cf6a",
                                                "text": "When I shop for shoes, I like to look everywhere."
                                            },
                                            {
                                                "example_id": "b6c790fe-1e9a-460b-b53b-0bc3694ed54a",
                                                "sense_id": "31c13dd6-4a6d-34c1-8427-c0518a08cf6a",
                                                "text": "I've looked everywhere in the house and still can't find my glasses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "everywhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5178cfc-b2f3-32dd-9036-0556706bce25",
                                        "entry_id": "04edaa19-928a-3f41-9449-cc90a5cb03ee",
                                        "glosses": [
                                            "All places or locations."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4c0abec-7f52-426f-8a91-f475cd6b15c7",
                                                "sense_id": "a5178cfc-b2f3-32dd-9036-0556706bce25",
                                                "text": "I went out to get some groceries, but everywhere was closed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83e713b4-20a6-41ea-9ad5-d93d6ef590fd",
                        "source_entry_id": "561c78f5-3c7e-331b-8f60-3066332e6b4f",
                        "source_sense_id": "134ea065-68b4-3da0-a754-5fbb1dcbb544",
                        "source_sense_description": "veraltend: überall",
                        "target_lang_word": "on all sides",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a68077b9-90f2-4131-95a8-abc17d846529",
                        "source_entry_id": "561c78f5-3c7e-331b-8f60-3066332e6b4f",
                        "source_sense_id": "134ea065-68b4-3da0-a754-5fbb1dcbb544",
                        "source_sense_description": "veraltend: überall",
                        "target_lang_word": "partout",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partout",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c44ce929-bfbc-3b21-876f-69292f618977",
                                        "entry_id": "c259f70a-1ff5-3d04-95eb-7bdbae0fafdd",
                                        "glosses": [
                                            "En tous lieux ; en tous endroits ; de tous côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9f0cc9b-f7b2-4842-be40-4429377a32d2",
                                                "sense_id": "c44ce929-bfbc-3b21-876f-69292f618977",
                                                "text": "Parmi ces colosses de l’air et ces hauts personnages, il se sentait écrasé par la certitude de son insignifiance ; la vie était trop vaste pour lui, elle le dépassait de partout."
                                            },
                                            {
                                                "example_id": "4c784523-869c-4df6-946d-54be5c288037",
                                                "sense_id": "c44ce929-bfbc-3b21-876f-69292f618977",
                                                "text": "Elle s'affaire près de Févier, revient me faire des guili-guili et des poutous, partout. Je suis aux anges. Si ça durait !"
                                            },
                                            {
                                                "example_id": "9659f71d-27a8-415f-a896-89230aa49927",
                                                "sense_id": "c44ce929-bfbc-3b21-876f-69292f618977",
                                                "text": "Les enquêtes archéozoologiques effectuées sur les ossements révèlent une grande importance du porc au nord, des ovins et des caprins au sud, tandis que les bovins sont présents partout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e0e8a7-c932-3639-9094-240a5b9580b5",
                                        "entry_id": "c259f70a-1ff5-3d04-95eb-7bdbae0fafdd",
                                        "glosses": [
                                            "En quelque lieu que ce puisse être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c817eb53-db78-4226-90bb-ee3d17ca1142",
                                                "sense_id": "02e0e8a7-c932-3639-9094-240a5b9580b5",
                                                "text": "Le regard ankylosé par trop d’impérities, je cherchais un improbable mais tant espéré soutien au loin, partout et nulle part, peut-être vers le ciel où s'était machinalement orientée ma tête; ce ciel où avaient établi leurs pénates, mon défunt père et mes regrettées sœurs."
                                            },
                                            {
                                                "example_id": "b03ec196-f7e7-4cf2-a4ce-79d4a7dba9a0",
                                                "sense_id": "02e0e8a7-c932-3639-9094-240a5b9580b5",
                                                "text": "On reprend son bien partout où on le trouve."
                                            },
                                            {
                                                "example_id": "3fed53ac-971a-4b9e-a9e6-e3e25a75ec8a",
                                                "sense_id": "02e0e8a7-c932-3639-9094-240a5b9580b5",
                                                "text": "On se moque de lui partout où il va."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16758c9a-ed8d-4d1a-a17f-4419fc162cb2",
                        "source_entry_id": "561c78f5-3c7e-331b-8f60-3066332e6b4f",
                        "source_sense_id": "134ea065-68b4-3da0-a754-5fbb1dcbb544",
                        "source_sense_description": "veraltend: überall",
                        "target_lang_word": "overal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c1d68192-61e1-345e-9af8-910a166689b9",
                                        "entry_id": "eed96e6f-f1a0-378f-bcb5-12cc8a87e417",
                                        "glosses": [
                                            "op alle plaatsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f91c8ba-c914-446c-9e30-04972ce824d9",
                                                "sense_id": "c1d68192-61e1-345e-9af8-910a166689b9",
                                                "text": "Overal vind je leugen en bedrog."
                                            },
                                            {
                                                "example_id": "35fbc7ef-ba16-414c-afad-25216de0f0c3",
                                                "sense_id": "c1d68192-61e1-345e-9af8-910a166689b9",
                                                "text": "Waar ter wereld ik ook kom, overal zijn verhalen over hoe mijn volk zich in bochten had gewrongen om zich aan te passen, om uiteindelijk toch vermoord, of met een beetje mazzel, verdreven te worden."
                                            },
                                            {
                                                "example_id": "ad57ecf8-43f7-4c54-b181-fba03fac483a",
                                                "sense_id": "c1d68192-61e1-345e-9af8-910a166689b9",
                                                "text": "Overal kwamen er kleine cactusbloemen tevoorschijn: prachtige felle kleuren, van knalroze tot limoengroen, oranje en citroengeel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c4f13ea-76ca-337e-91e6-24c40107c3b6",
                                        "entry_id": "eed96e6f-f1a0-378f-bcb5-12cc8a87e417",
                                        "glosses": [
                                            "als locatief deel van een samengesteld voornaamwoordelijk bijwoord vervangt het alles"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "130c665e-b37a-4b20-96a4-cc26cb79fa15",
                                                "sense_id": "2c4f13ea-76ca-337e-91e6-24c40107c3b6",
                                                "text": "Hij loog over alles -> hij loog overal over."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overal",
                                "target_lang_code": "nl",
