        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a1a20a6-35d0-3c73-a6d2-cf1f27916c74",
                    "sense_definition": "Describing a sound, voice, or instrument that is low and deep in pitch.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The giant spoke in a deep <w>bass</w> voice that rumbled through the room.",
                            "target_lang_translations": {
                                "ru": "Великан заговорил глубоким <w>басовым</w> голосом, который прогрохотал по комнате.",
                                "zh": "巨人用<w>低沉的</w>嗓音说话，声音在房间里回荡。"
                            }
