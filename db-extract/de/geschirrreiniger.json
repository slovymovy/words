                        "glosses": [
                            "Spülmittel für Geschirrspülmaschinen zum Säubern von Geschirr, die als Pulver oder Tab erhältlich sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "031bb3a3-8555-4721-bfec-17f32fa4b52e",
                                "sense_id": "cff799c6-cc41-3403-9a4c-2d23473e1045",
                                "text": "„Häufig werden Spülmaschinenreiniger im Handel als Mehrphasen-Tabs angeboten. Diese enthalten neben dem Geschirrreiniger noch zusätzlich Klarspüler und werden als 2 in 1 bezeichnet, mit zusätzlichem Wasserenthärter als 3 in 1, zusätzlichem Glasschutz und Spülkraftverstärker als 5 in 1 und mit zusätzlichem Edelstahlglanz und Power-Entkruster als 7 in 1.“"
                            }
                        ],
