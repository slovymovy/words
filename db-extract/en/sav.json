                        "sense_id": "8f03ffef-7f93-37b8-a92b-baf984c3be48",
                        "entry_id": "3c1d15f5-63d0-3cf5-8472-bb406e11a6a2",
                        "glosses": [
                            "薩弗洛伊香腸"
                        ],
                        "tags": [
                            "Australia",
