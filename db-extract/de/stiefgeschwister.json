                                "sense_id": "e1833f0e-828c-38de-900d-3c9ca490adb7",
                                "text": "Nachdem sein Vater seine neue Frau heiratete, hatte er fünf Stiefgeschwister."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
