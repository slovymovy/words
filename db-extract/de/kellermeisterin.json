                                "target_senses": [
                                    {
                                        "sense_id": "49578435-5b84-31b6-99e2-93f67a147f14",
                                        "entry_id": "1cc4119d-2935-3ed5-a8d6-39f888fa5b1b",
                                        "glosses": [
                                            "Celui qui est chargé de l’administration de la cave, dans les grands restaurants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab0d2c54-4f9c-4c2e-a5a2-fba99fff7e8a",
                                                "sense_id": "49578435-5b84-31b6-99e2-93f67a147f14",
                                                "text": "Une fille très jolie, accorte et fine, Line, dirigeait admirablement ce relais galant et tenait lieu de dépensière, d’économe, de caviste et de cuisinière."
                                            },
                                            {
                                                "example_id": "761ab93c-8829-4c03-8de4-63cafb84b041",
                                                "sense_id": "49578435-5b84-31b6-99e2-93f67a147f14",
                                                "text": "Savez-vous, jeune homme, qu’il fut un temps où caviste, sommelier et échanson correspondaient à trois professions bien distinctes, alors qu’aujourd’hui, les traditions se perdent, conserver, préparer et servir le vin, c’est tout un…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41137c8f-3b48-3582-ad76-c24758f62b28",
                                        "entry_id": "1cc4119d-2935-3ed5-a8d6-39f888fa5b1b",
                                        "glosses": [
                                            "Gérant d'un entrepôt de vins ; détaillant de bouteilles de vin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e079ed20-b646-4ed0-8144-d9cbdb6bb4f0",
                                                "sense_id": "41137c8f-3b48-3582-ad76-c24758f62b28",
                                                "text": "Victor, jeune distillateur de Lorraine, est venu, avec quelques collègues de toute la France, faire déguster ses produits à des cavistes et restaurateurs parisiens lors d’un « apéro-gnôle »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5f69cea-62f6-3c05-89e1-a4965546fc17",
                                        "entry_id": "1cc4119d-2935-3ed5-a8d6-39f888fa5b1b",
                                        "glosses": [
                                            "Personne aimant, et ayant l'habitude de faire des cunnilingus. → voir descendre à la cave."
                                        ],
                                        "tags": [
                                            "Congo-Kinshasa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec78aca-4a66-4f19-baeb-74b60852f0bf",
                                                "sense_id": "a5f69cea-62f6-3c05-89e1-a4965546fc17",
                                                "text": "De même, un caviste est un nettoyeur de caves, une personne qui pratique le cunnilingus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
