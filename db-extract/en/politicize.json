                    {
                        "translation_id": "f78ba8bb-d737-4ca0-91e5-49adcee4bbef",
                        "source_entry_id": "defdb873-6335-37b9-95c0-ad4ddf2779ab",
                        "source_sense_description": "to give something political characteristics",
                        "target_lang_word": "politiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a70cbde-8580-36db-b29b-6e3c7878e15f",
                                        "entry_id": "fcb965a3-b589-3f34-b098-52bcddd2e522",
                                        "glosses": [
                                            "Donner un caractère politique à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e945beb-7cdf-4d42-b36b-c6c741f479fa",
                                                "sense_id": "0a70cbde-8580-36db-b29b-6e3c7878e15f",
                                                "text": "Varsovie politise l'extradition de Polanski"
                                            },
                                            {
                                                "example_id": "d2984ea4-abef-4ad2-8163-e1e6c7cfeb92",
                                                "sense_id": "0a70cbde-8580-36db-b29b-6e3c7878e15f",
                                                "text": "Moscou essaie de politiser l'aide humanitaire au tiers-monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20073b83-2414-3c8d-ae20-1420d7af7756",
                                        "entry_id": "fcb965a3-b589-3f34-b098-52bcddd2e522",
                                        "glosses": [
                                            "Donner une conscience politique à quelqu'un."
                                        ],
