                        "glosses": [
                            "A female mentor or advisor; a female observer."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6f44f302-e2d8-4e04-ba2f-ddb61c1e4342",
                                "sense_id": "685268ea-8ce5-3a68-a7d4-f1961b912742",
                                "text": "Diana filled up all his heart: he felt as if by his union with her he had received a new and better soul. She was his monitress as he learned what were the true ends of life."
                            },
                            {
                                "example_id": "713d16a5-59f3-405f-86de-6d85e51e9891",
                                "sense_id": "685268ea-8ce5-3a68-a7d4-f1961b912742",
                                "text": "Maisie could feel his monitress stiffen almost with anguish against the increase of his spell and then hurl herself as a desperate defence from it into the quite confessed poorness of violence, of iteration."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b4126c5-337f-388c-b7b7-128f9cad685c",
                        "entry_id": "a6812966-0fab-3c7c-a887-e4928f899eae",
                        "glosses": [
                            "A female monitor, or school leader."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "bcc44821-1b3c-4bfa-877a-876efa04da20",
                                "sense_id": "4b4126c5-337f-388c-b7b7-128f9cad685c",
                                "text": "Miss Mitchell would certainly be most relieved to have a monitress who was capable of organising the juniors at games."
                            }
                        ]
                    }
