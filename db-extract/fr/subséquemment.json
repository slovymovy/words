                "word": "subséquemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7356707c-aa85-3ecd-92d1-a91b6b6acd68",
                        "entry_id": "54d098c3-10d9-37c9-aaa7-c9f9dbb9d3d4",
                        "glosses": [
                            "En conséquence, ensuite, après."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d0cd9b74-9343-4b57-823f-374608f4b6ee",
                                "sense_id": "7356707c-aa85-3ecd-92d1-a91b6b6acd68",
                                "text": "[…] or, les faits recueillis, les résultats constatés, prouvent que, soit primitivement, soit subséquemment, la terre fut entièrement couverte d’eau."
                            },
                            {
                                "example_id": "0b9ea970-861a-4e8e-bd7f-5133e26b55bb",
                                "sense_id": "7356707c-aa85-3ecd-92d1-a91b6b6acd68",
                                "text": "Cette divergence est suffisante pour justifier l’annulation de la saisie des biens subséquemment acquis mais pas des autres biens."
                            },
                            {
                                "example_id": "9b1df98a-979b-4391-9215-395d71cdfb4f",
                                "sense_id": "7356707c-aa85-3ecd-92d1-a91b6b6acd68",
                                "text": "Mon ami est une valeur sûre qui dit souvent, sans prétention, qu’à la minceur des épluchures on voit la grandeur des nations, subséquemment, subséquemment, subséquemment, que j’comprends pas pourquoi souvent ses compagnons l’appellent, l’appellent, caporal casse-pompon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2872abf-b31b-40c5-9464-70bf6b087f6a",
                        "source_entry_id": "54d098c3-10d9-37c9-aaa7-c9f9dbb9d3d4",
                        "source_sense_id": "7356707c-aa85-3ecd-92d1-a91b6b6acd68",
                        "target_lang_word": "daraufhin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daraufhin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb81d9d-56c8-3940-9a99-116d5f4351a0",
                                        "entry_id": "533837eb-600f-3c08-a068-4c7f22e55069",
                                        "glosses": [
                                            "im direkten zeitlichen Anschluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38717c99-6332-4e71-a9f4-44b9fae469a5",
                                                "sense_id": "9cb81d9d-56c8-3940-9a99-116d5f4351a0",
                                                "text": "Ich zeigte ihm meine Ideen. Daraufhin schlug er mir ein Geschäft vor."
                                            },
                                            {
                                                "example_id": "560580bc-f3d3-46e6-bec4-22d34c736cb9",
                                                "sense_id": "9cb81d9d-56c8-3940-9a99-116d5f4351a0",
                                                "text": "„Daraufhin wurde das römische Heer durch Marius zu einer Berufsarmee umgestaltet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c884e568-280e-3da0-aac1-6e16cec6c943",
                                        "entry_id": "533837eb-600f-3c08-a068-4c7f22e55069",
                                        "glosses": [
                                            "im kausal bedingten Anschluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80c8adcc-9d73-4a41-ba80-9ae7a632aff2",
                                                "sense_id": "c884e568-280e-3da0-aac1-6e16cec6c943",
                                                "text": "Wir sahen die Verletzten. Daraufhin musste sich mein Kamerad übergeben."
                                            },
                                            {
                                                "example_id": "bd8b2205-787b-4ddd-9d11-8e6306929b87",
                                                "sense_id": "c884e568-280e-3da0-aac1-6e16cec6c943",
                                                "text": "[Breschnew-Doktrin:] „Breschnews Nachfolger Michail Gorbatschow hob im Jahr 1989 die Doktrin auf. Daraufhin zerfiel der Ostblock.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6837c40-af40-4d67-867e-7e511622d3dd",
                        "source_entry_id": "54d098c3-10d9-37c9-aaa7-c9f9dbb9d3d4",
