                "senses": [
                    {
                        "sense_id": "50f993af-3325-358b-a40f-6d88e4a86cc1",
                        "entry_id": "4d052e82-fb6f-3886-affb-fa56576adbab",
                        "glosses": [
                            "christliche Freikirche mit ausgeprägter sozialer Tätigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0308d55a-d183-49af-b329-cbe2090cebca",
                                "sense_id": "50f993af-3325-358b-a40f-6d88e4a86cc1",
                                "text": "Das Motto der Heilsarmee lautet: Suppe, Seife, Seelenheil."
                            },
                            {
                                "example_id": "df2e8b29-f04d-4d2a-8aae-fcd0cd954390",
                                "sense_id": "50f993af-3325-358b-a40f-6d88e4a86cc1",
                                "text": "„Die Heilsarmee hat ein großes Arbeitsfeld in den Hafenstädten, um der Trunksucht und anderen Lastern entgegenzutreten.“"
                            },
                            {
                                "example_id": "93bbd28d-ebc3-421a-ad84-f24db1a7824a",
                                "sense_id": "50f993af-3325-358b-a40f-6d88e4a86cc1",
                                "text": "„Am Friedhof hatte sich eine Abteilung der Heilsarmee aufgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f9649ca-b4bd-4377-98df-079fec00097c",
                        "source_entry_id": "4d052e82-fb6f-3886-affb-fa56576adbab",
                        "source_sense_id": "50f993af-3325-358b-a40f-6d88e4a86cc1",
