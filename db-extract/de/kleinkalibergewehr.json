                "senses": [
                    {
                        "sense_id": "e788fc74-dbaf-32f7-9214-6e442ccf9a09",
                        "entry_id": "2bcff131-2936-3a97-8d8b-ed6efc66fa48",
                        "glosses": [
                            "Gewehr, mit dem (nur) kleinkalibrige Munition verschossen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4be22e57-aaa8-48de-a996-26351a8b702b",
                                "sense_id": "e788fc74-dbaf-32f7-9214-6e442ccf9a09",
                                "text": "„Laut ersten Erhebungen dürfte der Mann gegen 10.22 Uhr gemeinsam mit einem Freund mit einem Kleinkalibergewehr aus einem Kellerfenster auf einen gegenüberliegenden Baum geschossen haben.“"
                            },
                            {
                                "example_id": "3ef7bc82-ca82-438f-afcf-42c56eb5b4db",
                                "sense_id": "e788fc74-dbaf-32f7-9214-6e442ccf9a09",
                                "text": "„Der Amoklauf eines 66-Jährigen in Nymphenburg wirft einige Fragen auf. Fest steht: Walter S., der aus nichtigem Grund am Montag drei Nachbarn mit einem Kleinkalibergewehr niederstreckte und kurz darauf einem Gehirnschlag erlag (wie berichtet), durfte die Waffe nicht besitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
