                "senses": [
                    {
                        "sense_id": "6c2b2058-ce83-3db6-b86a-2763c1034515",
                        "entry_id": "ae85e0aa-69f5-3f14-a741-dff45caf6c7c",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34e7cc7a-3646-450e-b0fc-9a9f583f449c",
                                "sense_id": "6c2b2058-ce83-3db6-b86a-2763c1034515",
                                "text": "« Cette tentative absurde d’imposer la volonté par la force ne prévaudra pas », a averti le nouveau ministre de la Justice, Flavio Dino, dans un message sur Twitter."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e1735af0-eba2-3a24-8cbc-e5b2975bd1d4",
                "word": "Dino",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b3e2a4b8-fd20-3845-a470-634d943616e3",
                        "entry_id": "e1735af0-eba2-3a24-8cbc-e5b2975bd1d4",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3620ffbe-a3fb-4ac3-893c-3b2e69d6ec5c",
                                "sense_id": "b3e2a4b8-fd20-3845-a470-634d943616e3",
                                "text": "Bien que la voix de Dino fût juste et pure, la planète de feu s’en emparait et la sextuplait, avant de la répéter par ses millions de gemmes vivantes."
                            },
                            {
                                "example_id": "bf28b50f-e7b9-419c-8689-8ebf4365b57b",
                                "sense_id": "b3e2a4b8-fd20-3845-a470-634d943616e3",
                                "text": "Novak Djokocic a dû lâcher un set à Dino Prizmic, 178ᵉ à l'ATP (6-2, 6-7, 6-3, 6-4)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3f19e321-3633-3df2-bc71-1682eff6e9e4",
                "word": "dino",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
