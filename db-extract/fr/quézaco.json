                        "examples": [
                            {
                                "example_id": "d615da76-4a9a-4058-a272-d03dd6daac37",
                                "sense_id": "546b5a40-a594-35cd-8a3b-161c1f2c8c31",
                                "text": "Alors, vous, monsieur Antoine, que pensez-vous de la conquête de l'espace ?\nAntoine, la bouche pleine de croissant :\n— Conquête de l'espace... quézaco ?\n— Comment ça quézaco ? Vous n'ignorez tout de même pas que des hommes se sont baladés en jeep sur la lune !\n— Ah ? première nouvelle !"
                            }
                        ]
                    }
