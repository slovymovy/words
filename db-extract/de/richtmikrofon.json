                "senses": [
                    {
                        "sense_id": "b0aaceed-2dc5-3676-91d9-458e61c2afd3",
                        "entry_id": "824f9053-6775-324d-bbe6-87a81c4e5deb",
                        "glosses": [
                            "Mikrofon, das primär den frontal eintreffenden Schall aufnimmt und dadurch eine Richtcharakteristik aufweist, Schall aus anderen Richtungen dämpft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2273220d-869d-45ad-9c13-2490c9ec3b55",
                                "sense_id": "b0aaceed-2dc5-3676-91d9-458e61c2afd3",
                                "text": "„Aus einem Löchlein in der Seite von Laureens überdimensionaler Handtasche ragte der Kopf eines langen, schmalen Richtmikrofons hervor, womit sie und Mike den größten Teil des Gesprächs zwischen den Eheleuten mitverfolgen konnten.“"
                            },
                            {
                                "example_id": "b63ae658-c60f-4eeb-b5ee-88e9995f0415",
                                "sense_id": "b0aaceed-2dc5-3676-91d9-458e61c2afd3",
                                "text": "„Allerdings würde das Smartphone mit einem leistungsfähigen Richtmikrofon gekoppelt sein und das Gespräch des BlackBridge-Teams aufzeichnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
