                ],
                "senses": [
                    {
                        "sense_id": "05a9b760-0281-3342-88a3-34fb51b3ade8",
                        "entry_id": "62552083-f1fd-3572-9026-54bcffe3a27e",
                        "glosses": [
                            "палочка или стержень для писания на грифельной доске"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5057e136-59a8-4d86-8728-407527366156",
                                "sense_id": "05a9b760-0281-3342-88a3-34fb51b3ade8",
                                "text": "Здесь появляются Кутейкин с часословом, а Цыфиркин с аспидной доскою и грифелем."
                            },
                            {
                                "example_id": "8fbe41ea-8fad-416e-9d20-3061efa4731e",
                                "sense_id": "05a9b760-0281-3342-88a3-34fb51b3ade8",
                                "text": "Державин через несколько минут схватился за аспидную доску и стал писать грифелем."
                            },
                            {
                                "example_id": "75350800-5a5b-4149-b189-2a6e826375c4",
                                "sense_id": "05a9b760-0281-3342-88a3-34fb51b3ade8",
                                "text": "Егор Алексеич берёт в руки грифель и начинает решать [задачу]."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1e43460-70f6-3e48-a964-87edbcdd68d3",
                        "entry_id": "62552083-f1fd-3572-9026-54bcffe3a27e",
                        "glosses": [
                            "стержень карандаша"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a042a88d-768f-4710-88bb-d3a7fb0df9e9",
                                "sense_id": "a1e43460-70f6-3e48-a964-87edbcdd68d3",
                                "text": "Юрий Мигуль затачивает на коробке спичек грифель карандаша."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6aec034f-58b3-4b4d-9c29-5d2f2a99b95d",
                        "source_entry_id": "62552083-f1fd-3572-9026-54bcffe3a27e",
