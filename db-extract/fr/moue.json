                                        "sense_id": "465bc7a8-cdd4-38aa-af07-6f4b6406230a",
                                        "entry_id": "6e91034b-a9e5-34b5-96fb-fd7e418ca9c5",
                                        "glosses": [
                                            "Schaufel (Spaten), mit der man etwas aufnehmen, bewegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "200173c9-2ee1-474e-b190-fa3af649d20a",
                                                "sense_id": "465bc7a8-cdd4-38aa-af07-6f4b6406230a",
                                                "text": "Um den Misthaufen auf die Mistkarre aufladen zu können, nimmt man besser eine Mistgabel und keine Schippe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56a3c8ff-7bf6-3807-bd11-ea3dd2ceab0f",
                                        "entry_id": "6e91034b-a9e5-34b5-96fb-fd7e418ca9c5",
                                        "glosses": [
                                            "Farbe der Spielkarten im Deutschen Blatt"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "616af5ef-7e1e-4365-a626-81e0c9e487c7",
                                                "sense_id": "56a3c8ff-7bf6-3807-bd11-ea3dd2ceab0f",
                                                "text": "Zu Schippen sagt man heute Pik."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8ab677f5-6d21-3110-8ec0-b2b6d9fa5b7f",
                                        "entry_id": "6e91034b-a9e5-34b5-96fb-fd7e418ca9c5",
                                        "glosses": [
                                            "vorgewölbte Unterlippe, die Missmut deutlich macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "464601ed-4f2e-422d-9e1d-03961a734f4b",
                                                "sense_id": "8ab677f5-6d21-3110-8ec0-b2b6d9fa5b7f",
                                                "text": "Zieh nicht so eine Schippe!"
                                            },
                                            {
                                                "example_id": "194713dc-ec6a-4f13-aeb9-4e09e8a99079",
                                                "sense_id": "8ab677f5-6d21-3110-8ec0-b2b6d9fa5b7f",
                                                "text": "„Da lässt er los, macht eine Schippe und tröstet sich mit einer Jumbo-Packung Weinbrandbohnen ohne Kruste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
