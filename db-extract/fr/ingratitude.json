                                                "sense_id": "fa6d5c4d-14ee-3023-a13d-0fcfdf00eaf4",
                                                "text": "non aveva capito che lui era stato salvaguardato da offese... forse per ingratitudine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72123c22-1675-3dfb-a513-939e3a1409ff",
                                        "entry_id": "0f4f3fc7-f9cf-3eaa-9086-ea1b7ae25203",
                                        "glosses": [
                                            "apatia dei sentimenti per cui risulta quasi impossibile comprendere di aver ricevuto benevolmente e/o in modo corretto"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "357d0850-2b63-446c-80be-cdd71d3e4d0e",
                                                "sense_id": "72123c22-1675-3dfb-a513-939e3a1409ff",
                                                "text": "per ingratitudine si ribellò in modo crudele"
                                            },
                                            {
                                                "example_id": "0ae600ec-f34c-47a4-9d21-c4159171e6ff",
                                                "sense_id": "72123c22-1675-3dfb-a513-939e3a1409ff",
                                                "text": "non dirgli che riguarda la sua ingratitudine perché potrebbe reagire in modo offensivo"
                                            }
