                "senses": [
                    {
                        "sense_id": "8edbd75c-a42c-35a3-b880-afca4ab086e8",
                        "entry_id": "dacbc487-c677-3f9f-a068-d945596b204e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80b73db8-ee7b-4ddc-b848-ed2722cb4623",
                                "sense_id": "8edbd75c-a42c-35a3-b880-afca4ab086e8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schäfle kommt, geht der Herr Schäfle.“"
                            },
                            {
                                "example_id": "8f9a5520-18a2-4d50-9b4f-db7a135e6a43",
                                "sense_id": "8edbd75c-a42c-35a3-b880-afca4ab086e8",
                                "text": "Schäfle kommt und geht."
                            },
                            {
                                "example_id": "ad3dfa9e-82f6-41bd-9a12-7c854e3c8d3f",
                                "sense_id": "8edbd75c-a42c-35a3-b880-afca4ab086e8",
                                "text": "Schäfles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "47f976c8-b90f-4314-97a0-8aa80e7bad04",
                                "sense_id": "8edbd75c-a42c-35a3-b880-afca4ab086e8",
                                "text": "Frau Schäfle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a1a3c7da-1d4a-41a7-8728-7c71b6437acc",
                                "sense_id": "8edbd75c-a42c-35a3-b880-afca4ab086e8",
                                "text": "Herr Schäfle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d427930a-63a0-40d9-be68-8c9db1b03a0a",
                                "sense_id": "8edbd75c-a42c-35a3-b880-afca4ab086e8",
                                "text": "Die Schäfles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "bf39a0dd-5aea-4f0d-af89-f52de414e654",
                                "sense_id": "8edbd75c-a42c-35a3-b880-afca4ab086e8",
                                "text": "Der Schäfle trägt nie die Pullover, die die Schäfle ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
