    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "54f41744-a680-3958-8c27-05e93fc9459a",
                    "sense_definition": "Pronom interrogatif servant à identifier ou à distinguer une personne ou une chose précise parmi plusieurs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "interrogatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voici deux manteaux très chauds, alors dis-moi <w>lequel</w> tu préfères porter aujourd'hui."
                        },
                        {
                            "text": "<w>Lequel</w> de ces romans as-tu choisi pour ton cours de littérature ?"
                        }
                    ],
                    "common_phrases": [
                        "lequel des deux",
                        "lequel d'entre eux"
                    ]
                },
                {
                    "sense_id": "f8883ca8-7dc6-3e98-bdab-1cb8d2d4d1d5",
                    "sense_definition": "Pronom relatif employé principalement après une préposition pour renvoyer à un antécédent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un problème complexe pour <w>lequel</w> nous n'avons pas encore trouvé de solution."
                        },
                        {
                            "text": "Le banc en bois sur <w>lequel</w> nous nous reposons est particulièrement confortable."
                        }
                    ],
                    "common_phrases": [
                        "pour lequel",
                        "avec lequel",
                        "dans lequel",
                        "sur lequel"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "85d5c727-e575-3b4a-8456-ea02649882c7",
                    "sense_definition": "Adjectif relatif placé devant un nom pour reprendre avec insistance une notion énoncée auparavant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La cour a entendu un témoin, <w>lequel</w> témoin a contredit la version de l'accusé."
                        },
                        {
                            "text": "L'accusé a présenté un nouvel alibi, pour <w>lequel</w> motif le procès a été immédiatement suspendu."
