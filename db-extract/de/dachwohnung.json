                "senses": [
                    {
                        "sense_id": "32a3e7d2-6ffa-3ab3-b757-04ba2233d5f2",
                        "entry_id": "ebdc9a3a-0e6d-3101-ae2f-ce7a18237cd3",
                        "glosses": [
                            "Wohnung direkt unter dem Dach, im Dachgeschoss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "808e315d-7937-42e4-812c-60d7853d9534",
                                "sense_id": "32a3e7d2-6ffa-3ab3-b757-04ba2233d5f2",
                                "text": "Eine Dachwohnung ist oft preisgünstiger als die anderen Etagenwohnungen."
                            },
                            {
                                "example_id": "0d1b745b-ca8b-4f5d-a253-c4f9633eca84",
                                "sense_id": "32a3e7d2-6ffa-3ab3-b757-04ba2233d5f2",
                                "text": "„Wieland Herzfelde hatte eine Dachwohnung im Hause Kurfürstendamm 76.“"
                            },
                            {
                                "example_id": "ac5c2dff-e72d-4e5b-8f88-51ef8c216efe",
                                "sense_id": "32a3e7d2-6ffa-3ab3-b757-04ba2233d5f2",
                                "text": "„In meiner inzwischen herrlich warmen Dachwohnung stehe ich im eisigen, stürmischen Januar 2006 hoch oben am Fenster und schaue auf den eigenartig amorphen Platz des Slowakischen Nationalaufstands hinunter.“"
                            },
                            {
                                "example_id": "6fd18567-34fe-4d70-9458-e33299732e2f",
                                "sense_id": "32a3e7d2-6ffa-3ab3-b757-04ba2233d5f2",
                                "text": "„Die kleine Dachwohnung war für Eva und ihren Mann reserviert; das Mansardenzimmer wurde später an Studenten des Arolser Goethe-Instituts vermietet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
