                {
                    "sense_id": "06fd25e6-75e4-3027-ba98-38c44bef9849",
                    "sense_definition": "État ou caractère de ce qui est sale ou malpropre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "propreté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>saleté</w> des rues du quartier choque souvent les touristes.",
                            "target_lang_translations": {
                                "en": "The <w>dirtiness</w> of the streets in the neighbourhood often shocks tourists.",
                                "ru": "<w>Грязь</w> на улицах этого квартала часто шокирует туристов.",
                                "de": "Die <w>Schmutzigkeit</w> der Straßen im Viertel schockiert oft die Touristen.",
                                "es": "La <w>suciedad</w> de las calles del barrio suele chocar a los turistas.",
                                "zh": "这个街区街道的<w>肮脏</w>常常让游客感到震惊。"
                            }
                        },
                        {
                            "text": "Il a nettoyé la cuisine car la <w>saleté</w> devenait insupportable.",
                            "target_lang_translations": {
                                "en": "He cleaned the kitchen because the <w>dirtiness</w> was becoming unbearable.",
                                "ru": "Он убрал кухню, потому что <w>грязь</w> становилась невыносимой.",
                                "de": "Er hat die Küche geputzt, weil der <w>Schmutz</w> immer unerträglicher wurde.",
                                "es": "Limpió la cocina porque la <w>suciedad</w> se estaba volviendo insoportable.",
                                "zh": "他打扫了厨房，因为那里的<w>肮脏</w>已经令人难以忍受。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crasse",
                        "malpropreté"
                    ],
                    "antonyms": [
                        "propreté"
                    ],
                    "common_phrases": [
                        "état de saleté"
                    ],
                    "target_lang_definitions": {
