                                "sense_id": "0383ca9b-c4bf-30d7-8756-6aac9fab82dd",
                                "text": "Dit boek is gedrukt op krantenpapier.",
                                "translation": "This book is printed on newsprint.",
                                "english": "This book is printed on newsprint."
                            },
                            {
                                "example_id": "73c7aa3a-b46c-45bd-9fe1-2218d31e941d",
                                "sense_id": "0383ca9b-c4bf-30d7-8756-6aac9fab82dd",
                                "text": "Krantenpapier is goedkoper dan glanzend papier.",
                                "translation": "Newsprint is cheaper than glossy paper.",
                                "english": "Newsprint is cheaper than glossy paper."
                            },
                            {
                                "example_id": "1c61333f-20a4-4767-bb00-acd012f3887a",
                                "sense_id": "0383ca9b-c4bf-30d7-8756-6aac9fab82dd",
                                "text": "Ze gebruikte krantenpapier voor haar kunstproject.",
                                "translation": "She used newsprint for her art project.",
