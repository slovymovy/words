                ],
                "senses": [
                    {
                        "sense_id": "defcd3d1-1953-3172-83f2-d85263f4b6f4",
                        "entry_id": "ce0b1233-d83d-36a1-a4fa-76c695a097a6",
                        "glosses": [
                            "прост. крайне ослабленный, близкий к смерти человек или животное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af3eac45-d022-4c28-9999-9699a815410c",
                                "sense_id": "defcd3d1-1953-3172-83f2-d85263f4b6f4",
                                "text": "При тяжелейшей дороге и работе, при хроническом недоедании и недосыпании люди слабели, худели; по-лагерному — доходили, становились доходягами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ce47662-7b5a-427b-b428-54ebe2e1bfe8",
                        "source_entry_id": "ce0b1233-d83d-36a1-a4fa-76c695a097a6",
                        "source_sense_id": "defcd3d1-1953-3172-83f2-d85263f4b6f4",
                        "target_lang_word": "goner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f169c09-6c22-3927-86b0-a9d2ebb328a3",
                                        "entry_id": "d022b9db-f5b6-3033-a010-1e0ae067a25e",
                                        "glosses": [
                                            "Someone (or something) doomed; a hopeless case, especially someone who is bound to die soon."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db0c7ae2-7931-4c07-86d5-b6e3eb434e94",
                                                "sense_id": "4f169c09-6c22-3927-86b0-a9d2ebb328a3",
                                                "text": "I'm a goner if this plan doesn't work."
                                            },
                                            {
                                                "example_id": "2357c74b-64f8-411c-8c39-6defd57bf8cb",
                                                "sense_id": "4f169c09-6c22-3927-86b0-a9d2ebb328a3",
                                                "text": "You'll be a goner if I hit you with this gun."
                                            },
                                            {
                                                "example_id": "66690440-b46f-401d-8ded-504b51008259",
                                                "sense_id": "4f169c09-6c22-3927-86b0-a9d2ebb328a3",
                                                "text": "The sergeant was a goner. There was only one way to save him, and he threw himself on top, hurling the man to the ground."
                                            },
                                            {
                                                "example_id": "eff4aa98-a45a-46d3-9bcd-1a7d5e1adef9",
                                                "sense_id": "4f169c09-6c22-3927-86b0-a9d2ebb328a3",
                                                "text": "Retreat, in his view, means it’s […] about making plans for the migration of millions of people from low-lying regions like Bangladesh into Europe; about admitting that New Orleans is a goner and moving the people to cities better positioned for the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72965071-fca8-32c6-9160-3535a2a5eaa8",
                                        "entry_id": "d022b9db-f5b6-3033-a010-1e0ae067a25e",
                                        "glosses": [
                                            "A ball hit out of the playing area for a home run."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
