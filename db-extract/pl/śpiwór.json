                            {
                                "example_id": "aee895c2-37f6-4b77-bfd4-36e44de64bd3",
                                "sense_id": "c8750a00-fd6f-3491-aea8-ecd6e39a0f83",
                                "text": "Pokrowiec na śpiwór dziwnym trafem znalazł się obok psiej budy."
                            },
                            {
                                "example_id": "83600a47-4b1b-4d65-bd64-c1b1b8c79ef0",
                                "sense_id": "c8750a00-fd6f-3491-aea8-ecd6e39a0f83",
                                "text": "Tę noc spędzę w śpiworze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fe32839-24d1-4b93-ac89-46a8cf07c11c",
