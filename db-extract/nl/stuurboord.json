                        "target_lang_word": "Steuerbord",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steuerbord",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f813277-42c3-3afb-9ce3-08960bf42fac",
                                        "entry_id": "16b52858-2ce4-377c-9462-b8a427b3cb95",
                                        "glosses": [
                                            "die in Fahrtrichtung rechte Seite (eines Schiffes oder Luftfahrzeugs)"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbab96d2-e24f-488b-9846-99ce82b66001",
                                                "sense_id": "0f813277-42c3-3afb-9ce3-08960bf42fac",
                                                "text": "„1847 endlich ergriff Großbritannien als führende Seefahrernation die Initiative und ging mit der Einführung eines Systems voran, das bald allgemeine Zustimmung fand: weißes Topplicht, an Steuerbord ein grünes Licht und an Backbord ein rotes.“"
                                            },
                                            {
                                                "example_id": "964493ba-1781-43ea-bdf3-4432ea1747d4",
                                                "sense_id": "0f813277-42c3-3afb-9ce3-08960bf42fac",
                                                "text": "„Der Eisberg an Steuerbord hat Ähnlichkeit mit dem Opernhaus von Sydney und ist bestimmt dreihundert Meter lang und einhundert Meter groß.“"
                                            },
                                            {
                                                "example_id": "72f0ee1c-756e-4275-abe3-1431875b1994",
                                                "sense_id": "0f813277-42c3-3afb-9ce3-08960bf42fac",
                                                "text": "„Ein Bie-den-Winder zog an Steuerbord langsam vorbei.“"
                                            },
                                            {
                                                "example_id": "5ca0a3d4-7fb7-475f-b3b3-15642a574d94",
                                                "sense_id": "0f813277-42c3-3afb-9ce3-08960bf42fac",
                                                "text": "„Es gab an Bord zwei Kohlebunker, einer lag an Steuerbord, der andere an Backbord.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93314339-9a89-4caa-b080-df7b930ae9e3",
                        "source_entry_id": "de7cda9d-46cf-306f-b71b-7c93fb4adfb6",
                        "source_sense_id": "66ab79b5-3465-320f-9217-6137201a3a97",
                        "source_sense_description": "de rechterzijde als men vanop een schip naar de boeg kijkt",
                        "target_lang_word": "starboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8acfa9d3-6f78-3fad-bcc2-6707481b6439",
                                        "entry_id": "103b03a3-dfc1-32ef-8688-bd84eb96d33c",
                                        "glosses": [
                                            "A list that shows messages starred in a community space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e74c4a7b-0d8a-498f-b335-572effdf4437",
                                                "sense_id": "8acfa9d3-6f78-3fad-bcc2-6707481b6439",
                                                "text": "The unlimited starring power is an arguably useful feature because it enables management of the starboard with notifications and the like, but I see nothing in the informal job description of a room owner that says they have any more right to spam the room than I do."
                                            },
                                            {
                                                "example_id": "f62a8cc0-9e04-4d51-b568-322ce7b2a496",
                                                "sense_id": "8acfa9d3-6f78-3fad-bcc2-6707481b6439",
                                                "text": "TFHRC#1 indicates a backquote in a chat message using fixed-width formatting, which is (correctly) output literally. FHRC#2 shows that the same backquote is misinterpreted by the sidebar starboard as a formatting character, wrecking the intended look and feel even more."
                                            },
                                            {
                                                "example_id": "9a5647d4-1c2a-4e16-9921-8bcd1002ee00",
                                                "sense_id": "8acfa9d3-6f78-3fad-bcc2-6707481b6439",
                                                "text": "i also use carlbot for warnings, bans, mutes—and my starboard!!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c563fd-e17a-380d-b75f-8e2a0b40d06d",
                                        "entry_id": "103b03a3-dfc1-32ef-8688-bd84eb96d33c",
                                        "glosses": [
                                            "A system that enables such a list."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94e7b178-ffe1-4057-a52e-679d52e91a21",
                                                "sense_id": "f7c563fd-e17a-380d-b75f-8e2a0b40d06d",
                                                "text": "In case you don't know what a starboard is, it's basically a system used on Discord that whenever you react with a star emoji, the message is showcased inside of a #starboard channel."
                                            },
                                            {
                                                "example_id": "87392d15-0cc5-414c-a0c9-38d14aa616a4",
                                                "sense_id": "f7c563fd-e17a-380d-b75f-8e2a0b40d06d",
                                                "text": "We used to do that until someone suggested adding a bot that had a starboard."
                                            },
                                            {
                                                "example_id": "eb771793-b629-4280-ae31-a60d1d516df9",
                                                "sense_id": "f7c563fd-e17a-380d-b75f-8e2a0b40d06d",
                                                "text": "You could use a form of starboard to put messages into a read only channel, but then anyone with react permissions could theoretically add to it"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "starboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65af3171-5cb7-3b0e-948a-5efd7d9ebabd",
                                        "entry_id": "649e2a32-8fd7-3a65-b6f1-8af5bf20c256",
                                        "glosses": [
                                            "The righthand side of a ship, boat or aircraft when facing the front, or fore or bow. Used to unambiguously refer to directions according to the sides of the vessel, rather than those of a crew member or object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3282816f-a256-4660-afa5-d5412d6c3baa",
                                                "sense_id": "65af3171-5cb7-3b0e-948a-5efd7d9ebabd",
                                                "text": "I see another vessel off the starboard side."
                                            },
                                            {
                                                "example_id": "26dd806b-3a5f-40a0-9e8a-5be2a0b29dda",
                                                "sense_id": "65af3171-5cb7-3b0e-948a-5efd7d9ebabd",
                                                "text": "We're on starboard tack, so the other boat has to give way."
                                            },
                                            {
                                                "example_id": "7cf363df-3bbe-45af-a855-835c81c999df",
                                                "sense_id": "65af3171-5cb7-3b0e-948a-5efd7d9ebabd",
                                                "text": "Now stow the mainsail as follows, preferably with the sail still lying in the starboard cockpit: beginning at the head, fold the upper section so that the upper two battens are aligned together; then tightly roll the sail from the head down to the foot. Reinsert the sail into its bag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00014445-a29e-3a7f-8773-8e94d470b7d6",
                                        "entry_id": "649e2a32-8fd7-3a65-b6f1-8af5bf20c256",
                                        "glosses": [
                                            "One of the two traditional watches aboard a ship standing a watch in two."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "starboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8b0c65b-aa83-3ffd-9b5a-02025bc5f3bc",
                                        "entry_id": "b3e6f37c-9347-3cc8-ac91-e6c46c84e025",
                                        "glosses": [
                                            "To put to the right, or starboard, side of a vessel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
