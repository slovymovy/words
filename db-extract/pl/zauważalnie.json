                                            {
                                                "example_id": "dde7cd95-0758-4bf5-b9fa-f6df21c673fa",
                                                "sense_id": "b21e0bb9-62e4-33be-8a6c-a12b0df7104f",
                                                "text": "„Der Noniusgrenzwinkel ist der kleinste Sehwinkel, unter dem eine gegenseitige Versetzung von Objekten in einer frontoparallelen Ebene erkennbar wird.“"
                                            },
                                            {
                                                "example_id": "494077f7-4b33-4c06-9293-672c22537d94",
                                                "sense_id": "b21e0bb9-62e4-33be-8a6c-a12b0df7104f",
                                                "text": "„Wer mit Sprache umzugehen versteht, bei Mathematik und Physik aber eher kein Talent hat, tut gut daran, den erkennbaren Intelligenz-Schwerpunkt mit seinen Interessen zusammenzubringen.“"
                                            }
                                        ],
