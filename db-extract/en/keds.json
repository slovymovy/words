            {
                "entry_id": "dc1a5a5b-c593-3a22-b1bf-0a456bfd5432",
                "word": "Keds",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fde5571d-c801-4e75-9e99-ae3227ac53f0",
                        "entry_id": "dc1a5a5b-c593-3a22-b1bf-0a456bfd5432",
                        "tags": [
                            "singular"
