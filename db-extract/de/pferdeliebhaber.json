                "senses": [
                    {
                        "sense_id": "79767d8f-2b7c-3771-a643-b333eeb98d7d",
                        "entry_id": "e255fdb6-c490-3893-a344-58aa021abb87",
                        "glosses": [
                            "Person, die Pferde sehr mag, von Pferden begeistert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdd3c9d0-a4ed-4e37-b997-cec6a3bc7260",
                                "sense_id": "79767d8f-2b7c-3771-a643-b333eeb98d7d",
                                "text": "„Jetzt war er ein Husarenoffizier mit silberverschnürtem Dolman und dem noch als Junker erworbenen Georgskreuz der Mannschaftsklasse und fuhr einen Traber zum Rennen ein, zusammen mit bekannten Pferdeliebhabern und Kennern, älteren Herren, die in der Gesellschaft zu den Respektspersonen zählten.“"
                            },
                            {
                                "example_id": "2a0436fd-b8bc-4c10-a35c-ac840fa70deb",
                                "sense_id": "79767d8f-2b7c-3771-a643-b333eeb98d7d",
                                "text": "„Ich lernte einen liebenswürdigen Cavaliere kennen, einen Literaten, Soldaten und großen Pferdeliebhaber; er hatte keinen anderen Fehler, als um alles zu feilschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
