        "nl-extract.jsonl": [
            {
                "entry_id": "d5fd2a45-697b-3023-afe2-b72a5f73f1e3",
                "word": "troposfeer",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d460d31-0aa9-3a11-b604-426cd0b08bce",
                        "entry_id": "d5fd2a45-697b-3023-afe2-b72a5f73f1e3",
                        "glosses": [
                            "de onderste 10 kilometer van de dampkring van de aarde waar de weersveranderingen merkbaar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b0a2b6-8a92-4284-8329-226f4fe48f11",
                                "sense_id": "9d460d31-0aa9-3a11-b604-426cd0b08bce",
                                "text": "Bij die botsing braken de buitenlagen van de ster uiteen, de fotosfeer en de troposfeer, waardoor de stellaire materie vanaf de binnenkant de ruimte in werd uitgestoten en een omringende atmosfeer vormde."
                            },
                            {
                                "example_id": "98df852e-0d72-4982-8e29-f0e8ad1e1756",
                                "sense_id": "9d460d31-0aa9-3a11-b604-426cd0b08bce",
                                "text": "De troposfeer (tot 10 km hoogte) zal daardoor opwarmen, de zeespiegel stijgen en wereldwijd zal het klimaat veranderen."
                            },
                            {
                                "example_id": "a01a15e6-6675-468c-82ca-e9caeb6ecabb",
                                "sense_id": "9d460d31-0aa9-3a11-b604-426cd0b08bce",
                                "text": "\"Die grotere temperatuurverschillen versterken de zogeheten straalstromen hoog in de troposfeer, een soort stromende luchtrivieren waar vliegtuigen doorheen vliegen. Door die hogere windsnelheden ontstaat meer clear air turbulence (CAT)\", zegt Storer. Deze vorm van turbulentie, de naam zegt het al, doet zich voor bij een strakblauwe hemel, is niet altijd te voorspellen en kan je dus zomaar verrassen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54d1c19e-431a-4f99-86c3-4a25ca758947",
                        "source_entry_id": "d5fd2a45-697b-3023-afe2-b72a5f73f1e3",
                        "source_sense_id": "9d460d31-0aa9-3a11-b604-426cd0b08bce",
                        "target_lang_word": "Troposphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Troposphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ad8a97a-4ae2-371c-9350-9b4f7c0b1026",
                                        "entry_id": "7fa54dd3-f5be-3312-97c6-9bcfb48c22be",
                                        "glosses": [
                                            "die unterste, bis in 15 Kilometer Höhe reichende Luftschicht der Atmosphäre, in der hauptsächlich das Wettergeschehen stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e0cbfe-4101-4edc-94b9-28bbcd857d61",
                                                "sense_id": "7ad8a97a-4ae2-371c-9350-9b4f7c0b1026",
                                                "text": "Die Troposphäre wird nach oben hin von der Tropopause begrenzt."
                                            },
                                            {
                                                "example_id": "a651a198-177c-4f9f-9747-08d8cb6f7c12",
                                                "sense_id": "7ad8a97a-4ae2-371c-9350-9b4f7c0b1026",
                                                "text": "Zudem kann HALO auch Messungen in der forschungsrelevanten Grenzschicht zwischen Troposphäre und Stratosphäre durchführen."
                                            },
                                            {
                                                "example_id": "1f3cce85-8947-427e-a52a-87bcd2299363",
                                                "sense_id": "7ad8a97a-4ae2-371c-9350-9b4f7c0b1026",
                                                "text": "Ein Vorschlag lautet, künstliche Wolken in der Stratosphäre zu erzeugen, also in der Schicht oberhalb der Troposphäre, in der wir leben."
                                            },
                                            {
                                                "example_id": "aaad650c-6321-4bf6-abb2-48d345e1581e",
                                                "sense_id": "7ad8a97a-4ae2-371c-9350-9b4f7c0b1026",
                                                "text": "Wochenlang verdunkelten Aerosole in der Troposphäre den Himmel – nicht nur auf Island, sondern auch auf dem europäischen Festland."
                                            },
                                            {
                                                "example_id": "26dd42d6-e7df-44ba-83e9-f74664e96da0",
                                                "sense_id": "7ad8a97a-4ae2-371c-9350-9b4f7c0b1026",
                                                "text": "Bei den ersten Flügen soll es um die Oxidation von Schadstoffen in der Troposphäre in einer Höhe von zehn bis 15 Kilometern gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
