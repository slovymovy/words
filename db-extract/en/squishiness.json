                        "form_id": "4b16e835-d8d1-4ddd-8643-3d99275c8e26",
                        "entry_id": "e3802dbb-ac72-37b8-8126-125be3bdc4ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "squishinesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1c07cff-4af3-3c0e-a148-f4e306000b2d",
                        "entry_id": "e3802dbb-ac72-37b8-8126-125be3bdc4ab",
                        "glosses": [
                            "The state or quality of being squishy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "eea87521-4277-41e4-8fb2-cd3865a4660d",
                                "sense_id": "a1c07cff-4af3-3c0e-a148-f4e306000b2d",
                                "text": "The squishiness of an hour-old fertilized egg can predict its viability, ...."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29bb9f1e-bf9c-4141-8deb-fdbfaaea53d0",
                        "source_entry_id": "e3802dbb-ac72-37b8-8126-125be3bdc4ab",
                        "source_sense_id": "a1c07cff-4af3-3c0e-a148-f4e306000b2d",
                        "source_sense_description": "State or quality",
                        "target_lang_word": "mollesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mollesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93d0757b-fe4e-3b9d-aa32-e6290403ad50",
                                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                                        "glosses": [
                                            "État de ce qui est mou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76445d5e-f04b-4c7f-be5b-a7dbd601fd60",
                                                "sense_id": "93d0757b-fe4e-3b9d-aa32-e6290403ad50",
                                                "text": "Mais le soufre qui a été chauffé à un certain degré, devient épais comme syrupeux, et conserve après avoir été coulé dans l'eau froide, une mollesse qui le rend précieux pour les empreintes de cachet."
                                            },
                                            {
                                                "example_id": "56a42063-9a81-4a0c-98ad-abb88451704f",
                                                "sense_id": "93d0757b-fe4e-3b9d-aa32-e6290403ad50",
                                                "text": "— Vous tenez sur vos jambes, au moins ? Levez-vous.\nElles avaient des mollesses de chaussettes, mais elles tenaient."
                                            },
                                            {
                                                "example_id": "0254ec6b-9bf3-4d56-863d-8c5c47d293e8",
                                                "sense_id": "93d0757b-fe4e-3b9d-aa32-e6290403ad50",
                                                "text": "La mollesse et la dureté des corps. - La mollesse des chairs est une marque d’une débile constitution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c79372b4-6725-33da-9400-78dae72aa34a",
                                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                                        "glosses": [
                                            "Température douce et molle, en parlant du climat."
                                        ],
                                        "tags": [
                                            "Quelquefois"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df644988-aa40-3e28-961b-3b92edd61dbd",
                                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                                        "glosses": [
                                            "Complexion, tempérament mou, en parlant des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f674792-47a3-47f6-8e08-6607554feb5c",
                                                "sense_id": "df644988-aa40-3e28-961b-3b92edd61dbd",
                                                "text": "La mollesse de sa complexion l’expose à beaucoup de maladies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d9917fb-e1fb-3d3d-824c-944524ee8208",
                                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                                        "glosses": [
                                            "L’imitation vraie de la flexibilité, de la morbidesse des chairs."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c70e46e-9bae-32f0-b743-5e0339750d04",
                                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                                        "glosses": [
                                            "Défaut de fermeté dans le maniement du pinceau."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b51c29d-add9-33ff-af6e-0b67d34763e9",
                                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                                        "glosses": [
                                            "Manque de vigueur et de fermeté dans le caractère, dans la conduite, dans les mœurs."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "137e4170-b21b-446e-8b50-56be32f17b29",
                                                "sense_id": "3b51c29d-add9-33ff-af6e-0b67d34763e9",
                                                "text": "Babylone, si longtemps plongée dans une mollesse oisive, devint le théâtre d'une guerre civile affreuse."
                                            },
                                            {
                                                "example_id": "4280ece7-39f0-42e4-8720-ce0501fa18a0",
                                                "sense_id": "3b51c29d-add9-33ff-af6e-0b67d34763e9",
                                                "text": "Les voilà qui m'entourent ; les voilà qui me contemplent ; les voilà qui me disent en leurs provocations : « Jeune dieu d'Amour, enseigne aux nymphes bocagères la mollesse et le désir, l'inconstance et la passion , le sourire et le sérieux. »"
                                            },
                                            {
                                                "example_id": "d5845002-638c-408f-b4f1-86ff5b2a1a67",
                                                "sense_id": "3b51c29d-add9-33ff-af6e-0b67d34763e9",
                                                "text": "Eh! oui, il était grossier ce césarien. Il n'en toisait pas moins, non sans bonheur, les mollesses, les fluctuations du grand seigneur …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ec2ecc4-3162-3a08-b91f-a18b15dd019d",
                                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                                        "glosses": [
                                            "Excès d’indulgence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6b557de-d1f7-415b-b5ca-11432105c64b",
                                                "sense_id": "6ec2ecc4-3162-3a08-b91f-a18b15dd019d",
                                                "text": "La mollesse de ce père a perdu ses enfants."
                                            },
                                            {
                                                "example_id": "4a1646de-4466-44b3-8d9c-d950f867d85b",
                                                "sense_id": "6ec2ecc4-3162-3a08-b91f-a18b15dd019d",
                                                "text": "Sa mollesse face aux brutalités policières envers les Noirs a laissé des traces indélébiles dans l'esprit des minorités noires."
                                            },
                                            {
                                                "example_id": "0328e0aa-bdee-47b5-8c3d-7e1fe9f7eee6",
                                                "sense_id": "6ec2ecc4-3162-3a08-b91f-a18b15dd019d",
                                                "text": "À travers les témoignages émouvants de plusieurs « rescapés » de communautés religieuses, des jeunes courageux et inspirants qui ont tout laissé derrière eux (frères, sœurs, parents, amis) pour enfin vivre une vie normale, Marie-Claude Barrette montre à quel point nos gouvernements font preuve de mollesse, plient les genoux et renient leurs principes lorsque la religion se pointe le bout du nez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f13877c3-8d74-3f49-a629-90eededbc912",
                                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                                        "glosses": [
                                            "Délicatesse d’une vie efféminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c7326d0-e1a6-4d9a-bca5-d7e0b610a21e",
                                                "sense_id": "f13877c3-8d74-3f49-a629-90eededbc912",
                                                "text": "Vivre dans la mollesse. - La mollesse des sybarites."
                                            },
                                            {
                                                "example_id": "edb64802-55d1-43a1-9502-d0ef204331b4",
                                                "sense_id": "f13877c3-8d74-3f49-a629-90eededbc912",
                                                "text": "J’aime le luxe, et même la mollesse,\nTous les plaisirs, les arts de toute espèce,\nLa propreté, le goût, les ornements :\nTout honnête homme a de tels sentiments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "752afe7b-6a97-3aa9-b4e5-232060d5dd78",
                                        "entry_id": "a17d2e17-9195-31f2-b19b-f618773b8faf",
                                        "glosses": [
                                            "Manque de fermeté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b4b5b89-93e4-4f96-937b-7a853d6de0b9",
                                                "sense_id": "752afe7b-6a97-3aa9-b4e5-232060d5dd78",
                                                "text": "Mollesse du style."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74930421-adda-4e48-b468-4ede2309ae0a",
                        "source_entry_id": "e3802dbb-ac72-37b8-8126-125be3bdc4ab",
                        "source_sense_id": "a1c07cff-4af3-3c0e-a148-f4e306000b2d",
                        "source_sense_description": "State or quality",
                        "target_lang_word": "spongiosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spongiosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c486c3-2d96-36e9-8ba5-175061c30542",
                                        "entry_id": "46dde9a6-3701-3808-a57d-974be13ef274",
                                        "glosses": [
                                            "Qualité de ce qui est spongieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70950ba-1867-4b3e-814d-2e27c21de015",
                                                "sense_id": "a2c486c3-2d96-36e9-8ba5-175061c30542",
                                                "text": "— Ce sont les institutrices qui parlent tout le temps, l’enfant n’absorbe que ce qu’il peut absorber naturellement, sans effort ; les institutrices versent, versent à profusion, mais ce qui dépasse la spongiosité intellectuelle de l’enfant coule à côté… et voilà tout… ce sont les institutrices qui sont surmenées : ce sont elles qui filtrent et refiltrent plus qu’elles ne peuvent…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6b80866-d505-4776-ad9c-2b3fe6d1c231",
                        "source_entry_id": "e3802dbb-ac72-37b8-8126-125be3bdc4ab",
                        "source_sense_id": "a1c07cff-4af3-3c0e-a148-f4e306000b2d",
                        "source_sense_description": "State or quality",
                        "target_lang_word": "viscosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viscosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de4228e2-a525-3b01-8479-ab92d63091d1",
                                        "entry_id": "7b8783b8-94b2-325a-9d86-0e45dc411eee",
                                        "glosses": [
                                            "Caractère de ce qui est visqueux."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "930c1824-f7fd-468c-8dde-f93af57b0b6f",
                                                "sense_id": "de4228e2-a525-3b01-8479-ab92d63091d1",
                                                "text": "La viscosité du sang, qui est diminuée dans la fièvre typhoïde, augmente au contraire dans la pneumonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca218dc4-90fe-30bb-a3c4-920f8d01ecfa",
                                        "entry_id": "7b8783b8-94b2-325a-9d86-0e45dc411eee",
                                        "glosses": [
                                            "Résistance à l’écoulement uniforme et sans turbulence se produisant dans la masse d’une matière."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05b50f36-5600-48b9-9674-01106be1ca57",
                                                "sense_id": "ca218dc4-90fe-30bb-a3c4-920f8d01ecfa",
                                                "text": "Les huiles « newtoniennes », c'est-à-dire les huiles minérales et synthétiques ne comportant pas d'additif améliorant l'indice de viscosité sont dites «incisaillables», ce qui signifie que leur viscosité ne varie pas lorsqu'elles sont soumises à un cisaillement dans les organes mécaniques rapides à faibles jeux de fonctionnement […]."
                                            },
                                            {
                                                "example_id": "3a64113d-fda2-4f57-8d0d-bc9fc5deefff",
                                                "sense_id": "ca218dc4-90fe-30bb-a3c4-920f8d01ecfa",
                                                "text": "Explication : plus l'eau est chaude, moins elle est visqueuse. La viscosité de l'eau n'est pas facile à visualiser, mais c'est exactement le même phénomène que quand vous chauffez du miel ou du caramel, il devient plus mou et ne coule pas de la même façon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f3b47fb-712c-4ad4-8477-181d28e7e57c",
                        "source_entry_id": "e3802dbb-ac72-37b8-8126-125be3bdc4ab",
                        "source_sense_id": "a1c07cff-4af3-3c0e-a148-f4e306000b2d",
                        "source_sense_description": "State or quality",
                        "target_lang_word": "Nachgiebigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachgiebigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6716b9eb-2ea5-3197-b6d8-7d0f8bf50f26",
                                        "entry_id": "0d9cb98a-67cf-320c-bc93-e78c67919fd2",
                                        "glosses": [
                                            "Eigenschaft von Gegenständen, sich auf Druck hin zu verformen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6cc08491-1829-31d9-b8d5-c6fa2c14ea0b",
                                        "entry_id": "0d9cb98a-67cf-320c-bc93-e78c67919fd2",
                                        "glosses": [
                                            "psychische Verfasstheit, auch mal auf Durchsetzung von Prinzipien, Wünschen oder dergleichen zu verzichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1683540e-85ab-44dd-abb4-e64f34ff044a",
                                                "sense_id": "6cc08491-1829-31d9-b8d5-c6fa2c14ea0b",
                                                "text": "„Er war immer freundlich zu mir gewesen, und wenn er einmal ungerecht war, dann immer aus Nachgiebigkeit und zu meinem Besten.“"
                                            },
                                            {
                                                "example_id": "04fda05e-7cd2-433c-878a-416e6162fac0",
                                                "sense_id": "6cc08491-1829-31d9-b8d5-c6fa2c14ea0b",
                                                "text": "„Der Marchese triumphierte, und Veronica zeigte sich erfreut über meine Nachgiebigkeit.“"
                                            },
                                            {
                                                "example_id": "877b6921-71d7-4444-a638-45a45dafa8e0",
                                                "sense_id": "6cc08491-1829-31d9-b8d5-c6fa2c14ea0b",
                                                "text": "„Er hatte eine Natur, die alle Falten mit der zärtlichen Nachgiebigkeit eines schönen Samtstoffes annahm und behielt.“"
                                            },
                                            {
                                                "example_id": "3c120d79-783e-4d70-9a4b-4d3e6c4130a5",
                                                "sense_id": "6cc08491-1829-31d9-b8d5-c6fa2c14ea0b",
                                                "text": "„Sie spürte seine Nachgiebigkeit und seinen Unglauben; es waren die Spinngewebe, die sie wieder umwickeln und lähmen wollten.“"
                                            },
                                            {
                                                "example_id": "d85bc348-92f0-4aaf-9dbb-b95fcffcdc96",
                                                "sense_id": "6cc08491-1829-31d9-b8d5-c6fa2c14ea0b",
                                                "text": "„Solche Nachgiebigkeit begünstige die Unordnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
