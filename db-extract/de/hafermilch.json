                ],
                "senses": [
                    {
                        "sense_id": "95bf7f57-84b2-354a-9d11-d69e2a17f74e",
                        "entry_id": "a5b7cee7-26ce-33ec-b58b-591a74ad13a2",
                        "glosses": [
                            "der Milch ähnliches Getränk aus Haferkörnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f451c797-2fa7-4b43-8782-0562b22032a0",
                                "sense_id": "95bf7f57-84b2-354a-9d11-d69e2a17f74e",
                                "text": "„Eingesetzt wird Hafermilch unter anderem auch von Veganern, Ovo-Vegetariern sowie Menschen mit Laktoseintoleranz, Milcheiweiß-Allergie oder Sojaallergie.“"
                            },
                            {
                                "example_id": "a5ac9db4-6136-46bc-8dcb-2cfe414907a1",
                                "sense_id": "95bf7f57-84b2-354a-9d11-d69e2a17f74e",
                                "text": "„Die Herstellung von Hafermilch verbraucht im Vergleich zu Kuhmilch viel weniger Wasser und Landfläche.“"
                            },
                            {
                                "example_id": "09045522-1751-459f-a9d1-5ff22e943b31",
                                "sense_id": "95bf7f57-84b2-354a-9d11-d69e2a17f74e",
                                "text": "„Für Hafermilch leiden keine Kühe.“"
                            },
                            {
                                "example_id": "a28ce2cf-a7fb-4912-b6f3-69fb8d076d1d",
                                "sense_id": "95bf7f57-84b2-354a-9d11-d69e2a17f74e",
                                "text": "„Hafermilch schmeckt oft süßer als Kuhmilch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
