                ],
                "senses": [
                    {
                        "sense_id": "a77f2f7f-3da7-379d-ae93-bc812876c09b",
                        "entry_id": "0f750fcc-c8d2-3170-9bad-2d08a122902e",
                        "glosses": [
                            "A free person",
                            "A person who is not a serf or slave."
                        ],
                        "tags": [
                            "historical",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4d40ff81-7663-3eff-8fac-7154cf02b7e6",
                        "entry_id": "0f750fcc-c8d2-3170-9bad-2d08a122902e",
                        "glosses": [
                            "A free person",
                            "A burgher with full freedom of a city, as opposed to nobles, outsiders, bondsmen, and others."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "36d66faa-e6ee-310c-abd5-ecf69d30df0d",
                        "entry_id": "0f750fcc-c8d2-3170-9bad-2d08a122902e",
                        "glosses": [
                            "A free person",
                            "A person who has received an honorary freedom of a city."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8148e9e5-e0c4-35aa-a090-75925d8434c5",
                        "entry_id": "0f750fcc-c8d2-3170-9bad-2d08a122902e",
                        "glosses": [
                            "A free person",
                            "A person who is a citizen of a free country, as opposed to a subject of a tyranny or totalitarian dictatorship."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3029c7fb-132d-492e-a347-26fdb1e0687c",
                                "sense_id": "8148e9e5-e0c4-35aa-a090-75925d8434c5",
                                "text": "There breathes no being but has some pretence / To that fine instinct called poetic sense; […] / The freeman, casting with unpurchased hand / The vote that shakes the turrets of the land."
                            }
                        ]
                    },
                    {
                        "sense_id": "4743198d-0ec3-3548-83d6-2a6cfc35f30f",
                        "entry_id": "0f750fcc-c8d2-3170-9bad-2d08a122902e",
                        "glosses": [
                            "A free person",
                            "A person who immigrated to Australia freely, as opposed to those transported as convicts, or such a transported convict who has regained his freedom."
                        ],
                        "tags": [
                            "Australia",
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8e34837c-455b-3be7-933b-eb22c6e63894",
                        "entry_id": "0f750fcc-c8d2-3170-9bad-2d08a122902e",
                        "glosses": [
                            "A free person",
                            "An independent fur trapper."
                        ],
