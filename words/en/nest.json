{
    "word_family": [
        "nesting",
        "nested",
        "nestling",
        "nester"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a3e8209-643d-3158-ae8a-118f2844c726",
                    "sense_definition": "A structure built by a bird or other animal as a place to lay eggs and raise young.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle built a large <w>nest</w> at the top of the tree.",
                            "target_lang_translations": {
                                "ru": "Орел свил большое <w>гнездо</w> на вершине дерева.",
                                "zh": "老鹰在树顶筑了一个大<w>巢</w>。"
                            }
                        },
                        {
                            "text": "We found a bird's <w>nest</w> with three blue eggs inside it.",
                            "target_lang_translations": {
                                "ru": "Мы нашли птичье <w>гнездо</w> с тремя голубыми яйцами внутри.",
                                "zh": "我们发现了一个鸟<w>巢</w>，里面有三枚蓝色的蛋。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bird's nest",
                        "build a nest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Структура, построенная птицей или другим животным для откладывания яиц и выращивания потомства.",
                        "zh": "鸟类或其他动物为产卵和抚育后代而建造的结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "жилище птиц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巢",
                                "target_lang_sense_clarification": "动物的窝"
                            },
                            {
                                "target_lang_word": "鸟巢",
                                "target_lang_sense_clarification": "鸟类的窝"
                            },
                            {
                                "target_lang_word": "窝",
                                "target_lang_sense_clarification": "动物的栖息处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c5d371e-dddc-3809-ba0b-e81990604be2",
                    "sense_definition": "A home that a child or young adult shares with their parents, often used metaphorically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It can be difficult for parents when their children finally leave the <w>nest</w>.",
                            "target_lang_translations": {
                                "ru": "Родителям бывает трудно, когда их дети наконец покидают <w>гнездо</w>.",
                                "zh": "当孩子们最终离开<w>家</w>时，父母可能会感到很难过。"
                            }
                        },
                        {
                            "text": "He is planning to fly the <w>nest</w> and go to university next year.",
                            "target_lang_translations": {
                                "ru": "Он планирует вылететь из <w>гнезда</w> и поступить в университет в следующем году.",
                                "zh": "他计划明年离开<w>家</w>去上大学。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leave the nest",
                        "fly the nest",
                        "empty nest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дом, в котором ребенок или молодой человек живет с родителями (часто используется метафорически).",
                        "zh": "指子女与父母共同居住的家，常用于比喻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "родительский дом"
                            },
                            {
                                "target_lang_word": "родительский дом",
                                "target_lang_sense_clarification": "семья"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "家",
                                "target_lang_sense_clarification": "家庭住所"
                            },
                            {
                                "target_lang_word": "父母家",
                                "target_lang_sense_clarification": "子女成年前居住的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0afd0b53-4491-3545-977e-ec2be208d48b",
                    "sense_definition": "A snug, comfortable, or private place to rest or live.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a cozy <w>nest</w> of blankets and pillows on the sofa.",
                            "target_lang_translations": {
                                "ru": "Она устроила уютное <w>гнёздышко</w> из одеял и подушек на диване.",
                                "zh": "她在沙发上用毯子和枕头搭了一个舒适的<w>小窝</w>。"
                            }
                        },
                        {
                            "text": "The small cottage was a perfect <w>nest</w> for the newlyweds.",
                            "target_lang_translations": {
                                "ru": "Маленький коттедж был идеальным <w>гнёздышком</w> для молодоженов.",
                                "zh": "这间小屋是新婚夫妇完美的<w>安乐窝</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "love nest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уютное, комфортное или уединенное место для отдыха или жизни.",
                        "zh": "舒适、温馨或私密的休息或居住空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнёздышко",
                                "target_lang_sense_clarification": "уютное место"
                            },
                            {
                                "target_lang_word": "уютный уголок",
                                "target_lang_sense_clarification": "комфортное место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小窝",
                                "target_lang_sense_clarification": "温馨的住处"
                            },
                            {
                                "target_lang_word": "安乐窝",
                                "target_lang_sense_clarification": "舒适的居所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42e9430f-ffb3-3bc6-a736-91b8fcbbd168",
                    "sense_definition": "A place where bad or dangerous people gather.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police raided a <w>nest</w> of thieves in the old warehouse.",
                            "target_lang_translations": {
                                "ru": "Полиция совершила налет на <w>логово</w> воров на старом складе.",
                                "zh": "警察突袭了旧仓库里的一个窃贼<w>窝点</w>。"
                            }
                        },
                        {
                            "text": "That bar is known to be a <w>nest</w> of spies and criminals.",
                            "target_lang_translations": {
                                "ru": "Этот бар известен как <w>гнездо</w> шпионов и преступников.",
                                "zh": "那家酒吧被认为是间谍和罪犯的<w>老巢</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nest of vipers",
                        "nest of thieves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где собираются преступники или опасные люди.",
                        "zh": "坏人或危险分子聚集的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притон",
                                "target_lang_sense_clarification": "сборище преступников"
                            },
                            {
                                "target_lang_word": "логово",
                                "target_lang_sense_clarification": "место обитания врагов"
                            },
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "средоточие чего-то плохого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "窝点",
                                "target_lang_sense_clarification": "犯罪活动的聚集地"
                            },
                            {
                                "target_lang_word": "老巢",
                                "target_lang_sense_clarification": "坏人的藏身处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0229a3d-686b-3754-a442-93b294c4320d",
                    "sense_definition": "A set of objects of different sizes that fit inside one another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a <w>nest</w> of tables to save space in the living room.",
                            "target_lang_translations": {
                                "ru": "Мы купили <w>набор</w> столиков, чтобы сэкономить место в гостиной.",
                                "zh": "我们买了一<w>套</w>组合桌，以节省客厅的空间。"
                            }
                        },
                        {
                            "text": "The toy consists of a <w>nest</w> of boxes, each smaller than the last.",
                            "target_lang_translations": {
                                "ru": "Игрушка состоит из <w>набора</w> коробок, каждая из которых меньше предыдущей.",
                                "zh": "这个玩具由一<w>套</w>盒子组成，每一个都比前一个更小。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nest of tables"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор предметов разного размера, которые вставляются один в другой.",
                        "zh": "一套大小不一、可以层层套在一起的物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набор",
                                "target_lang_sense_clarification": "комплект предметов"
                            },
                            {
                                "target_lang_word": "комплект",
                                "target_lang_sense_clarification": "группа предметов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "套件",
                                "target_lang_sense_clarification": "成套的物品"
                            },
                            {
                                "target_lang_word": "组合",
                                "target_lang_sense_clarification": "成组的物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20f00005-3516-3012-8df9-544245ea2fab",
                    "sense_definition": "A fortified or hidden position for a weapon or lookout.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers attacked the enemy machine gun <w>nest</w> on the hill.",
                            "target_lang_translations": {
                                "ru": "Солдаты атаковали вражеское пулеметное <w>гнездо</w> на холме.",
                                "zh": "士兵们袭击了山上的敌军机枪<w>阵地</w>。"
                            }
                        },
                        {
                            "text": "Snipers were hiding in a <w>nest</w> on the roof of the building.",
                            "target_lang_translations": {
                                "ru": "Снайперы прятались в <w>гнезде</w> на крыше здания.",
                                "zh": "狙击手躲在楼顶的一个隐蔽<w>据点</w>里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "machine gun nest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укрепленная или скрытая позиция для оружия или наблюдателя.",
                        "zh": "用于武器或观察的加固或隐蔽阵地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "огневая точка"
                            },
                            {
                                "target_lang_word": "пулемётное гнездо",
                                "target_lang_sense_clarification": "военная позиция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阵地",
                                "target_lang_sense_clarification": "军事防御点"
                            },
                            {
                                "target_lang_word": "据点",
                                "target_lang_sense_clarification": "隐蔽的军事位置"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab6b88b6-0b20-3c8e-9730-d7d567b07e3f",
                    "sense_definition": "To build or use a nest, usually referring to birds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many birds <w>nest</w> in these woods during the spring.",
                            "target_lang_translations": {
                                "ru": "Многие птицы <w>гнездятся</w> в этих лесах весной.",
                                "zh": "春天，许多鸟儿在这些树林里<w>筑巢</w>。"
                            }
                        },
                        {
                            "text": "The swans are <w>nesting</w> near the edge of the lake.",
                            "target_lang_translations": {
                                "ru": "Лебеди <w>гнездятся</w> у края озера.",
                                "zh": "天鹅正在湖边<w>筑巢</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Строить гнездо или жить в нем (обычно о птицах).",
                        "zh": "建造或使用巢穴，通常指鸟类。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнездиться",
                                "target_lang_sense_clarification": "жить в гнезде"
                            },
                            {
                                "target_lang_word": "вить гнёзда",
                                "target_lang_sense_clarification": "строить жилище"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "筑巢",
                                "target_lang_sense_clarification": "建造巢穴"
                            },
                            {
                                "target_lang_word": "栖息",
                                "target_lang_sense_clarification": "在巢中居住"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20cdf5ff-3ccb-317c-906a-8bdb79457f60",
                    "sense_definition": "To fit an object or structure inside another of the same type.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>nest</w> these empty boxes to make them easier to carry.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>вложить</w> эти пустые коробки одну в другую, чтобы их было легче нести.",
                                "zh": "你可以把这些空盒子<w>套入</w>在一起，这样更容易携带。"
                            }
                        },
                        {
                            "text": "The programmer decided to <w>nest</w> the loops within the function.",
                            "target_lang_translations": {
                                "ru": "Программист решил <w>вложить</w> циклы внутрь функции.",
                                "zh": "程序员决定将循环<w>嵌套</w>在函数内。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вкладывать объект или структуру внутрь другого объекта того же типа.",
                        "zh": "将一个物体或结构放入另一个同类物体中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкладывать",
                                "target_lang_sense_clarification": "помещать внутрь"
                            },
                            {
                                "target_lang_word": "вставлять",
                                "target_lang_sense_clarification": "помещать один в другой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嵌套",
                                "target_lang_sense_clarification": "将结构置于另一结构内"
                            },
                            {
                                "target_lang_word": "套入",
                                "target_lang_sense_clarification": "将物体放入另一物体中"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cd9b91aa-644b-30be-83f9-2c57481a97c3",
                    "sense_definition": "A surname from German or Welsh.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Nest</w> will see you in his office now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Нест</w> примет вас в своем кабинете сейчас.",
                                "zh": "内斯特先生现在要在办公室见你。"
                            }
                        },
                        {
                            "text": "I have never met anyone with the surname <w>Nest</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не встречал никого с фамилией <w>Нест</w>.",
                                "zh": "我以前从未见过姓内斯特的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "German or Welsh origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия немецкого или валлийского происхождения.",
                        "zh": "源自德语或威尔士语的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нест",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内斯特",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}