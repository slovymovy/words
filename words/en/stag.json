{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "824343ab-8ac7-3966-8385-42ae8c8258bf",
                    "sense_definition": "An adult male deer, especially a red deer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A majestic <w>stag</w> with large antlers appeared at the edge of the forest.",
                            "target_lang_translations": {
                                "ru": "На опушке леса появился величественный <w>олень</w> с большими рогами."
                            }
                        },
                        {
                            "text": "The hunters tracked the <w>stag</w> through the deep snow for several hours.",
                            "target_lang_translations": {
                                "ru": "Охотники несколько часов выслеживали <w>оленя</w> по глубокому снегу."
                            }
                        }
                    ],
                    "synonyms": [
                        "hart",
                        "buck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрослый самец оленя (особенно благородного оленя)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "олень",
                                "target_lang_sense_clarification": "самец оленя"
                            },
                            {
                                "target_lang_word": "рогач",
                                "target_lang_sense_clarification": "олень с рогами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d597308-0a78-38b7-9e78-921d063f1fe0",
                    "sense_definition": "A party or gathering held for a man who is about to get married, attended by his male friends.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to travel to Prague for his weekend <w>stag</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили поехать в Прагу на его праздничный <w>мальчишник</w> на выходных."
                            }
                        },
                        {
                            "text": "He invited ten of his closest friends to the <w>stag</w>.",
                            "target_lang_translations": {
                                "ru": "Он пригласил на <w>мальчишник</w> десятерых ближайших друзей."
                            }
                        }
                    ],
                    "synonyms": [
                        "bachelor party",
                        "stag do",
                        "stag party"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used casually, especially in British and Commonwealth English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вечеринка для жениха перед свадьбой в кругу друзей-мужчин; мальчишник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мальчишник",
                                "target_lang_sense_clarification": "предсвадебная мужская вечеринка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb259b92-0da8-3d16-b1c0-d0c78edc9d4c",
                    "sense_definition": "An unmarried man, or a man who attends a social function without a female companion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several <w>stags</w> stood by the bar discussing football during the dance.",
                            "target_lang_translations": {
                                "ru": "Несколько <w>мужчин без пары</w> стояли у бара, обсуждая футбол во время танцев."
                            }
                        },
                        {
                            "text": "The banquet was organized exclusively for <w>stags</w> and alumni.",
                            "target_lang_translations": {
                                "ru": "Банкет был организован исключительно для <w>холостяков</w> и выпускников."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Somewhat dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неженатый мужчина или мужчина, пришедший на вечер или мероприятие без пары."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холостяк",
                                "target_lang_sense_clarification": "неженатый мужчина"
                            },
                            {
                                "target_lang_word": "мужчина без дамы",
                                "target_lang_sense_clarification": "пришедший без спутницы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d048d152-34b1-30d0-b53e-c888c2554e03",
                    "sense_definition": "A person who applies for shares in a new stock issue with the intention of selling them immediately at a profit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A financial <w>stag</w> aims to make a quick profit from new public offerings.",
                            "target_lang_translations": {
                                "ru": "Финансовый <w>спекулянт</w> стремится быстро нажиться на первичных публичных размещениях."
                            }
                        },
                        {
                            "text": "The massive oversubscription attracted every speculative <w>stag</w> in the market.",
                            "target_lang_translations": {
                                "ru": "Огромный переизбыток заявок привлёк каждого биржевого <w>спекулянта</w> на рынке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Биржевой спекулянт, подписывающийся на новые акции с целью немедленной перепродажи с прибылью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стаггер",
                                "target_lang_sense_clarification": "спекулянт новыми эмиссиями акций"
                            },
                            {
                                "target_lang_word": "биржевой спекулянт",
                                "target_lang_sense_clarification": "играющий на повышении при первичном размещении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cd6fdf9-cdef-3e78-b79d-86ef4dded87f",
                    "sense_definition": "A period of guard or sentry duty, especially in military contexts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier stood on <w>stag</w> through the freezing cold night.",
                            "target_lang_translations": {
                                "ru": "Солдат простоял <w>в карауле</w> всю морозную ночь."
                            }
                        },
                        {
                            "text": "After four hours of <w>stag</w>, he was finally relieved by his squadmate.",
                            "target_lang_translations": {
                                "ru": "После четырёх часов <w>дежурства</w> его наконец сменил сослуживец."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on stag"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Military slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Караул, дежурство или стояние на часах (в военном сленге)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "караул",
                                "target_lang_sense_clarification": "военное дежурство"
                            },
                            {
                                "target_lang_word": "дежурство",
                                "target_lang_sense_clarification": "несение вахты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a44669b9-b9c2-3fda-a193-382e7b406aed",
                    "sense_definition": "A stag beetle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child found an unusual <w>stag</w> crawling on an old oak log.",
                            "target_lang_translations": {
                                "ru": "Ребёнок нашёл необычного <w>жука-оленя</w>, ползущего по старому дубовому бревну."
                            }
                        },
                        {
                            "text": "Male <w>stags</w> possess enlarged mandibles that resemble the horns of deer.",
                            "target_lang_translations": {
                                "ru": "Самцы <w>жуков-рогачей</w> обладают увеличенными челюстями, напоминающими оленьи рога."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жук-олень, жук-рогач."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жук-олень",
                                "target_lang_sense_clarification": "насекомое"
                            },
                            {
                                "target_lang_word": "рогач",
                                "target_lang_sense_clarification": "жук с рогообразными челюстями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9a5ad2a-61d0-3e6e-b0a9-79e776e2e5ab",
                    "sense_definition": "An informer or snitch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The convicts suspected that a <w>stag</w> had tipped off the guards.",
                            "target_lang_translations": {
                                "ru": "Осуждённые заподозрили, что охрану предупредил <w>стукач</w>."
                            }
                        },
                        {
                            "text": "He refused to cooperate because nobody in the neighborhood trusted a <w>stag</w>.",
                            "target_lang_translations": {
                                "ru": "Он отказался сотрудничать, потому что на районе никто не доверял <w>доносчикам</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Archaic criminal cant"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Old criminal slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осведомитель, доносчик (в старом криминальном жаргоне)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стукач",
                                "target_lang_sense_clarification": "осведомитель"
                            },
                            {
                                "target_lang_word": "доносчик",
                                "target_lang_sense_clarification": "информатор"
                            }
                        ]
