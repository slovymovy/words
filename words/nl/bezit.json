                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bezit</w> de moed om voor je eigen mening uit te komen.",
                            "target_lang_translations": {
                                "en": "<w>Have</w> the courage to speak up for your own opinion.",
                                "ru": "<w>Имей</w> мужество отстаивать собственное мнение."
                            }
                        },
                        {
                            "text": "<w>Bezit</w> geduld wanneer de situatie moeilijk wordt.",
                            "target_lang_translations": {
