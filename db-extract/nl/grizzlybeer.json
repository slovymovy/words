                        "examples": [
                            {
                                "example_id": "c101f416-eec8-4b3f-8779-2b86ec08c2c9",
                                "sense_id": "86bee06f-2b57-38cf-96c8-4ff70d1a21f7",
                                "text": "Grizzlyberen zijn uitstekende zwemmers; in het juiste seizoen vangen ze zalm, forel en andere vissoorten uit de rivier."
                            },
                            {
                                "example_id": "a14a6f32-5ebd-4a02-9422-c51751f19c45",
                                "sense_id": "86bee06f-2b57-38cf-96c8-4ff70d1a21f7",
                                "text": "Zeer weinig mensen durven deze bijna 5.000 kilometer lange trail te lopen, die precies door het midden van Amerika loopt van Montana naar New Mexico, met af en toe een gratis grizzlybeer onderweg."
                            }
                        ]
                    }
