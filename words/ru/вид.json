    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a860a0e4-192a-3a8a-84a9-8374c5374d43",
                    "sense_definition": "Внешность, наружность; то, как выглядит человек или предмет.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него был очень усталый <вид> после долгой работы.",
                            "target_lang_translations": {
                                "en": "He had a very tired <look> after long work.",
                                "zh": "长时间工作后，他显得一副很疲惫的<w>样子</w>。"
                            }
                        },
                        {
                            "text": "Приведите свой внешний <вид> в порядок перед важной встречей.",
                            "target_lang_translations": {
                                "en": "Tidy up your <appearance> before the important meeting.",
                                "zh": "重要会面前，请先整理好自己的<w>仪容</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "облик",
                        "внешность"
                    ],
                    "common_phrases": [
                        "внешний вид",
                        "иметь вид",
                        "делать вид",
                        "для вида"
                    ],
                    "target_lang_definitions": {
                        "en": "Appearance, look; the way a person or object looks.",
                        "zh": "外表，外貌；人或事物呈现出来的样子。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appearance",
                                "target_lang_sense_clarification": "physical look"
                            },
                            {
                                "target_lang_word": "look",
                                "target_lang_sense_clarification": "visual impression"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "样子",
                                "target_lang_sense_clarification": "人的外在样貌、神情"
                            },
                            {
                                "target_lang_word": "外表",
                                "target_lang_sense_clarification": "外表、外观"
                            },
                            {
                                "target_lang_word": "仪容",
                                "target_lang_sense_clarification": "强调整理和仪态时"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfa83803-029a-3862-a660-0ea9c0f9445b",
                    "sense_definition": "Местность, открывающаяся взору; пейзаж, картина природы или города.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "scenery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из нашего окна открывается прекрасный <вид> на горы.",
                            "target_lang_translations": {
                                "en": "There is a beautiful <view> of the mountains from our window.",
                                "zh": "从我们窗户望出去，可以看到美丽的山间<w>景色</w>。"
                            }
                        },
                        {
                            "text": "Туристы долго любовались красивым <видом> старого города.",
                            "target_lang_translations": {
                                "en": "The tourists admired the beautiful <view> of the old city for a long time.",
                                "zh": "游客们久久欣赏着老城优美的<w>景色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "панорама",
                        "картина",
                        "пейзаж"
                    ],
                    "common_phrases": [
                        "вид из окна",
                        "вид на море",
                        "красивый вид"
                    ],
                    "target_lang_definitions": {
                        "en": "An area opening to the view; scenery, a landscape or picture of nature or a city.",
                        "zh": "映入眼帘的景象；自然或城市的风景。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "scenery"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "景色",
                                "target_lang_sense_clarification": "看到的自然或城市风光"
                            },
                            {
                                "target_lang_word": "风景",
                                "target_lang_sense_clarification": "窗外、远处的风景"
                            },
                            {
                                "target_lang_word": "景观",
                                "target_lang_sense_clarification": "较书面，指视野中的景象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8477f378-ab17-310b-ba65-1e748ca06f16",
                    "sense_definition": "Тип, категория, разряд предметов или явлений, обладающих общими признаками.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом магазине продаются различные <виды> сыра и колбасы.",
                            "target_lang_translations": {
                                "en": "Various <kinds> of cheese and sausage are sold in this store.",
                                "zh": "这家商店出售不同<w>种类</w>的奶酪和香肠。"
                            }
                        },
                        {
                            "text": "Мы обсуждали разные <виды> транспорта для нашего путешествия.",
                            "target_lang_translations": {
                                "en": "We discussed different <types> of transport for our trip.",
                                "zh": "我们讨论了这次旅行可以选择的不同<w>类型</w>的交通方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "тип",
                        "разновидность",
                        "класс",
                        "категория"
                    ],
                    "common_phrases": [
                        "вид спорта",
                        "вид деятельности",
                        "разные виды"
                    ],
                    "target_lang_definitions": {
                        "en": "Type, category, or class of objects or phenomena possessing common features.",
                        "zh": "具有共同特征的类型、类别或品种。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kind",
                                "target_lang_sense_clarification": "category"
                            },
                            {
                                "target_lang_word": "type",
                                "target_lang_sense_clarification": "classification"
                            },
                            {
                                "target_lang_word": "sort",
                                "target_lang_sense_clarification": "variety"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "种类",
                                "target_lang_sense_clarification": "普通、常用说法"
                            },
                            {
                                "target_lang_word": "类型",
                                "target_lang_sense_clarification": "强调分类时"
                            },
                            {
                                "target_lang_word": "类别",
                                "target_lang_sense_clarification": "较正式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a62e4ddb-0778-3d65-b53f-e87f6c8fc1f3",
                    "sense_definition": "Форма, состояние, в котором находится или проявляется что-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Отчёт нужно представить начальнику в письменном <виде>.",
                            "target_lang_translations": {
                                "en": "The report must be submitted to the boss in written <form>.",
                                "zh": "报告需要以书面<w>形式</w>提交给领导。"
                            }
                        },
                        {
                            "text": "Вода в твёрдом <виде> превращается в холодный лёд.",
                            "target_lang_translations": {
                                "en": "Water in a solid <state> turns into cold ice.",
                                "zh": "水以固体<w>状态</w>存在时，就是冰。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "в письменном виде",
                        "в чистом виде",
                        "в виде исключения",
                        "ни в коем виде"
                    ],
                    "target_lang_definitions": {
                        "en": "Form or state in which something exists or manifests itself.",
                        "zh": "事物存在或表现出来的形式、状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "form",
                                "target_lang_sense_clarification": "shape or format"
                            },
                            {
                                "target_lang_word": "state",
                                "target_lang_sense_clarification": "condition"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "形式",
                                "target_lang_sense_clarification": "指书面、口头等表现方式"
                            },
                            {
                                "target_lang_word": "状态",
                                "target_lang_sense_clarification": "指存在或呈现的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2906a100-6c13-3787-807a-912b8cb1afc7",
                    "sense_definition": "Грамматическая категория глагола, показывающая характер протекания действия во времени (завершённость или длительность).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В русском языке глаголы имеют совершенный и несовершенный <вид>.",
                            "target_lang_translations": {
                                "en": "In Russian, verbs have perfective and imperfective <aspect>.",
                                "zh": "在俄语中，动词有完成体和未完成<w>体</w>。"
                            }
                        },
                        {
                            "text": "Чтобы показать результат действия, нужно использовать совершенный <вид>.",
                            "target_lang_translations": {
                                "en": "To show the result of an action, you need to use the perfective <aspect>.",
                                "zh": "要表示动作的结果，就需要使用完成<w>体</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "совершенный вид",
                        "несовершенный вид",
                        "глагол несовершенного вида"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Grammatical category of a verb showing the character of the action's flow in time (completeness or duration).",
                        "zh": "动词的语法范畴，表示动作在时间进程中的性质，如完成或持续。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aspect",
                                "target_lang_sense_clarification": "grammar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体",
                                "target_lang_sense_clarification": "语法术语，指动词体"
                            },
                            {
                                "target_lang_word": "体貌",
                                "target_lang_sense_clarification": "较完整的语法说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "656fb633-3d33-35d7-b913-110dfc9861b7",
                    "sense_definition": "Поле зрения, возможность видеть; сфера внимания и мыслей (используется в устойчивых выражениях).",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "idiom_sight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, имейте в <виду>, что магазин закрывается через час.",
                            "target_lang_translations": {
                                "en": "Please bear in <mind> that the store closes in an hour.",
                                "zh": "请把商店一小时后关门这件事放在<w>心上</w>。"
                            }
                        },
                        {
                            "text": "Мы совсем упустили из <виду> этот важный документ при проверке.",
                            "target_lang_translations": {
                                "en": "We completely lost <sight> of this important document during the check.",
                                "zh": "检查时，这份重要文件完全脱离了我们的<w>视线</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "поле зрения"
                    ],
                    "common_phrases": [
                        "иметь в виду",
                        "упустить из виду",
                        "подать вид",
                        "скрыться из вида"
                    ],
                    "target_lang_definitions": {
                        "en": "Field of vision, ability to see; sphere of attention and thoughts (used in set expressions).",
                        "zh": "视野、看见的范围；也用于固定表达中，表示注意或记挂的范围。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sight",
                                "target_lang_sense_clarification": "field of vision"
                            },
                            {
                                "target_lang_word": "mind",
                                "target_lang_sense_clarification": "in idioms like 'bear in mind'"
                            },
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "in idioms"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心上",
                                "target_lang_sense_clarification": "用于“放在心上、记住”这类意思"
                            },
                            {
                                "target_lang_word": "视线",
                                "target_lang_sense_clarification": "指看见的范围"
                            },
                            {
                                "target_lang_word": "视野",
                                "target_lang_sense_clarification": "较抽象，指注意范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c26723b9-adf0-34b0-bfb2-58874a0439da",
                    "sense_definition": "Основная структурная единица в биологической классификации, объединяющая особей с общими признаками.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот редкий <вид> птиц занесён в Красную книгу.",
                            "target_lang_translations": {
                                "en": "This rare bird <species> is listed in the Red Book.",
                                "zh": "这种珍稀鸟类<w>物种</w>已被列入《红皮书》。"
                            }
                        },
                        {
                            "text": "Учёные открыли новый <вид> бабочек в тропических лесах Амазонки.",
                            "target_lang_translations": {
                                "en": "Scientists discovered a new <species> of butterflies in the Amazon rainforests.",
                                "zh": "科学家在亚马孙热带雨林发现了一种新的蝴蝶<w>物种</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "разновидность"
                    ],
                    "common_phrases": [
                        "биологический вид",
                        "исчезающий вид",
                        "происхождение видов"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Main structural unit in biological classification, uniting individuals with common features.",
                        "zh": "生物分类中的基本单位，包含具有共同特征的一群个体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "species",
                                "target_lang_sense_clarification": "biology"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "物种",
                                "target_lang_sense_clarification": "生物分类学术语"
                            },
                            {
                                "target_lang_word": "种",
                                "target_lang_sense_clarification": "较简短的分类说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c784fffb-0f9b-30ca-89fb-c1d448368abf",
                    "sense_definition": "Намерения, планы, расчёты на что-либо в будущем (обычно во множественном числе).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plans",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У родителей были большие <виды> на блестящее будущее их сына.",
                            "target_lang_translations": {
                                "en": "The parents had big <plans> for their son's brilliant future.",
                                "zh": "父母对儿子光明的未来抱有很大的<w>期望</w>。"
                            }
                        },
                        {
                            "text": "Фермеры активно обсуждали <виды> на урожай в этом засушливом году.",
                            "target_lang_translations": {
                                "en": "Farmers were actively discussing the <prospects> for the harvest in this dry year.",
                                "zh": "农民们正在积极讨论这个干旱年景下收成的<w>前景</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "план"
                    ],
                    "common_phrases": [
                        "виды на урожай",
                        "иметь виды на"
                    ],
                    "target_lang_definitions": {
                        "en": "Intentions, plans, or expectations for something in the future.",
                        "zh": "对未来的计划、打算或预期，常用复数意义。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prospects",
                                "target_lang_sense_clarification": "expectations"
                            },
                            {
                                "target_lang_word": "plans",
                                "target_lang_sense_clarification": "intentions"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前景",
                                "target_lang_sense_clarification": "对未来结果的期待"
                            },
                            {
                                "target_lang_word": "期望",
                                "target_lang_sense_clarification": "对某人或某事寄予的希望"
                            },
                            {
                                "target_lang_word": "打算",
                                "target_lang_sense_clarification": "计划、打算的意思"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b3df9fc-2700-32b4-8d44-e13a548af2c1",
                    "sense_definition": "Документ, дающий право на проживание (в современном языке используется в сочетании «вид на жительство»).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Иностранным гражданам необходимо получить <вид> на жительство для легальной работы.",
                            "target_lang_translations": {
                                "en": "Foreign citizens need to obtain a residence <permit> for legal work.",
                                "zh": "外国公民必须取得<w>居留许可</w>才能合法工作。"
                            }
                        },
                        {
                            "text": "Полицейский вежливо попросил предъявить паспорт или <вид> на жительство.",
                            "target_lang_translations": {
                                "en": "The police officer politely asked to show a passport or residence <permit>.",
                                "zh": "警察礼貌地请对方出示护照或<w>居留证</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "вид на жительство"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "official"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Document giving the right to residence (used in the phrase 'residence permit').",
                        "zh": "允许在一国居住的证件，常见于“居留许可”这一说法。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "permit",
                                "target_lang_sense_clarification": "document"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "居留许可",
                                "target_lang_sense_clarification": "正式说法，指合法居住许可文件"
                            },
                            {
                                "target_lang_word": "居留证",
                                "target_lang_sense_clarification": "常指居住许可证明文件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "aecc9eda-9178-35f5-8d34-8b4499bbba48",
                    "sense_definition": "Река в Германии.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "toponym",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Небольшая река <Вид> протекает по живописной территории Германии.",
                            "target_lang_translations": {
                                "en": "The small river <Wied> flows through a picturesque territory of Germany.",
                                "zh": "小河<w>维德河</w>流经德国一片风景优美的地区。"
                            }
                        },
                        {
                            "text": "Туристы остановились на берегу реки <Вид>, чтобы отдохнуть.",
                            "target_lang_translations": {
                                "en": "Tourists stopped on the bank of the river <Wied> to rest.",
                                "zh": "游客们在<w>维德河</w>河边停下来休息。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A river in Germany.",
                        "zh": "德国的一条河流。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Wied",
                                "target_lang_sense_clarification": "river"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维德河",
                                "target_lang_sense_clarification": "德国的一条河流名称"
                            }
                        ]
                    }
