                    {
                        "translation_id": "25058459-7f16-41fd-b28b-5fcedd3cc1e8",
                        "source_entry_id": "a9168cb3-4873-333e-bbe7-8b805749c2a6",
                        "source_sense_id": "ccebd501-91c9-3d55-ac39-1693ea9662c7",
                        "target_lang_word": "shining",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shining",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "399f3dcb-67c4-3bbc-ad6b-82747e1be9ff",
                                        "entry_id": "a6e99eb7-4572-31ef-bd53-80fa1d1920f7",
                                        "glosses": [
                                            "Emitting light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78e1330b-374c-4e38-a7d8-5c4d220941db",
                                                "sense_id": "399f3dcb-67c4-3bbc-ad6b-82747e1be9ff",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff0c62e5-3e2a-358d-8797-e212f4b4ca17",
                                        "entry_id": "a6e99eb7-4572-31ef-bd53-80fa1d1920f7",
                                        "glosses": [
                                            "Reflecting light."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f80333ac-c3f9-362e-baa4-374239a29a38",
                                        "entry_id": "a6e99eb7-4572-31ef-bd53-80fa1d1920f7",
                                        "glosses": [
                                            "Having a high polish or sheen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debaabc2-f7e7-4628-b37c-49a0a345fb23",
                                                "sense_id": "f80333ac-c3f9-362e-baa4-374239a29a38",
                                                "text": "He was at the wedding, too. His beard was flowinger and redder, and the part in the back of his head shininger than ever. He had an elegant time. He was so full of himself you would have thought it was his own party."
                                            },
                                            {
                                                "example_id": "68699208-6734-48ff-9bb3-14607b30bce8",
                                                "sense_id": "f80333ac-c3f9-362e-baa4-374239a29a38",
                                                "text": "Hardly knowing what he meant, she plucked a many-headed specimen with a long stalk. At the end of it was such a shining needle that it dazzled her eyes so that she couldn’t see how she did the sewing up with it. But however it was done, the torn sleeve, she says, “didn’t look like wanting mending any more, but was better tore ’cos it let you see he had a shininger coat under.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b91f2263-684e-38c3-9015-49cb28424179",
                                        "entry_id": "a6e99eb7-4572-31ef-bd53-80fa1d1920f7",
                                        "glosses": [
                                            "Having exceptional merit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99ac2f29-843f-42de-acdd-3f04dd26d2ae",
                                                "sense_id": "b91f2263-684e-38c3-9015-49cb28424179",
                                                "text": "a shining example"
                                            },
                                            {
                                                "example_id": "805e213f-8864-4021-a8a1-eb341d8d2097",
                                                "sense_id": "b91f2263-684e-38c3-9015-49cb28424179",
                                                "text": "Jill had, as you might say quite fallen in love with the Unicorn. She thought—and she wasn’t far wrong—that he was the shiningest, delicatest, most graceful animal she had ever met: and he was so gentle and soft of speech that, if you hadn’t known, you would hardly have believed how fierce and terrible he could be in battle."
                                            }
                                        ]
                                    }
                                ]
                            },
