                "senses": [
                    {
                        "sense_id": "dde8126f-4b43-3b0d-9719-0d6c9ac7e119",
                        "entry_id": "843ff7fc-5b6a-3da8-8db3-5e37f0e42747",
                        "glosses": [
                            "Bezeichnung für eine typisch spanische Musikgattung, die durch abwechselnd gesprochenen und gesungenen Text gekennzeichnet ist (ähnlich der französischen opéra comique und dem deutschen Singspiel)"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "1f1ad605-2147-419b-91d1-7f1a15c1597f",
                                "sense_id": "dde8126f-4b43-3b0d-9719-0d6c9ac7e119",
                                "text": "Als erste Zarzuela gilt \"El jardín de Falerina\" des spanischen Hofdichters und Dramatikers Pedro Calderón de la Barca."
                            },
                            {
                                "example_id": "90c728cb-bd09-4250-98c0-c84f7858241b",
                                "sense_id": "dde8126f-4b43-3b0d-9719-0d6c9ac7e119",
                                "text": "Placido Domingo hat wunderbar den Gutsbesitzer \"Don Vidal Hernando\" in der Zarzuela \"Luisa Fernanda\" von Federico Moreno Torroba gesungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b9a56372-247f-38fa-8cac-934d4b589ad7",
                        "entry_id": "843ff7fc-5b6a-3da8-8db3-5e37f0e42747",
                        "glosses": [
                            "eine Auswahl verschiedener Fischsorten und Meeresfrüchte, die mit Zwiebeln, Tomaten, Paprika und Knoblauch angebraten und dann mit einem Schuss Wein gegart werden"
                        ],
                        "tags": [
                            "spanische Küche"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf7d6318-ac59-4d38-ac6d-510d78bb5dc1",
                        "source_entry_id": "843ff7fc-5b6a-3da8-8db3-5e37f0e42747",
                        "source_sense_id": "dde8126f-4b43-3b0d-9719-0d6c9ac7e119",
                        "target_lang_word": "zarzuela",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zarzuela",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1c00745-a647-30f5-a652-4ac4f0d07627",
                                        "entry_id": "2cf963bd-d719-3f1c-afcd-0e896a89ac6e",
                                        "glosses": [
                                            "Genre d’opéra-comique espagnol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1019a318-8dc5-4724-890d-e77787763411",
                                                "sense_id": "f1c00745-a647-30f5-a652-4ac4f0d07627",
                                                "text": "De loin en loin, une troupe de zarzuela ou de danseuses espagnoles venait monter sur les tréteaux dans quelque fondouk inoccupé."
                                            },
                                            {
                                                "example_id": "6d510773-476a-46d1-829f-f7d51ee6bb1b",
                                                "sense_id": "f1c00745-a647-30f5-a652-4ac4f0d07627",
                                                "text": "Néstor Lujan, dans son Album de Habaneras signale que bien peu de zarzuelas espagnoles du XIXᵉ siècle ne comptent pas leur morceau de habanera, le plus beau de l’œuvre, celui que le public fredonne en sortant du spectacle."
                                            },
                                            {
                                                "example_id": "567a4953-f15e-42a2-ba1e-9a8d6f3e63c4",
                                                "sense_id": "f1c00745-a647-30f5-a652-4ac4f0d07627",
                                                "text": "Les vers de la zarzuela étaient toujours vrais pour les cœurs ingénus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09be28b9-a885-3731-9759-1e90ccae75b6",
                                        "entry_id": "2cf963bd-d719-3f1c-afcd-0e896a89ac6e",
                                        "glosses": [
                                            "Plat catalan à base de poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e6f3c92-7fb6-4050-a1dc-aa31c836ef55",
                                                "sense_id": "09be28b9-a885-3731-9759-1e90ccae75b6",
                                                "text": "— J’ai préparé de la zarzuela, dit-il.\n— Qu’est-ce que c’est ?\n— Pour simplifier, c’est de la paella sans le riz."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
