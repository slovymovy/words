        "fr-extract.jsonl": [
            {
                "entry_id": "f83403ad-3f75-30d5-bad7-b7af92f10152",
                "word": "casse-couilles",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dee36e20-26fd-3825-9e27-20172b82c100",
                        "entry_id": "f83403ad-3f75-30d5-bad7-b7af92f10152",
                        "glosses": [
                            "Qui énerve, horripile."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "8b2df307-b611-4b49-949e-348ebac5148d",
                                "sense_id": "dee36e20-26fd-3825-9e27-20172b82c100",
                                "text": "Au fond, il est pas méchant, tout juste un peu casse-couilles !"
                            },
                            {
                                "example_id": "fe9bdbbe-8ad8-401b-a05b-c24d503ef558",
                                "sense_id": "dee36e20-26fd-3825-9e27-20172b82c100",
                                "text": "Ses subalternes avaient d’ailleurs observé judicieusement qu’en plus d’être presbyte, il n’en était pas moins casse-couilles."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "af2060d7-9192-3ee1-b3d6-a5220c747948",
                "word": "casse-couilles",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bc7aa867-0e09-37dd-8055-a2dc6d578cca",
                        "entry_id": "af2060d7-9192-3ee1-b3d6-a5220c747948",
                        "glosses": [
                            "Individu qui a le don d’énerver."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "c09ee37f-a5d1-4ef5-80cd-9d0c8ee8b31a",
                                "sense_id": "bc7aa867-0e09-37dd-8055-a2dc6d578cca",
                                "text": "C’était pour se plaindre de tout : du temps, du pays, de la nourriture, de la messe, des professeurs, des camarades, de la directrice. « Quel casse-couilles » se dit Manouche."
                            },
                            {
                                "example_id": "d3364bee-4614-4956-88c8-a9b5ac1088c7",
                                "sense_id": "bc7aa867-0e09-37dd-8055-a2dc6d578cca",
                                "text": "Il y avait une soirée mousse à l'autre camping, pouvaient-elles y aller ?\nMa foi, c'était le premier jour des vacances, je n'allais pas non plus faire le casse-couilles en permanence."
                            },
                            {
                                "example_id": "eb214208-624e-4497-aceb-b97d083f1917",
                                "sense_id": "bc7aa867-0e09-37dd-8055-a2dc6d578cca",
                                "text": "« Devoir d'informer ? mon cul ! » Sous ce titre fleuri, Bruno Masure, éternel casse-couilles et coupeur de cheveux en quatre, avait publié quelques jours après les attentats de janvier 2015 une tribune sur Rue 89, dénonçant « le jeu pervers et dangereux » de vouloir montrer à tout prix que l'on est mieux rencardé que ses concurrents directs, […]."
                            },
                            {
                                "example_id": "cd43b3f5-d592-4f5e-8d73-349ebaae53f5",
                                "sense_id": "bc7aa867-0e09-37dd-8055-a2dc6d578cca",
                                "text": "La flache ! Il aurait pu dire la flaque, merde ! Là, il y a quelque chose non pas de poseur mais de vrai casse-couilles chez Rimbaud. Tu sors de douze minutes d’hallucinations pour arriver à « si je désire une eau d’Europe, c’est la flache »."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
