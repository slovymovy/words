                    {
                        "sense_id": "40cd615a-e671-3ec8-bc37-61600b25fc14",
                        "entry_id": "bcfba300-6bfc-3bc3-9af7-70348ca9a530",
                        "glosses": [
                            "unangenehme, verachtenswerte Person"
                        ],
                        "tags": [
