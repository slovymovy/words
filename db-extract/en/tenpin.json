                ],
                "translations": [
                    {
                        "translation_id": "25b5f24d-f598-421f-9e4c-ee6391b138ac",
                        "source_entry_id": "4880738c-6368-3652-aefc-e8f5a93f029d",
                        "source_sense_description": "target",
                        "target_lang_word": "quille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b50d0681-485b-30d0-ac98-0a1e0c8f01bc",
                                        "entry_id": "44360e58-c177-3d97-87bf-af2817fbe4e7",
                                        "glosses": [
                                            "Partie fixe et immergée de la coque sous le bateau faisant office de dérive fixe et de contrepoids à la gîte."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee063593-86e6-4301-95ad-7513124d3b00",
                                                "sense_id": "b50d0681-485b-30d0-ac98-0a1e0c8f01bc",
                                                "text": "Le « Français » en 1904 et le « Pourquoi pas ? » cinq ans après, laissèrent une partie de leur quille sur les roches."
                                            },
                                            {
                                                "example_id": "2cb93100-f15c-4cc4-acf8-6823b99b6c6d",
                                                "sense_id": "b50d0681-485b-30d0-ac98-0a1e0c8f01bc",
                                                "text": "Le cabanement doit être évité à tout prix, d’une part parce que les points de la quille qui subissent alors la réaction de la cale ne présentent pas une solidité aussi grande que le brion […]"
                                            },
                                            {
                                                "example_id": "7bf8075f-8842-48a1-88c5-1b2fe3ede897",
                                                "sense_id": "b50d0681-485b-30d0-ac98-0a1e0c8f01bc",
                                                "text": "Les éléments longitudinaux sont également continus; les quilles, contre-quilles et lisses sont en acajou; les élongis très largement dimensionnés sont en polyester renforcé de structure mixte mat-roving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08dcc5de-29d0-37e3-b800-be4e293d265a",
                                        "entry_id": "44360e58-c177-3d97-87bf-af2817fbe4e7",
                                        "glosses": [
                                            "Pièce de charpente de base à partir de laquelle la coque est construite."
                                        ],
                                        "tags": [
                                            "À voile"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca9de6e0-19a3-4758-86ea-f83bfbbc5385",
                                                "sense_id": "08dcc5de-29d0-37e3-b800-be4e293d265a",
                                                "text": "Sur la cale dallée de larges pierres plates usées par le temps, les quilles des sardiniers et les marées, la mer montait doucement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bed81f6a-bca7-37e6-aab7-ab767a4f42d6",
                                        "entry_id": "44360e58-c177-3d97-87bf-af2817fbe4e7",
                                        "glosses": [
                                            "Élément profilé de faible allongement fixé à la partie inférieure du fuselage, en vue d’augmenter la stabilité latérale de l’avion ou d’éviter qu’il se mette en vrille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd096635-9a3a-483c-b735-335cf6137266",
                                                "sense_id": "bed81f6a-bca7-37e6-aab7-ab767a4f42d6",
                                                "text": "le camion les emporte vers l'avion libérateur\nnotre nostalgie salue leur quille avec envie"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6356b334-dd72-363a-9f7c-d77afc67846f",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Élément d’un jeu constitué de cylindres de bois, que l’on dresse puis fait tomber à l’aide d’une boule de bois que l’on fait rouler sur le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d7ffc35-666f-4425-a6a8-9c94640e278c",
                                                "sense_id": "6356b334-dd72-363a-9f7c-d77afc67846f",
                                                "text": "Des corps tombèrent comme des quilles à moins de deux mètre de Wang."
                                            },
                                            {
                                                "example_id": "bc7e9045-aa27-4a66-8def-e5ba0fd4a6a2",
                                                "sense_id": "6356b334-dd72-363a-9f7c-d77afc67846f",
                                                "text": "Des paysans jouaient aux quilles avec des clameurs, des contestations, des disputes à chaque coup douteux. On entendait la boule sonnant contre les quilles cerclées de fer, quand elle arrivait au but."
                                            },
                                            {
                                                "example_id": "5e66ec3e-3831-49fc-8726-837f2871ef61",
                                                "sense_id": "6356b334-dd72-363a-9f7c-d77afc67846f",
                                                "text": "Nous aimons la musique des quilles, le choc sourd de la boule sur les pommes, sa façon de tourner […] et cette manière raide et stupéfaite qu’ont les quilles de s’abattre sur le sol ou de se renverser entre elles."
                                            },
                                            {
                                                "example_id": "9b0a5738-b6cd-42e6-94b8-9c90172d1138",
                                                "sense_id": "6356b334-dd72-363a-9f7c-d77afc67846f",
                                                "text": "Leur grand luxe était alors de s’arrêter une heure ou deux dans une auberge de village, d’y manger une omelette qu’on leur préparait pendant qu’ils renversaient quelques quilles sur la place."
                                            },
                                            {
                                                "example_id": "448ee5fd-7b22-48c8-9daf-af1405d16396",
                                                "sense_id": "6356b334-dd72-363a-9f7c-d77afc67846f",
                                                "text": "Jeu de quilles : Ensemble des neuf pièces de bois ou quillier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb712e9-a6f9-3cd6-9187-eded6fe7cda8",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Jambe."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e022b1b7-14b2-47c6-9f70-680eef59925f",
                                                "sense_id": "ceb712e9-a6f9-3cd6-9187-eded6fe7cda8",
                                                "text": "– […] Si je meurs, vous serez la maîtresse chez mon pauvre imbécile d’oncle : bene sit ! Si je reste sur mes quilles, marchez droit, et servez-lui du bonheur premier numéro."
                                            },
                                            {
                                                "example_id": "e8052cec-fb55-4df0-9f74-3e0217943fd0",
                                                "sense_id": "ceb712e9-a6f9-3cd6-9187-eded6fe7cda8",
                                                "text": "Ivre habituellement, le vin qui donne aux hommes des pensées tristes et les fait larmoyer, les coudes sur la table, le vin, lui chauffant le ventre et le remettant d’aplomb sur ses vieilles quilles, lui inspirait une gaieté trouble, largement épanouie, fertile en inventions bizarres, en idées cocasses qui traversaient son cerveau."
                                            },
                                            {
                                                "example_id": "a07a68dc-2ece-4653-973c-969bc7155a8c",
                                                "sense_id": "ceb712e9-a6f9-3cd6-9187-eded6fe7cda8",
                                                "text": "Près d’un vieux homme je m’assis, qui gardait, traînant la quille, deux vaches maigres ; je m’enquis de sa santé, lui conseillai de se chausser la jambe d’un bas fourré d’orties piquantes (je fais le mire, à mes loisirs)."
                                            },
                                            {
                                                "example_id": "90a59cd0-9bb3-4aa7-81b9-a8c1c1a86a96",
                                                "sense_id": "ceb712e9-a6f9-3cd6-9187-eded6fe7cda8",
                                                "text": "Il nous appelle fainéants ? un crampu qui ne saurait lever ses quilles du tabouret. Mais les jambes te remonteraient jusqu’à la gruette, pauvre bouif ! Des comme toi, c’est des lâches, des loches, des caracoles !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17a41077-f9cd-3da4-91a9-02090dee9fb3",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Bouteille."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a6798fd-0bb7-42db-b2df-d87f38978383",
                                                "sense_id": "17a41077-f9cd-3da4-91a9-02090dee9fb3",
                                                "text": "[…], et mon oncle marrant dira “Une quille de Beaujolais, un saucifflard et le maillot de Lacazette” qui entrainera un rire extrêmement gras, ponctué par un percutant “et moi je sens le gaz ??” de mon père […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78e724d6-9793-3a60-bc00-92c39015e88c",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Bouteille de bière grand format (environ un litre)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a291f2ad-af85-4414-88e9-e30112e40c6a",
                                                "sense_id": "78e724d6-9793-3a60-bc00-92c39015e88c",
                                                "text": "Elle avait genre une belle petite épicerie équilibrée de fille dans son panier, plein de yogourt pis de légumes verts, pis moi j'avais genre trois sacs de Doritos pis une quille de Colt 45, j'avais vraiment l'air d'un cave..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20731ce3-3b8c-3d43-a8c4-82949535219b",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Bouteille de 33 centilitres d’Orval."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4d50a60-71f2-4b7b-a087-6291fb9b7efd",
                                                "sense_id": "20731ce3-3b8c-3d43-a8c4-82949535219b",
                                                "text": "Il n’y aura bientôt plus une seule quille d’Orval en France pour le désaltérer, car une bande de cinglés refuse tout simplement l’exportation de cette roteuse nonpareille."
                                            },
                                            {
                                                "example_id": "12523711-aafa-4f63-a3fa-98f5fcade2ce",
                                                "sense_id": "20731ce3-3b8c-3d43-a8c4-82949535219b",
                                                "text": "La forme en quille de la bière Orval est unique au monde, et avait été pensée pour résister à la pression de la bière exercée sur la bouteille"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0125b62-7e0e-377a-ae28-eaff4ed2bae5",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Dernier jour du service militaire."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b5ad836-a67c-4d4e-9137-b1a1f9a35315",
                                                "sense_id": "a0125b62-7e0e-377a-ae28-eaff4ed2bae5",
                                                "text": "Les dégradés qui se permettraient de n’pas être d’accord, avertit cet homme équitable, seront de corvée de gogues pendant tout leur temps de service, et fusillés au moment de la quille."
                                            },
                                            {
                                                "example_id": "2bc0763f-c1a0-4e9b-978a-ca6c0c90957c",
                                                "sense_id": "a0125b62-7e0e-377a-ae28-eaff4ed2bae5",
                                                "text": "Vivement la quille !"
                                            },
                                            {
                                                "example_id": "6e15f506-bd05-4087-b964-f9d4693092e2",
                                                "sense_id": "a0125b62-7e0e-377a-ae28-eaff4ed2bae5",
                                                "text": "– Alors ? C'est la quille ? lui demanda Brossier, hilare.\n– Oui, c'est la quille, dit-il à mi-voix, car il avait toujours éprouvé de la peine à employer l'argot militaire.\n– Ça se fête, une quille, mon vieux, dit Brossier. Vous voyez, moi j'ai commencé…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4b397c6-3d21-3493-ae07-6b4c594b27c3",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Dernier jour d'une période de travail."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "592eeed1-1e2c-4e5b-86e4-079e02befdfc",
                                                "sense_id": "a4b397c6-3d21-3493-ae07-6b4c594b27c3",
                                                "text": "S’il perdait encore du temps, même une minute, il risquait l’amende. Pour compenser l’amende, il devrait faire un poste de plus. La quille ne serait pas pour demain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f88043c7-1c94-3af4-8125-f0c1c2352556",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Sortie de prison."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c783b330-a0b8-4481-bee3-db809bc11500",
                                                "sense_id": "f88043c7-1c94-3af4-8125-f0c1c2352556",
                                                "text": "Le jour de la quille, je prends une piaule et je me pieute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea3f1799-1b9e-36b5-89b8-fe2c987ab140",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Coin métallique qui sert à fendre les blocs d’ardoise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4efd104-544c-4214-9380-c7fdc55a73b8",
                                                "sense_id": "ea3f1799-1b9e-36b5-89b8-fe2c987ab140",
                                                "text": "Le petit coin est nommé alignoir, et le gros coin quille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8498da4-caea-3618-aaae-7492c28cf43a",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Pièce de tissus taillée en longueur et destinées à élargir une robe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92c32bac-870e-3618-8cf6-62ed457be42c",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Partie d'un tronc d'arbre restée debout alors que la partie supérieure a été cassée par le vent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9542871c-f162-3bf6-bc3e-dab7525c84b4",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Instrument utilisé par les gantiers pour élargir les doigts de gants, cet instrument était aussi nommé demoiselle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9874e3b-52c3-3b9e-a480-b55e2f424098",
                                        "entry_id": "d34c9405-8cae-33c7-b767-1440a17193bd",
                                        "glosses": [
                                            "Pierre taillée disposée verticalement, dans le sens de la hauteur, par exemple dans l'encadrement d'une porte (jambage)."
                                        ],
