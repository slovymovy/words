                "senses": [
                    {
                        "sense_id": "2cc9faec-8f68-3075-8843-cf163356af3f",
                        "entry_id": "91e83006-04d9-3247-af72-28ec86a27db2",
                        "glosses": [
                            "Acronyme désignant l’ensemble des quatre premiers éléments chimiques constituant la matière organique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7765c01-7e3d-4b5c-a1b6-7fd95801b669",
                                "sense_id": "2cc9faec-8f68-3075-8843-cf163356af3f",
                                "text": "À ce stade , la matière organique (CHON) se transforme en carbone et en hydrogène (CH) par effet de soustraction des molécules d'azote et d'oxygène ."
                            },
                            {
                                "example_id": "485ed97c-ca5c-4abe-bdd3-4095894a7c92",
                                "sense_id": "2cc9faec-8f68-3075-8843-cf163356af3f",
                                "text": "L’étude des météorites révèle leur richesse en molécules organiques, les CHON composées d’atomes de carbone, d’hydrogène, d’oxygène et d’azote, les éléments les plus abondants formés dans le chaudron atomique des étoiles."
                            },
                            {
                                "example_id": "b946846a-08c2-4205-abcd-f334fe65ffda",
                                "sense_id": "2cc9faec-8f68-3075-8843-cf163356af3f",
                                "text": "Certains de ces éléments, le carbone, l’hydrogène, l’oxygène et l’azote (CHON), constituent les « briques » de la vie"
                            }
                        ]
                    }
