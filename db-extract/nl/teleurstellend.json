                                "example_id": "5803486f-3695-4efb-a45e-731a7bc55271",
                                "sense_id": "ccc21779-833b-3780-895c-0250aa2abe9d",
                                "text": "Het was een teleurstellend resultaat.",
                                "translation": "It was a disappointing result.",
                                "english": "It was a disappointing result."
                            },
                            {
                                "example_id": "d8861297-e69d-4f11-ac92-cb519e479215",
                                "sense_id": "ccc21779-833b-3780-895c-0250aa2abe9d",
                                "text": "De verkoop was teleurstellender dan we hadden gehoopt.",
                                "translation": "The sales were more disappointing than we had hoped.",
                                "english": "The sales were more disappointing than we had hoped."
                            },
                            {
                                "example_id": "75d5f26a-f387-4085-ac91-5e039958605e",
                                "sense_id": "ccc21779-833b-3780-895c-0250aa2abe9d",
                                "text": "Dit is de teleurstellendste prestatie van het team dit seizoen.",
                                "translation": "This is the most disappointing performance by the team this season.",
