        "fr-extract.jsonl": [
            {
                "entry_id": "b4c1afb6-969a-33cc-9725-64162b8cc21a",
                "word": "sinuosité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2c100ab5-a770-44cf-9cfc-fcd29808d41b",
                        "entry_id": "b4c1afb6-969a-33cc-9725-64162b8cc21a",
                        "tags": [
                            "plural"
                        ],
                        "form": "sinuosités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "450caef9-96bc-33c2-8c8e-a966ced1e876",
                        "entry_id": "b4c1afb6-969a-33cc-9725-64162b8cc21a",
                        "glosses": [
                            "État de ce qui est sinueux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c1bea0d-09a7-4fb9-a4e9-9ba48104c88b",
                                "sense_id": "450caef9-96bc-33c2-8c8e-a966ced1e876",
                                "text": "À chaque nouvelle peine trop forte, nous sentons une veine de plus qui saille et développe sa sinuosité mortelle au long de notre tempe, sous nos yeux."
                            }
                        ]
                    },
                    {
                        "sense_id": "a396e6ba-9621-3f1d-bf7e-15ef231373e9",
                        "entry_id": "b4c1afb6-969a-33cc-9725-64162b8cc21a",
                        "glosses": [
                            "Les tours et détours que fait une chose sinueuse."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "74bb453b-4c37-42fd-bffc-b3d66a270579",
                                "sense_id": "a396e6ba-9621-3f1d-bf7e-15ef231373e9",
                                "text": "La pourpre de ses lèvres était rehaussée par les sinuosités de l'inévitable moustache noire."
                            },
                            {
                                "example_id": "c6c17998-f923-4524-b7f6-1111880ef66d",
                                "sense_id": "a396e6ba-9621-3f1d-bf7e-15ef231373e9",
                                "text": "A sa droite, le voyageur embrasse d'un regard toutes les sinuosités de la Cise, qui se roule, comme un serpent argenté, dans l'herbe des prairies."
                            },
                            {
                                "example_id": "158d3d2b-c002-4eee-99e5-22179d19e8a7",
                                "sense_id": "a396e6ba-9621-3f1d-bf7e-15ef231373e9",
                                "text": "[…] je pensais que le premier passant venu l’effacerait, qu’un peu de pluie la ferait disparaître, et je m’arrêtais pour apercevoir encore dans les sinuosités du sentier ce singulier sillage laissé, par l’être que j’aimais le plus, sur la terre même où j’étais né."
                            },
                            {
                                "example_id": "4cd2cdb4-04ba-43cd-a4b6-a00e49d8a2fa",
                                "sense_id": "a396e6ba-9621-3f1d-bf7e-15ef231373e9",
                                "text": "On avait fait deux milles environ dans la vallée, très encombrée et peu praticable, mais ses sinuosités empêchaient d'évaluer le chemin parcouru en droite ligne."
                            },
                            {
                                "example_id": "89642e71-6df7-4ebf-bcd7-27787dff7bbf",
                                "sense_id": "a396e6ba-9621-3f1d-bf7e-15ef231373e9",
                                "text": "La lune à son premier quartier éclairait une partie du ciel, et un brouillard flottait comme une écharpe sur les sinuosités de la Toucques."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f4432df-15d9-310e-ad5b-ebd02bce7baf",
                        "entry_id": "b4c1afb6-969a-33cc-9725-64162b8cc21a",
                        "glosses": [
                            "Pour un tracé plan comportant au moins un point d’inflexion, longueur curviligne (selon le parcours) divisée par la distance (ligne droite) entre les 2 points extrêmes du tracé considéré."
                        ],
