                                        "sense_id": "538e8284-ef9c-3574-9262-cdeb51b404d6",
                                        "entry_id": "5a8d74c9-d4dc-30a1-9955-b43b21e679aa",
                                        "glosses": [
                                            "een land in het noorden van Europa, grenzend aan Noorwegen, Zweden en Rusland, en inclusief het eilandgebied Åland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1f2921e-42f0-44ee-a314-adf798bdf316",
                                                "sense_id": "538e8284-ef9c-3574-9262-cdeb51b404d6",
                                                "text": "Finland staat ook bekend als het land van de duizend meren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "408bfe2f-02c8-452b-b3fe-b47389db05ab",
                        "source_entry_id": "d2d95445-2e9a-35c1-813e-d7da5a217902",
                        "source_sense_id": "f2943950-cbca-367b-9416-7fccc733ad31",
                        "source_sense_description": "Nordic country",
                        "target_lang_word": "Finlande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Finlande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2012ce1d-ba49-34b9-9049-596100d052f7",
                                        "entry_id": "b733851b-65c7-39c5-8697-be4e350b9544",
                                        "glosses": [
                                            "Pays de l’Europe du Nord, bordé à l’est par la Russie, au nord par la Norvège, au nord-ouest par la Suède et à l’ouest et au sud par la mer Baltique. Sa capitale est Helsinki."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e52678c3-3cdf-43ac-ae1e-53fb9aef6305",
                                                "sense_id": "2012ce1d-ba49-34b9-9049-596100d052f7",
                                                "text": "Mais il a laissé son kantele mélodieux à la Finlande, c’est-à-dire des runes sublimes aux fils de sa race, une joie éternelle à son peuple."
                                            },
                                            {
                                                "example_id": "860af4a0-aa18-45a4-b333-25f6cf367d3f",
                                                "sense_id": "2012ce1d-ba49-34b9-9049-596100d052f7",
                                                "text": "La Finlande a été désignée vendredi « pays le plus heureux du monde » pour la quatrième année de suite, devançant le Danemark, la Suisse et l'Islande dans un classement du bonheur où l'impact de la COVID-19 a été étonnamment contrasté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c0513d5-f00b-4267-9584-6d7bcdc1ea2e",
                        "source_entry_id": "d2d95445-2e9a-35c1-813e-d7da5a217902",
                        "source_sense_id": "f2943950-cbca-367b-9416-7fccc733ad31",
