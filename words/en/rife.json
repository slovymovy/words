{
    "word_family": [
        "rifely",
        "rifeness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d9919ab7-65e2-34be-a5f4-72d64cd28188",
                    "sense_definition": "Widespread or common, especially referring to something unpleasant or harmful.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "widespread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rumors were <w>rife</w> that the company would soon close its doors.",
                            "target_lang_translations": {
                                "zh": "关于公司即将倒闭的谣言<w>满天飞</w>。"
                            }
                        },
                        {
                            "text": "In the city, crime was <w>rife</w> during the economic crisis.",
                            "target_lang_translations": {
                                "zh": "经济危机期间，这座城市的犯罪活动十分<w>猖獗</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "widespread",
                        "ubiquitous",
                        "pandemic"
                    ],
                    "common_phrases": [
                        "rumors are rife",
                        "speculation is rife"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指坏事）猖獗的，极为普遍的，盛行的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "猖獗",
                                "target_lang_sense_clarification": "指恶性事物或犯罪行为横行盛行"
                            },
                            {
                                "target_lang_word": "盛行",
                                "target_lang_sense_clarification": "指谣言、不良风气等广泛传播或流行"
                            },
                            {
                                "target_lang_word": "普遍",
                                "target_lang_sense_clarification": "指坏事或不良现象随处可见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39d9b55f-625d-38c0-954c-3cf3fa27c0b5",
                    "sense_definition": "Filled with or containing a large amount of something, usually negative.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "filled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report was <w>rife</w> with errors and needed a complete revision.",
                            "target_lang_translations": {
                                "zh": "这份报告<w>满是</w>错误，需要彻底修改。"
                            }
                        },
                        {
                            "text": "The political campaign was <w>rife</w> with scandal and misinformation.",
                            "target_lang_translations": {
                                "zh": "这场政治竞选活动<w>充斥着</w>丑闻和虚假信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "filled",
                        "fraught"
                    ],
                    "common_phrases": [
                        "rife with controversy",
                        "rife with corruption"
                    ],
                    "target_lang_definitions": {
                        "zh": "充满……的，充斥着……的（常接with，通常指不良事物）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "充斥着",
                                "target_lang_sense_clarification": "大量充满不良事物或缺陷"
                            },
                            {
                                "target_lang_word": "满是",
                                "target_lang_sense_clarification": "到处都是（错误、丑闻等）"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2860fc3e-7f1e-3181-bace-d44b2769018d",
                    "sense_definition": "Existing in large numbers or quantities; plentiful.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "plentiful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wild flowers are <w>rife</w> in the valley during the spring season.",
                            "target_lang_translations": {
                                "zh": "春季的山谷里，野花<w>漫山遍野</w>。"
                            }
                        },
                        {
                            "text": "Small insects are <w>rife</w> near the stagnant water of the pond.",
                            "target_lang_translations": {
                                "zh": "池塘死水附近<w>聚满</w>了小昆虫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plentiful"
                    ],
                    "common_phrases": [
                        "rife in nature"
                    ],
                    "target_lang_definitions": {
                        "zh": "大量的，丰富的，繁多的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "繁多",
                                "target_lang_sense_clarification": "数量多且丰富"
                            },
                            {
                                "target_lang_word": "大量存在",
                                "target_lang_sense_clarification": "数量极多，随处可见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dea3da87-b523-3ede-95ab-529acc85288b",
                    "sense_definition": "Having power, active, or nimble.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his age, the old man still felt <w>rife</w> and energetic.",
                            "target_lang_translations": {
                                "zh": "尽管上了年纪，那位老人依然觉得自己<w>精力充沛</w>、活力满满。"
                            }
                        },
                        {
                            "text": "The athlete remained <w>rife</w> throughout the entire duration of the match.",
                            "target_lang_translations": {
                                "zh": "整场比赛中，这名运动员始终保持着<w>活跃</w>的状态。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "活跃的，精力充沛的，敏捷的（古英语用法）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "精力充沛",
                                "target_lang_sense_clarification": "充满活力与干劲"
                            },
                            {
                                "target_lang_word": "活跃",
                                "target_lang_sense_clarification": "行动敏捷或充满生机"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a68beb6c-d151-38e0-9bbe-14f40ff43253",
                    "sense_definition": "In a plentiful or abundant manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plentiful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rare herbs grow <w>rife</w> along the banks of the river.",
                            "target_lang_translations": {
                                "zh": "那些珍稀草药在河岸边<w>繁茂地</w>生长。"
                            }
                        },
                        {
                            "text": "In this region, wild berries grow <w>rife</w> during the summer months.",
                            "target_lang_translations": {
                                "zh": "在该地区，野生浆果在夏季月份里<w>大量地</w>生长。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is considered dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "大量地，繁茂地，丰富地（古英语用法）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "繁茂地",
                                "target_lang_sense_clarification": "植物或事物生长茂盛地"
                            },
                            {
                                "target_lang_word": "大量地",
                                "target_lang_sense_clarification": "以极大的数量或密度"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}