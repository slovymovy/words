                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad4d7e14-7478-4da8-b31e-7f948f0b9f94",
                                "sense_id": "6cf3a34e-f90a-358a-95fa-8a3c6540b9b9",
                                "text": "Die Harpyie erbeutet unter anderem Faultiere.",
                                "translation": "La harpie chasse entre autres les paresseux."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9e1cead-7fb2-309d-9632-fd9202e754da",
                        "entry_id": "e739850b-649f-3b40-8a53-5b2af039acac",
                        "glosses": [
                            "Harpie, créature fabuleuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1535699f-9daa-42b3-a30c-164659c41aa3",
                                "sense_id": "d9e1cead-7fb2-309d-9632-fd9202e754da",
                                "text": "Von wilden Harpyien umzingelt musste der Held um sein Leben hart kämpfen.",
                                "translation": "Encerclé de harpies féroces, le héros dut durement lutter pour sa vie."
                            }
                        ]
                    }
