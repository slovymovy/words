                                    {
                                        "sense_id": "5db7a7c4-1679-320b-b8b2-68f01f5f745e",
                                        "entry_id": "a57716f8-344e-3ab9-b09c-39ebd9b69a1a",
                                        "glosses": [
                                            "Someone who makes, repairs and sells saddles, harnesses etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d2cb34f-c32f-463a-ab78-483bcc7afc16",
                                                "sense_id": "5db7a7c4-1679-320b-b8b2-68f01f5f745e",
                                                "text": "In making saddles to run and try in, the trees of them are occasionally leaded by the tree-maker or saddler, agreeably to the directions either may receive from his employer; and a four-pound saddle in this way is made to weigh seven pounds."
                                            },
                                            {
                                                "example_id": "a6bbb28a-57d0-426d-8d6c-fef7dcee2d45",
                                                "sense_id": "5db7a7c4-1679-320b-b8b2-68f01f5f745e",
                                                "text": "saddlers and spurriers would be ruined by hundreds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b177b00a-ba62-3043-84cc-a7b27324c86f",
                                        "entry_id": "a57716f8-344e-3ab9-b09c-39ebd9b69a1a",
                                        "glosses": [
                                            "The harp seal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "597713b9-9749-4a4c-b6ce-2050b4fd9ee7",
                        "source_entry_id": "c27513fd-c6e5-36d2-9832-be5225b1d603",
                        "source_sense_id": "e9c69ba7-5912-3ca7-87f3-fa319480e58c",
                        "source_sense_description": "Handwerker, der Sättel und andere Gegenstände aus Leder herstellt",
                        "target_lang_word": "sellier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sellier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a3df577-5f2d-3961-88a8-f996d6e3c624",
                                        "entry_id": "e549bdcb-465e-317f-9411-d630ec002195",
                                        "glosses": [
                                            "Celui qui fait, qui vend des selles et tout ce qui concerne le harnachement du cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17ce14c5-d96d-43ad-85bf-d13f0b2af314",
                                                "sense_id": "5a3df577-5f2d-3961-88a8-f996d6e3c624",
                                                "text": "À un bout les épiceries, à l’autre les selliers, les maréchaux-ferrants, les chevaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf6c4fa2-3139-3317-83db-b665e3945569",
                                        "entry_id": "e549bdcb-465e-317f-9411-d630ec002195",
                                        "glosses": [
                                            "Celui qui fabrique selles, harnais, etc. mais aussi des ouvrages tels que coussins, garnitures pour voitures et voiliers… travaillant non seulement le cuir, mais aussi le nylon, la mousse etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08fa32fb-1493-4b3b-b7ad-17c394fcbc67",
                                                "sense_id": "cf6c4fa2-3139-3317-83db-b665e3945569",
                                                "text": "Il la conduisit chez un sellier qui était en même temps carrossier."
                                            },
                                            {
                                                "example_id": "9fcc62de-dc3a-4ff4-816e-4fc82dd061a2",
                                                "sense_id": "cf6c4fa2-3139-3317-83db-b665e3945569",
                                                "text": "Le sellier bourrelier fabrique des bâches, des courroies, des sacs industriels ainsi que des harnachements pour animaux de trait."
                                            },
                                            {
                                                "example_id": "2daba63f-7373-433a-a8d6-0c26e1eb6bb4",
                                                "sense_id": "cf6c4fa2-3139-3317-83db-b665e3945569",
                                                "text": "Le sellier garnisseur ou sellier carrossier habille l'intérieur des voitures et des bateaux."
                                            },
                                            {
                                                "example_id": "7d10e855-817c-402d-bf10-562ebbdaa0f5",
                                                "sense_id": "cf6c4fa2-3139-3317-83db-b665e3945569",
                                                "text": "Le sellier harnacheur réalise toutes les pièces en cuir indispensables à la conduite d'un attelage et à l'équipement d'un cheval."
                                            },
                                            {
                                                "example_id": "d35066e8-7010-42b5-b353-026f621815c2",
                                                "sense_id": "cf6c4fa2-3139-3317-83db-b665e3945569",
                                                "text": "Le sellier maroquinier fabrique des articles (portefeuille, porte-carte, porte-monnaie, sac à main, ceinture...) « façon sellier »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
