                    {
                        "sense_id": "d16d4088-6f4a-3d8f-8ca8-67da948f979e",
                        "entry_id": "7543c4c8-ab1c-334e-95ab-dd96c0522738",
                        "glosses": [
                            "засорённый, неочищенный"
