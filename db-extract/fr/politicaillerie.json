                "forms": [
                    {
                        "form_id": "26f712ed-70c9-476a-8812-7f787fe5fcfc",
                        "entry_id": "e4e883ae-9cd7-3c9c-b928-32ca86c32947",
                        "tags": [
                            "plural"
                        ],
                        "form": "politicailleries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00d6ab9c-bb00-30a5-b397-2f404ffc5a89",
                        "entry_id": "e4e883ae-9cd7-3c9c-b928-32ca86c32947",
                        "glosses": [
                            "Basse pratique politique, faite par un politicard."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "195314be-58b9-4253-beb0-dd8f54c4e19e",
                                "sense_id": "00d6ab9c-bb00-30a5-b397-2f404ffc5a89",
                                "text": "Il faut qu'à la politicaillerie dont la nation est lasse jusqu'à la satiété, elle fasse succéder les affaires et ne soit plus le régime de quelques-uns mais celui de tous les Français."
                            },
                            {
                                "example_id": "d908757f-57da-47d2-9f8d-951cc7f93d38",
                                "sense_id": "00d6ab9c-bb00-30a5-b397-2f404ffc5a89",
                                "text": "Toutes ses politicailleries nous poussent à cette question : à quoi croit réellement M. Coderre ?"
                            },
                            {
                                "example_id": "cb6fe32e-b069-498f-b03a-4d768bd51746",
                                "sense_id": "00d6ab9c-bb00-30a5-b397-2f404ffc5a89",
                                "text": "La politicaillerie a eu le dessus sur l’intérêt national."
                            },
                            {
                                "example_id": "05aa022e-f287-4900-9857-4329d2a93c44",
                                "sense_id": "00d6ab9c-bb00-30a5-b397-2f404ffc5a89",
                                "text": "De mémoire humaine, politicaillerie, tractations douteuses, caricature de ses adversaires, stratégie clivante, tout cela a toujours été plus ou moins au cœur du jeu politique."
                            }
                        ]
                    }
                ],
