                            {
                                "example_id": "b5414bc1-500b-4a94-a7e4-4148c5a9f48d",
                                "sense_id": "61e0dd24-b1be-34e8-bf07-74ba6cdad5d5",
                                "text": "„Das Kraftfahrt-Bundesamt hat erstmals die Genehmigung für ein Abgasreinigungssystem erteilt, das in BMW-Diesel nachträglich eingebaut werden kann.“"
                            },
                            {
                                "example_id": "7d5ae1e0-924f-48f7-bbf2-0baaaced7d65",
                                "sense_id": "61e0dd24-b1be-34e8-bf07-74ba6cdad5d5",
                                "text": "„Das Abgasreinigungssystem besteht aus einem Dieseloxidationskatalysator und einem Dieselpartikelfilter für das Modell F75 und zusätzlich aus einem selektiven katalytischen Reduktionssystem für die Modelle F95 und F105.“"
                            }
                        ],
