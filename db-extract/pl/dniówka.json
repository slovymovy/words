                        "glosses": [
                            "dzień pracy zarobkowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bfea086-b1a7-41b7-bfea-74f3f9d25fee",
                                "sense_id": "6735f330-f071-3426-83a6-b516eec515c8",
                                "text": "Mam już za sobą cztery dniówki w tej pracy i na razie nie narzekam."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "356655d0-7f79-3ea0-940f-3a9549d413cf",
                        "entry_id": "45edb549-df66-3814-b303-c0a2e3f90dfa",
                        "glosses": [
                            "system płacy, w którym wynagrodzenie dzienne jest związane z liczbą przepracowanych godzin"
