{
    "word_family": [
        "ontleding",
        "ontleedbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30412322-b4ce-3877-bd04-5b065f4ea9ab",
                    "sense_definition": "Iets in zijn bestanddelen uiteenleggen, zoals een organisme opensnijden voor wetenschappelijk onderzoek of een tekst taalkundig analyseren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "analyseren_en_dissecteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als onderdeel van dit practicum zullen we een dode muis <w>ontleden</w>.",
                            "target_lang_translations": {
                                "en": "As part of this practical, we will <w>dissect</w> a dead mouse."
                            }
                        },
                        {
                            "text": "De leraar vroeg ons om de moeilijke zin volledig te <w>ontleden</w>.",
                            "target_lang_translations": {
                                "en": "The teacher asked us to fully <w>parse</w> the difficult sentence."
                            }
                        }
                    ],
                    "synonyms": [
                        "anatomiseren",
                        "analyseren"
                    ],
                    "common_phrases": [
                        "een zin ontleden",
                        "een lichaam ontleden"
                    ],
                    "target_lang_definitions": {
                        "en": "To break something down into its components, such as cutting open an organism for scientific research or grammatically analyzing a text."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dissect",
                                "target_lang_sense_clarification": "to cut open an organism or analyze an idea in detail"
                            },
                            {
                                "target_lang_word": "analyze",
                                "target_lang_sense_clarification": "to examine a text or structure in detail"
                            },
                            {
                                "target_lang_word": "parse",
                                "target_lang_sense_clarification": "to analyze a sentence grammatically"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25e28414-0a12-3e39-9d41-e41ccbfe7e71",
                    "sense_definition": "Een chemische of biologische reactie ondergaan waarbij complexe moleculen of verbindingen in eenvoudigere eenheden uiteenvallen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemisch_uiteenvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kalksteen <w>ontleedt</w> bij verhitting in ongebluste kalk en koolzuur.",
                            "target_lang_translations": {
                                "en": "Limestone <w>decomposes</w> upon heating into quicklime and carbon dioxide."
                            }
                        },
                        {
                            "text": "Organisch materiaal <w>ontleedt</w> snel onder warme en vochtige omstandigheden.",
                            "target_lang_translations": {
                                "en": "Organic material <w>decomposes</w> quickly under warm and humid conditions."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bij verhitting ontleden",
                        "snel ontleden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To undergo a chemical or biological reaction in which complex molecules or compounds break down into simpler units."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "decompose",
                                "target_lang_sense_clarification": "to decay or break down chemically"
                            },
                            {
                                "target_lang_word": "decay",
                                "target_lang_sense_clarification": "to rot or decompose biologically"
                            },
                            {
                                "target_lang_word": "break down",
                                "target_lang_sense_clarification": "to separate into simpler substances"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}