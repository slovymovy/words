                    "frequency": "Middle",
                    "semantic_group_id": "Formgebung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Tischler muss die Holzbretter genau nach Maß <w>zuschneiden</w>."
                        },
                        {
                            "text": "Vor dem Nähen <w>schneidet</w> sie den Stoff für das Kleid sorgfältig <w>zu</w>."
                        }
                    ],
                    "synonyms": [
                        "zurechtschneiden"
                    ],
                    "common_phrases": [
                        "den Stoff zuschneiden",
