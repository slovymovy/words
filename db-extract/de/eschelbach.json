                "senses": [
                    {
                        "sense_id": "248842ae-3c58-3d2a-ac47-b27a40ecd693",
                        "entry_id": "baa6c50a-89fd-3e3d-b678-4ba30db35e21",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5113b498-14e2-47de-9fee-9e700fdc587e",
                                "sense_id": "248842ae-3c58-3d2a-ac47-b27a40ecd693",
                                "text": "Frau Eschelbach ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3be4649a-1e92-4046-a3fd-b70208a51148",
                                "sense_id": "248842ae-3c58-3d2a-ac47-b27a40ecd693",
                                "text": "Herr Eschelbach wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7e7c9fd2-0e44-4e82-bb60-d9e34cdf04f4",
                                "sense_id": "248842ae-3c58-3d2a-ac47-b27a40ecd693",
                                "text": "Die Eschelbachs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9a03acef-6559-404c-9f24-f74aa0752780",
                                "sense_id": "248842ae-3c58-3d2a-ac47-b27a40ecd693",
                                "text": "Der Eschelbach trägt nie die Schals, die die Eschelbach ihm strickt."
                            },
                            {
                                "example_id": "d52ae1c1-8b2f-43ad-9160-efed355abe51",
                                "sense_id": "248842ae-3c58-3d2a-ac47-b27a40ecd693",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eschelbach kommt, geht der Herr Eschelbach.“"
                            },
                            {
                                "example_id": "c78cf983-6991-418e-810a-e674dd1d12d3",
                                "sense_id": "248842ae-3c58-3d2a-ac47-b27a40ecd693",
                                "text": "Eschelbach kommt und geht."
                            },
                            {
                                "example_id": "bdf802f4-a7dc-4782-ac84-9ba0acb1ef0a",
                                "sense_id": "248842ae-3c58-3d2a-ac47-b27a40ecd693",
                                "text": "Eschelbachs kamen, sahen und siegten."
                            }
                        ],
