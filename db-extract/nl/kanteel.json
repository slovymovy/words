                        "sense_id": "36aae213-b044-38ab-a511-9ef8cf454f2e",
                        "entry_id": "258924c4-1c20-3cbf-a3fe-88d03773e61f",
                        "glosses": [
                            "elk van de opstaande delen van de getande bovenkant van (oude) verdedigingsmuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "951eb7da-a0e0-4a52-a58c-eac8863751b4",
                                "sense_id": "36aae213-b044-38ab-a511-9ef8cf454f2e",
                                "text": "Men kon zich achter de kantelen beschermen tegen vijandelijk geschut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3797bded-58ed-4ab8-a76d-4504e6381464",
                        "source_entry_id": "258924c4-1c20-3cbf-a3fe-88d03773e61f",
                        "source_sense_id": "36aae213-b044-38ab-a511-9ef8cf454f2e",
                        "source_sense_description": "elk van de opstaande delen van de getande bovenkant van (oude) verdedigingsmuren",
                        "target_lang_word": "Zinne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                        "entry_id": "322af360-4c92-3dc2-bc91-e865ca6da57c",
                                        "glosses": [
                                            "Schutzvorrichtung auf Burgen, Mauern oder Ähnlichem, die eine Gegenwehr ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c731b558-3a69-416b-9cf1-2205e53d7c73",
                                                "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                                "text": "Die Bogenschützen fanden Schutz hinter der Zinne und konnten gleichzeitig ein Ziel erfassen."
                                            },
                                            {
                                                "example_id": "73510419-221d-4f24-9ab9-371477cd3b52",
                                                "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                                "text": "„Wohl mehr als 300000 Menschen leben hinter den Zinnen der Stadt, auf einer Fläche, die jene des antiken Rom übertrifft.“"
                                            },
                                            {
                                                "example_id": "3873a6be-9812-4471-9e09-2533bc770aa1",
                                                "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                                "text": "„Erst unter den Zinnen der osmanischen Stadtmauer endete der verwinkelte Konvent.“"
                                            },
                                            {
                                                "example_id": "38548392-a9a9-466e-9aa9-3eec8b7fb884",
                                                "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                                "text": "„Auf den Mauerkronen sah ich die Zinnen, die zum größten Teil unversehrt waren; sie stammten immerhin aus dem zweiten Punischen Krieg.“"
                                            },
                                            {
                                                "example_id": "7b8fe214-6c83-413b-b46b-c1e8c95b4b16",
                                                "sense_id": "45c4b1ef-a6b1-3608-9541-0649a9cf6c1a",
                                                "text": "„Kein Mensch kümmerte sich um die Sonne über dem Meer, um die Zinnen der Kirche Saint-Victor, um die Netze, die auf der ganzen Länge des Hafendamms zum Trocknen lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d4242e4-f11d-3670-b2ba-097834431172",
                                        "entry_id": "322af360-4c92-3dc2-bc91-e865ca6da57c",
                                        "glosses": [
                                            "der oberste Punkt eines Berges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "481d821f-ebac-449e-8632-6939cd064269",
                                                "sense_id": "8d4242e4-f11d-3670-b2ba-097834431172",
                                                "text": "Bevor Alois die Zinne des Bergs erreichen konnte, rutschte er wieder in das Tal zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0090ad65-244c-3f09-9944-557dc90aa7f3",
                                        "entry_id": "322af360-4c92-3dc2-bc91-e865ca6da57c",
                                        "glosses": [
                                            "Dachterrasse"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae0af4c2-82af-4989-b5ec-1973c66e5c30",
                                                "sense_id": "0090ad65-244c-3f09-9944-557dc90aa7f3",
                                                "text": "Mit bald neunzig, als die Schweizer Seen zufroren, hat sie auf der Zinne Wäsche gehängt, die sie zum Plätten tiefgefroren vorzog, holte sich dabei eine Erkältung, ging zu Bett und starb."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7197358b-d713-48e1-9cd0-2a9bde4fbb87",
                        "source_entry_id": "258924c4-1c20-3cbf-a3fe-88d03773e61f",
                        "source_sense_id": "36aae213-b044-38ab-a511-9ef8cf454f2e",
                        "source_sense_description": "elk van de opstaande delen van de getande bovenkant van (oude) verdedigingsmuren",
                        "target_lang_word": "merlon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merlon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c09c4c3-fdb4-3caa-8585-d6b2a5523919",
                                        "entry_id": "4375a5dd-f38d-3cdc-925a-686e50e21e70",
                                        "glosses": [
                                            "Any of the upright projections between the embrasures of a battlement, originally for archers to shield behind while shooting arrows over the embrasures, or through loopholes in the merlons."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76afccd4-5071-41a4-bdc6-9dac58040d2c",
                                                "sense_id": "5c09c4c3-fdb4-3caa-8585-d6b2a5523919",
                                                "text": "The Merlons, to the end that they may be good, ought to be made of Earth, the most eaſie to be tempered that may be: And this Earth ought alſo to be mixed with Withy Twigs, or Brambles, provided they take Root, after which they are to be lined with good Turff."
                                            },
                                            {
                                                "example_id": "646e61eb-8da3-4dfc-9169-9b3c48406311",
                                                "sense_id": "5c09c4c3-fdb4-3caa-8585-d6b2a5523919",
                                                "text": "The parapet conſiſts of two parts, namely, the wall and the merlons. [...] The Merlons are detached pieces of the parapet, leaving openings called Embrasures, thro' which the cannon deliver their ſhot."
                                            },
                                            {
                                                "example_id": "98b2c1da-9648-4ef8-9766-65f95e716f8e",
                                                "sense_id": "5c09c4c3-fdb4-3caa-8585-d6b2a5523919",
                                                "text": "A battery of guns is a bank of earth thrown up to cover the men that are to ſerve the guns; this bank is cut into holes for the cannons to fire through, about 12 feet diſtant from each other. Theſe holes are called embraſures, and the maſſes of earth between them are called merlons; [...]"
                                            },
                                            {
                                                "example_id": "d02b676f-980a-48d2-aaa6-5d987a15e4bf",
                                                "sense_id": "5c09c4c3-fdb4-3caa-8585-d6b2a5523919",
                                                "text": "Along the walls, at the distance of every hundred yards, were square stone towers. In the parapets were also embrasures, and holes in merlons for archery; but there were no cannon, except a few old wrought-iron pieces near the gate."
                                            },
                                            {
                                                "example_id": "69c4cccb-2746-47cc-bfa4-0158778440f3",
                                                "sense_id": "5c09c4c3-fdb4-3caa-8585-d6b2a5523919",
                                                "text": "[T]he property of sloping surfaces [...] causes a cannon ball from the fortress, which enters by the mouth and strikes one cheek of an embrasure, to glance off without penetrating through the merlon on that side. Such a ball is not therefore likely to prove fatal to those men who are covered by the merlon, but to those only who stand immediately behind the embrasure, and not always even to them, for if it should strike the very sloping part of the cheek, it may be reflected upwards."
                                            },
                                            {
                                                "example_id": "6c54b945-83aa-443b-9abd-5a419b3cf8fc",
                                                "sense_id": "5c09c4c3-fdb4-3caa-8585-d6b2a5523919",
                                                "text": "He had appropriated a thick tapestry rope in the great hall, and now, having reached the parapet, he looped the soft strong cord about the girl's hips and lowered her to the earth. Then, making one end fast to a merlon, he slid down after her."
                                            },
                                            {
                                                "example_id": "fb25a560-d78f-43bc-901b-4c0815b96bd8",
                                                "sense_id": "5c09c4c3-fdb4-3caa-8585-d6b2a5523919",
                                                "text": "The exterior façades of the Cordoba mosque are carefully composed, with buttresses interspersed with doorways which reflect the framed arch of the mihrab. The upper line of the wall is given a dramatic and eastern finish with a row of stepped merlons."
                                            },
                                            {
                                                "example_id": "5c70b659-e59f-4ac9-a418-32418c34a209",
                                                "sense_id": "5c09c4c3-fdb4-3caa-8585-d6b2a5523919",
                                                "text": "The castle spread out before him, its high solid sandstone walls, with their crenel and merlon battlements ending in round towers, was a magnificent sight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "merlon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2a01bf2-14c4-341a-a468-58c855ce6ecf",
                                        "entry_id": "7d708d7f-2124-3e3e-9cb8-c3e87dc1ecac",
                                        "glosses": [
                                            "Alternative spelling of merlin (“a small falcon, Falco columbarius”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b2d247d-dc43-408d-966b-f59abd35834a",
                                                "sense_id": "c2a01bf2-14c4-341a-a468-58c855ce6ecf",
                                                "text": "Most of the fibulae have a triangular molding above the notch, which probably contained wound wire. The crossbar is decorated either with a flat knob or with a Persian merlon."
                                            },
                                            {
                                                "example_id": "307c1bf6-2f9c-4f86-8891-8da1f3f8d44a",
                                                "sense_id": "c2a01bf2-14c4-341a-a468-58c855ce6ecf",
                                                "text": "Smaller and less powerful falcons included the merlon, the hobby, and the kesterel."
                                            },
                                            {
                                                "example_id": "ce383b8b-4f56-4f84-81f1-728cdf56dfe1",
                                                "sense_id": "c2a01bf2-14c4-341a-a468-58c855ce6ecf",
                                                "text": "The connection between sporting activities and social rank is given a fanciful expression in the aforementioned The Boke of St. Albans. In that work the author lists the types of birds considered appropriate for the various stations of human life: / The eagle, the vulture, and the merlon for an emperor [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13a6fbd2-c711-455b-b34a-c1be17ceb737",
                        "source_entry_id": "258924c4-1c20-3cbf-a3fe-88d03773e61f",
                        "source_sense_id": "36aae213-b044-38ab-a511-9ef8cf454f2e",
                        "source_sense_description": "elk van de opstaande delen van de getande bovenkant van (oude) verdedigingsmuren",
                        "target_lang_word": "créneau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "créneau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Espace entre deux merlons en haut d’un rempart, pour tirer sur l'ennemi, tout en restant abrité de son tir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f85bfd0-322b-472b-ab19-54f4fa578ea8",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "L’unique fenêtre s’ouvrait sur une petite terrasse surmontant la tourelle, […] mais elle vit bientôt qu’elle ne communiquait avec aucune partie des créneaux."
                                            },
                                            {
                                                "example_id": "343d1d38-8fda-4a44-9e78-8497f97da186",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Elle se penche entre les noirs créneaux de moment en moment, et observe d'un oeil attentif l'ennemi dans son camp."
                                            },
                                            {
                                                "example_id": "133f8fc6-e052-4c3d-a025-b0caf3c3a693",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Or, cette surélévation est construite en pierres avec bossages, les créneaux sont plus espacés, l’appareil beaucoup plus soigné que dans la partie inférieure."
                                            },
                                            {
                                                "example_id": "89b71505-3669-4484-a324-675251e11b99",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Cela fait, le gars aux biques alla se poster à un créneau et se mit à envoyer aux tirailleurs allemands des balles bien dirigées."
                                            },
                                            {
                                                "example_id": "a7f77566-c405-43a7-ae20-9b422165d234",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "La loge du concierge figure une tour carrée, avec une plate-forme à créneaux, garnie d'échauguettes."
                                            },
                                            {
                                                "example_id": "8fa31f00-1474-4242-9824-ec99aec340d1",
                                                "sense_id": "9f6ce7fb-a5b1-3a19-9e9a-5246713b5b9d",
                                                "text": "Il passa une heure entière à se promener dans le hall, allant d’une pièce à l’autre, dans un silence fortifié, par les créneaux duquel il lançait parfois un regard éperdu, ne voulant, ne pouvant rien dire à personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceca25f7-0f49-36cd-90d6-a04cf6e67d00",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Ouverture faite au parapet des tranchées, par lesquelles on peut tirer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ff88a18-098d-3a24-a97d-51cb8bf5a87f",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Intervalle que les pelotons laissent entre eux dans l’ordre de bataille et où se placent les chefs de peloton."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Manœuvre pour mettre en stationnement le long d’un trottoir, un véhicule entre deux autres déjà stationnés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a73397c3-24c8-4d96-b701-5e3e1104c715",
                                                "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                                "text": "Dans les livres de code de la route, il y a trois types de stationnement : en épi, en bataille ou en créneau."
                                            },
                                            {
                                                "example_id": "fce8cf46-cd00-402c-a34a-6b8916d97082",
                                                "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                                "text": "Rater un créneau le jour du permis, ça peut être éliminatoire."
                                            },
                                            {
                                                "example_id": "7ff9f711-4415-4ebf-afe1-947e02457096",
                                                "sense_id": "e53abbc4-45c8-3e91-9fb6-7108821e8354",
                                                "text": "Certains modèles sont équipés de systèmes électroniques qui aident le conducteur à faire son créneau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbb7c54f-5145-3ad1-a3d2-24256c61e5a8",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Place disponible sur le marché, segment où peut être exploité un type de produit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e91585-6d85-4e55-a082-3bd7e01675a1",
                                                "sense_id": "cbb7c54f-5145-3ad1-a3d2-24256c61e5a8",
                                                "text": "A peine moins pessimistes, nombre d’économistes se préoccupent surtout du retard pris par l’Europe en matière d’innovation – au risque de rater les créneaux du futur, comme celui de l’intelligence artificielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57daf438-cef0-369f-92c5-dcd676e542b6",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Intervalle de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a3aa80c-9ffb-4ef0-a88c-2d9cb0eab787",
                                                "sense_id": "57daf438-cef0-369f-92c5-dcd676e542b6",
                                                "text": "Notre emploi du temps divise la journée de travail en 5 créneaux."
                                            },
                                            {
                                                "example_id": "beb66212-61ed-48f6-b106-1f423ae8de3c",
                                                "sense_id": "57daf438-cef0-369f-92c5-dcd676e542b6",
                                                "text": "Il y a forcément un créneau qu'on va trouver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcab2a12-2672-3664-82ba-ed00f5c10567",
                                        "entry_id": "e774faa6-70e0-3b47-a6db-8e33c9750956",
                                        "glosses": [
                                            "Emplacement destiné à recevoir un conteneur sur un porte-conteneurs."
                                        ],
                                        "tags": [
                                            "Transport maritime"
                                        ],
                                        "examples": []
