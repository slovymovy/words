                    {
                        "sense_id": "ac0ccf72-ee14-31e9-88ee-62c2cc85d451",
                        "entry_id": "3724c529-fa07-3847-907f-a4929d499b45",
                        "glosses": [
                            "bezleśne zbiorowisko roślinności w zimnym klimacie strefy arktycznej i subarktycznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44616bf4-f4bb-449f-ab28-e24815ca9baf",
                                "sense_id": "ac0ccf72-ee14-31e9-88ee-62c2cc85d451",
                                "text": "Strefa tundry jest prawie zupełnie pozbawiona ludzkich osiedli."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d34ece3-b8c7-47c9-bc25-e9fea1a8c5b4",
                        "source_entry_id": "3724c529-fa07-3847-907f-a4929d499b45",
                        "source_sense_id": "ac0ccf72-ee14-31e9-88ee-62c2cc85d451",
                        "target_lang_word": "tundra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tundra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4e4f337-00f9-3b18-a963-fa8873f04847",
                                        "entry_id": "d757e6c5-5cb3-3e96-b675-71d4092e2341",
                                        "glosses": [
                                            "A flat and treeless Arctic biome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6a03348-71d5-44d2-8a0a-a977ddc9b7a7",
                                                "sense_id": "b4e4f337-00f9-3b18-a963-fa8873f04847",
                                                "text": "The hut's walls rose without difficulty, and everything went smoothly until the problem of the roof confronted me. Of what use the four walls without a roof? And of what could a roof be made? There were the spare oars, very true. They would serve as roof-beams; but with what was I to cover them? Moss would never do. Tundra grass was impracticable. We needed the sail for the boat, and the tarpaulin had begun to leak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be797a32-c8fb-4c2c-abff-2dfc2bc3056e",
                        "source_entry_id": "3724c529-fa07-3847-907f-a4929d499b45",
                        "source_sense_id": "ac0ccf72-ee14-31e9-88ee-62c2cc85d451",
                        "target_lang_word": "tundra",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tundra",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ecb30afd-6025-3928-8875-75a1b60391d3",
                                        "entry_id": "4e47cdd0-6b47-3e21-8f8e-05cc4f8d69fd",
                                        "glosses": [
                                            "rostlinný pás chladných severských oblastí mezi ledovcem a hranicí, od které na jih začínají růst stromy"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29d7451f-494d-41bb-a8b6-76d9210abfeb",
                        "source_entry_id": "3724c529-fa07-3847-907f-a4929d499b45",
                        "source_sense_id": "ac0ccf72-ee14-31e9-88ee-62c2cc85d451",
                        "target_lang_word": "toundra",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toundra",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc08f575-91fe-34b5-b4ce-3db0fc410d9a",
                                        "entry_id": "785bc8de-ef4e-3248-9dfa-ebfb8c724ddc",
                                        "glosses": [
                                            "Formation végétale clairsemée des pays très froids faite de mousses, de lichens, de poacées (ou graminées) et d’arbres nains, et où vivent les rennes, les élans, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e410c64-61b0-4edd-824f-429ca99e9f2c",
                                                "sense_id": "dc08f575-91fe-34b5-b4ce-3db0fc410d9a",
                                                "text": "Puisque les toundra ne dégèlent qu’à une profondeur peu considérable, on conçoit qu’on puisse les parcourir aisément en tous sens, et même à la fin de la saison chaude, en traineaux attelés de rennes, sans que les buissons et les herbes de petite taille répandus çà et là soient de force à opposer une résistance sérieuse quelconque. Même la Mousse la plus tendre ne constitue jamais ici un sol à oscillation trompeuse, attendu la proximité de la glace souterraine de la surface du sol, qu’elle convertit en une masse compacte et solide comme la pierre. Dans la Sibérie arctique, il est des surfaces étendues où même les végétaux cryptogames ne sauraient venir et où le sol est dépouillé de toute plante, contrées désertes rattache également aux toundra."
                                            },
                                            {
                                                "example_id": "c1b6644b-ecbf-4736-b663-ac5e5d9fca50",
                                                "sense_id": "dc08f575-91fe-34b5-b4ce-3db0fc410d9a",
                                                "text": "Le fait est qu’en été les parties basses de la toundra sont extraordinairement mouillées. La cause première en est que la totalité de la surface topographique dégèle, nous le savons, sur plusieurs décimètres."
                                            },
                                            {
                                                "example_id": "f6059b3d-77ce-46fe-9047-63f0522792f4",
                                                "sense_id": "dc08f575-91fe-34b5-b4ce-3db0fc410d9a",
                                                "text": "Une des conséquences majeures de la présence des glaciers est une descente de la limite altitudinale des zones de végétation, d’environ 1,200/1,300 m par rapport aux limites actuelles. Toute la partie méridionale de l’Amérique du Sud est alors recouverte de steppe et de toundra."
                                            },
                                            {
                                                "example_id": "882a9e3a-216e-43d4-9212-fca2b58aa399",
                                                "sense_id": "dc08f575-91fe-34b5-b4ce-3db0fc410d9a",
                                                "text": "La forêt boréale n’existe que dans l'hémisphère nord. Elle sépare la toundra au nord de la forêt mixte et/ou de la prairie au sud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37782a9c-f046-42f2-b141-95e8b9c87d8b",
                        "source_entry_id": "3724c529-fa07-3847-907f-a4929d499b45",
                        "source_sense_id": "ac0ccf72-ee14-31e9-88ee-62c2cc85d451",
                        "target_lang_word": "tundra",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tundra",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3db92f0f-d65b-318f-abb5-2665f4c59e1b",
                                        "entry_id": "7a4a2f80-54ab-30e3-9604-3513f6baaecb",
                                        "glosses": [
                                            "Terreno abierto y llano de clima subglacial y subsuelo helado con falta de vegetación arbórea, suelo cubierto de musgos y líquenes y pantanoso en muchos sitios."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cc6471c-795a-49ba-a05a-c0d6b058b2bd",
                        "source_entry_id": "3724c529-fa07-3847-907f-a4929d499b45",
                        "source_sense_id": "ac0ccf72-ee14-31e9-88ee-62c2cc85d451",
                        "target_lang_word": "Tundra",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tundra",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b55b4a09-a76d-3e03-aac7-173fe6453bf1",
                                        "entry_id": "24cc6012-6873-3904-aa36-49a83be034e8",
                                        "glosses": [
                                            "sumpfige, baumlose Kältesteppe nördlich der arktischen Waldgrenze bis zur polaren Eisdecke"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddcfa3b0-a535-45fe-9f1f-484f5e34748c",
                                                "sense_id": "b55b4a09-a76d-3e03-aac7-173fe6453bf1",
                                                "text": "Die Tundra ist von Schnee bedeckt, die weiße Fläche wird nur von braunen Weidenbüschen unterbrochen."
                                            },
                                            {
                                                "example_id": "4e7c503b-1680-4bee-9f0d-7a699dda5220",
                                                "sense_id": "b55b4a09-a76d-3e03-aac7-173fe6453bf1",
                                                "text": "Im Sommer locken die weißen Belugawale, die in riesigen Herden hier auftauchen, Besucher an, oder die Tundra lockt durch die Vielfalt ihrer Vögel."
                                            },
                                            {
                                                "example_id": "eafe6a4a-961d-42c2-927a-34afca18cc39",
                                                "sense_id": "b55b4a09-a76d-3e03-aac7-173fe6453bf1",
                                                "text": "Das Landschaftsprofil umfasst Hunderte von Seen, Flüsse, Moore sowie subalpine und alpine Weideflächen, die in Tundra übergehen."
                                            },
                                            {
                                                "example_id": "f5bf4941-5781-4edd-9c30-ccac197c73ea",
                                                "sense_id": "b55b4a09-a76d-3e03-aac7-173fe6453bf1",
                                                "text": "Über rund 120 Kilometer schlängelt sich der Fluss durch eine mit Gräsern, Flechten und Zwergsträuchern bewachsene offene Tundra, in der Karibus – die nordamerikanischen Rentiere mit ihren immensen Schaufelgeweihen – leben."
                                            },
                                            {
                                                "example_id": "44a7c5b9-2569-43e2-9f8d-ac5960d6dc8a",
                                                "sense_id": "b55b4a09-a76d-3e03-aac7-173fe6453bf1",
                                                "text": "Auf der Höhe der diluvialen Eiszeit hatte er ihn tief in der Schweiz und in Frankreich kennengelernt, bis wohin damals noch diese öde polare Tundra (Moos- und Flechtensteppe) infolge der veränderten klimatischen Verhältnisse selbst reichte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
