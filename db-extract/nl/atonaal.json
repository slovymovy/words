                "senses": [
                    {
                        "sense_id": "8989c407-104b-3400-b78b-8b62e30c7b5a",
                        "entry_id": "a7f4cd44-02a5-3dcd-b03d-1e241eeb637e",
                        "glosses": [
                            "zonder overheersende tooncentra, zoals een tonica of dominant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fba50ff-538c-4437-bfe5-a65da5ffe365",
                                "sense_id": "8989c407-104b-3400-b78b-8b62e30c7b5a",
                                "text": "De atonale muziek werd met name in de tweede helft van de twintigste eeuw geschreven."
                            },
                            {
                                "example_id": "6985ede8-49eb-4da4-9ce7-ee004b771b15",
                                "sense_id": "8989c407-104b-3400-b78b-8b62e30c7b5a",
                                "text": "Nietsvermoedende konijnen hopsten door de boomgaard en op de heuvels in de verte werden geiten gehoed, de bellen om hun nek klingelden atonaal en onregelmatig, een rustgevend geluid, omdat er geen enkele opzet achter zat."
                            }
                        ]
                    }
                ],
