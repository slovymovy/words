                "senses": [
                    {
                        "sense_id": "c1c18530-dd64-30d5-a816-9c6101e9e64b",
                        "entry_id": "3d0dd5c3-e83a-3a81-918d-35527ca92bfc",
                        "glosses": [
                            "Apparat, der Flüssigkeiten oder andere Stoffe in Behälter einfüllt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e067e8f2-0a8b-4789-bc8b-d303d66c2541",
                                "sense_id": "c1c18530-dd64-30d5-a816-9c6101e9e64b",
                                "text": "„Nach dem Ersten Weltkrieg wurde die Brauerei nochmals erweitert und eine Flaschenwaschmaschine sowie ein Abfüllapparat angeschafft, um auch Flaschenbier ausliefern zu können.“"
                            },
                            {
                                "example_id": "7835addc-07f2-4d24-b082-9583deac2c93",
                                "sense_id": "c1c18530-dd64-30d5-a816-9c6101e9e64b",
                                "text": "„Die Flaschen selbst und der Abfüllapparat müssen regelmäßig mit nicht zu heißem Wasser (Gebrauchsanweisung beachten) ausgespült werden.“"
                            },
                            {
                                "example_id": "1e413a3f-f3c5-4027-a423-c97ff79123a1",
                                "sense_id": "c1c18530-dd64-30d5-a816-9c6101e9e64b",
                                "text": "„Parallel zu den chemisch- pharmazeutischen Produkten wurden Abfüllapparate verkauft, mit denen der Drogist die damaligen Haushaltsreiniger (Salzsäure, Bleichwasser, Natronlauge, Eau de Javel/Chlorbleichlauge, Salmiakgeist, Aqua Des. etc.) sicher aus Glaskorbflaschen abfüllen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
