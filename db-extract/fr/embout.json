                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7c20f114-491b-48bd-b57a-9e1354e6cf5f",
                        "entry_id": "ecabe2dc-8dff-3f93-90f6-62b79557971b",
                        "tags": [
                            "plural"
                        ],
                        "form": "embouts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25502a1c-42ad-37b3-99f7-6d143fe19763",
                        "entry_id": "ecabe2dc-8dff-3f93-90f6-62b79557971b",
                        "glosses": [
                            "Garniture dont on entoure, dans une canne, un parapluie, etc., l’extrémité qui touche le sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a80492-6eb8-42c9-8a93-c5cfdef0c941",
                                "sense_id": "25502a1c-42ad-37b3-99f7-6d143fe19763",
                                "text": "Un embout en caoutchouc."
                            }
                        ]
                    },
                    {
                        "sense_id": "74972ec5-9d37-3979-bc28-5adb7446e188",
                        "entry_id": "ecabe2dc-8dff-3f93-90f6-62b79557971b",
                        "glosses": [
                            "Extrémité d’une chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f42b7364-06eb-4a0f-9efa-7aa469f6120a",
                                "sense_id": "74972ec5-9d37-3979-bc28-5adb7446e188",
                                "text": "Elle prit sa perceuse dans sa trousse à outils, y fixa un embout de tournevis cruciforme et se mit à ôter les vis du verrou et de la plaque de propreté."
                            },
                            {
                                "example_id": "97ff4bc3-0d44-4b7d-99c7-4fdcfa9a9184",
                                "sense_id": "74972ec5-9d37-3979-bc28-5adb7446e188",
                                "text": "…indiquant de manière enfantine que la trompe vaporisait de l'eau, comme une pomme de douche ou un embout de tuyau d'arrosage."
                            },
                            {
                                "example_id": "d476fc7a-1dda-48c6-90b0-580b53fa77e7",
                                "sense_id": "74972ec5-9d37-3979-bc28-5adb7446e188",
                                "text": "Choisir un embout de taille adaptée aux narines du nouveau-né : le diamètre des embouts va croissant, au cours de la ventilation l'extrémité s'évase, réalisant ainsi l'étanchéité."
                            }
                        ]
                    },
                    {
                        "sense_id": "369fb0d1-51cd-39a5-a9b6-8f12dee11505",
                        "entry_id": "ecabe2dc-8dff-3f93-90f6-62b79557971b",
                        "glosses": [
                            "Revêtement de plomb étamé que l’on met, dans un bâtiment, à une corniche ou aux parties extérieures en bois."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
