                ],
                "senses": [
                    {
                        "sense_id": "789966e2-41eb-3641-bb36-1a0d5952a703",
                        "entry_id": "88974686-4b6d-335f-93e7-ec24fd558441",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fefb29bf-8b5b-43b6-b250-fe475ed872f1",
                                "sense_id": "789966e2-41eb-3641-bb36-1a0d5952a703",
                                "text": "Frau Eisenhardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f33c0991-0702-4b48-92b3-45866c8864d1",
                                "sense_id": "789966e2-41eb-3641-bb36-1a0d5952a703",
                                "text": "Herr Eisenhardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dd747df7-5a47-46b2-89be-fe0c160be919",
                                "sense_id": "789966e2-41eb-3641-bb36-1a0d5952a703",
                                "text": "Die Eisenhardts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6ac38971-0ba9-4db4-9663-316f79f318da",
                                "sense_id": "789966e2-41eb-3641-bb36-1a0d5952a703",
                                "text": "Der Eisenhardt trägt nie die Schals, die die Eisenhardt ihm strickt."
                            },
                            {
                                "example_id": "b0c2a8dc-66f9-4549-8968-0c6822a8da6d",
                                "sense_id": "789966e2-41eb-3641-bb36-1a0d5952a703",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eisenhardt kommt, geht der Herr Eisenhardt.“"
                            },
                            {
                                "example_id": "4de04ef5-3ce0-42d8-bd65-02b6e33111cd",
                                "sense_id": "789966e2-41eb-3641-bb36-1a0d5952a703",
                                "text": "Eisenhardt kommt und geht."
                            },
                            {
                                "example_id": "1994505b-6c61-443f-ade1-b3db63a38f7b",
                                "sense_id": "789966e2-41eb-3641-bb36-1a0d5952a703",
                                "text": "Eisenhardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
