                                                "example_id": "62c8f216-bb61-4c68-8c73-ce8ec54bec30",
                                                "sense_id": "33ef71b7-9f04-333e-ae45-79be2f91de14",
                                                "text": "Мы жили в самом центре, и я помню, как бомбы падали в нашем районе — фашистские лётчики метили в Кремль."
                                            },
                                            {
                                                "example_id": "02c60ab9-41f5-4e74-a0f1-ba3d53229084",
                                                "sense_id": "33ef71b7-9f04-333e-ae45-79be2f91de14",
                                                "text": "Вход в Кремль был по пропускам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78b52934-c3d5-3101-9630-31681a9bf4ba",
                                        "entry_id": "bd22b89a-715d-3154-a1f8-51aa664e1b63",
                                        "glosses": [
                                            "метоним. употребляется как символ высших органов власти Российской Федерации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c812f809-8551-4e96-b603-07f63e8d7bf2",
                                                "sense_id": "78b52934-c3d5-3101-9630-31681a9bf4ba",
                                                "text": "«ЕР» не лезет поперёк батьки в пекло — Кремль молчит, и она воды в рот набрала."
                                            },
                                            {
                                                "example_id": "fefd1df5-ce37-47fa-8a0b-3327dab80191",
                                                "sense_id": "78b52934-c3d5-3101-9630-31681a9bf4ba",
                                                "text": "Идите в Кремль и добивайтесь изменения политического и экономического курса."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce184356-fc96-4486-99f2-d38c45985eba",
                        "source_entry_id": "0992457e-8ab2-398e-b377-64573c49ca0f",
                        "target_lang_word": "Kreml",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreml",
