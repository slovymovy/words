                ],
                "senses": [
                    {
                        "sense_id": "ffedae16-de55-34d8-9405-f68ffac42ac7",
                        "entry_id": "32134109-002c-3f18-bf83-3f1cf47f5f64",
                        "glosses": [
                            "Fenster in einer ein Wohnzimmer umschließenden Mauer/Wand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "847f75fa-f748-44ba-9b49-f6a5df3538df",
                                "sense_id": "ffedae16-de55-34d8-9405-f68ffac42ac7",
                                "text": "„Er trat an das große Wohnzimmerfenster und sah auf die Stadt.“"
                            },
                            {
                                "example_id": "2c2f610d-3d81-4b26-a900-2fb0c54bbd35",
                                "sense_id": "ffedae16-de55-34d8-9405-f68ffac42ac7",
                                "text": "„Bundschuhs haben sich vor ihrem Wohnzimmer eine Terrasse angelegt, die auf die Schulwiese führt, und das Wohnzimmerfenster in eine Tür umbauen lassen, die immer offensteht, auch wenn niemand zu Hause ist, damit der Pudel Moritz jederzeit rein und raus kann.“"
                            },
                            {
                                "example_id": "65eb05b6-5daf-45a3-b090-01f3ef156cd2",
                                "sense_id": "ffedae16-de55-34d8-9405-f68ffac42ac7",
                                "text": "„Am 7. Dezember 1941, einem Sonntag, spielte der achtjährige Philip mit Freunden in der Gasse neben dem Haus in der Summit Avenue, als sich sein Vater aus dem Wohnzimmerfenster beugte und ihn hinaufrief; gerade war im Radio die Nachricht vom Angriff auf Pearl Harbor gekommen.“"
                            },
                            {
                                "example_id": "a0090d85-292c-471e-b942-16e6239abcfa",
                                "sense_id": "ffedae16-de55-34d8-9405-f68ffac42ac7",
                                "text": "„Erst wenn die Jungs durch die Tür waren und er sie vom Wohnzimmerfenster aus mit ihren viel zu schweren Schultaschen weggehen sah, hatte er das Gefühl, wieder frei atmen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
