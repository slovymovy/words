{
    "word_family": [
        "facsimile"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab18160b-0e6d-34f5-9ebd-ac3957042e97",
                    "sense_definition": "A machine used to send or receive documents electronically over a telephone line.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fax_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please send the signed contract to our office <w>fax</w>.",
                            "target_lang_translations": {
                                "zh": "请将签署好的合同发送到我们办公室的<w>传真机</w>上。"
                            }
                        },
                        {
                            "text": "The <w>fax</w> is out of paper, so I cannot receive your document right now.",
                            "target_lang_translations": {
                                "zh": "<w>传真机</w>没纸了，所以我现在收不到你的文件。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "send by fax",
                        "fax machine"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于通过电话线电子传输或接收文件的机器设备。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "传真机",
                                "target_lang_sense_clarification": "设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee83cd21-ad1a-3a37-ba6f-5f92092fe6ea",
                    "sense_definition": "A document that has been transmitted and printed by a fax machine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fax_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I just received a <w>fax</w> from the bank regarding your loan application.",
                            "target_lang_translations": {
                                "zh": "我刚收到一份银行发来的关于你贷款申请的<w>传真</w>。"
                            }
                        },
                        {
                            "text": "Please check the <w>fax</w> on the desk to see if the report arrived.",
                            "target_lang_translations": {
                                "zh": "请查看桌上的<w>传真件</w>，看看报告到了没有。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "receive a fax"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过传真机传输并打印出来的文件或信件。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "传真",
                                "target_lang_sense_clarification": "文件"
                            },
                            {
                                "target_lang_word": "传真件",
                                "target_lang_sense_clarification": "具体纸质文件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dd80f1d-bf7e-389b-b56e-edd943bd4164",
                    "sense_definition": "A nonstandard or slang way of saying facts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is just stating the <w>fax</w> about the situation.",
                            "target_lang_translations": {
                                "zh": "他只是在陈述这一情况的<w>事实</w>。"
                            }
                        },
                        {
                            "text": "You should check the <w>fax</w> before you make such a bold claim.",
                            "target_lang_translations": {
                                "zh": "在做出这样大胆的断言之前，你应该先核实一下<w>真相</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Nonstandard usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（俚语或非标准拼写）事实、真相（即 facts）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "事实",
                                "target_lang_sense_clarification": "实际情况"
                            },
                            {
                                "target_lang_word": "真相",
                                "target_lang_sense_clarification": "事情原貌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "530dae56-83fc-3c84-8f72-fcda7ef1cc72",
                    "sense_definition": "The hair on a person's head.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old poem described her golden <w>fax</w> flowing in the wind.",
                            "target_lang_translations": {
                                "zh": "那首古诗描写了她在风中飘拂的金黄色<w>发丝</w>。"
                            }
                        },
                        {
                            "text": "He brushed his <w>fax</w> carefully before leaving the house.",
                            "target_lang_translations": {
                                "zh": "出门前，他仔细地梳理了自己的<w>头发</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Old English usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语）人的头发。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "头发",
                                "target_lang_sense_clarification": "毛发"
                            },
                            {
                                "target_lang_word": "发丝",
                                "target_lang_sense_clarification": "诗歌或文学用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8795744-3d7c-3150-8b64-f9055a70c069",
                    "sense_definition": "The face or appearance of a person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler had a weary <w>fax</w> after the long journey.",
                            "target_lang_translations": {
                                "zh": "经过长途跋涉，这位旅行者露出了疲惫的<w>容貌</w>。"
                            }
                        },
                        {
                            "text": "She looked at him with a stern <w>fax</w>.",
                            "target_lang_translations": {
                                "zh": "她带着严厉的<w>面容</w>看着他。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Old English usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语）人的面容、容貌或外表。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "面容",
                                "target_lang_sense_clarification": "脸部容貌"
                            },
                            {
                                "target_lang_word": "容貌",
                                "target_lang_sense_clarification": "相貌外表"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67db4076-1d33-35ec-894f-02d85572724c",
                    "sense_definition": "To transmit a document using a fax machine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fax_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>fax</w> the signed document to our office by noon.",
                            "target_lang_translations": {
                                "zh": "请在中午前将签署好的文件<w>传真</w>到我们办公室。"
                            }
                        },
                        {
                            "text": "I will <w>fax</w> you the details as soon as I get to the office.",
                            "target_lang_translations": {
                                "zh": "我一到办公室就会把详细情况给您<w>发传真</w>过去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fax over",
                        "fax back"
                    ],
                    "target_lang_definitions": {
                        "zh": "使用传真机发送或传输文件。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "传真",
                                "target_lang_sense_clarification": "发送传真"
                            },
                            {
                                "target_lang_word": "发传真",
                                "target_lang_sense_clarification": "传输文件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "8898939c-8831-373a-9aae-e4afa45724e2",
                    "sense_definition": "An expression used to show strong agreement with a statement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A: That movie was absolutely terrible. B: <w>Fax</w>.",
                            "target_lang_translations": {
                                "zh": "A：那部电影简直烂透了。 B：<w>确实</w>。"
                            }
                        },
                        {
                            "text": "A: We really need to change our strategy. B: <w>Fax</w>, I agree completely.",
                            "target_lang_translations": {
                                "zh": "A：我们真得改变策略了。 B：<w>大实话</w>，我完全同意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "true that"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal agreement"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（俚语）表示强烈赞同或认可对方说法的感叹词，意为“确实”、“可不是嘛”。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "赞同对方的观点"
                            },
                            {
                                "target_lang_word": "大实话",
                                "target_lang_sense_clarification": "认同所言非虚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}