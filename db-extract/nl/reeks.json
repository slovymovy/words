                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "807c3ff1-3d72-4a0e-92ad-ea829dbb69b1",
                        "source_entry_id": "31e09e17-d814-3ed7-8d4d-38118aa18f00",
                        "source_sense_id": "5c572152-8946-30b4-9bd4-e7d0fd67013c",
                        "source_sense_description": "een opeenvolgende rij van gebeurtenissen",
                        "target_lang_word": "Reihe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reihe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc7ad4e-bfd2-32c2-af5e-611471e8ee78",
                                        "entry_id": "bceb4712-0560-3dc0-97b4-108ab66ebd04",
                                        "glosses": [
                                            "etwas geradlinig Angeordnetes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf2f7beb-b2cb-4419-b23f-7042c1d3e529",
                                                "sense_id": "7bc7ad4e-bfd2-32c2-af5e-611471e8ee78",
                                                "text": "Die Soldaten traten in einer Reihe an; sie standen Schulter an Schulter."
                                            },
                                            {
                                                "example_id": "9c92af73-a1d7-409f-9ebf-42a2e66d5f38",
                                                "sense_id": "7bc7ad4e-bfd2-32c2-af5e-611471e8ee78",
                                                "text": "Die Stiftung Warentest empfiehlt, [beim Hauskauf] einen Blick auch auf die zweite Reihe zu werfen, jenseits der oft überteuerten und begehrten Lagen."
                                            },
                                            {
                                                "example_id": "331a8851-f6e3-4eac-a710-6b822114ea75",
                                                "sense_id": "7bc7ad4e-bfd2-32c2-af5e-611471e8ee78",
                                                "text": "„Die Sträucher werden idealerweise in einem zwei Meter breiten Streifen und in mehreren Reihen gepflanzt.“"
                                            },
                                            {
                                                "example_id": "9c764f62-116a-4223-8c2f-c6afd13cea51",
                                                "sense_id": "7bc7ad4e-bfd2-32c2-af5e-611471e8ee78",
                                                "text": "Wer glaubt, dass Bundeskanzlerin Merkel nach dem Flüchtlingsdeal mit der Türkei nun Ruhe in die eigenen Reihen gebracht hat, der macht seine Rechnung ohne ihn: Horst Seehofer ist weiterhin auf seinem eigenen Kurs."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "116cf1d9-d50c-3ffb-8540-7ba91081fe43",
                                        "entry_id": "bceb4712-0560-3dc0-97b4-108ab66ebd04",
                                        "glosses": [
                                            "eine bestimmte Abfolge, Anzahl, Reihenfolge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de04b01-e51d-4065-ac85-d8472d9d706b",
                                                "sense_id": "116cf1d9-d50c-3ffb-8540-7ba91081fe43",
                                                "text": "Nach einer Reihe von Jahren sah man sich wieder."
                                            },
                                            {
                                                "example_id": "15c2f51a-9688-403e-8efb-a027ccabccc5",
                                                "sense_id": "116cf1d9-d50c-3ffb-8540-7ba91081fe43",
                                                "text": "Eine Reihe von Ereignissen schloss sich an."
                                            },
                                            {
                                                "example_id": "469b7ff6-0609-45cc-84e0-46b72eeff60d",
                                                "sense_id": "116cf1d9-d50c-3ffb-8540-7ba91081fe43",
                                                "text": "Man kann ihn in einer Reihe mit Bach und Mozart nennen."
                                            },
                                            {
                                                "example_id": "0d3d4453-7fa9-4f1b-a527-b4a68ce4f431",
                                                "sense_id": "116cf1d9-d50c-3ffb-8540-7ba91081fe43",
                                                "text": "„Unfälle sind keine Zufälle, wie so manche Zeitungsnotiz verharmlosend wahrhaben möchte. Unfälle entstehen stets im Zusammenlaufen mehrerer Kausallinien, im Schnittpunkt einer Reihe ungünstiger Umstände und Fehlverhaltensweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ab622309-4019-3a9b-8e27-8d7f368fdcfc",
                                        "entry_id": "bceb4712-0560-3dc0-97b4-108ab66ebd04",
                                        "glosses": [
                                            "Summe der Glieder einer Folge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433bbbc1-2e67-4739-b5ab-82341febdda6",
                                                "sense_id": "ab622309-4019-3a9b-8e27-8d7f368fdcfc",
                                                "text": "„Unfälle sind keine Zufälle, wie so manche Zeitungsnotiz verharmlosend wahrhaben möchte. Unfälle entstehen stets im Zusammenlaufen mehrerer Kausallinien, im Schnittpunkt einer Reihe ungünstiger Umstände und Fehlverhaltensweisen.“"
                                            },
                                            {
                                                "example_id": "798487b2-baab-4967-b7fe-73e4c9f03fd8",
                                                "sense_id": "ab622309-4019-3a9b-8e27-8d7f368fdcfc",
                                                "text": "Die harmonische Reihe konvergiert nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ce0bb63e-1be6-3ba2-9712-102453461b76",
                                        "entry_id": "bceb4712-0560-3dc0-97b4-108ab66ebd04",
                                        "glosses": [
                                            "Zeile einer Tabelle, Matrix oder ähnlicher rechteckiger Schemata"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d469aee6-508c-44ca-85a5-6628e9715330",
                                                "sense_id": "ce0bb63e-1be6-3ba2-9712-102453461b76",
                                                "text": "Eine Zahl in der zweiten Reihe der Tabelle scheint falsch zu sein."
                                            },
                                            {
                                                "example_id": "d9dd7467-f196-4875-b764-8395805e90c9",
                                                "sense_id": "ce0bb63e-1be6-3ba2-9712-102453461b76",
                                                "text": "Diese Reihe enthält 26 Zeichen, oder Anschläge, wie man auch sagt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8e1438f7-e93c-3210-97a4-31c7f7b29cb7",
                                        "entry_id": "bceb4712-0560-3dc0-97b4-108ab66ebd04",
                                        "glosses": [
                                            "eine Einteilung in der Systematik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef88524-3889-451b-b039-8c862a1abbbd",
                                                "sense_id": "8e1438f7-e93c-3210-97a4-31c7f7b29cb7",
                                                "text": "Die Reihe ist ein Teil der klassischen Systematik."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "6c86f524-9502-3dc6-81b5-f3e228be7809",
                                        "entry_id": "bceb4712-0560-3dc0-97b4-108ab66ebd04",
                                        "glosses": [
                                            "die „Zeilen“ eines Schachbretts, acht waagrecht nebeneinander angeordnete Felder"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ebd21e7-ac3d-424c-856b-eba571035035",
                                                "sense_id": "6c86f524-9502-3dc6-81b5-f3e228be7809",
                                                "text": "Bei der Eröffnung zog der Königsbauer in die vierte Reihe."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "b1cdc352-206f-3098-b04b-f1f0b676f5bb",
                                        "entry_id": "bceb4712-0560-3dc0-97b4-108ab66ebd04",
                                        "glosses": [
                                            "Tonfolge, in der kein Ton wieder auftreten darf, bevor die anderen elf erklungen sind"
                                        ],
                                        "tags": [
                                            "Zwölftonmusik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "446976c2-bf8c-448a-9e1d-fc22fa8fd069",
                                                "sense_id": "b1cdc352-206f-3098-b04b-f1f0b676f5bb",
                                                "text": "Als Regel gilt, dass immer erst alle zwölf Töne der Reihe vorgekommen sein müssen, bevor ein Ton wiederholt werden darf."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "80504d35-390f-3b53-a9ff-afb3982f424f",
                                        "entry_id": "bceb4712-0560-3dc0-97b4-108ab66ebd04",
                                        "glosses": [
                                            "Serielle Verschaltung mehrerer Bauelemente ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a1791a4-b5aa-4995-b062-08cadd6ea3d0",
                                                "sense_id": "80504d35-390f-3b53-a9ff-afb3982f424f",
                                                "text": "Sind zwei Widerstände in Reihe geschaltet, resultiert daraus ein Gesamtwiderstand, dessen Wert sich aus der Addition derer der Einzelwiderstände ergibt."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "d3b9e1d2-aa3b-316a-841a-a376682de529",
                                        "entry_id": "bceb4712-0560-3dc0-97b4-108ab66ebd04",
                                        "glosses": [
                                            "Buchreihe, Filmreihe, Hörspielreihe, Spielreihe, Videospielreihe"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e5db3b4-e589-4f0a-9206-bf9594d5f6b8",
                                                "sense_id": "d3b9e1d2-aa3b-316a-841a-a376682de529",
                                                "text": "In dieser Reihe erschienen noch weitere Werke des Autors."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "5fa96c59-b1f4-388f-bf55-17a23737d4c8",
                                        "entry_id": "bceb4712-0560-3dc0-97b4-108ab66ebd04",
                                        "glosses": [
                                            "Abfolge aufeinander bezogener Kommunikationsbeiträge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ddca0ab-022d-44f1-b1a9-25bbe587dfe3",
                                                "sense_id": "5fa96c59-b1f4-388f-bf55-17a23737d4c8",
                                                "text": "„Häufig gibt es in einer Reihe einen zentralen Schritt, zum Beispiel ein Gerichtsurteil, das vorangegangene Reihenschritte beziehungsweise Reihenschrittfolgen zum Abschluss bringt durch die Setzung einer neuen Wirklichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "023ff16b-6464-481c-bd2e-418937feb20d",
                        "source_entry_id": "31e09e17-d814-3ed7-8d4d-38118aa18f00",
                        "source_sense_id": "5c572152-8946-30b4-9bd4-e7d0fd67013c",
                        "source_sense_description": "een opeenvolgende rij van gebeurtenissen",
                        "target_lang_word": "series",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "series",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "640bb9fe-5190-36db-85e8-34ffd95b98f5",
                                        "entry_id": "2952a3ba-515d-366b-be3d-08d555609268",
                                        "glosses": [
                                            "A number of things that follow on one after the other or are connected one after the other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4708ab15-090a-4257-9974-966ed254380a",
                                                "sense_id": "640bb9fe-5190-36db-85e8-34ffd95b98f5",
                                                "text": "A series of seemingly inconsequential events led cumulatively to the fall of the company."
                                            },
                                            {
                                                "example_id": "07bfda78-839b-45d6-a176-bb084fc33c30",
                                                "sense_id": "640bb9fe-5190-36db-85e8-34ffd95b98f5",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him.[…]. The captive made no resistance and came not only quietly but in a series of eager little rushes like a timid dog on a choke chain."
                                            },
                                            {
                                                "example_id": "96ae0f87-9dc9-460d-b5d0-8fad57ce21b4",
                                                "sense_id": "640bb9fe-5190-36db-85e8-34ffd95b98f5",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. When a series of bank failures made this impossible, there was widespread anger, leading to the public humiliation of symbolic figures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85904c46-cbd5-38d2-ac0c-344c5caa0cb5",
                                        "entry_id": "2952a3ba-515d-366b-be3d-08d555609268",
                                        "glosses": [
                                            "A television or radio program consisting of several episodes that are broadcast at regular intervals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e0f109-5c43-4927-bf55-fb0e1e74756e",
                                                "sense_id": "85904c46-cbd5-38d2-ac0c-344c5caa0cb5",
                                                "text": "“Friends” was one of the most successful television series in recent years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad88b946-9974-34eb-a67e-0fe37a6696f0",
                                        "entry_id": "2952a3ba-515d-366b-be3d-08d555609268",
                                        "glosses": [
                                            "Synonym of season (“one of the groups of episodes that together make up a whole series”)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ebfafbf-dee6-4493-8c9c-13f8f84c11d9",
                                                "sense_id": "ad88b946-9974-34eb-a67e-0fe37a6696f0",
                                                "text": "I enjoyed the third series of “Friends”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "435e15cf-4e22-3426-a5c7-6c43c7cb6505",
                                        "entry_id": "2952a3ba-515d-366b-be3d-08d555609268",
                                        "glosses": [
                                            "The sequence of partial sums ∑ᵢ₌₁ⁿa_i of a given sequence aᵢ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f295c65-c7ff-4a32-908b-f280fc6b2a87",
                                                "sense_id": "435e15cf-4e22-3426-a5c7-6c43c7cb6505",
                                                "text": "The harmonic series has been much studied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff848772-7b0f-3705-ad8e-3b29c1707d08",
                                        "entry_id": "2952a3ba-515d-366b-be3d-08d555609268",
                                        "glosses": [
                                            "A group of matches between two sides, with the aim being to win more matches than the opposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce43f741-b669-432d-84d8-951637ce7805",
                                                "sense_id": "ff848772-7b0f-3705-ad8e-3b29c1707d08",
                                                "text": "The Blue Jays are playing the Yankees in a four-game series."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e7e73b-0906-3bf5-93c5-8b51a48cf2d0",
