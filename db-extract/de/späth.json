                ],
                "senses": [
                    {
                        "sense_id": "186c1f96-5611-3e41-9183-62fee2cbfa2a",
                        "entry_id": "b699010a-ef38-3776-9c37-58c470777ace",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b72121-7ff8-478b-8498-d2a51e0a5f79",
                                "sense_id": "186c1f96-5611-3e41-9183-62fee2cbfa2a",
                                "text": "Frau Späth ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "62194749-65dd-41cc-a5cd-916431cd8272",
                                "sense_id": "186c1f96-5611-3e41-9183-62fee2cbfa2a",
                                "text": "Herr Späth wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5d1e85bd-ff72-47dc-829e-eeac773836e5",
                                "sense_id": "186c1f96-5611-3e41-9183-62fee2cbfa2a",
                                "text": "Die Späths fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "83d53efa-a1b4-4445-9a53-57d278ff983b",
                                "sense_id": "186c1f96-5611-3e41-9183-62fee2cbfa2a",
                                "text": "Der Späth trägt nie die Schals, die die Späth ihm strickt."
                            },
                            {
                                "example_id": "061f5908-5a42-4353-8d39-93e346a1be35",
                                "sense_id": "186c1f96-5611-3e41-9183-62fee2cbfa2a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Späth kommt, geht der Herr Späth.“"
                            },
                            {
                                "example_id": "5da64fbc-0865-4603-97b8-20c061c6ee73",
                                "sense_id": "186c1f96-5611-3e41-9183-62fee2cbfa2a",
                                "text": "Späth kommt und geht."
                            },
                            {
                                "example_id": "e5b5bb27-fa0e-432a-97d3-c1faee1353c0",
                                "sense_id": "186c1f96-5611-3e41-9183-62fee2cbfa2a",
                                "text": "Späths kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
