                "senses": [
                    {
                        "sense_id": "7aebca86-619a-37bd-979f-244754deb6e7",
                        "entry_id": "691857ad-c393-3e41-98d0-0d38c7f65a8e",
                        "glosses": [
                            "Zuschlagsmarke, die zeitweise verwendet werden muss"
                        ],
                        "tags": [
                            "Postwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "438685cd-316a-40d4-be40-c2f401fdb226",
                                "sense_id": "7aebca86-619a-37bd-979f-244754deb6e7",
                                "text": "„Die erste Briefmarke der Republik Zypern, die die Präsenz der Türken auf der Insel vergegenwärtigt, ist die Zwangszuschlagsmarke vom Dezember 1974, auf der eine Frau - offensichtlich eine Flüchtlingsfrau - ein Kleinkind auf dem Arm hält.“"
                            },
                            {
                                "example_id": "90fbc68d-4254-4290-8bb9-70dbaa19fc72",
                                "sense_id": "7aebca86-619a-37bd-979f-244754deb6e7",
                                "text": "„Nachdem dort vom 10. Januar 1949 bis Ende Mai 1949 die »Notopfer«-Marke verwendet wurde, war zwischen 1. Juli und 31. Dezember 1949 die Zwangszuschlagsmarke »Wohnungsbauabgabe« vorgeschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
