                "senses": [
                    {
                        "sense_id": "47f78a8e-8dca-3bd9-935a-b2b1ad0d5b25",
                        "entry_id": "5c81b380-a03d-352f-bfeb-9daad5140ced",
                        "glosses": [
                            "Blockierung, Störung, Verhinderung"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "091dc3b7-5c86-4615-8339-e0601fdbc228",
                                "sense_id": "47f78a8e-8dca-3bd9-935a-b2b1ad0d5b25",
                                "text": "„In der südlichen Zone gingen die deutsch-französischen Aushebungen, mit denen der italienischen Obstruktion in den letzten Monaten des Mussolini-Regimes und während der kurzen Herrschaft Badoglios begegnet werden sollte, weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "31cb026f-256f-380f-9208-1967b3def261",
                        "entry_id": "5c81b380-a03d-352f-bfeb-9daad5140ced",
                        "glosses": [
                            "Blockierung der Beschlussfassung eines Parlaments durch lange Reden, zahlreiche Anträge usw."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bb753f1-16c2-4718-8445-81d9eedd2b9e",
                                "sense_id": "31cb026f-256f-380f-9208-1967b3def261",
                                "text": "„Erstmals in der römischen Geschichte wandte er dabei auch erfolgreich das Instrument des Dauerredens als Mittel der Obstruktion an und erreichte auf diese Weise, dass die Abstimmung verschoben werden musste.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d4f5add2-ea27-3341-a57f-dda7f41b37bb",
                        "entry_id": "5c81b380-a03d-352f-bfeb-9daad5140ced",
                        "glosses": [
                            "Verstopfung von Gefäßen oder Kanälen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2646c42-3117-4f65-91d5-cf231ab6bdd3",
                                "sense_id": "d4f5add2-ea27-3341-a57f-dda7f41b37bb",
                                "text": "„Aufgrund seiner stark hygroskopischen Eigenschaften kann die Einnahme ohne genügend Wasser zu Obstruktionen der Speiseröhre führen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
