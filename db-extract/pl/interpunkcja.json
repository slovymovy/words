                    {
                        "translation_id": "9de4b9c6-1c65-4119-8fa8-42ca98068231",
                        "source_entry_id": "bd3588ee-e318-3f82-adf8-2be3a2e6f51d",
                        "source_sense_id": "6858c861-51b7-364d-a569-3098badc47f1",
                        "target_lang_word": "Interpunktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Interpunktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                        "entry_id": "0a9753a4-82f4-39ab-810b-d1d066310df1",
                                        "glosses": [
                                            "Verwendung der Interpunktionszeichen (Satzzeichen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8ee700-ecae-4406-adc4-761c60580d8d",
                                                "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                                "text": "Die Rechtschreibregeln enthalten auch Regeln für die Interpunktion."
                                            },
                                            {
                                                "example_id": "11ffa975-27b2-414a-9c28-edcc80aebc0d",
                                                "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                                "text": "„Unter Interpunktion (auch Zeichensetzung) versteht man das Setzen von Satzzeichen in Sätzen zur Verdeutlichung syntaktischer Strukturen und das Setzen von Wortzeichen in Wörtern zur Verdeutlichung morphologischer Strukturen. Sie folgt in jeder Sprache entsprechenden Interpunktionsregeln.“"
                                            },
                                            {
                                                "example_id": "9de02173-d892-4587-ad3d-1e5c67b9d3a0",
                                                "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                                "text": "„Die Nachrichten, die wir gegenseitig verfassen, sind zumeist kurz, oft sehr kurz, und missverständlich, oft in falscher Interpunktion und mit kruden Abkürzungen, ohne Kommata und Bindestriche, ohne Frage- und Ausrufezeichen.“"
                                            },
                                            {
                                                "example_id": "7135f5ad-9f43-45b1-beac-675684d88978",
                                                "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                                "text": "„Schließlich kann durch falsche Interpunktion ein Sinnzusammenhang ins Gegenteil und damit ins Komische verzerrt werden.“"
                                            },
                                            {
                                                "example_id": "a0459aed-8141-4292-939e-1fda39987e48",
                                                "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                                "text": "„Noch mehr Interpunktion macht alles nur noch schlimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "508b2012-e86f-4b90-a1e3-e37607ef02d6",
                        "source_entry_id": "bd3588ee-e318-3f82-adf8-2be3a2e6f51d",
                        "source_sense_id": "6858c861-51b7-364d-a569-3098badc47f1",
                        "target_lang_word": "Zeichensetzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeichensetzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "102f0a40-76e9-349d-8f6b-49186e3abb00",
                                        "entry_id": "5c07c0ec-312b-3d9a-9c78-cbeaf2ef5344",
                                        "glosses": [
                                            "Verwendung der Satz- und Wortzeichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d27c1fb2-5f16-48b5-a776-b84473998af7",
                                                "sense_id": "102f0a40-76e9-349d-8f6b-49186e3abb00",
                                                "text": "Die Rechtschreibregeln enthalten auch Regeln für die Zeichensetzung."
                                            },
                                            {
                                                "example_id": "6ddc60e3-8b26-4311-ae8e-377afd2bc017",
                                                "sense_id": "102f0a40-76e9-349d-8f6b-49186e3abb00",
                                                "text": "„Seine Eintragungen im Logbuch entsprachen, was Rechtschreibung und die Zeichensetzung betraf, nicht den Regeln, doch das gilt für viele schriftliche Zeugnisse der damaligen Zeit.“"
                                            },
                                            {
                                                "example_id": "6a0a9562-1a9a-4ddb-8931-7ed9006ff33c",
                                                "sense_id": "102f0a40-76e9-349d-8f6b-49186e3abb00",
                                                "text": "„Offiziell ist die Zeichensetzung reglementiert, in Wirklichkeit wird sie höchst individuell verwendet, jeder Schriftsteller hat seine eigene Interpunktion.“"
                                            },
                                            {
                                                "example_id": "4ee0ae34-fd50-48c1-8c4b-49f5330df0ef",
                                                "sense_id": "102f0a40-76e9-349d-8f6b-49186e3abb00",
                                                "text": "„Wo ein Text ohne Zeichensetzung missverständlich ist oder die Zeichensetzung gar an ihre Grenzen zu stoßen scheint, stimmt etwas mit dem Inhalt und seiner Formulierung nicht.“"
                                            },
                                            {
                                                "example_id": "6c266a09-2000-4982-9e41-21cd7d644b23",
                                                "sense_id": "102f0a40-76e9-349d-8f6b-49186e3abb00",
                                                "text": "„Elaine fragt sich, ob eine derartige Nachlässigkeit in der Zeichensetzung ein Hinweis auf ein fehlendes emotionales Interesse an ihrem Leben sein könnte (obwohl sie ihrem Freund davon nichts erzählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
