                    "frequency": "High",
                    "semantic_group_id": "affect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il éprouve un profond <w>sentiment</w> d'amitié pour ses camarades de classe."
                        },
                        {
                            "text": "Elle a du mal à exprimer son véritable <w>sentiment</w> amoureux devant lui."
                        }
                    ],
                    "synonyms": [
                        "émotion"
                    ],
                    "common_phrases": [
                        "sentiment amoureux",
                        "éprouver un sentiment"
                    ]
                },
                {
