                "senses": [
                    {
                        "sense_id": "82f00c92-4d84-3f17-ad4f-6ecaf198cca3",
                        "entry_id": "e477a89f-1b69-39ee-b095-1ce722a3fdf9",
                        "glosses": [
                            "in eine Wand eingebauter, dort versteckter Tresor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6561a1c-07f7-423e-a0d1-115edf882736",
                                "sense_id": "82f00c92-4d84-3f17-ad4f-6ecaf198cca3",
                                "text": "„Ganz hinten im Saal hielt Atticus ein Feuerzeug vor den freigelegten Wandtresor, während Braithwhite am Zahlenschloss hantierte.“"
                            },
                            {
                                "example_id": "792f3fd3-b08e-4ca7-b801-38695813a42f",
                                "sense_id": "82f00c92-4d84-3f17-ad4f-6ecaf198cca3",
                                "text": "„Die Afrikaner, die für Lord Thompson gearbeitet hatten, hatten, mit Gott weiß was, den Wandtresor gesprengt und Dollarscheine und Pfundnoten segelten durch die Luft.“"
                            },
                            {
                                "example_id": "88833290-bc4d-4b7d-8804-86bc73be6b63",
                                "sense_id": "82f00c92-4d84-3f17-ad4f-6ecaf198cca3",
                                "text": "„Er legte das Gewehr mit dem Vierfach-Zielfernrohr beiseite und nahm sein Zehnfach-Bino vor die Augen, mit dessen Hilfe er die Herstellerfirma und die Art von Modell des Wandtresors identifizieren konnte.“"
                            },
                            {
                                "example_id": "108862a8-87a1-49b6-8ed3-3c668193262b",
                                "sense_id": "82f00c92-4d84-3f17-ad4f-6ecaf198cca3",
                                "text": "„Er ging zu dem Gemälde eines alten Segelschiffs und nahm es vom Haken. Dahinter wurde ein Wandtresor sichtbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
