                "senses": [
                    {
                        "sense_id": "3f327245-22d9-350c-a4df-19941498fed5",
                        "entry_id": "10233c29-375a-3d6a-a69d-97e4a0f71bfe",
                        "glosses": [
                            "Faire perdre son caractère sémantique, porteur de sens, à (un mot…)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34226fc3-7f2e-49c2-b47d-35dcdca1b3f4",
                                "sense_id": "3f327245-22d9-350c-a4df-19941498fed5",
                                "text": "Une manière de la désémantiser en dissociant ce que nous appelons la première voix de toute matérialité phonique, de toutes traces de signifiant et signifié linguistiques transmises par les voix du dehors."
                            },
                            {
                                "example_id": "08adc33a-30bc-46b7-b42e-60c701201d70",
                                "sense_id": "3f327245-22d9-350c-a4df-19941498fed5",
                                "text": "Il n'y a rien que de très normal, puisque le signe, avant de se désémantiser plus ou moins complètement, était motivé à l'origine."
                            }
                        ]
                    }
