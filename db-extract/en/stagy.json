                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3b586d0-8f93-40fa-ba8f-f7933facf0b0",
                                                "sense_id": "0ac221de-bf23-3ef2-b93d-c1c78e3f6cc1",
                                                "text": "Die Auseinandersetzung wurde sehr theatralisch geführt."
                                            },
                                            {
                                                "example_id": "d459a88d-f52e-414f-92e2-eda2513073e5",
                                                "sense_id": "0ac221de-bf23-3ef2-b93d-c1c78e3f6cc1",
                                                "text": "„Okan, der dabei an der Nase berührt wurde, ging anschließend recht theatralisch zu Boden und hielt sich das Gesicht.“"
                                            },
                                            {
                                                "example_id": "cd54880a-faa6-43eb-b8a5-8c415a7a0139",
                                                "sense_id": "0ac221de-bf23-3ef2-b93d-c1c78e3f6cc1",
                                                "text": "„In diesem Vorfall fiel Dries Mertens theatralisch im Strafraum gegen Adana Demirspor, das Tabellenletzte der türkischen Super League, was Schiedsrichter Oguzhan Çakir veranlasste, einen Elfmeter zu geben.“"
                                            }
                                        ],
