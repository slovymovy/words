{
    "word_family": [
        "ontzeggen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1cbbb11-f58e-3709-bc0f-4f7244f20f73",
                    "sense_definition": "Het officieel of formeel verbieden of onthouden van een bepaald recht of een bevoegdheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbod_en_onthouding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter legde de verdachte een <w>ontzegging</w> van de rijbevoegdheid op voor de duur van twee jaar.",
                            "target_lang_translations": {
                                "en": "The judge imposed a two-year <w>disqualification</w> from driving on the suspect."
                            }
                        },
                        {
                            "text": "Na het schandaal eisten de burgers de <w>ontzegging</w> van het passieve kiesrecht voor de corrupte politicus.",
                            "target_lang_translations": {
                                "en": "After the scandal, the citizens demanded the <w>deprivation</w> of the right to stand for election for the corrupt politician."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbod",
                        "onthouding",
                        "weigering"
                    ],
                    "common_phrases": [
                        "ontzegging van de rijbevoegdheid",
                        "ontzegging van het kiesrecht"
                    ],
                    "target_lang_definitions": {
                        "en": "The official or formal prohibition or withholding of a certain right or authority."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disqualification",
                                "target_lang_sense_clarification": "such as driving privileges"
                            },
                            {
                                "target_lang_word": "deprivation",
                                "target_lang_sense_clarification": "of rights or privileges"
                            },
                            {
                                "target_lang_word": "denial",
                                "target_lang_sense_clarification": "of access or rights"
                            },
                            {
                                "target_lang_word": "revocation",
                                "target_lang_sense_clarification": "of a license or right"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bb299af-4e44-3bd5-9da0-27790750fcb4",
                    "sense_definition": "De handeling van het zichzelf of anderen onthouden van bepaalde goederen, genot of gebruik.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbod_en_onthouding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De monniken leefden in strenge <w>ontzegging</w> van alle materiële luxe en comfort.",
                            "target_lang_translations": {
                                "en": "The monks lived in strict <w>self-denial</w> of all material luxury and comfort."
                            }
                        },
                        {
                            "text": "Een voortdurende <w>ontzegging</w> van basisbehoeften kan leiden tot ernstige psychologische schade.",
                            "target_lang_translations": {
                                "en": "A continuous <w>deprivation</w> of basic needs can lead to serious psychological damage."
                            }
                        }
                    ],
                    "synonyms": [
                        "onthouding"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of withholding certain goods, pleasure, or use from oneself or others."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deprivation",
                                "target_lang_sense_clarification": "of basic needs or comfort"
                            },
                            {
                                "target_lang_word": "self-denial",
                                "target_lang_sense_clarification": "abstaining from pleasures or luxury"
                            },
                            {
                                "target_lang_word": "abstinence",
                                "target_lang_sense_clarification": "refraining from indulgence"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}