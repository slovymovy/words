                "senses": [
                    {
                        "sense_id": "edc6f0eb-5f0e-3531-bcc9-4ad27827338f",
                        "entry_id": "c24dc555-ffb7-3a55-93a7-1830d35810b6",
                        "glosses": [
                            "Physionomiste chargé de l’accueil à l'entrée de certaines salles ouvertes au public."
                        ],
                        "tags": [
                            "ellipsis",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4c283447-3a30-4fdd-a245-12188ec2c2bb",
                                "sense_id": "edc6f0eb-5f0e-3531-bcc9-4ad27827338f",
                                "text": "Vous savez qui je suis ? Vous savez qui je suis, putain ? Non ? Espèce de minable, dis-moi, tu sers à quoi si tu sais pas qui je suis ? A quoi ça sert un physio, hein ? Phy-sio ! Qu’est-ce que ça veut dire, à ton avis ? C’est du grec, connard, et littéralement ça veut dire un mec qui sait qui je suis ! Parce que je SUIS ! Je suis, putain ! Je suis une star."
                            },
                            {
                                "example_id": "2b142f3b-5d9e-495c-8463-ce6cce76b071",
                                "sense_id": "edc6f0eb-5f0e-3531-bcc9-4ad27827338f",
                                "text": "3 heures et demi. Regard un peu triste et sensuel, la physio chuchote des câlineries à un cravaté ravi de plaire à tant de nanas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
