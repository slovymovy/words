                                        "glosses": [
                                            "4（四）を意味する和語。よん。",
                                            "助数詞の人、年 、時 、時間などの前で、よんの代わりに用いる。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb297343-257c-4544-9c43-8e192f00726a",
                                                "sense_id": "3bc045df-f91d-3889-8d02-733f2b8498a4",
                                                "text": "四人。四年。四時。四時間。四次元。四円。四膳。四晩。"
                                            },
                                            {
                                                "example_id": "a4f70ab3-f9a0-4ecc-a1e7-dc0c02ceb10e",
                                                "sense_id": "3bc045df-f91d-3889-8d02-733f2b8498a4",
                                                "text": "四代目（よんだいめ、よだいめ）。四番"
                                            }
                                        ]
                                    }
                                ]
                            },
