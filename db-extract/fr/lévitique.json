                "senses": [
                    {
                        "sense_id": "8d4e4884-9374-33f2-bcbe-8c228d48a696",
                        "entry_id": "607f056a-8170-31e7-ac2a-170b896674f4",
                        "glosses": [
                            "Relatif aux lévites."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "fe286e8a-2ecd-4388-87a7-e9ef75a3fcde",
                                "sense_id": "8d4e4884-9374-33f2-bcbe-8c228d48a696",
                                "text": "Loi lévitique, ensemble des prescriptions de Moïse sur les fonctions sacerdotales."
                            },
                            {
                                "example_id": "db31336a-1a10-4220-a455-92fccfd448f7",
                                "sense_id": "8d4e4884-9374-33f2-bcbe-8c228d48a696",
                                "text": "Les empereurs et les rois les plus sages, tels que Charlemagne et Alfred-le-Grand, ont cru ne pouvoir mieux faire que de recevoir, dans le code civil, une partie de ce code ecclésiastique où viennent se fondre la loi lévitique, l'évangile et le droit romain."
                            },
                            {
                                "example_id": "217df8c1-0fff-4350-b58e-e6554e08d1bb",
                                "sense_id": "8d4e4884-9374-33f2-bcbe-8c228d48a696",
                                "text": "À partir de cette époque, le nom de prêtre lévitique commença d'être employé, pour désigner tous les prêtres iahvéistes purs."
                            }
                        ]
                    }
                ],
