                "translations": [
                    {
                        "translation_id": "c2639181-fb92-4250-9b99-bca1facdfd60",
                        "source_entry_id": "046488c2-d24a-3962-aa83-ffaff0fde2a1",
                        "source_sense_id": "261f1237-85e9-3e49-969f-622c3257e409",
                        "source_sense_description": "ruimte waar heelkundige bewerkingen uitgevoerd worden",
                        "target_lang_word": "Operationssaal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Operationssaal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d319f061-adfc-3573-b45a-7191c1466f69",
                                        "entry_id": "476b952c-ac23-3abb-a211-23d7a7191f43",
                                        "glosses": [
                                            "Raum in Krankenhäusern und Arztpraxen, der über die für Operationen nötige Ausstattung verfügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "864a26cd-0db6-4343-bc1f-a0f3c714e3c3",
                                                "sense_id": "d319f061-adfc-3573-b45a-7191c1466f69",
                                                "text": "In Operationssälen geht es häufig um Leben und Tod."
                                            },
                                            {
                                                "example_id": "2e5e0a8e-75bd-4d1a-9aa7-f4949c4263ea",
                                                "sense_id": "d319f061-adfc-3573-b45a-7191c1466f69",
                                                "text": "„Ich wartete im Krankenhaus darauf, daß meine Schwester aus dem Operationssaal kam.“"
                                            },
                                            {
                                                "example_id": "f36e4b61-f170-430d-b3f7-7dcba0c0dcde",
                                                "sense_id": "d319f061-adfc-3573-b45a-7191c1466f69",
                                                "text": "„Vielleicht betäubte man mich gerade mit Narkosemittel, um mich in den Operationssaal zu schieben und eine verheimlichte Blutung abzusaugen.“"
                                            },
                                            {
                                                "example_id": "47d40db7-3a93-4097-8242-38aba7f0cbaf",
                                                "sense_id": "d319f061-adfc-3573-b45a-7191c1466f69",
                                                "text": "„Zwei Wochen später stand Jules Segal im Operationssaal des Krankenhauses in Los Angeles und sah seinem Freund Doktor Frederick Kellner bei seinem Spezialeingriff zu.“"
                                            },
                                            {
                                                "example_id": "5c5427fb-429d-4d93-a2be-58e911059b7a",
                                                "sense_id": "d319f061-adfc-3573-b45a-7191c1466f69",
                                                "text": "„Wir dürften nicht vergessen, konnte Katinka sagen, dass wir nicht im Operationssaal arbeiteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
