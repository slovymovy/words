        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9cef02bb-3d28-3b6d-9870-9e79d9ea1e6a",
                    "sense_definition": "Of or pertaining to Arabs, their nations, or their culture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adj_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed the traditional <w>Arab</w> hospitality during our trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки мы наслаждались традиционным <w>арабским</w> гостеприимством.",
                                "zh": "我们在旅行期间享受了传统的<w>阿拉伯</w>式好客。"
                            }
                        },
                        {
                            "text": "The <w>Arab</w> countries met to discuss regional trade agreements.",
                            "target_lang_translations": {
                                "ru": "<w>Арабские</w> страны встретились для обсуждения региональных торговых соглашений.",
                                "zh": "<w>阿拉伯</w>国家举行会议，讨论区域贸易协定。"
                            }
                        }
                    ],
