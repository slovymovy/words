                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04829e33-d6be-4137-98b5-041b83d125f9",
                                "sense_id": "102c1acc-5d5a-35e8-bf24-4182cdd0468c",
                                "text": "Zażywanie tabaki uzależnia i może powodować choroby"
                            },
                            {
                                "example_id": "76d84097-f5d6-4ced-b3a6-20875af0470b",
                                "sense_id": "102c1acc-5d5a-35e8-bf24-4182cdd0468c",
                                "text": "Reverendissime — rzekł kichnąwszy Skołuba — To mi tabaka, co to idzie aż do czuba!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7e7fc4bf-dac7-35b2-b37d-013970ad4c34",
                        "entry_id": "a188487b-9f3a-3fe0-885b-1e3ecea1fc0d",
                        "glosses": [
                            "każdy tytoń – do palenia i do wciągania nosem; zob. też tabaka w Encyklopedii staropolskiej"
                        ],
