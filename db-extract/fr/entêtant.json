                "senses": [
                    {
                        "sense_id": "47520bd2-3c4c-3831-bc0a-76db12fd11c6",
                        "entry_id": "3224534f-1a76-36bd-9e57-2e4ad43bed0f",
                        "glosses": [
                            "Qui étourdit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc5590bf-db94-495b-92cc-5118dd78bd50",
                                "sense_id": "47520bd2-3c4c-3831-bc0a-76db12fd11c6",
                                "text": "La case en bois est plutôt cossue. Elle comprend deux étages. Le toit en bardeaux semble avoir perdu quelques écailles, mais la pénombre laisse entrevoir un jardin luxuriant, bien entretenu et agrémenté d’un petit bassin en son centre. Le parfum entêtant du jasmin de nuit envahit tout l’espace."
                            },
                            {
                                "example_id": "6b95919c-1fcd-4df4-8f8f-163ed4e554dc",
                                "sense_id": "47520bd2-3c4c-3831-bc0a-76db12fd11c6",
                                "text": "La femme rassemble ses esprits, proteste et se débat. Nadine sent son corps résister et cogner contre sa hanche, son parfum entêtant. Elle n'a pas de mal à la maîtriser parce que les mouvements de résistance de la femme sont désordonnés et manquent de force."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc32f991-59a4-3ccf-b3b0-9e116f3109ca",
                        "entry_id": "3224534f-1a76-36bd-9e57-2e4ad43bed0f",
                        "glosses": [
                            "Qui obsède."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75763c9e-b9f5-46a2-903d-8731d1f0300e",
                                "sense_id": "dc32f991-59a4-3ccf-b3b0-9e116f3109ca",
                                "text": "15 janvier 1941 – J’enfermerai Jean et tout ce qui a rapport à lui dans une chambre écartée et je boucherai bien toutes les fentes pour ne pas être incommodée par le relent entêtant des amours mort-nées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "371958c6-5d05-435e-a14f-f6633538ed60",
                        "source_entry_id": "3224534f-1a76-36bd-9e57-2e4ad43bed0f",
                        "source_sense_id": "47520bd2-3c4c-3831-bc0a-76db12fd11c6",
                        "target_lang_word": "heady",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heady",
