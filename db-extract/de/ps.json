                "senses": [
                    {
                        "sense_id": "38971c81-2e5d-332d-8cc2-f29c79508380",
                        "entry_id": "dabef239-0564-3b19-976d-9e819b2f29b2",
                        "glosses": [
                            "Pferdestärke (veraltete Einheit der Leistung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44cdee8b-f4a1-4fb6-b7c3-fcbf0b47d275",
                                "sense_id": "38971c81-2e5d-332d-8cc2-f29c79508380",
                                "text": "PS ist eine Charakterisierung der Leistungsstärke, die ein Motor hat."
                            },
                            {
                                "example_id": "c1a967b0-f1e5-46d5-817b-f65526957c68",
                                "sense_id": "38971c81-2e5d-332d-8cc2-f29c79508380",
                                "text": "„Und schließlich wird die Power von Automobilen nach wie vor in PS, also Pferdestärken, gemessen, auch wenn offiziell die Bezeichnung kw gültig ist.“"
                            },
                            {
                                "example_id": "5ee284c1-feff-479e-9d1a-c59ea9e6e30b",
                                "sense_id": "38971c81-2e5d-332d-8cc2-f29c79508380",
                                "text": "„Der 150 PS-Diesel-Motor ist ein guter Kompromiss aus Kraft, Verbrauch und Langlebigkeit und erlaubt DSG und Allrad.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "18754619-c54c-34ad-93ff-6c709000013d",
                        "entry_id": "dabef239-0564-3b19-976d-9e819b2f29b2",
                        "glosses": [
                            "Postskriptum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231d6d8d-ec70-420d-bc04-766fa135081d",
                                "sense_id": "18754619-c54c-34ad-93ff-6c709000013d",
                                "text": "Mit PS kennzeichnet man Nachträge zu einem bereits abgeschlossenen Text."
                            },
                            {
                                "example_id": "fa373482-03e7-4696-982f-8deca2202000",
                                "sense_id": "18754619-c54c-34ad-93ff-6c709000013d",
                                "text": "„Er bekam sie mit einem kleinen PS.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "16693345-a7b1-314f-8db9-4dbb3ffa0f12",
                        "entry_id": "dabef239-0564-3b19-976d-9e819b2f29b2",
                        "glosses": [
                            "für Polystyrol"
                        ],
                        "tags": [
                            "Kunststofftechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "4a0fa8f5-2a31-4bf5-b4ea-e7dff86516f4",
                                "sense_id": "16693345-a7b1-314f-8db9-4dbb3ffa0f12",
                                "text": "Polystyrol (PS) ist ein weit verbreiteter, thermoplastischer Massenkunststoff."
                            }
                        ],
                        "sense_index_json": "\"3\""
