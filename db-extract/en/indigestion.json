                                            {
                                                "example_id": "365e8290-ff44-4b59-a18d-7ccce187620e",
                                                "sense_id": "8416523a-7687-3bb8-a3b0-891d108eb5ca",
                                                "text": "Les bons Flamands n’ayant plus peur de mourir d’indigestion, ni de goutte, ni d’apoplexie, burent et mangèrent tout leur saoul."
                                            },
                                            {
                                                "example_id": "844e186b-fb6a-43b3-9bbd-8a22c243e60d",
                                                "sense_id": "8416523a-7687-3bb8-a3b0-891d108eb5ca",
                                                "text": "D’écœurement, de dégoût et d’indigestion, Tintin vomit tripes et boyaux et faillit en crever pendant la nuit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
