                                        "sense_id": "762d97fa-ba78-3b72-808f-f5cc7340b515",
                                        "entry_id": "6802cbe1-c6c2-31b4-a49a-0c198763a771",
                                        "glosses": [
                                            "With little or no success; indifferently; with little profit or advantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dad0b99-5ad5-4d74-9560-2662ea538d5e",
                                                "sense_id": "762d97fa-ba78-3b72-808f-f5cc7340b515",
                                                "text": "to do poorly in business"
                                            },
                                            {
                                                "example_id": "680686df-b0b6-43f2-92a7-aacd4f55afd7",
                                                "sense_id": "762d97fa-ba78-3b72-808f-f5cc7340b515",
                                                "text": "“The Budget proposes eliminating Supporting Effective Instruction (SEI) State Grants (Title II State grants), a program that provides formula funds to States to improve the quality and effectiveness of teachers, principals, and other schools leaders. SEI grants are poorly targeted and funds are spread too thinly to have a meaningful impact on student outcomes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23851272-9987-3aa1-b1b6-06d00145187e",
                                        "entry_id": "6802cbe1-c6c2-31b4-a49a-0c198763a771",
                                        "glosses": [
                                            "Meanly; without spirit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28b62883-ef1f-494d-886c-c6ef6b3819f9",
                                                "sense_id": "23851272-9987-3aa1-b1b6-06d00145187e",
                                                "text": "Nor is their courage or their wealth so low, / That from his wars they poorly would retire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077f8942-dc10-3479-83dc-b0c35be4bcd8",
                                        "entry_id": "6802cbe1-c6c2-31b4-a49a-0c198763a771",
                                        "glosses": [
                                            "Without skill or merit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ce9a799-7822-48f9-a893-88c8663c1935",
                                                "sense_id": "077f8942-dc10-3479-83dc-b0c35be4bcd8",
                                                "text": "He plays tennis poorly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2dbce81-bdb3-3c75-b3e5-7e9b92523466",
                                        "entry_id": "6802cbe1-c6c2-31b4-a49a-0c198763a771",
                                        "glosses": [
                                            "In a negative manner; with disapproval; unfavorably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f73bea6-2183-45ff-a768-69ad51103ef8",
                                                "sense_id": "e2dbce81-bdb3-3c75-b3e5-7e9b92523466",
                                                "text": "I think poorly of them."
                                            },
                                            {
                                                "example_id": "8f369367-8afd-467f-8713-be8d2405a958",
                                                "sense_id": "e2dbce81-bdb3-3c75-b3e5-7e9b92523466",
                                                "text": "She looked poorly on that suggestion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poorly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e113a0f-cb81-3b1c-a8b1-a81499759137",
                                        "entry_id": "82ada760-fd6f-33b8-858d-d9f561a0fc8d",
                                        "glosses": [
                                            "Ill, unwell, sick."
