                            "comment": "rare noun form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавное волнообразное движение или колыхание; волнообразность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колыхание",
                                "target_lang_sense_clarification": "волнообразное движение"
                            },
                            {
                                "target_lang_word": "волнообразность",
                                "target_lang_sense_clarification": "волнистая форма или движение"
                            }
                        ]
                    }
                }
            ]
