                "translations": [
                    {
                        "translation_id": "68b904aa-cf12-4d50-8505-51a1f92d66b6",
                        "source_entry_id": "46b4fe74-9457-36ca-aed5-ed3ba18f1625",
                        "target_lang_word": "taxe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7720105-4f6d-316e-bd76-afa380480b6a",
                                        "entry_id": "1b6739ef-8410-3085-a8f2-ec50c9e71f96",
                                        "glosses": [
                                            "Tarification officielle fixant le prix de certaines denrées ou de certains services."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b973db99-2dce-44a3-9f3d-cd5fdfcc51bc",
                                                "sense_id": "e7720105-4f6d-316e-bd76-afa380480b6a",
                                                "text": "Payer les denrées suivant la taxe."
                                            },
                                            {
                                                "example_id": "bb8f1b76-a3ad-4108-be30-8472b444e15c",
                                                "sense_id": "e7720105-4f6d-316e-bd76-afa380480b6a",
                                                "text": "La taxe du kilogramme de pain, de viande est de tant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0bb38c7-3f36-3984-81c4-f11603828d54",
                                        "entry_id": "1b6739ef-8410-3085-a8f2-ec50c9e71f96",
                                        "glosses": [
                                            "Prélèvement obligatoire perçu par une collectivité publique en échange d’un service ou d’une prestation donnant lieu à une contrepartie individualisable."
                                        ],
                                        "tags": [
                                            "Finances publiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8ccbdc0-77de-405a-b3a7-e45b791f9268",
                                                "sense_id": "c0bb38c7-3f36-3984-81c4-f11603828d54",
                                                "text": "Taxe postale."
                                            },
                                            {
                                                "example_id": "a4a85fea-894c-40bd-9b20-80c887515e46",
                                                "sense_id": "c0bb38c7-3f36-3984-81c4-f11603828d54",
                                                "text": "Taxe sur les postes de télévision."
                                            },
                                            {
                                                "example_id": "2fc3285b-2cba-4f5d-9cda-db93f3e809aa",
                                                "sense_id": "c0bb38c7-3f36-3984-81c4-f11603828d54",
                                                "text": "Une taxe spéciale de 20.000 francs à Paris […] est venue frapper toute nouvelle installation [de téléphone]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65a8f7f4-f508-32a2-ac18-af65724f8892",
                                        "entry_id": "1b6739ef-8410-3085-a8f2-ec50c9e71f96",
                                        "glosses": [
                                            "Synonyme courant d’impôt ou d’imposition, sans distinction technique."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83836d36-a7f0-44ad-b479-7d28081e5c84",
                                                "sense_id": "65a8f7f4-f508-32a2-ac18-af65724f8892",
                                                "text": "Devant l'affluence des pèlerins, le cours du zouz ou la taxe du change devait naturellement s'élever; il n'était pas difficile aux changeurs occupant la place de se liguer dans une sorte de trust à la hausse. La foule subissait leurs conditions exorbitantes."
                                            },
                                            {
                                                "example_id": "42f4a1da-a8ed-460b-99a8-1e6900e77060",
                                                "sense_id": "65a8f7f4-f508-32a2-ac18-af65724f8892",
                                                "text": "Il est à peine besoin de faire remarquer que, vu la quantité de taxes et redevances auxquelles on les assujettissait […], les juifs se trouvaient dans une situation matérielle précaire."
                                            },
                                            {
                                                "example_id": "3943899b-285c-46a4-8d13-0e51dadafa2d",
                                                "sense_id": "65a8f7f4-f508-32a2-ac18-af65724f8892",
                                                "text": "La taxe sera calculée en prenant cette charge complète comme unité, quels que soient le nombre et le cubage des wagons réellement employés pour le transport."
                                            },
                                            {
                                                "example_id": "c7546ae8-00cf-4c81-8677-f0e97287857d",
                                                "sense_id": "65a8f7f4-f508-32a2-ac18-af65724f8892",
                                                "text": "Les taxes impopulaires, abolies en juin 1908 en don de joyeux avènement, avaient été rétablies et considérablement renforcées."
                                            },
                                            {
                                                "example_id": "080e3d5f-0d97-41d5-b457-f80b67bfe8d5",
                                                "sense_id": "65a8f7f4-f508-32a2-ac18-af65724f8892",
                                                "text": "Un système complexe de taxes permettait au gouvernement, aux aristocrates et aux religieux de profiter du travail de la plus grande partie de la population."
                                            }
                                        ]
                                    }
                                ]
                            },
