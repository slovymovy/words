                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cec33e9a-295d-44a6-aedb-4f4d4ca5b316",
                        "source_entry_id": "673dd675-6247-3aa2-bcb6-9a4b0767cabe",
                        "source_sense_id": "2a369481-2aea-3997-8392-75bdcbc9b337",
                        "target_lang_word": "epidote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epidote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a321d32-e2c2-3ff7-ab6a-65969b087916",
                                        "entry_id": "cba6c955-34e0-38cc-850d-31e99058b22c",
                                        "glosses": [
                                            "Any of a class of mixed calcium iron aluminium sorosilicates found in metamorphic rocks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ebef8b0-44e5-4e0d-820c-113d9b2d9cf5",
                                                "sense_id": "5a321d32-e2c2-3ff7-ab6a-65969b087916",
                                                "text": "A little higher is an outcrop of epidote schist with quartz, carbonate, and magnetite."
                                            },
                                            {
                                                "example_id": "1be72f69-2add-4a6d-b70d-9e6123a04db4",
                                                "sense_id": "5a321d32-e2c2-3ff7-ab6a-65969b087916",
                                                "text": "1990, Andrew P. Barth, Chapter 3: Mid-crustal emplacement of Mesozoic plutons, San Gabriel Mountains, California, and implications for the geologic history of the San Gabriel terrane, J. Lawford Anderson (editor), The Nature and Origin of Cordilleran Magmatism, Memoir 174: The Nature and Origin of Cordilleran Magmatism, The Geological Society of America, page 36,\nAvailable compositional data for magmatic epidotes (Naney, 1983; Zen and Hammarstrom, 1984; Barth, unpublished data) suggest no significant solid solution beyond the epidote-clinozoisite binary."
                                            },
                                            {
                                                "example_id": "e89dbd5a-c769-4e5f-9f90-d77dc288b0ab",
                                                "sense_id": "5a321d32-e2c2-3ff7-ab6a-65969b087916",
                                                "text": "Epidote is found in greenstone belts and many metamorphic rocks such as gneiss and schist, and is hence fairly widespread."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
