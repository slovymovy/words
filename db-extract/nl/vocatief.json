                                        "entry_id": "9fd786cf-733a-3e5b-9938-fdc7b50292e9",
                                        "glosses": [
                                            "Something said to (or as though to) a particular person or thing; an entreaty, an invocation."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dd47fff-4d0d-459f-aeac-e9874773eb29",
                                                "sense_id": "fa90c27b-1887-3851-82b9-8f2fd720b825",
                                                "text": "[T]he two latter will hardly come neither, if they think it will be to hear your whining vocatives."
                                            }
