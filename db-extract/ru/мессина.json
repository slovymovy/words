                "senses": [
                    {
                        "sense_id": "121ad9ec-e12e-32f4-b7dc-fae359af5bdd",
                        "entry_id": "60c6f87e-bd26-34f2-8207-8c88d1452a9a",
                        "glosses": [
                            "город в итальянском регионе Сицилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7dee25-2092-4796-a4f9-49da7d5db5da",
                                "sense_id": "121ad9ec-e12e-32f4-b7dc-fae359af5bdd",
                                "text": "…Кометы грозной и хвостатой / Ужасный призрак в вышине, / Безжалостный конец Мессины / (Стихийных сил не превозмочь), / И неустанный рёв машины, / Кующей гибель день и ночь…"
                            }
                        ]
                    },
                    {
                        "sense_id": "d5a903f7-3760-34a6-b7ae-d235f4cc1329",
                        "entry_id": "60c6f87e-bd26-34f2-8207-8c88d1452a9a",
                        "glosses": [
                            "провинция в итальянском регионе Сицилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb407d3c-1f61-4da1-91ee-4e675db6383b",
                                "sense_id": "d5a903f7-3760-34a6-b7ae-d235f4cc1329",
                                "text": "Таормина, город в итальянской провинции Мессина (Сицилия), 4,5 тыс. жителей."
                            }
                        ]
                    },
