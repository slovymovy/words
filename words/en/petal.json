{
    "word_family": [
        "petaled",
        "petalled",
        "petalless",
        "petaloid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a76086e4-0613-3a0c-9bbf-812ff29b77d4",
                    "sense_definition": "One of the brightly colored, leaf-like parts that make up the corolla of a flower.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "flower_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind blew gently, causing a single rose <w>petal</w> to fall onto the grass.",
                            "target_lang_translations": {
                                "ru": "Подул легкий ветерок, и одиночный <w>лепесток</w> розы упал на траву."
                            }
                        },
                        {
                            "text": "She carefully picked each flower <w>petal</w> to press them inside her heavy book.",
                            "target_lang_translations": {
                                "ru": "Она аккуратно срывала каждый <w>лепесток</w> цветка, чтобы засушить их внутри своей тяжелой книги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flower petal",
                        "rose petal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из ярко окрашенных, похожих на листья элементов, составляющих венчик цветка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лепесток",
                                "target_lang_sense_clarification": "часть цветка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb137cb3-db3c-3fec-a698-7c151370f7d9",
                    "sense_definition": "A friendly term of endearment used to address someone, especially a child or a woman.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "endearments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't worry, <w>petal</w>, everything is going to be just fine.",
                            "target_lang_translations": {
                                "ru": "Не волнуйся, <w>крошка</w>, все будет хорошо."
                            }
                        },
                        {
                            "text": "The kind shopkeeper smiled and said, 'Here is your change, <w>petal</w>.'",
                            "target_lang_translations": {
                                "ru": "Добрый лавочник улыбнулся и сказал: «Вот ваша сдача, <w>милая</w>»."
                            }
                        }
                    ],
                    "common_phrases": [
                        "my petal"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British and Irish English"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Mainly UK and Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружеское, ласковое обращение к кому-либо, особенно к ребенку или женщине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крошка",
                                "target_lang_sense_clarification": "ласковое обращение"
                            },
                            {
                                "target_lang_word": "милая",
                                "target_lang_sense_clarification": "ласковое обращение к женщине или девочке"
                            },
                            {
                                "target_lang_word": "деточка",
                                "target_lang_sense_clarification": "ласковое обращение к ребенку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd402386-843c-30aa-8259-ebc928f0be24",
                    "sense_definition": "A lobe of a rose curve, which is a mathematical and geometric shape.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The polar equation produces a curve with eight distinct <w>petals</w>.",
                            "target_lang_translations": {
                                "ru": "Полярное уравнение дает кривую с восемью отчетливыми <w>лепестками</w>."
                            }
                        },
                        {
                            "text": "We had to calculate the area of a single <w>petal</w> of the rose curve.",
                            "target_lang_translations": {
                                "ru": "Нам нужно было вычислить площадь одного <w>лепестка</w> розы Гранди."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Петля розы Гвидо Гранди, которая является математической и геометрической фигурой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лепесток",
                                "target_lang_sense_clarification": "в геометрии, часть полярной розы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fccc5897-20cf-341b-84c6-28dd3581bad1",
                    "sense_definition": "The labia majora or lips of the vulva.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author used poetic language to describe the soft <w>petals</w> of her body.",
                            "target_lang_translations": {
                                "ru": "Автор использовал поэтический язык, чтобы описать нежные <w>лепестки</w> ее тела."
                            }
                        },
                        {
                            "text": "In erotic literature, the term <w>petals</w> is often used as a euphemism for intimate anatomy.",
                            "target_lang_translations": {
                                "ru": "В эротической литературе термин <w>лепестки</w> часто используется как эвфемизм для интимной анатомии."
                            }
                        }
                    ],
                    "synonyms": [
                        "lips",
                        "lower lips"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used euphemistically or anatomically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большие половые губы или складки вульвы (в поэтическом или эротическом контексте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лепестки",
                                "target_lang_sense_clarification": "поэтический эвфемизм в анатомии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25fc39b6-feab-3263-bc00-83ff95d73890",
                    "sense_definition": "To spread out or curve outwards from a central point, resembling the petals of a flower.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fountain water rose high, <w>petaling</w> the air with delicate silver droplets.",
                            "target_lang_translations": {
                                "ru": "Вода в фонтане поднималась высоко, <w>осыпая</w> воздух нежными серебряными каплями, похожими на лепестки."
                            }
                        },
                        {
                            "text": "She watched the soft curls of hair that <w>petaled</w> against her forehead.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на мягкие кудри, которые <w>рассыпались лепестками</w> по ее лбу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расходиться или изгибаться наружу от центральной точки, напоминая лепестки цветка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расходиться лепестками",
                                "target_lang_sense_clarification": "о форме или движении"
                            },
                            {
                                "target_lang_word": "раскрываться как лепестки",
                                "target_lang_sense_clarification": "о форме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}