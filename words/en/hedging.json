                    "frequency": "Low",
                    "semantic_group_id": "gardening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional <w>hedging</w> along the country lane requires skilled maintenance each autumn.",
                            "target_lang_translations": {
                                "nl": "De traditionele <w>heggenstructuur</w> langs het landweggetje vereist elk najaar vakkundig onderhoud."
                            }
                        },
                        {
                            "text": "Regular <w>hedging</w> keeps the perimeter dense and prevents farm animals from wandering.",
                            "target_lang_translations": {
                                "nl": "Regelmatig <w>heggen snoeien</w> houdt de omheining dicht en voorkomt dat boerderijdieren gaan dwalen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
