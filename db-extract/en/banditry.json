                                            "Crime organisé, criminalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99a8b52c-cef0-48d8-b1db-de790414cd7a",
                                                "sense_id": "947e734c-75b2-3feb-a402-4e7858a0aeed",
                                                "text": "Les actes de banditismes en pleine expansion à Dago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0936bcb-1d20-3d1d-8e77-ec17820dc75e",
                                        "entry_id": "032513ee-4a73-3a98-bf3b-c819e7ff741b",
                                        "glosses": [
                                            "Comportement habituel d'un groupe social, assimilable à celui d'un bandit, ensemble d'abus d'un groupe, contraires à l'éthique de la société à laquelle il appartient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20408bad-ac2e-4d7b-89eb-6a985e46d3ca",
                                                "sense_id": "e0936bcb-1d20-3d1d-8e77-ec17820dc75e",
                                                "text": "L'impunité du banditisme soi-disant politique est notre danger public. L'ordre est désarmé. Et ce malheur se joint à tous ceux d'une situation extrêmement difficile. Quatre cents voyous peuvent faire chavirer notre barque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8071833c-c31f-4208-87d3-3a6cf8533396",
                        "source_entry_id": "4f40d0ba-8f29-335b-8ed0-125ff13944de",
                        "source_sense_id": "d2b7d9b6-3247-3150-a919-81219aa6c67d",
                        "source_sense_description": "acts characteristic of a bandit",
                        "target_lang_word": "Banditentum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Banditentum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9abd4861-5e39-3b4a-b0c8-0b537845090a",
                                        "entry_id": "6c1cc4bd-0235-3da9-97d5-e783e7d87169",
                                        "glosses": [
                                            "Leben als Dieb, Räuber, Mörder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb11354d-91c1-462b-9d0d-3c58ad4253cc",
                                                "sense_id": "9abd4861-5e39-3b4a-b0c8-0b537845090a",
                                                "text": "„Als Geächteter versteckte er sich in den Wäldern bei Boulogne und führte ein Banditenleben im Kampf gegen den Grafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02ded982-8153-3ce1-b5e0-4c2f948ca78a",
                                        "entry_id": "6c1cc4bd-0235-3da9-97d5-e783e7d87169",
                                        "glosses": [
                                            "Gesamtheit der Personen, die [1] entsprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b7fd50-87b5-40b5-8871-7c75ec2b890f",
                                                "sense_id": "02ded982-8153-3ce1-b5e0-4c2f948ca78a",
                                                "text": "„Die Beamten machen ihren Job, zu ihren Aufgaben gehört es, ethnische und religiöse Konflikte zu schlichten, Banditentum zu verhindern und Steuern einzutreiben.“"
                                            },
                                            {
                                                "example_id": "d95087c7-e683-481c-a254-d77f5082cde1",
                                                "sense_id": "02ded982-8153-3ce1-b5e0-4c2f948ca78a",
                                                "text": "„So startete unter der Regierung Nawaz Sharif 1992 eine großangelegte militärische Operation (Operation Clean-up), um die Revierkämpfe in den urbanen Zentren des Sindh wie auch das um sich greifende Banditentum im ländlichen Raum zu beenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
