                        "glosses": [
                            "Action de renationaliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cc9bbcd-5633-465c-93c3-c7ab9782eb24",
                                "sense_id": "a6520bee-9376-3b13-b72a-180806d43193",
                                "text": "Il réclame une hausse des bas salaires et des retraites, ainsi que des impositions accrues sur les grosses fortunes  ; la promotion des énergies renouvelables  ; la renationalisation des chemins de fer."
                            },
                            {
                                "example_id": "985a0ad1-7a30-47ce-a6d9-a636a180e24c",
                                "sense_id": "a6520bee-9376-3b13-b72a-180806d43193",
                                "text": "Une fois les vols effectifs, cela marquera la reprise des vols réguliers (passagers) du transporteur, dont le processus de renationalisation est en cours."
                            }
                        ]
                    }
