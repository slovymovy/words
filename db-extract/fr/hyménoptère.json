                                    },
                                    {
                                        "sense_id": "91bc79e4-f59b-3274-9a23-07c1c7af9498",
                                        "entry_id": "7b1d1196-f673-31b9-8eb0-6d0d7016470a",
                                        "glosses": [
                                            "een orde Hymenoptera een grote orde van insecten die vertegenwoordigd wordt door ruim 150.000 verschillende soorten. De vliesvleugeligen danken hun naam aan de dunne en doorzichtige vleugels. Bekende vliesvleugeligen zijn mieren, wespachtigen, bijen en hommels"
                                        ],
                                        "tags": [
                                            "meervoudsvorm als officiële benaming",
                                            "insecten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77647a89-f4f6-4f15-b72b-467b63d09d3f",
                                                "sense_id": "91bc79e4-f59b-3274-9a23-07c1c7af9498",
                                                "text": "Van alle 150.000 soorten ‘vliesvleugeligen’ – de orde waartoe ook de bij en de mier behoren – bestaat zo'n 80 procent uit wespen."
                                            }
