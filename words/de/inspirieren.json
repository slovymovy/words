                    "sense_definition": "jemandem neue schöpferische Ideen vermitteln oder geistig bzw. künstlerisch anregen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kreativ_anregen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die malerische Landschaft an der Küste <w>inspiriert</w> viele Künstler zu neuen Gemälden."
                        },
                        {
                            "text": "Für ihren neuen Roman ließ sich die Autorin von einer historischen Begebenheit <w>inspirieren</w>."
                        }
                    ],
                    "synonyms": [
                        "anregen",
                        "beflügeln",
                        "animieren"
                    ],
                    "antonyms": [
                        "entmutigen",
                        "hemmen"
                    ],
                    "common_phrases": [
                        "sich inspirieren lassen",
                        "von der Natur inspiriert",
                        "zu neuen Ideen inspirieren"
                    ]
                },
                {
                    "sense_id": "fc81f786-ae47-3014-b9de-5b9718f58ddc",
                    "sense_definition": "jemanden dazu veranlassen oder motivieren, eine bestimmte Handlung durchzuführen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zu_etwas_veranlassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sein Vortrag über den Umweltschutz <w>inspirierte</w> viele Zuhörer dazu, ihren Lebensstil zu überdenken."
                        },
                        {
                            "text": "Die Erfolge ihrer Kollegin haben sie dazu <w>inspiriert</w>, sich ebenfalls weiterzubilden."
                        }
                    ],
                    "synonyms": [
                        "motivieren",
                        "anspornen",
                        "veranlassen"
                    ],
                    "antonyms": [
                        "abhalten",
                        "abschrecken"
                    ],
                    "common_phrases": [
