                                "example_id": "c0f0f508-d156-41ae-b262-ed0e258d856f",
                                "sense_id": "da377a94-92ae-33b3-9359-5bd604348f80",
                                "text": "Kaiser Karl III. erhielt den Beinamen »der Dicke«. Dieser Beiname ist nicht zeitgenössisch. Er wurde erstmals im 12. Jahrhundert verwendet.",
                                "translation": "Emperor Charles III received the byname »the Fat«. This byname is not contemporary. It was first used in the 12th century.",
                                "english": "Emperor Charles III received the byname »the Fat«. This byname is not contemporary. It was first used in the 12th century."
                            },
