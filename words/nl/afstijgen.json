{
    "word_family": [
        "stijgen",
        "opstijgen",
        "stijging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f3e7716-cb32-367b-bebc-d63f13d91b97",
                    "sense_definition": "Van een rijdier (zoals een paard) of een tweewieler (zoals een fiets) afkomen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "afstappen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fietser moest even <w>afstijgen</w> om de weg op de kaart te zoeken.",
                            "target_lang_translations": {
                                "en": "The cyclist had to <w>dismount</w> for a moment to look up the route on the map.",
                                "ru": "Велосипедисту пришлось на минутку <w>слезть</w>, чтобы найти дорогу на карте."
                            }
                        },
                        {
                            "text": "Na een lange rit besloot de ruiter van zijn paard <w>af</w> te <w>stijgen</w>.",
                            "target_lang_translations": {
                                "en": "After a long ride, the rider decided to <w>get off</w> his horse.",
                                "ru": "После долгой поездки всадник решил <w>спешиться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "afstappen"
                    ],
                    "antonyms": [
                        "opstappen",
                        "opstijgen"
                    ],
                    "common_phrases": [
                        "van het paard afstijgen",
                        "veilig afstijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "To get off a riding animal (such as a horse) or a two-wheeled vehicle (such as a bicycle).",
                        "ru": "Слезать или сходить с верхового животного (например, лошади) или двухколесного транспорта (например, велосипеда)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismount",
                                "target_lang_sense_clarification": "from a horse or bicycle"
                            },
                            {
                                "target_lang_word": "get off",
                                "target_lang_sense_clarification": "from a bicycle or horse"
                            },
                            {
                                "target_lang_word": "alight",
                                "target_lang_sense_clarification": "formal, from a horse"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спешиваться",
                                "target_lang_sense_clarification": "о всаднике"
                            },
                            {
                                "target_lang_word": "слезать",
                                "target_lang_sense_clarification": "с велосипеда или лошади"
                            },
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "с велосипеда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b69c28e2-18a8-3100-9dff-1b7e77d343c7",
                    "sense_definition": "Naar beneden bewegen of dalen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dalen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wandelaars zagen de mist langzaam uit de bergen <w>afstijgen</w>.",
                            "target_lang_translations": {
                                "en": "The hikers saw the mist slowly <w>descend</w> from the mountains.",
                                "ru": "Пешие туристы видели, как туман медленно <w>спускается</w> с гор."
                            }
                        },
                        {
                            "text": "We zagen de ballon langzaam naar de aarde <w>afstijgen</w>.",
                            "target_lang_translations": {
                                "en": "We saw the balloon slowly <w>descend</w> to the earth.",
                                "ru": "Мы видели, как воздушный шар медленно <w>опускается</w> к земле."
                            }
                        }
                    ],
                    "synonyms": [
                        "afdalen",
                        "neerdalen",
                        "omlaaggaan",
                        "zakken"
                    ],
                    "antonyms": [
                        "opstijgen",
                        "opklimmen"
                    ],
                    "common_phrases": [
                        "naar beneden afstijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move downwards or descend.",
                        "ru": "Двигаться вниз или опускаться."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "descend",
                                "target_lang_sense_clarification": "to move downwards"
                            },
                            {
                                "target_lang_word": "go down",
                                "target_lang_sense_clarification": "to move to a lower level"
                            },
                            {
                                "target_lang_word": "come down",
                                "target_lang_sense_clarification": "to move downwards towards the ground"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спускаться",
                                "target_lang_sense_clarification": "двигаться вниз"
                            },
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "о тумане, воздушном шаре"
                            },
                            {
                                "target_lang_word": "снижаться",
                                "target_lang_sense_clarification": "о высоте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}