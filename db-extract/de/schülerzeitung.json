                "senses": [
                    {
                        "sense_id": "2c27d705-506e-3865-972f-b027dae68f70",
                        "entry_id": "b8e70be9-bc46-35f4-a2a9-c3f86562f636",
                        "glosses": [
                            "Zeitung, die meist von Schülern gestaltet, geschrieben und herausgegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e29c00d5-3e70-4c49-b08a-13a898a9a59b",
                                "sense_id": "2c27d705-506e-3865-972f-b027dae68f70",
                                "text": "Nächste Woche wird die neue Schülerzeitung erscheinen."
                            },
                            {
                                "example_id": "5f3a4e33-5b22-494b-a551-bf7e1c626d8d",
                                "sense_id": "2c27d705-506e-3865-972f-b027dae68f70",
                                "text": "„Renates neuer Eumel war auch Redakteur bei einer Schülerzeitung, und er machte bei einer Verkehrszählung mit.“"
                            },
                            {
                                "example_id": "841bc5de-b805-4c60-8153-f617abe47f83",
                                "sense_id": "2c27d705-506e-3865-972f-b027dae68f70",
                                "text": "„Dennoch sprach es sich schnell herum, das ich für eine Art Zeitung gearbeitet hatte, und in meinem zweiten Jahr auf der Lisbon Highschool wurde ich Chefredakteur unserer Schülerzeitung ‚The Drum‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
