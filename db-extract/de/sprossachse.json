                "senses": [
                    {
                        "sense_id": "f934dfe2-8223-3fae-b1f6-311e5cab2e50",
                        "entry_id": "cb4e93a4-2bb7-3cbb-9d3d-881017bc9a7c",
                        "glosses": [
                            "Grundorgan einer Pflanze (genauer eines Kormophyten), das die Blätter mit den Wurzeln verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79a27430-2e55-4fe2-8653-2decb6fc6891",
                                "sense_id": "f934dfe2-8223-3fae-b1f6-311e5cab2e50",
                                "text": "Tracheiden sind zusammen mit den Tracheen die Wasser leitenden Elemente des Xylems im Leitbündel der Sprossachse von Pflanzen."
                            },
                            {
                                "example_id": "9d5de351-802f-4dae-95c8-8c314cbafc82",
                                "sense_id": "f934dfe2-8223-3fae-b1f6-311e5cab2e50",
                                "text": "Die grüne oder violett getönte Sprossachse hat an der Basis einen Durchmesser von bis zu 4 cm und einen drehrunden Querschnitt."
                            },
                            {
                                "example_id": "405e0e2e-1b7f-487f-a87f-ec378c97160c",
                                "sense_id": "f934dfe2-8223-3fae-b1f6-311e5cab2e50",
                                "text": "Die ledrigen, glänzenden Blätter können einfach, fiederteilig oder fiederspaltig sein; sie sind eiförmig, länglich, herz-, pfeil- oder breit speerförmig, ganzrandig oder gesägt und stehen wechselständig, an langen Sprossachsen oder in Rosetten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6041b38a-f6c8-499f-85e9-0fc1f7862987",
                        "source_entry_id": "cb4e93a4-2bb7-3cbb-9d3d-881017bc9a7c",
