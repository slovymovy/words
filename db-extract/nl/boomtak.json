                        "glosses": [
                            "Deel van een boom dat ontspringt uit de stam of andere takken en eindigt voor de twijgjes waaraan de bladeren zitten."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5630ab8d-a08d-4bdb-966b-515439eb8525",
                                "sense_id": "3cd51970-776b-31dd-8bb2-0bef29d697b1",
                                "text": "Groeit een slingerplant om een boomtak, dan kan die tak zo sterk worden ingesnoerd dat hij zelf een spiraalvorm krijgt."
                            },
                            {
                                "example_id": "2026dc8d-77fa-4232-8a93-24195220b9db",
                                "sense_id": "3cd51970-776b-31dd-8bb2-0bef29d697b1",
                                "text": "Bij aankomst verkende ik meteen de tuin, die op een scène uit The Hobbit leek. Eindeloos veel tentjes stonden verdekt opgesteld onder de laaghangende boomtakken."
                            }
                        ]
