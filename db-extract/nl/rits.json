                    {
                        "sense_id": "f2e5fca5-397f-307a-9449-a7821e673b4c",
                        "entry_id": "c8197ee9-b3d9-3525-bf84-f08933d90a82",
                        "glosses": [
                            "zandrug, schelpenrug; hoger en droger gedeelte in een drasland"
                        ],
