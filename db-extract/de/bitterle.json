                ],
                "senses": [
                    {
                        "sense_id": "973a5f0c-80b1-3140-a628-065fb4e255fb",
                        "entry_id": "178e9d02-6144-3a23-9f99-008836628978",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6843b1dc-8275-4934-b87c-f400eb3b87ed",
                                "sense_id": "973a5f0c-80b1-3140-a628-065fb4e255fb",
                                "text": "Frau Bitterle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c969b76a-caef-4d10-a5bf-b7e14b74c4f1",
                                "sense_id": "973a5f0c-80b1-3140-a628-065fb4e255fb",
                                "text": "Herr Bitterle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "09f1bf1e-b801-4f35-9c61-4ce792223b2e",
                                "sense_id": "973a5f0c-80b1-3140-a628-065fb4e255fb",
                                "text": "Die Bitterles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "13517b3d-92fe-4916-8515-e8f078730804",
                                "sense_id": "973a5f0c-80b1-3140-a628-065fb4e255fb",
                                "text": "Der Bitterle trägt nie die Schals, die die Bitterle ihm strickt."
                            },
                            {
                                "example_id": "fa7a1bd6-4bae-4e7c-8093-7d8ad5dca8d0",
                                "sense_id": "973a5f0c-80b1-3140-a628-065fb4e255fb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bitterle kommt, geht der Herr Bitterle.“"
                            },
                            {
                                "example_id": "ef8faa9a-984a-4a64-9ee1-c825cc2f8ef6",
                                "sense_id": "973a5f0c-80b1-3140-a628-065fb4e255fb",
                                "text": "Bitterle kommt und geht."
                            },
                            {
                                "example_id": "fb49ddcd-6467-47c0-b12b-ff2085744637",
                                "sense_id": "973a5f0c-80b1-3140-a628-065fb4e255fb",
                                "text": "Bitterles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
