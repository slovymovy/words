                "senses": [
                    {
                        "sense_id": "b8cd72a0-2586-3401-a269-a159d4464c76",
                        "entry_id": "55bacd7f-7a17-3a20-98cd-2f985bc7ddfd",
                        "glosses": [
                            "полит. являющийся сторонником Запада, ориентирующийся на них, связанный с поддержкой их интересов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8694de6-443d-43f5-abfd-3184de5cac78",
                                "sense_id": "b8cd72a0-2586-3401-a269-a159d4464c76",
                                "text": "Порошенко проявлял осторожность, но он по сути своей прозападный политик, и европейский выбор для него не риторика, а способ самореализации."
                            }
                        ]
                    }
