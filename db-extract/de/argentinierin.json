                                "target_senses": [
                                    {
                                        "sense_id": "e67d998c-58a5-3273-b1e1-1420974e279f",
                                        "entry_id": "fb343a1c-7bae-3fc2-98b7-0c6f4d849419",
                                        "glosses": [
                                            "A person from Argentina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22b40fcb-e20f-4874-b7a4-bccd34897e28",
                                                "sense_id": "e67d998c-58a5-3273-b1e1-1420974e279f",
                                                "text": "Indeed, the Process Statute promised that which most Argentineans sought—a just and responsible government."
                                            },
                                            {
                                                "example_id": "1d4a1901-f38e-4ad3-b57d-695bb26383ad",
                                                "sense_id": "e67d998c-58a5-3273-b1e1-1420974e279f",
                                                "text": "She was my new doctor, a bespectacled Argentinean whose concern for me brimmed visibly in her eyes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b13bc6b5-bcdd-47d5-ba8c-8bda55833d18",
                        "source_entry_id": "9731707e-0759-3003-9b6d-994952cb36b3",
                        "source_sense_id": "307ea06d-c7b7-307d-8f8a-133585977604",
