                    {
                        "translation_id": "3f432b54-3d1f-4c38-bac2-5caa9901097d",
                        "source_entry_id": "d8c32901-d66d-324c-ab13-c3c37b4b7586",
                        "source_sense_description": "to force into military service",
                        "target_lang_word": "zwangsrekrutieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwangsrekrutieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d4ea1ff-0df9-35a6-be5e-9eafd25f0dbc",
                                        "entry_id": "fcd49baf-3e52-39d6-b1e5-4d18b3c3bf39",
                                        "glosses": [
                                            "zwangsweise rekrutieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abcb64be-4eb0-4317-aa41-2b0a1d7f2f9d",
                                                "sense_id": "2d4ea1ff-0df9-35a6-be5e-9eafd25f0dbc",
                                                "text": "„Weiße Todespatrouillen herrschten mittels Standgericht, Arbeitskräfte wurden zwangsrekrutiert, und wer protestierte, wurde auf der Stelle erschossen.“"
                                            },
                                            {
                                                "example_id": "00ea9e49-37cf-4d90-9a8e-e4474ec48708",
                                                "sense_id": "2d4ea1ff-0df9-35a6-be5e-9eafd25f0dbc",
                                                "text": "„Ihr Auftritt wird von einem Applaus begleitet, den man nur als lustlos bezeichnen kann, als hätte man das Publikum zwangsrekrutiert.“"
                                            },
                                            {
                                                "example_id": "90ef70a3-7aa8-4b96-ad92-fb90c0a93dec",
                                                "sense_id": "2d4ea1ff-0df9-35a6-be5e-9eafd25f0dbc",
                                                "text": "„›Du wurdest doch zwangsrekrutiert, oder?‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58222d6a-960a-4552-bdda-29417a24fc78",
                        "source_entry_id": "d8c32901-d66d-324c-ab13-c3c37b4b7586",
                        "source_sense_description": "to coerce (somebody) into doing something that they are reluctant to do",
                        "target_lang_word": "zwingen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwingen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2aea1f25-38df-30a9-bb45-6dba106c3218",
                                        "entry_id": "d69561da-eded-3ac9-a629-c024c380c4ff",
                                        "glosses": [
                                            "mit Druck/Gewalt zu etwas bringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1c7e257-ecd1-4a9b-95b8-c9bda4e00edd",
                                                "sense_id": "2aea1f25-38df-30a9-bb45-6dba106c3218",
                                                "text": "Die Wachen zwangen die Erschöpften, weiterzugehen."
                                            },
                                            {
                                                "example_id": "7289a11e-689b-4cc7-9bd2-9118f2255b10",
                                                "sense_id": "2aea1f25-38df-30a9-bb45-6dba106c3218",
                                                "text": "„Eine Attacke der Höhenkrankheit hat den Bergsteiger ereilt und zwingt ihn, sein Vorhaben aufzugeben.“"
                                            },
                                            {
                                                "example_id": "0204f6ec-daf2-4cb1-be2a-c440b3ed1cdc",
                                                "sense_id": "2aea1f25-38df-30a9-bb45-6dba106c3218",
                                                "text": "„Doch dann zwingen Angriffe der Wikinger die Hüter der Gebeine erneut zur Flucht.“"
                                            },
                                            {
                                                "example_id": "ca326bbd-e863-40e8-bcce-74380c65dc07",
                                                "sense_id": "2aea1f25-38df-30a9-bb45-6dba106c3218",
                                                "text": "Das erzwungene Geständnis der zur Unterschrift gezwungenen Geisel ist vor Gericht nichts wert."
                                            },
                                            {
                                                "example_id": "bcffed5a-5230-409b-a5ee-bfdb82a0d6d8",
                                                "sense_id": "2aea1f25-38df-30a9-bb45-6dba106c3218",
                                                "text": "Grundgesetz für die Bundesrepublik Deutschland, Art 4 (3): „Niemand darf gegen sein Gewissen zum Kriegsdienst mit der Waffe gezwungen werden.“"
                                            },
                                            {
                                                "example_id": "7b80b154-5bcc-465d-ab77-44ee4c93489d",
                                                "sense_id": "2aea1f25-38df-30a9-bb45-6dba106c3218",
                                                "text": "[Jesu Kreuzigung und Tod:] „Und als sie hinausgingen, fanden sie einen Menschen aus Kyrene mit Namen Simon; den zwangen sie, dass er ihm sein Kreuz trug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8098a419-8a20-36be-b262-f96751791d89",
                                        "entry_id": "d69561da-eded-3ac9-a629-c024c380c4ff",
                                        "glosses": [
                                            "etwas meistern, über etwas Herr werden"
                                        ],
                                        "tags": [
                                            "South-German",
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0be1ae89-a13a-45e0-9759-7aeee85d2c07",
                                                "sense_id": "8098a419-8a20-36be-b262-f96751791d89",
                                                "text": "Den zwinge ich ja mit dem kleinen Finger!"
                                            },
                                            {
                                                "example_id": "cebb555b-80bf-456b-bed0-41f6bc2c50d1",
                                                "sense_id": "8098a419-8a20-36be-b262-f96751791d89",
                                                "text": "Das Schnitzel ist zu groß, ich zwinge es einfach nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
