                    {
                        "sense_id": "5e60e633-f6e7-335a-87f3-dc84a07dafb1",
                        "entry_id": "8f59d9cc-1cab-3edf-8d34-e05632e34847",
                        "glosses": [
                            "aus Lamm und Reis bestehendes arabisches Gericht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa7491e-2fa6-4374-8859-289eb3705b52",
                                "sense_id": "5e60e633-f6e7-335a-87f3-dc84a07dafb1",
                                "text": "„Es war die einzige Gelegenheit, mit ihm Zeit zu verbringen. Sogar das ruinierte er manchmal, indem er Midhat mit nach Hause brachte, aber auch dann servierte Asmahan ihnen gefällig ihr Makluba, Musakhan oder Mansaf.“"
                            },
                            {
                                "example_id": "75975c8c-4057-45b2-b0f4-9de148b08891",
                                "sense_id": "5e60e633-f6e7-335a-87f3-dc84a07dafb1",
                                "text": "„Du hast es schon bei uns gegessen, obwohl es nicht auf der Speisekarte steht, denn Mansaf ist ein Gericht, das man serviert, wenn man Streithähne miteinander versöhnen oder jemandes Herz gewinnen will, Freunden eine Freude machen oder jemanden trösten möchte, der Trost braucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
