                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fcb57ee-d1b9-448a-8404-759217121342",
                                "sense_id": "04401cd5-3918-35d5-8f24-5749fd561268",
                                "text": "Hij moest een poos wachten voordat de bus aankwam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b8ad402-189f-4936-9acf-5f90593421ef",
                        "source_entry_id": "9cf7e643-276a-3590-9367-00c50279f722",
                        "source_sense_id": "04401cd5-3918-35d5-8f24-5749fd561268",
                        "source_sense_description": "tijdsinterval",
                        "target_lang_word": "while",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "while",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c40c9c8-ea99-3fad-a20e-7d1a844421ed",
                                        "entry_id": "18a799f5-06bf-32d1-83d2-087c64cd464d",
                                        "glosses": [
                                            "An uncertain duration of time, a period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13257f46-8914-4d6e-8124-25403d1b6cdf",
                                                "sense_id": "0c40c9c8-ea99-3fad-a20e-7d1a844421ed",
                                                "text": "He lectured for quite a long while."
                                            },
                                            {
                                                "example_id": "44742578-4437-47c8-8888-afe42e4c9e77",
                                                "sense_id": "0c40c9c8-ea99-3fad-a20e-7d1a844421ed",
                                                "text": "It’s a long while since anyone lived there, so it’s a ruin now."
                                            },
                                            {
                                                "example_id": "5064c79b-46aa-42ca-aeab-0757902a214c",
                                                "sense_id": "0c40c9c8-ea99-3fad-a20e-7d1a844421ed",
                                                "text": "Do the good that's nearest Though it's dull at whiles."
                                            },
                                            {
                                                "example_id": "ef6ac745-331c-4efe-a013-13a7396379ac",
                                                "sense_id": "0c40c9c8-ea99-3fad-a20e-7d1a844421ed",
                                                "text": "There are whiles […] when ye are altogether too canny and Whiggish to be company for a gentleman like me."
                                            },
                                            {
                                                "example_id": "857f3c69-c157-48c5-9992-12d217ad5c63",
                                                "sense_id": "0c40c9c8-ea99-3fad-a20e-7d1a844421ed",
                                                "text": "Things were pretty dark for a while — several whiles, actually."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f79b137-0344-3535-a0e7-0288787cb0b8",
                                        "entry_id": "18a799f5-06bf-32d1-83d2-087c64cd464d",
                                        "glosses": [
                                            "An uncertain duration of time, a period of time.",
                                            "An uncertain long period of time"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a260d7b-4e89-37f6-bf75-9d3fc7e74bfb",
                                        "entry_id": "18a799f5-06bf-32d1-83d2-087c64cd464d",
                                        "glosses": [
                                            "An uncertain duration of time, a period of time.",
                                            "an uncertain short moment"
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "while",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58cdde8b-bd15-3ff8-99c8-981c7525fae5",
                                        "entry_id": "9906f492-6316-37b9-bdb4-f1441d7eadaf",
                                        "glosses": [
                                            "During the same time that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d7a5a1e-b834-4528-976d-6e319adeea7b",
                                                "sense_id": "58cdde8b-bd15-3ff8-99c8-981c7525fae5",
                                                "text": "He was sleeping while I was singing."
                                            },
                                            {
                                                "example_id": "632ca284-ac91-42bd-be17-fc6c9bfbee5c",
                                                "sense_id": "58cdde8b-bd15-3ff8-99c8-981c7525fae5",
                                                "text": "Driving while intoxicated is against the law."
                                            },
                                            {
                                                "example_id": "2b19186a-a3f9-4e7f-98ea-72a2f12c687a",
                                                "sense_id": "58cdde8b-bd15-3ff8-99c8-981c7525fae5",
                                                "text": "I lived in Ávila for two lustra while I was a child."
                                            },
                                            {
                                                "example_id": "2fc62c08-b94a-4d40-8c81-7c432f62b525",
                                                "sense_id": "58cdde8b-bd15-3ff8-99c8-981c7525fae5",
                                                "text": "While the powwow was going on the big woman came back again. She was consider'ble rumpled and scratched up, but there was fire in her eye."
                                            },
                                            {
                                                "example_id": "72dfdc10-edb4-4e4b-adb0-ef7ea374ca6a",
                                                "sense_id": "58cdde8b-bd15-3ff8-99c8-981c7525fae5",
                                                "text": "While De Anza was exploring the Bay of San Francisco, seeking a site for the presidio, the American colonists on the eastern seaboard, three thousand miles away, were celebrating the signing of the Declaration of Independence."
                                            },
                                            {
                                                "example_id": "4bf17df5-5092-4808-88aa-bff87b2f3131",
                                                "sense_id": "58cdde8b-bd15-3ff8-99c8-981c7525fae5",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            },
                                            {
                                                "example_id": "23501379-3b78-4341-b134-a4efb1fd21c3",
                                                "sense_id": "58cdde8b-bd15-3ff8-99c8-981c7525fae5",
                                                "text": "Ms. Syed, along with many of her American Muslim friends and Islamic-rights advocates, is all too familiar with what many refer to as the stigma of traveling while Muslim."
                                            },
                                            {
                                                "example_id": "062ea59d-2e7e-41ec-9e70-46979b076fe0",
                                                "sense_id": "58cdde8b-bd15-3ff8-99c8-981c7525fae5",
                                                "text": "He added that the case took an emotional toll and left him humiliated by the accusations when, in fact, all he had been doing was \"gardening while black\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95e1eb13-9524-31b1-b961-8788031969e3",
                                        "entry_id": "9906f492-6316-37b9-bdb4-f1441d7eadaf",
                                        "glosses": [
                                            "Although."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e71519e6-bb9a-4345-b026-b811f69fcadf",
                                                "sense_id": "95e1eb13-9524-31b1-b961-8788031969e3",
                                                "text": "This case, while interesting, is a bit frustrating."
                                            },
                                            {
                                                "example_id": "d7730b74-4bc0-4ecc-97c5-3fe31be6d1a2",
                                                "sense_id": "95e1eb13-9524-31b1-b961-8788031969e3",
                                                "text": "While I would love to help, I am very busy at the moment."
                                            },
                                            {
                                                "example_id": "e70bb010-99ef-4516-8ab9-81955ae6d659",
                                                "sense_id": "95e1eb13-9524-31b1-b961-8788031969e3",
                                                "text": "While Britain’s recession has been deep and unforgiving, in London it has been relatively shallow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "510e1d46-8351-39e7-98a3-b88bebe36232",
                                        "entry_id": "9906f492-6316-37b9-bdb4-f1441d7eadaf",
                                        "glosses": [
                                            "Until."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74e8dbb0-5956-40b2-8f77-fbc90c750fa4",
                                                "sense_id": "510e1d46-8351-39e7-98a3-b88bebe36232",
                                                "text": "I'll wait while you've finished painting."
                                            },
                                            {
                                                "example_id": "8e83248a-5872-4061-886e-d49a8468a572",
                                                "sense_id": "510e1d46-8351-39e7-98a3-b88bebe36232",
                                                "text": "To dark is still used in Swaledale (Yorkshire) in the sense of to lie hid, as, 'Te rattens [rats] mun ha bin darkin whel nu [till now]; we hannot heerd tem tis last fortnith'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cb34293-d093-37ef-8b48-7aa7b0047650",
                                        "entry_id": "9906f492-6316-37b9-bdb4-f1441d7eadaf",
                                        "glosses": [
                                            "As long as."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e4461a0-6e14-41a1-994d-1fcaaaf69a87",
                                                "sense_id": "5cb34293-d093-37ef-8b48-7aa7b0047650",
                                                "text": "While you're at school you may live at home."
                                            },
                                            {
                                                "example_id": "a3e51f12-4e88-4461-905c-bf84074b84c6",
                                                "sense_id": "5cb34293-d093-37ef-8b48-7aa7b0047650",
                                                "text": "While there's quiet I can sleep."
                                            },
                                            {
                                                "example_id": "2d0a71c5-de07-4334-be8d-0192f864b486",
                                                "sense_id": "5cb34293-d093-37ef-8b48-7aa7b0047650",
                                                "text": "Use your memory; you will sensibly experience a gradual improvement, while you take care not to load it to excess."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "while",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb957ef8-2d65-3923-ad51-efd4edfcae2b",
                                        "entry_id": "c2c7081d-f662-3ff5-b9bd-3825ec7ea2b8",
                                        "glosses": [
                                            "Until."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7cdb06e-f811-4704-8a45-340bb07332e1",
                                                "sense_id": "bb957ef8-2d65-3923-ad51-efd4edfcae2b",
                                                "text": "I may be conveyed into your chamber; I'll lie under your bed while midnight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "while",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e0268ea-f77d-3e83-9d83-f20232ca3551",
                                        "entry_id": "98901367-65fd-316d-b5ad-f4c0e60debdf",
                                        "glosses": [
                                            "To pass (time) idly."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cdb885f-9024-4753-bb1b-c5963a215d3d",
                                                "sense_id": "0e0268ea-f77d-3e83-9d83-f20232ca3551",
                                                "text": "I whiled away the hours whilst waiting for him to arrive"
                                            },
                                            {
                                                "example_id": "9a1210ed-d0f2-48d7-a826-d5e4700aa8e3",
                                                "sense_id": "0e0268ea-f77d-3e83-9d83-f20232ca3551",
                                                "text": "Some were whiling the time by admiring the figures on the cloth of tissue."
                                            },
                                            {
                                                "example_id": "d893c315-9dc7-462c-b9dc-91431a85086b",
                                                "sense_id": "0e0268ea-f77d-3e83-9d83-f20232ca3551",
                                                "text": "Here in seclusion, as a widow may, / The lovely lady whiled the hours away, […]"
                                            },
                                            {
                                                "example_id": "293c527c-cf5a-4f55-b567-557c859ce8ff",
                                                "sense_id": "0e0268ea-f77d-3e83-9d83-f20232ca3551",
                                                "text": "As if she was just whiling her time with them until his arrival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c82b8526-c83a-39a8-aacb-da6eeff60f95",
                                        "entry_id": "98901367-65fd-316d-b5ad-f4c0e60debdf",
                                        "glosses": [
                                            "To occupy or entertain (someone) in order to let time pass."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "581ca6d0-9d85-4771-8c61-71a37fdb7cdb",
                                                "sense_id": "c82b8526-c83a-39a8-aacb-da6eeff60f95",
                                                "text": "They whiled them with such answere as suted to their purposes, and long adoe was made in weaving and unweaving Penelopes web, till the Spanish Armada was upon the Coast, and the very Ordnance proclaimed in their eares a surcease from further illusions."
                                            },
                                            {
                                                "example_id": "4633c687-6d90-412f-93c1-b01041e5dda5",
                                                "sense_id": "c82b8526-c83a-39a8-aacb-da6eeff60f95",
                                                "text": "He sat her on the corner of the carpenter's bench, and parried or diverted her questions about her father, and the desirability of wakening him by handing her the long curled shavings; and when these palled, he whiled her on by the impossible task of teaching him her version of the 'Three Golden Balls' a blank-verse poem, but rhythmically intoned, which he had taught her."
                                            },
                                            {
                                                "example_id": "39e9f7b2-05e0-40eb-bf9c-0ec1a6187e3c",
                                                "sense_id": "c82b8526-c83a-39a8-aacb-da6eeff60f95",
                                                "text": "In other worlds I whiled me now Through many a dark night long."
                                            },
                                            {
                                                "example_id": "4468e1d4-866d-4ab7-af80-1fd0e03690ec",
                                                "sense_id": "c82b8526-c83a-39a8-aacb-da6eeff60f95",
                                                "text": "Like a good father, he whiled him with stories about the past of his nation and discussed in detail the intricacies of his profession, teaching the child secrets of the craft that had been passed from generation to generation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db2a3790-0362-3e7a-bafe-10470223239d",
                                        "entry_id": "98901367-65fd-316d-b5ad-f4c0e60debdf",
                                        "glosses": [
                                            "To elapse, to pass."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d1a0cc1-2ad7-4a89-9724-ec7f34255d02",
                                                "sense_id": "db2a3790-0362-3e7a-bafe-10470223239d",
                                                "text": "The tedious hours whiled slowly on, 'till the succeeding afternoon, when the expected carriage made its appearance much sooner than they had promised themselves."
                                            },
                                            {
                                                "example_id": "65957331-3792-4c10-b73f-305e29aa433d",
                                                "sense_id": "db2a3790-0362-3e7a-bafe-10470223239d",
                                                "text": "Years whiled. He aged, sank, sickened; and was not: / And it was said, 'A man intractable / And curst is gone.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "while",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10943c06-d416-3550-b202-b24732c336e7",
                                        "entry_id": "4b4d4a75-4db5-3839-9d97-d19a7e35bea4",
                                        "glosses": [
                                            "Alternative spelling or misspelling of wile."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "misspelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92889c8e-e3cc-4355-b5e3-2437ad59e1c9",
                                                "sense_id": "10943c06-d416-3550-b202-b24732c336e7",
                                                "text": "There it lies before me sparkling in the sun, whiling me as it often does from my pen or book to gaze upon its loveliness."
                                            },
                                            {
                                                "example_id": "2b3681e8-dfdc-4b6b-b21a-0ece408d2845",
                                                "sense_id": "10943c06-d416-3550-b202-b24732c336e7",
                                                "text": "Perhaps the coziness of his seat, and the absence of the sun's rays from the side of the house where he was seated, had some agency in whiling him into a delicious sleep;"
                                            },
                                            {
                                                "example_id": "184f1671-4390-4980-994a-e951cf912b93",
                                                "sense_id": "10943c06-d416-3550-b202-b24732c336e7",
                                                "text": "Upon the shelf before me stands, The Book that lured to distant Lands, That prompt my boyish wish to roam, And whiled me from my childhood's home."
                                            },
                                            {
                                                "example_id": "fa1623e1-78e1-423e-85e0-b6c92f082782",
                                                "sense_id": "10943c06-d416-3550-b202-b24732c336e7",
                                                "text": "“Do not let us go near them,\" he says in a cajoling, low voice to Bertha, whiling her away into the sun and the flowers;"
                                            },
                                            {
                                                "example_id": "eb469a13-b2bd-43dc-bd54-d3be1b36391d",
                                                "sense_id": "10943c06-d416-3550-b202-b24732c336e7",
                                                "text": "He whiled him on to speak farther; but the same cloud was still upon Sir Henry Dacre's mind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
