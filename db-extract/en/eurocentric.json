                        "entry_id": "4569acb2-0f3f-3aeb-b195-9d22086a83b6",
                        "glosses": [
                            "Focused on Europe or the people and culture of Europe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a836782d-08bb-4408-8c78-a78a01ac2375",
                                "sense_id": "0ad6a43e-66d2-3bc2-870c-66922382092a",
                                "text": "The present curriculum / I put my fist in 'em / Eurocentric every last one of 'em / See right through the red, white, and blue disguise / With lecture I puncture the structure of lies / Installed in our minds and attempting to hold us back / We've got to take it back / Holes in our spirit causin' tears and fears / One-sided stories for years and years and years"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
