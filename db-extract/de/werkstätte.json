                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cbce664-2c51-420b-89f7-b94106e531d7",
                                "sense_id": "e13d7b06-d4cf-3514-b4b2-2e61275ac45d",
                                "text": "In unserer Werkstätte werden Schraubendreher aller Größen hergestellt."
                            },
                            {
                                "example_id": "b2f31d6c-54e4-4bcb-95fd-ba5b44aff519",
                                "sense_id": "e13d7b06-d4cf-3514-b4b2-2e61275ac45d",
                                "text": "„Die St. Pöltner Wirtschaftsdelegation mit Siemens, Sunpor, Geschützter Werkstätte, ÖBB, sowie der Fachhochschule und der Handelsakademie St. Pölten nutzten die Präsentation zu intensiven Gesprächen mit Interessenten.“"
                            }
