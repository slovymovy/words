        "fr-extract.jsonl": [
            {
                "entry_id": "02ed287d-5cfe-38e4-b7dc-fa1ea49b6e77",
                "word": "déplaisir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7a62aadd-6aa9-40e9-a0ff-e6966e981ce1",
                        "entry_id": "02ed287d-5cfe-38e4-b7dc-fa1ea49b6e77",
                        "tags": [
                            "plural"
                        ],
                        "form": "déplaisirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                        "entry_id": "02ed287d-5cfe-38e4-b7dc-fa1ea49b6e77",
                        "glosses": [
                            "Sentiment pénible que cause quelqu’un ou quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7f8ce59-0439-4663-b7a3-0dd8216a30bc",
                                "sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                                "text": "Si je pensais que le souverain bien fût la joie, je ne douterais point qu'on ne dût tâcher de se rendre joyeux, à quelque prix que ce pût être, et j'approuverais la brutalité de ceux qui noient leurs déplaisirs dans le vin, ou les étourdissent avec du pétun."
                            },
                            {
                                "example_id": "48cb6763-da94-46c2-888b-e4fe38cc3bf1",
                                "sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                                "text": "Don Louis -- Je ne me souviens plus déjà de tous les déplaisirs que vous m'avez donnés, et tout est effacé par les paroles que vous venez de me faire entendre."
                            },
                            {
                                "example_id": "f5c21168-2365-4f6f-8872-5f7c20121ba6",
                                "sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                                "text": "Son déplaisir se manifestait par des phrases entrecoupées, en partie murmurées entre ses dents, en partie adressées aux domestiques qui se tenaient autour de lui, …."
                            },
                            {
                                "example_id": "969690a8-7ba3-444d-9f2f-a4ecb1a373b1",
                                "sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                                "text": "Montès prit la bête farouche par la queue, et lui fit faire trois ou quatre tours de valse à son grand déplaisir et aux applaudissements frénétiques du peuple entier, ce qui donna le temps de relever le picador."
                            },
                            {
                                "example_id": "43ef4d87-2004-48cf-a70a-b606eae7c1ce",
                                "sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                                "text": "Comme le temps passait, je l’aperçus assise, les yeux vagues, triste comme elle savait l’être au moindre déplaisir."
                            },
                            {
                                "example_id": "dd87182b-25d8-4907-89fe-b8fdac830fe0",
                                "sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                                "text": "Des politiciens floridiens ont aussi exprimé leur déplaisir de voir l'État devenir une destination touristique antivirale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82311cad-b2db-4aad-bfce-0dfd18a6fd26",
                        "source_entry_id": "02ed287d-5cfe-38e4-b7dc-fa1ea49b6e77",
                        "source_sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                        "target_lang_word": "displeasure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "displeasure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "172e59eb-148a-3a2a-be35-dbc3d55667c3",
                                        "entry_id": "7d328fea-98d5-3901-8689-1549a071c4ad",
                                        "glosses": [
                                            "A feeling of being displeased with something or someone; dissatisfaction; disapproval."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71ba0633-bb00-4989-960e-833543fc1a69",
                                                "sense_id": "172e59eb-148a-3a2a-be35-dbc3d55667c3",
                                                "text": "Tangling with Ziv, Cameron caught him with a flailing elbow, causing the Israeli defender to go down a little easily. However, the referee was in no doubt, much to the displeasure of the home fans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aa75bfe-9f22-30a6-8255-60f970fcddd7",
                                        "entry_id": "7d328fea-98d5-3901-8689-1549a071c4ad",
                                        "glosses": [
                                            "That which displeases; cause of irritation or annoyance; offence; injury."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c8d2c85-20d5-4446-9444-70779ef7e2eb",
                                                "sense_id": "1aa75bfe-9f22-30a6-8255-60f970fcddd7",
                                                "text": "Hast thou delight to see a wretched man / Do outrage and displeasure to himself?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dc188a1-88d0-3051-a52a-73cad89c6f75",
                                        "entry_id": "7d328fea-98d5-3901-8689-1549a071c4ad",
                                        "glosses": [
                                            "A state of disgrace or disfavour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c32e7d9-3c53-4e6e-80da-f712db92dacf",
                                                "sense_id": "0dc188a1-88d0-3051-a52a-73cad89c6f75",
                                                "text": "[King Lear] charged me, on pain of their perpetual displeasure, neither to speak of him [Edgar], entreat for him, nor any way sustain him."
                                            },
                                            {
                                                "example_id": "d71fa6dd-2d1e-42d3-80ec-8506eb4d8f36",
                                                "sense_id": "0dc188a1-88d0-3051-a52a-73cad89c6f75",
                                                "text": "[H]ee went into Poland, being in displeasure with the pope for ouermuch familiaritie with a kinswoman of his."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "displeasure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93b9286e-dbdf-3ca1-aa70-59de089613ce",
                                        "entry_id": "560ec3e5-b5c7-34ed-83fe-eb4f4ef6eaac",
                                        "glosses": [
                                            "To displease or offend."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4754647e-a383-471a-8e30-534ce02f14bf",
                        "source_entry_id": "02ed287d-5cfe-38e4-b7dc-fa1ea49b6e77",
                        "source_sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                        "target_lang_word": "onbehagen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onbehagen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e8349811-ef3e-3f77-b1f1-80a616b66d2a",
                                        "entry_id": "3debee8a-863f-3b9b-bce7-16e8d8543b34",
                                        "glosses": [
                                            "gevoel niet op zijn gemak te zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "389d6ecf-b686-43bc-b78b-03231c903a60",
                                                "sense_id": "e8349811-ef3e-3f77-b1f1-80a616b66d2a",
                                                "text": "Het onbehagen onder de bevolking werd steeds groter."
                                            },
                                            {
                                                "example_id": "98c623ff-1f19-4526-90ce-dc98b66b3b7c",
                                                "sense_id": "e8349811-ef3e-3f77-b1f1-80a616b66d2a",
                                                "text": "Volgens het onderzoek ondervinden tussen de 600.000 en 800.000 Nederlanders ernstige hinder van verkeerslawaai. Ze zijn boos en hebben gevoelens van afkeer, onbehagen en onvoldaanheid. Nog eens 300.000 mensen hebben slaapproblemen door verkeerslawaai."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ef40eb0-3882-4c50-91f2-510d41363d78",
                        "source_entry_id": "02ed287d-5cfe-38e4-b7dc-fa1ea49b6e77",
                        "source_sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                        "target_lang_word": "ongemak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongemak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f1e4c90-652a-39b6-b2d4-7d14c6884f61",
                                        "entry_id": "1bef082c-e106-3bb4-900f-20c63af11119",
                                        "glosses": [
                                            "onaangename verstoring"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d35bcc9e-a805-4e3a-be13-882033b1a400",
                                                "sense_id": "6f1e4c90-652a-39b6-b2d4-7d14c6884f61",
                                                "text": "Wij verontschuldigen ons voor het ongemak dat dit veroorzaakt heeft."
                                            },
                                            {
                                                "example_id": "0f6c4dfb-149b-4a87-9ff6-913261b6c217",
                                                "sense_id": "6f1e4c90-652a-39b6-b2d4-7d14c6884f61",
                                                "text": "Een woordvoerder van de luchtvaartmaatschappij zei op zaterdag: ,,Alle passagiers kregen een diner. De passagiers die niet meer meekonden, werden voorzien van vervoer en hotelaccommodatie en zullen op de volgende beschikbare vlucht worden gezet. PIA betreurt het ongemak dat haar passagiers als gevolg van dit incident is overkomen.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "847ad8aa-050d-3732-9469-d6bec65d81a4",
                                        "entry_id": "1bef082c-e106-3bb4-900f-20c63af11119",
                                        "glosses": [
                                            "kwaal aan het lichaam"
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be515c3f-0052-4d51-ab14-4110bc62e60a",
                                                "sense_id": "847ad8aa-050d-3732-9469-d6bec65d81a4",
                                                "text": "Hij heeft een paar ongemakken aan zijn lichaam."
                                            },
                                            {
                                                "example_id": "710ee17b-6f8f-41fe-876c-5fc5b6a8cfbc",
                                                "sense_id": "847ad8aa-050d-3732-9469-d6bec65d81a4",
                                                "text": "Het duurde meer dan drie dagen voordat de zwelling en het ongemak over waren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a37bc29c-7f1f-4cfd-bafa-b00f8690ccd5",
                        "source_entry_id": "02ed287d-5cfe-38e4-b7dc-fa1ea49b6e77",
                        "source_sense_id": "ee69133e-b1cc-3967-954b-b99524097ccb",
                        "target_lang_word": "ontstemming",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ontstemming",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "38dfc27b-3eea-31ca-9141-1b7d1956d95b",
                                        "entry_id": "729772b0-fb77-37d9-89fb-cf01d099a67d",
                                        "glosses": [
                                            "het boos, kwaad, geërgerd zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f32ab64-0de4-4dd4-b61e-bb80406b21b1",
                                                "sense_id": "38dfc27b-3eea-31ca-9141-1b7d1956d95b",
                                                "text": "«Ik heb me dus niet vergist, dacht gravin Marja, waarom zou hij boos op me zijn?» In de toon waarop hij haar had geantwoord had gravin Marja ontstemming gehoord en de wens een einde aan het gesprek te maken."
                                            },
                                            {
                                                "example_id": "11b02f5f-e134-41ef-a6da-f42f86e20299",
                                                "sense_id": "38dfc27b-3eea-31ca-9141-1b7d1956d95b",
                                                "text": "De tijd tussen de aanval en het begin van de uitzending op Nederland 1 wekte ontstemming bij minister Opstelten van Veiligheid en Justitie. Hij gaat \"In alle scherpte kijken\" wat er moet gebeuren als de NOS niet kan uitzenden. De NOS moet immers kunnen optreden als rampenzender. “Een zender op zwart, dat kan niet en mag niet,” zei Opstelten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
