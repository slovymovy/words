                                        "sense_id": "d2d8b136-cb54-31e0-bd9d-20a4cf06f9c0",
                                        "entry_id": "ea8eca4d-847f-3e8e-be40-ff2714f0c2de",
                                        "glosses": [
                                            "Tayassuidae zoogdier uit een familie van evenhoevigen lijkend op de varkens uit de Oude Wereld. Het is een planteneter, die bij uitzondering een insect verorbert"
                                        ],
