        "nl-extract.jsonl": [
            {
                "entry_id": "d79c6bd6-a0b9-33b0-bb0d-c7cb86697c94",
                "word": "pest",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c53b864c-517e-362f-9991-6faed78d16ee",
                        "entry_id": "d79c6bd6-a0b9-33b0-bb0d-c7cb86697c94",
                        "glosses": [
                            "Dodelijke en besmettelijke ziekten veroorzaakt door de bacterie Yersinia pestis, die verspreid wordt door vlooien die met name op de zwarte rat parasiteren. Altijd gebruikt met lidwoord: 'de pest' of 'de Pest'."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1889e11-3be7-4422-ad27-c213d4c7780e",
                                "sense_id": "c53b864c-517e-362f-9991-6faed78d16ee",
                                "text": "Al zeventig doden door pest op Madagaskar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64dc52ca-d785-4ec3-ad64-e0c077cfde8d",
                        "source_entry_id": "d79c6bd6-a0b9-33b0-bb0d-c7cb86697c94",
                        "source_sense_id": "c53b864c-517e-362f-9991-6faed78d16ee",
                        "source_sense_description": "(medisch) Dodelijke en besmettelijke ziekten veroorzaakt door de bacterie Yersinia pestis",
                        "target_lang_word": "Pest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a61766f4-a3c2-3ef7-8a79-74dd8f89ba75",
                                        "entry_id": "d8d722b7-1698-3292-8289-b7ec89beb0ab",
                                        "glosses": [
                                            "hochgradig ansteckende Krankheit, die durch das Bakterium Yersinia pestis verursacht wird."
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "483470c6-22c1-4eee-8d1a-2e27b30e7375",
                                                "sense_id": "a61766f4-a3c2-3ef7-8a79-74dd8f89ba75",
                                                "text": "„In wichtigen Fragen hat man meist zwischen Pest und Cholera zu wählen.“ - (Dean Acheson)"
                                            },
                                            {
                                                "example_id": "018b1151-ff85-42d3-94e5-b4eb663780c7",
                                                "sense_id": "a61766f4-a3c2-3ef7-8a79-74dd8f89ba75",
                                                "text": "„Mittlerweile war es ein offenes Geheimnis, dass sie die Pest an Bord hatten.“"
                                            },
                                            {
                                                "example_id": "ec87959a-b231-4d06-83ad-e1bc6ecbce51",
                                                "sense_id": "a61766f4-a3c2-3ef7-8a79-74dd8f89ba75",
                                                "text": "„Da ich die Pest nicht mehr fürchtete, machte ich mich daran, die Verstorbenen zu bestatten.“"
                                            },
                                            {
                                                "example_id": "094d45f5-f694-4047-b3d9-3f898f379284",
                                                "sense_id": "a61766f4-a3c2-3ef7-8a79-74dd8f89ba75",
                                                "text": "„Als die große Pest ins Land kam, waren dreißig Jahre verstrichen, seit die letzte Pest gerast, und fünfzig, seit die vorige gewütet.“"
                                            },
                                            {
                                                "example_id": "859caa86-d10e-467e-8158-69754a0681dc",
                                                "sense_id": "a61766f4-a3c2-3ef7-8a79-74dd8f89ba75",
                                                "text": "„Eine Zeitlang war der interkonfessionelle Konflikt fast so tödlich wie die Pest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c594530-e8c9-3b31-bc9d-89de0fa82c5f",
                                        "entry_id": "d8d722b7-1698-3292-8289-b7ec89beb0ab",
                                        "glosses": [
                                            "konkrete Pestepidemie, in einem bestimmten Zeitraum und bestimmtem Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e489a6b-0900-42e5-8235-b0548d6cb717",
                                                "sense_id": "6c594530-e8c9-3b31-bc9d-89de0fa82c5f",
                                                "text": "„Eine Zeitlang war der interkonfessionelle Konflikt fast so tödlich wie die Pest.“"
                                            },
                                            {
                                                "example_id": "5d3fe382-84e7-4090-b0a7-8cd7b1c68ca9",
                                                "sense_id": "6c594530-e8c9-3b31-bc9d-89de0fa82c5f",
                                                "text": "„In der langen Zeit von 1540 bis 1740 sind viele Pesten, äusserliche und innerliche Kriege gewesen.“"
                                            },
                                            {
                                                "example_id": "301094cc-9ea5-475f-8968-589c112e0209",
                                                "sense_id": "6c594530-e8c9-3b31-bc9d-89de0fa82c5f",
                                                "text": "„Viele Pesten kommen nämlich, die nicht tödlich wären, sie sind aber doch tödlich, weil Zufälle wie Gelbsucht, Wassersucht, Paralyse etc. hinzukommen.“"
                                            },
                                            {
                                                "example_id": "334d92c3-4054-4d3a-a277-073f50a838af",
                                                "sense_id": "6c594530-e8c9-3b31-bc9d-89de0fa82c5f",
                                                "text": "„Denn als das heilige Land wieder in die Hände der Ungläubigen gefallen war, und später die Einfälle der Türken in Europa immer häufiger wurden, schreckliche Pesten die Länder durchzogen, und unsere Meere und Küsten Jahrhunderte lang vor den afrikanischen Raubstaaten zittern mußten, in diesen Zeiten, wo es der größten Anstrengung bedurft hätte, um den Christen Schutz und Hülfe zu bringen, da waren, ungeachtet des höchsten Bedürfnisses, die Orden so herabgekommen, daß ihr Untergang bevorzustehen schien.“"
                                            },
                                            {
                                                "example_id": "b61d90e3-23bb-443d-806f-dc0112f95905",
                                                "sense_id": "6c594530-e8c9-3b31-bc9d-89de0fa82c5f",
                                                "text": "„Die im Frühling 1632 in Mittelitalien waltende Pest verzögerte die schnelle Verbreitung des Buches.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1d735202-e14b-3146-94e2-16dcc78aadc2",
                                        "entry_id": "d8d722b7-1698-3292-8289-b7ec89beb0ab",
                                        "glosses": [
                                            "eine Reihe von Tierkrankheiten, zum Beispiel die Geflügelpest"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5199bebd-a553-4ac5-994a-aa35b2583cfa",
                                                "sense_id": "1d735202-e14b-3146-94e2-16dcc78aadc2",
                                                "text": "Schweinepest ist eine durch Viren übertragene Seuche. Ist die Pest erst einmal ausgebrochen, muss der gesamte Bestand getötet und entsorgt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d6ba3282-7c4c-30ff-a56e-e968e2559204",
                                        "entry_id": "d8d722b7-1698-3292-8289-b7ec89beb0ab",
                                        "glosses": [
                                            "Zinnpest, die allotrope Umwandlung von Zinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c229c880-8fc7-44e6-9a17-e599f3e3a247",
                                                "sense_id": "d6ba3282-7c4c-30ff-a56e-e968e2559204",
                                                "text": "Außerdem ist mir Zinnpest bisher nur bei reinem Zinn bekannt und nicht bei Legierungen, wo es nur Nebenbestandteil oder in Spuren vorhanden ist. Und schon Zinngeschirr ist enorm haltbar und ohne Pest - Erscheinungen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d740c3b-bb02-328d-a440-975ca62c1b29",
                                        "entry_id": "ad130cfd-5f8a-3df9-b7b8-5c6c1fba8f7c",
                                        "glosses": [
                                            "eine der drei Ursprungsstädte des heutigen Budapest"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b4bdaf3-771a-4952-aa28-f1ef7b3693bd",
                                                "sense_id": "7d740c3b-bb02-328d-a440-975ca62c1b29",
                                                "text": "Pest ist ein hübscher Stadtteil am östlichen Ufer der Donau."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "352ef4d3-14cd-4013-9412-200787cd9857",
                        "source_entry_id": "d79c6bd6-a0b9-33b0-bb0d-c7cb86697c94",
                        "source_sense_id": "c53b864c-517e-362f-9991-6faed78d16ee",
                        "source_sense_description": "(medisch) Dodelijke en besmettelijke ziekten veroorzaakt door de bacterie Yersinia pestis",
                        "target_lang_word": "pestilence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pestilence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "253d4a57-885f-37ab-a44c-8d6096085607",
                                        "entry_id": "a46e4fd5-e299-3ace-b48f-d15184f610d9",
                                        "glosses": [
                                            "Any epidemic disease that is highly contagious, infectious, virulent and devastating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee169ebb-1df2-491b-aa2f-bbfc1a172db2",
                                                "sense_id": "253d4a57-885f-37ab-a44c-8d6096085607",
                                                "text": "1485, Thomas Malory, Le Morte Darthur, Book XVII, Chapter iii, leaf 347r\nand hit was in the realme of Logrys and soo bifelle grete pestylence & grete harme to both Realmes\n\"And it was in the realm of Logris; and so befell great pestilence and great harm to both realms.\""
                                            },
                                            {
                                                "example_id": "4465ee96-525d-46c3-ad80-f2f3803cb17b",
                                                "sense_id": "253d4a57-885f-37ab-a44c-8d6096085607",
                                                "text": "Thou shalt not be afraid for the terror by night; nor for the arrow that flieth by day;\nNor for the pestilence that walketh in darkness; nor for the destruction that wasteth at noonday."
                                            },
                                            {
                                                "example_id": "b2a3e80e-b2a9-4efc-98ab-65db3ecfac2d",
                                                "sense_id": "253d4a57-885f-37ab-a44c-8d6096085607",
                                                "text": "\"Take it, Christian dogsǃ take the palaces, the gardens, the mosques, the abode of our fathers - take plague with them; pestilence is the enemy we fly; if she be your friend, hug her to your bosoms. The curse of Allah is on Stamboul, share ye her fateǃ\""
                                            },
                                            {
                                                "example_id": "b2c30647-6046-4f1a-9f95-8da5b2917a3e",
                                                "sense_id": "253d4a57-885f-37ab-a44c-8d6096085607",
                                                "text": "It was reserved for Christians to torture bread, the staff of life, bread for which children in whole districts wail, bread, the gift of pasture to the poor, bread, for want of which thousands of our fellow beings annually perish by famine; it was reserved for Christians to torture the material of bread by fire, to create a chemical and maddening poison, burning up the brain and brutalizing the soul, and producing evils to humanity, in comparison of which, war, pestilence, and famine, cease to be evils."
                                            },
                                            {
                                                "example_id": "935a2ee4-a164-406f-94b9-72b6bcfe4da7",
                                                "sense_id": "253d4a57-885f-37ab-a44c-8d6096085607",
                                                "text": "The pestilence slew and slew, and ceased not by day or by night, and those who escaped from the pestilence were slain of the famine."
                                            },
                                            {
                                                "example_id": "7a0023c9-afc7-4001-82b1-e23812d1ff53",
                                                "sense_id": "253d4a57-885f-37ab-a44c-8d6096085607",
                                                "text": "The snowshoe-rabbits build up through the years until they reach a climax when they seem to be everywhere; then with dramatic suddenness their pestilence falls upon them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21e8b5a7-d67d-3949-82fc-aaa77ebedc68",
                                        "entry_id": "a46e4fd5-e299-3ace-b48f-d15184f610d9",
                                        "glosses": [
                                            "Anything harmful to morals or public order."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "065fbaf7-a26c-4eb5-9d4c-38ebf0843daf",
                        "source_entry_id": "d79c6bd6-a0b9-33b0-bb0d-c7cb86697c94",
                        "source_sense_id": "c53b864c-517e-362f-9991-6faed78d16ee",
                        "source_sense_description": "(medisch) Dodelijke en besmettelijke ziekten veroorzaakt door de bacterie Yersinia pestis",
                        "target_lang_word": "plague",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plague",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e62d76f1-9e1f-38b7-921c-cc64ff13d809",
                                        "entry_id": "ada3e5d0-d157-398a-9eba-3e1da097f0b4",
                                        "glosses": [
                                            "The bubonic plague, the pestilent disease caused by the virulent bacterium Yersinia pestis."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "often",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc68321e-fa8f-457f-9b56-b603e0060b84",
                                                "sense_id": "e62d76f1-9e1f-38b7-921c-cc64ff13d809",
                                                "text": "It was about the beginning of September, 1664, that I, among the rest of my neighbours, heard in ordinary discourse that the plague was returned again in Holland[…] It mattered not from whence it came; but all agreed it was come into Holland again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8ffe924-c204-357f-b89f-04041418ad82",
                                        "entry_id": "ada3e5d0-d157-398a-9eba-3e1da097f0b4",
                                        "glosses": [
                                            "An epidemic or pandemic caused by any pestilence, but specifically by the above disease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a181740a-a7c8-4eef-861d-7f45de1d32bd",
                                                "sense_id": "e8ffe924-c204-357f-b89f-04041418ad82",
                                                "text": "Great plagues, such as the bubonic plague or smallpox or syphilis or influenza, can happen again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94554d67-fca6-3f2d-95ee-1038f6bff35d",
                                        "entry_id": "ada3e5d0-d157-398a-9eba-3e1da097f0b4",
                                        "glosses": [
                                            "A widespread affliction, calamity, or destructive influx, especially when seen as divine retribution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e5ea27a-edfb-4509-8a4a-cbdbe011f98e",
                                                "sense_id": "94554d67-fca6-3f2d-95ee-1038f6bff35d",
                                                "text": "Ten Biblical plagues over Egypt, ranging from locusts to the death of the crown prince, finally forced Pharaoh to let Moses's people go."
                                            },
                                            {
                                                "example_id": "b317992a-897b-43e0-a44b-46de1b0085d3",
                                                "sense_id": "94554d67-fca6-3f2d-95ee-1038f6bff35d",
                                                "text": "A plague a both the Houſes, I am sped: / Is he gone and hath nothing?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efbdda65-b9e9-32e6-9bfb-3889306482a8",
                                        "entry_id": "ada3e5d0-d157-398a-9eba-3e1da097f0b4",
                                        "glosses": [
                                            "A grave nuisance, whatever greatly irritates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46156c27-15dd-4986-966d-086005751a87",
                                                "sense_id": "efbdda65-b9e9-32e6-9bfb-3889306482a8",
                                                "text": "Bart is an utter plague; his pranks never cease."
                                            },
                                            {
                                                "example_id": "3398d5b7-de19-441b-8791-782e45878953",
                                                "sense_id": "efbdda65-b9e9-32e6-9bfb-3889306482a8",
                                                "text": "This is the first time a President has attended this dinner in six years. It's understandable- we had a horrible plague, followed by two years of COVID!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b7678d-2196-3288-abae-18744a844b34",
                                        "entry_id": "ada3e5d0-d157-398a-9eba-3e1da097f0b4",
