                                    {
                                        "sense_id": "79552a9e-f9bf-3ad4-acb6-75681b41c5fe",
                                        "entry_id": "442406d4-5870-3be3-9310-28a9ec2bc63a",
                                        "glosses": [
                                            "The process of converting to colour."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78e527ba-346a-4c70-b8ae-64ad8abcd895",
                                                "sense_id": "79552a9e-f9bf-3ad4-acb6-75681b41c5fe",
                                                "text": "When milk is kept at a high temperature for a long period of time chemical reactions take place and the resultant reaction products give rise to brown colorisation of milk and a caramel-like flavour."
                                            },
                                            {
                                                "example_id": "8c7a6d36-e3b0-4a1b-b477-39a6ee240ce1",
                                                "sense_id": "79552a9e-f9bf-3ad4-acb6-75681b41c5fe",
                                                "text": "Despite these design and safety implications, the potential of interventional MR in the future is astouding and includes:\nliver imaging and tumour ablation with colorisation imaging capabilities, …"
                                            },
                                            {
                                                "example_id": "1a02235e-0244-42a1-8a74-699ec912a274",
                                                "sense_id": "79552a9e-f9bf-3ad4-acb6-75681b41c5fe",
                                                "text": "The special prints with their computer-applied colour were released by MGM on 4 July 1985. ‘Colorisation,’ as it is known, has become a controversial issue in the industry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
