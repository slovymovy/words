                        "entry_id": "9dcc598d-3279-3247-b9e7-ef625ccb027d",
                        "glosses": [
                            "childishness, puerility"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71de89b-defe-429f-a0a9-afb45d4e3328",
                                "sense_id": "3651dafe-5c49-3cd3-8c7e-88c9ade27441",
                                "text": "Раздражи́тельность его́ доходи́ла до ребя́чества; его́ смех, звук его́ го́лоса, всё его́ существо́ каза́лось пропи́танным же́лчью.",
                                "translation": "His ill-humour almost approached puerility; his laugh, the sound of his voice, his whole being seemed steeped in venom.",
                                "english": "His ill-humour almost approached puerility; his laugh, the sound of his voice, his whole being seemed steeped in venom."
                            }
                        ]
                    }
