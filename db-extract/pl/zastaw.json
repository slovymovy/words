                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d4c1145-4a92-4fdc-b396-c101586972f4",
                        "source_entry_id": "d034de71-f448-3eda-8fc8-3a075e046b21",
                        "source_sense_id": "807b65b5-aa2a-3f29-b6b5-ab8b34057d62",
