        "fr-extract.jsonl": [
            {
                "entry_id": "ae076d72-f647-307e-b61a-291cf4e2ae0e",
                "word": "tacitement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "03123fb5-993f-3bf0-8a68-d30148fa13d4",
                        "entry_id": "ae076d72-f647-307e-b61a-291cf4e2ae0e",
                        "glosses": [
                            "D’une manière tacite, sans être formellement exprimé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df4603ed-41a2-47a7-a14e-5b3cf158f1ee",
                                "sense_id": "03123fb5-993f-3bf0-8a68-d30148fa13d4",
                                "text": "Les ennemis de Lamotte l’ont accusé d’avoir ambitionné la monarchie universelle en littérature ; peut-être aspirait-il tacitement à cette gloire, sans trop s'en douter,"
                            },
                            {
                                "example_id": "76285917-36a1-4af3-8915-38efa8786de2",
                                "sense_id": "03123fb5-993f-3bf0-8a68-d30148fa13d4",
                                "text": "Cela n’est pas exprimé dans le traité, mais cela y est compris tacitement."
                            },
                            {
                                "example_id": "5bada42d-4e7a-4297-9bc9-0a5a509f0c09",
                                "sense_id": "03123fb5-993f-3bf0-8a68-d30148fa13d4",
                                "text": "Ce contrat est tacitement reconductible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1a9f8ea-5227-427e-af25-78324b14112f",
                        "source_entry_id": "ae076d72-f647-307e-b61a-291cf4e2ae0e",
                        "source_sense_id": "03123fb5-993f-3bf0-8a68-d30148fa13d4",
                        "target_lang_word": "stillschweigend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stillschweigend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a95a3e86-994f-39b3-a7fc-a5a9dcab03b5",
                                        "entry_id": "ca0105bd-a434-345d-8a16-e955b05014cc",
                                        "glosses": [
                                            "ohne über etwas zu sprechen, ohne Absprache (mit Dritten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae2d4fad-7a9c-475f-bc23-e7ff9aa910b8",
                                                "sense_id": "a95a3e86-994f-39b3-a7fc-a5a9dcab03b5",
                                                "text": "Sie trafen eine stillschweigende Übereinkunft."
                                            },
                                            {
                                                "example_id": "ea2d78a6-4eac-49ef-b5c0-5ae32ceb4132",
                                                "sense_id": "a95a3e86-994f-39b3-a7fc-a5a9dcab03b5",
                                                "text": "„Selbst ein stillschweigendes Akzeptieren durch Ultrarechte war für eine Koalition der Mitte bislang völlig undenkbar.“"
                                            },
                                            {
                                                "example_id": "cf3fbb5d-8c26-4eac-9407-7d03a6a4f3db",
                                                "sense_id": "a95a3e86-994f-39b3-a7fc-a5a9dcab03b5",
                                                "text": "„Eigentlich bestand in Großbritannien eine stillschweigende Übereinkunft, die Indienpolitik aus dem Streit der Parteien herauszuhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "stillschweigend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d52a246-6dd7-3ad2-8bf7-08c698f24889",
                                        "entry_id": "2e73488f-464b-34d1-b3b8-af361f610204",
                                        "glosses": [
