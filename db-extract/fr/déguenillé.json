                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6c1bc978-3491-4b8f-8e7f-94973ab9316b",
                        "entry_id": "91a95e7d-e40a-319d-8ff8-4a01921c8315",
                        "tags": [
                            "plural",
