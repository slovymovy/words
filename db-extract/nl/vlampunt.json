                "translations": [
                    {
                        "translation_id": "54f68dda-2582-499c-8530-b7cefc91754a",
                        "source_entry_id": "64522ca3-1945-3ca8-9c03-4a5146d64d25",
                        "source_sense_id": "6665020b-4be0-30c5-b4b2-231b600bc699",
                        "target_lang_word": "Flammpunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flammpunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                                        "entry_id": "c54ef8c2-c818-355d-b4e3-6e2206766239",
                                        "glosses": [
                                            "die tiefstmögliche Temperatur, bei der eine Flüssigkeit im Raum über sich ein brennbares Gas-Luft-Gemisch in Abhängigkeit vom Luftdruck bilden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c78d6b-afaf-4a45-9386-36932000344d",
                                                "sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                                                "text": "Nach der Deutschen Industrienorm 7732, Blatt 1, vom Juni 1963 ist der Flammpunkt die niedrigste Temperatur bei der aus einer Flüssigkeit, bei einem Luftdruck von 760 Torr, so viele Moleküle vom flüssigen in den gasförmigen Aggregatzustand übergehen, dass diese mit der über dem Flüssigkeitsspiegel stehenden Luft ein entflammbares Gasgemisch bilden."
                                            },
                                            {
                                                "example_id": "1f9905fa-3da4-4499-9d46-8e7116d73201",
                                                "sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                                                "text": "Der Flammpunkt ist vom Brennpunkt zu unterscheiden."
                                            },
                                            {
                                                "example_id": "ede136d3-35d1-4cae-ac23-4561da2bf3f6",
                                                "sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                                                "text": "Für die Gefahrenklassen von brennbaren Flüssigkeiten ist der Flammpunkt ein mitentscheidendes Kriterium."
                                            },
                                            {
                                                "example_id": "dbca7df8-001f-4d22-8de1-ccf21021b9c8",
                                                "sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                                                "text": "Der Flammpunkt von Benzin liegt unterhalb von -20°C (256 K) und der von Ether bei -49°C (227 K)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c89c3d2-1952-47e2-9105-9c91b4fb8809",
                        "source_entry_id": "64522ca3-1945-3ca8-9c03-4a5146d64d25",
