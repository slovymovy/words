                                "example_id": "2b692e0b-188f-40cd-a821-1c56236ac43b",
                                "sense_id": "189e75be-723d-396d-9f29-248654374887",
                                "text": "In das Nierenkörperchen strömt das Blut hinein, um gereinigt und entwässert zu werden."
                            },
