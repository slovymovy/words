                                "target_lang_word": "подглядывание",
                                "target_lang_sense_clarification": "тайное наблюдение"
                            },
                            {
                                "target_lang_word": "вынюхивание",
                                "target_lang_sense_clarification": "поиск скрытой информации"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gözetleme",
