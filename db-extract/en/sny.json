                "senses": [
                    {
                        "sense_id": "b9463202-742a-37d6-9b00-5373698b9119",
                        "entry_id": "3bff08c3-4e17-3c6d-8cfa-140a614a7725",
                        "glosses": [
                            "Abound, swarm, teem, be infested, with something"
                        ],
                        "tags": [
                            "dialectal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "243e40fd-e811-41e3-9624-ecf312c1187c",
                                "sense_id": "b9463202-742a-37d6-9b00-5373698b9119",
                                "text": "“And did you kill it?”\n“I did, for they’re a nuisance. The place is fair snied wi’ ‛em.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c900acd-3418-49fa-af27-d24a768fb39f",
                        "source_entry_id": "3bff08c3-4e17-3c6d-8cfa-140a614a7725",
                        "source_sense_id": "b9463202-742a-37d6-9b00-5373698b9119",
                        "source_sense_description": "to swarm, teem, be infested with something",
                        "target_lang_word": "кише́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кише́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "166cba48-f042-3146-a08b-2e44c26858cf",
                                        "entry_id": "eed5bd40-5e55-3a8a-a016-644072a9ed15",
                                        "glosses": [
                                            "беспорядочно двигаться в различных направлениях (о множестве животных, людей)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "624b1400-c37c-4c04-b722-48b9e8dc6218",
                                                "sense_id": "166cba48-f042-3146-a08b-2e44c26858cf",
                                                "text": "Ребятишки босиком, в одних рубашонках, по-летнему, кишат на улице, бегают по всполью ― обедать даже не скоро домой загонишь их…"
                                            },
                                            {
                                                "example_id": "da37294c-6059-4578-89f3-1b4b69560282",
                                                "sense_id": "166cba48-f042-3146-a08b-2e44c26858cf",
                                                "text": "Чистый народ, блестя на ярком солнце шляпами, кишел у входа и по расчищенным дорожкам, между русскими домиками с резными князьками〈…〉"
                                            },
                                            {
                                                "example_id": "b9e684df-eb00-4cba-b6c6-3179d2fa3e0f",
                                                "sense_id": "166cba48-f042-3146-a08b-2e44c26858cf",
                                                "text": "Ему представилось, как лежит он в гробу мёртвый, но чувствующий, как на нём кишат черви, обгладывая кости, и он все это слышит, и ему больно и душно, но он не может пошевельнуться."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91e4bf00-7705-3b98-9d68-e736f9b61e6e",
                                        "entry_id": "eed5bd40-5e55-3a8a-a016-644072a9ed15",
                                        "glosses": [
                                            "быть наполненным чем-нибудь, вмещать в себе множество каких-либо существ"
                                        ],
                                        "tags": [
                                            "кем-чем."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d76cbe1-1a4c-4257-8fd3-317f03eca175",
                                                "sense_id": "91e4bf00-7705-3b98-9d68-e736f9b61e6e",
                                                "text": "Большая зала кишела народом и отличалась, как и все аукционы, крайним беспорядком."
                                            },
                                            {
                                                "example_id": "d362a4ba-a844-40d9-8803-b8aa95d17d86",
                                                "sense_id": "91e4bf00-7705-3b98-9d68-e736f9b61e6e",
                                                "text": "Лес кишит комарами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7445fe23-ddae-3472-9049-1b429d9895bf",
                                        "entry_id": "eed5bd40-5e55-3a8a-a016-644072a9ed15",
                                        "glosses": [
                                            "перен., разг. непрерывно быть во множестве (о мыслях, чувствах и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4ef84cb-12d7-4c7d-9c12-4509f7487f66",
                                                "sense_id": "7445fe23-ddae-3472-9049-1b429d9895bf",
                                                "text": "Клочки и отрывки каких-то мыслей так и кишели в его голове; но он ни одной не мог схватить, ни на одной не мог остановиться, несмотря даже на усилия…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
