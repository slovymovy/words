                        "glosses": [
                            "Se recouper, avoir une intersection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8330b6c-e1a2-437f-9ccd-e2ad90049b58",
                                "sense_id": "6349ce42-1257-3d37-b973-c4bba18c8dad",
                                "text": "(...) et leurs « sphères » respectives sont comme deux bulles imperméables qui se gardent bien de s'intersectionner."
                            },
                            {
                                "example_id": "bd1542d4-74cd-42df-8ad9-922f1ddb2fa0",
                                "sense_id": "6349ce42-1257-3d37-b973-c4bba18c8dad",
                                "text": "Que notre art soit UN où la dolence et le mysticisme asiatiques, le primitivisme africain, le cosmopolitisme des amériques, l'exotisme ultra et le machinisme décadent de l'Europe fusionnent, se croisent, s'intersectionnent."
                            }
                        ]
                    }
