                        "examples": [
                            {
                                "example_id": "4d6bb008-8f3d-4292-a934-c67bd1a0dd53",
                                "sense_id": "97c8a181-a2a6-382f-8a33-3c4fb09ec901",
                                "text": "Il attendait de découvrir l’île d’Olkhon pour s’apaiser un peu, elle de voir enfin les nerpas, phoques d’eau douce dont les perpétuelles querelles rendaient le spectacles divertissant."
                            },
                            {
                                "example_id": "7f947e07-4e60-4d2c-8e9c-3c62fefc8fbf",
                                "sense_id": "97c8a181-a2a6-382f-8a33-3c4fb09ec901",
                                "text": "A l’extrême nord de l’île se trouve le cap Khoboy, d’où l’on peut parfois voir les phoques ou les nerpas du Baïkal, les seuls mammifères existants."
                            }
                        ]
