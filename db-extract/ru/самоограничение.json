                        "cross_references": []
                    },
                    {
                        "translation_id": "9410446a-cbd5-4185-8330-d0b1e2b0562d",
                        "source_entry_id": "3632413c-1d4b-3e4c-8cbf-9e0a27f090e5",
                        "target_lang_word": "autolimitation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autolimitation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79360cb3-73e6-39e1-b111-8f43e47d25ed",
                                        "entry_id": "50d4136f-04bb-39ec-a264-ed477b025086",
                                        "glosses": [
                                            "Limitation qu'on applique à soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ba7676-0c0c-406f-8ced-d1270c2ab3e3",
                                                "sense_id": "79360cb3-73e6-39e1-b111-8f43e47d25ed",
                                                "text": "Ce dont nous avons besoin, c’est non pas d’une maîtrise, mais d’un contrôle de ce désir de maîtrise, d’une autolimitation."
                                            }
                                        ]
                                    }
                                ]
