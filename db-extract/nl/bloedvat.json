                                "sense_id": "ad001d74-6dd4-36f1-a9c1-ac6ff6288376",
                                "text": "De druk in de bloedvaten is wisselend."
                            },
                            {
                                "example_id": "8b750ced-0765-459a-ad2c-5dbfb990eb2b",
                                "sense_id": "ad001d74-6dd4-36f1-a9c1-ac6ff6288376",
                                "text": "De wand van de bloedvaten is dik bij een slagader en dun bij een ader."
                            }
                        ]
