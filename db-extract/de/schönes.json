                        "sense_id": "062f46cf-2cea-312d-a456-78a67690d52f",
                        "entry_id": "ea075f64-02af-3fd8-bf01-17d37611c008",
                        "glosses": [
                            "nominalization of schön: something beautiful"
                        ],
                        "tags": [
                            "adjectival",
                            "neuter",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "52b60c38-c14a-41fc-8536-4fc4a94a2ae8",
                                "sense_id": "062f46cf-2cea-312d-a456-78a67690d52f",
                                "text": "Es gab sehr viel Schönes im Zimmer zu sehen.",
                                "translation": "Many beautiful objects could be seen in the room.",
                                "english": "Many beautiful objects could be seen in the room."
                            },
                            {
                                "example_id": "ae3ecf9f-a33d-4a95-a8c9-931c3a3b5e35",
                                "sense_id": "062f46cf-2cea-312d-a456-78a67690d52f",
                                "text": "Dies ist der Anfang von etwas Schönem.",
                                "translation": "This is the start of something beautiful.",
                                "english": "This is the start of something beautiful."
                            },
                            {
                                "example_id": "9ebe8573-c10b-4648-97c7-572957618099",
                                "sense_id": "062f46cf-2cea-312d-a456-78a67690d52f",
                                "text": "das Gute, das Wahre und das Schöne",
                                "translation": "the good, the true, and the beautiful",
                                "english": "the good, the true, and the beautiful"
                            },
                            {
                                "example_id": "aab95e36-fda4-43db-9208-fa86fc415599",
                                "sense_id": "062f46cf-2cea-312d-a456-78a67690d52f",
                                "text": "Beobachtungen über das Gefühl des Schönen und Erhabenen",
                                "translation": "Observations on the Feeling of the Beautiful and Sublime",
                                "english": "Observations on the Feeling of the Beautiful and Sublime"
                            }
                        ]
                    }
