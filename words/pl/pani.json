{
    "word_family": [
        "pan",
        "panna",
        "państwo",
        "pański",
        "panować",
        "panienka"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "cf1da61b-3d94-30f7-93bd-c4e29bacc907",
                    "sense_definition": "Forma grzecznościowa używana przy zwracaniu się do kobiety lub mówieniu o niej (odpowiednik zaimka \"ty\" w relacjach oficjalnych)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "address_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy może mi <w>pani</w> pomóc w znalezieniu drogi?",
                            "target_lang_translations": {
                                "ru": "Не могли бы <w>вы</w> помочь мне найти дорогу?",
                                "en": "Could <w>you</w> help me find my way?"
                            }
                        },
                        {
                            "text": "Jak długo <w>pani</w> mieszka w tym mieście?",
                            "target_lang_translations": {
                                "ru": "Как долго <w>вы</w> живете в этом городе?",
                                "en": "How long have <w>you</w> been living in this city?"
                            }
                        }
                    ],
                    "antonyms": [
                        "pan"
                    ],
                    "common_phrases": [
                        "proszę pani",
                        "czy pani",
                        "droga pani"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливая форма обращения к женщине или упоминания о ней (эквивалент местоимения \"вы\" в официальных отношениях)",
                        "en": "A polite form of address used when speaking to or about a woman (equivalent to the formal 'you' in official or respectful relations)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вы",
                                "target_lang_sense_clarification": "вежливое обращение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "you",
                                "target_lang_sense_clarification": "formal address to a woman"
                            },
                            {
                                "target_lang_word": "madam",
                                "target_lang_sense_clarification": "polite form of address for a woman"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0a179f4-f68f-3bb4-8ea8-8545ccbef47a",
                    "sense_definition": "Słowo pełniące funkcję zaimka dzierżawczego, oznaczające przynależność czegoś do kobiety, do której się zwracamy (odpowiednik \"twój\" w relacjach oficjalnych)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To jest <w>pani</w> parasol, prawda?",
                            "target_lang_translations": {
                                "ru": "Это <w>ваш</w> зонт, правда?",
                                "en": "This is <w>your</w> umbrella, isn't it?"
                            }
                        },
                        {
                            "text": "Bardzo podoba mi się <w>pani</w> nowa fryzura.",
                            "target_lang_translations": {
                                "ru": "Мне очень нравится <w>ваша</w> новая прическа.",
                                "en": "I really like <w>your</w> new haircut."
                            }
                        }
                    ],
                    "antonyms": [
                        "pan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, выполняющее функцию притяжательного местоимения, означающее принадлежность чего-либо женщине, к которой мы обращаемся (эквивалент \"ваш\" в официальных отношениях)",
                        "en": "A word functioning as a possessive determiner, indicating that something belongs to the woman being addressed (equivalent to the formal 'your')"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ваш",
                                "target_lang_sense_clarification": "притяжательное местоимение"
                            },
                            {
                                "target_lang_word": "ваша",
                                "target_lang_sense_clarification": "притяжательное местоимение (женский род)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "your",
                                "target_lang_sense_clarification": "formal address to a woman"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29ca935e-ab67-3703-b697-cef553f88a19",
                    "sense_definition": "Tytuł grzecznościowy stawiany przed imieniem, nazwiskiem lub nazwą funkcji kobiety",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzień dobry, czy jest dzisiaj <w>pani</w> Kowalska?",
                            "target_lang_translations": {
                                "ru": "Добрый день, сегодня есть <w>госпожа</w> Ковальская?",
                                "en": "Good morning, is <w>Mrs.</w> Kowalska in today?"
                            }
                        },
                        {
                            "text": "<w>Pani</w> dyrektor zaraz przyjdzie na spotkanie.",
                            "target_lang_translations": {
                                "ru": "<w>Госпожа</w> директор сейчас придет на встречу.",
                                "en": "The <w>Director</w> will be here for the meeting shortly."
                            }
                        }
                    ],
                    "antonyms": [
                        "pan"
                    ],
                    "common_phrases": [
                        "szanowna pani",
                        "pani doktor",
                        "pani dyrektor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливый титул, ставящийся перед именем, фамилией или названием должности женщины",
                        "en": "A polite title placed before a woman's first name, surname, or professional title"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "госпожа",
                                "target_lang_sense_clarification": "официальное обращение"
                            },
                            {
                                "target_lang_word": "пани",
                                "target_lang_sense_clarification": "при обращении к польке"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "Mrs",
                                "target_lang_sense_clarification": "title before a married woman's surname"
                            },
                            {
                                "target_lang_word": "Ms",
                                "target_lang_sense_clarification": "title before a woman's surname regardless of marital status"
                            },
                            {
                                "target_lang_word": "Miss",
                                "target_lang_sense_clarification": "title before an unmarried woman's surname"
                            },
                            {
                                "target_lang_word": "Madame",
                                "target_lang_sense_clarification": "formal title used before a name or role"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d6f9724-6194-3a0a-b536-73d1ad00f38a",
                    "sense_definition": "Kobieta, zwłaszcza dorosła i nieznajoma, o której mówi się z szacunkiem",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "woman_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta miła <w>pani</w> w sklepie pomogła mi wybrać prezent.",
                            "target_lang_translations": {
                                "ru": "Эта милая <w>женщина</w> в магазине помогла мне выбрать подарок.",
                                "en": "That nice <w>lady</w> in the shop helped me choose a gift."
                            }
                        },
                        {
                            "text": "Ustąpiłem miejsca w autobusie starszej <w>pani</w>.",
                            "target_lang_translations": {
                                "ru": "Я уступил место в автобусе пожилой <w>женщине</w>.",
                                "en": "I gave up my seat on the bus to an elderly <w>lady</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kobieta"
                    ],
                    "antonyms": [
                        "pan"
                    ],
                    "common_phrases": [
                        "starsza pani",
                        "młoda pani"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина, особенно взрослая и незнакомая, о которой говорят с уважением",
                        "en": "A woman, especially an adult and a stranger, spoken of with respect"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "женщина",
                                "target_lang_sense_clarification": "нейтрально"
                            },
                            {
                                "target_lang_word": "дама",
                                "target_lang_sense_clarification": "уважительно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lady",
                                "target_lang_sense_clarification": "polite reference to a woman"
                            },
                            {
                                "target_lang_word": "woman",
                                "target_lang_sense_clarification": "adult female human"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e50c068-587f-3461-bd87-8d447c28327f",
                    "sense_definition": "Nauczycielka w szkole lub przedszkolu (określenie używane głównie przez uczniów)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "teacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasza <w>pani</w> od matematyki jest bardzo wymagająca.",
                            "target_lang_translations": {
                                "ru": "Наша <w>учительница</w> математики очень требовательная.",
                                "en": "Our math <w>teacher</w> is very demanding."
                            }
                        },
                        {
                            "text": "Dzieci przygotowały laurki dla swojej <w>pani</w>.",
                            "target_lang_translations": {
                                "ru": "Дети подготовили открытки для своей <w>учительницы</w>.",
                                "en": "The children prepared cards for their <w>teacher</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proszę pani",
                        "nasza pani"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in school context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Учительница в школе или детском саду (обозначение, используемое в основном учениками)",
                        "en": "A female teacher in a school or kindergarten (a term used mainly by students)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учительница",
                                "target_lang_sense_clarification": "в школе"
                            },
                            {
                                "target_lang_word": "воспитательница",
                                "target_lang_sense_clarification": "в детском саду"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "teacher",
                                "target_lang_sense_clarification": "female schoolteacher addressed by pupils"
                            },
                            {
                                "target_lang_word": "Miss",
                                "target_lang_sense_clarification": "form of address for a female teacher"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3230b4d-73af-3693-9d8c-ac374d055f58",
                    "sense_definition": "Kobieta sprawująca władzę nad czymś, właścicielka majątku lub pracodawczyni",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mistress_owner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pies wiernie czekał pod drzwiami na swoją <w>panią</w>.",
                            "target_lang_translations": {
                                "ru": "Собака верно ждала под дверью свою <w>хозяйку</w>.",
                                "en": "The dog waited faithfully at the door for its <w>mistress</w>."
                            }
                        },
                        {
                            "text": "Ona czuła się niepodzielną <w>panią</w> na tych włościach.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя полновластной <w>хозяйкой</w> в этих владениях.",
                                "en": "She felt like the absolute <w>mistress</w> of these estates."
                            }
                        }
                    ],
                    "synonyms": [
                        "właścicielka",
                        "protektorka"
                    ],
                    "antonyms": [
                        "służący",
                        "poddany"
                    ],
                    "common_phrases": [
                        "pani domu",
                        "pani sytuacji"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина, имеющая власть над чем-либо, владелица имущества или работодательница",
                        "en": "A woman who has authority or power over something, a female owner of property, or a female employer"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хозяйка",
                                "target_lang_sense_clarification": "владелица"
                            },
                            {
                                "target_lang_word": "госпожа",
                                "target_lang_sense_clarification": "властительница"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "mistress",
                                "target_lang_sense_clarification": "female owner or head of household"
                            },
                            {
                                "target_lang_word": "owner",
                                "target_lang_sense_clarification": "female proprietor"
                            },
                            {
                                "target_lang_word": "lady",
                                "target_lang_sense_clarification": "woman of authority or mistress of a household"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}