{
    "word_family": [
        "slouchy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4302879-33eb-30cc-a405-fb3b19ac7f4a",
                    "sense_definition": "To sit or stand with a bent, relaxed, or lazy posture",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>slouch</w> while you are sitting at the dinner table.",
                            "target_lang_translations": {
                                "pl": "Proszę, nie <w>garb się</w>, kiedy siedzisz przy stole."
                            }
                        },
                        {
                            "text": "He tends to <w>slouch</w> when he is tired after a long day.",
                            "target_lang_translations": {
                                "pl": "Ma tendencję do <w>garbienia się</w>, gdy jest zmęczony po długim dniu."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoop",
                        "droop",
                        "loll"
                    ],
                    "target_lang_definitions": {
                        "pl": "Siedzieć lub stać w zgarbionej, rozluźnionej lub leniwej pozycji"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "garbić się",
                                "target_lang_sense_clarification": "przyjmować zgarbioną postawę ciała"
                            },
                            {
                                "target_lang_word": "siedzieć zgarbionym",
                                "target_lang_sense_clarification": "dotyczy konkretnie pozycji siedzącej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "929f36d3-62da-34d0-acec-2b17e3c744c1",
                    "sense_definition": "To walk in a slow, lazy, or clumsy way",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired student <w>slouched</w> toward the classroom after the break.",
                            "target_lang_translations": {
                                "pl": "Zmęczony uczeń <w>wlekł się</w> w stronę klasy po przerwie."
                            }
                        },
                        {
                            "text": "He <w>slouched</w> down the hallway with his hands deep in his pockets.",
                            "target_lang_translations": {
                                "pl": "Szedł <w>zgarbiony</w> korytarzem, trzymając ręce głęboko w kieszeniach."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Poruszać się w powolny, leniwy lub niezdarny sposób"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wlec się",
                                "target_lang_sense_clarification": "chodzić powoli, bez energii"
                            },
                            {
                                "target_lang_word": "powłóczyć nogami",
                                "target_lang_sense_clarification": "sposób chodzenia sugerujący zmęczenie lub brak energii"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2424257-c29d-33f9-bcb8-4962a0e92ed6",
                    "sense_definition": "To cause a part of the body to hang down or droop",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>slouched</w> his shoulders forward as he felt the weight of the bad news.",
                            "target_lang_translations": {
                                "pl": "Bezwładnie <w>opuścił</w> ramiona, czując ciężar złych wieści."
                            }
                        },
                        {
                            "text": "She <w>slouched</w> her head onto the desk in total exhaustion.",
                            "target_lang_translations": {
                                "pl": "Z całkowitego wyczerpania <w>zwiesiła</w> głowę na biurko."
                            }
                        }
                    ],
                    "synonyms": [
                        "droop"
                    ],
                    "target_lang_definitions": {
                        "pl": "Powodować, że część ciała zwisa lub opada"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "opuszczać",
                                "target_lang_sense_clarification": "np. ramiona lub głowę w geście rezygnacji"
                            },
                            {
                                "target_lang_word": "zwieszać",
                                "target_lang_sense_clarification": "pozwolić czemuś opaść bezwładnie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e786ffab-159e-39ea-8554-24b1bcd4b6d9",
                    "sense_definition": "A posture where the head and shoulders are bent forward in a lazy or tired way",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sitting with a constant <w>slouch</w> can lead to back pain later in life.",
                            "target_lang_translations": {
                                "pl": "Ciągłe <w>garbienie się</w> podczas siedzenia może prowadzić do bólów pleców w późniejszym wieku."
                            }
                        },
                        {
                            "text": "He tried to correct his <w>slouch</w> by standing up straight against the wall.",
                            "target_lang_translations": {
                                "pl": "Próbował skorygować swoją <w>zgarbioną postawę</w>, stojąc prosto przy ścianie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Postawa, w której głowa i ramiona są pochylone do przodu w leniwy lub zmęczony sposób"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "garbienie się",
                                "target_lang_sense_clarification": "nawykowa zła postawa"
                            },
                            {
                                "target_lang_word": "zgarbiona postawa",
                                "target_lang_sense_clarification": "opis stanu sylwetki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3c19845-f54d-39bd-b535-778e043e65a0",
                    "sense_definition": "A person who is lazy or not very good at a particular activity",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is no <w>slouch</w> when it comes to solving complex mathematical problems.",
                            "target_lang_translations": {
                                "pl": "Ona <w>nie jest byle kim</w>, jeśli chodzi o rozwiązywanie złożonych problemów matematycznych."
                            }
                        },
                        {
                            "text": "He is certainly no <w>slouch</w> at playing the piano after years of practice.",
                            "target_lang_translations": {
                                "pl": "Z pewnością <w>nie jest amatorem</w> w grze na pianinie po latach ćwiczeń."
                            }
                        }
                    ],
                    "synonyms": [
                        "idler",
                        "loafer",
                        "laggard",
                        "underachiever"
                    ],
                    "antonyms": [
                        "achiever",
                        "go-getter"
                    ],
                    "common_phrases": [
                        "no slouch"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba leniwa lub niekompetentna w danej dziedzinie"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "leń",
                                "target_lang_sense_clarification": "osoba unikająca pracy"
                            },
                            {
                                "target_lang_word": "nieudacznik",
                                "target_lang_sense_clarification": "osoba słaba w danej dziedzinie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}