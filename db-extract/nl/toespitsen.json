                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d0f7b23-ec91-3241-bf9c-a214af362d63",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To make deep or deeper"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700d8cc0-5b8b-4fe7-bf59-9d005dd35dab",
                                                "sense_id": "9d0f7b23-ec91-3241-bf9c-a214af362d63",
                                                "text": "They deepened the well by 200 feet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2632c78-a7f5-33b5-91ba-adb53094d092",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To make darker or more intense; to darken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f74dd41-cb92-4c7b-949a-93959f17ac14",
                                                "sense_id": "b2632c78-a7f5-33b5-91ba-adb53094d092",
                                                "text": "The event deepened the prevailing gloom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e3769a-b367-3ff0-ae0b-2150c823fb25",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To make more poignant or affecting; to increase in degree"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f82ab4a-555a-4cf8-b8b1-7fa0468fc027",
                                                "sense_id": "b2e3769a-b367-3ff0-ae0b-2150c823fb25",
                                                "text": "News of her death deepened my sorrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2742c9d4-f583-33a9-9b8e-a62bf370eb7e",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To make lower in tone"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be400a62-b81d-4ed2-8b93-ae14ad90e684",
                                                "sense_id": "2742c9d4-f583-33a9-9b8e-a62bf370eb7e",
                                                "text": "The tuner deepened the tone of the organ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3286beba-c030-33d4-9699-c9846de1b0fa",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To make more thorough or extensive."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "917fa081-2b8e-4d97-a3a1-e0fd49666184",
                                                "sense_id": "3286beba-c030-33d4-9699-c9846de1b0fa",
                                                "text": "The class deepened my understanding of the subject."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c09aecc4-d35c-339f-9f81-0bfd18df010e",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To make more intimate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "248a1377-026f-4807-8441-b9e4a898bb80",
                                                "sense_id": "c09aecc4-d35c-339f-9f81-0bfd18df010e",
                                                "text": "The shared experiences deepened our relationship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce8532de-2fd1-382f-a49f-7c70518542f9",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To make more sound or heavy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2197a71-ca37-4422-8563-9d9a3e21f33c",
                                                "sense_id": "ce8532de-2fd1-382f-a49f-7c70518542f9",
                                                "text": "The hypnotist then proceeded to deepen his trance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0134157a-f01b-3242-a2a3-1f61dc5de8ea",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To become deeper"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9faf31f-a0bc-4c7b-9cdd-61f1db749169",
                                                "sense_id": "0134157a-f01b-3242-a2a3-1f61dc5de8ea",
                                                "text": "The water deepens as you go toward the middle of the channel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5c693d8-5b35-38ad-a2a9-257cf876c742",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To become darker or more intense"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b60c90dc-d6fc-44a5-9fe9-add81c6ab41b",
                                                "sense_id": "a5c693d8-5b35-38ad-a2a9-257cf876c742",
                                                "text": "The crisis deepened in the following weeks."
                                            },
                                            {
                                                "example_id": "f459ab7d-2576-4e81-a642-1890f804dc67",
                                                "sense_id": "a5c693d8-5b35-38ad-a2a9-257cf876c742",
                                                "text": "We may be pardoned our nostalgia, those of us who can remember the old days, the days before the grouping and before standardisation, when we see, as today we see so often, the derelict and abandoned buildings of what were once railway stations, for the life which they used to enjoy we lived with them. There they stand, today, as the dusk deepens about them, lampless, cold and deserted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7ffdd17-ed32-3552-bd6b-f9d63ff1036a",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To become lower in tone"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8915310b-b49e-45ad-8fc7-61dffda51071",
                                                "sense_id": "d7ffdd17-ed32-3552-bd6b-f9d63ff1036a",
                                                "text": "His voice deepened with age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0124a47-1742-3871-8a3a-43511c252cab",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To become more thorough or extensive."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871272f9-4396-4160-935e-4a7b40d0cae7",
                                                "sense_id": "f0124a47-1742-3871-8a3a-43511c252cab",
                                                "text": "His skill in deciphering the texts deepened with practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe88fcee-0920-39dd-aeb1-4bf2a63f85a4",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To become more intimate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45dfd3f2-4a92-4bd5-99e5-05b26b82b919",
                                                "sense_id": "fe88fcee-0920-39dd-aeb1-4bf2a63f85a4",
                                                "text": "The conversation deepened and they began to truly share."
                                            },
                                            {
                                                "example_id": "86df1f27-db9b-4aad-b8b7-9e723d89a251",
                                                "sense_id": "fe88fcee-0920-39dd-aeb1-4bf2a63f85a4",
                                                "text": "He's in the process of breaking up with one boyfriend, who refuses to let their relationship deepen, and courting another, who promises to be somebody with whom he could grow old."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4065572-0f23-3baa-a118-b244cbdf04b1",
                                        "entry_id": "8bf2e311-750d-3cba-b8b6-7df0900090b8",
                                        "glosses": [
                                            "To become more sound or heavy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8dc75a3-46b1-453e-a751-f2031cdfa24e",
                                                "sense_id": "c4065572-0f23-3baa-a118-b244cbdf04b1",
                                                "text": "The new bed allowed my sleep to deepen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
