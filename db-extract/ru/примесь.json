                                "target_senses": [
                                    {
                                        "sense_id": "79ef0e16-19dd-3406-a229-c8cd4f260075",
                                        "entry_id": "3b69009d-b275-38a7-a6ff-697eb30b807d",
                                        "glosses": [
                                            "An instance of admixing, a mixing in of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db6f396c-5a4d-49ad-850d-9611c98896f1",
                                                "sense_id": "79ef0e16-19dd-3406-a229-c8cd4f260075",
                                                "text": "The admixture of vanilla extract in the dough improved the pastries' flavor."
                                            },
                                            {
                                                "example_id": "d9c44976-6d35-4c2e-8737-64c0722e85e9",
                                                "sense_id": "79ef0e16-19dd-3406-a229-c8cd4f260075",
                                                "text": "Gas analysis of blood samples, obtained from different sites in the heart and great vessels, permits demonstration of admixture of oxygenated blood in the venous side or admixture of venous blood in the arterial side of the circulation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91552d1c-7bcb-352e-8dbc-238b5385be56",
                                        "entry_id": "3b69009d-b275-38a7-a6ff-697eb30b807d",
                                        "glosses": [
                                            "An instance of admixing, a mixing in of something.",
                                            "A mixing-in of a biologically or genetically differentiated group to an established stock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8551c5c9-08c6-4446-90b7-09473ef6613a",
                                                "sense_id": "91552d1c-7bcb-352e-8dbc-238b5385be56",
                                                "text": "[…] the wood still flourished high and dense, all of fir on the land side, but towards the sea with a large admixture of live oaks."
                                            },
                                            {
                                                "example_id": "9359c402-8209-49d1-952c-99c9847028f5",
                                                "sense_id": "91552d1c-7bcb-352e-8dbc-238b5385be56",
                                                "text": "Both were lean, raw-boned specimens; the man tall, sandy, and grey-eyed, and the woman short and rather dark, with a black straightness of hair suggesting a slight Indian admixture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45cfcd0a-c430-3c03-9cc3-38d10f4c0734",
                                        "entry_id": "3b69009d-b275-38a7-a6ff-697eb30b807d",
                                        "glosses": [
                                            "A mixture, in some contexts"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed2478fa-71c8-373b-bcbb-51d6d8861cd3",
                                        "entry_id": "3b69009d-b275-38a7-a6ff-697eb30b807d",
                                        "glosses": [
                                            "A mixture, in some contexts:",
                                            "a mixture composed of entities retaining their individual properties."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1fcc693-468c-4f17-9df2-c6468a7bd4ee",
                                                "sense_id": "ed2478fa-71c8-373b-bcbb-51d6d8861cd3",
                                                "text": "Background EEG demonstrates an admixture of theta and delta waves."
                                            }
                                        ]
                                    }
                                ]
