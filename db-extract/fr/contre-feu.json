        "fr-extract.jsonl": [
            {
                "entry_id": "20b599eb-939a-3310-9cf7-265d2ecc3c00",
                "word": "contre-feu",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fd9653dd-db6a-471a-993b-1fb54364b16f",
                        "entry_id": "20b599eb-939a-3310-9cf7-265d2ecc3c00",
                        "tags": [
                            "plural"
                        ],
                        "form": "contre-feux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd75afd4-94ba-3d33-918c-a773f2a5bcce",
                        "entry_id": "20b599eb-939a-3310-9cf7-265d2ecc3c00",
                        "glosses": [
                            "Plaque de fonte ou contre-mur garnissant le fond de l’âtre d’une cheminée, pour préserver le mur voisin de l’activité du feu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a3098ff-5ff7-493f-b72a-0637f4655a0d",
                                "sense_id": "cd75afd4-94ba-3d33-918c-a773f2a5bcce",
                                "text": "Le fond vertical, le contre-feu, est carrelé ou briqueté pour éviter que les pierres du mur ne se fendillent."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4172649-e090-354d-a6e0-3401a534caa3",
                        "entry_id": "20b599eb-939a-3310-9cf7-265d2ecc3c00",
                        "glosses": [
                            "Feu qu’on allume pour circonscrire un incendie."
                        ],
                        "tags": [
                            "Lutte contre l’incendie"
                        ],
                        "examples": [
                            {
                                "example_id": "2af339e0-01ad-4d1c-a2cd-34276a897e3f",
                                "sense_id": "f4172649-e090-354d-a6e0-3401a534caa3",
                                "text": "Un contre-feu est appelé ainsi car il brûle la végétation contre le vent vers l’incendie principal qui vient sur lui."
                            },
                            {
                                "example_id": "826e1d9a-c2f0-4aea-9cac-c7221d758a98",
                                "sense_id": "f4172649-e090-354d-a6e0-3401a534caa3",
                                "text": "En effet, on peut comprendre facilement qu’un contre-feu mal maîtrisé, peut avoir des conséquences dramatiques. Théoriquement, seuls les pompiers sont habilités à déclencher ce qu’ils appellent « le feu tactique »."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ad687f5-b09d-368d-99ba-27f1108aa1c6",
                        "entry_id": "20b599eb-939a-3310-9cf7-265d2ecc3c00",
                        "glosses": [
                            "Polémique déclenchée pour semer le doute ou faire diversion."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "74fb0258-6506-483d-8ba3-1488237dc484",
                                "sense_id": "8ad687f5-b09d-368d-99ba-27f1108aa1c6",
                                "text": "Les pompidoliens soutiennent d'abord l'éphémère candidature du Premier ministre, Pierre Messmer, qui expédie les affaires courantes. Mais ce contre-feu fait long feu. Messmer renonce. Les pompidoliens vont alors favoriser l'homme qui a fait tomber le général en 1969, l'antéchrist du gaullisme : Valéry Giscard d'Estaing."
                            },
                            {
                                "example_id": "6aeff4c6-4cf6-476c-ad39-9723f6de0da3",
                                "sense_id": "8ad687f5-b09d-368d-99ba-27f1108aa1c6",
                                "text": "Plus tard, on se souvient des contre-feux allumés dans certains médias prompts à croire en l’innocence du ministre."
                            },
                            {
                                "example_id": "db161361-3a3c-4eed-a9a0-f6de0c8d1332",
                                "sense_id": "8ad687f5-b09d-368d-99ba-27f1108aa1c6",
                                "text": "D’innombrables contre-feux sont allumés, alimentant un débat sans fin, à l’heure où celui-ci devrait être clos."
                            }
                        ]
                    }
                ],
