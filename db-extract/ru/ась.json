        "ru-extract.jsonl": [
            {
                "entry_id": "a6d46343-e8df-3bf2-83f2-5707b6af8530",
                "word": "ась",
                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ebd30943-3613-362c-8710-23d8c3291b3c",
                        "entry_id": "a6d46343-e8df-3bf2-83f2-5707b6af8530",
                        "glosses": [
                            "прост. или шутл. употребляется как вопросительный отклик при ответе и переспрашивании или как понуждение к ответу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a8e0041-0594-4843-bd9e-103e217a507f",
                                "sense_id": "ebd30943-3613-362c-8710-23d8c3291b3c",
                                "text": "— А признавайтесь-ка, даром что у нас, так сказать, затишье, ведь недурно и у нас, ась?"
                            },
                            {
                                "example_id": "d7b651bc-fd74-4254-bf30-6d212c6b79c8",
                                "sense_id": "ebd30943-3613-362c-8710-23d8c3291b3c",
                                "text": "— Дя-дя! — тихо позвал он. — Ась? — торопливо отозвался Терентий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91764576-9f82-4555-82ae-2ed9c90e5358",
                        "source_entry_id": "a6d46343-e8df-3bf2-83f2-5707b6af8530",
                        "source_sense_id": "ebd30943-3613-362c-8710-23d8c3291b3c",
                        "target_lang_word": "huh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90cd4bba-d0d1-3929-9419-02080e41a45e",
                                        "entry_id": "cf4dbf9a-a1e2-3ac0-ba7f-e5d339e59935",
                                        "glosses": [
                                            "Used to express doubt or confusion."
                                        ],
                                        "tags": [
                                            "with rising pitch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56229434-d94f-4500-b5f0-b9b31a98442a",
                                                "sense_id": "90cd4bba-d0d1-3929-9419-02080e41a45e",
                                                "text": "Huh? Where did they go?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc3e3635-a1ef-3d13-babd-43484a3f004f",
                                        "entry_id": "cf4dbf9a-a1e2-3ac0-ba7f-e5d339e59935",
                                        "glosses": [
                                            "Used to express amusement or subtle surprise."
                                        ],
                                        "tags": [
                                            "with falling pitch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7601a9f5-c0ea-40f4-8f5c-cedc65340d83",
                                                "sense_id": "bc3e3635-a1ef-3d13-babd-43484a3f004f",
                                                "text": "Huh! I'm sure I locked it when I left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c72748d8-93f1-3db5-b9be-2e8d5cc3a8e2",
                                        "entry_id": "cf4dbf9a-a1e2-3ac0-ba7f-e5d339e59935",
                                        "glosses": [
                                            "Used to reinforce a question."
                                        ],
                                        "tags": [
                                            "with rising pitch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a3ba891-ef59-4f17-8645-f9f3d0bef1f9",
                                                "sense_id": "c72748d8-93f1-3db5-b9be-2e8d5cc3a8e2",
                                                "text": "Where were you last night? Huh?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a92b237a-5281-37b8-9672-0fb2ce9420a2",
                                        "entry_id": "cf4dbf9a-a1e2-3ac0-ba7f-e5d339e59935",
                                        "glosses": [
                                            "Used either to belittle the issuer of a statement/question, or sarcastically to indicate utter agreement, and that the statement being responded to is an extreme understatement. The intonation is changed to distinguish between the two meanings - implied dullness for belittlement, and feigned surprise for utter agreement."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c581ca5e-3dc2-4e30-a8f0-c9a9a537a9f0",
                                                "sense_id": "a92b237a-5281-37b8-9672-0fb2ce9420a2",
                                                "text": "(belittlement) A: \"We should go to an amusement park, it would be fun.\" B: \"Huh.\""
                                            },
                                            {
                                                "example_id": "959ff84c-116b-4f44-bcf8-c671f1ce96e3",
                                                "sense_id": "a92b237a-5281-37b8-9672-0fb2ce9420a2",
                                                "text": "(agreement) A: \"Murder is bad.\" B: \"Huh!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0ab64e7-0735-3147-9223-b156433d07ea",
                                        "entry_id": "cf4dbf9a-a1e2-3ac0-ba7f-e5d339e59935",
                                        "glosses": [
                                            "Used to indicate that one did not hear what was said."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47a1c384-9244-495a-acfe-0dce243658b4",
                                                "sense_id": "a0ab64e7-0735-3147-9223-b156433d07ea",
                                                "text": "Huh? Could you speak up?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b43ee27-ee63-3fe4-a5c3-5db958974fd0",
                                        "entry_id": "cf4dbf9a-a1e2-3ac0-ba7f-e5d339e59935",
                                        "glosses": [
                                            "Used to create a tag question."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c08f422-98e4-4ebd-aeeb-d5b938bc06de",
                                                "sense_id": "8b43ee27-ee63-3fe4-a5c3-5db958974fd0",
                                                "text": "It's getting kind of late, huh?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "769dda06-a40c-3f83-ac8c-1036454e5c77",
                                        "entry_id": "cf4dbf9a-a1e2-3ac0-ba7f-e5d339e59935",
                                        "glosses": [
                                            "Representing the sound of heavy breathing."
                                        ],
                                        "tags": [
                                            "onomatopoeic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5689c42e-fa40-4db4-9877-7cfcfdc652cc",
                                                "sense_id": "769dda06-a40c-3f83-ac8c-1036454e5c77",
                                                "text": "He broke into a dogtrot and ran by us. I don't think he saw us. His voice was coming in little puffs, huh, huh, huh, but he probably didn't notice that either."
                                            },
                                            {
                                                "example_id": "b135d047-31f0-479a-ad3c-d72740621f66",
                                                "sense_id": "769dda06-a40c-3f83-ac8c-1036454e5c77",
                                                "text": "It was up so many flights of stairs that people would arrive for meetings drenched in sweat: \"They were like huh huh huh [panting] - where the hell are you?!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "059bccfa-0b3a-3175-b40b-3ba2c9258d26",
                                        "entry_id": "cf4dbf9a-a1e2-3ac0-ba7f-e5d339e59935",
                                        "glosses": [
                                            "Representing a chuckling sound."
                                        ],
                                        "tags": [
                                            "onomatopoeic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14ca8099-4b01-48d8-89ba-0f2c0425359f",
                                                "sense_id": "059bccfa-0b3a-3175-b40b-3ba2c9258d26",
                                                "text": "Mr. [Lambert] Wilson says this with a soft chuckle, sounding a bit like huh huh huh."
                                            },
                                            {
                                                "example_id": "55570448-a552-4661-b88e-472f002725fc",
                                                "sense_id": "059bccfa-0b3a-3175-b40b-3ba2c9258d26",
                                                "text": "Helen starts laughing, properly now. Huh-huh-huh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70ea5e52-98f2-3dfd-a818-03217334bdc2",
                                        "entry_id": "cf4dbf9a-a1e2-3ac0-ba7f-e5d339e59935",
                                        "glosses": [
                                            "A kiai, shouted as a limb is swung in attack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fb3d51b-2d95-420b-b41f-b4408308f07f",
                                                "sense_id": "70ea5e52-98f2-3dfd-a818-03217334bdc2",
                                                "text": "Shawn quickly turns around and punches the pale hand, yelling \"Huh! Huh! Hi yah'! Huh! Get off me! Yeah!\""
                                            },
                                            {
                                                "example_id": "12113e80-7201-44a8-a3c5-1e75087fd9b4",
                                                "sense_id": "70ea5e52-98f2-3dfd-a818-03217334bdc2",
                                                "text": "He gets out of the chair, whips off his jacket, and starts closing in on the camera, punching rapidly as he moves. A left hook, a right jab. \"Hey, I'm a boxer and a marine! So don't mess with me, man! Semper fi! Marine Corps! They better not mess with me! My critics better not mess with me, man, 'cause I'm gonna beat you up. Huh, huh, huh, huh, huh. Hmm, hmmm, hmm, hmmmm, heeeyah, huh, huh. Hmmm, yeah!\""
                                            },
                                            {
                                                "example_id": "50b101e8-e56a-4da5-8f8d-aaa19143f797",
                                                "sense_id": "70ea5e52-98f2-3dfd-a818-03217334bdc2",
                                                "text": "Student A has both arms outstretched in a karate motion and shouts out \"HUH\". Student B receives the sound by putting both arms straight in the air and yelling \"HUH\". Students on either side of B give B a karate chop by miming a sideways karate chop — without any touching."
                                            },
                                            {
                                                "example_id": "05790244-12ac-4992-99ef-21c1a2ecf208",
                                                "sense_id": "70ea5e52-98f2-3dfd-a818-03217334bdc2",
                                                "text": "HUH-HUH, HI-YAH!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb40ec2a-0b40-4613-8be5-f87136de9bde",
                        "source_entry_id": "a6d46343-e8df-3bf2-83f2-5707b6af8530",
                        "source_sense_id": "ebd30943-3613-362c-8710-23d8c3291b3c",
                        "target_lang_word": "hein",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hein",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "145ef078-f360-3f11-b8b6-7708f97cd256",
                                        "entry_id": "cbe50cc8-c5a6-3b2b-a7e9-5372b1c9aaee",
                                        "glosses": [
                                            "Dont on accompagne une interrogation ou une phrase qui exprime l’étonnement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fadac1d6-73bf-446f-bbc0-271c54761d42",
                                                "sense_id": "145ef078-f360-3f11-b8b6-7708f97cd256",
                                                "text": "« Scientifique », « scientifique », est-ce que j'ai la ganache d'Albert Einstein ? Hein ? Vous faites chier, à pénave comme des branques tout l’temps !"
                                            },
                                            {
                                                "example_id": "ea9e850d-dfea-4087-b0c4-8998673cc1f6",
                                                "sense_id": "145ef078-f360-3f11-b8b6-7708f97cd256",
                                                "text": "Hein, que dites-vous donc là?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d63ed465-0788-399c-bdd2-07c952ce316e",
                                        "entry_id": "cbe50cc8-c5a6-3b2b-a7e9-5372b1c9aaee",
                                        "glosses": [
                                            "Il s’emploie seul, pour indiquer que l’on n’a pas entendu ou compris et que l’on invite l’interlocuteur à répéter."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16cc301a-ba78-4ce3-bb7a-aebe47ef07ca",
                                                "sense_id": "d63ed465-0788-399c-bdd2-07c952ce316e",
                                                "text": "— Yfauparldstinctemnt.\n— Hein ?\n— Tu vois ! Il faut parler distinctement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37b07ae9-c04f-3586-a9df-3cdb5494f8fc",
                                        "entry_id": "cbe50cc8-c5a6-3b2b-a7e9-5372b1c9aaee",
                                        "glosses": [
                                            "S’emploie pour attirer l’attention, susciter l’approbation ou bien des questions."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40ed004e-6f05-4e4d-b304-34d815c6d7d9",
                                                "sense_id": "37b07ae9-c04f-3586-a9df-3cdb5494f8fc",
                                                "text": "— C’est l’équipe du Brésil, ça ?\n— Oui, c’est l’équipe du Brésil.\n— Ils sont super, hein ?\n— Oui, ils sont super.\n— Bon, eh ben salut, alors."
                                            },
                                            {
                                                "example_id": "936ee2f0-3be4-43d6-a827-cf82619462aa",
                                                "sense_id": "37b07ae9-c04f-3586-a9df-3cdb5494f8fc",
                                                "text": "C’est bon hein ? Mais, c’est pas franchement nouveau quand on sait qu’une pléiade de légumes peut ainsi se déguster rôtis."
                                            },
                                            {
                                                "example_id": "ac1ec147-4088-4a7a-b978-ae12d5a3fe12",
                                                "sense_id": "37b07ae9-c04f-3586-a9df-3cdb5494f8fc",
                                                "text": "Elle le dit à la fois comme une affirmation et comme une question : Elle est partie, hein."
                                            },
                                            {
                                                "example_id": "f01c90eb-95b9-4741-adb4-b724f3c7716d",
                                                "sense_id": "37b07ae9-c04f-3586-a9df-3cdb5494f8fc",
                                                "text": "Ça y est, p'tit frère, cette fois-ci c'est pour de vrai… Fini la chasse aux pintades ! Mais pas de panique, hein, et attends bien les ordres avant de tirer, il faut que ces diables rouges soient suffisamment près. Une fois que ça sera parti, ça va être le festival de la gâchette. Tu tires, tu recharges, tu tires, etc. On va se faire un carton !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "a7cea9ac-52f7-4f5d-81e2-ab8fda4003e7",
                        "source_entry_id": "a6d46343-e8df-3bf2-83f2-5707b6af8530",
