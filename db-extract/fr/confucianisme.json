        "fr-extract.jsonl": [
            {
                "entry_id": "23c84d07-3354-3eb9-9af0-5f5a1248635a",
                "word": "confucianisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9f4e0ecb-7b15-4887-a9d3-4bd12d6214cc",
                        "entry_id": "23c84d07-3354-3eb9-9af0-5f5a1248635a",
                        "tags": [
                            "plural"
                        ],
                        "form": "confucianismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a99a6cb2-7307-37b5-8f85-4a68049b5fd7",
                        "entry_id": "23c84d07-3354-3eb9-9af0-5f5a1248635a",
                        "glosses": [
                            "Doctrine que l’on peut tirer de l’ensemble de l’œuvre de Confucius."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd80726-4030-425c-9c52-73758e405dde",
                                "sense_id": "a99a6cb2-7307-37b5-8f85-4a68049b5fd7",
                                "text": "Concernant plus spécialement la manière dont le confucianisme imprègne les principes éthico-moraux dans les réalités des mentalités et comportements, j’ai attiré l’attention sur la particularité du Sud Viêt Nam dans le processus de modernisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3c5e803-9f3c-3310-bf74-f96fc28a456b",
                        "entry_id": "23c84d07-3354-3eb9-9af0-5f5a1248635a",
                        "glosses": [
                            "Religion qui met en pratique la philosophie de Confucius."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e926a27f-5125-4965-b63b-6227c1761d84",
                                "sense_id": "c3c5e803-9f3c-3310-bf74-f96fc28a456b",
                                "text": "… fournit un cadre officiel au dialogue interreligieux et à la coopération entre les six religions officiellement reconnues par l’État Indonésien : islam, catholicisme, protestantisme, hindouisme, bouddhisme et confucianisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50a53054-d8d9-4862-a80e-fa1716c8f68b",
                        "source_entry_id": "23c84d07-3354-3eb9-9af0-5f5a1248635a",
                        "target_lang_word": "Konfuzianismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konfuzianismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5db5b2ed-5abb-3ae2-97b7-d83f723e4809",
                                        "entry_id": "8f5d00a1-c4cc-3ee5-88dc-ad76c04fa67c",
                                        "glosses": [
                                            "Lehre und Philosophie des Chinesen Konfuzius"
                                        ],
                                        "tags": [
                                            "Staatsideologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c799ade-7744-4be9-ae98-069b645d7485",
                                                "sense_id": "5db5b2ed-5abb-3ae2-97b7-d83f723e4809",
                                                "text": "„Die Regierungsform Nordkoreas ist stalinistisch, hat zugleich tiefreligiöse Züge und viel vom Konfuzianismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75380683-84c7-4db3-b293-fb8940c0803e",
                        "source_entry_id": "23c84d07-3354-3eb9-9af0-5f5a1248635a",
                        "target_lang_word": "Confucianism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Confucianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fbd4ddd-95cf-32b4-9829-ebca073f1ce2",
                                        "entry_id": "0a9982fe-fa5e-3428-a070-e3bdf5ca4396",
                                        "glosses": [
                                            "The philosophy and teaching of Confucius, which emphasizes self-cultivation, collective harmony, righteousness and the family structure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "161335d3-c445-4258-ac3e-f70799accc22",
                                                "sense_id": "2fbd4ddd-95cf-32b4-9829-ebca073f1ce2",
                                                "text": "A third important part of Confucianism is the concept of chun tzu or \"ideal gentlemanly behavior.\" Confucius believed that the ideal man \"is kind and upholds moral principles. He is a man who loves learning, who is calm and perfectly at ease and constantly careful of his own conduct, believing that by example he has great influence over society.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2654095-b9f2-3a75-9d97-922f5a0a5fe3",
                                        "entry_id": "0a9982fe-fa5e-3428-a070-e3bdf5ca4396",
                                        "glosses": [
                                            "The school of thought and philosophy centered on Confucian principles, originating in China, including later teachings of scholars such as Zhu Xi (Chu Hsi)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76ae9a1c-a921-4c7d-9354-e26726fedd06",
                                                "sense_id": "f2654095-b9f2-3a75-9d97-922f5a0a5fe3",
                                                "text": "The Chinese New Year holiday period, being disrupted this year by the outbreak of a viral illness, has evolved over more than 3,000 years to become the most important of China’s traditional festivals.\nAs celebrated in China and in many other places where its known as the Lunar New Year, it is largely a secular holiday, yet it includes rituals and traditions that derive from Confucianism, Buddhism and Taoism, as well as from ancient myths and folk religions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f0dc84f-9e08-378c-98ef-7620bfdde2e4",
                                        "entry_id": "0a9982fe-fa5e-3428-a070-e3bdf5ca4396",
                                        "glosses": [
                                            "A saying, epithet or idea attributed to Confucius."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
