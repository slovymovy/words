                ],
                "translations": [
                    {
                        "translation_id": "d9a1244b-4a3a-4d22-b53c-be2252b9e45e",
                        "source_entry_id": "eb52e73f-4374-3c40-b096-152341592e95",
                        "source_sense_id": "5d67f989-eead-3b2c-bc10-bbd90cbc0c75",
                        "source_sense_description": "magnetische onregelmatigheid aan de oppervlakte van de zon die vanaf de aarde te zien is als een wat donkere vlek",
                        "target_lang_word": "太阳黑子",
