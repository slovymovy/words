                "senses": [
                    {
                        "sense_id": "f835a65b-0148-3d5b-a187-94a3d1fad909",
                        "entry_id": "e9c0df54-52ea-3063-97fb-345d8f242b47",
                        "glosses": [
                            "To make dim; to obscure or darken."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fb60c88c-89cb-46f9-8680-67642c325c26",
                                "sense_id": "f835a65b-0148-3d5b-a187-94a3d1fad909",
                                "text": "[…] by whose aid, / Weak masters though ye be, I have bedimm’d / The noontide sun […]"
                            },
                            {
                                "example_id": "646fbe4c-580c-4d28-ad86-fc0c6a033868",
                                "sense_id": "f835a65b-0148-3d5b-a187-94a3d1fad909",
                                "text": "Now I recenter my immortal mind / In the deep sabbath of meek self-content; / Cleans'd from the vaporous passions that bedim / God's Image, sister of the Seraphim."
                            },
                            {
                                "example_id": "9476b331-629a-4bf6-aa9f-80b19427912b",
                                "sense_id": "f835a65b-0148-3d5b-a187-94a3d1fad909",
                                "text": "Often, when all was dry, the heavens cloudless, and I was parched by thirst, a slight cloud would bedim the sky, shed the few drops that revived me, and vanish."
                            },
                            {
                                "example_id": "01ff79fd-7141-4cf9-96e0-e0d43b6832d7",
                                "sense_id": "f835a65b-0148-3d5b-a187-94a3d1fad909",
                                "text": "Read in thy New Testament and elsewhere,—if, with floods of mealymouthed inanity, with miserable froth-vortices of Cant now several centuries old, thy New Testament is not all bedimmed for thee."
                            },
                            {
                                "example_id": "1683d269-ea6d-4e1e-9842-00c9df829a4d",
                                "sense_id": "f835a65b-0148-3d5b-a187-94a3d1fad909",
                                "text": "\"Your voice is sad whene'er you speak / and tears bedim your loving eyes.\""
                            },
                            {
                                "example_id": "224df5e5-0ec0-4813-8be8-de4424abeb0b",
                                "sense_id": "f835a65b-0148-3d5b-a187-94a3d1fad909",
                                "text": "There will be no folly, nor laughter, nor bedimming of truth […]"
                            }
                        ]
                    }
                ],
