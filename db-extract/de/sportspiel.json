                ],
                "senses": [
                    {
                        "sense_id": "6e9b6c29-fedd-34da-ac13-935fcf61b14c",
                        "entry_id": "7a45d06c-ab28-31bc-ae3b-b517a0a7f59a",
                        "glosses": [
                            "unter Leistungsansprüchen und dem Wettkampfgedanken betriebenes Bewegungsspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff4bfbcc-e1a3-4db5-9690-bec20b22e663",
                                "sense_id": "6e9b6c29-fedd-34da-ac13-935fcf61b14c",
                                "text": "„So dürfte es in hohem Maße von der Aufgeschlossenheit und der Beteiligung der Eltern abhängen, ob die Bewegungsspiele des 4-bis 6-jährigen Kindes in ein Interesse für Sportspiele übergehen.“"
                            },
                            {
                                "example_id": "429cd2ff-e6dd-41f8-aa9d-cbd3e2bbe716",
                                "sense_id": "6e9b6c29-fedd-34da-ac13-935fcf61b14c",
                                "text": "„Insgesamt zeichnen sich alle Sportspiele durch das für den Sport typische und auch interessante Wettkampfprinzip aus.“"
                            },
                            {
                                "example_id": "44eaf2f9-fb44-4e9a-b4ab-9f50923d72d4",
                                "sense_id": "6e9b6c29-fedd-34da-ac13-935fcf61b14c",
                                "text": "„Das hohe Maß an Gewalt in den Sportspielen wird oft mit dem Argument verteidigt, dass hier mit extremem Einsatz gekämpft werde und übermäßige Gewaltbereitschaft sich im Kampfspiel sich relativ leicht entladen, kanalisieren und entschärfen lasse.“"
                            },
                            {
                                "example_id": "58aec2d7-bb1b-4aa8-ad12-b3779cc3c5ea",
                                "sense_id": "6e9b6c29-fedd-34da-ac13-935fcf61b14c",
                                "text": "„Die entwickelte Spielwelt des Sportspiels ist eine Spielwelt, die Entscheidungen im Rahmen vorgegebener Spielregeln verlangt und die zu taktischem Handeln zwingt.“"
                            },
                            {
                                "example_id": "6e036e85-131f-4757-9089-ce1e2ce5391f",
                                "sense_id": "6e9b6c29-fedd-34da-ac13-935fcf61b14c",
                                "text": "„„Pausen gibt es für die Fans von Sportspielen nicht.“"
                            },
                            {
                                "example_id": "1309d65d-1dfa-4232-8ac6-1fb0950fcfa5",
                                "sense_id": "6e9b6c29-fedd-34da-ac13-935fcf61b14c",
                                "text": "„Er spielt selbst gern Abenteuer oder Sportspiele“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
