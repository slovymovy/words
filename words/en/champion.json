{
    "word_family": [
        "championship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6fe1a4aa-afb9-37a0-beb3-ff4c199c3173",
                    "sense_definition": "A person or team that has won a competition or contest.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "winner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defending <w>champion</w> is expected to defeat his challenger in the final match.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что действующий <w>чемпион</w> победит своего соперника в финальном матче."
                            }
                        },
                        {
                            "text": "He became a world <w>champion</w> after winning the tournament last night.",
                            "target_lang_translations": {
                                "ru": "Он стал <w>чемпионом</w> мира, выиграв турнир вчера вечером."
                            }
                        }
                    ],
                    "common_phrases": [
                        "world champion",
                        "defending champion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или команда, победившие в соревновании или конкурсе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чемпион",
                                "target_lang_sense_clarification": "победитель в спорте или играх"
                            },
                            {
                                "target_lang_word": "победитель",
                                "target_lang_sense_clarification": "тот, кто одержал верх в борьбе или конкурсе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1797cd37-0fb5-3ab9-9f23-400019dfc100",
                    "sense_definition": "A person who vigorously supports or fights for a particular cause or principle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "advocate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Emmeline Pankhurst was a <w>champion</w> of women's suffrage throughout her life.",
                            "target_lang_translations": {
                                "ru": "Эммелин Панкхёрст на протяжении всей своей жизни была <w>защитницей</w> избирательного права для женщин."
                            }
                        },
                        {
                            "text": "The senator is a known <w>champion</w> of human rights in the region.",
                            "target_lang_translations": {
                                "ru": "Сенатор является известным <w>поборником</w> прав человека в регионе."
                            }
                        }
                    ],
                    "synonyms": [
                        "paladin"
                    ],
                    "common_phrases": [
                        "champion of rights",
                        "champion of justice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который активно поддерживает или борется за определенное дело или принцип."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поборник",
                                "target_lang_sense_clarification": "активный защитник или сторонник идеи"
                            },
                            {
                                "target_lang_word": "защитник",
                                "target_lang_sense_clarification": "тот, кто оберегает или отстаивает чьи-то интересы"
                            },
                            {
                                "target_lang_word": "борец",
                                "target_lang_sense_clarification": "тот, кто борется за что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92f53516-6734-3544-927d-41156db17647",
                    "sense_definition": "Someone who fights or speaks on behalf of another person or group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "advocate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a <w>champion</w> of the poor in his local community.",
                            "target_lang_translations": {
                                "ru": "В своей общине он был известен как <w>заступник</w> бедных."
                            }
                        },
                        {
                            "text": "The lawyer acted as a <w>champion</w> for the families affected by the disaster.",
                            "target_lang_translations": {
                                "ru": "Адвокат выступил <w>защитником</w> семей, пострадавших от катастрофы."
                            }
                        }
                    ],
                    "synonyms": [
                        "paladin"
                    ],
                    "common_phrases": [
                        "champion of the poor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто сражается или выступает от имени другого человека или группы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защитник",
                                "target_lang_sense_clarification": "представитель интересов группы людей"
                            },
                            {
                                "target_lang_word": "заступник",
                                "target_lang_sense_clarification": "тот, кто вступается за кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2dcc06e-9b2c-3511-a9fb-6018aa48559e",
                    "sense_definition": "A plant that is a particularly large or notable example of its species.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He found a new <w>champion</w> tree while searching the forest for red maples.",
                            "target_lang_translations": {
                                "ru": "Он нашел новое дерево-<w>рекордсмен</w>, когда искал красные клены в лесу."
                            }
                        },
                        {
                            "text": "This magnificent elm was named the <w>champion</w> for its impressive size.",
                            "target_lang_translations": {
                                "ru": "Этот величественный вяз был признан <w>чемпионом</w> за свои впечатляющие размеры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "champion tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение, являющееся особенно крупным или выдающимся экземпляром своего вида."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекордсмен",
                                "target_lang_sense_clarification": "выдающийся экземпляр по размеру или возрасту"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2c39c91-44aa-3834-803d-8f9b64779f94",
                    "sense_definition": "To publicly support, promote, or fight for a cause or idea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization continues to <w>champion</w> the cause of environmental protection.",
                            "target_lang_translations": {
                                "ru": "Организация продолжает <w>отстаивать</w> дело защиты окружающей среды."
                            }
                        },
                        {
                            "text": "She decided to <w>champion</w> the new policy despite the initial criticism.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>поддержать</w> новую политику, несмотря на первоначальную критику."
                            }
                        }
                    ],
                    "common_phrases": [
                        "champion a cause",
                        "champion the rights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публично поддерживать, продвигать или бороться за какую-либо идею или дело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстаивать",
                                "target_lang_sense_clarification": "защищать интересы или идеи"
                            },
                            {
                                "target_lang_word": "защищать",
                                "target_lang_sense_clarification": "выступать в поддержку чего-либо"
                            },
                            {
                                "target_lang_word": "продвигать",
                                "target_lang_sense_clarification": "способствовать развитию или признанию идеи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a00f6d5-e145-3b74-89d5-bc45b01d9b48",
                    "sense_definition": "Having won first place in a competition or being of the highest quality.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>champion</w> bodybuilder spent years training for this specific event.",
                            "target_lang_translations": {
                                "ru": "<w>Титулованный</w> бодибилдер годами тренировался для этого конкретного события."
                            }
                        },
                        {
                            "text": "They produced a <w>champion</w> breed of horses known for their speed.",
                            "target_lang_translations": {
                                "ru": "Они вывели <w>чемпионскую</w> породу лошадей, известную своей скоростью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "champion breed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занявший первое место в соревновании или обладающий высочайшим качеством."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чемпионский",
                                "target_lang_sense_clarification": "относящийся к чемпиону или достойный его"
                            },
                            {
                                "target_lang_word": "первоклассный",
                                "target_lang_sense_clarification": "высшего качества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c2a7c2b-03c4-3ae3-804b-01926bf98a7d",
                    "sense_definition": "Excellent, brilliant, or deserving of high praise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That rollercoaster was <w>champion</w> and we want to go again.",
                            "target_lang_translations": {
                                "ru": "Те американские горки были просто <w>класс</w>, мы хотим прокатиться еще раз."
                            }
                        },
                        {
                            "text": "He did a <w>champion</w> job fixing the broken fence yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера он <w>отлично</w> справился с починкой сломанного забора."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in British English dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, блестящий или заслуживающий высокой похвалы (разговорное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отличный",
                                "target_lang_sense_clarification": "очень хороший"
                            },
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "превосходно выполненный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cce23a71-1a86-3755-a217-8043f5710aa5",
                    "sense_definition": "A common English family name.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Champion</w> is the new head of the history department.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Чемпион</w> — новый заведующий кафедрой истории."
                            }
                        },
                        {
                            "text": "The author's last name is <w>Champion</w> according to the book cover.",
                            "target_lang_translations": {
                                "ru": "Согласно обложке книги, фамилия автора — <w>Чемпион</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Чемпион",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "470093b4-b3db-3ca4-8c6e-fa813485184f",
                    "sense_definition": "The name of several towns and communities in North America.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They moved to a small town called <w>Champion</w> in New York.",
                            "target_lang_translations": {
                                "ru": "Они переехали в небольшой городок под названием <w>Чемпион</w> в штате Нью-Йорк."
                            }
                        },
                        {
                            "text": "The village of <w>Champion</w> is located in Vulcan County.",
                            "target_lang_translations": {
                                "ru": "Деревня <w>Чемпион</w> расположена в округе Вулкан."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название нескольких городов и населенных пунктов в Северной Америке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Чемпион",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}