{
    "word": "microbiome",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b0208fde-c944-3562-bc1f-fc59f05c9dcc",
                "word": "microbiome",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6a327b98-d4d0-472f-8b72-64bb171d04b7",
                        "entry_id": "b0208fde-c944-3562-bc1f-fc59f05c9dcc",
                        "tags": [
                            "plural"
                        ],
                        "form": "microbiomes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75907d3d-6de9-3e65-a83b-d507fe523cc9",
                        "entry_id": "b0208fde-c944-3562-bc1f-fc59f05c9dcc",
                        "glosses": [
                            "The genetic information (genomes) of a microbiota."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8daed5ea-6b68-4f44-8565-fa9b2acc7fcc",
                                "sense_id": "75907d3d-6de9-3e65-a83b-d507fe523cc9",
                                "text": "The human microbiota consists of the 10-100 trillion symbiotic microbial cells harbored by each person, primarily bacteria in the gut; the human microbiome consists of the genes these cells harbor."
                            },
                            {
                                "example_id": "c9fc8462-9eea-4faf-ae9a-95bff8b66956",
                                "sense_id": "75907d3d-6de9-3e65-a83b-d507fe523cc9",
                                "text": "Your body’s microbiome is all the genes your microbiota contains, however colloquially the two terms are often used interchangeably."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cd53635-a10f-36e4-95d3-99cbc6a52877",
                        "entry_id": "b0208fde-c944-3562-bc1f-fc59f05c9dcc",
                        "glosses": [
                            "A microbial biome, such as the community of microbes within the human gut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5853017b-d6a1-4430-89ec-7a52fad663b5",
                                "sense_id": "5cd53635-a10f-36e4-95d3-99cbc6a52877",
                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                            },
                            {
                                "example_id": "3c25e4b3-8fe3-4bbd-afa8-d6798fe16cac",
                                "sense_id": "5cd53635-a10f-36e4-95d3-99cbc6a52877",
                                "text": "The microbiome creates the immediate environment for our genes as they play out their part in disease mechanisms."
                            },
                            {
                                "example_id": "7a438129-71f3-4ded-a2e6-c4c8584ce6e8",
                                "sense_id": "5cd53635-a10f-36e4-95d3-99cbc6a52877",
                                "text": "Yes, there are microbes everywhere and most are just fine for us, perhaps even beneficial to our microbiomes and immune systems. We don’t care about those."
                            },
                            {
                                "example_id": "cbf1f4fa-b425-4458-b72a-e6d5bc55f975",
                                "sense_id": "5cd53635-a10f-36e4-95d3-99cbc6a52877",
                                "text": "For your community of microbes— your 'microbiome' — your body is a planet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa4c0e53-c004-4f1c-b852-3a1a7a1fdcb7",
                        "source_entry_id": "b0208fde-c944-3562-bc1f-fc59f05c9dcc",
                        "source_sense_description": "Translations",
                        "target_lang_word": "microbiome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microbiome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae7cab7-9929-33e9-a803-b5a02bd1f595",
                                        "entry_id": "86f83fb0-f5a2-3393-bed1-ca7ef6579609",
                                        "glosses": [
                                            "Aire biotique (de vie) du microbiote, c’est-à-dire de l’ensemble des espèces microbiennes durablement adaptées à la surface et à l’intérieur d’un organisme vivant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1211f0d6-ab22-3bb5-87a0-b5ab98b1ec30",
                                        "entry_id": "86f83fb0-f5a2-3393-bed1-ca7ef6579609",
                                        "glosses": [
                                            "Somme des génomes des micro-organismes vivant dans ou sur un organisme animal ou végétal, exception faite des états pathologiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "586f52a1-4295-422e-a5fa-a5376e685f56",
                                                "sense_id": "1211f0d6-ab22-3bb5-87a0-b5ab98b1ec30",
                                                "text": "Elle pense toutefois que le microbiome (la flore intestinale) pourrait y être pour quelque chose."
                                            },
                                            {
                                                "example_id": "97119397-5af7-4c27-baba-a6623d980a8d",
                                                "sense_id": "1211f0d6-ab22-3bb5-87a0-b5ab98b1ec30",
                                                "text": "Certains scientifiques appellent l’ensemble des génomes de nos petits invités le microbiome qui, combiné à notre génome, constitue le métagénome humain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97c4d000-2805-4451-8a58-df17be63952e",
                        "source_entry_id": "b0208fde-c944-3562-bc1f-fc59f05c9dcc",
                        "source_sense_description": "Translations",
