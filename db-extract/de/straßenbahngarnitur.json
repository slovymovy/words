                "senses": [
                    {
                        "sense_id": "706b1e8c-d182-34ba-b672-d3192c674421",
                        "entry_id": "ab93b7a0-3ef8-3663-a2ab-369b5b03e9db",
                        "glosses": [
                            "schienengebundenes meist innerstädtisches Verkehrsmittel auf auch von Kraftfahrzeugen benutzten Verkehrswegen aus mehreren Wagen bestehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbb3a6d9-a76d-4f32-9b51-3857d461dea0",
                                "sense_id": "706b1e8c-d182-34ba-b672-d3192c674421",
                                "text": "„Während dieser dort hielt, wurde die Verkehrslichtanlage für den Fahrzeugverkehr in der Billrothstraße auf Grünlicht geschaltet, der Straßenbahnfahrer hat wegen des Fahrgastwechsels jedoch die Fahrt nicht sofort aufgenommen, sondern die Straßenbahngarnitur stand zunächst mit geöffneten Türen in der Haltestelle.“"
                            },
                            {
                                "example_id": "848f5bfa-7969-4497-b770-7529639815e8",
                                "sense_id": "706b1e8c-d182-34ba-b672-d3192c674421",
                                "text": "„Eine Straßenbahngarnitur ist gegen Mitternacht in Linz mit einem Auto zusammengeprallt.“"
                            },
                            {
                                "example_id": "eebcbf40-ae55-4a07-9b76-f99bd24601e3",
                                "sense_id": "706b1e8c-d182-34ba-b672-d3192c674421",
                                "text": "„Der Fahrer der inzwischen völlig leeren Straßenbahngarnitur hatte die Zeichen der Zeit rascher erkannt und bimmelte bereits heftig, um die Fahrgäste wieder an Bord zu locken.“"
                            },
                            {
                                "example_id": "79a4f80b-8319-4b1c-ba4b-f3e9ce564025",
                                "sense_id": "706b1e8c-d182-34ba-b672-d3192c674421",
                                "text": "„Nach der Auslieferung der bis zu 156 Straßenbahngarnituren umfassenden Tranche wurde diesmal - anders als zu ULF-Zeiten - keine vertragliche Option auf weitere Züge festgeschrieben.“"
                            },
                            {
                                "example_id": "82b74228-f7a3-4c9e-916f-fdf7ef7a2bd1",
                                "sense_id": "706b1e8c-d182-34ba-b672-d3192c674421",
                                "text": "„Die Serie E2, das sind jene mittelalten Straßenbahngarnituren, bei denen die untersten Stufen, auch ‚Schwenkstufen‘ genannt, in der Station ausfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
