    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8c040f68-35ba-318b-beb1-e76c839670bf",
                    "sense_definition": "Having a pleasant, friendly, and likeable nature; kind-hearted and easy to get along with.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "friendly_disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was an <w>amiable</w> host who made everyone feel welcome and comfortable.",
                            "target_lang_translations": {
                                "ru": "Она была <w>приветливой</w> хозяйкой, благодаря которой каждый чувствовал себя желанным гостем и чувствовал себя комфортно."
                            }
                        },
                        {
                            "text": "Despite his intimidating size, he proved to be an <w>amiable</w> person with a gentle laugh.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свои внушительные размеры, он оказался <w>добродушным</w> человеком с мягким смехом."
                            }
                        }
                    ],
                    "synonyms": [
                        "likable"
                    ],
                    "antonyms": [
                        "unfriendly",
                        "hostile"
                    ],
                    "common_phrases": [
                        "amiable person",
                        "amiable host"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий приятным, дружелюбным и привлекательным характером; добродушный и легкий в общении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добродушный",
                                "target_lang_sense_clarification": "о характере человека"
                            },
                            {
                                "target_lang_word": "приветливый",
                                "target_lang_sense_clarification": "о поведении и отношении к людям"
                            },
                            {
                                "target_lang_word": "любезный",
                                "target_lang_sense_clarification": "вежливый и приятный в общении"
                            },
                            {
                                "target_lang_word": "дружелюбный",
                                "target_lang_sense_clarification": "расположенный к другим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc3bb8ae-d5f1-3131-9696-09cd3bacbd73",
                    "sense_definition": "Characterized by warmth, friendliness, or goodwill; gracious and sweet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "friendly_disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two neighbors maintained an <w>amiable</w> relationship for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Двое соседей поддерживали <w>дружеские</w> отношения на протяжении более двадцати лет."
                            }
                        },
                        {
                            "text": "They reached an <w>amiable</w> agreement after a brief and polite discussion.",
                            "target_lang_translations": {
                                "ru": "Они пришли к <w>мирному</w> соглашению после короткого и вежливого обсуждения."
                            }
                        }
                    ],
                    "synonyms": [
                        "likable"
                    ],
                    "antonyms": [
                        "disagreeable"
                    ],
                    "common_phrases": [
                        "amiable relationship",
                        "amiable agreement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся теплотой, дружелюбием или доброжелательностью; любезный и приятный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дружелюбный",
                                "target_lang_sense_clarification": "об отношениях или атмосфере"
                            },
                            {
                                "target_lang_word": "мирный",
                                "target_lang_sense_clarification": "о соглашении или решении"
                            },
                            {
                                "target_lang_word": "дружественный",
                                "target_lang_sense_clarification": "о связях и отношениях"
                            },
                            {
                                "target_lang_word": "приятельский",
                                "target_lang_sense_clarification": "неофициальный и теплый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
