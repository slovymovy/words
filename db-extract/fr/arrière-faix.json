                                "target_senses": [
                                    {
                                        "sense_id": "50907c6b-a6b3-328b-8a1d-42336f702dad",
                                        "entry_id": "1358d845-6457-3f86-869c-57e12492196d",
                                        "glosses": [
                                            "letzte Phase der Geburt; Ausstoßung der Plazenta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8979c2-f587-41cb-b74c-37e0623f2d8f",
                                                "sense_id": "50907c6b-a6b3-328b-8a1d-42336f702dad",
                                                "text": "Bei der Nachgeburt wird die Plazenta ausgestoßen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "464118b5-45be-352b-bcff-c60dc24e395d",
                                        "entry_id": "1358d845-6457-3f86-869c-57e12492196d",
                                        "glosses": [
                                            "Ergebnis der letzten Geburtsphase; der Mutterkuchen samt Nabelschnur und Allem, was da noch so mitkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3daca293-e49e-4efe-871f-0fc7a8e5be12",
                                                "sense_id": "464118b5-45be-352b-bcff-c60dc24e395d",
                                                "text": "Sie ließ sich ihre Nachgeburt verpacken und nahm sie mit nach Hause."
                                            },
                                            {
                                                "example_id": "e4e6e6a7-a235-4bce-b632-b2c44784bb3e",
                                                "sense_id": "464118b5-45be-352b-bcff-c60dc24e395d",
                                                "text": "Die meisten Tiere fressen die Nachgeburt auf."
                                            },
                                            {
                                                "example_id": "b4bc5145-1e46-437a-9cfe-068b708dbd2e",
                                                "sense_id": "464118b5-45be-352b-bcff-c60dc24e395d",
                                                "text": "„Als die Nachgeburt eingegraben worden war, kochte sie ein Beruhigungssüppchen und ließ Väsele Li etwas davon zu sich nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c1d4812-9698-4fa6-aff1-a27b18ce41d0",
