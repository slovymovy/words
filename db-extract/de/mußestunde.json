                "senses": [
                    {
                        "sense_id": "f58b7d00-289e-39aa-b9fa-c0169086d059",
                        "entry_id": "cf6cfefb-5709-38b4-9b05-96d8d4db28b4",
                        "glosses": [
                            "ruhige Stunde, in der man ohne Rücksicht auf irgendwelche Pflichten tun oder lassen kann, was man möchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c863c5-539c-4b18-8da9-6b7974d46b9b",
                                "sense_id": "f58b7d00-289e-39aa-b9fa-c0169086d059",
                                "text": "„Der junge Mann teilt seine Mußestunden zwischen Künstlerkreisen, Mondänitäten, dem Theater, den Konzerten und dem Zeichnen.“"
                            },
                            {
                                "example_id": "42ed657f-5cbd-454a-add2-07b6d6a6d2e6",
                                "sense_id": "f58b7d00-289e-39aa-b9fa-c0169086d059",
                                "text": "„Die Gedichtsammlung aller lateinischen Poeten, die mir der Marchese Mosca-Barzi geschickt hatte, studierte ich erst in den Mußestunden, die ich in Acona hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
