                ],
                "senses": [
                    {
                        "sense_id": "dbc224ee-2141-310b-9ba5-cbfd30566e89",
                        "entry_id": "a9a49029-66cb-3bb6-93d8-888e8287480e",
                        "glosses": [
                            "Buch mit Liedern und Liedtexten, vor allem für religiöse Zwecke (Verwendung im Gottesdienst)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7b935d-b8e2-4713-8271-5af092f21390",
                                "sense_id": "dbc224ee-2141-310b-9ba5-cbfd30566e89",
                                "text": "Sie sangen Lied Nr. 240 aus dem evangelischen Gesangbuch."
                            },
                            {
                                "example_id": "07f05155-00ee-4d67-862b-f2cdcc90bb1d",
                                "sense_id": "dbc224ee-2141-310b-9ba5-cbfd30566e89",
                                "text": "„Das so lange erwartete gemeinsame Gebet- und Gesangbuch für die katholischen Gemeinden im deutschen Sprachbereich, das »Gotteslob«, liegt nun vor.“"
                            },
                            {
                                "example_id": "6f52dd4f-b02c-48c8-bff9-a3868ebda709",
                                "sense_id": "dbc224ee-2141-310b-9ba5-cbfd30566e89",
                                "text": "„Das Gesangbuch ist wie alles im Land komplett zweisprachig geschrieben, in Inuktitut und Dänisch.“"
                            },
                            {
                                "example_id": "a8335ef9-cc86-4d47-8289-c85fafb12a42",
                                "sense_id": "dbc224ee-2141-310b-9ba5-cbfd30566e89",
                                "text": "„Aber dann kam eine Reihe von Jahren, daß sie Bibel und Gesangbuch weglegte, nicht mehr zur Kirche finden konnte und ihre Ohren verschloß, wenn der Pastor, bald mit Milde, bald mit Strenge, auf sie einredete.“"
                            },
                            {
                                "example_id": "a9e1db6e-884f-4e4c-9ca5-f510f35a6f98",
                                "sense_id": "dbc224ee-2141-310b-9ba5-cbfd30566e89",
                                "text": "„So kann man es in einem älteren Gesangbuch lesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14fb31b7-72ab-41ef-8bd5-2476daa55ee9",
                        "source_entry_id": "a9a49029-66cb-3bb6-93d8-888e8287480e",
                        "source_sense_id": "dbc224ee-2141-310b-9ba5-cbfd30566e89",
                        "source_sense_description": "Buch mit Liedern und Liedtexten, vor allem für religiöse Zwecke (Verwendung im Gottesdienst)",
                        "target_lang_word": "songbook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "songbook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d733f541-e3be-3efe-8bac-2e4bab83bea0",
                                        "entry_id": "93e3668a-28fa-3dbb-8e60-7830aa36c6bd",
                                        "glosses": [
                                            "A book containing songs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c7a8953-ba69-4a27-92fe-d71180832bf9",
                                                "sense_id": "d733f541-e3be-3efe-8bac-2e4bab83bea0",
                                                "text": "Some of the young folks asked Mrs. Long could they have a sing at her home that Sunday afternoon; she readily agreed, telling them to come early, bring their songbooks, and have a good sing."
                                            },
                                            {
                                                "example_id": "790b76f4-262d-4aeb-acea-33d83b0c718e",
                                                "sense_id": "d733f541-e3be-3efe-8bac-2e4bab83bea0",
                                                "text": "In uncritical homage to the heyday of Hollywood musicals, Branagh sets the action in a kind of soundstagey Oxbridge (wittily designed by Tim Harvey) and at crucial moments has his cast spin on their heels and croon American songbook standards by Porter, Kern, Gershwin and company instead of launching into sonnets and masques."
                                            },
                                            {
                                                "example_id": "80343da1-04a2-427f-b264-21def2ba598d",
                                                "sense_id": "d733f541-e3be-3efe-8bac-2e4bab83bea0",
                                                "text": "Wondering how else he passed his time, Winifred surveyed the room again, this time without regard for the monetary value of the things she saw. A box of lutestrings. Five songbooks. But no lute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
