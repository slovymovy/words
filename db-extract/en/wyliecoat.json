                        "entry_id": "8bdfe495-2168-339a-abb5-061b5c16a149",
                        "glosses": [
                            "A heavy vest that is worn to provide warmth."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "0a5f5588-7ea8-46f1-ada9-abdf8bded739",
                                "sense_id": "1872fbca-968c-318c-acea-003d39919ac9",
                                "text": "Wyliecoats, stiffened at the hem and heavily lined with plaiding or scouringis', were made from fustian and grogram."
                            },
                            {
                                "example_id": "35b195b4-e712-42bb-8e9a-f15788a7b98b",
                                "sense_id": "1872fbca-968c-318c-acea-003d39919ac9",
                                "text": "No doubt it was she who made the wyliecoats, possibly for pauper children or orphans but perhaps for sale, and was probably one of many textile craftsmen's wives who added to the family income by sewing."
                            },
                            {
                                "example_id": "19eafe6a-7988-4f33-9401-3f1030dcabc9",
                                "sense_id": "1872fbca-968c-318c-acea-003d39919ac9",
                                "text": "The hearth glowing red with sleepy eyes and he reached for his breeches and put them on and took his wyliecoat off the chair, sleeved it and buttoned it and set towards the door leaving his boots by the bed."
                            }
                        ]
                    }
