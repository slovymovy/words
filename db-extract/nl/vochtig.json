                ],
                "senses": [
                    {
                        "sense_id": "c5014bfe-b1aa-3726-9ad5-38e2fe9c2fdf",
                        "entry_id": "e624cfdd-47ee-3738-8ce3-3d65d4c136f1",
                        "glosses": [
                            "doordrenkt met een zekere hoeveelheid water of waterdamp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "441e7a88-16af-4be1-a822-e768ba0beb86",
                                "sense_id": "c5014bfe-b1aa-3726-9ad5-38e2fe9c2fdf",
                                "text": "Door een kier onder de deur kwamen er steeds sneeuwvlokken naar binnen gewaaid en ik voelde mijn slaapzak langzaam vochtig worden."
                            },
                            {
                                "example_id": "265140ed-4de4-42b6-8cb3-e025265b30a1",
                                "sense_id": "c5014bfe-b1aa-3726-9ad5-38e2fe9c2fdf",
                                "text": "' Ten slotte keek ze me aan en ik zag dat haar ogen vochtig glansden."
                            },
                            {
                                "example_id": "eda5c23e-3757-4f6c-9316-2bd7f47f507a",
                                "sense_id": "c5014bfe-b1aa-3726-9ad5-38e2fe9c2fdf",
                                "text": "Wie had ooit meer dan drie woorden met haar gewisseld in die stank van pis en ongewassen lijf? Ze was een overblijfsel uit de tijd van turf en plaggen, van walmende pitten en vochtig hout, van stro op de vloer, dieren die binnenshuis werden gehouden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75402ed0-0ec8-40ef-96ed-3a2dc54044fb",
                        "source_entry_id": "e624cfdd-47ee-3738-8ce3-3d65d4c136f1",
                        "source_sense_id": "c5014bfe-b1aa-3726-9ad5-38e2fe9c2fdf",
                        "target_lang_word": "humid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ac40e5-360d-39b4-88a8-8c8b024a8d05",
                                        "entry_id": "0c0ecbd2-9dcb-3ed9-b29a-c963daaf6655",
                                        "glosses": [
                                            "Containing perceptible moisture (usually describing air or atmosphere); damp; moist; somewhat wet or watery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1051cab4-936d-48a3-9679-14c3adc994ca",
                                                "sense_id": "c2ac40e5-360d-39b4-88a8-8c8b024a8d05",
                                                "text": "humid earth"
                                            },
                                            {
                                                "example_id": "1ae80a5c-8e7d-43e5-a98d-15dd79638ff9",
                                                "sense_id": "c2ac40e5-360d-39b4-88a8-8c8b024a8d05",
                                                "text": "Evening cloud, or humid bow."
                                            },
                                            {
                                                "example_id": "b4059d0f-2c95-47d3-b34d-ad78b10bb1b9",
                                                "sense_id": "c2ac40e5-360d-39b4-88a8-8c8b024a8d05",
                                                "text": "Soft tears again bedewed my cheeks, and I even raised my humid eyes with thankfulness towards the blessed sun which bestowed such joy upon me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "262327a4-fb28-42fc-9bf2-8d016db41ea7",
                        "source_entry_id": "e624cfdd-47ee-3738-8ce3-3d65d4c136f1",
                        "source_sense_id": "c5014bfe-b1aa-3726-9ad5-38e2fe9c2fdf",
                        "target_lang_word": "humide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b542b10-e9dd-326a-8ef5-b98288fd57fc",
                                        "entry_id": "af269bae-d254-3641-b42e-027a752d47b5",
                                        "glosses": [
                                            "Une des quatre premières qualités, opposée au sec."
                                        ],
                                        "tags": [
