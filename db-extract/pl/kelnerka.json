                "senses": [
                    {
                        "sense_id": "9445e258-b5c0-3aca-83fe-b715c14c7717",
                        "entry_id": "3a1cfb62-055f-33a9-bcfe-22cddc364bdf",
                        "glosses": [
                            "osoba płci żeńskiej przyjmująca w restauracji zamówienie i przynosząca potrawy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fa78a3c-0a2c-4817-8f70-7790798a880a",
                                "sense_id": "9445e258-b5c0-3aca-83fe-b715c14c7717",
                                "text": "Ta kelnerka jest wyjątkowo miła."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "705bb70c-5b6e-4ee0-902e-f86f65faddb8",
                        "source_entry_id": "3a1cfb62-055f-33a9-bcfe-22cddc364bdf",
                        "source_sense_id": "9445e258-b5c0-3aca-83fe-b715c14c7717",
                        "target_lang_word": "waitress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waitress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12e248f3-34df-319b-8bbe-aa2ad429a00a",
                                        "entry_id": "be9c2b65-23c8-3496-8d39-39fbf487925d",
                                        "glosses": [
                                            "A female attendant who serves customers in a restaurant, café, or similar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f46ec8-0e6d-45ea-b106-de486d5712f2",
                                                "sense_id": "12e248f3-34df-319b-8bbe-aa2ad429a00a",
                                                "text": "a waitress in a cocktail bar."
                                            },
                                            {
                                                "example_id": "b0133215-3c6c-4e98-869d-9cd274c10444",
                                                "sense_id": "12e248f3-34df-319b-8bbe-aa2ad429a00a",
                                                "text": "It would take a few more beers, but when the liquid courage kicked in, his wobbly legs were unable to keep pace with the fleetfooted waitress, who rolled her eyes, smiling, and finally twirled away."
                                            },
                                            {
                                                "example_id": "307dfe36-374c-4f00-bce2-b758d53e0e9b",
                                                "sense_id": "12e248f3-34df-319b-8bbe-aa2ad429a00a",
                                                "text": "The chefs never cooked before, the cashiers never cashiered before, the dishwashers never dishwashed before, the waitresses never waitressed before, and the managers never managed before."
                                            },
                                            {
                                                "example_id": "4bccd0b8-2ad8-4b70-ac9a-8af1709dc7cd",
                                                "sense_id": "12e248f3-34df-319b-8bbe-aa2ad429a00a",
                                                "text": "I ask everybody… A waitress, flight attendant… …someone I’m shitting next to on the plane… “You know what my biggest hobby is?” Puking."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "waitress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b162aa7-d99d-3801-b56b-aedba8273d4a",
                                        "entry_id": "e6d74cf4-2998-3dec-bc14-a99fc37fafb5",
                                        "glosses": [
                                            "To work as a waitress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987becd8-28af-460d-bf43-ae44a228fe49",
                                                "sense_id": "7b162aa7-d99d-3801-b56b-aedba8273d4a",
                                                "text": "But it never did heal properly and Lizzie stayed on at the bar — waitressing until she came of legal age to bar-tend."
                                            },
                                            {
                                                "example_id": "d58e019b-d6b0-4ffd-8fca-27c5f40d9c6c",
                                                "sense_id": "7b162aa7-d99d-3801-b56b-aedba8273d4a",
                                                "text": "The chefs never cooked before, the cashiers never cashiered before, the dishwashers never dishwashed before, the waitresses never waitressed before, and the managers never managed before."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a9ab944-f68c-4f29-afd6-8245787f0acb",
                        "source_entry_id": "3a1cfb62-055f-33a9-bcfe-22cddc364bdf",
                        "source_sense_id": "9445e258-b5c0-3aca-83fe-b715c14c7717",
                        "target_lang_word": "camarera",
