                        "examples": [
                            {
                                "example_id": "b1dfb9d7-e40a-420b-8dad-88dd888cf894",
                                "sense_id": "1c8dc018-f7bd-3d04-a4ed-1aed1abbe906",
                                "text": "Die deutsche Industrie hat einen hohen Grad an Automation erreicht."
                            },
                            {
                                "example_id": "d1419fb1-a7e6-43ff-8693-9bc756f08b25",
                                "sense_id": "1c8dc018-f7bd-3d04-a4ed-1aed1abbe906",
                                "text": "„Die Automation, die sich auch bei der Herstellung hochwertiger Kleidung durchsetzt, hat bereits zu einem Rekordverlust an Arbeitsplätzen geführt.“"
                            }
                        ],
