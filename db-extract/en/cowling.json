                                "target_senses": [
                                    {
                                        "sense_id": "3b4f51d8-7c0c-3bfc-92bc-12e6a45e4d8f",
                                        "entry_id": "80621c87-311d-395e-b6d0-91424c3c6c24",
                                        "glosses": [
                                            "Jungtier eines Herdentieres, zum Beispiel von paarhufigen Säugetieren wie den Rindern oder Hirschen, aber auch Elefanten, Giraffen; auch Jungtier von Meeressäugern, also bei Walen und Seekühen; Je nach Tierart ist die Zeit des 'Kalbseins' unterschiedlich lang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63481365-1558-4a2c-8352-50d190a1b8d0",
                                                "sense_id": "3b4f51d8-7c0c-3bfc-92bc-12e6a45e4d8f",
                                                "text": "Das Kalb springt munter auf der Weide herum."
                                            },
                                            {
                                                "example_id": "30e690bc-f20f-4aea-b62a-8d9fe01fe5c1",
                                                "sense_id": "3b4f51d8-7c0c-3bfc-92bc-12e6a45e4d8f",
                                                "text": "„Wichtigstes Haustier war das Rind, das lange gehalten wurde, um Kälber und Milch zu produzieren.“"
                                            },
                                            {
                                                "example_id": "706014f9-b647-48ae-8314-6ef17c310ea4",
                                                "sense_id": "3b4f51d8-7c0c-3bfc-92bc-12e6a45e4d8f",
                                                "text": "„In einer Steuerliste des Jahres 1542 werden immerhin zehn Schweine (darunter drei Ferkel), fünf Kühe, neun Kälber und eine Ziege mit zwei Zicklein aufgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2373e00e-8ee8-3de3-9e04-d08595ea316d",
                                        "entry_id": "80621c87-311d-395e-b6d0-91424c3c6c24",
                                        "glosses": [
                                            "Fleisch vom jungen Rind"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3576a85e-def6-4ca9-a62b-2f26a6082d36",
                                                "sense_id": "2373e00e-8ee8-3de3-9e04-d08595ea316d",
                                                "text": "Zur Zubereitung eines Schnitzels eignet sich Kalb bestens."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aab98eb9-e5a2-3b56-ae1b-bf52521d29bd",
                                        "entry_id": "80621c87-311d-395e-b6d0-91424c3c6c24",
                                        "glosses": [
                                            "alberner, verspielter, einfältiger Mensch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dbc65ca-5f03-46ca-ae0f-7e1334836e17",
                                                "sense_id": "aab98eb9-e5a2-3b56-ae1b-bf52521d29bd",
                                                "text": "Er gebärdet sich manchmal noch wie ein junges Kalb."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b5c8f070-2f33-3a07-ac06-7224eee72800",
                                        "entry_id": "80621c87-311d-395e-b6d0-91424c3c6c24",
