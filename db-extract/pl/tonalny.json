                    },
                    {
                        "sense_id": "5dd376c5-7d3b-3dc8-be93-326457f8712b",
                        "entry_id": "bef0129f-867f-36e2-8560-049673cde8ca",
                        "glosses": [
                            "zróżnicowany pod względem barwy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1a2866-3a36-4871-9d57-e680cb4a50dc",
                                "sense_id": "5dd376c5-7d3b-3dc8-be93-326457f8712b",
                                "text": "Najcharakterystyczniejszym dla fotografiki elementem kompozycji jest barwa, czyli wartości tonalne obrazu, zawarte w skali od tonu białego poprzez szary aż do czarnego"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
