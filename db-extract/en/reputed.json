                            {
                                "example_id": "e69fd9d9-3f7f-44f7-a5ab-3182e3fe7fd3",
                                "sense_id": "748a2ce1-8f96-3315-82be-61e99e669ca6",
                                "text": "He was good to look on, brawly dressed, and with a tongue in his head that would have wiled the bird from the tree. Moreover, he was of gentle kin, and she was a poor lass biding in a cot house with an ill-reputed mother."
                            },
                            {
                                "example_id": "8213b088-56f2-4309-9b46-a815cb27bd56",
                                "sense_id": "748a2ce1-8f96-3315-82be-61e99e669ca6",
                                "text": "The other young ladies of Sulaco stood in awe of her character and accomplishments. She was reputed to be terribly learned and serious."
                            }
                        ]
