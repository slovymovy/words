                    {
                        "sense_id": "63103691-385a-338d-ad10-b804a9d11040",
                        "entry_id": "56c642a5-6bbd-3713-ab4e-4981ee3a1b88",
                        "glosses": [
                            "Geist oder Dämon, der sich in Form einer Katze manifestiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9f35bc8-22d0-4a65-ab51-655927ef2f8b",
                                "sense_id": "63103691-385a-338d-ad10-b804a9d11040",
                                "text": "„Dan sah ich ihn. Der Katzengeist saß auf dem Kaminsims. Ganz deutlich schimmerte er wie ein blasser Nebel. Seine Augen glommen rötlich und waren auf mich gerichtet. Die Ohren waren furchtsam angelegt, und der Schwanz wischte nervös hin und her.“"
                            }
                        ],
