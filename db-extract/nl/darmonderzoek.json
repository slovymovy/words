                "senses": [
                    {
                        "sense_id": "c77cde35-8ce5-38ba-89bd-67ae9a322f12",
                        "entry_id": "3e46db98-44fa-3898-ade6-78f02e5d611b",
                        "glosses": [
                            "onderzoek naar de vorm of het functioneren van de darmen van één patiënt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ff0f514-980a-499b-93ba-1870ae6713b0",
                                "sense_id": "c77cde35-8ce5-38ba-89bd-67ae9a322f12",
                                "text": "Bij het maag- en darmonderzoek wordt soms een cameraatje in het lichaam van de patiënt gebracht. In sommige gevallen wordt daarbij spoelwater gebruikt."
                            },
                            {
                                "example_id": "b35466d6-f880-4022-ae65-81f19a3c2c1d",
                                "sense_id": "c77cde35-8ce5-38ba-89bd-67ae9a322f12",
                                "text": "Intussen waren de organisatoren van de benefietavond druk op zoek naar de winnaar. Enigszins beschaamd vertelde de vrouw dat ze de diamant had ingeslikt. Toevallig moest ze de volgende dag naar het ziekenhuis voor een darmonderzoek. Daarbij werd de diamant teruggevonden."
                            }
                        ]
                    },
                    {
                        "sense_id": "b534bc68-aa8e-3856-b5ab-631699bbe4c4",
                        "entry_id": "3e46db98-44fa-3898-ade6-78f02e5d611b",
                        "glosses": [
                            "wetenschappelijk onderzoek naar darmziekten en darmstoornissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "131d9ef7-58c4-4e41-a09e-71129b701ffd",
                                "sense_id": "b534bc68-aa8e-3856-b5ab-631699bbe4c4",
                                "text": "Stemmen op jouw favoriete darmonderzoek: het is net Idols. Op deze manier probeert de Maag-, Lever- Darmstichting (MLDS) het publiek te betrekken bij het onderzoek naar darmkanker. De kandidaten? Het Erasmus MC en het AMC. De winnaar? Die krijgt 220.000 euro."
                            }
                        ]
                    }
