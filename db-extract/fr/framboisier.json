            {
                "entry_id": "4e410118-bc03-386d-8bed-b435dd200c45",
                "word": "framboisier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "07ea80fe-fee4-423f-a4e6-eefc84ed1a38",
                        "entry_id": "4e410118-bc03-386d-8bed-b435dd200c45",
                        "tags": [
                            "plural"
                        ],
                        "form": "framboisiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de11b3d2-c615-3889-9767-2fe88240f652",
                        "entry_id": "4e410118-bc03-386d-8bed-b435dd200c45",
                        "glosses": [
                            "Arbrisseau de la famille des rosacées, à rameaux garnis d’aiguillons et d’épines, et qui porte les framboises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df96a33c-4814-4128-93cf-61b49b2f2436",
                                "sense_id": "de11b3d2-c615-3889-9767-2fe88240f652",
                                "text": "Des haies de taille plus basse (1 m de haut environ) seront obtenues avec des arbustes comme le framboisier et le groseillier, à réserver à des emplacements mi-ombragés ."
                            }
                        ]
                    },
                    {
                        "sense_id": "514b07f4-c7ba-30b9-a152-3cf0fdecb8b0",
                        "entry_id": "4e410118-bc03-386d-8bed-b435dd200c45",
                        "glosses": [
                            "Gâteau superposant génoise, crème et framboises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43294d65-f81f-4578-be73-c3177adc3dc1",
                                "sense_id": "514b07f4-c7ba-30b9-a152-3cf0fdecb8b0",
                                "text": "Pas d’anniversaire sans gâteau, et c’est le cuisinier de l’établissement qui lui avait confectionné une pâtisserie à la hauteur de son âge. En lui laissant le choix de son gâteau, elle a opté pour un framboisier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1132fbb1-8e9c-4e4e-8cd5-bd54edb8a123",
                        "source_entry_id": "4e410118-bc03-386d-8bed-b435dd200c45",
                        "source_sense_description": "Arbrisseau",
                        "target_lang_word": "Himbeerstrauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Himbeerstrauch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bf6cf39-7ceb-3c3d-b5a0-f7de6447c38f",
                                        "entry_id": "3ea86634-6b26-3b43-a49b-78ee0fcc956e",
                                        "glosses": [
                                            "Gewächs der Pflanzenart Rubus idaeus, an dem Himbeeren wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e66605f9-46ee-4e12-9e1a-39cf2b000de0",
                                                "sense_id": "3bf6cf39-7ceb-3c3d-b5a0-f7de6447c38f",
                                                "text": "„Es gab Himbeersträucher im Park und oft, wenn er und Terry auf ihren Rennrädern dort vorbeikamen, sprangen sie ab und pflückten sich rasch eine Handvoll.“"
