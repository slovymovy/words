                "senses": [
                    {
                        "sense_id": "fb608e74-01a2-325d-9176-693b6207d8f8",
                        "entry_id": "36ecb2ef-9a9a-3e71-b3e7-7be32414f1d4",
                        "glosses": [
                            "Produktionsbetrieb, in dem Strickwaren fabrikmäßig hergestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4926f833-be48-4d5c-b73b-6806a9e9e546",
                                "sense_id": "fb608e74-01a2-325d-9176-693b6207d8f8",
                                "text": "30 Jahre habe ich in einer Strickerei gearbeitet, bis ich das Tempo nicht mehr mithalten konnte."
                            },
                            {
                                "example_id": "8f33c6ed-1f95-45ae-8475-442446bd5ab2",
                                "sense_id": "fb608e74-01a2-325d-9176-693b6207d8f8",
                                "text": "Zwei Strickereien wurden in den Dreißigern in unserem Ort errichtet, eine gibt es heute noch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "700fabd2-ba05-3aba-ab54-9f6fdca6d2af",
                        "entry_id": "36ecb2ef-9a9a-3e71-b3e7-7be32414f1d4",
                        "glosses": [
                            "das Verschlingen eines Fadens mit Stricknadeln"
                        ],
                        "tags": [
                            "Vorgang",
                            "Handlung"
                        ],
                        "examples": [
                            {
                                "example_id": "c1248f3d-b1d3-4dd3-9a13-e2de8c94547b",
                                "sense_id": "700fabd2-ba05-3aba-ab54-9f6fdca6d2af",
                                "text": "Die Strickerei kann manchmal anstregend sein."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e58b3b4e-90f6-3e89-b665-f457d07c0ae6",
                        "entry_id": "36ecb2ef-9a9a-3e71-b3e7-7be32414f1d4",
                        "glosses": [
                            "mit Hilfe der Technik des Strickens hergestelltes Gewebe/Textil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65d76ac6-5acf-4db0-9100-1066964a215c",
                                "sense_id": "e58b3b4e-90f6-3e89-b665-f457d07c0ae6",
                                "text": "Mir gefällt diese bunte Strickerei."
                            }
                        ],
                        "sense_index_json": "\"3\""
