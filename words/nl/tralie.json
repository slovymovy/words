{
    "word_family": [
        "traliën",
        "getralied"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e2f8fd8-7a9f-3208-a0de-f96d47149e45",
                    "sense_definition": "Een houten of metalen spijl waarmee een opening wordt afgesloten, zoals bij een raam of een kooi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "afsluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief wist te ontsnappen door de <w>tralies</w> door te zagen.",
                            "target_lang_translations": {
                                "en": "The thief managed to escape by sawing through the <w>bars</w>."
                            }
                        },
                        {
                            "text": "De vogel zat eenzaam achter de <w>tralies</w> van zijn kooi.",
                            "target_lang_translations": {
                                "en": "The bird sat lonely behind the <w>bars</w> of its cage."
                            }
                        }
                    ],
                    "synonyms": [
                        "spijl",
                        "stang"
                    ],
                    "common_phrases": [
                        "achter de tralies"
                    ],
                    "target_lang_definitions": {
                        "en": "A wooden or metal bar used to close off an opening, such as in a window or a cage."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bar",
                                "target_lang_sense_clarification": "metal or wooden rod"
                            },
                            {
                                "target_lang_word": "grate",
                                "target_lang_sense_clarification": "protective barrier of bars"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbcc5456-dba9-3170-923a-1d3c0075733d",
                    "sense_definition": "Een vlechtwerk of rooster van hout of metaal; latwerk.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "afsluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De klimplanten groeiden weelderig tegen het houten <w>tralie</w> aan.",
                            "target_lang_translations": {
                                "en": "The climbing plants grew lushly against the wooden <w>trellis</w>."
                            }
                        },
                        {
                            "text": "Hij maakte een stevig <w>tralie</w> om de tuin af te bakenen.",
                            "target_lang_translations": {
                                "en": "He made a sturdy <w>lattice</w> to fence off the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "rooster",
                        "traliewerk",
                        "latwerk",
                        "hekwerk"
                    ],
                    "target_lang_definitions": {
                        "en": "A wickerwork or grid of wood or metal; trellis or lattice."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trellis",
                                "target_lang_sense_clarification": "wooden or metal framework for climbing plants"
                            },
                            {
                                "target_lang_word": "lattice",
                                "target_lang_sense_clarification": "interlaced structure of wood or metal"
                            },
                            {
                                "target_lang_word": "grating",
                                "target_lang_sense_clarification": "framework of crossed bars"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5923e47-55a0-3332-84c1-55403b968167",
                    "sense_definition": "Een optisch instrument bestaande uit een plaatje met een groot aantal parallelle lijnen dat diffractie vertoont voor licht.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "optica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het natuurkundelaboratorium gebruikten de studenten een <w>tralie</w> om het spectrum van de lamp te analyseren.",
                            "target_lang_translations": {
                                "en": "In the physics laboratory, the students used a <w>diffraction grating</w> to analyze the spectrum of the lamp."
                            }
                        },
                        {
                            "text": "De diffractie van het laserlicht werd duidelijk zichtbaar door het fijne <w>tralie</w>.",
                            "target_lang_translations": {
                                "en": "The diffraction of the laser light became clearly visible through the fine <w>grating</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "buigingsrooster",
                        "diffractierooster"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "wetenschappelijke term"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An optical instrument consisting of a plate with a large number of parallel lines that exhibits diffraction for light."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "diffraction grating",
                                "target_lang_sense_clarification": "optical component with a periodic structure"
                            },
                            {
                                "target_lang_word": "grating",
                                "target_lang_sense_clarification": "optical physics term"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb8dd075-d6c5-33ec-9ef4-c2e7e5b4816b",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>traliën</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>tralie</w> het raam om de dieven buiten te houden.",
                            "target_lang_translations": {
                                "en": "I <w>bar</w> the window to keep the thieves out."
                            }
                        },
                        {
                            "text": "Als timmerman <w>tralie</w> ik deze opening met houten latten.",
                            "target_lang_translations": {
                                "en": "As a carpenter, I <w>lattice</w> this opening with wooden slats."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "werkwoordsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'traliën' (to bar, to provide with bars/trellis)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bar",
                                "target_lang_sense_clarification": "to fit with bars"
                            },
                            {
                                "target_lang_word": "grate",
                                "target_lang_sense_clarification": "to cover with a grate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "971b9e5d-f68c-35f2-bb44-610eae8c645a",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>traliën</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tralie</w> je de ramen van de kelder vanmiddag nog?",
                            "target_lang_translations": {
                                "en": "Are you going to <w>bar</w> the basement windows this afternoon?"
                            }
                        },
                        {
                            "text": "Waarom <w>tralie</w> je die opening niet voor de veiligheid?",
                            "target_lang_translations": {
                                "en": "Why don't you <w>bar</w> that opening for safety?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "werkwoordsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second person singular present tense of 'traliën' (to bar, to provide with bars/trellis)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bar",
                                "target_lang_sense_clarification": "to fit with bars"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bd6821b-e18c-3b3a-bc25-1f9c8e36c16d",
                    "sense_definition": "Gebiedende wijs van <w>traliën</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tralie</w> dat venster onmiddellijk voordat er vogels naar binnen vliegen!",
                            "target_lang_translations": {
                                "en": "<w>Bar</w> that window immediately before birds fly inside!"
                            }
                        },
                        {
                            "text": "<w>Tralie</w> de kooi goed af, zodat het dier niet kan ontsnappen.",
                            "target_lang_translations": {
                                "en": "<w>Bar</w> the cage well, so that the animal cannot escape."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "werkwoordsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative mood of 'traliën' (to bar, to provide with bars/trellis)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bar",
                                "target_lang_sense_clarification": "to fit with bars"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}