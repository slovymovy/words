                "senses": [
                    {
                        "sense_id": "c2dbfeee-6e5e-3782-865d-bd8cbecd7d80",
                        "entry_id": "c255ead4-ed7f-378d-985a-0c92a5933bc5",
                        "glosses": [
                            "Eigentümer eines sehr großen Unternehmens, eines Firmenimperiums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "370a6218-b812-437b-a62c-cf69fa76dbe8",
                                "sense_id": "c2dbfeee-6e5e-3782-865d-bd8cbecd7d80",
                                "text": "„Arnhold, der sein Vermögen auf den Handel mit Kohle aus den schlesischen Bergbaugebieten gegründet hatte, war Großindustrieller im Kaiserreich und wurde 1913 als einziger Jude ins Preußische Herrenhaus berufen.“"
                            },
                            {
                                "example_id": "0dbacb86-a49d-47f0-9913-92d69d2a19b2",
                                "sense_id": "c2dbfeee-6e5e-3782-865d-bd8cbecd7d80",
                                "text": "„Der Eintretende war ein Großindustrieller, Vorstand einer Fabrik für Maschinenwesen und Kabeldrähte, dem Gordons Ankunft von Bremen her telegraphiert worden war und der nicht säumen wollte, sich ihm vorzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
