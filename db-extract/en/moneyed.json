                                "example_id": "5636c07b-ada9-46f3-b8bd-30b1338079ee",
                                "sense_id": "82bfcf13-2ce6-32b8-b8ca-b8084d1ac944",
                                "text": "Many in these moneyed ranks choose to spend the festival in gas-guzzling luxury RVs."
                            }
