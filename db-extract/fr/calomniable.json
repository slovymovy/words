                        "glosses": [
                            "Qui peut être calomnié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b441812-de85-4b44-aa73-a052f6dd3971",
                                "sense_id": "c04e42f2-73af-37da-b747-9ca83a89410d",
                                "text": "Il vouloit qu’en prison l’on vous traînât aussi ;\nLe peintre & le poëte ont aisément fourni\nUn prétexte assez vraisemblable ;\nMais un musicien n’est point calomniable."
                            },
                            {
                                "example_id": "180ac467-82ff-4a5d-a12e-fcba4d136341",
                                "sense_id": "c04e42f2-73af-37da-b747-9ca83a89410d",
                                "text": "Je ne croyais pas, je l’avoue, administrativement parlant notre directeur calomniable, et cependant me voilà atteint et convaincu de l’avoir calomnié."
                            },
                            {
                                "example_id": "727c93a4-bb04-41b1-b56b-b3025bcb19dc",
                                "sense_id": "c04e42f2-73af-37da-b747-9ca83a89410d",
                                "text": "Un livre, sitôt publié, devient dépeçable, calomniable, diffamable à merci : son écriture et sa structure, son sens évident et ses motivations cachées, tout est livré aux morsures, griffures, coups de bistouri, aux venimeuses piqûres de tout critique qui - parfois d’avance - n’aime pas ou l’auteur ou le genre ou le thème ou le style."
                            }
                        ]
                    }
