                        "glosses": [
                            "Wielding or equipped with a javelin or javelins."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7ba243db-887e-4647-8994-ee28ac170f69",
                                "sense_id": "fad05670-2f71-3701-a1fd-d1b91db65908",
                                "text": "The diamond sun upon thy purple breast / Compares not with the light of my own North / Flashing from ice and snow and javelined men."
                            },
                            {
                                "example_id": "de9dfea6-4520-4735-8179-093374a41827",
                                "sense_id": "fad05670-2f71-3701-a1fd-d1b91db65908",
                                "text": "Think of this, you jolly hog-hunters of India! Regret, when you next ride to pig, with a single spear in your hand, that you did not live in the past, when, if you had gone after the same beast in armour, javelined, and sworded, you might have been a hero."
                            },
                            {
                                "example_id": "43f6aed6-898c-4425-9741-eef1e2c1aab1",
                                "sense_id": "fad05670-2f71-3701-a1fd-d1b91db65908",
                                "text": "Behold, lad, great tidings! Tidings from the hostel. A road for ships. A gleam of javelined men, fían-valorous in their wounding exploits. A great catastrophe. A fair woman upon whom the red embroidery of slaughter has settled. Behold!"
                            }
                        ]
                    }
