                "senses": [
                    {
                        "sense_id": "625037cc-9392-3883-becd-042ecda61357",
                        "entry_id": "1b1e78b9-f437-35c0-89c9-bc8c2ccf4bc1",
                        "glosses": [
                            "durch landeshoheitliche Maßnahmen gesicherter Verkehrsweg"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8b6348f0-e2b1-4baa-afc0-79019c6a5394",
                                "sense_id": "625037cc-9392-3883-becd-042ecda61357",
                                "text": "„Sie ritten über die große Geleitstraße, die durch das Bruch links und rechts der Blies führte, und überquerten bei Limbach den Fluss.“"
                            },
                            {
                                "example_id": "bbb3cb39-1116-435a-a41c-f24c968caa5a",
                                "sense_id": "625037cc-9392-3883-becd-042ecda61357",
                                "text": "„Kein Wunder, daß der Burggraf versuchte, diese Geleitstraße unter seine Kontrolle zu bringen.“"
                            },
                            {
                                "example_id": "e7202222-cb22-46fe-b0a7-31f6134682b3",
                                "sense_id": "625037cc-9392-3883-becd-042ecda61357",
                                "text": "„Ueberdies gehe hier eine kaiserliche Geleitstraße […].“"
                            },
                            {
                                "example_id": "b78d6cc9-0ecc-4c24-905e-24ae4f966aea",
                                "sense_id": "625037cc-9392-3883-becd-042ecda61357",
                                "text": "„Schon bald stieg die Stadt, die an wichtigen sich auf dem Fischmarkt kreuzenden europäischen Handelsstraßen wie der 768 erstmals genannten via regia und der Nürnberger Geleitstraße gelegen war […] zu einer der größten deutschen Handelsmetropolen des Mittelalters auf.“"
                            },
                            {
                                "example_id": "1505c135-baa0-44e2-a20e-297b43c67a5c",
                                "sense_id": "625037cc-9392-3883-becd-042ecda61357",
                                "text": "„Günstige zentrale Lage an der Kreuzung der Hohen Königsstraße (via regia) und der Nürnberger Geleitstraße.“"
                            },
                            {
                                "example_id": "06827a1e-d807-4a4c-a4b3-b4eed9180d36",
                                "sense_id": "625037cc-9392-3883-becd-042ecda61357",
                                "text": "„Über sie verlief eine der bedeutendsten Handelsstraßen des Mittelalters – die Nürnberger Geleitstraße, oder auch Frankenstieg genannt.“"
                            },
                            {
                                "example_id": "4edbe7c6-570d-421b-bcfc-1d0566ae282b",
                                "sense_id": "625037cc-9392-3883-becd-042ecda61357",
                                "text": "„Vermutlich existierte auch um diese Zeit ein viel benutzter Nebenweg zur Würzburger Geleitstraße über Ebrach nach Bamberg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
