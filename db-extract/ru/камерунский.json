                                            {
                                                "example_id": "c7e6e3de-8f4e-43f1-ba3c-171cd43db339",
                                                "sense_id": "9412140a-6d6d-3f5d-90df-ff5cad4051fa",
                                                "text": "Im Vergleich zur Lage in Marokko gilt nach kamerunischem Staatsbürgerschaftsrecht genau der umgekehrte Fall – hier verliert seine kamerunische Nationalität, wer eine weitere erhält."
                                            },
                                            {
                                                "example_id": "047ef879-6520-4bf4-b082-21797e4b8e61",
                                                "sense_id": "9412140a-6d6d-3f5d-90df-ff5cad4051fa",
                                                "text": "„Im Gegensatz zu Falkenhorst und von Puttkamer beruht seine Erfahrung mit der kamerunischen Fremde auf direkter Beobachtung.“"
                                            }
