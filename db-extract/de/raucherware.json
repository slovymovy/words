                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52470177-5bc4-4eab-bf17-5ee57d38ac28",
                                "sense_id": "8497feea-df48-36ee-b8b0-2fc1fc8b3fc2",
                                "text": "„Grund sind die neu vorgeschriebenen Warnhinweise auf Raucherwaren über die Gefahren des Rauchens.“"
                            },
                            {
                                "example_id": "b0083a74-7fe2-4df0-a49c-7610db58a7c9",
                                "sense_id": "8497feea-df48-36ee-b8b0-2fc1fc8b3fc2",
                                "text": "„‚Spice‘ wurde neben seiner Funktion als Raucherware hauptsächlich als – legaler Ersatz für Cannabis verkauft.“"
                            },
                            {
                                "example_id": "899a3f56-5357-4a72-b004-58bd4de23e27",
                                "sense_id": "8497feea-df48-36ee-b8b0-2fc1fc8b3fc2",
                                "text": "„Nein, der würde mir bestimmt keine Raucherware anbieten.“"
                            },
                            {
                                "example_id": "a88a179e-04e8-473d-863a-03d7d5745bc1",
                                "sense_id": "8497feea-df48-36ee-b8b0-2fc1fc8b3fc2",
                                "text": "„Das Fräulein zündete eine Zigarette an – ausgesprochen männliche Raucherware, französische Régie-Zigaretten: Gauloises.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
