                ],
                "senses": [
                    {
                        "sense_id": "d9933bd0-8987-3827-b652-6a415188a942",
                        "entry_id": "c7c70180-c219-3f5f-9892-671bc28e8925",
                        "glosses": [
                            "Heftigkeit, Intensität eines Spielgeschehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6007005-5215-4616-b416-54efdb9ecbfb",
                                "sense_id": "d9933bd0-8987-3827-b652-6a415188a942",
                                "text": "„Aufs Ganze gesehen besitzen Kooperationsspiele meist eine geringere Spieldynamik und können, wiederholt gespielt, rasch langweilig werden.“"
                            },
                            {
                                "example_id": "9670563e-7d48-4628-89c2-5d95eddc6c7b",
                                "sense_id": "d9933bd0-8987-3827-b652-6a415188a942",
                                "text": "„Entscheidend für die Wirkung auf die Spieler war weniger der thematische Bezug, seien es Kriegs- oder Sportspiele, sondern die Spieldynamik, […].“"
                            },
                            {
                                "example_id": "081c0b33-7145-40f5-b80f-db0d98e23eeb",
                                "sense_id": "d9933bd0-8987-3827-b652-6a415188a942",
                                "text": "„Es soll nochmals ausdrücklich danach gefragt werden, ob nicht die Offenheit der Spieldynamik und die Ungerichtetheit des Spiels auf einen spezifischen Spieltrieb zurückgeführt werden können.“"
                            },
                            {
                                "example_id": "51c6fadf-b83b-42b0-aa4f-8c1f785a1af3",
                                "sense_id": "d9933bd0-8987-3827-b652-6a415188a942",
                                "text": "„Bedeutsam ist vor allem, ob Spielzeug spielmotivierend wirkt, Spieldynamik erlaubt und dauerhaft Spielfreude vermittelt.“"
                            },
                            {
                                "example_id": "b6990e71-3b73-45f4-9e58-450f4c783f12",
                                "sense_id": "d9933bd0-8987-3827-b652-6a415188a942",
                                "text": "„In die Spieldynamik seiner Elf müsse noch mehr Kontinuität einfließen, referierte Real-Trainer Del Bosque selbstkritisch, die Abwehr dürfe sich nicht immer wieder eine Auszeit gönnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
