    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ab6f4961-4b1d-3095-9daf-1c1f44285f36",
                "word": "misfigure",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2022a45d-9084-4ad8-9ec8-26e6131bf796",
                        "entry_id": "ab6f4961-4b1d-3095-9daf-1c1f44285f36",
                        "tags": [
                            "plural"
                        ],
                        "form": "misfigures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7222acf8-0959-3372-a2e8-a1a4c2437157",
                        "entry_id": "ab6f4961-4b1d-3095-9daf-1c1f44285f36",
                        "glosses": [
                            "An incorrect figure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05815b57-49f3-4b3b-9ee8-b26d8383f61c",
                                "sense_id": "7222acf8-0959-3372-a2e8-a1a4c2437157",
                                "text": "All the uncertainties and misfigures of plans like this profit the agents and the companies, never the insured."
                            },
                            {
                                "example_id": "5cfe5e16-b6cc-4de8-b93a-b626530828d5",
                                "sense_id": "7222acf8-0959-3372-a2e8-a1a4c2437157",
                                "text": "There are misprints and misfigures and misnames in it."
                            },
                            {
                                "example_id": "e2f24792-8baf-404a-a4dc-45dca57a0b6a",
                                "sense_id": "7222acf8-0959-3372-a2e8-a1a4c2437157",
                                "text": "The machine cannot reason; the machine cannot know emotion; it is a mere receptacle of facts and misfigures."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd9403d1-02c7-3e1c-b35b-de599bd83df2",
                        "entry_id": "ab6f4961-4b1d-3095-9daf-1c1f44285f36",
                        "glosses": [
                            "The misfigured portion of an optical surface, or the presence of such a portion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e13430-bdd9-41a0-8e8a-283eec941ac3",
                                "sense_id": "bd9403d1-02c7-3e1c-b35b-de599bd83df2",
                                "text": "Should the element be misfigured, then these aberrations would be combined with the actual misfigure."
                            },
                            {
                                "example_id": "02beb0b8-3689-4214-869a-0d941a16a4ae",
                                "sense_id": "bd9403d1-02c7-3e1c-b35b-de599bd83df2",
                                "text": "Compensation for optical surface misfigure was provided by a phase conjugating mirror to construct a phase conjugated transmitter subsystem."
                            },
                            {
                                "example_id": "fcf5795d-3e46-4f15-aab4-cbdaef839cec",
                                "sense_id": "bd9403d1-02c7-3e1c-b35b-de599bd83df2",
                                "text": "In most systems, the optical misfigure can be at least partially corrected by focussing at one wavelength."
                            },
                            {
                                "example_id": "f1b4a998-f5bb-468c-bc42-051322705d15",
                                "sense_id": "bd9403d1-02c7-3e1c-b35b-de599bd83df2",
                                "text": "For primitive it may seem, this test is exquisitely sensitive to surface misfigure, and will immediately reveal errors that may escape the most modern metrology."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "01c2bda6-07ba-3cf4-bdcf-62875a2e6f9f",
                "word": "misfigure",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1f2b0aad-fbb9-4245-b7d4-8188bccfc22e",
                        "entry_id": "01c2bda6-07ba-3cf4-bdcf-62875a2e6f9f",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "misfigures"
                    },
                    {
                        "form_id": "0ab32dc9-23dd-43a0-a808-a45f962c309b",
                        "entry_id": "01c2bda6-07ba-3cf4-bdcf-62875a2e6f9f",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "misfiguring"
                    },
                    {
                        "form_id": "3b148381-d268-478f-9aec-abd4b6455b9c",
                        "entry_id": "01c2bda6-07ba-3cf4-bdcf-62875a2e6f9f",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "misfigured"
                    },
                    {
                        "form_id": "99b652f0-9bc7-44ed-b122-15e252d51b8f",
                        "entry_id": "01c2bda6-07ba-3cf4-bdcf-62875a2e6f9f",
                        "tags": [
                            "past"
                        ],
                        "form": "misfigured"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "844206c1-5617-3f5a-9ada-b5f0b519f6c1",
                        "entry_id": "01c2bda6-07ba-3cf4-bdcf-62875a2e6f9f",
                        "glosses": [
                            "To miscalculate; to make a computational error."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c63c6964-61e7-4c84-a233-bc5e26a3abda",
                                "sense_id": "844206c1-5617-3f5a-9ada-b5f0b519f6c1",
                                "text": "But you make another mistake — you misfigure dates again — and you've got something more to answer for."
                            },
                            {
                                "example_id": "65abd57c-d8b3-45d8-9fb2-1793cb0b1f74",
                                "sense_id": "844206c1-5617-3f5a-9ada-b5f0b519f6c1",
                                "text": "You're a Gray-Area Misfigurer when you misfigure accidentally on purpose. Say your 100 shares of a $20 stock go up to $22, so you claim bragging rights to 10% profits. However, when you figure in commission, your shares really cost more like $2,050."
                            },
                            {
                                "example_id": "7841338b-499e-4124-8a76-29821a3424cc",
                                "sense_id": "844206c1-5617-3f5a-9ada-b5f0b519f6c1",
                                "text": "You might argue about letting borderline students squeak through some courses, but who wants a nurse who misfigures her meds?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f5d9c119-4e58-3b23-8ca4-fffbc6c83a3d",
                        "entry_id": "01c2bda6-07ba-3cf4-bdcf-62875a2e6f9f",
                        "glosses": [
                            "To make an incorrect assessment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d258b32e-2c54-435f-8f0e-e2fdf4118ee0",
                                "sense_id": "f5d9c119-4e58-3b23-8ca4-fffbc6c83a3d",
                                "text": "\"Now, see here, mister, you get right back into that brush, a bargain's a bargain and you're not near the tree yet.\" “But I'se jest—” “Never mind now, you just misfigured a trifle, that's all, and I stay in the open till the tree is reached.”"
                            },
                            {
                                "example_id": "09d4c779-8b97-4c4b-81cb-9207fb79f7d3",
                                "sense_id": "f5d9c119-4e58-3b23-8ca4-fffbc6c83a3d",
                                "text": "And they did and the end began, and all Winkler 's words couldn't stop it: \"Even prophets can misfigure, but the Vision's still true. Christ's still coming . Why leave; life's good here. \""
                            },
                            {
                                "example_id": "b89ae910-6208-4dab-88dc-b9b00fc1caa5",
                                "sense_id": "f5d9c119-4e58-3b23-8ca4-fffbc6c83a3d",
                                "text": "Carter press secretary Jody Powell conceded that “we completely misfigured Ford's ability to pull off his 'Rose Garden campaign.' That was really a surprise to us. They've worked that to perfection.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "a15e913e-0cc9-352c-aa94-bd9b9b93604c",
                        "entry_id": "01c2bda6-07ba-3cf4-bdcf-62875a2e6f9f",
                        "glosses": [
                            "To misrepresent or disguise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52508254-cb63-4362-9933-adb2543ce40f",
                                "sense_id": "a15e913e-0cc9-352c-aa94-bd9b9b93604c",
                                "text": "If M W, at any time seemes to make some slender explication of himselfe in some of these particulars, he soone misfigures againe his owne expression with words of manifest inconsistency therewith: so that the setled judgement of the Author in the Question controverted, must be some where else inquired after, then in his discourse: This I can say of mine own knowledge, that when I was with him, pressing him to know, whither by righteoousnesse of Christ (in his opinion) he meant the righteousnesse of his nature, consisting of inward habits or dispositions of grace and holinesse; or the righteousnesse of his life, consisting of those righteous acts, which he performed in obedience to the Law of God, or whither he included them both, he absolutely denied, that he meant either the one or the other, or both together."
                            },
                            {
                                "example_id": "c48b17a0-3951-4402-84b5-1a20cef9b30a",
                                "sense_id": "a15e913e-0cc9-352c-aa94-bd9b9b93604c",
                                "text": "He may misfigure hissen next time as he likes, I shall knaw him."
                            },
                            {
                                "example_id": "d896044e-6110-47f4-a9cc-a889bd803098",
                                "sense_id": "a15e913e-0cc9-352c-aa94-bd9b9b93604c",
                                "text": "Logically speaking, a parodic reading is either intentionalist or voluntarist: either it presupposes a complicity between the reader and the author in their critical apprehension of the way the parodied discourse misfigures reality, or it is motivated by interests extrinsic to the text for which the reader is accountable."
                            },
                            {
                                "example_id": "dd5b24d3-a567-4bfa-ae6f-9f317c2e7fa9",
                                "sense_id": "a15e913e-0cc9-352c-aa94-bd9b9b93604c",
                                "text": "Western consumer society and media (whether applied to program structure or to the audience's act of viewing) necessarily misfigures the form and significance of the television discourse."
                            },
                            {
                                "example_id": "d87ac800-7397-48c7-b190-8637dcc03a6e",
                                "sense_id": "a15e913e-0cc9-352c-aa94-bd9b9b93604c",
                                "text": "But the violence here is that of being misidentified, of having one's desire misfigured as \"male desire.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "599ebd87-47a4-3958-94b9-604fdd48e6c1",
                        "entry_id": "01c2bda6-07ba-3cf4-bdcf-62875a2e6f9f",
                        "glosses": [
                            "To disfigure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e73eb10-01b7-44d2-bb5e-ec53ec3cc62b",
                                "sense_id": "599ebd87-47a4-3958-94b9-604fdd48e6c1",
                                "text": "Section 1427: makes it a misdemeanour for anyone not the owner wilfully to injure, misfigure, remove or destroy the work of art, and, similarly Section 1428: provides that the person who wilfully or maliciously cuts, tears, defaces, disfigures, soils, obliterates, breaks or destorys an object of art or curiosity deposited in a public library, gallery, museum, collection, fair or exhibition is punishable by prison or fine, or both."
                            },
                            {
                                "example_id": "c18e4eca-7fc0-4a96-b418-cc3e5625709a",
                                "sense_id": "599ebd87-47a4-3958-94b9-604fdd48e6c1",
                                "text": "Canst thou look on my poor wrinkld face & not wonder That such alterations misfigures my prime"
                            },
                            {
                                "example_id": "654c2e61-8ec5-4cc6-a258-4aeafc572395",
                                "sense_id": "599ebd87-47a4-3958-94b9-604fdd48e6c1",
                                "text": "Jack and an enormously-breasted teenage Jane go off to summer camp where seventeen of their friends are hacked to pieces by an ax-wielding lumberjack named Mr. Big who has been misfigured by a horrible logging accident and has escaped from Jane's nightmares."
                            },
                            {
                                "example_id": "0184b7f1-7ea9-48f7-9e42-c2e37e3815a7",
                                "sense_id": "599ebd87-47a4-3958-94b9-604fdd48e6c1",
                                "text": "No matter what has misfigured you, in God is the power to be transformed."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c035a0f-ed75-3577-90d9-5a993bf0f2da",
                        "entry_id": "01c2bda6-07ba-3cf4-bdcf-62875a2e6f9f",
                        "glosses": [
                            "To err in the manufacture of an optical surface so that it causes distortions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea0ad83-040a-4ad7-8489-896e3f36a3dc",
                                "sense_id": "3c035a0f-ed75-3577-90d9-5a993bf0f2da",
                                "text": "If the flat rim of the center axicon is misfigured in such a way that its best fit plane is not perpendicular to the axis of symmetry of the center axicon ( defined in a least squares sense ) this deviation will […]"
                            },
                            {
                                "example_id": "1306b3ca-f16d-4b27-9e2c-a34917c0aa7a",
                                "sense_id": "3c035a0f-ed75-3577-90d9-5a993bf0f2da",
                                "text": "Should the element be misfigured, then these aberrations would be combined with the actual misfigure."
                            },
                            {
                                "example_id": "991bd969-1561-4e72-bc65-994a7957469f",
                                "sense_id": "3c035a0f-ed75-3577-90d9-5a993bf0f2da",
                                "text": "Both provide corrective optics which essentially cancel the wavefront error introduced by the misfigured primary mirror."
                            }
                        ]
                    }
                ],
