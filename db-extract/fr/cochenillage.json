                        "sense_id": "c6c842b6-15aa-3be6-8e5a-37c6723b7788",
                        "entry_id": "3cedb634-ad17-3a61-97a8-ce0eb3d0e2bc",
                        "glosses": [
                            "Décoction faite avec la cochenille pour teindre en cramoisi ou en écarlate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8809cfbe-bbcb-4bbe-82f5-44238f5f9ba6",
                                "sense_id": "c6c842b6-15aa-3be6-8e5a-37c6723b7788",
                                "text": "Le maître-teinturier note qu’on se sert du cochenillage pour teindre en rose et en chair, en ajoutant de la galle, de l’orseille ou de la couperose."
                            }
                        ]
