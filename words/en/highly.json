    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                    "sense_definition": "To a high degree or extent; extremely.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>highly</w> likely that the meeting will be postponed until next week.",
                            "target_lang_translations": {
                                "ru": "<w>Весьма</w> вероятно, что встреча будет перенесена на следующую неделю.",
                                "pl": "Jest <w>wysoce</w> prawdopodobne, że spotkanie zostanie przełożone na przyszły tydzień.",
                                "zh": "会议<w>极</w>有可能会推迟到下周。"
                            }
                        },
                        {
                            "text": "The book was <w>highly</w> controversial yet sold unbelievably well.",
                            "target_lang_translations": {
                                "ru": "Книга была <w>весьма</w> спорной, но продавалась невероятно хорошо.",
                                "pl": "Książka była <w>bardzo</w> kontrowersyjna, a mimo to sprzedawała się niewiarygodnie dobrze.",
                                "zh": "这本书<w>极</w>具争议，但销量却好得惊人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extremely",
                        "very",
                        "greatly",
                        "immensely",
                        "exceptionally",
                        "exceedingly."
                    ],
                    "antonyms": [
                        "slightly",
                        "barely",
                        "hardly",
                        "somewhat"
                    ],
                    "common_phrases": [
                        "highly recommended",
                        "highly likely",
                        "highly effective",
                        "highly skilled",
                        "highly successful"
                    ],
                    "target_lang_definitions": {
                        "ru": "В высокой степени; чрезвычайно, очень",
                        "pl": "W wysokim stopniu; niezwykle, bardzo.",
                        "zh": "在很大程度上；极其，非常"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весьма",
