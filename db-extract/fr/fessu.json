                "senses": [
                    {
                        "sense_id": "1ba167db-27dd-3db0-997a-a1b6e13c1ce4",
                        "entry_id": "3edfdb4e-b769-3cdc-8216-cbec0c977dd0",
                        "glosses": [
                            "Qui a des fesses imposantes."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ca6cf513-ca60-48f6-9916-2792cc8f3462",
                                "sense_id": "1ba167db-27dd-3db0-997a-a1b6e13c1ce4",
                                "text": "Petits angelots bien fessus,\n Enfants Jésus ronds et mafflus…"
                            },
                            {
                                "example_id": "0c6f5ad2-895d-4d13-8d24-f8a90d2e6059",
                                "sense_id": "1ba167db-27dd-3db0-997a-a1b6e13c1ce4",
                                "text": "— Le langage de Lamendin m’est allé au cœur. Son avis a de l’importance. Ce visage fessu ne lâche, comme il est naturel, rien qui n’ait été longuement digéré."
                            },
                            {
                                "example_id": "61cb6ab4-faf0-460f-bde8-7d6edf88e677",
                                "sense_id": "1ba167db-27dd-3db0-997a-a1b6e13c1ce4",
                                "text": "J’avoue l’ennui sans fond éprouvé devant ce conclave de mémères fessues, hanchues, cuissues et mamelues."
                            }
                        ]
                    }
