                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "peur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce film d'horreur était tellement <w>flippant</w> que je n'ai pas pu dormir de la nuit.",
                            "target_lang_translations": {
                                "en": "That horror movie was so <w>creepy</w> that I couldn't sleep a wink that night.",
                                "ru": "Этот фильм ужасов был настолько <w>жутким</w>, что мне не удалось уснуть всю ночь.",
                                "nl": "Die horrorfilm was zo <w>eng</w> dat ik die nacht geen oog dicht kon doen.",
                                "de": "Dieser Horrorfilm war so <w>gruselig</w>, dass ich in dieser Nacht kein Auge zutun konnte.",
                                "pl": "Ten film grozy był tak <w>straszny</w>, że tej nocy w ogóle nie udało mi się zasnąć.",
                                "it": "Quel film dell'orrore era talmente <w>inquietante</w> che quella notte non ho chiuso occhio.",
                                "cs": "Ten hororový film byl tak <w>strašidelný</w>, že se mi té noci vůbec nepodařilo usnout.",
                                "tr": "Bu korku filmi o kadar <w>ürkütücüydü</w> ki o gece gözüme uyku girmedi.",
                                "es": "Esa película de terror era tan <w>espeluznante</w> que no pude pegar ojo esa noche.",
                                "zh": "那部恐怖片太<w>吓人</w>了，那天晚上我一整夜都没睡着。"
                            }
                        },
                        {
                            "text": "Il y a une ambiance <w>flippante</w> dans cette vieille maison abandonnée au bout de la rue.",
                            "target_lang_translations": {
                                "en": "There is a <w>creepy</w> atmosphere in that old abandoned house at the end of the street.",
                                "ru": "В этом старом заброшенном доме в конце улицы царит <w>жуткая</w> атмосфера.",
                                "nl": "Er hangt een <w>griezelige</w> sfeer in dat oude, verlaten huis aan het eind van de straat.",
                                "de": "In diesem alten, verlassenen Haus am Ende der Straße herrscht eine <w>unheimliche</w> Atmosphäre.",
                                "pl": "W tym starym, opuszczonym domu na końcu ulicy panuje <w>upiorna</w> atmosfera.",
                                "it": "In quella vecchia casa abbandonata in fondo alla strada c'è un'atmosfera <w>inquietante</w>.",
                                "cs": "V tom starém opuštěném domě na konci ulice panuje <w>strašidelná</w> atmosféra.",
                                "tr": "Sokağın sonundaki bu eski, terk edilmiş evde <w>ürkütücü</w> bir atmosfer var.",
                                "es": "Hay un ambiente <w>inquietante</w> en aquella vieja casa abandonada al final de la calle.",
                                "zh": "街道尽头那栋废弃的老房子里有一种<w>阴森</w>的气氛。"
                            }
                        }
