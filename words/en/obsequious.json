    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c4e28e6b-324c-3565-8dfb-477bce303348",
                    "sense_definition": "Excessively eager and attentive to please or to obey instructions; fawning, subservient, or servile.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subservient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was surrounded by <w>obsequious</w> assistants who agreed with every single word he said."
                        },
                        {
                            "text": "She grew tired of his <w>obsequious</w> behavior and wished he would express his honest opinion for once."
                        }
                    ],
                    "synonyms": [
                        "fawning",
                        "servile",
                        "sycophantic",
                        "toadying",
                        "ingratiating"
                    ],
                    "antonyms": [
                        "assertive",
                        "domineering"
                    ],
                    "common_phrases": [
                        "obsequious smile",
                        "obsequious behavior",
                        "obsequious flatterer"
                    ]
                },
                {
                    "sense_id": "4a352d4e-739b-36cd-ba5f-1483c1053d73",
                    "sense_definition": "Obedient or compliant with someone else's orders or wishes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "subservient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The servants remained <w>obsequious</w> to the wishes of the estate owner throughout his long stay."
                        },
                        {
                            "text": "They expected an <w>obsequious</w> follower who would never question their authority."
                        }
                    ],
                    "synonyms": [
