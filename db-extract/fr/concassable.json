                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acc4e555-e52c-4d11-b6ed-ada4d446b585",
                                "sense_id": "293da383-689b-3b2d-bd50-1bcc2ae37d51",
                                "text": "La précuisson présente l’avantage de brûler certaines impuretés, mais surtout de rendre le minerai plus facilement concassable."
                            },
                            {
                                "example_id": "5592dcf2-0dbe-4796-bafd-21ce1e8a14c4",
                                "sense_id": "293da383-689b-3b2d-bd50-1bcc2ae37d51",
                                "text": "La production moyenne de graviers concassables (et dans une moindre mesure, de sable) serait de 150.000 tonnes par an, voire 170.000 tonnes maximum, durant vingt ans."
                            },
                            {
                                "example_id": "002d7830-c5b4-44c7-a583-654bea2ac7fb",
                                "sense_id": "293da383-689b-3b2d-bd50-1bcc2ae37d51",
                                "text": "Il paraît que tout n’est pas à jeter et qu’on peut offrir une nouvelle vie à ces gravats. On va les trier (il n’y a pas de sot métier, pas plus qu’il n’y a de petits profits), puis laver ce qui est lavable et concasser ce qui est concassable."
                            }
                        ]
                    }
