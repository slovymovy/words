                                        "entry_id": "75d28d35-8bed-36ed-9bdd-cdf1c9cfbe56",
                                        "glosses": [
                                            "Punkt in einem perspektivischen Bild, in dem alle Linien zusammenlaufen, die in der realen Welt parallel verlaufen"
                                        ],
