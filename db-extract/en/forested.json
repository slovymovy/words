                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "306591bb-05db-47bf-b7e9-448905253341",
                                                "sense_id": "2bb152b6-f801-3e5f-9db6-27f0b7a9e700",
                                                "text": "Ils incluent les pâtés de campagne, de jambon, de viande, de volaille, de lapin, de gibier : lièvre, faisan, sanglier, cerf... sans oublier le pâté forestier comprenant des champignons sylvestres (surtout des trompettes-de-la-mort)."
                                            },
                                            {
                                                "example_id": "bbb662c0-fd7e-41be-ab21-7f51b156ac7f",
                                                "sense_id": "2bb152b6-f801-3e5f-9db6-27f0b7a9e700",
                                                "text": "Les animaux sylvestres sont difficiles à observer directement."
                                            },
                                            {
                                                "example_id": "d9a340d7-573c-43f7-9acd-448621f055ea",
                                                "sense_id": "2bb152b6-f801-3e5f-9db6-27f0b7a9e700",
                                                "text": "Pin, menthe sylvestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fcd91d7-0194-3a29-8673-846e04f411a0",
                                        "entry_id": "5878deb0-9ecb-3738-b5ac-fdc5f48ea14d",
                                        "glosses": [
                                            "Se dit d’une personne qui vit dans la forêt."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4703a39-ddea-455e-aafb-75380a3a12c4",
                                                "sense_id": "1fcd91d7-0194-3a29-8673-846e04f411a0",
                                                "text": "Plusieurs fois encore j’aperçus ces enfants sylvestres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba30d481-5d0c-30eb-bf03-514307d83609",
                                        "entry_id": "5878deb0-9ecb-3738-b5ac-fdc5f48ea14d",
                                        "glosses": [
                                            "Relatif à la forêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e39b50-af7f-4897-8092-255471507f7a",
                                                "sense_id": "ba30d481-5d0c-30eb-bf03-514307d83609",
                                                "text": "L’humidité sylvestre est plus élevée que celle des prairies."
                                            },
                                            {
                                                "example_id": "c0d5e4c8-96ed-4264-9d3f-ced8caa02222",
                                                "sense_id": "ba30d481-5d0c-30eb-bf03-514307d83609",
                                                "text": "Le Jura a d’importantes ressources sylvestres."
                                            },
                                            {
                                                "example_id": "7414b260-4648-49a6-bbc8-f6a26151e85c",
                                                "sense_id": "ba30d481-5d0c-30eb-bf03-514307d83609",
                                                "text": "Ma solitude sylvestre dura plusieurs étés."
                                            },
                                            {
                                                "example_id": "cc4a9651-efd1-4d9a-bd88-7d2b23066a9e",
                                                "sense_id": "ba30d481-5d0c-30eb-bf03-514307d83609",
                                                "text": "Harry Dickson, mis en verve par un large gobelet de vin pétillant, obtint un succès étourdissant, en comparant le menu vespéral et sylvestre avec celui du château."
                                            },
                                            {
                                                "example_id": "648b5f63-da5d-4275-91a6-7a47111c1ccf",
                                                "sense_id": "ba30d481-5d0c-30eb-bf03-514307d83609",
                                                "text": "Les formations sylvestres, qui occupent près de 4 milliards d’hectares, se déploient sur 30 % de la superficie des terres émergées. Les images qui viennent à l’esprit à leur évocation sont habituellement celles de luxuriantes forêts tropicales, de rustiques forêts boréales ou de plus sages bois tempérés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a796351-9b14-325c-aee6-6a7c631658fa",
                                        "entry_id": "5878deb0-9ecb-3738-b5ac-fdc5f48ea14d",
                                        "glosses": [
                                            "Couvert de bois, de forêts, en parlant d’un lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b930354d-9883-4021-a66b-9ed7eed0ef22",
                                                "sense_id": "9a796351-9b14-325c-aee6-6a7c631658fa",
                                                "text": "Ce pays est rempli d’immenses étendues sylvestres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
