                "senses": [
                    {
                        "sense_id": "d9ec4ea2-d8f3-3360-acaa-835ebd4f755b",
                        "entry_id": "43774121-b9fa-3e5e-93f2-7bc2d19034a9",
                        "glosses": [
                            "Rompre de nouveau (en particulier une relation)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b1038be2-df93-4602-85e2-022e55dec3cf",
                                "sense_id": "d9ec4ea2-d8f3-3360-acaa-835ebd4f755b",
                                "text": "Cela dit, je le répète afin de ne pas passer pour un grognon et un intraitable, je pense qu'il faut reprendre nos relations diplomatiques avec le Triste Rat, quitte à rerompre à la moindre incartade."
                            },
                            {
                                "example_id": "b74e1942-7033-42f2-9cf3-c8f594400b31",
                                "sense_id": "d9ec4ea2-d8f3-3360-acaa-835ebd4f755b",
                                "text": "Ressortir avec son ex, sortir avec, avoir un rencard, retourner voir la célébrité, et là rerompre avec l'ex. Vous avez suivi?"
                            },
                            {
                                "example_id": "3d255488-5a1d-4463-bf28-b6f6eecef1a7",
                                "sense_id": "d9ec4ea2-d8f3-3360-acaa-835ebd4f755b",
                                "text": "Personne ne lui a dit de tomber amoureux de l'une, puis de rompre et ensuite de tomber amoureux de l'autre puis de rerompre."
                            }
                        ]
                    }
                ],
