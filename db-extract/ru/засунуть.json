                ],
                "senses": [
                    {
                        "sense_id": "3a48888f-5934-397b-be10-c2b7ea4ff74d",
                        "entry_id": "c73786e3-0300-3674-bef7-39fe6cda1db8",
                        "glosses": [
                            "сунуть внутрь чего-либо, подо что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ecf5a8-3b41-4e0f-b019-ef77998fa228",
                                "sense_id": "3a48888f-5934-397b-be10-c2b7ea4ff74d",
                                "text": "Женя засунула в рот все ягоды, смешно скривилась, но зачмокала от удовольствия."
                            }
                        ]
                    },
                    {
                        "sense_id": "43ee10b2-d7f7-362d-95a0-4700091b1219",
                        "entry_id": "c73786e3-0300-3674-bef7-39fe6cda1db8",
                        "glosses": [
                            "разг. положить, спрятать так, что трудно найти"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1e42689-e061-4018-a00b-9e14efe2e30c",
                        "source_entry_id": "c73786e3-0300-3674-bef7-39fe6cda1db8",
                        "target_lang_word": "verlegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verlegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3eb7ff26-e124-380c-8d11-f5563ddc8cd3",
                                        "entry_id": "1724d3c2-6199-33b1-8745-a7205cfb779d",
                                        "glosses": [
                                            "eine Sache an einem Ort ablegen, an den man sich später nicht mehr erinnern kann (meist im Nachhinein benutzt: verlegt haben)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef22e8c-3e72-4f06-b519-2f82bb9586e3",
                                                "sense_id": "3eb7ff26-e124-380c-8d11-f5563ddc8cd3",
                                                "text": "Jetzt habe ich den Schlüssel schon wieder verlegt!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28ff5239-6fb7-3c27-b45f-d22c7e8e5afd",
                                        "entry_id": "1724d3c2-6199-33b1-8745-a7205cfb779d",
                                        "glosses": [
                                            "etwas an eine dafür vorgesehene Stelle bringen (zum Beispiel einen Bodenbelag (Dielen, Parkett, Laminat) aufbringen; ein Rohr unter die Erde legen)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d12f8a04-ef72-4535-9e80-171024068b33",
                                                "sense_id": "28ff5239-6fb7-3c27-b45f-d22c7e8e5afd",
                                                "text": "Wir wollen den Dielenboden selbst verlegen."
                                            },
                                            {
                                                "example_id": "b4e389f0-7ff8-469d-b7ca-79384525bd8b",
                                                "sense_id": "28ff5239-6fb7-3c27-b45f-d22c7e8e5afd",
                                                "text": "„Die Gemeinde hat begonnen, die Straßen zu verbreitern und leistungsstärkere Abwasserrohre zu verlegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e92a5fbe-eefd-33a7-9aa8-642686883837",
                                        "entry_id": "1724d3c2-6199-33b1-8745-a7205cfb779d",
                                        "glosses": [
                                            "von einem Zeitpunkt auf einen anderen verschieben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4372dc9b-4585-472e-9873-3b8865a99a40",
                                                "sense_id": "e92a5fbe-eefd-33a7-9aa8-642686883837",
                                                "text": "Der Zahnarzttermin muss verlegt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c276837a-ef13-358e-96d7-5c3860465d7a",
                                        "entry_id": "1724d3c2-6199-33b1-8745-a7205cfb779d",
                                        "glosses": [
                                            "von einem Ort zu einem anderen bewegen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "440a384b-8dc4-4d9e-9d99-548ba01bbeb7",
                                                "sense_id": "c276837a-ef13-358e-96d7-5c3860465d7a",
                                                "text": "Die Krankenstation wird nächstes Jahr in den Ostflügel verlegt."
                                            },
                                            {
                                                "example_id": "e3377dcd-78a2-4dcb-8b8e-4518a3a81392",
                                                "sense_id": "c276837a-ef13-358e-96d7-5c3860465d7a",
                                                "text": "„Bismarck verlegte seinen Hauptwohnsitz nach Friedrichsruh im Sachsenwald bei Hamburg.“"
                                            },
                                            {
                                                "example_id": "6ebdf678-848e-41b2-a41d-70c6ca393eaf",
                                                "sense_id": "c276837a-ef13-358e-96d7-5c3860465d7a",
                                                "text": "„Im November 1990 wird das kleine Mädchen in eine Reha-Klinik in der Nähe von Rosenheim verlegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ba35f074-1760-32ed-83fd-aa9946360daa",
                                        "entry_id": "1724d3c2-6199-33b1-8745-a7205cfb779d",
                                        "glosses": [
                                            "ein Buch veröffentlichen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83db2be3-b765-4741-8d7f-3c159901109b",
                                                "sense_id": "ba35f074-1760-32ed-83fd-aa9946360daa",
                                                "text": "Sein erster Roman wurde nur in geringer Stückzahl verlegt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "b580bca2-255c-3e32-a55a-e5fff99db5ce",
                                        "entry_id": "1724d3c2-6199-33b1-8745-a7205cfb779d",
                                        "glosses": [
                                            "sich zu einer bestimmten Haltung entscheiden, sich mit etwas beschäftigen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "053702f8-a7f5-4bbf-b4fa-751b8445bd3a",
                                                "sense_id": "b580bca2-255c-3e32-a55a-e5fff99db5ce",
                                                "text": "In jüngster Zeit hat er sich eher auf das Gänse-Stehlen verlegt."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "fec6cd2e-6e19-3595-8047-7005df83e256",
                                        "entry_id": "1724d3c2-6199-33b1-8745-a7205cfb779d",
                                        "glosses": [
                                            "Standort/Sitz ändern"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42a8f17-5457-4b00-a04e-ab19df4d3778",
                                                "sense_id": "fec6cd2e-6e19-3595-8047-7005df83e256",
                                                "text": "„[…] der Verband verlegte nach Peenemünde und hieß ab 1961 \"9. Jagdfliegergeschwader\", […]“"
                                            },
                                            {
                                                "example_id": "3c933fd0-6882-4a03-8fe3-98483576c2c9",
                                                "sense_id": "fec6cd2e-6e19-3595-8047-7005df83e256",
                                                "text": "„Der bisher im Südwesten am Oberrhein befindliche Stab verlegte hierzu ab dem 21. Januar an die Ostfront.“"
                                            },
                                            {
                                                "example_id": "c52ad8de-2570-4b95-875e-dd7b95846c97",
                                                "sense_id": "fec6cd2e-6e19-3595-8047-7005df83e256",
                                                "text": "„Der Regimentsstab und das 1. Bataillon wurden in Ried stationiert, das 2. Bataillon verlegte nach Braunau und das 3. Bataillon kam nach Schärding.“"
                                            },
                                            {
                                                "example_id": "25406164-3e0b-4d36-af4f-be2ed0e7530c",
                                                "sense_id": "fec6cd2e-6e19-3595-8047-7005df83e256",
                                                "text": "„Vom 15. Dezember 1958 bis Januar 1959 verlegte das Bataillon nach Immendingen in die Neue Kaserne, […]“"
                                            },
                                            {
                                                "example_id": "b99b80f8-e9de-48c5-9212-007505058183",
                                                "sense_id": "fec6cd2e-6e19-3595-8047-7005df83e256",
                                                "text": "„Kurz vor dem Beginn der Angriffsoperationen verlegte das Bataillon nach Tilsit und bereits am 26. Juni erreichte es Litauen.“"
                                            },
                                            {
                                                "example_id": "2b41a6c6-196e-4efd-aec5-f987aea0c127",
                                                "sense_id": "fec6cd2e-6e19-3595-8047-7005df83e256",
                                                "text": "„1961 wurde sie in Zerstörerflottille umbenannt. Deren Stab verlegte erst 1982 nach Wilhelmshaven.“"
                                            },
                                            {
                                                "example_id": "93b54105-bfb6-4fea-b491-932d01fbb9a7",
                                                "sense_id": "fec6cd2e-6e19-3595-8047-7005df83e256",
                                                "text": "„Ende November 1956 verlegte die Boston das erste Mal als Lenkwaffenkreuzer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
