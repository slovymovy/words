                        "source_sense_description": "Adverb, das ein Thema in eine Zweigeteiltheit kategorisiert, von der die erste Seite folgt",
                        "target_lang_word": "on the one hand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on the one hand",
