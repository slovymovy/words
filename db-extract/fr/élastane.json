                                        "sense_id": "08d94932-e9c4-3f03-9ca0-8566f428aa85",
                                        "entry_id": "4d1d09cf-f4b4-3c06-a214-4f46d9dd0c7a",
                                        "glosses": [
                                            "Spandex, lycra."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6cba334-2383-491e-badf-b60a159ca2e7",
                                                "sense_id": "08d94932-e9c4-3f03-9ca0-8566f428aa85",
                                                "text": "2005, W. Schindler, E. Finnimore, 8: Chemical analysis of damage to textiles, Qinguo Fan (editor), Chemical Testing of Textiles, CRC Press, Woodhead Publishing, page 212,\nThe resistance to ageing of elastane fibres is much better than that of the rubber threads previously used, which were particularly susceptible to oxidation."
                                            },
                                            {
                                                "example_id": "1bfd87f1-1b90-40a6-893c-55372a64067e",
                                                "sense_id": "08d94932-e9c4-3f03-9ca0-8566f428aa85",
                                                "text": "The source of elastane is polyurethane. Elastane is always use in addition to a major fibre to incorporate stretch into the fabric. Although most elastane fibres are produced to stretch to three times their length, they can be extended further."
                                            },
                                            {
                                                "example_id": "f01531c9-98a1-4b7e-b8f0-c33b3219ae91",
                                                "sense_id": "08d94932-e9c4-3f03-9ca0-8566f428aa85",
                                                "text": "Elastane holds an irreplaceable place in today's textile market as it is being used in all ranges of products from high-functional sportswear to leisurewear to improve comfort properties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
