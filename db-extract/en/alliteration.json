                                                "text": "trentatré trentini entrarono a Trento tutti e trentatré trotterellando"
                                            },
                                            {
                                                "example_id": "df08d426-1091-4239-9533-78b511fd32a0",
                                                "sense_id": "664bd956-615e-3b2e-975f-e68934879c9f",
