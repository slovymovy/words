                    {
                        "translation_id": "e78805e8-84f3-4613-a562-a3632e670252",
                        "source_entry_id": "2cdb5cc9-1e8b-3e64-9821-c90f645837ec",
                        "source_sense_id": "e661c35b-1d61-3835-8fd7-c33500891b15",
