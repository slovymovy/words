                "senses": [
                    {
                        "sense_id": "a15bf2c6-4d92-383b-b80e-70160df466dd",
                        "entry_id": "2fd3ad66-2a9d-3954-8e1e-b3e96a180b68",
                        "glosses": [
                            "jemand, der (oft in einer Behörde oder in einem Betrieb) ein bestimmtes Sachgebiet bearbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a9633b3-a8e7-4b62-a80c-1706786ea1c2",
                                "sense_id": "a15bf2c6-4d92-383b-b80e-70160df466dd",
                                "text": "Verbinden Sie mich sofort mit dem zuständigen Sachbearbeiter!"
                            },
                            {
                                "example_id": "a8107c11-c38a-4eba-8116-09f7b32e0c17",
                                "sense_id": "a15bf2c6-4d92-383b-b80e-70160df466dd",
                                "text": "„Wann der Prozess gegen den 56 Jahre alten Sachbearbeiter und den 65 Jahre alten Amtsvormund vor dem Landgericht beginnt, konnte ein Behördensprecher heute nicht sagen.“"
                            },
                            {
                                "example_id": "0eaebb9e-a88f-4869-89ec-5969072506c2",
                                "sense_id": "a15bf2c6-4d92-383b-b80e-70160df466dd",
                                "text": "„Ein eigens abgeordneter neuer Sachbearbeiter soll die verlorenen Anmeldungen rekonstruieren – und die Klausuren sollen wie geplant am 9. Dezember stattfinden.“"
                            },
                            {
                                "example_id": "fbdd47a7-0d57-4048-b5c5-7826fc25e9c1",
                                "sense_id": "a15bf2c6-4d92-383b-b80e-70160df466dd",
                                "text": "„Der Onkel hat auch verhindert, daß der Albert das Gymnasium beenden konnte und ihn stattdessen bei der Gemeinde in W als Sachbearbeiter untergebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
