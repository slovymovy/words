                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Precious</w> signed the contract yesterday.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Прешес</w> подписал контракт вчера.",
                                "tr": "Bay <w>Precious</w> sözleşmeyi dün imzaladı.",
                                "zh": "<w>普雷舍斯</w>先生昨天签署了合同。"
                            }
                        },
                        {
                            "text": "We are looking for the file on Mrs. <w>Precious</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем досье на миссис <w>Прешес</w>.",
                                "tr": "Bayan <w>Precious</w> hakkındaki dosyayı arıyoruz.",
                                "zh": "我们正在寻找关于<w>普雷舍斯</w>夫人的档案。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "tr": "Bir soyadı.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Прешес",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Precious",
                                "target_lang_sense_clarification": "soyadı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普雷舍斯",
                                "target_lang_sense_clarification": "音译姓"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4dc47a7e-663b-3cac-814c-8f7e3dea3d9e",
                    "sense_definition": "A person who is loved or cherished; a darling.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Come here, my <w>precious</w>, and let me fix your hair.",
