{
    "word_family": [
        "thump"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f13155e4-c0cb-3322-af79-515314680983",
                    "sense_definition": "A dull, heavy sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>thumping</w> from the upstairs apartment kept me awake all night.",
                            "target_lang_translations": {
                                "cs": "<w>Dupot</w> z bytu nad námi mě celou noc nenechal spát."
                            }
                        },
                        {
                            "text": "I heard a loud <w>thumping</w> against the door during the storm.",
                            "target_lang_translations": {
                                "cs": "Během bouřky jsem slyšel hlasité <w>bouchání</w> na dveře."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Tupý, těžký zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dupot",
                                "target_lang_sense_clarification": "zvuk kroků"
                            },
                            {
                                "target_lang_word": "bouchání",
                                "target_lang_sense_clarification": "opakovaný úderný zvuk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b920d569-a948-37f3-8f61-d60081e6766d",
                    "sense_definition": "A physical beating or striking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child received a severe <w>thumping</w> for his bad behavior.",
                            "target_lang_translations": {
                                "cs": "Dítě dostalo za své špatné chování pořádný <w>výprask</w>."
                            }
                        },
                        {
                            "text": "He walked away from the fight with a <w>thumping</w> to his ego.",
                            "target_lang_translations": {
                                "cs": "Z boje odešel s pořádně <w>zasaženým</w> egem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Fyzické bití nebo udeření."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "výprask",
                                "target_lang_sense_clarification": "fyzický trest"
                            },
                            {
                                "target_lang_word": "nakládačka",
                                "target_lang_sense_clarification": "hovorově bití"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b731918-6eab-3b51-9fdd-8307e14b4a74",
                    "sense_definition": "A heavy or decisive defeat in a competition or game.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team suffered a humiliating <w>thumping</w> in the championship final.",
                            "target_lang_translations": {
                                "cs": "Tým utrpěl ve finále šampionátu ponižující <w>debakl</w>."
                            }
                        },
                        {
                            "text": "After the 4-0 <w>thumping</w>, the coach decided to resign immediately.",
                            "target_lang_translations": {
                                "cs": "Po <w>výprasku</w> 4:0 se trenér rozhodl okamžitě rezignovat."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrashing"
                    ],
                    "target_lang_definitions": {
                        "cs": "Těžká nebo rozhodující porážka v soutěži či hře."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "debakl",
                                "target_lang_sense_clarification": "zdrcující porážka"
                            },
                            {
                                "target_lang_word": "výprask",
                                "target_lang_sense_clarification": "sportovní porážka"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f4dd7604-0c01-3ebf-b33b-c740a7d393f2",
                    "sense_definition": "Exceptional or very large in degree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They won by a <w>thumping</w> majority in the recent election.",
                            "target_lang_translations": {
                                "cs": "V nedávných volbách vyhráli <w>zdrcující</w> většinou."
                            }
                        },
                        {
                            "text": "The company reported a <w>thumping</w> profit for the third quarter.",
                            "target_lang_translations": {
                                "cs": "Společnost vykázala za třetí čtvrtletí <w>obrovský</w> zisk."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Výjimečný nebo velmi velký co do rozsahu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zdrcující",
                                "target_lang_sense_clarification": "velký, přesvědčivý"
                            },
                            {
                                "target_lang_word": "obrovský",
                                "target_lang_sense_clarification": "velmi značný"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "58080c30-cae7-3949-b90e-d8eb2b252cf1",
                    "sense_definition": "Exceptionally or very.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>thumping</w> good performance by the young actor.",
                            "target_lang_translations": {
                                "cs": "Byl to <w>náramně</w> dobrý výkon mladého herce."
                            }
                        },
                        {
                            "text": "The plan was a <w>thumping</w> success despite the initial doubts.",
                            "target_lang_translations": {
                                "cs": "Plán byl navzdory počátečním pochybnostem <w>nesmírným</w> úspěchem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Výjimečně nebo velmi."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "náramně",
                                "target_lang_sense_clarification": "velmi, skvěle"
                            },
                            {
                                "target_lang_word": "nesmírně",
                                "target_lang_sense_clarification": "velmi intenzivně"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b087884d-ca0b-30b6-89a0-ed2ee41188ea",
                    "sense_definition": "Present participle and gerund of <w>thump</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My heart was <w>thumping</w> loudly after the long race.",
                            "target_lang_translations": {
                                "cs": "Po dlouhém závodě mi srdce hlasitě <w>bušilo</w>."
                            }
                        },
                        {
                            "text": "She kept <w>thumping</w> the table to get everyone's attention.",
                            "target_lang_translations": {
                                "cs": "Neustále <w>bušila</w> do stolu, aby upoutala pozornost všech."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa 'thump' (bušit, tlouci)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bušící",
                                "target_lang_sense_clarification": "tlukot srdce"
                            },
                            {
                                "target_lang_word": "bušení",
                                "target_lang_sense_clarification": "činnost bušení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}