                ],
                "senses": [
                    {
                        "sense_id": "19520974-e93d-3b05-b01f-f408de1486d1",
                        "entry_id": "9cbdbc28-ff78-38fe-951c-4da8411642b2",
                        "glosses": [
                            "Kopfbedeckung im Stil der Tiroler Volkstracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c323fd-0119-4fe1-ae88-066e8f974633",
                                "sense_id": "19520974-e93d-3b05-b01f-f408de1486d1",
                                "text": "„In den Kasinosälen hocken heute schon neben reichen Italienerinnen Männer im Tirolerhut, Schwangere in Bermuda-Shorts lassen unter den Kronleuchtern die Kugeln rollen.“"
                            },
                            {
                                "example_id": "8bfbb610-9081-433d-9d4d-a410d46fdbfe",
                                "sense_id": "19520974-e93d-3b05-b01f-f408de1486d1",
                                "text": "„Die Staubfahne weht an seinem Heck wie der Gamsbart am Tirolerhut, schon von weitem ist die eilige Kolonne zu sehen.“"
                            },
                            {
                                "example_id": "524910ec-5aad-456a-a6f0-c3af5936e898",
                                "sense_id": "19520974-e93d-3b05-b01f-f408de1486d1",
                                "text": "„Brennende Holzscheite im Ofen wärmen den Raum, über der Tür wacht ein Plüschwildschwein, über dem Tresen hängen kleine Tirolerhüte als Lampenschirme, auf schlichten Regalbrettern stehen Weinflaschen aufgereiht, auf den Tischen frische Blumen, draußen neben dem Eingang leuchtet eine Laterne.“"
                            },
                            {
                                "example_id": "b6414b1a-4dce-44b5-bb84-43f3f5f19a95",
                                "sense_id": "19520974-e93d-3b05-b01f-f408de1486d1",
                                "text": "„Wenn man zum Eigentlichen vorstoßen will, darf man sich auch nicht von dem Stapel Tirolerhüte mit Gamsbart ablenken lassen, der auf einem Bänkchen liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
