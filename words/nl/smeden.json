                    "sense_id": "fd380b56-311f-349a-b156-e3d325bc2b5b",
                    "sense_definition": "metaal heet maken en met een hamer in de gewenste vorm slaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaalbewerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakman moet het hete ijzer urenlang met de hand <w>smeden</w>.",
                            "target_lang_translations": {
                                "fr": "L'artisan doit <w>forger</w> le fer chaud à la main pendant des heures."
                            }
                        },
                        {
                            "text": "Hij <w>smeedde</w> een nieuw zwaard in zijn werkplaats.",
                            "target_lang_translations": {
