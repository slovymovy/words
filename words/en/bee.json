{
    "word_family": [
        "beehive",
        "beekeeper",
        "beeswax",
        "beeline",
        "bumblebee",
        "honeybee"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d77ea1b-32e3-37ac-814c-0318ba78122b",
                    "sense_definition": "A flying insect with a hairy body that collects pollen and nectar, often living in organized colonies and producing honey and wax.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>bee</w> was buzzing around the colorful flowers in the garden.",
                            "target_lang_translations": {
                                "ru": "<w>Пчела</w> жужжала вокруг ярких цветов в саду."
                            }
                        },
                        {
                            "text": "The <w>honey</w> <w>bee</w> is essential for pollinating many of the crops we eat.",
                            "target_lang_translations": {
                                "ru": "Медоносная <w>пчела</w> необходима для опыления многих культур, которые мы употребляем в пищу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "honey bee",
                        "worker bee",
                        "bee sting",
                        "busy as a bee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Летающее насекомое с волосатым телом, которое собирает пыльцу и нектар, часто живет в организованных колониях и производит мед и воск."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пчела",
                                "target_lang_sense_clarification": "насекомое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f9947cb-06df-3e0b-8264-0995be916372",
                    "sense_definition": "A competition or contest, especially one where participants are tested on a specific skill like spelling.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She studied every night to prepare for the national spelling <w>bee</w>.",
                            "target_lang_translations": {
                                "ru": "Она занималась каждую ночь, чтобы подготовиться к национальному <w>конкурсу</w> по орфографии."
                            }
                        },
                        {
                            "text": "The school held a geography <w>bee</w> to see who knew the most capitals.",
                            "target_lang_translations": {
                                "ru": "В школе провели <w>олимпиаду</w> по географии, чтобы узнать, кто знает больше всего столиц."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spelling bee",
                        "geography bee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соревнование или конкурс, особенно тот, где участники проверяются на определенный навык, например, правописание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конкурс",
                                "target_lang_sense_clarification": "соревнование"
                            },
                            {
                                "target_lang_word": "олимпиада",
                                "target_lang_sense_clarification": "состязание в знаниях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c61a0c99-7623-37ab-8ed2-cf3cf1056e8c",
                    "sense_definition": "A social gathering of people who come together to complete a specific task or work project.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbors organized a quilting <w>bee</w> to finish the blanket for the new baby.",
                            "target_lang_translations": {
                                "ru": "Соседи устроили <w>посиделки</w> по стежке одеял, чтобы закончить одеяло для новорожденного."
                            }
                        },
                        {
                            "text": "In the past, a husking <w>bee</w> was a common way for farmers to help each other.",
                            "target_lang_translations": {
                                "ru": "В прошлом <w>толока</w> по очистке кукурузы была обычным способом взаимопомощи среди фермеров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quilting bee",
                        "sewing bee",
                        "husking bee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Социальное собрание людей, которые объединяются для выполнения определенной задачи или рабочего проекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толока",
                                "target_lang_sense_clarification": "коллективная помощь в работе"
                            },
                            {
                                "target_lang_word": "помочи",
                                "target_lang_sense_clarification": "совместный труд"
                            },
                            {
                                "target_lang_word": "посиделки",
                                "target_lang_sense_clarification": "совместная работа с общением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09abd263-6698-391d-8380-3cc4dda396bc",
                    "sense_definition": "The name of the letter B in the Latin alphabet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alphabet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word 'boy' starts with the letter <w>bee</w>.",
                            "target_lang_translations": {
                                "ru": "Слово «boy» начинается с буквы <w>би</w>."
                            }
                        },
                        {
                            "text": "He carefully pronounced the <w>bee</w> at the start of the sentence.",
                            "target_lang_translations": {
                                "ru": "Он тщательно произнес букву <w>бэ</w> в начале предложения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название буквы B в латинском алфавите."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "би",
                                "target_lang_sense_clarification": "английское произношение буквы B"
                            },
                            {
                                "target_lang_word": "бэ",
                                "target_lang_sense_clarification": "латинское название буквы B"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db9469a6-b597-359a-a072-41ffc8e55f1c",
                    "sense_definition": "Any stinging flying insect, often used loosely to refer to wasps or hornets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful near that nest, as those <w>bees</w> might sting you if provoked.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен рядом с тем гнездом, так как эти <w>пчелы</w> могут ужалить тебя, если их спровоцировать."
                            }
                        },
                        {
                            "text": "Many people mistakenly call a yellow jacket a <w>bee</w>.",
                            "target_lang_translations": {
                                "ru": "Многие люди ошибочно называют осу <w>пчелой</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used loosely for other stinging insects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое жалящее летающее насекомое, часто используется в разговорной речи для обозначения ос или шершней."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пчела",
                                "target_lang_sense_clarification": "любое жалящее насекомое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5465081a-cd63-3def-8f71-e08937d8f842",
                    "sense_definition": "Hardwood pieces bolted to a ship's bowsprit used to guide stays.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor checked the <w>bee</w> block to ensure the rigging was secure.",
                            "target_lang_translations": {
                                "ru": "Матрос проверил <w>би-блок</w>, чтобы убедиться в надежности такелажа."
                            }
                        },
                        {
                            "text": "The wooden <w>bee</w> on the bowsprit had worn down after years at sea.",
                            "target_lang_translations": {
                                "ru": "Деревянная <w>пчелка</w> на бушприте износилась за годы пребывания в море."
                            }
                        }
                    ],
                    "synonyms": [
                        "bee block"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Деревянные детали, прикрепленные к бушприту корабля, используемые для направления штагов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "би-блок",
                                "target_lang_sense_clarification": "морской термин"
                            },
                            {
                                "target_lang_word": "пчелка",
                                "target_lang_sense_clarification": "деталь бушприта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bffa874-443d-374f-b671-d1ac24b6672f",
                    "sense_definition": "A ring, torque, or bracelet, typically made of precious metal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jewelry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient king wore a heavy <w>bee</w> of gold around his neck.",
                            "target_lang_translations": {
                                "ru": "Древний царь носил на шее тяжелую золотую <w>гривну</w>."
                            }
                        },
                        {
                            "text": "Archaeologists discovered a silver <w>bee</w> among the treasures in the tomb.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили серебряное <w>кольцо</w> среди сокровищ в гробнице."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кольцо, гривна или браслет, обычно из драгоценного металла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кольцо",
                                "target_lang_sense_clarification": "украшение"
                            },
                            {
                                "target_lang_word": "гривна",
                                "target_lang_sense_clarification": "шейное украшение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e1e00eb8-3860-3ba1-99d2-f448c11eda6f",
                    "sense_definition": "A short or diminutive form of the female name <w>Beatrice</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her full name is Beatrice, but everyone calls her <w>Bee</w> for short.",
                            "target_lang_translations": {
                                "ru": "Ее полное имя Беатрис, но все зовут ее просто <w>Би</w>."
                            }
                        },
                        {
                            "text": "Aunt <w>Bee</w> is coming over for dinner this Sunday.",
                            "target_lang_translations": {
                                "ru": "Тетя <w>Би</w> придет к нам на обед в это воскресенье."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a nickname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая или уменьшительная форма женского имени Беатрис."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Би",
                                "target_lang_sense_clarification": "уменьшительное имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9b6d114-066e-3e3c-b64d-d102eb797ad4",
                    "sense_definition": "A family name or surname.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named Arthur <w>Bee</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Артур <w>Би</w>."
                            }
                        },
                        {
                            "text": "There are several families with the surname <w>Bee</w> living in this town.",
                            "target_lang_translations": {
                                "ru": "В этом городе живут несколько семей с фамилией <w>Би</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Би",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb25e872-3f66-3632-b39b-17c5ac5da2c5",
                    "sense_definition": "An old way of spelling the verb <w>be</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old manuscript, the author wrote that things should <w>bee</w> done quickly.",
                            "target_lang_translations": {
                                "ru": "В старой рукописи автор писал, что дела должны <w>быть</w> сделаны быстро."
                            }
                        },
                        {
                            "text": "It was common in the sixteenth century to <w>bee</w> inconsistent with spelling.",
                            "target_lang_translations": {
                                "ru": "В шестнадцатом веке было обычным делом <w>быть</w> непоследовательным в правописании."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старое написание глагола be (быть)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть",
                                "target_lang_sense_clarification": "архаичное написание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
