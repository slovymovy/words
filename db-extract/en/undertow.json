                    }
                ],
                "senses": [
                    {
                        "sense_id": "651ce300-d383-3401-adac-17444da61179",
                        "entry_id": "26c576eb-4bf1-398b-9b1d-f867ae057de2",
                        "glosses": [
                            "A short-range flow of water returning seaward from the waves breaking on the shore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e60fee0-e4e6-418b-8dea-13157bca8666",
                                "sense_id": "651ce300-d383-3401-adac-17444da61179",
                                "text": "A strong undertow may sweep a returning swimmer off their feet but it does not carry them far from the shore."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb320c2c-bfb1-3e67-8550-3ddc47d057e0",
                        "entry_id": "26c576eb-4bf1-398b-9b1d-f867ae057de2",
                        "glosses": [
                            "A feeling that runs contrary to one's normal one."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d9b80e3-d7c6-40d0-809b-38ee6040b8e0",
                        "source_entry_id": "26c576eb-4bf1-398b-9b1d-f867ae057de2",
                        "source_sense_description": "flow of water",
                        "target_lang_word": "courant de retour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6997c654-ae1c-4db8-870f-445edfd20d36",
                        "source_entry_id": "26c576eb-4bf1-398b-9b1d-f867ae057de2",
                        "source_sense_description": "flow of water",
                        "target_lang_word": "reflux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reflux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fac9393-2f04-3dfe-a08f-3bf91ab24be6",
                                        "entry_id": "8209ba8c-f3a7-31dd-94d1-b2cc414c4e2b",
                                        "glosses": [
                                            "Mouvement réglé de la mer qui se retire du rivage après le flux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7e8e218-7c13-41ea-ae0f-74d576391f8b",
                                                "sense_id": "9fac9393-2f04-3dfe-a08f-3bf91ab24be6",
                                                "text": "Le dimanche après-midi, avec un vieux vélo de dame, je parcourais les kilomètres qui séparaient mon lieu de résidence de la mer et j'allais contempler le flux et le reflux de l'océan."
                                            },
                                            {
                                                "example_id": "8b1304b0-9153-4cb1-b8f4-6753d196f1b0",
                                                "sense_id": "9fac9393-2f04-3dfe-a08f-3bf91ab24be6",
                                                "text": "Mais bientôt le reflux se fait sentir; la mer, après quelques oscillations, commence à baisser."
                                            },
                                            {
                                                "example_id": "5a8f1fa6-9375-4b81-bbfd-4c4e8e2dcc73",
                                                "sense_id": "9fac9393-2f04-3dfe-a08f-3bf91ab24be6",
                                                "text": "Au fond, vers le Louvre, tout bouillonnait ; des flux énormes de foule, puis des reflux soudains ; des regards furieux ; des multitudes qui se disloquaient, se formaient en bandes d'où jaillissaient des vociférations qui crépitaient sur le murmure immense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c70bc662-219c-3900-9026-bec3070befbd",
                                        "entry_id": "8209ba8c-f3a7-31dd-94d1-b2cc414c4e2b",
                                        "glosses": [
                                            "Vicissitude, changement alternatif des choses humaines."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b338b41c-b7f2-4b65-8929-f1ffbd6b5944",
                                                "sense_id": "c70bc662-219c-3900-9026-bec3070befbd",
                                                "text": "Dans quel flux et reflux de pensées, de résolutions, de plans de conduite, Ernest ne fut-il pas bercé avant de sommeiller !"
                                            },
                                            {
                                                "example_id": "b80539ea-5c2e-481a-be3a-408e8d647357",
                                                "sense_id": "c70bc662-219c-3900-9026-bec3070befbd",
                                                "text": "De l’assuétude, qui signifie la longue accoutumance, on peut dire qu’elle est d’emblée aussi consuétude, et par un mouvement qui n’est pas de reflux ou de résorption."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f46f129f-f643-3230-a9a1-da05cae7d598",
                                        "entry_id": "8209ba8c-f3a7-31dd-94d1-b2cc414c4e2b",
                                        "glosses": [
                                            "Réjection du bol alimentaire, chez le nourrisson, chez l’adulte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c28fb0e8-7d01-337e-a795-ab9c7141b337",
                                        "entry_id": "8209ba8c-f3a7-31dd-94d1-b2cc414c4e2b",
                                        "glosses": [
                                            "Mode de solubilisation avec une faible quantité de liquide qui, par condensation, dissout des substances à son contact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "690bd0c7-4a33-45b5-82b0-a55d6d77d146",
                                                "sense_id": "c28fb0e8-7d01-337e-a795-ab9c7141b337",
                                                "text": "Après refroidissement, ajouter 5 ml d'acide nitrique concentré, couvrir d'un verre de montre et remettre le bécher sur la plaque chauffante en maintenant un doux reflux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24fc91cd-4f79-4740-a65b-9b24ea36b331",
                        "source_entry_id": "26c576eb-4bf1-398b-9b1d-f867ae057de2",
                        "source_sense_description": "flow of water",
                        "target_lang_word": "Sog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07cc0fb3-3008-3d18-a6e4-a7d867a7deb6",
                                        "entry_id": "f85119ee-520f-332a-8ed1-cbe2243f0825",
                                        "glosses": [
                                            "saugende oder ziehende Strömung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fd04e84-1f73-4345-a504-85426a145a52",
                                                "sense_id": "07cc0fb3-3008-3d18-a6e4-a7d867a7deb6",
                                                "text": "Er konnte nicht mehr an Land schwimmen, als er in den Sog der Schiffsschraube geriet."
                                            },
                                            {
                                                "example_id": "57fe8607-04c6-4825-a6cc-97a3eb8f0c89",
                                                "sense_id": "07cc0fb3-3008-3d18-a6e4-a7d867a7deb6",
                                                "text": "Ein Schiff legt sich in den Sog oder das Fahrwasser eines anderen Schiffes, wenn es dessen Spur nachfährt."
                                            },
                                            {
                                                "example_id": "99e2986f-572c-4e9f-92c0-5a33d24265b9",
                                                "sense_id": "07cc0fb3-3008-3d18-a6e4-a7d867a7deb6",
                                                "text": "„Wenn man auch tausendmal an ihnen vorbeigeht, so kann man doch schließlich ihrem Sog nicht widerstehen und wird ihr Opfer.“"
                                            },
                                            {
                                                "example_id": "c6c83ce9-1aec-40f7-94de-78a798b68bc3",
                                                "sense_id": "07cc0fb3-3008-3d18-a6e4-a7d867a7deb6",
                                                "text": "„Niemals würde ich mich in den Sog von Ideen ziehen lassen, die dem Terrorismus huldigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "301d0b52-8b24-48fb-b108-60af458096ad",
                        "source_entry_id": "26c576eb-4bf1-398b-9b1d-f867ae057de2",
