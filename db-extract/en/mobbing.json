                                        "sense_id": "1030caf0-5830-35bc-8a3d-3906e7220b3a",
                                        "entry_id": "5f4f57ed-84c6-3133-942d-ca732effc9d9",
                                        "glosses": [
                                            "uporczywe celowe znęcanie się, ośmieszanie, izolowanie lub zastraszanie, zwłaszcza w pracy lub szkole, przez jedną osobę (np. szefa), lub grupę kolegów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7e4e0a8-0252-4ba6-a43b-0ef58ad1093a",
                                                "sense_id": "1030caf0-5830-35bc-8a3d-3906e7220b3a",
                                                "text": "Według art. 943 § 2. Kodeksu Pracy mobbing oznacza działania lub zachowania dotyczące pracownika lub skierowane przeciwko pracownikowi, polegające na uporczywym i długotrwałym nękaniu lub zastraszaniu pracownika, wywołujące u niego zaniżoną ocenę przydatności zawodowej, powodujące lub mające na celu poniżenie lub ośmieszenie pracownika, izolowanie go lub wyeliminowanie z zespołu współpracowników."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aac27b74-7300-480a-a459-a47f065f80c4",
                        "source_entry_id": "90b43765-b01e-3b7d-86be-5df5ee032d31",
                        "source_sense_description": "group bullying",
                        "target_lang_word": "тра́вля",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тра́вля",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "85ceafae-e744-3a66-aa08-43270ea56e5f",
                                        "entry_id": "fb273112-65c5-3ba4-997c-e5ae6fa5710a",
                                        "glosses": [
                                            "действие по значению гл. травить; преследование зверя, птицы, реже — человека; обычно на охоте, с собаками или ловчими птицами; гон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c53340ff-e6a3-4d1c-bc64-81304ab10bfb",
                                                "sense_id": "85ceafae-e744-3a66-aa08-43270ea56e5f",
                                                "text": "Проживая в Александровской слободе, она занималась соколиною охотою и ездила в пригородное село Курганиху, где был большой лес; там производили ей в забаву травлю волков."
                                            },
                                            {
                                                "example_id": "359a23bc-730e-4f41-8b8c-5377e5d9174a",
                                                "sense_id": "85ceafae-e744-3a66-aa08-43270ea56e5f",
                                                "text": "Сверх того всякую неделю посещал монастыри в окрестностях столицы и в праздничные дни забавлялся медвежьею травлею."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0b447a1-37e0-3ef8-8655-e9ed9735ecde",
                                        "entry_id": "fb273112-65c5-3ba4-997c-e5ae6fa5710a",
                                        "glosses": [
                                            "уничтожение животных с помощью ядов, ловушек и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8e6485-27c7-49b6-a257-55590b7312c3",
                                                "sense_id": "a0b447a1-37e0-3ef8-8655-e9ed9735ecde",
                                                "text": "Он здраво оценил собственные перспективы и занялся старым промыслом — травлей бытовых насекомых."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d103468d-c415-3f88-99e8-25bdf7826576",
                                        "entry_id": "fb273112-65c5-3ba4-997c-e5ae6fa5710a",
                                        "glosses": [
                                            "нападки, преследование"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c404fc0c-ded9-4f28-a6e5-ba73c626e820",
                                                "sense_id": "d103468d-c415-3f88-99e8-25bdf7826576",
                                                "text": "Говорили о том, что началась настоящая травля Некрасова в печати."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
