                        "sense_id": "7ea9258d-db43-32cc-98fe-288807f6ddff",
                        "entry_id": "1c2b46e4-fbd0-3f31-9414-379ae9184878",
                        "glosses": [
                            "Lieu peuplé principalement de genévrier."
                        ],
                        "tags": [
                            "Phytosociologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9198d9a4-bcfe-40a2-a2e4-5b66fd8d2c08",
                                "sense_id": "7ea9258d-db43-32cc-98fe-288807f6ddff",
                                "text": "La junipéraie de San Cristôbal se localise au nord de Casla et au sud-est de Santa Marta del Cerro."
                            },
                            {
                                "example_id": "147eddf6-de3a-43bd-b479-24d5e0d7faa0",
                                "sense_id": "7ea9258d-db43-32cc-98fe-288807f6ddff",
                                "text": "La disparition accélérée de la junipéraie élimine cette fonction de condensation de l’humidité transportée par le régime d’alizé."
                            },
                            {
                                "example_id": "0d13a603-52b6-430b-ad9b-37870eb14586",
                                "sense_id": "7ea9258d-db43-32cc-98fe-288807f6ddff",
                                "text": "La commune possède également un espace naturel prestigieux qui est classé en deux zones ZNIEFF […]: les dunes de la superbe plage de Cupabia et la junipéraie de Porto Pollo, les divers étangs et zones humides protégées."
                            }
                        ]
                    }
