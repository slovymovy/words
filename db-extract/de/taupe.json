                    {
                        "translation_id": "355bdf2d-24b2-4c17-81f9-d6229bc1ce00",
                        "source_entry_id": "9dcc8eca-c7c5-3c57-8da4-04256bdf735a",
                        "source_sense_id": "e097cf4b-b2cf-370f-82a5-8b71e2b67e50",
                        "source_sense_description": "eine graue, dunkle Farbe mit einem Rotschimmer",
