                                "example_id": "f4886641-8e72-4590-b0fc-c471a706fd1e",
                                "sense_id": "00a3ef4d-22b7-3ae4-8d53-b12a7b258253",
                                "text": "In Hotelbetten schlafe ich immer schlecht."
                            },
                            {
                                "example_id": "863fb815-4bb0-4b01-931b-12166b6a4d00",
                                "sense_id": "00a3ef4d-22b7-3ae4-8d53-b12a7b258253",
                                "text": "„Sie lag in der Dunkelheit in ihrem Hotelbett, und es dauerte ziemlich lange, bis sie wieder einschlief.“"
                            },
                            {
                                "example_id": "63a8b1c9-658f-4471-8b13-0369a96b4691",
                                "sense_id": "00a3ef4d-22b7-3ae4-8d53-b12a7b258253",
                                "text": "„Du kannst das Hotelbett ungemacht zurücklassen.“"
                            }
                        ],
