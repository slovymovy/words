                        "glosses": [
                            "(wiederholte) Handlung, Geldwäsche zu vollziehen; Legalisierung gesetzwidrig erworbenen Geldes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017677ca-f9eb-4910-98a1-198c7ba41884",
                                "sense_id": "a38e2695-63d9-349e-a374-73cfa6423af7",
                                "text": "„Jérôme Cahuzac, früherer Finanzminister, ausgerechnet jener, der die Steuerflucht bekämpfen wollte, wurde wegen Steuerbetrug und Geldwäscherei verurteilt.“"
                            }
                        ],
