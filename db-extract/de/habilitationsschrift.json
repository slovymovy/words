                        "glosses": [
                            "umfangreiche und anspruchsvolle wissenschaftliche Arbeit, die zum Zwecke der Habilitation angefertigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b1631f3-df67-446e-8ddb-bd21658c5df1",
                                "sense_id": "14b1a10b-cef3-38af-94e3-63a6a17a8442",
                                "text": "Monique hat fünf Jahre lang an ihrer Habilitationsschrift gearbeitet."
                            },
                            {
                                "example_id": "efc2e5ec-d43b-4fc3-83a7-ebea8a549174",
                                "sense_id": "14b1a10b-cef3-38af-94e3-63a6a17a8442",
                                "text": "Die Habilitationsschriften der Absolventen unserer Fakultät finden Sie in dem Segment dort drüben."
                            },
                            {
                                "example_id": "800d1330-1d4f-4bf9-9a2d-02efee59a0fd",
                                "sense_id": "14b1a10b-cef3-38af-94e3-63a6a17a8442",
                                "text": "Paula hat sich für ihre Habilitationsschrift einen sehr hochwertigen Einband ausgesucht."
                            },
                            {
                                "example_id": "410bd4f8-646f-426e-a656-5af4bc5b59c3",
                                "sense_id": "14b1a10b-cef3-38af-94e3-63a6a17a8442",
                                "text": "Mit ihrer Habilitationsschrift gewann Tina einen Wissenschaftspreis."
                            },
                            {
                                "example_id": "f2aec526-1f31-40bd-9fa5-0c4770f22030",
                                "sense_id": "14b1a10b-cef3-38af-94e3-63a6a17a8442",
                                "text": "In den Jahren, in denen er an seiner Habilitationsschrift saß, nahm Tonis Motivation immer weiter ab, was man dem Endprodukt leider deutlich anmerkt."
                            },
                            {
                                "example_id": "2a820bab-28d7-4659-a1b5-549c606bc731",
                                "sense_id": "14b1a10b-cef3-38af-94e3-63a6a17a8442",
                                "text": "Im Rahmen eines traditionellen Habilitationsverfahrens wird durch die Anfertigung einer Habilitationsschrift die Fähigkeit nachgewiesen, im Fachgebiet substantielle und umfassende wissenschaftliche Ergebnisse selbständig zu erzielen.“"
                            }
