                        "examples": [
                            {
                                "example_id": "943597fd-4e92-467c-86d6-893bdb4dc276",
                                "sense_id": "a9f21d29-229d-30a3-9d21-72a677161d72",
                                "text": "„Nach einem völlig unnötigen Handspiel von Steffen Reuther im eigenen Strafraum zeigte der Schiedsrichter auf den Elfmeter-Punkt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "383155d0-d13f-323e-ae9f-9eeb77e89ef8",
                        "entry_id": "989d2778-145a-32a0-91b4-3c39d58f5a4b",
                        "glosses": [
                            "Spiel aus der Hand, also nur mit den Karten, die man in der Hand hält"
                        ],
                        "tags": [
                            "insbesondere Skat"
                        ],
                        "examples": [
                            {
                                "example_id": "c51fe980-6c5b-429a-af93-90df81dfc4c0",
                                "sense_id": "383155d0-d13f-323e-ae9f-9eeb77e89ef8",
                                "text": "„Der Alleinspieler kann ein Handspiel wählen, bei dem er ohne den Skat spielt […] und den Skat auch nicht ansehen darf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "207acf3b-49cb-4b94-87a8-dd5d053664fe",
