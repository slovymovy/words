                    {
                        "translation_id": "201ade78-be46-4f29-9405-364a4ebdacf5",
                        "source_entry_id": "5fab79ca-eeb7-3b14-bb1e-fc5779b0c714",
                        "source_sense_id": "c92cd848-fe66-3aa2-92a5-0080e28b2c6d",
                        "source_sense_description": "verkeersongeval waarbij minstens één auto betrokken is",
                        "target_lang_word": "Autounfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autounfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d94329a5-155a-3c9d-b713-22417dcbabc6",
                                        "entry_id": "06e556f3-700b-337d-96d2-acb2d1554146",
                                        "glosses": [
                                            "ein Unfall mit, durch, in einem Auto; ein Verkehrsunfall mit einem beteiligten Kraftfahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ef2cd1e-04e4-415f-8f87-1d4689bf336a",
                                                "sense_id": "d94329a5-155a-3c9d-b713-22417dcbabc6",
                                                "text": "Anneliese hatte vorige Woche einen Autounfall."
                                            },
                                            {
                                                "example_id": "9bb01721-5c98-4163-a9e2-e834b906f266",
                                                "sense_id": "d94329a5-155a-3c9d-b713-22417dcbabc6",
                                                "text": "„Bei einem Autounfall wurde ich einmal aus dem Auto und unter einen Lastwagen geschleudert.“"
                                            },
                                            {
                                                "example_id": "4023f466-1c3a-422f-b57f-652e9c66d18d",
                                                "sense_id": "d94329a5-155a-3c9d-b713-22417dcbabc6",
                                                "text": "„Sein Vater entzog sich in die ferne Welt, seine Mutter Julia kam kurz nach der Trennung bei einem Autounfall ums Leben.“"
                                            },
                                            {
                                                "example_id": "dcdff807-d6ed-42c7-8083-6a4f66d199f4",
                                                "sense_id": "d94329a5-155a-3c9d-b713-22417dcbabc6",
                                                "text": "„Dean ist am zwölften Juni bei einem Autounfall umgekommen.“"
                                            },
                                            {
                                                "example_id": "d128cedc-ab7e-492b-ae6a-149551ea8337",
                                                "sense_id": "d94329a5-155a-3c9d-b713-22417dcbabc6",
                                                "text": "„Schließlich sind Mama und Papa bei einem Autounfall ums Leben gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6ec5f5d-c9c1-4fa4-9b1c-1489636e3a40",
                        "source_entry_id": "5fab79ca-eeb7-3b14-bb1e-fc5779b0c714",
                        "source_sense_id": "c92cd848-fe66-3aa2-92a5-0080e28b2c6d",
