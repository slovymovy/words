                        "es": [
                            {
                                "target_lang_word": "los Thu",
                                "target_lang_sense_clarification": "forma de referirse a los miembros de la familia Thu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "Thu 一家",
                                "target_lang_sense_clarification": "用于指代姓 Thu 的家庭成员"
                            }
                        ]
