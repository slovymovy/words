                "senses": [
                    {
                        "sense_id": "8bd33b8b-4f18-32bc-a0e8-67dfc669be75",
                        "entry_id": "92d68729-b35d-3c72-89a5-7e6deb4f5e96",
                        "glosses": [
                            "vor dem Mund getragener Gegenstand, der den Träger vor gefährlichen Stoffen oder Krankheiten schützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d63dfbc7-ba21-495e-b090-2d74597b59b1",
                                "sense_id": "8bd33b8b-4f18-32bc-a0e8-67dfc669be75",
                                "text": "„Konkrete Daten zur Effektivität von Atemschutzmasken, eine Infektion mit M. tuberculosiszu verhüten, existieren nicht […].“"
                            },
                            {
                                "example_id": "422efb63-50a2-4fb7-a461-93629d371ec7",
                                "sense_id": "8bd33b8b-4f18-32bc-a0e8-67dfc669be75",
                                "text": "„Die Atemschutzmaske […] zwingt mich, deutlich langsamer zu atmen, als ich es eigentlich möchte.“"
                            },
                            {
                                "example_id": "edaa961b-fb32-450a-a5e8-7d1009d304f1",
                                "sense_id": "8bd33b8b-4f18-32bc-a0e8-67dfc669be75",
                                "text": "„Auf Bildern aus den vom Coronavirus betroffenen Regionen Chinas tragen die Menschen häufig Mundschutz oder Atemschutzmaske.“"
                            },
                            {
                                "example_id": "8e4f6c42-abdf-4c4b-be2a-3325f1a782ba",
                                "sense_id": "8bd33b8b-4f18-32bc-a0e8-67dfc669be75",
                                "text": "„Die Sorge vor einer Infektion mit dem neuartigen Coronavirus lässt in Apotheken die Nachfrage nach Atemschutzmasken steigen, in Bayern sind sie vereinzelt bereits ausverkauft.“"
                            },
                            {
                                "example_id": "247915a3-fec2-4eea-91a7-0335819c808a",
                                "sense_id": "8bd33b8b-4f18-32bc-a0e8-67dfc669be75",
                                "text": "„Atemschutzmasken werden in Zeiten des Coronavirus dringender gebraucht denn je.“"
                            },
                            {
                                "example_id": "072a28e9-6725-4df5-955f-99b355f5ce8e",
                                "sense_id": "8bd33b8b-4f18-32bc-a0e8-67dfc669be75",
                                "text": "„Endlich ist sie da: In der deutschen Hauptstadt ist am Wochenende eine große Lieferung dringend benötigter Atemschutzmasken und Schutzkittel aus China angekommen.“"
                            },
                            {
                                "example_id": "4b97401e-52f7-4ab7-9791-4d553101cc54",
                                "sense_id": "8bd33b8b-4f18-32bc-a0e8-67dfc669be75",
                                "text": "„Krankenhäuser und Ärzte brauchen Masken, die für den medizinischen Einsatz zertifiziert sind, also OP-Masken oder Atemschutzmasken des Typs FFP2 und FFP3.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
