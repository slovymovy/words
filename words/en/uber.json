        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8831aa5-82f9-3aaf-a114-0c1f84abbc8e",
                    "sense_definition": "A car ride requested using the mobile application Uber, or the vehicle used for such a ride.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rideshare_noun",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "I decided to call an <w>Uber</w> because it was raining heavily.",
                            "target_lang_translations": {
                                "ru": "Я решил вызвать <w>Убер</w>, так как шел сильный дождь.",
                                "es": "Decidí pedir un <w>Uber</w> porque estaba lloviendo muy fuerte."
                            }
                        },
                        {
                            "text": "There are usually plenty of <w>Ubers</w> available near the train station.",
                            "target_lang_translations": {
                                "ru": "Около вокзала обычно доступно много <w>Уберов</w>.",
                                "es": "Normalmente hay muchos <w>ubers</w> disponibles cerca de la estación de tren."
                            }
                        }
                    ],
                    "synonyms": [
                        "rideshare",
                        "taxi",
                        "cab",
                        "lift"
                    ],
                    "common_phrases": [
                        "call an Uber",
                        "take an Uber",
                        "order an Uber",
                        "wait for an Uber"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used generically for any app-based rideshare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поездка на автомобиле, заказанная через приложение Uber, или сам автомобиль.",
                        "es": "Viaje solicitado mediante la aplicación Uber, o el propio vehículo utilizado para dicho transporte."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Убер",
                                "target_lang_sense_clarification": "сервис такси или машина этого сервиса"
                            },
                            {
                                "target_lang_word": "такси",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "uber",
                                "target_lang_sense_clarification": "vehículo o viaje solicitado por aplicación"
                            },
                            {
                                "target_lang_word": "Uber",
                                "target_lang_sense_clarification": "nombre propio o servicio"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8168060-8833-3e3b-be96-f87c5f3cc017",
                    "sense_definition": "To travel to a destination using a mobile app-based ridesharing service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rideshare_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We can just <w>Uber</w> to the restaurant instead of driving.",
                            "target_lang_translations": {
                                "ru": "Мы можем просто <w>поехать на Убере</w> в ресторан, вместо того чтобы вести машину.",
                                "es": "Podemos simplemente <w>ir en Uber</w> al restaurante en lugar de conducir."
                            }
                        },
                        {
                            "text": "She <w>Ubered</w> home after the party ended late at night.",
                            "target_lang_translations": {
                                "ru": "Она <w>поехала на Убере</w> домой после того, как вечеринка закончилась поздно ночью.",
                                "es": "Ella <w>se fue en Uber</w> a casa después de que la fiesta terminara a altas horas de la noche."
                            }
                        }
                    ],
                    "antonyms": [
                        "drive",
                        "walk"
                    ],
                    "common_phrases": [
                        "Uber home",
                        "Uber there",
                        "Uber everywhere"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "derived from the brand name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ехать куда-либо, используя сервис заказа такси через приложение.",
                        "es": "Desplazarse o viajar hacia un destino usando un servicio de transporte por aplicación como Uber."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поехать на Убере",
                                "target_lang_sense_clarification": "использовать сервис для поездки"
                            },
                            {
                                "target_lang_word": "вызвать Убер",
                                "target_lang_sense_clarification": "заказать машину"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ir en Uber",
