                "forms": [],
                "senses": [
                    {
                        "sense_id": "5add25de-4c37-35bd-bb19-447bffd4f14b",
                        "entry_id": "eab483e3-2687-353b-8cce-76ddbbc3e873",
                        "glosses": [
                            "ergens aan vastvriezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04c4e914-868a-478b-81ba-585740a24c33",
                                "sense_id": "5add25de-4c37-35bd-bb19-447bffd4f14b",
                                "text": "Sinds een paar dagen komt de lucht boven Nederland van de regio's rond de poolcirkel. Daardoor is de atmosfeer koud. Waar mist ontstaat kan deze aanvriezen en dan wordt het glad, vooral op bruggen, viaducten en op wegen die dicht bij water liggen."
                            },
                            {
                                "example_id": "c7651fb8-8bd5-455e-9664-cc08af7cefe8",
                                "sense_id": "5add25de-4c37-35bd-bb19-447bffd4f14b",
                                "text": "Het verkeer moet vanochtend in het hele land rekening houden met gladheid en dichte mist en op sommige plaatsen zeer dichte mist. De temperatuur daalde in de nacht op veel plaatsen tot onder het vriespunt. Daardoor kan mist aanvriezen op plaatsen waar niet gestrooid is."
                            },
                            {
                                "example_id": "f5ab5700-452b-43c6-9191-0d9dffd9a403",
                                "sense_id": "5add25de-4c37-35bd-bb19-447bffd4f14b",
                                "text": "De Verkeersinformatiedienst waarschuwt bovendien dat in Zuid-Holland en Zeeland ook dichte mist kan voorkomen, die ook kan aanvriezen. \"Alsof de gladheid niet voor genoeg problemen zorgt\", aldus de VID."
                            }
                        ]
                    }
