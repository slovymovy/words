                                                "sense_id": "c09a2a89-ebb3-306c-a6e5-c04f7e84b2ae",
                                                "text": "De strijdlustige advocaat was een goede verdediger van zijn cliënt."
                                            },
                                            {
                                                "example_id": "ab54028b-6f5e-444f-b181-b925af807979",
                                                "sense_id": "c09a2a89-ebb3-306c-a6e5-c04f7e84b2ae",
