                "senses": [
                    {
                        "sense_id": "d2d6e8e7-f835-32b6-b834-bd914daa7ef7",
                        "entry_id": "61e8020c-0cc1-3752-9a42-0646a6503f58",
                        "glosses": [
                            "Portefeuille électronique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37e7a295-8f42-4036-98d9-5d7e156741a1",
                                "sense_id": "d2d6e8e7-f835-32b6-b834-bd914daa7ef7",
                                "text": "Pas besoin de wallet pour commencer à jouer, gagner des tokens et collectionner les NFT représentant les cartes des joueurs."
                            },
                            {
                                "example_id": "d3cd65d2-c05b-40a9-b8a6-574c3ddb0c38",
                                "sense_id": "d2d6e8e7-f835-32b6-b834-bd914daa7ef7",
                                "text": "Un wallet permet le stockage et l’utilisation de crypto-actifs, en termes d’analogie ça serait comme un portefeuille."
                            },
                            {
                                "example_id": "3cf539cb-b497-4b3f-9222-1f961f2b93f7",
                                "sense_id": "d2d6e8e7-f835-32b6-b834-bd914daa7ef7",
                                "text": "La justice allemande avait saisi les wallets et les 50 000 bitcoins qu’ils contenaient. Un homme allemand de 40 ans et un homme polonais de 37 ans, sont soupçonnés d’être propriétaire du site de piratage allemand. L’un d’entre eux avait « volontairement transféré » les fonds à l’Office fédéral de police criminelle en 2020."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d726fccf-122e-4701-be84-41422bd80ea8",
                        "source_entry_id": "61e8020c-0cc1-3752-9a42-0646a6503f58",
                        "source_sense_id": "d2d6e8e7-f835-32b6-b834-bd914daa7ef7",
                        "target_lang_word": "wallet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wallet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5056c0d-7f45-37dc-91b2-20b3b75f9cfe",
                                        "entry_id": "53154ad5-f1bd-3439-bbe1-553db3f4c7ae",
                                        "glosses": [
                                            "A small case, often flat and often made of leather, for keeping money (especially paper money), credit cards, etc."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b87b9123-93f3-4564-966f-7c593dae3b4d",
                                                "sense_id": "d5056c0d-7f45-37dc-91b2-20b3b75f9cfe",
                                                "text": "The thief stole all the money and credit cards out of the old man's wallet."
                                            },
                                            {
                                                "example_id": "cb26efd1-b799-4666-860c-02c21445ca02",
                                                "sense_id": "d5056c0d-7f45-37dc-91b2-20b3b75f9cfe",
                                                "text": "I forgot my wallet and left it at home."
                                            },
                                            {
                                                "example_id": "e4f20c47-3629-46b9-a163-1f175f16e12d",
                                                "sense_id": "d5056c0d-7f45-37dc-91b2-20b3b75f9cfe",
                                                "text": "Master leathercrafter does handcrafted wallets, belts, purses, handbags etc., supporting self and helpers. Good enough to carve fantst art and portraits into leather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6de82c11-6c27-3e35-aabb-81cd4cd5b8ad",
                                        "entry_id": "53154ad5-f1bd-3439-bbe1-553db3f4c7ae",
                                        "glosses": [
                                            "A person's bank account or assets."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a90d5bc6-be27-4f31-ae30-92ae43a32f80",
                                                "sense_id": "6de82c11-6c27-3e35-aabb-81cd4cd5b8ad",
                                                "text": "It's unknown if the pro running back's recent sex scandal will hit him in the wallet or not."
                                            },
                                            {
                                                "example_id": "402a881e-c6c4-4e4f-bf82-42bcb7d9708c",
                                                "sense_id": "6de82c11-6c27-3e35-aabb-81cd4cd5b8ad",
                                                "text": "In all of India, China, Africa, and much of the southern American continent, those who had the leisure and wallet for fashion—or more simply, in the poorer latitudes, for the mere acquisition of things—would have killed for the street merchandise of Manhattan […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38054395-c8ad-3d8f-a795-155769cc217c",
                                        "entry_id": "53154ad5-f1bd-3439-bbe1-553db3f4c7ae",
                                        "glosses": [
                                            "An e-wallet or digital wallet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10d48743-8e8b-3f78-8f70-11ed6ee3923b",
                                        "entry_id": "53154ad5-f1bd-3439-bbe1-553db3f4c7ae",
                                        "glosses": [
                                            "A thick case or folder with plastic sleeves in which compact discs may be stored."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "733951a9-4726-4b8c-971b-63f1ce021a32",
                                                "sense_id": "10d48743-8e8b-3f78-8f70-11ed6ee3923b",
                                                "text": "I won an auction online for a cheap CD wallet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a604f622-af5e-3193-8a3c-f12e5f1cbac8",
                                        "entry_id": "53154ad5-f1bd-3439-bbe1-553db3f4c7ae",
                                        "glosses": [
                                            "A bag or pouch."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd26951d-29a3-4da0-a40c-f4aa4bc2eff9",
                                                "sense_id": "a604f622-af5e-3193-8a3c-f12e5f1cbac8",
                                                "text": "He brought with him a large wallet with some provisions for the road."
