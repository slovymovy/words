                "senses": [
                    {
                        "sense_id": "d5f85496-6d20-3b36-84bd-412b0834120c",
                        "entry_id": "747ddf63-6a5f-3e52-bd65-eec04ea1379a",
                        "glosses": [
                            "categorie in een kunstvorm (literatuur, muziek, film, enz.) met specifieke kenmerken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e0f0b4-2d80-44d9-a00e-595a6b8fbf9e",
                                "sense_id": "d5f85496-6d20-3b36-84bd-412b0834120c",
                                "text": "Politiedrama is een genre dat al jaren scoort op tv."
                            },
                            {
                                "example_id": "0cc4fb43-7538-4118-b782-bbf76acb082c",
                                "sense_id": "d5f85496-6d20-3b36-84bd-412b0834120c",
                                "text": "Het dancefestival biedt podium voor de meest uiteenlopende stromingen in het genre."
                            },
                            {
                                "example_id": "26e48d20-6d07-4afb-bfd4-4f39be622b11",
                                "sense_id": "d5f85496-6d20-3b36-84bd-412b0834120c",
                                "text": "Maar bovenal komt die verdraaiing van de werkelijkheid door Yorgos Lanthimos. De absurdistische Griekse regisseur (Dogtooth, The Lobster, The Killing of a Sacred Deer) geeft het genre [kostuumdrama] letterlijk een andere draai, door vaak een vervreemdend perspectief te kiezen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa55637d-8d39-4810-bb64-e7e91763ddc0",
                        "source_entry_id": "747ddf63-6a5f-3e52-bd65-eec04ea1379a",
                        "source_sense_id": "d5f85496-6d20-3b36-84bd-412b0834120c",
                        "source_sense_description": "categorie in een kunstvorm",
                        "target_lang_word": "genre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
