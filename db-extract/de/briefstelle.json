                    {
                        "sense_id": "d7918435-7602-381a-8f8c-e50a6698decb",
                        "entry_id": "dbf14e03-a628-37ae-a2c1-4c0c6ad2c0e1",
                        "glosses": [
                            "eine bestimmte Stelle/Passage in einem Brief"
