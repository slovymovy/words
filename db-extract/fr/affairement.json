        "fr-extract.jsonl": [
            {
                "entry_id": "f43c9abf-dc88-3851-81e0-44a9ab03ef0b",
                "word": "affairement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "583ae0bc-8811-4a8f-934e-792c570082f7",
                        "entry_id": "f43c9abf-dc88-3851-81e0-44a9ab03ef0b",
                        "tags": [
                            "plural"
                        ],
                        "form": "affairements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce799552-6e92-3ec5-b7f0-dfe5dc7564ad",
                        "entry_id": "f43c9abf-dc88-3851-81e0-44a9ab03ef0b",
                        "glosses": [
                            "Action de s'affairer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd8269f5-593b-4ee5-bcf1-32a09e58331d",
                                "sense_id": "ce799552-6e92-3ec5-b7f0-dfe5dc7564ad",
                                "text": "Traversant les convulsions de notre époque - hystérie de l'actualité, affairements, diktat de la communication - que dit le roman contemporain ?"
                            },
                            {
                                "example_id": "a6fe755a-6cc3-48de-b20a-f8b49359a47b",
                                "sense_id": "ce799552-6e92-3ec5-b7f0-dfe5dc7564ad",
                                "text": "Un affairement continu l’essouflait."
                            },
                            {
                                "example_id": "6e9c791f-832b-4ddb-8957-91809e9fb1ce",
                                "sense_id": "ce799552-6e92-3ec5-b7f0-dfe5dc7564ad",
                                "text": "Surtout que c’est, en plus, un important nœud ferroviaire, qu’il y a du passage, de l’affairement, un roulement d’argent…"
                            },
                            {
                                "example_id": "ead5809c-c00f-4bc3-b30f-dd1bdf7117bf",
                                "sense_id": "ce799552-6e92-3ec5-b7f0-dfe5dc7564ad",
                                "text": "Pendant plusieurs jours, ce ne fut pour Nazira et sa mêre, qu’affairement parmi les boutiques, discussions de prix, …."
                            },
                            {
                                "example_id": "c0cc7142-391c-4a78-a181-dcb55a9f5b7d",
                                "sense_id": "ce799552-6e92-3ec5-b7f0-dfe5dc7564ad",
                                "text": "J’aimais l’affairement de mes soldats, ces grosses faces plébéiennes où le sourire effaçait l’inquiétude."
                            },
                            {
                                "example_id": "1e10696a-af2c-4c3f-af60-18b8dacd2d04",
                                "sense_id": "ce799552-6e92-3ec5-b7f0-dfe5dc7564ad",
                                "text": "L’événement de la mort est toujours un affairement et c’est moi qui dus prendre en main les négociations avec la police pour déterminer le parcours du cortège."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edb9146b-45df-47f3-89cb-d1282ee607f7",
                        "source_entry_id": "f43c9abf-dc88-3851-81e0-44a9ab03ef0b",
                        "source_sense_id": "ce799552-6e92-3ec5-b7f0-dfe5dc7564ad",
                        "target_lang_word": "busying",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "busying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e0c3583-1174-3222-bdfc-16a82b95d1dd",
                                        "entry_id": "e7d879e8-b4f8-392e-9270-3c1b2fe7a766",
                                        "glosses": [
                                            "present participle and gerund of busy"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "busying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd03f3dd-f32f-3219-b9d7-7025372edb09",
                                        "entry_id": "be15ab78-752e-3aa8-b5cd-68ef65096f19",
                                        "glosses": [
                                            "busyness; making oneself busy with something"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2db97bc7-0fd6-400c-ae35-830ecafe35e4",
                                                "sense_id": "fd03f3dd-f32f-3219-b9d7-7025372edb09",
                                                "text": "All of you have some business or other to do in the world. Are not your thoughts, and talkings, and busyings, and anxieties, and cares, altogether about the business you have to do?"
                                            },
                                            {
                                                "example_id": "3a053f29-850d-4e1f-ae23-dd786794c70b",
                                                "sense_id": "fd03f3dd-f32f-3219-b9d7-7025372edb09",
                                                "text": "And as other dreams come from the multitude of business, so from such like busyings of the mind, we shall pray but dreamingly and distemperedly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72a1427b-27e0-4825-bc80-e76844281df1",
                        "source_entry_id": "f43c9abf-dc88-3851-81e0-44a9ab03ef0b",
                        "source_sense_id": "ce799552-6e92-3ec5-b7f0-dfe5dc7564ad",
                        "target_lang_word": "bustle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0718f116-0f01-3537-9f7c-f37bd1a29242",
                                        "entry_id": "3c44ada7-2d2c-3c19-b1ad-d92f3260b2aa",
                                        "glosses": [
                                            "An excited activity; a stir."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26b20fba-a7c8-497b-8aee-733746e4e294",
                                                "sense_id": "0718f116-0f01-3537-9f7c-f37bd1a29242",
                                                "text": "In the midſt of all this buſtle, I was ſtruck with the appearance of a large bevy of beauties and women of the firſt fashion, who with all the perfect confidence of good breeding, inſhrined themſelves in the ſeveral temples dedicated to the Cyprian Venus[.]"
                                            },
                                            {
                                                "example_id": "83947a97-bb0d-4741-b86a-bfc760fbcb45",
                                                "sense_id": "0718f116-0f01-3537-9f7c-f37bd1a29242",
                                                "text": "we are, perhaps, all the while flattering our natural indolence, which, hating the bustle of the world, and drudgery of business seeks a pretence of reason to give itself a full and uncontrolled indulgence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6681b38a-a822-3b3e-a584-3c40c3358e00",
                                        "entry_id": "3c44ada7-2d2c-3c19-b1ad-d92f3260b2aa",
                                        "glosses": [
                                            "A cover to protect and hide the back panel of a computer or other office machine."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9268e8b4-497a-3090-a54e-13bad678d693",
                                        "entry_id": "3c44ada7-2d2c-3c19-b1ad-d92f3260b2aa",
                                        "glosses": [
                                            "A frame worn underneath a woman's skirt, typically only protruding from the rear as opposed to the earlier more circular hoops."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc9a110b-58eb-4fb4-ab23-eda944c5eaed",
                                                "sense_id": "9268e8b4-497a-3090-a54e-13bad678d693",
                                                "text": "All the portraits that hang on the walls of the living room are, I realize, of my mother's family: miniatures of her great-aunts in Victorian bustles and elaborate feathered hats; a gilt-framed oil of her great-great-great-uncle as a boy in pastoral England, wearing a gold riding coat over white jodhpurs and sitting astride a white steed, a King Charles spaniel yapping at them from the foreground of the canvas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "790072e6-a4cc-3786-bffd-f6e756b1c6f2",
                                        "entry_id": "20ad084f-ca1d-3973-9ca0-c143971c0f3f",
                                        "glosses": [
                                            "To move busily and energetically with fussiness (often followed by about)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c341664-d506-4ea4-8af5-c00eecea49d2",
                                                "sense_id": "790072e6-a4cc-3786-bffd-f6e756b1c6f2",
                                                "text": "The commuters bustled about inside the train station."
                                            },
                                            {
                                                "example_id": "61196184-155b-4e59-ade5-b2baec05a93d",
                                                "sense_id": "790072e6-a4cc-3786-bffd-f6e756b1c6f2",
                                                "text": "I was once so mad to bussell abroad, and seek about for preferment […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e427dae0-b605-392e-abbf-d4682ebe7455",
                                        "entry_id": "20ad084f-ca1d-3973-9ca0-c143971c0f3f",
                                        "glosses": [
                                            "To teem or abound (usually followed by with); to exhibit an energetic and active abundance (of a thing)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f874ee3-cdbd-4fbe-8a9f-11767b692fe3",
                                                "sense_id": "e427dae0-b605-392e-abbf-d4682ebe7455",
                                                "text": "The train station was bustling with commuters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d91af679-37f3-3d90-be43-ba54606a8b84",
                                        "entry_id": "20ad084f-ca1d-3973-9ca0-c143971c0f3f",
                                        "glosses": [
                                            "To push around, to importune."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57a89d1d-f98f-4597-83bd-203a1b556dbc",
                                                "sense_id": "d91af679-37f3-3d90-be43-ba54606a8b84",
                                                "text": "Don’t bustle her or fuss or snatch: / A suitor looking at his watch / Is not a posture that persuades / Willing, much less reluctant maids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
