                                "target_senses": [
                                    {
                                        "sense_id": "15140890-54fb-31f0-978e-857f6ff76504",
                                        "entry_id": "150058ec-07b7-3b7b-9d23-dbb33567d007",
                                        "glosses": [
                                            "Ronde de nuit faite par des troupes de garde dans une ville, pour la sûreté des habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20eceab7-4982-4376-91d1-7451dd79acc1",
                                                "sense_id": "15140890-54fb-31f0-978e-857f6ff76504",
                                                "text": "Dans les ténèbres de la vallée, sur le tracé des routes, des chemins et des sentiers de petits points lumineux se déplaçaient : c’était la lanterne des patrouilles, le fanal des brancardiers, la torche des charrieurs de morts en travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e1eafaf-453e-361e-b8f1-6adeb33aed41",
                                        "entry_id": "150058ec-07b7-3b7b-9d23-dbb33567d007",
                                        "glosses": [
                                            "Marche de surveillance, d’une exploration faite par un détachement de soldats, d’agents de police, soit pour empêcher les surprises de la part de l’ennemi, soit pour prévenir les désordres et arrêter les malfaiteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1bd9fa5-c9f9-4619-9c78-dee9d60dfa2f",
                                                "sense_id": "4e1eafaf-453e-361e-b8f1-6adeb33aed41",
                                                "text": "Aller en patrouille."
                                            },
                                            {
                                                "example_id": "2d1e85a2-09e0-4e64-ab97-42e6148828c2",
                                                "sense_id": "4e1eafaf-453e-361e-b8f1-6adeb33aed41",
                                                "text": "Faire des patrouilles, envoyer des patrouilles devant les lignes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c076dfbb-5cb0-3979-82a8-ca3a3b334fb1",
                                        "entry_id": "150058ec-07b7-3b7b-9d23-dbb33567d007",
                                        "glosses": [
                                            "Le détachement lui-même qui fait la patrouille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e38d84-9486-4070-adb9-fea87f98efdc",
                                                "sense_id": "c076dfbb-5cb0-3979-82a8-ca3a3b334fb1",
                                                "text": "Dans une cave, une patrouille égarée du ***, que les compagnies se passent, que le capitaine Fontange félicite, que le capitaine Perret veut fusiller comme déserteurs."
                                            },
                                            {
                                                "example_id": "63ed26be-930c-4e2b-8c4e-f3eb562f9a04",
                                                "sense_id": "c076dfbb-5cb0-3979-82a8-ca3a3b334fb1",
                                                "text": "Nos patrouilles sont dans le bois de Bantheville et nos troupes ont pénétré dans les positions de Saint-Georges et de Landres-et-Saint-Georges. Nous avons dénombré environ sept cent cinquante prisonniers."
                                            },
                                            {
                                                "example_id": "423581f9-8d10-4c87-ad2c-a4391bd53117",
                                                "sense_id": "c076dfbb-5cb0-3979-82a8-ca3a3b334fb1",
                                                "text": "Les patrouilles de surveillance qui, d’abord, avaient impitoyablement fusillé les maraudeurs et les pillards, étaient maintenant dispersées par l’épidémie […]."
                                            }
                                        ]
                                    }
                                ]
                            },
