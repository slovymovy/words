                                "target_senses": [
                                    {
                                        "sense_id": "c556a4b1-6b3f-369c-8e53-83f9d440f62d",
                                        "entry_id": "0c59a4b7-7bee-3fc2-bebe-1dbe0abaf5b6",
                                        "glosses": [
                                            "The meat from a horse."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7302d73c-a740-4e58-a560-8d3d209e8508",
                                                "sense_id": "c556a4b1-6b3f-369c-8e53-83f9d440f62d",
                                                "text": "In January 2013, supermarkets were hit by an extraordinary scandal as it emerged that foods made of processed 'beef' actually contained horsemeat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c64b798-8360-498a-885f-1bd129bfb879",
                        "source_entry_id": "6e155812-f67b-32fa-9b8b-58fc778eab78",
                        "source_sense_id": "63058966-21c2-3f33-8f69-2b6f07217086",
                        "target_lang_word": "horseflesh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horseflesh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6d8d484-3f1f-3827-a6ca-b59307778662",
                                        "entry_id": "4bd64b5e-ea08-3382-b214-cac2a2334d98",
                                        "glosses": [
                                            "The flesh of a horse; horsemeat."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bebcb8ca-2fef-47b4-92c2-816ca13365cd",
                                                "sense_id": "f6d8d484-3f1f-3827-a6ca-b59307778662",
                                                "text": "Do they take to the cooking of horseflesh in ragoûts, emincés, and cheval à la mode without a tinge of disgust?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "247d6fc5-fecf-3003-b19b-37343bcb3c7c",
                                        "entry_id": "4bd64b5e-ea08-3382-b214-cac2a2334d98",
                                        "glosses": [
                                            "Horses collectively, with reference to driving, riding, or racing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b9291d4-65ac-4ddb-8f6a-f260cf4a1099",
                                                "sense_id": "247d6fc5-fecf-3003-b19b-37343bcb3c7c",
                                                "text": "He is a good judge of horseflesh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93f7070b-aa06-3ae4-83b4-25c9b5df3fba",
                                        "entry_id": "4bd64b5e-ea08-3382-b214-cac2a2334d98",
                                        "glosses": [
                                            "Bahama mahogany, wood from species Lysiloma sabicu and Lysiloma latisiliquum."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "horseflesh",
