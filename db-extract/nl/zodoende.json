                                            {
                                                "example_id": "fbc84923-27a3-41e4-9567-29d4daa7013e",
                                                "sense_id": "fd469cf5-5afc-352a-92dc-5df3d686655d",
                                                "text": "Gold ist in kleinen Stückelungen vergleichsweise teuer. Zehn Goldmünzen zu einem Gramm sind folglich teurer, als eine Goldmünze zu zehn Gramm."
                                            },
                                            {
                                                "example_id": "e92565d7-2dbe-4d6c-b4b1-3433a1fa7b2f",
                                                "sense_id": "fd469cf5-5afc-352a-92dc-5df3d686655d",
                                                "text": "Wer seine Sommerbräune möglichst lange erhalten will, sollte viel cremen. Denn trockene Haut schuppt leicht, und die Bräune verschwindet folglich schneller wieder."
                                            }
                                        ],
