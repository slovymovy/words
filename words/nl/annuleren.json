{
    "word_family": [
        "annulering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f513239-8c77-3e7d-af0d-b28e90115a8a",
                    "sense_definition": "Een geplande activiteit, afspraak of bestelling niet door laten gaan; afgelasten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "afgelasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "U kunt deze overdracht niet meer <w>annuleren</w>.",
                            "target_lang_translations": {
                                "en": "You can no longer <w>cancel</w> this transfer."
                            }
                        },
                        {
                            "text": "We moesten de vlucht naar Londen op het laatste moment <w>annuleren</w>.",
                            "target_lang_translations": {
                                "en": "We had to <w>cancel</w> the flight to London at the last minute."
                            }
                        }
                    ],
                    "synonyms": [
                        "cancelen"
                    ],
                    "antonyms": [
                        "bevestigen",
                        "boeken"
                    ],
                    "common_phrases": [
                        "een vlucht annuleren",
                        "een afspraak annuleren",
                        "de bestelling annuleren"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop a planned activity, appointment, or order from going ahead; to call off."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cancel",
                                "target_lang_sense_clarification": "for appointments, flights, orders, or events"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcf0cc33-2465-3336-8b5b-48607c09c988",
                    "sense_definition": "Een overeenkomst, huwelijk of besluit officieel ongeldig verklaren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ongeldig_verklaren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter besloot het contract volledig te <w>annuleren</w>.",
                            "target_lang_translations": {
                                "en": "The judge decided to completely <w>annul</w> the contract."
                            }
                        },
                        {
                            "text": "Zij willen hun huwelijk officieel laten <w>annuleren</w>.",
                            "target_lang_translations": {
                                "en": "They want to have their marriage officially <w>annulled</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "bekrachtigen"
                    ],
                    "common_phrases": [
                        "het contract annuleren",
                        "een huwelijk annuleren"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially declare an agreement, marriage, or decision invalid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "annul",
                                "target_lang_sense_clarification": "officially declare a marriage or contract invalid"
                            },
                            {
                                "target_lang_word": "cancel",
                                "target_lang_sense_clarification": "officially terminate a contract or agreement"
                            },
                            {
                                "target_lang_word": "void",
                                "target_lang_sense_clarification": "declare a legal document or decision invalid"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}