                                "example_id": "4710e072-caae-464c-9889-086a7ce9d56a",
                                "sense_id": "1de4ffdc-1bf0-3431-921a-cb51775b55c1",
                                "text": "Studenten kunnen hun interessegebieden verkennen door een of meerdere keuzevakken te volgen.",
                                "translation": "Students can explore their areas of interest by taking one or more elective courses.",
                                "english": "Students can explore their areas of interest by taking one or more elective courses."
