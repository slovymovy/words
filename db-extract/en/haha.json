                "senses": [
                    {
                        "sense_id": "d8c8a301-1b9e-3884-acd0-ffe012b98878",
                        "entry_id": "7af113de-1136-36ca-b862-473db65e5cdb",
                        "glosses": [
                            "To laugh."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f330ad-9be3-4e89-97e6-465cca4138ba",
                                "sense_id": "d8c8a301-1b9e-3884-acd0-ffe012b98878",
                                "text": "NatThrowinAwayMyShot: Haha, what?! GoChloGo: Y r u haha-ing?"
                            },
                            {
                                "example_id": "e57a4d25-1651-4a07-9864-df674cefe2fd",
                                "sense_id": "d8c8a301-1b9e-3884-acd0-ffe012b98878",
                                "text": "First he regarded the strangers, then his own band, and his mouth was expanded to a still wider grin; his eyes opened to their fullest extent, and at last he haha’d as furiously and heartily as the worst of the sailors, which was naturally the signal for an outbreak on the part of the islanders."
                            },
                            {
                                "example_id": "ed5f41aa-4ff2-4b80-ad30-02670a9f8205",
                                "sense_id": "d8c8a301-1b9e-3884-acd0-ffe012b98878",
                                "text": "Emett yelled for him, and Jones and Jim “hahaed!”"
                            },
                            {
                                "example_id": "ca3b6482-b529-4ade-a443-85e40b0e497a",
                                "sense_id": "d8c8a301-1b9e-3884-acd0-ffe012b98878",
                                "text": "She haha’d like she ate diamonds for breakfast and flossed with spun gold."
                            },
                            {
                                "example_id": "bb29f2f5-52b7-41d1-a4e1-caf3d96741b9",
                                "sense_id": "d8c8a301-1b9e-3884-acd0-ffe012b98878",
                                "text": "Then she shrugged and haha-ed again and mumbled, “Poor souls,” because she thought she was safe and none of us could comprehend a single word she said."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
