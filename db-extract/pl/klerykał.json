                                        "examples": [
                                            {
                                                "example_id": "032e20ca-523a-48ad-9a09-1fe34bb880fb",
                                                "sense_id": "93e6a093-604a-325c-98f2-736eb4d86c9e",
                                                "text": "What is striking in this letter is its deeply clericalist character."
                                            }
                                        ]
