                    }
                ],
                "senses": [
                    {
                        "sense_id": "bbb297c0-ba32-3ec5-b764-653093f13c00",
                        "entry_id": "3b21583f-cb43-37e6-937f-230f44ebf1c6",
                        "glosses": [
                            "Abondance, richesse, état de ce qui est luxuriant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a887f06d-bb6d-477f-be4b-708dd0307c3c",
                                "sense_id": "bbb297c0-ba32-3ec5-b764-653093f13c00",
                                "text": "Une plus grande teneur de l’air en gaz carbonique permettrait d’ailleurs d’expliquer la luxuriance de la végétation sans faire intervenir un climat équatorial."
                            },
                            {
                                "example_id": "d722cfaa-8d0b-447d-9752-2ff187fa3a49",
                                "sense_id": "bbb297c0-ba32-3ec5-b764-653093f13c00",
                                "text": "La beauté disparait sous la luxuriance des détails."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3df1e683-1f3c-469b-8e8e-e55ddb682049",
                        "source_entry_id": "3b21583f-cb43-37e6-937f-230f44ebf1c6",
                        "source_sense_id": "bbb297c0-ba32-3ec5-b764-653093f13c00",
                        "target_lang_word": "luxuriance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luxuriance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2577491-d968-35f0-9068-8c81d0f785d2",
                                        "entry_id": "f631a655-9346-3461-a2a6-fc09789f8d9f",
                                        "glosses": [
                                            "The property of being luxuriant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e3ca394-ded2-4c96-bc41-500c5ff88ff9",
                                                "sense_id": "f2577491-d968-35f0-9068-8c81d0f785d2",
                                                "text": "Yet such was the luxuriance of the tropical growth that the rats had not attained such numbers as to provide competition among members of the species."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdf7de7a-ce8a-4544-9413-8e8c9f686d92",
                        "source_entry_id": "3b21583f-cb43-37e6-937f-230f44ebf1c6",
                        "source_sense_id": "bbb297c0-ba32-3ec5-b764-653093f13c00",
                        "target_lang_word": "overvloed",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overvloed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                        "entry_id": "91de9a6e-6fda-3449-a7c0-d17d16bc6758",
                                        "glosses": [
                                            "het voorhanden zijn van meer dan voldoende van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7136de4-062d-42e1-99be-94b85c3246e0",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Dat had de bodem gelegd voor de welstand, om niet te zeggen overvloed, van de voltallige familie voor de nabije toekomst."
                                            },
                                            {
                                                "example_id": "d876f1c7-8c33-4ead-867f-b69e0d307e44",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Er was een overvloed van aardbeien dat jaar."
                                            },
                                            {
                                                "example_id": "e4d7f0e0-375a-4480-bebf-e6866abf8120",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Menselijke aangelegenheden waren al net zo onveranderlijk als de seizoenen. Keizerrijken bloeiden op en raakten in verval. Perioden van overvloed werden afgewisseld met hongersnoden, maar in essentie bleef alles bij het oude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57e72b86-72b9-4647-a2d0-967d9614d9d2",
                        "source_entry_id": "3b21583f-cb43-37e6-937f-230f44ebf1c6",
                        "source_sense_id": "bbb297c0-ba32-3ec5-b764-653093f13c00",
                        "target_lang_word": "rijkdom",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rijkdom",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "78818dd3-4655-3e23-a20c-47e3bc917832",
                                        "entry_id": "a314010e-1a6e-3a95-859f-857aa89c406d",
                                        "glosses": [
                                            "het bezitten van veel geld en goud"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bbe1047-b7a6-4c08-b0e5-295f314f4029",
                                                "sense_id": "78818dd3-4655-3e23-a20c-47e3bc917832",
                                                "text": "Hij leefde in grote rijkdom."
                                            },
                                            {
                                                "example_id": "315c3d7a-e081-431f-aa8c-a30fe18df95b",
                                                "sense_id": "78818dd3-4655-3e23-a20c-47e3bc917832",
                                                "text": "De broeders vonden het ontoelaatbaar dat ze van het toppunt van waardigheid, invloed, macht en al die rijkdom naar beneden tuimelden door de lectuur van één boekje; daarom vielen ze de auteur aan."
                                            },
                                            {
                                                "example_id": "19576fcc-5cea-43ba-b8cf-2b953a291f58",
                                                "sense_id": "78818dd3-4655-3e23-a20c-47e3bc917832",
                                                "text": "Het was vooral een herinnering aan al die dingen waaraan hij vermeed te denken, de laatste jaren tenminste, aan hoe makkelijk het was geweest om van armoede tot rijkdom te komen, al hield hij niet van dat woord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d86d585c-121d-3784-98a0-e5f0da24bdb1",
                                        "entry_id": "a314010e-1a6e-3a95-859f-857aa89c406d",
                                        "glosses": [
                                            "het bezitten van andere waarden zoals geluk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d409b6-cdc2-498b-91de-70ac9ba250c6",
                                                "sense_id": "d86d585c-121d-3784-98a0-e5f0da24bdb1",
                                                "text": "Hij had niet veel geld, maar beschouwde zijn gezin en zijn gezondheid als rijkdom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e1a285-d2d7-39d0-87ec-249e807ac93a",
                                        "entry_id": "a314010e-1a6e-3a95-859f-857aa89c406d",
                                        "glosses": [
                                            "gewoonlijk meervoud de bezittingen die iemand rijk maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eb28da5-7450-4ab2-b093-d4c0a12b3b0f",
                                                "sense_id": "b8e1a285-d2d7-39d0-87ec-249e807ac93a",
                                                "text": "De rijkdommen die hij daar te zien kreeg, verbijsterden hem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa078be-a923-326c-88c7-fafd52e22bd7",
                                        "entry_id": "a314010e-1a6e-3a95-859f-857aa89c406d",
                                        "glosses": [
                                            "overvloed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f8c36ef-a271-4f3e-87dc-6e4468ece1e4",
                                                "sense_id": "afa078be-a923-326c-88c7-fafd52e22bd7",
                                                "text": "In het oerwoud is een rijkdom van bomen en planten te vinden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
