                                        "sense_id": "9423ad97-0ad0-3960-8023-268d5ad33e0b",
                                        "entry_id": "256b90b4-541d-3086-9e35-e70456c083cf",
                                        "glosses": [
                                            "The official currency of several countries, including Algeria, Bahrain, Iraq, Jordan, Kuwait, Libya, Serbia, Tunisia and (as denar) North Macedonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48958834-f2e7-44c0-a6a5-bf8364de95bb",
                                                "sense_id": "9423ad97-0ad0-3960-8023-268d5ad33e0b",
                                                "text": "Standing near Joseph, carrying a bag of taboon flatbreads, was Olivier, from Ivory Coast. He arrived a year ago and has been trying to save the 3,000 dinars (£780) he said it would cost to make the trip to Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a94c352-d262-3ea2-bd4b-6d82a446d086",
                                        "entry_id": "256b90b4-541d-3086-9e35-e70456c083cf",
                                        "glosses": [
                                            "An ancient Arab gold coin of 65 grains in weight."
                                        ],
