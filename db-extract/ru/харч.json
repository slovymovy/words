                        "examples": [
                            {
                                "example_id": "c85e56ca-0e84-413c-8097-0ea418ef433f",
                                "sense_id": "ecfdfc51-0af1-353a-967c-a628feaaa138",
                                "text": "перебира́ть харча́ми",
                                "translation": "to be overly picky (also figuratively)",
                                "english": "to be overly picky (also figuratively)"
                            },
                            {
                                "example_id": "27d3e8c8-0c11-48cd-800f-7e699c9940c8",
                                "sense_id": "ecfdfc51-0af1-353a-967c-a628feaaa138",
                                "text": "мета́ть харч",
                                "translation": "to vomit",
                                "english": "to vomit"
                            },
                            {
                                "example_id": "618ece5f-a7d5-48c7-9f25-8f2211c31664",
                                "sense_id": "ecfdfc51-0af1-353a-967c-a628feaaa138",
                                "text": "— Кото́рые без привы́чки, тем, изве́стно, тру́дно, — говори́л он, — а обтерпе́лся — ничего́. То́лько бы харчи́ были настоя́щие. Снача́ла харчи́ плохи́ бы́ли. Ну, а пото́м наро́д оби́делся, и харчи́ ста́ли хоро́шие, и рабо́тать ста́ло легко́.",
                                "translation": "\"Those who are not used to it find it hard, of course,\" he said; \" but when one`s hardened it doesn`t matter, if only the food is right. At first the food was bad. Later the people complained, and they got good food, and it was easy to work.\"",
                                "english": "\"Those who are not used to it find it hard, of course,\" he said; \" but when one`s hardened it doesn`t matter, if only the food is right. At first the food was bad. Later the people complained, and they got good food, and it was easy to work.\""
                            }
                        ]
                    }
