                                        "entry_id": "9a823287-fb91-3109-8741-c392455f9c45",
                                        "glosses": [
                                            "A city in South Korea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d27dfe03-973e-460e-9586-ca29e26cb072",
                                                "sense_id": "4e83ea00-237c-31e1-b6a3-917cacd38282",
                                                "text": "Vice-Admiral Kamimura reports that at dawn of the 14th instant, our squadron found, off Ulsan, the south-eastern coast of Corea, three ships of the Vladivostock squadron steaming southward."
                                            },
                                            {
                                                "example_id": "32853fd5-105b-4d27-9fc6-05f904d0a384",
                                                "sense_id": "4e83ea00-237c-31e1-b6a3-917cacd38282",
                                                "text": "At least 80 people were being treated for smoke inhalation from the blaze, at a 33-story building in the city of Ulsan, according to the Yonhap news agency. No deaths were immediately reported."
                                            }
                                        ]
                                    }
                                ]
                            }
