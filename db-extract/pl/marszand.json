                    {
                        "translation_id": "5ba67e61-6e28-4faa-ae97-be82bd3e332c",
                        "source_entry_id": "645ff81c-ad55-343a-9bfc-6ba1399e3739",
                        "source_sense_id": "c2f2144a-da01-3383-9705-8c95025556d3",
                        "target_lang_word": "kunsthandelaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kunsthandelaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7a26f450-237e-3e82-8628-862cf929b0fb",
                                        "entry_id": "39ffb385-de8e-33e7-9168-23e6d51e700b",
                                        "glosses": [
                                            "iemand die voor zijn beroep kunst koopt en verkoopt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd47297f-4bb7-4a16-8126-45f6c88de580",
                                                "sense_id": "7a26f450-237e-3e82-8628-862cf929b0fb",
                                                "text": "Rudi Ekkart, die lang onderzoek deed naar eigenaren van in de Tweede Wereldoorlog geroofde kunst, stelt een tentoonstelling samen over deze zogenoemde roofkunst. Die is te zien vanaf 12 mei in de Deventer Bergkerk en omvat onder meer werken die deel uitmaakten van de verzamelingen van nazileider Adolf Hitler en rijksmaarschalk Hermann Göring. Ook is er kunst uit de vroegere collectie van de Nederlandse oorlogsmisdadiger Pieter Menten. De expositie Roofkunst vertelt over Joodse kunsthandelaren en particulieren van wie kunstwerken in de oorlog in Duitse handen terecht waren gekomen."
                                            },
                                            {
                                                "example_id": "def7bc5b-8d02-480e-ac54-a61cd2ab0f29",
                                                "sense_id": "7a26f450-237e-3e82-8628-862cf929b0fb",
                                                "text": "Op een Amerikaanse kunstveiling is een onbekend schilderij opgedoken van Nijmegen van rond de 18e eeuw. 'Probably Paris', was de omschrijving, 'waarschijnlijk Parijs'. Maar kunsthandelaar Patrick Peeters wist wel beter. Als kunstliefhebber en -kenner wist hij meteen dat het om een tafereel bij Nijmegen ging."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33f8c048-05c1-4bbc-b26f-5a377f4a4724",
                        "source_entry_id": "645ff81c-ad55-343a-9bfc-6ba1399e3739",
                        "source_sense_id": "c2f2144a-da01-3383-9705-8c95025556d3",
                        "target_lang_word": "Kunsthändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kunsthändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e982371a-c342-3bbb-8fd4-865bd518f9f9",
                                        "entry_id": "c821fd68-a776-3dc9-98fd-f0822f4ef191",
                                        "glosses": [
                                            "Person, die Kunstwerke kauft und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "798d136a-2c60-4a98-bf2e-6de6211f3477",
                                                "sense_id": "e982371a-c342-3bbb-8fd4-865bd518f9f9",
                                                "text": "Kunsthändlerin Eva und Kunsthändler Adam erfüllten sich einen lang gehegten Wunsch, eine Galerie zu eröffnen."
                                            },
                                            {
                                                "example_id": "ccf2c353-5158-4070-8a8f-2a265aef559b",
                                                "sense_id": "e982371a-c342-3bbb-8fd4-865bd518f9f9",
                                                "text": "„Der Schwiegervater war Kunsthändler und die Wohnung der Tochter diente als Zwischenlager.“"
                                            },
                                            {
                                                "example_id": "998f586d-0a5a-40ef-ac21-30925e68f4ce",
                                                "sense_id": "e982371a-c342-3bbb-8fd4-865bd518f9f9",
                                                "text": "„Wenn meine Großmutter von Mamans Jugend sprach, klang sie immer wie ein Kunsthändler, der einem inzwischen hoch gehandelten Werk nachtrauerte, das er vor langer Zeit viel zu günstig verkauft hatte.“"
                                            },
                                            {
                                                "example_id": "27fe01c3-da49-4371-8317-932df7f9b9ee",
                                                "sense_id": "e982371a-c342-3bbb-8fd4-865bd518f9f9",
                                                "text": "„Allerdings waren die Margen bei solchen Geschäften so lukrativ, dass sich trotzdem viele Kunsthändler und Auktionatoren darauf einließen, auch Maître Bellier.“"
                                            },
                                            {
                                                "example_id": "f5615329-ed79-447b-8522-6b07ab888d7b",
                                                "sense_id": "e982371a-c342-3bbb-8fd4-865bd518f9f9",
                                                "text": "„Sie führt ihn mit dem Kunsthändler Walter Feilchenfeldt zusammen, der Verlag und Kunsthandel von Paul Cassirer nach dessen Selbstmord weiterführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
