                "translations": [
                    {
                        "translation_id": "c9d5e79e-c25a-4058-96fb-d73ca55a7e93",
                        "source_entry_id": "23c8d069-fe04-3ef5-8add-2ae386212fd8",
                        "source_sense_id": "381cfebc-ec72-3f12-a4bc-26315d381c6d",
                        "target_lang_word": "xiphisternum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xiphisternum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b4ec288-0fba-39f7-83f7-11ffbd6c6442",
                                        "entry_id": "b4efbce4-4e84-3966-89ae-121bb96c1613",
                                        "glosses": [
                                            "Synonym of xiphoid process."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4faa7dad-8ab5-4fcb-8fa8-5fb9d2c3f15b",
                                                "sense_id": "5b4ec288-0fba-39f7-83f7-11ffbd6c6442",
                                                "text": "Hence the spaces between the forks of the hyposternum and between the hypo- and xiphisternums are relatively much smaller, and the external process of the hyposternum is twice as broad as in the common Cock."
                                            },
                                            {
                                                "example_id": "5d6e487f-1019-4ee1-8c23-3cd82a1904e8",
                                                "sense_id": "5b4ec288-0fba-39f7-83f7-11ffbd6c6442",
                                                "text": "1887, \"Skeleton\", entry in The Encyclopædia Britannica, Volume 22, 9th Edition, page 113,\nThe xiphisternum may assume various forms, but attains its maximum development in Birds, where it forms the part of the sternum posterior to the attachment of the ribs, and may consist of a median and four lateral processes, as in the Fowl. It bears the greater part of the keel."
                                            },
                                            {
                                                "example_id": "2e6a785a-986a-48d8-99bf-693ae45e4764",
                                                "sense_id": "5b4ec288-0fba-39f7-83f7-11ffbd6c6442",
                                                "text": "Unfixed cartilage was studied. It was isolated from the xiphisterna of female Sprague-Dawley rats (150-200 g body weight) killed by cervical fracture. The xiphisternum was removed immediately at its point of attachment to the sternal column."
                                            },
                                            {
                                                "example_id": "f2c4fda3-65bc-40e9-b458-190349de8964",
                                                "sense_id": "5b4ec288-0fba-39f7-83f7-11ffbd6c6442",
                                                "text": "Again, the distance between the umbilicus and the xiphisternum is divided into three equal parts, corresponding to 28, 32, and 36 weeks. At 36 weeks, the fundus is at the level of the xiphisternum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0774da12-a3ee-43a4-8001-9d6dcf4a1265",
                        "source_entry_id": "23c8d069-fe04-3ef5-8add-2ae386212fd8",
                        "source_sense_id": "381cfebc-ec72-3f12-a4bc-26315d381c6d",
