{
    "word_family": [
        "squawker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee7e2428-06fc-3a37-9bed-9c7fd1108123",
                    "sense_definition": "A loud, harsh, or shrill cry, typically made by a bird or a person in distress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parrot let out a loud <w>squawk</w> when the cat jumped onto its cage.",
                            "target_lang_translations": {
                                "ru": "Попугай издал громкий <w>крик</w>, когда кошка прыгнула на его клетку."
                            }
                        },
                        {
                            "text": "I heard a sudden <w>squawk</w> from the kitchen as the child dropped his toy.",
                            "target_lang_translations": {
                                "ru": "Я услышал внезапный <w>вскрик</w> из кухни, когда ребёнок уронил свою игрушку."
                            }
                        }
                    ],
                    "synonyms": [
                        "screech",
                        "shriek",
                        "yell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий, резкий или пронзительный крик, обычно издаваемый птицей или испуганным человеком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "громкий, резкий звук голоса или птичий крик"
                            },
                            {
                                "target_lang_word": "пронзительный крик",
                                "target_lang_sense_clarification": "резкий, пронзительный звук"
                            },
                            {
                                "target_lang_word": "писк",
                                "target_lang_sense_clarification": "визгливый или пронзительный звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5514ff62-b773-32fa-a860-849b420a17f7",
                    "sense_definition": "A complaint or an expression of dissatisfaction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a loud <w>squawk</w> from the customers about the new service fees.",
                            "target_lang_translations": {
                                "ru": "Со стороны клиентов поднялся громкий <w>вопль возмущения</w> по поводу новых сервисных сборов."
                            }
                        },
                        {
                            "text": "Management ignored every <w>squawk</w> from the staff regarding the office temperature.",
                            "target_lang_translations": {
                                "ru": "Руководство игнорировало каждую <w>жалобу</w> сотрудников по поводу температуры в офисе."
                            }
                        }
                    ],
                    "synonyms": [
                        "objection",
                        "complaint",
                        "protest"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жалоба или громкое выражение недовольства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалоба",
                                "target_lang_sense_clarification": "выражение недовольства"
                            },
                            {
                                "target_lang_word": "протест",
                                "target_lang_sense_clarification": "громкое возражение или возмущение"
                            },
                            {
                                "target_lang_word": "вопль",
                                "target_lang_sense_clarification": "разг., шумное возмущение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "775a5daa-b3a9-3094-8870-e01ba9d326f5",
                    "sense_definition": "A report of a technical issue or maintenance requirement, especially in aviation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot filed a maintenance <w>squawk</w> after noticing a vibration in the engine.",
                            "target_lang_translations": {
                                "ru": "Пилот записал <w>замечание</w> по техобслуживанию, заметив вибрацию в двигателе."
                            }
                        },
                        {
                            "text": "All mechanical <w>squawks</w> must be cleared before the aircraft is allowed to fly again.",
                            "target_lang_translations": {
                                "ru": "Все механические <w>неисправности</w> должны быть устранены до того, как самолёту снова разрешат летать."
                            }
                        }
                    ],
                    "synonyms": [
                        "report",
                        "defect"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in aviation industry jargon."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запись или сообщение о технической неисправности (в авиации)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечание",
                                "target_lang_sense_clarification": "запись о дефекте в бортжурнале"
                            },
                            {
                                "target_lang_word": "неисправность",
                                "target_lang_sense_clarification": "дефект или поломка оборудования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0162b082-d6d2-3f89-8f88-659ba45d27f3",
                    "sense_definition": "A four-digit identification code transmitted by an aircraft transponder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air traffic controller assigned a new <w>squawk</w> to the incoming flight.",
                            "target_lang_translations": {
                                "ru": "Авиадиспетчер присвоил прибывающему рейсу новый <w>код ответчика</w>."
                            }
                        },
                        {
                            "text": "The pilot entered the emergency <w>squawk</w> into the transponder system.",
                            "target_lang_translations": {
                                "ru": "Пилот ввёл аварийный <w>код</w> в систему ответчика."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in aviation."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Четырёхзначный идентификационный код, передаваемый ответчиком воздушного судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "код ответчика",
                                "target_lang_sense_clarification": "код радиолокационного ответчика"
                            },
                            {
                                "target_lang_word": "сквок-код",
                                "target_lang_sense_clarification": "жарг. авиационный код транспондера"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "281ac690-e59b-334e-b8f2-f1ecd6f5ba55",
                    "sense_definition": "To make a loud, harsh, or shrill cry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seagulls began to <w>squawk</w> loudly as we approached the beach with our food.",
                            "target_lang_translations": {
                                "ru": "Чайки начали громко <w>кричать</w>, когда мы подошли к пляжу с едой."
                            }
                        },
                        {
                            "text": "The frightened bird started to <w>squawk</w> when the door suddenly slammed shut.",
                            "target_lang_translations": {
                                "ru": "Испуганная птица начала <w>верещать</w>, когда дверь внезапно захлопнулась."
                            }
                        }
                    ],
                    "synonyms": [
                        "screech",
                        "shriek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать громкий, резкий или пронзительный крик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "издавать громкий крик"
                            },
                            {
                                "target_lang_word": "крикнуть",
                                "target_lang_sense_clarification": "однократно издать резкий крик"
                            },
                            {
                                "target_lang_word": "пронзительно кричать",
                                "target_lang_sense_clarification": "о птицах или людях"
                            },
                            {
                                "target_lang_word": "пищать",
                                "target_lang_sense_clarification": "издавать резкий, высокий звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82ce619b-b4f1-307f-8954-6323f3405ca6",
                    "sense_definition": "To complain or protest loudly and insistently.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The employees started to <w>squawk</w> when they heard about the new overtime policy.",
                            "target_lang_translations": {
                                "ru": "Сотрудники начали <w>возмущаться</w>, когда услышали о новых правилах сверхурочной работы."
                            }
                        },
                        {
                            "text": "It is useless to <w>squawk</w> about the rules after you have already signed the contract.",
                            "target_lang_translations": {
                                "ru": "Бесполезно <w>жаловаться</w> на правила после того, как вы уже подписали контракт."
                            }
                        }
                    ],
                    "synonyms": [
                        "complain",
                        "protest",
                        "grumble"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко, настойчиво жаловаться или выражать протест."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возмущаться",
                                "target_lang_sense_clarification": "громко выражать недовольство"
                            },
                            {
                                "target_lang_word": "жаловаться",
                                "target_lang_sense_clarification": "сетовать, выражать претензии"
                            },
                            {
                                "target_lang_word": "поднимать шум",
                                "target_lang_sense_clarification": "протестовать, скандалить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8f9b714-8b02-36a0-a7bf-77212c853da7",
                    "sense_definition": "To reveal secret information or betray someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang leader warned his members not to <w>squawk</w> to the police if they were caught.",
                            "target_lang_translations": {
                                "ru": "Главарь банды предупредил сообщников, чтобы те не вздумали <w>настучать</w> полиции, если их поймают."
                            }
                        },
                        {
                            "text": "He was afraid that his partner would <w>squawk</w> and tell the authorities everything.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что его напарник <w>расколется</w> и всё расскажет властям."
                            }
                        }
                    ],
                    "synonyms": [
                        "tattle",
                        "betray",
                        "snitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in criminal or underworld contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдавать секретную информацию, доносить или предавать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настучать",
                                "target_lang_sense_clarification": "жарг. донести властям или полиции"
                            },
                            {
                                "target_lang_word": "расколоться",
                                "target_lang_sense_clarification": "жарг. выдать секреты, заговорить"
                            },
                            {
                                "target_lang_word": "наябедничать",
                                "target_lang_sense_clarification": "разг. донести, выдать кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d21ab703-ac70-3571-aa28-f6817780d137",
                    "sense_definition": "To set an aircraft transponder to a specific identification code.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot was instructed to <w>squawk</w> code 1200 while flying in the local area.",
                            "target_lang_translations": {
                                "ru": "Пилоту было дано указание <w>установить на ответчике</w> код 1200 во время полёта в местной зоне."
                            }
                        },
                        {
                            "text": "In an emergency, the pilot should <w>squawk</w> 7700 to alert all nearby stations.",
                            "target_lang_translations": {
                                "ru": "В аварийной ситуации пилот должен <w>выставить код</w> 7700, чтобы оповестить все ближайшие станции."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Aviation terminology."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать определённый код на радиолокационном ответчике самолёта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устанавливать код ответчика",
                                "target_lang_sense_clarification": "вводить код транспондера"
                            },
                            {
                                "target_lang_word": "выставлять код",
                                "target_lang_sense_clarification": "авиац. на приборе опознавания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}