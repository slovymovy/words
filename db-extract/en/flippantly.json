                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                        "entry_id": "0e87d6cc-58e7-3457-b7a3-a9e4d4b88be5",
                                        "glosses": [
                                            "nicht gründlich oder auch nicht gründlich genug, nur das Äußere beachtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "611a86d6-b2ff-4417-bfa8-bf619b556ce4",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Eine hingeschluderte Arbeit nennt man oberflächlich."
                                            },
                                            {
                                                "example_id": "ad1be78d-126f-4273-a84c-155064668110",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Er hat viele Tiere und kann sich nicht um jedes kümmern, kann nur oberflächlich arbeiten."
                                            },
                                            {
                                                "example_id": "644b68be-eefb-4314-9a14-c82443b3b176",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Oberflächlich betrachtet, ist die Frage schnell zu beantworten, aber wenn man weiter nachdenkt, wird es schwieriger."
                                            },
                                            {
                                                "example_id": "10b86f5e-5f32-4a1b-ae03-24bd6eb588b6",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Die Frage der Finanzierung wurde nur oberflächlich gestreift."
                                            },
                                            {
                                                "example_id": "d5835093-c320-45cb-959c-63138900c405",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Leider ist seine neue Freundin ein recht oberflächlicher Mensch, sie hat nur Mode und Disko im Kopf."
                                            },
                                            {
                                                "example_id": "fa84a82e-8bca-4e01-a26c-8bec048afcea",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Welch ein oberflächlicher Angeber!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
