                ],
                "senses": [
                    {
                        "sense_id": "b852fcbf-82f7-3ef9-9187-59b2b2b92cbb",
                        "entry_id": "54d468db-efb8-3779-8c2b-a9fb897747b8",
                        "glosses": [
                            "Zeitraum der Literaturgeschichte, der sich durch bestimmte grundlegende Merkmale auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9170a3e5-64e8-472c-8af9-9e56f6702b91",
                                "sense_id": "b852fcbf-82f7-3ef9-9187-59b2b2b92cbb",
                                "text": "„Die Novelle Das Schloss Dürande gehört zur Literaturepoche der Romantik.“"
                            },
                            {
                                "example_id": "b5a2b69c-095a-4549-b227-a283dfde7a18",
                                "sense_id": "b852fcbf-82f7-3ef9-9187-59b2b2b92cbb",
                                "text": "„Etwa zeitgleich mit der Kunstepoche der (Weimarer) Klassik etablierte sich die Literaturepoche Romantik.“"
                            },
                            {
                                "example_id": "cfd5441e-c8b0-413d-a816-966d0bc42962",
                                "sense_id": "b852fcbf-82f7-3ef9-9187-59b2b2b92cbb",
                                "text": "„Der Beginn der romantischen Literaturepoche in Deutschland ist mit der Wanderung Ludwig Tiecks und Wilhelm Heinrich Wackenroders im Jahr 1793 anzusetzen.“"
                            },
                            {
                                "example_id": "eeb31055-2d31-4159-81e1-52481a6a6598",
                                "sense_id": "b852fcbf-82f7-3ef9-9187-59b2b2b92cbb",
                                "text": "„Wie die höfische Versepik ist auch der Minnesang der staufischen Literaturepoche zugeordnet.“"
                            },
                            {
                                "example_id": "b82e003f-9ad6-4a2a-8e8d-b0a5ef28b434",
                                "sense_id": "b852fcbf-82f7-3ef9-9187-59b2b2b92cbb",
                                "text": "„Die Frage nach der zeitlichen Eingrenzung des Mittelalters als Literaturepoche und seiner Binnengliederung scheint nur auf den ersten Blick überflüssig zu sein.“"
                            },
                            {
                                "example_id": "593661b9-19fc-4b48-966d-747745ea22f8",
                                "sense_id": "b852fcbf-82f7-3ef9-9187-59b2b2b92cbb",
                                "text": "„Die Rationalität und formalen Regeln der Literaturepoche der Aufklärung weichen der Darstellung der Subjektivität individueller Emotionen und Erlebnisse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
