                "senses": [
                    {
                        "sense_id": "3c8edcde-3714-3f76-badb-797ba102b574",
                        "entry_id": "7ce2a1cd-4a61-3520-ac10-b083a34b520e",
                        "glosses": [
                            "обрабатываться, делаться острым при точении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04edf285-a4f1-48d2-9dcd-2bdc6f746589",
                                "sense_id": "3c8edcde-3714-3f76-badb-797ba102b574",
                                "text": "― Всякий другой камень мокрым наждаком точится, а этому подавай сухой."
                            }
                        ]
                    },
                    {
                        "sense_id": "90e964c7-ec7e-3d2f-b39f-cb5383ddcc53",
                        "entry_id": "7ce2a1cd-4a61-3520-ac10-b083a34b520e",
                        "glosses": [
                            "страд. к точить"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "4d594bda-1321-4e13-9cbb-e40d6b8e29af",
                                "sense_id": "90e964c7-ec7e-3d2f-b39f-cb5383ddcc53",
                                "text": "Уже нельзя было лечь на подоконник, темно-серый и каменный, с фальшивыми нитями мраморных жил, и с обструганным, обнажавшим белый камень краем, о который точились перочинные ножи."
                            }
                        ]
                    }
