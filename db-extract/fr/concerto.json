                                        "glosses": [
                                            "публичное исполнение нескольких произведений, чаще всего музыкальных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "672e2a66-503f-450a-8f8a-41992708d1ed",
                                                "sense_id": "c88d0753-afe5-3e70-8c66-80528ddd57e5",
                                                "text": "Концерт длился почти пять часов."
                                            },
                                            {
                                                "example_id": "f1a09245-77c3-4d60-92f3-5014288313b6",
                                                "sense_id": "c88d0753-afe5-3e70-8c66-80528ddd57e5",
                                                "text": "В этом году саратовских меломанов ожидает восемь незаурядных концертов: пять сольных и три симфонических."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "339ff4e4-e1f6-3ed0-a4f2-9a55218dca68",
                                        "entry_id": "b8a274ef-0d09-3907-be93-fe77f9762f92",
                                        "glosses": [
                                            "муз. музыкальное произведение для одного (реже — нескольких) солирующего инструмента в сопровождении оркестра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5331aa73-f624-42e7-97c6-9f0dcc709083",
                                                "sense_id": "339ff4e4-e1f6-3ed0-a4f2-9a55218dca68",
                                                "text": "Башмет включил в эту программу реконструкцию Концерта для альта с оркестром Н. Паганини."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4c8311c-1254-3df0-9f68-c516a657613b",
                                        "entry_id": "b8a274ef-0d09-3907-be93-fe77f9762f92",
                                        "glosses": [
                                            "перен. ссора, сопровождаемая криками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d9230f-ea8c-450b-b18c-151937a694b8",
                                                "sense_id": "b4c8311c-1254-3df0-9f68-c516a657613b",
                                                "text": "Жена мне каждый вечер концерт устраивает — мол, где так долго шляешься."
                                            }
                                        ]
                                    }
