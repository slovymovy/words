                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd51512f-1a37-3a93-a0da-a76a9be04991",
                                        "entry_id": "0f37fb5e-ab72-3a3d-9240-05e17652e4f5",
                                        "glosses": [
                                            "Of perishable items, overridden with bacteria and other infectious agents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b506a073-daf3-4ce6-9b50-356efc6ff745",
                                                "sense_id": "bd51512f-1a37-3a93-a0da-a76a9be04991",
                                                "text": "If you leave a bin unattended for a few weeks, the rubbish inside will turn rotten."
                                            },
                                            {
                                                "example_id": "532dc3d4-f3f2-4b72-b372-de307d72b55b",
                                                "sense_id": "bd51512f-1a37-3a93-a0da-a76a9be04991",
                                                "text": "Antonio: Mark you this, Bassanio, / The devil can cite Scripture for his purpose. / An evil soul producing holy witness / Is like a villain with a smiling cheek, / A goodly apple rotten at the heart. / O, what a goodly outside falsehood hath!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dd887f3-2fac-3103-8931-2fa97aae175d",
                                        "entry_id": "0f37fb5e-ab72-3a3d-9240-05e17652e4f5",
                                        "glosses": [
                                            "In a state of decay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b9a5fe-e983-470a-87d7-0f4927f75b44",
                                                "sense_id": "4dd887f3-2fac-3103-8931-2fa97aae175d",
                                                "text": "The floors were damaged and the walls were rotten."
                                            },
                                            {
                                                "example_id": "5abed001-9e15-4443-ae84-39dff751aec6",
                                                "sense_id": "4dd887f3-2fac-3103-8931-2fa97aae175d",
                                                "text": "His mouth stank and his teeth were rotten."
                                            },
                                            {
                                                "example_id": "ac0d6aa7-89d6-48ae-8e68-0d1d2de70af0",
                                                "sense_id": "4dd887f3-2fac-3103-8931-2fa97aae175d",
                                                "text": "But poore old man, thou prun'ſt a rotten tree, / That cannot ſo much as a bloſſome yeelde"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dac8063-d2c2-3fd6-8d78-44ce31d82f21",
                                        "entry_id": "0f37fb5e-ab72-3a3d-9240-05e17652e4f5",
                                        "glosses": [
                                            "Cruel, mean or immoral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c785b6-73c5-46a0-9cdd-0900b6392e34",
                                                "sense_id": "3dac8063-d2c2-3fd6-8d78-44ce31d82f21",
                                                "text": "That man is a rotten father."
                                            },
                                            {
                                                "example_id": "0be685c6-15d8-4288-b5ae-24e7320cf223",
                                                "sense_id": "3dac8063-d2c2-3fd6-8d78-44ce31d82f21",
                                                "text": "This rotten policy will create more injustice in this country."
                                            },
                                            {
                                                "example_id": "3feb861e-1f68-42be-b77d-d6e62d95eb57",
                                                "sense_id": "3dac8063-d2c2-3fd6-8d78-44ce31d82f21",
                                                "text": "Something is rotten in the State of Denmarke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d43d6df7-8dce-39a2-bf1b-78b9bb6782c4",
                                        "entry_id": "0f37fb5e-ab72-3a3d-9240-05e17652e4f5",
                                        "glosses": [
                                            "Bad or terrible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b794f5-d13e-4247-a714-97b3d91d2dfa",
                                                "sense_id": "d43d6df7-8dce-39a2-bf1b-78b9bb6782c4",
                                                "text": "Why is the weather always rotten in this city?"
                                            },
                                            {
                                                "example_id": "9192903b-e70d-4ee5-ada5-16e6b0738175",
                                                "sense_id": "d43d6df7-8dce-39a2-bf1b-78b9bb6782c4",
                                                "text": "It was a rotten idea to take the boat out today."
                                            },
                                            {
                                                "example_id": "5901b2c1-18cf-4c3b-a910-024513d0e206",
                                                "sense_id": "d43d6df7-8dce-39a2-bf1b-78b9bb6782c4",
                                                "text": "She has the flu and feels rotten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3841f6bc-9535-3996-8f63-48c04c5c0fa2",
                                        "entry_id": "0f37fb5e-ab72-3a3d-9240-05e17652e4f5",
                                        "glosses": [
                                            "Of stone or rock, crumbling or friable; in a loose or disintegrated state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa300ae-9909-4d66-ac29-e9c6b5a7e8cc",
                                                "sense_id": "3841f6bc-9535-3996-8f63-48c04c5c0fa2",
                                                "text": "The quartz specimens were sometimes blue, hard-looking stone, or rotten quartz largely impregnated with iron, in both cases carrying bright glittering nodules of gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "578eb694-d9d0-33e1-90b3-42550bff9307",
                                        "entry_id": "0f37fb5e-ab72-3a3d-9240-05e17652e4f5",
                                        "glosses": [
                                            "Very drunk, intoxicated."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rotten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fb81ed1-0b9d-396f-98eb-e44bbbebff8f",
                                        "entry_id": "93db7939-e739-3d7d-9663-1c0a768f3757",
                                        "glosses": [
