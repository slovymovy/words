            "senses": [
                {
                    "sense_id": "bc40dab5-a2f9-3eb9-ab48-d9d1cbc50b4d",
                    "sense_definition": "An instance of becoming less, worse, or lower; a decline.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian documented the various <w>declinings</w> of the ancient empire.",
                            "target_lang_translations": {
                                "ru": "Историк задокументировал различные <w>периоды упадка</w> древней империи.",
                                "pl": "Historyk udokumentował różne <w>okresy upadku</w> starożytnego imperium."
                            }
                        },
                        {
                            "text": "He observed the subtle <w>declinings</w> in moral standards over the century.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал едва заметные <w>ухудшения</w> моральных норм на протяжении столетия.",
                                "pl": "Obserwował subtelne <w>spadki</w> standardów moralnych na przestrzeni stulecia."
                            }
                        }
                    ],
                    "synonyms": [
                        "deterioration",
                        "worsening"
                    ],
                    "antonyms": [
                        "improvement",
                        "growth"
                    ],
