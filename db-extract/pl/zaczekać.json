        "ru-extract.jsonl": [
            {
                "entry_id": "8cb6a018-7beb-31f6-b7ac-a190d0603550",
                "word": "zaczekać",
                "pos": "verb",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b4d52427-967d-33b8-b741-c584da20407c",
                        "entry_id": "8cb6a018-7beb-31f6-b7ac-a190d0603550",
                        "glosses": [
                            "постоять (цитата из польской Викитеки Lalka (Prus)/Tom I/I)\\nЗвук примера:"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61affb22-99ae-4b64-a2e9-be40d3388a32",
                                "sense_id": "b4d52427-967d-33b8-b741-c584da20407c",
                                "text": "— Nazywam go — odparł, powoli ogryzając i zapalając cygaro — nazywam go waryatem, gdyż go znam lat... Zaczekaj pan... Piętnaście... siedemnaście... ośmnaście...",
                                "translation": "- Я называю его... - отвечал он, неторопливо обкусывая сигару и закуривая, - я называю его безумцем, потому что знаю его... постойте-ка... пятнадцать... семнадцать... восемнадцать лет..."
                            }
                        ]
                    },
                    {
                        "sense_id": "10c0e2dc-70a6-3bb2-918a-59f41fa498b5",
                        "entry_id": "8cb6a018-7beb-31f6-b7ac-a190d0603550",
                        "glosses": [
                            "не торопиться (цитата из польской Викитеки Lalka (Prus)/Tom I/I)\\nЗвук примера:"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d802e0-f9d8-470c-99d3-54d5558b16c9",
                                "sense_id": "10c0e2dc-70a6-3bb2-918a-59f41fa498b5",
                                "text": "— Zaczekaj pan — przerwał radca.",
                                "translation": "- Не торопитесь, - остановил его советник."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
