                        "sense_id": "b01911e1-4062-3013-8e7d-372516e50510",
                        "entry_id": "1ec01b2a-0ef2-379c-9bd3-1b833a0911e3",
                        "glosses": [
                            "οι φιγούρες, τα βήματα, τα κόλπα με την μπάλα, η κίνηση των ποδιών, ο τρόπος με τον οποίο κάποιος κινεί τα πόδια του όταν αθλείται ή χορεύει"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a01d682-a1a0-4f40-8408-89beb99d6562",
                                "sense_id": "b01911e1-4062-3013-8e7d-372516e50510",
                                "text": "They added a lot of fancy footwork to the dance.",
                                "translation": "Πρόσθεσαν πολλές περίτεχνες φιγούρες στον χορό."
                            },
                            {
                                "example_id": "ccc10720-cffb-420a-97e8-08fc67968c56",
                                "sense_id": "b01911e1-4062-3013-8e7d-372516e50510",
                                "text": "Both dancers showed impressive footwork.",
                                "translation": "Και οι δύο χορευτές έδειξαν εντυπωσιακά βήματα."
                            },
                            {
                                "example_id": "e94325e8-9b11-4149-b862-507e6c96fe59",
                                "sense_id": "b01911e1-4062-3013-8e7d-372516e50510",
                                "text": "The player showed elaborate footwork.",
                                "translation": "Ο παίκτης έδειξε περίτεχνα κόλπα με την μπάλα."
                            },
                            {
                                "example_id": "c7c666a7-3a95-4151-abc2-4b2d8f2b66a5",
                                "sense_id": "b01911e1-4062-3013-8e7d-372516e50510",
                                "text": "The boxer displayed impressive footwork in the ring.",
                                "translation": "Ο πυγμάχος έδειξε εντυπωσιακή κίνηση ποδιών στο ρινγκ."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbd494ff-b142-3be8-93cc-99277702ff7c",
                        "entry_id": "1ec01b2a-0ef2-379c-9bd3-1b833a0911e3",
                        "glosses": [
                            "οι χειρισμοί, οι ελιγμοί, η ικανότητα να αντιδρά κανείς γρήγορα και με επιδεξιότητα σε μια δύσκολη κατάσταση"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1e6c9d5-a107-4e32-bd7f-d03e8191165a",
                                "sense_id": "fbd494ff-b142-3be8-93cc-99277702ff7c",
                                "text": "It was going to take some deft political footwork to save the situation.",
                                "translation": "Θα χρειαζόταν επιδέξιοι πολιτικοί χειρισμοί για να σωθεί η κατάσταση."
                            },
                            {
                                "example_id": "17357eb8-6129-4492-a82b-1c619a8bc5af",
                                "sense_id": "fbd494ff-b142-3be8-93cc-99277702ff7c",
                                "text": "Through careful diplomatic footwork, the minister avoided a conflict.",
                                "translation": "Με προσεκτικούς διπλωματικούς ελιγμούς, ο υπουργός απέφυγε τη σύγκρουση."
                            }
                        ]
                    }
