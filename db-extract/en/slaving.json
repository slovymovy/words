                        "entry_id": "60d968d6-60ee-31f5-84d7-d4a5c0615e06",
                        "glosses": [
                            "The transport of slaves, especially by sea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6833080-e998-4fba-ba73-fa29b4658c90",
                                "sense_id": "c66cdbd4-954b-32d2-8a85-617b4f674e4e",
                                "text": "These two ships would then chase, stop, and search ships, and if the ships were found with slaves aboard or equipped for slaving, the ships were seized, any slaves freed, and fines imposed."
                            }
                        ]
                    }
