                                "target_senses": [
                                    {
                                        "sense_id": "0a08d0fc-169e-3697-95fb-c0c23225ca48",
                                        "entry_id": "47d64fd6-144e-3e32-ae3a-0ac0732588d7",
                                        "glosses": [
                                            "The first trip of a vessel in its intended duty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49dbf17-a418-4791-b453-ede8e858b077",
                                                "sense_id": "0a08d0fc-169e-3697-95fb-c0c23225ca48",
                                                "text": "The Titanic hit an iceberg and sank on her maiden voyage."
                                            },
                                            {
                                                "example_id": "de716469-4604-4b00-8a1c-4dd81b4926be",
                                                "sense_id": "0a08d0fc-169e-3697-95fb-c0c23225ca48",
                                                "text": "For one thing, it was a maiden voyage, which always meant both passengers and staff were a little giddier, a little looser, than usual."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
