                "senses": [
                    {
                        "sense_id": "39955064-824e-3445-b597-7009415431a3",
                        "entry_id": "633adad2-db1a-385f-929e-9d003a8d9645",
                        "glosses": [
                            "niet te verdragen, niet uit te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9406a8-76af-4bb6-b24e-6d7048424078",
                                "sense_id": "39955064-824e-3445-b597-7009415431a3",
                                "text": "Kinderen die ondraaglijk en uitzichtloos lijden, moeten zelf kunnen vragen om euthanasie"
                            },
                            {
                                "example_id": "26d1f8c0-2687-4977-a8e4-af646f9cfbe1",
                                "sense_id": "39955064-824e-3445-b597-7009415431a3",
                                "text": "Zoals hij zichzelf herinnerde uit die tijd, iets wat hij niet graag deed, moest hij ondraaglijk zelfverzekerd zijn geweest, verbaal sterk, gewend om alle discussies te winnen, kortom onuitstaanbaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f20ec37-a4e0-43c0-950d-23fa95e7604a",
                        "source_entry_id": "633adad2-db1a-385f-929e-9d003a8d9645",
                        "source_sense_id": "39955064-824e-3445-b597-7009415431a3",
                        "target_lang_word": "unbearable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbearable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e423ac40-d56d-3c83-8ef0-b8d43b49a7b5",
                                        "entry_id": "117cad76-907c-39b7-92ec-8f5167b7ec4f",
                                        "glosses": [
                                            "So unpleasant or painful as to be unendurable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da18bbbf-5579-4994-a02d-50cef14535f5",
                                                "sense_id": "e423ac40-d56d-3c83-8ef0-b8d43b49a7b5",
                                                "text": "The heat of the fire, the steam which arose from the dampening water, the hard slogging at the white-hot metal of the links, and the continual pulling of lengths of chain, were calculated to put a test on the strongest of men, and often on hot summer days they had to be sent home, for the work became unbearable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
