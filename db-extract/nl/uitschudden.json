        "nl-extract.jsonl": [
            {
                "entry_id": "bd3071c9-ff80-31ec-9b7c-31578dcc729d",
                "word": "uitschudden",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1594c0eb-c205-3d59-a54e-4e969d36f63c",
                        "entry_id": "bd3071c9-ff80-31ec-9b7c-31578dcc729d",
                        "glosses": [
                            "zich van iets ontdoen door te schudden"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "19acbc6c-18f1-4a9f-8b24-5a971e9bc0e8",
                                "sense_id": "1594c0eb-c205-3d59-a54e-4e969d36f63c",
                                "text": "Een hoop geblaf, waterpret voor hond en baas en kletsnatte viervoeters, die zich uitschudden aan de rand van het zwembad. De hondenplons in zwembad 't Vinkennest was zondagmiddag een groot succes."
                            }
                        ]
                    },
                    {
                        "sense_id": "77bc41fd-f8aa-35c5-87a0-7b1990bcac5e",
                        "entry_id": "bd3071c9-ff80-31ec-9b7c-31578dcc729d",
                        "glosses": [
                            "iets legen door te schudden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbe14cbe-1a94-4b2f-a581-2862f9815219",
                                "sense_id": "77bc41fd-f8aa-35c5-87a0-7b1990bcac5e",
                                "text": "Schud je handdoek voorzichtig voor je uit en houd rekening met de windrichting, zodat anderen geen last hebben van het zand op jouw handdoek."
                            },
                            {
                                "example_id": "d4c3adf3-0c84-402c-b6e8-b0f51483b3ee",
                                "sense_id": "77bc41fd-f8aa-35c5-87a0-7b1990bcac5e",
                                "text": "De beestjes zijn in winterslaap en blijven meestal angstvallig tussen de takken. Wie er toch de kriebels van krijgt kan de boom het beste vooraf een paar dagen in de schuur zetten en de boel flink uitschudden."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9d67570-e766-322d-8b36-79934b41d219",
                        "entry_id": "bd3071c9-ff80-31ec-9b7c-31578dcc729d",
                        "glosses": [
                            "plunderen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "62e95bf6-f38c-49b5-a940-45f2585d79d0",
                                "sense_id": "d9d67570-e766-322d-8b36-79934b41d219",
                                "text": "Het besluit van het zorginstituut om geen keurmerk voor oogmetingen in te voeren is geweldige opsteker voor de mensen in ons land die afhankelijk zijn van een bril en daarvoor sinds jaar en dag naar de traditionele opticiens moesten om zich een nieuwe bril te laten aanmeten en zich hierna vervolgens financieel te laten uitschudden"
                            }
                        ]
                    }
