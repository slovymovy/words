                ],
                "senses": [
                    {
                        "sense_id": "c94b7f46-dc53-39f5-8e89-aebf1213e40f",
                        "entry_id": "1deb2efa-121c-3630-a709-c81f46d6e843",
                        "glosses": [
                            "kleinerer Sprengkörper (Granate), der bei seiner Explosion Tränengas freisetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e650f5-3b4f-40cf-b47b-81622d815ab5",
                                "sense_id": "c94b7f46-dc53-39f5-8e89-aebf1213e40f",
                                "text": "„Mit dem Daumen zog ich den Splint aus der Tränengasgranate.“"
                            },
                            {
                                "example_id": "3074b45d-03bf-47cf-b990-a893229e1164",
                                "sense_id": "c94b7f46-dc53-39f5-8e89-aebf1213e40f",
                                "text": "„Die dann von einem anderen Mann des Kommandos in die Gaststube hineingeworfene Tränengasgranate zwang den Wirt ebenfalls zur Flucht.“"
                            },
                            {
                                "example_id": "5857a572-caae-40a5-8f74-9f5717406db8",
                                "sense_id": "c94b7f46-dc53-39f5-8e89-aebf1213e40f",
                                "text": "„Der Ordnerdienst bildet zwar eine Pufferzone zwischen gewalttätigen Gruppen und den Polizeieinheiten, gerät aber selbst in die Schußlinie von Steinwürfen und Tränengasgranaten.“"
                            },
                            {
                                "example_id": "f332c16a-0176-4001-96ea-23240516a551",
                                "sense_id": "c94b7f46-dc53-39f5-8e89-aebf1213e40f",
                                "text": "„Ein Palästinenser ist bei einer Demonstration im Westjordanland von einer Tränengasgranate im Gesicht getroffen worden und seinen Verletzungen erlegen.“"
                            },
                            {
                                "example_id": "1a53e688-95fc-4d8e-a896-35996960a20c",
                                "sense_id": "c94b7f46-dc53-39f5-8e89-aebf1213e40f",
                                "text": "„Ein Oppositionspolitiker zündete laut Medienberichten vor der Abstimmung im Parlament eine Tränengasgranate.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
