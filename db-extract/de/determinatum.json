                "senses": [
                    {
                        "sense_id": "a8bc1411-bc1a-3cad-84cc-35d0fe3d0e7f",
                        "entry_id": "fb086671-1b61-3f2d-839e-5c1fea54597b",
                        "glosses": [
                            "zweiter Teil eines Determinativkompositums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "628b49c4-dc26-4376-8562-2ee8136d476b",
                                "sense_id": "a8bc1411-bc1a-3cad-84cc-35d0fe3d0e7f",
                                "text": "„Dampfschiff“ ist ein ‚Determinativkompositum‘, bei dem das ‚Determinans‘ „Dampf“ das ‚Determinatum‘ „Schiff“ näher bestimmt und z.B. von „Segelschiff“, „Schulschiff“ usw. unterscheidet."
                            },
                            {
                                "example_id": "64b33318-a61e-456d-9c3b-a854fb782fe6",
                                "sense_id": "a8bc1411-bc1a-3cad-84cc-35d0fe3d0e7f",
                                "text": "„Das native Determinatum wird als festes Element zur Reihenbildung mit fremden Erstelementen verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "470a7a3f-e88c-3815-a2d5-113191d2d6ce",
                        "entry_id": "fb086671-1b61-3f2d-839e-5c1fea54597b",
                        "glosses": [
                            "Kopf einer syntaktischen Konstruktion"
                        ],
                        "tags": [
                            "Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "c37f213a-1e7c-4910-8d0b-c2cabce66138",
                                "sense_id": "470a7a3f-e88c-3815-a2d5-113191d2d6ce",
                                "text": "In „der große Junge“ ist „Junge“ der Kopf der Konstruktion und damit das Determinatum."
                            }
