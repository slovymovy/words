        "fr-extract.jsonl": [
            {
                "entry_id": "1145c5d7-7f97-32f3-9924-c3b0e5ea8884",
                "word": "barbiche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7a367b2f-a36c-489b-a571-8c1cf2036f75",
                        "entry_id": "1145c5d7-7f97-32f3-9924-c3b0e5ea8884",
                        "tags": [
                            "plural"
                        ],
                        "form": "barbiches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f71c2810-d160-3e95-b224-c22d0235267c",
                        "entry_id": "1145c5d7-7f97-32f3-9924-c3b0e5ea8884",
                        "glosses": [
                            "Petite touffe de poils que l’on laisse pousser au menton."
                        ],
                        "tags": [
                            "Barbe"
                        ],
                        "examples": [
                            {
                                "example_id": "643db14d-f8ed-4d4a-a393-b960c48a835b",
                                "sense_id": "f71c2810-d160-3e95-b224-c22d0235267c",
                                "text": "Ce commandant, un homme fort, haut, avec des moustaches et une barbiche grises, […], nous reçut avec bonhomie et amabilité."
                            },
                            {
                                "example_id": "2dd9d7b7-20fc-44a5-bbfb-b82ba0b52d22",
                                "sense_id": "f71c2810-d160-3e95-b224-c22d0235267c",
                                "text": "Devant moi, un type tout différent et qui n’a rien d’oriental : trente-deux à trente-cinq ans, figure à barbiche roussâtre, regard très vif, […]."
                            },
                            {
                                "example_id": "209418fb-892c-447d-b7ae-0d3bf4483249",
                                "sense_id": "f71c2810-d160-3e95-b224-c22d0235267c",
                                "text": "Physiquement malade, d’aspect débile, la figure ravagée et longue, qui se termine par une petite barbiche poivre et sel."
                            },
                            {
                                "example_id": "25c67188-e59f-45a2-a7a9-3ec31f8686a6",
                                "sense_id": "f71c2810-d160-3e95-b224-c22d0235267c",
                                "text": "Ils nous accompagnent jusqu’aux arbres centenaires qui bordent la clairière, et un petit gars avec une barbiche blonde, de ces barbiches jeunes ,comme aimaient en porter les soldats pendant cette guerre, me demande brusquement : « Qui est-ce donc, ce Guy Mocquet ? »"
                            },
                            {
                                "example_id": "a73600c0-5d18-4595-8cc5-ce39813c9520",
                                "sense_id": "f71c2810-d160-3e95-b224-c22d0235267c",
                                "text": "Le Dr Marengo portait un manteau à col de castorette. Sa barbiche, soyeuse et unie, semblait un morceau de la même bête dont le pelage ornait son vêtement."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1bc2bfa-5044-3954-b490-c70391e5755a",
                        "entry_id": "1145c5d7-7f97-32f3-9924-c3b0e5ea8884",
                        "glosses": [
                            "Un des noms vernaculaires de la nigelle de Damas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d128d3eb-0883-4ad1-b9b8-a858592ada64",
                                "sense_id": "b1bc2bfa-5044-3954-b490-c70391e5755a",
                                "text": "La nigelle des champs, vulgairement barbiche, barbe de capucin ou tout-épice, est commune dans les blés de nos contrées méridionales. Ses semences aromatiques sont employées comme épices."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5181ed56-2bde-4b1d-ac3e-3a24a4b1179c",
                        "source_entry_id": "1145c5d7-7f97-32f3-9924-c3b0e5ea8884",
                        "target_lang_word": "goatee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goatee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d70c983-e00f-30b4-a82e-2846d4c48f43",
                                        "entry_id": "9314755d-ebe7-389e-8632-969da9879782",
                                        "glosses": [
                                            "A beard trimmed to grow only at the center of the chin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f2ed6a-2f10-4000-94ed-892738607bb7",
                                                "sense_id": "0d70c983-e00f-30b4-a82e-2846d4c48f43",
                                                "text": "One person sports a goatee, the hair refusing to grow on the sides of his physiognomy; the chin of another is as smooth as a baby's cheek,—he contents himself with a modest moustache and a faint attempt at an imperial; while a few of the upper classes rejoice in all the varieties."
                                            },
                                            {
                                                "example_id": "0b355618-bad3-4a21-8764-539e5e9b1ce2",
                                                "sense_id": "0d70c983-e00f-30b4-a82e-2846d4c48f43",
                                                "text": "The terrorist, as he called himself, was old and bald, with a narrow, snow-white wisp of a goatee hanging limply from his chin."
                                            },
                                            {
                                                "example_id": "3fc0bbb0-9e71-45c1-8c15-49038ba41d42",
                                                "sense_id": "0d70c983-e00f-30b4-a82e-2846d4c48f43",
                                                "text": "\"Yes, sir, behind you. He is a man of middle size, rather inclined to shortness. He is old, over sixty, with white hair, curved nose and a white, small beard of the variety that is called goatee.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
