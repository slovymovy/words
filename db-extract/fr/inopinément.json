        "fr-extract.jsonl": [
            {
                "entry_id": "b9c09590-76c2-3285-9fa6-d18343a7e0ed",
                "word": "inopinément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5bc4763d-c8cc-3ce5-9c51-27ae9366b097",
                        "entry_id": "b9c09590-76c2-3285-9fa6-d18343a7e0ed",
                        "glosses": [
                            "D’une manière inopinée, imprévue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9527a1f4-b5e2-4f9b-b2a4-232777de527f",
                                "sense_id": "5bc4763d-c8cc-3ce5-9c51-27ae9366b097",
                                "text": "Ô ciel ! de quel poison Sens-je inopinément attaquer ma raison ?"
                            },
                            {
                                "example_id": "d9717a2a-b41a-4beb-9730-2e61e7d6945c",
                                "sense_id": "5bc4763d-c8cc-3ce5-9c51-27ae9366b097",
                                "text": "Quelque charge que l’on vous donne, jamais vous ne cesserez de prétendre ; ce que vous croyez la fin de votre course, quand vous y serez arrivés, vous ouvrira inopinément une nouvelle carrière."
                            },
                            {
                                "example_id": "972d2b13-a7b6-45bc-85a1-7c788a896281",
                                "sense_id": "5bc4763d-c8cc-3ce5-9c51-27ae9366b097",
                                "text": "Ils finissent enfin, et rencontrent inopinément un avenir qu’ils n'ont ni craint, ni espéré."
                            },
                            {
                                "example_id": "2d3fa587-1f32-4b5c-8825-6d13366b3041",
                                "sense_id": "5bc4763d-c8cc-3ce5-9c51-27ae9366b097",
                                "text": "Pour ne pas tomber inopinément dans le gouffre."
                            },
                            {
                                "example_id": "01f6993f-d6e5-44cd-893d-864e9e6620ae",
                                "sense_id": "5bc4763d-c8cc-3ce5-9c51-27ae9366b097",
                                "text": "M. de Bernage arrivait au moment où l’entretien allait cesser, car la marquise ne paraissait pas disposée à le prolonger, depuis que M. de Scaër était entré en scène inopinément."
                            },
                            {
                                "example_id": "ee6bab44-be93-40ab-b11d-2ca4e42a8b48",
                                "sense_id": "5bc4763d-c8cc-3ce5-9c51-27ae9366b097",
                                "text": "On eût dit une bande de captifs rendus inopinément à la liberté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9df2ce72-8f52-4109-b832-41f8da236f0a",
                        "source_entry_id": "b9c09590-76c2-3285-9fa6-d18343a7e0ed",
                        "source_sense_id": "5bc4763d-c8cc-3ce5-9c51-27ae9366b097",
                        "target_lang_word": "unexpectedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unexpectedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                        "entry_id": "72175067-63da-3c54-a05e-1de7d45e321c",
                                        "glosses": [
                                            "In an unexpected manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d095c36-5026-4cd2-83af-63c47a289fd5",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Near-synonyms: against expectations, against all odds, surprisingly"
                                            },
                                            {
                                                "example_id": "8cf6fecf-97a8-4b26-8697-bff936162838",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "[…] she was startled by unexpectedly meeting her husband, who was coming to seek her."
                                            },
                                            {
                                                "example_id": "38b175cb-f4be-4ff2-8de1-b1e407b3dc97",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Other evidence of former ownerships such as notice-boards, number plates, and makers' plates, are often discovered unexpectedly."
                                            },
                                            {
                                                "example_id": "4ac4a871-d192-4892-ad79-18cc1f480fce",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Texas House Democrats’ historic quorum break unexpectedly ended Thursday evening when at least three new Democrats returned to the floor, paving the way for state Republicans to pass restrictive voting legislation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
