                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party focused its campaign efforts on the most <w>marginal</w> seats.",
                            "target_lang_translations": {
                                "ru": "Партия сосредоточила свои предвыборные усилия на самых <w>спорных</w> местах в парламенте.",
                                "zh": "该党把竞选重点放在那些最<w>摇摆的</w>席位上。"
                            }
                        },
                        {
                            "text": "Winning a <w>marginal</w> seat requires a very high voter turnout.",
                            "target_lang_translations": {
                                "ru": "Победа в <w>колеблющемся</w> округе требует очень высокой явки избирателей.",
                                "zh": "要赢下一个<w>摇摆</w>选区，需要非常高的投票率。"
                            }
