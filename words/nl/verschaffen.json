{
    "word_family": [
        "verschaffing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a04d775-f8ba-3892-a3de-7800396b486f",
                    "sense_definition": "ervoor zorgen dat iemand iets krijgt of kan gebruiken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "leveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bibliotheek kan u alle nodige informatie <w>verschaffen</w> over dit historische onderwerp.",
                            "target_lang_translations": {
                                "en": "The library can <w>provide</w> you with all the necessary information about this historical subject."
                            }
                        },
                        {
                            "text": "De nieuwe wet moet meer duidelijkheid <w>verschaffen</w> over de rechten van werknemers.",
                            "target_lang_translations": {
                                "en": "The new law should <w>provide</w> more clarity regarding workers' rights."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezorgen",
                        "leveren",
                        "geven"
                    ],
                    "common_phrases": [
                        "duidelijkheid verschaffen",
                        "informatie verschaffen",
                        "toegang verschaffen"
                    ],
                    "target_lang_definitions": {
                        "en": "To ensure that someone receives or can use something, such as information or supplies."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "provide",
                                "target_lang_sense_clarification": "to supply or make available"
                            },
                            {
                                "target_lang_word": "furnish",
                                "target_lang_sense_clarification": "to provide information or evidence"
                            },
                            {
                                "target_lang_word": "supply",
                                "target_lang_sense_clarification": "to give something that is needed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "453fb2cc-282e-333b-bc29-d922525ccbc5",
                    "sense_definition": "zichzelf iets eigen maken of ergens binnenkomen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verkrijgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dieven probeerden zich toegang te <w>verschaffen</w> tot het zwaar beveiligde gebouw.",
                            "target_lang_translations": {
                                "en": "The thieves tried to <w>gain</w> access to the heavily secured building."
                            }
                        },
                        {
                            "text": "Hij wist zich een goede positie te <w>verschaffen</w> binnen het internationale bedrijf.",
                            "target_lang_translations": {
                                "en": "He managed to <w>secure</w> a good position for himself within the international company."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich toegang verschaffen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak wederkerend gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To obtain something for oneself or to gain entry into a place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gain",
                                "target_lang_sense_clarification": "to obtain access or a position"
                            },
                            {
                                "target_lang_word": "secure",
                                "target_lang_sense_clarification": "to manage to get something for oneself"
                            },
                            {
                                "target_lang_word": "obtain",
                                "target_lang_sense_clarification": "to acquire or get"
                            }
                        ]
                    }
                }
            ]
        }
