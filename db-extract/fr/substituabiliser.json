                "senses": [
                    {
                        "sense_id": "336cc20b-c8bb-340c-9371-5a5c31da7b9d",
                        "entry_id": "f3ee0e13-6930-389b-9834-1b8e3e32c052",
                        "glosses": [
                            "Donner un caractère substituable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e40729d9-83f2-41f2-9584-4a1dbf64b1cf",
                                "sense_id": "336cc20b-c8bb-340c-9371-5a5c31da7b9d",
                                "text": "Un stylisticien serait à même d’étudier comment le texte A’, substituabilisé, autorise les procédés de la substitution, par la répétition lexicale (s’orgueilli/s’orgueillist, tost failli/tost trespasse) ou le parallélisme (Pour sa biauté, qui tost failli/Dont sa biautez est tost perie)…"
                            },
                            {
                                "example_id": "bfc442ed-5c43-45c6-aea7-b1644914faa7",
                                "sense_id": "336cc20b-c8bb-340c-9371-5a5c31da7b9d",
                                "text": "Comme nous l’avons démontré dans les sections précédentes, l’énergie qui est à la base de toute disponibilité risque de nous faire défaut dans un temps très court ce qui limitera notre capacité à substituabiliser de façon notable."
                            }
                        ]
                    }
