                        "glosses": [
                            "Faire perdre leur caractère crépelé (aux cheveux)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51b72c3-096b-49d0-9d48-6d3610aa12ac",
                                "sense_id": "9e0274c9-d853-349b-9e0f-5720bcb47ed0",
                                "text": "Pour avoir trop tiré sur les leurs — songez à la beauté des nattes — il est arrivé que des Japonais les ont perdus. Alopecia japonica. Et même des Noires d’Amérique que désolaient leurs cheveux crépus et qui s’acharnaient à les décrépeler."
                            },
                            {
                                "example_id": "d1eb42dd-b493-49df-99f6-9349aa22debb",
                                "sense_id": "9e0274c9-d853-349b-9e0f-5720bcb47ed0",
                                "text": "Les cheveux ne sont pas encore décrépelés à l’américaine, ni fendus de larges raies à la Joséphine Baker."
                            }
                        ]
                    }
