                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78c49b70-ac05-46a1-9111-588557c31904",
                        "source_entry_id": "9ddbc3ca-c336-38b4-9dbc-584ac7be36d6",
                        "source_sense_id": "191c42cb-e3cb-3adc-9575-6054599e274d",
                        "target_lang_word": "répercussion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répercussion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1769e49-6722-358a-b6a8-63c84d4ace0e",
                                        "entry_id": "f26d2db7-42b4-37b8-a82e-2438f3fe0723",
                                        "glosses": [
                                            "Renvoi, réflexion (en parlant des sons, de la lumière, de la chaleur)."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1402caa-6926-4c06-8cb2-08077c01d084",
                                                "sense_id": "c1769e49-6722-358a-b6a8-63c84d4ace0e",
                                                "text": "La répercussion des rayons du soleil."
                                            },
                                            {
                                                "example_id": "2e6f9533-6b6c-42fe-8123-d7de374db10b",
                                                "sense_id": "c1769e49-6722-358a-b6a8-63c84d4ace0e",
                                                "text": "À la répercussion des coups, il était facile de juger que l’on attaquait l’avant-dernière porte, celle qui donnait accès à la salle des bibelots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abc59479-71fa-3a38-b742-a81394751f08",
                                        "entry_id": "f26d2db7-42b4-37b8-a82e-2438f3fe0723",
                                        "glosses": [
                                            "Conséquence ; choc en retour."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7224cdf-c1ba-4240-aa16-30ccd34be669",
                                                "sense_id": "abc59479-71fa-3a38-b742-a81394751f08",
                                                "text": "L’impact de la TGAP diffère entre les deux secteurs concernés, en termes d’anticipation de la mesure, d’acceptabilité de la part des industriels et de répercussion sur les prix. L'impact environnemental reste encore difficile à évaluer trois ans après la mise en application de la taxe."
                                            },
                                            {
                                                "example_id": "4f71c6b6-a854-4753-90e5-f465f3149bb8",
                                                "sense_id": "abc59479-71fa-3a38-b742-a81394751f08",
                                                "text": "Et d'ailleurs, qui peut prévoir les lointaines répercussions d'une expérience désintéressée?"
                                            },
                                            {
                                                "example_id": "9a766989-8f63-48ef-9ba0-d0b698773f8c",
                                                "sense_id": "abc59479-71fa-3a38-b742-a81394751f08",
                                                "text": "Sans parler des divers traumatismes psychologiques ou moraux, innombrables à l’issue d’une telle période, il faut retenir les répercussions sur l’état physiologique et sanitaire des individus."
                                            },
                                            {
                                                "example_id": "9bbc3530-d4c0-4f25-ae7d-77b2f3922fb5",
                                                "sense_id": "abc59479-71fa-3a38-b742-a81394751f08",
                                                "text": "L'attentat qui s'est produit le 18 septembre 1931 à Moukden, une ville de Mandchourie, est l'un de ces événements oubliés qui ont pourtant changé le monde. En pratique, il fut insignifiant. Mais ses prolongements ont eu des répercussions jusqu'à Hiroshima et Nagasaki les 6 et 9 août 1945."
                                            },
                                            {
                                                "example_id": "dd9ba7d3-98e8-4bce-8f5e-ab95ea36e9fe",
                                                "sense_id": "abc59479-71fa-3a38-b742-a81394751f08",
                                                "text": "Tout comme les attentats du 11 septembre 2001, l’éclatement de ce qui pourrait bien être la plus grande guerre terrestre en Europe depuis la Seconde Guerre mondiale est un tel choc que certaines de ses répercussions sont impossibles à prédire ; certaines de ses conséquences vont surgir sans prévenir pendant des années."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
