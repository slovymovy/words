                    }
                ],
                "translations": [
                    {
                        "translation_id": "55ab2058-7fac-4e0e-87a6-c19585b0a752",
                        "source_entry_id": "42a51a5b-653a-3fad-9854-3d140c26a34e",
                        "source_sense_id": "eff30aa2-3768-35be-9e11-76f83d85d74c",
                        "source_sense_description": "Abkürzung für Red Army Faction/Red Army Fraction",
                        "target_lang_word": "RAF",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "RAF",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb6dd5fb-db70-3fd7-815e-4a47fd0724b7",
                                        "entry_id": "0faec2e7-b274-3183-924f-cae68f81be17",
                                        "glosses": [
                                            "Rote Armee Fraktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "926de643-e8a4-4005-b086-2f03feb8a964",
                                                "sense_id": "fb6dd5fb-db70-3fd7-815e-4a47fd0724b7",
                                                "text": "Die RAF war eine Terroristenorganisation."
                                            },
                                            {
                                                "example_id": "f3b01891-c29e-4014-a023-4e8fc06154bc",
                                                "sense_id": "fb6dd5fb-db70-3fd7-815e-4a47fd0724b7",
                                                "text": "„Die RAF löste sich vor 18 Jahren auf - jetzt wird bekannt: Bei einem Raubüberfall auf einen Geldtransporter 2015 waren offenbar frühere Mitglieder der Terrorgruppe beteiligt. […] Nach einem Raubüberfall auf einen Geldtransporter bei Bremen im vergangenen Sommer haben Ermittler in zwei Autos DNA-Spuren von Mitgliedern der früheren Roten Armee Fraktion (RAF) gefunden. […] Die linksextreme Terrororganisation RAF hatte sich 1998 für aufgelöst erklärt. Einige ihrer damaligen Mitglieder sind aber bis heute verschwunden und stehen weiter auf der Fahndungsliste des Bundeskriminalamts. Mehr als zwei Jahrzehnte lang war die RAF in Deutschland der Inbegriff von Gewalt, mehr als 30 Menschen starben durch ihren Terror.“"
                                            },
                                            {
                                                "example_id": "442da6fe-2939-4528-b1fe-8a7d503a8505",
                                                "sense_id": "fb6dd5fb-db70-3fd7-815e-4a47fd0724b7",
                                                "text": "„Und wie seinerzeit beim Verfahren gegen die RAF wurde auch diesmal ein eigenes Gericht gebaut.“"
                                            },
                                            {
                                                "example_id": "e945ff93-a7a3-4683-ab41-3886f6dce294",
                                                "sense_id": "fb6dd5fb-db70-3fd7-815e-4a47fd0724b7",
                                                "text": "„Von Marx über die RAF bis hin zur Partei der Linken waren es hier immer wieder Gutbürgerliche, die sich für die Arbeiterklasse einsetzten – aber keine Ahnung hatten, was das eigentlich für Typen sind und was sie wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d284c423-8f81-360b-90c8-4cae51a98ab0",
                                        "entry_id": "0faec2e7-b274-3183-924f-cae68f81be17",
                                        "glosses": [
                                            "Reichsarbeitsführer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39ea93a-3444-4d2a-a1af-e6e93b11a35f",
                                                "sense_id": "d284c423-8f81-360b-90c8-4cae51a98ab0",
                                                "text": "Hierl war der RAF."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "24400779-daf9-3890-bac6-95cdd5fb4975",
                                        "entry_id": "0faec2e7-b274-3183-924f-cae68f81be17",
                                        "glosses": [
                                            "Royal Air Force (Luftwaffe von Großbritannien)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21651fb2-abc3-4fb3-9b22-3b016852000b",
                                                "sense_id": "24400779-daf9-3890-bac6-95cdd5fb4975",
                                                "text": "Die RAF fliegt wieder Trainingsmissionen über New Hampshire."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
