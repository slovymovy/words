                        "examples": [
                            {
                                "example_id": "542b9652-490f-4e6d-bcda-c5b87e6f9f63",
                                "sense_id": "7aee52c2-93ff-3adc-82bd-44a3c9ce4687",
                                "text": "„Dabei handelt es sich im wesentlichen um Altöle mit geringem Wasser- und Schadstoffgehalt, die prinzipiell aufarbeitbar wären.“"
                            },
