                "senses": [
                    {
                        "sense_id": "078fb498-40ed-392a-838c-bebe7ad2ddc1",
                        "entry_id": "808ba372-9b67-3d6f-87ec-a2ffb8ef9534",
                        "glosses": [
                            "Redonner un caractère d’objet à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e8de32-7108-4213-b14f-9d3b65ec5a8c",
                                "sense_id": "078fb498-40ed-392a-838c-bebe7ad2ddc1",
                                "text": "S’il ne retrouve pas à se réinvestir, à se réobjectaliser et à se conflictualiser, l’Idéal du Moi se retourne contre le Moi dans un mouvement de dénigrement dévastateur conduisant au vide."
                            },
                            {
                                "example_id": "afe734a8-4ea7-447d-b1a4-338235cd2ea1",
                                "sense_id": "078fb498-40ed-392a-838c-bebe7ad2ddc1",
                                "text": "Dans cet intervalle narcissique de soi à soi où une partie des objets internes est pris comme objet externe et avec lequel le sujet se réobjectalise, ne pourrions-nous pas, dans ce cas précis, parler de « désir narcissique » ?"
                            }
                        ]
                    }
