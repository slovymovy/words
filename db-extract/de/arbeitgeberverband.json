                        "entry_id": "d0878e18-a039-36f0-a99d-5a7e8189a6d6",
                        "glosses": [
                            "institutioneller Zusammenschluss der Arbeitgeber zur Vertretung ihrer Interessen gegenüber Gewerkschaften und Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1a4dda6-0aad-44c9-82cd-4cc72994721f",
                                "sense_id": "32ce87de-d43c-379c-a95f-ca784ea369ec",
                                "text": "Der Arbeitgeberverband hat einen neuen Vorsitzenden gewählt."
                            },
                            {
                                "example_id": "7b3e4136-5037-45c5-9587-48a3a16f75bb",
                                "sense_id": "32ce87de-d43c-379c-a95f-ca784ea369ec",
                                "text": "„Der Arbeitgeberverband führt gemeinsame Tarifverhandlungen für alle Bundesländer außer Hessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
