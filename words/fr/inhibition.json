            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e93b1fd-99c5-322c-a547-e20c6aa12a70",
                    "sense_definition": "Blocage psychologique conscient ou inconscient qui empêche ou freine l'expression spontanée d'un comportement, d'une pensée ou d'une émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa timidité excessive crée une véritable <w>inhibition</w> lorsqu'il doit s'exprimer devant un large public."
                        },
                        {
                            "text": "La pratique régulière du théâtre l'a beaucoup aidé à lever ses <w>inhibitions</w> d'enfance."
                        }
                    ],
                    "synonyms": [
                        "blocage",
                        "gêne",
                        "retenue"
                    ],
                    "antonyms": [
                        "désinhibition",
                        "spontanéité"
                    ],
                    "common_phrases": [
                        "lever les inhibitions",
                        "perte d'inhibition"
                    ]
                },
                {
                    "sense_id": "e2e99e4a-c5fe-3192-8d11-62bdeb2ad9d7",
                    "sense_definition": "Action de ralentir, de bloquer ou d'arrêter un processus biologique, biochimique ou physiologique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau médicament agit directement par l'<w>inhibition</w> d'une enzyme clé responsable de l'inflammation."
                        },
                        {
                            "text": "Les chercheurs étudient l'<w>inhibition</w> de la prolifération des cellules tumorales en laboratoire."
                        }
                    ],
                    "synonyms": [
                        "blocage",
                        "freinage",
                        "neutralisation"
                    ],
                    "antonyms": [
                        "activation",
                        "stimulation"
                    ],
                    "common_phrases": [
                        "inhibition enzymatique"
                    ]
                },
                {
                    "sense_id": "72fb6eee-7c36-37c8-8480-554fe2dbb883",
                    "sense_definition": "Défense légale ou prohibition formelle ordonnée par une autorité judiciaire.",
                    "learner_level": "C2",
