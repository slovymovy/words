                                "ru": "Он дал <w>честный</w> ответ на трудный вопрос.",
                                "pl": "Udzielił <w>szczerej</w> odpowiedzi na trudne pytanie.",
                                "de": "Er gab eine <w>ehrliche</w> Antwort auf die schwierige Frage.",
                                "fr": "Il a donné une réponse <w>honnête</w> à la question difficile.",
                                "it": "Ha dato una risposta <w>onesta</w> alla domanda difficile.",
                                "cs": "Dal <w>upřímnou</w> odpověď na tu těžkou otázku.",
                                "tr": "Zor soruya <w>dürüst</w> bir cevap verdi.",
                                "es": "Él dio una respuesta <w>sincera</w> a la pregunta difícil.",
                                "zh": "他针对那个难题给出了<w>诚实</w>的回答。"
                            }
                        }
