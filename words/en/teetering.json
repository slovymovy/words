            "senses": [
                {
                    "sense_id": "a0ac939a-f7aa-36ee-b9df-9e11c25bc1f9",
                    "sense_definition": "present participle and gerund of <w>teeter</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child was <w>teetering</w> on the edge of the high wall.",
                            "target_lang_translations": {
                                "cs": "Dítě <w>balancovalo</w> na okraji vysoké zdi."
                            }
                        },
                        {
                            "text": "The company is <w>teetering</w> on the brink of bankruptcy.",
                            "target_lang_translations": {
                                "cs": "Společnost <w>kolísá</w> na pokraji bankrotu."
                            }
                        }
                    ],
                    "synonyms": [
                        "wobbling",
                        "swaying",
                        "tottering"
                    ],
                    "antonyms": [
                        "stabilizing"
                    ],
                    "common_phrases": [
                        "teetering on the edge",
                        "teetering on the brink"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybovat se nejistě ze strany na stranu, balancovat na hraně pádu nebo selhání."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "balancovat",
                                "target_lang_sense_clarification": "udržovat rovnováhu v nejisté pozici"
                            },
                            {
                                "target_lang_word": "potácet se",
                                "target_lang_sense_clarification": "pohybovat se nejistě, hrozit pádem"
                            },
                            {
                                "target_lang_word": "kolísat",
                                "target_lang_sense_clarification": "být v nejistém stavu, např. na hraně krachu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4fa53b36-67ee-3575-bf38-7496cd92b73c",
                    "sense_definition": "A precarious motion or situation, risking a fall or collapse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>teeterings</w> of the stock market caused panic among investors.",
                            "target_lang_translations": {
                                "cs": "<w>Kolísání</w> akciového trhu vyvolalo mezi investory paniku."
                            }
                        },
                        {
                            "text": "After many <w>teeterings</w>, the old fence finally fell down.",
                            "target_lang_translations": {
                                "cs": "Po mnoha <w>potáceních</w> starý plot konečně spadl."
                            }
                        }
                    ],
                    "synonyms": [
                        "instability",
                        "wobble",
                        "totter"
                    ],
                    "antonyms": [
                        "stability"
                    ],
                    "common_phrases": [
                        "market teeterings"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nejistý pohyb nebo stav, který hrozí pádem či zhroucením."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kolísání",
                                "target_lang_sense_clarification": "nestabilní pohyb nebo výkyvy"
                            },
                            {
                                "target_lang_word": "potácení",
                                "target_lang_sense_clarification": "nejistý, vratký pohyb"
                            }
                        ]
                    }
                }
            ]
        }
    ]
