                    {
                        "sense_id": "6f2d53c3-3a60-3ae3-b79a-ab9f556f248a",
                        "entry_id": "ce68ceb1-2701-3f72-8d4d-32a87d5499be",
                        "glosses": [
                            "een onaangenaam gevoel hebbend omdat een verwachting of hoop niet uitgekomen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56f75f74-70df-4849-96ed-1485b44cfbe3",
                                "sense_id": "6f2d53c3-3a60-3ae3-b79a-ab9f556f248a",
                                "text": "De teleurgestelde kinderen begonnen luid te protesteren."
