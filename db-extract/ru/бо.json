    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [
            {
                "entry_id": "823dc26c-c329-39c3-9e49-768592462cf1",
                "word": "бо",
                "pos": "conj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d12226a-7ed0-3695-92df-7b5b8effabb3",
                        "entry_id": "823dc26c-c329-39c3-9e49-768592462cf1",
                        "glosses": [
                            "старин. : потому что, так как"
                        ],
                        "tags": [
                            "постпозитивный союз, присоединяющий придаточные предложения причины"
                        ],
                        "examples": [
                            {
                                "example_id": "8b28f5ab-834e-49e7-8dec-add3eb3f982d",
                                "sense_id": "9d12226a-7ed0-3695-92df-7b5b8effabb3",
                                "text": "Жена скоро покойницей стала, бо для нас время гладно настало, а дочек-красоток люди приютили, бо родители им продовольствие прекратили, а затем остаюсь, без дальнейших слов, покорный ваш слуга Егор Павлов Абессаломов."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5b7c617-f2e8-306d-b555-29185be93072",
                        "entry_id": "823dc26c-c329-39c3-9e49-768592462cf1",
                        "glosses": [
                            "старин. : же, ведь"
                        ],
                        "tags": [
                            "употребляется как частица, для усиления"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5090d18-aceb-495e-84f0-4cfa35a5b9d9",
                        "source_entry_id": "823dc26c-c329-39c3-9e49-768592462cf1",
                        "source_sense_description": "потому что, так как",
                        "target_lang_word": "bo",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bo",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "7a462078-3e97-3d3a-a5cd-b21f24d10a52",
                                        "entry_id": "7decc8a0-114f-3ba0-b649-231fa8f7068a",
                                        "glosses": [
                                            "…przyłączający zdania lub ich części wyjaśniające lub rozwijające w jakiś sposób wcześniejszą informację; wyrażające jej przyczynę, wyjaśnienie, uzasadnienie itp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb6d97e7-338b-4754-a1b1-1f2548fcac11",
                                                "sense_id": "7a462078-3e97-3d3a-a5cd-b21f24d10a52",
                                                "text": "Nie przyszedłem wczoraj, bo miałem ważne spotkanie."
                                            },
                                            {
                                                "example_id": "e39f8279-f762-42eb-97a8-17084c667d56",
                                                "sense_id": "7a462078-3e97-3d3a-a5cd-b21f24d10a52",
                                                "text": "Strasznie się spociłem, bo padła mi klimatyzacja."
                                            },
                                            {
                                                "example_id": "4cb11d0d-02b0-4bdb-ae3a-ff42faad7c21",
                                                "sense_id": "7a462078-3e97-3d3a-a5cd-b21f24d10a52",
                                                "text": "Krzysztof W., bo o nim mowa, był znanym w okolicy przestępcą."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "c45f66ab-9fff-3a44-bd56-7fea564606ba",
                                        "entry_id": "7decc8a0-114f-3ba0-b649-231fa8f7068a",
                                        "glosses": [
                                            "…przyłączający zdania lub ich części wyrażające przewidywany, możliwy skutek tego, o czym była mowa; ostrzegający przed konsekwencjami niewykonania czegoś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d426c4a9-cbfd-4701-b635-9aeb53eb5871",
                                                "sense_id": "c45f66ab-9fff-3a44-bd56-7fea564606ba",
                                                "text": "Nie baw się zapałkami, bo się poparzysz."
                                            },
                                            {
                                                "example_id": "b012ea4a-47b4-4836-9a4d-382359aabd07",
                                                "sense_id": "c45f66ab-9fff-3a44-bd56-7fea564606ba",
                                                "text": "Policja antyterrorystyczna! Otwórz drzwi, bo je wyważymy!"
                                            },
                                            {
                                                "example_id": "933641ff-6e69-43a4-a95b-cdb1d4a3b2c8",
                                                "sense_id": "c45f66ab-9fff-3a44-bd56-7fea564606ba",
                                                "text": "Wykonuj polecenia, bo użyję środków przymusu bezpośredniego!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "bo",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e660a62b-3bb6-367d-bfda-7aa7fb131118",
                                        "entry_id": "54e88955-7169-32ab-9077-9e90cdb5887e",
                                        "glosses": [
                                            "…wprowadzająca pytanie retoryczne, przecząca komunikowanej w nim treści"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b99e9b1b-57f8-4f32-9c40-6c2ecbb31d48",
                                                "sense_id": "e660a62b-3bb6-367d-bfda-7aa7fb131118",
                                                "text": "Bo skąd ja niby mam to wiedzieć?!"
                                            },
                                            {
                                                "example_id": "56dfaf38-5c23-4dc4-bcc6-a8bd81a86eb0",
                                                "sense_id": "e660a62b-3bb6-367d-bfda-7aa7fb131118",
                                                "text": "Bo to prawda!?"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    },
                                    {
                                        "sense_id": "da601213-44ad-39da-857e-6dbd9988641d",
                                        "entry_id": "54e88955-7169-32ab-9077-9e90cdb5887e",
                                        "glosses": [
                                            "…umieszczana między dwoma powtórzeniami tego samego wyrazu, mającymi charakter wzmacniający, czasem przeciwstawny, zwłaszcza w połączeniu ze spójnikami ale, a"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a46c6c84-1e70-44b4-b49f-9845e44c75f7",
                                                "sense_id": "da601213-44ad-39da-857e-6dbd9988641d",
                                                "text": "Ładna, bo ładna, ale głupia"
                                            }
                                        ],
                                        "sense_index_json": "\"2.2\""
                                    },
                                    {
                                        "sense_id": "1b3418af-ef73-3743-9b1f-dd89ba9a4bb2",
                                        "entry_id": "54e88955-7169-32ab-9077-9e90cdb5887e",
                                        "glosses": [
                                            "…wzmacniająca wypowiedź, najczęściej w zwrotach przeciwstawnych; uwydatniająca kontrast, przeciwstawienie, zaskoczenie itp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53eeb521-2e80-4503-9fa9-603a3f934238",
                                                "sense_id": "1b3418af-ef73-3743-9b1f-dd89ba9a4bb2",
                                                "text": "Ja bo w ogień skoczę, w wodę, / Za uścisk Lwowianki"
                                            }
                                        ],
                                        "sense_index_json": "\"2.3\""
                                    }
                                ]
                            }
                        ]
                    },
