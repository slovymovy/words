                    {
                        "sense_id": "f8ee83dc-a6f7-37cc-bc14-a057c1b4f40c",
                        "entry_id": "8a98c58d-5019-3b89-bd79-b4c981dae57a",
                        "glosses": [
                            "die beiden größten Neuweltgeier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f34ae05-7727-4cca-9dd0-ea06451f9a55",
                                "sense_id": "f8ee83dc-a6f7-37cc-bc14-a057c1b4f40c",
                                "text": "Da fliegt ein Kondor."
                            },
                            {
                                "example_id": "6fde10f3-81e1-4fb5-9a87-859135ef2e5d",
                                "sense_id": "f8ee83dc-a6f7-37cc-bc14-a057c1b4f40c",
                                "text": "„Es soll direkt den Kondor, aber auch sein Ökosystem schützen und vor allen Dingen die Bevölkerung aufklären und ökonomisch unterstützen.“"
                            },
                            {
                                "example_id": "2151af91-9cc6-4324-ab97-3bd85d48c709",
                                "sense_id": "f8ee83dc-a6f7-37cc-bc14-a057c1b4f40c",
                                "text": "„Zahlreiche Tierdarstellungen von Kolibris, Kondoren, aber auch menschliche Figuren fanden Berücksichtigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
