    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f105d49f-d7af-351c-8f71-3b9eb0056ce8",
                    "sense_definition": "A thin tube used for sucking a liquid from a container into the mouth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "drinking_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She drank her iced tea through a plastic <w>straw</w>.",
                            "target_lang_translations": {
                                "ru": "Она пила свой холодный чай через пластиковую <w>трубочку</w>.",
                                "tr": "Buzlu çayını plastik bir <w>pipet</w> ile içti.",
                                "zh": "她用塑料<w>吸管</w>喝冰茶。"
                            }
                        },
                        {
                            "text": "The waiter forgot to bring a <w>straw</w> with my soda.",
                            "target_lang_translations": {
                                "ru": "Официант забыл принести <w>трубочку</w> к моей газировке.",
                                "tr": "Garson gazozumla birlikte <w>pipet</w> getirmeyi unuttu.",
                                "zh": "服务员忘了给我的汽水配一根<w>吸管</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drinking straw",
                        "plastic straw",
                        "paper straw",
                        "sucking through a straw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая трубка, используемая для всасывания жидкости из емкости в рот.",
                        "tr": "İçeceği bir kaptan ağza çekmek için kullanılan ince tüp.",
                        "zh": "一种用于将液体从容器吸入口中的细管。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трубочка",
                                "target_lang_sense_clarification": "для питья"
                            },
                            {
                                "target_lang_word": "соломинка",
                                "target_lang_sense_clarification": "для коктейлей"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "pipet",
                                "target_lang_sense_clarification": "içecek içmek için kullanılan araç"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吸管",
                                "target_lang_sense_clarification": "用于喝饮料的管子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2b0665c-59a3-3f94-9597-b572b70d1263",
                    "sense_definition": "Dried stalks of grain plants considered collectively, used for bedding, packing, or fodder.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plant_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horses slept comfortably on a bed of fresh <w>straw</w>.",
                            "target_lang_translations": {
                                "ru": "Лошади удобно спали на подстилке из свежей <w>соломы</w>.",
                                "tr": "Atlar taze <w>saman</w> yatağında rahatça uyudular.",
                                "zh": "马儿们舒适地睡在新鲜的<w>稻草</w>垫上。"
                            }
                        },
                        {
                            "text": "Farmers often store large bales of <w>straw</w> in the barn for winter.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто хранят большие тюки <w>соломы</w> в амбаре на зиму.",
                                "tr": "Çiftçiler kış için ahırda genellikle büyük <w>saman</w> balyaları saklarlar.",
                                "zh": "农民们常在谷仓里储存大捆<w>稻草</w>以备过冬。"
                            }
                        }
                    ],
                    "synonyms": [
                        "litter"
                    ],
                    "common_phrases": [
                        "bale of straw",
                        "bed of straw",
                        "straw bedding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сухие стебли зерновых растений, используемые для подстилки, упаковки или корма.",
                        "tr": "Yataklık, paketleme veya yem olarak kullanılan, kurutulmuş tahıl bitkisi sapları.",
                        "zh": "谷物植物的干燥茎秆，通常用于铺垫、包装或饲料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солома",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "tr": [
