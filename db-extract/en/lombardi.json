                    {
                        "sense_id": "46c2b771-558c-3d92-8037-5558d87766ea",
                        "entry_id": "45f0a6fc-cebb-327a-a92a-6d90d54c32f8",
                        "glosses": [
                            "A surname from Italian",
                            "used specifically of Vince Lombardi (1913–1970), best known as the head coach of the National Football League's Green Bay Packers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d74548f5-4292-4100-895f-f7889f955fe4",
                                "sense_id": "46c2b771-558c-3d92-8037-5558d87766ea",
                                "text": "Lombardi. ¶ Walsh. ¶ Shanahan. ¶ Steve from West Valley? ¶ The world is about to find out whether regular fans can take their place alongside the greatest offensive minds in the annals of professional football."
                            },
                            {
                                "example_id": "52c6719f-f2bb-40cb-9c82-eec380ad63b2",
                                "sense_id": "46c2b771-558c-3d92-8037-5558d87766ea",
                                "text": "If coming second is coming nowhere, as all sports-people tend to to^([sic]) be taught (remember the words of Mr Lombardi), then this is most true in those individual sports where careers tend to be brief, and opportunities to win fewest."
                            }
                        ]
                    },
                    {
                        "sense_id": "673482b8-7ee9-32ca-b848-f696792dc1a3",
                        "entry_id": "45f0a6fc-cebb-327a-a92a-6d90d54c32f8",
                        "glosses": [
                            "A trophy awarded each year to the winning team of the National Football League's championship game, named in honor of Vince Lombardi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c75db32-b6d2-4b20-9d0e-78516801b60b",
                                "sense_id": "673482b8-7ee9-32ca-b848-f696792dc1a3",
                                "text": "Looking specifically at the Patriots, […]. They've never had to win three playoff games to play for the Lombardi, showcasing the importance of home-field advantage."
                            },
                            {
                                "example_id": "0d351020-ab20-4606-97d5-5319666701ee",
                                "sense_id": "673482b8-7ee9-32ca-b848-f696792dc1a3",
                                "text": "The Dolphins are the organization of 17-0. Of Don Shula. Of Dan Marino. It's a franchise with two Lombardi trophies and one that made 21 postseason appearances between 1970 and 2001."
                            }
                        ]
                    }
