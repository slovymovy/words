                        "glosses": [
                            "Autrefois en Turquie, gouverneur d’un mutessarifat (arrondissement ou sandjak)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f48a9172-8c06-427d-bde0-7d2f1a645c3f",
                                "sense_id": "0e7bb50a-9a6f-3af4-a003-cd00b8735838",
                                "text": "Cependant, le mutessarif de Mardin, Hilmi bey, s’oppose aux ordres de Rechid et refuse de déporter les Arméniens sans un ordre de Constantinople."
                            },
                            {
                                "example_id": "9c51c9c6-426f-4dba-b723-1b02de82af4c",
