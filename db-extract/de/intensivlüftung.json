                "senses": [
                    {
                        "sense_id": "f8ce389f-e03f-3dcc-b3b5-62149966dd60",
                        "entry_id": "601b0011-3086-31d0-af3b-37466bfc537d",
                        "glosses": [
                            "zeitweilig notwendige erhöhte Lüftung zum Abbau von Lastspitzen bei Anwesenheit des Nutzers; Schaltstufe für Lüftungsanlagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d8a249-d55c-4871-ab7c-c02f38dc0a0a",
                                "sense_id": "f8ce389f-e03f-3dcc-b3b5-62149966dd60",
                                "text": "„Bei der ventilatorgestützten Lüftung kann – falls erforderlich - der Planer das aktive Öffnen der Fenster bei der Intensivlüftung berücksichtigen.“"
                            },
                            {
                                "example_id": "10b0a69a-a3f0-4f43-a824-541b842c8ab1",
                                "sense_id": "f8ce389f-e03f-3dcc-b3b5-62149966dd60",
                                "text": "„Durch die Intensivlüftung sollen Lastspitzen durch Kochen, Waschen etc. abgebaut werden.“"
                            },
                            {
                                "example_id": "3c70664a-1e0e-4077-86a2-13923c73fbb0",
                                "sense_id": "f8ce389f-e03f-3dcc-b3b5-62149966dd60",
                                "text": "„Die Intensivlüftung wird bei einer ventilatorgestützten Lüftungsanlage durch zusätzliches aktives Öffnen der Fenster erreicht.“"
                            },
                            {
                                "example_id": "e65ae2e0-2b54-47d3-aa9a-a8ca4fb066d5",
                                "sense_id": "f8ce389f-e03f-3dcc-b3b5-62149966dd60",
                                "text": "„Ein Lüftungsgerät kann z. B. mit drei aktiven Lüftungsstufen ausgerüstet sein, die Intensivlüftung kann daher unter Einbeziehung der Fensterlüftung sichergestellt werden.“"
                            },
                            {
                                "example_id": "46659107-0167-4ede-a109-d1762d8788c5",
                                "sense_id": "f8ce389f-e03f-3dcc-b3b5-62149966dd60",
                                "text": "„Bei der Intensivlüftung darf von einer Nutzerunterstützung (zeitweiliges manuelles Fensteröffnen) ausgegangen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
