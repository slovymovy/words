                    {
                        "sense_id": "4433794f-e398-3a91-895c-b1c358e775d2",
                        "entry_id": "b8ff6f93-f756-3797-8534-8bd1a6c27a20",
                        "glosses": [
                            "Garni d'un bord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec05e8d2-a050-49e7-b25a-1035f6465f50",
                                "sense_id": "4433794f-e398-3a91-895c-b1c358e775d2",
                                "text": "La construction du bateau fut activement poussée, et il devait être entièrement bordé et ponté avant la fin du mois."
                            }
                        ]
                    }
                ],
