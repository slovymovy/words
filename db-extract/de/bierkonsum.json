                "senses": [
                    {
                        "sense_id": "b81d3de9-d555-3fa2-99f1-d451978839c0",
                        "entry_id": "eaf93d81-0c26-364b-85e9-a821ec634e78",
                        "glosses": [
                            "Konsum von Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "479c533f-e81c-4094-af75-83b042c67d8c",
                                "sense_id": "b81d3de9-d555-3fa2-99f1-d451978839c0",
                                "text": "„Wenn auf Bierflaschenetiketten ausschließlich Angaben in deutscher Sprache, insbesonders die Bezeichnung \"Marcus Bräu\" und vor allem auf die nur im deutschen Sprachraum im Zusammenhang mit dem Bierkonsum übliche Werbung \"Hopfen und Malz - Gott erhalt's\" enthalten sind, kann nicht ausgeschlossen werden, daß zumindest ein nicht ganz unbeträchtlicher Teil der Interessen ein derart etikettiertes Bier für ein aus Österreich oder aus dem deutschen Sprachraum stammendes Bier hält.“"
                            },
                            {
                                "example_id": "826d710e-1a3d-4f72-9420-b52933514523",
                                "sense_id": "b81d3de9-d555-3fa2-99f1-d451978839c0",
                                "text": "„Der Bierkonsum nahm nach der Krankheit merklich ab, doch das Rauchen selbstgedrehter Zigaretten konnte und wollte sich Busch nicht abgewöhnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
