                                        "sense_id": "596dc3fd-cae1-39c6-bfd0-2e143b757df9",
                                        "entry_id": "5581ba59-1131-3997-a0ed-239c4d1bf677",
                                        "glosses": [
                                            "A person or company that acts in the sale, purchase, lease or maintenance of land, property, real estate etc for another."
