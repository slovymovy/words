                        "form": "den Rückweg"
                    },
                    {
                        "form_id": "ed00e523-0674-4a65-a52f-a9dcc9fdaa34",
                        "entry_id": "7d24c5ca-0b7f-30c7-98dc-76473859d7c8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rückwege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76814d6a-7348-310c-a09a-47730f971b35",
                        "entry_id": "7d24c5ca-0b7f-30c7-98dc-76473859d7c8",
                        "glosses": [
                            "der Weg, den man gehen muss, um wieder zu seinem Ausgangspunkt zurückzukommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caaf06cc-a574-4991-94cf-67a17e2166c0",
                                "sense_id": "76814d6a-7348-310c-a09a-47730f971b35",
                                "text": "Kannst du auf dem Rückweg noch Klopapier im Supermarkt holen?"
                            },
                            {
                                "example_id": "e885f60b-45d0-4ffe-ad1e-f4632ad71427",
                                "sense_id": "76814d6a-7348-310c-a09a-47730f971b35",
                                "text": "„In düsterem Schweigen machten wir uns auf den Rückweg zum Boot.“"
                            },
                            {
                                "example_id": "2ea1a729-45e8-4cef-ada4-50b291a0fe54",
                                "sense_id": "76814d6a-7348-310c-a09a-47730f971b35",
                                "text": "„Den Rückweg nahm sie vermutlich durch den Park, vorbei am Tennisplatz, denn dahinter lagen die Pferdeställe und die Wagenremisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5d8484ec-4ff6-3645-a9c2-eeceefc8b156",
                        "entry_id": "7d24c5ca-0b7f-30c7-98dc-76473859d7c8",
                        "glosses": [
                            "die Handlung des Zurückkehrens auf dem in [1] beschriebenen Weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be7e212e-7375-4a80-bcf5-a4db115a13b1",
                                "sense_id": "5d8484ec-4ff6-3645-a9c2-eeceefc8b156",
                                "text": "„Mein Hinweg zu Fuß dauerte sieben Stunden, der Rückweg kaum eine halbe Stunde.“"
                            },
                            {
                                "example_id": "6cf4b593-1d6b-412b-ab65-b73c24952619",
                                "sense_id": "5d8484ec-4ff6-3645-a9c2-eeceefc8b156",
                                "text": "Der Rückweg wird um einiges anstrengender, da wir den Berg hochfahren müssen."
                            },
                            {
                                "example_id": "ef41b68d-7ad8-4543-9237-723f5c20a27f",
                                "sense_id": "5d8484ec-4ff6-3645-a9c2-eeceefc8b156",
                                "text": "„Auf dem Rückweg legte Ramin die Schubert-CD ein, die in seinem Handschuhfach lag und die wir immer hörten, wenn wir durch Teheran fuhren.“"
                            },
                            {
                                "example_id": "bbbbe1c1-9c05-4246-8747-c0e4f951d1c3",
                                "sense_id": "5d8484ec-4ff6-3645-a9c2-eeceefc8b156",
                                "text": "„Etwa zwanzig Mann von der sechsten Kompagnie, die gerade auf dem Rückwege ins Dorf waren, kamen ihnen zu Hilfe, und nun bewegte sich die fünf Klafter lang und einen Klafter breite Flechtwand, in der Mitte sich einsenkend, den keuchenden Soldaten mit hartem Druck in die Schultern schneidend, auf der Dorfstrasse vorwärts.“"
                            },
                            {
                                "example_id": "d9de16c4-5faf-4ef9-8a2f-41d829962ddd",
                                "sense_id": "5d8484ec-4ff6-3645-a9c2-eeceefc8b156",
                                "text": "„Nach einigen Wodkas saß ich wieder neben ihm auf dem Beifahrersitz und ließ auf dem Rückweg nach Kaliningrad die Eichenalleen an mir vorbeiziehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
