                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96e754f1-f8b6-4280-9ea9-d8d998aaf200",
                                                "sense_id": "1575c36b-cd5e-35c6-a94e-186b15ce1229",
                                                "text": "Wenn ich ein Wort nicht weiß, etwa in einem Gespräch in einer fremden Sprache, kann ich das Gemeinte mit eigenen Worten umschreiben, um mich verständlich zu machen; der andere wird mir dann das Wort sagen."
                                            },
                                            {
                                                "example_id": "a8ce089a-17e0-487f-82e2-6e60c919ca66",
                                                "sense_id": "1575c36b-cd5e-35c6-a94e-186b15ce1229",
                                                "text": "Das Wort „Hund“ könnte man so umschreiben: Tier mit einem Schwanz, das bellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb54ee60-d743-35fb-9ce8-3bd308f2b6bf",
                                        "entry_id": "276b9b3b-12f6-362e-a5bd-25c57ab3b019",
                                        "glosses": [
                                            "ein geeignetes Vieleck, insbesondere ein Dreieck, mit einem Kreis (Umkreis) so einschließen, dass alle Eckpunkte auf der Kreislinie liegen"
                                        ],
                                        "tags": [
                                            "geometry",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15aadba9-b6ee-42ef-a86a-3228d45cb4fd",
                                                "sense_id": "bb54ee60-d743-35fb-9ce8-3bd308f2b6bf",
                                                "text": "Das rechtwinklige Dreieck lässt sich durch einen Thaleskreis umschreiben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
