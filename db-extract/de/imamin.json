                "senses": [
                    {
                        "sense_id": "4b12737e-d4fb-3c87-bd4f-9be0fdccc70c",
                        "entry_id": "3801cc4b-1087-3675-a07b-83a2247000a1",
                        "glosses": [
                            "Frau, die eine islamische Gemeinde religiös und seelsorgerisch betreut; die ein Gebet (Freitagsgebet) vorträgt und Teile davon im Wechsel mit anderen spricht; die Koranstunden gibt"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "ca58c4f3-a071-4836-9833-486d93bcc211",
                                "sense_id": "4b12737e-d4fb-3c87-bd4f-9be0fdccc70c",
                                "text": "„Da auch viele Frauen unter sich gemeinsam beten, gibt es dort auch immer eine Imamin. Sobald ein Mann dabei ist, übernimmt er aber die Vorbeter-Rolle.“"
                            },
                            {
                                "example_id": "93f2a97f-de8c-4dd5-abf3-bc9131360815",
                                "sense_id": "4b12737e-d4fb-3c87-bd4f-9be0fdccc70c",
                                "text": "„Rabeya Müller konvertierte als junge Katholikin zum Islam. Heute ist sie eine von vier Imaminnen in Deutschland. Als Vertreterin des liberalen Islam wünscht sie sich mehr Frauen, die eine Gemeinde führen.“ (2017)"
                            },
                            {
                                "example_id": "778cced8-4a09-4ba9-97f2-7fb2c0b8e80a",
                                "sense_id": "4b12737e-d4fb-3c87-bd4f-9be0fdccc70c",
                                "text": "„Islamische Predigerinnen sind selten. In Deutschland gibt es gerade mal 13 Imaminnen. Ihre Aufgabe: Seelsorge und Integration. Dafür werden Frauen in den Moscheen dringend gebraucht.“ (2008)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
