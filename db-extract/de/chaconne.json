                "senses": [
                    {
                        "sense_id": "0ffeb8ea-06d4-359f-a03e-6357124f17cb",
                        "entry_id": "188036f4-0745-38b3-98dd-3a6201c97623",
                        "glosses": [
                            "ein spanischer Reigentanz im 3/4-Takt, der seit 1600 am spanischen Hofe und in den Dramen der spanischen Klassiker getanzt wurde"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da50dac8-1e2c-30d9-bbc6-56ce44dcf569",
                        "entry_id": "188036f4-0745-38b3-98dd-3a6201c97623",
                        "glosses": [
                            "ein Satztyp im 3/4-Takt über einem ständig wiederholten Bassthema, der im 17. und 18. Jahrhundert aus dem unter [1] genannten Tanz entwicklet wurde"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "d0ef19d8-c67f-4459-8dd3-6c88e2e0262a",
                                "sense_id": "da50dac8-1e2c-30d9-bbc6-56ce44dcf569",
                                "text": "„Die berühmteste Chaconne ist die von Johann Sebastian Bach in seiner IV. Sonate für Violoncello.“"
                            },
                            {
                                "example_id": "0f927887-f05f-4ea7-a036-533197595a17",
                                "sense_id": "da50dac8-1e2c-30d9-bbc6-56ce44dcf569",
                                "text": "„Johann Sebastian Bachs Chaconne ist für Geiger das Maß aller Dinge.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74c30b31-3ee8-4be2-b3e3-aa771daee019",
                        "source_entry_id": "188036f4-0745-38b3-98dd-3a6201c97623",
                        "source_sense_id": "0ffeb8ea-06d4-359f-a03e-6357124f17cb",
