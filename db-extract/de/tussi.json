                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0232ca7-633b-4491-a0c0-f90b090b3d4d",
                        "source_entry_id": "83001e65-79b4-3885-b581-c6cbad836918",
                        "source_sense_id": "d50c4794-a2e2-3035-8548-fb5b542c026b",
                        "source_sense_description": "attraktive, modebewusste, ich-bezogene, oberflächliche Frau",
                        "target_lang_word": "bimbo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bimbo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d794a32-bab0-31ab-9a69-0e7c48cb13d8",
                                        "entry_id": "f151e460-e885-3ff9-a8b2-fe4dcc72ba50",
                                        "glosses": [
                                            "A physically attractive person, typically a woman or otherwise feminine in appearance, who lacks intelligence."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec1f6265-44d4-4e92-b93e-699a524a76d7",
                                                "sense_id": "0d794a32-bab0-31ab-9a69-0e7c48cb13d8",
                                                "text": "Anyway, to make a long, dull story even duller, I come from a time when a guy like me used to come into a joint like this and pick up a young chick like you and… call her a ‘bimbo’."
                                            },
                                            {
                                                "example_id": "d02811b0-3c5b-4ed2-bcf9-3f6b50ec2f8e",
                                                "sense_id": "0d794a32-bab0-31ab-9a69-0e7c48cb13d8",
                                                "text": "a. 1992, P. J. O’Rourke, a sketch\nA bimbo is a woman who is not pretty enough to be a model, not smart enough to be an actress, and not nice enough to be a poisonous snake."
                                            },
                                            {
                                                "example_id": "9f0501ba-3223-4afd-b329-de88839860c6",
                                                "sense_id": "0d794a32-bab0-31ab-9a69-0e7c48cb13d8",
                                                "text": "[Tina] Fey […] makes hay with the thought processes of a purebred bimbo: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1b8ce4c-96ab-3551-b1f2-3f59abd62090",
                                        "entry_id": "f151e460-e885-3ff9-a8b2-fe4dcc72ba50",
                                        "glosses": [
                                            "A stupid or foolish person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06d2822c-11c5-42bd-962e-6f2e4283bcda",
                                                "sense_id": "b1b8ce4c-96ab-3551-b1f2-3f59abd62090",
                                                "text": "And one had to remember that most of the bimbos to whom Roberta Wickham had been giving the bird through the years had been of the huntin', shootin' and fishin' type, fellows who had more or less shot their bolt after saying 'Eh, what?' and slapping their leg with a hunting crop."
                                            },
                                            {
                                                "example_id": "3e8033ba-a01b-4409-9a5b-4a9def9cbf28",
                                                "sense_id": "b1b8ce4c-96ab-3551-b1f2-3f59abd62090",
                                                "text": "Isn't he the bimbo who took the bread out of the mouths of the Thursday Review people? Chuck the blighter out of the window and we want to see him bounce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "651dfc1e-6c7e-4e46-905b-a77794ab7d53",
                        "source_entry_id": "83001e65-79b4-3885-b581-c6cbad836918",
                        "source_sense_id": "d50c4794-a2e2-3035-8548-fb5b542c026b",
                        "source_sense_description": "attraktive, modebewusste, ich-bezogene, oberflächliche Frau",
                        "target_lang_word": "gonzesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gonzesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                        "entry_id": "32891077-264f-3609-baf8-ece5beb05b2a",
                                        "glosses": [
                                            "Femme ou jeune femme, nana."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "familiar",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ac9d0c-e4b3-48a4-8afb-c747da288b98",
                                                "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                                "text": "Il m'accompagne jusqu'à la porte de mon hôtel : « Nous avons aussi des cajibis de nuit où dansent de très belles gonzesses. Si vous n'avez pas les foies, allez-y. »"
                                            },
                                            {
                                                "example_id": "7d4c445d-abad-4ac8-9cb2-610af759a97c",
                                                "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                                "text": "— À cause des grosses gonzesses qu’est là, poursuivit l’étonnant garçon, l’nom de « Vacherie » a été donné à la boite."
                                            },
                                            {
                                                "example_id": "1adc7244-6765-4c91-8d24-2a139b36bb13",
                                                "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                                "text": "Partage ou non partage,\nTout est à notre usage :\nN’épargnons le poitou.\nPoissons avec adresse\nMézières et gonzesses,\nSans faire de regout."
                                            },
                                            {
                                                "example_id": "a207601b-b673-479b-94de-3e8c1a4cfa8e",
                                                "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                                "text": "Ça ne court pas les fêtes, des broquilles comme les vôtres, et ça se reconnaît. Si ce n’est pas dégoûtant pour une gonzesse de porter des perles comme ça, il y a de quoi nourrir une famille pendant des années !"
                                            },
                                            {
                                                "example_id": "5dd80a78-c375-4046-9cd8-83618917f3b6",
                                                "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                                "text": "Eh bien, ça se passe sous votre Paris de mes couilles, mon vieux. Votre Paname comme vous dites, qui sent si bon Chanel, avec plein de belles gonzesses qui trottinent, il repose sur du pus et de la crevaison !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9591b222-59e6-32e4-a88f-71237f2b5319",
                                        "entry_id": "32891077-264f-3609-baf8-ece5beb05b2a",
                                        "glosses": [
                                            "Homme efféminé, sans courage, pleutre."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "offensive",
                                            "pejorative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f03255b-809a-401b-9f47-9093b82da6cf",
                                                "sense_id": "9591b222-59e6-32e4-a88f-71237f2b5319",
                                                "text": "Les « gonzesses », personne ne les appelait plus autrement, s’occupaient du ménage dans les piaules, briquaient les chiottes, ciraient les chaussures, raccommodaient les boutons, les épaulettes, préparaient le café à nos retours de saut ou de crapahutage."
                                            },
                                            {
                                                "example_id": "15b18213-573a-463b-9cfc-35d8497885d9",
                                                "sense_id": "9591b222-59e6-32e4-a88f-71237f2b5319",
                                                "text": "T’as peur d'un teckel ? Ma parole, t’es une vraie gonzesse !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c91e3142-d165-448d-8dd3-9de17ac3e381",
                        "source_entry_id": "83001e65-79b4-3885-b581-c6cbad836918",
                        "source_sense_id": "d50c4794-a2e2-3035-8548-fb5b542c026b",
                        "source_sense_description": "attraktive, modebewusste, ich-bezogene, oberflächliche Frau",
                        "target_lang_word": "bimbo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bimbo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "113a942d-d28d-3bda-92d1-1d10da9d1933",
                                        "entry_id": "26f96af6-ca67-3590-abab-acfb83a3115a",
                                        "glosses": [
                                            "Jeune femme superficielle qui prend exagérément soin de son apparence et sait jouer de ses charmes ; ravissante idiote, gourde sexy."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a412804-fa0d-4c9c-8594-e470e3a15738",
                                                "sense_id": "113a942d-d28d-3bda-92d1-1d10da9d1933",
                                                "text": "Dieu merci, ce n’est pas une bimbo sans cervelle."
                                            },
                                            {
                                                "example_id": "90cd7217-7083-4959-a53d-becc874eec09",
                                                "sense_id": "113a942d-d28d-3bda-92d1-1d10da9d1933",
                                                "text": "On pourra noter que de nos jours le stéréotype de la bimbo a des mensurations parfois démesurées."
                                            },
                                            {
                                                "example_id": "26a09a92-d281-4870-b0eb-2d332f24a876",
                                                "sense_id": "113a942d-d28d-3bda-92d1-1d10da9d1933",
                                                "text": "Les bolides brillent de mille feux, parfois accompagnés d’une bimbo au décolleté toujours généreux et affriolant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
