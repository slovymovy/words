                        "examples": [
                            {
                                "example_id": "395efcdd-db27-47f8-8a1e-78fc46d69d3d",
                                "sense_id": "9eb3ab32-4ad5-3caa-b68f-87faf2f03a03",
                                "text": "Однако не тут-то было: пятеро здоровенных мужиков испугались старой собаки, дремавшей на заднем сиденье."
                            }
                        ]
