                "senses": [
                    {
                        "sense_id": "51a3bbb6-f4bc-3df3-a9e8-fc27879d8456",
                        "entry_id": "af81185b-00f7-36bf-aaef-3a6c7dd9aa7a",
                        "glosses": [
                            "To include on a wishlist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f91e0898-f1ad-4a9e-a0e6-36b625538ad0",
                                "sense_id": "51a3bbb6-f4bc-3df3-a9e8-fc27879d8456",
                                "text": "The books table will hold the core information about each book, and the library table will hold each user’s information about that book—namely, whether it’s been read or wishlisted."
                            },
                            {
                                "example_id": "f77202a7-6549-4d39-a35e-e533aad81f77",
                                "sense_id": "51a3bbb6-f4bc-3df3-a9e8-fc27879d8456",
                                "text": "The titles featured saw staggering numbers of people checking out their store pages and wishlisting the games (this is key, as on launch day, an email is sent to remind players to pick up the game)."
                            },
                            {
                                "example_id": "833f82b3-53de-45fe-824c-0e17f892d516",
                                "sense_id": "51a3bbb6-f4bc-3df3-a9e8-fc27879d8456",
                                "text": "These discount promotions are driven by Google’s algorithm and can include: […] • Targeted in-app notifications and emails to customers that have wishlisted or sampled that title."
                            }
                        ]
                    }
                ],
