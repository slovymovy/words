                        "sense_id": "38a494d5-a836-3794-a268-63c2031c5913",
                        "entry_id": "544a7b93-e205-36dc-9c2d-02eda56f1600",
                        "glosses": [
                            "extra, decoration"
                        ],
                        "tags": [
                            "broadly",
                            "derogatory",
