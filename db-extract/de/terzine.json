                "senses": [
                    {
                        "sense_id": "b6434195-62dc-34b4-bbe8-82aa35457cf6",
                        "entry_id": "462424b9-4103-3578-8f41-1ff257524ece",
                        "glosses": [
                            "lyrische Strophenform aus elfsilbigen Dreizeilern, die im Kettenreim miteinander verbunden sind und mit einer einzelnen synkopischen Zeile abschließen"
                        ],
                        "tags": [
                            "Dichtung"
                        ],
                        "examples": [
                            {
                                "example_id": "e69c8d16-631e-4192-8616-fd657230d06b",
                                "sense_id": "b6434195-62dc-34b4-bbe8-82aa35457cf6",
                                "text": "Dante verwendet in seiner Göttlichen Komödie umfänglich Terzinen."
                            },
                            {
                                "example_id": "7ec2fde2-72c7-4b5b-9477-c359b005fd21",
                                "sense_id": "b6434195-62dc-34b4-bbe8-82aa35457cf6",
                                "text": "„Nachdem ich drei oder vier Stunden geschlafen hatte, setzte ich mich hin und schrieb wie Dante in Terzinen die Geschichte der Krankheit nieder, an der ich als Folge des traurigen Sieges zu leiden hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
