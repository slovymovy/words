                        "examples": [
                            {
                                "example_id": "37864097-d159-46f5-bab9-96caa626f76d",
                                "sense_id": "cbac75e1-5ec1-3202-b04c-67c54097f247",
                                "text": "Tous les hommes, une fois qu’ils ont été circoncis, doivent tôt ou tard porter le masque kanaga et savoir effectuer le pas de sa danse, car le masque exprime la vitalité de l’homme."
                            },
                            {
                                "example_id": "8a2e399f-a6ad-441c-ae75-15e2468eca69",
                                "sense_id": "cbac75e1-5ec1-3202-b04c-67c54097f247",
                                "text": "Tu m’écris qu’en face d’un Titien tu oublies tout ce que tu peux rechercher en Afrique. Mais devant les kanaga, pensais-tu beaucoup à l’Europe ?"
                            }
                        ]
                    },
