                    },
                    {
                        "translation_id": "53e698c9-b7c9-4884-80a1-19597e0b1cf3",
                        "source_entry_id": "bf0eb343-8360-329d-8fd2-2101947e9a6d",
                        "source_sense_id": "e3bd6b68-2bea-3969-9aa9-ee4c0e5fed3e",
                        "source_sense_description": "een brutale, bazige onafhankelijke keukenmeid",
                        "target_lang_word": "cook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3d6cfad-36aa-3f41-b51d-caccd301cade",
                                        "entry_id": "f350a42b-7a5a-3b87-9768-ed8c1286f46c",
                                        "glosses": [
                                            "A person who prepares food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b49afaf1-f756-417a-93c9-52cae088d39f",
                                                "sense_id": "d3d6cfad-36aa-3f41-b51d-caccd301cade",
                                                "text": "I'm a terrible cook, so I eat a lot of frozen dinners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d86af9-45ce-36a2-8cc3-6acd529a3878",
                                        "entry_id": "f350a42b-7a5a-3b87-9768-ed8c1286f46c",
                                        "glosses": [
                                            "The head cook of a manor house."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e89d80cf-d42d-3d9a-b1e2-6cad5f024749",
                                        "entry_id": "f350a42b-7a5a-3b87-9768-ed8c1286f46c",
                                        "glosses": [
                                            "The degree or quality of cookedness of food."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53a261da-1602-3ab4-b2ee-44be77eb7522",
                                        "entry_id": "f350a42b-7a5a-3b87-9768-ed8c1286f46c",
                                        "glosses": [
                                            "One who manufactures certain illegal drugs, especially meth."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f2e3693-4662-41f1-9531-05277c5c2700",
                                                "sense_id": "53a261da-1602-3ab4-b2ee-44be77eb7522",
                                                "text": "Police found two meth cooks working in the illicit lab."
                                            },
                                            {
                                                "example_id": "b2dae226-3121-44e6-aed1-831eefddea4b",
                                                "sense_id": "53a261da-1602-3ab4-b2ee-44be77eb7522",
                                                "text": "By late October, the pressure on the Dark Arrows' ecstasy cook had eased. Other suppliers had moved in with product."
                                            },
                                            {
                                                "example_id": "dfb4f65b-a17f-47f8-95b4-15347d4b3449",
                                                "sense_id": "53a261da-1602-3ab4-b2ee-44be77eb7522",
                                                "text": "Owsley Stanley was a pioneer LSD cook, and the Purple Owsley pill from his now-defunct lab was Dad's prized possession, a rare, potent, druggie collector's item, the alleged inspiration for the Hendrix song “Purple Haze.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e672559-f6c4-303f-b2f4-41bd69853477",
                                        "entry_id": "f350a42b-7a5a-3b87-9768-ed8c1286f46c",
                                        "glosses": [
                                            "A session of manufacturing certain illegal drugs, especially meth."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a69507f-128c-4447-b448-7abf4bf0daab",
                                                "sense_id": "5e672559-f6c4-303f-b2f4-41bd69853477",
                                                "text": "Punko told Plante he wanted to use a full barrel for the next cook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf0e2f73-431e-35e8-ab97-82dd3c9b204c",
                                        "entry_id": "f350a42b-7a5a-3b87-9768-ed8c1286f46c",
                                        "glosses": [
                                            "A fish, the European striped wrasse, Labrus mixtus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b502b940-0633-39fe-b818-123f35763ea3",
                                        "entry_id": "f350a42b-7a5a-3b87-9768-ed8c1286f46c",
                                        "glosses": [
                                            "An unintended solution to a chess problem, considered to spoil the problem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fcdb1ba-4e95-45f1-bdd7-b0198f512815",
                                                "sense_id": "b502b940-0633-39fe-b818-123f35763ea3",
                                                "text": "The original endgame was one file to the right (Kf1, Kb5 etc.). But there is a cook after 1. c6 dxc6 2. d6 cxd6 3. h4 gxh3 e.p. 4. gxh3 Ka4! 5. h4 b5. My version eliminates the cook."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f341f7b3-c896-3307-b4e6-c33370223637",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To prepare food for eating by heating it, often combining with other ingredients."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d55df4c2-f0c9-4279-9609-07994deed613",
                                                "sense_id": "f341f7b3-c896-3307-b4e6-c33370223637",
                                                "text": "I'm cooking bangers and mash."
                                            },
                                            {
                                                "example_id": "debf030a-d01b-4a3b-a1d6-6f02459b2c10",
                                                "sense_id": "f341f7b3-c896-3307-b4e6-c33370223637",
                                                "text": "He's in the kitchen, cooking."
                                            },
                                            {
                                                "example_id": "1bfb2bae-94e1-4160-85a2-9e163d0ef623",
                                                "sense_id": "f341f7b3-c896-3307-b4e6-c33370223637",
                                                "text": "You could just use ordinary shop-bought kecap manis to marinade the meat, but making your own is easy, has a far more elegant fragrance and is, above all, such a great brag! Flavouring kecap manis is an intensely personal thing, so try this version now and next time cook the sauce down with crushed, split lemongrass and a shredded lime leaf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3964c74f-33e0-36dd-a831-9d11b5a9aca0",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To smelt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07467e1b-fb8f-40d7-a990-42bf4e8796b9",
                                                "sense_id": "3964c74f-33e0-36dd-a831-9d11b5a9aca0",
                                                "text": "Your suggestion makes sense. You cook iron with coal to get... iron. The coal is expended, where does it go? inside the iron to turn it into steel in real life. I approve"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6016bc9-73f0-3586-a88b-2cf800deac1f",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To be cooked."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9995cc2-4639-4ca6-886c-a4556732e7d4",
                                                "sense_id": "c6016bc9-73f0-3586-a88b-2cf800deac1f",
                                                "text": "The dinner is cooking on the stove."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae8338fc-7d32-30df-acf4-4c3f626550d4",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To be uncomfortably hot."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37bfda3d-20a3-4e96-925f-658ca4179784",
                                                "sense_id": "ae8338fc-7d32-30df-acf4-4c3f626550d4",
                                                "text": "Look at that poor dog shut up in that car on a day like today - it must be cooking in there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ffd9715-45a0-3104-a525-818a13189de5",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To kill, destroy, or otherwise render useless or inoperative through exposure to excessive heat or radiation."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf773bf-253f-4053-9eff-bd1f65a5d257",
                                                "sense_id": "2ffd9715-45a0-3104-a525-818a13189de5",
                                                "text": "You would die from what we might call \"extremely acute radiation poisoning\" – that is, you would be cooked."
                                            },
                                            {
                                                "example_id": "4ce7afd2-b3fa-4a0c-aaed-22689baca785",
                                                "sense_id": "2ffd9715-45a0-3104-a525-818a13189de5",
                                                "text": "\"What's coming?\" \"Dunno yet. Cindy! Active scanning! Pulse hard, but don't cook any friendlies.\" \"We have sensors that can cook people?\" \"Another reason why warship combat is not an indoor sport.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44d713d9-bb41-382b-bd8f-5b0039857cf2",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To execute by electric chair."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3cd1fce-96d4-3998-97da-23660dae691e",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To hold on to a grenade briefly after igniting the fuse, so that it explodes almost immediately after being thrown."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "608e07aa-9d9d-4dda-b66d-417f4bfa0d26",
                                                "sense_id": "c3cd1fce-96d4-3998-97da-23660dae691e",
                                                "text": "I always cook my frags, in case they try to grab one and throw it back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d96a7bb-84e2-31e5-8044-a38a647d0827",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To concoct or prepare."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ef941bc-9ad4-4def-8cba-a3505e379199",
                                                "sense_id": "5d96a7bb-84e2-31e5-8044-a38a647d0827",
                                                "text": "My brother was locked up for cooking meth in his basement."
                                            },
                                            {
                                                "example_id": "204cc843-fa92-4b5a-948f-4ba1c3f67d4e",
                                                "sense_id": "5d96a7bb-84e2-31e5-8044-a38a647d0827",
                                                "text": "The process of cooking meth can leave residue on surfaces all over the home, exposing all of its occupants to the drug."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66f3c2f3-21ef-3d4c-9dc5-e665b766e021",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To tamper with or alter; to cook up."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f186fcf2-e6ce-4c15-a7b8-b3a3051e7089",
                                                "sense_id": "66f3c2f3-21ef-3d4c-9dc5-e665b766e021",
                                                "text": "They all of them receive the same advices from abroad, and very often in the same words; but their way of cooking it is so different, that there is no citizen, who has an eye to the public good, who can leave the coffee-house with peace of mind..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a5be4f0-dc1b-3ea8-82a9-5a415337b9f7",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To play or improvise in an inspired and rhythmically exciting way. (From 1930s jive talk.)"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b006ee72-9fd6-4f5f-9c9e-66fe2645f9e3",
                                                "sense_id": "1a5be4f0-dc1b-3ea8-82a9-5a415337b9f7",
                                                "text": "Watch this band: they cook!"
                                            },
                                            {
                                                "example_id": "d857c416-aeec-4a13-9dfa-bd4ab5b2ab7e",
                                                "sense_id": "1a5be4f0-dc1b-3ea8-82a9-5a415337b9f7",
                                                "text": "Crank up the Coltrane and start cooking!"
                                            },
                                            {
                                                "example_id": "2a0b8419-7bc9-4404-800a-097b62dc4c29",
                                                "sense_id": "1a5be4f0-dc1b-3ea8-82a9-5a415337b9f7",
                                                "text": "This album is called Cookin’ at Miles’ request. He said, “After all, that’s what we did – came in and cooked.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dd0d529-f7ec-35ce-bb28-254c562ba25f",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To play music vigorously."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b66b610-3d85-4595-a39b-641ce3a5ac33",
                                                "sense_id": "6dd0d529-f7ec-35ce-bb28-254c562ba25f",
                                                "text": "On the Wagner piece, the orchestra was cooking!"
                                            },
                                            {
                                                "example_id": "39df1464-4633-4d5b-886d-834d2a896f5f",
                                                "sense_id": "6dd0d529-f7ec-35ce-bb28-254c562ba25f",
                                                "text": "The tempos were swift. The orchestra cooked, reading [conductor] Kahane's mind and swinging with him as one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62b66e08-6d8d-3b49-8682-166c381a87ec",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To proceed with some plan or course of action, or develop some train of thought towards its conclusion (whether this is advantageous, or comical, or digging into a hole)."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4d7d421-2cc9-4e0f-8ee4-5446e87b210b",
                                                "sense_id": "62b66e08-6d8d-3b49-8682-166c381a87ec",
                                                "text": "Hol' up, let that boy cook!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa5f2dc2-29ce-3337-803b-5d865b037989",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To proceed with some plan or course of action, or develop some train of thought towards its conclusion (whether this is advantageous, or comical, or digging into a hole).",
                                            "To proceed with some advantageous course of action; (more generally) to be successful."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ae7a88-8fcf-46af-b126-c74ab89fe277",
                                                "sense_id": "aa5f2dc2-29ce-3337-803b-5d865b037989",
                                                "text": "We had to deal with some problems at first, but now we're cooking."
                                            },
                                            {
                                                "example_id": "adb7c435-1b21-4952-a447-a996d2d6720d",
                                                "sense_id": "aa5f2dc2-29ce-3337-803b-5d865b037989",
                                                "text": "My bar was built by Frazier, Gary Manson, Robert Feck, Jeff Picoli — that's who built my bar. When I hired those people, that's when my bar started cookin'. 'Cause Frazier gets along with anybody — he has a magnetic personality, and he can make the worst piece of shit feel like king for a day."
                                            },
                                            {
                                                "example_id": "4491db83-9a58-48c5-a108-1f8c44617dba",
                                                "sense_id": "aa5f2dc2-29ce-3337-803b-5d865b037989",
                                                "text": "Asensio as AMF might just be the truth man. Bro is cooking and now he has added a goal to top it all off."
                                            },
                                            {
                                                "example_id": "8866abb8-7c89-4257-befe-df0710bb36ac",
                                                "sense_id": "aa5f2dc2-29ce-3337-803b-5d865b037989",
                                                "text": "WAIT YOU'RE ACTUALLY COOKING RN. Emberwake ring. Quick math says that's about 21% more damage than just using tawhoa. Ring also gives fire damage and ignite chance, which is great."
                                            },
                                            {
                                                "example_id": "7ce87630-4d7b-41d4-b86b-3adc6d9f2d2f",
                                                "sense_id": "aa5f2dc2-29ce-3337-803b-5d865b037989",
                                                "text": "With the shot clock winding down, LA's superstars got accustomed to deferring to [Austin] Reaves and letting him cook for either open jumpers or moves that ultimately led to and-one's and free-throw attempts."
                                            },
                                            {
                                                "example_id": "29786c58-6f1f-438c-809f-cfff279a9491",
                                                "sense_id": "aa5f2dc2-29ce-3337-803b-5d865b037989",
                                                "text": "So Llama 4 immediately zooming up to number 2 on LM Arena would seem to indicate that Meta has really cooked here. They have built this incredible model."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb80bb98-ea4f-38db-991d-e1d15000b82e",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To proceed with some plan or course of action, or develop some train of thought towards its conclusion (whether this is advantageous, or comical, or digging into a hole).",
                                            "To develop insane or fringe ideas."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "derogatory",
                                            "humorous",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "432336a6-5725-44a7-b1d6-7cd684a67e9e",
                                                "sense_id": "eb80bb98-ea4f-38db-991d-e1d15000b82e",
                                                "text": "The furlough of workers during The Lockdowns left many with a conspiracy bent ample time to cook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "913a6b6f-fe1a-30ac-be2e-27abe9e08958",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To defeat or humiliate."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b971a1-d095-41da-89ac-e641494f9d58",
                                                "sense_id": "913a6b6f-fe1a-30ac-be2e-27abe9e08958",
                                                "text": "He didn't prepare for the debate at all, so his opponent cooked him hard."
                                            },
                                            {
                                                "example_id": "3c1144b4-1e07-48b9-a702-f3d8a6d7ed01",
                                                "sense_id": "913a6b6f-fe1a-30ac-be2e-27abe9e08958",
                                                "text": "You didn't have to cook him like that!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27907204-bc14-3fbd-9384-660539847a6b",
                                        "entry_id": "87bb8b90-0c3e-3e42-b469-557104fbee1b",
                                        "glosses": [
                                            "To cause to be cooked, i.e. to put in a hopeless situation."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "717ac916-f89c-4e9b-b12b-e0510f03cbad",
                                                "sense_id": "27907204-bc14-3fbd-9384-660539847a6b",
                                                "text": "This new labor law is really cooking working-class people."
                                            }
                                        ]
                                    }
                                ]
                            },
