                        "entry_id": "447147b6-7daf-3f34-9de9-47166c213572",
                        "glosses": [
                            "Kasten oder Kiste, in der Werkzeug (z. B. Hammer, Säge, Schraubenzieher) aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65d8a9cc-b781-42b9-b64b-1212284302d2",
                                "sense_id": "9c446047-32c6-3cdd-bda3-c2a6a8da9cbe",
                                "text": "All my tools fit into the toolbox.",
                                "translation": "Alle meine Werkzeuge passen in den Werkzeugkasten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96c1346c-ddfd-478e-8927-1f58a31a5a8f",
                        "source_entry_id": "447147b6-7daf-3f34-9de9-47166c213572",
                        "source_sense_id": "9c446047-32c6-3cdd-bda3-c2a6a8da9cbe",
