{
    "word_family": [
        "jellyfish",
        "jellybean",
        "jellyroll",
        "jellylike"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "edd4286d-0943-3a56-abea-bf9355c80d3a",
                    "sense_definition": "A sweet dessert made by boiling gelatin (or a plant-based alternative), sugar, and fruit flavouring, which sets into a soft, shaky solid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_dessert",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were excited to eat strawberry <w>jelly</w> and ice cream at the party.",
                            "target_lang_translations": {
                                "ru": "Дети были в восторге от того, что на вечеринке будут клубничное <w>желе</w> и мороженое.",
                                "zh": "孩子们很兴奋能在派对上吃草莓<w>果冻</w>和冰淇淋。"
                            }
                        },
                        {
                            "text": "She prepared a large bowl of lime <w>jelly</w> for dessert.",
                            "target_lang_translations": {
                                "ru": "Она приготовила большую миску лаймового <w>желе</w> на десерт.",
                                "zh": "她准备了一大碗青柠<w>果冻</w>作为甜点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Jell-O"
                    ],
                    "common_phrases": [
                        "jelly and ice cream",
                        "fruit jelly",
                        "lime jelly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сладкий десерт, приготовленный путем кипячения желатина (или растительного аналога), сахара и фруктового ароматизатора, который застывает в мягкую, дрожащую массу.",
                        "zh": "一种由明胶（或植物性替代品）、糖和水果调味剂煮沸后冷却而成的甜点，呈柔软、晃动的固体状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желе",
                                "target_lang_sense_clarification": "десерт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "果冻",
                                "target_lang_sense_clarification": "甜点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2684ddd-80e9-35ac-82e2-2581ba0a7608",
                    "sense_definition": "A clear, sweet fruit preserve made from fruit juice and sugar, often spread on bread or toast.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_spread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually have toast with butter and grape <w>jelly</w> for breakfast.",
                            "target_lang_translations": {
                                "ru": "Я обычно ем на завтрак тост с маслом и виноградным <w>джемом</w>.",
                                "zh": "我早餐通常吃涂了黄油和葡萄<w>果酱</w>的吐司。"
                            }
                        },
                        {
                            "text": "He made a sandwich with peanut butter and <w>jelly</w> for his lunch.",
                            "target_lang_translations": {
                                "ru": "Он сделал себе на обед сэндвич с арахисовой пастой и <w>джемом</w>.",
                                "zh": "他做了个花生酱<w>果酱</w>三明治当午餐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jam",
                        "marmalade",
                        "preserves"
                    ],
                    "common_phrases": [
                        "peanut butter and jelly",
                        "grape jelly",
                        "apple jelly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозрачная сладкая фруктовая заготовка из сока и сахара, которую часто намазывают на хлеб или тосты.",
                        "zh": "一种由果汁和糖制成的透明甜味水果制品，常涂抹在面包或吐司上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джем",
                                "target_lang_sense_clarification": "фруктовая паста"
                            },
                            {
                                "target_lang_word": "желе",
                                "target_lang_sense_clarification": "прозрачное варенье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "果酱",
                                "target_lang_sense_clarification": "涂抹在面包上的水果制品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "227318a1-3b6e-37f2-b914-97a784955c84",
                    "sense_definition": "Any substance or object that is soft, semi-solid, and shakes like gelatin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After running the marathon, his legs felt like <w>jelly</w>.",
                            "target_lang_translations": {
                                "ru": "После марафона его ноги были как <w>желе</w>.",
                                "zh": "跑完马拉松后，他的双腿感觉像<w>果冻</w>一样发软。"
                            }
                        },
                        {
                            "text": "The impact of the fall crushed the fruit into a soft <w>jelly</w>.",
                            "target_lang_translations": {
                                "ru": "От удара при падении фрукт превратился в мягкое <w>месиво</w>.",
                                "zh": "摔落的冲击力把水果压成了柔软的<w>胶状物</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "turn to jelly",
                        "legs like jelly",
                        "beat to a jelly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая субстанция или предмет, который является мягким, полутвердым и дрожит, как желатин.",
                        "zh": "任何柔软、半固体且像明胶一样晃动的物质或物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желе",
                                "target_lang_sense_clarification": "студенистая масса"
                            },
                            {
                                "target_lang_word": "студень",
                                "target_lang_sense_clarification": "масса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胶状物",
                                "target_lang_sense_clarification": "质地描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1386138e-177b-3475-ad79-358fa0cb6a41",
                    "sense_definition": "A sea animal with a soft, clear body and tentacles; a jellyfish.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful when swimming, as there might be a <w>jelly</w> in the water.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, когда плаваешь, в воде может быть <w>медуза</w>.",
                                "zh": "游泳时要小心，水里可能有<w>水母</w>。"
                            }
                        },
                        {
                            "text": "The aquarium display was full of glowing <w>jellies</w> floating in the tank.",
                            "target_lang_translations": {
                                "ru": "В аквариуме было полно светящихся <w>медуз</w>, плавающих в резервуаре.",
                                "zh": "水族馆的展示缸里满是漂浮的发光<w>水母</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jello"
                    ],
                    "common_phrases": [
                        "comb jelly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of jellyfish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Морское животное с мягким прозрачным телом и щупальцами; медуза.",
                        "zh": "一种身体柔软、透明且带有触手的海洋动物；水母。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медуза",
                                "target_lang_sense_clarification": "морское животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水母",
                                "target_lang_sense_clarification": "海洋生物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee464ac4-2c1e-30fe-a4d6-bea969ecc257",
                    "sense_definition": "A shoe made of soft, translucent plastic, often worn by children.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a pair of pink <w>jellies</w> to protect her feet on the rocky beach.",
                            "target_lang_translations": {
                                "ru": "Она надела пару розовых <w>мыльниц</w>, чтобы защитить ноги на каменистом пляже.",
                                "zh": "她在多石的海滩上穿了一双粉色<w>塑料凉鞋</w>来保护双脚。"
                            }
                        },
                        {
                            "text": "In the summer, many kids run around wearing colorful <w>jellies</w>.",
                            "target_lang_translations": {
                                "ru": "Летом многие дети бегают в разноцветных <w>сандалиях</w>.",
                                "zh": "夏天，许多孩子穿着五颜六色的<w>塑料凉鞋</w>跑来跑去。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обувь из мягкого полупрозрачного пластика, которую часто носят дети.",
                        "zh": "一种由柔软、半透明塑料制成的鞋子，常为儿童穿着。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мыльницы",
                                "target_lang_sense_clarification": "обувь (разг.)"
                            },
                            {
                                "target_lang_word": "силиконовые сандалии",
                                "target_lang_sense_clarification": "обувь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塑料凉鞋",
                                "target_lang_sense_clarification": "鞋类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aded63c-6d2b-3b5d-96cf-a54c54fd21ae",
                    "sense_definition": "A savoury gelatinous substance derived from meat stock, used in cooking.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food_savoury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a traditional dish involving meat set in a savoury <w>jelly</w>.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил традиционное блюдо из мяса в несладком <w>желе</w>.",
                                "zh": "厨师准备了一道传统菜肴，将肉包裹在咸味<w>肉冻</w>中。"
                            }
                        },
                        {
                            "text": "Once the stock cools down, it will turn into a firm <w>jelly</w>.",
                            "target_lang_translations": {
                                "ru": "Как только бульон остынет, он превратится в твердый <w>студень</w>.",
                                "zh": "肉汤冷却后，就会变成结实的<w>肉冻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aspic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несладкая желатиновая субстанция, полученная из мясного бульона, используемая в кулинарии.",
                        "zh": "一种源自肉汤的非甜味明胶物质，用于烹饪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "студень",
                                "target_lang_sense_clarification": "мясное блюдо"
                            },
                            {
                                "target_lang_word": "холодец",
                                "target_lang_sense_clarification": "мясное блюдо"
                            },
                            {
                                "target_lang_word": "заливное",
                                "target_lang_sense_clarification": "блюдо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肉冻",
                                "target_lang_sense_clarification": "烹饪用胶状物"
                            },
                            {
                                "target_lang_word": "皮冻",
                                "target_lang_sense_clarification": "中式肉冻"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c14c6aa9-9432-36b8-9ab3-00cc4d4d9016",
                    "sense_definition": "To turn a liquid or substance into a semi-solid, jelly-like form; to congeal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you boil the fruit juice with enough sugar, it will eventually <w>jelly</w>.",
                            "target_lang_translations": {
                                "ru": "Если кипятить фруктовый сок с достаточным количеством сахара, он в конце концов <w>желируется</w>.",
                                "zh": "如果你加入足够的糖煮果汁，它最终会<w>凝固</w>。"
                            }
                        },
                        {
                            "text": "The mixture began to <w>jelly</w> as soon as it was placed in the refrigerator.",
                            "target_lang_translations": {
                                "ru": "Смесь начала <w>застывать</w>, как только её поставили в холодильник.",
                                "zh": "混合物一放进冰箱就开始<w>结冻</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превращать жидкость или вещество в полутвердую желеобразную форму; застывать.",
                        "zh": "使液体或物质变成半固体、胶状的形式；凝固。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желироваться",
                                "target_lang_sense_clarification": "превращаться в желе"
                            },
                            {
                                "target_lang_word": "застывать",
                                "target_lang_sense_clarification": "сгущаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凝固",
                                "target_lang_sense_clarification": "状态改变"
                            },
                            {
                                "target_lang_word": "结冻",
                                "target_lang_sense_clarification": "变成胶状"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2fc5881b-c6f8-3bad-85bf-91d4b5003eb2",
                    "sense_definition": "Feeling or showing envy of someone or their achievements; jealous.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be <w>jelly</w> just because I got the highest score in the game.",
                            "target_lang_translations": {
                                "ru": "Не <w>завидуй</w> только потому, что я набрал больше всех очков в игре.",
                                "zh": "别因为我在游戏里得了最高分就<w>嫉妒</w>。"
                            }
                        },
                        {
                            "text": "She acted like she didn't care, but I think she was secretly <w>jelly</w>.",
                            "target_lang_translations": {
                                "ru": "Она делала вид, что ей всё равно, но я думаю, она втайне <w>завидовала</w>.",
                                "zh": "她装作不在乎，但我认为她暗地里很<w>羡慕</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "so jelly"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий или проявляющий зависть к кому-либо или их достижениям; завистливый.",
                        "zh": "对某人或其成就感到嫉妒；羡慕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завидовать",
                                "target_lang_sense_clarification": "глагол"
                            },
                            {
                                "target_lang_word": "завистливый",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嫉妒",
                                "target_lang_sense_clarification": "心理状态"
                            },
                            {
                                "target_lang_word": "羡慕",
                                "target_lang_sense_clarification": "心理状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}