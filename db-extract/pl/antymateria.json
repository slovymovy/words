                    }
                ],
                "senses": [
                    {
                        "sense_id": "8160a5b2-206d-3e17-bd37-36bdc3e8b057",
                        "entry_id": "9b102c41-151c-359c-9334-2b65ca9abdca",
                        "glosses": [
                            "materia, która składa się z antycząstek, a w kontakcie ze zwykłą materią ulega anihilacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ebec968-4039-4a05-b7bc-0615613a428e",
                                "sense_id": "8160a5b2-206d-3e17-bd37-36bdc3e8b057",
                                "text": "Naukowcom z genewskiego CERN udało się uwięzić antymaterię."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d03265d-f1ee-45fe-88d8-025f202b5946",
                        "source_entry_id": "9b102c41-151c-359c-9334-2b65ca9abdca",
                        "source_sense_id": "8160a5b2-206d-3e17-bd37-36bdc3e8b057",
                        "target_lang_word": "antimatter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "585631c0-b6ba-3260-be6f-0c1d3320fd68",
                                        "entry_id": "d8a401a0-985e-3ac4-9e23-e0aa2af7f37f",
                                        "glosses": [
                                            "Matter that is composed of the antiparticles of those that constitute normal matter."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72cbaf5-3839-4cc6-be38-ea4dbc36fa0b",
                                                "sense_id": "585631c0-b6ba-3260-be6f-0c1d3320fd68",
                                                "text": "But most theories predict that equal amounts of matter and antimatter should have been produced during the big bang, and the mystery of what happened to all the antimatter is a central question in fundamental physics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be0d928a-8a82-3433-9745-7052435cd6bd",
                                        "entry_id": "d8a401a0-985e-3ac4-9e23-e0aa2af7f37f",
                                        "glosses": [
                                            "A form of matter that has a key property, such as charge, opposite to that of ordinary matter."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ed13e5-944e-4eec-9170-8529a592f900",
                                                "sense_id": "be0d928a-8a82-3433-9745-7052435cd6bd",
                                                "text": "Particles of matter and antimatter are identical, except for an opposite electrical charge. An electron has a negative charge whereas its antiparticle, the positron, has a positive charge, and both have an identical mass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69914db6-dcd6-4c73-8ffb-86c684409539",
                        "source_entry_id": "9b102c41-151c-359c-9334-2b65ca9abdca",
                        "source_sense_id": "8160a5b2-206d-3e17-bd37-36bdc3e8b057",
                        "target_lang_word": "antihmota",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "34b1dd7c-059e-4acf-924e-82119c7f8341",
                        "source_entry_id": "9b102c41-151c-359c-9334-2b65ca9abdca",
                        "source_sense_id": "8160a5b2-206d-3e17-bd37-36bdc3e8b057",
                        "target_lang_word": "antimatière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimatière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ef08c88-977e-3f01-aa40-ca14380d5e1f",
                                        "entry_id": "95866055-09db-3677-b984-894fe99d74f5",
                                        "glosses": [
                                            "Équivalent de la matière si on y remplaçait chaque particule par son antiparticule."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01488bae-578f-4551-a120-5f69d267b634",
                                                "sense_id": "1ef08c88-977e-3f01-aa40-ca14380d5e1f",
                                                "text": "De surcroît, le modèle canonique est dans l’incapacité d’expliquer des pans entiers de la réalité physique, comme la masse des neutrinos, la matière noire de l’univers, et l’absence manifeste d’antimatière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "559fc52b-2330-41ba-afaf-3f74923225bc",
                        "source_entry_id": "9b102c41-151c-359c-9334-2b65ca9abdca",
                        "source_sense_id": "8160a5b2-206d-3e17-bd37-36bdc3e8b057",
                        "target_lang_word": "antimateria",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimateria",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "11e0ddfe-46ff-3481-8632-a539e97e0b8c",
                                        "entry_id": "f2eb8f15-b0ad-3fec-a947-d0bb5de06c42",
                                        "glosses": [
                                            "Materia compuesta por antipartículas."
                                        ],
                                        "tags": [
                                            "Física"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3d0b4b0-88bb-4742-97fd-76b891f2a852",
                        "source_entry_id": "9b102c41-151c-359c-9334-2b65ca9abdca",
                        "source_sense_id": "8160a5b2-206d-3e17-bd37-36bdc3e8b057",
                        "target_lang_word": "Antimaterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antimaterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0bd8d168-d42f-34fa-9694-d90b43b0bfc8",
                                        "entry_id": "37115ede-86fd-34b0-912c-bef289b3dd43",
                                        "glosses": [
                                            "aus Antiteilchen gebildete Materie"
                                        ],
                                        "tags": [
                                            "Teilchenphysik",
                                            "Kernphysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15267587-1795-41cd-839b-cf1c6ef63f66",
                                                "sense_id": "0bd8d168-d42f-34fa-9694-d90b43b0bfc8",
                                                "text": "Bringt man Antimaterie mit einer identischen Menge Materie zusammen, verschwinden beide in einer blendenden Explosion."
                                            },
                                            {
                                                "example_id": "6d8e2387-dce9-4407-a07b-af41c82a974a",
                                                "sense_id": "0bd8d168-d42f-34fa-9694-d90b43b0bfc8",
                                                "text": "Eine Büroklammer aus Materie, zusammengebracht mit einer ebensolchen aus Antimaterie, würde ähnlich Energie freisetzen wie die Atombombe, die 1945 über Hiroshima explodierte […]."
                                            },
                                            {
                                                "example_id": "eab2abc9-01c9-4fb4-92f1-c296a779dcfb",
                                                "sense_id": "0bd8d168-d42f-34fa-9694-d90b43b0bfc8",
                                                "text": "In Beschleunigern lässt sich Antimaterie erzeugen, indem sehr große Mengen an Energie in Materie und Antimaterie umgewandelt werden."
                                            },
                                            {
                                                "example_id": "33933328-7b41-42c7-a590-f86f50fc6426",
                                                "sense_id": "0bd8d168-d42f-34fa-9694-d90b43b0bfc8",
                                                "text": "Was vor 20 Jahren kaum vorstellbar war, ist heute schon Realität: Physiker können Antimaterie nicht nur produzieren, sondern inzwischen sogar speichern und manipulieren."
                                            },
                                            {
                                                "example_id": "36efb1c7-27f2-43e8-9f44-cb356f24e46e",
                                                "sense_id": "0bd8d168-d42f-34fa-9694-d90b43b0bfc8",
                                                "text": "Selbst wenn man sämtliche Antimaterie sammeln und vereinen könnte, die im Laufe der letzten 40 Jahre am CERN produziert wurde, wären das allenfalls zehn Milliardstel eines Gramms. Falls diese Antimaterie mit Materie zur Annihilation gebracht werden würde, wäre das nicht gefährlicher, als ein Streichholz anzuzünden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37aebe28-889e-40c1-927e-578834a7c150",
                        "source_entry_id": "9b102c41-151c-359c-9334-2b65ca9abdca",
                        "source_sense_id": "8160a5b2-206d-3e17-bd37-36bdc3e8b057",
                        "target_lang_word": "антивещество́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "антивещество́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a2845139-1bdc-33d3-bc45-062a369adb52",
                                        "entry_id": "a2d21113-01e6-30b4-9f94-31673c8bf688",
                                        "glosses": [
                                            "физ. гипотетическое вещество, атомы которого построены из античастиц"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abdfe7c4-b8e9-443e-9dd4-43923bf84f44",
                                                "sense_id": "a2845139-1bdc-33d3-bc45-062a369adb52",
                                                "text": "Писатели-фантасты устраивали драматические встречи земного космического корабля с неземным и ― вполне возможно! ― состоящим из антивещества."
                                            },
                                            {
                                                "example_id": "7e83af4d-0e94-43b0-88f9-93133ccd5f8a",
                                                "sense_id": "a2845139-1bdc-33d3-bc45-062a369adb52",
                                                "text": "За трехнедельный срок в результате столкновения между антипротонами и атомами ксенона образовались девять атомов антивещества."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9be80ad-ab4a-37bd-b4a5-1c91cff9b2b1",
                                        "entry_id": "a2d21113-01e6-30b4-9f94-31673c8bf688",
                                        "glosses": [
                                            "физ. неисч. то же, что антиматерия, совокупность античастиц"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3595cbdf-af55-4444-918f-6abd22a5eff1",
                                                "sense_id": "b9be80ad-ab4a-37bd-b4a5-1c91cff9b2b1",
                                                "text": "Дело в том, что продолжение опыта представляет исключительный интерес не только с точки зрения проверки Стандартной модели и уточнения ее параметров, но, возможно, и для разрешения загадки асимметрии (неравного присутствия) вещества и антивещества во Вселенной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83ce06e6-36b7-3985-8f01-17baacabe375",
                                        "entry_id": "a2d21113-01e6-30b4-9f94-31673c8bf688",
                                        "glosses": [
                                            "устар. мед. то же, что антитело"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40c6afc-e447-4913-83ff-34dc07c350ec",
                                                "sense_id": "83ce06e6-36b7-3985-8f01-17baacabe375",
                                                "text": "Позволительно думать, что и изоиммунсыворотка, как таковая, не будь в ней специфических противопаратифозных антивеществ, имела бы то же (повышающее кожную реактивность) действие, что и нормальная."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
