            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                    "sense_definition": "A woman or girl who performs in plays, movies, or on television.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous <w>actress</w> smiled at her fans on the red carpet.",
                            "target_lang_translations": {
                                "ru": "Известная <w>актриса</w> улыбнулась своим поклонникам на красной дорожке.",
                                "zh": "那位著名的<w>女演员</w>在红毯上向她的粉丝微笑。"
                            }
                        },
                        {
                            "text": "She dreams of becoming a lead <w>actress</w> in Hollywood someday.",
                            "target_lang_translations": {
                                "ru": "Она мечтает когда-нибудь стать ведущей <w>актрисой</w> в Голливуде.",
                                "zh": "她梦想着有一天能成为好莱坞的首席<w>女演员</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lead actress",
                        "supporting actress",
                        "famous actress",
                        "best actress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина или девушка, которая играет роли в пьесах, кино или на телевидении.",
                        "zh": "在戏剧、电影或电视中表演的女性或女孩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "актриса",
                                "target_lang_sense_clarification": "профессия"
                            },
                            {
                                "target_lang_word": "артистка",
                                "target_lang_sense_clarification": "исполнительница ролей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "女演员",
                                "target_lang_sense_clarification": "从事表演职业的女性"
                            },
                            {
                                "target_lang_word": "女艺人",
                                "target_lang_sense_clarification": "从事演艺工作的女性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23be3a93-71a9-3dd6-ae13-2fc3af4534b9",
                    "sense_definition": "A female who takes an active part or role in a situation or event.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt like an unwilling <w>actress</w> in the unfolding political drama.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя невольной <w>участницей</w> разворачивающейся политической драмы.",
                                "zh": "她感觉自己像是这场政治闹剧里不情愿的<w>参与者</w>。"
                            }
                        },
                        {
                            "text": "History made her a central <w>actress</w> in the events that changed the country.",
                            "target_lang_translations": {
                                "ru": "История сделала её главным <w>действующим лицом</w> в событиях, изменивших страну.",
                                "zh": "历史使她成为改变国家进程事件中的核心<w>主角</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used in a literary or general sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина, принимающая активное участие или играющая роль в какой-либо ситуации или событии.",
                        "zh": "在某种情况或事件中发挥积极作用或扮演角色的女性。"
                    },
