                                "target_senses": [
                                    {
                                        "sense_id": "29bd5c1d-6eac-3c87-8c21-d4560cf55652",
                                        "entry_id": "3358d391-8b69-38b8-ab04-b02d5ffadc1f",
                                        "glosses": [
                                            "Eau tirée d’une source, par opposition (autrefois) à l’eau du puits, souvent fétide ou (aujourd’hui) à l’eau du robinet ou à l’eau minérale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a32d09cc-9582-48e5-a57a-bd74165ee678",
                                                "sense_id": "29bd5c1d-6eac-3c87-8c21-d4560cf55652",
                                                "text": "Il faut noter que, lors de la dernière décennie, la consommation de l’eau de source ou de l’eau minérale en bouteille a beaucoup progressé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f4149e-7831-3b22-855b-559b40950b77",
                                        "entry_id": "3358d391-8b69-38b8-ab04-b02d5ffadc1f",
                                        "glosses": [
                                            "Liquide clair qui brille comme une eau de source."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46647689-6576-46ea-a3bb-e0685b87c150",
                                                "sense_id": "f8f4149e-7831-3b22-855b-559b40950b77",
                                                "text": "L’ancêtre, l’oubliée, grande, noueuse, effrayante, restait immobile, avec ses yeux qui vivaient seuls, ses clairs yeux d’eau de source, dans son mince visage desséché."
                                            }
                                        ]
                                    }
