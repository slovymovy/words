                        "target_lang_word": "Qurayshite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Qurayshite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f3c8606-b6bf-3ffc-ae1f-b7ec07e84a68",
                                        "entry_id": "2bc58843-a739-39d6-8304-6f39bb3a0079",
                                        "glosses": [
                                            "part of, or descended from, the Quraysh tribe."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03036731-c533-4ad1-ba01-3d397df3eb68",
                                                "sense_id": "5f3c8606-b6bf-3ffc-ae1f-b7ec07e84a68",
                                                "text": "A member of the Qurayshite Umayyad family wanted to claim the poet al-Farazdaq's bride al-Nawār, though the poet thought he could prove that he had a clear claim because he had paid the bride price."
                                            },
                                            {
                                                "example_id": "e1219159-5a66-4f6f-a514-0cc5cb2e66b1",
                                                "sense_id": "5f3c8606-b6bf-3ffc-ae1f-b7ec07e84a68",
                                                "text": "If anyone comes to Muhammad from the Qurayshite camp without the permission of his superiors, he [Muhammad] will send him back; however, if any of those who are with Muhammad comes to the Qurayshite camp, they [the Qurayshites] will not send him back."
                                            },
                                            {
                                                "example_id": "3075fc56-1054-48ad-95e2-8f33497db191",
                                                "sense_id": "5f3c8606-b6bf-3ffc-ae1f-b7ec07e84a68",
                                                "text": "He sought to understand the social contexts in which Qurayshite descent was a reasonable condition and those in which it was not."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Qurayshite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30531ba9-2139-3d4b-abf3-bf7ad8e2a853",
                                        "entry_id": "52a3f891-0182-319f-a5e3-6a214b76bbd0",
                                        "glosses": [
                                            "a member of this tribe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf310ac2-8036-40ea-a51c-4629974f9a27",
                                                "sense_id": "30531ba9-2139-3d4b-abf3-bf7ad8e2a853",
                                                "text": "The fortuitous circumstances that the first man to be elected to this high office was a Qurayshite became, for all except the heterodox, a principle — the caliph had to be a member of the Prophet's tribe, and the Prophet was a Qurayshite."
                                            },
                                            {
                                                "example_id": "51dc50ce-cf33-44b0-9af3-aa1c60ab2c54",
                                                "sense_id": "30531ba9-2139-3d4b-abf3-bf7ad8e2a853",
                                                "text": "At this point, having twice delivered up Abū Basīr to the Qurayshites, Muḥammad felt that he had fulfilled his obligation under the treaty."
                                            },
                                            {
                                                "example_id": "7ac77280-bb07-4e08-8b04-ca478e2f05ec",
                                                "sense_id": "30531ba9-2139-3d4b-abf3-bf7ad8e2a853",
                                                "text": "The Banu-Khuzaa, who had entered into an alliance with Muhammad at Mecca, were for a long time at bloody enmity with the neighboring tribe of Banu-Bakr, who were in alliance with the Qurayshites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
