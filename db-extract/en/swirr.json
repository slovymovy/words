                "senses": [
                    {
                        "sense_id": "075763d7-589f-3ddc-8b69-5c4eaa833fd3",
                        "entry_id": "a6bb9cff-bfcb-30fc-ae20-ebdf96b9cfd4",
                        "glosses": [
                            "A noise of something moving, like a swoosh or a whirr."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1083a4-dc55-408f-ba6e-c1db2dbb92d6",
                                "sense_id": "075763d7-589f-3ddc-8b69-5c4eaa833fd3",
                                "text": "... who heard the swirr of their skirts as they struck the bushes, took possession of the abandoned fortress. The taller and slighter of the two picked up the fragments of the handkerchief, and, after examining them, passed to his companion one[…]"
                            },
                            {
                                "example_id": "c733d3ee-247b-471d-9fef-6098a6717fcf",
                                "sense_id": "075763d7-589f-3ddc-8b69-5c4eaa833fd3",
                                "text": "... swirr of the scythe from the distant hayfields in the valley; the sonorous drone of wild bees on the wing; the hushed cry of the cuckoo from the woods; the elastic warmth of the thyme-laden air."
                            },
                            {
                                "example_id": "a7819a10-23df-4aa8-95e4-fdb74e9f8631",
                                "sense_id": "075763d7-589f-3ddc-8b69-5c4eaa833fd3",
                                "text": "... swirr of wind among the palm-branches, or the dull beat of the waveless Mediterranean far below."
                            },
                            {
                                "example_id": "47b017a5-9a07-4de9-b172-9ee08eedd46e",
                                "sense_id": "075763d7-589f-3ddc-8b69-5c4eaa833fd3",
                                "text": "... swirr of the locusts, the laughing of the jackass, or the tuneful note of the magpie."
                            },
                            {
                                "example_id": "52604975-e955-4067-99b0-1a957427857c",
                                "sense_id": "075763d7-589f-3ddc-8b69-5c4eaa833fd3",
                                "text": "... swirr of the wheels, and the handful of luminous cloud which preceded the lamp. The clang of the bell, as the corner was neared, seemed to act as a summons."
                            },
                            {
                                "example_id": "9faeda62-2da7-44b4-ad16-1ba1be003482",
                                "sense_id": "075763d7-589f-3ddc-8b69-5c4eaa833fd3",
                                "text": "... swirr of a bat's wing, the twittering hoot of a barn-owl, the cheep of night insects."
                            },
                            {
                                "example_id": "a9c928b8-7978-4e36-ba34-80a938567bba",
                                "sense_id": "075763d7-589f-3ddc-8b69-5c4eaa833fd3",
                                "text": "... swirr of the knife and the sickening swish accompanying the official decapitation of Henry J. Allen, president of the defunct board."
                            },
                            {
                                "example_id": "278dd851-79cd-45ed-afa7-e08a7d7072ed",
                                "sense_id": "075763d7-589f-3ddc-8b69-5c4eaa833fd3",
                                "text": "... swirr of myriads of little travelling feet caught his quick ear—the moving mass was an immense colony of beaver. Thousands upon thousands of them. Scores of baby beavers staggered along, following their mothers; scores of older beavers[…]"
                            }
                        ]
                    }
