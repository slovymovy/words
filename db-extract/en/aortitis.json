                        "sense_id": "202d3ed7-89fe-3014-a780-811b0ce2d56b",
                        "entry_id": "5bc7364d-138a-365b-ab61-c113cd129569",
                        "glosses": [
                            "Inflammation of the aorta."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ca49de36-52f5-47c0-b923-d949552d809c",
                                "sense_id": "202d3ed7-89fe-3014-a780-811b0ce2d56b",
                                "text": "In other maternal heart disease we had 7 aortitises, 5 cardiomyopathies, 1 primary pulmonary hypertension, angina pectoris with familial hyperrholesterolaemia and pericarditis."
                            },
                            {
                                "example_id": "363fbfe9-bf5d-4f6f-8984-a1be24219a00",
                                "sense_id": "202d3ed7-89fe-3014-a780-811b0ce2d56b",
                                "text": "The presence of inflammatory cells in the aortic media or adventitia is indicative of aortitis."
                            },
                            {
                                "example_id": "aa091cf9-6a3a-42a0-a1e4-4f89806e5f9b",
                                "sense_id": "202d3ed7-89fe-3014-a780-811b0ce2d56b",
                                "text": "Aortitis can affect any site in the aorta but has a predilection for the ascending aorta with a tendency to cause dilatation, aneurysms and aortic valve insufficiency (Figs. 42.1 and 42.2)."
                            }
                        ]
                    }
                ],
                "translations": [
