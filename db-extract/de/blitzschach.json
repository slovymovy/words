                    {
                        "sense_id": "45e9c19b-0e6d-39eb-adba-a6d4c09f75f9",
                        "entry_id": "40b6ac57-0db4-3a07-898e-31ec1bf71649",
                        "glosses": [
                            "schnelle Form des Schachspiels, wobei jeder Spieler für die gesamte Partie nur wenige Minuten Zeit hat (meistens fünf Minuten)"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "13bb1d26-405a-4619-a275-107ee8045ac9",
                                "sense_id": "45e9c19b-0e6d-39eb-adba-a6d4c09f75f9",
                                "text": "Alle Schachgroßmeister spielen auch hervorragend Blitzschach."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1fd977b-a8aa-4dbb-bbec-d7e7ca4840f1",
                        "source_entry_id": "40b6ac57-0db4-3a07-898e-31ec1bf71649",
                        "source_sense_id": "45e9c19b-0e6d-39eb-adba-a6d4c09f75f9",
                        "source_sense_description": "Form des Schachspiels, wobei jeder Spieler für die gesamte Partie nur wenige Minuten Zeit hat",
                        "target_lang_word": "blitz chess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blitz chess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91d2f673-9b0a-3f02-a18c-48ae499502ae",
                                        "entry_id": "cdfc5667-5d82-3f23-85b2-600182b06e35",
                                        "glosses": [
                                            "Chess played at a quick time control, with each side getting about five minutes to make their moves. Blitz chess is played at a variety of time controls, primarily 3+0 (three minutes per side), 3+2 (three minutes per side plus two extra seconds per move), 5+0, and 5+3."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aebf9af-9284-4e02-b244-23168bdb6400",
                                                "sense_id": "91d2f673-9b0a-3f02-a18c-48ae499502ae",
                                                "text": "What I had played was chess. Specially, I knocked out some 2,000 games of speed (or \"blitz\") chess in the two months leading up to the tournament. In fact, I played so much that I'm currently in the top half-percent of more than 1.3 million of blitz players at an online chess competition site."
                                            },
                                            {
                                                "example_id": "a85d5319-05f5-4338-80d4-8d479542aae5",
                                                "sense_id": "91d2f673-9b0a-3f02-a18c-48ae499502ae",
                                                "text": "If there’s still no winner, the players move on two games of blitz chess. There, each player is limited to only five minutes, with three seconds added after each move. If there is no winner, they play a further two games of blitz chess."
                                            },
                                            {
                                                "example_id": "1790139d-3c61-4773-9486-09b6560ac6db",
                                                "sense_id": "91d2f673-9b0a-3f02-a18c-48ae499502ae",
                                                "text": "Muzychuk, 27, is the reigning women’s world champion in both rapid and blitz chess."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1444ad07-5363-4a94-82d9-74b92168619d",
                        "source_entry_id": "40b6ac57-0db4-3a07-898e-31ec1bf71649",
                        "source_sense_id": "45e9c19b-0e6d-39eb-adba-a6d4c09f75f9",
                        "source_sense_description": "Form des Schachspiels, wobei jeder Spieler für die gesamte Partie nur wenige Minuten Zeit hat",
                        "target_lang_word": "fast chess",
                        "target_lang_code": "en",
