                ],
                "senses": [
                    {
                        "sense_id": "8d1fa7f4-723d-39fe-be7a-3dbecf66a8a6",
                        "entry_id": "33d99c1c-dcc0-38ad-8df5-67d099cd80db",
                        "glosses": [
                            "für die Aufführung in einem Theater vorgesehener Text"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249d7f47-4264-4905-8ae2-dbb7b745c71c",
                                "sense_id": "8d1fa7f4-723d-39fe-be7a-3dbecf66a8a6",
                                "text": "„Sie hatte mir gesagt, daß sie noch nie Komödien oder andere Bühnenstücke gesehen habe, und ich war sogleich entschlossen, ihr zu diesem Vergnügen zu verhelfen.“"
                            },
                            {
                                "example_id": "46518974-90f5-4971-87b1-7a1a9e459932",
                                "sense_id": "8d1fa7f4-723d-39fe-be7a-3dbecf66a8a6",
                                "text": "„Blieb noch das ernste Bühnenstück oder das bürgerliche Trauerspiel, in dem untröstliche Familienväter, Diener, die ihre Herren retten, Reiche, die ihr Vermögen verschenken, unschuldige Näherinnen und ruchlose Verführer auftreten, ein Genre, das bei Diderot anfängt und sich bis zu Pixérécourt fortsetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
