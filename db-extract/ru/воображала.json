                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1aa292a-f905-3370-ada0-1d204ad96d42",
                        "entry_id": "04c7fecf-22b3-33f3-935b-a5c96baa6ee5",
                        "glosses": [
                            "разг., неодобр. заносчивый человек, тот, кто имеет о себе слишком высокое мнение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e45e0bf-315d-4534-888d-e6cc4bd69ff1",
                                "sense_id": "a1aa292a-f905-3370-ada0-1d204ad96d42",
                                "text": "Всегда воображалой был, выше всех себя ставил."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c01ecc0c-430a-47f5-bbd0-ffe3296907ff",
                        "source_entry_id": "04c7fecf-22b3-33f3-935b-a5c96baa6ee5",
                        "source_sense_id": "a1aa292a-f905-3370-ada0-1d204ad96d42",
                        "target_lang_word": "nose-in-the-air",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5b902540-4963-4b04-937b-c5cadceda634",
                        "source_entry_id": "04c7fecf-22b3-33f3-935b-a5c96baa6ee5",
                        "source_sense_id": "a1aa292a-f905-3370-ada0-1d204ad96d42",
                        "target_lang_word": "swank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                        "entry_id": "7f4968fa-8a5b-3812-afa1-fbbe67aadfeb",
                                        "glosses": [
                                            "Fashionably elegant, posh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e656827-316b-49f7-a834-8e67fd118e8b",
                                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                                "text": "The fish house or shack is built without windows, covered with tar paper to keep out the light and wind, and set on the ice over about ten feet of water in a spot off shore where fish have been known to habitate habitually. […] A couple of boxes to sit on and a plank or mat for your feet and a small airtight stove, if you want swank comfort."
                                            },
                                            {
                                                "example_id": "bcf63841-3046-4023-9d27-6c62bd4d2c45",
                                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                                "text": "\"You live in that swank apartment round the corner.\"\n\"Yes.\"\n\"Hey you must be rich.\""
                                            },
                                            {
                                                "example_id": "cec5eda0-02ce-428a-83dd-8322d45b77ae",
                                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                                "text": "You know it's swank when … It's very shiny / It's very tan / It's got Royale in its name"
                                            },
                                            {
                                                "example_id": "38332447-0b7e-4d75-a0b5-8a7eada90ea2",
                                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                                "text": "[T]he Montgomery Block was the commercial and social center of San Francisco. […] Above [the ground floor] were a law library, the three rooms of the Mercantile Library Association, and a swank billiard room that ran nearly the entire length of the second floor."
                                            },
                                            {
                                                "example_id": "3b975b3a-c160-4f5a-8602-55e01bea986b",
                                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                                "text": "Mr. Heinz belonged to a very swank club in Pittsburgh."
                                            },
                                            {
                                                "example_id": "cb9fa33e-6cb5-4749-8fca-dd89f083ed6a",
                                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                                "text": "She arrived at a very swank studio, where Mr. Feldman introduced himself as the director of auditions."
                                            },
                                            {
                                                "example_id": "1bdf9705-785a-462c-8b61-e7c3b1ccf407",
                                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                                "text": "As we were enjoying this lovely meal, a very swank and sophisticated older woman came over to our table and excused herself, more so to Jerry than me."
                                            },
                                            {
                                                "example_id": "025a058e-25c7-40b7-b89a-04b2d07ec527",
                                                "sense_id": "564ab808-647e-34ca-9a26-0442b3a6640e",
                                                "text": "Warren, Emerald City's owner, had thrown a swank party at his house and invited the whole staff, along with about fifty others."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "379c9d03-2b44-333c-8bda-48b34d7fda3a",
                                        "entry_id": "ef5aa0c0-9685-309f-8bb6-98c152587e64",
                                        "glosses": [
                                            "A fashionably elegant person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de16231a-3fb7-45fe-ac2e-559f7188cd31",
                                                "sense_id": "379c9d03-2b44-333c-8bda-48b34d7fda3a",
                                                "text": "Us Morans don't like swanks, and that girl was a swank. Stuck-up rich girl. She wore a practically new gabardine with the same paper Union Jack flag as me, only hers was tucked into her coat buttonhole, behind a gold cat pasted with jewels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3751c403-9b66-3a00-8358-902d1edf99cc",
                                        "entry_id": "ef5aa0c0-9685-309f-8bb6-98c152587e64",
                                        "glosses": [
                                            "Ostentation; bravado."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75a439fe-907c-4c01-8914-edf9b1e277ac",
                                                "sense_id": "3751c403-9b66-3a00-8358-902d1edf99cc",
                                                "text": "'It is mere swank sending it to us,' said he. 'We have to be there whatever happens, as the hangman said to the murderer.'"
                                            },
                                            {
                                                "example_id": "fd851058-50d8-4e51-9de4-5f0f31ca115f",
                                                "sense_id": "3751c403-9b66-3a00-8358-902d1edf99cc",
                                                "text": "Not even the effeminate swank of his riding clothes could hide the enormous power of that body—he seemed to fill those glistening boots until he strained the top lacing and you could see a great pack of muscle shifting when his shoulder moved under his thin coat."
                                            },
                                            {
                                                "example_id": "c0753d91-bcc1-4c3a-9a08-7dcc1796fa5c",
                                                "sense_id": "3751c403-9b66-3a00-8358-902d1edf99cc",
                                                "text": "Huge waves keep coming in over the front and I have seen the boat nearly go under any number of times. All the others pretend to take no notice of this, either from swank or because Harold says one of the most cowardly things ordinary people do is to shut their eyes to Facts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7071afe7-4919-3f82-b500-22780c016e14",
                                        "entry_id": "6de2b67d-5bda-3b87-88af-8b529a69dba8",
                                        "glosses": [
                                            "To swagger, to show off."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "259c0fff-e8f8-4622-aec8-b4e8bdd44e73",
                                                "sense_id": "7071afe7-4919-3f82-b500-22780c016e14",
                                                "text": "Looks like she's going to swank in, flashing her diamonds, then swank out to another party."
                                            },
                                            {
                                                "example_id": "272290ed-a5b1-49c0-b083-1845478730f6",
                                                "sense_id": "7071afe7-4919-3f82-b500-22780c016e14",
                                                "text": "He was still an old galliard, with white Buffalo Bill vandyke, and he swanked around, still healthy of flesh, in white suits, looking things over with big sex-amused eyes."
                                            },
                                            {
                                                "example_id": "0c777ee0-f1bc-4c7a-af5c-ed6d2da6a8c3",
                                                "sense_id": "7071afe7-4919-3f82-b500-22780c016e14",
                                                "text": "[Peter] O'Toole does for this movie [My Favorite Year] what [Alan] Swann does for the cast and crew of Comedy Cavalcade: he swanks in whenever there's a lull in the action and with a dapper flare of his cuffs sets off smiles, sighs, palpitations."
                                            },
                                            {
                                                "example_id": "75daaaa0-30ec-431b-973e-98cbe6783138",
                                                "sense_id": "7071afe7-4919-3f82-b500-22780c016e14",
                                                "text": "With their innuendos and condemnations, with their loud-mouthed gabble, what a frighteningly learned lot they are – not quite clever, and not quite skilled. But still, it's woman's nature to swank; they swank because they're women, so let them swank. We won't take offence."
                                            },
                                            {
                                                "example_id": "b28a2ce8-4d46-4939-8c51-1af52bce4574",
                                                "sense_id": "7071afe7-4919-3f82-b500-22780c016e14",
                                                "text": "He hung up my coat – my shabby, two-seasons-old Gap coat – and it looked like the scruffy kid in class next to the fawn cashmere number swanking on the neighbouring peg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b705de07-ee0a-4964-bac3-cf6cfb799914",
                        "source_entry_id": "04c7fecf-22b3-33f3-935b-a5c96baa6ee5",
                        "source_sense_id": "a1aa292a-f905-3370-ada0-1d204ad96d42",
                        "target_lang_word": "swelled head",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swelled head",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddc95470-2d25-3852-b9cc-c4b20974f02c",
                                        "entry_id": "f4d1b92e-c500-339e-8bec-a342a3c6b03d",
                                        "glosses": [
                                            "Self-conceit."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc9174f1-4f59-4366-8cd8-6aecfefbfa8e",
                                                "sense_id": "ddc95470-2d25-3852-b9cc-c4b20974f02c",
                                                "text": "Success, however, is often their undoing, praise and flattery are inclined to make them have “swelled heads.”"
                                            },
                                            {
                                                "example_id": "42d670c3-97a6-4d57-aa35-7c6ceaca7431",
                                                "sense_id": "ddc95470-2d25-3852-b9cc-c4b20974f02c",
                                                "text": "Conversely, when that same child does something exceptional, the parent will say, “Don’t get a swelled head from it.” The parent may be trying to help the child avoid becoming conceited, but the result is a message that says achievements aren’t anything to strive for or be proud of."
                                            },
                                            {
                                                "example_id": "6dd4225a-0d5f-4b4a-b502-5eaddaaf1e80",
                                                "sense_id": "ddc95470-2d25-3852-b9cc-c4b20974f02c",
                                                "text": "Now his ego inflates and his swelled head knows no bounds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
