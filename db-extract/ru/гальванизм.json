                        "source_entry_id": "89a7f0b7-333c-3dfb-b641-d738b527132d",
                        "target_lang_word": "Galvanismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f6b3b3f3-cc63-4b32-8b80-6258eef19d86",
                        "source_entry_id": "89a7f0b7-333c-3dfb-b641-d738b527132d",
                        "target_lang_word": "galvanisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galvanisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e899686a-40cf-33e0-8d42-1259bb8ce9cb",
                                        "entry_id": "e7ae5d86-7be3-3041-aeaf-2d7bb00fe854",
                                        "glosses": [
                                            "Courant électrique produit par les piles ordinaires et les piles réversibles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "725a83eb-5db6-3177-833e-a466eb110c71",
                                        "entry_id": "e7ae5d86-7be3-3041-aeaf-2d7bb00fe854",
                                        "glosses": [
                                            "Phénomène électrique qui se produit dans les substances animales, spécialement dans les muscles et dans les nerfs, soit par le contact mutuel, soit quand on met ces substances en communication avec des métaux."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd5e8d34-e22a-4d75-8838-4d213ee2feef",
                                                "sense_id": "725a83eb-5db6-3177-833e-a466eb110c71",
                                                "text": "Elle prend du tabac, se tient raide comme un pieu, se pose en femme considérable, et ressemble parfaitement à une momie à laquelle le galvanisme aurait rendu la vie pour un instant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9256f3dc-da4a-3b27-9550-52adbf171d59",
                                        "entry_id": "e7ae5d86-7be3-3041-aeaf-2d7bb00fe854",
                                        "glosses": [
                                            "Agent invisible produisant des phénomènes galvaniques, et que l’on croyait être l’électricité en mouvement."
                                        ],
                                        "tags": [
                                            "Histoire des sciences"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3216319c-953a-4b8b-aaed-55da88fb1faa",
                                                "sense_id": "9256f3dc-da4a-3b27-9550-52adbf171d59",
                                                "text": "Mesurer la force du galvanisme."
                                            },
                                            {
                                                "example_id": "94bdadeb-1ef1-4b21-9462-7803121d261b",
                                                "sense_id": "9256f3dc-da4a-3b27-9550-52adbf171d59",
                                                "text": "Quand je la voyais venant de loin sur le Cours où je jouais avec d'autres enfants, et qu'elle y amenait Victurnien, son neveu, j'éprouvais une émotion qui tenait beaucoup des sensations produites par le galvanisme sur les êtres morts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
