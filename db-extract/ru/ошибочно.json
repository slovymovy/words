                                    },
                                    {
                                        "sense_id": "59ac64c6-8b9b-3cd2-9456-7b2bae1ed040",
                                        "entry_id": "fcc1bc95-733f-3d13-ae1c-a5992f0210f9",
                                        "glosses": [
                                            "Incorrectly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e011343-a2ff-45ff-a725-9f77e70ed7c6",
                                                "sense_id": "59ac64c6-8b9b-3cd2-9456-7b2bae1ed040",
                                                "text": "White House chief of staff Gen. John Kelly on Thursday erroneously claimed that Rep. Frederica Wilson, D-Florida, claimed credit for securing “$20 million” in federal funding to build a new FBI field office in Miami in 2015, according to a video of the dedication ceremony posted Friday by the Sun Sentinel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b669b288-3880-498c-8ddf-6e716f5b218a",
                        "source_entry_id": "7ebba3b7-e301-3f87-a550-b456311915a1",
                        "source_sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                        "target_lang_word": "à tort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à tort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71151c0e-5886-300e-9b34-88410a21d153",
                                        "entry_id": "12c45aca-61fa-30b6-93c3-0705a8975bb2",
                                        "glosses": [
                                            "Sans raison ; injustement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3a71c8e-cd8d-495e-92d4-d7cd22481bc1",
                                                "sense_id": "71151c0e-5886-300e-9b34-88410a21d153",
                                                "text": "L’acheteur d’une paire de chevaux les recherche, souvent à tort, au point de vue de la ressemblance, au lieu d’exiger la qualité ; le marchand est prévenu d’avance, aussi associe-t-il des animaux très-différents quant à leur valeur, pourvu qu’ils aient même taille et même robe ; […]."
                                            },
                                            {
                                                "example_id": "4ea07ced-4453-4e24-8ef5-cf95bbe5a21d",
                                                "sense_id": "71151c0e-5886-300e-9b34-88410a21d153",
                                                "text": "[…] au lieu d'aller chercher une subsistance moins saine et moins économique chez des industriels qu'on a baptisé bien à tort du nom de restaurateurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd3aa557-54ce-4e8f-98dc-4de62870ebf3",
                        "source_entry_id": "7ebba3b7-e301-3f87-a550-b456311915a1",
                        "source_sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                        "target_lang_word": "par erreur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "par erreur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aac82f48-0c25-31e4-8549-34078e65e135",
                                        "entry_id": "0af05f00-0838-31bf-91f1-ffe73676b732",
                                        "glosses": [
                                            "Suite à une information ou une croyance erronée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359253fb-c7b8-4958-9fb0-e88b3bc926fa",
                                                "sense_id": "aac82f48-0c25-31e4-8549-34078e65e135",
                                                "text": "Christophe Colomb a découvert l'Amérique par erreur. Il croyait que le Japon était à 4.000 km de l'Espagne"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2d77d28-fc86-3e3f-a68e-e43fb1811594",
                                        "entry_id": "0af05f00-0838-31bf-91f1-ffe73676b732",
                                        "glosses": [
                                            "A la suite d'une méprise dans l'action ; en se trompant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d6d38db-2937-4602-adae-ec7cbf67172c",
                                                "sense_id": "e2d77d28-fc86-3e3f-a68e-e43fb1811594",
                                                "text": "J’ai accepté par erreur ton invitation, j’ai dû me gourer dans l’heure, j’ai dû me planter dans la saison."
                                            },
                                            {
                                                "example_id": "55426e9c-1f93-4e84-91eb-719b86331127",
                                                "sense_id": "e2d77d28-fc86-3e3f-a68e-e43fb1811594",
                                                "text": "Le Splenda est le nom de marque apposé au terme scientifique \"sucralose\". Cette substance a été découverte par erreur alors que des scientifiques travaillaient à mettre au point un insecticide. Azalea, 27 mai 2007"
                                            },
                                            {
                                                "example_id": "eab67530-dcd8-4c0c-8a24-5853dc0ea436",
                                                "sense_id": "e2d77d28-fc86-3e3f-a68e-e43fb1811594",
                                                "text": "La découverte de l'aspartame fut une découverte surprenante et inattendue. Cette dernière, faite par James Schlatter en 1965, peut être qualifiée d'anecdotique. En effet, à la base, ce chimiste du laboratoire pharmaceutique américain G.D. Searle & Compagny cherchait à élaborer un nouveau traitement anti-ulcère. Il aurait goûté par erreur à cet intermédiaire de synthèse (en humectant son doigt pour attraper une feuille de papier) et découvert un goût très sucré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53f07b3a-8675-4caf-bc9b-7d9ee48a0dca",
                        "source_entry_id": "7ebba3b7-e301-3f87-a550-b456311915a1",
                        "source_sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                        "target_lang_word": "erronément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erronément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8186d3c5-598d-3154-a11b-97e6b3e0c519",
                                        "entry_id": "89d469a6-5c6d-305c-a3ce-046a1c96292e",
                                        "glosses": [
                                            "De façon erronée."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11322e04-409c-4875-8722-213666fa5cbf",
                                                "sense_id": "8186d3c5-598d-3154-a11b-97e6b3e0c519",
                                                "text": "Le cric d’arbalète est erronément connu de nos jours, sous le nom de cranequin. À l’origine, ce mot désignait l’arbalète et non le mécanisme destiné à la tendre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19ab4e83-7c52-41f9-85ba-a58ced35b558",
                        "source_entry_id": "7ebba3b7-e301-3f87-a550-b456311915a1",
                        "source_sense_id": "4735190d-68c7-3a82-8a84-ef51484ddea3",
                        "target_lang_word": "faussement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faussement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d483ce2-919a-343f-95cd-90bdab7c3c41",
                                        "entry_id": "20295155-2d56-3f77-93a3-fa2cbd9ae28c",
                                        "glosses": [
                                            "Contre la vérité. À tort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215de34f-1a08-4b98-8337-04aefaa0353e",
                                                "sense_id": "5d483ce2-919a-343f-95cd-90bdab7c3c41",
                                                "text": "Et faisant faussement parler les immortels."
                                            },
                                            {
                                                "example_id": "59b236b9-65c1-4515-b354-e48c99ff8114",
                                                "sense_id": "5d483ce2-919a-343f-95cd-90bdab7c3c41",
                                                "text": "Cher ami, si mon père un jour désabusé Plaint le malheur d’un fils faussement accusé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f60eab40-eb85-3d43-b2e6-1ead48f8cada",
                                        "entry_id": "20295155-2d56-3f77-93a3-fa2cbd9ae28c",
                                        "glosses": [
                                            "Seulement superficiellement et pas réellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468e2d5a-94c7-4f05-b163-4ea315cc5c92",
                                                "sense_id": "f60eab40-eb85-3d43-b2e6-1ead48f8cada",
                                                "text": "Un voile funèbre couvrit son visage, naguère si faussement joyeux, sa taille se pencha comme succombant sous un poids insupportable ; et des larmes involontaires coulèrent sur ses joues, alors d’une effrayante pâleur."
                                            },
                                            {
                                                "example_id": "49d5e06c-1124-4076-944b-c59006941437",
                                                "sense_id": "f60eab40-eb85-3d43-b2e6-1ead48f8cada",
                                                "text": "« Ces automobilistes sont dans ces cas-là faussement assurés. Ils croient pour certains être couverts, mais s’ils sont à l’origine d’un accident, tous les dégâts occasionnés seront à leur charge », martèle la Fédération française des assureurs."
                                            },
                                            {
                                                "example_id": "a4712882-5f54-4505-8948-7f0bec7b81ce",
                                                "sense_id": "f60eab40-eb85-3d43-b2e6-1ead48f8cada",
                                                "text": "Une coiffure faussement sage et naturelle, en réalité hyper-glamour !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "faussement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2950529d-4d5c-35c3-895e-9bb93a4a8b10",
                                        "entry_id": "bf173da6-dd19-304a-b7f7-e8e0239aa681",
                                        "glosses": [
                                            "Action de fausser ; état de ce qui est faussé."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "187bbf14-2f74-40ae-b647-5f2023adf632",
                                                "sense_id": "2950529d-4d5c-35c3-895e-9bb93a4a8b10",
                                                "text": "On doit le dire, Messieurs, cette loi électorale qui ravit aux masses nationales un droit acquis par deux révolutions, n'est pas seulement antilibérale, n'est pas seulement une loi de faussement du principe d'égalité sociale et politique ; c'est une loi de honte et d’humiliation pour toute là généralité française, […]."
                                            },
                                            {
                                                "example_id": "0b1746cd-5d31-4bb1-9721-035c5353eea7",
                                                "sense_id": "2950529d-4d5c-35c3-895e-9bb93a4a8b10",
                                                "text": "[…] c'est de la préparation régulière du pied que dépendent les qualités de la ferrure et les conditions auxquelles elle doit satisfaire, savoir : d'empêcher les faussements des aplombs, les déformations de l'organe, les défauts de régularité dans le mode."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
