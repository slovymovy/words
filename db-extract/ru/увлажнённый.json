                "senses": [
                    {
                        "sense_id": "53162145-1e57-3941-af83-8e532a8c08d7",
                        "entry_id": "fdf6728f-e558-331c-bc41-50b63b35829f",
                        "glosses": [
                            "страд. прич. прош. вр. от увлажнить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "0d16ba68-47c0-40de-afb0-201cc39bcb14",
                                "sense_id": "53162145-1e57-3941-af83-8e532a8c08d7",
                                "text": "Глаза у того были увлажнены слезами и губы вздрагивали."
                            },
                            {
                                "example_id": "2b20971d-faef-40fc-a1a4-97af5aa2b292",
                                "sense_id": "53162145-1e57-3941-af83-8e532a8c08d7",
                                "text": "Крот обычно предпочитает селиться в увлажнённой почве (но не болотистой) на лугах, близ речек, в огородах, садах, в лесных участках и кустарнике."
                            },
                            {
                                "example_id": "be464519-f452-4504-ae99-fd67b862e1cc",
                                "sense_id": "53162145-1e57-3941-af83-8e532a8c08d7",
                                "text": "Обильно увлажнённая росой трава проминается под ногами."
                            }
                        ]
                    }
                ],
