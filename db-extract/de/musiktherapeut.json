                "senses": [
                    {
                        "sense_id": "53bf13ab-ced0-3800-91bf-4d88ce1387b6",
                        "entry_id": "c3f1a6d6-67d4-36bd-9979-a15a71918e7b",
                        "glosses": [
                            "Therapeut, der durch die gezielte Anwendung von Musik versucht, die Patienten zu heilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "399c53c7-6fd7-472a-9f85-78f09cdf91c1",
                                "sense_id": "53bf13ab-ced0-3800-91bf-4d88ce1387b6",
                                "text": "„Man hat es auch mit Nebendarstellern wie Sven Hannawald versucht, dem RTL ein verlässlicher Musiktherapeut geworden ist in den Tagen der Springerei.“"
                            },
                            {
                                "example_id": "fa36ada4-ef57-4d94-b48b-63d46392f927",
                                "sense_id": "53bf13ab-ced0-3800-91bf-4d88ce1387b6",
                                "text": "„Die Abgrenzung gegen andere unkonventionelle Heilmethoden orientiert sich daran, ob Hilfsmittel eingesetzt werden. Die bloße Intention des Musiktherapeuten reicht manchmal aus, um Krankheitsverläufe günstig zu beeinflussen“, glaubt Wiesendanger. Doch die Heiler agieren oft am Rande der Legalität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
