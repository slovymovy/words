                                "target_senses": [
                                    {
                                        "sense_id": "d9848ee8-813f-39fd-a77e-6830ab2dc4e7",
                                        "entry_id": "78f216cb-443f-37d4-b8e1-164d9127de60",
                                        "glosses": [
                                            "A spar projecting over the prow of a sailing vessel to provide the means of adding sail surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8be8a1b-9f70-418a-b865-ca537af4f347",
                                                "sense_id": "d9848ee8-813f-39fd-a77e-6830ab2dc4e7",
                                                "text": "There lay the Ghost, bow on to the beach, her splintered bowsprit projecting over the sand, her tangled spars rubbing against her side to the lift of the crooning waves. Something must be done, must be done."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
