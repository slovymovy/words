                    },
                    {
                        "translation_id": "0b1fdd56-fd69-4cb7-a599-c2c32bdb39b2",
                        "source_entry_id": "6802ac8c-1925-3515-a4c8-0d2640de1d2e",
                        "source_sense_id": "15d63273-5eea-399b-a9e6-8eab7b4f8eb6",
                        "target_lang_word": "Menschenfresserei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschenfresserei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "119bb7cd-2fa0-375e-a2d4-392ab39eb79f",
                                        "entry_id": "ab04d2d5-fc35-3e5b-b07f-9cd19c9df8e7",
                                        "glosses": [
                                            "Verspeisen von Menschenfleisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e23d1456-37f8-4398-b2f9-e6f3f4bdca41",
                                                "sense_id": "119bb7cd-2fa0-375e-a2d4-392ab39eb79f",
                                                "text": "„Da sie sich bewusst waren, dass die meisten Afrikaner sie - stillschweigend oder explizit - bezichtigten, der Menschenfresserei zu frönen, reagierten Europäer oft mit Gegenanklagen:…“"
                                            },
                                            {
                                                "example_id": "6d79fbd3-13d9-45a8-93bf-9862f1b685f5",
                                                "sense_id": "119bb7cd-2fa0-375e-a2d4-392ab39eb79f",
                                                "text": "„Schilderungen von Menschenfressereien dienten häufig aber auch dazu, die Unterjochung und Ausrottung \"wilder Völker\" zu rechtfertigen. “"
                                            },
                                            {
                                                "example_id": "69c9a288-4678-42a6-823b-0de47eab84ad",
                                                "sense_id": "119bb7cd-2fa0-375e-a2d4-392ab39eb79f",
                                                "text": "„Die Frage von Colonel Sebastiani zur Menschenfresserei überraschte mich nicht.“"
                                            },
                                            {
                                                "example_id": "e5d6ac42-95fb-4bbf-b986-fcf11f8c1eb0",
                                                "sense_id": "119bb7cd-2fa0-375e-a2d4-392ab39eb79f",
                                                "text": "„Aber auch weiße Händler, Missionare und Schiffbrüchige wurden Opfer der Menschenfresserei, wie durch glaubwürdige Zeugen und Aufzeichnungen belegt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1964541-fd6a-465d-9fae-b63bc31efad6",
                        "source_entry_id": "6802ac8c-1925-3515-a4c8-0d2640de1d2e",
                        "source_sense_id": "15d63273-5eea-399b-a9e6-8eab7b4f8eb6",
                        "target_lang_word": "Anthropophagie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anthropophagie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4166ff38-731a-3fb1-ace2-094237a1457c",
                                        "entry_id": "78a443eb-061b-3873-a0a6-d06bb296c45c",
                                        "glosses": [
                                            "Verzehr von Menschenfleisch durch Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d990ef8-cbfc-42c7-aba8-ff283eb930a6",
                                                "sense_id": "4166ff38-731a-3fb1-ace2-094237a1457c",
                                                "text": "„Er hat ein kleines Buch über Literatur und Kannibalismus geschrieben, darin entfaltet er die Geschichte der Anthropophagie von James Cook bis Bret Easton Ellis.“"
                                            },
                                            {
                                                "example_id": "ec6d6fa8-cd03-415a-beb0-4cdccc88e247",
                                                "sense_id": "4166ff38-731a-3fb1-ace2-094237a1457c",
                                                "text": "„Meistens aber handelt es sich um pure Volksfantasie, wenn irgendwo in Afrika von Anthropophagie geraunt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
