                    {
                        "translation_id": "3ff97467-ba7b-4600-bf03-1f36fe803b7a",
                        "source_entry_id": "507b28ee-d787-370c-97a2-56e53c30a1fc",
                        "target_lang_word": "Weißbrot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weißbrot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6780f792-afcd-3a8c-abab-f237ac3481a3",
                                        "entry_id": "2ff9d38c-9a1e-3989-96b5-522ef46e92ab",
                                        "glosses": [
                                            "Brot, das aus hellem Weizenmehl gebacken ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc12b24e-0b2b-4d32-83b0-c192dcf86e1a",
                                                "sense_id": "6780f792-afcd-3a8c-abab-f237ac3481a3",
                                                "text": "Weißbrot schmeckt gut mit Marmelade."
                                            },
                                            {
                                                "example_id": "a5f82001-c8f0-4580-971b-803bec2672d5",
                                                "sense_id": "6780f792-afcd-3a8c-abab-f237ac3481a3",
                                                "text": "„Wir beeilten uns, ihm zu überreichen, was von dem Weißbrot übriggeblieben war, und sahen zu, wie er große Scheiben in den Mund steckte, die er mit einem mächtigen Klappmesser herunterschnitt.“"
                                            },
                                            {
                                                "example_id": "0bcaf2ca-59f6-446a-8036-f31e65db223d",
                                                "sense_id": "6780f792-afcd-3a8c-abab-f237ac3481a3",
                                                "text": "„Sie hatte Weißbrot mit Rosinen gebacken, denn Staszek hatte auch Rosinen mitgebracht.“"
                                            },
                                            {
                                                "example_id": "fdd97f17-3799-4e8f-b329-d06c79e8c706",
                                                "sense_id": "6780f792-afcd-3a8c-abab-f237ac3481a3",
                                                "text": "„Jim saß am rustikalen Tisch und schlürfte Nescafé, stopfte Weißbrot in sich hinein.“"
                                            },
                                            {
                                                "example_id": "a5698fec-c777-4555-ad6f-6a0f6bc122ed",
                                                "sense_id": "6780f792-afcd-3a8c-abab-f237ac3481a3",
                                                "text": "„Der vorletzte Satz wirkt Wunder, denn ein Hauch von Optimismus zieht in Papins Gesicht ein, und wir sehen, wie er Weißbrot in seinen Milchkaffee tunkt und entschlossen zum Mund führt, der sich ganz bereitwillig öffnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
