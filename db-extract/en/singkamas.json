                        "sense_id": "5fab75ac-47a7-3086-9a7f-87ef2057bd68",
                        "entry_id": "9c78c669-5ea2-3e05-976c-97b43ee4dfc6",
                        "glosses": [
                            "Synonym of jicama."
                        ],
                        "tags": [
