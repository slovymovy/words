                ],
                "senses": [
                    {
                        "sense_id": "294f52ba-9cb8-395f-a4c9-f22b005cbf41",
                        "entry_id": "6a2f81cb-12f8-3081-a4d6-d44077df7f65",
                        "glosses": [
                            "Person, die an Kampfhandlungen des Vietnamkriegs teilnahm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb17dfaa-b863-4710-a835-e712f3e1a5f4",
                                "sense_id": "294f52ba-9cb8-395f-a4c9-f22b005cbf41",
                                "text": "„Der Streit brach zwischen zwei Vietnamveteranen aus, von denen der eine behauptete, die erste in Kämpfe verwickelte Einheit sei die Luftlandeeinheit der 1. US-Kavalleriedivision gewesen, während der zweite diese Ehre der I. Division der Marines angerechnet wissen will.“"
                            },
                            {
                                "example_id": "293a5a0d-39db-406b-af62-f4d80c63c78e",
                                "sense_id": "294f52ba-9cb8-395f-a4c9-f22b005cbf41",
                                "text": "„Ich war vier Jahre in der Air Force gewesen, war dem Kampfgeschehen jedoch nie nähergekommen als im Krankenhaus neben verwundeten Vietnamveteranen, nachdem man meine Nase wegen der Football- und Boxverletzungen operiert hatte.“"
                            },
                            {
                                "example_id": "dfe155ea-ac16-4c5c-81c2-8c8cea713568",
                                "sense_id": "294f52ba-9cb8-395f-a4c9-f22b005cbf41",
                                "text": "„Bewaffnete, uniformierte Wachleute bewachen die Tore und patrouillieren auf dem Grundstück. Viele von ihnen sind verdiente Vietnamveteranen im Ruhestand, die sich geehrt fühlen, das Gelände bewachen zu dürfen.“"
                            },
                            {
                                "example_id": "a7dd57e1-eb52-42f2-9eb4-9bb167d1f6d7",
                                "sense_id": "294f52ba-9cb8-395f-a4c9-f22b005cbf41",
                                "text": "„Er war von der CIA ausgebildet worden, und dort vor allem durch einen ergrauten Vietnamveteranen namens Maurice, und in solchen Momenten wie jetzt hörte er ihn immer noch sagen: Junge! Munition kannst du nie zu viel dabeihaben, außer du ersäufst oder brennst.“"
                            },
                            {
                                "example_id": "ec29dfc1-050f-48aa-989f-2f7af66ead9c",
                                "sense_id": "294f52ba-9cb8-395f-a4c9-f22b005cbf41",
                                "text": "„›Ich habe einige Überlebenskünstler, Vietnamveteranen und Hippies erlebt, die den Winter alleine hier oben verbringen wollten.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
