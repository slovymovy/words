            "senses": [
                {
                    "sense_id": "527fd9d0-0f21-3e72-8a5a-9ecbb895a431",
                    "sense_definition": "The act of throwing something away or getting rid of something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "discarding_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>discarding</w> of old documents must be done securely to protect private information.",
                            "target_lang_translations": {
                                "nl": "Het <w>wegdoen</w> van oude documenten moet veilig gebeuren om privégegevens te beschermen."
                            }
                        },
                        {
                            "text": "Proper <w>discarding</w> of hazardous waste is essential for environmental safety.",
                            "target_lang_translations": {
                                "nl": "Het op de juiste wijze <w>verwijderen</w> van gevaarlijk afval is essentieel voor de veiligheid van het milieu."
                            }
                        }
                    ],
                    "synonyms": [
                        "disposal",
                        "rejection"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het proces van iets wegdoen of zich ontdoen van iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het wegdoen",
                                "target_lang_sense_clarification": "algemene handeling van iets verwijderen"
                            },
                            {
                                "target_lang_word": "de verwijdering",
                                "target_lang_sense_clarification": "formele handeling van het afvoeren van zaken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c620e43-e92c-3cf9-b8ed-55a413a6326c",
                    "sense_definition": "Material that has been thrown away or rejected.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "discarding_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists carefully sifted through the <w>discardings</w> of the ancient settlement.",
                            "target_lang_translations": {
                                "nl": "Archeologen zeefden zorgvuldig door het <w>afval</w> van de oude nederzetting."
                            }
                        },
                        {
                            "text": "The forest floor was covered with the natural <w>discardings</w> of the autumn season.",
                            "target_lang_translations": {
                                "nl": "De bosbodem was bedekt met de natuurlijke <w>resten</w> van het herfstseizoen."
                            }
                        }
                    ],
                    "synonyms": [
                        "refuse",
                        "waste",
                        "rubbish"
                    ],
                    "target_lang_definitions": {
                        "nl": "Materiaal dat is weggegooid of afgewezen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het afval",
                                "target_lang_sense_clarification": "materiaal dat niet meer bruikbaar is"
                            },
                            {
                                "target_lang_word": "het restafval",
                                "target_lang_sense_clarification": "overblijfselen van een proces of activiteit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56fe14fb-be06-364c-a8f5-0116bb4ab318",
                    "sense_definition": "Present participle and gerund of <w>discard</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discarding_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>discarding</w> his old clothes to make room for new ones.",
                            "target_lang_translations": {
                                "nl": "Hij is zijn oude kleren aan het <w>wegdoen</w> om ruimte te maken voor nieuwe."
                            }
                        },
                        {
                            "text": "By <w>discarding</w> the unnecessary parts, the machine became much more efficient.",
                            "target_lang_translations": {
                                "nl": "Door de onnodige onderdelen <w>weg te gooien</w>, werd de machine veel efficiënter."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb discard."
                        }
                    ],
                    "target_lang_definitions": {
