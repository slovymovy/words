                                                "example_id": "4d1fd204-0e4b-481f-a5ce-c5aede46af52",
                                                "sense_id": "33b88087-8312-3028-acee-d7a6a8bdbbed",
                                                "text": "They use perfume freely, paint their eyes with kohl, and are constantly polishing their teeth with twigs of green arak-wood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6498109-eec1-49bc-816c-e4079758ed73",
                        "source_entry_id": "52206904-e633-3064-a5f8-823fd1269190",
                        "source_sense_id": "17054e56-5eeb-331f-a0a5-6e61d38ec445",
                        "target_lang_word": "arack",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arack",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29f41eae-8a97-349e-a8b0-b9b30bc98d4f",
                                        "entry_id": "7d15e935-59d1-3c08-8b03-ff5e28298bf3",
                                        "glosses": [
                                            "Eau-de-vie préparée au Proche-Orient (Liban) avec du jus de raisin fermenté aromatisé avec des graines d’anis puis vieillie dans des jarres en argile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b60b567-eb5b-352f-b3c3-e787f94bc704",
                                        "entry_id": "7d15e935-59d1-3c08-8b03-ff5e28298bf3",
                                        "glosses": [
                                            "Liqueur spiritueuse qu’on tire du riz fermenté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ae6ea66-c9df-47bb-bdfa-02d3bd0f3b18",
                                                "sense_id": "4b60b567-eb5b-352f-b3c3-e787f94bc704",
                                                "text": "Les travailleurs pauvres, essentiellement des hommes qui travaillent à la journée, notamment dans l'agriculture, achètent régulièrement de l'arack, boisson commune en Asie du Sud et du Sud-Est, dans des sachets en plastique pour 60 roupies (0,70 euro), et le boivent avant d'aller travailler pour se donner du courage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aef8ef2d-09d0-3711-943c-84097155cae9",
                                        "entry_id": "7d15e935-59d1-3c08-8b03-ff5e28298bf3",
                                        "glosses": [
                                            "Liqueur qu’on tire de la canne à sucre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "171eeb33-4e15-490b-9742-5f1d0cb98470",
                                                "sense_id": "aef8ef2d-09d0-3711-943c-84097155cae9",
                                                "text": "Il faut les avoir vus en présence de l’arack pour comprendre l’affreuse action que l’eau de feu a eue sur les peuplades sauvages ."
                                            },
                                            {
                                                "example_id": "be2829f9-9af7-4dc1-9b1d-cb884d132651",
                                                "sense_id": "aef8ef2d-09d0-3711-943c-84097155cae9",
                                                "text": "Ils ne m’aiment pas. Ils ne m’ont jamais aimée. Au mieux, ils m’ignorent. Au pire, ils me molestent quand ils ont un peu trop bu l’arack."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
