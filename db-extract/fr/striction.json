                "senses": [
                    {
                        "sense_id": "9ad264c7-3266-3705-8ffb-e35590c13c53",
                        "entry_id": "bfd08a96-928a-366e-b88f-3eb5960a8b41",
                        "glosses": [
                            "Resserrement d’un conduit, d’un organe creux, sous une forte pression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49a62eaa-e230-421e-912e-6e46b2f7c339",
                                "sense_id": "9ad264c7-3266-3705-8ffb-e35590c13c53",
                                "text": "Les traces de striction étaient évidentes aux poignets, et on en trouva bientôt d’identiques aux chevilles."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bd50801-fb38-3519-aec3-608f9f2980dc",
                        "entry_id": "bfd08a96-928a-366e-b88f-3eb5960a8b41",
                        "glosses": [
                            "Resserrement, réduction locale du diamètre d’une section sous une forte traction."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "1e84371d-d87c-4102-a164-278110e15f4f",
                                "sense_id": "8bd50801-fb38-3519-aec3-608f9f2980dc",
                                "text": "La striction des éléments tirants subissant une surtraction."
                            },
                            {
                                "example_id": "c2dbc479-ac86-4100-9a63-928140ecae09",
                                "sense_id": "8bd50801-fb38-3519-aec3-608f9f2980dc",
                                "text": "Le confinement inertiel par striction magnétique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "faf86024-cb8a-468c-b1b4-1019044a609f",
                        "source_entry_id": "bfd08a96-928a-366e-b88f-3eb5960a8b41",
