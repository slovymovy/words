                "senses": [
                    {
                        "sense_id": "64b16e41-eb84-3980-925d-e7c70b12d110",
                        "entry_id": "900dda4e-160d-3b52-b2ff-6d78cc567917",
                        "glosses": [
                            "großer, wild lebender Vertreter der Katzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b421e79b-ef49-4b2d-a571-08aebfefe8e8",
                                "sense_id": "64b16e41-eb84-3980-925d-e7c70b12d110",
                                "text": "Der Luchs war in Deutschland ausgestorben. Mittlerweile erobert sich die Raubkatze ihr altes Terrain aber zurück."
                            },
                            {
                                "example_id": "de50ee97-f67c-40b1-a218-32c4019fba1f",
                                "sense_id": "64b16e41-eb84-3980-925d-e7c70b12d110",
                                "text": "„Ein Rudel von zehn Raubkatzen beschlich einige abseits der Herde äsende Zebras.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
