                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9ace8fb-b20e-4ed9-8953-7e427dcd6967",
                                "sense_id": "1958cc16-1f50-376f-94b4-8475acb59bf2",
                                "text": "„Bei der Einführung kann es hilfreich sein, vom 1., 2., 3., 4. Fall oder vom Wer-, Wes-, Wem- und Wen-Fall zu sprechen.“"
                            },
                            {
                                "example_id": "b3431d7f-90be-44b2-bdee-3491f9699c65",
                                "sense_id": "1958cc16-1f50-376f-94b4-8475acb59bf2",
                                "text": "„Man bezeichnet sie nach der Art, wie sie erfragt werden können, der Reihe nach als Wer-, Wessen-, Wem- und Wen-Fall […]“"
                            }
                        ],
