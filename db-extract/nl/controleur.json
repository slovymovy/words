                    {
                        "translation_id": "1e3cea74-a184-4404-a256-b800d2ede93f",
                        "source_entry_id": "ec3876ce-f437-3be6-8bf7-03779405d05f",
                        "source_sense_id": "29e2b216-8c0d-3fb9-aac5-4a35c0105bc5",
