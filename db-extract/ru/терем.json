                    }
                ],
                "senses": [
                    {
                        "sense_id": "68c31202-47a7-3d69-a9f7-e35e8bd934c9",
                        "entry_id": "75636b3c-1939-3aea-8e8d-c05c7da67d74",
                        "glosses": [
                            "в древней Руси — жилое помещение в верхней части здания или отдельный дом в виде башни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b43d029-6cb7-4504-8e8b-21383bee3c4f",
                                "sense_id": "68c31202-47a7-3d69-a9f7-e35e8bd934c9",
                                "text": "Черноокая далеко в пышном тереме своем."
                            },
                            {
                                "example_id": "d0e99706-023c-42ff-9224-7eab9d79ab95",
                                "sense_id": "68c31202-47a7-3d69-a9f7-e35e8bd934c9",
                                "text": "В тереме высоком вмиг растворится окно."
                            },
                            {
                                "example_id": "b082bdfb-12af-49e9-91fa-885efbeb6639",
                                "sense_id": "68c31202-47a7-3d69-a9f7-e35e8bd934c9",
                                "text": "Тебя я повезу в мой светлый терем, в тайную светлицу"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1256c49-0a3d-4130-b60b-e128a8703a05",
                        "source_entry_id": "75636b3c-1939-3aea-8e8d-c05c7da67d74",
                        "source_sense_id": "68c31202-47a7-3d69-a9f7-e35e8bd934c9",
                        "target_lang_word": "tower-",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4eb384f6-6ed2-4e48-b6ff-da865aef6fd5",
                        "source_entry_id": "75636b3c-1939-3aea-8e8d-c05c7da67d74",
                        "source_sense_id": "68c31202-47a7-3d69-a9f7-e35e8bd934c9",
                        "target_lang_word": "térem",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "488045d8-bef6-4aa7-be53-40d4b65fb72a",
                        "source_entry_id": "75636b3c-1939-3aea-8e8d-c05c7da67d74",
                        "source_sense_id": "68c31202-47a7-3d69-a9f7-e35e8bd934c9",
                        "target_lang_word": "Kemenate",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kemenate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9385774d-48ee-39d2-bf67-6b433090b235",
                                        "entry_id": "42662c27-3dd9-3dc9-99bc-1a1c3ebba152",
                                        "glosses": [
                                            "ein Kaminzimmer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80334dd6-6fc9-4ff2-954f-b4e8f4b0c415",
                                                "sense_id": "9385774d-48ee-39d2-bf67-6b433090b235",
                                                "text": "Sie trug die soeben gespaltenen Holzscheite in die Kemenate und legte sie neben den Kamin."
                                            },
                                            {
                                                "example_id": "f68617ba-d180-4aa0-8b8c-fefad0976883",
                                                "sense_id": "9385774d-48ee-39d2-bf67-6b433090b235",
                                                "text": "„Dort sitzt in ihrer Kemenate eine blauäugige Frau mit goldschimmernder Gesichtsfarbe und stickt in eine Borte die uralte Saga von Sigurd aus dem Geschlecht der Völsungen, der den Drachen Fafnir bezwang und das Gold eroberte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d6d7b25-156b-38f1-bb5e-92d9a790fda3",
                                        "entry_id": "42662c27-3dd9-3dc9-99bc-1a1c3ebba152",
                                        "glosses": [
                                            "ein kleiner, gemütlicher Raum"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bdb8264-25c2-4afd-a6e9-7fe52b0cbd61",
                                                "sense_id": "8d6d7b25-156b-38f1-bb5e-92d9a790fda3",
                                                "text": "„Ich sitz mit der Renate in meiner Kemenate bei einer Flasche Sekt, weil zu zweit sie besser schmeckt.“"
                                            },
                                            {
                                                "example_id": "69f324ff-4396-4336-a519-a5cd8367a89c",
                                                "sense_id": "8d6d7b25-156b-38f1-bb5e-92d9a790fda3",
                                                "text": "„Ich wanderte zurück in meine Kemenate und wartete ebenfalls.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c711147f-119c-3e58-91c4-63ba9526808d",
                                        "entry_id": "42662c27-3dd9-3dc9-99bc-1a1c3ebba152",
                                        "glosses": [
                                            "ein massiver, heizbarer Steinbau einer Burg"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba805c4d-e9e6-4d07-9ce8-1e1d4d11d1c7",
                                                "sense_id": "c711147f-119c-3e58-91c4-63ba9526808d",
                                                "text": "Die Kemenate war der einzige beheizte Bereich in der gesamten Burg."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9de3793-660a-41bd-9b2c-2ca42229662b",
                        "source_entry_id": "75636b3c-1939-3aea-8e8d-c05c7da67d74",
                        "source_sense_id": "68c31202-47a7-3d69-a9f7-e35e8bd934c9",
                        "target_lang_word": "terem",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terem",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2397419-9e21-303f-8a37-65a10b874d56",
                                        "entry_id": "a2e1d780-c509-3344-b497-52eba81d2ced",
                                        "glosses": [
                                            "Harem russe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59ff06a-11ea-459a-93f9-3d48e1f0ee77",
                                                "sense_id": "a2397419-9e21-303f-8a37-65a10b874d56",
                                                "text": "Dans la Russie moscovite, le harem s’appelle le terem, à l’étage supérieur de la maison, et le voile s’appelle la fata. Mais les grilles, les voiles, les lois, les mœurs, les préjugés n’ont pu, ni dans la Rome républicaine ou impériale, ni dans la Grèce de Périclès et des successeurs d’Alexandre, ni dans la Moscou des tsars, ni dans quelque pays d’Orient que ce puisse être, retirer toute action à la femme."
                                            },
                                            {
                                                "example_id": "37f66ced-39be-4e4f-b553-76040d463cd9",
                                                "sense_id": "a2397419-9e21-303f-8a37-65a10b874d56",
                                                "text": "Jusqu’à Pierre le Grand, les femmes étaient condamnées à la réclusion du terem."
                                            },
                                            {
                                                "example_id": "058f2ca1-4165-4eca-945a-cf8fdb7234f5",
                                                "sense_id": "a2397419-9e21-303f-8a37-65a10b874d56",
                                                "text": "Enfermées dans le terem, gynécée tatar ou byzantin, les tsarines et les tsarevnas laissaient les tsars à la grossièreté de leur sexe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cc8c793-6db0-3b78-86b8-c0c6ec56e07f",
                                        "entry_id": "a2e1d780-c509-3344-b497-52eba81d2ced",
                                        "glosses": [
                                            "Tour ; donjon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
