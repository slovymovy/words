                ],
                "senses": [
                    {
                        "sense_id": "0cd18208-af0a-3f7a-9c5d-1cd88a8b4b39",
                        "entry_id": "9a571bd6-7a2a-3ad9-b36d-c4806128f0ab",
                        "glosses": [
                            "Abbau, Verarbeitung der Energiereserve Fett im Körper (Organismus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990de6e4-6a76-4940-914a-1222bfa117d5",
                                "sense_id": "0cd18208-af0a-3f7a-9c5d-1cd88a8b4b39",
                                "text": "„Auf jeden Fall müssen die Personen gut ausdauertrainiert sein, um bei diesen Intensitäten die höchste Fettoxidation zu erreichen.“"
                            },
                            {
                                "example_id": "547baa11-777c-4c7d-9be9-565d8a40e66d",
                                "sense_id": "0cd18208-af0a-3f7a-9c5d-1cd88a8b4b39",
                                "text": "„Da bei niedrigen Belastungsintensitäten der Gesamtenergiebedarf insgesamt jedoch niedrig ist, fällt die absolute Fettoxidation hierbei betragsmäßig ebenfalls geringer aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bdea7e78-f51c-3422-9eaa-d302237417a9",
                        "entry_id": "9a571bd6-7a2a-3ad9-b36d-c4806128f0ab",
                        "glosses": [
                            "das Oxidieren von Fettstoffen durch den Sauerstoff der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "759f1829-5786-453b-a52f-3f383a8afd02",
                                "sense_id": "bdea7e78-f51c-3422-9eaa-d302237417a9",
                                "text": "Die Fettoxidation in der Nase, in Verbindung mit dem Einatmen von aktivem Sauerstoff (Ionen) der Luft, führt zu unterschiedlichen Geruchswahrnehmungen und einer Irritation der Riechschleimhaut."
                            },
                            {
                                "example_id": "e677e492-fbd0-4a8b-99b3-c61254af35a6",
                                "sense_id": "bdea7e78-f51c-3422-9eaa-d302237417a9",
                                "text": "„Die Fettoxidation führt bei höheren Temperaturen zu Peroxiden, Epoxiden und Polymerisationsprodukten der ungesättigten Fettsäuren.“"
                            },
                            {
                                "example_id": "c91e329e-b011-4161-bb8a-86bcb10da3ee",
                                "sense_id": "bdea7e78-f51c-3422-9eaa-d302237417a9",
                                "text": "„Je höher die Temperaturen steigen, desto anfälliger werden die Doppelbindungen gegenüber dem Sauerstoff der Luft, aber der Prozeß der Fettoxidation findet auch schon bei Kühlschranktemperaturen statt, wenn auch in sehr verlangsamtem Tempo.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
