                "senses": [
                    {
                        "sense_id": "eba1b0f5-99e8-3b36-b24e-a7b2f386fca4",
                        "entry_id": "ab8683b2-2b34-3ebf-8a1f-ba2eda6ec7b7",
                        "glosses": [
                            "A form of color blindness in which the retina is deficient in or lacks cone cells containing opsins that respond to the color green, resulting in an inability to distinguish red from green."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3444a216-bb03-4830-b344-e1c3043d506f",
                                "sense_id": "eba1b0f5-99e8-3b36-b24e-a7b2f386fca4",
                                "text": "Deuteranomalous subjects show ordering behaviour similar to the behaviour of normal colour vision subjects, but less like their colleagues with deuteranopia."
                            },
                            {
                                "example_id": "7b2a3867-71b9-4335-a078-aa92f12c2939",
                                "sense_id": "eba1b0f5-99e8-3b36-b24e-a7b2f386fca4",
                                "text": "A human with color blindness in the form of deuteranopia is missing the M cones and has only S and L cones present, resulting in a neutral point where the spectral absorption curves of the remaining pigments cross."
                            },
                            {
                                "example_id": "76862f9f-e432-435c-b96a-86918a3b361a",
                                "sense_id": "eba1b0f5-99e8-3b36-b24e-a7b2f386fca4",
                                "text": "Dichromacy is a moderately severe color vision defect. It is hereditary and, in the case of protanopia or deuteranopia, sex-linked, affecting predominantly males."
                            }
                        ]
                    }
                ],
