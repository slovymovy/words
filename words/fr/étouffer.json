    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e3bc186-e7bb-3ad1-9856-623908d8017a",
                    "sense_definition": "Éprouver une grande difficulté à respirer en raison d'un manque d'air ou d'une chaleur excessive.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ouvre la fenêtre s'il te plaît, car on <w>étouffe</w> dans cette pièce fermée."
                        },
                        {
                            "text": "Pendant cette comédie amusante, les spectateurs ont failli <w>étouffer</w> de rire."
                        }
                    ],
                    "synonyms": [
                        "suffoquer"
                    ],
                    "antonyms": [
                        "respirer"
                    ],
                    "common_phrases": [
                        "étouffer de rire",
                        "étouffer de chaud"
                    ]
                },
                {
                    "sense_id": "50033ed1-ee9c-3123-9437-4f51e1f45baa",
                    "sense_definition": "Faire mourir ou priver d'air quelqu'un en empêchant sa respiration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fumée noire a failli <w>étouffer</w> les habitants bloqués au deuxième étage."
                        },
                        {
                            "text": "Le criminel a tenté d'<w>étouffer</w> sa victime avant de prendre la fuite."
                        }
                    ],
                    "synonyms": [
                        "asphyxier"
                    ],
                    "antonyms": [
                        "ranimer"
                    ]
                },
                {
                    "sense_id": "b78214b0-02ac-3bf4-9ade-c418f3b05bcb",
                    "sense_definition": "Éteindre un feu ou une flamme en interceptant l'air.",
