                                        "entry_id": "237f3a64-483a-3d54-b2e0-ab0fa4ed52f0",
                                        "glosses": [
                                            "The production of flowers which do not open and are self-fertilized in the bud."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "119c56aa-df5f-4883-9cde-518f9fc43d22",
                                                "sense_id": "fd34e268-ad27-372d-a164-62c87c2f008d",
                                                "text": "In a species that produces fruits from self-pollination and from cross-pollination, self-pollinated fruits generally produce many more seeds than fruits produced from cross-pollination. This suggests the likelihood that cleistogamy arose in those species because cross-pollination was not always effective."
                                            }
                                        ]
                                    }
