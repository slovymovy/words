                    },
                    {
                        "translation_id": "f372c926-f968-4c1a-b9d6-711504a6fc78",
                        "source_entry_id": "642598ee-af20-36d1-9c65-83a721f37109",
                        "source_sense_description": "critical revision of a text",
                        "target_lang_word": "recension",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recension",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a856b72-da1e-368c-8960-98d2ff756ebe",
                                        "entry_id": "62488190-24b5-3e15-a21a-e5a3dc292f5a",
                                        "glosses": [
                                            "Comparaison d’une édition d’un auteur ancien avec les manuscrits."
                                        ],
                                        "tags": [
                                            "Philologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caf56205-b37e-4187-aa77-f74d72cc4dba",
                                                "sense_id": "8a856b72-da1e-368c-8960-98d2ff756ebe",
                                                "text": "Le texte de cet écrivain grec a été établi d’après les plus savantes recensions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e64fe0e1-a88b-3cd0-a43e-2ee264f27d45",
                                        "entry_id": "62488190-24b5-3e15-a21a-e5a3dc292f5a",
                                        "glosses": [
                                            "Texte revu et édité par un critique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b3c88bd-0ef3-4483-b400-d32710946098",
                                                "sense_id": "e64fe0e1-a88b-3cd0-a43e-2ee264f27d45",
                                                "text": "La recension d’Homère par Aristarque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c844290-857d-3bd8-a816-be38b8ccb30c",
                                        "entry_id": "62488190-24b5-3e15-a21a-e5a3dc292f5a",
                                        "glosses": [
                                            "Compte rendu critique d’une œuvre, d’un ouvrage dans une revue, un journal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8420ccef-e6d3-46ff-b5e3-c4710412ea0a",
                                                "sense_id": "5c844290-857d-3bd8-a816-be38b8ccb30c",
                                                "text": "Il avait attiré mon attention sur Rose poussière, le premier livre de Jean-Jacques Schuhl, auquel je consacrai une recension dans Le Nouvel Obs et j’ai conservé une relation amicale avec l’auteur de ce petit chef-d’œuvre."
                                            },
                                            {
                                                "example_id": "80302314-70d6-4fd6-8219-7832387d9a7c",
                                                "sense_id": "5c844290-857d-3bd8-a816-be38b8ccb30c",
                                                "text": "Ce bon vieux Tom, avec ses cheveux crépus et sa panse protubérante, se dit Baumgartner, ce moulin à paroles, leur ami de l’époque de la New School, de la fin des années 1970 au début des années 1980, un peu plus jeune qu’eux et plus ou moins amoureux d’Anna, dragueur impénitent mais inoffensif et à la conversation vive et stimulante, un spécialiste de poésie américaine contemporaine, des renégats et des outsiders de la troupe Black Mountain, l’école de New York et tout le reste, parti pour Ann Arbor à peu près au moment où Baumgartner et Anna arrivèrent à Princeton et auteur de la recension la plus enthousiaste, la plus longue et la plus fouillée du livre d’Anna"
                                            },
                                            {
                                                "example_id": "6718ba75-2dce-4fde-b397-49216faa8e38",
                                                "sense_id": "5c844290-857d-3bd8-a816-be38b8ccb30c",
                                                "text": "Voici donc, sous forme de bloc-notes, la recension de ce périple sur des terres autrefois chrétiennes et dont ne subsistent plus guère que de vieilles pierres…"
                                            },
                                            {
                                                "example_id": "def31892-9dc0-4ff2-b9ab-0693a67fb9c3",
                                                "sense_id": "5c844290-857d-3bd8-a816-be38b8ccb30c",
                                                "text": "Tantôt à la page économique, tantôt à la page politique ou culturelle des grands journaux de tous les pays, on trouvait son nom, la recension d’un ouvrage de sa main, le commentaire d’un discours remarquable qu’il avait prononcé ici ou là, l’annonce de sa réception par quelque souverain ou quelque association artistique, et il n’y eut bientôt plus personne, dans le cercle de ces grands industriels accoutumés à agir en silence et derrière des portes fermées à double tour, qui fit parler de lui au-dehors davantage que le Dr Arnheim."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17213af0-6274-458d-b3f5-1bd570e2bb7a",
                        "source_entry_id": "642598ee-af20-36d1-9c65-83a721f37109",
                        "source_sense_description": "critical revision of a text",
                        "target_lang_word": "Rezension",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rezension",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b1caf34-c191-320d-a1d8-6ac84d7979ec",
                                        "entry_id": "7db14c9e-8ea0-3ae8-9ff2-bb3d8fe3bffe",
                                        "glosses": [
                                            "kritische Besprechung eines Werkes (eines Buches, einer künstlerischen Darbietung oder einer wissenschaftlichen Arbeit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7149730f-4566-43b5-aad3-3aab59e02497",
                                                "sense_id": "8b1caf34-c191-320d-a1d8-6ac84d7979ec",
                                                "text": "Die Rezension zu dem neuen Grass hat mir nicht zugesagt."
                                            },
                                            {
                                                "example_id": "0861eb04-932b-4a86-a08b-e3d12e8253d7",
                                                "sense_id": "8b1caf34-c191-320d-a1d8-6ac84d7979ec",
                                                "text": "„Am Anfang, als Assistent und Privatdozent, hatte er auf jeden Sonderdruck mit einem Brief reagiert, der oft die Länge einer Rezension hatte.“"
                                            },
                                            {
                                                "example_id": "32ff5571-137c-48a4-aa1b-fb7cd69b7b63",
                                                "sense_id": "8b1caf34-c191-320d-a1d8-6ac84d7979ec",
                                                "text": "„Im Literaturteil einer großen österreichischen Tageszeitung darf ich eine Rezension schreiben, und in Absprache mit dem Redakteur halte ich diese sehr persönlich.“"
                                            },
                                            {
                                                "example_id": "6c4e306c-cadd-4fba-a807-ccc8623480e6",
                                                "sense_id": "8b1caf34-c191-320d-a1d8-6ac84d7979ec",
                                                "text": "„In den Rezensionen versuchten Polen, Deutsche und Schlesier »Choloneks« Thematik für ihre Zwecke einzuspannen.“"
                                            },
                                            {
                                                "example_id": "e5ee37bb-7550-41a8-8d00-6188a5395cf5",
                                                "sense_id": "8b1caf34-c191-320d-a1d8-6ac84d7979ec",
                                                "text": "„Mit dieser einen Rezension vernichtete er das Buch, zog er der Behaviorismus-Theorie den Boden unter den Füßen weg (sie sollte nie wieder auf die Beine kommen) und machte aus B. F. Skinner Geschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
