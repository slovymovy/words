                ],
                "senses": [
                    {
                        "sense_id": "4f511578-01fc-37a9-8501-9521e76e04fb",
                        "entry_id": "9f24e22b-afa9-3327-a078-31b5c4a44e9b",
                        "glosses": [
                            "Antarctic (of Antarctica)"
                        ],
                        "tags": [
                            "not-comparable",
                            "rare",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "3ea01917-682f-4402-930e-a4c22b594ddb",
                                "sense_id": "4f511578-01fc-37a9-8501-9521e76e04fb",
                                "text": "Inne lądolody współczesne natomiast, np. grenlandzki lub antarktydzki, albo kończą się w morzu, albo wysyłają dolinami fjordów do morza, zatrzymawszy się na nadbrzeżnych łańcuchach górskich, języki lodowe, które dlatego wykazują reżym górski",
                                "translation": "Other modern ice sheets, meanwhile, for example the Greenlandic or the Antarctic, either end up in the sea or send ice tongues through fjord valleys to the sea, having stopped on the coastal mountain ranges, that then demonstrate a mountain regime.",
                                "english": "Other modern ice sheets, meanwhile, for example the Greenlandic or the Antarctic, either end up in the sea or send ice tongues through fjord valleys to the sea, having stopped on the coastal mountain ranges, that then demonstrate a mountain regime."
                            },
                            {
                                "example_id": "31a84631-116e-481a-97ef-2b83f7a42294",
                                "sense_id": "4f511578-01fc-37a9-8501-9521e76e04fb",
                                "text": "Pojawią się nowe ruchy społeczne, domagające się na północnej półkuli wyprostowania osi ziemskiej, na południowej zaś ułożenia owej osi tak, ażeby antarktydzki lądolód spłynął wreszcie do oceanu światowego , dzięki czemu my tutaj wszyscy zgniniemy [...]",
                                "translation": "New social movements will appear, demanding that the axial tilt be straightened out on the southern hemisphere, but that the norther one be set so that the aAntarctic ice sheet can finally drift to the world's ocean, causing us all to die …",
                                "english": "New social movements will appear, demanding that the axial tilt be straightened out on the southern hemisphere, but that the norther one be set so that the aAntarctic ice sheet can finally drift to the world's ocean, causing us all to die …"
                            },
                            {
                                "example_id": "514686da-863b-49fd-842a-cec3a7b19102",
                                "sense_id": "4f511578-01fc-37a9-8501-9521e76e04fb",
                                "text": "[...] gdzie osobno wymieniono Svalbard i osobno wyspę Jan Mayen (oraz antarktydzką Wyspę Bouveta i Wyspę Piotra I).",
                                "translation": "… where Svalbard, Jan Mayen Island (as well as the Antarctic island Bouvet and Island Peter the 1) where listed out separately.",
                                "english": "… where Svalbard, Jan Mayen Island (as well as the Antarctic island Bouvet and Island Peter the 1) where listed out separately."
                            }
                        ]
                    }
                ],
