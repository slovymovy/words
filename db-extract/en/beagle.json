                                    {
                                        "sense_id": "ad9023b2-a01d-3629-a407-7909b025586f",
                                        "entry_id": "50a2207a-4b90-3be0-83b9-ea5a6576a45a",
                                        "glosses": [
                                            "kleine hond van een bepaald ras"
                                        ],
                                        "tags": [],
