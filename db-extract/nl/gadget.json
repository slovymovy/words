                "senses": [
                    {
                        "sense_id": "e5e9a846-76b2-3167-abf6-81d78bf332cd",
                        "entry_id": "6fd37eff-8555-3ca7-ad89-e7a53c95d22b",
                        "glosses": [
                            "klein apparaat, gereedschap of ander voorwerp voor een specifieke vaak nutteloze taak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6364c02f-f0ea-48d9-bdba-0d4d9d883c26",
                                "sense_id": "e5e9a846-76b2-3167-abf6-81d78bf332cd",
                                "text": "Het cadeau dat ik kreeg was niet meer dan een gadget."
                            },
                            {
                                "example_id": "6d2dfabd-9c25-4ccf-8d36-771062aa7853",
                                "sense_id": "e5e9a846-76b2-3167-abf6-81d78bf332cd",
                                "text": "Besparen is namelijk haar tweede natuur en ze ging direct plannen maken om te kijken waar we nog meer op zouden kunnen besparen. Misschien zouden we thuis wel gaan douchen in het donker en de wc met badwater doorspoelen. Niet meer zo vaak uit eten, geen gadgets kopen, minder autorijden."
                            },
                            {
                                "example_id": "a611a054-f4c9-4fef-8f0c-054d0d15f93c",
                                "sense_id": "e5e9a846-76b2-3167-abf6-81d78bf332cd",
                                "text": "De ambities van China zijn torenhoog. Dat is goed te merken tijdens een van de grootste autobeurzen in het land. Automerken proberen daar met de nieuwste gadgets consumenten te overtuigen voor hun auto te kiezen. Tom van Dillen van Greenkern, consultant in de auto-industrie, is op de autobeurs in Shanghai. Hij merkt vooral topdrukte wanneer de Chinese automerken nieuwe auto's presenteren."
                            }
                        ]
                    }
