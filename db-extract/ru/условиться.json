                        "glosses": [
                            "to arrange (with, with + to), to agree (with on, with + to ), to settle (with, with + to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e04092c-f1da-45bd-a581-df687e5967e6",
                                "sense_id": "f1d793de-94e9-3f8a-b117-917264ec07d4",
                                "text": "усло́виться встре́титься",
                                "translation": "to arrange to meet",
                                "english": "to arrange to meet"
                            },
                            {
                                "example_id": "4801632b-c182-41a7-beda-b80df74646f3",
                                "sense_id": "f1d793de-94e9-3f8a-b117-917264ec07d4",
                                "text": "усло́виться о встре́че",
                                "translation": "to arrange a meeting",
                                "english": "to arrange a meeting"
                            },
                            {
                                "example_id": "1bafbb07-4859-47f7-a0e9-aecd4b9c3bd5",
                                "sense_id": "f1d793de-94e9-3f8a-b117-917264ec07d4",
                                "text": "они́ усло́вились бо́льше об э́том не говори́ть",
                                "translation": "they agreed not to speak about it any more",
                                "english": "they agreed not to speak about it any more"
                            },
                            {
                                "example_id": "8d0f5654-5fa8-4bec-94f7-d9afda76d718",
                                "sense_id": "f1d793de-94e9-3f8a-b117-917264ec07d4",
                                "text": "усло́виться о дне",
                                "translation": "to settle the day; fix the date; agree on the day",
                                "english": "to settle the day; fix the date; agree on the day"
                            },
                            {
                                "example_id": "0a8cfb88-b07d-48d6-ab30-0f7f78dfaf98",
                                "sense_id": "f1d793de-94e9-3f8a-b117-917264ec07d4",
                                "text": "ну́жно оконча́тельно усло́виться",
                                "translation": "we must get it settled (once and for all)",
                                "english": "we must get it settled (once and for all)"
                            }
                        ]
                    }
