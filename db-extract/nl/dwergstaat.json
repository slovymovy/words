                "senses": [
                    {
                        "sense_id": "2c2ff036-83c7-337d-aaa1-b33426c667de",
                        "entry_id": "9d45a654-7014-39d7-92d5-83446bdf983f",
                        "glosses": [
                            "zeer kleine staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14e4c6c8-0bc3-4f1a-a624-d83dbe894c2f",
                                "sense_id": "2c2ff036-83c7-337d-aaa1-b33426c667de",
                                "text": "LGT is in handen van de prinselijke familie van Liechtenstein. Vorst Hans Adam II bestuurt samen met het parlement de dwergstaat. LGT is de grootste bank- en vermogensbeheerder ter wereld die eigendom is van een familie."
                            },
                            {
                                "example_id": "5c4b861f-1f0e-4a6c-856e-a40612010583",
                                "sense_id": "2c2ff036-83c7-337d-aaa1-b33426c667de",
                                "text": "Momenteel de enige betrouwbare bondgenoot - maar het is, voor wie verder blikt, volstrekt duidelijk dat Amerika - net als Europa - voor zijn geostrategische belangen in de rol op den duur niet aangewezen kan blijven op de grillen van een onbeduidende dwergstaat met een paar miljoen inwoners, die niet zonder reden door al zijn buren wordt gehaat. Daar doet het feit dat ook soennieten en sjiieten elkaar met niet minder overtuiging de hersens inslaan, en Saoedi-Arabië, Egypte, Turkije en Iran elkaar als de grote concurrenten zien, weinig aan af."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e05c2b0f-eca4-4553-953d-abafa7cc7333",
                        "source_entry_id": "9d45a654-7014-39d7-92d5-83446bdf983f",
                        "source_sense_id": "2c2ff036-83c7-337d-aaa1-b33426c667de",
