                "translations": [
                    {
                        "translation_id": "304c7422-baae-48d3-8a05-64ccd58e450f",
                        "source_entry_id": "389dc362-570b-3731-ba1e-7608b351c97f",
                        "source_sense_id": "786daea7-237b-3d13-8223-4d3703a96605",
                        "source_sense_description": "der Unterhalt",
                        "target_lang_word": "Unterhalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterhalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f443f990-3171-34b7-a6cd-6c72b4d71463",
                                        "entry_id": "09451905-531a-388e-aa53-96e951982e07",
                                        "glosses": [
                                            "materielle Absicherung für Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "782b6eba-0095-45dc-9b10-661fdd96e53a",
                                                "sense_id": "f443f990-3171-34b7-a6cd-6c72b4d71463",
                                                "text": "Meine Schwester bekommt Unterhalt für ihr Kind."
                                            },
                                            {
                                                "example_id": "29f10a7e-813a-4482-a053-d6aaa83a975a",
                                                "sense_id": "f443f990-3171-34b7-a6cd-6c72b4d71463",
                                                "text": "„Es sei wünschenswert, dass in den Familien mehr als seit Kriegsbeginn weibliche Hilfskräfte zum Nähen, Waschen, Kochen, Bedienen und so weiter angestellt würden, damit die beschäftigungslosen Frauen und Mädchen Ihren Unterhalt selbst verdienen könnten.“"
                                            },
                                            {
                                                "example_id": "cbab33a7-7d05-48fe-b503-31d3fb975dbb",
                                                "sense_id": "f443f990-3171-34b7-a6cd-6c72b4d71463",
                                                "text": "„Die Gemeindemitglieder haben nicht nur zu gehorchen, sondern auch für den Unterhalt derjenigen zu sorgen, denen sie Gehorsam schulden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae237ded-aacc-3455-9cd4-28a6ef18963a",
                                        "entry_id": "09451905-531a-388e-aa53-96e951982e07",
                                        "glosses": [
                                            "Instandhaltung eines Objekts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11fc588e-4c37-4c88-ac69-5309284d14cc",
                                                "sense_id": "ae237ded-aacc-3455-9cd4-28a6ef18963a",
                                                "text": "Der Unterhalt des Schlosses überforderte die Familie mehr und mehr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8b7bb01-5a97-42bd-8a72-b165785ce692",
                        "source_entry_id": "389dc362-570b-3731-ba1e-7608b351c97f",
                        "source_sense_id": "5cd6780b-b0f9-3f4d-84f7-bded50f99ac7",
                        "source_sense_description": "die Ernährung, die Verpflegung",
                        "target_lang_word": "Ernährung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ernährung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                        "entry_id": "828f1cd3-6948-3041-bd76-433260e6bc85",
                                        "glosses": [
                                            "die Zufuhr von Nahrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16eb78c6-002e-41f9-ae02-dd30b75772e2",
                                                "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                                "text": "Bei der Ernährung der Babys ist die Unterstützung der Mütter notwendig."
                                            },
                                            {
                                                "example_id": "20c000a9-2501-45a4-8d54-50409db9c515",
                                                "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                                "text": "„Die Ernährung von Großvieh war schwierig und teuer, insbesondere in der Trockenzeit im Sommer.“"
                                            },
                                            {
                                                "example_id": "a27c661f-b79c-410b-8ad1-ae4645847a0b",
                                                "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                                "text": "„Das Leben im Ruhestand wird unter dem Gesichtspunkt der Sinnfindung, möglicher neuer Aufgaben, der körperlichen Bewegung, des Reisens, der angemessenen Ernährung beschrieben.“"
                                            },
                                            {
                                                "example_id": "ea40b3d3-0889-4b7b-b9f2-d9b0a10bba0b",
                                                "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                                "text": "„Eine Stunde, bevor das Abendessen serviert wurde, kam eine Ernährungsberaterin und legte mir nahe, in Zukunft meine Ernährung zu ändern und den von mir auf Nachfrage gebeichteten horrenden Süßigkeitenkonsum drastisch einzuschränken.“"
                                            },
                                            {
                                                "example_id": "d409549d-9c80-412a-8421-ae4d579b81b8",
                                                "sense_id": "504494c2-45a6-3ac0-b541-03b4eee4a5b9",
                                                "text": "„Das war schon seit Gründung der Schule so: Niemand schritt ein, als im frühen 20. Jahrhundert fast die Hälfte der Kinder an der Schule starb – vor allem an Tuberkulose, die sich in den vollen Schlafsälen und bei schlechter Ernährung rasch verbreitete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01050b58-0c61-3423-b656-bb68bf3bf91d",
                                        "entry_id": "828f1cd3-6948-3041-bd76-433260e6bc85",
                                        "glosses": [
                                            "die Nahrung selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c64111-0510-42d1-acc4-b5ac69cdacab",
                                                "sense_id": "01050b58-0c61-3423-b656-bb68bf3bf91d",
                                                "text": "Obst ist gut als Ernährung für zwischendurch."
                                            },
                                            {
                                                "example_id": "f3fcf17f-810f-4384-87bb-25cdd30ba0c7",
                                                "sense_id": "01050b58-0c61-3423-b656-bb68bf3bf91d",
                                                "text": "„Rudolph erkundet aber auch, wie Ernährung den Altersprozess beeinflusst.“"
                                            },
                                            {
                                                "example_id": "d7e4d8ac-038e-420f-aca4-9bf3f0440e17",
                                                "sense_id": "01050b58-0c61-3423-b656-bb68bf3bf91d",
                                                "text": "„Kein Wunder, dass ich in meiner Schulklasse der Kleinste war, bei dieser Ernährung konnte man ja nicht wachsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f545f5ef-74fe-3b08-ab7a-8e004bb001cb",
                                        "entry_id": "828f1cd3-6948-3041-bd76-433260e6bc85",
                                        "glosses": [
                                            "der Lebensunterhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f6a16ec-cc26-47c0-91db-6d9deb406f63",
                                                "sense_id": "f545f5ef-74fe-3b08-ab7a-8e004bb001cb",
                                                "text": "Die Ernährung Schwerkranker ist sehr wichtig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "154efb20-65cf-4905-9cb5-93a5a4a058c8",
                        "source_entry_id": "389dc362-570b-3731-ba1e-7608b351c97f",
                        "source_sense_id": "5cd6780b-b0f9-3f4d-84f7-bded50f99ac7",
                        "source_sense_description": "die Ernährung, die Verpflegung",
                        "target_lang_word": "Verpflegung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verpflegung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "462dfee0-6294-3517-96ac-510aac6e033a",
                                        "entry_id": "012f9df1-db97-3354-9db3-dd12348caaac",
                                        "glosses": [
                                            "Vorgang respektive Handlung, jemanden mit Essen und Trinken zu versorgen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a43ea8-9c0f-43b4-b30f-c744222d50e8",
                                                "sense_id": "462dfee0-6294-3517-96ac-510aac6e033a",
                                                "text": "Die Verpflegung der Flutopfer hat nun höchste Priorität."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af47d17a-49b0-3914-9832-ce49db318a71",
                                        "entry_id": "012f9df1-db97-3354-9db3-dd12348caaac",
                                        "glosses": [
                                            "Zusammenstellung von Nahrungsmitteln und Getränken"
                                        ],
                                        "tags": [
                                            "meist im Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d14c990d-d48b-4f70-b6e1-38f558293f82",
                                                "sense_id": "af47d17a-49b0-3914-9832-ce49db318a71",
                                                "text": "Für eine Wanderung sollte man sich Verpflegung mitnehmen."
                                            },
                                            {
                                                "example_id": "0e4ae956-8183-473a-9e39-98c0fdf00df0",
                                                "sense_id": "af47d17a-49b0-3914-9832-ce49db318a71",
                                                "text": "„Unsere Verpflegung war armselig, und viele unserer Leute starben.“"
                                            },
                                            {
                                                "example_id": "bb8ab5b5-c455-49a8-843d-410ce5a0ce22",
                                                "sense_id": "af47d17a-49b0-3914-9832-ce49db318a71",
                                                "text": "„Was die Verpflegung des Heeres angeht, so verfügt Napoleon, die einzelnen Formationen sollen der Reihe nach à la maraude durch Moskau ziehen, um sich Lebensmittelvorräte zu besorgen, damit die Armee für die nächste Zukunft sichergestellt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
