                "senses": [
                    {
                        "sense_id": "a6f81fa2-76cb-3a7f-a10a-c3bc27df1874",
                        "entry_id": "ae601998-101c-309b-a795-42de030f0577",
                        "glosses": [
                            "in isolatie gebracht, geen contact meer hebben met de groep waartoe men behoorde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b6255b-d68e-494d-9b67-bb4bdbcb7023",
                                "sense_id": "a6f81fa2-76cb-3a7f-a10a-c3bc27df1874",
                                "text": "Doordat ik nu opeens zo afgezonderd was, voelde het alsof ik op een andere planeet was beland."
                            },
                            {
                                "example_id": "becc96f7-ed7f-45a4-b65c-3beb570f3d54",
                                "sense_id": "a6f81fa2-76cb-3a7f-a10a-c3bc27df1874",
                                "text": "Terwijl hij de wagen wordt ingeschoven kan hij nog net zien hoe vanaf de andere kant van de straat Salma, die nu Salomé heet en een gevierd kunstenaar is, afgezonderd van de rest, rokend en met een diepe frons zijn kant op staat te kijken."
                            }
                        ]
                    }
                ],
