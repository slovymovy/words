                "forms": [],
                "senses": [
                    {
                        "sense_id": "d796ea2a-c919-3367-969d-201653e6afdb",
                        "entry_id": "cd10fdbe-585d-30c0-9275-b800da951dd9",
                        "glosses": [
                            "(Antéposé : se place avant le nom, sans trait d'union) Qui dépasse la mesure, la norme."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4b91ec1e-f477-4da7-9482-9e40c0c4481c",
                                "sense_id": "d796ea2a-c919-3367-969d-201653e6afdb",
                                "text": "Et on sent que c'est vrai. Et que les reproches de médiocre, de paresseux, de fourbe, sont ultra justifiés."
                            },
                            {
                                "example_id": "6604b4cc-9cea-4ac8-a3b9-1cdd9672dbd5",
                                "sense_id": "d796ea2a-c919-3367-969d-201653e6afdb",
                                "text": "Cette soirée était ultra géniale !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
