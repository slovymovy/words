                "senses": [
                    {
                        "sense_id": "198b2483-d222-3558-849d-fa36d2eb93e5",
                        "entry_id": "15fcf9fc-ded0-3edd-a30c-45e82f256122",
                        "glosses": [
                            "Gruppierung, die sich aus einer anderen größeren Organisation gebildet hat beziehungsweise sich von dieser abgesplittert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b32981-1261-401e-8d53-cb58a7577bda",
                                "sense_id": "198b2483-d222-3558-849d-fa36d2eb93e5",
                                "text": "Aus manchen Terrororganisationen entwickeln sich Splittergruppen."
                            },
                            {
                                "example_id": "738d472b-65a5-4171-be13-32b137d70fca",
                                "sense_id": "198b2483-d222-3558-849d-fa36d2eb93e5",
                                "text": "[Weimarer Republik:] „Während sie [Anm.: die NSDAP] in anderen Teilen Deutschlands noch lange eine unbedeutende Splittergruppe blieb, wurde sie hier [Anm.: in Thüringen] immer größer.“"
                            },
                            {
                                "example_id": "528d7531-3df6-4f7f-8b3b-581bc5136c29",
                                "sense_id": "198b2483-d222-3558-849d-fa36d2eb93e5",
                                "text": "„Der einst so elitäre ANC wird nun innerhalb weniger Jahre zu einer Massenorganisation mit mehr als 100000 Mitgliedern – zu der freilich auch militante Splittergruppen gehören.“"
                            },
                            {
                                "example_id": "1579e512-60c8-42dc-b300-e596627a34c5",
                                "sense_id": "198b2483-d222-3558-849d-fa36d2eb93e5",
                                "text": "„Es gibt dort noch immer aufständische Splittergruppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
