                                        "sense_id": "48ddde56-41df-3ffb-987d-217ad77b648a",
                                        "entry_id": "000a04a7-c02f-3be2-b028-56f35e153c7b",
                                        "glosses": [
                                            "To assist another (a child, etc.) in using a toilet."
