    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87504efd-3b69-3878-8b5b-0c6dec576389",
                    "sense_definition": "Rendre sale ou malpropre en couvrant d'une substance salissante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proprete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les éclaboussures ont <w>souillé</w> ses vêtements neufs pendant les travaux."
                        },
                        {
                            "text": "En marchant dans les marécages, ils ont <w>souillé</w> leurs bottes d'une épaisse couche de terre."
                        }
                    ],
                    "synonyms": [
                        "salir",
                        "tacher"
                    ],
                    "antonyms": [
                        "laver",
                        "nettoyer"
                    ],
                    "common_phrases": [
                        "souiller de boue",
                        "souiller de sang"
                    ]
                },
                {
                    "sense_id": "7ffb52be-155c-3d4d-8580-3dc094c0bee1",
                    "sense_definition": "Porter atteinte à la dignité, à l'honneur ou à la réputation de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces fausses accusations cherchent uniquement à <w>souiller</w> la réputation de notre collègue."
                        },
                        {
                            "text": "Il a refusé de mentir pour ne pas <w>souiller</w> l'honneur de sa propre famille."
                        }
                    ],
                    "synonyms": [
                        "salir"
                    ],
                    "antonyms": [
                        "honorer"
                    ],
                    "common_phrases": [
                        "souiller la mémoire",
                        "souiller la réputation"
                    ]
                },
                {
                    "sense_id": "93753eb4-b6e6-3462-923b-b9769deb5da6",
                    "sense_definition": "Profaner un lieu sacré ou corrompre une pureté morale ou spirituelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sacré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les envahisseurs n'ont pas hésité à <w>souiller</w> le sanctuaire en détruisant les reliques."
                        },
                        {
                            "text": "Dans ce rituel ancien, tout mensonge risquait de <w>souiller</w> la pureté des participants."
                        }
                    ],
                    "antonyms": [
                        "purifier",
                        "sanctifier"
                    ],
                    "common_phrases": [
                        "souiller un sanctuaire"
                    ]
                }
            ]
        }
    ]
