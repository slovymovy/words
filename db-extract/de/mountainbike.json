                "senses": [
                    {
                        "sense_id": "5600fcf7-1253-3dfc-a723-52884fb4ada4",
                        "entry_id": "9e3605ad-cdd8-3a79-ba47-09a130dd7a94",
                        "glosses": [
                            "robustes, geländegängiges Fahrrad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d52b2fe4-a5cf-4643-a602-323a25524a24",
                                "sense_id": "5600fcf7-1253-3dfc-a723-52884fb4ada4",
                                "text": "An sonnigen Tagen fährt er mit seinem Mountainbike durch die Berge."
                            },
                            {
                                "example_id": "d52d9d38-30dd-4621-92cd-2d387ff9d0b9",
                                "sense_id": "5600fcf7-1253-3dfc-a723-52884fb4ada4",
                                "text": "„Ich habe davon gehört, und in den Sommermonaten beobachte ich Paare auf ihren Mountainbikes, schwer bepackt mit Zelten und Nahrung.“"
                            },
                            {
                                "example_id": "5fe6d704-61d7-4c3c-875f-cbdd4a02c736",
                                "sense_id": "5600fcf7-1253-3dfc-a723-52884fb4ada4",
                                "text": "„Nach jungentypischer Indianer-Cowboy-Manier sind sie oft mit ihrem Mountainbike unterwegs, wobei sie das nach der Wende undurchdringliche Gelände nahe der früheren Demarkationslinie erforschen, die an einigen Stellen noch immer stacheldrahtbewehrt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
