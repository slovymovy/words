                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "Mr. Chairman, at this moment I stand astonished at my own moderation!"
                                            },
                                            {
                                                "example_id": "40214534-ff55-4198-a690-1a7a9bf298bf",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "America is a model of force and freedom and moderation - with all the coarseness and rudeness of its people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11042b05-a7f9-30bf-aaa5-2b2a147eb1f5",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "An instance of moderating: bringing something away from extremes, especially in a beneficial way"
                                        ],
                                        "tags": [
