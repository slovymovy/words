                        "examples": [
                            {
                                "example_id": "7a2c5198-4d80-44fc-9629-757c07580588",
                                "sense_id": "df6bd2b2-9886-30ff-89c7-70e8c72332d9",
                                "text": "„Die Innenarchitektin und Designerin Sabine Fajana hat eine ehemalige Fleischhauerei in Wien Floridsdorf zu einem großzügigen Loft und Atelier umgebaut.“"
                            },
                            {
                                "example_id": "c4f7b61d-f53d-4a88-8f08-da1d8bb1521a",
                                "sense_id": "df6bd2b2-9886-30ff-89c7-70e8c72332d9",
                                "text": "„Seine Eltern betrieben in Rottenbach eine Fleischhauerei mit angeschlossener Gastwirtschaft.“"
                            },
                            {
                                "example_id": "61af0c47-fa2f-43ce-9971-7d98f607f8ea",
                                "sense_id": "df6bd2b2-9886-30ff-89c7-70e8c72332d9",
                                "text": "„Eine Fleischhauerei hatte dort ihr Gassenlokal.“"
                            }
                        ],
