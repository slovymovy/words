                        "examples": [
                            {
                                "example_id": "977eae0f-c4be-4ef7-a574-cbe586036eea",
                                "sense_id": "27e6fd48-095c-32ee-b37d-109d34e53212",
                                "text": "Geholpen door de Libische leider Kadhafi zette Taylor in Ivoorkust een rebellenleger op, dat in 1989 Liberia binnenviel. Samuel Doe werd afgezet en door een concurrende rebellengroep doodgemarteld (de video daarvan werd een van de eerste zogenoemde snuff-movies). Er volgde een burgeroorlog die aan 200.000 mensen het leven kostte."
                            },
                            {
                                "example_id": "52eb8f7d-2a7c-47c9-bf94-03d6464b93cb",
                                "sense_id": "27e6fd48-095c-32ee-b37d-109d34e53212",
                                "text": "Begin dit jaar kreeg Kony ineens opmerkelijk veel aandacht op internet toen de organisatie Invisible Children de film Kony2012 online zette. Daarin werd uiteengezet hoe het rebellenleger kinderen misbruikt."
                            }
                        ]
                    }
