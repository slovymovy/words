                        "source_entry_id": "e14bd1c8-4b71-3d96-b1cc-982026c441f9",
                        "target_lang_word": "chronologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                        "entry_id": "88009291-be3c-3693-908c-d9b1a7a2953e",
                                        "glosses": [
                                            "Relatif à la chronologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ea9aac-0090-4456-810b-c8f530fa63a8",
                                                "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                                "text": "C'est l’annaliste L. Calpurnius Pison (suivi par Denys) qui, à la suite de calculs chronologiques, faisait de Tarquin l’Ancien l’aïeul de Lucius."
                                            },
                                            {
                                                "example_id": "a76e0df0-5450-406d-9b62-fc4a77067bca",
                                                "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                                "text": "Nous avons présenté cette histoire, non dans une successivité véritablement chronologique, mais dans un ordre d’heuristicité croissante."
                                            },
                                            {
                                                "example_id": "6875e992-691e-4a22-bdc7-d25edd17a490",
                                                "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                                "text": "Nous proposons alors une approche chronologique en nous appuyant sur une nouvelle datation et sur la corrélation avec les stades des Alpes orientales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
