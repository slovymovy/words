                    {
                        "sense_id": "b516965d-b602-3513-b9f3-794d210fb755",
                        "entry_id": "e153458f-6c0c-351d-99c5-98d65bb74b16",
                        "glosses": [
                            "Cosmia trapezina een vlinder uit de familie van de uilen (Noctuidae)"
                        ],
