                ],
                "translations": [
                    {
                        "translation_id": "042fc051-219e-4bfa-ab95-d35d8e9d5948",
                        "source_entry_id": "7328a90a-bbe8-3ae8-b2d4-7edecf6279f8",
                        "source_sense_id": "1b765085-2edf-3373-b50a-047bb46e9adb",
                        "source_sense_description": "een wenskaart die wordt gekenmerkt door een kerstgroet en wensen voor het komende nieuwe jaar",
                        "target_lang_word": "Weihnachtskarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weihnachtskarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11205c3f-e71e-3dd6-8e84-9b02cbcf64d6",
                                        "entry_id": "259431f2-2983-3058-884d-15d3e607a019",
                                        "glosses": [
                                            "anlässlich von Weihnachten versendete Karte mit guten Wünschen, die als Postkarte oder als Klappkarte ausgestaltet sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2431985-7860-4de6-b1fe-596d50e0d0b3",
                                                "sense_id": "11205c3f-e71e-3dd6-8e84-9b02cbcf64d6",
                                                "text": "„Als Erinnerung an einen seiner anspruchsvollsten Auftraggeber hängt noch eine Weihnachtskarte hinter der Tür.“"
                                            },
                                            {
                                                "example_id": "b998ba2f-6d0c-44aa-9dd3-397a87bdab2b",
                                                "sense_id": "11205c3f-e71e-3dd6-8e84-9b02cbcf64d6",
                                                "text": "Die ersten Umschläge mit Weihnachtskarten versenden wir schon Anfang November, damit unsere Freunde in Russland und China sie sicher noch vor dem Fest erhalten."
                                            },
                                            {
                                                "example_id": "8542ef40-dd7e-4800-803c-6ce9ebe07feb",
                                                "sense_id": "11205c3f-e71e-3dd6-8e84-9b02cbcf64d6",
                                                "text": "„Es waren noch drei andere vorhanden, hier und dort standen sie im Haus herum, angefüllt mit alten Weihnachtskarten und mit Nähzeug, mit Knöpfen und ähnlichem Kram.“"
                                            },
                                            {
                                                "example_id": "3abbaa48-50e3-4871-9c9b-0fb7ca1838df",
                                                "sense_id": "11205c3f-e71e-3dd6-8e84-9b02cbcf64d6",
                                                "text": "„In einem Anfall von Raserei eilt er zur Arbeit und unterzeichnet die Weihnachtskarte für seinen Chef mit drei triumphierenden !!! nach seinem Namen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ada7008a-6f29-4bcf-9217-96c87c2c239a",
                        "source_entry_id": "7328a90a-bbe8-3ae8-b2d4-7edecf6279f8",
                        "source_sense_id": "1b765085-2edf-3373-b50a-047bb46e9adb",
