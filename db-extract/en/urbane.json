                                                "example_id": "c1212e20-45ec-4801-89e2-e9c38bde258f",
                                                "sense_id": "30f21e0f-6892-3416-933a-f122aaf7305a",
                                                "text": "Nedovedou číst jemné náznaky, kterými jim ten druhý chce sdělit, že tomu tak není."
                                            }
