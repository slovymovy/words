                ],
                "senses": [
                    {
                        "sense_id": "5ae2bd55-fdfd-3094-9568-25155722d69c",
                        "entry_id": "29ae84ee-066e-3aac-b6ee-543ca87f0891",
                        "glosses": [
                            "Race de chien d’arrêt ou de chien de compagnie, à poil long."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "61f686ed-a39b-4d6e-bfcf-8a55959dcdc2",
                                "sense_id": "5ae2bd55-fdfd-3094-9568-25155722d69c",
                                "text": "Les épagneuls font partie soit du groupe 7 (chiens d’arrêt) du classement des races de chien par la société centrale canine ou SCC soit du groupe 9 (chiens d’agrément et de compagnie)."
                            },
                            {
                                "example_id": "e6fee078-dbe4-433a-be07-816b73ccc09c",
                                "sense_id": "5ae2bd55-fdfd-3094-9568-25155722d69c",
                                "text": "Les autorités de l’Asile des chiens de Battersea furent fort surprises quand il leur demanda un épagneul sourd et refusa tous les candidats qui dressaient l’oreille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea6d8b86-e703-4151-8e37-9f2578536439",
                        "source_entry_id": "29ae84ee-066e-3aac-b6ee-543ca87f0891",
                        "source_sense_id": "5ae2bd55-fdfd-3094-9568-25155722d69c",
                        "target_lang_word": "Spaniel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spaniel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "813b7e44-fbf8-3dd5-9ed0-050a699f27f6",
                                        "entry_id": "5e5d0c53-ed77-36a6-9faf-4ea2833f8f84",
                                        "glosses": [
                                            "kleiner bis mittelgroßer Stöberhund mit breiter Schnauze, langem, gewelltem Fell und langen Ohren, die an der Seite des Kopfes hängen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "019a35cc-8400-4820-a41d-8f9914cf37d3",
                                                "sense_id": "813b7e44-fbf8-3dd5-9ed0-050a699f27f6",
                                                "text": "„Sie wurden über Einzelheiten des makellosen Privatlebens etlicher Romanschriftstellerinnen informiert und konnten sie mit ihren Spaniels vor rosenumrankten Landhäusern sitzend bewundern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f394131d-fa27-48ad-ac39-fd3b7b328d3c",
                        "source_entry_id": "29ae84ee-066e-3aac-b6ee-543ca87f0891",
                        "source_sense_id": "5ae2bd55-fdfd-3094-9568-25155722d69c",
                        "target_lang_word": "spaniel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spaniel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c2de0c9-782e-3e57-b1f0-3cfa895b0066",
                                        "entry_id": "8449e39a-8f47-35a8-a06b-0e85e1166cc5",
                                        "glosses": [
                                            "Any of various small to medium-sized breeds of gun dog having a broad muzzle, long, wavy fur and long ears that hang at the side of the head, bred for flushing and retrieving game."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76362d5c-5dc2-3646-8c89-3ad96da4f4a2",
                                        "entry_id": "8449e39a-8f47-35a8-a06b-0e85e1166cc5",
                                        "glosses": [
                                            "A cringing, fawning person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a71f55e8-5294-4b91-9909-8782683746f6",
                                                "sense_id": "76362d5c-5dc2-3646-8c89-3ad96da4f4a2",
                                                "text": "Pro[theus].[…]Yet (Spaniel-like) the more ſhe ſpurnes my loue, / The more it growes, and fawneth on her ſtill;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spaniel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6953842a-969d-36b3-ae54-bf058f501f0d",
                                        "entry_id": "6ce0caf2-9a2b-3715-82d2-7ec71237d72c",
                                        "glosses": [
                                            "To follow loyally or obsequiously, like a spaniel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89071621-415f-4838-962f-749c0944de7b",
                                                "sense_id": "6953842a-969d-36b3-ae54-bf058f501f0d",
                                                "text": "Antony: Do we shake hands.—All come to this!—The hearts / That spaniel'd me at heels, to whom I gave / Their wishes, do discandy, melt their sweets"
                                            },
                                            {
                                                "example_id": "976bd619-bb78-4400-955a-b1608004dba8",
                                                "sense_id": "6953842a-969d-36b3-ae54-bf058f501f0d",
                                                "text": "J. Sedgewick (1840), Timon, but not of Athens, page 200: “Always spanielling at the heels of power, the mitred Dignitaries displayed, from first to last, the most rancorous hostility against her.”"
                                            },
                                            {
                                                "example_id": "06c16044-8958-4b56-bbbe-a9e9be37ebf0",
                                                "sense_id": "6953842a-969d-36b3-ae54-bf058f501f0d",
                                                "text": "David S. Bell (2000), Presidential Power in Fifth Republic France, →ISBN, page 30: “Hence Duverger's famous question about de Gaulle's first spanielling Prime Minister makes political ('M. Debré, existe-t-il?'), but not constitutional sense.”"
                                            },
                                            {
                                                "example_id": "c848ec6a-376d-4033-a4f9-11227bfa2965",
                                                "sense_id": "6953842a-969d-36b3-ae54-bf058f501f0d",
                                                "text": "The genre which differed from the world in order to advocate a better one - or the genre which spanielled at heel the sensationalist virtual reality world we will now arguably inhabit till the planet dies - had become by 2000, in triumpth or defeat or both, an institution for the telling of story."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
