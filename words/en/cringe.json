{
    "word_family": [
        "cringeworthy",
        "cringingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4429846a-2485-39e0-a6e3-586622ffb70e",
                    "sense_definition": "To move the body back or down suddenly because of fear, disgust, or embarrassment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>cringed</w> as the bird collided with the window.",
                            "target_lang_translations": {
                                "cs": "Když pták narazil do okna, <w>trhl sebou</w>."
                            }
                        },
                        {
                            "text": "The dog <w>cringed</w> in the corner when it heard the loud thunder.",
                            "target_lang_translations": {
                                "cs": "Pes se <w>schoulil</w> v rohu, když uslyšel hlasité hřmění."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cringe in fear"
                    ],
                    "target_lang_definitions": {
                        "cs": "Náhlý pohyb těla dozadu nebo dolů v důsledku strachu, znechucení nebo rozpaků."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "schoulit se",
                                "target_lang_sense_clarification": "fyzické stažení se strachem nebo odporem"
                            },
                            {
                                "target_lang_word": "cuknout",
                                "target_lang_sense_clarification": "náhlý reflexivní pohyb těla"
                            },
                            {
                                "target_lang_word": "trhnout sebou",
                                "target_lang_sense_clarification": "prudká reakce na vnější podnět"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8d1cfb9-e511-3a32-b5a3-659a68b4396e",
                    "sense_definition": "To feel very embarrassed or uncomfortable because of something someone else has done.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>cringed</w> watching the actor forget all his lines on stage.",
                            "target_lang_translations": {
                                "cs": "Bylo mi <w>trapně</w>, když jsem sledoval, jak herec na pódiu zapomněl všechny své repliky."
                            }
                        },
                        {
                            "text": "Everyone <w>cringed</w> when he started singing that terrible song.",
                            "target_lang_translations": {
                                "cs": "Všichni <w>cítili trapnost</w>, když začal zpívat tu příšernou písničku."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cringe at the thought"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pocit velkých rozpaků nebo nepohodlí kvůli něčemu, co udělal někdo jiný."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "cítit trapnost",
                                "target_lang_sense_clarification": "prožívání pocitu trapnosti za někoho jiného"
                            },
                            {
                                "target_lang_word": "stydět se za někoho",
                                "target_lang_sense_clarification": "pocit sekundární trapnosti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34fa3291-48e1-3095-b88c-dbacab40a74b",
                    "sense_definition": "To behave in an overly humble or submissive way to gain favor.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "servile_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corrupt official would <w>cringe</w> before his powerful boss.",
                            "target_lang_translations": {
                                "cs": "Zkorumpovaný úředník se před svým mocným šéfem vždy <w>plazil</w>."
                            }
                        },
                        {
                            "text": "He refused to <w>cringe</w> to those in positions of authority.",
                            "target_lang_translations": {
                                "cs": "Odmítal <w>podlézat</w> lidem v mocenských pozicích."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in historical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Chovat se přehnaně pokorně nebo podlézavě za účelem získání přízně."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "plazit se",
                                "target_lang_sense_clarification": "ponížené, podlézavé chování"
                            },
                            {
                                "target_lang_word": "podlézat",
                                "target_lang_sense_clarification": "servilní chování vůči autoritě"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "197432d9-a912-3f12-b829-c87688a9ec83",
                    "sense_definition": "Causing feelings of awkwardness or secondhand embarrassment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That video of the politician dancing was so <w>cringe</w>.",
                            "target_lang_translations": {
                                "cs": "To video, jak politik tančí, bylo tak <w>trapné</w>."
                            }
                        },
                        {
                            "text": "Trying to use slang you do not understand is <w>cringe</w>.",
                            "target_lang_translations": {
                                "cs": "Snažit se používat slang, kterému nerozumíš, je <w>trapárna</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cringeworthy or uncool",
                        "inducing awkwardness or secondhand embarrassment"
                    ],
                    "common_phrases": [
                        "so cringe"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in informal online communication."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobující pocity trapnosti nebo sekundární stud."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "trapný",
                                "target_lang_sense_clarification": "vyvolávající pocit studu"
                            },
                            {
                                "target_lang_word": "k cringe",
                                "target_lang_sense_clarification": "slangové označení pro něco velmi trapného"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99af5542-55d7-3e55-aee5-59c4303e79e2",
                    "sense_definition": "A physical movement of shrinking away from something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a small <w>cringe</w> when the dentist touched his tooth.",
                            "target_lang_translations": {
                                "cs": "Když se ho zubař dotkl zubu, trochu <w>cukl</w>."
                            }
                        },
                        {
                            "text": "She could not hide her <w>cringe</w> at the sight of the spider.",
                            "target_lang_translations": {
                                "cs": "Nedokázala skrýt své <w>trhnutí</w> při pohledu na pavouka."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Fyzický pohyb odtažení se od něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "cuknutí",
                                "target_lang_sense_clarification": "fyzický reflexivní pohyb"
                            },
                            {
                                "target_lang_word": "trhnutí",
                                "target_lang_sense_clarification": "náhlý pohyb těla"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ae5ecaa-888a-37df-a7d6-012c80e92a48",
                    "sense_definition": "Content that causes an onlooker to feel secondhand embarrassment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The internet is full of <w>cringe</w> that people share for laughs.",
                            "target_lang_translations": {
                                "cs": "Internet je plný <w>trapáren</w>, které lidé sdílejí pro pobavení."
                            }
                        },
                        {
                            "text": "He posted pure <w>cringe</w> on his social media profile.",
                            "target_lang_translations": {
                                "cs": "Na svůj profil na sociálních sítích postoval čistou <w>trapárnu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "posted cringe"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used primarily in digital culture."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Obsah, který u diváka vyvolává pocit sekundární trapnosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "trapárna",
                                "target_lang_sense_clarification": "slangové označení pro trapný obsah"
                            },
                            {
                                "target_lang_word": "cringe",
                                "target_lang_sense_clarification": "přejaté slangové slovo pro trapný obsah"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "5e1ad921-231a-33e2-b29c-eca5b515f642",
                    "sense_definition": "An exclamation used to express that something is embarrassing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Cringe</w>! I cannot believe he actually said that out loud.",
                            "target_lang_translations": {
                                "cs": "<w>Trapas</w>! Nemůžu uvěřit, že to skutečně řekl nahlas."
                            }
                        },
                        {
                            "text": "She just looked at the screen and whispered, <w>cringe</w>.",
                            "target_lang_translations": {
                                "cs": "Jen se podívala na obrazovku a zašeptala: „<w>Trapas</w>.“"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal interjection."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Citoslovce vyjadřující, že je něco trapné."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "trapas",
                                "target_lang_sense_clarification": "vyjádření trapné situace"
                            },
                            {
                                "target_lang_word": "cringe",
                                "target_lang_sense_clarification": "slangové zvolání"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}