                        "examples": [
                            {
                                "example_id": "659e8c2d-3cd9-491d-9173-162dfe40dc3d",
                                "sense_id": "715fd6f3-0ea3-30b8-8399-d95fb1918452",
                                "text": "„Das Letzte, was er fand, war ein würfelförmiger Eichenholzkasten mit Eckfugen in Schwalbenschwanzverbindung und einer in den Deckel eingelassenen Messingplatte.“"
                            },
                            {
                                "example_id": "5ebc56f2-6150-4517-8efc-247afe2a82da",
                                "sense_id": "715fd6f3-0ea3-30b8-8399-d95fb1918452",
                                "text": "„Er wollte neben seiner Frau begraben werden, mit einem marmornen Grabstein und einer Messingplatte wie bei ihr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
