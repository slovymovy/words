                                        "glosses": [
                                            "klein vrijstaand winkeltje waar men snoep, koffie, kranten en tijdschriften kan kopen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a31e53-9153-4dea-b0d2-6b4be8388934",
                                                "sense_id": "f17f0b30-ee93-342f-b9ea-4f1818691121",
                                                "text": "Een kiosk is handig voor reizigers die snel wat nodig hebben voor hun reis"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36451dd8-5e29-4ffe-ac65-5922f887b7e1",
                        "source_entry_id": "7e7a6715-7958-3d58-838f-014b35e20077",
                        "source_sense_description": "retail business",
                        "target_lang_word": "kiosque à journaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiosque à journaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bac3849-7143-3af4-a276-2e8db3ffe557",
                                        "entry_id": "e18f3bd0-b3b5-3c02-9915-a8d9c5a70dd3",
                                        "glosses": [
                                            "Édicule de rue, à l’origine en forme de petit kiosque, servant de présentoir pour le commerce de la presse, fermé la nuit par des volets en bois ou en métal."
                                        ],
                                        "tags": [
                                            "Mobilier urbain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f6d935-ff32-4ee7-b8ff-58ecb224f36f",
                                                "sense_id": "7bac3849-7143-3af4-a276-2e8db3ffe557",
                                                "text": "Le visage de Jackie Kennedy ornait le dos du kiosque à journaux."
                                            },
                                            {
                                                "example_id": "9a56a23e-77a4-49e7-beee-5a7ec95372f5",
                                                "sense_id": "7bac3849-7143-3af4-a276-2e8db3ffe557",
                                                "text": "Plus bas, à l’angle de l’avenue de Friedland et de l’avenue Hoche, un nuage de fumée environne rapidement un kiosque à journaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6daaf97-ec7e-4452-9030-9e31385d01f0",
                        "source_entry_id": "7e7a6715-7958-3d58-838f-014b35e20077",
                        "source_sense_description": "retail business",
                        "target_lang_word": "Zeitungskiosk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeitungskiosk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43709a23-5e94-35a7-838f-30a9562ef375",
                                        "entry_id": "46b16373-cac1-3a47-ac79-ae057e2b6714",
                                        "glosses": [
                                            "Kiosk, der hauptsächlich auf den Verkauf von Zeitungen ausgelegt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df6ad42-54ab-4131-af90-d9cab1ff84bd",
                                                "sense_id": "43709a23-5e94-35a7-838f-30a9562ef375",
                                                "text": "„Sie wurde an Pariser Zeitungskioske verteilt und dort verkauft.“"
                                            },
                                            {
                                                "example_id": "f74ac3df-77bc-4897-9cef-af4c2583a1d6",
                                                "sense_id": "43709a23-5e94-35a7-838f-30a9562ef375",
                                                "text": "„Da ist ein Zeitungskiosk mit eisernen Läden.“"
                                            },
                                            {
                                                "example_id": "abb77262-1ba7-40b8-9672-5821753c6aef",
                                                "sense_id": "43709a23-5e94-35a7-838f-30a9562ef375",
                                                "text": "„Vor dem Zeitungskiosk blieb er stehen.“"
                                            },
                                            {
                                                "example_id": "502a03e9-94e7-491f-9de4-005de1c99527",
                                                "sense_id": "43709a23-5e94-35a7-838f-30a9562ef375",
                                                "text": "„Ich kaufte mir an dem Zeitungskiosk eine »New York Times« und nahm sie mit in den Drugstore gegenüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
