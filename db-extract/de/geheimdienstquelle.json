                        "examples": [
                            {
                                "example_id": "d772a60c-0add-4087-931e-271cb7cfb352",
                                "sense_id": "bb24bf80-63ab-3125-a244-6a6be2a7b4c2",
                                "text": "„Mujurus Gegner benutzten Material aus Geheimdienstquellen und erzielten mit ihrem erzwungenen Rücktritt Ende 2014 den gewünschten Erfolg.“"
                            },
                            {
                                "example_id": "98c33c97-a0ee-4442-893a-9560983c2117",
                                "sense_id": "bb24bf80-63ab-3125-a244-6a6be2a7b4c2",
                                "text": "„Die Front für die Befreiung des Libanon von Ausländern bekannte sich dazu, doch später wurde diese Gruppe in Interviews mit israelischen Geheimdienstquellen als von Israel kontrolliert identifiziert.“"
                            },
                            {
                                "example_id": "7842cf2a-f109-4d41-bd29-6080c6e52340",
                                "sense_id": "bb24bf80-63ab-3125-a244-6a6be2a7b4c2",
                                "text": "„Beide Männer waren erleichtert, dass ihre Geheimdienstquellen die Ankunft des Flugzeugs korrekt vorhergesagt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
