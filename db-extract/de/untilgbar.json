                ],
                "senses": [
                    {
                        "sense_id": "d9da1d23-e2fe-3c84-a685-17926ee92bb4",
                        "entry_id": "fc5b3e88-6537-37a1-b5ed-8bdd85f35f77",
                        "glosses": [
                            "so, dass es nicht getilgt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5027795d-35d0-4ddf-bbfa-4ca2c25d58b4",
                                "sense_id": "d9da1d23-e2fe-3c84-a685-17926ee92bb4",
                                "text": "„Wie es nun wohl zufällig kommen kann, daß sich unserem Geiste die Gestalt eines Baumes, Felsens, Hauses untilgbar einprägt, so wollte es der Zufall, … daß mir zwei alte Frauen, welche von den andern sich gesondert hielten und sehr eifrig miteinander verkehrten, besonders auffielen.“"
                            }
