                        "entry_id": "a91349f6-8727-3de8-b40b-c20cbee1c987",
                        "glosses": [
                            "Pertaining to Darbyism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d775e1-2a0e-4227-8236-e936dce49234",
                                "sense_id": "48a6e4ac-a958-3320-aa33-cb76a0bbf587",
                                "text": "Government restrictions imposed on the independent churches of Germany during the Nazi régime led to a forced union of Darbyite, Baptist and independent Brethren churches in a Bund, together with some other minor groups."
                            },
                            {
                                "example_id": "db50357a-a732-4fd0-8e79-90455b7eea0b",
                                "sense_id": "48a6e4ac-a958-3320-aa33-cb76a0bbf587",
                                "text": "In typical Darbyite fashion, Franson preached that a pretribulationist secret rapture would precede the appearance of the personal Antichrist."
                            },
                            {
                                "example_id": "da58f38c-8843-45cc-a8ac-5be3000ae8e5",
                                "sense_id": "48a6e4ac-a958-3320-aa33-cb76a0bbf587",
                                "text": "The \"conservatives,\", those who accept neither the \"higher criticism\" of the Bible nor the Darbyite doctrine, are ignored completely."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b06df842-5a53-3b34-9484-bae01c031631",
