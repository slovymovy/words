                                "target_word": "assistante paroissiale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a328d3f5-e338-34ca-9971-9e6b0d44a5b0",
                                        "entry_id": "ac50f9fd-6efe-324d-ba69-891c2ebbca7b",
                                        "glosses": [
                                            "Femme travaillant comme agent pastoral laïc dans une paroisse catholique romaine"
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Luxembourg"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b365eb4-6fb2-4523-abdd-b427cdece682",
                                                "sense_id": "a328d3f5-e338-34ca-9971-9e6b0d44a5b0",
                                                "text": "Devenir assistante paroissiale ne se fait pas comme ça, sur un simple claquement de doigts."
                                            },
                                            {
                                                "example_id": "598fc8be-1e4d-4ff3-a4db-b6df1fea9e77",
                                                "sense_id": "a328d3f5-e338-34ca-9971-9e6b0d44a5b0",
                                                "text": "Jean Schobbens, curé de Journal, décidait, à 71 ans, de se marier avec Micheline, son assistante paroissiale avec laquelle il vivait depuis cinq ans."
                                            },
                                            {
                                                "example_id": "89578a77-a328-419c-96af-c1c67834e166",
                                                "sense_id": "a328d3f5-e338-34ca-9971-9e6b0d44a5b0",
                                                "text": "Dans ce cas, l’église – en la personne du curé, du diacre, de l’assistante paroissiale, etc. – peut accompagner la famille dans son deuil."
                                            }
                                        ]
                                    }
