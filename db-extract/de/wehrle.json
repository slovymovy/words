                ],
                "senses": [
                    {
                        "sense_id": "2ad0ba39-ec2c-39d8-b980-8d5dab3f293b",
                        "entry_id": "bf47d6d5-e361-33f8-95a7-5b73ba56ff6a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96118328-9628-4cdd-a83c-55f81954ec73",
                                "sense_id": "2ad0ba39-ec2c-39d8-b980-8d5dab3f293b",
                                "text": "Frau Wehrle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "63e7005a-4555-4772-bfe8-b42b7ac74918",
                                "sense_id": "2ad0ba39-ec2c-39d8-b980-8d5dab3f293b",
                                "text": "Herr Wehrle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9d284ecb-c7b7-42ed-82d1-006d7df955b1",
                                "sense_id": "2ad0ba39-ec2c-39d8-b980-8d5dab3f293b",
                                "text": "Die Wehrles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "21445c6c-43cd-402b-9799-412d0438a019",
                                "sense_id": "2ad0ba39-ec2c-39d8-b980-8d5dab3f293b",
                                "text": "Der Wehrle trägt nie die Pullover, die die Wehrle ihm strickt."
                            },
                            {
                                "example_id": "34058083-d122-4a99-a151-ce4d45ef4eb4",
                                "sense_id": "2ad0ba39-ec2c-39d8-b980-8d5dab3f293b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wehrle kommt, geht der Herr Wehrle.“"
                            },
                            {
                                "example_id": "d5d25cad-dffe-4478-b420-03bd39801d08",
                                "sense_id": "2ad0ba39-ec2c-39d8-b980-8d5dab3f293b",
                                "text": "Wehrle kommt und geht."
                            },
                            {
                                "example_id": "806e583e-345c-4c45-ae82-fd2a2971c712",
                                "sense_id": "2ad0ba39-ec2c-39d8-b980-8d5dab3f293b",
                                "text": "Wehrles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
