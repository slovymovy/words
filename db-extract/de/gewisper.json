                    {
                        "form_id": "4e30f760-0321-481c-988b-407ecff42e16",
                        "entry_id": "cf578959-e07e-35cf-be9c-a091d0d0e35d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Gewisper"
