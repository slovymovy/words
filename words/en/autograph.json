                    ]
                },
                {
                    "sense_id": "207ecdf1-8be1-3433-af09-d2fafa8b14a9",
                    "sense_definition": "To write something in one's own handwriting.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian found a letter <w>autographed</w> by the king himself."
                        },
                        {
                            "text": "She <w>autographed</w> the entire manuscript to ensure its authenticity."
                        }
                    ],
                    "synonyms": [
                        "handwriting"
                    ]
                }
            ]
        },
