                    },
                    {
                        "sense_id": "8bafc672-d175-399f-8736-5b43d45fdb52",
                        "entry_id": "ce748615-f429-3c7b-9734-778e142db8bf",
                        "glosses": [
                            "głos wydawany przez koguta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21fb3bf3-f24f-483d-a05d-2d2823457455",
                                "sense_id": "8bafc672-d175-399f-8736-5b43d45fdb52",
                                "text": "Rano obudziło mnie energiczne pianie koguta."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a70fd5f3-3ee0-4e11-87db-2b57404139ef",
                        "source_entry_id": "ce748615-f429-3c7b-9734-778e142db8bf",
                        "source_sense_id": "8bafc672-d175-399f-8736-5b43d45fdb52",
                        "target_lang_word": "crow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ced763c-c4c8-3adb-864a-62bb6765ecde",
                                        "entry_id": "41b26086-8819-330c-9a83-a0b053abddce",
                                        "glosses": [
                                            "A bird, usually black, of the genus Corvus, having a strong conical beak, with projecting bristles; it has a harsh, croaking call."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25206a4d-a85e-47fd-aeb3-57c5c304e095",
                                                "sense_id": "7ced763c-c4c8-3adb-864a-62bb6765ecde",
                                                "text": "Gaslark in his splendour on the golden stairs saying adieu to those three captains and their matchless armament foredoomed to dogs and crows on Salapanta Hills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7677b389-44d2-3def-a685-08ef3f88755d",
                                        "entry_id": "41b26086-8819-330c-9a83-a0b053abddce",
                                        "glosses": [
                                            "Any of various dark-coloured nymphalid butterflies of the genus Euploea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29f224e7-a509-3913-978b-9c9eb336ed6c",
                                        "entry_id": "41b26086-8819-330c-9a83-a0b053abddce",
                                        "glosses": [
                                            "A bar of iron with a beak, crook or claw; a bar of iron used as a lever; a crowbar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf7aec8-1d75-4fd1-888e-72b65a1c8b3c",
                                                "sense_id": "29f224e7-a509-3913-978b-9c9eb336ed6c",
                                                "text": "He approached the humble tomb in which Antonia reposed. He had provided himself with an iron crow and a pick-axe: but this precaution was unnecessary."
                                            },
                                            {
                                                "example_id": "217e9354-f126-4b19-bd22-beda85382312",
                                                "sense_id": "29f224e7-a509-3913-978b-9c9eb336ed6c",
                                                "text": "Watt might have broken the door down, with an axe, or a crow, or a small charge of explosive, but this might have aroused Erskine's suspicions, and Watt did not want that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e16918a-bc68-3e8d-b9ab-50d86f1f4b1e",
                                        "entry_id": "41b26086-8819-330c-9a83-a0b053abddce",
                                        "glosses": [
                                            "Someone who keeps watch while their associates commit a crime; a lookout."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81f1f89-1c5c-4b2a-834d-f258167e41ff",
                                                "sense_id": "1e16918a-bc68-3e8d-b9ab-50d86f1f4b1e",
                                                "text": "“Ay,” put in a young man, who had the reputation of being the smartest “crow” in London—“‘fishers of men,’ as the parson says.”"
                                            },
                                            {
                                                "example_id": "6adb5cc3-0eb8-4ea1-8867-9a46859b68f0",
                                                "sense_id": "1e16918a-bc68-3e8d-b9ab-50d86f1f4b1e",
                                                "text": "By nine o'clock on the evening of November 12, 1854, Pierce had his confederates in their places. The crow, Agar's woman, lounged across the street from the Trent mansion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7231e56a-b1e0-33d9-a2a5-9f20ea2cce6d",
                                        "entry_id": "41b26086-8819-330c-9a83-a0b053abddce",
                                        "glosses": [
                                            "A gangplank (corvus) used by the Ancient Roman navy to board enemy ships."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97b25a74-a1f1-35e2-bbc1-dfccfff87853",
                                        "entry_id": "41b26086-8819-330c-9a83-a0b053abddce",
                                        "glosses": [
                                            "The mesentery of an animal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcc43525-4d28-3e42-8817-8f80403de11e",
                                        "entry_id": "41b26086-8819-330c-9a83-a0b053abddce",
                                        "glosses": [
                                            "An ill-tempered and obstinate woman, or one who otherwise has features resembling the bird; a harpy."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a47a7d69-01fe-40d8-9345-ed6181027ad5",
                                                "sense_id": "dcc43525-4d28-3e42-8817-8f80403de11e",
                                                "text": "But it helps a man along to have a wife he can be proud of. Suppose you marry some old crow. People point at her and ask, 'Who is that death's head yonder?'"
                                            },
                                            {
                                                "example_id": "f9595612-404f-4d02-8f2c-59c51b4fedc4",
                                                "sense_id": "dcc43525-4d28-3e42-8817-8f80403de11e",
                                                "text": "(Mrs. Meany to Woody, from a window) \"I don't care! I'm not running a pet shop.\"\n\"Well it looks like one with an old crow in the window!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00317334-731c-39f6-bda4-cd21e504669f",
                                        "entry_id": "41b26086-8819-330c-9a83-a0b053abddce",
                                        "glosses": [
                                            "A black person."
                                        ],
                                        "tags": [
                                            "ethnic",
                                            "offensive",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71d3664c-83c9-3181-b02a-d798e136f3fa",
                                        "entry_id": "41b26086-8819-330c-9a83-a0b053abddce",
                                        "glosses": [
                                            "The emblem of an eagle, a sign of military rank."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1162decc-eb1d-4ab9-848a-ae6179ae8ac1",
                                                "sense_id": "71d3664c-83c9-3181-b02a-d798e136f3fa",
                                                "text": "A young petty officer that must have just received his “crow” (a single chevron, with an eagle over it) was showing off to several seamen."
                                            },
                                            {
                                                "example_id": "7fa4e7a7-66a9-4280-9083-af47fdc22bc3",
                                                "sense_id": "71d3664c-83c9-3181-b02a-d798e136f3fa",
                                                "text": "The young man had been threatened with loss of his third class rank, his “crow,” the eagle in a petty officer's sleeve insignia."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f72d979b-14d0-34c5-8b35-350d75a33474",
                                        "entry_id": "5d22482b-d5cc-3217-b0e9-de0f72d44216",
                                        "glosses": [
                                            "Dark black, the color of a crow; crow-black."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "732d5c55-d5d8-4def-b707-a925f3736839",
                                                "sense_id": "f72d979b-14d0-34c5-8b35-350d75a33474",
                                                "text": "\"Though her her crow hair is lovely and wavy, she loathes it and craves yellow locks. Since she saw Hugh, she's given me no peace.” Sheffield's square , good-looking face shaped a grimace."
                                            },
                                            {
                                                "example_id": "b1515fb8-2c5a-43c5-8eda-05f85b5b298b",
                                                "sense_id": "f72d979b-14d0-34c5-8b35-350d75a33474",
                                                "text": "[…] only her crow hair could be seen. Her appearance could not be seen as she anxiously called out, \"Mother ...\" The setting sun cast a dim yellow light on the interior of the house. The woman lay on her back and looked up at the beams overhead[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aac8ece0-dd28-37f6-9e46-69e7d6ca7cd1",
                                        "entry_id": "dd31368f-54e1-3e85-81ca-aa78b9f90d61",
                                        "glosses": [
                                            "To make the shrill sound characteristic of a rooster; to make a sound in this manner, either in gaiety, joy, pleasure, or defiance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfa59d56-4785-4d04-9159-e17331c7f6ba",
                                                "sense_id": "aac8ece0-dd28-37f6-9e46-69e7d6ca7cd1",
                                                "text": "Yet once me thought it [the ghost of Hamlet's father] was about to ſpeake, / And lifted vp his head to motion, / Like as he would ſpeake, but euen the / The morning cocke crew lowd, and in all haſte / It ſhrunke in haſte away, and vaniſhed / Our ſight."
                                            },
                                            {
                                                "example_id": "e66a8883-d599-49ae-a3d9-7caf52e9a9ac",
                                                "sense_id": "aac8ece0-dd28-37f6-9e46-69e7d6ca7cd1",
                                                "text": "This is the Cock that crowed in the Morn[.]"
                                            },
                                            {
                                                "example_id": "3fcf3c4e-90b1-4ff9-acb6-948de03572a1",
                                                "sense_id": "aac8ece0-dd28-37f6-9e46-69e7d6ca7cd1",
                                                "text": "'You are that Psyche' Cyril said again / 'The mother of the sweetest little maid, / That ever crow'd for kisses.'"
                                            },
                                            {
                                                "example_id": "b1b3016a-cc51-480c-b8ec-c9a0d55a70d5",
                                                "sense_id": "aac8ece0-dd28-37f6-9e46-69e7d6ca7cd1",
                                                "text": "The child was at this time about ten months old, and was a strong, hearty, happy infant, always laughing when he was awake and always sleeping when he did not laugh, because his little limbs were free from pain and his little stomach was not annoyed by internal troubles. He kicked, and crowed, and sputtered, when his mother took him, and put up his little fingers to clutch her hair, and was to her as a young god upon the earth. Nothing in the world had ever been created so beautiful, so joyous, so satisfactory, so divine!"
                                            },
                                            {
                                                "example_id": "70fbfa60-60f6-4c80-9e12-429441afdb5a",
                                                "sense_id": "aac8ece0-dd28-37f6-9e46-69e7d6ca7cd1",
                                                "text": "Hearing the miner's footsteps, the baby would put up his arms and crow."
                                            },
                                            {
                                                "example_id": "30283abd-2f97-432a-9b5b-2ffdf1e10045",
                                                "sense_id": "aac8ece0-dd28-37f6-9e46-69e7d6ca7cd1",
                                                "text": "When your rooster crows at the break o' dawn / Look out your window and I'll be gone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "779aa752-5032-35da-aaf8-340c9618c047",
                                        "entry_id": "dd31368f-54e1-3e85-81ca-aa78b9f90d61",
                                        "glosses": [
                                            "To shout in exultation or defiance; to brag."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e38dac32-c62c-4021-9625-52ca1261cf70",
                                                "sense_id": "779aa752-5032-35da-aaf8-340c9618c047",
                                                "text": "He’s been crowing all day about winning the game of cards."
                                            },
                                            {
