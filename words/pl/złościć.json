                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gniew",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ciągłe spóźnienia współpracownika zaczęły go w końcu <w>złościć</w>.",
                            "target_lang_translations": {
                                "en": "His coworker's constant tardiness finally started to <w>anger</w> him.",
                                "ru": "Постоянные опоздания коллеги в конце концов начали его <w>злить</w>.",
                                "nl": "Het voortdurende te laat komen van zijn collega begon hem uiteindelijk te <w>ergeren</w>.",
                                "de": "Die ständigen Verspätungen des Kollegen begannen ihn schließlich zu <w>ärgern</w>.",
                                "fr": "Les retards constants de son collègue ont fini par l'<w>énerver</w>.",
                                "it": "I continui ritardi del collega hanno iniziato finalmente a <w>farlo arrabbiare</w>.",
                                "cs": "Neustálá zpoždění kolegy ho nakonec začala <w>zlobit</w>.",
                                "tr": "İş arkadaşının sürekli geç kalması sonunda onu <w>kızdırmaya</w> başladı.",
                                "es": "Los continuos retrasos del compañero de trabajo empezaron por fin a <w>enfadar</w>lo.",
                                "zh": "同事的频繁迟到最终开始让他<w>生气</w>。"
                            }
                        },
                        {
                            "text": "Nie pozwól, żeby drobne niepowodzenia tak bardzo cię <w>złościły</w>.",
                            "target_lang_translations": {
                                "en": "Don't let minor setbacks <w>annoy</w> you so much.",
                                "ru": "Не позволяй мелким неудачам так сильно тебя <w>злить</w>.",
                                "nl": "Laat kleine tegenslagen je niet zo erg <w>boos maken</w>.",
                                "de": "Lass nicht zu, dass kleine Misserfolge dich so sehr <w>ärgern</w>.",
                                "fr": "Ne laisse pas de petits échecs te <w>mettre en colère</w> à ce point.",
                                "it": "Non permettere che piccoli contrattempi ti <w>irritino</w> così tanto.",
                                "cs": "Nedovol, aby tě drobné neúspěchy tolik <w>rozčilovaly</w>.",
                                "tr": "Ufak aksiliklerin seni bu kadar <w>sinirlendirmesine</w> izin verme.",
                                "es": "No dejes que los pequeños contratiempos te <w>hagan enfadar</w> tanto.",
                                "zh": "别让小小的挫折把你<w>惹恼</w>成这样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "denerwować",
                        "gniewać",
                        "irytować"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause someone to feel anger or irritation",
                        "ru": "вызывать у кого-либо чувство гнева, раздражения или злости",
                        "nl": "bij iemand gevoelens van woede of irritatie opwekken",
