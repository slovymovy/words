                        "source_sense_id": "22bda3b0-e6bb-33f8-ad09-44d10738e800",
                        "source_sense_description": "laatste boek van de Bijbel",
                        "target_lang_word": "Offenbarung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Offenbarung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "756f589a-6040-3c48-a8a9-c152b59aa021",
                                        "entry_id": "c68be319-ecfc-3119-91cf-939c693e8c62",
                                        "glosses": [
                                            "das Aufdecken oder Offenlegen eines Geheimnisses oder einer Absicht"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a9fce4e-05ca-4386-a9f6-0ba8dd6e68fb",
                                                "sense_id": "756f589a-6040-3c48-a8a9-c152b59aa021",
                                                "text": "Die Offenbarung seiner wirtschaftlichen Verhältnisse ließ nichts Gutes ahnen."
                                            },
                                            {
                                                "example_id": "43c456cd-3c20-44b0-bdfb-6078e6e85043",
                                                "sense_id": "756f589a-6040-3c48-a8a9-c152b59aa021",
                                                "text": "„Ihre erste Offenbarung hatte Sisi an einem Mittwochabend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "96b91f70-9d2d-373c-8876-6cae7d8f2154",
                                        "entry_id": "c68be319-ecfc-3119-91cf-939c693e8c62",
                                        "glosses": [
                                            "die Mitteilung göttlicher Wahrheiten oder eines göttlichen Willens auf übernatürlichem Wege"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2442946d-2bdf-42d8-9e73-c91288c070f2",
                                                "sense_id": "96b91f70-9d2d-373c-8876-6cae7d8f2154",
                                                "text": "„Die Besinnung auf die inhärente Wortbedeutung … ist deshalb wichtig, weil es sehr schwer ist, zu bestimmen, was im Bereich nichtchristlicher Religionen als Analogon zur christlichen Offenbarung anzusehen ist.“"
                                            },
                                            {
                                                "example_id": "f0ce4aec-7db9-422f-a000-ec4da939ceca",
                                                "sense_id": "96b91f70-9d2d-373c-8876-6cae7d8f2154",
                                                "text": "\"Das deutsche Wort Offenbarung betont demgegenüber die grundsätzliche, wesentliche Neuheit und Andersheit des \"Eröffneten\", … So kann man, gerade vom deutschen Wort her, Offenbarung bestimmen als \"akthaftes, persönliches Sichkundgeben …\"\""
                                            },
                                            {
                                                "example_id": "820427ea-df95-429e-a176-36bca4f3ef5c",
                                                "sense_id": "96b91f70-9d2d-373c-8876-6cae7d8f2154",
                                                "text": "„Die Offenbarung des Johannes hatte verheißen, Gott werde einst die Tränen von den Augen der Menschen wischen, der Tod werde nicht mehr sein, keine Trauer, keine Klage, keine Mühsal.“"
                                            },
                                            {
                                                "example_id": "d599d00f-be1a-430a-bd28-ab3d06c03dd3",
                                                "sense_id": "96b91f70-9d2d-373c-8876-6cae7d8f2154",
                                                "text": "„Gemeint ist einmal die Verbindung von Altem und Neuem Testament, die Herder als Philologe und als Historiker, besser: als historischer Narrator und Rhetoriker herstellt – damit macht er das Ganze zu einer großen Erzählung, die ohne Rekurs auf Offenbarung auskommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bfc06530-d4d7-3c2a-a9f3-fd85dad15ef4",
                                        "entry_id": "c68be319-ecfc-3119-91cf-939c693e8c62",
                                        "glosses": [
                                            "kurz fürOffenbarung des Johannes: das letzte Buch der Bibel"
                                        ],
                                        "tags": [
                                            "Bibel"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
