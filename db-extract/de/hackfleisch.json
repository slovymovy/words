                        "examples": [
                            {
                                "example_id": "b7d48a06-6f82-425e-890c-ed9b0b54f752",
                                "sense_id": "0b84570f-e720-3936-8384-260196b3e53d",
                                "text": "Frikadellen sind aus Hackfleisch.",
                                "translation": "Meatballs are made from minced meat.",
                                "english": "Meatballs are made from minced meat."
                            }
                        ]
                    },
                    {
                        "sense_id": "84439d9f-b089-38ad-b790-80dd2d4d7311",
                        "entry_id": "8d46fe5b-eaa9-3552-adf5-fe529eae565a",
                        "glosses": [
                            "the victim of a beating or a harsh reprehension"
                        ],
                        "tags": [
                            "figuratively",
                            "informal",
                            "neuter",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a0288e01-7e7a-4c11-951d-8df76a053bf0",
                                "sense_id": "84439d9f-b089-38ad-b790-80dd2d4d7311",
                                "text": "Aus dem mach ich Hackfleisch!",
                                "translation": "I'll make him into minced meat!",
                                "english": "I'll make him into minced meat!"
                            },
                            {
                                "example_id": "d9e4329e-5362-41c6-ae30-a28b33b26c7a",
                                "sense_id": "84439d9f-b089-38ad-b790-80dd2d4d7311",
                                "text": "Wenn der Direktor das mitkriegt, bist du Hackfleisch.",
                                "translation": "If the principal finds out about that, you'll be minced meat.",
                                "english": "If the principal finds out about that, you'll be minced meat."
                            }
                        ]
                    }
