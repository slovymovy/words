                    {
                        "sense_id": "cb901abd-91f0-3bf9-909c-304450ca07c4",
                        "entry_id": "4a02b4f5-d310-3748-bb19-42f174200d86",
                        "glosses": [
                            "oesophagus, een onderdeel van het spijsverteringsstelsel, verbinding tussen de keelholte en de maag"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83af27df-2f0f-429e-a9b5-d8ba5841ba6b",
                        "source_entry_id": "4a02b4f5-d310-3748-bb19-42f174200d86",
                        "source_sense_id": "cb901abd-91f0-3bf9-909c-304450ca07c4",
                        "target_lang_word": "Speiseröhre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speiseröhre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9de66ec2-ec81-3cb1-9f6b-d26e668a693f",
                                        "entry_id": "754cb699-dd2b-33ad-a533-a43cfd6d1789",
                                        "glosses": [
                                            "hohles, aus Muskeln bestehendes, mit einer Schleimhaut ausgekleidetes Verbindungsstück zwischen dem Rachenraum und dem Magen, das dem Transport der Nahrung in denselben dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b16b1ce-92ea-4b33-b872-855c693b7b69",
                                                "sense_id": "9de66ec2-ec81-3cb1-9f6b-d26e668a693f",
                                                "text": "Beim Verschlucken geraten Nahrungsteile anstatt in die Speiseröhre in die Luftröhre."
                                            },
                                            {
                                                "example_id": "7ac7f037-5abb-45dd-bf81-60633188e490",
                                                "sense_id": "9de66ec2-ec81-3cb1-9f6b-d26e668a693f",
                                                "text": "„Die Untersuchung eignet sich gut, um das Herz quasi von hinten durch die Speiseröhre hindurch zubetrachten.“"
                                            },
                                            {
                                                "example_id": "dd7b7e3e-3538-4e25-8c59-f990b2e42bdb",
                                                "sense_id": "9de66ec2-ec81-3cb1-9f6b-d26e668a693f",
                                                "text": "„Die Perser wollen jetzt mit borsäurefreier Ware einspringen, und für Kaviar ist wieder grünes Licht in der bundesdeutschen Speiseröhre.“"
                                            },
                                            {
                                                "example_id": "5169264c-b72d-4a60-a1d4-f497595df21a",
                                                "sense_id": "9de66ec2-ec81-3cb1-9f6b-d26e668a693f",
                                                "text": "„Mit aller Kraft hielt er den Brei au Cola und Brot, der in seiner Speiseröhre aufstieg, zurück.“"
                                            },
                                            {
                                                "example_id": "8250b275-7c91-47ed-be6e-8b50c637cf28",
                                                "sense_id": "9de66ec2-ec81-3cb1-9f6b-d26e668a693f",
                                                "text": "„Ein erster Geschmack von Erbrochenem kroch meine Speiseröhre hoch.“"
                                            },
                                            {
                                                "example_id": "aab0124e-9f66-46d9-acc0-2f538e7be551",
                                                "sense_id": "9de66ec2-ec81-3cb1-9f6b-d26e668a693f",
                                                "text": "„Der Kehldeckel ist ein elastisches Knorpelplättchen, das sich an das Zungenbein und die Spannknorpel des Kehlkopfes (…) mittelst elastischer Bänder anheftet, welche ihm, wenn er sich selbst überlassen bleibt, eine solche Stellung zu der Zungenwurzel sichern, dass ihn ein Flüssigkeitsstrom in der Richtung vom Schlund zur Speiseröhre gegen den Kehlkopf umklappt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
