                    {
                        "translation_id": "2c28447b-5d6b-425d-a9ff-86b47e9e92e0",
                        "source_entry_id": "65e69325-0fde-3165-b62e-9abf6f3eeac6",
                        "source_sense_description": "alleviation",
                        "target_lang_word": "смягче́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "смягче́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2782fcb1-688c-3925-b75f-7f100c92134d",
                                        "entry_id": "dbfee8eb-3d72-3539-8f8c-9015422801a7",
                                        "glosses": [
                                            "действие по значению гл. смягчать, смягчить, смягчаться, смягчиться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdecbb11-db54-43f5-a0fa-48eed24d1361",
                                                "sense_id": "2782fcb1-688c-3925-b75f-7f100c92134d",
                                                "text": "Но я верю, вы сами, дорогие читатели, вот-вот прочтёте, что и как хотите, с купюрами, без купюр, со смягчениями или усилениями, кому как будет угодно, я же не беру греха на душу в эту минуту: ни сокращать, ни редактировать, оскоплять Алешковского не могу."
                                            }
                                        ]
                                    },
