                                                "sense_id": "7d350df7-f11e-31ed-a62e-4f6605c30d05",
                                                "text": "Die ring is ingezet met een prachtige diamant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f41efed8-e5d8-30a0-9b0a-498b729906f7",
                                        "entry_id": "7e02228c-1074-3d83-beb8-d2b922658b39",
                                        "glosses": [
