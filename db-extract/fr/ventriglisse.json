                                        "entry_id": "356b5bc3-7acd-3969-b170-e9f982f5b457",
                                        "glosses": [
                                            "A toy consisting of a long sheet of thin plastic that can be connected to a hose to cover it in water through perforations along its length, producing a slippery surface for sliding on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10a5e67a-6ad7-41db-a768-502532303df0",
                                                "sense_id": "158b7a52-5c76-3aed-a3ce-08fdd54b4a70",
                                                "text": "After placing the slip-and-slide down at the far end of the yard, I walked back to where Ray was and watched him work."
                                            },
                                            {
                                                "example_id": "3372e5ee-e821-400c-8af4-5989c7f36517",
                                                "sense_id": "158b7a52-5c76-3aed-a3ce-08fdd54b4a70",
                                                "text": "Move garden toys, such as kiddie paddling pools and slip-and-slide water toys, around the lawn every few days or weekly during summer."
                                            },
                                            {
                                                "example_id": "d4ecc303-7fb6-4b8e-8ff0-87a2b1c75bd7",
                                                "sense_id": "158b7a52-5c76-3aed-a3ce-08fdd54b4a70",
                                                "text": "Just before I try to form a coherent thought Megan calls out to me, causing me to spin and trip over the bag I have resting next to me. Here I am, spread out on my tummy like I'm about to slide down a slip and slide for the whole place to witness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
