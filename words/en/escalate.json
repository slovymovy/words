{
    "word_family": [
        "escalation",
        "escalator",
        "de-escalate",
        "de-escalation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d368ba51-48e9-3f56-b469-e3e2b86bb1eb",
                    "sense_definition": "To increase rapidly in intensity, magnitude, or extent; to step up or intensify.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minor argument quickly <w>escalated</w> into a full-blown physical fight.",
                            "target_lang_translations": {
                                "ru": "Мелкая ссора быстро <w>переросла</w> в настоящую драку."
                            }
                        },
                        {
                            "text": "The government is worried that the local conflict might <w>escalate</w> into a regional war.",
                            "target_lang_translations": {
                                "ru": "Правительство обеспокоено тем, что локальный конфликт может <w>перерасти</w> в региональную войну."
                            }
                        }
                    ],
                    "antonyms": [
                        "de-escalate",
                        "diminish",
                        "decrease"
                    ],
                    "common_phrases": [
                        "escalate into",
                        "escalate the situation",
                        "escalate tensions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро увеличиваться по интенсивности, масштабу или степени; обостряться или усиливаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обостряться",
                                "target_lang_sense_clarification": "о конфликте или ситуации"
                            },
                            {
                                "target_lang_word": "перерастать",
                                "target_lang_sense_clarification": "во что-то более серьезное"
                            },
                            {
                                "target_lang_word": "усиливаться",
                                "target_lang_sense_clarification": "о напряжении или интенсивности"
                            },
                            {
                                "target_lang_word": "эскалировать",
                                "target_lang_sense_clarification": "формальный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b66bc2cf-92a4-35f6-84cf-74794c02c148",
                    "sense_definition": "To refer a matter or a customer to a higher level of authority or a more specialized department.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the customer service agent cannot solve your problem, they will <w>escalate</w> the issue to a manager.",
                            "target_lang_translations": {
                                "ru": "Если агент службы поддержки не сможет решить вашу проблему, он <w>передаст</w> этот вопрос менеджеру."
                            }
                        },
                        {
                            "text": "I need to <w>escalate</w> the ticket because it requires technical skills I do not have.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>эскалировать</w> этот запрос, так как он требует технических навыков, которых у меня нет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "escalate the issue",
                        "escalate to management",
                        "escalate a ticket"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business and technical support context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передать вопрос или клиента на более высокий уровень полномочий или в специализированный отдел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "на вышестоящий уровень"
                            },
                            {
                                "target_lang_word": "эскалировать",
                                "target_lang_sense_clarification": "в бизнес-контексте или техподдержке"
                            },
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "руководству или специалистам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "982d0fa2-5969-3a0d-ad24-4a47310f8649",
                    "sense_definition": "To climb or move upwards, often used metaphorically regarding social or professional progress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "climb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent years <w>escalating</w> the ladder of success within the corporate world.",
                            "target_lang_translations": {
                                "ru": "Она потратила годы, <w>поднимаясь</w> по лестнице успеха в корпоративном мире."
                            }
                        },
                        {
                            "text": "The athlete is slowly <w>escalating</w> up the rankings after a series of wins.",
                            "target_lang_translations": {
                                "ru": "Спортсмен медленно <w>поднимается</w> в рейтинге после серии побед."
                            }
                        }
                    ],
                    "common_phrases": [
                        "escalate the ladder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься или двигаться вверх, часто используется метафорически в отношении социального или профессионального прогресса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "по карьерной лестнице или рейтингу"
                            },
                            {
                                "target_lang_word": "продвигаться",
                                "target_lang_sense_clarification": "вверх по структуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e04e72a-19d4-3334-bf8f-b35a09b03621",
                    "sense_definition": "To travel or move by using an escalator.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were <w>escalating</w> up to the third floor of the shopping mall.",
                            "target_lang_translations": {
                                "ru": "Мы <w>поднимались на эскалаторе</w> на третий этаж торгового центра."
                            }
                        },
                        {
                            "text": "The commuters were <w>escalating</w> down to the subway platform in a steady stream.",
                            "target_lang_translations": {
                                "ru": "Пассажиры непрерывным потоком <w>спускались на эскалаторе</w> на платформу метро."
                            }
                        }
                    ],
                    "synonyms": [
                        "escalator"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rare usage derived from the noun escalator"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаться или ехать, используя эскалатор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься на эскалаторе",
                                "target_lang_sense_clarification": "движение вверх"
                            },
                            {
                                "target_lang_word": "спускаться на эскалаторе",
                                "target_lang_sense_clarification": "движение вниз"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}