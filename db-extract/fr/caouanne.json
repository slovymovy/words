                        "sense_id": "f3d60956-6df4-3c52-aa0d-1938b3f8d0a4",
                        "entry_id": "2f1f577f-b388-319c-a24f-ea937d31b9ee",
                        "glosses": [
                            "loggerhead turtle (Caretta caretta)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "5a4638e3-c832-4afa-bda8-a2132d4a9e13",
                                "sense_id": "f3d60956-6df4-3c52-aa0d-1938b3f8d0a4",
                                "text": "A l'instar des autres Cheloni[i]dae marins, la caouanne est parfaitement adaptée à son milieu.",
                                "translation": "Just like other marine Cheloniidae, the loggerhead turtle is perfectly adapted to its habitat.",
                                "english": "Just like other marine Cheloniidae, the loggerhead turtle is perfectly adapted to its habitat."
                            },
                            {
                                "example_id": "09e9b25d-38b7-4b6b-85a2-0bce5682a6fa",
                                "sense_id": "f3d60956-6df4-3c52-aa0d-1938b3f8d0a4",
                                "text": "A noter que la caouanne, Caretta caretta, semble effectivement ne plus pondre en Corse, l'espèce n'a pas complètement disparu des côtes de France où, chaque année, quelques individus sont capturés involuntairement par des engins de pêche.",
                                "translation": "It should be noted that the loggerhead turtle, Caretta caretta, no longer seems to lay eggs in Corsica, but the species has not completely disappeared from French coastlines where, each year, several individuals are caught unintentionally in fishing apparatus.",
                                "english": "It should be noted that the loggerhead turtle, Caretta caretta, no longer seems to lay eggs in Corsica, but the species has not completely disappeared from French coastlines where, each year, several individuals are caught unintentionally in fishing apparatus."
                            },
                            {
                                "example_id": "33264a43-5c6f-4498-9d36-a5680276dc73",
                                "sense_id": "f3d60956-6df4-3c52-aa0d-1938b3f8d0a4",
                                "text": "Au premier abord, la caouanne est une tortue à très grosse tête.",
                                "translation": "At first glance, the loggerhead is a turtle with a very large head.",
                                "english": "At first glance, the loggerhead is a turtle with a very large head."
                            }
                        ]
                    }
                ],
