{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "db6435de-62c0-3487-b82b-1d211523d2a4",
                    "sense_definition": "Used to tell someone to be quiet or shut up.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "silence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"<w>Chup</w>!\" she hissed, listening intently for footsteps in the corridor.",
                            "target_lang_translations": {
                                "ru": "«<w>Цыц</w>!» — прошипела она, внимательно вслушиваясь в шаги в коридоре."
                            }
                        },
                        {
                            "text": "He interrupted the argument loudly, shouting, \"<w>Chup</w>! Let him speak!\"",
                            "target_lang_translations": {
                                "ru": "Он громко прервал спор, закричав: «<w>Тихо</w>! Дайте ему сказать!»"
                            }
                        }
                    ],
                    "synonyms": [
                        "shut up",
                        "hush"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South Asian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы призвать к тишине или заставить замолчать; «тихо!», «заткнись!»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тихо",
                                "target_lang_sense_clarification": "призыв к молчанию"
                            },
                            {
                                "target_lang_word": "цыц",
                                "target_lang_sense_clarification": "грубый или резкий призыв замолчать"
                            },
                            {
                                "target_lang_word": "заткнись",
                                "target_lang_sense_clarification": "грубое требование прекратить говорить"
                            },
                            {
                                "target_lang_word": "молчать",
                                "target_lang_sense_clarification": "требование сохранять тишину"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "51ccd92b-30f2-3d87-ac44-1c0ebebef184",
                    "sense_definition": "Remaining silent or quiet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "silence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to keep <w>chup</w> about the scandal to avoid bad press.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>помалкивать</w> о скандале, чтобы избежать огласки в прессе."
                            }
                        },
                        {
                            "text": "He remained completely <w>chup</w> throughout the meeting despite his strong disagreement.",
                            "target_lang_translations": {
                                "ru": "Он оставался совершенно <w>безмолвным</w> на протяжении всей встречи, несмотря на своё категорическое несогласие."
                            }
                        }
                    ],
                    "synonyms": [
                        "silent",
                        "quiet"
                    ],
                    "antonyms": [
                        "vocal",
                        "noisy"
                    ],
                    "common_phrases": [
                        "keep chup"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South Asian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохраняющий молчание, тихий, молчаливый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молчаливый",
                                "target_lang_sense_clarification": "не говорящий ничего"
                            },
                            {
                                "target_lang_word": "тихий",
                                "target_lang_sense_clarification": "безмолвный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2566767f-a063-3aa6-9aac-72ab9b480bee",
                    "sense_definition": "A short, sharp, and urgent vocal sound, typically made by a bird.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bird_call",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The robin gave a sharp <w>chup</w> from the hedge as the cat approached.",
                            "target_lang_translations": {
                                "ru": "Зарянка издала резкое <w>чириканье</w> из живой изгороди, когда приблизилась кошка."
                            }
                        },
                        {
                            "text": "We listened closely to the sudden <w>chup</w> echoing through the morning mist.",
                            "target_lang_translations": {
                                "ru": "Мы внимательно прислушивались к внезапному <w>теньканью</w>, разносившемуся сквозь утренний туман."
                            }
                        }
                    ],
                    "synonyms": [
                        "chirp",
                        "chirrup",
                        "peep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий, резкий и тревожный звук, издаваемый птицей; чириканье, теньканье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чириканье",
                                "target_lang_sense_clarification": "птичий звук"
                            },
                            {
                                "target_lang_word": "теньканье",
                                "target_lang_sense_clarification": "резкий короткий звук птицы"
                            },
                            {
                                "target_lang_word": "писк",
                                "target_lang_sense_clarification": "короткий птичий звук"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b7dd3b5b-3165-3ab8-9e5c-beba697101e9",
                    "sense_definition": "To produce a short, sharp, and urgent sound, typically of a bird.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bird_call",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A nervous blackbird <w>chupped</w> repeatedly from the high branch of the oak.",
                            "target_lang_translations": {
                                "ru": "Встревоженный дрозд без умолку <w>тенькал</w> с высокой ветки дуба."
                            }
                        },
                        {
                            "text": "Small birds often <w>chup</w> to alert others of nearby predators.",
                            "target_lang_translations": {
                                "ru": "Маленькие птицы часто тревожно <w>чирикают</w>, чтобы предупредить остальных о приближении хищников."
                            }
                        }
                    ],
                    "synonyms": [
                        "chirp",
                        "chirrup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать короткий, резкий звук (обычно о птицах); чирикать, тенькать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чирикать",
                                "target_lang_sense_clarification": "издавать птичьи звуки"
                            },
                            {
                                "target_lang_word": "тенькать",
                                "target_lang_sense_clarification": "издавать короткий резкий звук"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}