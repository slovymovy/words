                ],
                "senses": [
                    {
                        "sense_id": "87c3e858-7a2b-33c3-b717-84684d85966c",
                        "entry_id": "ba6391cc-9686-3b8d-b516-64830c43daeb",
                        "glosses": [
                            "Mauser (firearm)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beed8b02-255f-4c89-9769-0080f4f8b2ba",
                                "sense_id": "87c3e858-7a2b-33c3-b717-84684d85966c",
                                "text": "— Тебе́, дя́денька, лу́чше всего́ на са́мый верх, где билья́рдные, — посове́товал мальчи́шка, — там на кры́ше отсиди́шься, е́сли с ма́узером.",
                                "translation": "\"You'd better go right to the top, mister, where the billiard tables are,\" the boy advised him. \"You can sit it out on the roof, if you've got a Mauser.\"",
                                "english": "\"You'd better go right to the top, mister, where the billiard tables are,\" the boy advised him. \"You can sit it out on the roof, if you've got a Mauser.\""
                            }
                        ]
                    }
                ],
