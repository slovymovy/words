                "senses": [
                    {
                        "sense_id": "7a548c38-8d83-33cb-8f33-2a32b7e0199a",
                        "entry_id": "a87fc4ad-d383-31d0-9de7-9f604edb71de",
                        "glosses": [
                            "De manière humoristique."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a83d615e-4b31-4ee9-9a77-944a27394652",
                                "sense_id": "7a548c38-8d83-33cb-8f33-2a32b7e0199a",
                                "text": "Pencroff ne marchandait pas les éloges à ce qu’il appelait humoristiquement « son appartement au cinquième au-dessus de l’entresol ! »"
                            },
                            {
                                "example_id": "647ee18f-8e40-4905-add2-a81007954912",
                                "sense_id": "7a548c38-8d83-33cb-8f33-2a32b7e0199a",
                                "text": "C’est d’ailleurs ce final qui est humoristiquement choisi par l’un et l’autre auteur, mais sa valeur ne semble pas du tout être cathartique, elle est plutôt apotropaïque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03117b40-8ece-40c7-9e1e-b5771f738cca",
                        "source_entry_id": "a87fc4ad-d383-31d0-9de7-9f604edb71de",
                        "source_sense_id": "7a548c38-8d83-33cb-8f33-2a32b7e0199a",
                        "target_lang_word": "jocularly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jocularly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "943f324a-56d6-32ae-8464-66b51f38c1fb",
                                        "entry_id": "98dc1733-6c9d-3c09-a494-19c41753933c",
                                        "glosses": [
                                            "In a jocular manner; humorously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cd2c671-75f5-4ca9-9326-500b7c36065e",
                                                "sense_id": "943f324a-56d6-32ae-8464-66b51f38c1fb",
                                                "text": "He was in such a good mood that he even managed to take out the rubbish jocularly."
                                            },
                                            {
                                                "example_id": "392cb4bc-9f17-4515-84c2-affe07c8ab77",
                                                "sense_id": "943f324a-56d6-32ae-8464-66b51f38c1fb",
                                                "text": "She was not embarrassed at all so she told the story jocularly."
                                            },
                                            {
                                                "example_id": "70924fd9-1339-4be4-ae8f-9da0c1b4108b",
                                                "sense_id": "943f324a-56d6-32ae-8464-66b51f38c1fb",
                                                "text": "Sullenly, jocularly, resentfully, or derisively, names and addresses were extorted from the company, and each member given a jerk of the head to get out of this."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c54811b-8771-459a-bd08-b6f8f6d54e58",
                        "source_entry_id": "a87fc4ad-d383-31d0-9de7-9f604edb71de",
                        "source_sense_id": "7a548c38-8d83-33cb-8f33-2a32b7e0199a",
                        "target_lang_word": "humorously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
