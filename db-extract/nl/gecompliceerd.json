                                        "sense_id": "fe2c9541-eafe-3034-874d-fd718d287fdf",
                                        "entry_id": "6cc96e32-00e5-3624-8114-64f11a83b68f",
                                        "glosses": [
                                            "simple past and past participle of complicate"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d9ba31d-cde7-4d67-bcd3-7db0737cef11",
                                                "sense_id": "fe2c9541-eafe-3034-874d-fd718d287fdf",
                                                "text": "The process of fixing the car engine was complicated by the lack of tools."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "complicated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb969397-d652-3f9b-afda-95855d579233",
                                        "entry_id": "e666c95b-84bb-358f-8d90-276be63195d6",
                                        "glosses": [
                                            "Difficult or convoluted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98011bf8-a306-4a22-b5ca-c60e6a28562c",
                                                "sense_id": "fb969397-d652-3f9b-afda-95855d579233",
                                                "text": "It seems this complicated situation will not blow over soon."
                                            },
                                            {
                                                "example_id": "a1a4acde-3dff-4564-84b8-dfd61cb35af9",
                                                "sense_id": "fb969397-d652-3f9b-afda-95855d579233",
                                                "text": "But there always is in my mind something at once ludicrous and mournful in a crowd congregated for the purpose of amusement. What discontent, what vanity, move the complicated wheels of the social machine!"
                                            },
                                            {
                                                "example_id": "2eb590e0-3802-4b22-8255-a65efe6af5d1",
                                                "sense_id": "fb969397-d652-3f9b-afda-95855d579233",
                                                "text": "Mind you, clothes were clothes in those days. […] Frills, ruffles, flounces, lace, complicated seams and gores: not only did they sweep the ground and have to be held up in one hand elegantly as you walked along, but they had little capes or coats or feather boas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef79a6e2-b407-3418-b9e6-c7c91b40b71f",
                                        "entry_id": "e666c95b-84bb-358f-8d90-276be63195d6",
                                        "glosses": [
                                            "Folded longitudinally (as in the wings of certain insects)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
