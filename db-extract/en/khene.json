    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "792dda34-2a94-3d00-bb21-a2ead44080c3",
                "word": "khene",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7b3cf6fb-3465-4f2b-9764-fef41f8a0954",
                        "entry_id": "792dda34-2a94-3d00-bb21-a2ead44080c3",
                        "tags": [
                            "plural"
                        ],
                        "form": "khenes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17330d62-df68-3dec-8eef-4070f8ac33f1",
                        "entry_id": "792dda34-2a94-3d00-bb21-a2ead44080c3",
                        "glosses": [
                            "A traditional musical instrument of Laos, being a type of bamboo mouth organ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c245449-7f5b-4780-bb73-0e4e24dbd5b0",
                                "sense_id": "17330d62-df68-3dec-8eef-4070f8ac33f1",
                                "text": "There are processions led by dancers with castanets and accompanied by musicians playing the Kène."
                            },
                            {
                                "example_id": "c0f52d87-ba7b-4772-9176-75515db65b70",
                                "sense_id": "17330d62-df68-3dec-8eef-4070f8ac33f1",
                                "text": "The khene was once used to call warriors to fight. Now it is used for ceremonies."
                            },
                            {
                                "example_id": "cd773366-4747-4bef-9d1b-905a5d490988",
                                "sense_id": "17330d62-df68-3dec-8eef-4070f8ac33f1",
                                "text": "The Lao khaen, however, is the most sophisticated of all the bamboo mouth organs – it takes great skill to play it properly."
                            },
                            {
                                "example_id": "49e9ec2d-8b03-428d-9777-84b91f6985f6",
                                "sense_id": "17330d62-df68-3dec-8eef-4070f8ac33f1",
                                "text": "I then suggested that he should play a tune on the khène while I improvised an accompaniment on the ukelele."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c63e428-2c4f-4f5a-b67c-ae4817cc4c27",
