                    {
                        "sense_id": "20086c6b-f9a8-3261-921c-b5ce6f0d31b7",
                        "entry_id": "fd6d25a8-1670-3fa1-b6ee-58d8d63903a9",
                        "glosses": [
                            "Satakam, set of one hundred verses connected by the same metre or topic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9856328-0a36-4c4d-96e4-a91d63f513dc",
                                "sense_id": "20086c6b-f9a8-3261-921c-b5ce6f0d31b7",
                                "text": "Tonda-mandala-sātacam, a centum of verses on the Conjeveram country, No. 148, C. M. 73. The sātacam is a poem of one hundred stanzas, in its appropriate metre."
                            },
                            {
                                "example_id": "25b67b39-0745-4f50-8538-31d4de7f05f0",
                                "sense_id": "20086c6b-f9a8-3261-921c-b5ce6f0d31b7",
                                "text": "Norman Cutler's Songs of Experience: The Poetics of Tamil Devotion (1987) provides a partial translation, choosing to translate just 50 hymns from the first two centums and a few phalasrutis, or the signature stanzas."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5549663-17f6-3ee8-9a18-259b54622e93",
                        "entry_id": "fd6d25a8-1670-3fa1-b6ee-58d8d63903a9",
                        "glosses": [
                            "Perfect score on a board exam."
                        ],
                        "tags": [
                            "India"
                        ],
                        "examples": [
                            {
                                "example_id": "3b850c2e-4fdc-4f45-a820-5ed522209c43",
                                "sense_id": "b5549663-17f6-3ee8-9a18-259b54622e93",
                                "text": "Achyuta Satakam is a centum in Prakrit Language; Devanayaka Panchasat (the fifty on Devanayaka), in sanskrit and several poetical works in Tamil."
                            },
                            {
                                "example_id": "c3e9f68c-4225-4673-91f4-688ba59645a7",
                                "sense_id": "b5549663-17f6-3ee8-9a18-259b54622e93",
                                "text": "Though he secured a centum in mathematics, he failed to secure pass marks in other subjects."
                            },
                            {
                                "example_id": "65a519c0-7a67-4027-b716-a6dd53f42069",
                                "sense_id": "b5549663-17f6-3ee8-9a18-259b54622e93",
                                "text": "Ramesh scored a centum in mathematics."
                            }
                        ]
                    }
