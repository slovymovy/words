                "senses": [
                    {
                        "sense_id": "5aa845f9-9f8e-30ec-9231-9b6616d76500",
                        "entry_id": "6975f57b-dfd9-38e3-8c16-af0d8edb218b",
                        "glosses": [
                            "ten, kto ma nadzór nad zakrystią, kościelny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c36f5ad-a90f-4806-9257-4c8f5037a08b",
                                "sense_id": "5aa845f9-9f8e-30ec-9231-9b6616d76500",
                                "text": "W szafie ojca Masseo zakrystian znalazł złotą stułę."
                            },
                            {
                                "example_id": "e1136498-4fca-4bd5-80ad-7a11a6decb07",
                                "sense_id": "5aa845f9-9f8e-30ec-9231-9b6616d76500",
                                "text": "Br. Radosław wziął udział w rekolekcjach dla zakrystianów na Jasnej Górze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f7c30d1-60c1-4173-a10d-0905449922bd",
                        "source_entry_id": "6975f57b-dfd9-38e3-8c16-af0d8edb218b",
                        "source_sense_id": "5aa845f9-9f8e-30ec-9231-9b6616d76500",
                        "target_lang_word": "sacristan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacristan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                        "entry_id": "e130134f-83ea-3a2f-94b6-aaad8e741b46",
                                        "glosses": [
                                            "The person who maintains the sacristy and the sacred objects it contains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba3b748-f30d-4314-8543-b571936bdd5c",
                                                "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                                "text": "And hence the custom and law began\nThat still at dawn the sacristan,\nWho duly pulls the heavy bell,\nFive and forty beads must tell\nBetween each stroke"
                                            },
                                            {
                                                "example_id": "ee79d4c1-e753-4ebb-ab50-872274645435",
                                                "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                                "text": "[…] every evening as the temple was closed for the night the sacristan paused: \"Pindar to supper with the god!\" he cried."
                                            },
                                            {
                                                "example_id": "63c00b8f-1559-43f4-8031-d2fa1aecfb87",
                                                "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                                "text": "The church was looked after by an old sacristan who lived in a cottage on the shore of the lake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57a9ce1f-da99-4023-ab11-4457f27ad955",
                        "source_entry_id": "6975f57b-dfd9-38e3-8c16-af0d8edb218b",
                        "source_sense_id": "5aa845f9-9f8e-30ec-9231-9b6616d76500",
                        "target_lang_word": "sakristán",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "37df83bf-94cf-4df0-82a0-4b47d0b53f83",
                        "source_entry_id": "6975f57b-dfd9-38e3-8c16-af0d8edb218b",
                        "source_sense_id": "5aa845f9-9f8e-30ec-9231-9b6616d76500",
                        "target_lang_word": "sacristain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacristain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a6ab312-7026-39af-829d-9fdd05f017dd",
                                        "entry_id": "5feeea76-9cde-3f57-8535-2b8d1a1e125a",
                                        "glosses": [
                                            "Personne chargée de la bonne marche matérielle d’une église et de sa sacristie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6d54701-3a58-444f-9d56-d614f0dfbe81",
                                                "sense_id": "3a6ab312-7026-39af-829d-9fdd05f017dd",
                                                "text": "Je suis boiteux, comme vous voyez, et je l’ai été de jeunesse. C’est pour ça qu’on m’a fait sacristain ; je balaie l’église et je sers la messe ; je suis fossoyeur aussi, et j’ai appris à faire la cuisine. C’est moi qui fais les repas de noces et les enterrements, sans compter que j’aide aux baptêmes."
                                            },
                                            {
                                                "example_id": "e80fcddb-2eee-4185-b60a-4d48dfb99ab9",
                                                "sense_id": "3a6ab312-7026-39af-829d-9fdd05f017dd",
                                                "text": "Le sacristain m'avait vu endormi ; mais, connaissant mes habitudes, et sachant que j'avais sur moi une clef de la petite porte de l'église, il n'avait pas même songé à m'éveiller."
                                            },
                                            {
                                                "example_id": "3ac27d00-ff65-4917-aaad-3a429321cde5",
                                                "sense_id": "3a6ab312-7026-39af-829d-9fdd05f017dd",
                                                "text": "Le diable, ce soir-là, avait pris la face ronde et les traits indécis du jeune sacristain pour mieux induire le révérend père en tentation et lui faire commettre un épouvantable péché de gourmandise."
                                            },
                                            {
                                                "example_id": "15475e28-437e-4d87-90ad-e1ec33ed85f9",
                                                "sense_id": "3a6ab312-7026-39af-829d-9fdd05f017dd",
                                                "text": "Un sacristain s’introduisit par une petite porte ouverte dans l’autre aile du transept, alluma les cierges du maître-autel […]."
                                            },
                                            {
                                                "example_id": "1d2c104a-4a41-4db1-b91a-5c5e417ab83a",
                                                "sense_id": "3a6ab312-7026-39af-829d-9fdd05f017dd",
                                                "text": "Si tu veux que je te dise, les tiens m’ont l’air trop sérieux, ils ne gueulent pas assez fort, et j’aurais presque peur de les voir prendre plus tard ces airs de sacristain qui ne conviennent qu’à leur père."
                                            },
                                            {
                                                "example_id": "50f57389-c269-4f13-aaf5-3ad0caf7a086",
                                                "sense_id": "3a6ab312-7026-39af-829d-9fdd05f017dd",
                                                "text": "Alors, oubliant qu’il avait l’avant-veille troussé une fille dans les prés de la rivière, il prenait la mine vertueuse et offensée d’un sacristain égaré en mauvaise compagnie."
                                            },
                                            {
                                                "example_id": "74589f0b-4859-4746-81af-6c55c1e571d1",
                                                "sense_id": "3a6ab312-7026-39af-829d-9fdd05f017dd",
                                                "text": "Alors, nous avons fait le tour jusqu’à la grande grille, et j’ai sonné comme un sacristain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3bc91b1-2b32-3f59-86e4-a848204764a8",
                                        "entry_id": "5feeea76-9cde-3f57-8535-2b8d1a1e125a",
                                        "glosses": [
                                            "Petit gâteau fait d’un bâtonnet de pâte feuilletée torsadé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0523c2db-3f53-429e-8ce9-aaf4b2c59025",
                        "source_entry_id": "6975f57b-dfd9-38e3-8c16-af0d8edb218b",
                        "source_sense_id": "5aa845f9-9f8e-30ec-9231-9b6616d76500",
                        "target_lang_word": "sacristán",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacristán",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "1acff202-622a-3740-af10-4d49f4b23f1a",
                                        "entry_id": "ca137367-877d-3273-bf62-0a8bce54c4b3",
                                        "glosses": [
                                            "Persona que asiste al sacerdote en labores de cuidado y limpieza de la iglesia, sacristía, así como de los objetos sagrados que contienen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de4d08a1-193d-4268-bb19-3f1df7d7503d",
                                                "sense_id": "1acff202-622a-3740-af10-4d49f4b23f1a",
                                                "text": "Cómo lograste tanta precisión\ndescribiendo a mi pueblo blanco y polvoriento\nsi el sacristán por ahí no te vio,\nni el cura, ni el cabo, ni el polvo ni el viento."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c4015dd-b5a6-35ee-91d3-3ffb199e9299",
                                        "entry_id": "ca137367-877d-3273-bf62-0a8bce54c4b3",
                                        "glosses": [
                                            "Persona pícara."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "sacristán",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b443b9ab-dbcb-34fa-9325-6fb41e061c18",
                                        "entry_id": "cc88ef68-4120-367d-9496-92fd0f4cc6f6",
                                        "glosses": [
                                            "Dignidad eclesiástica a cuyo cargo estaba la custodia y guarda de los vasos, vestiduras y libros sagrados, y la vigilancia de todos los dependientes de la sacristía. Hoy se conserva en algunas catedrales, y en las órdenes militares; en otras ha mudado el nombre, por lo común, en el de tesorero."
                                        ],
