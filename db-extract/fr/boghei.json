                "senses": [
                    {
                        "sense_id": "f0a64a3d-f43f-3ba8-90a2-79d03a17b177",
                        "entry_id": "ec13a2bc-976a-3065-a095-e23e8931d4b6",
                        "glosses": [
                            "Sorte de voiture hippomobile légère, de petit cabriolet découvert."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2ca7849e-1221-4646-b49d-a90d481fa3cb",
                                "sense_id": "f0a64a3d-f43f-3ba8-90a2-79d03a17b177",
                                "text": "Tant de bogheis, de phaétons, de milords n’étaient pas inutiles à un agité, qui du matin au soir, parcourait Paris."
                            },
                            {
                                "example_id": "cd5f54c1-8d34-414f-b253-dc030070cccb",
                                "sense_id": "f0a64a3d-f43f-3ba8-90a2-79d03a17b177",
                                "text": "Les bogheis, qu'on était allé décrotter à la rivière en baignant les roues jusqu'aux moyeux, roulaient sur la longue route grise, brillant aux rayons du soleil."
                            },
                            {
                                "example_id": "ee64f828-552c-4dd0-8a80-56ac30e7126f",
                                "sense_id": "f0a64a3d-f43f-3ba8-90a2-79d03a17b177",
                                "text": "Alors, la tante Marie alla frapper aux volets d'un voisin, qui possédait un boghei et un petit cheval. C'était une époque bénie, où les gens se rendaient service : il n'y avait qu'à demander."
                            }
                        ]
                    }
