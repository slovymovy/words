                                        "entry_id": "138227c9-d8f8-3858-ac85-7465fd3386b3",
                                        "glosses": [
                                            "spottende benaming voor een meisje of jonge vrouw in de puberteit of adolescentie wier gedrag nog niet van volwassenheid getuigt"
                                        ],
