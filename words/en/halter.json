                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a light blue <w>halter</w> with white linen shorts to the beach party."
                        },
                        {
                            "text": "During the warm summer months, she prefers wearing a cotton <w>halter</w> when going outside."
                        }
                    ],
                    "common_phrases": [
                        "halter neck",
                        "halter dress"
                    ]
                },
                {
                    "sense_id": "d144c997-819f-317a-9e1b-b37ca4bf8a98",
                    "sense_definition": "A strap or rope fitted around an animal's head, used for leading or tethering it.",
