                    {
                        "translation_id": "961a4344-9014-47fd-95aa-fe608e62b19f",
                        "source_entry_id": "42f69270-48cd-3826-8f07-cac51ec70647",
                        "source_sense_id": "55a3966c-9b08-35f6-82c6-649552c3e044",
