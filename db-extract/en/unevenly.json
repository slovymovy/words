                        "entry_id": "419f340d-6081-312a-8390-428c7c5f7283",
                        "glosses": [
                            "In an uneven or haphazard manner."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "100527c3-7dd7-3361-8f18-40df26f56132",
                        "entry_id": "419f340d-6081-312a-8390-428c7c5f7283",
                        "glosses": [
                            "In an unequal manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fa244b9-7751-4c72-91bc-8b8eba695dbe",
                                "sense_id": "100527c3-7dd7-3361-8f18-40df26f56132",
                                "text": "Put easily, instamining is a method that enables coins to be issued unfairly or unevenly."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbf07140-9ff0-43c3-bfb0-3e13f6e87ea3",
                        "source_entry_id": "419f340d-6081-312a-8390-428c7c5f7283",
                        "source_sense_description": "in an uneven manner",
                        "target_lang_word": "неро́вно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неро́вно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5db3f94c-47c4-31cf-86b3-adfd22b5f9d4",
                                        "entry_id": "c7126cff-7496-34c0-889e-fea739f07bee",
                                        "glosses": [
                                            "наречие к неровный; негладко, шероховато"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df523140-a236-49eb-992e-0ee65a61f40f",
                                                "sense_id": "5db3f94c-47c4-31cf-86b3-adfd22b5f9d4",
                                                "text": "Мы не пошли ни в деревню Бо-Тсунг, ни на большую дорогу, а взяли налево, прорезали рощу и очутились в обработанных полях, идущих неровно, холмами, во все стороны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "232faf73-a194-37b2-bb2b-70b68b9de70f",
                                        "entry_id": "c7126cff-7496-34c0-889e-fea739f07bee",
                                        "glosses": [
                                            "криво, непрямо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c46a303-a05e-408b-b6e6-5f85ddffbc9d",
                                                "sense_id": "232faf73-a194-37b2-bb2b-70b68b9de70f",
                                                "text": "Эти два слова были написаны так криво и неровно, что я долго думал: не переписать ли?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa7e2d1f-f72f-3734-80e2-aa7a9c97ab2e",
                                        "entry_id": "c7126cff-7496-34c0-889e-fea739f07bee",
                                        "glosses": [
                                            "неодинаково по размеру, форме, объёму, качествам, свойствам и т.п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52242540-38bf-4513-8128-0057ed8460f9",
                                                "sense_id": "aa7e2d1f-f72f-3734-80e2-aa7a9c97ab2e",
                                                "text": "Накануне был зазимок, снег неровно покрыл поля, дорогу и крыши…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "204d56a2-b70b-30da-9b4c-8458b51ce093",
                                        "entry_id": "c7126cff-7496-34c0-889e-fea739f07bee",
                                        "glosses": [
                                            "сбивчиво, неравномерно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b67bb648-a8ce-437e-98e1-15d87383dc52",
                                                "sense_id": "204d56a2-b70b-30da-9b4c-8458b51ce093",
                                                "text": "То был румянец лихорадочного волнения, ибо он слышал, как неровно и часто стучало её маленькое сердце на его груди."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49511064-ce6c-37e6-a663-ccf37d215e28",
                                        "entry_id": "c7126cff-7496-34c0-889e-fea739f07bee",
                                        "glosses": [
                                            "прост. то же, что неравно́; не ровен час"
                                        ],
                                        "tags": [
                                            "частица"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fc1af21-aea6-4966-8947-ae6fb7077327",
                                                "sense_id": "49511064-ce6c-37e6-a663-ccf37d215e28",
                                                "text": "― Нет, ступай лучше один, а то неровно мы с ним разойдемся."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e77cae5-c812-406f-9608-b76689cd2a95",
                        "source_entry_id": "419f340d-6081-312a-8390-428c7c5f7283",
                        "source_sense_description": "in an unequal manner",
                        "target_lang_word": "неравноме́рно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неравноме́рно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "acaaeb44-982a-38c1-bce1-0af48a4d5433",
                                        "entry_id": "7b9d4553-07a3-3be3-8a48-a059ae8f2fc8",
                                        "glosses": [
                                            "наречие к неравномерный; по-разному в разных частях, в разные моменты времени"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6be1b151-9c41-4e40-801d-7c233dfbd8d9",
                                                "sense_id": "acaaeb44-982a-38c1-bce1-0af48a4d5433",
                                                "text": "Я ведь долгое время зарабатывал неравномерно, приходилось уезжать надолго в командировки, чтобы подмолотить погуще и облегчить семью, сам-то как-нибудь перебьюсь, но и им без меня проще."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
