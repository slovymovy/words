                    "target_lang_definitions": {
                        "en": "To experience use or benefit from something.",
                        "ru": "Получать пользу или выгоду от чего-либо.",
                        "fr": "Tirer profit ou utilité de quelque chose."
                    },
                    "translations": {
                        "en": [
