                                    {
                                        "sense_id": "7c56c1ad-979a-3954-a8e2-87633ad97a53",
                                        "entry_id": "418b27b6-29ba-3add-9637-15a11c752449",
                                        "glosses": [
                                            "Sammelbegriff für krankhafte Zustände des Gehirns unterschiedlicher Ursache und Ausprägung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb3bf7f-4656-4a7b-b931-be254a2c26f3",
                                                "sense_id": "7c56c1ad-979a-3954-a8e2-87633ad97a53",
                                                "text": "„Francisco Goya, vergiftet von dem Blei in seinen hellen Farben. Farben, die er mit Fingern und Daumen auftrug, bis er sich eine von Blei ausgelöste Enzephalopathie zuzog, die in seinem Fall zu Taubheit, Depressionen und Wahnsinn führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b2f2ea4-45c0-41dd-9e24-2f2c339fe690",
                        "source_entry_id": "e2696418-c742-3e4d-9d61-35631087415b",
                        "source_sense_id": "f45a5ec4-0e87-382a-9016-2acc4ecf6f52",
