                ],
                "senses": [
                    {
                        "sense_id": "c70522f3-44b3-329b-b652-7d4666d54cec",
                        "entry_id": "7cf1b32c-f5df-3d27-89b3-869264bb9a97",
                        "glosses": [
                            "Vorgang, bei dem etwas zu Aktivität angeregt wird; Aktivierung"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "793b2831-7987-31ac-98eb-a96400fe1255",
                        "entry_id": "7cf1b32c-f5df-3d27-89b3-869264bb9a97",
                        "glosses": [
                            "Anschließung an ein Netz; Freischaltung"
                        ],
