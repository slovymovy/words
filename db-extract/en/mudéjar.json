        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "45e61625-33e5-3345-99ab-cbda817d5454",
                "word": "Mudéjar",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "09272317-aa22-3e82-b447-d44f00abcbc2",
                        "entry_id": "45e61625-33e5-3345-99ab-cbda817d5454",
                        "glosses": [
                            "Of or pertaining to the Moors of Al-Andalus who remained in Christian territory after the Reconquista but were not converted to Christianity."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8c59cf04-d0fb-4572-aa35-c24a073fc1df",
                                "sense_id": "09272317-aa22-3e82-b447-d44f00abcbc2",
                                "text": "We must not forget that Mudejar identity was a contractual identity, entered into through myriad treaties between conquerors and conquered, each different from the other, and each subject to constant renegotiation, reinterpretation, and change depending on circumstance."
                            }
                        ]
                    },
                    {
                        "sense_id": "b335788c-5f3e-30ad-8fda-6897a1702c35",
                        "entry_id": "45e61625-33e5-3345-99ab-cbda817d5454",
                        "glosses": [
                            "Of or pertaining to the style of Iberian architecture and decoration of the 12th to 16th centuries."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1e3cb93e-6804-4a8a-9144-321082b67a24",
                                "sense_id": "b335788c-5f3e-30ad-8fda-6897a1702c35",
                                "text": "These artisans and workers used particular techniques that earlier Muslims under Christian rule had refined into the Mudéjar style."
                            }
                        ]
                    }
                ],
