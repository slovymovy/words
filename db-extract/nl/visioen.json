                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "095d81c5-ac12-3da4-8172-bffa929428bc",
                                        "entry_id": "3ed341b8-3bd8-32b5-8354-5ba7b44a78b0",
                                        "glosses": [
                                            "The sense or ability of sight."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54b8864c-0b19-32ae-9af1-cbe34e7e5ef3",
                                        "entry_id": "3ed341b8-3bd8-32b5-8354-5ba7b44a78b0",
                                        "glosses": [
                                            "Something seen; an object perceived visually."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50b73879-32fd-49f7-9308-edf2b46b23f5",
                                                "sense_id": "54b8864c-0b19-32ae-9af1-cbe34e7e5ef3",
                                                "text": "[…]For to a Viſion ſo apparant, Rumor / Cannot be mute[…]"
                                            },
                                            {
                                                "example_id": "0404a0d1-392b-4b56-8c58-245a9338dacd",
                                                "sense_id": "54b8864c-0b19-32ae-9af1-cbe34e7e5ef3",
                                                "text": "It was the Lost Oasis, the Oasis of the vision in the sand. […] Deep-hidden in the hollow, beneath the cliffs, it lay; and round it the happy verdure spread for many a rood. […] Yes, the quest was ended, the Lost Oasis was the Found!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6be293be-a683-30fa-b8dc-731f2ed85568",
                                        "entry_id": "3ed341b8-3bd8-32b5-8354-5ba7b44a78b0",
                                        "glosses": [
                                            "Something imaginary one thinks one sees."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7da1a91-7540-4000-becb-116808b232ef",
                                                "sense_id": "6be293be-a683-30fa-b8dc-731f2ed85568",
                                                "text": "He tried drinking from the pool of water, but realized it was only a vision."
                                            },
                                            {
                                                "example_id": "45819cf1-587f-4b9a-9e7f-ec21f84d17ab",
                                                "sense_id": "6be293be-a683-30fa-b8dc-731f2ed85568",
                                                "text": "Visitations are a commonly reported afterlife phenomenon. For example, a dying patient has a vision of her mother, who has been dead for twenty years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f06dc25c-37a0-3c23-bcc4-5b99b215d9af",
                                        "entry_id": "3ed341b8-3bd8-32b5-8354-5ba7b44a78b0",
                                        "glosses": [
                                            "Something unreal or imaginary; a creation of fancy."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9564d5d-3ca7-4fa6-bf1e-3c89d43acadc",
                                                "sense_id": "f06dc25c-37a0-3c23-bcc4-5b99b215d9af",
                                                "text": "For having the Idea of any thing in our Mind, no more proves the Exiſtence of that Thing, than the Picture of a Man evidences his being in the World, or the Viſions of a Dream make thereby a true Hiſtory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "259bc87c-bb10-3171-a65b-23a19024a75f",
                                        "entry_id": "3ed341b8-3bd8-32b5-8354-5ba7b44a78b0",
                                        "glosses": [
                                            "A perceived potential future event or occurrence."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2d318c-336f-4ddd-929d-4d70c7a7cdc8",
                                                "sense_id": "259bc87c-bb10-3171-a65b-23a19024a75f",
                                                "text": "I know you wanted me to stay\nBut I can't ignore the crazy visions of me in LA"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d892cf76-771a-3bb1-8850-3708387fc3a2",
                                        "entry_id": "3ed341b8-3bd8-32b5-8354-5ba7b44a78b0",
                                        "glosses": [
                                            "An ideal or a goal toward which one aspires."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81ed9f62-003a-4c80-b5e1-7c243030840e",
                                                "sense_id": "d892cf76-771a-3bb1-8850-3708387fc3a2",
                                                "text": "He worked tirelessly toward his vision of world peace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4a071a0-bb1c-3721-a40b-2db2fb18b099",
                                        "entry_id": "3ed341b8-3bd8-32b5-8354-5ba7b44a78b0",
                                        "glosses": [
                                            "General aspiration; forward-thinkingness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09f7ffb0-da18-4015-99d1-a56a409f9af3",
                                                "sense_id": "a4a071a0-bb1c-3721-a40b-2db2fb18b099",
                                                "text": "I can't stand this indecision\nMarried with a lack of vision\nEverybody wants to rule the—"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5658bfff-1806-3252-997e-8ae464b2cdc2",
                                        "entry_id": "3ed341b8-3bd8-32b5-8354-5ba7b44a78b0",
                                        "glosses": [
                                            "A religious or mystical experience of a supernatural appearance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9426653-3741-41da-a35f-68f7384eb5af",
                                                "sense_id": "5658bfff-1806-3252-997e-8ae464b2cdc2",
                                                "text": "He had a vision of the Virgin Mary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4613ff99-d499-3127-bac6-6616c764b04a",
                                        "entry_id": "3ed341b8-3bd8-32b5-8354-5ba7b44a78b0",
                                        "glosses": [
                                            "A person or thing of extraordinary beauty."
                                        ],
