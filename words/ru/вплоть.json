{
    "word_family": [
        "плотный",
        "вплотную",
        "сплотить",
        "уплотнить",
        "оплот"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5ee04fc6-fdf7-34eb-819e-c68b59919b72",
                    "sense_definition": "Указывает на предел в пространстве или времени, до которого продолжается действие или состояние (обычно употребляется с предлогом «до»).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы работали в саду <w>вплоть</w> до самого вечера.",
                            "target_lang_translations": {
                                "en": "We worked in the garden <w>right up</w> to the very evening.",
                                "de": "Wir haben <w>bis</w> in den späten Abend hinein im Garten gearbeitet."
                            }
                        },
                        {
                            "text": "Я читал эту интересную книгу <w>вплоть</w> до рассвета.",
                            "target_lang_translations": {
                                "en": "I read this interesting book <w>up</w> to dawn.",
                                "de": "Ich habe dieses interessante Buch <w>bis</w> zum Morgengrauen gelesen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "вплоть до конца",
                        "вплоть до утра",
                        "вплоть до вечера"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates a limit in space or time up to which an action or state continues.",
                        "de": "Bezeichnet eine zeitliche oder räumliche Grenze, bis zu der eine Handlung oder ein Zustand andauert."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "up to",
                                "target_lang_sense_clarification": "indicating a limit in time or space"
                            },
                            {
                                "target_lang_word": "until",
                                "target_lang_sense_clarification": "specifically regarding time"
                            },
                            {
                                "target_lang_word": "right up to",
                                "target_lang_sense_clarification": "emphatic form indicating the very limit"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bis hin zu",
                                "target_lang_sense_clarification": "betont die zeitliche oder räumliche Grenze"
                            },
                            {
                                "target_lang_word": "bis",
                                "target_lang_sense_clarification": "allgemeine Angabe einer zeitlichen Grenze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "199972f8-a0d7-3230-a33c-435d36299ae6",
                    "sense_definition": "Употребляется для выделения кого-либо или чего-либо, включенного в перечисление; включая.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все сотрудники, <w>вплоть</w> до директора, пришли на собрание.",
                            "target_lang_translations": {
                                "en": "All the employees, <w>up</w> to the director, came to the meeting.",
                                "de": "Alle Mitarbeiter, <w>bis hin zum</w> Direktor, kamen zur Versammlung."
                            }
                        },
                        {
                            "text": "Она помнила всё <w>вплоть</w> до мельчайших деталей.",
                            "target_lang_translations": {
                                "en": "She remembered everything, <w>down</w> to the smallest details.",
                                "de": "Sie erinnerte sich an alles, <w>bis hin zu</w> den kleinsten Details."
                            }
                        }
                    ],
                    "synonyms": [
                        "включая"
                    ],
                    "antonyms": [
                        "за исключением",
                        "не считая"
                    ],
                    "common_phrases": [
                        "вплоть до мелочей"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to highlight someone or something included in a list or range, often to emphasize the extent.",
                        "de": "Wird verwendet, um jemanden oder etwas in einer Aufzählung hervorzuheben, einschließlich extremer Beispiele."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "down to",
                                "target_lang_sense_clarification": "used when emphasizing details or smaller elements"
                            },
                            {
                                "target_lang_word": "up to",
                                "target_lang_sense_clarification": "used when emphasizing higher-ranking elements"
                            },
                            {
                                "target_lang_word": "including",
                                "target_lang_sense_clarification": "general inclusion"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bis hin zu",
                                "target_lang_sense_clarification": "betont die Einbeziehung von Details oder Personen"
                            },
                            {
                                "target_lang_word": "einschließlich",
                                "target_lang_sense_clarification": "allgemeine Einbeziehung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28db8ede-ce62-3ae3-82d4-6654bc2bdbf1",
                    "sense_definition": "Находясь совсем рядом, непосредственно касаясь чего-либо.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Лодка подошла <w>вплоть</w> к берегу.",
                            "target_lang_translations": {
                                "en": "The boat came <w>right up</w> to the shore.",
                                "de": "Das Boot fuhr <w>direkt an</w> das Ufer heran."
                            }
                        },
                        {
                            "text": "Он стоял <w>вплоть</w> к стене.",
                            "target_lang_translations": {
                                "en": "He stood <w>right up</w> against the wall.",
                                "de": "Er stand <w>direkt an</w> der Wand."
                            }
                        }
                    ],
                    "synonyms": [
                        "вплотную"
                    ],
                    "antonyms": [
                        "далеко"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Located very close to, directly touching something.",
                        "de": "Ganz in der Nähe befindlich, direkt an etwas angrenzend oder berührend."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right up against",
                                "target_lang_sense_clarification": "in direct physical contact"
                            },
                            {
                                "target_lang_word": "flush with",
                                "target_lang_sense_clarification": "directly touching or level with a surface"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "direkt an",
                                "target_lang_sense_clarification": "räumliche Nähe oder Kontakt"
                            },
                            {
                                "target_lang_word": "unmittelbar an",
                                "target_lang_sense_clarification": "sehr nah oder direkt berührend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}