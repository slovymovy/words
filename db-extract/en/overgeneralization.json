                            {
                                "example_id": "b199c453-ac1f-47a3-acba-2acc65dfe377",
                                "sense_id": "e8d9cf21-9e69-3818-b9a1-890aa1cced7f",
                                "text": "\"George Orwell put the easy use of words like 'unique' under the headings of 'pretentious diction' and overgeneralization."
                            },
                            {
                                "example_id": "d041f649-d9c0-4f6e-a80d-c402457426b5",
                                "sense_id": "e8d9cf21-9e69-3818-b9a1-890aa1cced7f",
                                "text": "Fortunately for all of us, the rhetoric of both cultural pessimism and postmodernism contains more than its fair share of exaggeration and overgeneralization."
                            }
                        ]
                    },
                    {
                        "sense_id": "0711df08-faa4-370a-ad25-7608f20ac531",
                        "entry_id": "5d5785fc-b1ea-3446-8b4c-ee5daaf3e487",
                        "glosses": [
                            "An instance of overgeneralizing."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "51b649f9-f666-4b27-92cb-c0d07e49f9c2",
                                "sense_id": "0711df08-faa4-370a-ad25-7608f20ac531",
                                "text": "It's an overgeneralization to say that everywhere you look is the hand of man in the presettlement era,\" says Thomas Swetnam, a fire ecologist at the University of Arizona in Tucson."
                            }
                        ]
