                "senses": [
                    {
                        "sense_id": "a629e916-35f2-3c3f-a9a7-9db9af867473",
                        "entry_id": "f61f3af5-b851-35fc-bd0c-de1c42367499",
                        "glosses": [
                            "Demonstration, die sich gegen ein bestimmtes Atomkraftwerk oder generell gegen Atomkraftwerke richtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8dc9b97-1e26-463f-aec3-8afe9ec9280e",
                                "sense_id": "a629e916-35f2-3c3f-a9a7-9db9af867473",
                                "text": "„Die erste grosse Anti-AKW-Demonstration seit langer Zeit bedingt einen riesigen logistischen Aufwand.“"
                            },
                            {
                                "example_id": "5e373811-211c-4ad1-983c-a11c78e3ec53",
                                "sense_id": "a629e916-35f2-3c3f-a9a7-9db9af867473",
                                "text": "„Nach der grossen Anti-AKW-Demonstration in Berlin sieht die SPD eine neue breite Protestbewegung entstehen.“"
                            },
                            {
                                "example_id": "65402d84-0617-45c8-af89-b2e93264e9d9",
                                "sense_id": "a629e916-35f2-3c3f-a9a7-9db9af867473",
                                "text": "„Der Atomunfall in Japan wirft unterdessen auch ein Schlaglicht auf die Anti-AKW-Demonstration, die am Samstag im schwäbischen Neckarwestheim stattfindet.“"
                            },
                            {
                                "example_id": "02df0581-5bfa-4329-b2d0-01db41747b12",
                                "sense_id": "a629e916-35f2-3c3f-a9a7-9db9af867473",
                                "text": "„Nach dem deutschen Herbst 1977 und den Polizeistaatsverhältnissen bei den Anti-AKW-Demonstrationen von Brokdorf, Grohnde und Kalkar haben wir eine Partei quasi aus Notwehr ins Auge gefasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
