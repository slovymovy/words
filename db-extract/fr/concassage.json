                                            {
                                                "example_id": "4aba5585-eac2-4a03-a61d-b91097270085",
                                                "sense_id": "f1b27b40-aeac-324a-8cb8-ca7332f03f7d",
                                                "text": "a crushing defeat"
                                            },
                                            {
                                                "example_id": "0486f354-b669-4854-8f46-d50d3f0b87b0",
                                                "sense_id": "f1b27b40-aeac-324a-8cb8-ca7332f03f7d",
                                                "text": "The fruits of these kickstarted endeavors began to show in 1915, first in the deployment of a new range of depth charges. These were, mercifully, smaller than Jellicoe's \"crushing hand of God\" prototype, and, whilst practically just as lethal to submarines, they were significantly less risky to the launching ship, and could also be carried in larger numbers."
                                            },
                                            {
                                                "example_id": "0530217b-fa48-49f7-a7b9-4ecfa14ba216",
                                                "sense_id": "f1b27b40-aeac-324a-8cb8-ca7332f03f7d",
                                                "text": "The TSSA union stated that he had been carrying out maintenance and died as a result of crushing injuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b736216-8a16-3408-a86e-d1c3709484c3",
                                        "entry_id": "ba38ad15-f246-342e-ac85-afe6633c2818",
                                        "glosses": [
                                            "Devastatingly disheartening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2dec77c-8ef4-4b47-9093-b41b059b700e",
                                                "sense_id": "4b736216-8a16-3408-a86e-d1c3709484c3",
                                                "text": "crushing guilt"
                                            },
                                            {
                                                "example_id": "ff19551e-d28d-464c-b787-f58f420fe4eb",
                                                "sense_id": "4b736216-8a16-3408-a86e-d1c3709484c3",
                                                "text": "Oh, your dog has leukemia? That’s crushing."
                                            }
                                        ]
                                    }
                                ]
                            },
