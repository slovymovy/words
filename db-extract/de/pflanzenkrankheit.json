                "senses": [
                    {
                        "sense_id": "571168c0-203c-3469-8e15-555e1dfd99cb",
                        "entry_id": "81f2e4a9-a4e6-3f2a-ac4a-1924096a7b7b",
                        "glosses": [
                            "Krankheit, die nur bei Pflanzen auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e86555e-b594-4a30-abc3-bf6cd5b7325c",
                                "sense_id": "571168c0-203c-3469-8e15-555e1dfd99cb",
                                "text": "„Feuerbrand ist eine seuchenhafte Pflanzenkrankheit, die ganze Obsternten vernichten kann.“"
                            },
                            {
                                "example_id": "66510cf7-b571-4e6d-8ea7-e2eef742fc17",
                                "sense_id": "571168c0-203c-3469-8e15-555e1dfd99cb",
                                "text": "„Seit den 1960er Jahren wurde Triticale vielerorts als Futtergetreide angebaut und zeigte eine hohe Resistenz gegen Befall durch sogenannten Mehltau – eine Reihe von Pflanzenkrankheiten, die auf Pilze als Erreger zurückgehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
