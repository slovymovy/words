                                        "entry_id": "11337749-6bfd-381f-96f6-9decce70936a",
                                        "glosses": [
                                            "The endless deferral of any ultimate meaning in a word or sentence, owing to the necessity of recourse to a potentially infinite series of other, equally uncertain words or signs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8780250-273b-491d-a25c-9c31eda9c1dc",
                                                "sense_id": "b4d2eee9-b5e9-3425-8c84-757475a6ccc3",
                                                "text": "This is the final Derridan manoeuvre, the showing up of ‘blind spots’ in a text, or the ‘blindness’ of an author to certain textual ‘différances’ or ‘suppléments’ in his own text, operative though not observed."
                                            }
