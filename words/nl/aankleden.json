                },
                {
                    "sense_id": "2b2cdd74-642b-38a4-a93a-3549a4e2b00a",
                    "sense_definition": "Iemand anders of iets kleren aandoen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing_transitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De moeder wil haar baby zelf <w>aankleden</w>.",
                            "target_lang_translations": {
                                "en": "The mother wants to <w>dress</w> her baby herself.",
                                "ru": "Мать хочет сама <w>одеть</w> своего ребенка.",
                                "it": "La madre vuole <w>vestire</w> il suo bambino da sola.",
                                "zh": "母亲想亲自给她的宝宝<w>穿衣服</w>。"
                            }
                        },
                        {
                            "text": "Kun jij de kinderen even <w>aankleden</w>?",
                            "target_lang_translations": {
                                "en": "Can you <w>dress</w> the children for a moment?",
                                "ru": "Ты можешь <w>одеть</w> детей?",
                                "it": "Puoi <w>vestire</w> i bambini per un momento?",
                                "zh": "你能帮孩子们<w>穿一下衣服</w>吗？"
                            }
                        }
