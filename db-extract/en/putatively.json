                        ]
                    },
                    {
                        "translation_id": "1b3f7612-3cf2-4d34-8ec9-8f5eed2028f4",
                        "source_entry_id": "70e47705-a64d-3416-bb08-eb86e4701d51",
                        "source_sense_id": "9cd55237-7398-30d1-ae38-97a3988218d3",
                        "source_sense_description": "according to belief",
                        "target_lang_word": "mutmaßlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutmaßlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                        "entry_id": "aa448e33-6ee6-3776-89bb-0c674ace6d90",
                                        "glosses": [
                                            "einem begründeten Verdacht folgend, von einer Mutmaßung ausgehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "198e72d4-8aa8-4e2a-b8c1-9ad6287a701c",
                                                "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                                "text": "Der mutmaßliche Täter ist selbst Vater von zwei Kindern."
                                            },
                                            {
                                                "example_id": "d8a21aaf-2457-43bc-b40d-e3f21558f156",
                                                "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                                "text": "Die vermisste Person ist mutmaßlich verwirrt und suizidgefährdet."
                                            },
                                            {
                                                "example_id": "031c7106-d083-4009-8e2a-ab9b0430f613",
                                                "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                                "text": "„Er ist froh, dass die Staatsanwaltschaft ein paar Tage zuvor Anklage erhoben hat gegen den mutmaßlichen Täter.“"
                                            },
                                            {
                                                "example_id": "42b07cd0-c4f6-4106-a99b-7d4f41407ad6",
                                                "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                                "text": "„Bei einer Messerattacke in Hamburg sind am Freitagabend mehrere Menschen schwer verletzt worden. Die Polizei gab später erste Informationen zur mutmaßlichen Täterin bekannt.“"
                                            },
                                            {
                                                "example_id": "0bbc59ee-c4a3-4259-8d2e-6fca319903cf",
                                                "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                                "text": "Um den mutmaßlichen Erreger [des Marburg-Fiebers] sichtbar zu machen, schickt er [der Virologe Werner Slenczka] inaktivierte Proben an das Tropeninstitut in Hamburg."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
