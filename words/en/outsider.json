{
    "word_family": [
        "outside",
        "outsiderness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb13295e-99de-3bdd-847f-27e2f6cdd6a5",
                    "sense_definition": "A person who does not belong to a particular group, community, or organization.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While the members easily understand the symbols, they are often confusing to an <w>outsider</w>.",
                            "target_lang_translations": {
                                "ru": "В то время как члены группы легко понимают символы, они часто сбивают с толку <w>постороннего</w>."
                            }
                        },
                        {
                            "text": "He felt like a total <w>outsider</w> at the party because he didn't know anyone there.",
                            "target_lang_translations": {
                                "ru": "На вечеринке он чувствовал себя полным <w>чужаком</w>, потому что никого там не знал."
                            }
                        }
                    ],
                    "synonyms": [
                        "stranger",
                        "outcast",
                        "misfit",
                        "pariah"
                    ],
                    "antonyms": [
                        "insider",
                        "member"
                    ],
                    "common_phrases": [
                        "total outsider",
                        "feel like an outsider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который не принадлежит к определенной группе, сообществу или организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посторонний",
                                "target_lang_sense_clarification": "человек не из этого круга"
                            },
                            {
                                "target_lang_word": "чужак",
                                "target_lang_sense_clarification": "чужой человек, не свой"
                            },
                            {
                                "target_lang_word": "аутсайдер",
                                "target_lang_sense_clarification": "человек вне социальной группы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "462f6ab1-da5c-39ff-9010-443b338f87fc",
                    "sense_definition": "A competitor or contestant who is thought to have very little chance of winning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete was a complete <w>outsider</w> in the tournament but managed to win the silver medal.",
                            "target_lang_translations": {
                                "ru": "Молодой атлет был абсолютным <w>аутсайдером</w> на турнире, но сумел завоевать серебряную медаль."
                            }
                        },
                        {
                            "text": "Even though he was a rank <w>outsider</w>, his determination led him to a surprising victory.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то, что он был явным <w>аутсайдером</w>, его решимость привела его к удивительной победе."
                            }
                        }
                    ],
                    "synonyms": [
                        "underdog",
                        "dark horse",
                        "long shot"
                    ],
                    "antonyms": [
                        "favorite",
                        "front-runner"
                    ],
                    "common_phrases": [
                        "rank outsider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участник соревнований, имеющий очень мало шансов на победу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аутсайдер",
                                "target_lang_sense_clarification": "в спорте или конкурсе"
                            },
                            {
                                "target_lang_word": "темная лошадка",
                                "target_lang_sense_clarification": "неожиданный претендент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f8828bd-de6e-351f-8f12-5c36fa24c0ce",
                    "sense_definition": "A person who has recently joined a group or organization and lacks experience within it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to hire a political <w>outsider</w> to bring a fresh perspective to the board.",
                            "target_lang_translations": {
                                "ru": "Компания решила нанять <w>человека со стороны</w> политики, чтобы привнести свежий взгляд в совет директоров."
                            }
                        },
                        {
                            "text": "As a corporate <w>outsider</w>, she struggled at first to understand the internal office politics.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>новичком</w> в корпоративной среде, она поначалу с трудом понимала внутреннюю офисную политику."
                            }
                        }
                    ],
                    "synonyms": [
                        "newcomer",
                        "newbie",
                        "entrant"
                    ],
                    "antonyms": [
                        "veteran",
                        "expert"
                    ],
                    "common_phrases": [
                        "political outsider",
                        "corporate outsider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, недавно присоединившийся к организации и не имеющий в ней опыта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "человек со стороны"
                            },
                            {
                                "target_lang_word": "человек со стороны",
                                "target_lang_sense_clarification": "не из системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03492aba-131b-3045-910f-d41d69039882",
                    "sense_definition": "The crusty end piece of a loaf of bread.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bread_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather always preferred eating the <w>outsider</w> of the loaf because it was the crunchiest part.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка всегда предпочитал есть <w>горбушку</w>, потому что это была самая хрустящая часть."
                            }
                        },
                        {
                            "text": "Don't throw away the <w>outsider</w>; it is perfect for making croutons for the soup.",
                            "target_lang_translations": {
                                "ru": "Не выбрасывайте <w>корку</w>; она идеально подходит для приготовления гренок к супу."
                            }
                        }
                    ],
                    "synonyms": [
                        "heel",
                        "crust"
                    ],
                    "common_phrases": [
                        "outsider of the loaf"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in some English dialects to refer to the heel of bread"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайний, покрытый коркой кусок буханки хлеба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горбушка",
                                "target_lang_sense_clarification": "край хлеба"
                            },
                            {
                                "target_lang_word": "корка",
                                "target_lang_sense_clarification": "крайний кусок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}