                    "sense_id": "7b8dd737-a390-37eb-9cf6-f8704384f228",
                    "sense_definition": "A strong dark lager beer traditionally brewed in autumn and aged during the winter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ordered a cold <w>bock</w> at the German tavern to celebrate the arrival of spring.",
                            "target_lang_translations": {
                                "it": "Ha ordinato una <w>bock</w> fresca alla taverna tedesca per festeggiare l'arrivo della primavera."
                            }
                        },
                        {
                            "text": "The local brewery introduced a rich, malty <w>bock</w> for the festive season.",
                            "target_lang_translations": {
                                "it": "Il birrificio locale ha introdotto una <w>birra bock</w> ricca e maltata per la stagione festiva."
                            }
                        }
                    ],
                    "synonyms": [
                        "bock beer"
                    ],
                    "target_lang_definitions": {
                        "it": "Una birra lager scura e forte, tradizionalmente brassata in autunno e maturata durante l'inverno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "bock",
