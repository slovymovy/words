{
    "word_family": [
        "peerage",
        "peerless",
        "peering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc82eabf-3130-3469-82e9-20c1dd4f05df",
                    "sense_definition": "To look closely or with difficulty, as if searching for something or trying to see more clearly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "looking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective had to <w>peer</w> through the thick fog to see the license plate of the car.",
                            "target_lang_translations": {
                                "ru": "Детективу пришлось <w>вглядываться</w> сквозь густой туман, чтобы разглядеть номерной знак машины."
                            }
                        },
                        {
                            "text": "She would <w>peer</w> through the window to check if her guests had arrived yet.",
                            "target_lang_translations": {
                                "ru": "Она <w>всматривалась</w> в окно, чтобы проверить, не приехали ли уже гости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "peer through the window",
                        "peer into the darkness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внимательно или с трудом всматриваться, как будто в поисках чего-то или пытаясь разглядеть что-то более четко."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вглядываться",
                                "target_lang_sense_clarification": "внимательно смотреть, стараясь рассмотреть"
                            },
                            {
                                "target_lang_word": "всматриваться",
                                "target_lang_sense_clarification": "пристально смотреть, напрягая зрение"
                            },
                            {
                                "target_lang_word": "присматриваться",
                                "target_lang_sense_clarification": "внимательно наблюдать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e06ea34-95e3-37ad-a0a3-43424b985767",
                    "sense_definition": "To begin to appear or come into sight, often from behind or through something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun began to <w>peer</w> through the heavy clouds after the storm passed.",
                            "target_lang_translations": {
                                "ru": "Солнце начало <w>проглядывать</w> сквозь тяжелые тучи после того, как шторм утих."
                            }
                        },
                        {
                            "text": "We watched as the first flowers of spring started to <w>peer</w> above the melting snow.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как первые весенние цветы начали <w>показываться</w> над тающим снегом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "peer through the clouds"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary or older contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать появляться или показываться, часто из-за чего-либо или сквозь что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проглядывать",
                                "target_lang_sense_clarification": "становиться видимым сквозь что-то"
                            },
                            {
                                "target_lang_word": "показываться",
                                "target_lang_sense_clarification": "начинать виднеться"
                            },
                            {
                                "target_lang_word": "выглядывать",
                                "target_lang_sense_clarification": "появляться из-за преграды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3845c10-7f58-30fd-8db9-665f14be36b3",
                    "sense_definition": "To exchange internet traffic with another network provider on equal terms without charging each other.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two major internet service providers decided to <w>peer</w> with each other to improve speed.",
                            "target_lang_translations": {
                                "ru": "Два крупных интернет-провайдера решили <w>пиринговаться</w> друг с другом для повышения скорости."
                            }
                        },
                        {
                            "text": "Small networks often find it difficult to <w>peer</w> with global giants without paying a fee.",
                            "target_lang_translations": {
                                "ru": "Малым сетям часто трудно <w>осуществлять пиринг</w> с глобальными гигантами без оплаты взноса."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in networking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обмениваться интернет-трафиком с другим сетевым провайдером на равных условиях без взаимной оплаты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиринговаться",
                                "target_lang_sense_clarification": "устанавливать пиринговое соединение"
                            },
                            {
                                "target_lang_word": "осуществлять пиринг",
                                "target_lang_sense_clarification": "технический термин обмена трафиком"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f71b37e-ba40-3adf-a5d6-1cb19af0d809",
                    "sense_definition": "A person who is of the same age, status, or ability as another person.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important for teenagers to feel accepted by their <w>peer</w> group at school.",
                            "target_lang_translations": {
                                "ru": "Для подростков важно чувствовать себя принятыми в своей группе <w>сверстников</w> в школе."
                            }
                        },
                        {
                            "text": "The scientist's research was highly respected by his <w>peers</w> in the academic community.",
                            "target_lang_translations": {
                                "ru": "Исследование ученого пользовалось большим уважением среди его <w>коллег</w> в академическом сообществе."
                            }
                        }
                    ],
                    "synonyms": [
                        "compeer"
                    ],
                    "common_phrases": [
                        "peer group",
                        "peer pressure",
                        "peer review"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек того же возраста, статуса или способностей, что и другой человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверстник",
                                "target_lang_sense_clarification": "человек того же возраста"
                            },
                            {
                                "target_lang_word": "ровня",
                                "target_lang_sense_clarification": "равный по положению или способностям"
                            },
                            {
                                "target_lang_word": "коллега",
                                "target_lang_sense_clarification": "равный по профессиональному статусу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b50d5b3-beeb-3ed2-81e2-5fb3ae8a7fde",
                    "sense_definition": "A member of the nobility who holds a title such as duke, marquess, earl, viscount, or baron.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nobility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>peer</w> of the realm was invited to attend the royal coronation ceremony.",
                            "target_lang_translations": {
                                "ru": "<w>Пэр</w> королевства был приглашен на церемонию королевской коронации."
                            }
                        },
                        {
                            "text": "He was the first member of his family to be made a life <w>peer</w> in the House of Lords.",
                            "target_lang_translations": {
                                "ru": "Он стал первым членом своей семьи, получившим титул пожизненного <w>пэра</w> в Палате лордов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "peer of the realm",
                        "life peer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in the United Kingdom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель высшего дворянства, обладающий титулом, таким как герцог, маркиз, граф, виконт или барон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пэр",
                                "target_lang_sense_clarification": "титул высшего дворянства в Великобритании"
                            },
                            {
                                "target_lang_word": "лорд",
                                "target_lang_sense_clarification": "член палаты лордов или титулованное лицо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2384d7cb-c412-3086-9fed-a5fffa9cc266",
                    "sense_definition": "A quick or searching look; a brief glance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "looking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a quick <w>peer</w> at the map before continuing his journey through the woods.",
                            "target_lang_translations": {
                                "ru": "Он бросил быстрый <w>взгляд</w> на карту, прежде чем продолжить путь через лес."
                            }
                        },
                        {
                            "text": "With a cautious <w>peer</w> around the corner, she made sure the hallway was empty.",
                            "target_lang_translations": {
                                "ru": "Осторожно <w>заглянув</w> за угол, она убедилась, что коридор пуст."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick peer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый или пытливый взгляд; короткое заглядывание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взгляд",
                                "target_lang_sense_clarification": "быстрое или внимательное всматривание"
                            },
                            {
                                "target_lang_word": "взор",
                                "target_lang_sense_clarification": "пристальный взгляд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca812257-7507-3785-854e-3f687a40f690",
                    "sense_definition": "A person or animal that urinates.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bodily_functions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy is a frequent <w>peer</w> and needs to be taken outside every hour.",
                            "target_lang_translations": {
                                "ru": "Щенок часто <w>писается</w>, и его нужно выводить на улицу каждый час."
                            }
                        },
                        {
                            "text": "He joked that his toddler was a professional <w>peer</w> during the potty training phase.",
                            "target_lang_translations": {
                                "ru": "Он шутил, что его малыш был профессиональным <w>зассыхой</w> на этапе приучения к горшку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное, которое мочится."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зассыха",
                                "target_lang_sense_clarification": "грубо-разговорное о том, кто часто мочится"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}