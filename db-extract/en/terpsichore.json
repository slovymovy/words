                                        "entry_id": "2f23c002-93db-39bf-b208-25705a81a35f",
                                        "glosses": [
                                            "(81) Terpsichore, planète mineure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
