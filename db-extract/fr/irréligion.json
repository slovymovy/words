        "fr-extract.jsonl": [
            {
                "entry_id": "b1869545-8770-302c-a0dd-1644d20f5bc3",
                "word": "irréligion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b9b16c05-b42e-4892-b069-91e0547637ef",
                        "entry_id": "b1869545-8770-302c-a0dd-1644d20f5bc3",
