                        "examples": [
                            {
                                "example_id": "98c15375-8418-4e00-86ee-615d073aca8f",
                                "sense_id": "31d7fbb4-710a-3e7e-b0f4-57f0f9a5ae77",
                                "text": "O semickości utworu świadczy użyte słownictwo."
