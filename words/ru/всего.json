            "senses": [
                {
                    "sense_id": "a83a0d42-4e54-3e57-82e0-579b30e8f013",
                    "sense_definition": "Употребляется для ограничения количества, меры или времени; то же, что «только», «лишь».",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "До начала фильма осталось <w>всего</w> пять минут.",
                            "target_lang_translations": {
                                "en": "There are <w>only</w> five minutes left until the movie starts.",
                                "zh": "电影开始前<w>只</w>剩下五分钟了。",
                                "nl": "Er zijn <w>slechts</w> vijf minuten over tot de film begint.",
                                "pl": "Do rozpoczęcia filmu zostało <w>tylko</w> pięć minut.",
                                "de": "Bis zum Filmbeginn sind es <w>nur</w> noch fünf Minuten.",
                                "fr": "Il ne reste que <w>cinq</w> minutes avant le début du film.",
                                "it": "Mancano <w>solo</w> cinque minuti all'inizio del film.",
                                "cs": "Do začátku filmu zbývá <w>jen</w> pět minut.",
                                "tr": "Filmin başlamasına <w>sadece</w> beş dakika kaldı.",
                                "es": "Quedan <w>solo</w> cinco minutos para que empiece la película."
                            }
                        },
                        {
                            "text": "Это стоит <w>всего</w> сто рублей.",
                            "target_lang_translations": {
                                "en": "It costs <w>just</w> one hundred rubles.",
                                "zh": "这<w>仅仅</w>需要一百卢布。",
                                "nl": "Dit kost <w>maar</w> honderd roebel.",
                                "pl": "To kosztuje <w>zaledwie</w> sto rubli.",
                                "de": "Das kostet <w>nur</w> hundert Rubel.",
                                "fr": "Cela coûte <w>seulement</w> cent roubles.",
                                "it": "Costa <w>soltanto</w> cento rubli.",
                                "cs": "Stojí to <w>jen</w> sto rublů.",
                                "tr": "Bu <w>sadece</w> yüz ruble.",
                                "es": "Esto cuesta <w>solo</w> cien rublos."
                            }
                        }
                    ],
                    "synonyms": [
                        "только",
                        "лишь",
                        "всего́ лишь"
                    ],
                    "antonyms": [
                        "аж"
                    ],
                    "common_phrases": [
                        "всего лишь",
                        "всего-навсего"
