                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "063d4ad8-2a16-4d5f-82eb-6d50b534b268",
                                "sense_id": "5b973699-050c-393c-971d-f5a2c247f9b4",
                                "text": "Hij is een pionier op het gebied van genetica."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b788de4-03c6-3c2d-957e-7872f2a7d0b4",
                        "entry_id": "1defae1f-a0b6-3dcf-bfea-37c156c18ad8",
                        "glosses": [
                            "iemand die zich in onbekend land vestigt en een nieuw bestaan opbouwt"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecd0d14a-3996-46c4-92c3-afc2a01f424b",
                        "source_entry_id": "1defae1f-a0b6-3dcf-bfea-37c156c18ad8",
                        "target_lang_word": "Bahnbrecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "37c6735c-a5fd-4908-9c79-a84df5c0e183",
                        "source_entry_id": "1defae1f-a0b6-3dcf-bfea-37c156c18ad8",
                        "target_lang_word": "Pionier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pionier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32f94388-102a-396d-9135-8d2db19a29aa",
                                        "entry_id": "8c227a77-ef52-3b23-839e-91e44b827e41",
                                        "glosses": [
                                            "Wegbereiter, Bahnbrecher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57326ebc-ccbb-45d0-ba88-2a9750d21f06",
                                                "sense_id": "32f94388-102a-396d-9135-8d2db19a29aa",
                                                "text": "Er war ein Pionier der Wissenschaft."
                                            },
                                            {
                                                "example_id": "d55d61c0-bfc5-4990-bd8f-3c9b934e7f8d",
                                                "sense_id": "32f94388-102a-396d-9135-8d2db19a29aa",
                                                "text": "„Ados Vater war seinerzeit einer der Pioniere.“"
                                            },
                                            {
                                                "example_id": "5510ed91-6c36-4b39-9fbe-35429eeb9168",
                                                "sense_id": "32f94388-102a-396d-9135-8d2db19a29aa",
                                                "text": "„Bereits die älteste Version des Landnahmebuchs nennt rund 400 Pioniere mit Namen, beschreibt bei manchen sogar, woher sie stammen, wer ihre Vorfahren waren und wo genau sie sich auf Island ansiedeln.“"
                                            },
                                            {
                                                "example_id": "737cb1f4-5e01-4e97-9a17-f52046d8403e",
                                                "sense_id": "32f94388-102a-396d-9135-8d2db19a29aa",
                                                "text": "„Es war nun einmal eine Tatsache, daß dieser löwengescheite Mann auch noch zu den Pionieren der neueren Lyrik in Island gehörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "115b0aa6-1cba-3463-bf78-f20b726617a1",
                                        "entry_id": "8c227a77-ef52-3b23-839e-91e44b827e41",
                                        "glosses": [
                                            "Angehöriger einer Pioniertruppe und in Deutschland niedrigster Dienstgrad in der Pioniertruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53ba900e-1e09-4894-b8a9-8b9b4a960fd8",
                                                "sense_id": "115b0aa6-1cba-3463-bf78-f20b726617a1",
                                                "text": "Die Pioniere sprengten eine Brücke."
                                            },
                                            {
                                                "example_id": "065fbd61-cb2a-4e23-81c4-f6c2a8c1b823",
                                                "sense_id": "115b0aa6-1cba-3463-bf78-f20b726617a1",
                                                "text": "„Nun berichtet der Beschwerdeführer, daß er als Pionier beim Bundesheer beschäftigt ist.“"
                                            },
                                            {
                                                "example_id": "3441060b-b325-47b7-9e9d-c888146c6654",
                                                "sense_id": "115b0aa6-1cba-3463-bf78-f20b726617a1",
                                                "text": "„Wir wurden auf Fähren von zwei Pontons durch Pioniere übergebootet.“"
                                            },
                                            {
                                                "example_id": "1e514b84-af62-420d-8724-dcf87cf4201c",
                                                "sense_id": "115b0aa6-1cba-3463-bf78-f20b726617a1",
                                                "text": "„Während die Pioniere Pontonbrücken über den Fluss legten, verbrachte Martin seine Zeit bei den Kanonen und den Pferden im Wald.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e2ad162b-134b-3a76-a179-01dc1c33830e",
                                        "entry_id": "8c227a77-ef52-3b23-839e-91e44b827e41",
                                        "glosses": [
                                            "Angehöriger einer Kinderorganisation der führenden Partei"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d98aea2e-8ea1-4828-9a0b-cda99ea5197f",
                                                "sense_id": "e2ad162b-134b-3a76-a179-01dc1c33830e",
                                                "text": "Die Mitgliedschaft bei den Jungen Pionieren sowie den Thälmann-Pionieren war formal freiwillig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "525dc18a-b74e-483e-b412-8424c2dba61e",
                        "source_entry_id": "1defae1f-a0b6-3dcf-bfea-37c156c18ad8",
                        "target_lang_word": "pioneer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pioneer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e1d81f4-a269-3f51-b4d4-85580c5c7992",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "One who goes before, as into the wilderness, preparing the way for others to follow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "420cf265-6ed8-3b7b-a174-f35348d9bfcb",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "A person or other entity who is first or among the earliest in any field of inquiry, enterprise, or progress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "714320cd-ab8a-4eec-ae8d-bb477bf94bce",
                                                "sense_id": "420cf265-6ed8-3b7b-a174-f35348d9bfcb",
                                                "text": "Some people will consider their national heroes to be pioneers of civilization."
                                            },
                                            {
                                                "example_id": "0c2fbb80-e19c-4232-b529-af87c6882259",
                                                "sense_id": "420cf265-6ed8-3b7b-a174-f35348d9bfcb",
                                                "text": "Certain politicians can be considered as pioneers of reform."
                                            },
                                            {
                                                "example_id": "6cbc6460-fbba-4b55-bee5-59eb9371e2e6",
                                                "sense_id": "420cf265-6ed8-3b7b-a174-f35348d9bfcb",
                                                "text": "As towns continue to grow, replanting vegetation has become a form of urban utopia and green roofs are spreading fast. Last year 1m square metres of plant-covered roofing was built in France, as much as in the US, and 10 times more than in Germany, the pioneer in this field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5f61775-651f-341f-9fb6-3a6aee4b854d",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "A soldier detailed or employed to form roads, dig trenches, and make bridges, as an army advances; a sapper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fefdae6b-46f6-4a28-8fb4-926617524156",
                                                "sense_id": "d5f61775-651f-341f-9fb6-3a6aee4b854d",
                                                "text": "[King of] Fess. What thinks your greatnes beſt to be atchieu’d\nIn purſuit of the Cities ouerthrow?\nBai[azeth]. I wil the captiue Pioners of Argier,\nCut off the water, that by leaden pipes\nRuns to the citie from the mountain Carnon, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8273d2d9-21ed-3847-a7b3-97aea594ce4f",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "A member of any of several European organizations advocating abstinence from alcohol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "102290f7-6bb5-320c-9a90-06574fc0a286",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "A member of a children’s organization operated by the Communist Party, typically in the second of three stages toward becoming a member of the Party itself."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06596dcd-5d70-3056-b4c7-b150958186b7",
                                        "entry_id": "ef301654-04ec-3afe-b680-7e600883aadf",
                                        "glosses": [
                                            "Alternative letter-case form of Pioneer (“A Singaporean born on or before 31 December 1949, who is entitled to various healthcare and social support schemes.”)."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa55c2aa-337f-48cf-9d66-4c28443a515f",
                                                "sense_id": "06596dcd-5d70-3056-b4c7-b150958186b7",
                                                "text": "Perhaps the pioneer generation, having experienced unity in solidarity, will show the rest of Singapore the way."
                                            },
                                            {
                                                "example_id": "dcb394ed-44a4-4920-a7e7-b7e1c5c2353a",
                                                "sense_id": "06596dcd-5d70-3056-b4c7-b150958186b7",
                                                "text": "A fenceless open-air museum […] that captures the spirit and struggles of Singapore's pioneer generation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
