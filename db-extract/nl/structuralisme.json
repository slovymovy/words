                                        "sense_id": "a2519709-cfbb-33cf-aee4-59ed81b10951",
                                        "entry_id": "875b0182-0bf9-3817-a294-3661835f2450",
                                        "glosses": [
                                            "Estructuralismo científico."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6cc8d65d-103f-38ee-9726-e9e71db4eaf5",
                                        "entry_id": "875b0182-0bf9-3817-a294-3661835f2450",
                                        "glosses": [
                                            "Escuela de la psicología que considera que el objeto de estudio de la misma es la estructura de la mente, por oposición al funcionalismo."
                                        ],
                                        "tags": [],
                                        "examples": [],
