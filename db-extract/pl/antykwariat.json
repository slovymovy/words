                        "examples": [
                            {
                                "example_id": "4d46943a-7e10-4e74-bab4-7278e45da55e",
                                "sense_id": "646563c2-335e-3907-b887-dfdc1c9f2068",
                                "text": "Mirek był zawziętym bibliofilem, czytał godzinami, znał wszystkie antykwariaty w mieście."
                            }
                        ],
