                        "entry_id": "edd7bc1a-16e7-3eb2-9630-7409a4cd9daf",
                        "glosses": [
                            "Que l’on peut balayer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bff558ea-341d-4521-ad5c-785008eb1bcc",
                                "sense_id": "a4eae427-7084-3384-b0e1-619239d437e1",
                                "text": "Il fallait enlever à l’émeute populaire les épais maquis où elle s’embusquait jadis; rendre Paris aisément « balayable » par la cavalerie, la mousqueterie, le canon."
                            },
                            {
                                "example_id": "1e73e487-6e65-4f17-9d91-febc03b9eacb",
                                "sense_id": "a4eae427-7084-3384-b0e1-619239d437e1",
                                "text": "Généralement, seul l’élément le plus sélectif est balayable électroniquement, ce qui limite la plage de balayage."
                            },
                            {
                                "example_id": "db36fddf-0055-42d9-8294-d2988b54634e",
                                "sense_id": "a4eae427-7084-3384-b0e1-619239d437e1",
                                "text": "Une « opinion » reçue n’est donc pas pour Montaigne balayable d’un négligent revers de main."
                            }
                        ]
                    }
