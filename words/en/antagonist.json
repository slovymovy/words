    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b54352a2-0019-313e-ba34-1810b359bc63",
                    "sense_definition": "The main character or force opposing the protagonist in a literary work or drama.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "literary_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>antagonist</w> in this novel is a very complex and interesting character."
                        },
                        {
                            "text": "Every great story needs a strong <w>antagonist</w> to challenge the hero."
                        }
                    ],
                    "antonyms": [
                        "protagonist"
                    ],
                    "common_phrases": [
                        "story antagonist",
                        "main antagonist"
                    ]
                },
                {
                    "sense_id": "19aeb9b9-bd2a-3c4a-b250-4348b99d88e2",
                    "sense_definition": "An opponent or enemy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opponent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two political <w>antagonist</w> groups could not agree on the new law."
                        },
                        {
                            "text": "He faced his <w>antagonist</w> with courage during the heated debate."
                        }
                    ],
                    "common_phrases": [
                        "fierce antagonist",
                        "political antagonist"
                    ]
                },
                {
                    "sense_id": "462f6398-3913-3dbf-8291-d3f6f4133825",
                    "sense_definition": "A muscle that acts in opposition to another.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bicep acts as the <w>antagonist</w> to the tricep during arm extension."
                        },
                        {
                            "text": "Muscles often work in pairs where one is the <w>antagonist</w> to the other."
                        }
                    ],
                    "common_phrases": [
                        "muscle antagonist"
                    ]
                },
                {
                    "sense_id": "65d441db-f51d-37fb-8eff-6292b0ad9a67",
                    "sense_definition": "A chemical that binds to a receptor but does not produce a physiological response, blocking the action of other agonist chemicals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pharmacology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drug acts as an <w>antagonist</w> to prevent the hormone from binding."
                        },
                        {
                            "text": "Scientists developed a new <w>antagonist</w> to block the receptor's activity."
                        }
                    ],
                    "synonyms": [
                        "blocker"
                    ],
                    "antonyms": [
                        "agonist"
                    ],
                    "common_phrases": [
                        "receptor antagonist",
                        "drug antagonist"
                    ]
                },
                {
                    "sense_id": "e85be551-5569-369d-8fd6-9a1d0b930e49",
                    "sense_definition": "One who antagonizes or stirs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opponent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a constant <w>antagonist</w> in the office meetings."
                        },
                        {
                            "text": "The persistent <w>antagonist</w> kept interrupting the speaker with rude comments."
                        }
                    ]
                }
            ]
        }
    ]
