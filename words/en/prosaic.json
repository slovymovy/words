{
    "word_family": [
        "prose",
        "prosaically",
        "prosaicness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed0cd5f1-cd68-3e2c-80e0-87cb3e4c14e6",
                    "sense_definition": "Relating to or written in prose rather than poetry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>prosaic</w> style is very clear, but it lacks the beauty of his poems.",
                            "target_lang_translations": {
                                "tr": "Onun <w>düzyazısal</w> üslubu çok açık, ancak şiirlerinin güzelliğinden yoksun."
                            }
                        },
                        {
                            "text": "The author prefers <w>prosaic</w> language over poetic metaphors in his novels.",
                            "target_lang_translations": {
                                "tr": "Yazar, romanlarında şiirsel metaforlar yerine <w>yalın</w> bir dil tercih ediyor."
                            }
                        }
                    ],
                    "antonyms": [
                        "poetic"
                    ],
                    "common_phrases": [
                        "prosaic style",
                        "prosaic writing"
                    ],
                    "target_lang_definitions": {
                        "tr": "Şiirsel değil, düzyazı biçiminde olan veya düzyazıya özgü."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "düzyazısal",
                                "target_lang_sense_clarification": "Düzyazı biçiminde veya tarzında olan."
                            },
                            {
                                "target_lang_word": "nesirsel",
                                "target_lang_sense_clarification": "Şiirsel olmayan, düzyazı ile ilgili."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1309d57-7207-3499-8f82-3051f036fcbf",
                    "sense_definition": "Straightforward, practical, and matter-of-fact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was simply making a <w>prosaic</w> point about our budget restrictions.",
                            "target_lang_translations": {
                                "tr": "Sadece bütçe kısıtlamalarımız hakkında <w>gerçekçi</w> bir noktaya değiniyordum."
                            }
                        },
                        {
                            "text": "We need to focus on a <w>prosaic</w> explanation for why the system failed.",
                            "target_lang_translations": {
                                "tr": "Sistemin neden çöktüğüne dair <w>yalın</w> bir açıklamaya odaklanmamız gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "straightforward",
                        "matter-of-fact"
                    ],
                    "common_phrases": [
                        "prosaic point",
                        "prosaic explanation"
                    ],
                    "target_lang_definitions": {
                        "tr": "Süsten uzak, pratik, gerçekçi ve olduğu gibi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yalın",
                                "target_lang_sense_clarification": "Sade, süssüz ve doğrudan."
                            },
                            {
                                "target_lang_word": "gerçekçi",
                                "target_lang_sense_clarification": "Pratik ve mantıklı bir bakış açısıyla."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                    "sense_definition": "Dull, ordinary, or lacking imagination; commonplace.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She lived a <w>prosaic</w> life in a quiet suburb without any drama.",
                            "target_lang_translations": {
                                "tr": "Sessiz bir banliyöde, hiçbir dramanın olmadığı <w>sıradan</w> bir hayat sürüyordu."
                            }
                        },
                        {
                            "text": "His account of the incident was so <w>prosaic</w> that everyone lost interest quickly.",
                            "target_lang_translations": {
                                "tr": "Olayı anlatışı o kadar <w>tekdüze</w> idi ki herkes çabucak ilgisini kaybetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "banal",
                        "dull",
                        "humdrum",
                        "mundane",
                        "pedestrian",
                        "unimaginative"
                    ],
                    "common_phrases": [
                        "prosaic life",
                        "prosaic details"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sıkıcı, sıradan, hayal gücünden yoksun veya tekdüze."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sıradan",
                                "target_lang_sense_clarification": "Özelliği olmayan, alışılmış."
                            },
                            {
                                "target_lang_word": "tekdüze",
                                "target_lang_sense_clarification": "Sıkıcı, monoton, değişiklik göstermeyen."
                            },
                            {
                                "target_lang_word": "yavan",
                                "target_lang_sense_clarification": "İlgi çekmeyen, tatsız veya sıkıcı."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}