    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "04d24551-d7d8-33a9-a572-2d59a1c63ee6",
                    "sense_definition": "iets dat overlast of belemmering veroorzaakt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overlast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het lawaai van de buren is erg <w>hinderlijk</w> als ik probeer te studeren.",
                            "target_lang_translations": {
                                "en": "The noise from the neighbors is very <w>annoying</w> when I am trying to study."
                            }
                        },
                        {
                            "text": "Zijn constante onderbrekingen tijdens de vergadering werden als <w>hinderlijk</w> ervaren.",
                            "target_lang_translations": {
                                "en": "His constant interruptions during the meeting were perceived as <w>bothersome</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervelend",
                        "lastig",
                        "storend",
                        "irritant"
                    ],
                    "antonyms": [
                        "prettig",
                        "aangenaam",
                        "nuttig"
                    ],
                    "common_phrases": [
                        "hinderlijk gedrag",
                        "hinderlijk geluid",
                        "hinderlijk volgen"
                    ],
                    "target_lang_definitions": {
                        "en": "something that causes nuisance, annoyance, or a minor disturbance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "annoying",
                                "target_lang_sense_clarification": "causing irritation or nuisance"
                            },
                            {
                                "target_lang_word": "bothersome",
                                "target_lang_sense_clarification": "causing trouble or annoyance"
                            },
                            {
                                "target_lang_word": "disturbing",
                                "target_lang_sense_clarification": "interrupting focus or peace"
                            },
                            {
                                "target_lang_word": "nuisance",
                                "target_lang_sense_clarification": "acting as a source of irritation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c4c498b-805a-3d38-99df-bea1eea77d89",
                    "sense_definition": "het proces van voortgang vertragen of bemoeilijken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belemmering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De grote koffer was een <w>hinderlijk</w> object tijdens de drukke treinreis.",
                            "target_lang_translations": {
                                "en": "The large suitcase was a <w>cumbersome</w> object during the busy train journey."
                            }
                        },
                        {
                            "text": "Een <w>hinderlijke</w> onderbreking zorgde ervoor dat het project vertraging opliep.",
                            "target_lang_translations": {
                                "en": "An <w>obstructive</w> interruption caused the project to suffer a delay."
                            }
                        }
                    ],
                    "synonyms": [
                        "belemmerend",
                        "stagnerend"
                    ],
                    "antonyms": [
                        "bevorderlijk",
                        "helpend"
                    ],
                    "common_phrases": [
                        "hinderlijke onderbreking",
                        "hinderlijke obstructie"
                    ],
                    "target_lang_definitions": {
                        "en": "slowing down or making the process of progress more difficult"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obstructive",
                                "target_lang_sense_clarification": "blocking or hindering progress"
                            },
                            {
                                "target_lang_word": "cumbersome",
                                "target_lang_sense_clarification": "clumsy or difficult to manage, slowing things down"
                            },
                            {
                                "target_lang_word": "hindering",
                                "target_lang_sense_clarification": "making it difficult for someone to do something"
                            },
                            {
                                "target_lang_word": "impeding",
                                "target_lang_sense_clarification": "delaying or preventing someone or something"
                            }
                        ]
                    }
                }
            ]
        }
