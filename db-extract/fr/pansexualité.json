                    {
                        "sense_id": "6cde6ac5-3533-370c-a0e7-82193267321b",
                        "entry_id": "e2dc8bbb-c3d9-3adc-b63b-d82d228fa423",
                        "glosses": [
                            "Orientation sexuelle désignant l’attirance, l’affinité d’une personne pour les autres, indifféremment de leur genre, identité de genre ou sexe."
                        ],
                        "tags": [
                            "LGBTQ"
                        ],
                        "examples": [
                            {
                                "example_id": "e5ca7381-015d-4568-920f-621285f54fd3",
                                "sense_id": "6cde6ac5-3533-370c-a0e7-82193267321b",
                                "text": "Dans ce second épisode de Hétérogène, Léa se confie sur l'influence des drag queens sur sa non binarité, le passing, l’embyphobie, sa pansexualité, les problèmes dans RuPaul's Drag Race, et l'importance des représentations LGBTQ+ dans les médias."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e3863ec-0836-474b-98ee-3d61a5beac94",
                        "source_entry_id": "e2dc8bbb-c3d9-3adc-b63b-d82d228fa423",
                        "source_sense_id": "6cde6ac5-3533-370c-a0e7-82193267321b",
                        "target_lang_word": "pansexuality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pansexuality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7531bf2b-41c6-3f07-af62-16b736f56862",
                                        "entry_id": "be5dd36d-d2e7-3ef0-a154-3940d4cc39aa",
                                        "glosses": [
                                            "A sexual orientation characterized by the potential for aesthetic attraction, romantic love and/or sexual desire for people regardless of their gender or sex."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28d20698-915d-430a-a589-cb14392a12fc",
                                                "sense_id": "7531bf2b-41c6-3f07-af62-16b736f56862",
                                                "text": "They know nothing of flower power or meditation, pansexuality, or mind expansion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfbe99f5-dd88-316a-ab5e-0077a92e6cf0",
                                        "entry_id": "be5dd36d-d2e7-3ef0-a154-3940d4cc39aa",
                                        "glosses": [
                                            "Sexuality that encompasses all kinds of sexuality."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a9a35d2-1efc-44c3-9408-21066f6d2456",
                                                "sense_id": "bfbe99f5-dd88-316a-ab5e-0077a92e6cf0",
                                                "text": "Pansexuality encompasses all kinds of sexuality. It differs, however, from pansexualism, a perspective that declares “all desire and interest are derived from the sex instinct.” Pansexuality includes heterosexuality, homosexuality, bisexuality, and sexual behavior that does not necessarily involve a coupling. It includes, for example, masturbation, celibacy, fetishism, and fantasy. Moreover, pansexuality includes heteroerotic and homoerotic play and sexual aggression, sometimes mislabeled as “horseplay.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
