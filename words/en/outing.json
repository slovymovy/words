                },
                {
                    "sense_id": "7fae3da9-551b-3a1d-814e-ee6f248d1878",
                    "sense_definition": "The act of revealing someone's secret identity or hidden status, such as that of an undercover agent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>outing</w> of the secret agent put the entire intelligence operation at risk.",
                            "target_lang_translations": {
                                "ru": "<w>Разоблачение</w> секретного агента поставило под угрозу всю разведывательную операцию."
                            }
