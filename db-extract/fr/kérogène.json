                "senses": [
                    {
                        "sense_id": "e16eadee-9798-3e6c-9236-5226c7b6c845",
                        "entry_id": "4574ef68-ae27-38fc-9cd8-0177e99d660e",
                        "glosses": [
                            "Matière organique contenue dans les schistes bitumineux, susceptible de donner des hydrocarbures par distillation."
                        ],
                        "tags": [
                            "Chimie organique"
                        ],
                        "examples": [
                            {
                                "example_id": "c5a5ab42-6ed0-490c-b13f-5f55b160e5a0",
                                "sense_id": "e16eadee-9798-3e6c-9236-5226c7b6c845",
                                "text": "En l’absence d’oxygène, ces sédiments se transforment progressivement en kérogène, un hydrocarbure à l’origine du pétrole."
                            },
                            {
                                "example_id": "6debb1e7-722e-4337-b9df-5ae75e9b1c1e",
                                "sense_id": "e16eadee-9798-3e6c-9236-5226c7b6c845",
                                "text": "Cette transformation a abouti à un premier produit appelé kérogène."
                            },
                            {
                                "example_id": "ac035531-1a2d-4371-8ec5-bb42428c865e",
                                "sense_id": "e16eadee-9798-3e6c-9236-5226c7b6c845",
                                "text": "En injectant par un puits de l’air chaud dans la couche schisteuse, on provoquerait la combustion d’une partie du kérogène et la distillation du reste."
                            }
                        ]
                    }
                ],
