                    {
                        "sense_id": "98bf5368-76c8-3e31-bd14-93bf09e5b1f2",
                        "entry_id": "0697ea75-dc64-32ae-847b-da68f56505b1",
                        "glosses": [
                            "A very powerful magus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4cb30a3-07b8-4a9d-b6a4-716d7006bc47",
                                "sense_id": "98bf5368-76c8-3e31-bd14-93bf09e5b1f2",
                                "text": "A powerful archmagus, who could whisk himself from place to place with a few words of magic, did not travel the dusty roads of Ansalon on the back of a donkey unless he had good reason to want to dawdle in inns and gossip with the innkeepers, all the while keeping an eye on who came in and who went out."
                            },
                            {
                                "example_id": "ceebf7a5-e567-4f0f-918f-35ca7d2ac1d0",
                                "sense_id": "98bf5368-76c8-3e31-bd14-93bf09e5b1f2",
                                "text": "The archmagus had absolute authority over the Isle of Mid and everyone on it."
                            },
                            {
                                "example_id": "d2f809e3-56a1-4a13-bcef-5c83c748f51e",
                                "sense_id": "98bf5368-76c8-3e31-bd14-93bf09e5b1f2",
                                "text": "Gate of Archmagus Ginan’i: One of the five elder magic gates created to end the war between demons and elvenkind in the year 35,398 of the elven calendar. Created by Ginan’i Azurebright at the cost of the archmagus’s own life. […] By the rules of the magic he’d outlined, this gate demanded uncorrupted blood. In the parlance of the elven archmagi, that meant the blood of their own, nigh-immortal people."
                            }
                        ]
                    }
