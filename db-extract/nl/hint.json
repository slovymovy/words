                "senses": [
                    {
                        "sense_id": "becf669d-b568-3c17-b359-fbedb0cecf59",
                        "entry_id": "46f253e8-84bd-3039-9df2-025d2587d886",
                        "glosses": [
                            "etwas (Äußerung, Zeichen oder dergleichen), mit dem jemandem etwas angedeutet wird, mit dem jemand (unauffällig) auf etwas hingewiesen, aufmerksam gemacht wird; nützlicher Rat, der jemandem hilft"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0104adc-af6b-4c74-9d9e-0116a35dcf26",
                        "source_entry_id": "46f253e8-84bd-3039-9df2-025d2587d886",
                        "source_sense_id": "becf669d-b568-3c17-b359-fbedb0cecf59",
                        "target_lang_word": "Andeutung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Andeutung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acb9f1df-f1be-397b-a7dc-9eb5d9a10eef",
                                        "entry_id": "a3595aff-cd54-3ad0-bb48-686cc36bc7c0",
                                        "glosses": [
                                            "ein indirekter, undeutlicher, relativ vager Hinweis auf etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8edc9727-6e9c-4480-b38d-c1369f924148",
                                                "sense_id": "acb9f1df-f1be-397b-a7dc-9eb5d9a10eef",
                                                "text": "Ich komme durch schlimmen Weg und Wetter übel zugerichtet im Kloster an, ich lasse sie in Eurem Namen vor mich fordern, sie erscheint, und ich reiche ihr statt des Grußes den Stiefel hin, mit der Andeutung, sie solle mir ihn ausziehen. (Johann Wolfgang Goethe, Italienische Reise, Philipp Neri, der humoristische Heilige, zitiert nach Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "287124b2-d9ed-4eb4-b8d3-3b96e788c9b0",
                                                "sense_id": "acb9f1df-f1be-397b-a7dc-9eb5d9a10eef",
                                                "text": "„Die Gräfin war durch die Andeutungen Anna Michailownas bereits vorbereitet.“"
                                            },
                                            {
                                                "example_id": "d51f7296-9b9b-40a2-82cb-53566440cb41",
                                                "sense_id": "acb9f1df-f1be-397b-a7dc-9eb5d9a10eef",
                                                "text": "„Ich konnte weder an der Verschwiegenheit C. C.s zweifeln noch an der Aufrichtigkeit, mit der sie mir davon erzählt hätte, wenn sie ihrer Nonne auch nur die geringste Andeutung gemacht hätte.“"
                                            },
                                            {
                                                "example_id": "58b50150-cb06-46ec-87f7-56aba0161726",
                                                "sense_id": "acb9f1df-f1be-397b-a7dc-9eb5d9a10eef",
                                                "text": "„Die Dame des Hauses macht in großer Gesellschaft Andeutungen über ihr Alter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e9f7f866-d43b-34ff-8778-598217581137",
                                        "entry_id": "a3595aff-cd54-3ad0-bb48-686cc36bc7c0",
                                        "glosses": [
                                            "nicht ausgeprägte Darstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa711f41-a8c7-429f-b480-48813a19f3f0",
                                                "sense_id": "e9f7f866-d43b-34ff-8778-598217581137",
                                                "text": "Die Körperlichkeit Christi und der Heiligen ist zur bloßen Andeutung eingeschrumpft, aber diese Andeutung wird mit dem größten Aufwand des Stoffes und mit der emsigsten Sauberkeit zur Darstellung gebracht. (Jacob Burckhardt, Der Cicerone, Dritter Teil Malerei, zitiert nach Projekt Gutenberg)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "059c6cc1-ec9e-4874-a2d0-95c44030e96d",
                        "source_entry_id": "46f253e8-84bd-3039-9df2-025d2587d886",
                        "source_sense_id": "becf669d-b568-3c17-b359-fbedb0cecf59",
                        "target_lang_word": "Hinweis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hinweis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c414d8ef-664b-31d7-ad40-7756cf0c2616",
                                        "entry_id": "7d5c98c1-1e02-3f61-9061-e38b1a8a2c13",
                                        "glosses": [
                                            "die Handlung, jemanden auf etwas aufmerksam zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9a1f117-eb00-470b-ad50-922b4ba25ef7",
                                                "sense_id": "c414d8ef-664b-31d7-ad40-7756cf0c2616",
                                                "text": "Er gab ihm einen Hinweis."
                                            },
                                            {
                                                "example_id": "3304c28a-d672-49d0-951d-f1feef0355ab",
                                                "sense_id": "c414d8ef-664b-31d7-ad40-7756cf0c2616",
                                                "text": "„Es kam ihm vor, als ginge der amerikanische Hauptmann hastig über diesen Hinweis hinweg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30880ae7-ddf7-35a2-9042-e2df88883b15",
                                        "entry_id": "7d5c98c1-1e02-3f61-9061-e38b1a8a2c13",
                                        "glosses": [
                                            "etwas, das jemanden auf etwas aufmerksam macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103660e0-c1b7-4491-b683-4bc6d3f518df",
                                                "sense_id": "30880ae7-ddf7-35a2-9042-e2df88883b15",
                                                "text": "Die Kratzer waren Hinweise auf einen Kampf."
                                            },
                                            {
                                                "example_id": "545b71ba-e44c-41f7-845f-6766ef93f20a",
                                                "sense_id": "30880ae7-ddf7-35a2-9042-e2df88883b15",
                                                "text": "Wer zweckdienliche Hinweise zum Unfall geben kann, wird gebeten, sich bei der Polizei zu melden."
                                            },
                                            {
                                                "example_id": "4aeb0ad1-463a-4f53-a895-d21caf613f8b",
                                                "sense_id": "30880ae7-ddf7-35a2-9042-e2df88883b15",
                                                "text": "„Auch wenn die Schätzungen zu Hebungen in Afrika sehr weit auseinandergehen, gibt es doch Hinweise darauf, dass zum Beispiel das Gebirgsgebiet Namibias, welches aktuell bis über 2000 Meter hoch aufragt, in den letzten 10 Millionen Jahren um etwa 1000 Meter angehoben wurde.“"
                                            },
                                            {
                                                "example_id": "3c268747-56ce-4aa6-85f7-f41450a6abee",
                                                "sense_id": "30880ae7-ddf7-35a2-9042-e2df88883b15",
                                                "text": "„Vielleicht verbargen sich in ihrem Suchverlauf irgendwelche Hinweise darauf, dass sie geplant hatte, Eiríkur zu verlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04e911bb-7d7f-47fe-94eb-adb4fec1d639",
                        "source_entry_id": "46f253e8-84bd-3039-9df2-025d2587d886",
                        "source_sense_id": "becf669d-b568-3c17-b359-fbedb0cecf59",
                        "target_lang_word": "Tipp",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tipp",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40b291f5-1573-3dbe-8ff0-5531c9fde49a",
                                        "entry_id": "ce1ba888-d545-3ce3-bf40-3c6999f7ecba",
                                        "glosses": [
                                            "knapper, hilfreicher Hinweis, Ratschlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b80caa-4d0b-4dfd-8aa4-2f36fc35657e",
                                                "sense_id": "40b291f5-1573-3dbe-8ff0-5531c9fde49a",
                                                "text": "Kannst Du mir einen Tipp geben, wie ich dieses Programm richtig konfiguriere?"
                                            },
                                            {
                                                "example_id": "2c08a07a-4b9d-4cea-9b9c-e0dc7232f2ad",
                                                "sense_id": "40b291f5-1573-3dbe-8ff0-5531c9fde49a",
                                                "text": "Vielen Dank für den Tipp!"
                                            },
                                            {
                                                "example_id": "a32bfb7d-9844-4ea4-936c-050babbfb8c2",
                                                "sense_id": "40b291f5-1573-3dbe-8ff0-5531c9fde49a",
                                                "text": "„Dieses wurde zum heissen Tipp innerhalb der Bank, ausgestattet mit besonderen Vollmachten des obersten Patrons.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ecdacde5-fdca-3cc3-92b6-3bf9db8d30fe",
                                        "entry_id": "ce1ba888-d545-3ce3-bf40-3c6999f7ecba",
                                        "glosses": [
                                            "Vorhersage bei einer Wette"
                                        ],
                                        "tags": [
                                            "Glücksspiel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe08070f-36ff-472b-9d9f-e874245f535d",
                                                "sense_id": "ecdacde5-fdca-3cc3-92b6-3bf9db8d30fe",
                                                "text": "Mit dem Tipp hatte er nach dreißig Jahren Lottospielen mit einmal Glück und bekam € 20.000 ausgezahlt."
                                            },
                                            {
                                                "example_id": "61a3cae8-bd63-4a95-b1b9-66e65480131e",
                                                "sense_id": "ecdacde5-fdca-3cc3-92b6-3bf9db8d30fe",
                                                "text": "„Die Zuschauer geben ihren Tipp ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d516dfc8-60ae-42ac-a24b-a9b1ad4418ab",
                        "source_entry_id": "46f253e8-84bd-3039-9df2-025d2587d886",
                        "source_sense_id": "becf669d-b568-3c17-b359-fbedb0cecf59",
                        "target_lang_word": "Wink",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wink",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd59b20c-c98d-34e2-9c05-a9dcf5d74c54",
                                        "entry_id": "c5a257c1-abe8-3ea9-a1ac-36a719acc13e",
                                        "glosses": [
                                            "ein Zeichen mit Auge, Kopf, Hand oder Finger gegeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8134d04-f112-40df-8098-fa81023232a0",
                                                "sense_id": "dd59b20c-c98d-34e2-9c05-a9dcf5d74c54",
                                                "text": "Er gab ihr einen Wink und sie begann zu singen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05c54dbd-7c44-3282-b85d-2cc4a7f2658e",
                                        "entry_id": "c5a257c1-abe8-3ea9-a1ac-36a719acc13e",
                                        "glosses": [
                                            "eine Art versteckter oder aber auch sehr offensichtlicher Hinweis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845a6c45-e4ed-4a97-8ac0-6cf94910df77",
                                                "sense_id": "05c54dbd-7c44-3282-b85d-2cc4a7f2658e",
                                                "text": "Sie sah ihre Krankheit als einen Wink, ihr Leben ändern zu müssen."
                                            },
                                            {
                                                "example_id": "7a35e493-787d-4bb8-bd49-8ed4b0c25adc",
                                                "sense_id": "05c54dbd-7c44-3282-b85d-2cc4a7f2658e",
                                                "text": "„Robert, der den Wink, auf sich selber angewiesen zu bleiben, nicht überhörte, ließ sich von dem Beamten weiter informieren, ohne Fragen zu stellen.“"
                                            },
                                            {
                                                "example_id": "6078eafd-9d4a-46f2-a3f9-fb02986ebb0c",
                                                "sense_id": "05c54dbd-7c44-3282-b85d-2cc4a7f2658e",
                                                "text": "„Entweder hat Kästner sehr überzeugend argumentiert, oder, was viel wahrscheinlicher ist, es kam ein Wink von oben – das kann, bei seiner bekannten Film-Manie und einem solchen Prestigeprojekt, nur der Propagandaminister selbst gewesen sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
