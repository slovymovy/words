                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e37cb30-7b50-4afc-890b-9f9c22bb1e73",
                                "sense_id": "b6442423-08b0-3bfe-ac64-2ec6c5a406e0",
                                "text": "La collecte en porte à porte s’applique plus aux déchets ménagers qu’aux déchets industriels."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6021a0c-182a-30d4-a127-1878fb5dce13",
                        "entry_id": "6b3dbbde-6de7-3910-aba5-221b5cf83195",
                        "glosses": [
                            "Quête faite pour une œuvre de bienfaisance ou pour un objet d’intérêt commun."
