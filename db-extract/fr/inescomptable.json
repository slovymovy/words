        "fr-extract.jsonl": [
            {
                "entry_id": "1403b22b-9f68-3b31-bcb1-71dc4f296ddf",
                "word": "inescomptable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "23bfd248-20c2-485d-a27a-4a6ba5eed623",
                        "entry_id": "1403b22b-9f68-3b31-bcb1-71dc4f296ddf",
                        "tags": [
                            "plural"
                        ],
                        "form": "inescomptables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "177d0bbf-67e2-317f-a44a-9865fcb65522",
                        "entry_id": "1403b22b-9f68-3b31-bcb1-71dc4f296ddf",
                        "glosses": [
                            "Qui ne peut pas être escompté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ce7347f-6f7a-4ca2-8c4f-381a1f22475b",
                                "sense_id": "177d0bbf-67e2-317f-a44a-9865fcb65522",
                                "text": "On sait que le portefeuille de cet établissement est plein de bons inescomptables à l’étranger ; on est convaincu qu’il ne pourrait faire face au remboursement du quart de ses billets, s’il était exigé du jour au lendemain."
                            },
                            {
                                "example_id": "ad017a18-516e-45cc-bc4c-0d59c9599556",
                                "sense_id": "177d0bbf-67e2-317f-a44a-9865fcb65522",
                                "text": "Les clients viennent, mais ils règlent à longues échéances. Plusieurs sont véreux, leur papier est inescomptable."
                            }
                        ]
                    },
                    {
                        "sense_id": "9778ded9-cc8f-3f18-a7a9-e53c63cccbd5",
                        "entry_id": "1403b22b-9f68-3b31-bcb1-71dc4f296ddf",
                        "glosses": [
                            "Sur quoi il ne faut pas compter."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "340ecacb-8b27-4f48-a5c1-003b51fe9480",
                                "sense_id": "9778ded9-cc8f-3f18-a7a9-e53c63cccbd5",
                                "text": "À ce stade initial, le bonheur auquel pourra conduire l’écriture est imprévisible, inescomptable, et c’est seulement le désir qui permet au poète de surmonter son angoisse, de lui faire courir le risque de l’aventure."
                            }
                        ]
                    }
                ],
