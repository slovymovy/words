                ],
                "senses": [
                    {
                        "sense_id": "b2cf7d87-7deb-3b08-9434-735a9ba6b23f",
                        "entry_id": "803201f2-b4f8-3c5b-a418-302227563802",
                        "glosses": [
                            "pharmacist (“药剂师”)之同義詞； （中世纪或近现代时的）药剂师，卖药人"
                        ],
                        "tags": [
                            "form-of",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "80240978-0918-44dd-b84e-726a7ede0450",
                                "sense_id": "b2cf7d87-7deb-3b08-9434-735a9ba6b23f",
                                "text": "The girls, though their illness was long and dangerous, recovered under Mrs. Palmer's care, who watched over them as if they had been her own; and from that time an affection, as valuable as it was pleasant, sprang up between them. When Lady Anne returned, she called, and talked about every thing but the apothecary's bill."
                            },
                            {
                                "example_id": "aa03c8c6-8702-4f22-befb-d7f35e8df32c",
                                "sense_id": "b2cf7d87-7deb-3b08-9434-735a9ba6b23f",
                                "text": "It amused me to see the bustle and the life in the apothecary's shop across the street."
                            }
                        ]
                    },
                    {
                        "sense_id": "3385ac96-0019-33ec-9302-41a5baa3bc63",
                        "entry_id": "803201f2-b4f8-3c5b-a418-302227563802",
                        "glosses": [
                            "pharmacy (“药店”)之同義詞"
                        ],
                        "tags": [
                            "archaic",
                            "form-of",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "440b7724-e103-471d-be6a-abfebdbeb584",
                                "sense_id": "3385ac96-0019-33ec-9302-41a5baa3bc63",
                                "text": "The Russian people as a whole almost revered the apothecary, and they entered it as they would enter a sanctum."
                            },
                            {
                                "example_id": "37c20505-d62e-4e84-86b6-0ddef81bcb44",
                                "sense_id": "3385ac96-0019-33ec-9302-41a5baa3bc63",
                                "text": "He was befriended by a local druggist, Jay Miller, who worked at the apothecary at the corner of Sixth and Harrison Street."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fa36b26-cdb0-3941-b54d-33e6c713c2b2",
