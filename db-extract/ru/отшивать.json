                "senses": [
                    {
                        "sense_id": "50430b1b-68c2-345a-8dcf-d45c1ecf7664",
                        "entry_id": "a7116faf-7418-32b4-b067-9fe2a17248ac",
                        "glosses": [
                            "разг. отрывать, отделять что-либо пришитое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "763a1118-b519-47c6-8433-143a32094bd1",
                                "sense_id": "50430b1b-68c2-345a-8dcf-d45c1ecf7664",
                                "text": "Там уже застёгивали и расстёгивали, пришивали и отшивали другие «пуговицы»."
                            }
                        ]
                    },
                    {
                        "sense_id": "acac923c-96a8-3652-a802-abf232080d8b",
                        "entry_id": "a7116faf-7418-32b4-b067-9fe2a17248ac",
                        "glosses": [
                            "спец. откреплять, отдирать обшивку, тёс"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8d82ac50-8847-3cae-99b8-56f141693521",
                        "entry_id": "a7116faf-7418-32b4-b067-9fe2a17248ac",
                        "glosses": [
                            "прост. заставлять кого-либо прекратить свои посещения, ухаживания и т. п.; отваживать, прогонять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f29ef55-c184-48e5-b9fe-3028f78d0d7e",
                                "sense_id": "8d82ac50-8847-3cae-99b8-56f141693521",
                                "text": "Сам же предлагал тебе работать. Отказался, а теперь, выходит, вроде я тебя отшиваю."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a58d70f-ec56-37cd-88c2-4d3846fe8634",
                        "entry_id": "a7116faf-7418-32b4-b067-9fe2a17248ac",
                        "glosses": [
                            "проф. изготавливать шитьём"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3feedd5-29ec-45ff-9060-0401becc8d90",
                                "sense_id": "3a58d70f-ec56-37cd-88c2-4d3846fe8634",
                                "text": "Идем дальше и попадаем в мастерскую, где отшивают сумки лимитированных коллекций и знаменитые модели марки."
                            },
                            {
                                "example_id": "8e26dbdf-83ff-4894-8fd1-43f79dc7b59f",
                                "sense_id": "3a58d70f-ec56-37cd-88c2-4d3846fe8634",
                                "text": "Такие крупные заказы логично отшивать в Китае, однако могут возникнуть риски с таможней и сроками поставок."
                            }
                        ]
                    }
                ],
