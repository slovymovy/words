                        ]
                    },
                    {
                        "translation_id": "add46ffc-b46f-46e0-bfe6-e7835a7e42cc",
                        "source_entry_id": "84f67a56-8c1e-3896-891f-8b51db30852f",
                        "source_sense_id": "4dd59eae-afd6-36fd-9ba8-041fa7cb2d5c",
                        "target_lang_word": "forma de la palabra",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "966ba710-de21-438f-86f0-a7674a3da1a8",
                        "source_entry_id": "84f67a56-8c1e-3896-891f-8b51db30852f",
                        "source_sense_id": "4dd59eae-afd6-36fd-9ba8-041fa7cb2d5c",
                        "target_lang_word": "Wortform",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortform",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "042afaf7-6693-32f8-ae9f-b2a178114d5e",
                                        "entry_id": "e7b6a6b2-e58a-37c1-aeab-300184edcffe",
                                        "glosses": [
                                            "flektierte Form eines Wortes (Lexems)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f6ffd99-3466-4b0b-bd8e-bfe498897f99",
                                                "sense_id": "042afaf7-6693-32f8-ae9f-b2a178114d5e",
                                                "text": "Die Wortform des Wortes „Hut“ im Genitiv Singular lautet „Hutes“."
                                            },
                                            {
                                                "example_id": "3d879245-0950-40dd-8980-ecdb38b5e04a",
                                                "sense_id": "042afaf7-6693-32f8-ae9f-b2a178114d5e",
                                                "text": "„Nur Wortformen kommen in Sätzen vor, niemals Paradigmen oder lexikalische Wörter.“"
                                            },
                                            {
                                                "example_id": "88ce6824-1892-49c2-9080-ea5e9728ee23",
                                                "sense_id": "042afaf7-6693-32f8-ae9f-b2a178114d5e",
                                                "text": "Kürschner nennt die Wortform die Realisierungsform des Wortes und nennt sie die „[k]onkrete Form, in der ein Wort im Satz auftritt.“"
                                            },
                                            {
                                                "example_id": "702df2d4-1302-4312-bcb1-6a848ca7fdfe",
                                                "sense_id": "042afaf7-6693-32f8-ae9f-b2a178114d5e",
                                                "text": "„Es stellte sich nicht nur heraus, daß sich die Formen dieser Sprachen in ebensolche Bestandteile zerlegen ließen, sondern vor allem, daß sich die gewonnenen Endungen und Suffixe der einzelnen Sprachen ebenso vergleichen ließen wie die fertigen Wortformen.“"
                                            },
                                            {
                                                "example_id": "55675ba1-7c1e-4457-99f0-90358de7cb19",
                                                "sense_id": "042afaf7-6693-32f8-ae9f-b2a178114d5e",
                                                "text": "„Daß eine Wortform von 3 oder auch 4 Silben dabei auf eine einzige Silbe zusammenschmolz, ist ziemlich häufig.“"
                                            },
                                            {
                                                "example_id": "8db660a8-1c44-414a-a20d-3dc09d4614c4",
                                                "sense_id": "042afaf7-6693-32f8-ae9f-b2a178114d5e",
                                                "text": "„Bei dieser Redeweise trennt man allerdings oft nicht zwischen Wortformen und Lexemen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
