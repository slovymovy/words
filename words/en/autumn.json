{
    "word_family": [
        "autumnal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb952388-99aa-3240-bf65-a5ceb19f360c",
                    "sense_definition": "The season of the year between summer and winter, when leaves change color and the weather becomes cooler.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "season",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trees look beautiful in the <w>autumn</w>.",
                            "target_lang_translations": {
                                "ru": "Деревья выглядят красиво <w>осенью</w>.",
                                "zh": "树木在<w>秋天</w>看起来很美。"
                            }
                        },
                        {
                            "text": "We are planning a trip to the mountains for early <w>autumn</w>.",
                            "target_lang_translations": {
                                "ru": "Мы планируем поездку в горы на начало <w>осени</w>.",
                                "zh": "我们计划在初<w>秋</w>去山区旅行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fall"
                    ],
                    "antonyms": [
                        "spring"
                    ],
                    "common_phrases": [
                        "in the autumn",
                        "autumn leaves",
                        "early autumn",
                        "late autumn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время года между летом и зимой, когда листья меняют цвет, а погода становится прохладнее.",
                        "zh": "一年四季中介于夏季和冬季之间的季节，此时树叶变色，天气转凉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осень",
                                "target_lang_sense_clarification": "время года"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秋天",
                                "target_lang_sense_clarification": "一年四季中的第三个季节"
                            },
                            {
                                "target_lang_word": "秋季",
                                "target_lang_sense_clarification": "秋天的正式称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e64df27-d291-3340-897f-c221285022d1",
                    "sense_definition": "The later part of a person's life or a period of time, often associated with aging or gradual decline.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wrote his memoirs in the <w>autumn</w> of his life.",
                            "target_lang_translations": {
                                "ru": "Он написал свои мемуары на <w>закате</w> своей жизни.",
                                "zh": "他在<w>晚年</w>写下了自己的回忆录。"
                            }
                        },
                        {
                            "text": "The empire was in its <w>autumn</w> and beginning to lose its power.",
                            "target_lang_translations": {
                                "ru": "Империя переживала свой <w>закат</w> и начинала терять власть.",
                                "zh": "这个帝国正处于<w>暮年</w>，开始失去权力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decline"
                    ],
                    "antonyms": [
                        "spring"
                    ],
                    "common_phrases": [
                        "autumn of life",
                        "autumn years"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or poetic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поздний период жизни человека или отрезок времени, часто ассоциирующийся со старением или постепенным упадком.",
                        "zh": "人生的晚年或某段时期的末尾，常与衰老或逐渐衰落联系在一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закат",
                                "target_lang_sense_clarification": "конец, упадок"
                            },
                            {
                                "target_lang_word": "осень",
                                "target_lang_sense_clarification": "перен. период увядания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晚年",
                                "target_lang_sense_clarification": "人生的最后阶段"
                            },
                            {
                                "target_lang_word": "暮年",
                                "target_lang_sense_clarification": "指老年时期，常用于文学语境"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1be1bd9e-5558-3a56-bfd2-2b625c9834db",
                    "sense_definition": "A female given name derived from the season.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I met a girl named <w>Autumn</w> at school today.",
                            "target_lang_translations": {
                                "ru": "Сегодня в школе я встретил девочку по имени <w>Отом</w>.",
                                "zh": "今天在学校我遇见了一个叫<w>奥特姆</w>的女孩。"
                            }
                        },
                        {
                            "text": "<w>Autumn</w> is coming to the party later.",
                            "target_lang_translations": {
                                "ru": "<w>Отом</w> придет на вечеринку позже.",
                                "zh": "<w>奥特姆</w>待会儿会来参加聚会。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, происходящее от названия времени года.",
                        "zh": "源自季节名称的女性英文名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Отом",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奥特姆",
                                "target_lang_sense_clarification": "女性英文名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                    "sense_definition": "To spend the autumn season in a particular place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family <w>autumned</w> in their cottage by the lake.",
                            "target_lang_translations": {
                                "ru": "Семья <w>проводила осень</w> в своем коттедже у озера.",
                                "zh": "那家人在湖边的小屋里<w>秋居</w>。"
                            }
                        },
                        {
                            "text": "She usually <w>autumns</w> in New York to enjoy the city atmosphere.",
                            "target_lang_translations": {
                                "ru": "Она обычно <w>проводит осень</w> в Нью-Йорке, чтобы насладиться атмосферой города.",
                                "zh": "她通常在纽约<w>秋居</w>，以享受那里的城市氛围。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить осенний сезон в определенном месте.",
                        "zh": "在某个地方度过秋季。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить осень",
                                "target_lang_sense_clarification": "жить где-либо осенью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秋居",
                                "target_lang_sense_clarification": "在某地度过秋天"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}