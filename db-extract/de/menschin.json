                ],
                "senses": [
                    {
                        "sense_id": "ce97ebcc-9e73-3bd1-94ee-56a2bfc16a21",
                        "entry_id": "1bba4fda-9dea-3800-a032-d6cd6bc8fe7e",
                        "glosses": [
                            "Angehörige der Art Homo sapiens der Gattung Homo aus der Familie der Menschenaffen, die zur Ordnung der Primaten und damit zu den höheren Säugetieren gehört."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "83e85346-1909-4483-901f-209a833a033c",
                                "sense_id": "ce97ebcc-9e73-3bd1-94ee-56a2bfc16a21",
                                "text": "„Der Kapitalhirsch Sultan im Wildgatter, der den Hirschkühen seines Harems so viel wie sie ihm Ehre machte, hatte sich einmal in eine Menschin, will sagen eine Magd, verliebt, die innerhalb der Umzäunung Gras mähte.“"
                            },
                            {
                                "example_id": "d208a399-b365-4db3-ac64-56d09d1c43c0",
                                "sense_id": "ce97ebcc-9e73-3bd1-94ee-56a2bfc16a21",
                                "text": "„Es konnte ja sein, daß ein so guter und reiner Mensch, wie er, die Macht hatte, den Bösen zu zwingen und aus einer schönen Teufelin eine Menschin zu machen, neben der gut hausen sei.“"
                            },
                            {
                                "example_id": "172d4a52-6dd0-4dc0-bc85-1359dab85392",
                                "sense_id": "ce97ebcc-9e73-3bd1-94ee-56a2bfc16a21",
                                "text": "„Menschen haben Menschen beschrieben, an den Himmel projizierte nannten sie: Götter, sie schrieben von Göttern, beschrieben Götter, als wären es Menschen, manche schlimmer als Menschen, menschliche und unmenschliche Götter lebten und handelten, führten Krieg, führten Liebe gegen Götter und Göttinnen und Menschinnen und Menschen: Menschen haben von jeher Menschen beschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
