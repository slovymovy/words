                "senses": [
                    {
                        "sense_id": "9ebe3291-83f1-3109-a3d4-6c9040280652",
                        "entry_id": "0c874a3e-f268-3308-a761-57c9447f2389",
                        "glosses": [
                            "Schule (in freier Trägerschaft), an der nach den Methoden von Rudolf Steiner unterrichtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73009685-5573-4c5b-87c7-a42665296fff",
                                "sense_id": "9ebe3291-83f1-3109-a3d4-6c9040280652",
                                "text": "„Waldorfschulen sind 12-jährige Gesamtschulen und haben in Deutschland den Status staatlich anerkannter Ersatzschulen in freier Trägerschaft.“"
                            },
                            {
                                "example_id": "ff2ce428-febe-45ac-b4a8-49ac37f5555e",
                                "sense_id": "9ebe3291-83f1-3109-a3d4-6c9040280652",
                                "text": "„Schüler können an einer Waldorfschule einerseits auf das staatlich anerkannte Abitur vorbereitet werden, andererseits verteilt die Waldorfschule auch Berufsabschlüsse.“"
                            },
                            {
                                "example_id": "6cb1d8a1-b87b-46ab-aac0-2e3121607583",
                                "sense_id": "9ebe3291-83f1-3109-a3d4-6c9040280652",
                                "text": "„Bereits im September 1919 konnte in Stuttgart-Ost die erste Waldorfschule eröffnet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
