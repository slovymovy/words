                                "target_senses": [
                                    {
                                        "sense_id": "310f93c4-94da-37f0-b7a8-d849fc911787",
                                        "entry_id": "a8cb7a4b-60ec-3228-8e7c-ff93fe941ed4",
                                        "glosses": [
                                            "A transducer that converts electric signals into sound and is held near the ear, especially as part of a telephone; an earpiece or headphone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0fe41de-bd60-4779-a032-37a07887b9bb",
                        "source_entry_id": "5f6068aa-a8f9-3a59-9a44-6c81d7bace7f",
                        "source_sense_id": "f58e59a2-2589-3287-a336-c4d1b28363a2",
                        "source_sense_description": "sehr kleiner Schallwandler, der an oder in den Ohren getragen wird",
                        "target_lang_word": "écouteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écouteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d36455ec-f4c4-3580-a3b2-4284b141a999",
                                        "entry_id": "6586b1f9-45e7-3226-a43f-9c9e64190281",
                                        "glosses": [
                                            "Personne qui a l’habitude d’écouter, par une curiosité indiscrète, ce qu’on ne veut pas lui faire connaître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad99a015-84d5-4bf0-a7d5-5da7b71c3b3c",
                                                "sense_id": "d36455ec-f4c4-3580-a3b2-4284b141a999",
                                                "text": "Écouteur malgré moi, je voulus m’en aller, tout au moins faire quelque mouvement qui leur signalât ma présence ; mais quoi ? tousser ? crier : je suis là ! je vous entends !… et ce fut bien plutôt la gêne et la timidité, que la curiosité d’en entendre davantage, qui me tinrent coi."
                                            },
                                            {
                                                "example_id": "a921e71f-0f48-4509-af21-2a75deeb2070",
                                                "sense_id": "d36455ec-f4c4-3580-a3b2-4284b141a999",
                                                "text": "Mais l’écouteur en avait entendu suffisamment pour que les oreilles lui en brûlassent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e080b5-817c-3d82-a513-8d9bb28179f4",
                                        "entry_id": "6586b1f9-45e7-3226-a43f-9c9e64190281",
                                        "glosses": [
                                            "Appareil qui permet d’écouter une communication, un enregistrement, de la musique, etc. Ce terme est généralement utilisé au pluriel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a702946-9f7e-452b-a126-9822174214a5",
                                                "sense_id": "88e080b5-817c-3d82-a513-8d9bb28179f4",
                                                "text": "Petit bémol : ces écouteurs ne sont pas multipoints."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00af1f62-bfef-4c31-970d-e03e44712f5f",
                        "source_entry_id": "5f6068aa-a8f9-3a59-9a44-6c81d7bace7f",
                        "source_sense_id": "f58e59a2-2589-3287-a336-c4d1b28363a2",
                        "source_sense_description": "sehr kleiner Schallwandler, der an oder in den Ohren getragen wird",
                        "target_lang_word": "наушники",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "наушники",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3d6de7-9652-3cc2-87ac-b0e6dec99b03",
                                        "entry_id": "4be01380-0352-3eb0-b8e9-c419419b0757",
                                        "glosses": [
                                            "форма именительного или винительного падежа множественного числа существительного наушник"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "наушники",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3a4ed10a-b46c-3338-b0b3-6bc455f6c714",
                                        "entry_id": "1178c23a-1085-3e4c-be71-bb1d99fb423c",
                                        "glosses": [
                                            "часть головного убора, закрывающая уши"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c42178e-078f-4d37-a804-c9ec51ba6f8f",
                                                "sense_id": "3a4ed10a-b46c-3338-b0b3-6bc455f6c714",
                                                "text": "Не было блестящих киверов ― все солдаты в фуражках, шинелях, тёплых наушниках."
                                            },
                                            {
                                                "example_id": "f2fbec97-726e-447c-92ac-5862c1284529",
                                                "sense_id": "3a4ed10a-b46c-3338-b0b3-6bc455f6c714",
                                                "text": "Развязанные наушники его облезлой меховой шапки бессильно свисали вниз, как уши у легавой собаки, и было влажно под маленьким красноватым носиком."
                                            },
                                            {
                                                "example_id": "98902eba-0c0b-4146-b955-1583307b984d",
                                                "sense_id": "3a4ed10a-b46c-3338-b0b3-6bc455f6c714",
                                                "text": "Наступили холода ― появились обывательские головные уборы с наушниками. И вот, нарядившись в наушники, обыватель победоносно шествует по улицам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12a09404-1b71-357e-a37b-0e0f88db0471",
                                        "entry_id": "1178c23a-1085-3e4c-be71-bb1d99fb423c",
                                        "glosses": [
                                            "футляры из тёплой материи, закрывающие уши"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b05f2876-c40f-3dc3-ab48-db1805c399e3",
                                        "entry_id": "1178c23a-1085-3e4c-be71-bb1d99fb423c",
                                        "glosses": [
                                            "техн. прикладываемый к ушам или надеваемый на уши прибор для слушания, соединённый со звукопередающим аппаратом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ba2c205-2e24-449f-a6d0-a24ac70df4c7",
                                                "sense_id": "b05f2876-c40f-3dc3-ab48-db1805c399e3",
                                                "text": "К примеру, можно идти по городу в модных наушниках, а слушать ― «Гамлета», «Ромео и Джульетту»."
                                            },
                                            {
                                                "example_id": "063babe6-69df-4192-a5b7-45968d3c3dd9",
                                                "sense_id": "b05f2876-c40f-3dc3-ab48-db1805c399e3",
                                                "text": "В этих опытах испытуемым внезапно подавался в наушники резкий звуковой сигнал опасности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
