    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6ba977b-737d-3e2d-af93-2c5d9c703f6b",
                    "sense_definition": "To take action to solve a problem, handle a situation, or manage a person.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manage_cope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has to <w>deal</w> with difficult customers every day at work.",
                            "target_lang_translations": {
                                "ru": "Ей приходится <w>иметь дело</w> с трудными клиентами каждый день на работе.",
                                "pl": "Ona musi <w>radzić sobie</w> z trudnymi klientami każdego dnia w pracy."
                            }
                        },
                        {
                            "text": "I cannot <w>deal</w> with this noise anymore.",
                            "target_lang_translations": {
                                "ru": "Я больше не могу <w>мириться</w> с этим шумом.",
                                "pl": "Nie mogę już <w>wytrzymać</w> z tym hałasem."
                            }
                        }
                    ],
                    "synonyms": [
                        "handle",
                        "manage",
                        "cope"
                    ],
                    "antonyms": [
                        "ignore",
                        "neglect"
                    ],
                    "common_phrases": [
                        "deal with",
                        "deal with it"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предпринимать действия для решения проблемы, управления ситуацией или взаимодействия с человеком.",
                        "pl": "Podejmowanie działań w celu rozwiązania problemu, poradzenia sobie z sytuacją lub zarządzania osobą."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь дело",
                                "target_lang_sense_clarification": "взаимодействовать"
                            },
                            {
                                "target_lang_word": "справляться",
                                "target_lang_sense_clarification": "решать проблему"
                            },
                            {
                                "target_lang_word": "заниматься",
                                "target_lang_sense_clarification": "решать вопрос"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "radzić sobie",
                                "target_lang_sense_clarification": "z sytuacją lub problemem"
                            },
                            {
                                "target_lang_word": "zajmować się",
                                "target_lang_sense_clarification": "sprawą lub osobą"
                            },
                            {
                                "target_lang_word": "postępować",
                                "target_lang_sense_clarification": "z kimś w określony sposób"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f4403e7-9481-3381-b64c-7a09dd521a13",
                    "sense_definition": "To buy and sell goods or services as a business activity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trade_business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company used to <w>deal</w> in rare antiques before it closed.",
                            "target_lang_translations": {
                                "ru": "Компания раньше <w>торговала</w> редким антиквариатом до закрытия.",
                                "pl": "Firma <w>handlowała</w> rzadkimi antykami, zanim została zamknięta."
                            }
                        },
                        {
                            "text": "He only wants to <w>deal</w> with reputable suppliers.",
                            "target_lang_translations": {
                                "ru": "Он хочет <w>иметь дело</w> только с надежными поставщиками.",
                                "pl": "On chce <w>robić interesy</w> tylko z renomowanymi dostawcami."
                            }
                        }
                    ],
                    "synonyms": [
                        "trade",
                        "sell"
                    ],
                    "common_phrases": [
                        "deal in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покупать и продавать товары или услуги в качестве коммерческой деятельности.",
                        "pl": "Kupowanie i sprzedawanie towarów lub usług w ramach działalności gospodarczej."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торговать",
                                "target_lang_sense_clarification": "вести торговлю"
                            },
                            {
                                "target_lang_word": "вести дела",
                                "target_lang_sense_clarification": "заниматься бизнесом"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "handlować",
                                "target_lang_sense_clarification": "towarami"
                            },
                            {
                                "target_lang_word": "prowadzić interesy",
                                "target_lang_sense_clarification": "z kimś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b73e5a08-ec9a-3f0c-ac44-9a276856d4a7",
                    "sense_definition": "To distribute playing cards to players in a game.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is your turn to <w>deal</w> the cards for the next round.",
                            "target_lang_translations": {
                                "ru": "Твоя очередь <w>сдавать</w> карты для следующего раунда.",
                                "pl": "Twoja kolej, żeby <w>rozdać</w> karty w następnej rundzie."
                            }
                        },
                        {
                            "text": "The casino employee will <w>deal</w> two cards to every player.",
                            "target_lang_translations": {
                                "ru": "Сотрудник казино <w>раздаст</w> по две карты каждому игроку.",
                                "pl": "Pracownik kasyna <w>rozda</w> po dwie karty każdemu graczowi."
                            }
                        }
                    ],
                    "synonyms": [
                        "distribute",
                        "hand out"
                    ],
                    "common_phrases": [
                        "deal the cards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздавать игральные карты игрокам в игре.",
                        "pl": "Rozdzielanie kart do gry pomiędzy graczy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "карты"
                            },
                            {
                                "target_lang_word": "раздавать",
                                "target_lang_sense_clarification": "распределять карты"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozdawać",
                                "target_lang_sense_clarification": "karty"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e33c506-165a-3b3e-8c8f-4d0c7ad01a0c",
                    "sense_definition": "To sell illegal drugs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trade_business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the man who used to <w>deal</w> on this corner.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала мужчину, который <w>торговал</w> на этом углу.",
                                "pl": "Policja aresztowała mężczyznę, który <w>handlował</w> na tym rogu."
                            }
                        },
                        {
                            "text": "He was caught trying to <w>deal</w> drugs to an undercover officer.",
                            "target_lang_translations": {
                                "ru": "Его поймали при попытке <w>сбыть</w> наркотики агенту под прикрытием.",
                                "pl": "Został złapany na próbie <w>sprzedaży</w> narkotyków tajnemu agentowi."
                            }
                        }
                    ],
                    "synonyms": [
                        "push",
                        "sell"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often implies illegal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продавать запрещенные наркотические вещества.",
                        "pl": "Sprzedawanie nielegalnych narkotyków."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торговать",
                                "target_lang_sense_clarification": "наркотиками"
                            },
                            {
                                "target_lang_word": "сбывать",
                                "target_lang_sense_clarification": "продавать незаконно"
                            },
                            {
                                "target_lang_word": "барыжить",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "handlować",
                                "target_lang_sense_clarification": "narkotykami"
                            },
                            {
                                "target_lang_word": "dilować",
                                "target_lang_sense_clarification": "slangowo o narkotykach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66079279-a074-37fc-bf74-a09ef541af55",
                    "sense_definition": "To inflict or administer something, such as a blow, damage, or punishment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loss of funding will <w>deal</w> a heavy blow to the project.",
                            "target_lang_translations": {
                                "ru": "Внезапная потеря финансирования <w>нанесет</w> тяжелый удар по проекту.",
                                "pl": "Nagła utrata finansowania <w>zada</w> ciężki cios projektowi."
                            }
                        },
                        {
                            "text": "The judge promised to <w>deal</w> out justice fairly to all parties.",
                            "target_lang_translations": {
                                "ru": "Судья пообещал справедливо <w>вершить</w> правосудие для всех сторон.",
                                "pl": "Sędzia obiecał sprawiedliwie <w>wymierzyć</w> sprawiedliwość wszystkim stronom."
                            }
                        }
                    ],
                    "synonyms": [
                        "inflict",
                        "deliver",
                        "administer"
                    ],
                    "common_phrases": [
                        "deal a blow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять или осуществлять что-либо, например удар, урон или наказание.",
                        "pl": "Zadawanie lub wymierzanie czegoś, np. ciosu, szkody lub kary."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наносить",
                                "target_lang_sense_clarification": "удар, урон"
                            },
                            {
                                "target_lang_word": "вершить",
                                "target_lang_sense_clarification": "правосудие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zadawać",
                                "target_lang_sense_clarification": "cios lub ból"
                            },
                            {
                                "target_lang_word": "wymierzać",
                                "target_lang_sense_clarification": "karę lub sprawiedliwość"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8fbfafd9-c9ed-38f4-a54f-189147d80a76",
                    "sense_definition": "An agreement or arrangement, especially in business or politics.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "trade_business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We made a <w>deal</w> to sell the house next month.",
                            "target_lang_translations": {
                                "ru": "Мы заключили <w>сделку</w> о продаже дома в следующем месяце.",
                                "pl": "Zawarliśmy <w>umowę</w> sprzedaży domu w przyszłym miesiącu."
                            }
                        },
                        {
                            "text": "It is a done <w>deal</w> and we cannot change it now.",
                            "target_lang_translations": {
                                "ru": "Это решенное <w>дело</w>, и мы не можем это изменить сейчас.",
                                "pl": "To <w>załatwiona sprawa</w> i nie możemy jej teraz zmienić."
                            }
                        }
                    ],
                    "synonyms": [
                        "agreement",
                        "contract",
                        "bargain"
                    ],
                    "common_phrases": [
                        "make a deal",
                        "cut a deal",
                        "done deal",
                        "big deal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соглашение или договоренность, особенно в бизнесе или политике.",
                        "pl": "Umowa lub porozumienie, szczególnie w biznesie lub polityce."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделка",
                                "target_lang_sense_clarification": "соглашение"
                            },
                            {
                                "target_lang_word": "договор",
                                "target_lang_sense_clarification": "контракт"
                            },
                            {
                                "target_lang_word": "соглашение",
                                "target_lang_sense_clarification": "договоренность"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "umowa",
                                "target_lang_sense_clarification": "zobowiązanie"
                            },
                            {
                                "target_lang_word": "układ",
                                "target_lang_sense_clarification": "porozumienie"
                            },
                            {
                                "target_lang_word": "interes",
                                "target_lang_sense_clarification": "transakcja"
                            }
                        ]
