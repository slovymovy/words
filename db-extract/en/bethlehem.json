                                        "glosses": [
                                            "miasto w środkowej części Palestyny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a910d92-cb99-4799-8f77-c83cb97c4758",
                                                "sense_id": "8ebce729-e2aa-3e43-94de-ec4757cbd61e",
                                                "text": "Do Betlejemu pełni radości, / Śpieszmy powitać Jezusa małego"
                                            },
                                            {
                                                "example_id": "2ffa7116-753d-4ba1-9c90-c89749ec7be7",
                                                "sense_id": "8ebce729-e2aa-3e43-94de-ec4757cbd61e",
                                                "text": "Rzemieślnicy z Betlejem wyrabiają pamiątki z masy perłowej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0765c72-42e5-426c-8c54-b094f2c1ccb0",
                        "source_entry_id": "8e47367b-2d91-3b57-b9e9-8679ce0a19e7",
