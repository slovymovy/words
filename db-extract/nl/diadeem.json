                    {
                        "translation_id": "8b499345-0b77-453e-8e28-fe87cd52c174",
                        "source_entry_id": "0ca3a4be-7ef9-3167-a035-119bc50bf94e",
                        "source_sense_id": "b9823185-6861-3069-a84a-88428cd8c4a8",
