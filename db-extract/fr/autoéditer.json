                                "example_id": "82733566-0cf5-4da1-aafc-5f3aea46095a",
                                "sense_id": "57d26a7a-bc8e-3bb2-96fd-cdb89441e0a9",
                                "text": "Traditionnellement, seuls les auteurs refusés par les éditeurs professionnels choisissaient de s’autoéditer."
                            },
                            {
                                "example_id": "520c0ce0-9f6a-4c0f-835e-f2f39e43f3ea",
                                "sense_id": "57d26a7a-bc8e-3bb2-96fd-cdb89441e0a9",
                                "text": "S’autoéditer, un pari sur l’avenir !"
                            },
                            {
                                "example_id": "6bdf7e3f-0f41-43c7-85f5-99f3e45132d7",
                                "sense_id": "57d26a7a-bc8e-3bb2-96fd-cdb89441e0a9",
                                "text": "Comment autoéditer un livre électronique (E-book) ?"
                            }
