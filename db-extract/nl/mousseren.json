                        "source_entry_id": "e7008fd4-3dde-3334-ab08-33167b306f89",
                        "source_sense_id": "7a81d7f6-7989-3e17-90ee-57e7d644f941",
                        "target_lang_word": "mousser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mousser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25904cc0-f9ae-38e4-aea0-2d582e432532",
                                        "entry_id": "9a1b30c9-5559-3184-879a-b3bac0605f63",
                                        "glosses": [
                                            "Produire de la mousse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbaef709-0ee5-4b46-b782-8bb5ca4ede60",
                                                "sense_id": "25904cc0-f9ae-38e4-aea0-2d582e432532",
                                                "text": "Verser de la bière de haut pour la faire mousser."
                                            },
                                            {
                                                "example_id": "11bfde59-d096-4c3a-ae44-3c93a854e10e",
                                                "sense_id": "25904cc0-f9ae-38e4-aea0-2d582e432532",
                                                "text": "Le vin de Champagne mousse."
                                            },
                                            {
                                                "example_id": "9c19aa11-e3cd-4eff-b130-7804ed7e1a60",
                                                "sense_id": "25904cc0-f9ae-38e4-aea0-2d582e432532",
                                                "text": "Faire mousser le chocolat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14c0aedc-21f9-3bd0-bd65-754d9b88dedb",
                                        "entry_id": "9a1b30c9-5559-3184-879a-b3bac0605f63",
                                        "glosses": [
                                            "Vanter, mettre en avant, faire valoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8ce5372-411f-4f42-bb52-08d1e38d8668",
                                                "sense_id": "14c0aedc-21f9-3bd0-bd65-754d9b88dedb",
                                                "text": "Faire mousser, présenter une chose, la raconter de manière à la faire croire plus considérable, plus glorieuse qu’elle n’est en effet."
                                            },
                                            {
                                                "example_id": "aa912061-0eeb-47d9-b1fa-6bd30ce4017b",
                                                "sense_id": "14c0aedc-21f9-3bd0-bd65-754d9b88dedb",
                                                "text": "Ça ne rate jamais : qu’il vienne n’importe qui en visite, dame patronnesse, délégué cantonal, conseiller, si on veut faire mousser l’école, on présente Marie ; et l’on ne rate jamais non plus d’entendre la fameuse question : « Qu’est-ce que c’est donc que cet enfant-là ? »"
                                            },
                                            {
                                                "example_id": "397480a6-124a-452d-a11c-97392b52986c",
                                                "sense_id": "14c0aedc-21f9-3bd0-bd65-754d9b88dedb",
                                                "text": "Le ministre de l’Économie et de l’Innovation du Québec, Pierre Fitzgibbon, a tenu à préciser mercredi qu’il ne moussait aucune candidature en vue de remplacer Valérie Plante à la mairie de Montréal en 2021."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
