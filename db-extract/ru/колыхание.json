                                        "sense_id": "64e737f7-a0ea-33ec-b11a-b9075dd4b37b",
                                        "entry_id": "b0dafd50-4583-3da0-8fdb-598b7655c8d7",
                                        "glosses": [
                                            "Fine, good, successful."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10171a65-ac45-4347-b205-64a86420d049",
                                                "sense_id": "64e737f7-a0ea-33ec-b11a-b9075dd4b37b",
                                                "text": "1964, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nDidn't do anything great except saw \"The Beatles\" on The Ed Sullivan Show and Kathy practically had a bird. They are sorta cute but I think Ringo is swingin, George is cute, Paul is a good singer and John is icky. Too!"
                                            },
                                            {
                                                "example_id": "e264e948-a97d-4233-a1bb-061ef8c2a605",
                                                "sense_id": "64e737f7-a0ea-33ec-b11a-b9075dd4b37b",
                                                "text": "The party was swinging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61c7aa06-1ef1-3789-9c15-c7abf3fc1e0c",
                                        "entry_id": "b0dafd50-4583-3da0-8fdb-598b7655c8d7",
                                        "glosses": [
                                            "Sexually promiscuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d44bce36-6f60-4f82-a302-ded641c64930",
                                                "sense_id": "61c7aa06-1ef1-3789-9c15-c7abf3fc1e0c",
                                                "text": "Hey, everyone fantasizes about what kind of swinging stud or studette they could be if they were only free from the shackles of domesticity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swinging",
