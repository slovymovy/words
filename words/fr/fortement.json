    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                    "sense_definition": "Avec force, vigueur ou puissance physique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut appuyer <w>fortement</w> sur le bouton pour déclencher l'alarme.",
                            "target_lang_translations": {
                                "en": "You need to press the button <w>hard</w> to set off the alarm.",
                                "ru": "Чтобы включить сигнализацию, нужно <w>сильно</w> нажать на кнопку.",
                                "de": "Man muss den Knopf <w>fest</w> drücken, um den Alarm auszulösen.",
                                "es": "Hay que presionar <w>fuertemente</w> el botón para activar la alarma.",
                                "zh": "要触发警报，必须<w>用力</w>按下按钮。"
                            }
                        },
                        {
                            "text": "Le vent soufflait <w>fortement</w> contre les volets de la maison.",
                            "target_lang_translations": {
                                "en": "The wind was blowing <w>hard</w> against the shutters of the house.",
                                "ru": "Ветер <w>сильно</w> дул на ставни дома.",
                                "de": "Der Wind wehte <w>heftig</w> gegen die Fensterläden des Hauses.",
                                "es": "El viento soplaba <w>fuertemente</w> contra las contraventanas de la casa.",
                                "zh": "风<w>猛烈</w>地拍打着房子的百叶窗。"
                            }
                        }
