                        "examples": [
                            {
                                "example_id": "acd74876-cde8-417f-bb3a-3c6cbebda4ff",
                                "sense_id": "bf556752-7a32-3637-8a8c-6ff6cf96508e",
                                "text": "The wind that blows across them calls\nEver at dawns and evenfalls,\nAnd I am suddenly forlorn.\nAcross the pastures and ripe corn\nI see the mountains in my dreams."
                            },
                            {
                                "example_id": "fefb99c9-f37f-49c3-b0eb-e0cb19432303",
                                "sense_id": "bf556752-7a32-3637-8a8c-6ff6cf96508e",
                                "text": "Arriving at Brinkley in the quiet evenfall and putting the old machine away in the garage, I noticed that Aunt Dahlia's car was there and gathered from this that the aged relative was around and about once more."
                            }
                        ]
                    }
                ],
