                                "target_senses": [
                                    {
                                        "sense_id": "df01a9f2-3645-3371-af32-6057144b0234",
                                        "entry_id": "209570b6-b74d-31b6-9f61-234a32bf6e9b",
                                        "glosses": [
                                            "Gallenwirkstoff in Arzneimitteln, der am Aufbau von Zellwänden beteiligt ist und die Ablagerung von Fett im Organismus hemmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20329ab6-77f3-4ba3-8532-6dd49e543265",
                                                "sense_id": "df01a9f2-3645-3371-af32-6057144b0234",
                                                "text": "Cholin ist in Blut, Galle, Harn und Sperma enthalten."
                                            },
                                            {
                                                "example_id": "078ccd30-7dfb-4b65-99dd-062a61f36177",
                                                "sense_id": "df01a9f2-3645-3371-af32-6057144b0234",
                                                "text": "Besonders bei der Leistung des Gedächtnisses lassen sich viele vorbeugenden Maßnahmen ergreifen, um im Alter fit zu sein. Cholin ist hier von immenser Bedeutung."
                                            },
                                            {
                                                "example_id": "6157dbaf-ecaf-4c34-a056-84db0df33e8d",
                                                "sense_id": "df01a9f2-3645-3371-af32-6057144b0234",
                                                "text": "Zudem hat Cholin eine Wirkung auf den Stoffwechsel und ist bei der Synthese verschiedener Enzyme und Hormone beteiligt."
                                            },
                                            {
                                                "example_id": "54ce2bd6-26f3-4f75-b1cb-183d2a364df5",
                                                "sense_id": "df01a9f2-3645-3371-af32-6057144b0234",
                                                "text": "Die Nerven-Erneuerer Cholin und Inositol gehören beide zur Gruppe der B-Vitamine und sind Bestandteile von Lecithin."
                                            },
                                            {
                                                "example_id": "81c9be26-03cc-49fa-acb9-f4fe00f320d5",
                                                "sense_id": "df01a9f2-3645-3371-af32-6057144b0234",
                                                "text": "Benötigt wird Serin für die Synthese von Glycin, Cystein, Phosphatidylserin, Sphingolipiden und Cholin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
