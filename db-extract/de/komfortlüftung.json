                "senses": [
                    {
                        "sense_id": "0133bc50-35b0-38b7-9ba9-2a4b44375e71",
                        "entry_id": "88cf8204-5ec0-37ca-b1da-0dd8a9dd7271",
                        "glosses": [
                            "technische Luftzirkulation in einem Raum oder Gebäude unter Beachtung sämtlicher Aspekte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "189f6981-5f9c-4c59-a0b4-20ef36bb8783",
                                "sense_id": "0133bc50-35b0-38b7-9ba9-2a4b44375e71",
                                "text": "„Das Untersuchungsprojekt \"Gesundheitliche und ökologische Aspekte der Komfortlüftung\" ist eine gemeinsame Initiative von Firmen und verschiedenen öffentlich - rechtlichen Organisationen, welche im Bereich der Komfortlüftung tätig sind.“"
                            },
                            {
                                "example_id": "a654c194-bc46-4800-a8bc-8fde5bd7a561",
                                "sense_id": "0133bc50-35b0-38b7-9ba9-2a4b44375e71",
                                "text": "„Eine Komfortlüftung sorgt kontinuierlich für frische, saubere Luft ohne Zugerscheinungen.“"
                            },
                            {
                                "example_id": "5717b8a1-2033-43c7-8bbf-82fb90fdc9cf",
                                "sense_id": "0133bc50-35b0-38b7-9ba9-2a4b44375e71",
                                "text": "„Beim System der Komfortlüftung erfolgt der Austausch der Luft kontinuierlich, leise und langsam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
