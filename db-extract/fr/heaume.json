                                        "sense_id": "f47a50be-90ee-300f-ab42-634322d3beee",
                                        "entry_id": "94fbc04d-3a08-371d-8caa-f3c11f6635ab",
                                        "glosses": [
                                            "A hard, protective head covering, typically part of armour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7503bad2-5e37-4a4f-83c1-58a6cb490b07",
                                                "sense_id": "f47a50be-90ee-300f-ab42-634322d3beee",
                                                "text": "Now that she had rested and had fed from the luncheon tray Mrs. Broome had just removed, she had reverted to her normal gaiety. She looked cool in a grey tailored cotton dress with a terracotta scarf and shoes and her hair a black silk helmet."
                                            },
                                            {
                                                "example_id": "f46b8528-b23b-444d-b25f-568cca18398d",
                                                "sense_id": "f47a50be-90ee-300f-ab42-634322d3beee",
                                                "text": "Most speedboarders wear helmets, knee and elbow pads, and occasionally all-in-one aerodynamic suits, to protect themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbf60b56-79d0-3e52-a28b-17452887982e",
                                        "entry_id": "94fbc04d-3a08-371d-8caa-f3c11f6635ab",
