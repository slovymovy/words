                {
                    "sense_id": "7db83e11-a8c0-3000-ad99-d9337844db34",
                    "sense_definition": "The German language, or a dialect of it (such as Pennsylvania Dutch).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "german_language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "This letter had to be written in <w>Deutsch</w> because neither Paul nor Harriet knew Danish.",
                            "target_lang_translations": {
                                "de": "Dieser Brief musste auf <w>Deutsch</w> geschrieben werden, da weder Paul noch Harriet Dänisch konnten."
                            }
                        },
                        {
                            "text": "They spoke <w>Deutsch</w> at home to keep their ancestral language alive.",
                            "target_lang_translations": {
                                "de": "Sie sprachen zu Hause <w>Deutsch</w>, um die Sprache ihrer Vorfahren lebendig zu erhalten."
                            }
                        }
                    ],
                    "synonyms": [
                        "German"
                    ],
                    "common_phrases": [
                        "speak Deutsch",
                        "written in Deutsch"
                    ],
                    "target_lang_definitions": {
