                    {
                        "sense_id": "e74fade4-ad79-3312-b08a-1585de0b4665",
                        "entry_id": "0f921f5c-38a8-3fdc-adc2-23245ba299e8",
                        "glosses": [
                            "Saucisse sèche de la région suisse des Grisons, de section rectangulaire, à base de viande de bœuf et, souvent, de porc."
                        ],
                        "tags": [
                            "Charcuterie"
                        ],
                        "examples": [
                            {
                                "example_id": "31bc3ffd-9f8c-4c9f-89d6-9e3b18051008",
                                "sense_id": "e74fade4-ad79-3312-b08a-1585de0b4665",
                                "text": "Le salsiz authentique des Grisons se présente sous forme de saucisses séchées à l’air frais des montagnes du Prättigau pendant plusieurs semaines."
                            },
                            {
                                "example_id": "b4e89339-6481-4ffe-8515-5447491a0cc8",
                                "sense_id": "e74fade4-ad79-3312-b08a-1585de0b4665",
                                "text": "Une semaine après l’annonce de contamination de salsiz grison par la listeria, le même producteur a découvert que d’autres lots sont aussi touchés. Les points de vente concernés ont été informés et ont immédiatement retiré les paquets des rayons."
                            },
                            {
                                "example_id": "4b8c7b03-591b-46b5-99c8-ea5e4c76e11a",
                                "sense_id": "e74fade4-ad79-3312-b08a-1585de0b4665",
                                "text": "Voici une recette rustique avec de la saucisse séchée des Grisons – le salsiz. Comme le salami, le salsiz est une saucisse crue à base de viande de porc et de bœuf."
                            }
                        ]
                    }
