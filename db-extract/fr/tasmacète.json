                ],
                "senses": [
                    {
                        "sense_id": "8c486062-f9eb-3013-8601-85448d9d5527",
                        "entry_id": "08381b8e-2cf7-3b83-b31c-5a833621cb58",
                        "glosses": [
                            "Espèce de baleine à bec des eaux circumpolaires de l’hémisphère sud, unique espèce du genre Tasmacetus, et dont le nom complet est tasmacète de Shepherd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8d99633-d4d9-47d1-8f8a-15789a4cee4f",
                                "sense_id": "8c486062-f9eb-3013-8601-85448d9d5527",
                                "text": "Les tasmacètes sont reconnaissables à leur tête fortement bombée et à leur bec allongé. … On pensait le tasmacète plutôt solitaire, mais le groupe observé comprenait au moins une douzaine d’individus."
                            },
                            {
                                "example_id": "c2781cb0-adb0-438c-85f7-293e97da3675",
                                "sense_id": "8c486062-f9eb-3013-8601-85448d9d5527",
                                "text": "Enfin, le tasmacète (Tasmacetus shepherdi) est l’un des moins bien connus des cétacés austraux."
                            }
                        ]
                    }
                ],
