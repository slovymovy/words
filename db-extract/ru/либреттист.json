                "senses": [
                    {
                        "sense_id": "809a37ea-357a-3f27-98ef-85415a64653e",
                        "entry_id": "0f4cd3c1-8b0b-33ce-a90d-ce932d3f5aef",
                        "glosses": [
                            "автор либретто"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1a5aef1-a22a-4ca2-b743-65272fa7decd",
                                "sense_id": "809a37ea-357a-3f27-98ef-85415a64653e",
                                "text": "Либретто создавалось командой либреттистов, среди которых, в частности, был драматург Константин Бахтурин."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3f7847c-20aa-418c-bf0e-a119416a0537",
                        "source_entry_id": "0f4cd3c1-8b0b-33ce-a90d-ce932d3f5aef",
                        "source_sense_id": "809a37ea-357a-3f27-98ef-85415a64653e",
                        "target_lang_word": "librettist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "librettist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c131781-b482-3175-8d3b-62cd2195f288",
                                        "entry_id": "5528285a-f85e-3f81-9986-e3be67476952",
                                        "glosses": [
                                            "The person who writes a libretto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e03af7b5-f0c3-4008-8c99-844744bb4549",
                                                "sense_id": "1c131781-b482-3175-8d3b-62cd2195f288",
                                                "text": "It was secondhand‹make that fourth- or fifthhand. This was from an era before any kind of copyright, when librettists were almost expected to steal from other works."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d1ae6dc-0d11-4a7d-804a-7b0a02744568",
                        "source_entry_id": "0f4cd3c1-8b0b-33ce-a90d-ce932d3f5aef",
                        "source_sense_id": "809a37ea-357a-3f27-98ef-85415a64653e",
