                "senses": [
                    {
                        "sense_id": "ea99217d-43ec-3a71-b727-a85f67790b76",
                        "entry_id": "d685e90d-a63d-3bda-b101-829564f49d21",
                        "glosses": [
                            "Étude des protubérances ou bosses que présente le crâne et des indices que certains anatomistes en tirent pour déterminer les dispositions morales, les penchants des individus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beccc6dd-ac30-4e10-a2e0-162751b6958f",
                                "sense_id": "ea99217d-43ec-3a71-b727-a85f67790b76",
                                "text": "Une des premières préoccupations de la craniologie consiste à rechercher si un crâne est normal, asymétrique ou véritablement déformé."
                            },
                            {
                                "example_id": "5f21d784-e592-45e5-870b-2342a2834f0a",
                                "sense_id": "ea99217d-43ec-3a71-b727-a85f67790b76",
                                "text": "Aucune des mesures de crânes effectuées par Paul Broca, au demeurant bon républicain, et par ses disciples, n’a jamais rien donné. … Dans les années 1960, la craniologie était encore enseignée et pratiquée dans les Facultés de médecine françaises."
                            }
                        ]
                    }
