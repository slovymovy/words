        "fr-extract.jsonl": [
            {
                "entry_id": "b88f5c5d-ed2a-30e0-a3f5-ce5b66f54519",
                "word": "stratosphère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a28d8b15-cadf-4bb0-b5a9-2bdc7a0a53dd",
                        "entry_id": "b88f5c5d-ed2a-30e0-a3f5-ce5b66f54519",
                        "tags": [
                            "plural"
                        ],
                        "form": "stratosphères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "539bb84c-282b-31bf-8c0d-27295fe96b0a",
                        "entry_id": "b88f5c5d-ed2a-30e0-a3f5-ce5b66f54519",
                        "glosses": [
                            "Partie supérieure de l’atmosphère, où les gaz sont en repos presque complet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d76bbc3-33cc-40a0-b44f-a890018a1283",
                                "sense_id": "539bb84c-282b-31bf-8c0d-27295fe96b0a",
                                "text": "Au-dessus de la tropopause se trouve la stratosphère ; elle s’étend jusqu’à 40 à 60 km d’altitude et joue un rôle protecteur pour les êtres vivants puisque l’ozone qu’elle contient en grande quantité (90 % du total de la colonne atmosphérique avec un maximum vers 25 km) absorbe le rayonnement solaire ultraviolet de longueur d’onde inférieure à environ 300 nm, qui est dangereux pour les organismes vivants."
                            },
                            {
                                "example_id": "c045e35d-ba25-4055-9cb5-43470db5a40f",
                                "sense_id": "539bb84c-282b-31bf-8c0d-27295fe96b0a",
                                "text": "La stratosphère est la deuxième couche constituant l'atmosphère, au-dessus de la troposphère (dans laquelle nous vivons)."
                            },
                            {
                                "example_id": "cda69395-d8bc-4f83-a7a6-80bd19ad595e",
                                "sense_id": "539bb84c-282b-31bf-8c0d-27295fe96b0a",
                                "text": "Pour arriver à mesurer les vents dans sa stratosphère, les astronomes ont donc eu recours à un moyen plutôt inusité : la collision de la comète Shoemaker-Levy 9 avec la planète, survenue en 1994."
                            }
                        ]
                    },
                    {
                        "sense_id": "10da7533-41c3-3302-ad0f-07cf5768c87c",
                        "entry_id": "b88f5c5d-ed2a-30e0-a3f5-ce5b66f54519",
                        "glosses": [
                            "Point culminant d'une chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "97e7bc2f-ba6f-4021-9e68-019d15590bec",
                                "sense_id": "10da7533-41c3-3302-ad0f-07cf5768c87c",
                                "text": "J'ai connu l'Amérique de la prospérité. J'ai connu cette confiance, cette certitude, cet orgueil. J'ai connu ce peuple qui croyait, de bonne foi, monter tout entier vers une stratosphère paradisiaque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dc529e6-48a8-496a-b1c0-b9c228318ff0",
                        "source_entry_id": "b88f5c5d-ed2a-30e0-a3f5-ce5b66f54519",
                        "target_lang_word": "Stratosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stratosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3920004-1b70-3068-bd40-7fc2e3c39627",
                                        "entry_id": "49032741-2184-3fc9-8746-98ed413bea5b",
                                        "glosses": [
                                            "zweite Schicht der Erdatmosphäre im Bereich von etwa 12 Kilometer an bis 50 Kilometer Höhe über der Erdoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cff71e48-c1ef-40b6-8ae8-2b2baba0d9dd",
                                                "sense_id": "e3920004-1b70-3068-bd40-7fc2e3c39627",
                                                "text": "Die Stratosphäre wird nach unten hin von der Tropopause und nach oben hin von der Stratopause begrenzt."
                                            },
                                            {
                                                "example_id": "0e067639-b92f-45a2-bebd-1ec6cf7f13ad",
                                                "sense_id": "e3920004-1b70-3068-bd40-7fc2e3c39627",
                                                "text": "90 Minuten hatte der Aufstieg in die Stratosphäre über Spanien gedauert, den ein Fotoapparat und eine Videokamera, die am Ballon befestigt waren, dokumentiert haben."
                                            },
                                            {
                                                "example_id": "544290c5-fa09-47f0-87f3-621f50450bf5",
                                                "sense_id": "e3920004-1b70-3068-bd40-7fc2e3c39627",
                                                "text": "Je mehr Kohlendioxid also in den unteren Atmosphärenschichten ist, um so kälter wird die Stratosphäre, umso effektiver zerstört das verbleibende FCKW das Ozon."
                                            },
                                            {
                                                "example_id": "fc1d296a-d4db-4919-a084-659af495d3bd",
                                                "sense_id": "e3920004-1b70-3068-bd40-7fc2e3c39627",
                                                "text": "Ozon kommt zwar nur in geringen Mengen in der Atmosphäre vor. Dennoch ist das Molekül zwingend für das Leben auf der Erde, da es ultraviolette Strahlung in der Stratosphäre abfängt."
                                            },
                                            {
                                                "example_id": "5b130cc6-1689-40a7-83c0-83b33c69d52f",
                                                "sense_id": "e3920004-1b70-3068-bd40-7fc2e3c39627",
                                                "text": "In der Stratosphäre ging der Anteil des Wasserdampfes um 10 Prozent zurück, was den Grad des Temperaturanstiegs um 25 Prozent reduziert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d4ef49d-f7a7-4ed6-9c25-fd2689a89f85",
                        "source_entry_id": "b88f5c5d-ed2a-30e0-a3f5-ce5b66f54519",
                        "target_lang_word": "stratosphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stratosphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1149eb33-a8f6-36fd-b27a-8bd28a286ff1",
                                        "entry_id": "b721a88e-22f3-3621-a127-2887ec5c84bb",
                                        "glosses": [
                                            "The region of the uppermost atmosphere where the temperature increases along with the altitude due to the absorption of solar ultraviolet radiation by ozone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c39d4b75-7416-4bc6-8cac-1f385f047187",
                                                "sense_id": "1149eb33-a8f6-36fd-b27a-8bd28a286ff1",
                                                "text": "Variation in height of the stratosphere (isothermal layer)."
                                            },
                                            {
                                                "example_id": "995f0bdf-2fd4-439f-95de-971ced652f5d",
                                                "sense_id": "1149eb33-a8f6-36fd-b27a-8bd28a286ff1",
                                                "text": "The mesosphere may be described as the earth's intermediate or middle atmosphere, which separates the thermosphere above from the ozonosphere (or stratosphere) below, both of which are responsible for absorption of most of the ultraviolet part of the solar radiation and preventing it from reaching the earth's surface."
                                            },
                                            {
                                                "example_id": "19c5908d-050a-4a48-9e49-b52620d57a13",
                                                "sense_id": "1149eb33-a8f6-36fd-b27a-8bd28a286ff1",
                                                "text": "The technique would involve spraying large amounts of sulfate particles into the Earth’s lower stratosphere at altitudes as high as 12 miles. The scientists propose delivering the sulfates with specially designed high-altitude aircraft, balloons or large naval-style guns."
                                            },
                                            {
                                                "example_id": "172c9ab2-ad65-439e-9aaf-b491cb1eceb7",
                                                "sense_id": "1149eb33-a8f6-36fd-b27a-8bd28a286ff1",
                                                "text": "Even if you’ve run an ironclad household budget and managed your retirement accounts on your own, you’re about to be at a level of wealth in a different stratosphere. It’s time to hire professionals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37cbe9d9-de47-32f4-a46c-9c47301d1848",
                                        "entry_id": "b721a88e-22f3-3621-a127-2887ec5c84bb",
                                        "glosses": [
                                            "Collectively, those layers of the Earth’s crust which primarily comprise stratified deposits."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a6294c0-ff01-433b-8f5e-dc213f2d1ed8",
                                                "sense_id": "37cbe9d9-de47-32f4-a46c-9c47301d1848",
                                                "text": "So great is the part played by stratified deposits in the structure of the earth’s crust that we might be tempted to speak of the stratosphere of the earth in contradistinction to the scoriosphere of the moon."
                                            },
                                            {
                                                "example_id": "1d76663c-14cf-48dc-a915-4dcaad9f73b5",
                                                "sense_id": "37cbe9d9-de47-32f4-a46c-9c47301d1848",
                                                "text": "The stratosphere, or younger sedimentary envelope has been formed almost entirely at the expense of the Sal envelope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05c0743a-9fd9-447c-bef9-8c0ac4250d94",
                        "source_entry_id": "b88f5c5d-ed2a-30e0-a3f5-ce5b66f54519",
