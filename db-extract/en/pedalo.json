                    {
                        "sense_id": "7a5cd183-c115-31cb-992e-456d32141691",
                        "entry_id": "2c0a3350-bf6e-3715-af23-b1563ecec2c2",
                        "glosses": [
                            "A small boat propelled by pedals that directly turn external paddles, used for recreation."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "056653cc-5096-43c5-acba-87ece61e229a",
                                "sense_id": "7a5cd183-c115-31cb-992e-456d32141691",
                                "text": "It is the prelapsarian Polynesia of free love, noble savagery, Kon Tiki rafting and Easter Island statuary, not the Levi’s-wearing, Toyota-driving, pédalo-pushing, efflorescent-cocktails-in-a-split-coconut-serving pseudo-paradise that awaits latter-day travellers."
                            },
                            {
                                "example_id": "7e76c03d-94dc-4231-ba17-853985653ed2",
                                "sense_id": "7a5cd183-c115-31cb-992e-456d32141691",
                                "text": "On the other hand: I’m sorry the sculpture hurt your feelings. But it’s just art. It can’t harm you. You don’t have to like it – not at all – but it’s going to be gone in a month or so, and you can still use the pedalos while it’s there."
                            }
                        ]
                    }
