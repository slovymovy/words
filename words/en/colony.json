{
    "word_family": [
        "colonial",
        "colonist",
        "colonize",
        "colonization",
        "colonialism",
        "colonizer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "204f3c1b-37dd-35d1-b9ab-0a6d0acc33be",
                    "sense_definition": "An area under the political control of another country and typically occupied by settlers from it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "political_settlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The island remained a British <w>colony</w> until it gained independence in the last century.",
                            "target_lang_translations": {
                                "ru": "Остров оставался британской <w>колонией</w>, пока не получил независимость в прошлом веке.",
                                "zh": "该岛在上个世纪获得独立之前，一直是大英帝国的<w>殖民地</w>。"
                            }
                        },
                        {
                            "text": "Many European countries established <w>colonies</w> in the Americas during the age of exploration.",
                            "target_lang_translations": {
                                "ru": "Многие европейские страны основали <w>колонии</w> в Северной и Южной Америке в эпоху Великих географических открытий.",
                                "zh": "在大航海时代，许多欧洲国家在美洲建立了<w>殖民地</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "settlement",
                        "territory",
                        "dependency",
                        "possession"
                    ],
                    "antonyms": [
                        "metropole"
                    ],
                    "common_phrases": [
                        "crown colony",
                        "former colony",
                        "British colony",
                        "penal colony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория, находящаяся под политическим контролем другой страны и обычно заселенная выходцами из нее.",
                        "zh": "受另一国政治控制，通常由该国移民定居的地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колония",
                                "target_lang_sense_clarification": "зависимая территория"
                            },
                            {
                                "target_lang_word": "поселение",
                                "target_lang_sense_clarification": "место жительства переселенцев"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "殖民地",
                                "target_lang_sense_clarification": "受他国统治的领土"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0235155e-d67a-3407-97c8-15ccb0ee2280",
                    "sense_definition": "A group of organisms of the same species living together in close association.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "biological_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We found a large ant <w>colony</w> under the old paving stones in the garden.",
                            "target_lang_translations": {
                                "ru": "Мы нашли большую муравьиную <w>колонию</w> под старой брусчаткой в саду.",
                                "zh": "我们在花园的旧铺路石下发现了一个巨大的蚂蚁<w>群体</w>。"
                            }
                        },
                        {
                            "text": "The coral <w>colony</w> provides a vital habitat for many small fish.",
                            "target_lang_translations": {
                                "ru": "Коралловая <w>колония</w> служит жизненно важной средой обитания для множества мелких рыб.",
                                "zh": "珊瑚<w>群落</w>为许多小鱼提供了至关重要的栖息地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "community"
                    ],
                    "common_phrases": [
                        "ant colony",
                        "bee colony",
                        "coral colony",
                        "bird colony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа организмов одного вида, живущих вместе в тесной связи.",
                        "zh": "同一物种中生活在一起并紧密联系的生物群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колония",
                                "target_lang_sense_clarification": "группа организмов"
                            },
                            {
                                "target_lang_word": "семья",
                                "target_lang_sense_clarification": "пчел или муравьев"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "群体",
                                "target_lang_sense_clarification": "生物聚集在一起的集合"
                            },
                            {
                                "target_lang_word": "群落",
                                "target_lang_sense_clarification": "生态学中的生物聚集"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ad95adb-6a65-31b2-9f3c-6b04aa7df00c",
                    "sense_definition": "A group of people with similar interests, occupations, or characteristics, living in a particular area.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter moved to an artist <w>colony</w> to find inspiration among other creatives.",
                            "target_lang_translations": {
                                "ru": "Художник переехал в <w>колонию</w> живописцев, чтобы найти вдохновение среди других творческих людей.",
                                "zh": "这位画家搬到了一个艺术家<w>聚居区</w>，以便在其他创作者中寻找灵感。"
                            }
                        },
                        {
                            "text": "They visited a nudist <w>colony</w> while on vacation in the south of France.",
                            "target_lang_translations": {
                                "ru": "Во время отпуска на юге Франции они посетили нудистскую <w>колонию</w>.",
                                "zh": "他们在法国南部度假时参观了一个天体主义者<w>社区</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "community",
                        "camp",
                        "settlement"
                    ],
                    "common_phrases": [
                        "artist colony",
                        "nudist colony",
                        "leper colony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей с общими интересами, занятиями или характеристиками, проживающих в определенной местности.",
                        "zh": "居住在特定区域，具有相似兴趣、职业或特征的人群。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колония",
                                "target_lang_sense_clarification": "сообщество людей"
                            },
                            {
                                "target_lang_word": "поселение",
                                "target_lang_sense_clarification": "населенный пункт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "聚居区",
                                "target_lang_sense_clarification": "特定人群居住的区域"
                            },
                            {
                                "target_lang_word": "社区",
                                "target_lang_sense_clarification": "具有共同特征的群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c9630a5-7e0c-3871-af97-4339beb05dae",
                    "sense_definition": "A visible cluster of bacteria, fungi, or other cells cultured together, typically growing from a single cell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biological_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student counted the number of bacterial <w>colonies</w> growing in the petri dish.",
                            "target_lang_translations": {
                                "ru": "Студент подсчитал количество бактериальных <w>колоний</w>, растущих в чашке Петри.",
                                "zh": "学生数了数培养皿中生长的细菌<w>菌落</w>数量。"
                            }
                        },
                        {
                            "text": "Each <w>colony</w> on the plate represents a distinct strain of the microorganism.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>колония</w> на пластине представляет собой отдельный штамм микроорганизма.",
                                "zh": "培养皿上的每一个<w>菌落</w>都代表一种不同的微生物菌株。"
                            }
                        }
                    ],
                    "synonyms": [
                        "culture",
                        "growth"
                    ],
                    "common_phrases": [
                        "bacterial colony",
                        "fungal colony"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Видимое скопление бактерий, грибков или других клеток, выращенных вместе.",
                        "zh": "在培养基上由单个细胞生长而成的可见细菌、真菌或其他细胞簇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колония",
                                "target_lang_sense_clarification": "микроорганизмов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菌落",
                                "target_lang_sense_clarification": "微生物培养出的可见群体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7e764997-46c8-3a15-acf0-5c4a7b795c75",
                    "sense_definition": "A place name used for various towns or townships in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through the small town of <w>Colony</w> on our road trip across the state.",
                            "target_lang_translations": {
                                "ru": "Мы проехали через маленький городок <w>Колони</w> во время нашего путешествия по штату.",
                                "zh": "我们在横跨该州的公路旅行中开车经过了科洛尼小镇。"
                            }
                        },
                        {
                            "text": "The map shows a township called <w>Colony</w> in the next county.",
                            "target_lang_translations": {
                                "ru": "На карте показан поселок под названием <w>Колони</w> в соседнем округе.",
                                "zh": "地图显示邻县有一个叫科洛尼的乡镇。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название, используемое для различных городов или поселков в США.",
                        "zh": "美国多个城镇或乡镇的名称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Колони",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "科洛尼",
                                "target_lang_sense_clarification": "地名音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "808a14c4-2e09-3fde-964e-2bcffbf1208d",
                    "sense_definition": "To settle an area as a colony; to colonize.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient times, the empire <w>colonied</w> distant lands to expand its influence.",
                            "target_lang_translations": {
                                "ru": "В древние времена империя <w>колонизировала</w> далекие земли, чтобы расширить свое влияние.",
                                "zh": "在古代，该帝国为了扩大影响力而对遥远的土地进行<w>殖民</w>。"
                            }
                        },
                        {
                            "text": "The explorers <w>colonied</w> the island, bringing their own customs and laws.",
                            "target_lang_translations": {
                                "ru": "Исследователи <w>заселили</w> остров, принеся с собой свои обычаи и законы.",
                                "zh": "探险家们在该岛<w>定居</w>，并带来了他们自己的习俗和法律。"
                            }
                        }
                    ],
                    "synonyms": [
                        "colonize",
                        "settle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заселять территорию в качестве колонии; колонизировать.",
                        "zh": "将某地作为殖民地进行定居；殖民。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колонизировать",
                                "target_lang_sense_clarification": "основывать колонию"
                            },
                            {
                                "target_lang_word": "заселять",
                                "target_lang_sense_clarification": "обживать территорию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "殖民",
                                "target_lang_sense_clarification": "建立殖民地"
                            },
                            {
                                "target_lang_word": "定居",
                                "target_lang_sense_clarification": "在某地居住下来"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}