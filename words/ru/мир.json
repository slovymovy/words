                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "peace_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Генералы собрались, чтобы наконец подписать <w>мир</w>.",
                            "target_lang_translations": {
                                "en": "The generals gathered to finally sign the <w>peace treaty</w>.",
                                "zh": "将军们聚集在一起，最终签署了<w>和约</w>。"
                            }
                        },
                        {
                            "text": "Выгодный <w>мир</w> позволил стране восстановить экономику.",
                            "target_lang_translations": {
                                "en": "A profitable <w>peace</w> allowed the country to restore its economy.",
                                "zh": "一份有利的<w>和约</w>使该国得以恢复经济。"
                            }
