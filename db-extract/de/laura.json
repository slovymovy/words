        "de-extract.jsonl": [
            {
                "entry_id": "71c1c760-f3bd-3e81-b926-94ef7e25a480",
                "word": "Laura",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "3f8f81ca-f37c-4b76-99db-f058ef932561",
                        "entry_id": "71c1c760-f3bd-3e81-b926-94ef7e25a480",
                        "tags": [
                            "abbreviation"
                        ],
                        "form": "L."
                    },
                    {
                        "form_id": "f3d5c86f-4742-4882-af80-84a0806fbec3",
                        "entry_id": "71c1c760-f3bd-3e81-b926-94ef7e25a480",
                        "tags": [
                            "affective"
                        ],
                        "form": "Lauri"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62fb3520-08d2-3b27-83aa-ecf87d6154e3",
                        "entry_id": "71c1c760-f3bd-3e81-b926-94ef7e25a480",
                        "glosses": [
                            "weiblicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e657e49-7790-4707-b202-4b71c34c3ea4",
                                "sense_id": "62fb3520-08d2-3b27-83aa-ecf87d6154e3",
                                "text": "Laura eilt der Ruf voraus, eine Zicke zu sein."
                            },
                            {
                                "example_id": "6a987e45-957b-44fa-a7bd-0aa43e49c035",
                                "sense_id": "62fb3520-08d2-3b27-83aa-ecf87d6154e3",
                                "text": "Der Name Laura ist in dieser Gegend nicht gerade selten."
                            },
                            {
                                "example_id": "ab42ffc3-5d0a-4e09-b146-54eb605ac17d",
                                "sense_id": "62fb3520-08d2-3b27-83aa-ecf87d6154e3",
                                "text": "„Es war nämlich einer der Vorfahren des Marquis, der Graf Hugues de Sade, der am Anfang des 14. Jahrhunderts jene unsterblich gewordene Laura zur Frau nahm, die Petrarca zu seinen schmerzlich-sehnsüchtigen Sonetten inspiriert hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2e46640-a55e-491f-bdf6-4a56b36b848e",
                        "source_entry_id": "71c1c760-f3bd-3e81-b926-94ef7e25a480",
                        "source_sense_id": "62fb3520-08d2-3b27-83aa-ecf87d6154e3",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Laura",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laura",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "441f71a2-755a-3217-b8be-fb1d9f23b687",
                                        "entry_id": "e0d30491-2032-3c3a-89cf-c18b44a349f8",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7348e9-d628-43c8-b195-2cdc6e52d833",
                                                "sense_id": "441f71a2-755a-3217-b8be-fb1d9f23b687",
                                                "text": "Now is he for the numbers that Petrarch flowed in; Laura to his lady was but a kitchen-wench; marry, she had a better love to be-rime her;"
                                            },
                                            {
                                                "example_id": "54ad4527-9d45-463b-9711-a0b2647adbde",
                                                "sense_id": "441f71a2-755a-3217-b8be-fb1d9f23b687",
                                                "text": "Laura was saying something. A mellifluous name, he thought. I wish she were far away, so I could call her."
                                            },
                                            {
                                                "example_id": "0ed466a1-d9b4-47e2-8c49-11d3e9c582d0",
                                                "sense_id": "441f71a2-755a-3217-b8be-fb1d9f23b687",
                                                "text": "'Mine's Laura'./ 'A beautiful name.'/ Laura has never liked her name. It's too old-fashioned and has, to her mind, a slightly whiny sound, like the twang of a country and western guitar. In fact she was given the name because Michelle liked the song 'Tell Laura I Love Her'."
                                            },
                                            {
                                                "example_id": "0d535dea-2bfe-40a3-963e-7f56b027d540",
                                                "sense_id": "441f71a2-755a-3217-b8be-fb1d9f23b687",
                                                "text": "The request for a retraction centers around an October 28 segment on Laura Ingraham’s prime time show, “The Ingraham Angle.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e938780-ca15-404c-bc51-e58493c7cf29",
                        "source_entry_id": "71c1c760-f3bd-3e81-b926-94ef7e25a480",
                        "source_sense_id": "62fb3520-08d2-3b27-83aa-ecf87d6154e3",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Laure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bdbbf09-ccd0-37da-a9a8-9b92231d672a",
                                        "entry_id": "3c642145-0929-372b-bfd9-5d9759762a03",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0633168-7ada-4107-98f6-777a3418140b",
                                                "sense_id": "6bdbbf09-ccd0-37da-a9a8-9b92231d672a",
                                                "text": "Laure sécha ses larmes, salua Servin, et se retira."
                                            },
                                            {
                                                "example_id": "90c6ab93-324c-4020-825c-26e77c14b083",
                                                "sense_id": "6bdbbf09-ccd0-37da-a9a8-9b92231d672a",
                                                "text": "Pourquoi a-t-il pris tant de risques pour désimplanter Lorenzo ? s’interrogea Laure."
                                            },
                                            {
                                                "example_id": "9f51bcb7-3bf4-4e31-9d3e-45faf37ed353",
                                                "sense_id": "6bdbbf09-ccd0-37da-a9a8-9b92231d672a",
                                                "text": "Florence Montreynaud attend aussi beaucoup de la nouvelle procureure de Paris, Laure Beccuau, et de sa vice-procureure, Julie Colin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
