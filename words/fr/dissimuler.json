{
    "word_family": [
        "dissimulation",
        "dissimulateur",
        "dissimulatrice"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "015126cc-3d2e-38d7-a784-c38dcc8de8c3",
                    "sense_definition": "Cacher une chose matérielle ou concrète, la dérober à la vue ou à la connaissance d'autrui.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cambrioleur a essayé de <w>dissimuler</w> les bijoux volés sous le plancher de sa chambre."
                        },
                        {
                            "text": "Le brouillard épais finit par <w>dissimuler</w> entièrement le sommet de la montagne."
                        }
                    ],
                    "synonyms": [
                        "cacher",
                        "masquer",
                        "dérober"
                    ],
                    "antonyms": [
                        "montrer",
                        "révéler",
                        "exposer"
                    ],
                    "common_phrases": [
                        "dissimuler des preuves",
                        "dissimuler la vérité"
                    ]
                },
                {
                    "sense_id": "4e3d949e-cbd8-3ff1-8afb-08a06ffbab46",
                    "sense_definition": "Se dérober aux regards en se mettant à l'abri ; se cacher.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'espion s'est <w>dissimulé</w> derrière un rideau pour écouter la conversation secrète."
                        },
                        {
                            "text": "Plusieurs animaux sauvages se <w>dissimulent</w> dans les buissons pour guetter leur proie."
                        }
                    ],
                    "synonyms": [
                        "se cacher",
                        "se tapir",
                        "se terrer"
                    ],
                    "antonyms": [
                        "se montrer",
                        "s'exposer"
                    ],
                    "common_phrases": [
                        "se dissimuler derrière"
                    ]
                },
                {
                    "sense_id": "5ab213b0-a050-3dc3-9dd6-bba4c5be99ec",
                    "sense_definition": "Ne pas laisser paraître ses sentiments, ses pensées ou ses intentions réelles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle avait du mal à <w>dissimuler</w> sa joie en apprenant les résultats de l'examen."
                        },
                        {
                            "text": "Malgré son calme apparent, il ne put <w>dissimuler</w> sa profonde inquiétude."
                        }
                    ],
                    "synonyms": [
                        "taire",
                        "masquer",
                        "étouffer"
                    ],
                    "antonyms": [
                        "exprimer",
                        "manifester",
                        "extérioriser"
                    ],
                    "common_phrases": [
                        "dissimuler sa joie",
                        "dissimuler sa déception",
                        "dissimuler ses émotions"
                    ]
                },
                {
                    "sense_id": "6e23f4cb-97d1-3c88-be44-828410e7bee3",
                    "sense_definition": "Refuser de s'avouer ou de reconnaître consciemment une réalité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur ne se <w>dissimule</w> pas la gravité de la crise financière actuelle."
                        },
                        {
                            "text": "Elle refusait de se <w>dissimuler</w> que leur longue amitié touchait bientôt à sa fin."
                        }
                    ],
                    "synonyms": [
                        "se cacher"
                    ],
                    "antonyms": [
                        "s'avouer",
                        "admettre",
                        "reconnaître"
                    ],
                    "common_phrases": [
                        "ne pas se dissimuler"
                    ]
                },
                {
                    "sense_id": "84c05392-fbf1-3786-99cc-029b3b104eb9",
                    "sense_definition": "Feindre de ne pas remarquer ou de ne pas ressentir un affront ou une offense.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux provocations de son adversaire, il préféra <w>dissimuler</w> l'affront sans réagir."
                        },
                        {
                            "text": "Le diplomate a su <w>dissimuler</w> cette injure pour préserver la paix entre les délégations."
                        }
                    ],
                    "synonyms": [
                        "avaler",
                        "tolérer"
                    ],
                    "antonyms": [
                        "relever"
                    ],
                    "common_phrases": [
                        "dissimuler un affront",
                        "dissimuler une injure"
                    ]
                }
            ]
        }
    ]
}