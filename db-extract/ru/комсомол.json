                "senses": [
                    {
                        "sense_id": "f065aca6-37ee-3fe5-9ce7-ee91ad9bf2f5",
                        "entry_id": "1584ac37-e65c-3303-bae4-70ff4161f0c8",
                        "glosses": [
                            "Komsomol, organisation de la jeunesse communiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7783f91-e363-4bbd-9bcf-bd39bc42e16a",
                                "sense_id": "f065aca6-37ee-3fe5-9ce7-ee91ad9bf2f5",
                                "text": "В прессе, радио и телевидении, в школе, комсомоле, вузе, семье процветают лицемерие и ложь.",
                                "translation": "L'hypocrisie et les mensonges fleurissent dans la presse, à la radio et à la télévision, à l'école, au Komsomol, à l'université et dans la famille."
                            }
                        ]
                    },
                    {
                        "sense_id": "da7bffec-053c-36f9-b63b-f18f3d0040b9",
                        "entry_id": "1584ac37-e65c-3303-bae4-70ff4161f0c8",
                        "glosses": [
                            "Komsomol, membre des jeunesses communistes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8562c94a-a3b6-4096-857a-27d276ce78e4",
                                "sense_id": "da7bffec-053c-36f9-b63b-f18f3d0040b9",
                                "text": "Тот, однако, не обиделся и, добродушно улыбнувшись, крикнул ему: — Здрасте, комсомол!",
                                "translation": "Il ne fut cependant pas offensé et, souriant avec bonhomie, lui cria : « Bonjour, Komsomol ! »"
                            }
                        ]
                    }
                ],
