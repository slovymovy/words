                                ]
                            },
                            {
                                "target_word": "scholastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff04678-8ae8-3d6c-b021-d6328ada2a21",
                                        "entry_id": "395911c7-7185-35d6-adcf-c2e1bf267cf4",
                                        "glosses": [
                                            "Of or relating to school; academic"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aacf63fd-cc18-4ced-ac3a-775829121d75",
                                                "sense_id": "3ff04678-8ae8-3d6c-b021-d6328ada2a21",
                                                "text": "This award is for the greatest scholastic achievement by a graduating student."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60fe6b48-d7e2-32f6-b0db-138164adc0fa",
                                        "entry_id": "395911c7-7185-35d6-adcf-c2e1bf267cf4",
                                        "glosses": [
                                            "Of or relating to the philosophical tradition of scholasticism"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be6b527c-dcf7-4996-9065-22a86658dc5f",
                                                "sense_id": "60fe6b48-d7e2-32f6-b0db-138164adc0fa",
                                                "text": "And hence it is that men, even when they are baffled and silenced in this scholastic way, are seldom or never convinced , and so brought over to the conquering side"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "837551d8-c695-3909-bfc0-fc13ddf185e8",
                                        "entry_id": "395911c7-7185-35d6-adcf-c2e1bf267cf4",
                                        "glosses": [
                                            "Characterized by excessive subtlety, or needlessly minute subdivisions; pedantic; formal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e0f723f-3878-4ce3-aa39-838b2d8dab8e",
                        "source_entry_id": "e639ecb1-dd06-38b7-b7b2-084afad7a7e6",
                        "source_sense_id": "e58db8c0-7023-32f7-a307-29a96ac4a7bd",
                        "target_lang_word": "scolastique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scolastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "953dd109-b741-3f0d-8ff8-03535dccf66a",
                                        "entry_id": "154bb8e5-ab57-3d2c-b589-e9e37c9725de",
                                        "glosses": [
                                            "Qui appartient à l’école."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f5061c5-f452-3018-97bf-17739d00a90f",
                                        "entry_id": "154bb8e5-ab57-3d2c-b589-e9e37c9725de",
                                        "glosses": [
                                            "Ce qui s’enseignait suivant la méthode des écoles de théologie et de philosophie au Moyen Âge."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbcdf2bb-078e-38ee-af76-a510a726fa53",
                                        "entry_id": "154bb8e5-ab57-3d2c-b589-e9e37c9725de",
                                        "glosses": [
                                            "Académique ; formel."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad27ddbb-f51e-452d-a684-e84e73b7ef30",
                                                "sense_id": "bbcdf2bb-078e-38ee-af76-a510a726fa53",
                                                "text": "Grâce à l’argumentation toute scolastique de son interlocuteur, le comte venait de s’enferrer lui-même."
                                            },
                                            {
                                                "example_id": "85573f9b-e018-4463-b332-b165c499b690",
                                                "sense_id": "bbcdf2bb-078e-38ee-af76-a510a726fa53",
                                                "text": "Lorsque ces maîtres franco-parisiens commenceront d’enseigner en déclamant pédantesquement leurs démonstrations scolastiques, les Toulousains cultivés, venus les écouter, éclateront de rire."
                                            },
                                            {
                                                "example_id": "a40262cb-2984-46cc-bcc1-d9eae4d960b5",
                                                "sense_id": "bbcdf2bb-078e-38ee-af76-a510a726fa53",
                                                "text": "Mlle Préfère, indignée, pressa son cœur à deux mains sous sa pèlerine, et je m’attendis à voir s’évanouir son âme scolastique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scolastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46a08698-ef3b-3119-9d1c-329905123c2d",
                                        "entry_id": "b0282092-22db-3ae9-a2c4-d6a2d8b86976",
                                        "glosses": [
                                            "Théologie ou philosophie scolastique (adjectif sens 2)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a0abf4b-77d6-4bbb-b5bb-7d04935f2379",
                                                "sense_id": "46a08698-ef3b-3119-9d1c-329905123c2d",
                                                "text": "Il ne serait pas plus raisonnable de l’en rendre responsable, que d’imputer aux catégories d’Aristote tous les vices de la scolastique."
                                            },
                                            {
                                                "example_id": "f35dd971-83c4-4fbb-a4ff-60765bf0f16f",
                                                "sense_id": "46a08698-ef3b-3119-9d1c-329905123c2d",
                                                "text": "L’enseignement philosophique du séminaire était la scolastique en latin, non la scolastique du XIIIᵉ siècle, barbare et enfantine, mais ce qu’on peut appeler la scolastique cartésienne, c’est-à-dire ce cartésianisme mitigé qui fut adopté en général pour l’enseignement ecclésiastique, au XVIIIᵉ siècle, et fixé dans les trois volumes connus sous le nom de Philosophie de Lyon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e72a615e-8bd6-33b4-9a57-9fa82e38d403",
                                        "entry_id": "b0282092-22db-3ae9-a2c4-d6a2d8b86976",
                                        "glosses": [
                                            "Doctrine oiseuse."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce46d1c-a3b3-4f92-a0ba-7dd4a8929efc",
                                                "sense_id": "e72a615e-8bd6-33b4-9a57-9fa82e38d403",
                                                "text": "Nos pères ont excellé dans cette scolastique, qui comprend la partie lumineuse des discussions politiques."
                                            },
                                            {
                                                "example_id": "2f12ec48-c680-476d-a639-363b42905423",
                                                "sense_id": "e72a615e-8bd6-33b4-9a57-9fa82e38d403",
                                                "text": "Le triumvirat déclenche contre lui de nouvelles polémiques, bientôt frénétiques, dans lesquelles l’argumentation fait place à une scolastique forgée pour les besoins de la cause et oppose sans fin le léninisme au trotskisme, comme la vérité révélée à l’hérésie, le mal au bien, le salut à la perdition."
                                            },
                                            {
                                                "example_id": "2091b2c4-c1ec-4216-9ece-33942c035532",
                                                "sense_id": "e72a615e-8bd6-33b4-9a57-9fa82e38d403",
                                                "text": "Mais cette scolastique de l’espionnage, et la méthode si raisonnable des recoupements, enivrent ceux qui y participent, et encore plus ceux qui les ont inventées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scolastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f257a022-9f35-3e0f-ac60-3a8de301eadc",
                                        "entry_id": "a537edab-b4d1-3e46-a0f0-dc597ebabaca",
                                        "glosses": [
                                            "Celui, celle qui enseigne la théologie ou la philosophie suivant la méthode scolastique (adjectif sens 2)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ffb75a-386a-4451-9eb8-40ebea560c3a",
                                                "sense_id": "f257a022-9f35-3e0f-ac60-3a8de301eadc",
                                                "text": "Les professeurs portaient le nom de scolastiques ou d’écolâtres, dénomination qui devait servir à caractériser les méthodes et les doctrines qu’ils professaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
