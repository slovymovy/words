{
    "word_family": [
        "leakage",
        "leaker",
        "leaky"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "57ef42ba-4b28-316a-b06e-3c51cb931d6a",
                    "sense_definition": "To allow liquid or gas to escape through a hole or crack.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_leak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old pipe began to <w>leak</w> water all over the kitchen floor.",
                            "target_lang_translations": {
                                "ru": "Старая труба начала <w>протекать</w>, заливая водой весь пол на кухне.",
                                "zh": "旧水管开始<w>漏</w>水，弄得厨房地板上到处都是。"
                            }
                        },
                        {
                            "text": "We realized that the car was <w>leaking</w> oil onto the driveway.",
                            "target_lang_translations": {
                                "ru": "Мы поняли, что из машины <w>подтекает</w> масло на подъездную дорожку.",
                                "zh": "我们发现车子正在往车道上<w>漏</w>油。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leak oil",
                        "leak water",
                        "leak gas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропускать жидкость или газ через отверстие или трещину.",
                        "zh": "指液体或气体通过孔洞或裂缝流出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протекать",
                                "target_lang_sense_clarification": "о трубе, крыше или емкости"
                            },
                            {
                                "target_lang_word": "течь",
                                "target_lang_sense_clarification": "пропускать воду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漏",
                                "target_lang_sense_clarification": "指液体或气体流出"
                            },
                            {
                                "target_lang_word": "渗漏",
                                "target_lang_sense_clarification": "指液体缓慢流出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50c824ae-e7c1-389f-9fbf-9bf33d7c079e",
                    "sense_definition": "(of a liquid or gas) To escape from a container through a hole or crack.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_leak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water <w>leaked</w> from the ceiling during the heavy rainstorm yesterday.",
                            "target_lang_translations": {
                                "ru": "Вода <w>просочилась</w> с потолка во время сильного ливня вчера.",
                                "zh": "昨天暴雨期间，水从天花板<w>渗</w>了下来。"
                            }
                        },
                        {
                            "text": "Dangerous fumes were <w>leaking</w> out of the rusty metal tank.",
                            "target_lang_translations": {
                                "ru": "Опасные испарения <w>вытекали</w> из ржавого металлического бака.",
                                "zh": "危险的气体正从生锈的金属罐中<w>泄漏</w>出来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leak out",
                        "leak into"
                    ],
                    "target_lang_definitions": {
                        "ru": "(о жидкости или газе) Вытекать или просачиваться из контейнера через отверстие.",
                        "zh": "（液体或气体）从容器的孔洞或裂缝中流出或渗出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытекать",
                                "target_lang_sense_clarification": "литься наружу"
                            },
                            {
                                "target_lang_word": "просачиваться",
                                "target_lang_sense_clarification": "медленно проникать сквозь что-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泄漏",
                                "target_lang_sense_clarification": "指气体或液体流出"
                            },
                            {
                                "target_lang_word": "渗出",
                                "target_lang_sense_clarification": "指液体缓慢透出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d65bf839-9675-34c9-8c36-f9071a4d4000",
                    "sense_definition": "To disclose secret or confidential information to the public.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "info_leak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unhappy employee <w>leaked</w> the documents to a national newspaper.",
                            "target_lang_translations": {
                                "ru": "Недовольный сотрудник <w>слил</w> документы в национальную газету.",
                                "zh": "那名不满的员工将文件<w>泄露</w>给了全国性报纸。"
                            }
                        },
                        {
                            "text": "Someone <w>leaked</w> the news about the merger before the official announcement.",
                            "target_lang_translations": {
                                "ru": "Кто-то <w>разгласил</w> новость о слиянии до официального объявления.",
                                "zh": "有人在正式宣布之前<w>走漏</w>了合并的消息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leak information",
                        "leak to the press"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрывать секретную или конфиденциальную информацию общественности.",
                        "zh": "向公众披露秘密或机密信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сливать",
                                "target_lang_sense_clarification": "разг. предавать огласке"
                            },
                            {
                                "target_lang_word": "разглашать",
                                "target_lang_sense_clarification": "офиц. раскрывать тайну"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泄露",
                                "target_lang_sense_clarification": "指秘密被公开"
                            },
                            {
                                "target_lang_word": "走漏",
                                "target_lang_sense_clarification": "指消息不慎传出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0e1a3a2-5c7a-3bef-9d7c-bf7619d630ee",
                    "sense_definition": "To urinate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "urination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stopped the car by the road because he had to <w>leak</w>.",
                            "target_lang_translations": {
                                "ru": "Он остановил машину у дороги, потому что ему нужно было <w>отлить</w>.",
                                "zh": "他把车停在路边，因为他得去<w>撒尿</w>。"
                            }
                        },
                        {
                            "text": "I drank too much water and need to go <w>leak</w> somewhere.",
                            "target_lang_translations": {
                                "ru": "Я выпил слишком много воды, и мне нужно пойти где-нибудь <w>отлить</w>.",
                                "zh": "我水喝多了，得找个地方<w>解手</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "micturate",
                        "pass water",
                        "pee",
                        "piddle",
                        "piss",
                        "slash",
                        "take a leak",
                        "take a piss",
                        "take a whiz",
                        "urinate",
                        "void",
                        "wee",
                        "widdle",
                        "whiz"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мочиться (справлять нужду).",
                        "zh": "排尿（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отлить",
                                "target_lang_sense_clarification": "слэнг"
                            },
                            {
                                "target_lang_word": "справить нужду",
                                "target_lang_sense_clarification": "фразеологизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撒尿",
                                "target_lang_sense_clarification": "口语"
                            },
                            {
                                "target_lang_word": "解手",
                                "target_lang_sense_clarification": "委婉说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a7fe7a1-024e-388f-8a5a-8aba47a9e293",
                    "sense_definition": "To allow something to pass through a defense or barrier, often used in sports.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team's defense was <w>leaking</w> goals throughout the second half of the match.",
                            "target_lang_translations": {
                                "ru": "Защита команды <w>пропускала</w> голы на протяжении всей второй половины матча.",
                                "zh": "在下半场比赛中，该队的防线不断<w>失球</w>。"
                            }
                        },
                        {
                            "text": "They <w>leaked</w> too many points early in the game to recover later.",
                            "target_lang_translations": {
                                "ru": "Они <w>упустили</w> слишком много очков в начале игры, чтобы отыграться позже.",
                                "zh": "他们在比赛初期<w>漏防</w>太多，导致后来无法追回比分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leak goals",
                        "leak points"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропускать что-либо через защиту или барьер (часто используется в спорте).",
                        "zh": "指在防守或屏障中出现漏洞，常用于体育比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропускать",
                                "target_lang_sense_clarification": "о голах или очках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失球",
                                "target_lang_sense_clarification": "指防守被突破导致丢分"
                            },
                            {
                                "target_lang_word": "漏防",
                                "target_lang_sense_clarification": "指防守出现疏漏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bd62ea6-3a36-3cf7-9525-763967d8c5e3",
                    "sense_definition": "To bleed, usually from a serious wound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victim was <w>leaking</w> badly on the pavement after the fight.",
                            "target_lang_translations": {
                                "ru": "Жертва сильно <w>истекала кровью</w> на тротуаре после драки.",
                                "zh": "打架后，受害者在人行道上严重<w>流血</w>。"
                            }
                        },
                        {
                            "text": "He got cut during the struggle and started <w>leaking</w> all over the floor.",
                            "target_lang_translations": {
                                "ru": "Он порезался во время борьбы и начал <w>истекать кровью</w> прямо на пол.",
                                "zh": "他在挣扎中被割伤，地板上开始<w>流血</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кровоточить, обычно из серьезной раны.",
                        "zh": "流血，通常指严重伤口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истекать кровью",
                                "target_lang_sense_clarification": "терять кровь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流血",
                                "target_lang_sense_clarification": "指伤口出血"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5cc2492f-8560-346e-9d1a-7ef1ac0be7c2",
                    "sense_definition": "A crack, hole, or fissure that allows liquid or gas to escape.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_leak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber came to fix a <w>leak</w> under the kitchen sink.",
                            "target_lang_translations": {
                                "ru": "Сантехник пришел устранить <w>течь</w> под кухонной раковиной.",
                                "zh": "水管工来修理厨房水槽下的<w>漏点</w>。"
                            }
                        },
                        {
                            "text": "We noticed a small <w>leak</w> in the roof after the storm.",
                            "target_lang_translations": {
                                "ru": "Мы заметили небольшую <w>протечку</w> в крыше после шторма.",
                                "zh": "暴风雨过后，我们注意到屋顶有一处小<w>裂缝</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fix a leak",
                        "spring a leak",
                        "gas leak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трещина, отверстие или разрыв, через которые выходит жидкость или газ.",
                        "zh": "导致液体或气体流出的裂缝、孔洞或缝隙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "течь",
                                "target_lang_sense_clarification": "место протекания"
                            },
                            {
                                "target_lang_word": "пробоина",
                                "target_lang_sense_clarification": "крупное отверстие (в судне)"
                            },
                            {
                                "target_lang_word": "протечка",
                                "target_lang_sense_clarification": "небольшое место утечки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漏点",
                                "target_lang_sense_clarification": "指发生泄漏的地方"
                            },
                            {
                                "target_lang_word": "裂缝",
                                "target_lang_sense_clarification": "指导致泄漏的物理破损"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d666ae26-2a36-3289-bfe9-070d5cdc81db",
                    "sense_definition": "The act or instance of a fluid or gas escaping through an opening.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_leak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>leak</w> of chemicals forced the factory to evacuate immediately.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>утечка</w> химикатов заставила немедленно эвакуировать завод.",
                                "zh": "化学品的突然<w>泄漏</w>迫使工厂立即疏散。"
                            }
                        },
                        {
                            "text": "Engineers are trying to stop the <w>leak</w> from the damaged pipeline.",
                            "target_lang_translations": {
                                "ru": "Инженеры пытаются остановить <w>течь</w> из поврежденного трубопровода.",
                                "zh": "工程师们正试图阻止受损管道的<w>渗漏</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop the leak",
                        "oil leak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или случай выхода жидкости или газа через отверстие.",
                        "zh": "液体或气体通过开口流出的行为或实例。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "процесс выхода вещества"
                            },
                            {
                                "target_lang_word": "течь",
                                "target_lang_sense_clarification": "проникновение воды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泄漏",
                                "target_lang_sense_clarification": "指物质流出的过程"
                            },
                            {
                                "target_lang_word": "渗漏",
                                "target_lang_sense_clarification": "指液体缓慢流出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47f326eb-7908-3b9b-a7a2-68ef1eba5e93",
                    "sense_definition": "A disclosure of secret or confidential information.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "info_leak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is investigating the <w>leak</w> of classified military documents.",
                            "target_lang_translations": {
                                "ru": "Правительство расследует <w>утечку</w> секретных военных документов.",
                                "zh": "政府正在调查机密军事文件的<w>泄密</w>事件。"
                            }
                        },
                        {
                            "text": "There was a major <w>leak</w> of private emails from the company server.",
                            "target_lang_translations": {
                                "ru": "Произошел крупный <w>слив</w> личных писем с сервера компании.",
                                "zh": "公司服务器发生了大规模的私人邮件<w>泄露</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "security leak",
                        "data leak",
                        "press leak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрытие секретной или конфиденциальной информации.",
                        "zh": "秘密或机密信息的披露。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "информации"
                            },
                            {
                                "target_lang_word": "слив",
                                "target_lang_sense_clarification": "разг. намеренное разглашение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泄密",
                                "target_lang_sense_clarification": "指机密信息被公开"
                            },
                            {
                                "target_lang_word": "走漏",
                                "target_lang_sense_clarification": "指消息外传"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e8b03be-1014-3ab7-8d8e-804b6b96f9e2",
                    "sense_definition": "A person who secretly reveals confidential information.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "info_leak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are trying to identify the <w>leak</w> within the department.",
                            "target_lang_translations": {
                                "ru": "Они пытаются вычислить <w>информатора</w> внутри отдела.",
                                "zh": "他们正试图找出部门内部的<w>泄密者</w>。"
                            }
                        },
                        {
                            "text": "He was accused of being the <w>leak</w> who gave the story to the press.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в том, что он был <w>источником утечки</w>, передавшим историю прессе.",
                                "zh": "他被指控是向媒体提供报道的<w>泄密者</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "find the leak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который тайно раскрывает конфиденциальную информацию.",
                        "zh": "秘密泄露机密信息的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "информатор",
                                "target_lang_sense_clarification": "источник сведений"
                            },
                            {
                                "target_lang_word": "источник утечки",
                                "target_lang_sense_clarification": "виновник разглашения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泄密者",
                                "target_lang_sense_clarification": "指泄露秘密的人"
                            },
                            {
                                "target_lang_word": "内鬼",
                                "target_lang_sense_clarification": "指组织内部的泄密者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48d31ea1-ac0b-315e-ad82-bfe864df2f78",
                    "sense_definition": "An act of urination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "urination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excuse me for a moment, I really need to take a <w>leak</w>.",
                            "target_lang_translations": {
                                "ru": "Извините на минутку, мне правда нужно <w>отлить</w>.",
                                "zh": "失陪一下，我真的需要去<w>排尿</w>。"
                            }
                        },
                        {
                            "text": "He went behind the bushes for a quick <w>leak</w>.",
                            "target_lang_translations": {
                                "ru": "Он зашел за кусты, чтобы по-быстрому <w>справить нужду</w>.",
                                "zh": "他走到灌木丛后面去<w>撒尿</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pee",
                        "piss",
                        "slash",
                        "wee",
                        "whiz"
                    ],
                    "common_phrases": [
