                                "target_senses": [
                                    {
                                        "sense_id": "0a08ee65-8069-3dee-bd97-b42b99212712",
                                        "entry_id": "541321fd-ef25-3971-881f-d6c7b03a5a62",
                                        "glosses": [
                                            "derjenige Teil eines Gegenstandes, der dafür vorgesehen ist, dass man ihn ergreift, wenn man den Gegenstand benutzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d81707-0b1c-40c5-be4b-36047af75432",
                                                "sense_id": "0a08ee65-8069-3dee-bd97-b42b99212712",
                                                "text": "Der Griff des Kochtopfes ist abgebrochen."
                                            },
                                            {
                                                "example_id": "57f0654b-5b07-41c4-bae2-bd34f984e5b4",
                                                "sense_id": "0a08ee65-8069-3dee-bd97-b42b99212712",
                                                "text": "Der Griff des Schwertes war kunstvoll verziert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b506fec-0977-3b57-9b8b-c231ef3cc5fa",
                                        "entry_id": "541321fd-ef25-3971-881f-d6c7b03a5a62",
                                        "glosses": [
                                            "das Greifen, Zugreifen, Anpacken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8cbbcea-398e-46f3-b2c2-8ba42c39693f",
                                                "sense_id": "2b506fec-0977-3b57-9b8b-c231ef3cc5fa",
                                                "text": "Endlich lockerte er den Griff um meinen Oberarm."
                                            },
                                            {
                                                "example_id": "a9f74531-50c2-4779-9daf-06f84387b100",
                                                "sense_id": "2b506fec-0977-3b57-9b8b-c231ef3cc5fa",
                                                "text": "Ein Griff in die Tasche und er holte die Pistole hervor."
                                            },
                                            {
                                                "example_id": "8a6c2e96-d1ea-4715-9134-7506bb23d9f7",
                                                "sense_id": "2b506fec-0977-3b57-9b8b-c231ef3cc5fa",
                                                "text": "Zeigst du mir noch mal den Griff? Ich kriege die Finger nicht so weit auseinander. Gitarre lerne ich wohl nie."
                                            },
                                            {
                                                "example_id": "e6c60289-5aa8-449e-b65e-8a7ccf2da9f3",
                                                "sense_id": "2b506fec-0977-3b57-9b8b-c231ef3cc5fa",
                                                "text": "Mit einem beherzten Griff erwischte er noch den Ärmel der Jacke des Fliehenden."
                                            },
                                            {
                                                "example_id": "210df7ab-27c3-4032-ab2a-45efb2c2fc71",
                                                "sense_id": "2b506fec-0977-3b57-9b8b-c231ef3cc5fa",
                                                "text": "Mit Herrn Hansen hat der Chef einen guten Griff getan, er ist kompetent und freundlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1dad18f8-e372-3c7c-b616-18c23e66c326",
                                        "entry_id": "541321fd-ef25-3971-881f-d6c7b03a5a62",
                                        "glosses": [
                                            "das Beherrschen einer Aufgabe, im Griff"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d30eb1d-81e1-4799-836c-0d9ab2026a40",
                                                "sense_id": "1dad18f8-e372-3c7c-b616-18c23e66c326",
                                                "text": "Er hatte seine Probleme im Griff."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4e1aea8d-e5a5-3ae7-bea1-1fed4235088c",
                                        "entry_id": "541321fd-ef25-3971-881f-d6c7b03a5a62",
                                        "glosses": [
                                            "Haftung von einer Oberfläche an einer anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbe6ca7c-08f3-49fd-9a55-f6c27b1f3d50",
                                                "sense_id": "4e1aea8d-e5a5-3ae7-bea1-1fed4235088c",
                                                "text": "Die Reifen hatten einen zufriedenstellenden Griff auf der feuchten Straße."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b245002e-d2c4-311b-a904-17055ebf8ea3",
                                        "entry_id": "541321fd-ef25-3971-881f-d6c7b03a5a62",
