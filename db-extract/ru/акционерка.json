                        "entry_id": "b0d2db51-7a64-3987-8cdc-2650d32135b6",
                        "glosses": [
                            "разг. сокр. акционерное общество, АО"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "03e563f3-c6c7-40c5-80f3-a7250d8c0241",
                                "sense_id": "1e135129-051b-3dd6-9a34-f90727a71022",
                                "text": "Короче, работаем тонко ― эта акционерка, которую мы с вами учредим, тотчас создает другую, тоже по сути нашу."
                            }
                        ]
                    }
