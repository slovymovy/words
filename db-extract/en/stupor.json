                                            {
                                                "example_id": "ebcbb2a1-8407-433b-a9dd-842ae099b8e3",
                                                "sense_id": "fb78baf7-0069-3af3-9116-1ce888653e24",
                                                "text": "Toen ik dat zag gebeuren sloeg de verbijstering toe."
                                            }
                                        ]
