                    {
                        "translation_id": "2730c6e5-2607-473c-9bfe-895abf250fd5",
                        "source_entry_id": "96cc09de-fb89-31ea-a37d-b208bdbcb784",
                        "source_sense_id": "355fe9d6-63cd-3a0a-97e4-2d7e345b3b04",
                        "source_sense_description": "alle masten, stengen en ra's behorende tot de vaste uitrusting van een zeilschip",
                        "target_lang_word": "mâture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mâture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "484b4b27-dd73-3bac-9a2a-c322851ec3d6",
                                        "entry_id": "b029b0bc-bd9e-33e2-815a-a8c08cca7fce",
                                        "glosses": [
                                            "Ensemble des mâts d’un bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c61a3a2c-b4ff-46cf-aa98-d19a7f8305e1",
                                                "sense_id": "484b4b27-dd73-3bac-9a2a-c322851ec3d6",
                                                "text": "Le feu, sortant des trois panneaux à la fois, se joignit et s’étendit comme un vaste rideau enflammé, sur lequel la mâture et les cordages du San-Pablo se dessinaient en noir."
                                            },
                                            {
                                                "example_id": "083fb3d1-eea0-42e5-bcad-103c832c91a1",
                                                "sense_id": "484b4b27-dd73-3bac-9a2a-c322851ec3d6",
                                                "text": "Enfin, celui-ci termina sa tournée par l’inspection de la mâture et du gréement."
                                            },
                                            {
                                                "example_id": "7325fd50-ec1c-4b55-8268-bed4167330b5",
                                                "sense_id": "484b4b27-dd73-3bac-9a2a-c322851ec3d6",
                                                "text": "Le temps se modère un peu, la mer toujours affreuse, le navire se comporte toujours très-bien, la mâture ne bouge pas quoique le navire tangue beaucoup, […]."
                                            },
                                            {
                                                "example_id": "ba0eeb0c-1ce1-4431-9629-b324d3651d58",
                                                "sense_id": "484b4b27-dd73-3bac-9a2a-c322851ec3d6",
                                                "text": "Plusieurs de ces navires étaient en train d’appareiller et dans leur mâture on voyait des matelots courir çà et là sur des échelles de corde qui, de loin, paraissaient fines comme des fils d’araignée."
                                            },
                                            {
                                                "example_id": "df64018f-572c-4d8e-86a4-336aa8475811",
                                                "sense_id": "484b4b27-dd73-3bac-9a2a-c322851ec3d6",
                                                "text": "La navigation dans les glaces ne s'effectue dans de bonnes conditions qu'avec des ordres venant du haut de la mâture."
                                            },
                                            {
                                                "example_id": "89e7417b-300a-40bd-a155-d5176b6a9fb7",
                                                "sense_id": "484b4b27-dd73-3bac-9a2a-c322851ec3d6",
                                                "text": "Un grain tombe sur sa mâture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43d28c32-fe06-366d-92a4-03c5d4bccafd",
                                        "entry_id": "b029b0bc-bd9e-33e2-815a-a8c08cca7fce",
                                        "glosses": [
                                            "Bois propre à faire des mâts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dd4a085-5dd5-3ada-a5a5-7dbbfa37def6",
                                        "entry_id": "b029b0bc-bd9e-33e2-815a-a8c08cca7fce",
                                        "glosses": [
                                            "Art de mâter les bâtiments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76f88ea6-baab-311c-8325-aafc81bfcc90",
                                        "entry_id": "b029b0bc-bd9e-33e2-815a-a8c08cca7fce",
                                        "glosses": [
                                            "Atelier et les magasins établis pour confectionner, réparer, conserver les mâts et les bois de mâture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a1906d-c711-479b-804e-3880e2ceb808",
                                                "sense_id": "76f88ea6-baab-311c-8325-aafc81bfcc90",
                                                "text": "Je vais à la mâture."
                                            }
                                        ]
                                    }
                                ]
