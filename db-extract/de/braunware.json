                        "glosses": [
                            "vor allem in Österreich gebräuchliches Wort für Geräte der Unterhaltungselektronik (Abgrenzung zu Weißware)"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "862f42a2-950c-47f5-bcb7-0abfaaaa8eb8",
                                "sense_id": "e10f84df-9f32-37a9-bf83-29a7abe4a1f1",
                                "text": "Die Preise für Braunware sind im letzten Monat gefallen."
                            },
                            {
                                "example_id": "71cc8de0-fef6-4312-9bc5-6b63b4a0c430",
                                "sense_id": "e10f84df-9f32-37a9-bf83-29a7abe4a1f1",
                                "text": "„Etablierung eines Nachhaltigkeitssiegels für reparaturfreundlich konstruierte Elektro(nik)-Geräte (Weiß- und Braunware) zur Orientierung der KonsumentInnen [sic] bei Kaufentscheidungen“"
                            },
                            {
                                "example_id": "631a2b33-f0de-4a5b-9cb1-96a5f07be888",
                                "sense_id": "e10f84df-9f32-37a9-bf83-29a7abe4a1f1",
                                "text": "„wie übersetzt ihr die Warengruppenbezeichnungen Braunware (z.B. Fernseher, Video, etc.) und Weissware (z.B. Kühlschränke, Waschmaschinen, Trockner) für den Elektro-Fachhandel?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
