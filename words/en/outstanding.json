{
    "word_family": [
        "outstand",
        "outstandingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "22d90a0e-7a31-3acb-bbcb-7563ada80a82",
                    "sense_definition": "Exceptionally good; distinguished from others by its superiority.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student received an award for her <w>outstanding</w> academic performance.",
                            "target_lang_translations": {
                                "ru": "Студентка получила награду за свою <w>выдающуюся</w> успеваемость.",
                                "zh": "这位学生因其<w>杰出</w>的学业表现而获得了奖励。",
                                "pl": "Studentka otrzymała nagrodę za swoje <w>wybitne</w> wyniki w nauce."
                            }
                        },
                        {
                            "text": "It was an <w>outstanding</w> achievement for the entire team to win the championship.",
                            "target_lang_translations": {
                                "ru": "Победа в чемпионате стала <w>выдающимся</w> достижением для всей команды.",
                                "zh": "整个团队赢得冠军是一项<w>杰出</w>的成就。",
                                "pl": "Zdobycie mistrzostwa było <w>znakomitym</w> osiągnięciem dla całego zespołu."
                            }
                        }
                    ],
                    "synonyms": [
                        "excellent",
                        "exceptional",
                        "magnificent",
                        "impressive",
                        "remarkable",
                        "amazing",
                        "extraordinary",
                        "distinguished",
                        "noteworthy",
                        "wonderful"
                    ],
                    "antonyms": [
                        "mediocre"
                    ],
                    "common_phrases": [
                        "outstanding achievement",
                        "outstanding performance",
                        "outstanding success",
                        "outstanding contribution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительно хороший; выделяющийся среди других своим превосходством.",
                        "zh": "极其优秀的；因卓越而与众不同。",
                        "pl": "Wyjątkowo dobry; wyróżniający się na tle innych swoją wyższością."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдающийся",
                                "target_lang_sense_clarification": "исключительный, знаменитый"
                            },
                            {
                                "target_lang_word": "незаурядный",
                                "target_lang_sense_clarification": "необычный, яркий (о способностях или личности)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杰出的",
                                "target_lang_sense_clarification": "才华或成就非常突出"
                            },
                            {
                                "target_lang_word": "优秀的",
                                "target_lang_sense_clarification": "表现或品质极好"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wybitny",
                                "target_lang_sense_clarification": "wyróżniający się ponad przeciętność, niezwykle uzdolniony"
                            },
                            {
                                "target_lang_word": "znakomity",
                                "target_lang_sense_clarification": "bardzo dobry, doskonały, świetny"
                            },
                            {
                                "target_lang_word": "doskonały",
                                "target_lang_sense_clarification": "wspaniały, pozbawiony wad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0391c4da-7532-3f68-8962-46caea1821f1",
                    "sense_definition": "Owed as a debt; not yet paid.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "remaining_to_be_done",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please pay your <w>outstanding</w> balance by the end of the month.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оплатите ваш <w>неоплаченный</w> остаток до конца месяца.",
                                "zh": "请在月底前付清您的<w>未付</w>余额。",
                                "pl": "Proszę uregulować <w>zaległe</w> saldo do końca miesiąca."
                            }
                        },
                        {
                            "text": "The company is struggling to collect its <w>outstanding</w> debts from customers.",
                            "target_lang_translations": {
                                "ru": "Компания с трудом пытается взыскать свои <w>непогашенные</w> долги с клиентов.",
                                "zh": "公司正努力向客户追讨<w>未偿还</w>的债务。",
                                "pl": "Firma ma trudności z odzyskaniem <w>niespłaconych</w> długów od klientów."
                            }
                        }
                    ],
                    "synonyms": [
                        "unpaid",
                        "unsettled",
                        "due"
                    ],
                    "common_phrases": [
                        "outstanding debt",
                        "outstanding balance",
                        "outstanding bill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причитающийся в качестве долга; еще не оплаченный.",
                        "zh": "作为债务应付的；尚未支付的。",
                        "pl": "Należny jako dług; jeszcze nieopłacony."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неоплаченный",
                                "target_lang_sense_clarification": "о счетах или расходах"
                            },
                            {
                                "target_lang_word": "непогашенный",
                                "target_lang_sense_clarification": "о долгах или кредитах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未付的",
                                "target_lang_sense_clarification": "指账单或款项尚未结清"
                            },
                            {
                                "target_lang_word": "未偿还的",
                                "target_lang_sense_clarification": "指债务或贷款尚未还清"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zaległy",
                                "target_lang_sense_clarification": "taki, którego nie opłacono we właściwym czasie"
                            },
                            {
                                "target_lang_word": "niespłacony",
                                "target_lang_sense_clarification": "o długu lub kredycie, który nie został uregulowany"
                            },
                            {
                                "target_lang_word": "nieuregulowany",
                                "target_lang_sense_clarification": "o rachunku lub płatności, która nie została dokonana"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a33d842-09fd-388c-a828-dc6a5919b3b6",
                    "sense_definition": "Unresolved; not settled or finished.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "remaining_to_be_done",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We still have several <w>outstanding</w> issues to discuss at the meeting.",
                            "target_lang_translations": {
                                "ru": "У нас все еще есть несколько <w>нерешённых</w> вопросов для обсуждения на собрании.",
                                "zh": "我们还有几个<w>未解决</w>的问题需要在会议上讨论。",
                                "pl": "Mamy jeszcze kilka <w>niezałatwionych</w> spraw do omówienia na spotkaniu."
                            }
                        },
                        {
                            "text": "There are a few <w>outstanding</w> tasks on my list before I can go home.",
                            "target_lang_translations": {
                                "ru": "В моем списке есть несколько <w>невыполненных</w> задач, прежде чем я смогу пойти домой.",
                                "zh": "在我回家之前，清单上还有几项<w>未完成</w>的任务。",
                                "pl": "Na mojej liście pozostało kilka <w>niezałatwionych</w> zadań, zanim będę mógł wrócić do domu."
                            }
                        }
                    ],
                    "synonyms": [
                        "unresolved",
                        "unfinished",
                        "unsettled"
                    ],
                    "common_phrases": [
                        "outstanding issues",
                        "outstanding work",
                        "outstanding tasks",
                        "outstanding questions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нерешённый; не урегулированный или не законченный.",
                        "zh": "未解决的；未处理或未完成的。",
                        "pl": "Nierozwiązany; nieuregulowany lub niedokończony."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нерешённый",
                                "target_lang_sense_clarification": "о проблемах или вопросах"
                            },
                            {
                                "target_lang_word": "невыполненный",
                                "target_lang_sense_clarification": "о задачах или работе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未解决的",
                                "target_lang_sense_clarification": "指问题或争议尚未处理"
                            },
                            {
                                "target_lang_word": "未完成的",
                                "target_lang_sense_clarification": "指任务或工作尚未做完"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niezałatwiony",
                                "target_lang_sense_clarification": "o sprawach lub zadaniach, które czekają na rozwiązanie"
                            },
                            {
                                "target_lang_word": "nierozwiązany",
                                "target_lang_sense_clarification": "o problemie lub kwestii, która nie została wyjaśniona"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b9c2547-93b6-3ccd-8912-f77830d6d8d0",
                    "sense_definition": "Projecting or sticking outwards.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climbers aimed for the <w>outstanding</w> rock formation near the summit.",
                            "target_lang_translations": {
                                "ru": "Альпинисты направлялись к <w>выступающему</w> скальному образованию у вершины.",
                                "zh": "登山者们瞄准了山顶附近那块<w>突出</w>的岩层。",
                                "pl": "Wspinacze celowali w <w>wystającą</w> formację skalną w pobliżu szczytu."
                            }
                        },
                        {
                            "text": "From the coast, we could see an <w>outstanding</w> spur of the mountain range.",
                            "target_lang_translations": {
                                "ru": "С побережья мы могли видеть <w>выступающий</w> отрог горного хребта.",
                                "zh": "从海岸望去，我们可以看到山脉中一个<w>突出</w>的山脊。",
                                "pl": "Z wybrzeża mogliśmy zobaczyć <w>wystający</w> odnóg pasma górskiego."
                            }
                        }
                    ],
                    "synonyms": [
                        "projecting",
                        "protuberant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literal meaning"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающий или торчащий наружу.",
                        "zh": "向外突出或伸出的。",
                        "pl": "Wystający lub sterczący na zewnątrz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступающий",
                                "target_lang_sense_clarification": "физически выдающийся вперед"
                            },
                            {
                                "target_lang_word": "торчащий",
                                "target_lang_sense_clarification": "разг. выделяющийся на поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突出的",
                                "target_lang_sense_clarification": "物理上向外伸出"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wystający",
                                "target_lang_sense_clarification": "fizycznie wysunięty do przodu"
                            },
                            {
                                "target_lang_word": "sterczący",
                                "target_lang_sense_clarification": "wyróżniający się na powierzchni, często pionowo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef462f2a-45b1-3ea4-8c55-d74b0290f398",
                    "sense_definition": "Present participle and gerund of <w>outstand</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old structure was <w>outstanding</w> the newer buildings in durability.",
                            "target_lang_translations": {
                                "ru": "Старая конструкция <w>превосходила</w> новые здания по долговечности.",
                                "zh": "这座旧建筑在耐用性上<w>胜过</w>了那些新建筑。",
                                "pl": "Stara konstrukcja <w>przewyższała</w> nowsze budynki pod względem trwałości."
                            }
                        },
                        {
                            "text": "He was <w>outstanding</w> the storm while others sought shelter.",
                            "target_lang_translations": {
                                "ru": "Он <w>противостоял</w> шторму, пока другие искали укрытие.",
                                "zh": "当别人都在寻找避难所时，他仍在<w>抵御</w>风暴。",
                                "pl": "On <w>przeczekiwał</w> burzę, podczas gdy inni szukali schronienia."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от outstand.",
                        "zh": "outstand的现在分词和动名词形式。",
                        "pl": "Imiesłów czasu teraźniejszego i gerundium od czasownika 'outstand'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превосходящий",
                                "target_lang_sense_clarification": "быть лучше или долговечнее"
                            },
                            {
                                "target_lang_word": "противостоящий",
                                "target_lang_sense_clarification": "выдерживать (шторм и т.д.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胜过",
                                "target_lang_sense_clarification": "在某方面超过其他事物"
                            },
                            {
                                "target_lang_word": "抵御",
                                "target_lang_sense_clarification": "经受住恶劣环境"
                            }
                        ],
                        "pl": []
                    }
                }
            ]
        }
    ]
