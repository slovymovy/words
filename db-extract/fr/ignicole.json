                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e386dbd3-cb3b-42c9-bc79-ff9e68e3b0d9",
                                "sense_id": "97e812c2-9b99-3d9a-ab09-b16a9c065fa6",
                                "text": "C'est à lui [Hyde] surtout que nous devons les cent portes du Sadder, qui contiennent tous les principaux préceptes des pieux ignicoles."
                            },
                            {
                                "example_id": "a3bbbe82-3c6f-4de4-a312-ab7c41ba6efa",
                                "sense_id": "97e812c2-9b99-3d9a-ab09-b16a9c065fa6",
                                "text": "Vous, les ignicoles, vous adorez le feu, objet matériel qui s'éteint, se rallume et s'éteint encore."
                            }
                        ]
                    }
