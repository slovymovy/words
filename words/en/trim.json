{
    "word_family": [
        "trimmer",
        "trimming",
        "trimly",
        "trimness",
        "untrimmed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f805186-a534-3b55-8e6b-b72b23d5d5e7",
                    "sense_definition": "To reduce slightly by cutting, especially to remove excess or make something neat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>trim</w> his beard before the job interview.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>подровнять</w> бороду перед собеседованием."
                            }
                        },
                        {
                            "text": "You should <w>trim</w> the edges of the paper to make it fit the frame.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит <w>обрезать</w> края бумаги, чтобы она подошла к рамке."
                            }
                        }
                    ],
                    "synonyms": [
                        "clip",
                        "crop",
                        "prune"
                    ],
                    "common_phrases": [
                        "trim the edges",
                        "trim a beard",
                        "trim the fat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Немного уменьшить путем срезания, особенно для удаления лишнего или придания опрятного вида."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстричь",
                                "target_lang_sense_clarification": "волосы, бороду или кусты"
                            },
                            {
                                "target_lang_word": "подровнять",
                                "target_lang_sense_clarification": "края или концы"
                            },
                            {
                                "target_lang_word": "обрезать",
                                "target_lang_sense_clarification": "лишнее по краям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fb70dc9-99f7-3536-8769-ec128f419b2a",
                    "sense_definition": "To decorate or adorn, especially by adding ornaments to a Christmas tree.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whole family gathered to <w>trim</w> the tree on Christmas Eve.",
                            "target_lang_translations": {
                                "ru": "Вся семья собралась, чтобы <w>нарядить</w> елку в канун Рождества."
                            }
                        },
                        {
                            "text": "The designer chose to <w>trim</w> the gown with delicate silver lace.",
                            "target_lang_translations": {
                                "ru": "Дизайнер решил <w>отделать</w> платье изящным серебристым кружевом."
                            }
                        }
                    ],
                    "synonyms": [
                        "decorate",
                        "adorn",
                        "embellish"
                    ],
                    "common_phrases": [
                        "trim the tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать или декорировать, особенно добавляя украшения на рождественскую елку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наряжать",
                                "target_lang_sense_clarification": "елку"
                            },
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "одежду или предметы"
                            },
                            {
                                "target_lang_word": "отделывать",
                                "target_lang_sense_clarification": "декоративными элементами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f170967-531e-3788-9459-87a01b033697",
                    "sense_definition": "To adjust the angle of sails or control surfaces to achieve the best position relative to wind or water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor had to <w>trim</w> the sails to catch the light breeze.",
                            "target_lang_translations": {
                                "ru": "Моряку пришлось <w>подстроить</w> паруса, чтобы поймать легкий ветерок."
                            }
                        },
                        {
                            "text": "The pilot needed to <w>trim</w> the aircraft to maintain a steady altitude.",
                            "target_lang_translations": {
                                "ru": "Пилоту нужно было <w>оттриммировать</w> самолет, чтобы поддерживать постоянную высоту."
                            }
                        }
                    ],
                    "synonyms": [
                        "adjust",
                        "align"
                    ],
                    "common_phrases": [
                        "trim the sails"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautical and aeronautical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулировать угол наклона парусов или поверхностей управления для достижения наилучшего положения относительно ветра или воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дифферентовать",
                                "target_lang_sense_clarification": "выравнивать судно или самолет"
                            },
                            {
                                "target_lang_word": "настраивать",
                                "target_lang_sense_clarification": "паруса"
                            },
                            {
                                "target_lang_word": "триммировать",
                                "target_lang_sense_clarification": "в авиации"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3016d41d-c774-3737-ac56-653adb4d0b8c",
                    "sense_definition": "A small amount of cutting to tidy up hair or a hedge.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I just need a quick <w>trim</w> to keep my hair looking neat.",
                            "target_lang_translations": {
                                "ru": "Мне нужно просто немного <w>подровнять</w> волосы, чтобы они выглядели аккуратно."
                            }
                        },
                        {
                            "text": "The gardener gave the garden hedge a light <w>trim</w> this morning.",
                            "target_lang_translations": {
                                "ru": "Садовник слегка <w>подстриг</w> живую изгородь этим утром."
                            }
