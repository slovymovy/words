                        "glosses": [
                            "A type of twin-engine jet that was the first medium-haul modern jet airplane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d9347b5-4629-4c5d-9b61-6cef2620fb5a",
                                "sense_id": "54a1ddf3-40c1-349e-8baf-44d3adbfcc3a",
                                "text": "The Comet disasters gave all the more prestige to Air France when in 1959 it began flying its elegant jet the Caravelle, through Europe as far as Istanbul."
                            },
                            {
                                "example_id": "2e40cc8e-03aa-4495-b4c1-be2fbd83baaa",
                                "sense_id": "54a1ddf3-40c1-349e-8baf-44d3adbfcc3a",
                                "text": "After much consideration, Friedkin decided not to purchase the Caravelles."
                            },
                            {
                                "example_id": "6b8e79c3-8cab-455e-bc48-629794cee2a6",
                                "sense_id": "54a1ddf3-40c1-349e-8baf-44d3adbfcc3a",
                                "text": "The airline has bought 4 Caravelles from Swissair, and they are very nice aircraft and are far superior to the previous planes they had."
                            }
                        ]
                    }
