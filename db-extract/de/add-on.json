                "senses": [
                    {
                        "sense_id": "14851208-d4ac-38e2-b16d-24b210f30b76",
                        "entry_id": "85c9c2a7-c076-3958-8a00-daed6954400b",
                        "glosses": [
                            "Hilfsprogramm, Erweiterung für ein Anwendungsprogramm"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "2773ae1d-ec36-4be8-948a-a72673e6aac5",
                                "sense_id": "14851208-d4ac-38e2-b16d-24b210f30b76",
                                "text": "„Um beim Lesen nicht den Überblick zu verlieren, helfen Literaturdatenbanken wie Zotero. Mit dem Add-on für den Internetbrowser lassen sich PDF-Dokumente und Online-Publikationen sammeln und verwalten.“"
                            },
                            {
                                "example_id": "2a5b2d42-9fbe-4a88-ae2e-9a0da318d0d5",
                                "sense_id": "14851208-d4ac-38e2-b16d-24b210f30b76",
                                "text": "Das Ziel unserer ganzen Wörterbucharbeit ist ein Deutsch-Add-on für alle Browser."
                            },
                            {
                                "example_id": "c8b1d5df-9dcb-441f-bcfb-2493d5a5bafa",
                                "sense_id": "14851208-d4ac-38e2-b16d-24b210f30b76",
                                "text": "Was Add-ons und was „Plug-ins“ sind, ändert sich schneller, als das Wörterbuch die Bedeutungen formulieren kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7cc645b1-578e-3500-a052-585408f7e9be",
                        "entry_id": "85c9c2a7-c076-3958-8a00-daed6954400b",
                        "glosses": [
                            "Hardware-Zubehör; Erweiterung, Ergänzung, Auf- oder Nachrüstung für einen Rechner oder andere Geräte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ae772be-4d24-464a-8298-f636a9316078",
                                "sense_id": "7cc645b1-578e-3500-a052-585408f7e9be",
                                "text": "Was Add-ons und was „Plug-ins“ sind, ändert sich schneller, als das Wörterbuch die Bedeutungen formulieren kann."
                            },
                            {
                                "example_id": "2dc91a1b-4296-4e2b-a033-bc50c4ca18c0",
                                "sense_id": "7cc645b1-578e-3500-a052-585408f7e9be",
                                "text": "Der billige Preis kommt nur dadurch zustande, dass notwendige Bestandteile als Add-ons verkauft werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "26713424-f5a5-3711-8d85-77bfd95aa53a",
                        "entry_id": "85c9c2a7-c076-3958-8a00-daed6954400b",
                        "glosses": [
                            "etwas, das man (bei einem Einkauf) zusätzlich kostenlos erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c2f104d-3f42-4d7b-94b7-45cbe1491630",
                                "sense_id": "26713424-f5a5-3711-8d85-77bfd95aa53a",
                                "text": "Das Wahrig Deutsches Wörterbuch auf CD-ROM gibt es immer noch nur als Add-on zum Buch."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
