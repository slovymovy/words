                        "source_sense_id": "5a308b19-6f4e-3cd8-9eb2-32c714941367",
                        "source_sense_description": "die Dauer, in der jemand oder etwas lebt oder haltbar ist",
                        "target_lang_word": "lifespan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lifespan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c605c09-403d-39e8-97f4-1ad4cc2252a9",
                                        "entry_id": "550fbcc1-9139-3e6e-9074-5c154921304e",
                                        "glosses": [
                                            "The length of time for which an organism lives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2598c367-7ee4-4e73-94e6-1d977d66ffd4",
                                                "sense_id": "0c605c09-403d-39e8-97f4-1ad4cc2252a9",
                                                "text": "Meronym: healthspan"
                                            },
                                            {
                                                "example_id": "7bda7845-a848-4bb7-bd5d-20e5426b70b6",
                                                "sense_id": "0c605c09-403d-39e8-97f4-1ad4cc2252a9",
                                                "text": "Some clams have lifespans far longer than those of human beings."
                                            },
                                            {
                                                "example_id": "44004fc6-2696-4bc7-b963-6106aaaba345",
                                                "sense_id": "0c605c09-403d-39e8-97f4-1ad4cc2252a9",
                                                "text": "What the devil happened to my year? Another little digit on my lifespan, what a bore."
                                            },
                                            {
                                                "example_id": "7db8d324-8d6a-4a6c-88ef-16df5a024d84",
                                                "sense_id": "0c605c09-403d-39e8-97f4-1ad4cc2252a9",
                                                "text": "Last spring, the periodical cicadas emerged across eastern North America. Their vast numbers and short above-ground life spans inspired awe and irritation in humans—and made for good meals for birds and small mammals."
                                            },
                                            {
                                                "example_id": "d816f2db-0812-4996-b2ee-a44683d8bc3a",
                                                "sense_id": "0c605c09-403d-39e8-97f4-1ad4cc2252a9",
                                                "text": "Asari Cultural VI: Due to our lifespan-sometimes reaching 1,000 years of age-we are patient in our decisions, and prefer long-term solutions over short-term gains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb1628fb-c9ed-3086-aeff-21c71ec4fe20",
                                        "entry_id": "550fbcc1-9139-3e6e-9074-5c154921304e",
                                        "glosses": [
                                            "The length of time for which something exists or is current, valid, or usable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc2d0234-7c40-4c2d-b8ca-7a008d9f432f",
                                                "sense_id": "eb1628fb-c9ed-3086-aeff-21c71ec4fe20",
                                                "text": "The virtual enterprise forum developed several \"classical\" management functions for which resources were available throughout its lifespan."
                                            },
                                            {
                                                "example_id": "ac68b674-bf94-458c-b63d-7693d5da454d",
                                                "sense_id": "eb1628fb-c9ed-3086-aeff-21c71ec4fe20",
                                                "text": "The reactor, located in the city of Fuqing city in China’s southeastern Fujian province, was designed to have a 60-year lifespan, with its core equipment domestically produced."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
