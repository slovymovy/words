                ],
                "senses": [
                    {
                        "sense_id": "d811524e-42ac-3aa7-abcb-36a10a785663",
                        "entry_id": "1cd60d0c-ea35-3810-82b4-5a98f3df9b21",
                        "glosses": [
                            "Künstler, der (beruflich) Gemälde und Grafiken erstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "114fdd7d-0daf-4972-a4e7-8e601111e84f",
                                "sense_id": "d811524e-42ac-3aa7-abcb-36a10a785663",
                                "text": "„Die Herren seien ihr auch gleich recht ernst vorgekommen, wo doch die Kunstmaler meistens ein lockeres, sorgloses Völkchen seien ohne viel Sinn für den Ernst des Lebens.“"
                            },
                            {
                                "example_id": "12bfb61c-9e7d-4341-916d-5bffb7f45013",
                                "sense_id": "d811524e-42ac-3aa7-abcb-36a10a785663",
                                "text": "„Übrigens wolle sie der Gattung der Kunstmaler nicht Unrecht tun, denn ihr Mieter von damals, zum Beispiel, habe schon gleich eine Ausnahme von der Vergnügtheit gemacht und sei ein sehr stiller, verschlossener Mann gewesen, eher von schwerem Mut […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
