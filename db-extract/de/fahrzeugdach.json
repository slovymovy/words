                ],
                "senses": [
                    {
                        "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                        "entry_id": "fac54f22-7348-31e2-ace1-0abfb4a0bf22",
                        "glosses": [
                            "Dach eines Autos, Lasters oder Zuges (= Fahrzeug)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88a06d39-fd70-41e9-8f2c-601cba10737f",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "Vor dem Losfahren muss das Fahrzeugdach von Schnee und Eis befreit werden."
                            },
                            {
                                "example_id": "4b11da03-4916-45db-9d37-4f6f8602ad4e",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "„Vor allem herunterfallende Eisbrocken stellen für den nachfolgenden Verkehr eine große Gefahr dar, weshalb Trucker dazu verpflichtet sind, vor Fahrtantritt das Fahrzeugdach zu kontrollieren.“"
                            },
                            {
                                "example_id": "0e521b26-a240-4067-bcb9-a58120c5228e",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "Bei schweren Unfällen muss die Feuerwehr manchmal das Fahrzeugdach mit einer hydraulischen Rettungsschere aufschneiden, um den Fahrer oder die Passagiere aus dem Fahrzeug zu befreien."
                            },
                            {
                                "example_id": "0b04a49c-7571-4361-a069-52645751d772",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "[Großtanklöschfahrzeuge:] „Diese Fahrzeuge verfügen in der Regel über einen Schaum-Wasser-Werfer auf dem Fahrzeugdach, der einen besonders massiven Löschangriff ermöglicht.“"
                            },
                            {
                                "example_id": "c4c61e2c-9f41-4ef2-8e5d-70ae6ea866f9",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "[Wasserwerfer der Polizei:] „Auf dem Fahrzeugdach sind zwei hydraulisch gesteuerte Wasserkanonen befestigt, die im Kreis herumschwenken können.“"
                            },
                            {
                                "example_id": "9d6bba5e-b31c-4e30-a997-dd0f009d2cf0",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "„Zu den Besonderheiten eines Minivans im Vergleich zu einem Kleinwagen zählt ein höheres Fahrzeugdach.“"
                            },
                            {
                                "example_id": "5ba1a752-a9e6-4191-9fc2-b69e4fc997a4",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "„Im Automobilbau dient die Dachreling als Grundträger zum Transport auf dem Fahrzeugdach.“"
                            },
                            {
                                "example_id": "c30820b0-a364-4df7-a2d9-d70cf3f5fe15",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "„Ein 23-jähriger aus dem Raum Freudenberg befuhr die L512 in Fahrtrichtung Olpe, als auf Grund eines Sturmtiefs ein Ast von einem Baum abbrach und beim Herunterfallen das Fahrzeugdach des Kleintransporters durchschlug.“ […] „Der Fahrzeugführer blieb unverletzt.“"
                            },
                            {
                                "example_id": "8c4dbd4c-3046-49fa-be93-a1bc47504910",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "[Nach Erdbeben auf Haiti:] „Zum Teil mit Gewalt rissen die Männer den Verteilern die Waren aus der Hand, stiegen auf die Fahrzeugdächer, um schneller an die Nahrungsmittel zu kommen.“"
                            },
                            {
                                "example_id": "95b712e4-4b80-4edc-8c57-d04f37925ee8",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "„Dachgepäckträger können eine gute Möglichkeit sein, Deine Solarmodule auf dem Fahrzeugdach zu befestigen.“"
                            },
                            {
                                "example_id": "da66c45e-02be-495c-adf2-053f2bdb8658",
                                "sense_id": "d8198885-e92c-3a5a-b9ec-8323c4992a89",
                                "text": "„Der Straßenbahnhersteller Siemens muss sämtliche 400 ausgelieferten Straßenbahnen vom Typ Combino für eine Vollsanierung zurückrufen. Risse in der Karosserie und falsch konstruierte Aufbauten könnten bei Unfällen zu einem Einsturz der Fahrzeugdächer führen, berichtet die Rheinische Post.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
