                },
                {
                    "sense_id": "2301b5f2-995d-3a0b-bb6a-e80ba6e5bf20",
                    "sense_definition": "Qui a une expression sévère, dure ou menaçante, en parlant des yeux ou du visage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'inconnu nous observait de loin avec un regard <w>farouche</w> et inquiétant.",
                            "target_lang_translations": {
                                "en": "The stranger watched us from a distance with a <w>menacing</w> and unsettling look.",
                                "ru": "Незнакомец наблюдал за нами издали с <w>угрожающим</w> и тревожным взглядом.",
                                "de": "Der Fremde beobachtete uns aus der Ferne mit einem <w>finsteren</w> und unheimlichen Blick.",
                                "es": "El desconocido nos observaba desde lejos con una mirada <w>amenazadora</w> e inquietante.",
                                "zh": "那个陌生人远远地注视着我们，目光<w>凶狠</w>，令人不安。"
                            }
                        },
                        {
                            "text": "Son air <w>farouche</w> intimidait tous les jeunes élèves de la classe.",
                            "target_lang_translations": {
                                "en": "His <w>stern</w> air intimidated all the young pupils in the class.",
                                "ru": "Его <w>суровый</w> вид пугал всех младших учеников класса.",
                                "de": "Seine <w>strenge</w> Miene schüchterte die jungen Schüler der Klasse ein.",
                                "es": "Su aire <w>severo</w> intimidaba a todos los alumnos más jóvenes de la clase.",
                                "zh": "他那副<w>严厉</w>的神情吓住了班上所有年幼的学生。"
                            }
                        }
