                                        "glosses": [
                                            "To utter the interjection oh; to express surprise, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "988b9931-2a03-49e9-8f68-35c89102e0fa",
                                                "sense_id": "a1f5526e-416f-34e3-96e4-01f02c9d7abd",
                                                "text": "A quarter of an hour elapsed, and then, after several rings at the door-bell, a smothered laugh, and a good deal of ohing and ahing, the door was thrown open, and one by one, as they were announced, in came the expected characters."
                                            }
                                        ]
                                    }
                                ]
                            },
