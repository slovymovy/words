                        "glosses": [
                            "Spécialiste en graphologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d365b60-da18-4593-8b18-2030ffcb84ab",
                                "sense_id": "0a683d22-04f5-3eac-9180-90341b817950",
                                "text": "Ses chefs […] louaient aussi son calme, son tact et sa tenue. Aux yeux d'un graphologue, la dernière lettre autographe de lui, qui a été conservée, confirme ces notes. Elle révèle un esprit net et précis."
                            },
                            {
                                "example_id": "da1eaeb8-000c-476f-bd53-3e668d6d349b",
                                "sense_id": "0a683d22-04f5-3eac-9180-90341b817950",
                                "text": "Quelque 15 historiens, juristes, experts médicaux et graphologues, se sont succédé à la barre durant son procès."
                            }
                        ]
                    }
                ],
                "translations": [
