{
    "word_family": [
        "masculinity",
        "masculinize",
        "masculinization",
        "masculinely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98ed8ca2-a222-3920-bd88-32f6a4ea2071",
                    "sense_definition": "Relating to men or boys; biologically male.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gender_identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir is looking for more <w>masculine</w> voices to balance the sound.",
                            "target_lang_translations": {
                                "ru": "Хор ищет больше <w>мужских</w> голосов для баланса звучания.",
                                "zh": "合唱团正在寻找更多<w>男性</w>声部以平衡音色。"
                            }
                        },
                        {
                            "text": "John and Paul are traditionally <w>masculine</w> names in English-speaking countries.",
                            "target_lang_translations": {
                                "ru": "Джон и Пол — традиционно <w>мужские</w> имена в англоязычных странах.",
                                "zh": "在英语国家，约翰和保罗是传统的<w>男性</w>名字。"
                            }
                        }
                    ],
                    "synonyms": [
                        "male",
                        "manly"
                    ],
                    "antonyms": [
                        "female"
                    ],
                    "common_phrases": [
                        "masculine voice",
                        "masculine name"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к мужчинам или мальчикам; биологически мужской.",
                        "zh": "与男性或男孩有关的；生物学上的雄性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужско́й",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "男性",
                                "target_lang_sense_clarification": "指性别或生物学属性"
                            },
                            {
                                "target_lang_word": "男性的",
                                "target_lang_sense_clarification": "形容词形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e20e3b4-eaaf-3a9b-a3db-c836dbe91fcb",
                    "sense_definition": "Having qualities, appearance, or behavior traditionally associated with men, such as strength or assertiveness.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "gender_identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She admired his <w>masculine</w> features and strong jawline.",
                            "target_lang_translations": {
                                "ru": "Она восхищалась его <w>мужественными</w> чертами лица и сильной линией челюсти.",
                                "zh": "她很欣赏他那<w>阳刚</w>的五官和坚毅的下颌线。"
                            }
                        },
                        {
                            "text": "The living room was decorated with dark wood and leather to create a <w>masculine</w> style.",
                            "target_lang_translations": {
                                "ru": "Гостиная была отделана темным деревом и кожей, чтобы создать <w>мужской</w> стиль.",
                                "zh": "客厅用深色木材和皮革装饰，营造出一种<w>阳刚</w>的风格。"
                            }
                        }
                    ],
                    "synonyms": [
                        "manly",
                        "virile",
                        "macho"
                    ],
                    "antonyms": [
                        "effeminate",
                        "womanly",
                        "unmanly"
                    ],
                    "common_phrases": [
                        "masculine energy",
                        "masculine style",
                        "masculine features"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий качествами, внешностью или поведением, традиционно ассоциируемыми с мужчинами (сила, уверенность).",
                        "zh": "具有传统上与男性相关的特质、外貌或行为，如力量或果断。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "му́жественный",
                                "target_lang_sense_clarification": "обладающий положительными мужскими качествами (смелость, сила)"
                            },
                            {
                                "target_lang_word": "маскули́нный",
                                "target_lang_sense_clarification": "характерный для мужчины (часто о внешности или стиле)"
                            },
                            {
                                "target_lang_word": "мужско́й",
                                "target_lang_sense_clarification": "свойственный мужчине"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阳刚的",
                                "target_lang_sense_clarification": "形容具有男性气概的"
                            },
                            {
                                "target_lang_word": "有男子气概的",
                                "target_lang_sense_clarification": "形容行为或气质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40a49307-6347-367a-95fd-1b44a12d52e1",
                    "sense_definition": "Belonging to the grammatical gender that includes words referring to male beings in languages with gender distinctions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar_gender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In German, the word for student is a <w>masculine</w> noun.",
                            "target_lang_translations": {
                                "ru": "В немецком языке слово \"студент\" — это существительное <w>мужского</w> рода.",
                                "zh": "在德语中，“学生”这个词是一个<w>阳性</w>名词。"
                            }
                        },
                        {
                            "text": "You must use the <w>masculine</w> article when referring to a man in this language.",
                            "target_lang_translations": {
                                "ru": "В этом языке нужно использовать артикль <w>мужского</w> рода, когда речь идет о мужчине.",
                                "zh": "在这种语言中，指代男性时必须使用<w>阳性</w>冠词。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "masculine noun",
                        "masculine gender",
                        "masculine form"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к грамматическому роду, включающему слова, обозначающие существ мужского пола.",
                        "zh": "在有性别的语言中，属于包含指代男性生物的词汇的语法范畴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужско́й",
                                "target_lang_sense_clarification": "грамматический термин (мужской род)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阳性的",
                                "target_lang_sense_clarification": "语法术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c82b711-866a-3c8d-aba5-89299d1f63c0",
                    "sense_definition": "Ending on a stressed syllable, used to describe rhymes or endings in poetry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poem employs a <w>masculine</w> rhyme scheme throughout the first stanza.",
                            "target_lang_translations": {
                                "ru": "В первой строфе стихотворения используется <w>мужская</w> рифма.",
                                "zh": "这首诗的第一节通篇采用了<w>阳性</w>韵律。"
                            }
                        },
                        {
                            "text": "A <w>masculine</w> ending gives the line a strong and abrupt finish.",
                            "target_lang_translations": {
                                "ru": "<w>Мужское</w> окончание придает строке сильное и резкое завершение.",
                                "zh": "<w>阳性</w>结尾使诗行显得有力且干脆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "masculine rhyme",
                        "masculine ending"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заканчивающийся на ударный слог (о рифмах или окончаниях в поэзии).",
                        "zh": "指诗歌中以重读音节结尾的韵律或结尾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужско́й",
                                "target_lang_sense_clarification": "о рифме или клаузуле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阳性的",
                                "target_lang_sense_clarification": "指诗歌韵律"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1a44cfd-d669-3437-b221-e99fdc43c054",
                    "sense_definition": "The grammatical gender that typically includes words referring to males.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar_gender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many languages, the <w>masculine</w> is used as the default gender for mixed groups.",
                            "target_lang_translations": {
                                "ru": "Во многих языках <w>мужской род</w> используется как род по умолчанию для смешанных групп.",
                                "zh": "在许多语言中，<w>阳性</w>被用作混合群体的默认性别。"
                            }
                        },
                        {
                            "text": "Students often struggle to distinguish the feminine from the <w>masculine</w> in French.",
                            "target_lang_translations": {
                                "ru": "Студентам часто трудно отличить женский род от <w>мужского</w> во французском языке.",
                                "zh": "学生们在法语中往往难以区分阴性和<w>阳性</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the masculine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грамматический род, к которому обычно относятся слова, обозначающие мужчин.",
                        "zh": "通常包含指代男性词汇的语法性别。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужско́й род",
                                "target_lang_sense_clarification": "грамматическая категория"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阳性",
                                "target_lang_sense_clarification": "语法范畴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc6f7c22-bd41-35ab-976b-56284d25641b",
                    "sense_definition": "The quality or state of being masculine; that which is associated with men.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist's work explores the relationship between the <w>masculine</w> and the feminine.",
                            "target_lang_translations": {
                                "ru": "Работа художника исследует взаимоотношения между <w>мужским</w> и женским.",
                                "zh": "这位艺术家的作品探讨了<w>男性特质</w>与女性特质之间的关系。"
                            }
                        },
                        {
                            "text": "He wrote a philosophical essay on the nature of the <w>masculine</w> in modern society.",
                            "target_lang_translations": {
                                "ru": "Он написал философское эссе о природе <w>мужского</w> в современном обществе.",
                                "zh": "他写了一篇关于现代社会中<w>男性特质</w>本质的哲学论文。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние быть мужчиной; то, что ассоциируется с мужчинами.",
                        "zh": "作为男性的品质或状态；与男性相关的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужско́е",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            },
                            {
                                "target_lang_word": "мужско́е нача́ло",
                                "target_lang_sense_clarification": "философское понятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阳刚之气",
                                "target_lang_sense_clarification": "指男性特质"
                            },
                            {
                                "target_lang_word": "男性特质",
                                "target_lang_sense_clarification": "指代男性属性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90825486-8cb0-39ee-b0ba-448dc1e7d196",
                    "sense_definition": "A male person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old letter jokingly referred to the men of the house as the <w>masculines</w>.",
                            "target_lang_translations": {
                                "ru": "В старом письме мужчин в доме в шутку называли <w>мужчинами</w>.",
                                "zh": "那封旧信开玩笑地把家里的男人们称为“<w>男性</w>”。"
                            }
                        },
                        {
                            "text": "She wondered if any of the <w>masculines</w> would help with the cooking.",
                            "target_lang_translations": {
                                "ru": "Она гадала, поможет ли кто-нибудь из <w>мужчин</w> с готовкой.",
                                "zh": "她想知道是否有哪位<w>男性</w>愿意帮忙做饭。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often humorous or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо мужского пола.",
                        "zh": "男性个体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужчи́на",
                                "target_lang_sense_clarification": "человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "男性",
                                "target_lang_sense_clarification": "指人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}