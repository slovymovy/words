                                        "sense_id": "f078eae4-dd87-39bf-80a1-12bd8fa3e6e9",
                                        "entry_id": "2bdb2ecf-2d1e-30d4-a179-80df0744a563",
                                        "glosses": [
                                            "Feeling pain or sorrow on account of one's sins or offenses; feeling sincere guilt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97955446-bd96-4c27-bdad-de3ff0e7ec91",
                                                "sense_id": "f078eae4-dd87-39bf-80a1-12bd8fa3e6e9",
                                                "text": "Be penitent, and for thy fault contrite."
                                            },
                                            {
                                                "example_id": "f01633f8-60a1-4027-8172-dcfd17e5c617",
                                                "sense_id": "f078eae4-dd87-39bf-80a1-12bd8fa3e6e9",
                                                "text": "If thou be penitent and grieved, or desirous to be so, these heinous sins shall not be laid to thy charge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef75ab8-01af-31ef-8381-a37ed31ec1bc",
                                        "entry_id": "2bdb2ecf-2d1e-30d4-a179-80df0744a563",
                                        "glosses": [
                                            "Doing penance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a30da585-6c17-4053-b8d9-5a5339a77b52",
                                                "sense_id": "cef75ab8-01af-31ef-8381-a37ed31ec1bc",
                                                "text": "[…] But we that know what ’tis to faſt and pray, / Are penitent for your default to day."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "penitent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f415a2c4-ba48-33e8-b61b-17962206c8db",
                                        "entry_id": "31ca2fff-3f9d-3806-a0ec-57d494e5ca76",
                                        "glosses": [
                                            "One who repents of sin; one sorrowful on account of their transgressions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efa0c90b-149a-31e9-9d98-4da553cb6686",
                                        "entry_id": "31ca2fff-3f9d-3806-a0ec-57d494e5ca76",
                                        "glosses": [
                                            "One under church censure, but admitted to penance; one undergoing penance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b131d28-659c-4e96-a94f-346923daa2aa",
                                                "sense_id": "efa0c90b-149a-31e9-9d98-4da553cb6686",
                                                "text": "Wamba, who defeated the Saracens in an attempt upon Spain, was deprived of the crown, because he had been clothed in the habit of a penitent, while labouring under the influence of poison, administered by the ambitious Erviga!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fbf14ef-2a42-3cf2-90dc-fec8d6697a67",
                                        "entry_id": "31ca2fff-3f9d-3806-a0ec-57d494e5ca76",
                                        "glosses": [
                                            "One under the direction of a confessor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
