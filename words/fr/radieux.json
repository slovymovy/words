                {
                    "sense_id": "f1d0f24c-5e98-3ae3-a98b-00355ae46590",
                    "sense_definition": "Qui offre d'heureuses perspectives, qui est plein de promesses et d'espoir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les jeunes diplômés espèrent tous se construire un avenir <w>radieux</w> dans leur domaine.",
                            "target_lang_translations": {
                                "en": "All the young graduates hope to build a <w>bright</w> future in their field.",
                                "ru": "Молодые выпускники надеются построить <w>светлое</w> будущее в своей области.",
                                "de": "Die jungen Absolventen hoffen alle, sich in ihrem Fachgebiet eine <w>strahlende</w> Zukunft aufzubauen.",
                                "es": "Los jóvenes titulados esperan forjarse un futuro <w>brillante</w> en su campo.",
                                "zh": "这些年轻的毕业生都希望在自己的领域里打造一个<w>光明</w>的未来。"
                            }
                        },
                        {
                            "text": "Malgré les difficultés passagères, elle reste convaincue que des jours <w>radieux</w> viendront.",
                            "target_lang_translations": {
                                "en": "Despite the temporary difficulties, she remains convinced that <w>bright</w> days lie ahead.",
                                "ru": "Несмотря на временные трудности, она по-прежнему уверена, что впереди её ждут <w>светлые</w> дни.",
                                "de": "Trotz der vorübergehenden Schwierigkeiten bleibt sie überzeugt, dass <w>strahlende</w> Tage kommen werden.",
                                "es": "A pesar de las dificultades pasajeras, sigue convencida de que vendrán días <w>brillantes</w>.",
                                "zh": "尽管遇到了一些暂时的困难，她依然坚信<w>美好</w>的日子会到来。"
                            }
                        }
                    ],
