                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "65e3d604-dd3d-3d5b-a491-a4a9d8054acf",
                                        "entry_id": "0275f7ba-3d19-3246-8f80-db84bc5bee2e",
                                        "glosses": [
                                            "obilné zrno zbavené plev"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a84da405-73a6-44d9-9e91-e89ac97c7a01",
                                                "sense_id": "65e3d604-dd3d-3d5b-a491-a4a9d8054acf",
                                                "text": "A tak jí přinesli z komory všecko do kuchyňky, hrách a kroupy a jáhly a krupici a mouku, také trochu čočky a pak ještě jiskřičku másla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "122d87a1-082b-3955-b37e-eab47d6539d7",
                                        "entry_id": "0275f7ba-3d19-3246-8f80-db84bc5bee2e",
                                        "glosses": [
                                            "zmrzlý kousek ledu vzniklý kondenzací atmosférických srážek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad83cbe-6f21-409c-9fe3-beea270b9393",
                                                "sense_id": "122d87a1-082b-3955-b37e-eab47d6539d7",
                                                "text": "Už nad Zátavou a Kestřany počalo mračno sypat kroupy, ale řídce jen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6a73272-da68-45c7-9354-2c468560d983",
                        "source_entry_id": "3634ebe1-7d1f-38bf-88ff-af287e3658ff",
                        "source_sense_id": "ca3ab7e2-fc7d-3ba6-8bbc-5ff76b4a2b67",
                        "source_sense_description": "single ball of hail",
                        "target_lang_word": "hagelsteen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hagelsteen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c8705800-33dc-37af-b42e-8c3eedba5d72",
                                        "entry_id": "043cf7e3-809d-3f59-b500-6c9e9e1b5ae4",
                                        "glosses": [
                                            "een klontje ijs dat als neerslag uit de lucht komt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07fc33ae-f762-4627-a7ea-f40fafab71d1",
                                                "sense_id": "c8705800-33dc-37af-b42e-8c3eedba5d72",
                                                "text": "Eén hagelsteen is niet zo erg maar ik hoop niet dat het zo echt gaat hagelen!"
                                            },
                                            {
                                                "example_id": "7bb13bd4-f8a3-4ed3-861b-07d9c68458e9",
                                                "sense_id": "c8705800-33dc-37af-b42e-8c3eedba5d72",
                                                "text": "Vanwege zware regen- en onweersbuien geldt voor Noord-Brabant, Limburg en Gelderland code tot 16.00 uur oranje. Het KNMI zegt dat er hier kans is op zware windstoten tussen de 75 en 100 kilometer per uur en hagelstenen van twee centimeter."
                                            },
                                            {
                                                "example_id": "f677c2a2-3c1e-412a-82c3-e417985b61a9",
                                                "sense_id": "c8705800-33dc-37af-b42e-8c3eedba5d72",
                                                "text": "Het KNMI heeft voor morgenmiddag en -avond code oranje afgegeven voor het oosten en zuidoosten van het land. In Overijssel, Gelderland, Noord-Brabant en Limburg verwacht het weerinstituut in de middag zware onweersbuien. Daarbij is kans op zware windstoten van 75 tot 100 kilometer per uur en grote hagelstenen van 2 centimeter of groter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e73ad34-636a-45a9-9d74-93c67378f3eb",
                        "source_entry_id": "3634ebe1-7d1f-38bf-88ff-af287e3658ff",
                        "source_sense_id": "ca3ab7e2-fc7d-3ba6-8bbc-5ff76b4a2b67",
                        "source_sense_description": "single ball of hail",
                        "target_lang_word": "grêlon",
