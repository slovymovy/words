                        ],
                        "form": "die Wohnräume"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54032fc3-499c-3ab3-9aba-d8776815b703",
                        "entry_id": "e089a3fb-bd3f-39b3-8bbb-3bb3df3861a3",
                        "glosses": [
                            "ein Zimmer, welches zum Schlafen oder Wohnen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dc41e88-705e-4bee-9c33-3778c2a02ff4",
                                "sense_id": "54032fc3-499c-3ab3-9aba-d8776815b703",
                                "text": "Die Polizei durchsuchte nochmals die Wohnräume des Verdächtigen."
                            },
                            {
                                "example_id": "7e91e426-5f7b-4a81-900f-e0502217c7ca",
                                "sense_id": "54032fc3-499c-3ab3-9aba-d8776815b703",
                                "text": "„Meine Freude wurde allerdings bald getrübt, da die Suche nach bezahlbarem Wohnraum mich beinahe in den Wahnsinn trieb.“"
                            },
                            {
                                "example_id": "87c8c6fa-b243-45db-8381-98071694b480",
                                "sense_id": "54032fc3-499c-3ab3-9aba-d8776815b703",
                                "text": "„Der Wohnraum war rustikal eingerichtet.“"
                            },
                            {
                                "example_id": "62c31207-1254-4072-a421-f51e507c65c0",
                                "sense_id": "54032fc3-499c-3ab3-9aba-d8776815b703",
                                "text": "„Der H-förmig erbauten dreigeschossigen Villa mit Walmdächern schließt sich ein großer, geschlossener Wirtschaftshof mit Wohnräumen für Bedienstete, Küche, Werkstätten, Garagen und Ställen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da42ebde-1592-3a3a-8efa-df1791a65176",
                        "entry_id": "e089a3fb-bd3f-39b3-8bbb-3bb3df3861a3",
                        "glosses": [
                            "Sammelbegriff für alle Wohnungen und Wohnhäuser in einer gewissen Umgebung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56002702-607b-4cf7-ab7a-8d23cd898642",
                                "sense_id": "da42ebde-1592-3a3a-8efa-df1791a65176",
                                "text": "In Bayern suchen vermehrt Studenten nach günstigem Wohnraum."
                            },
                            {
                                "example_id": "5048e43a-ce26-434a-ab47-aee363d679e3",
                                "sense_id": "da42ebde-1592-3a3a-8efa-df1791a65176",
                                "text": "„Der Wiederaufbau und die Schaffung von neuem Wohnraum bestimmten die Entwicklung der Stadt bis in die 1960er Jahre hinein.“"
                            },
                            {
                                "example_id": "086d1697-c032-4ef7-a473-c5ec8bb2692a",
                                "sense_id": "da42ebde-1592-3a3a-8efa-df1791a65176",
                                "text": "„Doch das Ballungsgebiet hat auch Nachteile: Bezahlbarer Wohnraum wird knapp.“"
                            },
                            {
                                "example_id": "a40062f5-cb93-490c-b909-65660e0ca951",
                                "sense_id": "da42ebde-1592-3a3a-8efa-df1791a65176",
