                                "target_senses": [
                                    {
                                        "sense_id": "193e2d38-03e8-3926-b8ad-eebce943cdbd",
                                        "entry_id": "a81c87a2-612d-38ba-8046-9e83c1be018e",
                                        "glosses": [
                                            "A niche in a mosque that indicates the qibla (direction of Mecca), and into which the imam prays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a244ad1c-510a-448e-a8dc-b0b0c01f5483",
                                                "sense_id": "193e2d38-03e8-3926-b8ad-eebce943cdbd",
                                                "text": "Certainly there are nagging undertones of regret to the greatest of the Islamic monuments of Spain, the Great Mosque of Córdoba, for now that its mihrab has been demoted to be a mere curiosity, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e5c6ba0-83fe-38f0-808f-408ea8154e27",
                                        "entry_id": "a81c87a2-612d-38ba-8046-9e83c1be018e",
                                        "glosses": [
                                            "A design in a Muslim prayer mat with the same function."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ca1eddb-d8dd-46f9-af25-8619ba01cebf",
                        "source_entry_id": "a9a448f4-fae0-3f19-83d4-207d3327022b",
                        "source_sense_id": "69143729-1067-3578-8ab4-4e7b22b681b6",
