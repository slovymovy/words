                        "glosses": [
                            "In a manner affecting, relating or pertaining to the spirit or the soul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d88930-6216-4190-959c-ab0e2ee733e3",
                                "sense_id": "b3e0990b-5fe0-32be-82de-216d25788f75",
                                "text": "physically and spiritually abused"
                            },
                            {
                                "example_id": "f819c3d4-c3b7-4407-86d6-606a7b8d08a5",
                                "sense_id": "b3e0990b-5fe0-32be-82de-216d25788f75",
                                "text": "spiritually sanctified"
                            },
                            {
                                "example_id": "3ca938d8-dd62-4101-b22d-8ecd66b7e2fe",
                                "sense_id": "b3e0990b-5fe0-32be-82de-216d25788f75",
                                "text": "Corporeally, he stood between Robert and Millie, a parent of dark menace. Spiritually, he was as effective as a scarecrow in a black coat."
                            },
                            {
                                "example_id": "8fdac8ec-dd46-42e0-929b-b0854dd9c2ae",
                                "sense_id": "b3e0990b-5fe0-32be-82de-216d25788f75",
                                "text": "Whatever we desire, we can find a person who has already attained what we want to attain spiritually, relationshipwise, careerwise, and materially."
                            }
                        ]
                    }
                ],
