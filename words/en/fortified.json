{
    "word_family": [
        "fort",
        "fortification",
        "fortify",
        "fortress"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c182d778-8922-3047-9725-c7e0ef374072",
                    "sense_definition": "simple past and past participle of <w>fortify</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers <w>fortified</w> the castle walls before the enemy attacked.",
                            "target_lang_translations": {
                                "ru": "Солдаты <w>укрепили</w> стены замка до того, как враг атаковал."
                            }
                        },
                        {
                            "text": "They had <w>fortified</w> the perimeter with barbed wire and deep trenches.",
                            "target_lang_translations": {
                                "ru": "Они <w>укрепили</w> периметр колючей проволокой и глубокими траншеями."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "прошедшее время и причастие прошедшего времени глагола fortify (укреплять, обогащать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрепил",
                                "target_lang_sense_clarification": "оборону, позиции"
                            },
                            {
                                "target_lang_word": "укрепленный",
                                "target_lang_sense_clarification": "причастие от fortify"
                            },
                            {
                                "target_lang_word": "обогащенный",
                                "target_lang_sense_clarification": "о продуктах, витаминами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "91a32aa7-090e-3252-8dc3-35e0aa206460",
                    "sense_definition": "Protected or strengthened against attack with defensive structures or reinforcements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The border was heavily guarded and protected by a <w>fortified</w> wall.",
                            "target_lang_translations": {
                                "ru": "Граница усиленно охранялась и была защищена <w>укрепленной</w> стеной."
                            }
                        },
                        {
                            "text": "The army retreated behind the secure walls of the <w>fortified</w> city.",
                            "target_lang_translations": {
                                "ru": "Армия отступила за надежные стены <w>укрепленного</w> города."
                            }
                        }
                    ],
                    "synonyms": [
                        "castellated"
                    ],
                    "common_phrases": [
                        "fortified position",
                        "fortified city",
                        "heavily fortified"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищенный или усиленный оборонительными сооружениями от нападения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрепленный",
                                "target_lang_sense_clarification": "оборонительными сооружениями"
                            },
                            {
                                "target_lang_word": "фортифицированный",
                                "target_lang_sense_clarification": "специальный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef91dd48-c057-368f-ad07-137b7a779795",
                    "sense_definition": "Enriched by the addition of nutrients, such as vitamins or minerals, to increase nutritional value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nutrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children often drink <w>fortified</w> milk to ensure they get enough vitamin D.",
                            "target_lang_translations": {
                                "ru": "Дети часто пьют <w>обогащенное</w> молоко, чтобы получать достаточно витамина D."
                            }
                        },
                        {
                            "text": "Many breakfast cereals are <w>fortified</w> with extra iron and essential vitamins.",
                            "target_lang_translations": {
                                "ru": "Многие сухие завтраки <w>обогащены</w> дополнительным железом и необходимыми витаминами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fortified wine",
                        "fortified foods",
                        "fortified cereal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обогащенный витаминами, минералами или другими питательными веществами, либо крепленый (об алкоголе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обогащенный",
                                "target_lang_sense_clarification": "витаминами или минералами"
                            },
                            {
                                "target_lang_word": "витаминизированный",
                                "target_lang_sense_clarification": "о еде или напитках"
                            },
                            {
                                "target_lang_word": "крепленый",
                                "target_lang_sense_clarification": "о вине"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c804b1d-154d-34af-8747-c9c5a8f7c727",
                    "sense_definition": "A fortified wine, such as port or sherry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nutrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After dinner, the host served a rich Spanish <w>fortified</w> alongside the dessert.",
                            "target_lang_translations": {
                                "ru": "После ужина хозяин подал к десерту насыщенное испанское <w>крепленое вино</w>."
                            }
                        },
                        {
                            "text": "Sales of table wines increased while older styles like <w>fortifieds</w> declined.",
                            "target_lang_translations": {
                                "ru": "Продажи столовых вин выросли, в то время как спрос на классические напитки, такие как <w>крепленые вина</w>, снизился."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепленое вино (например, портвейн или херес)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепленое вино",
                                "target_lang_sense_clarification": "портвейн, херес и т. д."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}