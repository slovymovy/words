                    {
                        "sense_id": "c9c05b88-73aa-33c0-bb9b-e62d95ab6463",
                        "entry_id": "f65ece5a-a407-307f-97b5-be73956ec85f",
                        "glosses": [
                            "dat wat in een (rang)ordening met 35 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e719dc0a-41e5-4aab-bb0c-8ecc49dec4f8",
                                "sense_id": "c9c05b88-73aa-33c0-bb9b-e62d95ab6463",
                                "text": "Het is weer de vijfendertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "83351d74-aa84-41c4-bfa5-ed951e949bcb",
                                "sense_id": "c9c05b88-73aa-33c0-bb9b-e62d95ab6463",
                                "text": "Haar zesendertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de vijfendertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccceb57d-5a8e-30ca-ad40-af948565ab83",
                        "entry_id": "f65ece5a-a407-307f-97b5-be73956ec85f",
                        "glosses": [
                            "groep van 35 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76886a14-a202-4954-8cf4-b394fa5b427e",
                                "sense_id": "ccceb57d-5a8e-30ca-ad40-af948565ab83",
                                "text": "De vijfendertig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
