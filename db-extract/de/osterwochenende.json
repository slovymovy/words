                "senses": [
                    {
                        "sense_id": "28965432-d0c4-3293-b962-e4bbd6254305",
                        "entry_id": "c9d34fe5-74eb-30d7-ab6b-be3b7c91ed08",
                        "glosses": [
                            "der Zeitraum vom Karfreitag bis zum Ostermontag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee758cab-fc50-45e0-b655-d4b60a8cd815",
                                "sense_id": "28965432-d0c4-3293-b962-e4bbd6254305",
                                "text": "„Am Osterwochenende und wahrscheinlich auch die gesamte nächste Woche ändert sich an der Großwetterlage nicht viel.“"
                            },
                            {
                                "example_id": "7d69f214-01da-4ea1-b52c-5d9f1a4c25cb",
                                "sense_id": "28965432-d0c4-3293-b962-e4bbd6254305",
                                "text": "„Präsident Donald Trump hat am Mittwoch bestätigt, dass er den Direktor der CIA, Mike Pompeo, über das Osterwochenende nach Pjongjang entsandte, wo Pompeo mit dem nordkoreanischen Diktator Kim Jong Un zusammentraf.“"
                            },
                            {
                                "example_id": "ab2e6527-f244-437c-8d14-a99f14a82151",
                                "sense_id": "28965432-d0c4-3293-b962-e4bbd6254305",
                                "text": "„Bei zahlreichen Bränden in Bayern ist am Osterwochenende teils hoher Sachschaden entstanden.“"
                            },
                            {
                                "example_id": "87416a44-17cc-4b6d-91cc-7a358af57a02",
                                "sense_id": "28965432-d0c4-3293-b962-e4bbd6254305",
                                "text": "„Dieses Osterwochenende entwickelte sich anders als erwartet, so viel stand fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
