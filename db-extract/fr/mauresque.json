                        "entry_id": "7129f91f-f9e8-3542-91f4-6a7dada5e1f9",
                        "glosses": [
                            "Nom qui était donné aux habitants de l’Afrique du Nord."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5c8c0adf-26ba-4e0d-9430-2c84bb4867e1",
                                "sense_id": "08cc9fd4-6136-3255-9e7e-557aba5fd4af",
                                "text": "Quand il m’a dit le nom de la femme, j’ai vu que c’était une Mauresque."
                            },
                            {
                                "example_id": "4f98ff12-92ef-4ff2-ba2f-35b34535c44d",
                                "sense_id": "08cc9fd4-6136-3255-9e7e-557aba5fd4af",
                                "text": "Yasmina savait même que son sort serait un peu meilleur que celui des autres femmes de sa tribu, puisqu’elle habiterait la ville et qu’elle n’aurait, comme les Mauresques, que son ménage à soigner et ses enfants à élever."
                            }
                        ]
                    }
                ],
