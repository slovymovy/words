                    {
                        "sense_id": "612f023f-e7d4-3e4d-b920-eb228f8bc88f",
                        "entry_id": "b3ab8de5-49f5-32c2-85e1-dc538a45e474",
                        "glosses": [
                            "Méduse des mers froides de très grande taille et de couleur bleue, appartenant à la famille des Cyaneidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "462d3f81-1aac-4f73-8bd5-beddd320bc70",
                                "sense_id": "612f023f-e7d4-3e4d-b920-eb228f8bc88f",
                                "text": "La Cyanée bleue se rencontre généralement entre la surface et 8 mètres de profondeur en Mer du Nord au sud de la Norvège, en Atlantique, du sud de l’Islande jusqu’au Golfe de Gascogne."
                            },
                            {
                                "example_id": "c582bab8-2545-4089-851b-4490f5d8a3a8",
                                "sense_id": "612f023f-e7d4-3e4d-b920-eb228f8bc88f",
                                "text": "La cyanée bleue ou méduse chevelue (Cyanea lamarckii) apparaît dès le mois de mars et est présente jusqu’en août."
                            },
                            {
                                "example_id": "a2172be9-8d38-455a-985d-16577d2816db",
                                "sense_id": "612f023f-e7d4-3e4d-b920-eb228f8bc88f",
                                "text": "La cyanée capillaire est carnivore. Les proies, poissons et crustacés principalement, mais aussi cténophores et autres méduses, sont récupérées par les tentacules, garnis de millions de cnidocytes très urticants."
                            }
                        ]
                    }
