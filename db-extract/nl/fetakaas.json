                ],
                "senses": [
                    {
                        "sense_id": "b9fcc338-fd29-3fd2-ad22-7cd90578a2fc",
                        "entry_id": "a9151eb0-60de-373a-ab73-20142369b0a4",
                        "glosses": [
                            "een Griekse ongerijpte schapenkaas die behoort tot een familie van witte kazen waartoe ook bijvoorbeeld beyaz peynir (Turkije), sirene (Bulgarije) en telemea (Roemenië) behoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb0b7fa1-1851-46af-a1dd-aa51887bc697",
                                "sense_id": "b9fcc338-fd29-3fd2-ad22-7cd90578a2fc",
                                "text": "Na de verwoestende bosbranden van afgelopen maand maakt de Griekse regering zich zorgen om de kwaliteit van de wereldberoemde fetakaas."
                            },
                            {
                                "example_id": "4014e659-77cf-4cfd-a137-fabe7dc58966",
                                "sense_id": "b9fcc338-fd29-3fd2-ad22-7cd90578a2fc",
                                "text": "Dat de kaaskwestie Brussel aan het hart gaat, werd al duidelijk bij de sluiting van recente handelsovereenkomsten met Canada en Centraal-Amerika. Alleen kazen uit Europa mogen daar de oorspronkelijke naam dragen. In Canada vervaardigde fetakaas mag bijvoorbeeld alleen als ”feta-achtig” worden omschreven, en op de verpakking mogen geen Griekse letters of verwijzingen naar Griekenland staan."
                            }
                        ]
                    }
