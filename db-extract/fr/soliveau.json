                                    {
                                        "sense_id": "802aa17e-de8d-31c9-bfe1-813b26cb699e",
                                        "entry_id": "6f763281-91fb-3b5f-8f89-dc61864e05f1",
                                        "glosses": [
                                            "tekortkomend in kracht of vaardigheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03dc30ab-6153-4baf-8985-a7e199afb7ce",
                                                "sense_id": "802aa17e-de8d-31c9-bfe1-813b26cb699e",
                                                "text": "' Ik voel een hand op mijn rug, die ik zwak wegduw."
                                            },
                                            {
                                                "example_id": "79271eef-67db-471b-ba93-6a7e92909f12",
                                                "sense_id": "802aa17e-de8d-31c9-bfe1-813b26cb699e",
                                                "text": "Hij droeg een groene bandana in zijn lange haar en had als een van de weinigen hoge leren bergschoenen om zijn zwakke enkels te beschermen."
                                            },
                                            {
                                                "example_id": "4de83b17-814e-4cfc-94ce-169d5e4aaa78",
                                                "sense_id": "802aa17e-de8d-31c9-bfe1-813b26cb699e",
                                                "text": "' Het was een zwak protest, en haar woorden waren voldoende voor me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c69db2-2b17-3b1a-8c87-5aacaa5165b3",
                                        "entry_id": "6f763281-91fb-3b5f-8f89-dc61864e05f1",
                                        "glosses": [
                                            "een verleden tijd vormend met een dentaal achtervoegsel"
                                        ],
                                        "tags": [
                                            "Germaanse werkwoorden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad6b1277-028a-4c54-83cc-a9eb3b3b892d",
                                                "sense_id": "57c69db2-2b17-3b1a-8c87-5aacaa5165b3",
                                                "text": "Reizen-reisde-gereisd is een zwak werkwoord, rijzen-rees-gerezen een sterk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd122018-64fd-37ba-bf0d-eebd4d288d83",
                                        "entry_id": "6f763281-91fb-3b5f-8f89-dc61864e05f1",
                                        "glosses": [
                                            "een stelsel buigingsuitgangen vertonend die op -n gebaseerd zijn"
                                        ],
                                        "tags": [
                                            "Germaanse naamwoorden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32c048e2-0e5f-4f70-af07-6840ad792ae3",
                                                "sense_id": "cd122018-64fd-37ba-bf0d-eebd4d288d83",
                                                "text": "Des hertogen is een zwakke genitief, des konings een sterke."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zwak",
