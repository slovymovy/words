                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e7bd1d2-2fea-4385-8607-60e2a95b0b12",
                                "sense_id": "68544cbe-fa12-30e9-bb01-a75330b54da3",
                                "text": "„Sie war eine der ersten Frauen, die in Afghanistan als Militärpilotinnen dienten.“"
                            },
                            {
                                "example_id": "39c4d205-c24d-4d71-a777-8135128cbc9d",
                                "sense_id": "68544cbe-fa12-30e9-bb01-a75330b54da3",
                                "text": "„In Russland beginnt heute der Prozess gegen die Militärpilotin Nadeschda Sawtschenko.“"
                            },
                            {
                                "example_id": "f413079c-75fa-402e-a2ec-dee667182f9a",
                                "sense_id": "68544cbe-fa12-30e9-bb01-a75330b54da3",
                                "text": "„In einem umstrittenen Prozess in Russland hat der Richter die ukrainische Militärpilotin Nadeschda Sawtschenko als schuldig bezeichnet - ohne jedoch ein formales Urteil zu sprechen.“"
                            }
                        ],
