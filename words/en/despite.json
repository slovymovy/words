{
    "word_family": [
        "spite",
        "despise",
        "spiteful",
        "despiteful"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "56e3ef00-75d5-36f2-a5da-4fe21db69a3b",
                    "sense_definition": "In spite of; without being affected by something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went for a walk <w>despite</w> the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Мы пошли гулять <w>несмотря на</w> сильный дождь.",
                                "tr": "Şiddetli yağmura <w>rağmen</w> yürüyüşe çıktık."
                            }
                        },
                        {
                            "text": "<w>Despite</w> the fact that he was tired, he finished his homework.",
                            "target_lang_translations": {
                                "ru": "<w>Несмотря на</w> то, что он устал, он закончил домашнюю работу.",
                                "tr": "Yorgun olmasına <w>rağmen</w> ödevini bitirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "in spite of",
                        "regardless of",
                        "notwithstanding",
                        "for all",
                        "irrespective of",
                        "even with"
                    ],
                    "antonyms": [
                        "because of"
                    ],
                    "common_phrases": [
                        "despite the fact",
                        "despite the weather",
                        "despite everything",
                        "despite all efforts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несмотря на что-либо; вопреки обстоятельствам.",
                        "tr": "Bir şeye rağmen; bir durumdan etkilenmeyerek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несмотря́ на",
                                "target_lang_sense_clarification": "самый распространенный, нейтральный вариант"
                            },
                            {
                                "target_lang_word": "вопреки́",
                                "target_lang_sense_clarification": "наперекор, против чего-либо"
                            },
                            {
                                "target_lang_word": "невзира́я на",
                                "target_lang_sense_clarification": "не обращая внимания (более формально)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "rağmen",
                                "target_lang_sense_clarification": "en yaygın ve nötr kullanım (-e rağmen)"
                            },
                            {
                                "target_lang_word": "karşın",
                                "target_lang_sense_clarification": "daha resmi veya edebi kullanım (-e karşın)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed82da9f-e949-3739-91b1-cbe142e66fae",
                    "sense_definition": "Contemptuous feelings, disdain, or hatred.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king looked upon the traitor with <w>despite</w>.",
                            "target_lang_translations": {
                                "ru": "Король смотрел на предателя с <w>презрением</w>.",
                                "tr": "Kral, haine <w>hor görerek</w> baktı."
                            }
                        },
                        {
                            "text": "He spoke with <w>despite</w> regarding his enemies.",
                            "target_lang_translations": {
                                "ru": "Он говорил со <w>злобой</w> о своих врагах.",
                                "tr": "Düşmanları hakkında <w>kinle</w> konuştu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern English uses 'spite' or 'disdain' instead"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Презрение, злоба или ненависть (устаревшее).",
                        "tr": "Aşağılama, hor görme veya nefret duygusu (eskimiş)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презрение",
                                "target_lang_sense_clarification": "устар.: пренебрежение, злоба, ненависть"
                            },
                            {
                                "target_lang_word": "злоба"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hor görme",
                                "target_lang_sense_clarification": "eskimiş: aşağılama, kin"
                            },
                            {
                                "target_lang_word": "kin",
                                "target_lang_sense_clarification": "eskimiş: nefret, garez"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "409b3b01-f035-346c-823b-42e2f066d904",
                    "sense_definition": "To vex, annoy, or offend contemptuously.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight sought to <w>despite</w> his rival with insults.",
                            "target_lang_translations": {
                                "ru": "Рыцарь стремился <w>унизить</w> своего соперника оскорблениями.",
                                "tr": "Şövalye, hakaretlerle rakibini <w>aşağılamaya</w> çalıştı."
                            }
                        },
                        {
                            "text": "It did <w>despite</w> him to see such injustice in the land.",
                            "target_lang_translations": {
                                "ru": "Его <w>возмущало</w> видеть такую несправедливость в стране.",
                                "tr": "Ülkede böyle bir adaletsizlik görmek onu <w>kızdırdı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражать, досаждать или оскорблять (устаревшее).",
                        "tr": "Aşağılayarak kızdırmak, rahatsız etmek veya gücendirmek (eskimiş)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорблять",
                                "target_lang_sense_clarification": "устар.: презрительно досаждать, оскорблять"
                            },
                            {
                                "target_lang_word": "досаждать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aşağılamak",
                                "target_lang_sense_clarification": "eskimiş: hor görmek, incitmek"
                            },
                            {
                                "target_lang_word": "kızdırmak",
                                "target_lang_sense_clarification": "eskimiş: rahatsız etmek, gücendirmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
