                                "text": "Z żwawej staruszki zmieniła się w bezsilne truchło, na łasce opieki społecznej"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "d63e1293-e5e2-3fd1-8a1a-8820d621325f",
                        "entry_id": "5f597fbe-3510-3e80-8c96-0a4cb34431df",
                        "glosses": [
                            "smutek, przygnębienie, strapienie"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c19fd79-7cc0-421d-829a-77797940251d",
                        "source_entry_id": "5f597fbe-3510-3e80-8c96-0a4cb34431df",
                        "source_sense_id": "26e75ef9-1721-3611-8488-77d7222f720c",
                        "target_lang_word": "Kadaver",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kadaver",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                        "entry_id": "8920a24b-1d94-3a6a-97b5-9e2c3f6c64bf",
                                        "glosses": [
                                            "toter, in Verwesung begriffener Tierkörper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b8adbd-8f31-4eae-82b3-44aa11e384dc",
                                                "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                                "text": "Die Tierkörperverwertung nimmt alle Kadaver entgegen."
                                            },
                                            {
                                                "example_id": "e9d6e75d-5432-437c-8a87-2ba50bc2dbd2",
                                                "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                                "text": "„Eins, zwei, drei, ist dem Tier die Haut über den Kopf gezogen, und ein anderes Pferd mit einer Karre kommt, um den Kadaver wegzuziehen.“"
                                            },
                                            {
                                                "example_id": "5a1dc9fd-9b93-41f0-b958-9fa057e8a72f",
                                                "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                                "text": "„Aufgerissene Mäuler, erschreckte Augen, zerissenes Gedärm, Fliegenschwärme hatten sich auf den Kadavern niedergelassen.“"
                                            },
                                            {
                                                "example_id": "5df7339e-e701-4d3b-8922-10cde9aa52b9",
                                                "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                                "text": "„Einige Monate später, der Kriminalfall Piontek ruht als vorläufig ungelöst in den Akten, zeigt ein Forstarbeiter bei der Polizei an, dass sein Labrador in einem Waldgebiet, das nach Feststellung der Polizei weiter entfernt von Pionteks Jagdgründen liegt, den offensichtlich nicht tief genug vergrabenen Kadaver eines mittelgroßen Hundes aufgespürt habe.“"
                                            },
                                            {
                                                "example_id": "4816e7f6-0c57-4e33-89c2-247ecee8d00f",
                                                "sense_id": "c1d91108-43a5-316e-bec5-4ec47cd598fd",
                                                "text": "„Alsdann nahmen sie ihn zwischen sich und trugen ihn hinaus und schmissen ihn wie einen Kadaver auf die Straße .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65b522cb-a58d-36fa-83b4-3f6e3d0089bc",
                                        "entry_id": "8920a24b-1d94-3a6a-97b5-9e2c3f6c64bf",
                                        "glosses": [
                                            "schwacher, kraftloser Körper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1d9bdae-7489-4376-8408-086c455a1fcc",
                                                "sense_id": "65b522cb-a58d-36fa-83b4-3f6e3d0089bc",
                                                "text": "Beweg doch deinen Kadaver ein bisschen mehr!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
