                                "sense_id": "76ec8c4b-6d20-3930-9839-1b6ec1fb4aec",
                                "text": "Zult gij den Leviathan met den angel trekken, of zijn tong met een koord, dat gij laat nederzinken?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
