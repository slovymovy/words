                ],
                "senses": [
                    {
                        "sense_id": "edb4ccc2-32fe-3ab3-ad0c-5d271e13c1a1",
                        "entry_id": "573a33ff-c3b1-3689-b813-537832e0b31c",
                        "glosses": [
                            "Pris par une étreinte vigoureuse ou subite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488da07f-4353-4260-a516-790355cafe46",
                                "sense_id": "edb4ccc2-32fe-3ab3-ad0c-5d271e13c1a1",
                                "text": "Le voleur saisi au moment où il s'échappait."
                            }
                        ]
                    },
                    {
                        "sense_id": "081f23e2-9c6a-3b09-882f-11c96738b0d8",
                        "entry_id": "573a33ff-c3b1-3689-b813-537832e0b31c",
                        "glosses": [
                            "Retenu par acte de saisie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43c0ace0-fab9-4089-84e8-b39ad9a0bdeb",
                                "sense_id": "081f23e2-9c6a-3b09-882f-11c96738b0d8",
                                "text": "Ses meubles sont saisis."
                            },
                            {
                                "example_id": "939b59b2-e4f4-44f5-98e1-507613ecce24",
                                "sense_id": "081f23e2-9c6a-3b09-882f-11c96738b0d8",
                                "text": "La partie saisie."
                            },
                            {
                                "example_id": "bf762fe1-7b4f-4bf8-b7ab-1cda20283a25",
                                "sense_id": "081f23e2-9c6a-3b09-882f-11c96738b0d8",
                                "text": "Tiers saisi."
                            }
                        ]
                    },
                    {
                        "sense_id": "d633c613-d06f-3ddd-9f4f-6c43169f0a67",
                        "entry_id": "573a33ff-c3b1-3689-b813-537832e0b31c",
                        "glosses": [
                            "Muni, nanti."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "107bf316-47fd-4624-9890-1e03ad99dcaa",
                                "sense_id": "d633c613-d06f-3ddd-9f4f-6c43169f0a67",
                                "text": "Le greffe tient bon\nQuand une fois il est saisi des choses."
                            }
                        ]
                    },
                    {
                        "sense_id": "80d61829-6754-3ba2-98fe-fe03a64756f2",
                        "entry_id": "573a33ff-c3b1-3689-b813-537832e0b31c",
                        "glosses": [
                            "Saisi d'une affaire, qui a à décider cette affaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d96f69da-072f-4a94-bf9d-c767c8737535",
                                "sense_id": "80d61829-6754-3ba2-98fe-fe03a64756f2",
                                "text": "Lorsque les saints entraient en séance à Westminster, ils récitaient des prières, cherchaient le Seigneur des journées entières, et expliquaient l'Écriture : cela fait, ils s'occupaient des affaires dont ils se croyaient saisis."
                            }
                        ]
                    },
                    {
                        "sense_id": "e32bbaa7-32ee-329b-8bf6-a9409ce63752",
                        "entry_id": "573a33ff-c3b1-3689-b813-537832e0b31c",
                        "glosses": [
                            "Qui s’est emparé de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3581ecc3-8d01-481b-a20b-666e3af5fabe",
                                "sense_id": "e32bbaa7-32ee-329b-8bf6-a9409ce63752",
                                "text": "Des portes du palais saisi pour ce perfide,\nEn fait votre prison, et lui répond de vous."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7531992-7c78-3289-8f9c-c0605d872178",
                        "entry_id": "573a33ff-c3b1-3689-b813-537832e0b31c",
                        "glosses": [
                            "Qui est captivé, dominé par quelque chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "81e58a70-0089-3c3c-9fc8-fd5550bb24e1",
                        "entry_id": "573a33ff-c3b1-3689-b813-537832e0b31c",
                        "glosses": [
                            "Frappé subitement d'une vive émotion."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "af7c4c1e-1ddf-3a8a-86f7-b4bbe8eaefd1",
                        "entry_id": "573a33ff-c3b1-3689-b813-537832e0b31c",
                        "glosses": [
                            "Qui a été exposé à un grand feu et qui est grillé extérieurement et rose encore intérieurement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7956cf0-7fee-47c8-a31b-3caa75417123",
                                "sense_id": "af7c4c1e-1ddf-3a8a-86f7-b4bbe8eaefd1",
                                "text": "Une viande bien saisie."
                            }
                        ]
                    },
                    {
                        "sense_id": "90779c8a-717d-3b68-b117-f3ca7817a1f1",
                        "entry_id": "573a33ff-c3b1-3689-b813-537832e0b31c",
                        "glosses": [
                            "Qui est surpris, étonné."
                        ],
                        "tags": [
                            "Haïti"
                        ],
                        "examples": [
                            {
                                "example_id": "30a1983f-cc3d-4c04-b98b-8d3ca3392daf",
                                "sense_id": "90779c8a-717d-3b68-b117-f3ca7817a1f1",
                                "text": "Je suis vraiment saisie de te voir. Où étais-tu passée ?"
                            }
                        ]
                    }
                ],
