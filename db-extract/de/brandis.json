                ],
                "senses": [
                    {
                        "sense_id": "b4e3960a-450d-3231-bf5d-08efd635eeef",
                        "entry_id": "2aa0504e-68b2-3b7a-9816-5922cc5571ab",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac4973d2-ce92-4c20-821d-f31000f2337c",
                                "sense_id": "b4e3960a-450d-3231-bf5d-08efd635eeef",
                                "text": "Frau Brandis ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b44e0d42-2239-463f-ab71-ea26c6a2d4bb",
                                "sense_id": "b4e3960a-450d-3231-bf5d-08efd635eeef",
                                "text": "Herr Brandis wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "05e8a6ad-065f-459f-9aae-70f25b29e2fb",
                                "sense_id": "b4e3960a-450d-3231-bf5d-08efd635eeef",
                                "text": "Die Brandisens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "db222909-01b8-467e-9d86-8159a7048b30",
                                "sense_id": "b4e3960a-450d-3231-bf5d-08efd635eeef",
                                "text": "Der Brandis trägt nie die Schals, die die Brandis ihm strickt."
                            },
                            {
                                "example_id": "a2fc8269-6d23-4646-9a95-f019b8c427aa",
                                "sense_id": "b4e3960a-450d-3231-bf5d-08efd635eeef",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brandis kommt, geht der Herr Brandis.“"
                            },
                            {
                                "example_id": "f183366b-4e05-400b-ba9c-a673d366b487",
                                "sense_id": "b4e3960a-450d-3231-bf5d-08efd635eeef",
                                "text": "Brandis kommt und geht."
                            },
                            {
                                "example_id": "8fce4b27-8b91-441c-82f6-bd271b55bfab",
                                "sense_id": "b4e3960a-450d-3231-bf5d-08efd635eeef",
                                "text": "Brandis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
