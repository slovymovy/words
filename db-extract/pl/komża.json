                                        ]
                                    },
                                    {
                                        "sense_id": "ce996853-d604-316f-a31a-3bcd0d293106",
                                        "entry_id": "56983af3-629f-3e0a-b58c-1b2a69b04afe",
                                        "glosses": [
                                            "Bobine sur laquelle on dévide la soie, le fil d'or, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59657009-7acd-43e7-b304-d97edb0ddbe4",
                                                "sense_id": "ce996853-d604-316f-a31a-3bcd0d293106",
                                                "text": "Ne pourront les maîtres teinturiers défaire ni diviser les pantines de soies crues ou teintes.... mais les rendront en la forme qu'ils les auront reçues.... même les rochets et bobines sur lesquelles elles seront dévidées, lesquels rochets seront à cet effet marqués par le maître auquel les dites soies appartiendront."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc825499-19ce-3235-b463-7a239ae3fd29",
                                        "entry_id": "56983af3-629f-3e0a-b58c-1b2a69b04afe",
                                        "glosses": [
                                            "Dans le domaine de la fatigue des matériaux, désigne une sollicitation telle que la déformation plastique augmente à chaque cycle (fatigue oligocyclique)."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f19d179-f3cf-4686-82b3-e6a18f526978",
                                                "sense_id": "cc825499-19ce-3235-b463-7a239ae3fd29",
                                                "text": "Les comportements asymptotiques des structures élasto-visco-plastiques soumises à des chargements mécaniques cycliques sont : élasticité, adaptation, accommodation et rochet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
