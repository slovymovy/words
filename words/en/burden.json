                            "comment": "used in medical and scientific contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее количество определённого вредного вещества, организма или заболевания в системе или организме.",
                        "zh": "系统或人体内某种特定有害物质、微生物或疾病的总量，常用于医学和科学语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагрузка",
                                "target_lang_sense_clarification": "концентрация"
                            },
                            {
                                "target_lang_word": "содержание",
                                "target_lang_sense_clarification": "количество вещества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "负荷",
                                "target_lang_sense_clarification": "医学、科学语境中指体内某种有害因素的总量"
                            },
                            {
                                "target_lang_word": "载量",
                                "target_lang_sense_clarification": "多用于病毒等可测量对象"
                            },
                            {
                                "target_lang_word": "疾病负担",
                                "target_lang_sense_clarification": "侧重疾病对个体或群体造成的总影响时使用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dc53214-348b-3ca3-88ec-0900023f9a73",
                    "sense_definition": "A recurring phrase, line, or theme at the end of each verse in a song or poem.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "musical_refrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir sang the <w>burden</w> of the hymn with great enthusiasm.",
                            "target_lang_translations": {
                                "ru": "Хор с большим энтузиазмом пел <w>припев</w> гимна.",
                                "zh": "合唱团满怀热情地唱起了这首圣歌的<w>副歌</w>。"
                            }
                        },
