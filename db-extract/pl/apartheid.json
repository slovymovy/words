                                "target_senses": [
                                    {
                                        "sense_id": "3cba0aca-d25d-3e93-8ba9-3c3ac9309e0d",
                                        "entry_id": "9e5e84a3-afae-3a30-9365-ab03266a1fbc",
                                        "glosses": [
                                            "zřízení, ve kterém jsou lidé různých ras nuceni žít odděleně"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "872aa619-2c63-4b67-a58d-bc286acbedb3",
                                                "sense_id": "3cba0aca-d25d-3e93-8ba9-3c3ac9309e0d",
                                                "text": "V roce 1994 byl apartheid v Jihoafrické republice zrušen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1b729ed-3721-4dad-805d-13fd18148229",
                        "source_entry_id": "a1d588ca-c773-3258-9f52-b50a2e2266c6",
                        "source_sense_id": "b4b0b30c-201e-30e6-8150-036239a2725f",
                        "target_lang_word": "apartheid",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apartheid",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf0a571-d13a-32af-aa4a-c52fbdcfcf33",
                                        "entry_id": "5d266f45-67be-3d67-ba55-176cb51bbdf7",
                                        "glosses": [
                                            "En Afrique du Sud, régime politique de séparation des Blancs et des Noirs en tant que groupes raciaux distincts."
                                        ],
                                        "tags": [],
                                        "note": "L’apartheid fut aboli en 1994",
                                        "examples": [
                                            {
                                                "example_id": "a14a09a7-c2b4-407e-b3fa-1d6edee5bbe2",
                                                "sense_id": "2bf0a571-d13a-32af-aa4a-c52fbdcfcf33",
                                                "text": "L’Afrique du Sud, avec la fin de l’apartheid, a vu ainsi affluer des migrants venus du Mozambique, de Zambie ou d’Angola quand les Afrikaners partaient vers l’Australie ou l’Amérique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e239cb55-e092-3a5f-865c-41487bf03c3f",
                                        "entry_id": "5d266f45-67be-3d67-ba55-176cb51bbdf7",
                                        "glosses": [
                                            "Politique tendant à séparer deux groupes raciaux ou ethniques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a22ba08d-1e02-4450-8dd6-368e73be1332",
                                                "sense_id": "e239cb55-e092-3a5f-865c-41487bf03c3f",
                                                "text": "On a même parlé d’apartheid pour qualifier les conditions qui sont imposées aux Palestiniens."
                                            },
                                            {
                                                "example_id": "36158f32-4102-48d6-ba19-c47b205507e9",
                                                "sense_id": "e239cb55-e092-3a5f-865c-41487bf03c3f",
                                                "text": "À Toronto, la ségrégation raciale de facto se compare à celle de grandes villes américaines. Les minorités visibles sont regroupées dans les quartiers pauvres, tandis que la minorité blanche domine les quartiers riches. Je reviens sur l’apartheid torontois plus loin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da876bf2-4396-3ea9-94d0-d31e41d4c8cc",
                                        "entry_id": "5d266f45-67be-3d67-ba55-176cb51bbdf7",
                                        "glosses": [
                                            "Discrimination, voire exclusion, d’une partie de la population qui ne dispose pas des mêmes droits, lieux d’habitation ou emplois que le reste de la collectivité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8a1ca85-5065-40d1-85f5-b77049c9684c",
                                                "sense_id": "da876bf2-4396-3ea9-94d0-d31e41d4c8cc",
                                                "text": "La discrimination institutionnalisée à l’encontre des femmes en Afghanistan et en Iran devrait-elle être reconnue comme un « apartheid des genres » ? Un terme lourd et chargé qui renvoie immanquablement à l’apartheid racial qui a sévi en Afrique du Sud pendant des décennies et qui a été activement combattu par la communauté internationale. Or, des voix de plus en plus fortes s’élèvent afin que cet « apartheid du XXIᵉ siècle » soit nommé comme tel et que la communauté internationale se saisisse d’outils juridiques pour lutter contre la ségrégation sexuelle érigée en projet politique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "366002a7-4900-480c-8153-d98a3b20997c",
                        "source_entry_id": "a1d588ca-c773-3258-9f52-b50a2e2266c6",
                        "source_sense_id": "b4b0b30c-201e-30e6-8150-036239a2725f",
                        "target_lang_word": "Apartheid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apartheid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "054acc15-2dd4-3220-8190-b579c49f5d1d",
                                        "entry_id": "9666d11f-7f8f-3d13-9561-e4942a5774e4",
                                        "glosses": [
                                            "frühere Rassentrennung zwischen Schwarzen und Weißen in Südafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc11f44-277e-41f4-8ead-c6efd942ce21",
                                                "sense_id": "054acc15-2dd4-3220-8190-b579c49f5d1d",
                                                "text": "Zu Zeiten der Apartheid in Südafrika war es Schwarzen verboten, Weiße zu heiraten."
                                            },
                                            {
                                                "example_id": "02214183-a3c5-4d48-9578-71b53a6f6cf6",
                                                "sense_id": "054acc15-2dd4-3220-8190-b579c49f5d1d",
                                                "text": "„Er war eine der wichtigsten Führungsfiguren im Kampf gegen die Apartheid und wurde nach deren Ende der erste schwarze Präsident Südafrikas.“"
                                            },
                                            {
                                                "example_id": "0e6828a0-c3a7-4dbd-8bd8-89b476195adb",
                                                "sense_id": "054acc15-2dd4-3220-8190-b579c49f5d1d",
                                                "text": "„Im Blick auf die Beziehungen zur rumänischen Bevölkerungsmehrheit kann man, ohne zu dramatisieren, von einer nicht kodifizierten Apartheid in den wichtigsten Lebensbereichen sprechen, die auch nicht in den Bildungsinstitutionen durchbrochen wird.“"
                                            },
                                            {
                                                "example_id": "9fd452dc-8017-461f-be30-6c71e6e88f35",
                                                "sense_id": "054acc15-2dd4-3220-8190-b579c49f5d1d",
                                                "text": "„Das System der Apartheid ist nicht länger zu halten.“"
                                            },
                                            {
                                                "example_id": "82670aa8-8c2b-4f8f-92ae-2eb72037e798",
                                                "sense_id": "054acc15-2dd4-3220-8190-b579c49f5d1d",
                                                "text": "„Wir machten einen Abstecher zu District Six, während der Zeit der Apartheid ein lebendiger Teil von Kapstadt, der dem Rassismus widerstanden hatte und als sicheres, multikulturelles Innenstadtviertel aufgeblüht war.\""
                                            },
                                            {
                                                "example_id": "de9bf14e-f9a5-4e28-a2b1-ff49f172659f",
                                                "sense_id": "054acc15-2dd4-3220-8190-b579c49f5d1d",
                                                "text": "„Apartheid war ein Polizeistaat, ein Überwachungssystem und ein Gesetzwerk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
