                    {
                        "sense_id": "eae3bcc2-a18d-3feb-bd31-939f2a0caa3e",
                        "entry_id": "a6ee8a00-9d03-31e0-8358-8c646ad9ee38",
                        "glosses": [
                            "oppervlakkige beschadiging van de huid door een ongeval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d2b4b3d-ffe5-4d8b-9c91-8b8b8ee90b0a",
                                "sense_id": "eae3bcc2-a18d-3feb-bd31-939f2a0caa3e",
                                "text": "Een gezonde jongen heeft altijd schrammen op zijn knieën."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8d5971f-e318-4054-b8f6-615dd5a80178",
                        "source_entry_id": "a6ee8a00-9d03-31e0-8358-8c646ad9ee38",
                        "source_sense_id": "eae3bcc2-a18d-3feb-bd31-939f2a0caa3e",
                        "source_sense_description": "oppervlakkige beschadiging van de huid door een ongeval",
                        "target_lang_word": "Schramme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schramme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee71156e-5f86-304b-987c-d216fdcd15ba",
                                        "entry_id": "3ddaabe1-9865-3490-af21-7bf90718a85c",
                                        "glosses": [
                                            "relativ geringfügige Beschädigung oder Verletzung einer Oberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a84b448-6652-4f6f-8c71-3dbb58c50349",
                                                "sense_id": "ee71156e-5f86-304b-987c-d216fdcd15ba",
                                                "text": "Er hat mir versehentlich eine Schramme zugefügt."
                                            },
                                            {
                                                "example_id": "c551096c-7fec-42fe-b641-3c687534fd65",
                                                "sense_id": "ee71156e-5f86-304b-987c-d216fdcd15ba",
                                                "text": "Ich habe im Lack eine Schramme entdeckt."
                                            },
                                            {
                                                "example_id": "99fea7d3-9201-470a-8e91-589ce1b80f03",
                                                "sense_id": "ee71156e-5f86-304b-987c-d216fdcd15ba",
                                                "text": "„Wahrscheinlich war die Schramme längst verheilt.“"
                                            },
                                            {
                                                "example_id": "2a506785-efdc-4a58-843c-b31d6051ed18",
                                                "sense_id": "ee71156e-5f86-304b-987c-d216fdcd15ba",
                                                "text": "„Dann und wann sah er nochmals auf die Schramme im Baumstamm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4358c3c5-3883-481e-9453-59953cb10dd1",
                        "source_entry_id": "a6ee8a00-9d03-31e0-8358-8c646ad9ee38",
                        "source_sense_id": "eae3bcc2-a18d-3feb-bd31-939f2a0caa3e",
                        "source_sense_description": "oppervlakkige beschadiging van de huid door een ongeval",
                        "target_lang_word": "Kratzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kratzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da8257a3-9ae9-316c-9e89-f86d875c1413",
                                        "entry_id": "1e9d75d9-7d91-367c-b1d5-dd0ddda7e4cb",
                                        "glosses": [
                                            "kleine bis mittelgroße Wunde oder Beschädigung, die durch bewegte Berührung mit einem spitzen Gegenstand hervorgerufen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85cef711-15a3-4a05-9c9c-b66a92efba9f",
                                                "sense_id": "da8257a3-9ae9-316c-9e89-f86d875c1413",
                                                "text": "Nicht weinen, es ist doch nur ein Kratzer."
                                            },
                                            {
                                                "example_id": "140537bc-2c1a-4538-8a85-b182057ea7bd",
                                                "sense_id": "da8257a3-9ae9-316c-9e89-f86d875c1413",
                                                "text": "Jemand hat einen Kratzer an meinen neuen Sportwagen gemacht!"
                                            },
                                            {
                                                "example_id": "7a03e0de-9522-4670-b57f-1ed49930d950",
                                                "sense_id": "da8257a3-9ae9-316c-9e89-f86d875c1413",
                                                "text": "„Die kleinen Kratzer zeigt er dann den Ausländern, die meist kein Wort der Landessprache Amharisch beherrschen.“"
                                            },
                                            {
                                                "example_id": "266d872f-67f3-4b5a-96f4-91338db18748",
                                                "sense_id": "da8257a3-9ae9-316c-9e89-f86d875c1413",
                                                "text": "„Mein kleiner Bruder dagegen war unversehrt, unglaublich, meine Mutter hatte ihn mit ihrem eigenen Körper so gut geschützt, dass er nicht einen Kratzer abbekommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dc53e7b-c934-3add-ad2d-1ac10ad3f9ed",
                                        "entry_id": "1e9d75d9-7d91-367c-b1d5-dd0ddda7e4cb",
                                        "glosses": [
                                            "Werkzeug zum Schaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8fa86a4-cfde-4297-9d4b-3e6fa9714436",
                                                "sense_id": "5dc53e7b-c934-3add-ad2d-1ac10ad3f9ed",
                                                "text": "Er benutzt einen Kratzer um den Vogelkot von der Treppe zu kratzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a7e6168b-5741-3309-94ff-dbfdd982704f",
                                        "entry_id": "1e9d75d9-7d91-367c-b1d5-dd0ddda7e4cb",
                                        "glosses": [
                                            "im Darm vorkommende parasitischer Wurm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b61c91-ca7d-4786-8dde-c0c78d453f30",
                                                "sense_id": "a7e6168b-5741-3309-94ff-dbfdd982704f",
                                                "text": "„Weltweit parasitieren die getrenntgeschlechtlichen Kratzer im Darm von über 300 Fischarten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
