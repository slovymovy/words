                "senses": [
                    {
                        "sense_id": "fef66e60-f25b-3264-bc12-2813c973eee5",
                        "entry_id": "09ba5363-762b-3625-95a9-a64221facf5d",
                        "glosses": [
                            "Remettre dans un état correct ce qui était à l’état de ruine."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6d6bbb4f-23b1-4e9c-a24c-023c0cff446c",
                                "sense_id": "fef66e60-f25b-3264-bc12-2813c973eee5",
                                "text": "Écuelles en bois incurvées en forme de canard sont enrégimentées, l'une pour la cargaison laiteuse de la nuée, l'autre pour les pièces détachées de ce palais à déruiner, la dernière, plus modeste, pour les quelques débris végétaux à épandre avec parcimonie."
                            },
                            {
                                "example_id": "f2631e08-4cf1-4cfe-b9e1-4f9cf6eeea15",
                                "sense_id": "fef66e60-f25b-3264-bc12-2813c973eee5",
                                "text": "\"science sans conscience n'est que ruine de l'âme\", il est très facile de définir la conscience c'est ce qui, ajouté à la science, déruine l'âme."
                            }
                        ]
                    }
