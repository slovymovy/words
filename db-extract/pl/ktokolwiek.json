                                            {
                                                "example_id": "98d0d4cc-e2ce-43a1-9fe1-8082c2255ac1",
                                                "sense_id": "789a31d2-eed3-320f-9dbc-4fcc4cd62d6c",
                                                "text": "Anybody will do."
                                            },
                                            {
                                                "example_id": "10bc55e0-4693-4cd6-87e6-64e86d21a667",
                                                "sense_id": "789a31d2-eed3-320f-9dbc-4fcc4cd62d6c",
                                                "text": "Is there anybody inside?"
                                            }
