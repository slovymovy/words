                "senses": [
                    {
                        "sense_id": "80b77ff0-7f96-3f04-a7dd-a5cdc76fd240",
                        "entry_id": "8537afd0-3532-3343-8a61-aa5572cecdc3",
                        "glosses": [
                            "układ pięciu obiektów w którym cztery znajdują się na kątach, a piąty w środku; również motyw dekoracyjny o takim układzie"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7ba2e29d-9dd8-4515-b74e-502cc774874b",
                                "sense_id": "80b77ff0-7f96-3f04-a7dd-a5cdc76fd240",
                                "text": "Również żołnierzy rzymskich legionów w natarciu ustawiano tak, że tworzyli trzy naprzemienne szeregi, w których wyróżnić można geometryczny układ kwinkunksów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74850ec9-5050-499c-b12b-505c043a1b33",
                        "source_entry_id": "8537afd0-3532-3343-8a61-aa5572cecdc3",
                        "source_sense_id": "80b77ff0-7f96-3f04-a7dd-a5cdc76fd240",
                        "target_lang_word": "quincunx",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quincunx",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb37c9b-f6bf-32df-98c0-e59816a36a8d",
                                        "entry_id": "8dcbb473-78f5-3f6d-ba08-19eb1022b2fb",
                                        "glosses": [
                                            "An arrangement of five units with four forming the corners of a square and the fifth at the centre of the square, a pattern corresponding to the five-spot on dice, playing cards, or dominoes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0118cff-008b-37e7-b940-934c465e6e55",
                                        "entry_id": "8dcbb473-78f5-3f6d-ba08-19eb1022b2fb",
                                        "glosses": [
                                            "An angle of five-twelfths of a circle, or 150°, between two objects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23ab2cab-7566-3f3b-a948-3c3bed2b1448",
                                        "entry_id": "8dcbb473-78f5-3f6d-ba08-19eb1022b2fb",
                                        "glosses": [
                                            "A Galton board."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f51f15ba-1fc6-4ed3-a6d9-e93d36bc2fbc",
                                                "sense_id": "23ab2cab-7566-3f3b-a948-3c3bed2b1448",
                                                "text": "In 1873–74 Sir Francis Galton (Charles Darwin’s cousin) designed an apparatus that he later named the quincunx."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7555b24a-4e75-3300-85f0-094041adeedb",
                                        "entry_id": "8dcbb473-78f5-3f6d-ba08-19eb1022b2fb",
                                        "glosses": [
                                            "A bronze coin minted during the Roman Republic, valued at five-twelfths of an as."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16877693-ba13-483e-a9f0-2c48455f04c3",
                        "source_entry_id": "8537afd0-3532-3343-8a61-aa5572cecdc3",
                        "source_sense_id": "80b77ff0-7f96-3f04-a7dd-a5cdc76fd240",
                        "target_lang_word": "quinconce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quinconce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dffdbae-0d13-34f0-98ed-df0fcd03c10d",
                                        "entry_id": "731a3394-3516-3abb-87fa-dcb70309edf5",
                                        "glosses": [
                                            "Groupe de cinq arbres dont quatre sont plantés en carré et le cinquième au milieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e9e3d73-c9b4-48ef-9b69-cd9b397f14b1",
                                                "sense_id": "7dffdbae-0d13-34f0-98ed-df0fcd03c10d",
                                                "text": "… un cimetière d'un arpent carré fermé par une haie vive, quatre ormeaux en quinconce et une tour ruinée.."
                                            },
                                            {
                                                "example_id": "0c1d0952-8d9c-4ae0-aa4e-7f86bbf54c00",
                                                "sense_id": "7dffdbae-0d13-34f0-98ed-df0fcd03c10d",
                                                "text": "Jardin de curé, avec son quinconce de tilleuls, sa collection de dahlias et de rosiers, ses berceaux de vignes et ses espaliers de pêchers et d’abricotiers."
                                            },
                                            {
                                                "example_id": "9ed5c04e-65a4-42cd-90d3-47b00563298b",
                                                "sense_id": "7dffdbae-0d13-34f0-98ed-df0fcd03c10d",
                                                "text": "Il y a dans les promenades aux environs du Mont-Dore des endroits qu’on appelle des salons, ce sont des groupes d’arbres, des quinconces sous l’ombrage desquels les baigneurs vont passer quelques heures en plein air."
                                            },
                                            {
                                                "example_id": "d455c9cc-387f-42b0-9b6c-2cb4ef8b94de",
                                                "sense_id": "7dffdbae-0d13-34f0-98ed-df0fcd03c10d",
                                                "text": "Ils s’arrêtèrent et s’assirent sous les quinconces qui ne donnaient pas encore de l’ombre."
                                            },
                                            {
                                                "example_id": "0f1dd392-82ea-4446-9acb-d2148314f99f",
                                                "sense_id": "7dffdbae-0d13-34f0-98ed-df0fcd03c10d",
                                                "text": "Comme Deleuze, Sartre avait installé ma sœur à deux pas de chez lui, au 26 de la rue Jacob, dans un hôtel particulier au charme aristocratique dont il louait le grand appartement du premier étage, qui donnait par la façade et ses deux ailes sur la cour d’honneur tandis que l’arrière du bâtiment s’ouvrait, passé le porche d’entrée, sur un jardin mélancolique, avec un quinconce de grands arbres aux fûts élancés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "201c5cd0-a8af-3a7a-a059-91530bc080a1",
                                        "entry_id": "731a3394-3516-3abb-87fa-dcb70309edf5",
                                        "glosses": [
                                            "Plantation faite à distances égales en ligne droite et qui présente plusieurs allées d’arbres en différents sens."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f8c071d-3e0c-466f-85bb-04d5c2987b29",
                                                "sense_id": "201c5cd0-a8af-3a7a-a059-91530bc080a1",
                                                "text": "Et celle-ci, soumise, obéissant aux files rigides et aux quinconces rigoureux, nourrit la proportion immuablement consacrée de 4400 ceps à l’hectare."
                                            },
                                            {
                                                "example_id": "e4ca71cf-5ac7-4a87-856f-92944d195164",
                                                "sense_id": "201c5cd0-a8af-3a7a-a059-91530bc080a1",
                                                "text": "Les trous sont souvent disposés en quinconce, parfois en carré ou simplement en ligne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b29b7905-8003-310e-9ad0-86506635c449",
                                        "entry_id": "731a3394-3516-3abb-87fa-dcb70309edf5",
                                        "glosses": [
                                            "Lieu planté de cette manière."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70cea2d2-8fb0-4afa-a194-6bca57611120",
                                                "sense_id": "b29b7905-8003-310e-9ad0-86506635c449",
                                                "text": "Vous, qui n'avez point vu de camp militaire, allez voir, un soir de fête de Saint-Cloud, le grand quinconce. Ces groupes de mangeurs, ces cantiniers empressés de vendre, ces verres et ces bouteilles épars à côté des convives, vous en donneront une idée parfaite. C'est le même désordre, et souvent la même gaîté."
                                            },
                                            {
                                                "example_id": "4fb06a34-0c8d-41fa-b0f6-026c0adf1dcd",
                                                "sense_id": "b29b7905-8003-310e-9ad0-86506635c449",
                                                "text": "Le couvent, placé au bord du chemin, s’envieillissait d’un quinconce d’ormes du temps de Jean V de Bretagne. Du quinconce, on entrait dans le cimetière"
                                            },
                                            {
                                                "example_id": "5f2b5ebc-345d-4f0e-9e3b-6fa6fceccc90",
                                                "sense_id": "b29b7905-8003-310e-9ad0-86506635c449",
                                                "text": "Elle avait passé par le quinconce des platanes, près de la source, pour couper au plus court."
                                            },
                                            {
                                                "example_id": "4c2e3f04-f774-4d64-b80a-7b662245a6ff",
                                                "sense_id": "b29b7905-8003-310e-9ad0-86506635c449",
                                                "text": "La maison, cachée derrière de hauts quinconces, gardait autour d’elle l’air d’un autre siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb7bf2a-cb4d-359b-8b51-ca7a6f3a0f9e",
                                        "entry_id": "731a3394-3516-3abb-87fa-dcb70309edf5",
                                        "glosses": [
                                            "Objets disposés de cette manière."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "086aa86d-bdc6-49a4-ac88-4c277777f455",
                                                "sense_id": "beb7bf2a-cb4d-359b-8b51-ca7a6f3a0f9e",
                                                "text": "Remarquons, que ce dernier exemple (quinconce à diagonales uniformes) pourrait encore être présenté sous la forme d'un triangle à mots décroissants, que l’on appelle parfois quinconce à mot générateur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
