                "senses": [
                    {
                        "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                        "entry_id": "c94b417a-43f9-3fd9-a9a6-f6f8dcd334ac",
                        "glosses": [
                            "kurzer, enger Männerrock (Männerrock im Sinne von Jacke)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac7eadbc-d4da-468b-a477-9742af928cc5",
                                "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                "text": "Das Jackett ist farblich auf die Hose abgestimmt und sitzt perfekt."
                            },
                            {
                                "example_id": "0c295a6c-f989-4583-95e2-bc81cc1c675b",
                                "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                "text": "„Er trug eine untadelig gepuderte Perücke und ein Jackett aus Seidenbrokat.“"
                            },
                            {
                                "example_id": "b1ecc7af-c977-48e6-a106-b11161f77458",
                                "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                "text": "„Das Jackett saß ihm wie angegossen.“"
                            },
                            {
                                "example_id": "12b670b4-004d-4218-9c46-a2404f235793",
                                "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                "text": "„Im Jackett fand er die Brieftasche und ein leeres Zigarettenetui, flach, elegant und mit eingraviertem ›Betsy‹.“"
                            },
                            {
                                "example_id": "de7f250f-fd52-4c31-9c96-d72e389d3d50",
                                "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                "text": "„Nachmittags hört er schon die Schwägerinnen in der Küche sitzen und reden, wenn er sein Jackett an der Garderobe aufhängt und die Schuhe abstreift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
