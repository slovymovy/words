                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff0eb18-ed54-48ee-9817-fd05db968fc8",
                                "sense_id": "2abb5ed7-d6c3-3b59-91fb-245209538c65",
                                "text": "Через два часа из трактира вышел докторский Мишка и сказал генеральскому кучеру, чтобы тот распряг и поводил лошадей."
                            }
                        ]
