                "senses": [
                    {
                        "sense_id": "d0994893-5a94-3b8c-befe-ee947cd21bb9",
                        "entry_id": "7a3fc09d-a378-3f1b-a733-1097d3afea71",
                        "glosses": [
                            "Gesetz, das die Prävention, Früherkennung und die Verhinderung der Weiterverbreitung regelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d472c4c1-6dcc-4874-b32b-459a3e13068e",
                                "sense_id": "d0994893-5a94-3b8c-befe-ee947cd21bb9",
                                "text": "„Das Infektionsschutzgesetz räumt dem Staat schon jetzt weit reichende Befugnisse zur Seuchenbekämpfung ein.“"
                            },
                            {
                                "example_id": "c1e7182a-2aa2-4e63-9a5a-dac919296028",
                                "sense_id": "d0994893-5a94-3b8c-befe-ee947cd21bb9",
                                "text": "„Bevor Flüchtlinge in einer Gemeinschaftsunterkunft untergebracht werden können, müssen laut dem Infektionsschutzgesetz ansteckende Krankheiten ausgeschlossen werden.“"
                            },
                            {
                                "example_id": "e828ab37-0f5a-4a0a-a602-a8f6ed4a546a",
                                "sense_id": "d0994893-5a94-3b8c-befe-ee947cd21bb9",
                                "text": "„Im Impfwesen der Bundesrepublik Deutschland gibt es keine Impfpflicht für die Bevölkerung […] Allerdings können Behörden auf der Grundlage des Infektionsschutzgesetzes bestimmte Schutzimpfungen für besonders gefährdete Personengruppen anordnen und für solche, die bei einer möglichen Infektion eine Gefahr für die Bevölkerung darstellen, z. B. Mitarbeiter in der Lebensmittelherstellung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
