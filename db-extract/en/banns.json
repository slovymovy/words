                                    {
                                        "sense_id": "c5dd3dbb-d5cf-3f2f-97a7-c9bfaf635666",
                                        "entry_id": "57aaa318-b18c-36dc-aa95-1a1aedb9a988",
                                        "glosses": [
                                            "Pluriel de ban."
