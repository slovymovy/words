                    {
                        "sense_id": "aab025a3-b6ad-3823-8f9b-6eb7f056f79c",
                        "entry_id": "201f1d57-b600-3489-8a3e-f2d0c7e87986",
                        "glosses": [
                            "Nom d’un pays ou d'une région issu d’une caractéristique géographique physique ou d'une particularité environnementale."
                        ],
                        "tags": [
                            "Toponymie"
                        ],
                        "examples": [
                            {
                                "example_id": "fd13ba8b-43cb-4c54-931f-aa85e18e5284",
                                "sense_id": "aab025a3-b6ad-3823-8f9b-6eb7f056f79c",
                                "text": "Yorkshire, Attique, Chaumont (Haute-Marne, France), Chaumont (Neuchâtel, Suisse) sont des choronymes."
                            },
                            {
                                "example_id": "1758cc83-e6f9-4e43-888b-8e11eeffb7b1",
                                "sense_id": "aab025a3-b6ad-3823-8f9b-6eb7f056f79c",
                                "text": "Ce choronyme ne désigne cependant que la partie comprise entre les deux décharges."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "216df213-a650-4c12-9c8b-a5d7e9056d1d",
                        "source_entry_id": "201f1d57-b600-3489-8a3e-f2d0c7e87986",
                        "source_sense_id": "aab025a3-b6ad-3823-8f9b-6eb7f056f79c",
