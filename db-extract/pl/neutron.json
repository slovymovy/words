                "senses": [
                    {
                        "sense_id": "583026fb-453a-38f3-9644-4fc659079a12",
                        "entry_id": "ddd24d68-4ab9-315b-bb29-e364e64a5fe0",
                        "glosses": [
                            "cząstka złożona z dwóch kwarków dolnych i jednego górnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d2f897c-74d7-4766-8e35-95cef2cdad7f",
                                "sense_id": "583026fb-453a-38f3-9644-4fc659079a12",
                                "text": "Moderatorem najczęściej bywa woda lub ciężka woda, rzadziej już ostatnio grafit, zaś reflektorem materiał o małym przekroju czynnym do wychwytu neutronów, a dużym na rozpraszanie elastyczne – przeważnie beryl lub grafit."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
