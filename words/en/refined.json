                    "sense_definition": "Improved or made more effective through small changes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "improved",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software has a <w>refined</w> search engine that provides much more accurate results.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение имеет <w>усовершенствованную</w> поисковую систему, которая выдает гораздо более точные результаты."
                            }
                        },
                        {
                            "text": "After years of practice, he finally <w>refined</w> his technique to a professional level.",
                            "target_lang_translations": {
