                                "target_senses": [
                                    {
                                        "sense_id": "cca13d96-e355-3235-a1bf-b2eb2ec16ce6",
                                        "entry_id": "615c9dc4-f832-3a45-beae-364583eb0689",
                                        "glosses": [
                                            "De manera inmediata, sin que medie nada más."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16348c42-9928-4bf7-b7f8-7bee49d0621d",
                                                "sense_id": "cca13d96-e355-3235-a1bf-b2eb2ec16ce6",
                                                "text": "—Eh, tú, ¿dónde está mi café?\n—¡Perdone! Ha habido una falla con la máquina, pero no se preocupe; inmediatamente se lo preparo.\n—Más te vale."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "inmediatamente",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "54db551e-2d05-30eb-af15-bd1e53a38ea5",
                                        "entry_id": "3056652f-01a0-301f-8f80-9aaccb35cc39",
                                        "glosses": [
                                            "En el momento, sin demora."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d2b6ef6-b13c-4797-987d-d1bd29dd8100",
                                                "sense_id": "54db551e-2d05-30eb-af15-bd1e53a38ea5",
                                                "text": "—¡Oh, no! Es el jefe. ¿¡Qué hacemos ahora!?\n—Tú solo respóndele.\n—Ho…\n—¿¡DÓNDE CARAJOS ESTÁS!?\n—Jefe, verá…\n—¡NO QUIERO ESCUCHAR TUS EXCUSAS! ¡TE QUIERO AQUÍ INMEDIATAMENTE! Si no llegas, considérate ¡DESPEDIDA! ¿¡ME HAS ESCUCHADO!?\n—Pero… ¿Hola? ¿Hola?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
