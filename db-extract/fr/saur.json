                "senses": [
                    {
                        "sense_id": "7f1ca312-ed26-3af3-904d-e8f9d27e27ce",
                        "entry_id": "01737203-a450-3795-a0f8-e1d89ca1960e",
                        "glosses": [
                            "Société française se consacrant principalement à la distribution d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd1bea8-efd2-479d-af1c-aa8651964691",
                                "sense_id": "7f1ca312-ed26-3af3-904d-e8f9d27e27ce",
                                "text": "Chef du secteur de la Saur, qui gère le service public d’eau potable pour Barbezieux, Richard Bô a dressé un état des lieux des deux captages qui alimentent la commune devant le conseil municipal réuni mercredi : le puits des Bruns à Barret et celui de Chez Drouillard à Saint-Hilaire."
                            },
                            {
                                "example_id": "2939453b-c09c-4d11-852e-23ae095e220b",
                                "sense_id": "7f1ca312-ed26-3af3-904d-e8f9d27e27ce",
                                "text": "La Saur accompagne depuis plus de 80 ans les collectivités locales dans la fourniture de l'eau et de la propreté."
                            },
                            {
                                "example_id": "5f6ec407-0670-48af-b20f-1e77405c6532",
                                "sense_id": "7f1ca312-ed26-3af3-904d-e8f9d27e27ce",
                                "text": "Marché de l'eau : la Saur pourrait être remise en vente."
                            }
                        ]
                    }
