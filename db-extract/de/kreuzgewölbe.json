                ],
                "senses": [
                    {
                        "sense_id": "a192daf4-26e3-3f02-bf2b-84539d99945e",
                        "entry_id": "023d6c4b-2fac-34ee-a9ed-a50f8e33078b",
                        "glosses": [
                            "eine Gewölbeform, die durch zwei sich rechtwinklig schneidende Tonnengewölbe entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dae4ac4-b734-4f17-91e4-a39875374094",
                                "sense_id": "a192daf4-26e3-3f02-bf2b-84539d99945e",
                                "text": "Ein Kreuzgewölbe kann man geometrisch aus einer rechtwinkligen Durchdringung zweier Tonnengewölbe gleichen Querschnitts ableiten."
                            },
                            {
                                "example_id": "25e00457-51b7-4f46-9e07-3ca9472a2416",
                                "sense_id": "a192daf4-26e3-3f02-bf2b-84539d99945e",
                                "text": "Die sphärischen Dreiecke in einem Kreuzgewölbe bezeichnet man als Kappen, die Grenzlinien zwischen diesen als Grate."
                            },
                            {
                                "example_id": "05e3a2ad-6a37-4df3-bd24-683df8dedce6",
                                "sense_id": "a192daf4-26e3-3f02-bf2b-84539d99945e",
                                "text": "„Wird ein Kreuzgewölbe über verschieden hohen Bögen errichtet, muß die Kappe über den kleineren ansteigen, um die Kappe über dem größeren Bogen in dem gleichen Schnittpunkt zu treffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
