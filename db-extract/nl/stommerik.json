                                            {
                                                "example_id": "c913617e-c71c-47f8-b222-ff4a8c162641",
                                                "sense_id": "2d998cbf-15e0-3b94-87d7-762504e2f79e",
                                                "text": "My gear is stupid fly."
                                            },
                                            {
                                                "example_id": "a3aa9a59-b127-4dd1-87f5-a33eb9ad5c06",
                                                "sense_id": "2d998cbf-15e0-3b94-87d7-762504e2f79e",
                                                "text": "Richard DeLongpre: Aw, we did, didn't we? I'm sorry. I'm so stupid in love with you."
                                            },
                                            {
                                                "example_id": "892f515e-eec3-4ce7-b7eb-7dcd16c30900",
                                                "sense_id": "2d998cbf-15e0-3b94-87d7-762504e2f79e",
                                                "text": "I'm your mother, sister, your father, brother / This family is stupid attractive"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stupid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d276dd43-ee0e-3a33-ac96-03f6e15db8a5",
                                        "entry_id": "c3de1862-7007-3ccf-92ca-45b3c3ee8bb6",
                                        "glosses": [
                                            "A stupid person; a fool."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a4c024b-1e62-4f3c-823c-e53e5f1d7d97",
                                                "sense_id": "d276dd43-ee0e-3a33-ac96-03f6e15db8a5",
                                                "text": "\"You stupid!\" screamed the girls, \"we've got to guess the word. Now you'll have to go back and think of another.\""
                                            },
                                            {
                                                "example_id": "6845a6b5-04a6-498a-9a7f-a2a31818c0c6",
                                                "sense_id": "d276dd43-ee0e-3a33-ac96-03f6e15db8a5",
                                                "text": "\"What a stupid I am!\" Harry exclaimed, as she watched the man ride away in the distance."
                                            },
                                            {
                                                "example_id": "6716189f-200a-4283-90be-1d3eae34b5ed",
                                                "sense_id": "d276dd43-ee0e-3a33-ac96-03f6e15db8a5",
                                                "text": "Some stupid with a flare gun burned the place to the ground."
                                            },
                                            {
                                                "example_id": "3c574bee-6066-46a9-b146-e5f03e7423f5",
                                                "sense_id": "d276dd43-ee0e-3a33-ac96-03f6e15db8a5",
                                                "text": "At least those stupids got their money's worth out of this country before they burnt their lungs out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b89702c-74fb-3def-be69-16776ca1b588",
                                        "entry_id": "c3de1862-7007-3ccf-92ca-45b3c3ee8bb6",
                                        "glosses": [
                                            "The condition or state of being stupid; stupidity, stupidness."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ce4ab9-b641-4ac2-9d15-83fa32443389",
                                                "sense_id": "3b89702c-74fb-3def-be69-16776ca1b588",
                                                "text": "His stupid knows no bounds."
                                            },
                                            {
                                                "example_id": "641edf83-894f-42cd-8865-a1627eaf9ec2",
                                                "sense_id": "3b89702c-74fb-3def-be69-16776ca1b588",
                                                "text": "As long as our staff keeps giving us the stupid, we'll never get our work done."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
