                                "target_senses": [
                                    {
                                        "sense_id": "c62f19ee-5cb9-36f4-974b-c9bbc8499963",
                                        "entry_id": "c6e95618-3b43-3b72-8080-00101a5c2423",
                                        "glosses": [
                                            "Qui est relatif à l’explosion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24659db2-e366-42f3-8959-9e7cda13fb9d",
                                                "sense_id": "c62f19ee-5cb9-36f4-974b-c9bbc8499963",
                                                "text": "Étudier les phénomènes explosifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b17cc14d-d611-3eb8-bf58-700f43c278f3",
                                        "entry_id": "c6e95618-3b43-3b72-8080-00101a5c2423",
                                        "glosses": [
                                            "Qui produit l’explosion → voir explosible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324a89d2-4ad4-46a8-ae84-8cf83b86c6c9",
                                                "sense_id": "b17cc14d-d611-3eb8-bf58-700f43c278f3",
                                                "text": "Substance explosive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae6f9e2-a0aa-3d74-ab44-1de92f52e919",
                                        "entry_id": "c6e95618-3b43-3b72-8080-00101a5c2423",
                                        "glosses": [
                                            "Dont le son est une sorte de petite explosion → voir plosive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef4e73a-afae-462d-aa7e-042458135d85",
                                                "sense_id": "2ae6f9e2-a0aa-3d74-ab44-1de92f52e919",
                                                "text": "Consonne explosive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "231ae31f-595a-3b48-a882-502e4fc4df4e",
                                        "entry_id": "c6e95618-3b43-3b72-8080-00101a5c2423",
                                        "glosses": [
                                            "Qui produit des gaz."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe564742-df70-3e4d-b944-c8f605cdaff2",
                                        "entry_id": "c6e95618-3b43-3b72-8080-00101a5c2423",
                                        "glosses": [
                                            "Sensationnel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "041a8b77-a97b-4c25-b18d-4c7c6960b83d",
                                                "sense_id": "fe564742-df70-3e4d-b944-c8f605cdaff2",
                                                "text": "La publication de cette tribune intervient au lendemain de la diffusion de larges extraits d’un livre explosif du journaliste d’investigation Bob Woodward, qui dresse le portrait d’un président colérique et paranoïaque que ses collaborateurs s’efforcent de contrôler, voire de contourner, pour éviter de dangereux dérapages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00d75aac-3ec3-3a14-919c-7a958093b50a",
                                        "entry_id": "c6e95618-3b43-3b72-8080-00101a5c2423",
                                        "glosses": [
                                            "Qui peut provoquer des réactions agressives."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c898915c-a761-4b31-9236-642dcfbcc7ff",
                                                "sense_id": "00d75aac-3ec3-3a14-919c-7a958093b50a",
                                                "text": "L’erreur a été de ne jamais poser le problème en ces termes, parce que le débat était jugé trop explosif et le compromis trop difficile à trouver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "explosif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3115bef-f2e3-3f61-a003-fc3eb042df3d",
                                        "entry_id": "2885b619-158d-343c-a141-071d710aa6af",
                                        "glosses": [
                                            "Substance qui produit une explosion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0478f888-2a3a-4d6e-9e94-1de017efb730",
                                                "sense_id": "c3115bef-f2e3-3f61-a003-fc3eb042df3d",
                                                "text": "Les assaillants, amplement pourvus d’explosifs, causèrent, tant à Berlin qu’en Franconie, des dommages énormes."
                                            },
                                            {
                                                "example_id": "f6ab1377-2bfb-417c-afa6-536924a253c9",
                                                "sense_id": "c3115bef-f2e3-3f61-a003-fc3eb042df3d",
                                                "text": "Ces dévastateurs de l'humanité, les explosifs, les avions de bombardement, les gaz mortifères, font partie de la plus haute science, au même titre que la chaise à électrocuter et que les alcaloïdes hypertoxiques."
                                            },
                                            {
                                                "example_id": "0e83d545-6a0e-46f4-9208-05b2b1f2a352",
                                                "sense_id": "c3115bef-f2e3-3f61-a003-fc3eb042df3d",
                                                "text": "Ce mélange de 75 pour cent de salpêtre, de 15 pour cent de charbon de bois et de 10 pour cent de soufre fut l’unique explosif utilisé dans les armes à feu et pour les explosions jusqu’à l’invention du coton-poudre (nitrocellulose), au XIXᵉ siècle."
                                            }
