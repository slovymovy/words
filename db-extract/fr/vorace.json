                        "cross_references": [
                            {
                                "target_word": "gierig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                        "entry_id": "91688a52-5b34-3db2-8dfc-6330f86422e9",
                                        "glosses": [
                                            "triebartig danach verlangend, etwas zu bekommen oder zu besitzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38389943-1c68-435d-8a0a-eef27b1e7a72",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Der Pirat starrte gierig auf die Schätze."
                                            },
                                            {
                                                "example_id": "ca0167e2-23bb-4c68-bb3f-2db963b21e8a",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Gierig verschlang der Gefangene einen Teller Suppe."
                                            },
                                            {
                                                "example_id": "cc1612ff-8850-4e79-8a3b-77b9a4c60456",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Der Mann saß an der Bar und verschlang die Stripperin mit gierigem Blick."
                                            },
                                            {
                                                "example_id": "017944bc-c030-4b74-b3db-6c6b62bee8f4",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Die Mannschaft ist gieriger auf den Titel als auf die Prämie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d4cf14e-412e-4848-8b15-64e2f2d255f2",
                        "source_entry_id": "865c2ee0-a1f6-3515-a6e1-2b0a8a6958d5",
                        "source_sense_id": "a046a4ea-01d9-3f19-bd4d-647ddb97b1cd",
                        "source_sense_description": "Qui dévore, qui mange avec avidité",
                        "target_lang_word": "voracious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voracious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2145405c-02cc-3960-9285-e8bb33d6992c",
                                        "entry_id": "69f7db48-7d3e-349d-81e7-6386fa7d20c7",
                                        "glosses": [
                                            "Wanting or devouring great quantities of food."
                                        ],
                                        "tags": [
                                            "of a person or their appetite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18785019-ce9d-4c0f-9f34-477568beca09",
                                                "sense_id": "2145405c-02cc-3960-9285-e8bb33d6992c",
                                                "text": "He is voracious by suppertime."
                                            },
                                            {
                                                "example_id": "faca3946-9b05-460a-8369-0b0dee6be41a",
                                                "sense_id": "2145405c-02cc-3960-9285-e8bb33d6992c",
                                                "text": "His appetite is voracious by suppertime."
                                            },
                                            {
                                                "example_id": "26bb467f-a0ba-488b-a2f9-214ea753691c",
                                                "sense_id": "2145405c-02cc-3960-9285-e8bb33d6992c",
                                                "text": "I never had so much as […] one wish to God to direct me whither I should go, or to keep me from the danger which apparently surrounded me, as well from voracious creatures as cruel savages."
                                            },
                                            {
                                                "example_id": "390a1467-bacb-4dc7-80be-887c63820aad",
                                                "sense_id": "2145405c-02cc-3960-9285-e8bb33d6992c",
                                                "text": "The old man was up, betimes, next morning, and waited impatiently for the appearance of his new associate, who after a delay that seemed interminable, at length presented himself, and commenced a voracious assault on the breakfast."
                                            },
                                            {
                                                "example_id": "abda9c59-7398-4a96-8229-b45d9e5a03a2",
                                                "sense_id": "2145405c-02cc-3960-9285-e8bb33d6992c",
                                                "text": "Retreating before stronger breeds, hungry and voracious, the Eskimo has drifted to the inhospitable polar regions, the Pygmy to the fever-rotten jungles of Africa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66bd87c4-e025-32b2-ad80-293c956af1e0",
                                        "entry_id": "69f7db48-7d3e-349d-81e7-6386fa7d20c7",
                                        "glosses": [
                                            "Having a great appetite for anything; eager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16ad4c53-d970-4d87-b0ab-d87420c4875b",
                                                "sense_id": "66bd87c4-e025-32b2-ad80-293c956af1e0",
                                                "text": "a voracious reader"
                                            },
                                            {
                                                "example_id": "0baeadcf-f67d-4d11-97e6-2b77fca5aebd",
                                                "sense_id": "66bd87c4-e025-32b2-ad80-293c956af1e0",
                                                "text": "If he carried chiefly his appetite, a zeal for tiled bathrooms, a conviction that the Pullman car is the acme of human comfort, and a belief that it is proper to tip waiters, taxicab drivers, and barbers, but under no circumstances station agents and ushers, then his Odyssey will be replete with good meals and bad meals, bathing adventures, compartment-train escapades, and voracious demands for money."
                                            },
                                            {
                                                "example_id": "a5f6cbd8-975d-4de0-9f2c-d800cd929b62",
                                                "sense_id": "66bd87c4-e025-32b2-ad80-293c956af1e0",
                                                "text": "Methodical and voracious, these hackers wanted all the files they could find."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d933491-c265-414f-8f7f-33da9e29f816",
