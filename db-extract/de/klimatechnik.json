                        "sense_id": "fd390caf-1f3a-3ce7-acad-7c8a0a3298ab",
                        "entry_id": "0f0e6f26-9a9b-3278-b1a9-04bcb7b25a07",
                        "glosses": [
                            "Fachrichtung, die sich mit der Planung und dem Bau von Klimaanlagen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c1c4ed1-3e91-4c11-8c24-215b52abfe4b",
                                "sense_id": "fd390caf-1f3a-3ce7-acad-7c8a0a3298ab",
                                "text": "„Die meisten Normungsvorhaben der Lüftungs- und Klimatechnik entstehen im europäischen Raum; nationale Normen werden Zug um Zug zurückgezogen und durch europäische Normen ersetzt.“"
                            },
                            {
                                "example_id": "fe15659f-51a0-4a06-9809-1497e522556d",
                                "sense_id": "fd390caf-1f3a-3ce7-acad-7c8a0a3298ab",
                                "text": "„Ebenso hat die Erschließung und stärkere Besiedlung tropischer und subtropischer Gebiete der Klimatechnik starken Auftrieb gegeben.“"
                            }
                        ],
