                        "sense_id": "743623be-5897-3241-a254-e6299dae2bc5",
                        "entry_id": "b4352b27-1364-3685-9285-c4ab6aa0cdcf",
                        "glosses": [
                            "(räumliches oder thematisches) Gebiet, in dem bestimmte Versuche durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1297078-1860-48d0-a0c3-5e6903b7d503",
                                "sense_id": "743623be-5897-3241-a254-e6299dae2bc5",
                                "text": "„Syrien scheint derzeit nicht nur ein Experimentierfeld für Bomben und Granaten zu sein, sondern auch ein rechtsfreier Raum.“"
                            },
                            {
                                "example_id": "40b5e93a-284b-4625-86fe-5673248383fa",
                                "sense_id": "743623be-5897-3241-a254-e6299dae2bc5",
                                "text": "„Elektromobilität war in Deutschland bisher eher ein Experimentierfeld.“"
                            },
                            {
                                "example_id": "8669aa1e-ffe9-48bd-b8c9-a86683dca5e6",
                                "sense_id": "743623be-5897-3241-a254-e6299dae2bc5",
                                "text": "„Die frühen Gemälde sind dabei noch Experimentierfelder, die Idee der Zweckentfremdung ist präsent, und Helene Hegemann würde es Sampling nennen.“"
                            }
                        ],
