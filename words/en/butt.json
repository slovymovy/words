                },
                {
                    "sense_id": "d8334c4c-5ed2-359a-8c82-2257c0cee46d",
                    "sense_definition": "A person at whom ridicule, jest, or contempt is directed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "target",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was tired of being the <w>butt</w> of their cruel jokes.",
                            "target_lang_translations": {
                                "ru": "Он устал быть <w>мишенью</w> их жестоких шуток.",
                                "es": "Estaba cansado de ser el <w>hazmerreír</w> de sus bromas crueles."
                            }
                        },
                        {
                            "text": "The politician became the <w>butt</w> of satire on late-night television.",
                            "target_lang_translations": {
                                "ru": "Политик стал <w>объектом</w> сатиры в ночном телеэфире.",
                                "es": "El político se convirtió en el <w>blanco</w> de la sátira en la televisión nocturna."
                            }
