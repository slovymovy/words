                                "target_lang_word": "ежевичник",
                                "target_lang_sense_clarification": "заросли или куст ежевики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76dfafee-2f9e-36a2-a29d-17be86adebd0",
                    "sense_definition": "een ruw opstaand randje of onregelmatigheid aan een metalen voorwerp of mes",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft de wedstrijd verloren omdat er een <w>braam</w> op zijn schaats zat.",
                            "target_lang_translations": {
                                "en": "He lost the race because there was a <w>burr</w> on his skate.",
                                "ru": "Он проиграл забег, потому что на его коньке был <w>заусенец</w>."
                            }
                        },
                        {
                            "text": "Na het slijpen moet je de <w>braam</w> van het mes verwijderen.",
                            "target_lang_translations": {
                                "en": "After sharpening, you must remove the <w>burr</w> from the knife.",
                                "ru": "После заточки необходимо удалить <w>заусенец</w> с ножа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "braam op de schaats"
                    ],
                    "target_lang_definitions": {
                        "en": "a rough raised edge or irregularity on a metal object or knife",
                        "ru": "шероховатый выступающий край или неровность на металлическом предмете или ноже"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "burr",
                                "target_lang_sense_clarification": "rough edge on metal"
                            },
                            {
                                "target_lang_word": "bur",
                                "target_lang_sense_clarification": "rough edge on metal"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "заусенец",
                                "target_lang_sense_clarification": "на металле или лезвии"
                            },
                            {
                                "target_lang_word": "грат",
                                "target_lang_sense_clarification": "технический термин для излишков металла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6295dee-d3d7-30f6-a1d1-7da06512623b",
                    "sense_definition": "een bepaald soort Europese zoetwatervis, ook wel bekend als de brasem",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser ving een grote <w>braam</w> in de lokale vijver.",
                            "target_lang_translations": {
                                "en": "The fisherman caught a large <w>bream</w> in the local pond.",
                                "ru": "Рыбак поймал большого <w>леща</w> в местном пруду."
                            }
                        },
                        {
                            "text": "In sommige dialecten wordt de brasem simpelweg een <w>braam</w> genoemd.",
                            "target_lang_translations": {
                                "en": "In some dialects, the bream is simply called a <w>bream</w>.",
                                "ru": "В некоторых диалектах леща называют просто <w>braam</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vaak gebruikt als synoniem voor brasem in specifieke regio's"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a certain type of European freshwater fish, also known as the bream",
                        "ru": "определенный вид европейской пресноводной рыбы, также известный как лещ"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bream",
                                "target_lang_sense_clarification": "freshwater fish"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лещ",
                                "target_lang_sense_clarification": "пресноводная рыба"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d500e93b-e399-3c6f-87be-ae22af8a8419",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>bramen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>braam</w> de randen van het metaal om ze glad te maken.",
                            "target_lang_translations": {
                                "en": "I <w>deburr</w> the edges of the metal to make them smooth.",
                                "ru": "Я <w>удаляю заусенцы</w> с краев металла, чтобы сделать их гладкими."
                            }
                        },
                        {
                            "text": "Wanneer ik het staal bewerk, <w>braam</w> ik het direct daarna.",
                            "target_lang_translations": {
                                "en": "When I work the steel, I <w>deburr</w> it immediately afterwards.",
                                "ru": "Когда я обрабатываю сталь, я сразу после этого <w>зачищаю</w> её."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van het werkwoord bramen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'bramen' (to deburr)",
                        "ru": "форма первого лица единственного числа настоящего времени глагола 'bramen' (удалять заусенцы)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deburr",
                                "target_lang_sense_clarification": "to remove rough edges"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "удаляю заусенцы",
                                "target_lang_sense_clarification": "процесс зачистки металла"
                            },
                            {
                                "target_lang_word": "зачищаю",
                                "target_lang_sense_clarification": "края металла"
                            }
                        ]
                    }
                }
            ]
        }
    ]
