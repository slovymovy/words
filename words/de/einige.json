    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "81d754ac-b2fc-367c-a0e4-571e370b01b2",
                    "sense_definition": "Eine unbestimmte, begrenzte Anzahl von Personen oder Dingen; mehrere.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "menge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir müssen vor der Abreise noch <w>einige</w> wichtige Vorbereitungen treffen.",
                            "target_lang_translations": {
                                "en": "Before departing, we still need to make <w>some</w> important preparations."
                            }
                        },
                        {
                            "text": "<w>Einige</w> meiner Kollegen sind heute im Homeoffice geblieben.",
                            "target_lang_translations": {
                                "en": "<w>Some</w> of my colleagues stayed to work from home today."
                            }
                        }
                    ],
                    "synonyms": [
                        "mehrere",
                        "etliche",
                        "manche"
                    ],
                    "antonyms": [
                        "alle",
                        "keine"
                    ],
                    "common_phrases": [
                        "vor einige Tagen",
                        "einige von uns",
                        "einige Zeit"
                    ],
                    "target_lang_definitions": {
                        "en": "An indefinite, limited number of people or things; several."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "some",
                                "target_lang_sense_clarification": "an unspecified number of countable things"
                            },
                            {
                                "target_lang_word": "several",
                                "target_lang_sense_clarification": "more than one or two, but not very many"
                            },
                            {
                                "target_lang_word": "a few",
                                "target_lang_sense_clarification": "a small number"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf263b56-c92d-3b7a-aad6-d485a647aeab",
                    "sense_definition": "Eine unbestimmte, aber doch beträchtliche oder relevante Menge von etwas.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "menge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe <w>einige</w> Geduld gebraucht, bis endlich die passende Antwort kam.",
                            "target_lang_translations": {
                                "en": "I needed <w>quite a bit of</w> patience until the right answer finally arrived."
                            }
                        },
                        {
                            "text": "In den letzten Wochen ist bei dem Projekt <w>einige</w> Arbeit liegen geblieben.",
                            "target_lang_translations": {
                                "en": "Over the past few weeks, <w>a good deal of</w> work has been left undone on the project."
                            }
                        }
                    ],
                    "synonyms": [
                        "etwas"
                    ],
                    "antonyms": [
                        "nichts"
                    ],
                    "common_phrases": [
                        "einige Mühe",
                        "einige Geduld"
                    ],
                    "target_lang_definitions": {
                        "en": "An indefinite, but considerable or relevant amount of something (often used with uncountable nouns)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "some",
                                "target_lang_sense_clarification": "a considerable amount or degree"
                            },
                            {
                                "target_lang_word": "quite a bit of",
                                "target_lang_sense_clarification": "a noticeable or substantial quantity"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "75fc8391-8f47-358b-98f8-5d1ecbea169f",
                    "sense_definition": "Form des Adjektivs <w>einig</w> (übereinstimmend, ungeteilt).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>einige</w> Gruppe konnte schnell eine gemeinsame Entscheidung fällen.",
                            "target_lang_translations": {
                                "en": "The <w>united</w> group was able to reach a joint decision quickly."
                            }
                        },
                        {
                            "text": "Eine <w>einige</w> Familie übersteht auch schwere Zeiten gemeinsam.",
                            "target_lang_translations": {
                                "en": "A <w>united</w> family weathers difficult times together as well."
                            }
                        }
                    ],
                    "synonyms": [
                        "einträchtige"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "flektierte Form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Inflected form of the adjective 'einig': united, agreed, harmonious."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "united",
                                "target_lang_sense_clarification": "joined together in agreement or harmony"
                            },
                            {
                                "target_lang_word": "harmonious",
                                "target_lang_sense_clarification": "free from disagreement or dissent"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45a12870-ed1d-3257-8c5f-be3763ef45c7",
                    "sense_definition": "Form des Verbs <w>einigen</w> (eine Übereinkunft erzielen).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich <w>einige</w> mich mit meinem Geschäftspartner über die neuen Bedingungen.",
                            "target_lang_translations": {
                                "en": "I <w>reach an agreement</w> with my business partner regarding the new terms."
                            }
                        },
                        {
                            "text": "Wenn es Streit gibt, <w>einige</w> ich mich meistens recht schnell.",
                            "target_lang_translations": {
                                "en": "When there is a dispute, I usually <w>come to an agreement</w> quite quickly."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "flektierte Form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present form of the verb 'einigen': to agree, to reach an agreement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "agree",
                                "target_lang_sense_clarification": "to reach a mutual understanding"
                            },
                            {
                                "target_lang_word": "come to an agreement",
                                "target_lang_sense_clarification": "settle on a consensus"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}