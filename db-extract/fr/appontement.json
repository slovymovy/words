        "fr-extract.jsonl": [
            {
                "entry_id": "dc173a9b-477f-3677-87e5-c85a8a3246f6",
                "word": "appontement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2599a650-fbe6-4723-8310-42c3f8f39197",
                        "entry_id": "dc173a9b-477f-3677-87e5-c85a8a3246f6",
                        "tags": [
                            "plural"
                        ],
                        "form": "appontements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1f228d7-5b89-384d-8bfc-4c2823074e41",
                        "entry_id": "dc173a9b-477f-3677-87e5-c85a8a3246f6",
                        "glosses": [
                            "Plate-forme fixe, en bois, supportée par des pilotis et servant de quai d’amarrage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfa92e90-6f54-4b3b-85f8-7317906fdb48",
                                "sense_id": "b1f228d7-5b89-384d-8bfc-4c2823074e41",
                                "text": "— Non : devant l’appontement Yen-Tang.»"
                            },
                            {
                                "example_id": "4dc7b85a-b2ad-44a8-a9fe-168ff0de1f13",
                                "sense_id": "b1f228d7-5b89-384d-8bfc-4c2823074e41",
                                "text": "De retour sur le pont, il constata que l’embarcation se dirigeait vers un appontement proche d’un village."
                            },
                            {
                                "example_id": "9a211136-713d-418c-b43a-0d87647ee484",
                                "sense_id": "b1f228d7-5b89-384d-8bfc-4c2823074e41",
                                "text": "Là où jadis abordaient les flûtes de cent tonnes, des encadrements géométriques, des portiques de déchargement à grande puissance, des appontements, des canalisations pour l’évacuation des tank steamers et le chargement des chalands-citernes ; des barrages pour isoler ; en cas de sinistre, un bassin aux pétroles, des réservoirs ; des grues à terre et des pontons ; des hangars, des docks flottants ; un slip-way pour mettre à sec les navires."
                            },
                            {
                                "example_id": "7536e445-4dc2-4b2a-9318-4655ceb16d94",
                                "sense_id": "b1f228d7-5b89-384d-8bfc-4c2823074e41",
                                "text": "Il désigna l’appontement où une flotte disparate se pressait . Il y avait pêle-mêle des croiseurs, des frégates, des navires de croisière et même quelques coquilles de noix peu engageantes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9967f216-b851-481d-8076-c40f3ede6847",
                        "source_entry_id": "dc173a9b-477f-3677-87e5-c85a8a3246f6",
                        "source_sense_id": "b1f228d7-5b89-384d-8bfc-4c2823074e41",
                        "target_lang_word": "Pier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a04acdc9-1f01-35ea-ae50-949626f19eca",
                                        "entry_id": "f0c9f5cf-a183-395e-8c37-690785f30d64",
                                        "glosses": [
                                            "massiver Hafendamm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31e75c83-362a-419a-9493-6141fc62a076",
                                                "sense_id": "a04acdc9-1f01-35ea-ae50-949626f19eca",
                                                "text": "Wir treffen uns auf der Pier."
                                            },
                                            {
                                                "example_id": "08dfa323-a0e1-45ea-8eca-394cf6526387",
                                                "sense_id": "a04acdc9-1f01-35ea-ae50-949626f19eca",
                                                "text": "„Wir gingen hinaus in die der Pier zugewandte Steuerbordnock, um den Schaden in Augenschein zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c249d122-8846-3c3a-9b7f-792f56d8d372",
                                        "entry_id": "e5d80fd6-3c85-3876-94fa-351b96e9a5b4",
                                        "glosses": [
                                            "Köderwurm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8495a81d-8e65-4caa-b870-e455f503b747",
                                                "sense_id": "c249d122-8846-3c3a-9b7f-792f56d8d372",
                                                "text": "Der Brachvogel hat einen Pier am Wickel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74490ebd-7390-3ba8-be83-b701b971d29a",
                                        "entry_id": "a6979627-fa98-3082-9e81-c73359514958",
                                        "glosses": [
                                            "Ortsteil der Gemeinde Inden im Kreis Düren, Nordrhein-Westfalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec5a405-838c-40d5-b70f-f575fa0635b7",
                                                "sense_id": "74490ebd-7390-3ba8-be83-b701b971d29a",
                                                "text": "Pier bestand bis 1806 aus zwei einzelnen Dörfern: Pier und Bonsdorf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41902b36-1163-363f-b9f0-888158e55962",
                                        "entry_id": "a6979627-fa98-3082-9e81-c73359514958",
                                        "glosses": [
                                            "Ortsteil von Langerwehe im Kreis Düren in Nordrhein-Westfalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceb810a2-0ef7-4934-a66d-b304f4ca8993",
                                                "sense_id": "41902b36-1163-363f-b9f0-888158e55962",
                                                "text": "Pier wurde mit dem ersten Spatenstich am 26. November 2004 östlich des Langerweher Ortsteils Jüngersdorf auf einem etwa 26 Hektar großen Baugebiet mit 265 Grundstücken gegründet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "027fcd3f-eb0a-4705-9e5a-751d0e72a7ac",
                        "source_entry_id": "dc173a9b-477f-3677-87e5-c85a8a3246f6",
                        "source_sense_id": "b1f228d7-5b89-384d-8bfc-4c2823074e41",
                        "target_lang_word": "Steg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "eine kleine Brücke"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b97d196d-0ae3-4d32-844d-3300608105b5",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "Diesen schmalen Steg müssen wir überschreiten."
                                            },
                                            {
                                                "example_id": "98b2eff3-e3ea-42dd-a9e0-365976a22f12",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "„Weit und breit verursachten unsere Füße auf dem knarrenden Steg das einzige Geräusch.“"
                                            },
                                            {
                                                "example_id": "1b7d0d8d-692c-4341-b6fc-f6144c56a12a",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "„Die Bretter des Stegs hatten geknarrt, und das Wasser des Flusses war so dunkel und durchsichtig gewesen wie immer.“"
                                            },
                                            {
                                                "example_id": "bba2adaf-ea7a-46a2-a9d2-d745bf88bfe0",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "Köln, Rheinauhafen. Im Schatten der architektonisch durchaus gewagten drei Kranhäuser dümpeln gut vertäut Schiffe an den Stegen."
                                            },
                                            {
                                                "example_id": "2aa8c37b-67f7-40f5-963a-fa5f488ef1d3",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "Am Steg baumelt ein Thermometer im Wasser. Neun Grad."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "347ae8b4-d71e-31f8-8635-5f747d30120b",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "bei Streichinstrumenten auf dem Resonanzboden aufstehendes kleines Querbrett, über das die Saiten laufen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a2302b2-8479-4fec-aac0-d8277c1ebc64",
                                                "sense_id": "347ae8b4-d71e-31f8-8635-5f747d30120b",
                                                "text": "Ein virtuoser Geiger muss den perfekten Treffpunkt des Bogens auf der Saite zwischen Steg und Griffbrett finden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a3f20325-6510-35ba-a289-d51a9c22f9b0",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "unter dem Schuh oder unter dem Fuß durchlaufender Riemen, um die Kleidung straff zu halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4efd06b-5206-45fb-8e88-751188b9e6d6",
                                                "sense_id": "a3f20325-6510-35ba-a289-d51a9c22f9b0",
                                                "text": "Der Steg unter meinem rechten Schuh ist schon durchgetreten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dbb98190-58ba-382f-94b1-b7a113c8553e",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "die leere Außenfläche einer bedruckten Buchseite"
                                        ],
                                        "tags": [
                                            "Druckerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad9af13e-aeaa-4d96-b51b-bd2d83d84eb0",
                                                "sense_id": "dbb98190-58ba-382f-94b1-b7a113c8553e",
                                                "text": "Der Steg dieser Buchseite ist mit Notizen beschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8274703b-c041-3b8c-9e18-15b0924ef4ac",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "das die beiden Gurte (im Stahlbau auch Flansche genannten) verbindende Konstruktionselement eines doppel-T-förmigen Trägers"
                                        ],
                                        "tags": [
                                            "Stahlbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d16fa22d-4f60-43f9-87b8-1c5b8ff07f92",
                                                "sense_id": "8274703b-c041-3b8c-9e18-15b0924ef4ac",
                                                "text": "Der Steg eines Doppel-T-Trägers verbindet die beiden Flansche."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "e655164a-cc0b-3da0-9f77-7b175a361851",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "generell verbindendes Konstruktionselement wie zum Beispiel der Brillensteg"
                                        ],
