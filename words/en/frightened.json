    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "108a500e-b6f3-37b4-8b8c-547486ab2bc2",
                    "sense_definition": "Feeling fear or being afraid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>frightened</w> child hid behind his mother when the dog barked.",
                            "target_lang_translations": {
                                "ru": "<w>Испуганный</w> ребенок спрятался за мать, когда залаяла собака.",
                                "tr": "Köpek havladığında <w>korkmuş</w> çocuk annesinin arkasına saklandı."
                            }
                        },
                        {
                            "text": "She looked very much <w>frightened</w> of the storm outside.",
                            "target_lang_translations": {
                                "ru": "Она выглядела очень <w>напуганной</w> бурей за окном.",
                                "tr": "Dışarıdaki fırtınadan çok <w>korkmuş</w> görünüyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "afraid",
                        "scared",
                        "fearful",
                        "terrified"
                    ],
                    "antonyms": [
                        "brave",
                        "unafraid",
                        "fearless",
                        "confident"
                    ],
                    "common_phrases": [
                        "frightened of",
                        "frightened to death",
                        "look frightened",
                        "frightened by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий страх или боящийся чего-либо.",
                        "tr": "Korku hisseden veya korkmuş olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испуганный",
                                "target_lang_sense_clarification": "охваченный страхом"
                            },
                            {
                                "target_lang_word": "напуганный",
                                "target_lang_sense_clarification": "подвергшийся испугу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "korkmuş",
                                "target_lang_sense_clarification": "korku hissi taşıyan"
                            },
                            {
                                "target_lang_word": "ürkmüş",
                                "target_lang_sense_clarification": "ani bir korkuyla irkilmiş"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ef4dc75-3888-38aa-90e4-0b59a7d1a122",
                    "sense_definition": "Simple past and past participle of <w>frighten</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud noise <w>frightened</w> the birds away from the garden.",
                            "target_lang_translations": {
                                "ru": "Внезапный громкий шум <w>спугнул</w> птиц из сада.",
                                "tr": "Ani ve yüksek ses kuşları bahçeden <w>ürküttü</w>."
                            }
                        },
                        {
                            "text": "The elephant was <w>frightened</w> by the tiny mice running around.",
                            "target_lang_translations": {
                                "ru": "Слон был <w>напуган</w> крошечными мышами, бегающими вокруг.",
                                "tr": "Fil, etrafta koşturan minik farelerden <w>korktu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scared",
                        "terrified",
                        "startled",
                        "alarmed"
                    ],
                    "antonyms": [
                        "calmed",
                        "reassured",
                        "comforted"
                    ],
                    "common_phrases": [
                        "frightened away",
                        "frightened off"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола frighten (пугать).",
                        "tr": "frighten (korkutmak) fiilinin geçmiş zaman ve geçmiş zaman ortacı hali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испугал",
                                "target_lang_sense_clarification": "заставил почувствовать страх (прошедшее время)"
                            },
                            {
                                "target_lang_word": "напугал",
                                "target_lang_sense_clarification": "вызвал страх (прошедшее время)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "korkuttu",
                                "target_lang_sense_clarification": "korku verdi (geçmiş zaman)"
                            },
                            {
                                "target_lang_word": "ürküttü",
                                "target_lang_sense_clarification": "ani bir şekilde korkuttu (geçmiş zaman)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}