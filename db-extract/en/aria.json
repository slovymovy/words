                "forms": [],
                "senses": [
                    {
                        "sense_id": "2fd8b9c5-d499-3758-b598-a5fbb505e216",
                        "entry_id": "a97b470c-715b-3cc9-b110-89e2c873640b",
                        "glosses": [
                            "A female given name from English."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "271a9dbd-54b3-4380-8231-24d65535c9d7",
                                "sense_id": "2fd8b9c5-d499-3758-b598-a5fbb505e216",
                                "text": "Aria Montgomery burrowed her face in her best friend Alison DiLaurentis's lawn."
                            },
                            {
                                "example_id": "12bb54d7-5eee-4cde-9bdc-5cbfb9366327",
                                "sense_id": "2fd8b9c5-d499-3758-b598-a5fbb505e216",
                                "text": "Aria is not surprised to hear there is an Ardat-Yakshi on the planet. There have been reports of bodies and minds drained in ways only the Ardat-Yakshi are capable of. Aria tells you that Morinth’s last victim was a young human woman who lived in the tenements near Afterlife."
                            }
                        ]
                    }
