                        ]
                    },
                    {
                        "sense_id": "27e1b380-c6fa-39b6-ae1a-f2971eb1881c",
                        "entry_id": "840f356b-efd8-33f7-a0fb-09aae9b31171",
                        "glosses": [
                            "idiom coming from a Slavic language"
