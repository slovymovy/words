                "senses": [
                    {
                        "sense_id": "626c7035-baac-3949-8084-9dfa2ba12724",
                        "entry_id": "1cb0c54f-18cc-3065-b662-28156452f458",
                        "glosses": [
                            "Dépôt minéral dans une grotte dû à l’action de l’eau."
                        ],
                        "tags": [
                            "Spéléologie"
                        ],
                        "examples": [
                            {
                                "example_id": "dd0c5665-7c3a-4b6e-9432-6e14e35aa390",
                                "sense_id": "626c7035-baac-3949-8084-9dfa2ba12724",
                                "text": "Les spéléothèmes sont généralement constitués de carbonate de calcium (calcite, aragonite) apporté en solution par les eaux de percolation."
                            },
                            {
                                "example_id": "9c814770-622e-4c33-90b4-03d60e24c09e",
                                "sense_id": "626c7035-baac-3949-8084-9dfa2ba12724",
                                "text": "Les spéléothèmes sont responsables de l’attrait touristique des cavités souterraines."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca5eee8a-de85-3e2a-9994-f073da87e94e",
                        "entry_id": "1cb0c54f-18cc-3065-b662-28156452f458",
                        "glosses": [
                            "Concrétion calcaire (comme les stalagmites ou stalactites) utilisée comme enregistreur climatique dans les études des climats du passé."
                        ],
                        "tags": [
                            "Paléoclimatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "fc82ceaf-d72e-4a0f-8ffb-e535a011463d",
                                "sense_id": "ca5eee8a-de85-3e2a-9994-f073da87e94e",
                                "text": "Une nouvelle étude s'appuyant sur la datation assez précise de spéléothèmes provenant de la grotte de Kuna-Ba, (...) indique que la période allant de 925 à 725 av. JC environ fut beaucoup plus humide que toutes celles que les Assyriens avaient connues depuis la fin de l'âge de bronze récent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c132fd87-ac02-41bd-b56b-e6dc9864802c",
                        "source_entry_id": "1cb0c54f-18cc-3065-b662-28156452f458",
                        "target_lang_word": "speleothem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speleothem",
