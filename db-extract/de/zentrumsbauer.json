                "senses": [
                    {
                        "sense_id": "85d23720-8ff5-3d16-9efa-48575b575b49",
                        "entry_id": "8de5cc7a-2be6-3f51-84e7-c88ac9fd0e07",
                        "glosses": [
                            "Bauer, der auf der d-Linie oder e-Linie steht, also ein Damenbauer oder ein Königsbauer"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "a1dfa52a-3b66-4026-a1d7-115da915f59b",
                                "sense_id": "85d23720-8ff5-3d16-9efa-48575b575b49",
                                "text": "In der Ausgangsstellung des Schachspiels stehen die weißen Zentrumsbauern auf den Feldern d2 und e2, die schwarzen Zentrumsbauern auf den Feldern d7 und e7."
                            },
                            {
                                "example_id": "b866f2f9-f66f-40f9-b7c9-eb26a78ae64c",
                                "sense_id": "85d23720-8ff5-3d16-9efa-48575b575b49",
                                "text": "„Dies ist eine ungeheuer spannende Positionspartie, in der es sich um den Kampf zweier schwarzer Zentrumsbauern um die bedingungslose Vorherrschaft über das Brett handelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
