                        "glosses": [
                            "A harder or more resistant rock type overlying a weaker or less resistant rock type."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "eea6604d-43eb-43f4-b4ba-4778e8d81b4b",
                                "sense_id": "7bf7d195-226f-351c-a960-6c7877439f52",
                                "text": "Last month, federal scientists said that the company had fallen far behind schedule because a huge rig hired to drill down about 12,000 feet, or more than two miles, on federal land had not been able to pierce surface formations called caprock."
                            },
                            {
                                "example_id": "5ec81621-7813-49e7-ad57-9800af8f5a2a",
                                "sense_id": "7bf7d195-226f-351c-a960-6c7877439f52",
                                "text": "Meanwhile, there were houses going up within gunshot of the caprock."
                            },
                            {
                                "example_id": "fec38844-d8d8-439c-825c-efdba4bf251f",
                                "sense_id": "7bf7d195-226f-351c-a960-6c7877439f52",
                                "text": "This park’s strange and beautiful rock formations were formed by the Yellowstone River and various streams that have cut through the rock over millions of years, carving out hoodoos, spires and caprocks. The name Makoshika comes from a Lakota word for badlands."
                            }
                        ]
                    }
