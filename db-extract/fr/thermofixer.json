                        "glosses": [
                            "Fixer en utilisant la chaleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6a56dc9-6e72-4bd1-bfb0-4d15087ac804",
                                "sense_id": "401ec3e2-4f62-33f0-b9ea-73f1b937a6c6",
                                "text": "Il est préférable de thermofixer au-dessous de 155°C et de laver au-dessous de 75°C, ce qui a été montré par analyse thermique différentielle."
                            },
                            {
                                "example_id": "21904ff1-6a8e-431a-969f-5ca1c41a3f43",
                                "sense_id": "401ec3e2-4f62-33f0-b9ea-73f1b937a6c6",
                                "text": "Il faut qu'on puisse relaxer les jerseys en préservant la régularité des mailles, les sécher, sans flottement des tricots, et les thermofixer en assurant la rectitude des mailles."
                            }
                        ]
                    }
