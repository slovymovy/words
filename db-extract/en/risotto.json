                                "target_senses": [
                                    {
                                        "sense_id": "332c53a2-8e54-3a67-a58f-779e91585f87",
                                        "entry_id": "eb093be0-e63b-3633-8840-2d2c1534d448",
                                        "glosses": [
                                            "Plat italien à base de riz, revenu à l’huile d’olive, puis cuit au bouillon ajouté de façon progressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "310847bb-e3b1-48e4-8856-291c373e91ac",
                                                "sense_id": "332c53a2-8e54-3a67-a58f-779e91585f87",
                                                "text": "Le risotto était superbe. Bébé me dit qu’elle n’avait encore jamais goûté de truffes blanches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58e5c5fd-f7d2-4781-ac0c-072183f4454b",
                        "source_entry_id": "7e1ca8cb-5d72-3b10-bd6b-53abbffe5319",
                        "source_sense_description": "food",
                        "target_lang_word": "Risotto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Risotto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                        "entry_id": "8d24b096-b88a-3b2b-93c4-a8a802c945d9",
                                        "glosses": [
                                            "norditalienisches Gericht mit vielen Variationen, bei dem Rundkornreis zumeist mit Zwiebeln in Fett angedünstet wird und anschließend Brühe hinzugegeben wird, die der Reis aufnimmt; weitere Zutaten sind vielfach Weißwein, Pilze, Tomaten und Parmesan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3967cb0a-91da-4dac-a1c8-d43198c34db7",
                                                "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                                "text": "„Man könnte meinen, mit den Roten Beten, die heute für ein Risotto verarbeitet werden sollen, auf der sicheren Seite zu sein. Aber: Die Roten Bete müssen 90 Minuten oder länger in Wasser köcheln, bis sie gar sind.“"
                                            },
                                            {
                                                "example_id": "08564ef6-0b0a-4556-b0ef-3b732b458ab4",
                                                "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                                "text": "„Ich fuhr kürzlich durch die Po-Ebene, die immerhin den Risotto, den Belcanto und den Grappa hervorgebracht hat, unter anderem durch Seveso, und alles sah aus wie im Rhein-Main-Gebiet.“"
                                            },
                                            {
                                                "example_id": "032e0fb0-aab2-4ffe-af3e-ad371d9c6e24",
                                                "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                                "text": "„Und genau in diesem Spiel der beiden Stärkesorten liegen Segen und Fluch des Risottos, denn das sich absetzende Amylopektin brennt ruckzuck am Topfboden an.“"
                                            },
                                            {
                                                "example_id": "38b6d7bc-37ac-414d-8a92-b0959dea55e3",
                                                "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                                "text": "„Ein richtiger Risotto müsse eben mit Olivenöl durchtränkt sein, stark duften und jede Menge Safran oder Knoblauch vertragen.“"
                                            },
                                            {
                                                "example_id": "96cb5b4c-2033-42e4-af6e-b4a9eb03a272",
                                                "sense_id": "bf47d2bf-6f83-3054-a108-f7b9c5cb6227",
                                                "text": "„Das süße Risotto findet sich überall in Italien auf den Familientischen, meist klassisch mit Milch und frischer Vanille gekocht, schnell und einfach mit gemischten Früchten, Macadamianüssen oder Maronencreme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
