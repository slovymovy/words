                                    {
                                        "sense_id": "1ca47e8e-5755-3dcd-b418-186a4f0811e0",
                                        "entry_id": "ca31f34a-7380-38fb-b885-99f38528a2db",
                                        "glosses": [
                                            "The science that studies the blood serum, and especially the reaction between antigens and antibodies in serum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b23b4afb-19c6-306d-897b-d95ba90c781c",
                                        "entry_id": "ca31f34a-7380-38fb-b885-99f38528a2db",
                                        "glosses": [
                                            "The characteristics of the blood serum in a particular disease or organism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6af18a88-4dcc-3933-a8ec-1c5949188126",
                                        "entry_id": "ca31f34a-7380-38fb-b885-99f38528a2db",
                                        "glosses": [
                                            "A serologic test: a blood test to detect the presence of, and often to measure the amount of, various components of the serum (usually antibodies, antigens, and immune complexes thereof)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "799a9018-0d3d-479a-953f-78e7757be9c2",
                                                "sense_id": "6af18a88-4dcc-3933-a8ec-1c5949188126",
                                                "text": "Diagnosis is presumptive by history and physical examination and is confirmed by serologies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa76a75c-892d-413d-862f-eb84c86237d5",
                        "source_entry_id": "c8df8564-7fee-3a96-b226-387987f50eb8",
