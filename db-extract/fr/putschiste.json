                    }
                ],
                "senses": [
                    {
                        "sense_id": "e1ffab70-d3ed-39a3-b4c1-a5b570bc2db1",
                        "entry_id": "029227d7-3dac-38fb-a769-197bb1e7e730",
                        "glosses": [
                            "Qui participe à un putsch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1119248-c361-43ae-b9e3-a655fa295d64",
                                "sense_id": "e1ffab70-d3ed-39a3-b4c1-a5b570bc2db1",
                                "text": "Les militaires putschistes affirmant avoir pris le pouvoir en Guinée ont promis mercredi d'\"organiser des élections libres fin décembre 2010\"."
                            },
                            {
                                "example_id": "1d3b6879-bd37-49f1-ad9d-42217188a312",
                                "sense_id": "e1ffab70-d3ed-39a3-b4c1-a5b570bc2db1",
                                "text": "L’armée française sans aucun doute avait gagné la bataille sur le plan militaire, cet argument a été souvent utilisé par les généraux putschistes pour justifier leur entrée en dissidence contre de Gaulle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "52ec6dec-94e2-363e-b7eb-5388b9a4d57f",
                "word": "putschiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e116b37a-ee04-4f34-b9ee-e19e39b25ca0",
                        "entry_id": "52ec6dec-94e2-363e-b7eb-5388b9a4d57f",
                        "tags": [
                            "plural"
                        ],
                        "form": "putschistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c052c0c5-d542-3728-906c-86f0a53d8e63",
                        "entry_id": "52ec6dec-94e2-363e-b7eb-5388b9a4d57f",
                        "glosses": [
                            "Participant d’un putsch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9ede969-b9f7-4294-a6db-106e95b50033",
                                "sense_id": "c052c0c5-d542-3728-906c-86f0a53d8e63",
                                "text": "Les putschistes sont maîtres du pays."
                            },
                            {
                                "example_id": "bed1e72e-f4d8-48e2-8a23-3b7f7238fa32",
                                "sense_id": "c052c0c5-d542-3728-906c-86f0a53d8e63",
                                "text": "Laërte aurait donc été un chef de troupe ou un putschiste."
                            },
                            {
                                "example_id": "e734c45e-0a87-45d1-b5d6-729a900d1dbe",
                                "sense_id": "c052c0c5-d542-3728-906c-86f0a53d8e63",
                                "text": "Emmenés par le général Tiani, les putschistes n’ont pas perdu de temps pour tenter d’asseoir leur pouvoir à la tête du Niger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70e6659d-fcbc-43cc-bb39-52e93e1ebaeb",
                        "source_entry_id": "52ec6dec-94e2-363e-b7eb-5388b9a4d57f",
                        "source_sense_id": "c052c0c5-d542-3728-906c-86f0a53d8e63",
                        "source_sense_description": "Participant à un putsch",
                        "target_lang_word": "Putschist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Putschist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                        "entry_id": "ebce70ba-687d-3126-92df-1d39bdc50de7",
                                        "glosses": [
                                            "Person, die einen Putsch plant und/oder durchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f4fb367-fe50-492c-9312-0449815038ae",
                                                "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                                "text": "„Die Putschisten schlugen am 1. November los.“"
                                            },
                                            {
                                                "example_id": "06c558ad-64df-40b2-9103-895119cc4eaa",
                                                "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                                "text": "„Die Putschisten hatten den Flughafen geschlossen, das Telefonnetz der Stadt lahmgelegt, die Zentrale des Polizeihauptquartiers gestürmt, den Regierungssender besetzt und die Zentren der politischen Macht angegriffen.“"
                                            },
                                            {
                                                "example_id": "b0b684f2-3ac6-4c16-a309-7bdde7f920d7",
                                                "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                                "text": "„Nach drei Jahren auf dem Thron wird Iyasus 1916 von Putschisten abgesetzt, seine Truppen unterliegen in mehreren Schlachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed60de82-6df6-4e32-b13d-cbf4b8d5d0ff",
                        "source_entry_id": "52ec6dec-94e2-363e-b7eb-5388b9a4d57f",
                        "source_sense_id": "c052c0c5-d542-3728-906c-86f0a53d8e63",
                        "source_sense_description": "Participant à un putsch",
                        "target_lang_word": "putschist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "putschist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84fb0c17-42be-3586-823e-7f7207e3fdfe",
                                        "entry_id": "394a84dd-4a0f-3c66-97da-9d98aabd9d83",
                                        "glosses": [
                                            "One who participates in a putsch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5993fff-12ab-498a-ada7-94e4dc2e2d4f",
                                                "sense_id": "84fb0c17-42be-3586-823e-7f7207e3fdfe",
                                                "text": "The Forum itself would always, henceforth, wield a strange kind of mesmeric fascination upon the mob demagogue or would-be putschist."
                                            },
                                            {
                                                "example_id": "ee9b61f9-977d-4f0b-a384-4111da70bd3c",
                                                "sense_id": "84fb0c17-42be-3586-823e-7f7207e3fdfe",
                                                "text": "The alleged putschists are said to have taken inspiration from the global QAnon movement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46a16b89-4a28-491b-b32f-93023c06756d",
                        "source_entry_id": "52ec6dec-94e2-363e-b7eb-5388b9a4d57f",
                        "source_sense_id": "c052c0c5-d542-3728-906c-86f0a53d8e63",
                        "source_sense_description": "Participant à un putsch",
                        "target_lang_word": "coupist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coupist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4309e181-a874-3c33-91e5-9ace7f02686f",
                                        "entry_id": "f3e66c9f-f6f3-37a8-a7b1-795cd1de8c9f",
                                        "glosses": [
                                            "One who takes part in a coup d'état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b886957-6979-4a6e-aad9-6a019c60197c",
                                                "sense_id": "4309e181-a874-3c33-91e5-9ace7f02686f",
                                                "text": "Our first stage was Cheragas; and, after passing the Trappist establishment at Staouëli, where the French fought their first battle, and Sidi-Ferruch, where they landed, we again changed horses at Douaouda. Here we deposited our fellow-coupist."
                                            },
                                            {
                                                "example_id": "28e36201-4266-436e-acc0-fb69c980460e",
                                                "sense_id": "4309e181-a874-3c33-91e5-9ace7f02686f",
                                                "text": "Besides preparing plans of attack, the coupist officers took measures to meet the problem of anti-coupism in their services."
                                            },
                                            {
                                                "example_id": "6d773a87-e1db-43cc-b6c4-e6c7ce680f90",
                                                "sense_id": "4309e181-a874-3c33-91e5-9ace7f02686f",
                                                "text": "Either by design or default, Lieutenant Colonel Odumegwu-Ojukwu held on to 5 Infantry Battalion and refused to cooperate with the coupists, particularly in their bid to obtain money from Kano Central Bank under the pretext of settling troops salaries by intercepting the aircraft sent to Kano by [Chukwuma Kaduna] Nzeogwu for that purpose on Monday 17 January 1966."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e25762e4-26b7-4b4a-bc87-8c7995aaab02",
                        "source_entry_id": "52ec6dec-94e2-363e-b7eb-5388b9a4d57f",
