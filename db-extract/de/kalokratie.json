                        "sense_id": "10d45fdf-f1ce-37a7-a274-305213d10b6a",
                        "entry_id": "2cb0422a-0229-304c-beb3-93b56efe4726",
                        "glosses": [
                            "Macht der Schönheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7c35593-28fe-4606-bc81-bd306d9c8fcb",
                                "sense_id": "10d45fdf-f1ce-37a7-a274-305213d10b6a",
                                "text": "„Die neoliberale Kalokratie erzeugt Zwänge.“"
                            },
                            {
                                "example_id": "39c4d391-54a4-4ff2-b990-506081a77e68",
                                "sense_id": "10d45fdf-f1ce-37a7-a274-305213d10b6a",
                                "text": "Ich möchte sagen: die Kalokratie, die Herrschaft des Schönen, d. h. ein Leben, wo alles Gute in seiner reinsten Form erschiene."
                            },
                            {
                                "example_id": "ec4ffce5-8d98-4aa0-a5bf-94f1963273d4",
                                "sense_id": "10d45fdf-f1ce-37a7-a274-305213d10b6a",
                                "text": "Deren Ikonen, die langbeinigen Supermodels und verträumten Rockstars, bringen die Macht der Schönheit, Kalokratie, wie die Griechen sie nannten, auf globales Niveau."
                            },
                            {
                                "example_id": "ac1d49db-0cd4-49c7-b931-16de5364d40f",
                                "sense_id": "10d45fdf-f1ce-37a7-a274-305213d10b6a",
                                "text": "„Wird nicht in solcher poetischen Kalokratie der Autor im Grunde zum Untertanen des Herrschaftssystems seiner Werkprozesse verurteilt?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
