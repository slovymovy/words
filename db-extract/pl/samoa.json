                                                "example_id": "d3611a73-12b7-434b-bf7b-f2903c29eb02",
                                                "sense_id": "68a83a40-a7d5-3634-ad84-ce9c5c49c46c",
                                                "text": "Apia ist die Hauptstadt von Samoa."
                                            },
                                            {
                                                "example_id": "17db63dd-bb47-44e6-9cd1-182fa5a3b16c",
                                                "sense_id": "68a83a40-a7d5-3634-ad84-ce9c5c49c46c",
                                                "text": "„Um 500 n. Chr. kamen polynesische Einwanderer von Samoa und Tonga nach Tuvalu.“"
