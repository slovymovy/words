{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d0c9fa0-7377-373a-8870-ef97f57ce68b",
                    "sense_definition": "A long, narrow container used for feeding or watering animals.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer filled the <w>trough</w> with fresh water for the thirsty horses.",
                            "target_lang_translations": {
                                "ru": "Фермер наполнил <w>корыто</w> свежей водой для изнывающих от жажды лошадей.",
                                "zh": "农夫往<w>槽</w>里注满了清水，供口渴的马儿饮用。",
                                "tr": "Çiftçi, susamış atlar için <w>yalağı</w> taze suyla doldurdu."
                            }
                        },
                        {
                            "text": "The pigs gathered around the <w>trough</w> to eat their morning meal.",
                            "target_lang_translations": {
                                "ru": "Свиньи собрались вокруг <w>корыта</w>, чтобы съесть свой утренний корм.",
                                "zh": "猪群围在<w>食槽</w>旁吃它们的早餐。",
                                "tr": "Domuzlar sabah yemlerini yemek için <w>yemliğin</w> etrafında toplandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "manger"
                    ],
                    "common_phrases": [
                        "feeding trough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная узкая ёмкость для кормления или поения животных.",
                        "zh": "一种用于喂养或给动物饮水的长条形容器。",
                        "tr": "Hayvanları beslemek veya sulamak için kullanılan uzun, dar kap."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корыто",
                                "target_lang_sense_clarification": "открытая продолговатая ёмкость для корма скота"
                            },
                            {
                                "target_lang_word": "кормушка",
                                "target_lang_sense_clarification": "оборудование для подачи корма животным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "槽",
                                "target_lang_sense_clarification": "用于盛放饲料或水的长形容器"
                            },
                            {
                                "target_lang_word": "食槽",
                                "target_lang_sense_clarification": "专门用于喂食牲畜的槽"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yalak",
                                "target_lang_sense_clarification": "hayvanların su içtiği taş veya ahşap oyuk tekne"
                            },
                            {
                                "target_lang_word": "yemlik",
                                "target_lang_sense_clarification": "hayvanlara yem verilen kap"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c2004ac-34ac-3928-b695-7f9a3f7a9709",
                    "sense_definition": "A gutter under the eaves of a building that collects rainwater.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>trough</w> was clogged with dead leaves and needed to be cleaned out.",
                            "target_lang_translations": {
                                "ru": "<w>Водосточный жёлоб</w> был забит сухими листьями, и его нужно было прочистить.",
                                "zh": "<w>排水槽</w>被枯叶堵住了，需要清理一下。",
                                "tr": "<w>Çatı oluğu</w> kuru yapraklarla tıkanmıştı ve temizlenmesi gerekiyordu."
                            }
                        },
                        {
                            "text": "Water overflowed from the <w>trough</w> during the heavy rainstorm.",
                            "target_lang_translations": {
                                "ru": "Во время сильного ливня вода переливалась через край <w>жёлоба</w>.",
                                "zh": "暴雨期间，雨水从<w>天沟</w>里溢了出来。",
                                "tr": "Şiddetli fırtınada su <w>oluktan</w> taştı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eaves trough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жёлоб под краем крыши здания для сбора дождевой воды.",
                        "zh": "建筑物屋檐下用于收集雨水的槽。",
                        "tr": "Bir binanın saçaklarının altında yağmur suyunu toplayan oluk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водосточный жёлоб",
                                "target_lang_sense_clarification": "приспособление для стока воды с крыши"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排水槽",
                                "target_lang_sense_clarification": "安装在屋檐下用于引流雨水的装置"
                            },
                            {
                                "target_lang_word": "天沟",
                                "target_lang_sense_clarification": "建筑屋面用于汇集雨水的沟槽"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çatı oluğu",
                                "target_lang_sense_clarification": "saçak altındaki yağmur suyu oluğu"
                            },
                            {
                                "target_lang_word": "oluk",
                                "target_lang_sense_clarification": "su tahliye kanalı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60f8fa8a-e69f-3afd-89af-d5c510e577b1",
                    "sense_definition": "The low point between two waves or ridges.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "low_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat dipped into the <w>trough</w> between two large ocean waves.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка погрузилась во <w>впадину</w> между двумя большими океанскими волнами.",
                                "zh": "小船沉入了两个大洋浪之间的<w>波谷</w>。",
                                "tr": "Küçük tekne, iki büyük okyanus dalgası arasındaki <w>dalga çukuruna</w> battı."
                            }
                        },
                        {
                            "text": "The ship rose to the crest and then fell into the <w>trough</w>.",
                            "target_lang_translations": {
                                "ru": "Корабль поднялся на гребень, а затем упал во <w>впадину</w>.",
                                "zh": "船只升上浪尖，随后又跌入<w>低谷</w>。",
                                "tr": "Gemi dalganın tepesine yükseldi ve ardından <w>çukuruna</w> düştü."
                            }
                        }
                    ],
                    "antonyms": [
                        "peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкая точка между двумя волнами или гребнями.",
                        "zh": "两波浪或山脊之间的最低点。",
                        "tr": "İki dalga veya sırt arasındaki en alçak nokta."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впадина",
                                "target_lang_sense_clarification": "углубление между волнами"
                            },
                            {
                                "target_lang_word": "ложбина",
                                "target_lang_sense_clarification": "понижение между гребнями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波谷",
                                "target_lang_sense_clarification": "波浪运动中最低的位置"
                            },
                            {
                                "target_lang_word": "低谷",
                                "target_lang_sense_clarification": "地形或波动中的凹陷处"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dalga çukuru",
                                "target_lang_sense_clarification": "dalgalar arasındaki en alçak kısım"
                            },
                            {
                                "target_lang_word": "çukur",
                                "target_lang_sense_clarification": "iki tümsek arasındaki alçak yer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41f3ec2f-c193-3fbb-a143-7e8a3e277b40",
                    "sense_definition": "A low point or minimum level in a business or economic cycle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "low_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economy reached a <w>trough</w> before finally starting to recover.",
                            "target_lang_translations": {
                                "ru": "Экономика достигла <w>дна</w>, прежде чем наконец начала восстанавливаться.",
                                "zh": "经济在最终开始复苏前触及了<w>谷底</w>。",
                                "tr": "Ekonomi nihayet toparlanmaya başlamadan önce <w>dibe</w> vurdu."
                            }
                        },
                        {
                            "text": "Investors are waiting for the market to hit its <w>trough</w> before buying.",
                            "target_lang_translations": {
                                "ru": "Инвесторы ждут, когда рынок достигнет своего <w>минимума</w>, прежде чем покупать.",
                                "zh": "投资者们正等待市场跌至<w>最低点</w>后再入场购买。",
                                "tr": "Yatırımcılar satın almadan önce piyasanın <w>en düşük seviyeyi</w> görmesini bekliyor."
                            }
                        }
                    ],
                    "antonyms": [
                        "peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низшая точка или минимальный уровень в деловом или экономическом цикле.",
                        "zh": "商业或经济周期中的最低点或最低水平。",
                        "tr": "Bir iş veya ekonomik döngüdeki en düşük nokta ya da dip seviye."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дно",
                                "target_lang_sense_clarification": "самая низкая точка экономического спада"
                            },
                            {
                                "target_lang_word": "минимум",
                                "target_lang_sense_clarification": "низшая точка цикла"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谷底",
                                "target_lang_sense_clarification": "经济衰退或市场表现的最低点"
                            },
                            {
                                "target_lang_word": "最低点",
                                "target_lang_sense_clarification": "周期性波动中的极小值"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dip",
                                "target_lang_sense_clarification": "ekonomik döngünün en alt seviyesi"
                            },
                            {
                                "target_lang_word": "en düşük seviye",
                                "target_lang_sense_clarification": "ekonomideki asgari düzey"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1ff1842-745b-3ba2-96a5-b9a3ab46a660",
                    "sense_definition": "To eat in a greedy or vulgar manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>troughed</w> his dinner as if he had not eaten for days.",
                            "target_lang_translations": {
                                "ru": "Он <w>лопал</w> свой обед так, будто не ел несколько дней.",
                                "zh": "他<w>狼吞虎咽</w>地吃着晚餐，好像好几天没吃过饭一样。",
                                "tr": "Günlerdir hiçbir şey yememiş gibi akşam yemeğini <w>tıkındı</w>."
                            }
                        },
                        {
                            "text": "The guests <w>troughed</w> through the buffet table without any manners.",
                            "target_lang_translations": {
                                "ru": "Гости <w>жрали</w> за шведским столом, совершенно не соблюдая манер.",
                                "zh": "客人们毫无礼貌地在自助餐桌前<w>大吃大喝</w>。",
                                "tr": "Konuklar hiç görgü kuralı gözetmeksizin açık büfeyi <w>tıkabasa yediler</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to imply gluttony."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Есть жадно или невоспитанно.",
                        "zh": "贪婪或粗鲁地进食。",
                        "tr": "Açgözlüce veya görgüsüzce yemek yemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лопать",
                                "target_lang_sense_clarification": "разговорное, есть много и жадно"
                            },
                            {
                                "target_lang_word": "жрать",
                                "target_lang_sense_clarification": "грубое, есть очень жадно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狼吞虎咽",
                                "target_lang_sense_clarification": "形容吃东西又急又猛"
                            },
                            {
                                "target_lang_word": "大吃大喝",
                                "target_lang_sense_clarification": "形容毫无节制地进食"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tıkınmak",
                                "target_lang_sense_clarification": "oburca ve hızla yemek"
                            },
                            {
                                "target_lang_word": "tıkabasa yemek",
                                "target_lang_sense_clarification": "açgözlülükle çok miktarda yemek"
                            },
                            {
                                "target_lang_word": "tıkıştırmak",
                                "target_lang_sense_clarification": "görgüsüzce ve aceleyle mideye indirmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}