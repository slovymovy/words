                        "entry_id": "9a6bf930-b0fe-36f3-9b01-51a59e9a042d",
                        "glosses": [
                            "Gargoulette, vase poreux en terre, pour rafraichir l’eau."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8d16d31a-d29a-4a95-8ea9-521578b0f8e8",
                                "sense_id": "60084c9c-1805-3af2-b3b4-d70908fd07dd",
                                "text": "On fait dans cette ville des bardaques ou pots à-l’eau, très-estimés au Caire pour leur façon & pour la qualité qu’ils ont de rafraîchir l’eau."
                            },
                            {
                                "example_id": "d2480a43-fb7c-4126-9e65-350f231696f6",
                                "sense_id": "60084c9c-1805-3af2-b3b4-d70908fd07dd",
                                "text": "A Kéné, ville avec mosquées et bazar, où l’on fabrique les bardaques, petits vases à formes variées, où l’eau se tient fraîche, placées dans un courant d’air."
                            }
                        ]
                    }
