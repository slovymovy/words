                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5a2ff2b7-745b-4df9-b9db-f421875918c2",
                        "entry_id": "a5f36642-384c-3879-864c-00c8b0187dc7",
                        "tags": [
