                        "target_lang_word": "housewife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "housewife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b71a368d-0324-327c-915a-91dd24f47e73",
                                        "entry_id": "d9d4c82d-a132-3f02-8926-d8bf76005168",
                                        "glosses": [
                                            "A woman whose main employment is homemaking, maintaining the upkeep of her home and tending to household affairs; often, such a woman whose sole [unpaid] employment is homemaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510ecf74-b592-4305-bbca-6d11db1a032d",
                                                "sense_id": "b71a368d-0324-327c-915a-91dd24f47e73",
                                                "text": "2000, Uli Kusch, \"Mr. Torture\", Helloween, The Dark Ride\nMr Torture sells pain / To the housewives in Spain / He knows just what they crave / Mr Torture"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "314e8e25-70c7-30ad-82da-488e12772450",
                                        "entry_id": "d9d4c82d-a132-3f02-8926-d8bf76005168",
                                        "glosses": [
                                            "The wife of a householder; the mistress of a family; the female head of a household."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57a78d96-8f9c-3687-993b-76bd5f24114f",
                                        "entry_id": "d9d4c82d-a132-3f02-8926-d8bf76005168",
                                        "glosses": [
                                            "A little case or bag for materials used in sewing, and for other articles of female work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5cc0235-8a9a-4368-9aa1-e12aefe9ef71",
                                                "sense_id": "57a78d96-8f9c-3687-993b-76bd5f24114f",
                                                "text": "It was a housewife, containing needles, a bodkin, and thread; ‘and, do you know,’ added he, ‘it was the most useful thing she could have given me, for it lasted all the time I was at Rome to mend my clothes with […].’"
                                            },
                                            {
                                                "example_id": "28ea052f-5ef7-4ad5-a14f-27bf1eb29d08",
                                                "sense_id": "57a78d96-8f9c-3687-993b-76bd5f24114f",
                                                "text": "Woffington's housewife, made by herself, homely to the eye, but holds everything in the world"
                                            },
                                            {
                                                "example_id": "3eb0a422-8cd8-4ac9-802d-a52da2a47131",
                                                "sense_id": "57a78d96-8f9c-3687-993b-76bd5f24114f",
                                                "text": "The \"soldier's housewife\" was a small sewing kit that was carried to make timely repairs to clothing and equipment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f8429ea-80c9-328e-a31f-58f2c17ed534",
                                        "entry_id": "d9d4c82d-a132-3f02-8926-d8bf76005168",
                                        "glosses": [
                                            "A worthless woman; a hussy."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "housewife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c784e2c0-94c3-3e6a-834e-edeae01c58bd",
                                        "entry_id": "4cbbea62-61ff-3a33-9fcd-10bf7ead4b57",
                                        "glosses": [
                                            "Alternative form of housewive."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94de3f22-f60c-4f57-bca9-c53a40eeec0f",
                                                "sense_id": "c784e2c0-94c3-3e6a-834e-edeae01c58bd",
                                                "text": "Career opportunity […] is the one who never knocks — especially not on the doors of women, who are still hooking, housewifing and hairdressing for their livings."
                                            }
                                        ]
                                    }
                                ]
                            }
