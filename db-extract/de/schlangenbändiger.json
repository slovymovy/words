                "senses": [
                    {
                        "sense_id": "ea4b78d2-4551-3766-985e-06f9297eedf7",
                        "entry_id": "11056a06-b64b-39d8-80f2-340feb597742",
                        "glosses": [
                            "Person, die Schlangen dressiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b1fa7d1-2814-4c8c-8ea2-1ff1250ce7ed",
                                "sense_id": "ea4b78d2-4551-3766-985e-06f9297eedf7",
                                "text": "„Sobald du einschläfst, übernehme ich und gehe zur Arbeit, zum Fight Club oder sonstwohin. Du kannst froh sein, dass ich keinen Job als Schlangenbändiger bekommen habe.“"
                            },
                            {
                                "example_id": "7c7176bf-b0fe-46c1-88e4-a88bce869417",
                                "sense_id": "ea4b78d2-4551-3766-985e-06f9297eedf7",
                                "text": "„Dann trugen sie die größte Kobra, die ich je in meinem Leben gesehen habe, herein und versuchten, sie mit Haken in Schach zu halten - du weißt schon, diese Schlangenhaken, die Schlangenbändiger benutzen, damit das Tier sie nicht beißt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
