    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c03a818-c3e9-32f9-8c8f-23736f56a11f",
                    "sense_definition": "Официальное удостоверение личности (например, паспорт, водительские права).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Полицейский попросил меня предъявить <w>документы</w>.",
                            "target_lang_translations": {
                                "en": "The police officer asked me to show my <w>documents</w>.",
                                "fr": "Le policier m'a demandé de présenter mes <w>papiers</w>."
                            }
                        },
                        {
                            "text": "Без <w>документов</w> вы не сможете купить билет на самолёт.",
                            "target_lang_translations": {
                                "en": "Without <w>documents</w>, you cannot buy a plane ticket.",
                                "fr": "Sans <w>papiers</w>, vous ne pourrez pas acheter de billet d'avion."
                            }
                        }
                    ],
                    "common_phrases": [
                        "предъявить документы",
                        "проверка документов",
                        "документы на машину"
                    ],
                    "target_lang_definitions": {
                        "en": "An official proof of identity (e.g., passport, driver's license).",
                        "fr": "Pièce officielle attestant de l'identité d'une personne (par exemple, passeport, permis de conduire)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ID",
                                "target_lang_sense_clarification": "common abbreviation for identification documents"
                            },
                            {
                                "target_lang_word": "papers",
                                "target_lang_sense_clarification": "official documents proving identity"
                            },
                            {
                                "target_lang_word": "document",
                                "target_lang_sense_clarification": "formal term for an official paper"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "papiers",
                                "target_lang_sense_clarification": "documents d'identité ou administratifs personnels"
                            },
                            {
                                "target_lang_word": "pièce d'identité",
                                "target_lang_sense_clarification": "titre officiel prouvant l'identité"
                            },
                            {
                                "target_lang_word": "document",
                                "target_lang_sense_clarification": "pièce justificative officielle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28a23193-be91-3b57-be6f-4396741456b5",
                    "sense_definition": "Файл с текстом или данными, созданный в компьютерной программе.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не забудьте сохранить <w>документ</w> перед закрытием программы.",
                            "target_lang_translations": {
                                "en": "Don't forget to save the <w>document</w> before closing the program.",
                                "fr": "N'oubliez pas d'enregistrer le <w>document</w> avant de fermer le programme."
                            }
                        },
                        {
                            "text": "Я отправил вам текстовый <w>документ</w> по электронной почте.",
                            "target_lang_translations": {
                                "en": "I sent you a text <w>document</w> via email.",
                                "fr": "Je vous ai envoyé un <w>document</w> texte par e-mail."
                            }
                        }
                    ],
                    "common_phrases": [
