                                        "examples": [
                                            {
                                                "example_id": "468cf00b-0eff-49bb-a188-aac9f3376faf",
                                                "sense_id": "6b955f76-22fe-31a3-b79e-577bcd94a9d2",
                                                "text": "In unserem Mexiko-Urlaub besuchten wir auch Tequila."
