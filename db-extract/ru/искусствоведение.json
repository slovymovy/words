                    },
                    {
                        "translation_id": "46db296f-ba6e-4ffa-bee0-ddc49f620c0f",
                        "source_entry_id": "6dc68ff0-7461-3532-8569-265acc76abc9",
                        "source_sense_id": "7fcc6c73-ede8-3b86-8aa6-6d287c311e53",
                        "target_lang_word": "Kunstwissenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kunstwissenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "430bb935-ad1e-3669-a6b2-fb57818fd787",
                                        "entry_id": "b679b09b-a9aa-3f71-9d01-965c61df5e64",
                                        "glosses": [
                                            "Wissenschaft von der bildenden Kunst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ddabc8-bfdd-42d1-b81c-0952d5402806",
                                                "sense_id": "430bb935-ad1e-3669-a6b2-fb57818fd787",
                                                "text": "Selbst getragen hat er es angeblich nur ein einziges Mal, aber van Gogh wollte in den Schuhen auch nicht laufen, er wollte sie malen. Daraus wurden die berühmtesten Schuhe der Kunstwissenschaft und das Lieblingsobjekt der philosophischen Ästhetik."
                                            },
                                            {
                                                "example_id": "659d5476-a573-4116-ae4a-f7cd7fb8f519",
                                                "sense_id": "430bb935-ad1e-3669-a6b2-fb57818fd787",
                                                "text": "Nichts deutet darauf hin, dass er es in Aby Warburg mit einer Gründerfigur der Kunstwissenschaft des 20. Jahrhunderts zu tun hat, die auf einem umfassenden kulturanthropologischen Wissen vom Menschen beruht."
                                            },
                                            {
                                                "example_id": "cd60edcf-9803-415d-90d2-0dad05ad1c40",
                                                "sense_id": "430bb935-ad1e-3669-a6b2-fb57818fd787",
                                                "text": "Was Bénédicte Savoy, seit 2009 Professorin am Institut für Kunstwissenschaft der Technischen Universität Berlin, bei ihrer Suche in Pariser Archiven entdeckt hat, ist der Nachlass des langjährigen Direktors der Altertümerverwaltung in Kairo, Pierre Lacau."
                                            },
                                            {
                                                "example_id": "622ff374-f371-4e8a-bcce-3ecd1ef2582f",
                                                "sense_id": "430bb935-ad1e-3669-a6b2-fb57818fd787",
                                                "text": "Frauenfeindlichkeit - das findet man zwar immer noch. Sie ist aber glücklicherweise auf dem Rückzug. Sogar in der Kunstwissenschaft, lange ein Hort konservierender Weltsicht."
                                            },
                                            {
                                                "example_id": "92c4eb3a-d305-4144-a926-4a3ed119b58f",
                                                "sense_id": "430bb935-ad1e-3669-a6b2-fb57818fd787",
                                                "text": "Die Salzburgerin Hildegund Amanshauser, bis 2008 Professorin für Kunstwissenschaft in Münster, hat die „vehemente aggressive Ablehnung, die die zeitgenössische Kunst im Salzburger Stadtraum erfährt“, wiederholt kritisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
