                        "source_sense_description": "Kosename, für einen Jungen oder jungen Mann: mein Lieber, mein Süßer",
                        "target_lang_word": "hartenboer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hartenboer",
