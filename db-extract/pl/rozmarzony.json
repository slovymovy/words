                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee91b187-d30b-46c4-a2e8-def5a9390d37",
                        "source_entry_id": "f13bbc47-bbef-3030-b736-6cdc13bdcfdb",
                        "source_sense_id": "ed0fb764-2193-34d7-9892-c35c8e3b6604",
                        "target_lang_word": "dreamy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreamy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a59ffee-02b0-3174-9c27-a3e3028546c8",
                                        "entry_id": "5820fd43-3e8c-3f5c-8243-99a6761ec6fb",
                                        "glosses": [
                                            "As in a dream; resembling a dream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "316d742f-d899-4964-96d3-cd95f5dc2229",
                                                "sense_id": "2a59ffee-02b0-3174-9c27-a3e3028546c8",
                                                "text": "It's so dreamy / Oh, fantasy free me / So you can't see me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1897563d-eeb9-3db2-9094-29b8767d78bf",
                                        "entry_id": "5820fd43-3e8c-3f5c-8243-99a6761ec6fb",
                                        "glosses": [
                                            "Sexy; handsome; attractive."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec352b25-dbf0-4eb7-873a-6de9347b2bd2",
                                                "sense_id": "1897563d-eeb9-3db2-9094-29b8767d78bf",
                                                "text": "I love the doctor in that American TV show: he is so dreamy!"
                                            },
                                            {
                                                "example_id": "1cfa4667-c763-4286-9fe6-08d3ca370f36",
                                                "sense_id": "1897563d-eeb9-3db2-9094-29b8767d78bf",
                                                "text": "He is dreamy, sex-bomb cute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20af9391-39ec-36d3-9467-1dcd3de21682",
                                        "entry_id": "5820fd43-3e8c-3f5c-8243-99a6761ec6fb",
                                        "glosses": [
                                            "Having a pleasant or romantic atmosphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b42946b1-0ccf-4f63-8a71-900dec107d46",
                                                "sense_id": "20af9391-39ec-36d3-9467-1dcd3de21682",
                                                "text": "That place was so dreamy!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c92e529a-f5aa-3baf-b70b-24c5668969cd",
                                        "entry_id": "5820fd43-3e8c-3f5c-8243-99a6761ec6fb",
                                        "glosses": [
                                            "Tending to dream or daydream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fd46a14-e14a-40a1-a1fb-b338afbfcb89",
                                                "sense_id": "c92e529a-f5aa-3baf-b70b-24c5668969cd",
                                                "text": "Cocktails and moonlit nights / That dreamy look in your eye / Give me a tropical contact high"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d417fa0f-c3d0-4600-af42-d64a996d009b",
                        "source_entry_id": "f13bbc47-bbef-3030-b736-6cdc13bdcfdb",
                        "source_sense_id": "ed0fb764-2193-34d7-9892-c35c8e3b6604",
                        "target_lang_word": "moony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a5b1bfb-5bb5-387c-85a0-cb12602cb899",
                                        "entry_id": "93718c48-17c5-39d2-9924-cd6be80437e7",
                                        "glosses": [
                                            "Resembling the moon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90925ada-0546-47d8-b80c-abb28653754c",
                                                "sense_id": "2a5b1bfb-5bb5-387c-85a0-cb12602cb899",
                                                "text": "(Her white throat whiter than a moony pearl / Just threaded with a blue vein’s tapestry / Had not yet ceased to throb, and still her breast / Swayed like a wind-stirred lily in ambiguous unrest)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d00b446-a65e-32dd-ae77-0cef320b83db",
                                        "entry_id": "93718c48-17c5-39d2-9924-cd6be80437e7",
                                        "glosses": [
                                            "Moonlit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c24e0338-6bda-4cbe-a5d1-933439c1ecda",
                                                "sense_id": "3d00b446-a65e-32dd-ae77-0cef320b83db",
                                                "text": "It was an extraordinary sight. Even the light was extraordinary, a kind of reddy-coloured twilight, on account of the streamers of seaweed that floated up on either side of the ship. And far overhead just a moony, deep green-blue."
                                            },
                                            {
                                                "example_id": "c8f0bb79-68a4-4b53-b1bd-310a0ef48780",
                                                "sense_id": "3d00b446-a65e-32dd-ae77-0cef320b83db",
                                                "text": "And oft at midnight’s moony scene\nA faded form of ghastly mien\nAcross the waves doth glide;\nAnd oft upon the passing gales\nA plaintive voice the ear assails,\nWhen wand’ring by the tide."
                                            },
                                            {
                                                "example_id": "6403dadc-162e-4303-bbb0-655efe119440",
                                                "sense_id": "3d00b446-a65e-32dd-ae77-0cef320b83db",
                                                "text": "I peered at his rather featureless face through the moony twilight; and then he suddenly rose and paced the path with the impatience of a schoolboy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00d7b1aa-d3a3-387d-ae55-83225173cdf5",
                                        "entry_id": "93718c48-17c5-39d2-9924-cd6be80437e7",
                                        "glosses": [
                                            "Absent-minded."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "054a744b-4ce7-4c49-b94f-93496e40381f",
                                                "sense_id": "00d7b1aa-d3a3-387d-ae55-83225173cdf5",
                                                "text": "“Well, ain’t it strange? Why, Aunt Polly, he was always so good and kind and moony and absent-minded and chuckle-headed and lovable—why, he was just an angel! What CAN be the matter of him, do you reckon?”"
                                            },
                                            {
                                                "example_id": "e303cf4b-0770-4b2b-969c-6f7cc324360e",
                                                "sense_id": "00d7b1aa-d3a3-387d-ae55-83225173cdf5",
                                                "text": "Less violent, but no less eerie, was a teenage girl with Down’s syndrome who suddenly lolloped up to me on a sidewalk in Tacoma, Washington – I being then a morose and moony college student – and kissed me on the cheek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f39a9c3-6c5f-33f8-928a-b62cbe77b5d4",
                                        "entry_id": "93718c48-17c5-39d2-9924-cd6be80437e7",
                                        "glosses": [
                                            "Silly; sentimental; mooning over something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b085f7f0-5d09-491d-a437-f5efe657349e",
                                                "sense_id": "3f39a9c3-6c5f-33f8-928a-b62cbe77b5d4",
                                                "text": "In one of his earliest known paintings, A Carnival Evening, which was shown at the Salon des Independants in 1886, the clown may reflect the influence of Watteau, the clown's girlfriend perhaps was taken from an advertisement for chocolates, the lacy tangle of branches in the trees possibly echoes a postcard photograph of the Bois de Boulogne. They all fit together in a moony atmosphere which is the Duanier's own."
                                            },
                                            {
                                                "example_id": "3aeb2333-f534-4dae-bdf0-486ee7b7db44",
                                                "sense_id": "3f39a9c3-6c5f-33f8-928a-b62cbe77b5d4",
