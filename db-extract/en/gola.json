                        "sense_id": "dd0c686c-64a0-3f90-91ed-f9389a09e115",
                        "entry_id": "f70fc395-bef7-3320-b590-7494f9dd7bee",
                        "glosses": [
                            "A language spoken in eastern Liberia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8b39d7d-dfaa-438f-8d14-524edbcc38c4",
                                "sense_id": "dd0c686c-64a0-3f90-91ed-f9389a09e115",
                                "text": "Most De speak Gola fluently and many also speak Vai."
                            },
                            {
                                "example_id": "795786d6-8622-4d7d-b502-e5902a655598",
                                "sense_id": "dd0c686c-64a0-3f90-91ed-f9389a09e115",
                                "text": "Nevertheless, some still remember how to speak Gola, occasionally uphold their Gola origins, and seem to reflect them in the orientation of certain social values."
                            },
                            {
                                "example_id": "fa779ca1-94da-4c9e-8323-ca81597ca7a2",
                                "sense_id": "dd0c686c-64a0-3f90-91ed-f9389a09e115",
                                "text": "The Gola live on the border with Liberia in the provinces of Kenema and Pujehun. They number about 9000, speak Gola and practice Islam […]"
                            }
                        ]
                    }
