                "senses": [
                    {
                        "sense_id": "3ce26610-4837-3b88-b9c1-a336f1313b82",
                        "entry_id": "f173c991-e983-300b-ba67-700065b91b4a",
                        "glosses": [
                            "weibliche Person, die Stenographie beherrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a06e802-ecac-4b23-bc28-68b9c7f8953a",
                                "sense_id": "3ce26610-4837-3b88-b9c1-a336f1313b82",
                                "text": "„Er hetzte an Frisiersalons und Telefonzellen vorbei, durchquerte zuerst den türkischen, dann den arabischen Saal und landete schließlich in einem Diktierraum, wo Geschäftsleute in bequemen Sesseln die Dienste hauseigener Stenotypistinnen in Anspruch nahmen.“"
                            },
                            {
                                "example_id": "473236e9-f274-4228-9e5c-e3e74fd900bc",
                                "sense_id": "3ce26610-4837-3b88-b9c1-a336f1313b82",
                                "text": "„Ditti meldete sich anschließend freiwillig als Wehrmachtshelferin und wurde in Berlin zur Fernschreiberin und Stenotypistin ausgebildet – was sie später für meinen Vater sehr nützlich machte, denn sie tippte stets seine sämtlichen Manuskripte ab, viele Zehntausende von Seiten.“"
                            },
                            {
                                "example_id": "7e0f9693-9f0b-41fb-9a6b-b29a65444483",
                                "sense_id": "3ce26610-4837-3b88-b9c1-a336f1313b82",
                                "text": "„Was genau meine Mutter machte, die vorher einmal Stenotypistin gewesen war und Kurzschrift beherrschte, weiß ich nicht genau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
