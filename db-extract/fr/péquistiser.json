                        "sense_id": "49ff80e5-039c-3c5b-9165-22e54cd0ee90",
                        "entry_id": "7ad3c1e2-525b-3760-8da6-3447dfea3be9",
                        "glosses": [
                            "Donner un caractère péquiste à."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "c24e0345-eca7-41f5-97bd-4d5cee94bf75",
                                "sense_id": "49ff80e5-039c-3c5b-9165-22e54cd0ee90",
                                "text": "Mais il faudrait pas trop « péquistiser » la chose."
                            },
                            {
                                "example_id": "723a5d5a-6e49-40a0-860c-0c45cfe20d20",
                                "sense_id": "49ff80e5-039c-3c5b-9165-22e54cd0ee90",
                                "text": "L'erreur du PQ a été d'intenter un procès en patriotisme à des gens qui avaient eu le défaut de ne rien trouver de bon dans le Québec péquistisé du souverainisme"
                            },
                            {
                                "example_id": "9505bd22-bc8f-4ddb-bbab-8370fb5e665b",
                                "sense_id": "49ff80e5-039c-3c5b-9165-22e54cd0ee90",
                                "text": "De plus en plus de fédéralistes québécois acceptent le bilinguisme pour éviter d'être identifiés au discours «péquistisé» de la loi 101."
                            }
                        ]
