                                    {
                                        "sense_id": "99b0e956-7053-3e7d-9590-232a637798bf",
                                        "entry_id": "41672530-0f65-3870-b516-996663215b75",
                                        "glosses": [
                                            "A member of the Wikimedia movement; especially, a volunteer contributor to it, as contrasted with a Wikimedia Foundation employee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e08dca4-6406-4594-8d03-8bbe0c1770f1",
                                                "sense_id": "99b0e956-7053-3e7d-9590-232a637798bf",
                                                "text": "The museums asked Wikimedians to provide the institutions with lists of thematic topics that required illustration."
                                            },
                                            {
                                                "example_id": "dca18a05-c518-456a-ade1-038e7a4ebdfd",
                                                "sense_id": "99b0e956-7053-3e7d-9590-232a637798bf",
                                                "text": "Trusted Wikimedians could apply for one of the many levels of volunteer stewardship, receive administrator rights, and then move on to become “bureaucrats” and eventually “stewards.”"
                                            },
                                            {
                                                "example_id": "46e493f6-f20f-4a9c-ace0-fc07a8318fff",
                                                "sense_id": "99b0e956-7053-3e7d-9590-232a637798bf",
                                                "text": "To create such a role, an institution works in partnership with an affiliate or a champion to find a Wikimedian editing in a certain topic area that is relevant to the collection, and then the institution invites that Wikimedian to fill the “Visiting Scholar\" position."
                                            }
                                        ]
                                    }
                                ]
                            }
