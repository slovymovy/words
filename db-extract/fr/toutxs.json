                                                "example_id": "0dc282f6-13e2-41c8-8dd9-f6224787b620",
                                                "sense_id": "c5db3e3f-2cdc-326b-8723-a940e01e0226",
                                                "text": "she therefore ordered Jenny to pack up her alls and begone, for that she was determined she should not sleep that night within her walls. […] I packed up my little all as well as I could, and went off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d921dfd-e580-3787-8c7e-c03b7adf82e0",
                                        "entry_id": "f53ed22e-0f36-3444-b976-b9640151bfd0",
                                        "glosses": [
                                            "Everything in general; all that matters."
                                        ],
