                "senses": [
                    {
                        "sense_id": "032742b2-880b-3375-a678-eadcc90836a6",
                        "entry_id": "93da6ab1-4639-3524-8cd0-16f9f421c56f",
                        "glosses": [
                            "The formation of cliffs."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "da4b1656-15cd-4a26-b7bd-78983ba1d506",
                                "sense_id": "032742b2-880b-3375-a678-eadcc90836a6",
                                "text": "Cliffing of this kind is repaired if there is an abundant supply of sediment to restore the profile, permitting mangroves to spread again, but if there is a sediment deficit a mangrove cliff will persist and recede until the mangrove terrace has been completely removed."
                            },
                            {
                                "example_id": "d378436f-ee58-4281-b3fb-6ea864b3d0c1",
                                "sense_id": "032742b2-880b-3375-a678-eadcc90836a6",
                                "text": "When the alternate bands of hard and soft rock dip upstream in the longitudinal course of the river and if the caprock is resistant the underlying soft rocks are eroded more rapidly due to cliffing and thus the resistant rock beds form precipituous wall-like scarps which allow the river water to fall downstram vertically and ultimately a stupendous waterfall is formed."
                            },
                            {
                                "example_id": "f8cd3cde-75a6-4ae2-8cc0-3af94d015921",
                                "sense_id": "032742b2-880b-3375-a678-eadcc90836a6",
                                "text": "Cliffing (scarping) of the seaward margins of coastal dunes and the absence of new fore dunes (or the formation of new fore dunes lasting at most a few years) is very widespread around the world’s coastline, a consequence of the modern prevalence of beach erosion (Figure 9.2)."
                            }
                        ]
                    }
