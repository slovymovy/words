                                                "sense_id": "47ba575d-4dc6-3164-826e-6476b774a73b",
                                                "text": "easy pickings, rich pickings"
                                            },
                                            {
                                                "example_id": "83dcad2c-9ef3-4f91-a8c5-5d8195aff05b",
                                                "sense_id": "47ba575d-4dc6-3164-826e-6476b774a73b",
                                                "text": "He liked the pickings which the job brought him much better than the job itself."
                                            }
                                        ]
                                    },
