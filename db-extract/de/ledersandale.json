                ],
                "senses": [
                    {
                        "sense_id": "c445f51f-7363-3d0d-a529-8cfa7bbdd2d0",
                        "entry_id": "a6ef0093-3961-3967-93cf-4d64d25f8916",
                        "glosses": [
                            "Sandale aus Leder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d38b7704-1789-409b-bd1d-eb867d0cccf5",
                                "sense_id": "c445f51f-7363-3d0d-a529-8cfa7bbdd2d0",
                                "text": "„Mit den Füßen schlüpfte er in dunkelblaue Ledersandalen, lief die Treppe hinunter, verließ das Haus und ging über die Terrasse zum Strand.“"
                            },
                            {
                                "example_id": "04c51e51-c71f-4be9-a1fe-c34435e74af7",
                                "sense_id": "c445f51f-7363-3d0d-a529-8cfa7bbdd2d0",
                                "text": "„Er starrte ins Feuer und schürte es, nachdenklich dreinblickend, mit der Spitze seiner Ledersandalen.“"
                            },
                            {
                                "example_id": "b8545851-302a-4777-a5e9-14d146fd659c",
                                "sense_id": "c445f51f-7363-3d0d-a529-8cfa7bbdd2d0",
                                "text": "„Ihre kleinen Füße steckten nackt in einfachen Ledersandalen.“"
                            },
                            {
                                "example_id": "2a3df3d7-1a03-473a-9f7a-a162322e6166",
                                "sense_id": "c445f51f-7363-3d0d-a529-8cfa7bbdd2d0",
                                "text": "„Er holte den landesüblichen Leinensack, in dem seine Einheimischenkleidung verstaut war, aus der Fallschirmtasche und schlüpfte hinein. Ein Paar alte, zerlumpte Ledersandalen folgten.“"
                            },
                            {
                                "example_id": "78d9bce6-4860-4478-8deb-703ebe0dfc01",
                                "sense_id": "c445f51f-7363-3d0d-a529-8cfa7bbdd2d0",
                                "text": "„Wie ich zerstreut feststellte, trug ich eine Art Lendenschurz, an dessen Gürtel eine leere Scheide hing, und meine Füße steckten in Ledersandalen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
