                    "sense_definition": "Skomponowana pozycja szachowa, w której należy dać mata w określonej liczbie posunięć.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "szachy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj wieczorem rozwiązałem ciekawe <w>zadanie</w> szachowe.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером я решил интересную шахматную <w>задачу</w>.",
                                "en": "Last night I solved an interesting chess <w>problem</w>."
                            }
                        },
                        {
                            "text": "To <w>zadanie</w> wymagało znalezienia mata w trzech ruchach.",
                            "target_lang_translations": {
                                "ru": "Эта <w>задача</w> требовала нахождения мата в три хода.",
                                "en": "This <w>puzzle</w> required finding a mate in three moves."
                            }
                        }
