                                        "entry_id": "e8b13d7d-91e7-3602-918c-526b985301f6",
                                        "glosses": [
                                            "Troisième personne du pluriel de l’indicatif présent de serper."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
