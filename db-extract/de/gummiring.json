                                                "text": "Des bretelles élastiques."
                                            },
                                            {
                                                "example_id": "e1d48bbb-dfe3-4cd6-9de6-033efe90fe9b",
                                                "sense_id": "25e40e7d-2612-30d2-80a2-528d57fc4a2a",
                                                "text": "Une balle élastique."
                                            },
                                            {
                                                "example_id": "52836780-fbae-453e-9d06-a8df578873f2",
                                                "sense_id": "25e40e7d-2612-30d2-80a2-528d57fc4a2a",
                                                "text": "Une déformation élastique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b99d3454-72f7-33e7-9bc9-120c586130b9",
                                        "entry_id": "1ccd4e31-5549-31d9-80fa-d16b3e2dc581",
                                        "glosses": [
                                            "Fait d’une matière souple et flexible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5daffd22-5c61-47eb-8ce8-908b6f25190e",
                                                "sense_id": "b99d3454-72f7-33e7-9bc9-120c586130b9",
                                                "text": "Un tissu élastique."
                                            },
                                            {
                                                "example_id": "068f57ef-2c82-4be0-94f0-0aa8fa8a05e6",
                                                "sense_id": "b99d3454-72f7-33e7-9bc9-120c586130b9",
                                                "text": "Une peau douce et fine, tendue sur une chair ferme et élastique, apanage exclusif de la fraîcheur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c8eebe-c6d1-35d1-af55-3d9bdcde1347",
                                        "entry_id": "1ccd4e31-5549-31d9-80fa-d16b3e2dc581",
                                        "glosses": [
                                            "Qui a une apparence de souplesse, qui s'effectue avec beaucoup d'aisance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b19275-c1aa-4549-ad1b-f6f9501a3c53",
                                                "sense_id": "54c8eebe-c6d1-35d1-af55-3d9bdcde1347",
                                                "text": "Le kangourou saute par bonds précis et élastiques tout le long de son allée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5205e52e-482e-36a1-9dc6-fb655c42989e",
                                        "entry_id": "1ccd4e31-5549-31d9-80fa-d16b3e2dc581",
                                        "glosses": [
                                            "Qui fait montre d’un manque de fermeté morale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "932a7605-3ddc-4b9e-b2cc-429dcdae5256",
                                                "sense_id": "5205e52e-482e-36a1-9dc6-fb655c42989e",
                                                "text": "Il a la conscience élastique."
                                            },
                                            {
                                                "example_id": "b974a0fb-9a4a-4ab0-a959-cc28316d4829",
                                                "sense_id": "5205e52e-482e-36a1-9dc6-fb655c42989e",
                                                "text": "Ces solides gaillards de la SA au coup de poing facile et à la conscience élastique sont 1,5 million au début de 1933, et 3 millions un an plus tard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "élastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3103b4d3-1f17-3a20-8de6-e06a351028e2",
