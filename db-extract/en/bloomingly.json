    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "be6ffd6e-9890-3162-8a70-8178ed163252",
                "word": "bloomingly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fbf6bc05-ee1a-46c8-a096-cb32afb4e8f2",
                        "entry_id": "be6ffd6e-9890-3162-8a70-8178ed163252",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more bloomingly"
                    },
                    {
                        "form_id": "0e2ec721-cbe0-4698-bba4-89e95439d4d6",
                        "entry_id": "be6ffd6e-9890-3162-8a70-8178ed163252",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most bloomingly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9240658c-18be-343c-a83e-cd3fde1efe5e",
                        "entry_id": "be6ffd6e-9890-3162-8a70-8178ed163252",
                        "glosses": [
                            "With or by flowers that are blooming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0394314f-cb9b-4240-90f5-a76dba941f3d",
                                "sense_id": "9240658c-18be-343c-a83e-cd3fde1efe5e",
                                "text": "The fields dress'd so bloomingly gay ; The birds that delightfully sing -Delight not when Celia's away :"
                            },
                            {
                                "example_id": "dbdc059d-4592-44dd-9f7b-2a939a85568c",
                                "sense_id": "9240658c-18be-343c-a83e-cd3fde1efe5e",
                                "text": "But whether observed or not by the dust-loving eyes of vanity and fashion, nature goes silently and bloomingly on."
                            },
                            {
                                "example_id": "936f3338-0703-47da-ae42-4e0256b21771",
                                "sense_id": "9240658c-18be-343c-a83e-cd3fde1efe5e",
                                "text": "Not to have it so is an error, but the error is an inoffensive one easily corrected, and the merit is that the dwelling's business path is greenly, bloomingly screened from its pleasure-ground by a lovely natural drapery which at the same time furnishes, as far as the path goes, the house's robes of modesty."
                            },
                            {
                                "example_id": "924d0929-3c61-4fb3-a936-d8b8df7fb1cb",
                                "sense_id": "9240658c-18be-343c-a83e-cd3fde1efe5e",
                                "text": "Except for the icky cowl enveloping the bulb, which we washed off in the cold strem that bloomingly warm day ."
                            }
                        ]
                    },
                    {
                        "sense_id": "bda20d3d-9d33-3ebb-aed4-d9ab5a290ea4",
                        "entry_id": "be6ffd6e-9890-3162-8a70-8178ed163252",
                        "glosses": [
                            "While blossoming; in the process of blooming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697b3194-2eba-46e2-9870-82a011f8452d",
                                "sense_id": "bda20d3d-9d33-3ebb-aed4-d9ab5a290ea4",
                                "text": "Beneath it the primrose looked. bloomingly fair; The hyacinth danced, in its mantle of green ; And over the rill waved the sweet meadow queen."
                            },
                            {
                                "example_id": "632a8166-5c09-4205-97b0-bb2e725725fb",
                                "sense_id": "bda20d3d-9d33-3ebb-aed4-d9ab5a290ea4",
                                "text": "O, a maiden flower, Buring with blushes the sweet bride-bower, Beauty her dower! Breathing perfumingly; Shall I live. bloomingly, Said she, by day, or the bridal hour?"
                            },
                            {
                                "example_id": "ce7c77c5-52eb-4ddd-9659-e47e010fc538",
                                "sense_id": "bda20d3d-9d33-3ebb-aed4-d9ab5a290ea4",
                                "text": "A rose-tree never appears so bloomingly lovely as when placed between two leafless thorns ."
                            },
                            {
                                "example_id": "35de9471-6e09-48d7-aaad-4872aa804436",
                                "sense_id": "bda20d3d-9d33-3ebb-aed4-d9ab5a290ea4",
                                "text": "But when I am grown old, and in the obstruction of death, will not all that now rustles so bloomingly and livingly about me appear gray and dull ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "73fe2cf2-d43c-35c9-9230-cfdaffc051cf",
                        "entry_id": "be6ffd6e-9890-3162-8a70-8178ed163252",
                        "glosses": [
                            "In the bloom of health; flourishingly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897e3787-bfd7-488f-b2c8-695511e527c6",
                                "sense_id": "73fe2cf2-d43c-35c9-9230-cfdaffc051cf",
                                "text": "Though Mrs. Belsize made herself so intensely agreeable, was what is called a \"fine woman,\" (certainly not more than forty,) and became her age bloomingly; yet the young clergyman shrunk from her ordinary civilities , and positively winced at her more glaring attentions ."
                            },
                            {
                                "example_id": "11e3fcbe-0869-470f-8b16-77fdad0e535d",
                                "sense_id": "73fe2cf2-d43c-35c9-9230-cfdaffc051cf",
                                "text": "She little thinks how fatal are those charms she bears bloomingly into womanhood ."
                            },
                            {
                                "example_id": "928b7f18-48b7-4f55-872f-9aa9e5fc7755",
                                "sense_id": "73fe2cf2-d43c-35c9-9230-cfdaffc051cf",
                                "text": "There were tall, strong-looking men, of a type never seen in England, not even in the country, hard-worked looking women, healthy, out prematurely lined and aged when compared with town-bred women who have time and opportunity to take care of their appearance, and strapping girls and children, the latter bare-footed, bloomingly, aggressively robust, and without exaggeration nearly half as big again as English children of their ages."
                            },
                            {
                                "example_id": "f5e9268b-1dc6-4a97-954d-21825fd02166",
                                "sense_id": "73fe2cf2-d43c-35c9-9230-cfdaffc051cf",
                                "text": "Eva, although perhaps, strictly speaking, not beautiful, was yet bloomingly lovely."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcaa651b-ff6e-39f1-a628-81d20d44a390",
                        "entry_id": "be6ffd6e-9890-3162-8a70-8178ed163252",
                        "glosses": [
                            "Redly; in a rosy manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "860c8b06-da4e-4258-8c22-aaf37222cb34",
                                "sense_id": "fcaa651b-ff6e-39f1-a628-81d20d44a390",
                                "text": "Little Jimmy was none the worse for the climate; the frost and snow delighted him, the boisterous easterly windows only brought the roses more bloomingly into his cheeks, and even the dreary wet days did not seem to have any injurious effect upon his robust and healthy spirits ."
                            },
                            {
                                "example_id": "815e368c-c2e7-4683-bbce-ca6dc79b5f93",
                                "sense_id": "fcaa651b-ff6e-39f1-a628-81d20d44a390",
                                "text": "An early writer on the poem remarked that his manuscript was \"bloomingly erubricated with Latin quotations .\""
                            },
                            {
                                "example_id": "ba07f3ff-7b56-40c4-b937-28a0d534d2cd",
                                "sense_id": "fcaa651b-ff6e-39f1-a628-81d20d44a390",
                                "text": "Bunty sat bloomingly regal in the same old red-silk dress with a pearl collar and tiara, day after day, playing on the red-lacquered grand piano."
                            },
                            {
                                "example_id": "ade1db86-b318-4fcf-8047-fe7d90dbbf2b",
                                "sense_id": "fcaa651b-ff6e-39f1-a628-81d20d44a390",
                                "text": "A certain nose has grown sharper, a certain chin more peaked, a certain pair of cheeks more bloomingly red than ever , and a certain pair of eyes keep more vigilant watch out of Miss Slimmen's window."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4fc710b-f677-3430-8b83-46c6b4606cf9",
                        "entry_id": "be6ffd6e-9890-3162-8a70-8178ed163252",
                        "glosses": [
                            "Coming into full development or openness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbabd2db-8b64-4122-8685-9598f0d31971",
                                "sense_id": "b4fc710b-f677-3430-8b83-46c6b4606cf9",
                                "text": "May He spare him to see throughout the land bloomingly flourish the good see he himself so sedulously sowed."
                            },
                            {
                                "example_id": "2d678285-c42f-44f2-83e0-25038787ad35",
                                "sense_id": "b4fc710b-f677-3430-8b83-46c6b4606cf9",
                                "text": "To me, fresh from a desert where they beat you for carrying books, it seemed profoundly cultivated, bloomingly humanistic."
                            },
                            {
                                "example_id": "be6611d8-ca71-4f37-8edf-98655ec738c3",
                                "sense_id": "b4fc710b-f677-3430-8b83-46c6b4606cf9",
                                "text": "Yet in that small room my heart always opened so warmly, nay glowingly and bloomingly, so that now I want to be with you again for good and not part with you until the sun shines sweetly and lures me into the pine forest"
                            }
                        ]
                    },
                    {
                        "sense_id": "75ab5b43-8ec3-3338-9c0c-2cbf8014fa70",
                        "entry_id": "be6ffd6e-9890-3162-8a70-8178ed163252",
                        "glosses": [
                            "Used as a mild intensifier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e13538-2c86-4862-843a-e15a9055d1c2",
                                "sense_id": "75ab5b43-8ec3-3338-9c0c-2cbf8014fa70",
                                "text": "As she said this, Lady Lexley grew more bloomingly vicious; and, despite the opaque whiteness of Miss Harper's skin, a shade of green shot across her face."
                            },
                            {
                                "example_id": "dc692f34-4f8c-4e93-aeb0-aac900143728",
                                "sense_id": "75ab5b43-8ec3-3338-9c0c-2cbf8014fa70",
                                "text": "I hate her with a B because she's so bitterly bellicose, and so bloomingly blunt."
                            },
                            {
                                "example_id": "136ae9a9-92ad-4aca-bdc2-5ab84d2453ac",
                                "sense_id": "75ab5b43-8ec3-3338-9c0c-2cbf8014fa70",
                                "text": "What is the name of one so bloomingly needing of a good man as you?"
                            }
                        ]
                    }
                ],
