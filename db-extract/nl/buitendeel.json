                        "examples": [
                            {
                                "example_id": "806e01d2-d026-4401-a11a-6f9668fb86fe",
                                "sense_id": "b02f13b1-f45c-376b-88f1-725bf29a565a",
                                "text": "Hoe kunnen die merkwaardige structuren verklaard worden? De Voyagergeologen gaan ervan uit dat Triton in de buitendelen van het zonnestelsel is ontstaan, en pas later door Neptunus werd 'ingevangen'."
                            },
                            {
                                "example_id": "6cf1519a-07f9-4fca-a8ed-8c8306404dee",
                                "sense_id": "b02f13b1-f45c-376b-88f1-725bf29a565a",
                                "text": "En misschien werd de pasgeboren aarde een paar miljard jaar geleden niet geraakt door een rotsachtige protoplaneet, maar door een ijzig hemellichaam uit de buitendelen van het zonnestelsel."
                            }
