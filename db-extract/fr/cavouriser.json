                "senses": [
                    {
                        "sense_id": "79fa9d99-3444-3147-99d5-5059a22714d0",
                        "entry_id": "cfada50b-89ac-3a4c-8f69-ce57194266d8",
                        "glosses": [
                            "Soumettre aux idées de Camillo Cavour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c78c7a-678d-4eb6-89e1-359596c184db",
                                "sense_id": "79fa9d99-3444-3147-99d5-5059a22714d0",
                                "text": "Si le cabinet de Berlin déclare qu’il ne se laissera point majoriser (c’est-à-dire dominer par la majorité de la Diète), la Bavière annonce à son tour, rendant barbarisme pour barbarisme, qu’elle ne se laissera pas cavouriser."
                            },
                            {
                                "example_id": "40cdb1a7-984c-45db-b480-0932a05bb6bf",
                                "sense_id": "79fa9d99-3444-3147-99d5-5059a22714d0",
                                "text": "C’est ce que sentait Cavour, avec son tact de grand homme d’État; et pour qu’on ne pût lui reprocher de turiniser et de cavouriser l’Italie, il désirait prendre pour collaborateurs les hommes les plus éminens de chaque région."
                            }
                        ]
                    }
                ],
