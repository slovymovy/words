                ],
                "senses": [
                    {
                        "sense_id": "9064c46c-1b35-3cf2-8efd-e6a8bc9de63f",
                        "entry_id": "0b56c337-8ad5-321d-a64a-96d78481dd9e",
                        "glosses": [
                            "junge, unverheiratete Freundin oder Verwandte der Braut, die diese bei der Hochzeit begleitet und unterstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5a2e7d8-bb3a-4811-b004-c27470c02ab3",
                                "sense_id": "9064c46c-1b35-3cf2-8efd-e6a8bc9de63f",
                                "text": "„Die Brautjungfer hat sich für die Hochzeit ihrer Schwester Nicole am vergangenen Samstag in Kalifornien eine ganz besondere Ansprache einfallen lassen.“"
                            },
                            {
                                "example_id": "e6966218-ba04-4c3d-ae95-5d0235237993",
                                "sense_id": "9064c46c-1b35-3cf2-8efd-e6a8bc9de63f",
                                "text": "„Seit sie am Hochzeitstag den funkelnden Blick bemerkt hatte, den Titus ihrer Brautjungfer zuwarf, wusste sie, dass er ihr niemals treu sein würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ede8c378-6ddc-408a-b9ce-b005af9afab2",
                        "source_entry_id": "0b56c337-8ad5-321d-a64a-96d78481dd9e",
                        "source_sense_id": "9064c46c-1b35-3cf2-8efd-e6a8bc9de63f",
                        "source_sense_description": "junge, unverheiratete Nahestehende der Braut, die diese bei der Hochzeit begleitet und unterstützt",
                        "target_lang_word": "bridesmaid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bridesmaid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3acf477-83a3-3f19-b3ce-c16fa1976ae5",
                                        "entry_id": "09f28d21-f86b-3e43-93b3-2cb71f5da10c",
                                        "glosses": [
                                            "A woman who attends a bride during her wedding ceremony, as part of the main wedding party."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "129e2223-80b5-4efe-ab6d-1001ed959c79",
                                                "sense_id": "f3acf477-83a3-3f19-b3ce-c16fa1976ae5",
                                                "text": "I'd love to be your bridesmaid at the wedding."
                                            },
                                            {
                                                "example_id": "71589767-d55e-434f-a6fe-293721a92e04",
                                                "sense_id": "f3acf477-83a3-3f19-b3ce-c16fa1976ae5",
                                                "text": "I was promised sex. Everybody said it. You'll be a bridesmaid, you'll get sex, you'll be fighting 'em off. But not so much as a tongue in sight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2186a2c2-75f1-3599-aa72-a9f3e90e4fc2",
                                        "entry_id": "09f28d21-f86b-3e43-93b3-2cb71f5da10c",
                                        "glosses": [
                                            "A person or team that perennially finishes well, but never first."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "622736c4-41cd-403c-9b13-01cc15463f55",
                                                "sense_id": "2186a2c2-75f1-3599-aa72-a9f3e90e4fc2",
                                                "text": "He had taken her for a dogsbody, a beta fish, a bridesmaid, a ride-along; he had looked right past her, as likely many people did."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bridesmaid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "323cd629-851e-31b4-bd79-457a20230b61",
                                        "entry_id": "6dad13c1-8281-3553-9f9d-43d81b22a393",
                                        "glosses": [
                                            "To act as a bridesmaid for; to attend a bride during her wedding ceremony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4025030f-e3be-4ac9-8faf-f9593c518aad",
                                                "sense_id": "323cd629-851e-31b4-bd79-457a20230b61",
                                                "text": "\"No, Trichy; I won't be Augusta's bridesmaid; I'll bide my time for bridesmaiding.\""
                                            },
                                            {
                                                "example_id": "7bcef9c4-fb26-4a62-a719-13db7629621f",
                                                "sense_id": "323cd629-851e-31b4-bd79-457a20230b61",
                                                "text": "And what's this? that isn't Herbie Frost with you in the canoe ; why he was best man when I bridesmaided Corinne."
                                            },
                                            {
                                                "example_id": "388b29eb-f16e-45dd-a79e-aa57a33e290e",
                                                "sense_id": "323cd629-851e-31b4-bd79-457a20230b61",
                                                "text": "\"It's in my Data-fax, right here! December Bride: and I'm supposed to bridesmaid!\""
                                            },
                                            {
                                                "example_id": "bf61406f-8d18-4b25-8f94-e2085210d6a9",
                                                "sense_id": "323cd629-851e-31b4-bd79-457a20230b61",
                                                "text": "After ten years of friendship and just six months of lackluster bridesmaiding, the women did not even get an invitation to the wedding."
                                            },
                                            {
                                                "example_id": "7e7ef66c-5ef6-42b3-8ea7-837e95195e0b",
                                                "sense_id": "323cd629-851e-31b4-bd79-457a20230b61",
                                                "text": "Still they bridesmaided for her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "900bf6b3-46aa-4639-81a8-89cb6966290d",
                        "source_entry_id": "0b56c337-8ad5-321d-a64a-96d78481dd9e",
                        "source_sense_id": "9064c46c-1b35-3cf2-8efd-e6a8bc9de63f",
                        "source_sense_description": "junge, unverheiratete Nahestehende der Braut, die diese bei der Hochzeit begleitet und unterstützt",
                        "target_lang_word": "demoiselle d’honneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demoiselle d’honneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdfdf0c9-0bd1-3461-93b9-e268ce7e0e2e",
                                        "entry_id": "efe84161-d22a-3e01-8591-5c8d06781223",
                                        "glosses": [
                                            "Jeune fille noble attachée à la personne d’une princesse."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d7bdda2-7155-38e8-81fe-07e0c3eb438d",
                                        "entry_id": "efe84161-d22a-3e01-8591-5c8d06781223",
                                        "glosses": [
                                            "Jeune fille qui accompagne la mariée à l’église."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3a20695-be88-4407-8b27-6da82e9e1a5b",
                                                "sense_id": "5d7bdda2-7155-38e8-81fe-07e0c3eb438d",
                                                "text": "Propos entendus dans le train de Chaminadour à Saint-Sébastien.\n– Le marié installe l’électricité à l'église et il y aura quatre demoiselles d’honneur.\n– À quoi les reconnaîtra-t-on ? Est-ce qu'on leur mettra des numéros ?\n– Non. On les habillera pareil, c'est la mariée qui paie les robes.\n– Il faut que la noce fasse tant de bruit qu'on en parle à dix lieues et dans dix ans."
                                            },
                                            {
                                                "example_id": "e5356e4e-74cb-47f1-8ff2-e9447558f49e",
                                                "sense_id": "5d7bdda2-7155-38e8-81fe-07e0c3eb438d",
                                                "text": "Tout le monde est chic et bien habillé, Liane est radieuse dans son rôle de mère de la mariée, Justine et Violette (qui ont alors respectivement treize et onze ans), entourées de quelques cousines, jouent avec le plus grand sérieux leur partition de demoiselles d’honneur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
