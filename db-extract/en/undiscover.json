                "senses": [
                    {
                        "sense_id": "ed96faa7-5f44-3c77-9fc8-f34cbe378cdf",
                        "entry_id": "38ab6c78-b9de-3dbb-8c6b-3981959c4f93",
                        "glosses": [
                            "To forget or revoke the discovery of (something discovered earlier)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a53b4d0b-c884-49dd-8aa1-bec1e3b5a196",
                                "sense_id": "ed96faa7-5f44-3c77-9fc8-f34cbe378cdf",
                                "text": "It's been happening since man discovered war, and it'll keep on till he undiscovers it, if he ever […]"
                            },
                            {
                                "example_id": "5a80ce7a-3a14-4ac1-a301-bb7c39ddf3f7",
                                "sense_id": "ed96faa7-5f44-3c77-9fc8-f34cbe378cdf",
                                "text": "“I want...” I began, “I suppose...I am trying, for lack of a better word, to un-recall these words. To undiscover these things.”\n“Don't you mean forget?” Throneberry said.\nI shook my head. “I don't know. Maybe. But forgetting is too weak a word for what I want. I want the words to disappear not just from my mind, but from this...”"
                            },
                            {
                                "example_id": "ab9f1e56-1428-4a5d-b038-f834fe2ad579",
                                "sense_id": "ed96faa7-5f44-3c77-9fc8-f34cbe378cdf",
                                "text": "In fact, as it turned out, Sandy Island had been undiscovered more than once already. Most recently, in the year 2000, a group of amateur radio enthusiasts had noticed its absence while travelling to the Chesterfield Islands, 100km to the west."
                            }
                        ]
                    }
