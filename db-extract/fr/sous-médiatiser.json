                ],
                "senses": [
                    {
                        "sense_id": "370f783d-f0ce-3979-b1c9-eccfcb1cef75",
                        "entry_id": "9185ef0f-01a2-3514-8148-cc6694554ea3",
                        "glosses": [
                            "Médiatiser moins que ce qui serait normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ef6ea6-9c91-4538-bf3d-ae76323777d9",
                                "sense_id": "370f783d-f0ce-3979-b1c9-eccfcb1cef75",
                                "text": "Au contraire, il semble exister une volonté tenace et sans doute un peu organisée, en matière internationale, de sous-médiatiser à l'extrême certaines infos."
                            },
                            {
                                "example_id": "d7c17535-3066-4a7a-8677-b1806b227d3e",
                                "sense_id": "370f783d-f0ce-3979-b1c9-eccfcb1cef75",
                                "text": "L’idée ? Changer son avatar en se cachant la moitié du visage, symbolisant les Jeux Paralympiques, et ainsi montrer leur volonté de ne pas les sous-médiatiser, et de ne pas laisser dans l’ombre cette partie des Jeux…"
                            },
                            {
                                "example_id": "71529ad2-932a-4fad-82a3-ced04a071e5a",
                                "sense_id": "370f783d-f0ce-3979-b1c9-eccfcb1cef75",
                                "text": "Le sélectionneur français de la Zambie reprochait d'ailleurs à la presse de sous-médiatiser les performances de ses protégés au profit des autres cadors africains."
                            }
                        ]
                    }
                ],
