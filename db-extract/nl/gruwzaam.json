                    {
                        "form_id": "0116f415-dbe8-4182-97d7-d0e31318206b",
                        "entry_id": "74914090-be79-3dcb-952e-48c878fc92fd",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "gruwzamers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc23caa9-73e5-3a5e-bc5c-01e9015af489",
                        "entry_id": "74914090-be79-3dcb-952e-48c878fc92fd",
                        "glosses": [
                            "afkeer en schrik opwekkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59bc6091-e4f0-43f0-97d4-c7d0b05fdfec",
                                "sense_id": "bc23caa9-73e5-3a5e-bc5c-01e9015af489",
                                "text": "Het is even opmerkelijk dat de afschuwelijke moord op 20.000 varkens de meeste mensen koud laat, terwijl een stille tocht ter nagedachtenis aan de op gruwzame wijze omgekomen varkens en een protest tegen de beestachtige omstandigheden, waaronder varkens in megastallen hun miserabele leven leiden, op zijn plaats is."
                            },
                            {
                                "example_id": "1449b8cd-7185-4ec2-98ff-29fd0c0d3fe6",
                                "sense_id": "bc23caa9-73e5-3a5e-bc5c-01e9015af489",
                                "text": "Volgend jaar wordt het begin van het Twaalfjarig Bestand officieel herdacht. In de aanloop naar deze herdenking werd gisteren in het Nationaal Archief een standaardwerk over de Tachtigjarige Oorlog gepresenteerd. Een gruwzaam tijdvak, schreef tijdgenoot P. C. Hooft, „bitter van twist, wrang van wreedheid.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46d7e18f-6748-46a4-8908-1016ceab488c",
                        "source_entry_id": "74914090-be79-3dcb-952e-48c878fc92fd",
                        "source_sense_id": "bc23caa9-73e5-3a5e-bc5c-01e9015af489",
                        "source_sense_description": "afkeer en schrik opwekkend",
                        "target_lang_word": "gruesome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gruesome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "620d6944-1a9b-363f-becd-35b3a8160aaf",
                                        "entry_id": "27818388-a396-3eff-b661-acdc9ffbf4d9",
                                        "glosses": [
                                            "Repellently frightful and shocking; horrific or ghastly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fc5b0a3-2460-4fce-ae55-41921d76a167",
                                                "sense_id": "620d6944-1a9b-363f-becd-35b3a8160aaf",
                                                "text": "True, there were the usual night-sounds of the country—the whir of night-birds, the buzzing of insects, the barking of distant dogs, the mellow lowing of far-off kine—but these didn't seem to break the stillness, they only intensified it, and added a grewsome melancholy to it into the bargain."
                                            },
                                            {
                                                "example_id": "ec579843-90f4-4526-b70d-bc9ca7313019",
                                                "sense_id": "620d6944-1a9b-363f-becd-35b3a8160aaf",
                                                "text": "In the middle of the floor lay a skeleton, every vestige of flesh gone from the bones to which still clung the mildewed and moldered remnants of what had once been clothing. Upon the bed lay a similar gruesome thing, but smaller, while in a tiny cradle near-by was a third, a wee mite of a skeleton."
                                            },
                                            {
                                                "example_id": "825fe0ba-6220-4f03-a3d1-62e2635f8317",
                                                "sense_id": "620d6944-1a9b-363f-becd-35b3a8160aaf",
                                                "text": "Jay Carney said that the US was considering whether to release photos of bin Laden after he was killed on Sunday but that the photos were gruesome and could be inflammatory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
