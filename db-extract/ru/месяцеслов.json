                        ]
                    },
                    {
                        "translation_id": "339bf090-4d9f-4a56-a14a-887c88d998b8",
                        "source_entry_id": "1b6ece77-9c38-3477-a015-e3c32d93135d",
                        "source_sense_id": "054e17a3-dd6f-37bc-a8ae-f43323ca1f39",
                        "target_lang_word": "menologion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menologion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "389284df-d211-3e6b-93a9-ec342f58f5af",
                                        "entry_id": "8d99ddc8-1f9e-3fbf-9e72-67b4ad9a755d",
                                        "glosses": [
                                            "Synonym of menologium, particularly in Greek, Byzantine, and Eastern Orthodox contexts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d68ce1-52d9-450c-a5ee-2f95724778ac",
                                                "sense_id": "389284df-d211-3e6b-93a9-ec342f58f5af",
                                                "text": "In order to make a preliminary study of the text of the menologion on the basis of evidence from the MSS accessible, the area of greatest uniformity was sought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fc2fde3-3dfa-4d44-bcd5-e1506fda1119",
                        "source_entry_id": "1b6ece77-9c38-3477-a015-e3c32d93135d",
                        "source_sense_id": "054e17a3-dd6f-37bc-a8ae-f43323ca1f39",
                        "target_lang_word": "menology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e13740b-3c07-39bd-a870-163b9bf4782b",
                                        "entry_id": "3d2f45c4-ba82-3c5c-b1c6-6473dc4e4a56",
                                        "glosses": [
                                            "The study of months; the names and system of months within a given calendar."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df1efc0-ee0a-4c72-a0b8-010c0af5f70d",
                                                "sense_id": "3e13740b-3c07-39bd-a870-163b9bf4782b",
                                                "text": "...in Afghanistan, we find two systems of month-names. One of these... is of Indian origin..., while the other is borrowed from the Mohammedan menology..."
                                            },
                                            {
                                                "example_id": "1005fc21-3a24-4a2b-a3e1-48acd95dc5a4",
                                                "sense_id": "3e13740b-3c07-39bd-a870-163b9bf4782b",
                                                "text": "The Romans themselves believed Romulus had given them a 10-month lunar calendar, but modern scholars consider the actual original state of Roman menology uncertain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85092866-8b37-3d76-8cdf-b137eb1e5e71",
                                        "entry_id": "3d2f45c4-ba82-3c5c-b1c6-6473dc4e4a56",
                                        "glosses": [
                                            "Synonym of menologium, a monthly record, particularly in Assyriology and certain Christian contexts."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a6da0e9-83fd-4700-ae4f-ada8349b6e01",
                                                "sense_id": "85092866-8b37-3d76-8cdf-b137eb1e5e71",
                                                "text": "In the Mart. of Donegal, this is the day of St. Comgall (Comhgall), placed in the Menology on the 27th June, as having no day."
                                            },
                                            {
                                                "example_id": "64f6150c-9530-4239-af7b-f0404b75d5fd",
                                                "sense_id": "85092866-8b37-3d76-8cdf-b137eb1e5e71",
                                                "text": "The menology of the tenth century has the formula ..."
                                            },
                                            {
                                                "example_id": "febd8c29-e8b2-4b87-9f96-511155756483",
                                                "sense_id": "85092866-8b37-3d76-8cdf-b137eb1e5e71",
                                                "text": "The duration of the rites of mourning over nine days is... supported by references in a Standard Babylonian menology..."
                                            },
                                            {
                                                "example_id": "a1347867-d5cb-482f-8442-6d79915f8d94",
                                                "sense_id": "85092866-8b37-3d76-8cdf-b137eb1e5e71",
                                                "text": "The Menology of St Symeon mostly repeats earlier accounts but includes some small additions as well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71a744ed-4fdd-3c07-b0bf-92801cd0f14b",
                                        "entry_id": "3d2f45c4-ba82-3c5c-b1c6-6473dc4e4a56",
                                        "glosses": [
                                            "The content of a menologium, a liturgical calendar or hagiography."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae17c264-88e8-4385-a6ed-381b7efe8d2e",
                                                "sense_id": "71a744ed-4fdd-3c07-b0bf-92801cd0f14b",
                                                "text": "Their readings from the holy Scriptures and from the fathers, from the menologies of the church and the teachings of its principal pastors, are a great, continually swelling hymn of praise to the rule of providence and to the progressive actualization of the eternal plan of salvation."
                                            },
                                            {
                                                "example_id": "3e8ed1dc-f7a9-40d8-b0a4-1f9d357793a0",
                                                "sense_id": "71a744ed-4fdd-3c07-b0bf-92801cd0f14b",
                                                "text": "The menologies of St Symeon mostly repeat earlier accounts but include some small additions as well."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
