{
    "word_family": [
        "slop",
        "sloppiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4834fa8d-cc50-3639-9acd-883c03160dc0",
                    "sense_definition": "Messy or not neat, elegant, or careful.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "messy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter did a <w>sloppy</w> job of building the staircase.",
                            "target_lang_translations": {
                                "ru": "Плотник выполнил работу по строительству лестницы <w>небрежно</w>.",
                                "pl": "Stolarz wykonał budowę schodów bardzo <w>niestarannie</w>.",
                                "fr": "Le charpentier a fait un travail <w>bâclé</w> pour construire l'escalier."
                            }
                        },
                        {
                            "text": "He handed in a <w>sloppy</w> report full of mistakes.",
                            "target_lang_translations": {
                                "ru": "Он сдал <w>неаккуратный</w> отчет, полный ошибок.",
                                "pl": "Oddał <w>niechlujny</w> raport pełen błędów.",
                                "fr": "Il a rendu un rapport <w>négligé</w> et plein d'erreurs."
                            }
                        }
                    ],
                    "synonyms": [
                        "untidy",
                        "careless",
                        "messy"
                    ],
                    "antonyms": [
                        "neat",
                        "careful"
                    ],
                    "common_phrases": [
                        "sloppy work",
                        "sloppy job"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неаккуратный, небрежный или сделанный без должного внимания.",
                        "pl": "Niechlujny, niestaranny lub wykonany bez należytej uwagi.",
                        "fr": "Désordonné, négligé ou fait sans soin ni attention."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "небрежный",
                                "target_lang_sense_clarification": "о работе или действиях, выполненных без старания"
                            },
                            {
                                "target_lang_word": "неряшливый",
                                "target_lang_sense_clarification": "о человеке или его внешнем виде, склонном к беспорядку"
                            },
                            {
                                "target_lang_word": "неаккуратный",
                                "target_lang_sense_clarification": "о том, что сделано без должной тщательности"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niechlujny",
                                "target_lang_sense_clarification": "o osobie lub pracy wykonanej bez dbałości o porządek"
                            },
                            {
                                "target_lang_word": "niestaranny",
                                "target_lang_sense_clarification": "o pracy wykonanej bez należytej staranności"
                            },
                            {
                                "target_lang_word": "niedbały",
                                "target_lang_sense_clarification": "o kimś, kto wykonuje zadania w sposób powierzchowny"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "bâclé",
                                "target_lang_sense_clarification": "fait à la va-vite et sans soin"
                            },
                            {
                                "target_lang_word": "négligé",
                                "target_lang_sense_clarification": "qui manque de soin ou de propreté"
                            },
                            {
                                "target_lang_word": "brouillon",
                                "target_lang_sense_clarification": "désordonné et confus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4916be7a-4a87-3941-9350-debfd5842ac3",
                    "sense_definition": "Imprecise or loose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "messy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist made a <w>sloppy</w> measurement that ruined the experiment.",
                            "target_lang_translations": {
                                "ru": "Ученый произвел <w>неточный</w> замер, который испортил весь эксперимент.",
                                "pl": "Naukowiec dokonał <w>niedokładnego</w> pomiaru, który zrujnował eksperyment.",
                                "fr": "Le scientifique a fait une mesure <w>imprécise</w> qui a gâché l'expérience."
                            }
                        },
                        {
                            "text": "His <w>sloppy</w> thinking led to many errors in the final report.",
                            "target_lang_translations": {
                                "ru": "Его <w>поверхностное</w> мышление привело к множеству ошибок в итоговом отчете.",
                                "pl": "Jego <w>powierzchowne</w> myślenie doprowadziło do wielu błędów w raporcie końcowym.",
                                "fr": "Son raisonnement <w>flou</w> a entraîné de nombreuses erreurs dans le rapport final."
                            }
                        }
                    ],
                    "synonyms": [
                        "imprecise",
                        "loose",
                        "inaccurate"
                    ],
                    "antonyms": [
                        "precise",
                        "accurate"
                    ],
                    "common_phrases": [
                        "sloppy measurement",
                        "sloppy thinking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неточный, расплывчатый или недостаточно строгий.",
                        "pl": "Niedokładny, nieprecyzyjny lub zbyt ogólnikowy.",
                        "fr": "Imprécis, flou ou manquant de rigueur."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неточный",
                                "target_lang_sense_clarification": "о данных, измерениях или выводах"
                            },
                            {
                                "target_lang_word": "поверхностный",
                                "target_lang_sense_clarification": "о мышлении или анализе, лишенном глубины"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niedokładny",
                                "target_lang_sense_clarification": "o pomiarach, danych lub wynikach"
                            },
                            {
                                "target_lang_word": "powierzchowny",
                                "target_lang_sense_clarification": "o myśleniu lub analizie, której brakuje głębi"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "imprécis",
                                "target_lang_sense_clarification": "qui manque de rigueur ou de précision"
                            },
                            {
                                "target_lang_word": "flou",
                                "target_lang_sense_clarification": "vague, mal défini"
                            },
                            {
                                "target_lang_word": "lâche",
                                "target_lang_sense_clarification": "peu rigoureux ou manquant de fermeté"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1275bda-23d8-385a-8e51-8c95f535f12c",
                    "sense_definition": "Very wet or covered in mud or slush.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog tracked <w>sloppy</w> mud through the kitchen.",
                            "target_lang_translations": {
                                "ru": "Собака натаскала в кухню <w>грязной</w> жижи.",
                                "pl": "Pies naniósł do kuchni <w>błotnistej</w> mazi.",
                                "fr": "Le chien a traîné de la boue <w>détrempée</w> partout dans la cuisine."
                            }
                        },
                        {
                            "text": "We walked through the <w>sloppy</w> snow after the storm.",
                            "target_lang_translations": {
                                "ru": "После бури мы шли по <w>слякотному</w> снегу.",
                                "pl": "Po burzy szliśmy przez <w>rozciapany</w> śnieg.",
                                "fr": "Nous avons marché dans la neige <w>fondue</w> après la tempête."
                            }
                        }
                    ],
                    "synonyms": [
                        "muddy",
                        "slushy",
                        "wet"
                    ],
                    "common_phrases": [
                        "sloppy mud",
                        "sloppy snow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень влажный, грязный или покрытый слякотью.",
                        "pl": "Bardzo mokry, błotnisty lub pokryty roztopionym śniegiem.",
                        "fr": "Très humide, boueux ou couvert de gadoue."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слякотный",
                                "target_lang_sense_clarification": "о погоде или состоянии дороги, покрытой талым снегом и грязью"
                            },
                            {
                                "target_lang_word": "грязный",
                                "target_lang_sense_clarification": "покрытый жидкой грязью"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "błotnisty",
                                "target_lang_sense_clarification": "pokryty warstwą mokrej ziemi lub błota"
                            },
                            {
                                "target_lang_word": "rozciapany",
                                "target_lang_sense_clarification": "o konsystencji mokrego śniegu lub błota"
                            },
                            {
                                "target_lang_word": "chlapiący",
                                "target_lang_sense_clarification": "o mokrym podłożu, które brudzi przy chodzeniu"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "boueux",
                                "target_lang_sense_clarification": "plein de boue ou de gadoue"
                            },
                            {
                                "target_lang_word": "détrempé",
                                "target_lang_sense_clarification": "gorgé d'eau, très humide"
                            },
                            {
                                "target_lang_word": "mouillé",
                                "target_lang_sense_clarification": "imbibé de liquide"
                            }
                        ]
                    }
                }
            ]
        },
