                    },
                    {
                        "translation_id": "c53ca391-6928-417c-984c-e144d1fc38ba",
                        "source_entry_id": "b2693c12-41a5-3059-8bbb-87aa4b4bc916",
                        "source_sense_id": "a397fc18-0584-3550-8d4e-089e7334152f",
