    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63b5c9a0-a6ab-33c9-939c-7df705fb4d03",
                    "sense_definition": "The sound of a muffled explosion",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distant <w>crump</w> of artillery fire echoed across the valley throughout the night.",
                            "target_lang_translations": {
                                "cs": "Vzdálený <w>tlumený výbuch</w> dělostřelecké palby se celou noc rozléhal údolím."
                            }
                        },
                        {
                            "text": "We heard a dull <w>crump</w> as the old building finally collapsed into the dust.",
                            "target_lang_translations": {
                                "cs": "Slyšeli jsme tupý <w>náraz</w>, když se stará budova konečně zřítila do prachu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Tlumený zvuk výbuchu nebo nárazu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tlumený výbuch",
                                "target_lang_sense_clarification": "zvukový vjem"
                            },
                            {
                                "target_lang_word": "dunivý náraz",
                                "target_lang_sense_clarification": "zvukový vjem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d83d81bf-5359-333d-9aa5-517912729663",
                    "sense_definition": "To make the sound of a muffled explosion",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy shells began to <w>crump</w> in the distance as the battle intensified.",
                            "target_lang_translations": {
                                "cs": "Těžké granáty začaly v dálce <w>dunět</w>, jak bitva sílila."
                            }
                        },
                        {
                            "text": "The mortar rounds <w>crumped</w> against the earth, shaking the ground beneath our feet.",
                            "target_lang_translations": {
                                "cs": "Minometné granáty <w>dopadaly</w> do země a otřásaly půdou pod našima nohama."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat tlumený zvuk výbuchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dunět",
                                "target_lang_sense_clarification": "vydávat hluboký zvuk"
                            },
                            {
                                "target_lang_word": "ozývat se výbuchy",
                                "target_lang_sense_clarification": "popis děje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f50e396-6bda-3527-8270-a3b07326595d",
                    "sense_definition": "To decline rapidly in health",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient started <w>crumping</w> suddenly, requiring immediate intervention from the medical team.",
                            "target_lang_translations": {
                                "cs": "Pacientův stav se náhle <w>prudce zhoršil</w>, což vyžadovalo okamžitý zásah lékařského týmu."
                            }
                        },
                        {
                            "text": "We must monitor the vitals closely because the patient is <w>crumping</w> after the surgery.",
                            "target_lang_translations": {
                                "cs": "Musíme pečlivě sledovat životní funkce, protože pacient po operaci <w>kolabuje</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "circle the drain"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used by medical professionals"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychle se zhoršovat ve zdravotním stavu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prudce se zhoršovat",
                                "target_lang_sense_clarification": "zdravotní stav"
                            },
                            {
                                "target_lang_word": "kolabovat",
                                "target_lang_sense_clarification": "náhlý úpadek zdraví"
                            }
                        ]
                    }
                }
            ]
        },
        {
