                        ],
                        "form": "die Impfpflichten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6f19a5d-07b3-3674-9bad-a1f458176961",
                        "entry_id": "069ed5ab-e905-3364-bf16-f3685a84fc8d",
                        "glosses": [
                            "Vorschrift zur Vakzination (Impfung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d06fcb2f-d7cf-4991-abe0-32a625e07eb5",
                                "sense_id": "e6f19a5d-07b3-3674-9bad-a1f458176961",
                                "text": "„Im Impfwesen der Bundesrepublik Deutschland gibt es keine Impfpflicht für die Bevölkerung, aber die Verpflichtung, Schutzimpfungen anzubieten.“"
                            },
                            {
                                "example_id": "9993ae19-1808-41a0-9d5d-292a48424c4c",
                                "sense_id": "e6f19a5d-07b3-3674-9bad-a1f458176961",
                                "text": "„In Deutschland fordern Politiker parteiübergreifend eine Impfpflicht.“"
                            },
                            {
                                "example_id": "4125dd78-c782-4581-87c4-cb6c0f426aee",
                                "sense_id": "e6f19a5d-07b3-3674-9bad-a1f458176961",
                                "text": "„Um die Masern auszurotten, entschloss sich die Regierung für eine Impfpflicht, die sehr kontrovers diskutiert wurde.“"
                            },
                            {
                                "example_id": "7718212b-3701-4d63-b59b-c10b2f9316d7",
                                "sense_id": "e6f19a5d-07b3-3674-9bad-a1f458176961",
                                "text": "„Italien hat vor wenigen Tagen eine Impfpflicht für Menschen ab 50 eingeführt. Wer sich nicht impfen lässt, muss ein Bußgeld von 100 Euro bezahlen. Eine berufsbezogene Impfpflicht gibt es dort schon seit vergangenem Jahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
