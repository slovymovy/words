                "entry_id": "837bbd57-163a-38ea-8f41-5391c386859e",
                "word": "biter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "048520c9-12a7-4a5f-a3bb-c5e4d89328a0",
                        "entry_id": "837bbd57-163a-38ea-8f41-5391c386859e",
                        "tags": [
                            "plural"
                        ],
                        "form": "biters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "adbf4bb9-aa26-3c9e-8c69-70e2d3724464",
                        "entry_id": "837bbd57-163a-38ea-8f41-5391c386859e",
                        "glosses": [
                            "Agent noun of bite; someone or something who bites or tends to bite."
                        ],
                        "tags": [
                            "agent",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d0ea9867-c014-483b-a440-cbfc65ba7777",
                                "sense_id": "adbf4bb9-aa26-3c9e-8c69-70e2d3724464",
                                "text": "Not all dogs are biters."
                            },
                            {
                                "example_id": "e8e97003-cc39-411a-bdac-1cb28ae799e8",
                                "sense_id": "adbf4bb9-aa26-3c9e-8c69-70e2d3724464",
                                "text": "My dislike was reinforced in 2016 when researchers discovered that more than three-quarters of the domestic boars and 40 per cent of wild boars they examined had bite injuries to their penises. The photos are horrific. Just who the biters were remains a mystery, but I think something goes wrong when a fundamentally herbivorous creature acquires a taste for flesh."
                            }
                        ]
                    },
                    {
                        "sense_id": "59b9bdf4-3bb0-3b6a-91e8-e02212a8a2c6",
                        "entry_id": "837bbd57-163a-38ea-8f41-5391c386859e",
                        "glosses": [
                            "A fish that tends to take bait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9527094a-b3c3-49a5-a581-797c148ebec4",
                                "sense_id": "59b9bdf4-3bb0-3b6a-91e8-e02212a8a2c6",
                                "text": "She tried the same cast several times. I signaled her to switch flies. After two such changes we still couldn't move the fish. Some steelhead are biters; some are not."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1ca4b0c-dccb-3047-8d91-20f0a4d7f2ef",
                        "entry_id": "837bbd57-163a-38ea-8f41-5391c386859e",
                        "glosses": [
                            "A stone that barely touches the outside of the house."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "79a5dc7e-806a-338f-b49f-abab438eb52d",
                        "entry_id": "837bbd57-163a-38ea-8f41-5391c386859e",
                        "glosses": [
                            "One who copies someone else's work, style or techniques, especially in hip-hop."
