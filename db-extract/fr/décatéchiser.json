                "senses": [
                    {
                        "sense_id": "b13ab650-d46f-3547-8ef4-67160444e098",
                        "entry_id": "22138c2e-d80d-3520-b08e-2586af33b0ca",
                        "glosses": [
                            "Faire perdre son caractère catéchisé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d995b12-be3c-46c8-b673-10da9108de1c",
                                "sense_id": "b13ab650-d46f-3547-8ef4-67160444e098",
                                "text": "Tout cela dut être changé, et le malheureux préfet avait grand’peine à décatéchiser, à reprendre ses mots d’ordre, à retirer ses instructions, et à sucrer les articles du journal officiel."
                            },
                            {
                                "example_id": "d9aa568a-bd39-4b29-8cff-24fba06f72f6",
                                "sense_id": "b13ab650-d46f-3547-8ef4-67160444e098",
                                "text": "Suzy, qui s’était mis en tête de la décatéchiser, lui avait formellement interdit d’entrer dans toute église, elle célébrait chaque dimanche matin son propre office dans sa chambre, dont elle avait pris soin auparavant de verrouiller la porte et de fermer les volets."
                            }
                        ]
                    }
