                "senses": [
                    {
                        "sense_id": "021da3aa-2cd5-3e6a-bff6-bd5863fb2edc",
                        "entry_id": "641a1014-17ed-3a0a-aeb9-74a5cdf8c0ee",
                        "glosses": [
                            "Simple femme, par opposition à une personne morale ou publique, ou d’un rang élevé."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "40bb76b5-8053-43c6-907f-73c3ddd20b10",
                                "sense_id": "021da3aa-2cd5-3e6a-bff6-bd5863fb2edc",
                                "text": "— Eh ! Pierrot, une particulière qui veut cirer l’escalier à sa façon, cria le suisse à un groom microscopique passant dans le vestibule."
                            },
                            {
                                "example_id": "1470867d-8099-4afc-a6d4-d7696cbe1299",
                                "sense_id": "021da3aa-2cd5-3e6a-bff6-bd5863fb2edc",
                                "text": "V’là qu’un soir, je pousse une pointe et je m’emmanche dans la boutique, histoire d’aller en reconnaissance et de voir ma particulière."
                            },
                            {
                                "example_id": "457bdb6e-ca37-4d33-9fb4-9154008cb173",
                                "sense_id": "021da3aa-2cd5-3e6a-bff6-bd5863fb2edc",
                                "text": "— Une particulière en gris. Pour ce qui serait de la reconnaître, non. Mais la couleur de la robe, oui… Et le chapeau aussi… un chapeau avec des fleurs violettes…"
                            }
                        ]
                    }
                ],
