                        "entry_id": "c5be2a7d-c84a-35ec-8447-59d51e33e6b1",
                        "glosses": [
                            "À Athènes, une des subdivisions des quatre tribus primitives."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "0df89346-ee99-45fd-b1d9-a9f19b6fa133",
                                "sense_id": "e44a4f38-31f1-355a-8496-ca9560575542",
                                "text": "Afin de l'équiper [la flotte] les quatre tribus furent divisées en douze naucraries."
                            },
                            {
                                "example_id": "64c29c11-3759-4f49-9547-4bfee73d3331",
                                "sense_id": "e44a4f38-31f1-355a-8496-ca9560575542",
                                "text": "À une époque mal déterminée, mais avant Solon, furent établies les naucraries, petites circonscriptions territoriales au nombre de douze par tribu ; chaque naucrarie devait fournir, armer et équiper un bateau de guerre et fournissait en outre deux cavaliers."
                            }
                        ]
                    }
