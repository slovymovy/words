{
    "word_family": [
        "singer",
        "singing",
        "songbird",
        "songwriter",
        "songbook",
        "sing",
        "songless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59fb91fc-36f2-3849-bfd5-7f00389adbc7",
                    "sense_definition": "A musical composition with lyrics for voice or voices, performed by singing.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thomas listened to his favorite <w>song</w> on the radio yesterday.",
                            "target_lang_translations": {
                                "ru": "Томас вчера слушал свою любимую <w>песню</w> по радио."
                            }
                        },
                        {
                            "text": "The band played a <w>popular</w> <w>song</w> that everyone in the crowd knew.",
                            "target_lang_translations": {
                                "ru": "Группа исполнила популярную <w>песню</w>, которую знали все в толпе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "popular song",
                        "favorite song",
                        "write a song"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальное произведение с текстом для голоса или голосов, исполняемое пением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "песня",
                                "target_lang_sense_clarification": "музыкальное произведение"
                            },
                            {
                                "target_lang_word": "песенка",
                                "target_lang_sense_clarification": "разговорное или уменьшительное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b0e8151-894e-3431-acda-7dee5556a432",
                    "sense_definition": "A melodious sound made by a bird, insect, whale or other animal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love hearing the <w>bird</w> <w>song</w> early in the morning.",
                            "target_lang_translations": {
                                "ru": "Мне нравится слушать <w>пение</w> птиц рано утром."
                            }
                        },
                        {
                            "text": "The whale's <w>song</w> could be heard from miles away under the water.",
                            "target_lang_translations": {
                                "ru": "<w>Песню</w> кита можно было услышать за много миль под водой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bird song",
                        "whale song"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелодичные звуки, издаваемые птицей, насекомым, китом или другим животным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пение",
                                "target_lang_sense_clarification": "звуки животных"
                            },
                            {
                                "target_lang_word": "песня",
                                "target_lang_sense_clarification": "мелодия животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0e7c48b-4237-3767-a3dc-071f2ddf1f60",
                    "sense_definition": "The act or art of singing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birds were <w>bursting</w> <w>into</w> <w>song</w> as soon as the sun came up.",
                            "target_lang_translations": {
                                "ru": "Птицы <w>запели</w>, как только взошло солнце."
                            }
                        },
                        {
                            "text": "She has dedicated her entire life to the study of <w>song</w> and performance.",
                            "target_lang_translations": {
                                "ru": "Она посвятила всю свою жизнь изучению <w>пения</w> и исполнительского мастерства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burst into song"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или искусство пения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пение",
                                "target_lang_sense_clarification": "процесс или искусство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21be1dee-fbfb-30ba-be66-97a52318c04f",
                    "sense_definition": "A very low price, especially one much lower than the expected value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought that vintage car <w>for</w> <w>a</w> <w>song</w> at the local auction.",
                            "target_lang_translations": {
                                "ru": "Он купил ту винтажную машину за <w>бесценок</w> на местном аукционе."
                            }
                        },
                        {
                            "text": "The house was in such bad condition that it sold <w>for</w> <w>a</w> <w>song</w>.",
                            "target_lang_translations": {
                                "ru": "Дом был в таком плохом состоянии, что его продали за <w>гроши</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "for a song"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "chiefly in the phrase 'for a song'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень низкая цена, особенно намного ниже ожидаемой стоимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесценок",
                                "target_lang_sense_clarification": "очень низкая цена"
                            },
                            {
                                "target_lang_word": "гроши",
                                "target_lang_sense_clarification": "мизерная сумма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "563a921b-9be9-3518-ba5f-66c8a8c34da5",
                    "sense_definition": "A poetical composition, poetry, or verse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient bard tuned his lyre to perform an <w>ancient</w> <w>song</w> for the king.",
                            "target_lang_translations": {
                                "ru": "Древний бард настроил свою лиру, чтобы исполнить древнюю <w>песнь</w> для короля."
                            }
                        },
                        {
                            "text": "This epic <w>song</w> tells the story of a hero from long ago.",
                            "target_lang_translations": {
                                "ru": "Эта эпическая <w>песнь</w> повествует о герое далекого прошлого."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ancient song",
                        "heroic song"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in a literary or historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поэтическое произведение, поэзия или стих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "песнь",
                                "target_lang_sense_clarification": "высокий или архаичный стиль"
                            },
                            {
                                "target_lang_word": "песня",
                                "target_lang_sense_clarification": "поэтическое произведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e3f0681-b1fa-3b9d-bddf-19ee3ee921f2",
                    "sense_definition": "An object of derision or a laughing stock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "derision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the scandal, he became their <w>song</w> and a target for their jokes.",
                            "target_lang_translations": {
                                "ru": "После скандала он стал их <w>посмешищем</w> и мишенью для шуток."
                            }
                        },
                        {
                            "text": "The failed project was the <w>song</w> of the entire office for weeks.",
                            "target_lang_translations": {
                                "ru": "Провальный проект в течение нескольких недель был <w>притчей во языцех</w> для всего офиса."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily found in biblical or older literary texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект насмешек или посмешище."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притча во языцех",
                                "target_lang_sense_clarification": "объект всеобщих разговоров и насмешек"
                            },
                            {
                                "target_lang_word": "посмешище",
                                "target_lang_sense_clarification": "объект издевательств"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "609f6dfa-90e0-30fa-9dd3-71bf6b69615f",
                    "sense_definition": "A former dynasty in China, reigning from 960 to 1279.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chinese_history",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "The <w>Song</w> Dynasty is known for its significant advancements in technology and art.",
                            "target_lang_translations": {
                                "ru": "Династия <w>Сун</w> известна своими значительными достижениями в области технологий и искусства."
                            }
                        },
                        {
                            "text": "A rare bowl from the <w>Song</w> era was sold for millions at the auction.",
                            "target_lang_translations": {
                                "ru": "Редкая чаша эпохи <w>Сун</w> была продана на аукционе за миллионы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Song Dynasty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бывшая династия в Китае, правившая с 960 по 1279 год."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сун",
                                "target_lang_sense_clarification": "китайская династия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e7c767f-4be3-3182-a5e7-380fb8372683",
                    "sense_definition": "A common surname of Chinese origin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Song</w> is the new manager of the international trade department.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Сун</w> — новый менеджер отдела международной торговли."
                            }
                        },
                        {
                            "text": "There are many people with the surname <w>Song</w> living in this city.",
                            "target_lang_translations": {
                                "ru": "В этом городе живет много людей с фамилией <w>Сун</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Chinese origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная фамилия китайского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сун",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7769c615-2a13-3222-85bd-93a2a32e35b8",
                    "sense_definition": "The name of various rivers in China.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Song</w> River flows through several provinces in the eastern part of the country.",
                            "target_lang_translations": {
                                "ru": "Река <w>Сун</w> протекает через несколько провинций в восточной части страны."
                            }
                        },
                        {
                            "text": "Local legends often mention the spirits living in the <w>Song</w> waters.",
                            "target_lang_translations": {
                                "ru": "Местные легенды часто упоминают духов, живущих в водах <w>Сун</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Songjiang",
                        "Song Jiang"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "China"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных рек в Китае."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сун",
                                "target_lang_sense_clarification": "название реки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}