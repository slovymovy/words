                "senses": [
                    {
                        "sense_id": "3db6edf9-5b6f-3962-ac1c-7a8b51825004",
                        "entry_id": "b6d37635-4e77-3c47-8959-9b469df4116d",
                        "glosses": [
                            "недовесить по ошибке или намеренно"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "925f5eec-7ac4-3d10-9212-6e4e57c914b6",
                        "entry_id": "b6d37635-4e77-3c47-8959-9b469df4116d",
                        "glosses": [
                            "просушить на воздухе, провялить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99573baa-ad9d-428c-bdc7-d8ebd225fd9c",
                                "sense_id": "925f5eec-7ac4-3d10-9212-6e4e57c914b6",
                                "text": "— Была прежде свинья, потом её зарезали, рассортировали, окорока посолили, провесили — вот и ветчина сделалась."
                            }
                        ]
                    },
                    {
                        "sense_id": "04899c75-c507-390d-843d-3d28a1af2f16",
                        "entry_id": "b6d37635-4e77-3c47-8959-9b469df4116d",
                        "glosses": [
                            "спец. проверить прямизну, вертикальность или горизонтальность чего-либо; выполнить провеску"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c39b3f71-b3f2-4300-95f8-241f3d871da6",
                                "sense_id": "04899c75-c507-390d-843d-3d28a1af2f16",
                                "text": "Провесить стену, поверить отвесом; провесить потолок, поверить по уровню."
                            }
                        ]
                    }
                ],
