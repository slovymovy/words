                        "glosses": [
                            "Covered in short, stiff hairs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27d45fa5-5294-4203-a14f-3d2fcdec410c",
                                "sense_id": "6ccfc6cd-dbde-3811-b74b-69b17e12ed33",
                                "text": "The hispid hare inhabits forested areas."
                            },
                            {
                                "example_id": "7664501e-e5f2-4759-8ef6-d5ec4819c3d9",
                                "sense_id": "6ccfc6cd-dbde-3811-b74b-69b17e12ed33",
                                "text": "An erect, branching, hispid or glabrate annual, 1 ft. high. Radical leaves petioled, crowded, spreading on the ground, hispid with white hairs, lobes toothed; cauline entire or pinnatifid."
                            },
                            {
                                "example_id": "7b1578a7-ef7a-45eb-b1a2-a97f94098a94",
                                "sense_id": "6ccfc6cd-dbde-3811-b74b-69b17e12ed33",
                                "text": "Larger and stouter, less than a foot high, much branched, roughish-hispid: nutlets dull, with rounded sides, no angles, and a large and deep areola or scar."
                            }
                        ]
                    }
