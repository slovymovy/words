            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc70d732-e0a0-3f59-99d9-0c10a718d1a0",
                    "sense_definition": "aus einer Gefangenschaft, Bedrohung oder akuten Gefahr fliehen und dadurch entkommen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flucht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dem Gefangenen gelang es in der Nacht, aus der schwer bewachten Festung zu <w>entfliehen</w>."
                        },
                        {
                            "text": "Die Dorfbewohner mussten hastig packen und <w>entflohen</w> der drohenden Überschwemmung in die Berge."
                        }
                    ],
                    "synonyms": [
                        "ausbrechen",
                        "entkommen",
                        "entrinnen",
                        "flüchten"
                    ],
                    "common_phrases": [
                        "aus dem Gefängnis entfliehen",
                        "der Gefangenschaft entfliehen"
                    ]
                },
                {
                    "sense_id": "936a2263-1ff5-3ff7-bfdc-1deb55dfe699",
                    "sense_definition": "einer belastenden, monotonen oder unangenehmen Lebenssituation gedanklich oder räumlich ausweichen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ausweichen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Menschen reisen am Wochenende in die Berge, um dem hektischen Alltag zu <w>entfliehen</w>."
                        },
                        {
                            "text": "Mit spannenden Büchern versucht sie regelmäßig, der grauen Realität für ein paar Stunden zu <w>entfliehen</w>."
                        }
                    ],
                    "synonyms": [
                        "entgehen",
                        "entrinnen"
                    ],
                    "common_phrases": [
                        "dem Alltag entfliehen",
                        "der Realität entfliehen"
                    ]
                },
                {
                    "sense_id": "997049be-40a1-30d3-ba14-bad8b1786358",
                    "sense_definition": "in Bezug auf Zeit oder Momente: sehr schnell vergehen oder unwiederbringlich verstreichen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn man in guter Gesellschaft ist, <w>entflieht</w> die Zeit wie im Flug."
                        },
                        {
                            "text": "Nutze die Gelegenheit rechtzeitig, bevor der günstige Augenblick für immer <w>entflieht</w>."
                        }
                    ],
                    "synonyms": [
                        "verrinnen"
                    ],
                    "common_phrases": [
                        "die Zeit entflieht",
                        "der Augenblick entflieht"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "gehobener oder poetischer Sprachgebrauch"
                        }
                    ]
                }
            ]
        }
