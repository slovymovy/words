{
    "word_family": [
        "couronne",
        "couronnement",
        "découronner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f9b28a2-9449-3070-a7a2-584c75a662a1",
                    "sense_definition": "Poser solennellement la couronne sur la tête d'un monarque lors de son sacre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "monarchie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'archevêque s'apprête à <w>couronner</w> le nouveau roi dans la cathédrale historique."
                        },
                        {
                            "text": "Après des années d'attente, elle s'est fait <w>couronner</w> reine devant le peuple réuni."
                        }
                    ],
                    "synonyms": [
                        "sacrer"
                    ],
                    "antonyms": [
                        "détrôner"
                    ],
                    "common_phrases": [
                        "couronner un roi",
                        "se faire couronner"
                    ]
                },
                {
                    "sense_id": "dc408c28-bfb5-36b1-8d20-06cf958ee4a4",
                    "sense_definition": "Mettre une couronne sur la tête de quelqu'un, en particulier de fleurs ou de feuillage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ornement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants aiment <w>couronner</w> leurs amis avec des guirlandes de fleurs fraîches."
                        },
                        {
                            "text": "Pendant le festival traditionnel, on a <w>couronné</w> la jeune fille d'une parure d'olivier."
                        }
                    ],
                    "synonyms": [
                        "ceindre"
                    ],
                    "common_phrases": [
                        "couronner de fleurs",
                        "couronner de lauriers"
                    ]
                },
                {
                    "sense_id": "af6b1d38-d74a-3036-8144-beca62ae2900",
                    "sense_definition": "Achever ou terminer heureusement une entreprise, en constituer le point culminant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aboutissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une formidable médaille d'or est venue <w>couronner</w> des années de travail acharné."
                        },
                        {
                            "text": "Le grand banquet annuel doit <w>couronner</w> une semaine de célébrations culturelles."
                        }
                    ],
                    "synonyms": [
                        "parachever",
                        "consacrer"
                    ],
                    "common_phrases": [
                        "couronner de succès",
                        "pour couronner le tout"
                    ]
                },
                {
                    "sense_id": "b330835a-4447-3488-9d03-ad6705715054",
                    "sense_definition": "Récompenser ou distinguer officiellement une personne ou une œuvre par un prix.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jury a décidé de <w>couronner</w> ce premier roman pour son style remarquable."
                        },
                        {
                            "text": "L'académie <w>couronne</w> chaque année des scientifiques auteurs de découvertes majeures."
                        }
                    ],
                    "synonyms": [
                        "récompenser",
                        "primer"
                    ],
                    "common_phrases": [
                        "couronner un lauréat",
                        "couronner un ouvrage"
                    ]
                },
                {
                    "sense_id": "9488ed81-7db9-3924-9767-b930f4a67a22",
                    "sense_definition": "Surmonter quelque chose, occuper la partie supérieure d'un lieu ou d'un édifice.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ornement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un dôme en cuivre étincelant vient <w>couronner</w> ce monument récemment restauré."
                        },
                        {
                            "text": "D'anciennes fortifications en pierre <w>couronnent</w> la crête escarpée de la montagne."
                        }
                    ],
                    "synonyms": [
                        "surmonter",
                        "coiffer"
                    ],
                    "common_phrases": [
                        "couronner la colline",
                        "couronner un édifice"
                    ]
                },
                {
                    "sense_id": "fa2bb48f-2fff-3e88-b99d-0df15b0f3035",
                    "sense_definition": "En parlant d'un cheval, s'écorcher ou se blesser aux genoux à la suite d'une chute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "veterinaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La monture a trébuché sur le sentier et a manqué de se <w>couronner</w>."
                        },
                        {
                            "text": "Ce cheval s'est <w>couronné</w> en butant violemment contre un obstacle pendant la course."
                        }
                    ],
                    "common_phrases": [
                        "se couronner les genoux"
                    ]
                }
            ]
        }
    ]
}