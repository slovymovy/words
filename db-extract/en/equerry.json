                    },
                    {
                        "sense_id": "852bfb46-db4e-3041-9354-cfd682b558b4",
                        "entry_id": "b1b93605-1e0c-3447-ba79-dcdfeb38c03f",
                        "glosses": [
                            "A personal attendant to a head of state, a member of a royal family, or a national representative."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "f90edd19-2a39-433b-bc76-5368d20b07ac",
                                "sense_id": "852bfb46-db4e-3041-9354-cfd682b558b4",
                                "text": "A bedroom is provided for the equerry and one for the King's physician. […] The compartments for the doctor and equerry are panelled in West African betula and cherry mahogany."
                            }
                        ]
                    }
                ],
