                                "target_senses": [
                                    {
                                        "sense_id": "d2d85ca0-38f8-345e-9a00-58da61b0ebeb",
                                        "entry_id": "0c58edea-4b98-34e5-a866-358e25926c41",
                                        "glosses": [
                                            "Ligne qui sépare la partie submergée de celle qui ne l’est pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88cadcc0-03bc-4c35-a0a6-4626e13899a7",
                                                "sense_id": "d2d85ca0-38f8-345e-9a00-58da61b0ebeb",
                                                "text": "Le chebek est un bâtiment élégant et rapide. Il a un faible tirant d’eau avec une ligne de flottaison concave vers l'avant et des flancs bombés ; […]."
                                            },
                                            {
                                                "example_id": "c21adda3-2b54-46f6-b4b8-6cd2b8ff2856",
                                                "sense_id": "d2d85ca0-38f8-345e-9a00-58da61b0ebeb",
                                                "text": "Plus dense que le Cocos nucifera le coco de mer a sa ligne de flottaison trop basse et l’eau pénétrant dans la graine, elle arrive morte sur les côtes étrangères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fe44837-12e6-3c49-a10d-d56bbfa411c3",
                                        "entry_id": "0c58edea-4b98-34e5-a866-358e25926c41",
                                        "glosses": [
                                            "Partie visible d'un site web sans utilisation de la barre de défilement."
                                        ],
                                        "tags": [],
                                        "examples": [
