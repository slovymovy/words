                    "frequency": "High",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour la fête de l'école, les parents vont <w>déguiser</w> leurs enfants avec des costumes colorés."
                        },
                        {
                            "text": "Le détective a décidé de se <w>déguiser</w> en serveur afin d'observer discrètement les suspects."
                        }
                    ],
