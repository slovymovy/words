                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df84f3bf-f26d-4653-9287-732619d8b877",
                                                "sense_id": "42573fc6-56bb-336c-b600-51dabaaf231c",
                                                "text": "Sie lag auf dem Bauch."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "eb782014-3350-3ece-8676-c7c0d558ae21",
                                        "entry_id": "032236a3-4ac4-33f5-b30f-c74113d10d1c",
                                        "glosses": [
                                            "mit der bezeichneten Seite nach unten"
                                        ],
                                        "tags": [
                                            "prepositional",
                                            "with-accusative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4cb7176-639a-465f-bca5-f9cde488303f",
                                                "sense_id": "eb782014-3350-3ece-8676-c7c0d558ae21",
                                                "text": "Sie legte sich auf den Bauch."
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "8e8ea1bc-9a92-382d-8bbc-8a540fc2fd94",
                                        "entry_id": "032236a3-4ac4-33f5-b30f-c74113d10d1c",
                                        "glosses": [
                                            "an der Oberfläche von etwas"
                                        ],
                                        "tags": [
                                            "prepositional",
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd96ab6c-6e15-43a2-89ce-f3acd772d123",
                                                "sense_id": "8e8ea1bc-9a92-382d-8bbc-8a540fc2fd94",
                                                "text": "Sie spürte ein Kribbeln auf der Haut. (aber: Sie spürte ein Kribbeln am Rücken.)"
                                            },
                                            {
                                                "example_id": "9d711149-06ff-4e91-87aa-45450a4bf844",
                                                "sense_id": "8e8ea1bc-9a92-382d-8bbc-8a540fc2fd94",
                                                "text": "Das steht auf Seite 28. Anton Puvogel: „Landschaft“, Acryl auf Leinwand, 1968"
                                            }
                                        ],
                                        "sense_index_json": "\"3a\""
                                    },
                                    {
                                        "sense_id": "33b7fad8-b794-3de6-935f-66143754c931",
                                        "entry_id": "032236a3-4ac4-33f5-b30f-c74113d10d1c",
                                        "glosses": [
                                            "an die Oberfläche von etwas"
                                        ],
                                        "tags": [
                                            "prepositional",
                                            "with-accusative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "158e3074-e35f-45ed-8511-abde02d21a8a",
                                                "sense_id": "33b7fad8-b794-3de6-935f-66143754c931",
                                                "text": "Sie schrieb es auf die Rückseite. (aber: Sie malte es an die Wand.)"
                                            },
                                            {
                                                "example_id": "acf3a641-33f3-4685-a085-184b957246d8",
                                                "sense_id": "33b7fad8-b794-3de6-935f-66143754c931",
                                                "text": "Er leimte es auf die Unterseite. (aber: Er nagelte es unter die Tischplatte.)"
                                            }
                                        ],
                                        "sense_index_json": "\"3b\""
                                    },
                                    {
                                        "sense_id": "445b0d47-853a-3a3b-83f3-ecc5bad6315f",
                                        "entry_id": "032236a3-4ac4-33f5-b30f-c74113d10d1c",
                                        "glosses": [
                                            "bei einer Unternehmung oder Veranstaltung"
                                        ],
                                        "tags": [
                                            "prepositional",
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbfec738-f8fa-428d-8bb7-0750958e578b",
                                                "sense_id": "445b0d47-853a-3a3b-83f3-ecc5bad6315f",
                                                "text": "Sie waren schon auf der Reise. Ich traf sie auf der Kirmes. Er stand auf dem Markt."
                                            }
                                        ],
                                        "sense_index_json": "\"4a\""
                                    },
                                    {
                                        "sense_id": "9e436432-b64c-3708-9b4e-2cbdeebdd4f4",
                                        "entry_id": "032236a3-4ac4-33f5-b30f-c74113d10d1c",
                                        "glosses": [
                                            "zu einer Unternehmung oder Veranstaltung"
                                        ],
                                        "tags": [
                                            "prepositional",
                                            "with-accusative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60009095-966f-44f3-adca-df3e6c8c6c20",
                                                "sense_id": "9e436432-b64c-3708-9b4e-2cbdeebdd4f4",
                                                "text": "Sie gingen auf die Reise. Sie ging auf die Kirmes. Er brachte seine Erfindung auf den Markt."
                                            }
                                        ],
                                        "sense_index_json": "\"4b\""
                                    },
                                    {
                                        "sense_id": "9b1eaaf9-7962-33e6-8ef1-b4514f4a4905",
                                        "entry_id": "032236a3-4ac4-33f5-b30f-c74113d10d1c",
                                        "glosses": [
                                            "an einer Örtlichkeit, die einem zu Füßen liegt"
                                        ],
                                        "tags": [
                                            "prepositional",
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66b0d388-6081-407e-b0ad-3d8ec25fb864",
                                                "sense_id": "9b1eaaf9-7962-33e6-8ef1-b4514f4a4905",
                                                "text": "Ich traf sie auf der Straße (aber: Sie wohnt in der Bäckerstraße.)"
                                            },
                                            {
                                                "example_id": "fce63068-c91b-482c-b9ca-5b6399ca33e0",
                                                "sense_id": "9b1eaaf9-7962-33e6-8ef1-b4514f4a4905",
                                                "text": "Sie begegneten sich auf dem Schillerplatz: (aber: Er wohnte am Schillerplatz.)"
                                            },
                                            {
                                                "example_id": "47140a5c-472f-4027-baf3-e59475741a11",
                                                "sense_id": "9b1eaaf9-7962-33e6-8ef1-b4514f4a4905",
                                                "text": "Er arbeitet auf dem Feld: (aber: Sie trafen sich im Felde = auf dem Schlachtfeld)"
                                            },
                                            {
                                                "example_id": "95a8a83c-0cd6-4978-b711-e22269f3b9dd",
                                                "sense_id": "9b1eaaf9-7962-33e6-8ef1-b4514f4a4905",
                                                "text": "Er wohnt auf dem Lande (= nicht in der Stadt) aber: Er ist wieder im Lande = in der Heimat. Sie leben im Lande Bayern.)"
                                            }
                                        ],
                                        "sense_index_json": "\"5a\""
                                    },
                                    {
                                        "sense_id": "286d7197-6f38-3b0f-b319-16e5d540fbe8",
                                        "entry_id": "032236a3-4ac4-33f5-b30f-c74113d10d1c",
                                        "glosses": [
                                            "zu einer Örtlichkeit, die einem zu Füßen liegt"
                                        ],
                                        "tags": [
                                            "prepositional",
                                            "with-accusative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d73cc85c-9833-4afd-8b37-0b5e284c7ab7",
                                                "sense_id": "286d7197-6f38-3b0f-b319-16e5d540fbe8",
                                                "text": "Er ging auf die Straße. Dann kamen wir auf die Bäckerstraße. (aber: Dann fuhren/zogen wir in die Bäckerstraße.)"
                                            },
                                            {
                                                "example_id": "4c3f9f85-f33a-42dc-92b8-bb56373e350d",
                                                "sense_id": "286d7197-6f38-3b0f-b319-16e5d540fbe8",
                                                "text": "Sie ging auf den Schillerplatz. (aber: Sie zog an den Schillerplatz.)"
                                            },
                                            {
                                                "example_id": "210c9884-e8a2-4c74-875b-778deb48d25b",
                                                "sense_id": "286d7197-6f38-3b0f-b319-16e5d540fbe8",
                                                "text": "Er ging aufs Feld. (aber: Sie zogen ins Feld oder zu Felde.)"
                                            },
                                            {
                                                "example_id": "1965b462-a47f-4d86-9188-579c17972a93",
                                                "sense_id": "286d7197-6f38-3b0f-b319-16e5d540fbe8",
                                                "text": "Wir fahren/ziehen aufs Land (= aus der Stadt), aber: Sie kommen ins Land. Die Tage gehen ins Land.)"
                                            }
                                        ],
                                        "sense_index_json": "\"5b\""
                                    },
                                    {
                                        "sense_id": "0057e02b-eed4-3446-a566-d237f0911aac",
                                        "entry_id": "032236a3-4ac4-33f5-b30f-c74113d10d1c",
                                        "glosses": [
                                            "in einer bestimmten Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb4cbdf-2cf5-4636-a4d1-a881812f866b",
                                                "sense_id": "0057e02b-eed4-3446-a566-d237f0911aac",
                                                "text": "Das ist auf Deutsch geschrieben."
                                            },
                                            {
                                                "example_id": "b900ed42-bfe4-4b52-97bb-d95db1102017",
