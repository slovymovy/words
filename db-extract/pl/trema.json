                    {
                        "translation_id": "6b5dbbe8-458e-480b-a754-c3e88cbb4b70",
                        "source_entry_id": "5043e9c0-eaba-3174-8e37-8db83b88468e",
                        "source_sense_id": "a4d4bc2d-4db7-378b-84d5-c3c1e642d80d",
