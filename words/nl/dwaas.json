{
    "word_family": [
        "dwaasheid",
        "dwazin",
        "verdwaasd"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "681baf00-85c9-3434-9b33-015a0ce560f3",
                    "sense_definition": "gebrek aan gezond verstand tonend; onverstandig of gek",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onverstandig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>dwaas</w> idee om zonder jas naar buiten te gaan in de kou.",
                            "target_lang_translations": {
                                "en": "It was a <w>foolish</w> idea to go outside in the cold without a coat."
                            }
                        },
                        {
                            "text": "Zijn <w>dwaze</w> gedrag zorgde voor veel onbegrip bij zijn collega's.",
                            "target_lang_translations": {
                                "en": "His <w>silly</w> behavior caused a lot of misunderstanding among his colleagues."
                            }
                        }
                    ],
                    "synonyms": [
                        "zot",
                        "dom"
                    ],
                    "antonyms": [
                        "verstandig",
                        "wijs"
                    ],
                    "common_phrases": [
                        "dwaas idee",
                        "dwaze streek",
                        "dwaas gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "showing a lack of common sense; unwise or foolish"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "foolish",
                                "target_lang_sense_clarification": "lacking good sense or judgment"
                            },
                            {
                                "target_lang_word": "silly",
                                "target_lang_sense_clarification": "playfully or thoughtlessly foolish"
                            },
                            {
                                "target_lang_word": "crazy",
                                "target_lang_sense_clarification": "wildly impractical or senseless"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2f93bd3-5cdd-3159-a3a9-8bd4384bfa6f",
                    "sense_definition": "iemand die zich onverstandig gedraagt of onlogisch denkt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onverstandig persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alleen een <w>dwaas</w> zou zijn hele fortuin in één dag uitgeven.",
                            "target_lang_translations": {
                                "en": "Only a <w>fool</w> would spend his entire fortune in one day."
                            }
                        },
                        {
                            "text": "De <w>dwaas</w> maakte veel lawaai op de markt en trok alle aandacht.",
                            "target_lang_translations": {
                                "en": "The <w>idiot</w> made a lot of noise at the market and drew everyone's attention."
                            }
                        }
                    ],
                    "synonyms": [
                        "domoor",
                        "gek",
                        "idioot",
                        "stommeling",
                        "sukkel"
                    ],
                    "common_phrases": [
                        "een grote dwaas",
                        "zich als een dwaas gedragen"
                    ],
                    "target_lang_definitions": {
                        "en": "someone who behaves unwisely or thinks illogically"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fool",
                                "target_lang_sense_clarification": "a person with poor judgment"
                            },
                            {
                                "target_lang_word": "idiot",
                                "target_lang_sense_clarification": "a person who makes stupid decisions"
                            },
                            {
                                "target_lang_word": "nincompoop",
                                "target_lang_sense_clarification": "a silly or foolish person"
                            },
                            {
                                "target_lang_word": "prat",
                                "target_lang_sense_clarification": "a contemptible fool"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}