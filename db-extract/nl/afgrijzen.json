                                    }
                                ]
                            },
                            {
                                "target_word": "dread",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b2f6428-81c0-3dbe-af43-eedab418025a",
                                        "entry_id": "f9527d8c-9ae1-3447-8dac-1182c96a4ee5",
                                        "glosses": [
                                            "Terrible; greatly feared; dreaded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da0c24b9-c160-4410-b200-b993e69c9a59",
                                                "sense_id": "7b2f6428-81c0-3dbe-af43-eedab418025a",
                                                "text": "With cat-like tread / Upon our prey we steal / In silence dread / Our cautious way we feel"
                                            },
                                            {
                                                "example_id": "57bffef5-03ef-4a15-b1af-4f9c98e171c2",
                                                "sense_id": "7b2f6428-81c0-3dbe-af43-eedab418025a",
                                                "text": "I even remember thinking that no human being would go down that dread path again."
                                            },
                                            {
