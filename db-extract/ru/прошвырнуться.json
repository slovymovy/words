                        "examples": [
                            {
                                "example_id": "c4f9b56c-b60a-4bfa-bbe0-9b9cfa0a4444",
                                "sense_id": "d6d0bbc6-578b-3d0a-963d-85084e8ba06a",
                                "text": "Прошвырну́лся, — отве́тил Число́в с како́й-то стра́нной интона́цией. Полко́вник попыта́лся посмотре́ть ему́ в глаза́, но капитáн отвёл взгляд.",
                                "translation": "\"Went out for a bit,\" Chislov answered with some strange intonation. The colonel tried to meet his eyes, but the captain looked away.",
                                "english": "\"Went out for a bit,\" Chislov answered with some strange intonation. The colonel tried to meet his eyes, but the captain looked away."
                            }
                        ]
                    }
