                "senses": [
                    {
                        "sense_id": "afdcd921-02fa-3249-862e-e57b80348f8c",
                        "entry_id": "92ab0b94-8649-3560-81a2-bd349acd8f85",
                        "glosses": [
                            "weibliche Person, die zu Hause gegen Bezahlung Aufträge erledigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96127549-4717-457d-b30a-79c09564054f",
                                "sense_id": "afdcd921-02fa-3249-862e-e57b80348f8c",
                                "text": "„Die Textilbetriebe der Stadt verlegten sich weitgehend auf Uniformen, während viele Heimarbeiterinnen zerfetzte Soldatenkleidung flickten, die oft aus nahe gelegenen Lazaretten angeliefert wurde.“"
                            },
                            {
                                "example_id": "cdfd79f2-8bc3-46da-a470-030e6fed3c84",
                                "sense_id": "afdcd921-02fa-3249-862e-e57b80348f8c",
                                "text": "„Die extreme Armut in der zu Ende gehenden Monarchie, die schweren Lebensbedingungen der Arbeiterschaft, besonders der Frauen in den Ziegelfabriken und der Heimarbeiterinnen, veranlassen sie zu ihrem sozialpolitischen Engagement.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
