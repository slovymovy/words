                        "glosses": [
                            "Shortened form of fraternity, college organization. (Often used as a noun modifier.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e8bdcf1-07ed-4c7d-bace-722e8b46878f",
                                "sense_id": "b0814ef2-43cb-3239-8dfb-9d3f539df477",
                                "text": "frat party"
                            },
                            {
                                "example_id": "a4e0d3c3-1141-486b-ac0b-b1c443320dcc",
                                "sense_id": "b0814ef2-43cb-3239-8dfb-9d3f539df477",
                                "text": "See you at the frat house."
                            },
                            {
                                "example_id": "d07d6b88-f36a-42a4-b125-11a18508636c",
                                "sense_id": "b0814ef2-43cb-3239-8dfb-9d3f539df477",
                                "text": "All the frats will be there."
                            },
                            {
                                "example_id": "064bc609-a2a7-4121-aeec-d8be74cf2c5f",
                                "sense_id": "b0814ef2-43cb-3239-8dfb-9d3f539df477",
                                "text": "\"But the cultural conflict between these two post-revolutionary styles — between frat guys and feminist bluestockings, Gamergaters and the diversity police, alt-right provocateurs and 'woke' dudebros, the mouthbreathers who poured hate on the all-female 'Ghostbusters' and the tastemakers who pretended it was good — is likely here to stay.\""
                            },
                            {
                                "example_id": "b8527856-41ab-491d-91e8-55ecb6c8b3d3",
                                "sense_id": "b0814ef2-43cb-3239-8dfb-9d3f539df477",
                                "text": "And Florida State University suspended all frats and sororities for two months after the November 2017 death of Pi Kappa Phi pledge Andrew Coffey, which has since been determined to have been due to hazing, according to police."
                            }
                        ]
                    }
