                        "entry_id": "170a4046-cb16-3bfe-a919-d34305fa624c",
                        "tags": [],
                        "form": "peplum"
                    },
                    {
                        "form_id": "68d57f31-6acb-483a-89da-a6a426c986c8",
                        "entry_id": "170a4046-cb16-3bfe-a919-d34305fa624c",
                        "tags": [
                            "familiar"
                        ],
                        "form": "péplome"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8015686e-7d12-3248-ba5f-6d5c71195e0d",
                        "entry_id": "170a4046-cb16-3bfe-a919-d34305fa624c",
                        "glosses": [
                            "Manteau de laine que les femmes grecques mettaient par-dessus la tunique et qu’elles portaient attaché à l’épaule par une agrafe."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "bbcbb525-32eb-45bf-a5d0-23856b4b8a36",
                                "sense_id": "8015686e-7d12-3248-ba5f-6d5c71195e0d",
                                "text": "[…] elle détacha le camée qui agrafait son péplum sur son épaule, […]"
                            },
                            {
                                "example_id": "78489ae4-5846-4e85-b1e6-1b2f70639a21",
                                "sense_id": "8015686e-7d12-3248-ba5f-6d5c71195e0d",
                                "text": "Drapée dans une sorte de péplum blanc qui laissait apparaître ses épaules de marbre et ses bras magnifiques, on eût dit une fée shakespearienne, s’évadant tout à coup de la nuit."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e303460-0496-3bff-9ebd-4f24062cb6ee",
                        "entry_id": "170a4046-cb16-3bfe-a919-d34305fa624c",
                        "glosses": [
                            "Film de fiction de reconstitution historique dont l’action se situe dans l’Antiquité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7a1336a-aacc-4433-9c16-7b9d44ce07e9",
                                "sense_id": "4e303460-0496-3bff-9ebd-4f24062cb6ee",
                                "text": "Les Cahiers du cinéma aborde les différentes questions esthétiques engendrées par la production de genre, s’il en est, du péplum dans « L’âge du péplum », en mai 1962."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa3fe15e-82ce-35ae-87c8-411b7a8cd4d5",
                        "entry_id": "170a4046-cb16-3bfe-a919-d34305fa624c",
                        "glosses": [
                            "Jupe courte ou volant évasé superposé à la taille d’une veste, d’un chemisier ou d’une robe."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6af6bc88-8760-43fa-a1ef-221072a44ed2",
                        "source_entry_id": "170a4046-cb16-3bfe-a919-d34305fa624c",
                        "source_sense_description": "Manteau antique",
                        "target_lang_word": "Peplon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "798564ee-62ba-424a-bb0f-86e92fe2e02c",
                        "source_entry_id": "170a4046-cb16-3bfe-a919-d34305fa624c",
                        "source_sense_description": "Manteau antique",
                        "target_lang_word": "peplum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peplum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b70fa861-31ae-3149-8bdb-119dd9ce6c45",
                                        "entry_id": "e269c609-617a-317a-ab7a-af0a1696d70b",
                                        "glosses": [
                                            "A peplos, an Ancient Greek garment formed of a tubular piece of cloth folded back upon itself halfway down so that the top of the tube is worn around the waist, and the bottom covers the legs down to the ankles; the open top is then worn over the shoulders, and draped, in folds, down to the waist. Compare the Roman palla."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc356927-01a8-31b9-928a-1dd6b6053cd8",
                                        "entry_id": "e269c609-617a-317a-ab7a-af0a1696d70b",
                                        "glosses": [
                                            "A kind of women's outer garment in ancient Greece; a veil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b93de36-7210-4ecc-993a-9d215710427d",
                                                "sense_id": "fc356927-01a8-31b9-928a-1dd6b6053cd8",
                                                "text": "And this was Neith, or Athena, that God thus described, \"I am all that was, is, and shall be, and my peplum or veil, no mortal could ever uncover.\" […] Peplum is properly a womanish pall or veil, embroidered all over and consecrated to Minerva."
                                            },
                                            {
                                                "example_id": "b590366e-db62-4658-bab6-da46e3097ed1",
                                                "sense_id": "fc356927-01a8-31b9-928a-1dd6b6053cd8",
                                                "text": "1838: The North American Review, volume XLVII\nThe outer garment was called the peplum, and was used more for occasions of ceremony than for ordinary convenience, as it was very long and ample, and, from the manner of putting it on, must have been inconvenient to the wearer. It was sometimes wound double round the body, […]"
                                            },
                                            {
                                                "example_id": "5285da26-1b12-4b46-8ecd-9eddf71ee7a5",
                                                "sense_id": "fc356927-01a8-31b9-928a-1dd6b6053cd8",
                                                "text": "Over this they adopted the Greek peplum, under the name of palla. This garment, however, was exclusively confined to the gentler sex, and was never worn, as was the peplum among the Greeks, by men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b891d6f-0e7b-302a-815d-61518d5f562f",
                                        "entry_id": "e269c609-617a-317a-ab7a-af0a1696d70b",
                                        "glosses": [
                                            "A short overskirt cut in such a way that the sides form points."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d21968c-8bc0-378c-8293-2d983349ae1c",
                                        "entry_id": "e269c609-617a-317a-ab7a-af0a1696d70b",
                                        "glosses": [
                                            "A short overskirt attached to the waist of a garment; a basque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "peplum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9663c4ba-6c69-38ed-86dc-d35c8bf9d41a",
                                        "entry_id": "ab2f33f9-8cad-3243-8222-a922dd0d5502",
                                        "glosses": [
                                            "A genre of Italian films based on historical or biblical epics."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb329841-b57c-36f0-ba64-bc68007f5854",
                                        "entry_id": "ab2f33f9-8cad-3243-8222-a922dd0d5502",
                                        "glosses": [
                                            "An individual film in this genre."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9100b973-3dac-4be6-a857-37142d613e62",
                                                "sense_id": "cb329841-b57c-36f0-ba64-bc68007f5854",
                                                "text": "[…] there were hastily produced B movies, such as the peplums, the spaghetti westerns, the detective stories, the horrors."
                                            },
                                            {
                                                "example_id": "e508bfff-1164-4ee3-979d-00110bf3cee1",
                                                "sense_id": "cb329841-b57c-36f0-ba64-bc68007f5854",
                                                "text": "While it does offer a lighter tone than most peplums, and spotlights a hero who relies more on his wits than his biceps […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
