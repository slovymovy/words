                    {
                        "translation_id": "4a038cb6-ebb9-4e65-9d30-8036c52585e2",
                        "source_entry_id": "7e19ed71-3699-3379-89f7-0f1eb348c009",
                        "source_sense_id": "9dbcbd37-74b7-3c93-adb0-f67c863731e0",
                        "source_sense_description": "een bedrijf dat tegen betaling van een premie een bepaald risico voor een klant dekt",
                        "target_lang_word": "insurer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
