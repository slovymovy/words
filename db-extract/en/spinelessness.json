                        "source_sense_id": "ea987bfa-01e9-3f22-a053-70ce11a574dd",
                        "source_sense_description": "state or quality of being spineless (not having a spine)",
                        "target_lang_word": "безво́лие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "безво́лие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2f5465ec-fec1-3d24-a6f5-d41c34c33bb9",
                                        "entry_id": "4a2879ba-a105-32e2-9fc7-27dd9cac099b",
                                        "glosses": [
                                            "отсутствие силы воли, неспособность управлять своим поведением для достижения какой-либо цели"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e8e6e4e-face-4379-a88e-dd2fcf39792d",
                                                "sense_id": "2f5465ec-fec1-3d24-a6f5-d41c34c33bb9",
                                                "text": "И он хотел отвести от них свои глаза и не мог, и испытывал то же состояние безволия, порабощения, как и в ту минуту, когда он глядел, не отрываясь, на блестящую лысину начальника."
                                            },
                                            {
                                                "example_id": "0ef75864-2110-47db-8f7b-4b7f55c071bc",
                                                "sense_id": "2f5465ec-fec1-3d24-a6f5-d41c34c33bb9",
                                                "text": "Время плыло, и я уплывала с ним в бесконечность, в чёрный простор бессилия и безволия."
                                            },
                                            {
                                                "example_id": "8874e7a3-d065-43df-b7c9-fe5dcb62a6c3",
                                                "sense_id": "2f5465ec-fec1-3d24-a6f5-d41c34c33bb9",
                                                "text": "Но от этой мысли прежний ужас оледенил его душу и странным безволием напоил мускулы рук."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
