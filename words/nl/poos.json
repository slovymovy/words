                    "sense_id": "be6496eb-240f-3360-9ad9-f0f682e6f7ad",
                    "sense_definition": "een onbepaalde hoeveelheid tijd",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tijdsduur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest een <w>poos</w> wachten voordat de bus eindelijk bij de halte aankwam.",
                            "target_lang_translations": {
                                "en": "He had to wait for a <w>while</w> before the bus finally arrived at the stop."
                            }
