                                    {
                                        "sense_id": "480eaed9-f3ec-3b0c-84d1-2bc1f7489d3d",
                                        "entry_id": "a5796666-2aec-3a27-8693-748096fa31fc",
                                        "glosses": [
                                            "An organizer that papers are kept in, usually with an index tab, to be stored as a single unit in a filing cabinet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216a01eb-d406-4f26-96f5-e2388e7422a6",
                                                "sense_id": "480eaed9-f3ec-3b0c-84d1-2bc1f7489d3d",
                                                "text": "I keep all my schoolwork in a yellow folder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "662e035a-5eee-3dc8-9fb3-99c6fbddc8aa",
                                        "entry_id": "a5796666-2aec-3a27-8693-748096fa31fc",
                                        "glosses": [
                                            "A virtual container in a computer's file system, in which files and other folders may be stored. The files and subfolders in a folder are usually related."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ca8f82c-8c60-437b-810e-2cc564fdc752",
                                                "sense_id": "662e035a-5eee-3dc8-9fb3-99c6fbddc8aa",
                                                "text": "My essays are in the folder named \"Schoolwork\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc8eef81-43c7-333d-964d-af5bffd5f2e3",
                                        "entry_id": "a5796666-2aec-3a27-8693-748096fa31fc",
                                        "glosses": [
                                            "A machine or person that folds things."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21f66947-7071-3d79-a471-3ce71dd5eda2",
                                        "entry_id": "a5796666-2aec-3a27-8693-748096fa31fc",
                                        "glosses": [
                                            "A folding knife, typically a pocketknife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "422279f5-d125-4ace-979e-da8e145f1b9c",
                                                "sense_id": "21f66947-7071-3d79-a471-3ce71dd5eda2",
                                                "text": "A funny name for a knife, the Needs Work folder is purpose-built as a working folder, and includes a straight, plain-edge, modified-wharncliffe blade, and a comfortable, ergonomic handle."
                                            }
                                        ]
                                    }
                                ]
