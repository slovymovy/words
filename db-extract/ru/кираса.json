                    {
                        "translation_id": "9dbbd203-5676-48ca-9602-1a6c5b39b4b6",
                        "source_entry_id": "56b5f6d8-b65a-3913-a80e-d733a8917f55",
                        "target_lang_word": "cuirasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
