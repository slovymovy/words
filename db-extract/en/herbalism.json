                        ],
                        "examples": [
                            {
                                "example_id": "bc5827e0-0dc3-4e98-a601-b5be7da55bf4",
                                "sense_id": "f7b354e7-08d1-3f8a-a6e3-ef88f7825c86",
                                "text": "Herbalism holds a great attraction for those seeking a more natural, holistic approach to their well-being. Herbalism is a science and an art, combining the objectivity of science with the subjectivity of human experience."
                            }
                        ]
                    },
                    {
                        "sense_id": "7487de77-7ccb-37f9-a9b3-82a3058965b1",
                        "entry_id": "0a3a376e-990a-3036-b8bf-5c3cd20b0813",
                        "glosses": [
                            "Botany, the study of plants in general."
