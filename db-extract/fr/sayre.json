                        "glosses": [
                            "Nom provençal de la grive draine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78c63f2a-73a8-4f25-915c-98644b0509a2",
                                "sense_id": "20456981-c860-3ac5-97c4-a40673382647",
                                "text": "[Il] leva à bout de bras un oiseau que je pris pour un petit pigeon. Il cria :\n– « La première sayre ! »\nJe m’approchai.\nC’était la grande grive des Alpes, celle que mon père avait un jour appelée « litorne ».\nSa tête était d’un gris bleuté et, de sa gorge rousse, un éventail de mouchetures noires descendait sur le ventre blanc."
                            },
                            {
                                "example_id": "251f8df2-f632-4eaa-b7ec-71c74d334a69",
                                "sense_id": "20456981-c860-3ac5-97c4-a40673382647",
                                "text": "Dans quatre jours, c’est saint Michel, et les sayres vont arriver. Ce n’est pas encore le grand passage – parce que le grand passage, c’est la semaine prochaine, au mois d’octobre."
                            }
                        ]
                    }
