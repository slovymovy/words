                                ]
                            },
                            {
                                "target_word": "spaghetti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ed9620d-4d17-3466-a021-978df262bf7a",
                                        "entry_id": "f7a2140f-38ce-35ce-9f4e-54186477253d",
                                        "glosses": [
                                            "To serve (someone) spaghetti (noun sense 1)."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c19b6ef1-a517-44d8-a7bf-2d375855a5c7",
                                                "sense_id": "4ed9620d-4d17-3466-a021-978df262bf7a",
                                                "text": "Visiting members expected to attend, and all will be properly spaghettied."
                                            },
                                            {
                                                "example_id": "48746032-ab34-4d9f-a167-7426ef58ba5b",
                                                "sense_id": "4ed9620d-4d17-3466-a021-978df262bf7a",
                                                "text": "Pi Phis spaghettied their mothers and fathers last Saturday evening in the rooms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e8e159-5fca-3b3d-9dde-8353e25d9655",
                                        "entry_id": "f7a2140f-38ce-35ce-9f4e-54186477253d",
                                        "glosses": [
                                            "To cause (someone or something) to become, or appear to become, longer and thinner; to stretch."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ec43cf7-f837-41a0-aa13-d33ea2c11a68",
                                                "sense_id": "f1e8e159-5fca-3b3d-9dde-8353e25d9655",
                                                "text": "He spaghettied the referee when he landed on him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97c61bdd-1c00-395a-9852-bbcac0c36cb2",
                                        "entry_id": "f7a2140f-38ce-35ce-9f4e-54186477253d",
                                        "glosses": [
                                            "To cause (something) to become tangled."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15a5fca9-07c4-47b7-b0dc-281de578c424",
                                                "sense_id": "97c61bdd-1c00-395a-9852-bbcac0c36cb2",
                                                "text": "All these are spaghettied together, as the following boxscore will show: […]"
                                            },
                                            {
                                                "example_id": "ded13719-4c86-480a-ae5a-b6295e1c399f",
                                                "sense_id": "97c61bdd-1c00-395a-9852-bbcac0c36cb2",
                                                "text": "\"What makes you think this watercolorist and I would develop a romantic relationship?\" Sissy's brow was spaghettied."
                                            },
                                            {
                                                "example_id": "e47eaa8a-0806-4f21-a46b-672244d098ef",
                                                "sense_id": "97c61bdd-1c00-395a-9852-bbcac0c36cb2",
                                                "text": "A twenty-foot ceiling was spaghettied by ductwork and ladders – not library rollers on rails, just foldable aluminium ladders – supplied for those willing to climb their way to erudition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69a0aea8-18cb-3860-a056-0e3e053d56bc",
                                        "entry_id": "f7a2140f-38ce-35ce-9f4e-54186477253d",
                                        "glosses": [
                                            "To eat spaghetti (noun sense 1)."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b8a415b-1d72-4f62-aabd-39dc6f2429f2",
                                                "sense_id": "69a0aea8-18cb-3860-a056-0e3e053d56bc",
                                                "text": "I have \"spaghettied\" from Ventimiglia to Brindisi and I doubt if I have ever eaten as excellent spaghetti, certainly none better nor richer, than I have enjoyed in the home of a very charming Maryland hostess."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb29571-ea92-39c1-9590-fdbb7d73e4cd",
                                        "entry_id": "f7a2140f-38ce-35ce-9f4e-54186477253d",
                                        "glosses": [
                                            "To become, or appear to become, longer and thinner."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba645698-d3a8-42c4-a143-bfccfadbda9f",
                                                "sense_id": "0cb29571-ea92-39c1-9590-fdbb7d73e4cd",
                                                "text": "The oldest Lark spaghettied down to a noodle and slithered through the letterbox-like hole at the bottom of the cistern."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42a5b218-7272-3f68-8b2b-f9717f686a25",
                                        "entry_id": "f7a2140f-38ce-35ce-9f4e-54186477253d",
                                        "glosses": [
                                            "To become tangled."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7953f758-0aa6-418a-8347-aa031c6267a1",
                                                "sense_id": "42a5b218-7272-3f68-8b2b-f9717f686a25",
                                                "text": "The cables spaghettied onto the shoulder of the technician."
                                            },
                                            {
                                                "example_id": "dc363d31-fe3e-45e8-9a8e-96e773601f96",
                                                "sense_id": "42a5b218-7272-3f68-8b2b-f9717f686a25",
                                                "text": "These elegant instrument pods will bring all the instruments within eye range of the most nearsighted skipper, keep his bulkhead intact and eliminate all those messy wires spaghettiing around."
                                            },
                                            {
                                                "example_id": "e6e132bf-8cc0-4761-b5a6-c2b08d06fe51",
                                                "sense_id": "42a5b218-7272-3f68-8b2b-f9717f686a25",
                                                "text": "[H]is instrument looked like a Rube Goldberg contraption. It was rigged from electronic bits and pieces, put together with wires that habitually spaghettied out of its grey metal box."
                                            },
                                            {
                                                "example_id": "d63dcf1d-02ec-4dcf-8b7b-4b59b8c9c77f",
                                                "sense_id": "42a5b218-7272-3f68-8b2b-f9717f686a25",
                                                "text": "Canada's cities are different from America's— […] There are no freeways spaghettiing their way through the town."
                                            },
                                            {
                                                "example_id": "0d037e1b-1a89-43a6-aee4-60fbfdfe137b",
                                                "sense_id": "42a5b218-7272-3f68-8b2b-f9717f686a25",
                                                "text": "These four problems, spaghettiing through our minds and bookshelves, make for crippling limitations of literary sensibility."
                                            },
                                            {
                                                "example_id": "d7746eee-aa82-415c-bbef-286f3c52b391",
                                                "sense_id": "42a5b218-7272-3f68-8b2b-f9717f686a25",
                                                "text": "Call it what you will, but as soon as you think you've got your dish ready to serve, it spaghettis all over the place and you have to clean up the mess."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "441c3b18-3083-4ad4-8347-153bcff50e02",
                        "source_entry_id": "975260ea-7193-31ef-a544-03c7ad81436e",
                        "source_sense_id": "6a90e782-a6a9-3db9-999e-5a4ce2ddf5cb",
                        "target_lang_word": "špagety",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d75ed772-f3f3-42de-9bf6-f6ab7e965726",
                        "source_entry_id": "975260ea-7193-31ef-a544-03c7ad81436e",
                        "source_sense_id": "6a90e782-a6a9-3db9-999e-5a4ce2ddf5cb",
                        "target_lang_word": "Spaghetti",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spaghetti",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcadffc6-2c1a-3a10-8fdc-961f68643852",
                                        "entry_id": "55c69700-5abf-3974-92a7-98704370aac0",
                                        "glosses": [
                                            "lange, dünne Nudeln, die meist aus Hartweizengrieß bestehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "588e4ee0-40d0-4e18-9295-e6b6e19087b5",
                                                "sense_id": "fcadffc6-2c1a-3a10-8fdc-961f68643852",
                                                "text": "Koch doch wieder mal Spaghetti."
                                            },
                                            {
                                                "example_id": "4b78d3db-45fe-4b80-98cd-0fbf57a07bb9",
                                                "sense_id": "fcadffc6-2c1a-3a10-8fdc-961f68643852",
                                                "text": "„Es gibt Spaghetti mit Tomatensoße, manchmal auch Fischstäbchen mit Kartoffelpüree und Spinat.“"
                                            },
                                            {
                                                "example_id": "a7d0c892-5d9c-42a0-be59-a99119330c69",
                                                "sense_id": "fcadffc6-2c1a-3a10-8fdc-961f68643852",
                                                "text": "„In jedem Fall eine Spaghetti herausangeln und probieren. Sie sollte noch ein bisschen fest sein.“"
                                            },
                                            {
                                                "example_id": "f7d471e5-2604-45f9-b22f-007219e2b85b",
                                                "sense_id": "fcadffc6-2c1a-3a10-8fdc-961f68643852",
                                                "text": "„Wird eine Spaghetti über ihre Elastizitätsgrenze hinweg gebogen, so zerbricht sie typischerweise nicht einfach in zwei Hälften, sondern in drei bis zehn Stücke.“"
                                            },
                                            {
                                                "example_id": "61b759a3-ec40-445c-b7e0-6f434526da2d",
                                                "sense_id": "fcadffc6-2c1a-3a10-8fdc-961f68643852",
                                                "text": "„Dünn wie eine Spaghetti ist die kleinste bisher beschriebene Schlange der Welt.“"
                                            },
                                            {
