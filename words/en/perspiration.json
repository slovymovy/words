{
    "word_family": [
        "perspire",
        "perspirable",
        "perspiratory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a65c18b-07da-3cdc-a545-2b48f0c55084",
                    "sense_definition": "Sweat; the salty fluid excreted by the sweat glands of the skin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sweat_fluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passing his hand across his forehead he withdrew it, wet with drops of <w>perspiration</w>.",
                            "target_lang_translations": {
                                "ru": "Проведя рукой по лбу, он убрал ее, влажную от капель <w>пота</w>."
                            }
                        },
                        {
                            "text": "After running the marathon, his shirt was completely soaked in <w>perspiration</w>.",
                            "target_lang_translations": {
                                "ru": "После марафона его футболка насквозь пропиталась <w>потом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweating#Noun",
                        "diaphoresis",
                        "hidrosis",
                        "sudation",
                        "sudoresis"
                    ],
                    "common_phrases": [
                        "beads of perspiration",
                        "covered in perspiration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пот; соленая жидкость, выделяемая потовыми железами кожи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пот",
                                "target_lang_sense_clarification": "выделяемая организмом жидкость"
                            },
                            {
                                "target_lang_word": "испарина",
                                "target_lang_sense_clarification": "легкий пот на коже, часто от волнения или слабости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcf0a106-9367-3499-9606-8046b8264015",
                    "sense_definition": "The physiological action or process of perspiring.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sweat_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The body regulates its temperature through the process of <w>perspiration</w>.",
                            "target_lang_translations": {
                                "ru": "Организм регулирует свою температуру посредством процесса <w>потоотделения</w>."
                            }
                        },
                        {
                            "text": "Certain medical conditions can cause excessive <w>perspiration</w> even in cold weather.",
                            "target_lang_translations": {
                                "ru": "Некоторые заболевания могут вызывать избыточное <w>потоотделение</w> даже в холодную погоду."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweating#Noun"
                    ],
                    "common_phrases": [
                        "insensible perspiration",
                        "excessive perspiration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физиологический процесс выделения пота организмом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потоотделение",
                                "target_lang_sense_clarification": "физиологический процесс"
                            },
                            {
                                "target_lang_word": "поте́ние",
                                "target_lang_sense_clarification": "процесс выделения пота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f67b4131-f63f-3593-ab5e-9346a473e7fe",
                    "sense_definition": "Hard work; intense effort or labor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thomas Edison famously said that genius is one percent inspiration and ninety-nine percent <w>perspiration</w>.",
                            "target_lang_translations": {
                                "ru": "Томас Эдисон произнес знаменитую фразу о том, что гений — это один процент вдохновения и девяносто девять процентов <w>пота</w>."
                            }
                        },
                        {
                            "text": "Achieving success in this industry requires years of dedication and pure <w>perspiration</w>.",
                            "target_lang_translations": {
                                "ru": "Достижение успеха в этой индустрии требует лет преданности делу и чистого <w>упорного труда</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hard work"
                    ],
                    "common_phrases": [
                        "inspiration and perspiration"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used metaphorically in contrast with inspiration"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелая работа; интенсивные усилия или труд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пот",
                                "target_lang_sense_clarification": "в переносном смысле: тяжелый труд, усилия"
                            },
                            {
                                "target_lang_word": "упорный труд",
                                "target_lang_sense_clarification": "тяжелая работа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}