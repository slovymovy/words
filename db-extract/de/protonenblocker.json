                "senses": [
                    {
                        "sense_id": "f55b0c5b-dcb2-3b79-ae79-06a578e9508f",
                        "entry_id": "bb287556-0ede-3906-a4de-120ccdd463b1",
                        "glosses": [
                            "Medikament zur Reduzierung der Magensäurebildung"
                        ],
                        "tags": [
                            "medizinisch"
                        ],
                        "examples": [
                            {
                                "example_id": "bfb4c465-dac1-4521-ba3f-4ff2f2213e84",
                                "sense_id": "f55b0c5b-dcb2-3b79-ae79-06a578e9508f",
                                "text": "„Der Protonenblocker Cimetidin kann schwere Myalgien zur Folge haben, die die Anwendung des Medikaments limitieren, und in Einzelfällen auch zu einem Polymyositis—Vaskulitis—Syndrom mit CK—Erhöhung führen.“"
                            },
                            {
                                "example_id": "6f78b56b-eedd-4ce5-937d-44c1d4106f05",
                                "sense_id": "f55b0c5b-dcb2-3b79-ae79-06a578e9508f",
                                "text": "„Protonenblocker müssen vorher abgesetzt werden, da sie das Serumgastrin erhöhen.“"
                            },
                            {
                                "example_id": "6271a2a7-8152-4af8-8b0c-e58dda76ed02",
                                "sense_id": "f55b0c5b-dcb2-3b79-ae79-06a578e9508f",
                                "text": "„Der Einsatz von Protonenblockern scheint nur dann gerechtfertigt, wenn gleichzeitig ein gastroösophagealer Reflux vorliegt, welcher das spontane Abheilen der medikamentös induzierten Läsionen beeinträchtigen könnte.“"
                            },
                            {
                                "example_id": "48ec1adf-17fa-4c81-a138-bf400d20fd55",
                                "sense_id": "f55b0c5b-dcb2-3b79-ae79-06a578e9508f",
                                "text": "„Zum Schutz der Darmschleimhaut hat sich neben allgemeinen diätetischen Maßnahmen ([…]) die Gabe von Protonenblockern bewährt.“"
                            },
                            {
                                "example_id": "be669c3f-c85a-47b1-9c24-b1a6c3db609b",
                                "sense_id": "f55b0c5b-dcb2-3b79-ae79-06a578e9508f",
                                "text": "„Am schnellsten bessert sich eine posteriore Laryngitis unter Protonenblockern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
