                                "target_senses": [
                                    {
                                        "sense_id": "a5966bcd-cfe7-3a61-87b5-07729cb52567",
                                        "entry_id": "132d4b06-f247-3dce-a72b-e045329da1f0",
                                        "glosses": [
                                            "een (deel van) een lever uit het ene individu nemen en weer implanteren in het andere individu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "340b9222-b5a4-4deb-85cf-3c59d1cab823",
                                                "sense_id": "a5966bcd-cfe7-3a61-87b5-07729cb52567",
                                                "text": "Jobs kampte al jaren met gezondheidsproblemen. In 2004 overwon hij kanker en in 2009 onderging hij een levertransplantatie. Sinds januari dit jaar was hij met ziekteverlof."
                                            },
                                            {
                                                "example_id": "e78506f4-f810-43e1-865a-314c7cc4c0ed",
                                                "sense_id": "a5966bcd-cfe7-3a61-87b5-07729cb52567",
                                                "text": "Het gaat om een 27-jarige Chinees. Hij is na acht maanden vreemdelingendetentie in Rotterdam op straat gezet en kort daarna met ernstige gezondheidsklachten opgenomen in een ziekenhuis in Tilburg. Hij bleek de besmettelijke ziekte hepatitis B te hebben en moest onmiddellijk een levertransplantatie ondergaan."
                                            }
                                        ]
