                "senses": [
                    {
                        "sense_id": "69c9a2ba-7286-3ffe-857d-d4b298b6ef6c",
                        "entry_id": "39859b1a-e33d-3fba-8661-189e54a9c730",
                        "glosses": [
                            "to buzz or hum; to speak idly, vacuously, or to little effect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8425a2b0-57c9-49ac-bf18-722a25ed5ad1",
                                "sense_id": "69c9a2ba-7286-3ffe-857d-d4b298b6ef6c",
                                "text": "None of this multitude of thinkers and their satellites brought his thoughts into really conclusive contact with the others. To do it would have been to discover much practical identity and so lose distinction. After their fashion, each bombinated abundantly with only the slightest regard to other bombinators."
                            },
                            {
                                "example_id": "bfeaf9a0-0266-47d0-aa4e-7cb9ab4c13a2",
                                "sense_id": "69c9a2ba-7286-3ffe-857d-d4b298b6ef6c",
                                "text": "So full a ship, so close-packed a world, moving urgently along, surrounded by its own vacuum; each man bombinating in his own, no doubt."
                            }
                        ]
                    }
                ],
