                                "example_id": "adb9507d-8b23-4c4b-9be8-1d321a2079aa",
                                "sense_id": "95acadb0-c384-3111-a828-fb9adcfde142",
                                "text": "It's one of the main selling points of the prison business: that they keep the sexually non-conformist or \"deviant\" out of sight of the respectable citizenry, especially to \"protect\" the children."
                            }
