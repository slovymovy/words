                                "target_senses": [
                                    {
                                        "sense_id": "5f45ef0f-e2c7-33cf-b238-ae48b6b3fae6",
                                        "entry_id": "a6cd7065-9386-3ff4-821c-5716ab1abf79",
                                        "glosses": [
                                            "Abbreviation of dichlorodiphenyltrichloroethane, compound originally developed as an insecticide."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e4949a2-9fd7-4457-a53d-43067ca7b3d3",
                                                "sense_id": "5f45ef0f-e2c7-33cf-b238-ae48b6b3fae6",
                                                "text": "After working briefly for a federal entomologist to control the spruce budworm — and spraying DDT from the air — he returned to the Adirondacks in 1946 to be district ranger at Cranberry Lake for 11 years."
                                            },
                                            {
                                                "example_id": "762767c3-86c4-4b2d-8462-5aa33bc84e75",
                                                "sense_id": "5f45ef0f-e2c7-33cf-b238-ae48b6b3fae6",
                                                "text": "The use of DDT for disinfectation of louse-infested communities is a primary control measure in epidemic situations."
                                            }
                                        ]
                                    }
                                ]
                            },
