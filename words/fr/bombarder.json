                    ]
                },
                {
                    "sense_id": "8ca55aa7-9d7f-3c91-b6f3-9733dad1dbbb",
                    "sense_definition": "Nommer ou installer brusquement quelqu'un à une fonction sans concertation préalable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nomination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la surprise générale, le conseil d'administration l'a <w>bombardé</w> directeur sans aucune expérience."
