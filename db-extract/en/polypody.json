                                "sense_id": "a43183de-45c7-320b-bb80-291c844d0e71",
                                "text": "Polypodie and epithyme are, without all exceptions, gentle purgers of melancholy […]."
                            },
                            {
                                "example_id": "ac09f916-c654-443d-8271-9cb61f5b14f1",
                                "sense_id": "a43183de-45c7-320b-bb80-291c844d0e71",
                                "text": "If the humour be otherwise choose your Polypody accordingly."
                            }
                        ]
