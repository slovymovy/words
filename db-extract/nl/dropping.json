                "senses": [
                    {
                        "sense_id": "60e94dae-6d79-31f1-b9cf-71daafb4e992",
                        "entry_id": "c57a9423-cd3c-35de-9fa8-823789ab1798",
                        "glosses": [
                            "uit een vliegtuig werpen van bepaalde goederen, bijvoorbeeld medicijnen of voedsel, in gebieden die (door welke reden dan ook) over land moeilijk bereikbaar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfa78e00-20e8-4723-92e7-95e1d5942da5",
                                "sense_id": "60e94dae-6d79-31f1-b9cf-71daafb4e992",
                                "text": "Vrachtvliegtuigen van de Amerikaanse luchtmacht hebben munitie voor lichte wapens gedropt bij rebellengroepen in het noorden van Syrië. Dat heeft een woordvoerder maandag bevestigd. De munitiedroppings vonden zondag plaats. De woordvoerder zei niet voor welke groepen de munitie bestemd was, maar verklaarde dat ze vechten tegen de groep Islamitische Staat."
                            }
                        ]
                    },
                    {
                        "sense_id": "46c189ea-a717-3edc-a06f-bce7fa2889f5",
                        "entry_id": "c57a9423-cd3c-35de-9fa8-823789ab1798",
                        "glosses": [
                            "een spel of een (militaire) oefening waarbij personen geblinddoekt naar een plek worden gebracht, vanwaar zij zelfstandig de weg naar huis moeten vinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07f7c1f7-79a0-492a-94a4-2c5a362c6014",
                                "sense_id": "46c189ea-a717-3edc-a06f-bce7fa2889f5",
                                "text": "De fotograaf wil nachtelijke foto’s op het strand. Jim en Wende worden in een plas zeewater gezet, gezicht in het felle licht van een schijnwerper. Wende vertelt over haar nieuwe programma dat over angst gaat – vandaar haar interesse. „Ik heb angsten, maar niet in de zin van de-hele-dag-bang, hoor, niet als een patiënt.” Jim raadt haar een boek van Kierkegaard aan. Wende, terug op de parkeerplek: „Zo. Gaan we nu een dropping doen?”"
                            }
                        ]
                    }
