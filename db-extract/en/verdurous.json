                                "sense_id": "4c6b8177-1776-32d6-86db-bff27771202a",
                                "text": "The hill was blanketed in verdurous grasses."
                            },
                            {
                                "example_id": "a4cbad19-8f04-48d1-aaff-5601dc8b7e31",
                                "sense_id": "4c6b8177-1776-32d6-86db-bff27771202a",
                                "text": "The verdurous pasture..."
                            },
