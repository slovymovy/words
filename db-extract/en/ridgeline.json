                        "glosses": [
                            "The topmost edge along a mountain ridge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e800a3-055e-49ef-93df-1065f83b66e0",
                                "sense_id": "a0eee5f1-fe89-30ff-a1ff-8212e5227ffd",
                                "text": "To either side there are beautiful views from the trail along the ridgeline."
                            },
                            {
                                "example_id": "8c210b54-f50c-49da-8ea2-b0587d2ad004",
                                "sense_id": "a0eee5f1-fe89-30ff-a1ff-8212e5227ffd",
                                "text": "a. 2007, Federal Aviation Administration, Rotorcraft Flying Handbook, →ISBN, Skyhorse Publishing, 2007, p. 10-8 http://books.google.com/books?id=Bk9fOM4zsKwC&pg=PT97&dq=ridgeline&sig=9rt5EdI_M39hmj7A4pxbJZ8PX-k\nA ridgeline is a long area from which the surface drops away steeply on one or two sides, such as a bluff or precipice."
                            },
                            {
                                "example_id": "9d23bf3e-4f37-439f-af9d-78400536b24a",
                                "sense_id": "a0eee5f1-fe89-30ff-a1ff-8212e5227ffd",
                                "text": "As the trail flattens out, it follows the draw up right to a saddle in the ridgeline."
                            },
                            {
                                "example_id": "e33bb2d5-17d7-401b-9c48-c36a72b7f08f",
                                "sense_id": "a0eee5f1-fe89-30ff-a1ff-8212e5227ffd",
                                "text": "Surface runoff from ridgeline development can contaminate rivers and streams that supply drinking water downstream."
                            },
                            {
                                "example_id": "b0f73cbe-8e7d-4865-93c1-a9d2c9b11fec",
                                "sense_id": "a0eee5f1-fe89-30ff-a1ff-8212e5227ffd",
                                "text": "These ridgelines and hilltops are exceptional aesthetic and ecological resources, visible from many perspectives and distances."
                            },
                            {
                                "example_id": "332a44d0-4aa5-45ab-b63d-6dc98f016f03",
                                "sense_id": "a0eee5f1-fe89-30ff-a1ff-8212e5227ffd",
                                "text": "Standing atop the ridgeline, King Edward watched the nightmare scenario he himself had predicted."
                            }
                        ]
                    },
