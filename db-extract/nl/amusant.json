                ],
                "senses": [
                    {
                        "sense_id": "f7743e48-8acc-3fa7-b398-55ef0a4b805b",
                        "entry_id": "0ed1ea8a-27fd-38da-8820-e8bced181b75",
                        "glosses": [
                            "vermakelijk, grappig, vrolijk, licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8615437a-e85a-429c-a201-8f50bf8ccf09",
                                "sense_id": "f7743e48-8acc-3fa7-b398-55ef0a4b805b",
                                "text": "Hij vertelde enkele amusante verhalen."
                            },
                            {
                                "example_id": "fdb2277c-f8e2-483c-893f-d4b35ca56e4c",
                                "sense_id": "f7743e48-8acc-3fa7-b398-55ef0a4b805b",
                                "text": "Om zijn lippen speelde de amusante glimlach van iemand die het leven niet zo serieus neemt."
                            },
                            {
                                "example_id": "a839e394-1559-4f54-86c3-db8b13f0ec12",
                                "sense_id": "f7743e48-8acc-3fa7-b398-55ef0a4b805b",
                                "text": "'U lijkt het nogal amusant te vinden, meneer.' De kilte in mijn stem kon hem niet zijn ontgaan. 'Maar wat u hebt gehoord, is helaas niet waar.'"
                            }
                        ]
                    }
                ],
