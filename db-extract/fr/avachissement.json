                "senses": [
                    {
                        "sense_id": "967aa3c0-d264-34a8-a090-37e7ac116fb6",
                        "entry_id": "f666d8d4-9186-36f6-9ba3-3c5949df4125",
                        "glosses": [
                            "Fait de s’avachir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a99241c9-0ac5-4022-b7ac-90b986985071",
                                "sense_id": "967aa3c0-d264-34a8-a090-37e7ac116fb6",
                                "text": "Un peu d’embonpoint, un certain avachissement de la chair et de l’esprit, je ne sais quelle descente de la cervelle dans les fesses, ne messiéent pas à un haut fonctionnaire. Car tu as mûri dans les bureaux. L’âge et la faveur t’ont promu à un poste élevé."
                            },
                            {
                                "example_id": "9b46d87d-bb5c-40fd-bf27-717099254b61",
                                "sense_id": "967aa3c0-d264-34a8-a090-37e7ac116fb6",
                                "text": "Et la vie de famille, composée essentiellement de repas et d’avachissement, était en contradiction avec l’obsession nouvelle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
