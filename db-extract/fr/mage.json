                                    },
                                    {
                                        "sense_id": "8e2d7926-29bb-3e10-8c4f-e7dad8306a98",
                                        "entry_id": "0c716d27-180d-3d58-8eef-90d3c4643833",
                                        "glosses": [
                                            "Synonym of magus: a Zoroastrian priest."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "514be445-fe8d-4aed-987b-731104db47d6",
                                                "sense_id": "8e2d7926-29bb-3e10-8c4f-e7dad8306a98",
                                                "text": "While the liberality of Gelo and his brother Hiero atracted every stranger who could amuse or instruct the court of Syracuse, a Persian Mage related to the former of those princes that he himself had circumnavigated the whole continent of Africa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
