                                "target_senses": [
                                    {
                                        "sense_id": "f052e692-4fe3-37e2-a153-8b6bc924d4a5",
                                        "entry_id": "12aa18e6-5cb8-3887-af04-bf3338ab500a",
                                        "glosses": [
                                            "Centre commercial ; lieu ou place de marché."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a74129b0-e838-4a56-92cc-b0e5329f26e8",
                                                "sense_id": "f052e692-4fe3-37e2-a153-8b6bc924d4a5",
                                                "text": "Le site de la rue du Souvenir atteste l’existence d’un emporium. Situé à la frontière du monde romain (la cité romaine de Vienne est à moins de 30 km au sud), l’emporium faisait le pont entre les cultures romaines et gauloises et servait également de port de transbordement (le goulet d’étranglement de la Saône à Pierre-Scize interdisait la navigation)."
                                            },
                                            {
                                                "example_id": "8d370b47-b2c3-4498-8b8a-467f0ee56d70",
                                                "sense_id": "f052e692-4fe3-37e2-a153-8b6bc924d4a5",
                                                "text": "Thônis était, avant la fondation d’Alexandrie, le grand et prospère emporium de l’Égypte sur la Méditerranée et contrôlait tout le commerce du royaume avec le monde grec."
                                            },
                                            {
                                                "example_id": "7e53d70d-176a-41fb-be95-b12864a37a1b",
                                                "sense_id": "f052e692-4fe3-37e2-a153-8b6bc924d4a5",
                                                "text": "— Me trouvant à Hambourg, l’an passé, j’eus […] la curiosité de voir le Marché des Juifs. La surprenante abjection de cet emporium de détritus emphytéotiques est difficilement exprimable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "079dff34-de1d-35a1-b667-2c4e5ace4156",
                                        "entry_id": "12aa18e6-5cb8-3887-af04-bf3338ab500a",
                                        "glosses": [
                                            "Centre commercial"
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eaf3552-35fb-4ab5-b48d-0a788108e3fd",
                                                "sense_id": "079dff34-de1d-35a1-b667-2c4e5ace4156",
                                                "text": "Hannah m’entraînait dans les grands magasins, à cet Eaton, qui faisait maintenant la gloire de Winnipeg avec son emporium géant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
