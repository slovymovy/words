                    "synonyms": [
                        "leech"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This spelling is largely considered archaic or non-standard compared to leech."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревший вариант написания слова leech (пиявка)."
