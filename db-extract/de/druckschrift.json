                ],
                "senses": [
                    {
                        "sense_id": "09feb475-35ff-3b57-9f9b-e69230c7f500",
                        "entry_id": "431a02f4-e3a3-38df-b57f-cdfc4bd57984",
                        "glosses": [
                            "eine (genormte) Schriftform, bei der die Buchstaben (Letter) einzeln wiedergeben werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d88298f-525e-42a3-ab3c-57521b554946",
                                "sense_id": "09feb475-35ff-3b57-9f9b-e69230c7f500",
                                "text": "Bitte füllen Sie das Formular in Druckschrift aus, damit die automatische Texterkennung Ihre Angaben entziffern kann."
                            },
                            {
                                "example_id": "2b9868f0-0342-4033-9b2e-1c0aa88013b3",
                                "sense_id": "09feb475-35ff-3b57-9f9b-e69230c7f500",
                                "text": "„Englische und spanische Abc-Schützen etwa lernen eine Art Druckschrift, in der Schweiz verdrängen Druckbuchstaben gegenwärtig die traditionelle »Schnürlischrift«.“"
                            },
                            {
                                "example_id": "9a21c954-4522-4f5f-966a-fded82224ecf",
                                "sense_id": "09feb475-35ff-3b57-9f9b-e69230c7f500",
                                "text": "„Mit der Verbreitung der Renaissance gelangten am Ende des 15. Jahrhunderts erste Druckschriften der Antiqua auch in deutsche Druckereien.“"
                            },
                            {
                                "example_id": "589be31d-0a4e-4ff1-b435-3754fcacd2af",
                                "sense_id": "09feb475-35ff-3b57-9f9b-e69230c7f500",
                                "text": "„Besonders in Wittenberg nahm sie vor allen anderen Druckschriften eine führende Rolle ein…“"
                            },
                            {
                                "example_id": "d27b0a45-ad26-4b73-b7a8-de281ee1a3c1",
                                "sense_id": "09feb475-35ff-3b57-9f9b-e69230c7f500",
                                "text": "„Er schrieb es in Druckschrift, wobei er die einzelnen Buchstaben doppelt und dreifach nachzog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a5e41dff-6303-3392-85f3-f161a086dda3",
                        "entry_id": "431a02f4-e3a3-38df-b57f-cdfc4bd57984",
                        "glosses": [
                            "Blatt/Heft mit Text"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55a0e71b-522e-4d72-bb9e-dc32818913b8",
                                "sense_id": "a5e41dff-6303-3392-85f3-f161a086dda3",
                                "text": "„Er zeigt ihr die Druckschrift des Reisebüros auf Hochglanzpapier mit einem pompösen Autobus auf der Titelseite.“"
                            },
                            {
                                "example_id": "19c4f25c-bc04-429e-9cde-1bf75fbf0fe0",
                                "sense_id": "a5e41dff-6303-3392-85f3-f161a086dda3",
                                "text": "„Dann blätterten sie die Druckschriften des Grafen durch.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
