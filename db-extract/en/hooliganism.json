                                "target_senses": [
                                    {
                                        "sense_id": "eaa0f3c3-bed7-3fe5-b040-8cdbe96a26d6",
                                        "entry_id": "3989cadb-9f7c-3fe0-845d-c9ed3c6d97ff",
                                        "glosses": [
                                            "gewalttätiges, flegelhaftes öffentliches Benehmen von (meist jungen) Personen"
