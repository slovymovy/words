                "senses": [
                    {
                        "sense_id": "13637e31-0527-3f4b-be9b-64e187b32d9b",
                        "entry_id": "238e82e7-58e7-321c-8d61-196fdd885423",
                        "glosses": [
                            "Person, die die Verwendung einer sogenannten gendergerechten Sprache ablehnt"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "537bd312-81fb-4ec9-a0b6-28647b411a09",
                                "sense_id": "13637e31-0527-3f4b-be9b-64e187b32d9b",
                                "text": "„Gender-Gegner argumentieren: Es reicht von Schülern zu sprechen, es sei eine rein grammatische Definition, dass die maskuline Mehrzahl auch die Frauen mitmeint.“"
                            },
                            {
                                "example_id": "89f01fd9-0faf-4cab-9a9a-6ab7220619d2",
                                "sense_id": "13637e31-0527-3f4b-be9b-64e187b32d9b",
                                "text": "„Kein Erfolg für den Gender-Gegner Alexander B.. Das Landgericht in Ingolstadt hat die Klage des VW-Mitarbeiters gegen eine Ansprache in geschlechtergerechter Sprache abgewiesen.“"
                            },
                            {
                                "example_id": "58dc914d-9e65-4295-acf7-7ca721fa7eb5",
                                "sense_id": "13637e31-0527-3f4b-be9b-64e187b32d9b",
                                "text": "„Es braucht nicht mehr sehr viel an Provokation – und die Gender-Gegnerinnnen und Gender–Gegner werden sich zu „Abendspaziergängen“ zusammenfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "80d4fa74-7c0d-3760-801b-7ef3e9fc9de7",
                        "entry_id": "238e82e7-58e7-321c-8d61-196fdd885423",
                        "glosses": [
                            "Person, die gegenüber der Genderbewegung eine ablehnende Haltung hat"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "4a94857d-29e0-457f-9f12-843339cd496e",
                                "sense_id": "80d4fa74-7c0d-3760-801b-7ef3e9fc9de7",
                                "text": "„Was die Gender-Gegner antreibt, wird auch hier wieder deutlich: Es geht um Abwehr von Konkurrenz.“"
                            },
                            {
                                "example_id": "e91674b5-2b86-449b-a0ed-87b7e041f814",
                                "sense_id": "80d4fa74-7c0d-3760-801b-7ef3e9fc9de7",
                                "text": "„Der neue Erzbischof von Krakau ist einer der entschiedensten Gender-Gegner.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
