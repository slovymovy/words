                    },
                    {
                        "translation_id": "7f4700cd-e610-4356-a303-8b53862653e1",
                        "source_entry_id": "546bf612-a9f1-3f29-8213-15f6266ce64d",
                        "source_sense_description": "в прямом смысле, дословно",
                        "target_lang_word": "littéralement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "littéralement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ece1b568-e86a-3898-8d22-97451ccf7bb3",
                                        "entry_id": "08578b42-c1a2-3d11-bdec-ced2e6762b38",
                                        "glosses": [
                                            "D’une façon littérale ; à la lettre ; hors de toute interprétation imagée, figurée ou symbolique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5962d7c6-76b0-46a3-8a1d-c3f5d977ee5a",
                                                "sense_id": "ece1b568-e86a-3898-8d22-97451ccf7bb3",
                                                "text": "Lire littéralement les textes sacrés rime à refuser de prendre de la maturité intellectuelle, c'est se refuser à l'âge adulte de la raison."
                                            },
                                            {
                                                "example_id": "fbf9f4f5-6c66-4b1d-b2d8-960a7c9f7bb6",
                                                "sense_id": "ece1b568-e86a-3898-8d22-97451ccf7bb3",
                                                "text": "La troupe se mit en marche à l’indienne, c’est-à-dire en tournant littéralement le dos à l’endroit vers lequel elle se dirigeait."
                                            },
                                            {
                                                "example_id": "48c83b69-8619-4619-92b7-3e82ac76a33a",
                                                "sense_id": "ece1b568-e86a-3898-8d22-97451ccf7bb3",
                                                "text": "Dans la salle, trop étroite pour contenir un aussi grand nombre de gens, on s'écrasait littéralement."
                                            },
                                            {
                                                "example_id": "26793fae-9171-4554-a615-0586ddcc852f",
                                                "sense_id": "ece1b568-e86a-3898-8d22-97451ccf7bb3",
                                                "text": "Mais il ne faut pas rire de la choléraphobie. Mme de Boigne affirme que quelques personnes, entre autres la comtesse de Montesquiou-Fesenac, sont littéralement mortes de peur, sans aucune maladie."
                                            },
                                            {
                                                "example_id": "ae743396-5549-4344-a72a-d029ae88818b",
                                                "sense_id": "ece1b568-e86a-3898-8d22-97451ccf7bb3",
                                                "text": "Dans un système lexical où les fibres sont les os, l’amidon est littéralement la substantifique moelle du manioc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d461dd17-5674-3ce5-9430-6f9a0c582837",
                                        "entry_id": "08578b42-c1a2-3d11-bdec-ced2e6762b38",
                                        "glosses": [
                                            "Totalement, absolument ; vraiment."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb58aaa-0356-483a-83d2-938bb62b1025",
                                                "sense_id": "d461dd17-5674-3ce5-9430-6f9a0c582837",
                                                "text": "Dans celui-là, les deux puissantes agglomérations industrielles de Rouen et du Havre agirent littéralement comme des arrêtoirs, en exerçant localement assez d'attraction pour empêcher un prolétariat, voué, de toute manière, à l'exode, de s'éloigner trop de sa terre natale."
                                            },
                                            {
                                                "example_id": "e64b4e51-0c86-4c18-ade0-af0a91ddf752",
                                                "sense_id": "d461dd17-5674-3ce5-9430-6f9a0c582837",
                                                "text": "Mais son style de vie littéralement extraordinaire sera aussi à l’origine de la disgrâce de Jayalalitha."
                                            },
                                            {
                                                "example_id": "3fb51d69-2d28-4f01-8fbe-26aff07ae412",
                                                "sense_id": "d461dd17-5674-3ce5-9430-6f9a0c582837",
                                                "text": "Finalement, hormis mon éternel couple d’indécis, venu visiter un appartement, tout en sachant qu'il ne l’achèterait pas, je suis assez satisfait de ma rencontre avec cette Latine, qui me fait littéralement fondre."
                                            },
                                            {
                                                "example_id": "b2635202-72d3-4aa8-a3e6-23c0824e88f9",
                                                "sense_id": "d461dd17-5674-3ce5-9430-6f9a0c582837",
                                                "text": "Koroibete a littéralement dansé dans la défense géorgienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
