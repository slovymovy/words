    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0ce34890-fb34-3fee-9321-000dee7c48b0",
                    "sense_definition": "Being the only one; single.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adj_singleness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was the <w>sole</w> survivor of the terrible crash.",
                            "target_lang_translations": {
                                "ru": "Он был <w>единственным</w> выжившим в той ужасной аварии.",
                                "zh": "他是那场可怕事故中<w>唯一</w>的幸存者。",
                                "pl": "Był <w>jedynym</w> ocalałym z tej strasznej katastrofy."
                            }
                        },
                        {
                            "text": "My <w>sole</w> reason for coming here is to ask for your help.",
                            "target_lang_translations": {
                                "ru": "Моя <w>единственная</w> причина прийти сюда — попросить вашей помощи.",
                                "zh": "我来这里的<w>唯一</w>原因就是请求你的帮助。",
                                "pl": "Moim <w>jedynym</w> powodem przybycia tutaj jest prośba o pomoc."
                            }
                        }
                    ],
                    "synonyms": [
                        "only",
                        "single",
                        "solitary",
                        "lone",
                        "one"
                    ],
                    "antonyms": [
                        "many"
                    ],
                    "common_phrases": [
                        "sole survivor",
                        "sole purpose",
                        "sole heir"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся только одним; единственный.",
                        "zh": "指唯一的、单独的。",
                        "pl": "Będący jedynym w swoim rodzaju; pojedynczy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единственный",
                                "target_lang_sense_clarification": "only one"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唯一",
                                "target_lang_sense_clarification": "only one"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "jedyny",
                                "target_lang_sense_clarification": "wskazuje na brak innych osób lub rzeczy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "585fb275-364c-3078-a1e9-371b58629c04",
                    "sense_definition": "Belonging or restricted to one person or group; not shared.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_singleness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother was granted <w>sole</w> custody of the children after the divorce.",
                            "target_lang_translations": {
                                "ru": "Матери была предоставлена <w>единоличная</w> опека над детьми после развода.",
                                "zh": "离婚后，母亲获得了孩子的<w>独有</w>监护权。",
                                "pl": "Po rozwodzie matce przyznano <w>wyłączną</w> opiekę nad dziećmi."
                            }
                        },
                        {
                            "text": "He has <w>sole</w> responsibility for the management of the project.",
                            "target_lang_translations": {
                                "ru": "Он несет <w>единоличную</w> ответственность за управление проектом.",
                                "zh": "他承担该项目管理的<w>单独</w>责任。",
                                "pl": "Ponosi on <w>wyłączną</w> odpowiedzialność za zarządzanie projektem."
                            }
                        }
                    ],
                    "synonyms": [
                        "individual"
                    ],
                    "antonyms": [
                        "collective"
                    ],
                    "common_phrases": [
                        "sole custody",
                        "sole responsibility",
                        "sole owner",
                        "sole authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежащий или ограниченный одним лицом или группой; не общий.",
                        "zh": "属于个人或特定群体，不与他人共享的。",
                        "pl": "Należący wyłącznie do jednej osoby lub grupy; niepodzielny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единоличный",
                                "target_lang_sense_clarification": "custody, responsibility"
                            },
                            {
                                "target_lang_word": "исключительный",
                                "target_lang_sense_clarification": "rights, usage"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "独有",
                                "target_lang_sense_clarification": "exclusive"
                            },
                            {
                                "target_lang_word": "单独",
                                "target_lang_sense_clarification": "sole responsibility"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyłączny",
                                "target_lang_sense_clarification": "dotyczy praw lub odpowiedzialności"
                            },
                            {
                                "target_lang_word": "jedyny",
                                "target_lang_sense_clarification": "w kontekście sprawowania władzy lub opieki"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69165a5c-d540-3c77-9a31-18d409d9c753",
                    "sense_definition": "The bottom part of a shoe or boot that touches the ground.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "noun_bottom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sole</w> of my running shoe has worn down completely.",
                            "target_lang_translations": {
                                "ru": "<w>Подошва</w> моей беговой кроссовки полностью стерлась.",
                                "zh": "我跑鞋的<w>鞋底</w>已经完全磨损了。",
                                "pl": "<w>Podeszwa</w> mojego buta do biegania całkowicie się starła."
                            }
                        },
                        {
                            "text": "She checked the <w>sole</w> of her boot to see if she had stepped in gum.",
                            "target_lang_translations": {
                                "ru": "Она проверила <w>подошву</w> своего ботинка, чтобы узнать, не наступила ли она в жвачку.",
                                "zh": "她检查了一下靴子的<w>鞋底</w>，看看是不是踩到了口香糖。",
                                "pl": "Sprawdziła <w>podeszwę</w> swojego buta, żeby zobaczyć, czy nie weszła w gumę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rubber sole",
                        "leather sole",
                        "thick sole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя часть обуви, соприкасающаяся с землей.",
                        "zh": "鞋底，即鞋子接触地面的底部。",
                        "pl": "Dolna część obuwia, która styka się z podłożem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подошва",
                                "target_lang_sense_clarification": "shoe part"
                            },
                            {
                                "target_lang_word": "подмётка",
                                "target_lang_sense_clarification": "replaceable sole part"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞋底",
                                "target_lang_sense_clarification": "shoe part"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podeszwa",
                                "target_lang_sense_clarification": "część buta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edc830d2-604a-3546-909e-f9abe6477856",
                    "sense_definition": "The bottom surface of the foot.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_bottom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sharp pain in the <w>sole</w> of his foot.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал острую боль в <w>подошве</w>.",
                                "zh": "他感到<w>脚掌</w>一阵剧痛。",
                                "pl": "Poczuł ostry ból w <w>podeszwie</w> stopy."
                            }
                        },
                        {
                            "text": "The hot sand burned the <w>soles</w> of our feet as we ran to the water.",
                            "target_lang_translations": {
                                "ru": "Горячий песок обжигал нам <w>подошвы</w>, пока мы бежали к воде.",
                                "zh": "当我们跑向水边时，滚烫的沙子灼烧着我们的<w>脚掌</w>。",
                                "pl": "Gorący piasek parzył nas w <w>podeszwy</w>, gdy biegliśmy do wody."
                            }
                        }
                    ],
                    "synonyms": [
                        "planta"
                    ],
                    "common_phrases": [
                        "sole of the foot"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "anatomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя поверхность стопы.",
                        "zh": "脚掌，即脚的底部。",
                        "pl": "Dolna powierzchnia stopy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подошва",
                                "target_lang_sense_clarification": "anatomy"
                            },
                            {
                                "target_lang_word": "ступня",
                                "target_lang_sense_clarification": "foot bottom"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脚掌",
                                "target_lang_sense_clarification": "anatomy"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podeszwa",
                                "target_lang_sense_clarification": "anatomiczna część stopy"
                            },
                            {
                                "target_lang_word": "spód stopy",
                                "target_lang_sense_clarification": "opisowa nazwa anatomiczna"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26e17170-a08d-39a0-aa9b-61a9f0db08bd",
                    "sense_definition": "A flat sea fish with white flesh, often eaten as food.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered grilled <w>sole</w> with lemon and butter for dinner.",
                            "target_lang_translations": {
                                "ru": "Мы заказали жареный <w>морской язык</w> с лимоном и маслом на ужин.",
                                "zh": "晚餐我们点了柠檬黄油烤<w>鳎目鱼</w>。",
                                "pl": "Na kolację zamówiliśmy grillowaną <w>solę</w> z cytryną i masłem."
                            }
                        },
                        {
                            "text": "The fisherman was pleased to catch a large <w>sole</w> in his net.",
                            "target_lang_translations": {
                                "ru": "Рыбак был доволен, поймав в свою сеть крупного <w>морского языка</w>.",
                                "zh": "渔夫很高兴在网里捕到了一条大<w>鳎目鱼</w>。",
                                "pl": "Rybak był zadowolony, że złowił w sieć dużą <w>solę</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Dover sole",
                        "lemon sole",
                        "fillet of sole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская морская рыба с белым мясом, часто употребляемая в пищу.",
                        "zh": "一种肉质洁白的扁平海鱼，常作为食物。",
                        "pl": "Płaska ryba morska o białym mięsie, często spożywana jako pokarm."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морской язык",
                                "target_lang_sense_clarification": "fish"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鳎目鱼",
                                "target_lang_sense_clarification": "fish"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sola",
                                "target_lang_sense_clarification": "gatunek ryby"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f213ecac-21d9-354f-9755-165f00b16107",
                    "sense_definition": "To repair a shoe or boot by replacing the bottom part.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cobbler promised to <w>sole</w> and heel my boots by Friday.",
                            "target_lang_translations": {
                                "ru": "Сапожник обещал <w>поставить подмётки</w> и набойки на мои ботинки к пятнице.",
                                "zh": "鞋匠答应周五前帮我把靴子<w>换底</w>并修好鞋跟。",
                                "pl": "Szewc obiecał <w>zelować</w> i wymienić obcasy w moich butach do piątku."
                            }
                        },
                        {
                            "text": "It is often cheaper to <w>sole</w> old shoes than to buy new ones.",
                            "target_lang_translations": {
                                "ru": "Часто дешевле <w>починить подошву</w> старых туфель, чем покупать новые.",
                                "zh": "给旧鞋<w>换底</w>通常比买新鞋便宜。",
                                "pl": "Często taniej jest <w>zelować</w> stare buty niż kupować nowe."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sole and heel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ремонтировать обувь, заменяя нижнюю часть.",
                        "zh": "修理鞋子，更换鞋底。",
                        "pl": "Naprawiać obuwie poprzez wymianę dolnej części."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить подмётки",
                                "target_lang_sense_clarification": "repair shoes"
                            },
                            {
                                "target_lang_word": "чинить подошву",
                                "target_lang_sense_clarification": "fix sole"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "换底",
                                "target_lang_sense_clarification": "repair shoes"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zelować",
                                "target_lang_sense_clarification": "fachowe określenie naprawy podeszwy"
                            },
                            {
                                "target_lang_word": "wymienić podeszwę",
                                "target_lang_sense_clarification": "opisowa czynność naprawcza"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cd61c89d-59e4-3b4f-849c-62be579a1818",
                    "sense_definition": "A sea area to the north of FitzRoy, corresponding to the Sole Bank.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The shipping forecast issued a gale warning for the area of <w>Sole</w>.",
                            "target_lang_translations": {
                                "ru": "В прогнозе для судоходства было передано штормовое предупреждение для района <w>Сол</w>.",
                                "zh": "航运预报对<w>索尔</w>海域发布了大风警报。",
                                "pl": "Prognoza żeglugowa wydała ostrzeżenie przed sztormem dla obszaru <w>Sole</w>."
                            }
                        },
                        {
                            "text": "Fishermen often navigate the waters around <w>Sole</w> carefully during storms.",
                            "target_lang_translations": {
                                "ru": "Рыбаки часто с осторожностью проходят воды вокруг <w>Сол</w> во время штормов.",
                                "zh": "暴风雨期间，渔民在<w>索尔</w>周边海域航行时通常会格外小心。",
                                "pl": "Rybacy często ostrożnie żeglują po wodach wokół <w>Sole</w> podczas sztormów."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Морской район к северу от Фицроя, соответствующий банке Сол.",
                        "zh": "位于菲茨罗伊以北的海域，对应索尔浅滩。",
                        "pl": "Obszar morski na północ od FitzRoy, odpowiadający ławicy Sole."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сол",
                                "target_lang_sense_clarification": "geographic area"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "索尔",
                                "target_lang_sense_clarification": "geographic area"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Sole",
                                "target_lang_sense_clarification": "nazwa własna obszaru morskiego"
                            }
                        ]
                    }
                }
            ]
        }
