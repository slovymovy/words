                    {
                        "sense_id": "21d0d667-2e7e-3acb-9762-1f90597c4709",
                        "entry_id": "69200a68-c82e-3002-b7da-ae4791cc8c06",
                        "glosses": [
                            "Phénomène sociologique décrivant les relations fréquentes et régulières entre membres du même sexe qui ne sont pas d'une nature romantique ou sexuelle, telles que l'amitié ou le mentorat."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "312670b1-4f46-3d0b-8956-fece313f9967",
                        "entry_id": "69200a68-c82e-3002-b7da-ae4791cc8c06",
                        "glosses": [
                            "Socialité homosexuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98c1b07e-8532-4a81-bf44-93253304e2f7",
                                "sense_id": "312670b1-4f46-3d0b-8956-fece313f9967",
                                "text": "On utilise le terme homosocialité parce que l’homosexualité ne recouvre pas uniquement la sexualité mais aussi des modes de vie, des courants de pensée, une culture propre."
                            }
                        ]
                    }
                ],
