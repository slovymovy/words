                                    {
                                        "sense_id": "e7d51a30-5cb9-34f7-9a62-dd0f0aeb2b08",
                                        "entry_id": "1a185c22-40fc-3fe7-baf6-65e8e1545332",
                                        "glosses": [
                                            "A binary compound of fluorine and another element or radical."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47cfd058-516d-3b8b-bc38-24aacb8e5f13",
                                        "entry_id": "1a185c22-40fc-3fe7-baf6-65e8e1545332",
                                        "glosses": [
                                            "A binary compound of fluorine and another element or radical.",
                                            "Any of certain salts of hydrofluoric acid, such as the simple metallic ones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a26bd95-36cd-44d4-bdd8-423e7707c322",
                                                "sense_id": "47cfd058-516d-3b8b-bc38-24aacb8e5f13",
                                                "text": "However, too much fluoride produces a mottling effect on teeth. Large doses of fluoride are actually toxic."
                                            },
                                            {
                                                "example_id": "77348530-1718-4204-b2f3-bbfe20208cc3",
                                                "sense_id": "47cfd058-516d-3b8b-bc38-24aacb8e5f13",
                                                "text": "The public health practice of adding fluoride to water supplies faces new scrutiny as a few recent reports raise concerns about potential health risks and suggest the benefits may not be as significant as they once were."
                                            },
                                            {
                                                "example_id": "c34defee-f06f-4576-9327-e5f11e23ce48",
                                                "sense_id": "47cfd058-516d-3b8b-bc38-24aacb8e5f13",
                                                "text": "McCoy’s team, including 66 researchers across four continents, found the salt and minerals left behind as water on Bennu, or its larger parent asteroid, evaporated. The minerals include sodium phosphates, carbonates, sulfates, chlorides and fluorides, some of which are necessary to the formation of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2bfe3b0-1fa6-307c-823e-2216300f002f",
                                        "entry_id": "1a185c22-40fc-3fe7-baf6-65e8e1545332",
                                        "glosses": [
                                            "The anionic form of a fluorine atom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
