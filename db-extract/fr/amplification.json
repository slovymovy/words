                    {
                        "sense_id": "d0454d8c-81c0-3923-b218-5df09002b564",
                        "entry_id": "5ee6e955-2a5f-332e-9fd6-717774d2531d",
                        "glosses": [
                            ". Action d’amplifier. Amplification oratoire."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "4fa0d6b3-58c4-4605-9065-6b73b304d8e7",
                                "sense_id": "d0454d8c-81c0-3923-b218-5df09002b564",
                                "text": "Les paroles indignées du lieutenant sur la conduite de ses poilus, les amplifications moins vertueuses mais ultra-séduisantes qu’y ajouta Lénac, mirent l’eau à la bouche des hommes de la 8ᵉ."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ae78ece-53f0-3296-b927-8376db22f6e9",
                        "entry_id": "5ee6e955-2a5f-332e-9fd6-717774d2531d",
                        "glosses": [
                            "Il se disait, dans les collèges, des discours que les écoliers faisaient sur un sujet qu’on leur donnait à développer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b9060db-74b0-4b11-8f04-3ac35a5c2f1f",
                                "sense_id": "9ae78ece-53f0-3296-b927-8376db22f6e9",
                                "text": "Cet écolier réussissait dans les amplifications."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fb31140-4c80-3176-baea-00df55e6346d",
                        "entry_id": "5ee6e955-2a5f-332e-9fd6-717774d2531d",
                        "glosses": [
                            "Désigne le grossissement des corps vus à travers une lunette."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "be68dd24-b80d-3472-9466-56837af602f7",
                        "entry_id": "5ee6e955-2a5f-332e-9fd6-717774d2531d",
                        "glosses": [
                            "Désigne aussi des modifications d’effets d’un courant électrique obtenues au moyen de l’amplificateur."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "16be9719-1500-4af1-8f07-7a890a193ecd",
                                "sense_id": "be68dd24-b80d-3472-9466-56837af602f7",
                                "text": "Les équipements de télécommunications, que l'on appelle des répéteurs, assurent les mêmes fonctions qu'un relai hertzien : ils reçoivent les émissions provenant de la Terre et les réémettent vers la Terre après amplification et transposition en fréquence."
                            }
                        ]
                    },
