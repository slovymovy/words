                "senses": [
                    {
                        "sense_id": "847ae447-e9e8-30c7-b734-31e725d26cb8",
                        "entry_id": "8495f180-1afb-3b15-8b09-4813fc3fad15",
                        "glosses": [
                            "automatisch, zonder sturing van bovenaf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97bfda47-8032-48e8-9d5e-aca6dc688fb5",
                                "sense_id": "847ae447-e9e8-30c7-b734-31e725d26cb8",
                                "text": "Ook tactisch voegde Post een dimensie toe aan het wielrennen. Bij hem werd 'allen voor één, één voor allen' het adagium. De kopman maakte plaats voor een hecht collectief. In de beste jaren was dat een zelfwerkend mechanisme. Post beperkte zich tot de infrastructuur, opdat het de coureurs aan niets ontbrak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5f32844-cfc6-40e5-9e96-ea3f301c9a11",
                        "source_entry_id": "8495f180-1afb-3b15-8b09-4813fc3fad15",
                        "source_sense_id": "847ae447-e9e8-30c7-b734-31e725d26cb8",
                        "source_sense_description": "automatisch, zonder sturing van bovenaf",
                        "target_lang_word": "self-acting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-acting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab82a75b-21a6-36c0-a348-23bc58b30526",
                                        "entry_id": "2a1fdc34-1a3b-3e16-b7c2-79695a1bea42",
                                        "glosses": [
                                            "Acting of or by itself."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52156cd2-2f05-4e44-b5aa-1e79796b22ca",
                                                "sense_id": "ab82a75b-21a6-36c0-a348-23bc58b30526",
                                                "text": "On this railway there were three inclined planes of the self-acting type, the full wagons pulling up the empty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ff1e293-69a6-470f-8d11-ab7006439890",
                        "source_entry_id": "8495f180-1afb-3b15-8b09-4813fc3fad15",
                        "source_sense_id": "847ae447-e9e8-30c7-b734-31e725d26cb8",
                        "source_sense_description": "automatisch, zonder sturing van bovenaf",
                        "target_lang_word": "automatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "224ba00c-ad20-37b8-9a13-a23b12a548c7",
                                        "entry_id": "8266f52a-c256-36a8-af8d-c9414f79607c",
                                        "glosses": [
                                            "Capable of operating without external control or intervention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0919528a-e776-4364-860a-3b7c1773a151",
                                                "sense_id": "224ba00c-ad20-37b8-9a13-a23b12a548c7",
                                                "text": "The automatic clothes washer was a great labor-saving device."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45ac2e46-7cb4-3035-8bec-8cc3faf47dda",
                                        "entry_id": "8266f52a-c256-36a8-af8d-c9414f79607c",
                                        "glosses": [
                                            "Done out of habit or without conscious thought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b119467b-6646-4752-83b1-b5f8bcda6f20",
                                                "sense_id": "45ac2e46-7cb4-3035-8bec-8cc3faf47dda",
                                                "text": "The reaction was automatic: flight!"
                                            },
                                            {
                                                "example_id": "a3da0201-cf8a-43f7-a77a-ca0625f49ee5",
                                                "sense_id": "45ac2e46-7cb4-3035-8bec-8cc3faf47dda",
                                                "text": "Absent-minded doodling is a form of automatic art."
                                            },
                                            {
                                                "example_id": "c8f9839a-19ba-47c1-8d3a-4e170e1ffde9",
                                                "sense_id": "45ac2e46-7cb4-3035-8bec-8cc3faf47dda",
                                                "text": "\"I don't know why! Sometimes I feel like a girl! Sometimes a guy! I don't know why I feel that way! I just do! Always have! I can't remember not feeling this way! How do you explain something as natural and automatic to you as breathing?!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dc86cba-2603-3117-bb80-da46bfb04a02",
                                        "entry_id": "8266f52a-c256-36a8-af8d-c9414f79607c",
                                        "glosses": [
                                            "Necessary, inevitable, prescribed by logic, law, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c512c3-5c3b-4131-9f2c-d4c9cd2369fb",
                                                "sense_id": "8dc86cba-2603-3117-bb80-da46bfb04a02",
                                                "text": "Spitting at another player means an automatic red card."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0781dff8-7e98-3498-af73-7b7fb5186103",
                                        "entry_id": "8266f52a-c256-36a8-af8d-c9414f79607c",
                                        "glosses": [
                                            "Firing continuously as long as the trigger is pressed until ammunition is exhausted."
                                        ],
                                        "tags": [
                                            "of a firearm such as a machine gun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eea6795c-c7eb-4552-997b-d640c4334caf",
                                                "sense_id": "0781dff8-7e98-3498-af73-7b7fb5186103",
                                                "text": "Fully automatic weapons cannot be legally owned by private citizens in the US, except in very special circumstances, as by private security companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbe1fc69-f36e-304f-9b96-84e37b7f0c20",
                                        "entry_id": "8266f52a-c256-36a8-af8d-c9414f79607c",
                                        "glosses": [
                                            "An autoloader; a semi-automatic or self-loading pistol, as opposed to a revolver or other manually actuated handgun, which fires one shot per pull of the trigger; distinct from machine guns."
                                        ],
                                        "tags": [
                                            "of a handgun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904a718a-88af-4a90-bb63-86f51d5e51e1",
                                                "sense_id": "fbe1fc69-f36e-304f-9b96-84e37b7f0c20",
                                                "text": "The US Army adopted John Browning's M1911 pistol as its sidearm, chambered in .45 ACP (Automatic Colt Pistol)."
                                            },
                                            {
                                                "example_id": "6648215b-bafd-445b-9251-766a8918826f",
                                                "sense_id": "fbe1fc69-f36e-304f-9b96-84e37b7f0c20",
                                                "text": "From a little hand-bag he extracted his automatic pistol, which he put upon the mantelpiece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2384ed56-08b8-3dfa-9818-f44f5de58931",
                                        "entry_id": "8266f52a-c256-36a8-af8d-c9414f79607c",
                                        "glosses": [
                                            "Automatically added to and removed from the stack during the course of function calls."
                                        ],
                                        "tags": [
                                            "of a local variable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bfec82-2bd1-4706-969a-77310f54c0f0",
                                                "sense_id": "2384ed56-08b8-3dfa-9818-f44f5de58931",
                                                "text": "Automatic variables are created on the stack. They are valid only from the point where they are declared to the end of the function."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f9d3a7d-da60-3cab-a8e1-554d3c781f1f",
                                        "entry_id": "8266f52a-c256-36a8-af8d-c9414f79607c",
                                        "glosses": [
                                            "Having one or more finite-state automata."
                                        ],
                                        "tags": [
                                            "of a group"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "automatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32666884-9de6-31cb-a04c-f4a1f8a70a7b",
                                        "entry_id": "45081165-7f96-3945-8d0a-c0aa68ada560",
                                        "glosses": [
                                            "A car with an automatic transmission; the transmission itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73f1daaf-044d-40e4-ad54-f50a0f551fb6",
                                                "sense_id": "32666884-9de6-31cb-a04c-f4a1f8a70a7b",
                                                "text": "I never learned to drive a stick. I can only drive an automatic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1e61a38-f448-3a84-844d-3fdd77c934d0",
                                        "entry_id": "45081165-7f96-3945-8d0a-c0aa68ada560",
                                        "glosses": [
                                            "A semi-automatic pistol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80bebe4e-2c47-401b-9617-8edddb7a612e",
                                                "sense_id": "e1e61a38-f448-3a84-844d-3fdd77c934d0",
                                                "text": "The G-men raiding the speakeasy were equipped with .45 automatics, while the local policemen were carrying revolvers and shotguns."
                                            },
                                            {
                                                "example_id": "323cdc2f-d41e-45b4-9f15-d626166ab2c8",
                                                "sense_id": "e1e61a38-f448-3a84-844d-3fdd77c934d0",
                                                "text": "\"I told him that if my automatic was not a spook-stopper, nothin' else would serve.\""
                                            },
                                            {
                                                "example_id": "82a2dfdb-e7dd-45cf-9741-c62e57b410fb",
                                                "sense_id": "e1e61a38-f448-3a84-844d-3fdd77c934d0",
                                                "text": "'The automatic under his pillow gave the lie to that statement.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
