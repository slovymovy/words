    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bba87d50-168e-3ed7-904c-377cbf34c06e",
                    "sense_definition": "The process of making something more varied or including a wider range of different elements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is focusing on the <w>diversification</w> of its workforce to include people from many different backgrounds."
                        },
                        {
                            "text": "Cultural <w>diversification</w> has brought many new ideas and traditions to our local community."
                        }
                    ],
                    "synonyms": [
                        "variety",
                        "variation"
                    ],
                    "antonyms": [
                        "uniformity"
                    ],
                    "common_phrases": [
                        "cultural diversification",
                        "workforce diversification"
                    ]
                },
                {
                    "sense_id": "3d4f3231-e95d-3d60-89f5-b060450eca20",
                    "sense_definition": "An investment strategy of spreading money across different types of assets to lower financial risk.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proper <w>diversification</w> of your portfolio helps protect your savings from sudden market crashes."
                        },
                        {
                            "text": "Financial advisors often recommend <w>diversification</w> to ensure that one bad investment does not ruin your entire plan."
                        }
                    ],
                    "common_phrases": [
                        "portfolio diversification",
                        "investment diversification"
                    ]
                },
                {
                    "sense_id": "2bd4889a-41d7-3d40-8eac-9e48dd71f60d",
                    "sense_definition": "A business strategy where a company enters new markets or starts selling new products unrelated to its current business.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tech giant pursued <w>diversification</w> by buying a major food production company last year."
                        },
                        {
                            "text": "Strategic <w>diversification</w> allowed the firm to survive when its main industry began to decline."
                        }
                    ],
                    "synonyms": [
                        "expansion"
                    ],
                    "common_phrases": [
                        "strategic diversification",
                        "business diversification"
                    ]
                }
            ]
        }
    ]
