                ],
                "senses": [
                    {
                        "sense_id": "7a04d6d2-38c1-3348-b628-d3b482b294d2",
                        "entry_id": "ed324154-bbb9-36d1-bade-6f597e399122",
                        "glosses": [
                            "Relatif à l’expansionnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d013a945-cf61-41b6-9885-5a353391c02e",
                                "sense_id": "7a04d6d2-38c1-3348-b628-d3b482b294d2",
                                "text": "La politique expansionniste de l'Union soviétique en Afghanistan."
                            },
                            {
                                "example_id": "fc5c329b-0aea-47ad-97d7-75c0934b1cdd",
                                "sense_id": "7a04d6d2-38c1-3348-b628-d3b482b294d2",
                                "text": "Dès 1933 donc, Kraus parle longuement des préparatifs de guerre de l’Allemagne nazie, de ses visées expansionnistes, de l’antisémitisme affiché et brutal, de la structure préfasciste de la société allemande, des camps de concentration (le premier, Oranienburg, a été ouvert en février 1933, suivi par celui de Dachau en mars de la même année), des tortures, des exécutions sommaires, des sévices perpétrés contre les femmes accusées de « se commettre » avec des Juifs, de la « détention préventive » comme incarcération arbitraire et sans jugement permettant de mettre rapidement les opposants à l’écart."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a45e9b82-fec4-491a-a1c2-2b768c156c76",
                        "source_entry_id": "ed324154-bbb9-36d1-bade-6f597e399122",
                        "source_sense_id": "7a04d6d2-38c1-3348-b628-d3b482b294d2",
                        "target_lang_word": "expansionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expansionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0a34c3b-8e57-3e5b-9263-eea2ddc3a57e",
                                        "entry_id": "6ae6503e-0965-3dc5-89d2-a0ffb3d8bcfc",
                                        "glosses": [
                                            "Of or pertaining to expansionism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84023fc6-1aec-44e7-a011-6ef5b6138359",
                                                "sense_id": "f0a34c3b-8e57-3e5b-9263-eea2ddc3a57e",
                                                "text": "Unlike passenger demand forecasts in England, that have resulted in the removal of 20% of service capacity in the May 2022 timetable, Welsh Ministers acting through the TfW agency are continuing an expansionist agenda for rail services under their control."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "expansionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bcdef30-34d5-37e6-8ccb-77e908c1611e",
                                        "entry_id": "cdcc3a41-27b5-35ba-9dee-b15404e54fac",
                                        "glosses": [
                                            "An advocate of expansionism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b05696ed-8d5d-4289-9036-2a99171cc27c",
                                                "sense_id": "1bcdef30-34d5-37e6-8ccb-77e908c1611e",
                                                "text": "Mr. Miller argues convincingly that a majority of Americans shared the romantic nationalism of such expansionists as Theodore Roosevelt and Sen. Albert Beveridge and participated vicariously in their dreams of martial glory and expanding markets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
