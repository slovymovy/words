                                                "example_id": "a2e144e6-4d1f-4680-b4ef-8b187e64819a",
                                                "sense_id": "a83fdb78-1bda-3dd8-b2fd-dd2c946cb460",
                                                "text": "Юрка сел опять за учебники."
