                "senses": [
                    {
                        "sense_id": "41a31a36-b0e1-3bcc-b511-41edfd0155a4",
                        "entry_id": "fe53ef24-7cbf-3ff7-a591-05a7fd489151",
                        "glosses": [
                            "Tür, die sich an einem Schrank befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4226a03-a556-4814-ac69-dd140520a557",
                                "sense_id": "41a31a36-b0e1-3bcc-b511-41edfd0155a4",
                                "text": "„Aber immerhin konnte man alle Schranktüren öffnen, stellte ich neidisch fest.“"
                            },
                            {
                                "example_id": "0cb9251f-aa3a-4f6d-b137-865772653ad0",
                                "sense_id": "41a31a36-b0e1-3bcc-b511-41edfd0155a4",
                                "text": "„Die Schranktür war offen.“"
                            },
                            {
                                "example_id": "c7656101-881f-44c3-b12b-d7b6bbb9349b",
                                "sense_id": "41a31a36-b0e1-3bcc-b511-41edfd0155a4",
                                "text": "„Ich hörte, wie oben im ersten Stock eine Schranktür zugeschlagen wurde.“"
                            },
                            {
                                "example_id": "ac398fa5-8957-41a2-820a-61c9758deeee",
                                "sense_id": "41a31a36-b0e1-3bcc-b511-41edfd0155a4",
                                "text": "„Die Schranktüren waren herausgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
