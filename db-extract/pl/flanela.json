                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46300fc6-2791-3a7c-823c-2322a9b7dd43",
                                        "entry_id": "32a34321-ed48-33ce-aaf6-3f4f58555116",
                                        "glosses": [
                                            "To waffle or prevaricate."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb451984-d87e-4b14-ba65-4bb7610806a0",
                                                "sense_id": "46300fc6-2791-3a7c-823c-2322a9b7dd43",
                                                "text": "I got a little cross and asked him to stop flannelling and to tell me what was holding me back. Were my annual assessments below par? Was there something I had done – or not done?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4e0b4b2-8dd0-4a4e-8c20-640939d46493",
                        "source_entry_id": "278820b6-fa54-3e20-9295-61da4eea6b12",
                        "source_sense_id": "819eb17c-9506-35b6-862c-85521fb7e67f",
                        "target_lang_word": "flanelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flanelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa5c5294-d64b-3249-a3b6-cbc3e8ca5dd0",
                                        "entry_id": "adc124e5-37d8-3e5d-a121-57c26dda78a5",
                                        "glosses": [
                                            "Étoffe de laine peignée ou cardée, à tissu peu serré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cc807c4-70eb-4b5b-805a-8d31fc0c85af",
                                                "sense_id": "fa5c5294-d64b-3249-a3b6-cbc3e8ca5dd0",
                                                "text": "Les femmes, qui sont de taille moyenne et plutôt trapues, portent une robe en vadmel, sorte de flanelle tissée avec la laine qu'elles-mêmes ont cardée et filée."
                                            },
                                            {
                                                "example_id": "dcb22469-629f-43c9-9476-8436605938ea",
                                                "sense_id": "fa5c5294-d64b-3249-a3b6-cbc3e8ca5dd0",
                                                "text": "Chez Gap, je voudrais ce pantalon de flanelle à la Lauren Bacall, taille extra-small."
                                            },
                                            {
                                                "example_id": "15f431c2-a6f2-4da2-821a-d3389b693da7",
                                                "sense_id": "fa5c5294-d64b-3249-a3b6-cbc3e8ca5dd0",
                                                "text": "Son ventre retombait en plis grassouillets sur une taillole de flanelle grège retenant le pantalon."
                                            },
                                            {
                                                "example_id": "3148536f-a93f-4bbd-871e-2b4cb25ffa22",
                                                "sense_id": "fa5c5294-d64b-3249-a3b6-cbc3e8ca5dd0",
                                                "text": "La bonne la déshabilla, l’enveloppa dans une longue tunique de flanelle et serra, par-dessus, sa robe de chambre en laine bouillie, puis elle remonta l’édredon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "570ab237-b03a-3023-87d5-adbd116a6d54",
                                        "entry_id": "adc124e5-37d8-3e5d-a121-57c26dda78a5",
                                        "glosses": [
                                            "Vêtement de flanelle."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c715e9c-738d-4647-a137-06faf5c06a6b",
                                                "sense_id": "570ab237-b03a-3023-87d5-adbd116a6d54",
                                                "text": "— J’aurais bien dû te donner une flanelle, dit la mère. En arrivant, tu te serais changé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
