                        "examples": [
                            {
                                "example_id": "31922ff1-93af-45ab-a1cb-80b278f466d4",
                                "sense_id": "a52e6f39-c4d5-350d-9d19-fa0817c325cc",
                                "text": "Comme la Julia vivait seule depuis la mort de son père dans son magasin et une arrière-boutique dont le loyer était hors de prix, une bredine lui persuade de prendre le vieux chez elle, de lui donner les derniers soins, en échange de quoi il lui donnerait sa maison."
                            },
                            {
                                "example_id": "85bc2500-7135-48f5-a26b-97abf20533f2",
                                "sense_id": "a52e6f39-c4d5-350d-9d19-fa0817c325cc",
                                "text": "Cependant j'hésite, car tu risques de me prendre pour une bredine et de revenir sur ta proposition de me prêter de quoi me refaire."
                            }
                        ]
                    }
