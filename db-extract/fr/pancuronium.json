                                        "sense_id": "9d1cbe05-0fb3-3a4e-98bf-20b223fc8367",
                                        "entry_id": "4194db91-b143-3336-9a25-caf71bc8d9da",
                                        "glosses": [
                                            "A synthetic steroid which is used as a neuromuscular blocking agent."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "535229aa-4d4a-4cdd-8d2b-67c13c2272c0",
                                                "sense_id": "9d1cbe05-0fb3-3a4e-98bf-20b223fc8367",
                                                "text": "Pancuronium bromide has been used frequently for muscle relaxation during cardiac anesthesia and has been reported to provide superior hemodynamics compared with vecuronium (171) or with metocurine or metocurine-pancuronium combinations."
                                            },
                                            {
                                                "example_id": "9e6d3491-463c-443c-ad99-418bf41a991d",
                                                "sense_id": "9d1cbe05-0fb3-3a4e-98bf-20b223fc8367",
                                                "text": "The second chemical is pancuronium bromide, a relative of curare."
                                            },
                                            {
                                                "example_id": "c516f410-8678-4fec-a16a-719e9adfd18e",
                                                "sense_id": "9d1cbe05-0fb3-3a4e-98bf-20b223fc8367",
                                                "text": "The only long-acting relaxant that is still used in some institutions is pancuronium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
