                "senses": [
                    {
                        "sense_id": "b7bd1206-3328-3a7c-b4a0-58f037fd347b",
                        "entry_id": "2d7fd68e-c67f-3cca-8259-ab9429a33b7b",
                        "glosses": [
                            "linguistische Disziplin, die sich mit Spracherscheinungen in abgegrenzten Gebieten befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dff1c937-3d8a-4490-a6be-02ccbff9f05a",
                                "sense_id": "b7bd1206-3328-3a7c-b4a0-58f037fd347b",
                                "text": "Entscheidend bei der Areallinguistik ist die Ausrichtung auf den geographischen Aspekt."
                            },
                            {
                                "example_id": "0e5e94dc-8c07-4708-b854-3f737086c12c",
                                "sense_id": "b7bd1206-3328-3a7c-b4a0-58f037fd347b",
                                "text": "„Eine Areallinguistik (Dialektgeographie) ist von der Soziolinguistik immer dann deutlich zu trennen, wenn der variabel gehaltene Raumfaktor (Dialekt vs. Sprachraum) eine extrakommunikative Fragestellung bewirkt.“"
                            },
                            {
                                "example_id": "d453b740-f9ca-47c1-a8ae-bb7ace3c23ad",
                                "sense_id": "b7bd1206-3328-3a7c-b4a0-58f037fd347b",
                                "text": "„Areallinguistik heißt diejenige Teildisziplin, in der Übereinstimmungen und Unterschiede zwischen sich räumlich gegeneinander abhebenden Sprachsystemen oder zwischen geographisch differenzierten sprachlichen Subsystemen sowie die Verbreitung der Übereinstimmungen mit Hilfe kartographischer Darstellungen interpretiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
