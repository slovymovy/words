                    }
                ],
                "senses": [
                    {
                        "sense_id": "af2c3dc2-1541-3287-ade3-fab814c2edcc",
                        "entry_id": "d5265ed8-a3f7-32e1-92f9-fa626ba0b476",
                        "glosses": [
                            "Einrichtung, in der Menschen im Alter wohnen und je nach Bedarf betreut und gepflegt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6221df1-35cc-45a9-a39e-b4dd0f599165",
                                "sense_id": "af2c3dc2-1541-3287-ade3-fab814c2edcc",
                                "text": "Sonntags besuchen wir meist Uroma im Altersheim."
                            },
                            {
                                "example_id": "221c7c91-d866-4638-8be0-4be47bf8f490",
                                "sense_id": "af2c3dc2-1541-3287-ade3-fab814c2edcc",
                                "text": "„Helena wollte in beiden Welten leben, sie wollte mit ihren Tieren leben und nicht auf den Platz im Altersheim verzichten.“"
                            },
                            {
                                "example_id": "818d2a00-a80a-460f-81c2-4e4e5064cde0",
                                "sense_id": "af2c3dc2-1541-3287-ade3-fab814c2edcc",
                                "text": "„Wer keine Lust auf Altersheim oder Kindergarten hatte, konnte Flüchtlingen helfen.“"
                            },
                            {
                                "example_id": "480ddbfa-531d-46c6-909d-0b1d63e11fe7",
                                "sense_id": "af2c3dc2-1541-3287-ade3-fab814c2edcc",
                                "text": "„Aber Teresienstadt war nicht einfach ein Aufbewahrungsort, ein Altersheim, oder, wie man manchen alten jüdischen Ehepaaren weismachte, denen man ihr Eigentum abschwatzte, ein Kurort, in den man sich einkaufen konnte.“"
                            },
                            {
                                "example_id": "dc67ef68-cad3-4a2c-abbc-161df469149b",
                                "sense_id": "af2c3dc2-1541-3287-ade3-fab814c2edcc",
                                "text": "„Manchmal nahm meine Mutter mich in ein Altersheim mit, das in der Nähe ihrer Wohnung lag und in dem sie ihre Freundinnen zu besuchen pflegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
