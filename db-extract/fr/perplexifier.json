                "senses": [
                    {
                        "sense_id": "8c62352e-2bfe-33f3-9fca-e1e132bdbfb6",
                        "entry_id": "1aeb28f9-2c28-3f0a-94df-652a8c639cc2",
                        "glosses": [
                            "Rendre perplexe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf0ca4d3-6846-46c1-a466-e862faf323bc",
                                "sense_id": "8c62352e-2bfe-33f3-9fca-e1e132bdbfb6",
                                "text": "Lacan, lorsqu’il faisait ses présentations de malades, avait l’habitude de perplexifier l’assistant qui veillait à lui fournir un malade, à faire que ça se passe bien, etc."
                            },
                            {
                                "example_id": "c54c37a7-c603-4aad-b96b-89a2322c4d17",
                                "sense_id": "8c62352e-2bfe-33f3-9fca-e1e132bdbfb6",
                                "text": "Réagissant comme les spectateurs d’un mirage, le sujet « perplexifié » va se construire un espace défensif pour critiquer l’illusionnement dont il ne peut cependant se déprendre, maintenu en cela par le désir parental."
                            }
                        ]
                    }
