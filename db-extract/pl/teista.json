                "senses": [
                    {
                        "sense_id": "5030153c-ceaa-3908-a26e-2898dd916f16",
                        "entry_id": "6a14831b-25fe-30e9-b9e7-0093e8dfceb4",
                        "glosses": [
                            "osoba wyznająca teizm"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a21d6fb0-d1dd-46d8-bfea-08dc41ac2e29",
                        "source_entry_id": "6a14831b-25fe-30e9-b9e7-0093e8dfceb4",
                        "source_sense_id": "5030153c-ceaa-3908-a26e-2898dd916f16",
                        "target_lang_word": "theist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4943ed1-1518-307b-a6a9-484ce775ef30",
                                        "entry_id": "6012326d-a607-3e0a-8cd8-92aefda75ff9",
                                        "glosses": [
                                            "One who believes in the existence of a god or gods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e132cce2-61b4-423b-b13b-0a61cb2e1424",
                                                "sense_id": "e4943ed1-1518-307b-a6a9-484ce775ef30",
                                                "text": "The term stands in contradistinction to theism which, in its widest sense, means belief in a personal god, goddess, gods and /or goddesses."
                                            },
                                            {
                                                "example_id": "e0dbafb1-555c-4574-bffa-1c5739220175",
                                                "sense_id": "e4943ed1-1518-307b-a6a9-484ce775ef30",
                                                "text": "The theist is a man firmly persuaded of the existence of a Supreme Being as good as He is powerful, who has formed all beings with extension, vegetating, sentient and reflecting; who perpetuates their species, who punishes crimes without cruelty, and rewards virtuous actions with kindness."
                                            },
                                            {
                                                "example_id": "556b1f78-27d3-42f7-954c-9339f89fdc07",
                                                "sense_id": "e4943ed1-1518-307b-a6a9-484ce775ef30",
                                                "text": "[…] and I call him a theist who believes in any God."
                                            },
                                            {
                                                "example_id": "4c4c9f02-d0ee-4228-9bb9-e708597183b9",
                                                "sense_id": "e4943ed1-1518-307b-a6a9-484ce775ef30",
                                                "text": "No one is to be called a Theist, who does not believe in a Personal God, whatever difficulty there may be in defining the word \"Personal.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7c026ce-a10c-4e26-b5e8-dfc1b82e2306",
                        "source_entry_id": "6a14831b-25fe-30e9-b9e7-0093e8dfceb4",
                        "source_sense_id": "5030153c-ceaa-3908-a26e-2898dd916f16",
                        "target_lang_word": "teísta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teísta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "abca0170-f927-3241-a9a8-543fb25cf5fd",
                                        "entry_id": "58e464a3-6e5f-3a18-a1ee-c6ed274e6e0a",
                                        "glosses": [
                                            "Propio o relacionado con el teísmo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33c26c58-93ea-4055-bc6b-1421fd9f49fd",
                        "source_entry_id": "6a14831b-25fe-30e9-b9e7-0093e8dfceb4",
                        "source_sense_id": "5030153c-ceaa-3908-a26e-2898dd916f16",
                        "target_lang_word": "Theist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "368d93e8-a1a9-3474-9f11-0ab7c0e51ec2",
                                        "entry_id": "72f21a53-69a6-3b06-bc5e-047bc9346815",
                                        "glosses": [
                                            "Anhänger des Theismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9289aa-87e6-4dd2-a7a8-e6a522f294e3",
                                                "sense_id": "368d93e8-a1a9-3474-9f11-0ab7c0e51ec2",
                                                "text": "Theisten glauben an Gott."
                                            },
                                            {
                                                "example_id": "9153fad1-c4bd-4c71-bd07-f996d2b55d10",
                                                "sense_id": "368d93e8-a1a9-3474-9f11-0ab7c0e51ec2",
                                                "text": "„Man behauptet, daß ein Atheist, der bei seinen Erwägungen an Gott denkt, mehr wert ist, als ein Theist, der nie an ihn denkt.“"
                                            },
                                            {
                                                "example_id": "35f446cc-3b43-4709-9a63-7434f463a321",
                                                "sense_id": "368d93e8-a1a9-3474-9f11-0ab7c0e51ec2",
                                                "text": "„Die Religionen wurden ihres dogmatischen, symbolischen, historischen Inhaltes entkleidet, und der Gott, den die Theisten übrigließen, war eine bloße Abstraktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e08ece7-7a27-3904-8415-7650a4d668e7",
                                        "entry_id": "72f21a53-69a6-3b06-bc5e-047bc9346815",
                                        "glosses": [
                                            "Anhänger des Theismus",
                                            "von Theismus im engen Sinne"
                                        ],
