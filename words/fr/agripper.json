                {
                    "sense_id": "76b9b7ef-2b42-354e-b1cc-ec28c1346815",
                    "sense_definition": "S'attacher ou se tenir fermement à quelque chose pour ne pas tomber ou être emporté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "saisir_fermement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la tempête, l'enfant s'<w>agrippait</w> à la rampe pour ne pas glisser sur le sol mouillé."
                        },
                        {
                            "text": "Terrifié par le vide, le randonneur s'<w>agrippe</w> de toutes ses forces à la paroi rocheuse."
