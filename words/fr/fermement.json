                {
                    "sense_id": "a0c5255c-a7a8-3c95-b554-3e6b55958047",
                    "sense_definition": "Avec résolution, autorité ou une entière conviction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "volonté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a refusé <w>fermement</w> d'accepter cette proposition injuste.",
                            "target_lang_translations": {
                                "en": "The director <w>firmly</w> refused to accept this unfair proposal.",
                                "ru": "Директор <w>решительно</w> отказался принять это несправедливое предложение.",
                                "de": "Der Direktor lehnte es <w>entschieden</w> ab, diesen ungerechten Vorschlag anzunehmen.",
                                "es": "El director se negó <w>firmemente</w> a aceptar esta propuesta injusta.",
                                "zh": "那位经理<w>坚决</w>拒绝接受这项不公平的提议。"
                            }
                        },
                        {
                            "text": "Nous continuons de croire <w>fermement</w> en la réussite de notre projet commun.",
                            "target_lang_translations": {
                                "en": "We continue to <w>firmly</w> believe in the success of our joint project.",
                                "ru": "Мы по-прежнему <w>твёрдо</w> верим в успех нашего общего проекта.",
                                "de": "Wir glauben nach wie vor <w>fest</w> an den Erfolg unseres gemeinsamen Projekts.",
                                "es": "Seguimos creyendo <w>firmemente</w> en el éxito de nuestro proyecto común.",
                                "zh": "我们仍然<w>坚定</w>地相信，我们的共同项目会取得成功。"
                            }
                        }
                    ],
                    "synonyms": [
                        "résolument",
                        "catégoriquement"
                    ],
                    "antonyms": [
                        "mollement",
                        "hésitamment"
                    ],
                    "common_phrases": [
