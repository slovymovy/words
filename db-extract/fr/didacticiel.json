                    {
                        "translation_id": "634c4c1b-aa7a-4659-8e1c-5052b6d23208",
                        "source_entry_id": "3e54f75d-3f05-37a6-8bfd-6b2d2c12caa4",
                        "source_sense_id": "3f12fa04-d6ad-3e55-9c96-c8496bce0940",
                        "source_sense_description": "EDV, Bildung: Lernsoftware, Lernprogramm",
                        "target_lang_word": "Lernprogramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lernprogramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa02e245-e0df-3a24-8596-55e20573e9a8",
                                        "entry_id": "f9b56254-2318-3d0a-8cad-baa301a5e6ca",
                                        "glosses": [
                                            "systematisch aufgebaute Abfolge von kleinsten Lerneinheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6d81da7-4215-46ca-89db-13bd1f5b983c",
                                                "sense_id": "fa02e245-e0df-3a24-8596-55e20573e9a8",
                                                "text": "„Wie Lernprogramme sind auch Lernprojekte definiert als Netzwerk von Aktivitäten.“"
                                            },
                                            {
                                                "example_id": "06f7e4c0-4615-4ac9-9367-18643ed7de77",
                                                "sense_id": "fa02e245-e0df-3a24-8596-55e20573e9a8",
                                                "text": "„Lernprogramme sind kompakte Veranstaltungen, die sich durch eine intensive Lerntätigkeit auszeichnen.“"
                                            },
                                            {
                                                "example_id": "8b79ddec-aa48-4647-8ed6-a0e567cd501a",
                                                "sense_id": "fa02e245-e0df-3a24-8596-55e20573e9a8",
                                                "text": "„Damit gelangen nicht nur neue Lernprogramme in die Klassenzimmer, sondern vor allem das Internet.“"
                                            },
                                            {
                                                "example_id": "c793772c-4c41-4b54-b58b-54dfc2219764",
                                                "sense_id": "fa02e245-e0df-3a24-8596-55e20573e9a8",
                                                "text": "„Die Lehrerin sagte, dass die zweite Fremdsprache jetzt schon in der dritten Klasse kommt, dass es hervorragende Lernprogramme für Mathematik am Computer gibt.“"
                                            },
                                            {
                                                "example_id": "e2ed9ae6-8ab4-47b8-92a9-7ec84616c9a7",
                                                "sense_id": "fa02e245-e0df-3a24-8596-55e20573e9a8",
                                                "text": "„Die steigende Nachfrage nach Wissen aus dem Web lockt zahlreiche Anbieter auf den Markt - dementsprechend unterschiedlich ist die Qualität der Lernprogramme.“"
                                            },
                                            {
                                                "example_id": "56a83960-3aaa-4009-85ed-e5d2fba825b5",
                                                "sense_id": "fa02e245-e0df-3a24-8596-55e20573e9a8",
                                                "text": "„Wer den Bachelorstudiengang in Freiburg beginnt, gestaltet später zum Beispiel Weiterbildungen oder Lernprogramme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
