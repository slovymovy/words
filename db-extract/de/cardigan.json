                "senses": [
                    {
                        "sense_id": "2169859c-d2e4-3bd9-844c-c1ebd78a5729",
                        "entry_id": "1ba4cfa0-2b40-3228-8655-307d42913128",
                        "glosses": [
                            "lange, kragenlose Strickweste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38a53d01-8882-4b87-8610-9b9e156d2568",
                                "sense_id": "2169859c-d2e4-3bd9-844c-c1ebd78a5729",
                                "text": "„Seine Frau Amy saß neben ihm und strickte, unbeirrt von den Tenue-Vorgaben des tropischen Klimas, einen Cardigan für ihren Ehemann.“"
                            },
                            {
                                "example_id": "186f6b51-452d-4217-936f-2dcedae94b35",
                                "sense_id": "2169859c-d2e4-3bd9-844c-c1ebd78a5729",
                                "text": "Als Kohl 1990 Michail Gorbatschow im Kaukasus traf, um die deutsche Einheit zu verhandeln, trug er einen dunklen Cardigan."
                            },
                            {
                                "example_id": "23e97e38-723a-45c1-bf82-ce7cbb7b631e",
                                "sense_id": "2169859c-d2e4-3bd9-844c-c1ebd78a5729",
                                "text": "Cut statt Cardigan, ausgelassene Bälle und steife Drinks statt verschämtem Feiern bei sanften Getränken, Selbstbewußtsein an Stelle von Selbstzweifeln – seit John F. Kennedy hat die Wachablösung im Weißen Haus nicht mehr solch symbolischen Charakter gehabt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f88cf191-7d0d-48f7-b5b6-c105fc1dc000",
                        "source_entry_id": "1ba4cfa0-2b40-3228-8655-307d42913128",
                        "source_sense_id": "2169859c-d2e4-3bd9-844c-c1ebd78a5729",
                        "source_sense_description": "lange, kragenlose Strickweste",
                        "target_lang_word": "cardigan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardigan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                                        "entry_id": "9acd5873-d88c-3f37-b99d-813c09df8647",
                                        "glosses": [
                                            "A type of sweater or jumper that fastens up the front with buttons or a zipper, usually machine- or hand-knitted from wool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79c0890e-ea6a-4d92-a1c5-642a1a291b9d",
                                                "sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                                                "text": "[…] a coarsely knit white cardigan and a black turban whose broadened tails could be arranged around her neck scarfwise."
                                            },
                                            {
                                                "example_id": "7e596213-42e0-4c68-8fef-09046b0499f5",
                                                "sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                                                "text": "“I love that loungewear has become a prevailing new category,” said Barbara Lippert, 65, a writer. “During the worst part of the pandemic even jeans seemed like an overreach, requiring that complex button and zipper action. And cardigans were too much work.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff4bf9fd-ac33-48ad-b2be-6a26711fefe7",
                        "source_entry_id": "1ba4cfa0-2b40-3228-8655-307d42913128",
                        "source_sense_id": "2169859c-d2e4-3bd9-844c-c1ebd78a5729",
                        "source_sense_description": "lange, kragenlose Strickweste",
                        "target_lang_word": "cardigan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardigan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                        "entry_id": "f1ccd7be-4075-378e-aa08-1b924b169bd1",
                                        "glosses": [
                                            "Veste tricotée, boutonnée par devant, sans col."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608c24a6-5d5c-4226-b283-8c617a72ebbf",
                                                "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                                "text": "Elle portait une jupe de tweed et un cardigan en shetland."
                                            },
                                            {
                                                "example_id": "352b0344-9273-45f5-853c-545c4db2377f",
                                                "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                                "text": "Le cardigan : impeccablement réalisé dans une matière raffinée, [74% acétate et 26% polyamide], fraîche, chatoyante, de belle tenue et facile à entretenir."
                                            },
                                            {
                                                "example_id": "6aa710e7-2b2e-4b24-b57b-3c911c90db34",
                                                "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                                "text": "Une jupe évasée, une crinoline si large que j'entrerai difficilement dans l'autobus et un petit cardigan tout mignon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
