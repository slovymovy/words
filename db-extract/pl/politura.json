                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Politur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7eef6f33-b211-3dc3-9c81-85775d4612cf",
                                        "entry_id": "ce06453c-6890-3394-8601-2248796a1694",
                                        "glosses": [
                                            "Mittel zum Polieren, zum Beispiel Schuhcreme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8acc0cb-ac82-46d1-8c75-22924e1f991f",
                                                "sense_id": "7eef6f33-b211-3dc3-9c81-85775d4612cf",
                                                "text": "Mit einer Politur für Möbel verschwinden Wasserflecken im Nu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ff58f5f-1d5e-3906-a17a-65b6956ba76f",
                                        "entry_id": "ce06453c-6890-3394-8601-2248796a1694",
                                        "glosses": [
                                            "besonders glatte, glänzende, strahlende Erscheinung (zum Beispiel einer Oberfläche, die durch Polieren entstanden ist; auch im übertragenen Sinn)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d376c98c-d47d-4112-9521-776a45f7215b",
                                                "sense_id": "5ff58f5f-1d5e-3906-a17a-65b6956ba76f",
                                                "text": "Aber der Begrüßung des Pontifex maximus durch den Líder máximo fehlte jede staatsmännische Politur."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4d08d689-8734-3483-b9d4-316730af7fa9",
                                        "entry_id": "ce06453c-6890-3394-8601-2248796a1694",
                                        "glosses": [
                                            "die Tätigkeit des Polierens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "124d96f3-c595-4606-b091-2dd9617a25e2",
                                                "sense_id": "4d08d689-8734-3483-b9d4-316730af7fa9",
                                                "text": "Manche Patienten meinen, die \"gründliche Politur aller Zahnflächen\" sei der krönende Abschluss […]."
                                            },
                                            {
                                                "example_id": "3e96b574-7ae8-40af-b1fd-c075fb13a261",
                                                "sense_id": "4d08d689-8734-3483-b9d4-316730af7fa9",
                                                "text": "[…] so hat die Erfahrung gelehrt, dass sie sich während der Politur um vieles schneller abnutzen, als durch das gewöhnliche Schleifen mit Wasser unter den Steinen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c36bb66-0807-4803-9e0c-b95ff73c3eeb",
                        "source_entry_id": "c5328f58-44c7-31d1-82f0-58760e8fdef7",
                        "source_sense_id": "a65cda20-cced-34f9-a093-d02ad5aa4d8f",
