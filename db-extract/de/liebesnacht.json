                "senses": [
                    {
                        "sense_id": "4dcb4ef6-4fb5-302a-a4bc-dc0d0f1efa25",
                        "entry_id": "f5d486e8-fa38-378a-8417-9f671ba84450",
                        "glosses": [
                            "Nacht, in der (zumeist) zwei Liebende miteinander Sex haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dab034a-b80e-47e1-ac5e-a0dae38eb547",
                                "sense_id": "4dcb4ef6-4fb5-302a-a4bc-dc0d0f1efa25",
                                "text": "„Die erste Liebesnacht läuft selten glatt: Für fast jeden zweiten Mann und 55 Prozent aller Frauen war der erste Sex ein Flop.“"
                            },
                            {
                                "example_id": "f2858169-971e-4ff3-b0b1-98541df64524",
                                "sense_id": "4dcb4ef6-4fb5-302a-a4bc-dc0d0f1efa25",
                                "text": "„Nein, hundert Frauen waren es nicht in den zehn Monaten, in denen mir keine einzige Liebesnacht gelang.“"
                            },
                            {
                                "example_id": "36ea9f41-7406-49d1-86e6-029c774a73fc",
                                "sense_id": "4dcb4ef6-4fb5-302a-a4bc-dc0d0f1efa25",
                                "text": "„Am übernächsten Abend nach der ersten Liebesnacht stellte sich die Nachbarin von gegenüber ein und bettelte – sie konnte es nicht lassen – unseren Jüngling um Gunst an.“"
                            },
                            {
                                "example_id": "936b2112-e007-4573-8ba0-ca66bf997045",
                                "sense_id": "4dcb4ef6-4fb5-302a-a4bc-dc0d0f1efa25",
                                "text": "Gleich in der ersten Liebesnacht mit ihrem neuen Freund wurde Tina schwanger."
                            },
                            {
                                "example_id": "f2353478-45dc-45e4-8a53-46ec4935b9de",
                                "sense_id": "4dcb4ef6-4fb5-302a-a4bc-dc0d0f1efa25",
                                "text": "Mit seiner Frau erlebte er einige heiße Liebesnächte am Ufer eines Sees."
                            },
                            {
                                "example_id": "280ddf29-c5a8-4298-a740-b9fbd353a7da",
                                "sense_id": "4dcb4ef6-4fb5-302a-a4bc-dc0d0f1efa25",
                                "text": "Dem Abend folgte eine wunderschöne Liebesnacht."
                            }
                        ],
