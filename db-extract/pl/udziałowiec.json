                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7144e95-7ac1-3640-87fd-6b4c09139098",
                                        "entry_id": "3c1f2f55-6fce-3b04-be7a-bdc1a92821d5",
                                        "glosses": [
                                            "Personne avec qui l'on partage son entreprise ou sa société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f447a14c-4d62-48f9-8d20-6b4d5cd1f6b8",
                                                "sense_id": "b7144e95-7ac1-3640-87fd-6b4c09139098",
                                                "text": "A côté des sociétés où l’associé-travailleur ne participait qu’aux bénéfices et non à la propriété même du capital social, il y en avait d'autres où l'apport de l’associé-capitaliste était fait en propriété."
                                            },
                                            {
                                                "example_id": "f0390614-c7dc-4c1a-9561-a0e50d6f8b53",
                                                "sense_id": "b7144e95-7ac1-3640-87fd-6b4c09139098",
                                                "text": "La Shell apporte aussi aux associés le précieux appui de sa flotte de tankers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2509cf75-b412-3ef2-9ac5-d5fcf970685f",
                                        "entry_id": "3c1f2f55-6fce-3b04-be7a-bdc1a92821d5",
                                        "glosses": [
                                            "Membres associés ou simplement associés désigne les membres d’une académie, de nationalité étrangère, qui jouissent de quelques-uns des droits des autres membres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "associé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28c1d56a-df03-3c03-a74f-dc894c1b06ca",
                                        "entry_id": "639cee0b-bdd1-32cc-9b56-7678a33e5ab0",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe associer."
