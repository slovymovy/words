                    {
                        "translation_id": "fdf49c53-f573-4689-b401-6c73c111e72a",
                        "source_entry_id": "45f5f5da-db39-3851-873e-02d7bc659c5d",
                        "source_sense_description": "condition of being flamboyant",
                        "target_lang_word": "Extravaganz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Extravaganz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2faeeef9-18ec-3939-835a-093aed9a8ada",
                                        "entry_id": "a4fd6faf-3ae4-31c4-beb8-d084633e1b18",
                                        "glosses": [
                                            "außergewöhnliche und meist übertriebene Sache oder Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc9ef594-352d-400c-95b1-f1e7430328e8",
                                                "sense_id": "2faeeef9-18ec-3939-835a-093aed9a8ada",
                                                "text": "„Der König wollte sich vor dem in Belgien weitverbreiteten Bewußtsein schützen, daß für ein kleines Land eine Kolonie eine kostspielige Extravaganz darstellte.“"
                                            },
                                            {
                                                "example_id": "89e11a54-8864-4cd6-b93f-1cb60b15ebd5",
                                                "sense_id": "2faeeef9-18ec-3939-835a-093aed9a8ada",
                                                "text": "„Wir konnten uns solche Extravaganzen nicht leisten.“"
                                            },
                                            {
                                                "example_id": "07b5986a-c956-41ae-a967-8a9e82326abb",
                                                "sense_id": "2faeeef9-18ec-3939-835a-093aed9a8ada",
                                                "text": "„Der gute Rittmeister Joachim von Prackwitz - er fand nur die Extravaganzen anderer Leute verdächtig, über die eigenen dachte er vollkommen wohlwollend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a05778c6-3b6c-36ef-8cf6-434b9e1ee77f",
                                        "entry_id": "a4fd6faf-3ae4-31c4-beb8-d084633e1b18",
                                        "glosses": [
                                            "außergewöhnliches, ausgefallenes Aussehen/Wesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd532cb-e648-4dda-823d-fbe3ba219aae",
                                                "sense_id": "a05778c6-3b6c-36ef-8cf6-434b9e1ee77f",
                                                "text": "„Der gute Rittmeister Joachim von Prackwitz - er fand nur die Extravaganzen anderer Leute verdächtig, über die eigenen dachte er vollkommen wohlwollend.“"
                                            },
                                            {
                                                "example_id": "d08826b1-e15f-46bc-8dc2-9a3cb3b51370",
                                                "sense_id": "a05778c6-3b6c-36ef-8cf6-434b9e1ee77f",
                                                "text": "„Sie war versucht, diese Höflichkeit zu durchbrechen, die polierte Oberfläche ihrer Sanftheit anzukratzen mit ihrer Extravaganz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b65e6ea9-ea33-42da-abd1-e869d1361de2",
                        "source_entry_id": "45f5f5da-db39-3851-873e-02d7bc659c5d",
