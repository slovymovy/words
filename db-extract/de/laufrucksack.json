                ],
                "senses": [
                    {
                        "sense_id": "1248f3d3-d718-37f1-acbb-8f67d78f8d04",
                        "entry_id": "2b2580e5-7638-3cbe-a647-79749d07a606",
                        "glosses": [
                            "Rucksack, der speziell für das Laufen entwickelt wurde, um Wasser, Verpflegung und andere Ausrüstung komfortabel und körpernah mitzuführen"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "2d64e9fe-2e3c-4926-b5ab-20ea97435b96",
                                "sense_id": "1248f3d3-d718-37f1-acbb-8f67d78f8d04",
                                "text": "„Beim Kauf von Laufrucksäcken ist der Sitz entscheidend.“"
                            },
                            {
                                "example_id": "b5f881d2-90c8-4876-87b1-64ec4cee2d94",
                                "sense_id": "1248f3d3-d718-37f1-acbb-8f67d78f8d04",
                                "text": "„Für den erfahrenen Ultratrailrunner für Distanzen jenseits der 60 km war der Laufrucksack schnell gepackt und am Donnerstag um 21 Uhr begann am Fuße des Nebelhorns der Lauf über die Alpen.“"
                            },
                            {
                                "example_id": "d81d2d02-d16f-439e-942d-8c21f1e0c291",
                                "sense_id": "1248f3d3-d718-37f1-acbb-8f67d78f8d04",
                                "text": "„Auch nach mehrfachem Einsatz der Jacke mit Laufrucksack sind bisher an den üblichen Stellen keine Abriebspuren zu entdecken.“"
                            },
                            {
                                "example_id": "7d4c64c2-4ef9-48de-8ea3-9d943eb7c2f8",
                                "sense_id": "1248f3d3-d718-37f1-acbb-8f67d78f8d04",
                                "text": "„Irgendwann wurde ich es leid und zog die Bikeschuhe aus und die Laufschuhe aus dem Rucksack an (ach ja, ich vergaß zu erwähnen, in dem coolen Laufrucksack von Ferrino gesponsert musste so einiges mit: die Laufschuhe, Klettergurt und ein wasserdichter Behälter für den Fotoapparat).“"
                            },
                            {
                                "example_id": "a0d279d2-d849-478a-a054-57dba4b55488",
                                "sense_id": "1248f3d3-d718-37f1-acbb-8f67d78f8d04",
                                "text": "„Natürlich wollen wir alle einen coolen Laufrucksack haben aber der ist zum einen teuer und für den Anfang tatsächlich nicht notwendig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
