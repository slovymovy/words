                                        "sense_id": "eed5ce50-99a1-3bc3-99cd-483bffa4acf8",
                                        "entry_id": "7940ea5b-c7c4-382d-9e65-3066a9a30b1e",
                                        "glosses": [
                                            "Any of several battles fought near this city during the First World War."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d86a9b45-75d5-4c4d-b979-29d470c14fd4",
                        "source_entry_id": "5420d38e-16af-3e7b-980a-b1c36a4e4384",
