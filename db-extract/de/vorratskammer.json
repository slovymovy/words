                ],
                "senses": [
                    {
                        "sense_id": "5552a9d9-3509-340c-982f-0054094f7a3d",
                        "entry_id": "db212a4d-7a34-30da-ab0a-d991e9989880",
                        "glosses": [
                            "Raum oder Aufbewahrungsort, an dem Vorräte gelagert werden, speziell Nahrungsmittelvorräte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7d300f6-a52f-48bb-853a-3c1ff6342c21",
                                "sense_id": "5552a9d9-3509-340c-982f-0054094f7a3d",
                                "text": "In der Vorratskammer haben wir noch zwei Packungen Mehl und zwölf Dosen Mais."
                            },
                            {
                                "example_id": "d0730665-f30b-4c99-8bcb-e2af4f2ff9df",
                                "sense_id": "5552a9d9-3509-340c-982f-0054094f7a3d",
                                "text": "Was nicht in den Kühlschrank muss, lagern wir in der Vorratskammer, die gleich neben der Küche liegt."
                            },
                            {
                                "example_id": "fd2a7428-7a8c-4a02-9296-629833f53d98",
                                "sense_id": "5552a9d9-3509-340c-982f-0054094f7a3d",
                                "text": "„Allein die Vorratskammer war größer als alle Zimmer in allen Häusern, die Val jemals bewohnt hatte.“"
                            },
                            {
                                "example_id": "323e7643-7a13-42bf-a1ec-81b23810e272",
                                "sense_id": "5552a9d9-3509-340c-982f-0054094f7a3d",
                                "text": "„Die Schöne Frau sah eher unglücklich als verängstigt aus, als sie Buster in die Vorratskammer führte und die Tür zumachte.“"
                            },
                            {
                                "example_id": "e799d2b5-8f8a-40a4-bb30-539fa1bfcfbc",
                                "sense_id": "5552a9d9-3509-340c-982f-0054094f7a3d",
                                "text": "„Die Vorrratskammer war gleich neben der Küche, und sie wollte sich darin verkriechen, doch da standen die beiden schon vor ihr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
