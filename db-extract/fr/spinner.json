                                "example_id": "878e786d-4759-498f-acb6-e6fe54e1537f",
                                "sense_id": "edc2406d-2372-37b7-8cdb-8cf4d883bf95",
                                "text": "C’est la glace, les chars ostie, y a rien qui marche tabarnak, ça fait une heure que j’avance pis que je r’cule, viarge, pis j’reste pogné là comme un cave à m’faire niaiser par un crisse de bazou à marde qui spinne dans l’beurre comme un innocent…"
                            },
                            {
                                "example_id": "53df31a1-8585-4f30-b0f4-67b4ae5d72cc",
                                "sense_id": "edc2406d-2372-37b7-8cdb-8cf4d883bf95",
                                "text": "Prunelle ? répète-t-elle pendant que les pneus spinnent dans le vide."
                            },
                            {
                                "example_id": "6311cf73-ec4f-4173-96f3-80aeea58b065",
                                "sense_id": "edc2406d-2372-37b7-8cdb-8cf4d883bf95",
                                "text": "Autrement dit, une élection, ça compte: des partis montent, descendent, spinnent!"
                            }
                        ]
