                ],
                "translations": [
                    {
                        "translation_id": "ccb7bbe7-ba0f-439c-8d3d-da4bc0e20825",
                        "source_entry_id": "ae4e5af6-c63a-3ffe-b286-93b4f456da69",
                        "source_sense_id": "f648c68d-ddee-3b2a-ae47-4ebc5d043d3d",
                        "source_sense_description": "kriebel",
                        "target_lang_word": "Juckreiz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Juckreiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff724a7b-d433-367b-a71a-ccc3784cfb8f",
                                        "entry_id": "a7bc4096-3551-346c-ab8c-f3a95bf084dc",
                                        "glosses": [
                                            "unangenehmer Hautreiz, der zum Kratzen der betroffenen Stelle veranlasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "781ab532-bca3-4ac2-b376-76b3ac7e5d8c",
                                                "sense_id": "ff724a7b-d433-367b-a71a-ccc3784cfb8f",
                                                "text": "„Der Speichel ist es, der den anschließenden Juckreiz verursacht.“"
                                            },
                                            {
                                                "example_id": "09525141-cd4b-4ba2-a0aa-37db8d16f1b6",
                                                "sense_id": "ff724a7b-d433-367b-a71a-ccc3784cfb8f",
                                                "text": "„Louise muss ihre Arme und ihr Gesicht unter eiskaltes Wasser halten, um den Juckreiz zu lindern, der sie auffrisst.“"
                                            },
                                            {
                                                "example_id": "2a29a8bd-f4fa-4b71-bf93-1c2e22cae809",
                                                "sense_id": "ff724a7b-d433-367b-a71a-ccc3784cfb8f",
                                                "text": "„Leider Gottes zieht man sich dort, ob durch die Luft, ob durch das Wasser oder den Wein, einen leichten Ausschlag zu, was den Bolognesern das Vergnügen verschafft, sich zu kratzen; das ist nicht so nebensächlich, wie man denkt, wenn der Juckreiz nur leicht ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a74f385-931a-4ff0-856b-df4e5f7d5c9a",
                        "source_entry_id": "ae4e5af6-c63a-3ffe-b286-93b4f456da69",
                        "source_sense_id": "f648c68d-ddee-3b2a-ae47-4ebc5d043d3d",
                        "source_sense_description": "kriebel",
                        "target_lang_word": "itch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "itch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db63c936-1cf2-373f-a436-e7a88ed08587",
                                        "entry_id": "7503958a-b9e3-33bf-9925-4e5aac5b1b15",
                                        "glosses": [
                                            "A sensation felt on an area of the skin that causes a person or animal to want to scratch said area."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a5c4c8c-776f-384a-848a-39fa9b108e47",
                                        "entry_id": "7503958a-b9e3-33bf-9925-4e5aac5b1b15",
                                        "glosses": [
                                            "A constant teasing desire or want."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b788841-e114-4d7d-b861-566ec146d218",
                                                "sense_id": "9a5c4c8c-776f-384a-848a-39fa9b108e47",
                                                "text": "... it left, however, a bee at his ear and an itch to transfer the buzzer's attentions and tease his darling; for she had betrayed herself as right good game."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "itch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0962e801-ec36-3fde-8a12-3c6724d93b12",
                                        "entry_id": "48f158ab-45f4-32cd-9072-cc7143eea0da",
                                        "glosses": [
                                            "To feel itchy; to feel a need to be scratched."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "stative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "faac0152-9a3e-3104-a865-bd688a78d3b8",
                                        "entry_id": "48f158ab-45f4-32cd-9072-cc7143eea0da",
                                        "glosses": [
                                            "To have a constant, teasing urge; to feel strongly motivated; to want or desire something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0b79d83-20c8-4aec-9ecb-79ce0eeeb17e",
                                                "sense_id": "faac0152-9a3e-3104-a865-bd688a78d3b8",
                                                "text": "He started learning to drive and he has been itching for opportunities to practice ever since."
                                            },
                                            {
                                                "example_id": "518dab05-bbd1-4136-b845-8246542575ea",
                                                "sense_id": "faac0152-9a3e-3104-a865-bd688a78d3b8",
                                                "text": "Capulet: ... Speak not, reply not, do not answer me; / My fingers itch. Wife, we scarce thought us blest / That God had lent us but this only child; / But now I see this one is one too much, / And that we have a curse in having her: / Out on her, hilding!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae4f8c5-9e9d-38d3-969b-f6608d041789",
                                        "entry_id": "48f158ab-45f4-32cd-9072-cc7143eea0da",
                                        "glosses": [
                                            "To cause to feel an itch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8ba4368-c1cf-4c50-a2a3-b1426ac22af8",
                                                "sense_id": "cae4f8c5-9e9d-38d3-969b-f6608d041789",
                                                "text": "My head is suddenly itching me like mad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                        "entry_id": "48f158ab-45f4-32cd-9072-cc7143eea0da",
                                        "glosses": [
                                            "To scratch or rub so as to relieve an itch."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b05b042-7376-429b-8b31-903b790312a1",
                                                "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                                "text": "\"What makes you suspect him?\" Max asked as he itched his neck."
                                            },
                                            {
                                                "example_id": "d192092b-8b94-4f62-81cf-07b7fa07cde8",
                                                "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                                "text": "I have to take both shoes and socks off! If I go bare foot I'm ok! I also get itching on my r/palm of my hand. I itch it so much that it's raw!"
                                            },
                                            {
                                                "example_id": "c394523b-e5c5-4db3-9e99-948b588ee2c8",
                                                "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                                "text": "Basically I go through a half hour of trying to figure out of it is an fake OCD itch or a regular itch before I itch it (if I determine it's a \"fake\" itch, then I try not to itch it)."
                                            },
                                            {
                                                "example_id": "d6f8bee7-b394-4012-99dd-5fc53b9f4c09",
                                                "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                                "text": "Ulysses thumped his side and itched his back side, then slipped into his car."
                                            },
                                            {
                                                "example_id": "a06c9f57-33d6-425b-88a5-b88bf7abe835",
                                                "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                                "text": "But when we asked more about the famous man whose specter still commanded the heights, the guard just sneered at me, pointed his gun back toward the road with one hand, and itched his chin with the other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
