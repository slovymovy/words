                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stood <w>apart</w> from the crowd, watching the parade in silence.",
                            "target_lang_translations": {
                                "ru": "Она стояла <w>в стороне</w> от толпы, молча наблюдая за парадом.",
                                "pl": "Stała <w>na uboczu</w> od tłumu, w milczeniu przyglądając się paradzie.",
                                "tr": "Geçit törenini sessizce izleyerek kalabalıktan <w>uzakta</w> durdu."
                            }
                        },
                        {
                            "text": "He set <w>apart</w> some money every month for his future travels.",
