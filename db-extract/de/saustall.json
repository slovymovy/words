                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc3faee6-cc41-41c4-9695-3c5891481004",
                                "sense_id": "2587a3ad-1abd-32d9-bf66-7fd463bd1e33",
                                "text": "„Wenn ein Schwein beschrien ist, soll man die Blätter von einer alten Karten inwendig hin und her im Saustall anzwecken, so wird es mit ihr besser.“ (1759)"
                            }
                        ],
