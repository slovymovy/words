                        "examples": [
                            {
                                "example_id": "2228aaf8-69f5-4479-a70a-27ce478d74c2",
                                "sense_id": "339da08d-1bc6-35a9-8ab6-8ba77de239ff",
                                "text": "— Podstawą języka łacińskiego — ciągnie Izdebski — są deklinacje i koniugacje. Bez Korneliusza, Owidiusza, Wergiliusza możesz zostać choćby biskupem — ale jeśli nie znasz deklinacyjki i koniugacyjki, nie będziesz nawet dobrym… / — Organistą! — kończy[ł] któryś z chłopców, na pamięć już znający tę przemowę, przez wszystkie klasy nieustannie powtarzaną."
                            }
                        ],
