                "senses": [
                    {
                        "sense_id": "ca88e8fa-70e9-31a5-9321-e9b88b91b898",
                        "entry_id": "6c7c6f40-96da-39bc-96cc-714593b61745",
                        "glosses": [
                            "Anhängerin des Kommunismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97c07e90-1f75-442d-9e23-12c8d81e2d24",
                                "sense_id": "ca88e8fa-70e9-31a5-9321-e9b88b91b898",
                                "text": "„Am 28. Oktober [2015] wurde mit der Kommunistin und Frauenrechtlerin Bidhya Devis Bhandari erstmals eine Frau zur Präsidentin Nepals gewählt.“"
                            },
                            {
                                "example_id": "8686108d-2d40-4e7f-adfe-9a9e7b05b1b3",
                                "sense_id": "ca88e8fa-70e9-31a5-9321-e9b88b91b898",
                                "text": "„Sie, die Kommunistin, die wortgewaltige Verfechterin des Materialismus, lief mit einem Schutzzauber durch die Gegend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
