                                    },
                                    {
                                        "sense_id": "f4555ef8-e441-361e-8504-2f83dd6ae2be",
                                        "entry_id": "f6fbc730-ee8c-3fb0-8e90-e72d220fbc2b",
                                        "glosses": [
                                            "A relative."
