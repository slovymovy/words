{
    "word_family": [
        "flicker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5081539-5e81-3838-a8c1-fc6b949c81f6",
                    "sense_definition": "A short, quick movement, especially a brush, sweep, or flip.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He removed the speck of dust with a <w>flick</w> of his finger.",
                            "target_lang_translations": {
                                "zh": "他用手指<w>弹</w>掉了那粒灰尘。",
                                "cs": "Odstranil smítko prachu <w>cvrnknutím</w> prstu.",
                                "de": "Er entfernte das Staubkorn mit einem <w>Schnipser</w> seines Fingers."
                            }
                        },
                        {
                            "text": "She gave a disdainful <w>flick</w> of her hair and marched out of the room.",
                            "target_lang_translations": {
                                "zh": "她轻蔑地<w>甩</w>了甩头发，大步走出了房间。",
                                "cs": "Pohrdavě <w>švihla</w> vlasy a vykročila z místnosti.",
                                "de": "Sie warf ihr Haar mit einem verächtlichen <w>Schwung</w> zurück und marschierte aus dem Zimmer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flick of the finger",
                        "flick of the wrist"
                    ],
                    "target_lang_definitions": {
                        "zh": "指轻快、迅速的动作，尤指拂、扫或弹的动作。",
                        "cs": "Krátký, rychlý pohyb, zejména švihnutí, smýknutí nebo cvrnknutí.",
                        "de": "Eine kurze, schnelle Bewegung, insbesondere ein Schnipsen, leichtes Schlagen oder Wischen."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻弹",
                                "target_lang_sense_clarification": "指用手指快速弹开某物。"
                            },
                            {
                                "target_lang_word": "拂",
                                "target_lang_sense_clarification": "指轻轻扫过或掸去。"
                            },
                            {
                                "target_lang_word": "弹",
                                "target_lang_sense_clarification": "用手指快速击打"
                            },
                            {
                                "target_lang_word": "甩",
                                "target_lang_sense_clarification": "快速摆动一下"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "cvrnknutí",
                                "target_lang_sense_clarification": "pohyb prstem při odražení něčeho"
                            },
                            {
                                "target_lang_word": "švihnutí",
                                "target_lang_sense_clarification": "rychlý pohyb švihem"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schnipser",
                                "target_lang_sense_clarification": "kurze Bewegung mit dem Finger"
                            },
                            {
                                "target_lang_word": "Schwung",
                                "target_lang_sense_clarification": "schnelle Bewegung, z. B. der Haare"
                            },
                            {
                                "target_lang_word": "Flick",
                                "target_lang_sense_clarification": "schnelle, ruckartige Bewegung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e698de1-645d-36a1-86cf-d51403fc7d8e",
                    "sense_definition": "A motion picture, movie, or film; in plural, the cinema.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My all-time favorite <w>flick</w> is Gone with the Wind.",
                            "target_lang_translations": {
                                "zh": "我最喜欢的<w>电影</w>是《乱世佳人》。",
                                "cs": "Můj nejoblíbenější <w>film</w> všech dob je Jih proti Severu.",
                                "de": "Mein absoluter <w>Lieblingsfilm</w> ist Vom Winde verweht."
                            }
                        },
                        {
                            "text": "Want to go to the <w>flicks</w> tonight?",
                            "target_lang_translations": {
                                "zh": "今晚想去看<w>电影</w>吗？",
                                "cs": "Chceš jít dnes večer do <w>kina</w>?",
                                "de": "Willst du heute Abend ins <w>Kino</w> gehen?"
                            }
                        }
                    ],
                    "synonyms": [
                        "the picture"
                    ],
                    "common_phrases": [
                        "go to the flicks"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a movie."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "电影；复数形式指电影院。",
                        "cs": "Filmové dílo nebo kino (hovorově).",
                        "de": "Umgangssprachlich für ein Film; im Plural das Kino."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "电影",
                                "target_lang_sense_clarification": "指电影作品。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "film",
                                "target_lang_sense_clarification": "filmové dílo"
                            },
                            {
                                "target_lang_word": "kino",
                                "target_lang_sense_clarification": "místo, kde se promítají filmy"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Film",
                                "target_lang_sense_clarification": "Spielfilm"
                            },
                            {
                                "target_lang_word": "Streifen",
                                "target_lang_sense_clarification": "umgangssprachlich für Film"
                            },
                            {
                                "target_lang_word": "Kino",
                                "target_lang_sense_clarification": "im Plural (the flicks)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68fe37b9-4e0b-337f-b3d6-55180db0af0f",
                    "sense_definition": "A photograph.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was taking some <w>flicks</w> of the parade when someone asked if I would like to take a picture of him.",
                            "target_lang_translations": {
                                "zh": "我正在拍游行的<w>照片</w>时，有人问我愿不愿意给他拍一张。",
                                "cs": "Dělal jsem <w>fotky</w> průvodu, když se mě někdo zeptal, jestli bych ho nevyfotil.",
                                "de": "Ich machte gerade ein paar <w>Fotos</w> von der Parade, als mich jemand fragte, ob ich ein Bild von ihm machen wolle."
                            }
                        },
                        {
                            "text": "She showed me a few <w>flicks</w> from her summer vacation.",
                            "target_lang_translations": {
                                "zh": "她给我看了几张她暑假拍的<w>照片</w>。",
                                "cs": "Ukázala mi pár <w>fotek</w> z letní dovolené.",
                                "de": "Sie zeigte mir ein paar <w>Fotos</w> aus ihrem Sommerurlaub."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a photo."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "照片。",
                        "cs": "Fotografie (hovorově).",
                        "de": "Umgangssprachlich für ein Foto."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "照片",
                                "target_lang_sense_clarification": "指拍摄的影像。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "fotka",
                                "target_lang_sense_clarification": "hovorové označení pro fotografii"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Foto",
                                "target_lang_sense_clarification": "Fotografie"
                            },
                            {
                                "target_lang_word": "Schnappschuss",
                                "target_lang_sense_clarification": "schnelles Foto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27b5f2f5-e9f9-332e-acc2-1690f8a9e570",
                    "sense_definition": "A person or fellow, often used as a friendly term of address.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All that I have, dear old <w>flick</w>, is yours for the asking.",
                            "target_lang_translations": {
                                "zh": "我亲爱的老<w>伙计</w>，我所有的一切，只要你开口，就都是你的。",
                                "cs": "Všechno, co mám, můj drahý <w>kámoši</w>, je tvé, stačí si říct.",
                                "de": "Alles, was ich habe, mein lieber alter <w>Kumpel</w>, gehört dir, wenn du nur fragst."
                            }
                        },
                        {
                            "text": "He is a decent <w>flick</w> who always helps his neighbors.",
                            "target_lang_translations": {
                                "zh": "他是个正派的<w>家伙</w>，总是乐于帮助邻居。",
                                "cs": "Je to slušný <w>chlapík</w>, který vždy pomůže svým sousedům.",
                                "de": "Er ist ein anständiger <w>Kerl</w>, der seinen Nachbarn immer hilft."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Old-fashioned informal address."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指人或伙伴，常用于友好的称呼。",
                        "cs": "Osoba nebo kamarád, často používané jako přátelské oslovení.",
                        "de": "Veraltet und umgangssprachlich für eine Person, Freund oder Kerl."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "伙计",
                                "target_lang_sense_clarification": "对熟人的亲切称呼"
                            },
                            {
                                "target_lang_word": "家伙",
                                "target_lang_sense_clarification": "指某个人，口语"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chlapík",
                                "target_lang_sense_clarification": "neformální označení pro muže"
                            },
                            {
                                "target_lang_word": "kámoš",
                                "target_lang_sense_clarification": "přátelské oslovení"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kumpel",
                                "target_lang_sense_clarification": "Freund, Kamerad"
                            },
                            {
                                "target_lang_word": "Kerl",
                                "target_lang_sense_clarification": "Typ, Typus"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a848ecd-ef81-3928-a398-a418c9b7044d",
                    "sense_definition": "To move or hit something with a short, quick motion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to <w>flick</w> snow away from her mouth.",
                            "target_lang_translations": {
                                "zh": "她试图把嘴边的雪<w>拂</w>掉。",
                                "cs": "Snažila se <w>odmrštit</w> sníh od úst.",
                                "de": "Sie versuchte, den Schnee von ihrem Mund <w>wegzuwischen</w>."
                            }
                        },
                        {
                            "text": "He used his finger to <w>flick</w> the dirt from his boots.",
                            "target_lang_translations": {
                                "zh": "他用手指<w>弹</w>掉靴子上的泥土。",
                                "cs": "Použil prst, aby <w>cvrnknutím</w> odstranil špínu z bot.",
                                "de": "Er benutzte seinen Finger, um den Schmutz von seinen Stiefeln <w>wegzuschnipsen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flick away"
                    ],
                    "target_lang_definitions": {
                        "zh": "用轻快、迅速的动作移动或击打某物。",
                        "cs": "Pohybovat nebo udeřit do něčeho krátkým, rychlým pohybem.",
                        "de": "Etwas mit einer kurzen, schnellen Bewegung bewegen, schnipsen oder wegwischen."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弹",
                                "target_lang_sense_clarification": "用手指快速拨动或击打。"
                            },
                            {
                                "target_lang_word": "拂去",
                                "target_lang_sense_clarification": "快速扫除。"
                            },
                            {
                                "target_lang_word": "拂",
                                "target_lang_sense_clarification": "轻轻扫过"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "cvrnknout",
                                "target_lang_sense_clarification": "udeřit prstem"
                            },
                            {
                                "target_lang_word": "odmrštit",
                                "target_lang_sense_clarification": "rychlým pohybem odstranit"
                            },
                            {
                                "target_lang_word": "švihnout",
                                "target_lang_sense_clarification": "rychle pohnout"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schnipsen",
                                "target_lang_sense_clarification": "mit dem Finger wegstoßen oder schleudern"
                            },
                            {
                                "target_lang_word": "wischen",
                                "target_lang_sense_clarification": "mit einer raschen Handbewegung entfernen"
                            },
                            {
                                "target_lang_word": "schnellen",
                                "target_lang_sense_clarification": "mit Schwung bewegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f82c50b-0740-37f0-88ae-db2be62390aa",
                    "sense_definition": "To pass by rapidly, so as not to be perceived clearly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were quiet for a time, watching the fields and lanes <w>flick</w> past.",
                            "target_lang_translations": {
                                "zh": "他们沉默了一会儿，看着田野和巷道从窗外<w>掠过</w>。",
                                "cs": "Chvíli mlčeli a dívali se, jak pole a cesty <w>mihají</w> kolem.",
                                "de": "Sie waren eine Zeit lang still und sahen zu, wie die Felder und Wege <w>vorbeihuschten</w>."
                            }
                        },
                        {
                            "text": "The shadows seemed to <w>flick</w> past the window as the train accelerated.",
                            "target_lang_translations": {
                                "zh": "随着火车加速，影子似乎从窗前<w>掠过</w>。",
                                "cs": "Stíny se zdály <w>mihat</w> kolem okna, jak vlak zrychloval.",
                                "de": "Die Schatten schienen am Fenster <w>vorbeizuhuschen</w>, als der Zug beschleunigte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flick past"
                    ],
                    "target_lang_definitions": {
                        "zh": "迅速掠过，使人无法看清。",
                        "cs": "Rychle kolem něčeho projet nebo proletět, tak aby to nebylo jasně patrné.",
                        "de": "Sehr schnell an etwas vorbeiziehen oder vorbeihuschen."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "掠过",
                                "target_lang_sense_clarification": "指快速经过。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "mihnout se",
                                "target_lang_sense_clarification": "rychle se objevit a zmizet"
                            },
                            {
                                "target_lang_word": "prosvištět",
                                "target_lang_sense_clarification": "velmi rychle projet"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "vorbeihuschen",
                                "target_lang_sense_clarification": "schnell und kaum wahrnehmbar vorbeiziehen"
                            },
                            {
                                "target_lang_word": "vorbeiziehen",
                                "target_lang_sense_clarification": "rasch vorübergehen"
                            },
                            {
                                "target_lang_word": "flitzen",
                                "target_lang_sense_clarification": "sich sehr schnell bewegen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fb84c2f9-21d8-3b9a-ab99-c6395d7a3d6b",
                    "sense_definition": "A diminutive of the female given name Felicia.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Felicia Jane <w>Flick</w> Beatrix Drummond is a British politician.",
                            "target_lang_translations": {
                                "zh": "费利西亚·简·<w>弗利克</w>·比阿特丽克斯·德拉蒙德是一位英国政治家。",
                                "cs": "Felicia Jane <w>Flick</w> Beatrix Drummond je britská politička.",
                                "de": "Felicia Jane <w>Flick</w> Beatrix Drummond ist eine britische Politikerin."
                            }
                        },
                        {
                            "text": "Everyone calls her <w>Flick</w> instead of Felicia.",
                            "target_lang_translations": {
                                "zh": "大家都叫她<w>弗利克</w>，而不叫费利西亚。",
                                "cs": "Všichni jí říkají <w>Flick</w> místo Felicia.",
                                "de": "Alle nennen sie <w>Flick</w> statt Felicia."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a nickname."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "女性名字 Felicia 的昵称。",
                        "cs": "Domácká podoba ženského jména Felicia.",
                        "de": "Eine Koseform des weiblichen Vornamens Felicia."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弗利克",
                                "target_lang_sense_clarification": "音译名。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "Flick",
                                "target_lang_sense_clarification": "přezdívka nebo domácké jméno"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Flick",
                                "target_lang_sense_clarification": "Kosename"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}