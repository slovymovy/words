                                "example_id": "b6e946bb-3c1f-4468-b7d9-6ba04db514c3",
                                "sense_id": "e5ea8dea-4f3a-3e57-910c-ab604b2f5b32",
                                "text": "Martin Luther lehnte die Lehre von der Supererogation ab."
                            }
                        ],
