                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f24217b-7dd8-4802-b0d5-f675e0006827",
                                "sense_id": "ca2b3fb4-7ef1-37b0-bc51-a704df52cb89",
                                "text": "Hij had schik in die ondeugd van een kleinzoon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43f07664-b953-4966-80a8-66205a11b064",
                        "source_entry_id": "098798a3-963d-34bf-8ac7-16ff9df2c4aa",
                        "source_sense_id": "ca2b3fb4-7ef1-37b0-bc51-a704df52cb89",
                        "source_sense_description": "pret",
                        "target_lang_word": "fun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68ae3bc5-6e69-308b-9e7b-4e3ddf86f710",
                                        "entry_id": "851bad82-a61b-3f65-b04a-b1695d0fa9bd",
                                        "glosses": [
                                            "Amusement, enjoyment or pleasure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51af23d1-fb91-4045-9fed-ecf495ddb9fa",
                                                "sense_id": "68ae3bc5-6e69-308b-9e7b-4e3ddf86f710",
                                                "text": "Grafting your boss's face onto the hind end of a donkey is fun, but serious fun is when you create the impossible and it looks real."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86fa3b75-83a4-34cc-ae0b-ec06da34531f",
                                        "entry_id": "851bad82-a61b-3f65-b04a-b1695d0fa9bd",
                                        "glosses": [
                                            "Playful, often noisy, activity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a33b27f-056d-3edd-a4b5-bdea04e50122",
                                        "entry_id": "c9f3a148-18f9-3433-9245-24d74695947f",
                                        "glosses": [
                                            "Enjoyable or amusing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4f18e25-66ee-41ed-82a2-af7bf2af1b83",
                                                "sense_id": "0a33b27f-056d-3edd-a4b5-bdea04e50122",
                                                "text": "We had a fun time at the party."
                                            },
                                            {
                                                "example_id": "863f7060-c0e8-49c9-8cc1-48b23e08add3",
                                                "sense_id": "0a33b27f-056d-3edd-a4b5-bdea04e50122",
                                                "text": "He is such a fun person to be with."
                                            },
                                            {
                                                "example_id": "c881d7e4-fc7d-462d-bb4c-cd5e978cc03e",
                                                "sense_id": "0a33b27f-056d-3edd-a4b5-bdea04e50122",
                                                "text": "He's the liberated character that everyone wants to be, so he was very fun to play"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9256db4-f4b3-3548-b25b-beee3d80a6e8",
                                        "entry_id": "c9f3a148-18f9-3433-9245-24d74695947f",
                                        "glosses": [
                                            "Whimsical or flamboyant."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49750750-fdf8-4fd3-9f87-b79a2252d5cf",
                                                "sense_id": "c9256db4-f4b3-3548-b25b-beee3d80a6e8",
                                                "text": "This year's fashion style is much more fun than recent seasons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "551c5dbd-8a82-3a9a-a0ab-53ab95f35570",
                                        "entry_id": "2175aa30-2c32-30b0-a977-0f60c77ab57e",
                                        "glosses": [
                                            "To tease, kid, poke fun at, make fun of."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5813e69-8f18-4ad3-8fcf-fe9f0b8d3457",
                                                "sense_id": "551c5dbd-8a82-3a9a-a0ab-53ab95f35570",
                                                "text": "Hey, don't get bent out of shape over it; I was just funning you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fef33af5-102d-4daa-b535-467fcdcc8386",
                        "source_entry_id": "098798a3-963d-34bf-8ac7-16ff9df2c4aa",
                        "source_sense_id": "ca2b3fb4-7ef1-37b0-bc51-a704df52cb89",
                        "source_sense_description": "pret",
                        "target_lang_word": "amusement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amusement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                        "entry_id": "e1bca45e-7d33-3ee3-b6f5-743a380f7c24",
                                        "glosses": [
                                            "Entertainment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "247c70fa-286d-4bef-bebb-e0e7702ea5d2",
                                                "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                                "text": "To my great amusement, the dog kept on chasing its tail and yelped when it bit it."
                                            },
                                            {
                                                "example_id": "0e737311-22aa-422b-bf9b-65a918b4bb94",
                                                "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                                "text": "This is some form of amusement you're talking about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                        "entry_id": "e1bca45e-7d33-3ee3-b6f5-743a380f7c24",
                                        "glosses": [
                                            "An activity that is entertaining or amusing, such as dancing, gunning, or fishing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5d70d6-fdd6-425e-afd2-45ab4bad3bd4",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "\"What a charming amusement for young people this is, Mr. Darcy! There is nothing like dancing after all. I consider it as one of the first refinements of polished society.\""
                                            },
                                            {
                                                "example_id": "0bdd7367-bdd2-498d-9848-56ca96262f11",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "His chief amusements were gunning and fishing, or sauntering along the beach and through the myrtles, in quest of shells or entomological specimens--his collection of the latter might have been envied by a Swammerdamm."
                                            },
                                            {
                                                "example_id": "7013f761-b22d-467a-bb84-05d69a48f281",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "The Cat was sour-tempered and grumpy, at first, but before they had journeyed far, the crystal creature had discovered a fine amusement. The long tails of the monkeys were constantly sticking through the bars of their cage, and when they did, the Glass Cat would slyly seize the tails in her paws and pull them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
