                ],
                "senses": [
                    {
                        "sense_id": "a8829075-447b-38d5-96da-f7057f72b974",
                        "entry_id": "b90a8571-cc2f-31e4-8275-1a5ddfd5766a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55a59dcd-a3bc-4fac-80f1-46e1147722a7",
                                "sense_id": "a8829075-447b-38d5-96da-f7057f72b974",
                                "text": "Frau Grüble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "afcabce3-fb28-4098-8207-32b020380d67",
                                "sense_id": "a8829075-447b-38d5-96da-f7057f72b974",
                                "text": "Herr Grüble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "27d910f6-da32-40dc-808a-f8badfbc97e6",
                                "sense_id": "a8829075-447b-38d5-96da-f7057f72b974",
                                "text": "Die Grübles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "541d8b09-4b6e-43bd-a8db-6cb1b0b775a9",
                                "sense_id": "a8829075-447b-38d5-96da-f7057f72b974",
                                "text": "Der Grüble trägt nie die Pullover, die die Grüble ihm strickt."
                            },
                            {
                                "example_id": "742c75cd-d0fe-4ced-8367-5183d9e73c1d",
                                "sense_id": "a8829075-447b-38d5-96da-f7057f72b974",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Grüble kommt, geht der Herr Grüble.“"
                            },
                            {
                                "example_id": "2625cb6c-efad-4ae9-b9dc-c2c1fb76438d",
                                "sense_id": "a8829075-447b-38d5-96da-f7057f72b974",
                                "text": "Grüble kommt und geht."
                            },
                            {
                                "example_id": "6e8e6edb-7447-4ed2-8968-a17e520d666c",
                                "sense_id": "a8829075-447b-38d5-96da-f7057f72b974",
                                "text": "Grübles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
