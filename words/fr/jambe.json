                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est cassé la <w>jambe</w> en faisant du ski le week-end dernier."
                        },
                        {
                            "text": "Elle a marché toute la journée et a maintenant mal aux <w>jambes</w>."
                        }
                    ],
                    "synonyms": [
                        "gambette",
                        "guibole"
                    ],
                    "common_phrases": [
