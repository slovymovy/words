                                "target_senses": [
                                    {
                                        "sense_id": "1f8b6ed3-2a66-3903-8d7a-cfdce36cb2dd",
                                        "entry_id": "f3fb9487-4277-31c2-b321-15ed149f8b8f",
                                        "glosses": [
                                            "Province du nord-est de la Chine, à la frontière avec la Corée du Nord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c16e90d-e9a0-4626-933c-7a1bb759448c",
                                                "sense_id": "1f8b6ed3-2a66-3903-8d7a-cfdce36cb2dd",
                                                "text": "Et aujourd’hui que la province ressent le besoin d’une aide de l’État central, ses chercheurs aiment à rappeler que le Liaoning a contribué, par l’impôt, à la modernisation du reste de la Chine."
                                            }
                                        ]
                                    }
                                ]
