                    },
                    {
                        "translation_id": "fee86927-08ca-4198-824f-36f558137649",
                        "source_entry_id": "fdd13cd9-d02e-3345-b7d2-b57c9cc6ce4f",
                        "source_sense_id": "40227159-476f-3f89-b2ee-7165fb04f52b",
                        "target_lang_word": "doze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                        "entry_id": "45aa7378-ae5a-37e5-9aa1-70d4e17a8006",
                                        "glosses": [
                                            "To sleep lightly or briefly; to nap, snooze."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adf90b28-3e2a-4155-a1b7-135658c6a717",
                                                "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                                "text": "I didn’t sleep very well, but I think I may have dozed a bit."
                                            },
                                            {
                                                "example_id": "d65cc87d-3400-4db0-ae79-17f27ea2425f",
                                                "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                                "text": "If he Happen'd to Doze a little no and then in a Morning, the Jolly Cobbler Wak'd him."
                                            },
                                            {
                                                "example_id": "b2d3722d-3673-4ce3-aaf3-fe29ca8a07f7",
                                                "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                                "text": "She dozes, too. Lies there for a minute or two, all these thoughts going through her head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb21dd7-54b0-3ee0-a3b6-af32179512cd",
                                        "entry_id": "45aa7378-ae5a-37e5-9aa1-70d4e17a8006",
                                        "glosses": [
                                            "To make dull; to stupefy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b482a1d-1c7e-413a-9e27-267cdda47046",
                                                "sense_id": "beb21dd7-54b0-3ee0-a3b6-af32179512cd",
                                                "text": "I was an hour […] in casting up about twenty sums, being dozed with much work."
                                            },
                                            {
                                                "example_id": "25c0e183-5c1d-4115-a721-b7275aaa33c7",
                                                "sense_id": "beb21dd7-54b0-3ee0-a3b6-af32179512cd",
                                                "text": "October 29, 1693, Robert South, a sermon preached at Christ-church in Oxford before the university\nThey left for a long time (as it were) dozed and benumbed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                        "entry_id": "0a784180-7a02-3e70-b8a5-0a4e8c62f462",
                                        "glosses": [
                                            "A light, short sleep or nap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56111de-2744-4fe8-89ac-020528e190d0",
                                                "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                                "text": "I felt much better after a short doze."
                                            },
                                            {
                                                "example_id": "e0dd8747-4d83-4021-b707-4ec1c8e8767c",
                                                "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                                "text": "Others who conscientiously attended the Technical College at night often drooped over their desks in a doze, and one does not wonder at it."
                                            },
                                            {
                                                "example_id": "81d0d527-2227-493d-9a5b-9742c0355549",
                                                "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                                "text": "At the mention of money Mrs Dibble was overcome with great debility, and wheezed, \"I don't feel up to talking about money, matters just now, dearie. I think I better have a bit of a doze.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6cfb6a-1f6b-3c85-adfc-f04b80306f89",
                                        "entry_id": "ba69aac1-12b7-36d7-a267-e52615075757",
