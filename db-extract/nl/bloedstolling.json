                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea37e276-e542-4609-b255-eacd353a0886",
                                                "sense_id": "e14858b0-deea-337d-846e-7dffd0b16b00",
                                                "text": "The cure for thrombosis at the heart of London was to start work quickly on the new Victoria line. A high-level decision to proceed with this railway was urgently awaited"
                                            },
                                            {
                                                "example_id": "f8decf70-ecde-4153-adc7-d02a805b3b44",
                                                "sense_id": "e14858b0-deea-337d-846e-7dffd0b16b00",
                                                "text": "Blood-clotting platelets had surged like minnows to the site of injury, clumping together to form a thrombosis that blocked the artery, causing a heart attack and tissue death."
                                            }
                                        ]
