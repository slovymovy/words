                        "glosses": [
                            "De façon caractéristique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635817e5-d428-4e36-962f-8e29a1f95fdf",
                                "sense_id": "6146431f-6161-3ff7-b522-6931b674f0a3",
                                "text": "Visages féminins dont la joue est caractéristiquement, suavement arrondie."
                            },
                            {
                                "example_id": "3f5b7aed-6a7e-4bdc-b0be-6d16d6c918d0",
                                "sense_id": "6146431f-6161-3ff7-b522-6931b674f0a3",
                                "text": "L’envie de mourir a pu être une de ses « taches de nuit ». Caractéristiquement, à vingt ans, il avait regretté de n’en avoir plus douze."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75db555c-5f43-43ef-8768-76351fd78168",
                        "source_entry_id": "1fb0a3b7-2b19-3c85-a5fa-69bd457d112d",
