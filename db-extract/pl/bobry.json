                                    {
                                        "sense_id": "4c2cb38a-3728-3a12-bb8c-82280b13858d",
                                        "entry_id": "cefe2caa-b8e5-370d-a439-ebc7ed3aa6a4",
                                        "glosses": [
                                            "zu den Nagetieren gehörende Tierfamilie (nur Plural)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f1d41f3-1e60-4a83-8880-4cbfe912ad30",
                                                "sense_id": "4c2cb38a-3728-3a12-bb8c-82280b13858d",
                                                "text": "Biber gibt es nur auf der Nordhalbkugel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f3144d6-5c07-3aa0-b397-c67520522a38",
                                        "entry_id": "cefe2caa-b8e5-370d-a439-ebc7ed3aa6a4",
                                        "glosses": [
                                            "Vertreter aus [1], das einen spindelförmigen bis 1,40 m langen Körper mit braunem Fell, einen breiten, abgeplatteten, mit lederartiger Haut bedeckten und unbehaarten Schwanz und Schwimmhäute hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f3c368b-797a-4668-87ba-8894116cbf54",
                                                "sense_id": "5f3144d6-5c07-3aa0-b397-c67520522a38",
                                                "text": "Ein Biber hat den Baum gefällt."
                                            },
                                            {
                                                "example_id": "5cca07ed-6dea-4d76-b6c0-902ed9b0b67d",
                                                "sense_id": "5f3144d6-5c07-3aa0-b397-c67520522a38",
                                                "text": "„Mammute und andere zottelige Rüsseltiere trotteten durch die Steppe; Säbelzahnkatzen stellten Riesenhirschen und wildschweingroßen Bibern nach; weiter südlich fraßen sich drei Meter hohe Faultiere und 200 Kilogramm schwere Gürteltiere satt.“"
                                            },
                                            {
                                                "example_id": "e078ffa0-40ec-45be-88cf-e3e653520750",
                                                "sense_id": "5f3144d6-5c07-3aa0-b397-c67520522a38",
                                                "text": "„Laut dem Bundesnaturschutzgesetz ist es verboten, Bibern nachzustellen, sie zu fangen, zu verletzen oder zu töten sowie Burgen und Dämme zu beschädigen oder zu zerstören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
