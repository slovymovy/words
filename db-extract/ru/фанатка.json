                                ]
                            },
                            {
                                "target_word": "fan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c08acb0-4f51-3758-b55b-331bf4d388e4",
                                        "entry_id": "62411c66-2c6f-3a6f-b9f8-050d380e7e53",
                                        "glosses": [
                                            "A unit of length, equivalent to 0.1 tsun (0.01 chek), or 0.00371475 metres."
                                        ],
                                        "tags": [
                                            "Hong-Kong",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "757da215-5e5c-4efb-82a7-c91d5a84539d",
                                                "sense_id": "9c08acb0-4f51-3758-b55b-331bf4d388e4",
                                                "text": "1 chek (foot) = 14⅝ English inches divided into 10 tsün (inches) and each tsün into ten fan or tenths."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adf2e863-eea7-4ad8-a25a-c84f6a8c1d2b",
                        "source_entry_id": "90e708ff-a244-3f20-afa1-7a0309f78bca",
                        "source_sense_id": "c0779c03-2f92-3ba2-9d3c-661317ce526a",
                        "target_lang_word": "fangirl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fangirl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a0d9bb2-6c29-3852-b960-317b5630968b",
                                        "entry_id": "5f77ab5e-3749-3a13-ad38-f1ef4e44b953",
                                        "glosses": [
                                            "A female fan who is obsessive about a particular subject (especially, someone or something in popular entertainment media)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f66eaf-e699-46cc-9e15-60423c905a6f",
                                                "sense_id": "3a0d9bb2-6c29-3852-b960-317b5630968b",
                                                "text": "It's often an all or nothing world for the fangirl who has yet to learn to bridle the imagination. She is notorious for being incapable of passively enjoying stories."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fangirl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb21807b-8100-3728-8961-20098d5acd2e",
                                        "entry_id": "fff6f796-5c23-35ca-8501-57578cfe675f",
                                        "glosses": [
                                            "To behave like a fangirl; to be obsequious, star-struck, boy crazy, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c33cb861-db5e-4bb3-9d23-447882332ebf",
                                                "sense_id": "cb21807b-8100-3728-8961-20098d5acd2e",
                                                "text": "I bought the magazines, ran home after work, filmed myself flipping through the pages—half legitimately fangirling over the boys, half making fun of people like myself who fangirl over the boys."
                                            },
                                            {
                                                "example_id": "8e373613-e754-45a2-9b1f-956096a17a5b",
                                                "sense_id": "cb21807b-8100-3728-8961-20098d5acd2e",
                                                "text": "Letterboxd, armed with the tri-colour microphone which has become their viral go-to, recently attended the red carpet of the BAFTAs. As one TikToker put it, on seeing the famous mic, Paul Mescal fangirled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
