                "senses": [
                    {
                        "sense_id": "7fcd80e2-4cc6-3c90-a0d7-bb3113bce864",
                        "entry_id": "843bacb8-05c2-36f6-8306-86b72c0f6202",
                        "glosses": [
                            "eine nordamerikanische Kiefernart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef2adb9-3c6d-4240-b89c-89b42c63baec",
                                "sense_id": "7fcd80e2-4cc6-3c90-a0d7-bb3113bce864",
                                "text": "„Ein Umbau der Waldbestände zu Lasten der Douglasie, Strobe, Kiefer und Fichte ist dadurch notwendig geworden.“"
                            },
                            {
                                "example_id": "63c52a15-eaa9-46c0-9a2c-fd4692eb8dd4",
                                "sense_id": "7fcd80e2-4cc6-3c90-a0d7-bb3113bce864",
                                "text": "„Neben Buchen und Eichen wachsen auch Fichte, Kiefer, Tanne, Strobe, Lärche und Douglasie, darunter der höchste Baum Bayerns, eine Douglasie mit über 60 m Höhe.“"
                            },
                            {
                                "example_id": "c2de3518-eb00-4dcf-8cc1-4c41a936edd8",
                                "sense_id": "7fcd80e2-4cc6-3c90-a0d7-bb3113bce864",
                                "text": "„Die Lärche hat einen Anteil von 8,0 %, die Douglasie von 3,2 % und die Strobe einen Anteil von 0,4 %.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
