                        "examples": [
                            {
                                "example_id": "ddfba50e-9bbe-424b-8f47-9114a711fdc2",
                                "sense_id": "be09e906-188a-35fe-8e87-13333e128d01",
                                "text": "Van 't Wout kwam juist ingetogen over de finish, want hij kreeg zijn bronzen plak in de schoot geworpen na een val van de Chinees Xiaojun Lin, die met zijn onhandige inhaalpoging ook zijn landgenoot Shaoang Liu hinderde."
                            },
                            {
                                "example_id": "18334e94-e017-4189-80ce-fb2970ca299a",
                                "sense_id": "be09e906-188a-35fe-8e87-13333e128d01",
                                "text": "George Russell, die al bij de kwalificatie voor de sprintrace een straf incasseerde en pas als elfde van start ging, ontving wel een straf vanwege een inhaalpoging bij Oscar Piastri en dat kostte hem uiteindelijk ook een plekje."
                            }
                        ]
                    }
