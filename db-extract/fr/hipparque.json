                "senses": [
                    {
                        "sense_id": "330226f2-ebab-3d0b-9c08-2d0bbc4e20c7",
                        "entry_id": "0b1d1cc6-e13a-3b5f-a436-ef3956233c52",
                        "glosses": [
                            "Mathématicien, astronome et géographe de la Grèce antique."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "66be0f35-e366-4d92-924a-2c7deb295a4f",
                                "sense_id": "330226f2-ebab-3d0b-9c08-2d0bbc4e20c7",
                                "text": "Et d’abord, montrons que c’est à bon droit qu’à l’imitation de nos prédécesseurs, d’Hipparque notamment, nous avons présenté Homère comme le fondateur même de la science géographique."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff88e6b5-5a6f-3874-9914-de46266890ba",
                        "entry_id": "0b1d1cc6-e13a-3b5f-a436-ef3956233c52",
                        "glosses": [
                            "Fils du tyran Pisistrate."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "0bff0428-f717-4513-8763-f361ae4b0887",
                                "sense_id": "ff88e6b5-5a6f-3874-9914-de46266890ba",
                                "text": "Pisistrate avait eu deux fils, Hippias et Hipparque ; d’une femme d’Argos, il en avait eu deux autres, Iophon et Hégésistratos."
                            }
                        ]
                    }
                ],
