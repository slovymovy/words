                        "examples": [
                            {
                                "example_id": "86e055b2-bfbb-4ab0-9d1b-636186e79c8f",
                                "sense_id": "e5a5f7cb-2d6e-3478-9af7-834fceeab140",
                                "text": "Udowodniono, że zestaw białek macierzy jądrowej zmienia się w sposób specyficzny podczas dojrzewania osteoblastów w osteocyty, dostarczając znaczników dla poszczególnych stadiów tego procesu różnicowania […]"
                            }
                        ],
