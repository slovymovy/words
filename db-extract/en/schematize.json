                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "456d9028-e8af-34b4-98d6-6908c15a770c",
                                        "entry_id": "6f9c6659-0e4c-3521-b8b9-a2497a6a13d3",
                                        "glosses": [
                                            "grundlegende Züge feststellen und mittels dieser normen und beschreiben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "652088a5-8ebe-4f2c-93af-85f3cd099f9a",
                                                "sense_id": "456d9028-e8af-34b4-98d6-6908c15a770c",
                                                "text": "„Abb. 6.1 zeigt grob schematisiert die physikalischen und physiologischen Vorgänge bei einer Farbwahrnehmung.“"
                                            },
                                            {
                                                "example_id": "a720c34a-3108-405e-ba10-3df1e64b14fa",
                                                "sense_id": "456d9028-e8af-34b4-98d6-6908c15a770c",
                                                "text": "„Zur Lösung des Problems entwerfen wir ein Simulationsprogramm; wir schematisieren die Situation in der Weise, daß wir das genannte Straßennetz in den ersten Quadranten des Achsenkreuzes eingebettet denken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1bf909b2-72a5-3ce7-af64-7ee30a894600",
                                        "entry_id": "6f9c6659-0e4c-3521-b8b9-a2497a6a13d3",
                                        "glosses": [
                                            "das anschauliche Vereinfachen übertreiben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d659c3a-adff-4ac9-9fa6-63d850d66139",
                                                "sense_id": "1bf909b2-72a5-3ce7-af64-7ee30a894600",
                                                "text": "„Unsere bisherigen Ausführungen wirken ein wenig zu plakativ, zu schematisiert, zu rasterhaft, um „wahr zu sein\".“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
