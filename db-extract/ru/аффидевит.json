                    },
                    {
                        "translation_id": "338df6ec-52a3-4cf4-bb86-2bb0a41ee803",
                        "source_entry_id": "304ad36d-5ef0-3a02-8519-9e6a678bf4cc",
                        "source_sense_id": "625f90e4-7631-3c45-80a3-3e4b468d96e1",
                        "target_lang_word": "affidavit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affidavit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70b785bb-1895-3637-8004-110c415943db",
                                        "entry_id": "70f0f6ba-7dac-3d18-bf67-d9db864ce5a3",
                                        "glosses": [
                                            "Déclaration solennelle devant une personne assermentée, une autorité compétente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57a28ca6-9587-4dea-9a27-41d5fd547571",
                                                "sense_id": "70b785bb-1895-3637-8004-110c415943db",
                                                "text": "Les affidavits sont des témoignages écrits des parties à un contentieux, notamment en matière d’arbitrage commercial international."
                                            },
                                            {
                                                "example_id": "5406c5e5-298f-4bd4-9482-095a1eb4512f",
                                                "sense_id": "70b785bb-1895-3637-8004-110c415943db",
                                                "text": "Il est à relever, cependant, que la force probante de l’affidavit est moindre que celle des autres modes de preuve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78a8d63f-7e1c-3526-a316-bcb3f9cc1e39",
                                        "entry_id": "70f0f6ba-7dac-3d18-bf67-d9db864ce5a3",
                                        "glosses": [
                                            "Le document attestant de cette déclaration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "202170e7-3018-4da0-a033-a575c4480041",
                                                "sense_id": "78a8d63f-7e1c-3526-a316-bcb3f9cc1e39",
                                                "text": "L’avenir de ces gens souvent brillants, diplômés, célébrés tenait à deux misérables bouts de papier : un visa et un affidavit."
                                            },
                                            {
                                                "example_id": "01c934ff-26f3-46df-9fde-040f61a16ad0",
                                                "sense_id": "78a8d63f-7e1c-3526-a316-bcb3f9cc1e39",
                                                "text": "Un jour de 1936, Prinz reçut d’Amérique un affidavit qui allait lui permettre de quitter l’Allemagne avec sa famille après un délai d’attente de six mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59429603-3b9a-3ed7-b244-3484f4000149",
                                        "entry_id": "70f0f6ba-7dac-3d18-bf67-d9db864ce5a3",
                                        "glosses": [
                                            "Le document attestant de cette déclaration.",
                                            "Certificat délivré à un étranger qui détient des valeurs mobilières de manière à ce qu'il soit exonéré des impôts liés à ces valeurs quand ils les à déjà payé dans son pays d’origine."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1808472c-3b07-4661-bc9e-dad0c717657d",
                                                "sense_id": "59429603-3b9a-3ed7-b244-3484f4000149",
                                                "text": "Le cas échéant, les étrangers sont autorisé à produire un affidavit, seulement au moment du déblocage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
