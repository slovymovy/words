                        "translation_id": "a0d35858-2494-451b-953e-67769f30c70c",
                        "source_entry_id": "97b88e5d-a2b6-37e4-9a88-ed1d57cd0ecf",
                        "source_sense_id": "502e1ff6-9c70-3868-a2a7-01f2150b081f",
                        "source_sense_description": "Idée préconçue",
                        "target_lang_word": "preconception",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
