                ],
                "senses": [
                    {
                        "sense_id": "4d51843d-9d00-3988-9829-1ac84495bc29",
                        "entry_id": "19da5ccc-0179-3ab3-b8df-d11544b1ef8b",
                        "glosses": [
                            "cilindervormig vat met een nauwe opening, om water in te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b75a09c-02fc-4bb4-aa41-696e87eb7f80",
                                "sense_id": "4d51843d-9d00-3988-9829-1ac84495bc29",
                                "text": "Water! Eindelijk water! Met hernieuwde moed liep ik de berg af en vulde snel mijn lege waterflessen met het koele water uit het meer, waarbij ik moest terugdenken aan het advies van mijn dochter."
                            },
                            {
                                "example_id": "2e5de8e1-8d15-4386-ae9c-804ea22b3c23",
                                "sense_id": "4d51843d-9d00-3988-9829-1ac84495bc29",
                                "text": "Mijn denken zwiept telkens weer terug naar mijn lopen, mijn voeten, mijn rug, de plekken waar ik mijn waterfles kan bijvullen, en Nicolas."
                            },
                            {
                                "example_id": "2c4172a2-7df5-45bd-b675-cb7e599319e5",
                                "sense_id": "4d51843d-9d00-3988-9829-1ac84495bc29",
                                "text": "De dop kan openspringen door de druk als er voedsel, koolzuurhoudende dranken of bederfelijke dranken zoals sap en melk in de waterfles worden gedaan, zegt een Amerikaanse consumentenwaakhond."
                            }
                        ]
                    },
                    {
                        "sense_id": "782d3119-9781-3cf5-9cd8-d516c47dd561",
                        "entry_id": "19da5ccc-0179-3ab3-b8df-d11544b1ef8b",
                        "glosses": [
                            "kruik die met warm water gevuld als warmtebron dient voor iemand die het koud heeft"
                        ],
