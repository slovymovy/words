                        "glosses": [
                            "Dessiner en utilisant la technique du fusain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50282c4-b69d-41b7-b4a4-c78023d0a9e7",
                                "sense_id": "38d3d9d7-e87e-3116-88d2-82287e47f051",
                                "text": "Hébert fait le portrait de la Princesse, que nous lui avions vu fusiner avant de partir : la Princesse en buste, dans le format des petits portraits d’Holbein, un portrait intime qui doit être gravé de la même grandeur pour les amis."
                            },
                            {
                                "example_id": "bd584c12-4ba3-479a-8412-94334ed3a572",
                                "sense_id": "38d3d9d7-e87e-3116-88d2-82287e47f051",
                                "text": "Francesca, à mon approche, s’arrêta de fusiner."
                            }
                        ]
                    }
