                        "entry_id": "a304df1f-eeb3-3b2a-ae60-00daf7db2328",
                        "glosses": [
                            "Écosystème d’entreprises et de nouvelles technologies déployées pour innover dans le domaine du droit, des contrats ou de la justice."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
