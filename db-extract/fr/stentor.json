        "fr-extract.jsonl": [
            {
                "entry_id": "32ff1b8d-569e-3f01-bafc-18ededa6fa4a",
                "word": "Stentor",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1cca094c-7b67-30c6-b4bd-acb83991a9c3",
                        "entry_id": "32ff1b8d-569e-3f01-bafc-18ededa6fa4a",
                        "glosses": [
                            "Guerrier grec participant au siège de Troie, et qui avait, dit-on, une voix si éclatante, qu’elle faisait seule plus de bruit que celle de cinquante hommes criant tous ensemble."
                        ],
                        "tags": [
                            "Anthroponyme",
                            "Mythologie grecque"
                        ],
                        "examples": [
                            {
                                "example_id": "ec213ada-4f04-445b-aee7-90915727c4f0",
                                "sense_id": "1cca094c-7b67-30c6-b4bd-acb83991a9c3",
                                "text": "Le drôle avait les poumons de Stentor, et sa voix, habituée à promulguer les édits, donnait aux titres des pièces et aux noms des acteurs une redondance emphatique la plus majestueuse du monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f626ff93-ec1c-406b-bf61-fe8800e2dd73",
                        "source_entry_id": "32ff1b8d-569e-3f01-bafc-18ededa6fa4a",
                        "source_sense_id": "1cca094c-7b67-30c6-b4bd-acb83991a9c3",
                        "target_lang_word": "Stentor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stentor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96671bb6-e567-344b-bb43-bfcd1e2c2ae6",
                                        "entry_id": "1a403938-3a3d-31a1-8615-5f61fa4e61d1",
                                        "glosses": [
                                            "A herald in the Iliad celebrated for his loud voice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2776dd8d-2011-4d25-b3d4-a14bda8de812",
                                                "sense_id": "96671bb6-e567-344b-bb43-bfcd1e2c2ae6",
                                                "text": "For who can be the general of such a vast multitude, or who the herald, unless he have the voice of a Stentor?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c64b7aeb-6f4d-330d-8648-051821c41eb3",
                                        "entry_id": "1a403938-3a3d-31a1-8615-5f61fa4e61d1",
                                        "glosses": [
                                            "The Jovian asteroid 2146 Stentor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4189d7a8-4d7f-4164-be6c-63af16239352",
                        "source_entry_id": "32ff1b8d-569e-3f01-bafc-18ededa6fa4a",
                        "source_sense_id": "1cca094c-7b67-30c6-b4bd-acb83991a9c3",
