                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "紫薯",
                                "target_lang_sense_clarification": "指代紫色的薯类，常用于描述其在甜点中的应用。"
                            },
                            {
                                "target_lang_word": "参薯",
                                "target_lang_sense_clarification": "指代植物学上的参薯，即Dioscorea alata。"
