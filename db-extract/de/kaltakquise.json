                    {
                        "sense_id": "1204a391-ec63-35df-bb08-dd0ff3510018",
                        "entry_id": "f9b85cde-fbd3-3e8e-962b-016671515dd4",
                        "glosses": [
                            "erstmalige Kontaktaufnahme eines Verkäufers mit einem potenziellen Kunden; dieser Gesprächspartner ist also weder bereits Kunde, noch hat er sich freiwillig gemeldet und um Kontakt gebeten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6dfdb44-bce7-44bd-8363-a6f0e562f627",
                                "sense_id": "1204a391-ec63-35df-bb08-dd0ff3510018",
                                "text": "„Es gab Zeiten, da verbrachte er jede Woche ganze Tage mit mühseliger Kaltakquise – und hatte trotzdem noch Kapazitäten frei.“"
                            },
                            {
                                "example_id": "127eef24-a1c6-43d9-bdf6-55e60c4d8924",
                                "sense_id": "1204a391-ec63-35df-bb08-dd0ff3510018",
                                "text": "„Keiner mag die Kaltakquise am Telefon. Woran liegt das? Ganz einfach: Wir erleben dabei meist sehr viel mehr Niederlagen als Erfolge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
