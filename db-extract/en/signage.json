                                    {
                                        "sense_id": "cbd9faf7-adf0-343c-99a2-6d1f191ed4ac",
                                        "entry_id": "777baba8-2519-3dc2-a3ec-fa04d709db1c",
                                        "glosses": [
                                            "een plaats voorzien met (verkeers)borden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed12765e-3093-4093-b234-3d7d65270bab",
                                                "sense_id": "cbd9faf7-adf0-343c-99a2-6d1f191ed4ac",
                                                "text": "De snelheidsbeperking geldt voor beide rijrichtingen op de Van Rechteren Limpurgsingel, vanaf de bebording tot het kruisingsvlak."
                                            },
                                            {
                                                "example_id": "b30cfb04-18b2-4fd8-a7bb-43213b5a99d0",
                                                "sense_id": "cbd9faf7-adf0-343c-99a2-6d1f191ed4ac",
                                                "text": "De meerderheid van de ondernemers heeft aangegeven best mensen met hoge nood te willen toelaten, zonder dat ze een consumptie aanschaffen. Daar bebording of een sticker voor ophangen, willen ze echter niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46712ca7-7d25-4e21-b63d-32a99eaf5185",
                        "source_entry_id": "1f49d23e-9bd8-31ad-918e-01ee5c00476f",
