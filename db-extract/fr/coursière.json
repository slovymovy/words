                ],
                "senses": [
                    {
                        "sense_id": "c2229fab-ef66-3d63-83ce-6c7c154c4a76",
                        "entry_id": "802a6db0-1d52-3bdb-b3b4-9dba75a57b72",
                        "glosses": [
                            "Sentier coupant à travers champs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "665e35d3-b75a-4d9b-919e-b681e203734c",
                                "sense_id": "c2229fab-ef66-3d63-83ce-6c7c154c4a76",
                                "text": "Il s’engagea sur le chemin indiqué mais tourna à droite, sitôt qu’il fut hors de vue des maisons et, piquant à travers champs, grimpa la coursière qui, passant devant le cimetière, rejoint la route de Saint-Étienne au Rhône."
                            },
                            {
                                "example_id": "2566e602-e0d5-4a6b-a202-8851745c21c6",
                                "sense_id": "c2229fab-ef66-3d63-83ce-6c7c154c4a76",
                                "text": "Il connaissait si bien toutes les traînes , tous les bouts de sac , toutes les coursières , toutes les traques et traquettes , et jusqu' aux échaliers des bouchures , qu' en pleine nuit il aurait passé aussi droit qu' un pigeon dans le ciel , par le plus court chemin sur terre ."
                            }
                        ]
                    },
                    {
                        "sense_id": "41c08fa1-866a-3f27-96ad-9f21c926aa45",
                        "entry_id": "802a6db0-1d52-3bdb-b3b4-9dba75a57b72",
                        "glosses": [
                            "Rigole conduisant le métal fondu au moule."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "987b827b-cff7-305f-9f8f-0bbed748e449",
                        "entry_id": "802a6db0-1d52-3bdb-b3b4-9dba75a57b72",
                        "glosses": [
                            "Galeries de coursière : Galeries d’essai."
                        ],
                        "tags": [
                            "Mines"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f0d099c8-bf5e-3f49-a91e-dd57fcc4f9c0",
                        "entry_id": "802a6db0-1d52-3bdb-b3b4-9dba75a57b72",
                        "glosses": [
                            "Dispositif d’un mécanisme conduisant la navette d'un métier à tisser."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "019d5b0d-b368-34b0-a7b1-d0b4fdd3911b",
                        "entry_id": "802a6db0-1d52-3bdb-b3b4-9dba75a57b72",
                        "glosses": [
                            "Dans une église, galerie se situant le long de la nef sous des arcades."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd2a2529-78ba-47f0-b18c-b81a729e1dc3",
                                "sense_id": "019d5b0d-b368-34b0-a7b1-d0b4fdd3911b",
                                "text": "Une remarque complémentaire doit encore être faite sur ce point : si nous admettons que l'étage clair de la nef de la cathédrale de Cambrai était doté d'une coursière, celle-ci aurait figuré parmi les rares monuments à élévation à quatre étages …. — (Jacques Thiébaut, La Cathédrale disparue de Cambrai, Éd. Septentrion, 2020)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22af985b-d721-460a-b22b-5f27dd9d9723",
                        "source_entry_id": "802a6db0-1d52-3bdb-b3b4-9dba75a57b72",
                        "target_lang_word": "Laubengang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laubengang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9eece403-983d-349b-8ff1-faa402b160fd",
                                        "entry_id": "89186ed4-c5c5-30d8-bd59-a655d417c16f",
                                        "glosses": [
                                            "überwölbter langgezogener Verbindungsraum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c38ae41-ea02-4e9e-bee9-28d2ed37c224",
                                                "sense_id": "9eece403-983d-349b-8ff1-faa402b160fd",
                                                "text": "Der Zugang zur Wohnung erfolgt über einen Laubengang."
                                            },
                                            {
                                                "example_id": "44198d17-af94-4ca3-9439-e025a13afebe",
                                                "sense_id": "9eece403-983d-349b-8ff1-faa402b160fd",
                                                "text": "„Er gab nun die Blumen auf und schritt auf einen der beiden Laubengänge zu, die den großen Parkgarten flanierten und von der Höhe bis fast an den Fuß des Schloßhügels herniederstiegen.“"
                                            },
                                            {
                                                "example_id": "4756faf5-b4db-4cc7-830a-b58831384539",
                                                "sense_id": "9eece403-983d-349b-8ff1-faa402b160fd",
                                                "text": "„Als er sich schließlich von den Kaufständen des Laubenganges entfernt hatte und auf den freien Platz getreten war, wagten die Trödler nicht, ihm dorthin zu folgen, sie schienen an den Saum des Ovals gebannt.“"
                                            },
                                            {
                                                "example_id": "5368f6a5-90ef-4022-99ec-121189a87a66",
                                                "sense_id": "9eece403-983d-349b-8ff1-faa402b160fd",
                                                "text": "„Als Bouvard am Laubengang vorbeiging, entdeckte er unter den Zweigen eine Dame aus Gips.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
