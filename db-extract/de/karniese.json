                    },
                    {
                        "translation_id": "a0098152-b79b-451b-bd28-5934941961b5",
                        "source_entry_id": "f2f74c08-fa9b-3188-b271-c3379db3a3d0",
                        "source_sense_id": "b76606af-3fde-352d-b105-01afa2653d90",
                        "source_sense_description": "österreichisch: Gardinenleiste, Vorhangstange",
                        "target_lang_word": "tringle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tringle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad675a95-e6fe-33b6-af76-52f679070960",
                                        "entry_id": "36f29f04-f56d-32f8-9be0-f6f21edc2dd0",
                                        "glosses": [
                                            "Verge métallique, en plastique ou en bois, menue, ronde et longue, servant à soutenir un rideau, une draperie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3bdf3e-6533-4f42-91a8-1702af877798",
                                                "sense_id": "ad675a95-e6fe-33b6-af76-52f679070960",
                                                "text": "Ces tringles sont trop courtes pour mes fenêtres."
                                            },
                                            {
                                                "example_id": "8fc6000f-00f9-4f75-ba1d-095e981be65b",
                                                "sense_id": "ad675a95-e6fe-33b6-af76-52f679070960",
                                                "text": "J’avais à peine bu les premières gorgées du sommeil, que j’entendis ouvrir les rideaux de mon lit et glisser les anneaux sur les tringles avec un bruit éclatant ; je me soulevai brusquement sur le coude, et je vis une ombre de femme qui se tenait debout devant moi."
                                            },
                                            {
                                                "example_id": "2dea7657-7d02-4c64-afd1-65a1086e0435",
                                                "sense_id": "ad675a95-e6fe-33b6-af76-52f679070960",
                                                "text": "Les tringles des sistres tintaient\nAvec un éclat métallique\nEt sur cette étrange musique\nLes zingarellas se levaient"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c63cd9-0b6a-32e0-9c02-9e90a0a3c573",
                                        "entry_id": "36f29f04-f56d-32f8-9be0-f6f21edc2dd0",
                                        "glosses": [
                                            "Baguette équarrie, longue et étroite, qui sert principalement à former des moulures ou à remplir un vide entre deux planches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00ea9254-77e8-3260-bb88-7b1dc6993f50",
                                        "entry_id": "36f29f04-f56d-32f8-9be0-f6f21edc2dd0",
                                        "glosses": [
                                            "Marque faite sur une pièce de bois avec un cordeau frotté de blanc ou de rouge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7097e869-8f57-3d07-983c-fed2f7bb54f7",
                                        "entry_id": "36f29f04-f56d-32f8-9be0-f6f21edc2dd0",
                                        "glosses": [
                                            "Tige métallique utilisée pour commander certaines pièces de machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d98fe7e5-fa30-41e2-af0c-2af3417a624e",
                                                "sense_id": "7097e869-8f57-3d07-983c-fed2f7bb54f7",
                                                "text": "Quand le chariot termine sa course de rentrées, la tringle 34 est poussée, et le goujon 23 tombe en 30 pour faire effectuer son demi-tour à l'arbre à deux temps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tringle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47a9e743-5df4-3664-acb0-406f1ea4384a",
                                        "entry_id": "205531d8-54d6-367d-9abe-1e4a78447813",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de tringler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b1b0904-8119-4b6a-8e35-7e6437f0d954",
                                                "sense_id": "47a9e743-5df4-3664-acb0-406f1ea4384a",
                                                "text": "Nicky est exacte au rendez-vous et nous allons nous déloquer en vitesse dans une chambre de louage, c’est la joie la frénésie, je tringle et tournoche devant derrière dessus dessous, Nicky bafouille et bavouille, (…)."
                                            }
                                        ]
                                    },
