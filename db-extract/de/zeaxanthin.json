                ],
                "senses": [
                    {
                        "sense_id": "4ce3bd20-6403-3da7-bfbd-ee29582d02e0",
                        "entry_id": "bf5c92f6-51e5-3a4e-ae50-6abe24791936",
                        "glosses": [
                            "gelboranges Xanthophyll, das besonders im Mais, grünen Bohnen und bestimmten Blattgemüsen, aber auch in Eiern enthalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d2e2cc-d80e-4da0-ad66-d0e9426a6d7e",
                                "sense_id": "4ce3bd20-6403-3da7-bfbd-ee29582d02e0",
                                "text": "Die Isomere Lutein und Zeaxanthin kommen in Pflanzen häufig gemeinsam vor."
                            },
                            {
                                "example_id": "505d6323-97de-4d51-9341-401fc2f14ae7",
                                "sense_id": "4ce3bd20-6403-3da7-bfbd-ee29582d02e0",
                                "text": "Die gelbe Pigmentierung der Makula (macula lutea), der Stelle des schärfsten Sehens in der Netzhaut, ist dabei hauptsächlich auf den hohen Gehalt der Carotinoiden Lutein und Zeaxanthin zurückzuführen."
                            },
                            {
                                "example_id": "7a20698d-a7e5-4c09-8f0d-847a29ff0f47",
                                "sense_id": "4ce3bd20-6403-3da7-bfbd-ee29582d02e0",
                                "text": "Unter anderem stellen die beiden Carotinoide Lutein und Zeaxanthin wesentliche Schutzfaktoren für die Augen dar: Auf Grund ihrer spezifischen chemischen Struktur filtern sie das energiereiche Blaulicht aus dem Sonnenlicht heraus, bevor dieses auf die empfindlichen Sehzellen treffen kann."
                            },
                            {
                                "example_id": "9584e540-dcc7-4728-a514-efb9e3ce626d",
                                "sense_id": "4ce3bd20-6403-3da7-bfbd-ee29582d02e0",
                                "text": "Derzeit sehe es so aus, als ob die Einnahme großer Mengen Lutein und Zeaxanthin sich positiv auf die Prävention der AMD auswirke, sagte Beatty."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
