                                        "examples": [
                                            {
                                                "example_id": "5ba2a941-820a-459f-b873-b531ea2db26c",
                                                "sense_id": "131c5a90-b078-3036-a9da-c34d3aaa7e20",
                                                "text": "The committee would like to entertain the idea of reducing the budget figures."
                                            },
                                            {
                                                "example_id": "e7e6b48b-492c-49b4-95c7-8487c2223c92",
                                                "sense_id": "131c5a90-b078-3036-a9da-c34d3aaa7e20",
