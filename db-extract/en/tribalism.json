                        "form_id": "e85e0683-8e0c-40f5-a29c-3fc7fba9cca7",
                        "entry_id": "745c07bf-9811-36aa-82c8-c81612235a43",
                        "tags": [
                            "plural"
                        ],
                        "form": "tribalisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eff78894-ddea-3330-bdb2-6074b40bb18e",
                        "entry_id": "745c07bf-9811-36aa-82c8-c81612235a43",
                        "glosses": [
                            "The condition of being tribal."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6df4c9e0-9413-3222-8bc8-4fa1f22a180a",
                        "entry_id": "745c07bf-9811-36aa-82c8-c81612235a43",
                        "glosses": [
                            "A feeling of identity and loyalty to one's tribe."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cf28b571-7dbf-355f-8e94-43bbceb342f2",
                        "entry_id": "745c07bf-9811-36aa-82c8-c81612235a43",
                        "glosses": [
                            "The tendency among human beings to form socially cohesive groups within which there exists social pressure upon the individual to conform to either common behaviors, customs, habits, mores and/or norms, and which groups exhibit greater or lesser degrees of exclusivism."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "67dc74c3-be8b-4859-bf3b-703216f8c687",
                                "sense_id": "cf28b571-7dbf-355f-8e94-43bbceb342f2",
                                "text": "If we put an end to regionalism and normalize the flow of great energies in the body of Kyrgyzstan, then there will be a very rapid healing of the whole country and people, who have been vegetating in a semi-paralyzed state for many decades due to the grave illness of tribalism and regionalism."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f89bf0dc-978f-41fa-923c-0b732246dd6b",
                        "source_entry_id": "745c07bf-9811-36aa-82c8-c81612235a43",
                        "source_sense_description": "the condition of being tribal",
                        "target_lang_word": "tribalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tribalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b898ae2-d930-3f30-864d-a30666ca5cc4",
                                        "entry_id": "439cd9f3-2065-322c-ac89-86683d00ef10",
                                        "glosses": [
                                            "Mode d'organisation sociale basée sur la tribu."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08e43777-8987-4dd9-bc52-1520fe3ed168",
                                                "sense_id": "4b898ae2-d930-3f30-864d-a30666ca5cc4",
                                                "text": "Plusieurs sourates ou versets du Coran sont hostiles au tribalisme, soit en présentant Muhâmmad comme un homme à qui Dieu a assuré la solidarité qui était du ressort tribal (XCIII, XCIV), soit en indiquant le rejet dont il a été l’objet de la part des siens, qui l’accusaient de trahir les traditions des ancêtres (« anciens ») de la tribu (XXV, 5), […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4736653-d119-3efd-933f-86887b6434a8",
                                        "entry_id": "439cd9f3-2065-322c-ac89-86683d00ef10",
                                        "glosses": [
                                            "Mode d’organisation politique basée sur la lutte entre groupes, au profit de leurs dirigeants."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ace6b27-3e5c-4cd7-b1d9-ea0e34e4942e",
                                                "sense_id": "d4736653-d119-3efd-933f-86887b6434a8",
                                                "text": "Puisque la tribu n’avait, à l’évidence, aucun lien structurel avec le capitalisme, le tribalisme devait être une manière de manipulation idéologique, liée à l’appareil hégémonique, que la nouvelle bourgeoisie africaine, maintenant arrivée au pouvoir, utilisait pour défendre ses intérêts de classe. […] Le tribalisme était facteur de division des travailleurs ; il rendait les pauvres fiers de certains de leurs exploiteurs, considérés comme des héros qui procuraient à leurs fidèles profits et emplois réservés à l’intérieur de l’État marchand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e29c38a-1a03-3731-9b38-eea9151f5407",
                                        "entry_id": "439cd9f3-2065-322c-ac89-86683d00ef10",
                                        "glosses": [
                                            "Mode d’organisation basée sur le sentiment d'appartenance, à un lieu, à un groupe comme fondement essentiel de la vie sociale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8428723a-22f2-41b3-869b-f728542ec009",
                                                "sense_id": "2e29c38a-1a03-3731-9b38-eea9151f5407",
                                                "text": "La chose est d’autant plus amusante, qu’emportée par l’esprit du temps, cette même intelligentsia, d’une manière inconsciente, fonctionne sur un tribalisme à toute épreuve. Le monde universitaire en est un exemple achevé en ce qu’il est constitué d’un ensemble de clans, chacun se reconnaissant autour d’un héros éponyme, clans maniant à loisir l’exclusive, l’exclusion, le mépris ou la stigmatisation. Et celui qui n’a pas l’odeur de la meute est, immanquablement, rejeté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c60a8d27-4c60-4421-904b-03601505f427",
                        "source_entry_id": "745c07bf-9811-36aa-82c8-c81612235a43",
                        "source_sense_description": "the condition of being tribal",
                        "target_lang_word": "Tribalismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tribalismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e805729-e9d9-332e-9a88-3a80973284a0",
                                        "entry_id": "29fa26f6-5ca7-3489-9194-4a1e45a7d94d",
                                        "glosses": [
                                            "Stammesbewusstsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf97530-1f58-4a1c-89c1-aff1553d2ef2",
                                                "sense_id": "4e805729-e9d9-332e-9a88-3a80973284a0",
                                                "text": "In unserem Land, das angeblich Zweitausend Jahre alt ist, herrscht immer noch der dumpfe Tribalismus, der dumpfe Glaube an die alte Stammeszugehörigkeit."
                                            },
                                            {
                                                "example_id": "d2b68e81-6d5d-4d68-96cb-59a4d6e7fbd8",
                                                "sense_id": "4e805729-e9d9-332e-9a88-3a80973284a0",
                                                "text": "„Nur durch den Tribalismus war es ihnen gelungen, Afrika zu kolonialisieren.“"
                                            },
                                            {
                                                "example_id": "7986615b-b49c-4941-9991-6ffc09d5595d",
                                                "sense_id": "4e805729-e9d9-332e-9a88-3a80973284a0",
                                                "text": "„Zuletzt das ewig gleiche Problem, die ewig gleiche afrikanische Krankheit: Tribalismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf10e2d3-dd3d-3834-ad3d-1d75a065cb8f",
                                        "entry_id": "29fa26f6-5ca7-3489-9194-4a1e45a7d94d",
                                        "glosses": [
                                            "Glaube an die Stammeszugehörigkeit"
                                        ],
