                        "form": "die Balustrade"
                    },
                    {
                        "form_id": "1c908304-3414-4cf8-a3fb-b4033b6a3ed5",
                        "entry_id": "986c4520-27c9-339a-9b18-1feb2ec00741",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Balustraden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                        "entry_id": "986c4520-27c9-339a-9b18-1feb2ec00741",
                        "glosses": [
                            "Brüstung oder Geländer, das aus einer niedrigen Säulenreihe besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ac71fb-011f-42b0-a49b-e6baf1f41c05",
                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                "text": "Die Balustraden im Schloss müssten dringend renoviert werden."
                            },
                            {
                                "example_id": "dd45f752-25ef-4317-b249-57785af1caee",
                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                "text": "„Ich setze mich auf eine Balustrade und lasse die Beine baumeln.“"
                            },
                            {
                                "example_id": "0f92f555-bdba-4ee7-9675-5140bf1b1574",
                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                "text": "„In der Nacht träumte ich, in dem Innenhof eines orientalischen Hauses zu stehen, und auf der Balustrade des ersten Stocks drängten sich so viele Frauen, wie draufpassten.“"
                            },
                            {
                                "example_id": "4a86adb5-0d25-426f-bb21-f0763e1a91cf",
                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                "text": "„Oben auf der Balustrade sitzen goldverziert der schöne (kleine) Krishna und die schöne (kleine) Radha.“"
                            },
                            {
                                "example_id": "397977a2-8d28-4743-8134-a7357177861e",
                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                "text": "„Die Luftverschmutzung hatte die prallen Pobacken der Putten auf den Balustraden geschwärzt.“"
                            },
                            {
                                "example_id": "e1278723-add7-473b-ac78-cf1974b79cca",
                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                "text": "„Die Schrotkugeln prasselten auf die Balustrade im ersten Stock und ließen einige Fensterscheiben bersten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b48a1e4-6c28-4959-94a1-6ce437c5d02f",
                        "source_entry_id": "986c4520-27c9-339a-9b18-1feb2ec00741",
                        "source_sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                        "source_sense_description": "Brüstung oder Geländer, das aus einer niedrigen Säulenreihe besteht",
                        "target_lang_word": "balustrade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balustrade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49064ec5-1913-3492-9862-2fad58691659",
                                        "entry_id": "7422dab5-b1b7-3b0b-9a6c-98825d60e59b",
                                        "glosses": [
                                            "A row of balusters topped by a rail, serving as an open parapet, as along the edge of a balcony, terrace, bridge, staircase, or the eaves of a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25909899-688a-4a95-aa82-af639fece015",
                                                "sense_id": "49064ec5-1913-3492-9862-2fad58691659",
                                                "text": "So on a pleasant morning, as he leant / Into the sun-rise, o’er the balustrade [...]"
                                            },
                                            {
                                                "example_id": "038599ee-7685-485a-84eb-4491664b2854",
                                                "sense_id": "49064ec5-1913-3492-9862-2fad58691659",
                                                "text": "The Jester sat down on one of the marble balustrades and regarded Alvin with a curious intentness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "679c714d-3282-49ef-9cfc-5becf8bb4e89",
                        "source_entry_id": "986c4520-27c9-339a-9b18-1feb2ec00741",
                        "source_sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                        "source_sense_description": "Brüstung oder Geländer, das aus einer niedrigen Säulenreihe besteht",
                        "target_lang_word": "balustrade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balustrade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5443fc54-e79d-3ecb-997e-9e92868f6409",
                                        "entry_id": "4c5d3f15-1fdd-3b96-99fd-f045d007582e",
                                        "glosses": [
                                            "Suite, rangée de plusieurs balustres portant une tablette d’appui et servant d’ornement ou de clôture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b66c2b3a-56de-49f5-8979-ebfdfeba7660",
                                                "sense_id": "5443fc54-e79d-3ecb-997e-9e92868f6409",
                                                "text": "[…], et le chat gris, un peu sauvage, nous regardait de loin, à travers la balustrade de l’escalier au fond, sans oser descendre."
                                            },
                                            {
                                                "example_id": "bcf12e55-9bb6-4270-b2b4-671ea628650b",
                                                "sense_id": "5443fc54-e79d-3ecb-997e-9e92868f6409",
                                                "text": "Un énorme figuier faisait retomber comme un tapis par-dessus la balustrade ses branches cachées par les feuilles plates et ses fruits poudrés de lilas."
                                            },
                                            {
                                                "example_id": "f3f6f0e8-4990-4078-9f00-e5a10025ec85",
                                                "sense_id": "5443fc54-e79d-3ecb-997e-9e92868f6409",
                                                "text": "Durtal aboutissait à une terrasse dominant la ville et il s’accoudait à une balustrade de pierre grise, sèche, trouée […]."
                                            },
                                            {
                                                "example_id": "3dc2655a-b5c6-4c54-8679-d427b2354f41",
                                                "sense_id": "5443fc54-e79d-3ecb-997e-9e92868f6409",
                                                "text": "— Votre démon aime les souris. N'avez-vous pas ici un chat noir ?\nUn mistigri couleur de charbon trottait sur la balustrade, à la recherche d'une bonne fortune dotée de grandes oreilles roses et d'une queue de rat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efc5d428-46aa-33ca-9b7d-d38aa93c059c",
                                        "entry_id": "4c5d3f15-1fdd-3b96-99fd-f045d007582e",
                                        "glosses": [
                                            "Toute sorte de clôture qui est à jours et à hauteur d’appui."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a4dd23-b69a-4884-a291-ec397c82f49b",
                                                "sense_id": "efc5d428-46aa-33ca-9b7d-d38aa93c059c",
                                                "text": "Brrr ! fit Bert, en se cramponnant à la balustrade, et quelques soldats auprès de lui firent entendre un murmure d’horreur."
                                            },
                                            {
                                                "example_id": "26df1489-459f-4c7e-b64b-0dd15be35017",
                                                "sense_id": "efc5d428-46aa-33ca-9b7d-d38aa93c059c",
                                                "text": "Il arrive, sans que nul puisse l’arrêter, jusqu’à la balustrade des remparts qui cède, et voilà, au douzième coup de midi, l’équipage au fond du ravin, la voiture en miettes, la femme morte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
