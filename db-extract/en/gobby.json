                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "cac07f7f-2331-46c2-aba9-cf3cb1dce213",
                                "sense_id": "f44e9003-a1a8-38cd-91bb-2aa0c84237da",
                                "text": "But if, however, the bees make from it a \"gobby\" article of comb honey, no one will be quicker to drop it than the Root Co."
                            },
                            {
                                "example_id": "18162230-5e1e-4c23-9459-1a5c150babb5",
                                "sense_id": "f44e9003-a1a8-38cd-91bb-2aa0c84237da",
                                "text": "...to have a gobby mess of unrelated and meaningless color hung in a metropolitan show..."
                            },
                            {
                                "example_id": "d87502cd-db8a-4057-a5fb-a046c619e27e",
                                "sense_id": "f44e9003-a1a8-38cd-91bb-2aa0c84237da",
                                "text": "He poured the Argentine stew in a gobby mess on top of the Spam."
                            }
                        ]
