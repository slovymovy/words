                        "glosses": [
                            "Carnegiea gigantea, a large cactus native to the Sonoran Desert and characterized by its \\\"arms\\\"."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d15d8c-26a6-4e29-ab94-90d86de6b80c",
                                "sense_id": "26e8d4f8-c10f-3678-8369-63d630e1557d",
                                "text": "The Suwarrow or Saguaro of the natives."
                            },
                            {
                                "example_id": "90fa045f-3e5a-48cf-a9e1-2b71bd75999d",
                                "sense_id": "26e8d4f8-c10f-3678-8369-63d630e1557d",
                                "text": "The Pitella (pronounced Pitayo) and the Saguaro are the most prized."
                            }
                        ]
                    }
