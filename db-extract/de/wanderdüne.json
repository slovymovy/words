                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9942cbd-87ea-49a8-9c5a-3166079291bd",
                                "sense_id": "5fe476a4-b9b6-37ae-991c-7c9e07944f2a",
                                "text": "„Auf die Frage von Marcel, ob er jemals Wanderdünen gesehen habe, begann er, von seinen Abenteuern in der Wüste zu erzählen.“"
                            },
                            {
                                "example_id": "405bd07a-2ac5-4990-a9b3-0c2f31286a43",
                                "sense_id": "5fe476a4-b9b6-37ae-991c-7c9e07944f2a",
                                "text": "„An anderen Stellen, in der Wüste, verschwindet sie unter dem Sand der Wanderdünen.“"
                            }
                        ],
