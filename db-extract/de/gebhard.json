                ],
                "senses": [
                    {
                        "sense_id": "ad09e24c-ba03-3ad3-a683-d5c5bd97e2c3",
                        "entry_id": "dfbfd1b4-b5e9-3452-a1ff-c378bca009f1",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef51c240-dc08-407a-93aa-07b8e7d5734e",
                                "sense_id": "ad09e24c-ba03-3ad3-a683-d5c5bd97e2c3",
                                "text": "Frau Gebhard ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bc6eb76c-509b-46c3-a083-55438e41f71a",
                                "sense_id": "ad09e24c-ba03-3ad3-a683-d5c5bd97e2c3",
                                "text": "Herr Gebhard wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bad7d0f5-7459-453c-affb-ce6ad0a47477",
                                "sense_id": "ad09e24c-ba03-3ad3-a683-d5c5bd97e2c3",
                                "text": "Die Gebhards fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9eb7e94c-8d0d-40e7-b0e3-a762ec075af0",
                                "sense_id": "ad09e24c-ba03-3ad3-a683-d5c5bd97e2c3",
                                "text": "Der Gebhard trägt nie die Schals, die die Gebhard ihm strickt."
                            },
                            {
                                "example_id": "086be17f-e986-47f5-969a-c38e61e31f4f",
                                "sense_id": "ad09e24c-ba03-3ad3-a683-d5c5bd97e2c3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gebhard kommt, geht der Herr Gebhard.“"
                            },
                            {
                                "example_id": "a1b57d53-71fe-4429-9f83-125ed4b168e6",
                                "sense_id": "ad09e24c-ba03-3ad3-a683-d5c5bd97e2c3",
                                "text": "Gebhard kommt und geht."
                            },
                            {
                                "example_id": "1bec2aa3-07b3-4bee-9578-c73bb534eaf2",
                                "sense_id": "ad09e24c-ba03-3ad3-a683-d5c5bd97e2c3",
                                "text": "Gebhards kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
