                                "example_id": "99005a24-1e01-4f2c-ad24-459a52765607",
                                "sense_id": "2aae7e11-122e-3899-a287-3d287ad0916b",
                                "text": "Ses deux douzaines de cheveux demeurés fidèles se tournaient, se contournaient et se recontournaient sur son crâne pour donner, à une portée de fusil, l’illusion d’un système pileux follement développé."
                            },
                            {
                                "example_id": "93f84a7c-4313-4454-9d4d-718b060d83df",
                                "sense_id": "2aae7e11-122e-3899-a287-3d287ad0916b",
                                "text": "Je sais pas, ça m’a l’air tellement simple à recontourner que je me dis que je dois rater quelque chose."
                            }
                        ]
                    }
