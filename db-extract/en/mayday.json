                            {
                                "example_id": "44f2bfc7-d491-45a6-83a3-3c60cff30c66",
                                "sense_id": "1e148ba2-24b1-3fd1-a811-9fec70caeb52",
                                "text": "\"Odd that she hasn't sent out a Mayday.\"\n\"That is curious. Her radio must be disabled.\""
                            }
                        ]
