                "senses": [
                    {
                        "sense_id": "b7f9da78-79cf-37f7-9bf6-67c21e65c9d2",
                        "entry_id": "9dd52c58-dc43-3f0e-bcf9-a1bf6bafd99f",
                        "glosses": [
                            "Not paid for; appearing in media on its own merits."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "09f50684-967c-4b98-a655-7fb8fa7b42b6",
                                "sense_id": "b7f9da78-79cf-37f7-9bf6-67c21e65c9d2",
                                "text": "Earned media has a number of advantages. It's “free” in the sense that clients are not “billed” for the earned media placement."
                            },
                            {
                                "example_id": "1a639631-0bd2-4ef6-8ef2-3a4c12164fde",
                                "sense_id": "b7f9da78-79cf-37f7-9bf6-67c21e65c9d2",
                                "text": "This chapter will cover four ways in which media and technology partners have infused data into the creative process to work together with marketers: 1) in paid and earned advertising (including social media) […]"
                            },
                            {
                                "example_id": "f1ae528c-88f9-473c-bbe9-7c1595bd4dfa",
                                "sense_id": "b7f9da78-79cf-37f7-9bf6-67c21e65c9d2",
                                "text": "Ben & Jerry's flexed its brand authority regarding these missions when it took a public stand with the Black Lives Matter movement (witnessed on all of its owned media) at the same time it launched its newest line of flavors to get the greatest amount of earned coverage possible."
                            }
                        ]
                    }
