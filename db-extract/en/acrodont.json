                "senses": [
                    {
                        "sense_id": "b2680fbc-6a4e-339f-b0b9-984c8767692e",
                        "entry_id": "b82fca11-70e7-3413-9ea4-12bfbb2b8fbf",
                        "glosses": [
                            "Having teeth immovably united to the top of the alveolar ridge."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "cb68220e-0465-4110-b861-fe56b286b95e",
                                "sense_id": "b2680fbc-6a4e-339f-b0b9-984c8767692e",
                                "text": "Pleurodont lizards are such as have the teeth attached by their sides {148} to the inner surface of the jaw, in contradistinction to acrodont lizards, which have the bases of their teeth anchylosed to the summit of the margin of the jaw."
                            },
                            {
                                "example_id": "815a86b3-42eb-4d3e-b55e-e92ae505e385",
                                "sense_id": "b2680fbc-6a4e-339f-b0b9-984c8767692e",
                                "text": "The known skeletal remains of Longisquama lack any other diagnostic archosaurian characters [the furcula mentioned by Jones et al. consists of paired clavicles, as Sharov originally noted], but they exhibit two features, acrodont teeth and an interclavicle ( 3 ), that are typical of lepidosaurs."
                            }
                        ]
                    }
