                ],
                "senses": [
                    {
                        "sense_id": "3139135f-0865-33b0-896f-1251bc67d1f7",
                        "entry_id": "92539da6-7728-3821-b091-1cc7ae3c37af",
                        "glosses": [
                            "Enlever son caractère anthropologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a6b027-9fde-4a10-8e2a-ecb762efee8e",
                                "sense_id": "3139135f-0865-33b0-896f-1251bc67d1f7",
                                "text": "Les analyses consacrées à la question de l’origine répondent à un double souci : d’une part, « dés-anthropologiser » la question de la technique, ce qui exige une reprise de la question de l’anthropologie ; (…)"
                            },
                            {
                                "example_id": "c4cb90bf-c5e9-4ff8-9901-8933ce745469",
                                "sense_id": "3139135f-0865-33b0-896f-1251bc67d1f7",
                                "text": "La détermination du divin est alors dés-anthropologisée : échappant aux caprices, aux désirs, aux passions, les dieux comme intellects purs et volontés pures soutiennent l’ordre du monde."
                            }
                        ]
                    }
