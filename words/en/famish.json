{
    "word_family": [
        "famished",
        "famishment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7111c736-aa43-33df-bf6c-55f8c17f8599",
                    "sense_definition": "To suffer from extreme hunger or become weak through lack of food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suffer_hunger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without emergency food supplies, the trapped survivors began to <w>famish</w> in the ruins.",
                            "target_lang_translations": {
                                "ru": "Без экстренных запасов продовольствия оказавшиеся в ловушке выжившие начали <w>голодать</w> среди руин."
                            }
                        },
                        {
                            "text": "The lost hikers were left to <w>famish</w> in the mountains before rescuers finally found them.",
                            "target_lang_translations": {
                                "ru": "Заблудившиеся туристы были обречены <w>изнемогать от голода</w> в горах, пока их наконец не нашли спасатели."
                            }
                        }
                    ],
                    "synonyms": [
                        "starve"
                    ],
                    "antonyms": [
                        "feast"
                    ],
                    "common_phrases": [
                        "left to famish"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "More commonly encountered as the participial adjective 'famished'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Страдать от сильного голода, изнемогать от недоедания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голодать",
                                "target_lang_sense_clarification": "испытывать сильный голод"
                            },
                            {
                                "target_lang_word": "изнемогать от голода",
                                "target_lang_sense_clarification": "ослабевать от недоедания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "535dcd58-f497-30c6-9094-469cb673d81b",
                    "sense_definition": "To cause someone to suffer extreme hunger or weakness from lack of food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cause_hunger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh winter threatened to <w>famish</w> the entire village before spring arrived.",
                            "target_lang_translations": {
                                "ru": "Суровая зима грозила <w>заморить голодом</w> всю деревню еще до наступления весны."
                            }
                        },
                        {
                            "text": "Cruel captors would intentionally <w>famish</w> prisoners to break their resistance.",
                            "target_lang_translations": {
                                "ru": "Жестокие тюремщики намеренно <w>морили голодом</w> заключенных, чтобы сломить их сопротивление."
                            }
                        }
                    ],
                    "synonyms": [
                        "starve"
                    ],
                    "antonyms": [
                        "feed",
                        "nourish"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used transitively, modern usage prefers 'starve'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрекать на голод, морить кого-либо голодом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морить голодом",
                                "target_lang_sense_clarification": "лишать пищи, заставлять голодать"
                            },
                            {
                                "target_lang_word": "голодом изнурять",
                                "target_lang_sense_clarification": "мучить недостатком пищи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3339d875-66ce-3b04-af3f-ba876ebb2482",
                    "sense_definition": "To kill or cause to die from starvation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cause_hunger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel tyrant sought to <w>famish</w> his political opponents in deep dungeons.",
                            "target_lang_translations": {
                                "ru": "Жестокий тиран стремился <w>уморить голодом</w> своих политических противников в глубоких темницах."
                            }
                        },
                        {
                            "text": "A prolonged blockade was engineered to <w>famish</w> the garrison into submission.",
                            "target_lang_translations": {
                                "ru": "Длительная блокада была спланирована так, чтобы <w>уморить</w> гарнизон <w>голодом</w> и принудить его к покорности."
                            }
                        }
                    ],
                    "synonyms": [
                        "starve"
                    ],
                    "common_phrases": [
                        "famish to death"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Largely superseded by 'starve to death'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уморить до смерти голодом, погубить недостатком пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уморить голодом",
                                "target_lang_sense_clarification": "довести до гибели от голода"
                            },
                            {
                                "target_lang_word": "заморить голодом",
                                "target_lang_sense_clarification": "убить лишением пищи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5cfd821-facd-3198-8c59-3ba4b613efae",
                    "sense_definition": "To die from a complete lack of food; to starve to death.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "suffer_hunger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many abandoned animals simply <w>famish</w> during the harshest months of winter.",
                            "target_lang_translations": {
                                "ru": "Многие брошенные животные просто <w>умирают от голода</w> в самые суровые зимние месяцы."
                            }
                        },
                        {
                            "text": "They feared they would <w>famish</w> before any relief expedition could reach them.",
                            "target_lang_translations": {
                                "ru": "Они боялись, что <w>погибнут от голода</w> прежде, чем до них успеет добраться спасательная экспедиция."
                            }
                        }
                    ],
                    "synonyms": [
                        "starve"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Intransitive use meaning to perish of hunger."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умереть от голода, погибнуть от истощения из-за отсутствия пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умирать от голода",
                                "target_lang_sense_clarification": "погибать от истощения"
                            },
                            {
                                "target_lang_word": "умереть голодной смертью",
                                "target_lang_sense_clarification": "погибнуть без еды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4be15cae-c6ee-3563-bc1a-57244a4de450",
                    "sense_definition": "To force, control, or compel someone into an action by withholding food.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The besieging army intended to <w>famish</w> the city into a total surrender.",
                            "target_lang_translations": {
                                "ru": "Осаждающая армия намеревалась <w>взять</w> город <w>измором</w>, добившись полной капитуляции."
                            }
                        },
                        {
                            "text": "He planned to <w>famish</w> the defenders until they had no choice but to open the gates.",
                            "target_lang_translations": {
                                "ru": "Он планировал <w>изморить</w> защитников <w>голодом</w> настолько, чтобы у них не осталось выбора, кроме как открыть ворота."
                            }
                        }
                    ],
                    "common_phrases": [
                        "famish into surrender"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used especially in military or siege contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принудить к чему-либо (например, к сдаче) с помощью голодной блокады или лишения пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взять измором",
                                "target_lang_sense_clarification": "вынудить к капитуляции голодом"
                            },
                            {
                                "target_lang_word": "принудить голодом",
                                "target_lang_sense_clarification": "заставить сдаться нехваткой пищи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f3c28e0-dbb9-3362-aefc-81d84350b1b8",
                    "sense_definition": "To cause severe suffering or death by depriving someone of any essential necessity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deprive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strict regime sought to <w>famish</w> the populace of independent thought and free speech.",
                            "target_lang_translations": {
                                "ru": "Тоталитарный режим стремился <w>лишить</w> народ независимой мысли и свободы слова."
                            }
                        },
                        {
                            "text": "Denying sunlight would slowly <w>famish</w> the delicate plants of vital energy.",
                            "target_lang_translations": {
                                "ru": "Лишение солнечного света постепенно <w>лишило бы</w> нежные растения жизненной энергии."
                            }
                        }
                    ],
                    "synonyms": [
                        "deprive"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used figuratively for non-food deprivation."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать чего-либо жизненно необходимого, морить нехваткой чего-либо (в переносном смысле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морить",
                                "target_lang_sense_clarification": "лишать необходимого ресурса"
                            },
                            {
                                "target_lang_word": "изнурять",
                                "target_lang_sense_clarification": "мучить депривацией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73367401-451f-35a1-9a8e-cd3e2b16dd83",
                    "sense_definition": "To suffer extreme distress or misery from the lack of an essential requirement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deprive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without affection or care, a lonely soul may <w>famish</w> in silence.",
                            "target_lang_translations": {
                                "ru": "Без любви и заботы одинокая душа может молча <w>изнывать</w>."
                            }
                        },
                        {
                            "text": "Deprived of water and care, the neglected garden began to <w>famish</w> under the blazing sun.",
                            "target_lang_translations": {
                                "ru": "Лишенный воды и ухода заброшенный сад начал <w>чахнуть</w> под палящим солнцем."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Figurative intransitive sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно страдать или увядать от острой нехватки чего-то необходимого (в переносном смысле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изнывать",
                                "target_lang_sense_clarification": "страдать от дефицита чего-либо"
                            },
                            {
                                "target_lang_word": "чахнуть",
                                "target_lang_sense_clarification": "увядать от нехватки заботы или ресурсов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}