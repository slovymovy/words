                            {
                                "example_id": "b5adc089-e5e4-4841-a372-2e8f3529bdb3",
                                "sense_id": "ad1b42c7-037b-315c-a7b7-a1258683b8bb",
                                "text": "The missionaries, soon after the restoration was complete, developed a nostalgia for the old days: the past slavings and excesses of the Muslims and Biheans, who had been the major armed aliens in the region, paled in comparison to the Congo Free State's cruel exercise of its monopolies of rubber and ivory as well as its military license."
                            }
                        ]
                    },
                    {
