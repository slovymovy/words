                                                "sense_id": "9c9cf26d-3441-3a81-abd8-d0cfeb637c21",
                                                "text": "Op zijn bureau lagen nog veel onbeantwoorde brieven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "690d40e2-3ddf-3f7d-a5a9-c488d35abdcd",
                                        "entry_id": "8681c10e-452c-34c8-8706-94106d43fcce",
                                        "glosses": [
                                            "van een liefde: dat je verliefd op iemand bent die niet verliefd op jou is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3623e90-17ee-4a09-8c4d-ef5fe80c4208",
                                                "sense_id": "690d40e2-3ddf-3f7d-a5a9-c488d35abdcd",
                                                "text": "De jonge man leed zeer onder de onbeantwoorde liefde die hij voelde voor het mooie meisje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c35d268-b74a-3621-95c0-5bd7962864e2",
                                        "entry_id": "8681c10e-452c-34c8-8706-94106d43fcce",
                                        "glosses": [
                                            "van een probleem: dat er nog geen oplossing voor is gevonden"
                                        ],
                                        "tags": [],
                                        "examples": [
