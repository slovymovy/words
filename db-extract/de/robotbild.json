                "senses": [
                    {
                        "sense_id": "d8f4470c-2f6d-3ccf-af9a-2f1b60b1775b",
                        "entry_id": "0ee4ee0c-0751-3330-a5ba-4855fb4ba515",
                        "glosses": [
                            "Bild eines mutmaßlichen Täters, das anhand von Zeugenaussagen und/oder anderer Informationen (früher manuell, heutzutage per Computerprogramm) erstellt worden ist"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "dc864aea-d047-4b89-b247-7076fe37cf1f",
                                "sense_id": "d8f4470c-2f6d-3ccf-af9a-2f1b60b1775b",
                                "text": "«Bereits im vergangenen April war sämtlichen Polizeistellen der Kantone Zürich und Aargau zur Fahndung nach dem Unbekannten ein Robotbild ausgeteilt worden.»"
                            },
                            {
                                "example_id": "7a55381e-f2eb-41a3-86ee-f9c66e790c1c",
                                "sense_id": "d8f4470c-2f6d-3ccf-af9a-2f1b60b1775b",
                                "text": "«Die Madrider Polizei hat am Sonntag die Robotbilder von zwei Tatverdächtigen veröffentlicht.»"
                            },
                            {
                                "example_id": "d22ce5ea-5b5a-4e46-bf0b-2b6f3f5b1a95",
                                "sense_id": "d8f4470c-2f6d-3ccf-af9a-2f1b60b1775b",
                                "text": "«Die internationale Fahndung nach dem offenbar herumvagabundierenden Mann blieb ohne jedes Ergebnis, trotz künstlich ‹gealterten› Robotbildern mit US-Hilfe.»"
                            },
                            {
                                "example_id": "592eab1b-d748-4350-8f2d-e8e8a02f9e03",
                                "sense_id": "d8f4470c-2f6d-3ccf-af9a-2f1b60b1775b",
                                "text": "«Seit der Veröffentlichung des Robotbildes des Täters vom vergangenen Mittwoch sind bei der Polizei über 500 Hinweise eingegangen.»"
                            },
                            {
                                "example_id": "255ff872-2357-43a6-8c3a-99cbedf3e6e0",
                                "sense_id": "d8f4470c-2f6d-3ccf-af9a-2f1b60b1775b",
                                "text": "«Die Kantonspolizei hat vom mutmasslichen Täter ein Robotbild erstellen können, das auf der Homepage der Polizei (www.police.be.ch) zu finden ist.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
