                ],
                "senses": [
                    {
                        "sense_id": "c285337e-f9a3-3cef-8bca-6d0c43d03891",
                        "entry_id": "395e9499-694e-32fb-b9ca-533d28a71dfc",
                        "glosses": [
                            "Action de manger, ensemble des opérations antérieures à la digestion (préhension, mastication, insalivation, déglutition)."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "95166f84-3c05-4ca6-82a9-3045695d1578",
                                "sense_id": "c285337e-f9a3-3cef-8bca-6d0c43d03891",
                                "text": "La thèse sur la manducation des mues chez les serpents."
                            },
                            {
                                "example_id": "5bb57f9d-cde3-46e2-b953-93a23b527313",
                                "sense_id": "c285337e-f9a3-3cef-8bca-6d0c43d03891",
                                "text": "(Théologie) Manducation de l'hostie. (1541)"
                            },
                            {
                                "example_id": "5f213c8b-71b2-4700-abd0-48c2b4943438",
                                "sense_id": "c285337e-f9a3-3cef-8bca-6d0c43d03891",
                                "text": "Le cannibalisme pratiqué dans la société archaïque était fondé sur la conviction magique que dans la manducation d’un autre humain s'accomplit un transfert de pouvoir."
                            },
                            {
                                "example_id": "cccc4ca5-085c-4d16-9474-8230f0362c39",
                                "sense_id": "c285337e-f9a3-3cef-8bca-6d0c43d03891",
                                "text": "On le voyait manger et la dignité qu’il mettait à la manducation devait plus, sans doute, aux vertus purificatrices du bénédicité qu’à l'odeur de plus en plus surie des aliments du bord."
                            },
                            {
                                "example_id": "ff41603b-b5bd-43f0-b935-af5cf7b589f0",
                                "sense_id": "c285337e-f9a3-3cef-8bca-6d0c43d03891",
                                "text": "Un chrétien qui rompt et mange le pain eucharistique, se livre bien à une activité physique de manducation, qui n'annule pas le goût et l'aspect du pain, mais la finalité alimentaire de l'acte est remplacée par une participation rituelle et symbolique au Corps et à l'Esprit du Christ."
                            }
                        ]
                    }
                ],
