                        ],
                        "examples": [
                            {
                                "example_id": "070c4024-e14e-4c63-808e-767a1921a4d4",
                                "sense_id": "05042112-ded6-354c-9d52-1ee3f727d93d",
                                "text": "Sur la même page, et sous le même titre, les autres séries viennent de types d'emblèmes non anthropomorphes : drapeaux seuls, drapeaux avec écusson RF, drapeaux avec écusson Liberté, Égalité, Fraternité, […]."
                            },
                            {
                                "example_id": "2497f6ef-b884-4bdc-abc0-e40efff16623",
                                "sense_id": "05042112-ded6-354c-9d52-1ee3f727d93d",
                                "text": "Les lettres RF sont peintes en doré sur un fond tricolore ou parfois dorées, mais en relief ou en trompe-l’œil, sur un fond doré."
                            },
                            {
                                "example_id": "e68792cf-bb49-4f6e-ba75-83c883cfcc59",
                                "sense_id": "05042112-ded6-354c-9d52-1ee3f727d93d",
                                "text": "Le type anglais [Document 66] reproduit une Marianne au bonnet entourée de la croix de Lorraine, de l'acronyme RF et de branches d'olivier symbolisant la paix à venir."
                            }
                        ]
                    }
