                    {
                        "translation_id": "10558054-9462-4e17-a1ef-5e07446e381e",
                        "source_entry_id": "4a9b06d6-c53c-33d6-8f4d-693a67af0ce8",
                        "source_sense_id": "2177faa8-36f7-3bfc-953f-96f361be2a7f",
                        "target_lang_word": "au quart de tour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au quart de tour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "686086ca-0afe-3278-9a6f-852e937f9d59",
                                        "entry_id": "f07c22ab-398a-35fe-8eb5-393487bfcfc6",
                                        "glosses": [
                                            "Rapidement et de manière optimale, pour une machine, un élément mécanique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd63f27-f59d-4ef2-ad42-03d956a25ae4",
                                                "sense_id": "686086ca-0afe-3278-9a6f-852e937f9d59",
                                                "text": "En toutes occasions chacune connaissait son rôle et de ce fait le monde pour eux tournait au quart de tour."
                                            },
                                            {
                                                "example_id": "328c350d-7c7d-427f-a604-4b1fe41a4b96",
                                                "sense_id": "686086ca-0afe-3278-9a6f-852e937f9d59",
                                                "text": "Un mécanicien m'aide. Je m'installe. Le moteur part au quart de tour. A trente-cinq kilomètres à l'heure je décolle et l'indicateur de vitesse, le « Badin », m'indique bientôt que ma vitesse de croisière oscille entre quatre-vingt-quinze et cent kilomètres à l'heure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b235dc10-5b3c-3326-a327-62365b986a80",
                                        "entry_id": "f07c22ab-398a-35fe-8eb5-393487bfcfc6",
                                        "glosses": [
                                            "Immédiatement et rapidement, en parlant d’une personne, de ses émotions."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07351013-0358-47e3-9ff8-bda2b2e1d303",
                                                "sense_id": "b235dc10-5b3c-3326-a327-62365b986a80",
                                                "text": "Il réagit au quart de tour lorsqu’il est contrarié, il est mauvais perdant et prend très souvent des décisions de manière impulsive, sans avoir l’air de se soucier de leurs conséquences."
                                            },
                                            {
                                                "example_id": "bdb9f484-8b62-4a9c-8d56-5860eb96c186",
                                                "sense_id": "b235dc10-5b3c-3326-a327-62365b986a80",
                                                "text": "Larry a compris au quart de tour sans en avoir l’air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ae456c7-452c-4958-97fe-456e638cbe1b",
                        "source_entry_id": "4a9b06d6-c53c-33d6-8f4d-693a67af0ce8",
                        "source_sense_id": "2177faa8-36f7-3bfc-953f-96f361be2a7f",
