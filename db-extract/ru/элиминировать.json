                "senses": [
                    {
                        "sense_id": "b904c1db-0776-306d-93f9-06c781082024",
                        "entry_id": "eff483e0-b11c-3230-a507-034fbd065a62",
                        "glosses": [
                            "книжн. удалять (удалить), исключать (исключить), устранять (устранить) что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af5e8f9a-c49b-4aab-9a38-0a1188aab956",
                                "sense_id": "b904c1db-0776-306d-93f9-06c781082024",
                                "text": "В данной книге я хотел бы элиминировать идеологию; идеология юноши будет взята мною «постольку, поскольку»…"
                            }
                        ]
                    },
                    {
                        "sense_id": "08a05fa0-6b9e-369e-b234-bb94751a6d84",
                        "entry_id": "eff483e0-b11c-3230-a507-034fbd065a62",
                        "glosses": [
                            "матем. исключать (исключить) неизвестное из системы уравнений"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6154829-184a-4a21-b477-94544dcc2bdb",
                        "source_entry_id": "eff483e0-b11c-3230-a507-034fbd065a62",
                        "target_lang_word": "eliminate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eliminate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "349dbc2e-1ebe-3a52-81af-a1f67c9cd6f7",
                                        "entry_id": "73c9368f-0c6b-3b79-a6f4-80b34597eb7c",
                                        "glosses": [
                                            "To completely remove, get rid of, put an end to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7f75d12-c2ea-4780-8198-99ae2abf7437",
                                                "sense_id": "349dbc2e-1ebe-3a52-81af-a1f67c9cd6f7",
                                                "text": "The air-handling equipment humidifies, dehumidifies, and distributes the correct amount of fresh air into every zone and eliminates all smoke, dust, and odors, with electric precipitrons."
                                            },
                                            {
                                                "example_id": "c4e0bb70-6502-44dc-a38a-a98fb69bc0e4",
                                                "sense_id": "349dbc2e-1ebe-3a52-81af-a1f67c9cd6f7",
                                                "text": "The real savings of OCR come from the elimination of redundant keyboardings of the same data; from eliminating multiple verification steps; from reducing the number of documents needed to complete a transaction; […]"
                                            },
                                            {
                                                "example_id": "f8bb53a6-259d-43da-9348-cef4fb907445",
                                                "sense_id": "349dbc2e-1ebe-3a52-81af-a1f67c9cd6f7",
                                                "text": "[…] it should be possible to eliminate most of these mental \"costs\" by improving the e-shopping systems."
                                            },
                                            {
                                                "example_id": "44dad9cb-1b58-41b3-9f8b-4cfecafb72af",
                                                "sense_id": "349dbc2e-1ebe-3a52-81af-a1f67c9cd6f7",
                                                "text": "“The Budget proposes eliminating Supporting Effective Instruction (SEI) State Grants (Title II State grants), a program that provides formula funds to States to improve the quality and effectiveness of teachers, principals, and other schools leaders. SEI grants are poorly targeted and funds are spread too thinly to have a meaningful impact on student outcomes."
                                            },
                                            {
                                                "example_id": "b83d8158-93f9-4393-b1b6-56ca9c4f6268",
                                                "sense_id": "349dbc2e-1ebe-3a52-81af-a1f67c9cd6f7",
                                                "text": "Last year, the company eliminated hundreds of jobs and asked some of the remaining staff to take on the responsibilities of those who were let go."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b9e43e0-25de-3643-81c1-ccb14425910e",
                                        "entry_id": "73c9368f-0c6b-3b79-a6f4-80b34597eb7c",
                                        "glosses": [
                                            "To render (a facility) unusable, to destroy it; to disable (a soldier), make them unable to fight (typically but not necessarily by killing)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0532491b-ee60-36b5-8619-d9f2649c7cb3",
                                        "entry_id": "73c9368f-0c6b-3b79-a6f4-80b34597eb7c",
                                        "glosses": [
                                            "To kill (a person or animal)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8922c42-c4c1-4ffe-b866-4da403bd3fe7",
                                                "sense_id": "0532491b-ee60-36b5-8619-d9f2649c7cb3",
                                                "text": "a ruthless mobster who eliminated his enemies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8de15cd-79ed-3334-b485-d22f01276739",
                                        "entry_id": "73c9368f-0c6b-3b79-a6f4-80b34597eb7c",
                                        "glosses": [
                                            "To excrete (waste products)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a923ed81-37e2-43d3-bfc9-f4f0d749c133",
                                                "sense_id": "f8de15cd-79ed-3334-b485-d22f01276739",
                                                "text": "In one study, 65.8% of the cat owners relinquishing a cat thought that their cat eliminated outside the litter box or destroyed furniture to spite them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "178a57cd-14fa-335a-8f9e-26a89609b952",
                                        "entry_id": "73c9368f-0c6b-3b79-a6f4-80b34597eb7c",
                                        "glosses": [
                                            "To exclude (from investigation or from further competition)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5f0c68f-26d4-4275-ba15-2da58fccb3f9",
                                                "sense_id": "178a57cd-14fa-335a-8f9e-26a89609b952",
                                                "text": "Bill was eliminated as a suspect when the police interviewed witnesses."
                                            },
                                            {
                                                "example_id": "19500cc2-0ce6-4b14-8cb9-c1ff42e392c7",
                                                "sense_id": "178a57cd-14fa-335a-8f9e-26a89609b952",
                                                "text": "John was eliminated as a contestant when it was found he had gained, rather than lost, weight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "046bfd7c-3417-31fd-9930-e80310e5f3a7",
                                        "entry_id": "73c9368f-0c6b-3b79-a6f4-80b34597eb7c",
                                        "glosses": [
                                            "To record amounts in a consolidation statement to remove the effects of inter-company transactions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
