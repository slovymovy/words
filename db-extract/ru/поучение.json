                    }
                ],
                "senses": [
                    {
                        "sense_id": "4784331f-ef77-359c-8431-48d71594976e",
                        "entry_id": "b0cd0a71-3d8d-374c-b07d-2d5dc541af7d",
                        "glosses": [
                            "книжн. и разг.-ирон. назидательный совет, наставление Надоели мне твои поучения."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e03da3cf-6106-4439-8800-52cfd89eef21",
                                "sense_id": "4784331f-ef77-359c-8431-48d71594976e",
                                "text": "И твои останки людям милы, и укор, и поученье в них."
                            }
                        ]
                    },
                    {
                        "sense_id": "31687311-c5b7-38db-aa5a-5ccad68e3c11",
                        "entry_id": "b0cd0a71-3d8d-374c-b07d-2d5dc541af7d",
                        "glosses": [
                            "книжн., филол. проповедь, речь, содержащая в себе наставления о жизни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f235273f-2bd8-49b3-86e4-34e2beceac22",
                                "sense_id": "31687311-c5b7-38db-aa5a-5ccad68e3c11",
                                "text": "Поучение Владимира Мономаха."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a191d1b-7600-46a5-9226-2668d9aca81e",
                        "source_entry_id": "b0cd0a71-3d8d-374c-b07d-2d5dc541af7d",
                        "target_lang_word": "sermon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sermon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20d68bb8-6213-3594-9c7d-68d5ab0f221f",
                                        "entry_id": "20131ed6-983d-33fd-b868-669f3d8e6703",
                                        "glosses": [
                                            "Prédication ou discours chrétien, qui est prononcé du haut de la chaire, dans une église, pour instruire et pour exhorter les fidèles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d2da4a5-c9a3-4061-b6d0-38b6d4ce68b7",
                                                "sense_id": "20d68bb8-6213-3594-9c7d-68d5ab0f221f",
                                                "text": "La prédication se faisait tantôt en latin pour les clercs, tantôt en français pour le peuple. C’est dans l’homélie, le sermon, que la langue vulgaire a été employée d’abord, et cet emploi remonte jusqu’au IXᵉ siècle […]"
                                            },
                                            {
                                                "example_id": "6c977052-7cdc-44f3-8248-b03aca1a5b56",
                                                "sense_id": "20d68bb8-6213-3594-9c7d-68d5ab0f221f",
                                                "text": "John Wesley seul prêcha quarante mille sermons et parcourut deux cent cinquante mille milles."
                                            },
                                            {
                                                "example_id": "e3ab9a93-ba54-4331-8add-4f568c986dde",
                                                "sense_id": "20d68bb8-6213-3594-9c7d-68d5ab0f221f",
                                                "text": "Il truffait ses sermons de paraboles modernes, d'images progressistes, magnifiés par sa verve naturelle et mordante et appuyés par un langage coloré qui choquèrent plus d'une grenouille de bénitier et d'une punaise de sacristie, mais que voulez-vous, il faut s'adapter ou périr, et le père Benoît La Poudrière n'avait aucune intention de baisser les bras face aux temps modernes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8807722d-b3ff-3327-b810-2cad0de94099",
                                        "entry_id": "20131ed6-983d-33fd-b868-669f3d8e6703",
                                        "glosses": [
                                            "Remontrance ennuyeuse et importune."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc70c0ef-1d6d-43b3-8f26-01cc62fcdbfc",
                                                "sense_id": "8807722d-b3ff-3327-b810-2cad0de94099",
                                                "text": "Ses assiettes du déjeuner et du dîner furent de nouveau nettoyées à fond, par un procédé de sauçage au morceau de pain qui nous eût valu, à nous, de jolis sermons dans nos familles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2b2825d-7e07-4a73-b4b9-df7bfb6434ea",
                        "source_entry_id": "b0cd0a71-3d8d-374c-b07d-2d5dc541af7d",
                        "target_lang_word": "leçon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leçon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf6e3a0-fbaa-36a6-be84-b3b0346378a7",
                                        "entry_id": "21a55829-cab0-38f6-908a-08520aac9b9c",
                                        "glosses": [
                                            "Petite portion d’une discipline enseignée à un groupe de personnes ou à une seule personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c27f95-6ab9-4260-b09a-9901340ef6d9",
                                                "sense_id": "bcf6e3a0-fbaa-36a6-be84-b3b0346378a7",
                                                "text": "— C’te veine, monologuait-il ! Une classe de gouappée, et moi que j’savais justement pas ma leçon de système métrique. Les mesures de volume, c’est ça qu’est emm… bêtant !"
                                            },
                                            {
                                                "example_id": "7bccbb7f-57e1-4ee0-81e9-a7a5a8a0e40e",
                                                "sense_id": "bcf6e3a0-fbaa-36a6-be84-b3b0346378a7",
                                                "text": "Ce cabinet était la demeure favorite du roi ; c’était là qu’il prenait ses leçons d’escrime avec Pompée, et ses leçons de poésie avec Ronsard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c8b19a4-4216-316c-98e5-a95e4a592d51",
                                        "entry_id": "21a55829-cab0-38f6-908a-08520aac9b9c",
                                        "glosses": [
                                            "Ce que le maître donne à l’écolier à apprendre et que celui-ci doit répéter, généralement par cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc7a2c3-5ba8-4b1f-8e74-e8a471afe50b",
                                                "sense_id": "7c8b19a4-4216-316c-98e5-a95e4a592d51",
                                                "text": "Arsène André étend ce mépris aux méthodes scolaires. […], une pédagogie qui refuse par système le bénéfice éprouvé des leçons sues par cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f726582-3d94-32b0-9c93-6e4475ea4065",
                                        "entry_id": "21a55829-cab0-38f6-908a-08520aac9b9c",
                                        "glosses": [
                                            "Instructions ou conseils donnés à une personne relativement à sa conduite dans la vie ou dans quelque affaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e26b0e95-2b26-4184-a995-c1f0d7be1e31",
                                                "sense_id": "6f726582-3d94-32b0-9c93-6e4475ea4065",
                                                "text": "Cette dépravée, cette aventurière qui vient nous narguer et a le toupet de nous donner des leçons !"
                                            },
                                            {
                                                "example_id": "ee09549c-1681-4fd7-ba28-fa6a0482027a",
                                                "sense_id": "6f726582-3d94-32b0-9c93-6e4475ea4065",
                                                "text": "Place Charles-Surugue, des feldgendarmes apprennent aux Auxerrois à traverser dans les passages cloutés qu'ils semblaient ignorer. C'est une leçon de prévention routière avant la lettre."
                                            },
                                            {
                                                "example_id": "2e5a2c2d-9256-4ced-b03e-8703271e864f",
                                                "sense_id": "6f726582-3d94-32b0-9c93-6e4475ea4065",
                                                "text": "Avant de l’envoyer traiter pour moi de cette affaire, je lui ai fait la leçon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d7a1b44-fae2-3edb-903b-53dd2aa314b3",
                                        "entry_id": "21a55829-cab0-38f6-908a-08520aac9b9c",
                                        "glosses": [
                                            "Avertissement salutaire ou correction qu’on reçoit des personnes ou des choses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18c0fe72-9ddd-410f-b519-48a9fce34206",
                                                "sense_id": "8d7a1b44-fae2-3edb-903b-53dd2aa314b3",
                                                "text": "Louis XVIII […] avait appris et retenu cette leçon : ce qui bouge trop meurt vite, et s'était enfermé dans l'étiquette, les usages râpés et les habitudes hiératiques d'antan."
                                            },
                                            {
                                                "example_id": "cbeb4209-0c89-4a2b-b6c3-b7a6edf12189",
                                                "sense_id": "8d7a1b44-fae2-3edb-903b-53dd2aa314b3",
                                                "text": "Il me parlait malhonnêtement ; mais je lui ai bien fait sa leçon."
                                            },
                                            {
                                                "example_id": "4cd23976-88bc-4161-8b51-2510f21be4b0",
                                                "sense_id": "8d7a1b44-fae2-3edb-903b-53dd2aa314b3",
                                                "text": "Recevoir une leçon."
                                            },
                                            {
                                                "example_id": "a9886b0f-270f-43b4-8ddc-52d1f4bad0ca",
                                                "sense_id": "8d7a1b44-fae2-3edb-903b-53dd2aa314b3",
                                                "text": "Les leçons de l’expérience sont perdues pour la plupart des hommes."
                                            },
                                            {
                                                "example_id": "b3872f21-0b61-499c-b96e-f097f9f3af34",
                                                "sense_id": "8d7a1b44-fae2-3edb-903b-53dd2aa314b3",
                                                "text": "Cet événement a été pour moi une bonne leçon."
                                            },
                                            {
                                                "example_id": "89c99dca-3a45-4c72-8d31-8899ad937c2e",
                                                "sense_id": "8d7a1b44-fae2-3edb-903b-53dd2aa314b3",
                                                "text": "Le théâtre peut offrir des leçons profitables."
                                            },
                                            {
                                                "example_id": "549af202-2680-4864-9077-6913c7e6a2c4",
                                                "sense_id": "8d7a1b44-fae2-3edb-903b-53dd2aa314b3",
                                                "text": "Réciter sa leçon, Répéter fidèlement ce qu’on vous a recommandé de dire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52b2ab15-5003-3ee0-a7b4-e62e5468768d",
                                        "entry_id": "21a55829-cab0-38f6-908a-08520aac9b9c",
                                        "glosses": [
                                            "Texte d’un auteur, par comparaison à une ou plusieurs autres copies du même texte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e81e0fb-314a-42c9-b6bf-f878b5bf669a",
                                                "sense_id": "52b2ab15-5003-3ee0-a7b4-e62e5468768d",
                                                "text": "Il y a deux leçons différentes de ce texte. Voici la bonne leçon. Confronter les diverses leçons d’un passage."
                                            },
                                            {
                                                "example_id": "06c4f6a3-ce95-4196-a333-cf1e2ca7f2f0",
                                                "sense_id": "52b2ab15-5003-3ee0-a7b4-e62e5468768d",
                                                "text": "la leçon de Reiffenberg, dous feiz, est sûrement la bonne"
                                            },
                                            {
                                                "example_id": "86ddbc7b-e638-458d-a347-0141e6b72c67",
                                                "sense_id": "52b2ab15-5003-3ee0-a7b4-e62e5468768d",
                                                "text": "leçon : variante textuelle. Les diverses leçons, ou variantes, ornant quasiment chaque verset (grec) du Nouveau Testament sont une aide précieuse pour qui entend rétrovertir le texte vers son hébreu originel."
                                            },
                                            {
                                                "example_id": "77a4b3ad-3b07-4848-b8c3-c63f78633e80",
                                                "sense_id": "52b2ab15-5003-3ee0-a7b4-e62e5468768d",
                                                "text": "Une fois le collationnement refait, le problème qui se posait était celui de l’interprétation des leçons variantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11e7b884-2a9a-3e44-bff9-cf33aedf91d6",
                                        "entry_id": "21a55829-cab0-38f6-908a-08520aac9b9c",
                                        "glosses": [
                                            "Récit qui diffère d’un autre relatif au même fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3de2b7b-4ff8-4429-bdc5-b7b5fbb70aee",
                                                "sense_id": "11e7b884-2a9a-3e44-bff9-cf33aedf91d6",
                                                "text": "Vous racontez ainsi l’aventure ; mais il y a une autre leçon, une leçon différente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6be113d-2c59-346a-8deb-ef5fb65df1b7",
                                        "entry_id": "21a55829-cab0-38f6-908a-08520aac9b9c",
                                        "glosses": [
                                            "Petit chapitre de l’écriture ou des pères, qui fait partie du bréviaire, et que l’on récite ou que l’on chante à matines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48a94b65-9633-45ab-ae47-8cfb88152125",
                                                "sense_id": "d6be113d-2c59-346a-8deb-ef5fb65df1b7",
                                                "text": "Il y a trois leçons à chaque nocturne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "332d7039-b59e-3e21-b9c9-c9ff6a3bd851",
                                        "entry_id": "21a55829-cab0-38f6-908a-08520aac9b9c",
                                        "glosses": [
                                            "Genre musical créé pour accompagner les leçons (au sens de « textes religieux ») pendant la semaine sainte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baeb3407-4e92-40bd-ab60-b0c819740148",
                                                "sense_id": "332d7039-b59e-3e21-b9c9-c9ff6a3bd851",
                                                "text": "Les leçons de Ténèbres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
