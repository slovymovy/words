                    {
                        "sense_id": "90935381-3963-39f5-8466-1b4ad5c0e9a8",
                        "entry_id": "bd5a6d66-ec90-3113-b11e-dff731e2fc9e",
                        "glosses": [
                            "In a dexterous manner; skillfully; with precision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef4f69bc-8a1f-458e-b611-5699e9a20b04",
                                "sense_id": "90935381-3963-39f5-8466-1b4ad5c0e9a8",
                                "text": "He ducked dexterously, and the stool crashed to its own detriment against the wall."
                            },
                            {
                                "example_id": "3d378e3c-9de7-4c30-baf9-3148b3095d6b",
                                "sense_id": "90935381-3963-39f5-8466-1b4ad5c0e9a8",
                                "text": "Very interested, Dr Grimsby watched the saw follow the fine pencil line on the white pearwood as Peter dexterously twirled the veneers on the fretwork table, timing the movement of both hands precisely to put no strain on either the saw or the wood."
                            }
                        ]
                    }
                ],
