        "fr-extract.jsonl": [
            {
                "entry_id": "3643fa99-1b03-3c90-8bc9-dd1666b33b74",
                "word": "sarclage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8b67b8ed-588a-4e13-ba54-e548ffcb0d9b",
                        "entry_id": "3643fa99-1b03-3c90-8bc9-dd1666b33b74",
                        "tags": [
                            "plural"
                        ],
                        "form": "sarclages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "51a65c05-5282-313b-9798-33296a4abc51",
                        "entry_id": "3643fa99-1b03-3c90-8bc9-dd1666b33b74",
                        "glosses": [
                            "Action de sarcler ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7933c5e1-b5e2-43bd-88b0-ad8664227fec",
                                "sense_id": "51a65c05-5282-313b-9798-33296a4abc51",
                                "text": "L’opération de sarclage consiste essentiellement à sectionner les adventices dans le sol à faible profondeur au moyen de pièces travaillantes tranchantes."
                            },
                            {
                                "example_id": "45cfd58d-b356-4b23-bcba-aaba30f89eb0",
                                "sense_id": "51a65c05-5282-313b-9798-33296a4abc51",
                                "text": "Peu de temps après la levée on donne un sarclage rigoureux, suivi d’un rechargeage très léger, destiné à raffermir les plants qui auraient pu être soulevés ou ébranlés; […]."
                            },
                            {
                                "example_id": "32847ae7-6c16-4239-8f39-d64e83f5225b",
                                "sense_id": "51a65c05-5282-313b-9798-33296a4abc51",
                                "text": "L'ameublissement superficiel du sol fait disparaître cette cause de dessèchement. On l'obtient à l'aide des binages, des serfouissages et des sarclages, ces derniers plus particulièrement destinés à la destruction des plantes adventices."
                            },
                            {
                                "example_id": "48722034-b35e-431f-995f-f9f90149e329",
                                "sense_id": "51a65c05-5282-313b-9798-33296a4abc51",
                                "text": "[…]: il y a plus, c’est que les sarclages et l’arrachement ont nettoyé le sol de toutes les plantes étrangères, […]."
                            },
                            {
                                "example_id": "448102e3-5d95-4404-a69d-4e9090fb0d20",
                                "sense_id": "51a65c05-5282-313b-9798-33296a4abc51",
                                "text": "Dès que le jeune plant s'élève à environ un décimètre, on le débarrasse des mauvaises herbes par un sarclage soigné. On répète ensuite les sarclages, et l'on bine même toutes les fois que l'herbe envahit l’indigotière."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
