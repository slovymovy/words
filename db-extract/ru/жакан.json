                "senses": [
                    {
                        "sense_id": "52d51ebf-e4b4-3b74-a505-0ce3a4401072",
                        "entry_id": "609c87a2-792f-32cd-b987-161879c35584",
                        "glosses": [
                            "охотн. самодельная свинцовая пуля большой убойной силы для стрельбы из гладкоствольного охотничьего ружья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bad67a7-ff3a-42ba-a5b8-95aa6d9b732d",
                                "sense_id": "52d51ebf-e4b4-3b74-a505-0ce3a4401072",
                                "text": "Не мог же он делать какой-нибудь разницы между жаканами и экспрессными штуцерными пулями, ему тоже не видно было, что сзади медведя шёл народ."
                            },
                            {
                                "example_id": "afaf471c-fdef-4e28-bbc4-c509bf3b3036",
                                "sense_id": "52d51ebf-e4b4-3b74-a505-0ce3a4401072",
                                "text": "Жакан — самодельная пуля из свинца — вошел чуть ниже, прошел тело наискосок и вышел сбоку."
                            }
                        ]
                    }
