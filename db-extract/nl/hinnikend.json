                        "glosses": [
                            "bezig zijnd met het maken van paardengeluiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d09ccc1-a645-4ca4-b7ea-a52fa18fd631",
                                "sense_id": "388b4fab-8736-331b-8b65-aba4fc0116ff",
                                "text": "Deze roemruchte historie vormt de grootste attractie van Williamsburg. Speciaal voor de merendeels Amerikaanse bezoekers worden de veldslagen af en toe nagespeeld. Losse flodders, kruitdamp, hinnikende paarden, wapengekletter, hoorngeschal; het hoort er allemaal bij en het levert fantastische foto’s en video’s op."
                            },
                            {
                                "example_id": "8dac3038-7c00-44e2-9347-08d1707acb08",
                                "sense_id": "388b4fab-8736-331b-8b65-aba4fc0116ff",
                                "text": "Mijn zoon wijst naar alles wat hij ziet, klapt en juicht bij elk hinnikend paard langs de kant van de weg."
                            }
                        ]
                    }
