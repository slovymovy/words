                    },
                    {
                        "translation_id": "a5639d65-adaa-4140-b8ce-ac5e067ec2c0",
                        "source_entry_id": "2b34dcfa-bffb-3ccd-b9ff-6be9fc2aaa27",
                        "source_sense_id": "370d08f8-824c-3146-ba24-016f65c2e9ac",
                        "target_lang_word": "sidelight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sidelight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db3cd9b3-359c-3bee-8f72-b971a0ede26b",
                                        "entry_id": "0fa55a94-ee27-37a8-a867-673d36973412",
                                        "glosses": [
                                            "A light found at the side of something; especially of a vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f075274-a4ba-40c5-a2cf-5faf8707cac9",
                                                "sense_id": "db3cd9b3-359c-3bee-8f72-b971a0ede26b",
                                                "text": "If it starts getting misty, put your sidelights on."
                                            },
                                            {
                                                "example_id": "5b0d6b9d-d79d-49d6-96ad-162623e73141",
                                                "sense_id": "db3cd9b3-359c-3bee-8f72-b971a0ede26b",
                                                "text": "After dark the train is a lighted snake, as, even when the passengers' lights are out, each carriage has a side-light in the middle just under the eaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3cbd426-b4c2-3124-961e-5dffc8b443c1",
                                        "entry_id": "0fa55a94-ee27-37a8-a867-673d36973412",
                                        "glosses": [
                                            "A window found at one or both sides of a door."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "895c2469-3444-3292-ab13-3ea107794ad3",
                                        "entry_id": "0fa55a94-ee27-37a8-a867-673d36973412",
                                        "glosses": [
                                            "A piece of incidental information that helps one understand a subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee754c64-5864-49f9-a96d-01fc6f502a9f",
                                                "sense_id": "895c2469-3444-3292-ab13-3ea107794ad3",
                                                "text": "A book of this type is necessarily mainly factual, but it is diversified by many incidents and sidelights which help to give life to a story now accorded its due place in railway history."
                                            },
                                            {
                                                "example_id": "60ee8b2d-2fbe-4e5f-9488-15fb023d34e3",
                                                "sense_id": "895c2469-3444-3292-ab13-3ea107794ad3",
                                                "text": "He is well up to form when dealing with passenger stock, notably Victorian and Edwardian and on this and on East Coast motive power he throws many sidelights."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
