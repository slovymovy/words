                    {
                        "sense_id": "d99003b6-0e7a-3c98-9778-465bcc125fb6",
                        "entry_id": "b1cf4d00-19d1-33b7-b48f-dd342f12e05e",
                        "glosses": [
                            "de geleidelijke verandering door de tijd van soorten organismen"
