                ],
                "senses": [
                    {
                        "sense_id": "9d72db0e-15f8-3a33-9864-72d8da53b8df",
                        "entry_id": "065ba81f-c008-3e25-a479-9d6b4f4c6683",
                        "glosses": [
                            "Gesamtheit der morphologischen Mittel, die eine Sprache zur Verwirklichung der Flexion zur Verfügung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca03a9f9-03d5-48da-a10a-b9b99fa34a2b",
                                "sense_id": "9d72db0e-15f8-3a33-9864-72d8da53b8df",
                                "text": "„Dänisch gehört, wie im übrigen alle festlandsskandinavischen Sprachen, zu den germanischen Sprachen mit der geringsten Flexionsmorphologie.“"
                            },
                            {
                                "example_id": "7cc8c043-e8d5-4ae1-883e-bae09d71e5b6",
                                "sense_id": "9d72db0e-15f8-3a33-9864-72d8da53b8df",
                                "text": "„Vergleichen wir damit die Flexionsmorphologie.“"
                            },
                            {
                                "example_id": "88bc1871-25a1-445d-a810-af9d4ed65108",
                                "sense_id": "9d72db0e-15f8-3a33-9864-72d8da53b8df",
                                "text": "„Die Angaben zur Flexionsmorphologie des (flektierbaren) Lemmazeichens können … in der Zuordnung des behandelten Lemmazeichens zu einer in einer einleitenden Wörterbuchgrammatik beschriebenen morphologischen Klasse oder in einer Zeichen für Zeichen vorgenommenen, in Abkürzungen notierten Einzelbeschreibung bestehen.“"
                            },
                            {
                                "example_id": "8929118f-90b3-43f7-95d8-f94c75c2d3db",
                                "sense_id": "9d72db0e-15f8-3a33-9864-72d8da53b8df",
                                "text": "„Wolfgang Klein (...) hält Flexionsmorphologie generell für entbehrlich, weshalb sie in allen hinreichend bekannten Sprachen der Welt seit Jahrhunderten immer weiter abgebaut werde.“"
                            },
                            {
                                "example_id": "8ebc7294-befe-4c89-8bdd-657c9ac3bbed",
                                "sense_id": "9d72db0e-15f8-3a33-9864-72d8da53b8df",
                                "text": "„Es ist faktisch die Hauptthese der vorliegenden Arbeit, daß die einzelsprachliche Flexionsmorphologie nicht – wie immer angenommen – eine Anhäufung von mehr oder weniger zufälligen Fakten darstellt und demzufolge theoretisch uninteressant ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
