                        ]
                    },
                    {
                        "translation_id": "affd1bc7-649d-4c56-8ae5-7139615b254f",
                        "source_entry_id": "3fec18d7-35c4-30ea-9be1-c3dd75dbd655",
                        "source_sense_id": "2723109d-d8fc-3fad-b72e-14b970c14718",
                        "source_sense_description": "nach hinten, rückwärts hinter sich",
                        "target_lang_word": "en arrière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en arrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21923854-afa4-3a15-a908-1216fa01c928",
                                        "entry_id": "8a4cd926-3f3e-31bb-8c27-f38fc0842ae7",
                                        "glosses": [
                                            "Vers le lieu ou vers le côté qui est derrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6665bdcd-3ef5-450e-9a98-999fb2b78100",
                                                "sense_id": "21923854-afa4-3a15-a908-1216fa01c928",
                                                "text": "[…], les chevaux s’arrêtent net, ployant sur leurs jarrets et rejetant la tête en arrière sous l’action brutale du mors arabe."
                                            },
                                            {
                                                "example_id": "e41987e4-865f-4d3d-9a38-0bc8d1e6539a",
                                                "sense_id": "21923854-afa4-3a15-a908-1216fa01c928",
                                                "text": "Votre coiffure est trop en arrière."
                                            },
                                            {
                                                "example_id": "38ff61f9-feb2-4d4c-a43b-f4023bbbc46a",
                                                "sense_id": "21923854-afa4-3a15-a908-1216fa01c928",
                                                "text": "Penchez-vous un peu en arrière."
                                            },
                                            {
                                                "example_id": "7f373767-d7af-4157-b2ec-edf159a4a024",
                                                "sense_id": "21923854-afa4-3a15-a908-1216fa01c928",
                                                "text": "Il est resté bien loin en arrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b55d1395-801e-399e-9759-b8585a432753",
                                        "entry_id": "8a4cd926-3f3e-31bb-8c27-f38fc0842ae7",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81c94dd9-af7f-49fd-b661-d06c8d586317",
                                                "sense_id": "b55d1395-801e-399e-9759-b8585a432753",
                                                "text": "Cette affaire ne va ni en avant ni en arrière : Elle est toujours dans le même état."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3abf0095-8341-34f0-9e82-ca2a3373e8d2",
                                        "entry_id": "8a4cd926-3f3e-31bb-8c27-f38fc0842ae7",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f98207e-22e0-47d5-b279-42cc2274a669",
                                                "sense_id": "3abf0095-8341-34f0-9e82-ca2a3373e8d2",
                                                "text": "Il me loue en face et me déchire en arrière : Il me déchire quand je suis absent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ffdd11d-064c-39d6-a89e-588e3ceee1e0",
                                        "entry_id": "8a4cd926-3f3e-31bb-8c27-f38fc0842ae7",
                                        "glosses": [
                                            "En retard."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c266084-cc13-4ae9-adba-3325124fa474",
                                                "sense_id": "8ffdd11d-064c-39d6-a89e-588e3ceee1e0",
                                                "text": "Vous êtes bien en arrière, et je crains que votre tâche ne soit pas achevée à temps."
                                            },
                                            {
                                                "example_id": "30fd94c3-f9ea-4f7d-968c-1edc88dfaea0",
                                                "sense_id": "8ffdd11d-064c-39d6-a89e-588e3ceee1e0",
                                                "text": "Ce fermier est toujours en arrière pour ses paiements."
                                            },
                                            {
                                                "example_id": "01b4af59-2f1f-4def-8957-352a359a07af",
                                                "sense_id": "8ffdd11d-064c-39d6-a89e-588e3ceee1e0",
                                                "text": "Il est en arrière de trois termes pour son loyer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e017860-a976-4956-9cd9-b54183da4c85",
                        "source_entry_id": "3fec18d7-35c4-30ea-9be1-c3dd75dbd655",
                        "source_sense_id": "2723109d-d8fc-3fad-b72e-14b970c14718",
                        "source_sense_description": "nach hinten, rückwärts hinter sich",
                        "target_lang_word": "à la renverse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la renverse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cdc4af9-698e-375b-b3b8-18936d5096af",
                                        "entry_id": "2dd37fe1-86d1-3ff8-a319-18ee0c9488d6",
                                        "glosses": [
                                            "Sur le dos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a20a2af-a767-4c36-829d-322a2432c3e5",
                                                "sense_id": "9cdc4af9-698e-375b-b3b8-18936d5096af",
                                                "text": "Le corps de la victime gisait à la renverse sur les dalles, « […]. Il portait à la région hypocondriaque gauche une plaie ronde formée par une balle sortie au milieu de la colonne vertébrale, à la région lombaire. »"
                                            },
                                            {
                                                "example_id": "b54902de-8210-4ef7-b2dd-99653010e42b",
                                                "sense_id": "9cdc4af9-698e-375b-b3b8-18936d5096af",
                                                "text": "Précisément, les héritiers […] vinrent envahir le logis où tout fut bientôt bouleversé. Pendant que le malade scandait à la renverse sur le lit les bouffées d'un souffle de plus en plus oppressé, on discutait au grenier, à la cave, à l'étable à qui reviendrait telle vache, à qui serait dévolu tel ou tel lot de fromage ou de viande."
                                            },
                                            {
                                                "example_id": "867c801d-ce89-4db9-8e77-e2f21e39986e",
                                                "sense_id": "9cdc4af9-698e-375b-b3b8-18936d5096af",
                                                "text": "Ivre-mort, le Dagorn avait buté contre la marche du seuil et s'était allongé à la renverse, la face baignant à demi dans le purin de la cour."
                                            },
                                            {
                                                "example_id": "56278667-56e1-462b-88e3-7d3a999c6098",
                                                "sense_id": "9cdc4af9-698e-375b-b3b8-18936d5096af",
                                                "text": "D'autres filles encore, plus nombreuses, escaladent les grilles, et là c'est la débandade : un gardien tombe à la renverse, une Femen à califourchon sur lui, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb2d960a-f63a-3cac-b71c-7e8e9dd08c39",
                                        "entry_id": "2dd37fe1-86d1-3ff8-a319-18ee0c9488d6",
                                        "glosses": [
                                            "À l’envers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e54c45-4da4-41e1-9f1e-3d6e7adbc4bc",
                                                "sense_id": "cb2d960a-f63a-3cac-b71c-7e8e9dd08c39",
                                                "text": "Elle eut l’impression qu’il s’éloignait d’elle insensiblement, qu’il s’enfonçait à la renverse dans un monde riche, snob et superficiel, où elle ne pourrait jamais le rejoindre."
                                            },
                                            {
                                                "example_id": "dfbfafe0-b246-4d65-8c70-24b2d0d5c6da",
                                                "sense_id": "cb2d960a-f63a-3cac-b71c-7e8e9dd08c39",
                                                "text": "Le serveur réapparut et commença à disposer les chaises à la renverse sur les tables. C'était l'heure de la fermeture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
