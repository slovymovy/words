                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8cd07b6-58a6-385b-9ff3-9d0406da510a",
                        "entry_id": "949970bf-e423-3715-9bad-e38e36e13722",
                        "glosses": [
                            "niepoważne lub kompromitujące zachowanie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba7c78e-be5d-4f15-aaca-37b27e8661b4",
                                "sense_id": "b8cd07b6-58a6-385b-9ff3-9d0406da510a",
                                "text": "Wygłupy na jezdni skończyły się tragedią."
                            },
                            {
                                "example_id": "c06d5430-f74d-4504-85ed-98ab50d76696",
                                "sense_id": "b8cd07b6-58a6-385b-9ff3-9d0406da510a",
                                "text": "Nie lubię tego studenta, nieustannie przerywa mi wykłady wygłupami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b04f45dc-8a35-43a4-b36d-c7a80928d536",
                        "source_entry_id": "949970bf-e423-3715-9bad-e38e36e13722",
                        "source_sense_id": "b8cd07b6-58a6-385b-9ff3-9d0406da510a",
                        "target_lang_word": "antic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b3380c-aa05-349c-aa62-aebcccb2e3de",
                                        "entry_id": "0daab1a1-a8b6-34f6-975c-89bea180ef91",
                                        "glosses": [
                                            "Playful, funny, absurd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2fdd0f-3fee-425f-9210-4314a3f121b1",
                                                "sense_id": "e8b3380c-aa05-349c-aa62-aebcccb2e3de",
                                                "text": "My men like Satyres grazing on the lawnes,\nShall with their Goate feete daunce an antick hay,"
                                            },
                                            {
                                                "example_id": "69b90940-ef04-42e9-bc40-6387eae55c40",
                                                "sense_id": "e8b3380c-aa05-349c-aa62-aebcccb2e3de",
                                                "text": "In recounting the story of Lenny and Eunice in his antic, supercaffeinated prose, Mr. Shteyngart gives us his most powerful and heartfelt novel yet — a novel that performs the delightful feat of mashing up an apocalyptic satire with a genuine supersad true love story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d258407-d3a9-38a2-ab32-b807e07c69c7",
                                        "entry_id": "0daab1a1-a8b6-34f6-975c-89bea180ef91",
                                        "glosses": [
                                            "Grotesque, incongruous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c746411-0727-4968-87fd-c707acbe0a11",
                                                "sense_id": "9d258407-d3a9-38a2-ab32-b807e07c69c7",
                                                "text": "The amusement park environment of seaside resorts such as Venice and the antic eclecticism of Greene & Greene's pre-Craftsman work all preceded the establishment of the movie colony in Hollywood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceec6445-92b1-3206-b7c4-5327555f9e61",
                                        "entry_id": "0daab1a1-a8b6-34f6-975c-89bea180ef91",
                                        "glosses": [
                                            "Grotesque, bizarre"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd6c5235-60f4-47e9-8e25-a651259e74a2",
                                                "sense_id": "ceec6445-92b1-3206-b7c4-5327555f9e61",
                                                "text": "Fetch me my Rapier Boy, what dares the ſlaue / Come hither, couer'd with an antique face, / To fleere and ſcorne at our Solemnitie?"
                                            },
                                            {
                                                "example_id": "2228a513-f6c7-42fb-b7ec-91fb852b8c5b",
                                                "sense_id": "ceec6445-92b1-3206-b7c4-5327555f9e61",
                                                "text": "[…] we all three enter'd the Gate of the Palace between two Rows of Guards, armed and dreſſed after a very antick manner, and ſomething in their Countenances that made my Fleſh creep with a Horror I cannot expreſs."
                                            },
                                            {
                                                "example_id": "07e82ac8-246b-4705-a83c-8cde0a1f5a0f",
                                                "sense_id": "ceec6445-92b1-3206-b7c4-5327555f9e61",
                                                "text": "[…]a fourth would fondly kiss and paw his companions, and sneer in their faces, with a countenance more antic than any in a Dutch droll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b80912-6913-35bb-84cf-4a4db77ac552",
                                        "entry_id": "0daab1a1-a8b6-34f6-975c-89bea180ef91",
                                        "glosses": [
                                            "Obsolete form of antique."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "antic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "518340b6-6f83-320b-86e9-0807d0ef1353",
                                        "entry_id": "764698c8-d906-30e5-9c0a-14c3f3418856",
                                        "glosses": [
                                            "A grotesque representation of a figure; a gargoyle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04d66992-f98f-392f-b337-965743d64ce3",
                                        "entry_id": "764698c8-d906-30e5-9c0a-14c3f3418856",
                                        "glosses": [
                                            "A caricature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                                        "entry_id": "764698c8-d906-30e5-9c0a-14c3f3418856",
                                        "glosses": [
                                            "A ludicrous gesture or act; ridiculous behaviour; caper."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b11029e9-1d1d-4a74-a63d-28d79ba4b46e",
                                                "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                                                "text": "I'm fed up with your constant antics in class. Please behave yourself!"
                                            },
                                            {
                                                "example_id": "1f177fd0-bfe6-40bd-bdf3-87fbe381b0f0",
                                                "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                                                "text": "Two sets of manners, could the youth put on; / And, fraught with antics as the Indian bird / That writhes and chatters in her wiry cage, / Was graceful, when it pleased him, smooth and still / As the mute Swan that floats adown the stream, […]"
                                            },
                                            {
                                                "example_id": "5dc14030-957d-44e4-9b62-001ce6ce1279",
                                                "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                                                "text": "The woman opened the cover now and then, whereupon the kitten would put out its head, and indulge in playful antics."
                                            },
                                            {
                                                "example_id": "4364a55a-954d-43d3-ac83-cbc2401d0f30",
                                                "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                                                "text": "I've 'ad about enough of you and your antics. I been thinking you over, you and your war and your Empire and all the rot of it."
                                            },
                                            {
                                                "example_id": "b9563ea9-06b4-44ee-915d-59bb4caca3f7",
                                                "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                                                "text": "Toad ceased his frivolous antics at once. He became grave and depressed, and a dull pain in the lower part of his spine, communicating itself to his legs, made him want to sit down and try desperately not to think of all the possibilities."
                                            },
                                            {
                                                "example_id": "b3a20ae3-dea9-4201-987a-2a8ae592c190",
                                                "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                                                "text": "She put Rosebud through his paces in the ring, and received her share of applause at the antics of the clever horse."
                                            },
                                            {
                                                "example_id": "ef8b3935-6219-4ee3-a996-180da76fc3d4",
                                                "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                                                "text": "Of their elders some, by imitating the antics of youth, strive to persuade themselves that their day is not yet over; they shout with the lustiest, but the war cry sounds hollow in their mouth;[…]"
                                            },
                                            {
                                                "example_id": "5d5a137d-5675-43e4-af9e-40f08078f18a",
                                                "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                                                "text": "I saw the barren horror of your people's leisure with the million entertained by the antics of a tiny few […]"
                                            },
                                            {
                                                "example_id": "092dbc29-b364-44bb-b33a-1eae24f0bf94",
                                                "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                                                "text": "Pintsize: Wait, don’t you want to know why I’m tied up and hanging from the ceiling? / Faye: Not really. Nighty night! / Pintsize: Shit! My wacky antics have jumped the shark!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a93d0e95-7ddd-3300-885c-c2c6280dcf17",
                                        "entry_id": "764698c8-d906-30e5-9c0a-14c3f3418856",
                                        "glosses": [
                                            "A grotesque performer or clown, buffoon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "864757fa-7226-4a06-85e7-e69087e017be",
                                                "sense_id": "a93d0e95-7ddd-3300-885c-c2c6280dcf17",
                                                "text": "The Grave-maker, like the professional fools and Falstaff, and like Hamlet himself, is an antic, a grotesque, one who demonstrates to men how foolish and"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "101ab0e8-0de3-3ce2-b5dd-a60e2055a3eb",
                                        "entry_id": "e9fa6c13-d0ea-3d4b-a1c9-be8880b65fb3",
                                        "glosses": [
                                            "To perform antics, to caper."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bbc7255-3582-435b-9a7d-c9a0d0bfb3c6",
                                                "sense_id": "101ab0e8-0de3-3ce2-b5dd-a60e2055a3eb",
                                                "text": "Jerry no more than cocked a contemptuous quizzical eye at the mainsail anticking above him. He knew already the empty windiness of its threats, but he was careful of the mainsheet blocks, and walked around the traveller instead of over it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ee6a6b8-138a-374b-9d32-97bc39398c7e",
                                        "entry_id": "e9fa6c13-d0ea-3d4b-a1c9-be8880b65fb3",
                                        "glosses": [
                                            "To make a fool of, to cause to look ridiculous."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e25386e6-6582-4d34-8024-743796924a1a",
                                                "sense_id": "5ee6a6b8-138a-374b-9d32-97bc39398c7e",
                                                "text": "Gentle lords, let's part; / You see we have burnt our cheeks: strong Enobarb / Is weaker than the wine; and mine own tongue / Splits what it speaks: the wild disguise hath almost / Antick'd us all."
                                            },
                                            {
                                                "example_id": "0fa58c7a-3ac2-4b0d-b2d1-aa9bee54b8a1",
                                                "sense_id": "5ee6a6b8-138a-374b-9d32-97bc39398c7e",
                                                "text": "Whether one's surroundings were anticked up or not, one often felt one was living in another century at Roque."
                                            },
                                            {
                                                "example_id": "05da3233-b10e-47e6-8c33-a08072a2bc64",
                                                "sense_id": "5ee6a6b8-138a-374b-9d32-97bc39398c7e",
                                                "text": "Surtees became a friend of Walter Scott and played a very \"anticking\" joke upon the author."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2a4ccb2-b586-3032-bcf8-d89a190082d2",
                                        "entry_id": "e9fa6c13-d0ea-3d4b-a1c9-be8880b65fb3",
                                        "glosses": [
                                            "To perform (an action) as an antic; to mimic ridiculously."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9deae560-30a5-496c-af98-960b591f53bb",
                                                "sense_id": "e2a4ccb2-b586-3032-bcf8-d89a190082d2",
                                                "text": "She unfastened her dress, her arms arched thin and high, her shadow anticking her movements."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8e52d94-3496-3b27-8dc3-07ee03be4bc8",
                                        "entry_id": "0cae71b2-936e-3226-9ceb-f81b4a275cbb",
                                        "glosses": [
                                            "A pose, often exaggerated, in anticipation of an action; for example, a brief squat before jumping"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38449606-8f02-4b91-8177-175cab005248",
                        "source_entry_id": "949970bf-e423-3715-9bad-e38e36e13722",
                        "source_sense_id": "b8cd07b6-58a6-385b-9ff3-9d0406da510a",
                        "target_lang_word": "foolery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foolery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "784220d3-116e-3d7b-9980-75c78039dccb",
                                        "entry_id": "5c40dd91-ff96-30b3-8bfa-19cea31fb27a",
                                        "glosses": [
                                            "Foolish behaviour or speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8e32489-b80a-4db6-b1d7-4241fe18f36d",
                                                "sense_id": "784220d3-116e-3d7b-9980-75c78039dccb",
                                                "text": "So from that tyme forwarde I began to ſmell the word of god, and forſoke the ſchole doctors and ſuch foolries."
                                            },
                                            {
                                                "example_id": "2be64aed-0e9f-4057-b33f-766d81b1cbfb",
                                                "sense_id": "784220d3-116e-3d7b-9980-75c78039dccb",
                                                "text": "Foolery, sir, does walk about the orb like the sun, it shines every where."
                                            },
                                            {
                                                "example_id": "baf8e0c4-ca0c-4c8c-94aa-8098ea047e34",
                                                "sense_id": "784220d3-116e-3d7b-9980-75c78039dccb",
                                                "text": "A wantonneſſe in wealth, methinks I agree not with, / Tis ſuch a trouble to be married too, / And have a thouſand things of great importance, / Jewells and plates, and fooleries moleſt mee, / To have a mans brains whimſied with his wealth: […]"
                                            },
                                            {
                                                "example_id": "46c9bd24-94e7-4afa-b3de-07f99d4149e7",
                                                "sense_id": "784220d3-116e-3d7b-9980-75c78039dccb",
                                                "text": "Tradesmen and clerks, with fashionable novel-reading families, and circulating-library-subscribing daughters, get up small assemblies in humble imitation of Almack’s, and promenade the dingy ‘large room’ of some second-rate hotel with as much complacency as the enviable few who are privileged to exhibit their magnificence in that exclusive haunt of fashion and foolery."
                                            },
                                            {
                                                "example_id": "c2c428ed-5766-494c-b643-e6169fc8794f",
                                                "sense_id": "784220d3-116e-3d7b-9980-75c78039dccb",
                                                "text": "Though you think, maybe, young men can do their fill of foolery and there is none to blame them."
                                            },
                                            {
                                                "example_id": "8b3739eb-0c66-4bfa-9f35-d5b5dd8496cd",
                                                "sense_id": "784220d3-116e-3d7b-9980-75c78039dccb",
                                                "text": "He […] hurried off to the Centre, took part in the solemn foolery of a 'discussion group' […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
