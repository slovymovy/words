                    {
                        "translation_id": "26c77a87-9905-4d17-a60d-40cde6131c61",
                        "source_entry_id": "abcb2d9d-7d3a-3ca0-ba01-443dd0f96d14",
                        "source_sense_id": "107681ed-9bbd-37a1-b2d1-e13bb55e2096",
                        "target_lang_word": "Karotin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karotin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc78d81d-d85a-33d1-a331-0092e7966b08",
                                        "entry_id": "13ef40f8-3fea-30a5-a037-71fda2c5a464",
                                        "glosses": [
                                            "ein gelber oder roter Farbstoff in Pflanzenzellen, der zugleich eine Vorstufe des Vitamins A bildet"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d03f015-f6c4-4bda-ab02-7dac4bb7dff2",
                                                "sense_id": "cc78d81d-d85a-33d1-a331-0092e7966b08",
                                                "text": "Karotin ist ein Provitamin des spezifisch die Sehfähigkeit beeinflussenden Vitamins A."
                                            },
                                            {
                                                "example_id": "6dc48989-74cf-43ed-aebb-b80ba1bd0e0b",
                                                "sense_id": "cc78d81d-d85a-33d1-a331-0092e7966b08",
                                                "text": "Karotin, Zink und die Vitamine wirken als sogenannte Antioxidantien, die aggressive Sauerstoffverbindungen vernichten."
                                            },
                                            {
                                                "example_id": "5cfb0bf2-e724-45c8-9052-fa5f539c6750",
                                                "sense_id": "cc78d81d-d85a-33d1-a331-0092e7966b08",
                                                "text": "Neben dem Chlorophyll ist in den Blättern auch noch das rot-, orange-, gelbfarbene Karotin vorhanden. Nur wurde das bislang von den farbintensiveren Blattgrünkörperchen verdeckt. Werden sie abgebaut, kommt das Karotin zum Vorschein."
                                            },
                                            {
                                                "example_id": "1bb7a94e-a217-41d1-980b-0dd8426058df",
                                                "sense_id": "cc78d81d-d85a-33d1-a331-0092e7966b08",
                                                "text": "Karotin oder Farbstoffe in der Nahrung färben Dotter kräftig orange."
                                            },
                                            {
                                                "example_id": "9cb1c39a-0ded-4da8-9b4c-8e88b1328f93",
                                                "sense_id": "cc78d81d-d85a-33d1-a331-0092e7966b08",
                                                "text": "Die ernährungsphysiologische Bedeutung des Apfels liegt in seinen wertvollen Inhaltsstoffen. Die Obstsorte ist fett- und cholesterinfrei und enthält Vitamin B1, B2 und C, sowie Beta-Karotin und Kalium."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
