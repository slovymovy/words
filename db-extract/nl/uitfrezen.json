                                        "sense_id": "12b3c79b-c443-3616-8412-c14277997849",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To serve time in prison as an alternative to paying fines."
                                        ],
