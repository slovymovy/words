                                        "entry_id": "0c8c3d39-5aad-3895-b7c1-40bc0a3afaa1",
                                        "glosses": [
                                            "To be impelled or driven forward by the action of wind upon sails, as a ship on water; to be impelled on a body of water by steam or other power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6af4a389-3607-48c5-997b-4e4e70e2b5e9",
                                                "sense_id": "28e3b53b-6ec6-3195-b7aa-4a0b2cb1004d",
                                                "text": "Fair ship, that from the Italian shore,\n⁠Sailest the placid ocean-plains\n⁠With my lost Arthur’s loved remains,\nSpread thy full wings, and waft him o’er."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bf5bba6-cc72-3152-a57c-5dadce745583",
                                        "entry_id": "0c8c3d39-5aad-3895-b7c1-40bc0a3afaa1",
                                        "glosses": [
                                            "To move through or on the water; to swim, as a fish or a waterfowl."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b9222f6-5baf-3b35-85ea-21340b0af981",
                                        "entry_id": "0c8c3d39-5aad-3895-b7c1-40bc0a3afaa1",
                                        "glosses": [
                                            "To ride in a boat, especially a sailboat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15241b9e-bc9b-3c61-8006-a74dd7200190",
                                        "entry_id": "0c8c3d39-5aad-3895-b7c1-40bc0a3afaa1",
                                        "glosses": [
                                            "To set sail; to begin a voyage."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7b5e520-b1c1-4a9a-b80a-4568b57e3c85",
                                                "sense_id": "15241b9e-bc9b-3c61-8006-a74dd7200190",
                                                "text": "We sail for Australia tomorrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ac31712-e3cf-3462-93d2-795627d5c60e",
                                        "entry_id": "0c8c3d39-5aad-3895-b7c1-40bc0a3afaa1",
                                        "glosses": [
                                            "To move briskly and gracefully through the air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be777de2-8b40-43cd-bb39-cb1578145c7e",
                                                "sense_id": "4ac31712-e3cf-3462-93d2-795627d5c60e",
                                                "text": "As is a winged messenger of heaven, […] / When he bestrides the lazy pacing clouds, / And sails upon the bosom of the air."
                                            },
                                            {
                                                "example_id": "0e64b07d-9b89-465c-bf30-f68e5f3767ad",
                                                "sense_id": "4ac31712-e3cf-3462-93d2-795627d5c60e",
                                                "text": "[flavor text of the card \"Spirit of the Winds\"] A spirit of the wind that freely sails the skies."
                                            },
                                            {
                                                "example_id": "fc297aa6-57de-491d-b27b-54d53cc3e547",
                                                "sense_id": "4ac31712-e3cf-3462-93d2-795627d5c60e",
                                                "text": "A hopeful ball from Forest right-back Brendan Moloney to the left edge of the area was met first by Ruddy but his attempted clearance rebounded off Tyson's leg and sailed in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53f05fd7-7dc8-33e6-a442-2343ce0a7bd7",
                                        "entry_id": "0c8c3d39-5aad-3895-b7c1-40bc0a3afaa1",
                                        "glosses": [
                                            "To move briskly but sedately."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf6f45c-a82d-4d33-b82b-0261b8178341",
                                                "sense_id": "53f05fd7-7dc8-33e6-a442-2343ce0a7bd7",
                                                "text": "The duchess sailed haughtily out of the room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6ca1abd-6605-30f4-96bb-b14fc4eb3b29",
                                        "entry_id": "0c8c3d39-5aad-3895-b7c1-40bc0a3afaa1",
                                        "glosses": [
                                            "To deal out (cards) from a distance by impelling them across a surface."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "037d8af0-a21d-4fac-a2ee-4a3f81a64d8e",
                                                "sense_id": "e6ca1abd-6605-30f4-96bb-b14fc4eb3b29",
                                                "text": "He would sit his hat across the room, and we would sail cards into it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
