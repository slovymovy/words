                                                "example_id": "b4663a33-8897-4ad1-9b4e-dd23159a6eb1",
                                                "sense_id": "3e3b7cd8-c205-3576-a20e-3e5a13351516",
                                                "text": "Der Drescher trägt nie die Schals, die die Drescher ihm strickt."
                                            },
                                            {
                                                "example_id": "09029ce6-1ccf-412b-9401-da08f09f81cf",
                                                "sense_id": "3e3b7cd8-c205-3576-a20e-3e5a13351516",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Drescher kommt, geht der Herr Drescher.“"
                                            },
                                            {
                                                "example_id": "e7edbe6e-a311-41c8-9fcc-2adbbde17de9",
                                                "sense_id": "3e3b7cd8-c205-3576-a20e-3e5a13351516",
                                                "text": "Drescher kommt und geht."
                                            },
                                            {
                                                "example_id": "841f3e2b-7ac4-4331-a238-a8ac0dcb4627",
                                                "sense_id": "3e3b7cd8-c205-3576-a20e-3e5a13351516",
                                                "text": "Dreschers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
