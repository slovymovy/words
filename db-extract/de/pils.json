                        "form": "die Pils"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2d27437-c71a-3aaa-b459-0e2d972e3aaf",
                        "entry_id": "5ccd2775-ca1c-3c21-af69-ebfb7340cf1b",
                        "glosses": [
                            "kurz für „Bier nach Pilsener Brauart“, ein untergäriges Bier mit erhöhtem Hopfengehalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3c51cc-03d6-41a9-a56d-73c4047a413c",
                                "sense_id": "a2d27437-c71a-3aaa-b459-0e2d972e3aaf",
                                "text": "Was darf es sein? - Ein Pils bitte."
                            },
                            {
                                "example_id": "07aac9e0-15cb-4da1-a525-6af0ecea5899",
                                "sense_id": "a2d27437-c71a-3aaa-b459-0e2d972e3aaf",
                                "text": "Sollen wir noch ein Pils trinken?"
                            },
                            {
                                "example_id": "71bd54dc-9683-4a32-854d-85724cfc73e9",
                                "sense_id": "a2d27437-c71a-3aaa-b459-0e2d972e3aaf",
                                "text": "Zwischen Leber und Milz passt immer ein Pils."
                            },
                            {
                                "example_id": "17330dec-046f-49ad-8744-bc02f498452c",
                                "sense_id": "a2d27437-c71a-3aaa-b459-0e2d972e3aaf",
                                "text": "„Nach und nach wurde es am Stammtisch enger und ohne zu fragen, erfüllte Herbert die tausendfach geäußerten Wünsche der gewichtigen Herren, die sich wie eh und je mit Pils und Klarem auf die ernsthaften Wirtshausdebatten kommunaler und globaler Politik einstimmten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
