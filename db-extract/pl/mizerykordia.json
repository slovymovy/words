                        ]
                    },
                    {
                        "translation_id": "cd6633a6-e0d4-47a1-bda6-adb52a74fb75",
                        "source_entry_id": "7481a6ae-6d98-3453-80b0-ca6f944f2bbd",
                        "source_sense_id": "881d1c22-52c9-3004-a1eb-3295e7d6b2c4",
                        "target_lang_word": "miséricorde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miséricorde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ae7723c-b5ef-31b2-8305-354ac6bc8488",
                                        "entry_id": "90775eab-13cf-3645-afd4-47ec165fb324",
                                        "glosses": [
                                            "Pitié ; compassion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78bc5353-c4ac-3f0c-96f7-bfe5b5a164db",
                                        "entry_id": "90775eab-13cf-3645-afd4-47ec165fb324",
                                        "glosses": [
                                            "Vertu qui porte à avoir pitié des autres, à avoir compassion des misères d’autrui et à souhaiter les soulager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06398c9b-4c5e-42af-959f-0ea476bece88",
                                                "sense_id": "78bc5353-c4ac-3f0c-96f7-bfe5b5a164db",
                                                "text": "Madeleine frappe à poings fermés comme un homme.\n— Tiens, loup ! Tiens, serpent !… Te voilà basculé, garou !… Ah ! chétif ! je te pilerais sous mes sabots si je n’avais miséricorde !"
                                            },
                                            {
                                                "example_id": "8c8fe164-4c0c-4715-b838-6051353ed445",
                                                "sense_id": "78bc5353-c4ac-3f0c-96f7-bfe5b5a164db",
                                                "text": "J’ai écouté avec patience et miséricorde cet évêque qui comparut un soir à la télévision. Il matagrabolisait tout comme un autre sur les hontes d’une Église en dangereuse régression depuis le concile, et il entassait sans effort les mea culpa sur les autocritiques […]."
                                            },
                                            {
                                                "example_id": "aff51694-29e1-4aa0-aa62-b7c34a0db2ac",
                                                "sense_id": "78bc5353-c4ac-3f0c-96f7-bfe5b5a164db",
                                                "text": "À tout péché miséricorde. J’ai contracté l’habitude de boire dans le Grand Nord, du temps que je naviguais avec les pêcheurs. Quand on est trempé, glacé jusqu’aux moelles, il faut de l’alcool. Pour se frictionner autant que pour boire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb8e7a4f-0a18-3730-81e4-78de6a066d1d",
                                        "entry_id": "90775eab-13cf-3645-afd4-47ec165fb324",
                                        "glosses": [
                                            "Grâce, pardon accordé à ceux que l’on pourrait punir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f59e66c-8628-454e-a31e-1e106bb6f42f",
                                                "sense_id": "cb8e7a4f-0a18-3730-81e4-78de6a066d1d",
                                                "text": "Demander miséricorde, obtenir miséricorde."
                                            },
                                            {
                                                "example_id": "978825a7-919e-4210-9d5b-4ecdcaf78cc0",
                                                "sense_id": "cb8e7a4f-0a18-3730-81e4-78de6a066d1d",
                                                "text": "Maintenant, voici ce que je demande : quand vous aurez trouvé madame votre mère, obtenez de la duchesse d'Angoulême un mot de miséricorde pour le nain qui l'a trahie à Orléans !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1f739e-35c8-38a2-8d06-aa1c642cc5b2",
                                        "entry_id": "90775eab-13cf-3645-afd4-47ec165fb324",
                                        "glosses": [
                                            "Bonté par laquelle Dieu fait grâce aux hommes, aux pécheurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59a948ff-67f7-4b43-8f6e-bffb5bb467d9",
                                                "sense_id": "1a1f739e-35c8-38a2-8d06-aa1c642cc5b2",
                                                "text": "La miséricorde de Dieu, la miséricorde divine est la bonté par laquelle Dieu fait grâce aux hommes, aux pécheurs."
                                            },
                                            {
                                                "example_id": "31563930-5fde-4016-aacd-0b726cf11f0a",
                                                "sense_id": "1a1f739e-35c8-38a2-8d06-aa1c642cc5b2",
                                                "text": "Pippo. – Dieu de miséricorde !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "338dc7b7-df73-3744-985e-38c7c3b84988",
                                        "entry_id": "90775eab-13cf-3645-afd4-47ec165fb324",
                                        "glosses": [
                                            "Petite saillie de bois fixée sous le siège d’une stalle et où on peut se reposer légèrement tout en gardant la position verticale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b90179b-15f9-4a8a-9c47-b489649abda4",
                                                "sense_id": "338dc7b7-df73-3744-985e-38c7c3b84988",
                                                "text": "Dans le décor des miséricordes, autrefois simple, les huchiers donnent libre cours à leur fantaisie, les groupes sculptés n’ont pas toujours un caractère religieux, la tendance de l’époque au réalisme stimule l’humour et la verve satirique des artistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4aaca13-26e3-3d2a-83a4-0ecf207ca583",
                                        "entry_id": "90775eab-13cf-3645-afd4-47ec165fb324",
                                        "glosses": [
                                            "Tout dispositif permettant un appui ou un repos partiel dans une position debout fixe, hors contexte religieux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8d16ea4-07de-473a-8b5a-479a7e6b3cb4",
                                                "sense_id": "e4aaca13-26e3-3d2a-83a4-0ecf207ca583",
                                                "text": "Homogénéiser les mobiliers et favoriser l’observation naturaliste (miséricorde, ponton d’observation sur l’étang […])"
                                            },
                                            {
                                                "example_id": "6b7579fc-5ca7-44cf-97ea-60c3f7483e24",
                                                "sense_id": "e4aaca13-26e3-3d2a-83a4-0ecf207ca583",
                                                "text": "Il apposa contre le mur, en face, un banc-d’œuvre, surmonté d’un grand dais à jour garni de miséricordes sculptées en plein bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "100e043d-d2af-363b-b7fa-f4d2a58ff8e0",
                                        "entry_id": "90775eab-13cf-3645-afd4-47ec165fb324",
                                        "glosses": [
                                            "Dague effilée essentiellement destinée à porter le coup de grâce à un homme à terre."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c8598f7-a190-47e6-94e3-48285741f293",
                                                "sense_id": "100e043d-d2af-363b-b7fa-f4d2a58ff8e0",
                                                "text": "La dague, à lame courte et mince (20 cm), appelée plus tard \"miséricorde\", est employée pour achever un vaincu, ou l'en menacer afin d'obtenir complète reddition."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "miséricorde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5af03083-f604-34a0-9236-5c260825466c",
                                        "entry_id": "97db692d-5434-3a40-8185-f39f20c3d9b7",
                                        "glosses": [
                                            "Exclamation marquant une grande détresse ou un grand découragement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454f562f-fba9-48c8-9b5b-d1dc3e3d1b97",
                                                "sense_id": "5af03083-f604-34a0-9236-5c260825466c",
                                                "text": "– … C’est qu’il y a eu aujourd’hui deux cas bien constatés du choléra asiatique... le véritable choléra-morbus asiatique.\n– Miséricorde ! s’écria madame Guérin.\n– Mon Dieu, mon Dieu ! fit Louise."
                                            },
                                            {
                                                "example_id": "b7cd5494-e0b3-40b1-8bb9-2e6dff3beefa",
                                                "sense_id": "5af03083-f604-34a0-9236-5c260825466c",
                                                "text": "Miséricorde ! quelle horrible odeur de poisson ! On sent tout de suite que la mer fait la fortune de ces îles."
                                            },
                                            {
                                                "example_id": "3834d714-bb02-4b95-9db8-872e4b7c05ff",
                                                "sense_id": "5af03083-f604-34a0-9236-5c260825466c",
                                                "text": "Miséricorde! Quel champ de bataille! Que s'est-il passé?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
