{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "5c24c445-2451-3921-b875-bc13748e8dad",
                    "sense_definition": "Formule dont on use en prenant congé d'une personne que l'on ne pense plus revoir ou pas avant très longtemps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Adieu</w>, mon vieil ami, nous ne nous reverrons sans doute jamais plus."
                        },
                        {
                            "text": "Sur le quai, elle agita la main en criant : « <w>Adieu</w> pour toujours ! »"
                        }
                    ],
                    "common_phrases": [
                        "dire adieu",
                        "adieu pour toujours"
                    ]
                },
                {
                    "sense_id": "2efd1e95-0651-3923-b489-a96e2b22deaf",
                    "sense_definition": "Formule employée pour exprimer la fin irrévocable, la perte ou la destruction imminente d'une chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si nous perdons ce contrat important, alors <w>adieu</w> nos projets de vacances."
                        },
                        {
                            "text": "Une seule maladresse de sa part et <w>adieu</w> la belle réputation du restaurant."
                        }
                    ],
                    "common_phrases": [
                        "adieu les vacances",
                        "adieu les espoirs"
                    ]
                },
                {
                    "sense_id": "f0964d03-b25d-3c47-828c-8d1d3f6901d8",
                    "sense_definition": "Formule employée pour prendre congé au quotidien, sans impliquer une séparation définitive.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois partir maintenant, alors <w>adieu</w> et à demain au bureau !"
                        },
                        {
                            "text": "En quittant la boulangerie, la vieille dame a lancé : « <w>Adieu</w>, à tout à l'heure ! »"
                        }
                    ],
                    "synonyms": [
                        "au revoir",
                        "salut",
                        "ciao",
                        "tchao"
                    ],
                    "common_phrases": [
                        "adieu à demain",
                        "adieu et à bientôt"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Principalement utilisé en Suisse romande et dans le Midi de la France"
                        }
                    ]
                },
                {
                    "sense_id": "1c482855-6f71-39a1-9b7a-8f08b58ef954",
                    "sense_definition": "Salutation amicale employée au moment de rencontrer quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Adieu</w>, comment vas-tu depuis notre dernière rencontre au village ?"
                        },
                        {
                            "text": "En franchissant la porte du café, il a crié <w>adieu</w> à tous ses amis."
                        }
                    ],
                    "synonyms": [
                        "bonjour",
                        "salut"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Usité en Suisse romande et dans le sud de la France"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad3186d1-28f2-36a1-b036-0159354ba381",
                    "sense_definition": "Action de prendre congé d'une personne ou paroles que l'on prononce à cette occasion, souvent de manière définitive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le diplomate a fait ses <w>adieux</w> officiels avant de quitter définitivement la capitale."
                        },
                        {
                            "text": "Ces touchants <w>adieux</w> sur le quai de la gare ont ému tous les témoins."
                        }
                    ],
                    "synonyms": [
                        "au revoir"
                    ],
                    "antonyms": [
                        "bonjour"
                    ],
                    "common_phrases": [
                        "faire ses adieux",
                        "mot d adieu",
                        "sans adieu"
                    ]
                }
            ]
        }
    ]
}