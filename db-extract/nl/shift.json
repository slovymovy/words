                "senses": [
                    {
                        "sense_id": "a7b90f11-a9e2-3187-be72-2e8e01667b23",
                        "entry_id": "e6bde76a-4e74-382f-8b95-6fdffb603841",
                        "glosses": [
                            "ploeg van een ploegendienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c318778-504b-4e84-a19c-8f68545c3182",
                                "sense_id": "a7b90f11-a9e2-3187-be72-2e8e01667b23",
                                "text": "Initiatiefnemer Katja Heinrich, eigenaar van een evenementenbureau, wilde het jaar beginnen „met iets leuks voor zichzelf”. Het aanvankelijke idee was om het café maar één dag te openen. Omdat de kaarten (met hondje 5 euro en zonder hondje 10 euro) binnen een dag waren uitverkocht, is het evenement uitgebreid naar drie dagen, twee shifts per dag. Per shift van drie uur zijn telkens zo’n vijftig mensen aanwezig en dribbelen er zo’n dertig rimpelige hondjes rond."
                            },
                            {
                                "example_id": "c250d4d2-d431-46aa-8d2c-72304d3f5996",
                                "sense_id": "a7b90f11-a9e2-3187-be72-2e8e01667b23",
                                "text": "Kantoorwerkers en thuiswerkers werkten als team onder dezelfde manager. Ze werkten dezelfde shift en werden gelijk beloond. Het enige verschil was dus de locatie waarin zij hun werk verrichtten."
                            }
                        ]
                    },
                    {
                        "sense_id": "d55e7338-b3c7-3bce-bfd8-f64357b7eac6",
                        "entry_id": "e6bde76a-4e74-382f-8b95-6fdffb603841",
                        "glosses": [
                            "toets op het computertoetsenbord waardoor o.a. hoofdletters kunnen worden getypt"
                        ],
                        "tags": [],
                        "examples": [
                            {
