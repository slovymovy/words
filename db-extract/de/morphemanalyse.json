                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a86455c0-dc4d-4de6-b46a-72be9202be3f",
                                "sense_id": "d66d1699-1d9b-3fcd-9544-29032eec13e4",
                                "text": "Die Morphemanalyse von Wörtern macht manchmal Probleme."
                            },
                            {
                                "example_id": "7cb6d301-1976-4c73-9012-abbabd81555c",
                                "sense_id": "d66d1699-1d9b-3fcd-9544-29032eec13e4",
                                "text": "„Wie bei Phonem- und Morphemanalyse ist auch hier das abstrahierende Zusammenfassen heterogener konkreter Phänomene zu Klassen notwendig.“"
                            },
                            {
                                "example_id": "05b9e816-b485-432c-a5d1-3fb50785e029",
                                "sense_id": "d66d1699-1d9b-3fcd-9544-29032eec13e4",
                                "text": "„Bei der bisherigen Morphemanalyse sind bereits zwei verschiedene Klassen von Morphemen sichtbar geworden.“"
                            }
                        ],
