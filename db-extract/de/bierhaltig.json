                ],
                "senses": [
                    {
                        "sense_id": "6648ec7e-d7bc-38f1-9d24-99cb0933950f",
                        "entry_id": "bee40ba7-1402-38e4-840b-f5a371ef88ee",
                        "glosses": [
                            "Bier enthaltend; mit (viel) Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a56e2620-eaa6-447a-a444-8019f1a48769",
                                "sense_id": "6648ec7e-d7bc-38f1-9d24-99cb0933950f",
                                "text": "„Nach dieser bierhaltigen Nacht mit wunderbarstem Steak brummt mir etwas der Schädel.“"
                            },
                            {
                                "example_id": "1d285d69-be7d-4696-9b24-d9ef5a3e45f7",
                                "sense_id": "6648ec7e-d7bc-38f1-9d24-99cb0933950f",
                                "text": "„Es half nichts, denn seine Nase roch umso intensiver, dass er sich der Quelle des bierhaltigen Atems näherte.“"
                            },
                            {
                                "example_id": "37ec722f-6192-4769-b24f-3d1c2d4e8f3a",
                                "sense_id": "6648ec7e-d7bc-38f1-9d24-99cb0933950f",
                                "text": "„Nicht betroffen sind wein- oder bierhaltige Mischgetränke, weshalb die Hersteller nun auf diese Mischungsart ausweichen.“"
                            },
                            {
                                "example_id": "22911ead-4571-4a15-8399-a6eca248d006",
                                "sense_id": "6648ec7e-d7bc-38f1-9d24-99cb0933950f",
                                "text": "„Der OFw konnte wieder als stolzer Autobesitzer nach Hause fahren und die Soldaten der Spezi hatten einen bierhaltigen Abend und ihre Genugtuung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
