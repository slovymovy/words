                "forms": [],
                "senses": [
                    {
                        "sense_id": "1327b394-6db4-3faf-b0d8-7b5d530b75d0",
                        "entry_id": "18feafef-912b-3795-84fe-6de7ba2264f6",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21248fea-3f4d-422e-903c-f7826254d645",
                                "sense_id": "1327b394-6db4-3faf-b0d8-7b5d530b75d0",
                                "text": "Entourés de vestons-cravates, Girard et moi détonnions dans nos vestes de denim fatiguées, arborées comme par défi à la barbe de cet obscur aréopage de diplomates culturels à la solennité empesée."
                            },
                            {
                                "example_id": "02e31f38-c38b-4f30-8bf0-3861081ab414",
                                "sense_id": "1327b394-6db4-3faf-b0d8-7b5d530b75d0",
                                "text": "\"C’est sûr que c’est une immense déception\", a déclaré le vice-président de l’entreprise basée à Louiseville, Luc Girard, en entrevue à l’émission Toujours le matin."
                            },
                            {
                                "example_id": "9a63880f-f3e9-4ffa-88c4-1d2013311906",
                                "sense_id": "1327b394-6db4-3faf-b0d8-7b5d530b75d0",
                                "text": "Avec : Daniel Leduc, Sophie Raynaud, Théo Dusoulié ou Hermann Marchand, Marguerite Dabrin, Marie-Laure Girard ou Maïlis Jeunesse, Olivier Girard, Frédéric Habéra ou Yves Roux."
                            }
                        ]
                    }
                ],
