                                        "glosses": [
                                            "A country that is heavily involved in the trafficking or production of illegal drugs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f482d563-48b0-4d8c-8d81-8cd5eaaf98e6",
                                                "sense_id": "3a93ec40-4cc3-33fb-9f3d-7cae1669f975",
                                                "text": "But it is time to deprive drug lords, organized crime and narcostates of the huge, tax-free profits realized from illicit drug use in our society."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
