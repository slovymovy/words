                "senses": [
                    {
                        "sense_id": "9ccf4513-eccb-326e-a582-f3f7faed2b38",
                        "entry_id": "ccf54175-9972-3021-920b-31a34d276ec9",
                        "glosses": [
                            "поэт. отличающийся ясным, не затуманенным взором"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "252ff1c6-26ef-421a-aacb-628f07d3bfc9",
                                "sense_id": "9ccf4513-eccb-326e-a582-f3f7faed2b38",
                                "text": "Лицом крестница тоже была хороша: ясноглазая, белозубая."
                            },
                            {
                                "example_id": "a3c47170-c5a1-4fa6-b32b-27c9878d1649",
                                "sense_id": "9ccf4513-eccb-326e-a582-f3f7faed2b38",
                                "text": "То есть он этого толстого, жизнерадостного, розовощёкого и ясноглазого карапуза с его туманным загадочным взором попросту терпеть не мог."
                            }
                        ]
                    }
