                        "sense_id": "8e4f436d-c386-37a1-b9c0-ebc6bf2b67ff",
                        "entry_id": "4a4878cc-3f74-38c6-85f3-68f47e11012c",
                        "glosses": [
                            "waterdichte muts die vooral vrouwen dragen tijdens het zwemmen met als doel de haren droog te houden en bij wedstrijdzwemmer om de weerstand in het water te verminderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81ff98c6-0461-4b5c-bf2c-5cdf350669f5",
                                "sense_id": "8e4f436d-c386-37a1-b9c0-ebc6bf2b67ff",
                                "text": "De waterpoloërs van de beide teams waren te herkennen aan hun badmuts van verschillende kleur."
                            },
                            {
                                "example_id": "a4f65a59-9438-4612-be5a-08efc37b6565",
                                "sense_id": "8e4f436d-c386-37a1-b9c0-ebc6bf2b67ff",
                                "text": "En hoe is het weer hier in de winter eigenlijk?' Het mannetje was onooglijk en had zo weinig haar op zijn hoofd dat het leek of hij een badmuts droeg waar per ongeluk enkele sprietjes gras op waren blijven kleven."
                            }
                        ]
