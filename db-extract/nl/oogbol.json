                                "target_senses": [
                                    {
                                        "sense_id": "ceb68b7d-c385-334b-9878-b95c817c3d12",
                                        "entry_id": "41b8e492-3b63-34b6-afbb-0b08fdaa0870",
                                        "glosses": [
                                            "The ball of the eye."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aecc8da7-abf7-43a9-a784-dc28570c9970",
                                                "sense_id": "ceb68b7d-c385-334b-9878-b95c817c3d12",
                                                "text": "Goe make thy ſelfe like a Nymph o' th' Sea.\nBe ſubiect to no ſight but thine, and mine: inuisible\nTo euery eye-ball elſe: goe take this ſhape,\nAnd hither come in't: goe: hence\nWith diligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d9cf5f9-cf3a-378f-bf37-3203a212c2f6",
                                        "entry_id": "41b8e492-3b63-34b6-afbb-0b08fdaa0870",
                                        "glosses": [
                                            "A person's focus of attention."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ccdcf40-0d3d-3356-b2d5-e17857015cb8",
                                        "entry_id": "41b8e492-3b63-34b6-afbb-0b08fdaa0870",
                                        "glosses": [
                                            "Surveillance."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a680984a-1ece-436f-be72-9d6ffa2188a3",
                                                "sense_id": "1ccdcf40-0d3d-3356-b2d5-e17857015cb8",
                                                "text": "Intelligence work is necessarily limited in scope by the capacity of national surveillance systems. […] Ultimately, it is only when you have an 'eyeball' or the electronic equivalent on a suspect that you have a reasonable chance of a preventive intervention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50d86787-88ed-357c-9a5a-f44669b8219b",
                                        "entry_id": "41b8e492-3b63-34b6-afbb-0b08fdaa0870",
                                        "glosses": [
                                            "A readership or viewership."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d7b7eaa-2918-47fd-803b-e56112b82898",
                                                "sense_id": "50d86787-88ed-357c-9a5a-f44669b8219b",
                                                "text": "We need compelling content for the new Web site so we can attract more eyeballs."
                                            },
                                            {
                                                "example_id": "2d825543-1a1d-4b39-a9b5-ca1c257d7791",
                                                "sense_id": "50d86787-88ed-357c-9a5a-f44669b8219b",
                                                "text": "When The Lord of the Rings: The Rings of Power debuted at the same time as House of the Dragon, much noise was made about which show attracted more eyeballs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5143f76b-059c-3624-bfa8-ebc80f08130b",
                                        "entry_id": "41b8e492-3b63-34b6-afbb-0b08fdaa0870",
                                        "glosses": [
                                            "A face-to-face meeting."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a594b11f-1d74-4ef2-9e45-a19fe5c37e99",
                                                "sense_id": "5143f76b-059c-3624-bfa8-ebc80f08130b",
                                                "text": "We had an eyeball last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47fb84f9-2000-31e5-a885-00613897f2c1",
                                        "entry_id": "41b8e492-3b63-34b6-afbb-0b08fdaa0870",
                                        "glosses": [
                                            "A favourite or pet; the apple of someone's eye."
                                        ],
                                        "tags": [
                                            "Caribbean"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "eyeball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb26d338-3063-34d5-829d-968bfe3f2a94",
                                        "entry_id": "4d11d811-8ab4-3ea0-83dd-b10d86beee34",
                                        "glosses": [
                                            "To gauge, estimate or judge by eye, rather than measuring precisely; to look or glance at."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8de37b19-0d2c-4734-abdb-24b2f5d040a4",
                                                "sense_id": "eb26d338-3063-34d5-829d-968bfe3f2a94",
                                                "text": "A good cook can often just eyeball the correct quantities of ingredients."
                                            },
                                            {
                                                "example_id": "d885760f-361e-4f39-9d09-111d71f942f0",
                                                "sense_id": "eb26d338-3063-34d5-829d-968bfe3f2a94",
                                                "text": "Each geometric construction must be exact; eyeballing it and getting close does not count."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f2d6e71-eef4-371f-9fe3-ad7331697393",
                                        "entry_id": "4d11d811-8ab4-3ea0-83dd-b10d86beee34",
                                        "glosses": [
                                            "To stare at intently."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f820fed0-ae74-46b5-8fd4-04f6270eeb16",
                                                "sense_id": "2f2d6e71-eef4-371f-9fe3-ad7331697393",
                                                "text": "Are you eyeballing my girl?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "245a4286-3fd5-3d0f-943c-f3df95a8d01f",
                                        "entry_id": "4d11d811-8ab4-3ea0-83dd-b10d86beee34",
                                        "glosses": [
                                            "To roll one's eyes."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "945c5bbe-ad0c-4cac-bf94-7d677bf03169",
                                                "sense_id": "245a4286-3fd5-3d0f-943c-f3df95a8d01f",
                                                "text": "Guardiola strode on to the pitch at half-time to remonstrate with the Spanish referee, Antonio Mateu Lahoz, but went too far with his eyeballing and matador-like hand movements. He was “upstairs”, in the Colin Bell stand, to watch Liverpool’s second-half turnaround and a dismal seven days for City take another turn for the worse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
