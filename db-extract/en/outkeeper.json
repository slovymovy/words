                ],
                "senses": [
                    {
                        "sense_id": "67e9a0bb-5249-3943-9425-bdfe1025c0de",
                        "entry_id": "abe813a2-dd9b-3418-9691-80fd1489ee4b",
                        "glosses": [
                            "An attachment to a surveyor's compass for keeping tally in chaining."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f03960a-d80a-4031-bc37-60d0ae7796ec",
                                "sense_id": "67e9a0bb-5249-3943-9425-bdfe1025c0de",
                                "text": "The surveyor kept a record of the number of “outs” sometimes using a counting device called an outkeeper, which was placed on the face of the instrument ."
                            },
                            {
                                "example_id": "91134146-bc62-47f5-aa4d-dcfc69d8e26b",
                                "sense_id": "67e9a0bb-5249-3943-9425-bdfe1025c0de",
                                "text": "This particular instrument is unusual because of the additional dial, and the fact that the outkeeper appears at the east point instead of at the south end of the dial plate."
                            },
                            {
                                "example_id": "9f5f1542-8b5c-477f-9adf-25c8bde4ce9d",
                                "sense_id": "67e9a0bb-5249-3943-9425-bdfe1025c0de",
                                "text": "Some Irish and American instruments were equipped with an “outkeeper,” a dial that helped the surveyor keep track of the number of times (“outs”) a chain had been run."
                            },
                            {
                                "example_id": "0663b6bb-7bb2-4ef3-adea-e09aa304be9a",
                                "sense_id": "67e9a0bb-5249-3943-9425-bdfe1025c0de",
                                "text": "Goldsmith Chandlee placed an outkeeper on his compasses like none other. The outkeeper that Goldsmith Chandlee invented and developed had no equal."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd702827-fb8d-35c3-b5dc-13eeadd3a6a8",
                        "entry_id": "abe813a2-dd9b-3418-9691-80fd1489ee4b",
                        "glosses": [
                            "One who is responsible for maintaining a remote area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6e06d83-ab09-41f9-9d11-dd1ecb6172d5",
                                "sense_id": "cd702827-fb8d-35c3-b5dc-13eeadd3a6a8",
                                "text": "This was a single dwelling, the home of one of the outkeepers."
                            },
                            {
                                "example_id": "2b78b4c1-4d54-42e1-ae73-f7cbb072dc8c",
                                "sense_id": "cd702827-fb8d-35c3-b5dc-13eeadd3a6a8",
                                "text": "My husband David is the 'outkeeper' dealing with all the grounds, gardens, shopping and housekeeping and building related issues,\" says Shirley."
                            },
                            {
                                "example_id": "dc6b1bbd-dfb2-4fef-bbe4-15a7c650a00d",
                                "sense_id": "cd702827-fb8d-35c3-b5dc-13eeadd3a6a8",
                                "text": "When she got to the outkeeper's house, however, Trevelton wasn't there, even though she'd been certain he would be."
                            }
                        ]
                    }
                ],
