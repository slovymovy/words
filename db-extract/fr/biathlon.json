        "fr-extract.jsonl": [
            {
                "entry_id": "66e43967-06dc-3c6f-b4c2-4b367b02664a",
                "word": "biathlon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "05d0fb2a-b3fb-4f51-9a63-023433ea01e0",
                        "entry_id": "66e43967-06dc-3c6f-b4c2-4b367b02664a",
                        "tags": [
                            "plural"
                        ],
                        "form": "biathlons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c42573be-14df-30ff-adfa-1c25db210cec",
                        "entry_id": "66e43967-06dc-3c6f-b4c2-4b367b02664a",
                        "glosses": [
                            "Compétition sportive combinant en alternance du ski de fond et du tir à la carabine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bae3eb52-0a7e-4ec2-a8d6-5cf487656568",
                                "sense_id": "c42573be-14df-30ff-adfa-1c25db210cec",
                                "text": "Cela aurait pu rester ainsi si Martin Fourcade, n’était pas allé plaider auprès des diffuseurs dès 2012 : « J’avais la conviction que mon sport avait du potentiel. Ça cartonnait en Norvège, en Allemagne, en Russie, alors pourquoi pas en France ? Pour continuer à développer le biathlon, il fallait frapper à la porte des chaînes en clair », dit le sextuple champion olympique."
                            },
                            {
                                "example_id": "cd7b73c1-eb0c-4df2-8a44-92c687491348",
                                "sense_id": "c42573be-14df-30ff-adfa-1c25db210cec",
                                "text": "Elle a très bien su gérer la période, rassure Cyril Burdet, l’entraîneur de l'équipe de France féminine de biathlon."
                            },
                            {
                                "example_id": "1b604fa9-8cc7-46cd-9013-578b4c635d8b",
                                "sense_id": "c42573be-14df-30ff-adfa-1c25db210cec",
                                "text": "Celle qui avait gagné la poursuite, la semaine passée en Finlande, prend le maillot jaune de leadeuse de la Coupe du monde de biathlon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da6ce020-d0c3-49f9-be8a-4fd7ea13b96a",
                        "source_entry_id": "66e43967-06dc-3c6f-b4c2-4b367b02664a",
                        "source_sense_id": "c42573be-14df-30ff-adfa-1c25db210cec",
                        "target_lang_word": "Biathlon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biathlon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bed9869-7968-3145-a76e-2dc1fd761a73",
                                        "entry_id": "d11800e6-1a7f-3e15-bbc3-3231244490ea",
                                        "glosses": [
                                            "Wintersportart, bei der die beiden Sportarten Skilanglauf und Schießen verbunden werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bafd8a46-6e18-4481-aa5c-b15533677bad",
                                                "sense_id": "4bed9869-7968-3145-a76e-2dc1fd761a73",
                                                "text": "Das Biathlon ist ein Zweifach-Kampf und gehört zu den Wintersportarten."
                                            },
                                            {
                                                "example_id": "7a6392e5-23eb-47f0-a1de-65d145879d05",
                                                "sense_id": "4bed9869-7968-3145-a76e-2dc1fd761a73",
                                                "text": "Tjark betreibt Biathlon als Hobby."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3bb45601-0d6d-3d18-b9b3-91365cb8e60b",
                                        "entry_id": "d11800e6-1a7f-3e15-bbc3-3231244490ea",
                                        "glosses": [
                                            "Biathlon besteht aus dem Präfix bi- ‚zwei‘, das lateinischen Ursprungs ist, und dem altgriechischen ἆθλον (athlon^☆) ^(→ grc) ‚Wettkampf‘."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Biathlon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6449a7a-e722-36f2-8c1c-17ea30ef7fd5",
                                        "entry_id": "c9b5233c-44e4-3a2c-944d-4748fb56d93e",
                                        "glosses": [
                                            "ein Wettkampf im Biathlon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc7357b0-1ff2-4e9d-ae77-ed19403f2611",
                                                "sense_id": "b6449a7a-e722-36f2-8c1c-17ea30ef7fd5",
                                                "text": "Sven hat schon an fünf Biathlons teilgenommen."
                                            },
                                            {
                                                "example_id": "040b89fa-7209-4660-907d-854723ad64e0",
                                                "sense_id": "b6449a7a-e722-36f2-8c1c-17ea30ef7fd5",
                                                "text": "An unserem Urlaubsort finden während unserer Anwesenheit gleich mehrere Biathlons statt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
