                "senses": [
                    {
                        "sense_id": "3d94dfed-027a-37f0-a089-1a63d9e5d750",
                        "entry_id": "8d94102e-003e-3d9b-86b3-5ba3b686421f",
                        "glosses": [
                            "Rancunier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa2c4f0a-1633-4a68-9cbb-b86aa49b2894",
                                "sense_id": "3d94dfed-027a-37f0-a089-1a63d9e5d750",
                                "text": "Quoique le notaire fût peu rancuneux, il fit partager ses répugnances à bon nombre de familles."
                            },
                            {
                                "example_id": "e623e73b-19e2-4258-896f-5995dbef4b16",
                                "sense_id": "3d94dfed-027a-37f0-a089-1a63d9e5d750",
                                "text": "Il regardait maman avec une ironie d’abord souriante, puis glacée, puis rancuneuse."
                            },
                            {
                                "example_id": "faf06b9c-63dd-4e6b-b1e0-c9213d6e073a",
                                "sense_id": "3d94dfed-027a-37f0-a089-1a63d9e5d750",
                                "text": "Il eut peur et sursauta ; il se tourna vers Ivich. Rancuneuse et distante comme elle était, c’était pourtant son unique secours."
                            },
                            {
                                "example_id": "b7b342e7-c9c7-4b54-9220-a0330785916b",
                                "sense_id": "3d94dfed-027a-37f0-a089-1a63d9e5d750",
                                "text": "Elle se sentait en sécurité avec Jeanne, Marthe, deux ou trois amies pieuses mais compréhensives et qui approuvaient nos mensonges. Elle se méfiait des autres et parlait de certaines d’entre elles d’un ton rancuneux."
                            }
                        ]
                    }
