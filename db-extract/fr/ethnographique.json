        "fr-extract.jsonl": [
            {
                "entry_id": "402eb500-9a8e-33bc-a845-13e9d3994d3f",
                "word": "ethnographique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a4069e8a-66d0-479d-865c-7a35820a2c01",
                        "entry_id": "402eb500-9a8e-33bc-a845-13e9d3994d3f",
                        "tags": [
