            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35d8efc2-a334-3abf-b9a9-a241cf6df228",
                    "sense_definition": "Человек, родившийся под знаком зодиака Козерог (с 22 декабря по 20 января)",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "astrology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат — типичный <w>Козерог</w>, он очень трудолюбивый и ответственный.",
                            "target_lang_translations": {
                                "en": "My brother is a typical <w>Capricorn</w>; he is very hardworking and responsible."
                            }
                        },
                        {
                            "text": "В нашем отделе работают сразу три <w>Козерога</w>, поэтому порядок идеальный.",
                            "target_lang_translations": {
                                "en": "There are three <w>Capricorns</w> working in our department at once, so the order is perfect."
                            }
                        }
                    ],
                    "common_phrases": [
                        "типичный Козерог",
                        "родиться Козерогом"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление для обозначения человека по знаку зодиака"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person born under the astrological sign of Capricorn (between December 22 and January 20)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Capricorn",
                                "target_lang_sense_clarification": "person born under the sign"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8a2ffcd-e091-3efe-ba32-e1aa41ec14ce",
                    "sense_definition": "Дикое парнокопытное млекопитающее рода горных козлов с большими саблевидными рогами; альпийский козёл",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Горный <w>козерог</w> легко и быстро передвигается по крутым скалам.",
                            "target_lang_translations": {
                                "en": "The mountain <w>ibex</w> moves easily and swiftly across steep cliffs."
                            }
                        },
                        {
                            "text": "Рога взрослых <w>козерогов</w> могут достигать более метра в длину.",
                            "target_lang_translations": {
                                "en": "The horns of adult <w>ibexes</w> can reach more than a meter in length."
                            }
                        }
                    ],
                    "synonyms": [
                        "козёл"
                    ],
                    "common_phrases": [
                        "альпийский козерог",
                        "горный козерог"
                    ],
                    "target_lang_definitions": {
                        "en": "A wild cloven-hoofed mammal of the mountain goat genus with large, saber-shaped horns; ibex"
                    },
                    "translations": {
                        "en": [
                            {
