                                        "entry_id": "4f900b56-0130-3103-98bc-afc09e61d751",
                                        "glosses": [
                                            "Rochen mit stark verlängerter, doppelseitig wie ein Sägeblatt gezähnter Schnauze"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4474aea3-49c7-4159-baa2-3bfa40cfd9ed",
                                                "sense_id": "ad2b7345-64cc-3c41-8539-3228e12bbac4",
                                                "text": "Im äußersten Norden Australiens hat ein Tier überlebt, so bizarr in Form und Gestalt, dass es jahrhundertelang für ein Fabelwesen gehalten wurde: der Sägefisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
