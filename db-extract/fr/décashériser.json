                ],
                "senses": [
                    {
                        "sense_id": "dc963df8-7056-3734-b158-9e3f45f81a77",
                        "entry_id": "ed9938b8-9eb1-37d2-9659-d5bec8925b1b",
                        "glosses": [
                            "Faire perdre son caractère casher à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1826b8c-e626-4e52-8004-fdb382fb111d",
                                "sense_id": "dc963df8-7056-3734-b158-9e3f45f81a77",
                                "text": "juif pratiquant, je ne voulais pas que mon logement soit « décashérisé », en quelque sorte."
                            },
                            {
                                "example_id": "0f39c16f-c331-4641-8fac-fa96fa491699",
                                "sense_id": "dc963df8-7056-3734-b158-9e3f45f81a77",
                                "text": "Il raconte notamment comment, pour ne pas « décashériser » la cellule de ses codétenus, il avait été amené à respecter à nouveau les rites religieux et les interdits alimentaires."
                            },
                            {
                                "example_id": "2e6eb619-2861-47e3-b2c5-db75f13ea953",
                                "sense_id": "dc963df8-7056-3734-b158-9e3f45f81a77",
                                "text": "Dommage que nous soyons impurs (nous, les goys) au point de décashériser la nourriture, le vin, ou, au simple touché, salir la vaisselle !"
                            }
                        ]
                    }
                ],
