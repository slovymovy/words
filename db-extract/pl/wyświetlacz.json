                "senses": [
                    {
                        "sense_id": "a2227528-2760-3cf0-8217-ff1ce4c538a4",
                        "entry_id": "59aae233-0a49-3bcc-9a37-cc4cb7bdcc5c",
                        "glosses": [
                            "tablica informacyjna lub moduł urządzenia elektronicznego, który świecąc podaje informacje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde6f598-10f5-4860-91fc-e8c285e4e696",
                                "sense_id": "a2227528-2760-3cf0-8217-ff1ce4c538a4",
                                "text": "W tym filmie czarnoskóry aktor pokazuje pewien napis na wyświetlaczu telefonu, ale tego nie ma w zwiastunie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4c9a7be-f653-4ea6-b0cb-d26bc973aa6d",
                        "source_entry_id": "59aae233-0a49-3bcc-9a37-cc4cb7bdcc5c",
                        "source_sense_id": "a2227528-2760-3cf0-8217-ff1ce4c538a4",
                        "target_lang_word": "display",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "display",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "717b72f5-6053-3a15-8356-5dd8ce46d17c",
                                        "entry_id": "71c1fccc-ecad-3c81-92ed-b779cde06cc7",
                                        "glosses": [
                                            "A show or spectacle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00a5a7d8-9e5c-4833-8277-fd0aa538a939",
                                                "sense_id": "717b72f5-6053-3a15-8356-5dd8ce46d17c",
                                                "text": "The trapeze artist put on an amazing acrobatic display."
                                            },
                                            {
                                                "example_id": "bb8559e2-4df3-4380-9dc8-7e175566f334",
                                                "sense_id": "717b72f5-6053-3a15-8356-5dd8ce46d17c",
                                                "text": "The festival has been popular with locals since it began in 2003. This year, in addition to the skies over the Siying Archway Bridge (西瀛虹橋) near the main town of Makung (馬公市), there will be fireworks displays over the Penghu Sea-Crossing Bridge (跨海大橋) in Paisha Township (白沙鄉) and the Kuanri Recreational Area (觀日遊憩區) in Huhsi Township (湖西鄉)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d98fb6e-6fbd-3a18-8d8e-85b65319fe82",
                                        "entry_id": "71c1fccc-ecad-3c81-92ed-b779cde06cc7",
                                        "glosses": [
                                            "A piece of work to be presented visually."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d284d09-dacd-416b-a410-aba5944a596f",
                                                "sense_id": "3d98fb6e-6fbd-3a18-8d8e-85b65319fe82",
                                                "text": "Pupils are expected to produce a wall display about a country of their choice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72c2e0a-b8f9-330e-b741-73f3203077cb",
                                        "entry_id": "71c1fccc-ecad-3c81-92ed-b779cde06cc7",
                                        "glosses": [
                                            "A device, furniture or marketing-oriented bulk packaging for visual presentation for sales promotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dfa5478-6e0e-342e-90c0-6042cba89cae",
                                        "entry_id": "71c1fccc-ecad-3c81-92ed-b779cde06cc7",
                                        "glosses": [
                                            "An electronic screen that shows graphics or text."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32efe184-ce6d-3da5-8a24-08a75f4284e0",
                                        "entry_id": "71c1fccc-ecad-3c81-92ed-b779cde06cc7",
                                        "glosses": [
                                            "The presentation of information for visual or tactile reception."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "display",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b057ee93-5792-3b50-b486-ef2744ad9997",
                                        "entry_id": "719e6946-0e33-34c2-8b73-10ad0d0200b1",
                                        "glosses": [
                                            "To show conspicuously; to exhibit; to demonstrate; to manifest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4073ab2-91d8-41a4-ab94-b62836c751e3",
                                                "sense_id": "b057ee93-5792-3b50-b486-ef2744ad9997",
                                                "text": "All this was extraordinarily distasteful to Churchill. It was ugly, gross. Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connexion […] such talk had been distressingly out of place."
                                            },
                                            {
                                                "example_id": "ee9680ce-1ba8-4fb0-903f-cd09de01689c",
                                                "sense_id": "b057ee93-5792-3b50-b486-ef2744ad9997",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "807f4e52-3b8c-3f59-99ca-6c26b36a9250",
                                        "entry_id": "719e6946-0e33-34c2-8b73-10ad0d0200b1",
                                        "glosses": [
                                            "To make a display; to act as one making a show or demonstration."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c08967-7077-4708-907e-25c9d60e8f02",
                                                "sense_id": "807f4e52-3b8c-3f59-99ca-6c26b36a9250",
                                                "text": "Being the very fellow which of late / Diſplaid ſo ſawcily againſt your Highneſſe […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fdd0d17-41e5-3aad-939c-8c67633ed073",
                                        "entry_id": "719e6946-0e33-34c2-8b73-10ad0d0200b1",
                                        "glosses": [
                                            "To extend the front of (a column), bringing it into line, deploy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f19a1f78-fede-48d3-a0e5-d8da831d8c33",
                                                "sense_id": "0fdd0d17-41e5-3aad-939c-8c67633ed073",
                                                "text": "The Englishmen[…]display their ranks and[…]press hard upon their enemies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "357d8bf3-df4f-3b29-a98e-3f5d9ed6a05b",
                                        "entry_id": "719e6946-0e33-34c2-8b73-10ad0d0200b1",
                                        "glosses": [
                                            "To make conspicuous by using large or prominent type."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0091087-f121-3a81-bc0d-ddd7bd1ae3a2",
                                        "entry_id": "719e6946-0e33-34c2-8b73-10ad0d0200b1",
                                        "glosses": [
                                            "To discover; to descry."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ed3b0fa-776e-4309-b211-7c457c0fffbd",
                                                "sense_id": "b0091087-f121-3a81-bc0d-ddd7bd1ae3a2",
                                                "text": "And from his seat took pleasure to display / The city so adorned with towers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4a78874-72dd-318b-b5c6-0355d071d746",
                                        "entry_id": "719e6946-0e33-34c2-8b73-10ad0d0200b1",
                                        "glosses": [
                                            "To spread out, to unfurl."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88656c6a-3489-4226-8677-0f0157419e2c",
                                                "sense_id": "b4a78874-72dd-318b-b5c6-0355d071d746",
                                                "text": "The wearie Traueiler, wandring that way, / Therein did often quench his thristy heat, / And then by it his wearie limbes display, / Whiles creeping slomber made him to forget / His former paine [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
