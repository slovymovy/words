                                        "sense_id": "03bea6fc-957b-353f-9146-29eccf72a815",
                                        "entry_id": "8db715b2-a9d8-3a9d-813d-0775f4eec713",
                                        "glosses": [
                                            "jemandem raten, etwas nicht zu tun"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2650b4ae-b69a-4c51-be60-2195b1a56f8c",
                                                "sense_id": "03bea6fc-957b-353f-9146-29eccf72a815",
                                                "text": "Kann das Auswärtige Amt generell von Reisen abraten oder sichere Reiseziele empfehlen?"
                                            },
                                            {
                                                "example_id": "7b2fb342-2ea1-470b-8d93-c686a2d155b6",
                                                "sense_id": "03bea6fc-957b-353f-9146-29eccf72a815",
                                                "text": "»Und auch von der anderen Idee möchte ich dringend abraten.«"
                                            },
                                            {
                                                "example_id": "691e819e-e5e9-453e-a76e-589e2a0c9166",
                                                "sense_id": "03bea6fc-957b-353f-9146-29eccf72a815",
                                                "text": "Statt Mädchen zu fördern und sie mehr für technische Berufe zu begeistern, wird ihnen traurigerweise sogar aktiv davon abgeraten, zeigt eine aktuelle Studie der Fachhochschule Oberösterreich."
                                            },
                                            {
                                                "example_id": "61526dbb-4d5e-44f2-8698-a5434860c9f0",
                                                "sense_id": "03bea6fc-957b-353f-9146-29eccf72a815",
                                                "text": "Vom Geschlechtsverkehr mit Verwandten sowie vom Einzug des Ehebruchpartners in die eheliche Wohnung, so das Gericht, sei aus den genannten Gründen allerdings grundsätzlich abzuraten."
                                            },
                                            {
                                                "example_id": "b4ef99e7-118c-4b5c-8ab0-f2a2d150f063",
                                                "sense_id": "03bea6fc-957b-353f-9146-29eccf72a815",
                                                "text": "Die Lagebeurteilung durch die Kreispolizei im Oktober 2015 fiel vernichtend aus: Eine Flüchtlingsunterkunft in der „Schelde“ von Vogelsang sehe die Polizei als kritisch an und rate daher von einer solchen Einrichtung an diesem Ort ab."
                                            },
                                            {
                                                "example_id": "a4c03f54-e5c3-4dab-b836-f84d11023f87",
                                                "sense_id": "03bea6fc-957b-353f-9146-29eccf72a815",
                                                "text": "In seinen Vorträgen riet er dringend vom Anbau dieser neuen Sorten ab."
                                            },
                                            {
                                                "example_id": "c9d94932-e22b-4376-a851-0f30c92d364a",
                                                "sense_id": "03bea6fc-957b-353f-9146-29eccf72a815",
                                                "text": "Oliver Kahn riet den schwulen Kickern in einem Interview mit der Gala sogar gänzlich von einem Coming out ab: „Ein Spieler, der sich outet, steht jeden Samstag im Stadion vor den gegnerischen Fans.“"
                                            },
                                            {
                                                "example_id": "5765604c-70c4-4c04-9e9b-a145e83079cd",
                                                "sense_id": "03bea6fc-957b-353f-9146-29eccf72a815",
                                                "text": "[Trotz des Coronarisikos] „rät die DGHO Krebspatienten davon ab, eine geplante Krebstherapie zu verschieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
