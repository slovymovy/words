                "senses": [
                    {
                        "sense_id": "09007a4f-1b49-3873-a6f0-90e99cfbf291",
                        "entry_id": "1ddb267a-c057-3ffa-b3d2-8931dd537c4b",
                        "glosses": [
                            "Substanz, die genutzt werden muss, um zwei Kunststoffteile durch Kleben miteinander zu verbinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d689470e-2fc3-46d0-bc44-9f373b96bac5",
                                "sense_id": "09007a4f-1b49-3873-a6f0-90e99cfbf291",
                                "text": "„Vorab muss gesagt werden, dass es keinen universellen Kunststoffkleber für alle Arten von Kunststoffen gibt. Je nach Anwendung muss ein spezieller Klebstoff ausgewählt werden.“"
                            },
                            {
                                "example_id": "5fa81f7b-80cb-4a2e-b446-dcbecc0a1fb1",
                                "sense_id": "09007a4f-1b49-3873-a6f0-90e99cfbf291",
                                "text": "„Bei der Verarbeitung von Kunststoffklebern ist besonders auf eine gute Frischluftzufuhr zu achten.“"
                            },
                            {
                                "example_id": "1e82f0d3-0cf4-4bec-87af-39b695666155",
                                "sense_id": "09007a4f-1b49-3873-a6f0-90e99cfbf291",
                                "text": "„Die Prüfung gilt für Kunststoffkleber, die im Rohrleitungsbau Rohr- bzw. Muffenverbindungen herstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
