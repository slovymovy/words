                        "examples": [
                            {
                                "example_id": "bed00190-82fe-4bcb-a89a-da0673a8a080",
                                "sense_id": "ac991f85-c98c-3935-b5a9-00434caa13a2",
                                "text": "поставить назавтра что-л.",
                                "translation": "để cái gì lại chỗ cũ"
                            },
                            {
                                "example_id": "4da35499-74e6-4a75-a20a-17957b089463",
                                "sense_id": "ac991f85-c98c-3935-b5a9-00434caa13a2",
                                "text": "взять назавтра своё обещание",
                                "translation": "rút lui lời hứa [của mình]"
                            },
                            {
                                "example_id": "39b99436-1848-4e62-a8a6-f84411a05ee3",
                                "sense_id": "ac991f85-c98c-3935-b5a9-00434caa13a2",
                                "text": "взять назавтра свои слова",
                                "translation": "rút lui lời nói (ý kiến) của mình"
                            },
                            {
                                "example_id": "fc3a7764-08d3-4b7b-8fbe-e83edd182707",
                                "sense_id": "ac991f85-c98c-3935-b5a9-00434caa13a2",
                                "text": "отдать что-л. назавтра",
                                "translation": "trả lại cái gì"
                            },
                            {
