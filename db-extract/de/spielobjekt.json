                ],
                "senses": [
                    {
                        "sense_id": "ae55e7a9-077a-34a6-b59b-4525c398282f",
                        "entry_id": "583c465a-6e17-3245-8176-b2e525fc9f93",
                        "glosses": [
                            "Gegenstand, mit dem sich spielen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8015cbcb-7f62-4a9d-a920-51e76af2291c",
                                "sense_id": "ae55e7a9-077a-34a6-b59b-4525c398282f",
                                "text": "„Wenn der Mensch mitspielt und Spielobjekte zum Leben erweckt werden, ist auch der Spielmuffel zu motivieren.“"
                            },
                            {
                                "example_id": "db738193-4330-441a-ba87-b94488239c11",
                                "sense_id": "ae55e7a9-077a-34a6-b59b-4525c398282f",
                                "text": "„Irgendwann tätschelte Ronaldinho das Spielobjekt auf die rechte Seite zu Cincinho, der flankte wieder nach links zu Robinho, dieser legte elegant ab auf Kaka - und der vollendete eine weltmeisterliche Stafette mit einem hübschen Schuss in den rechten Winkel.“"
                            },
                            {
                                "example_id": "35240cdb-946d-495a-822e-a978af1cbd19",
                                "sense_id": "ae55e7a9-077a-34a6-b59b-4525c398282f",
                                "text": "„Dabei wird das Spielobjekt getreten, gepasst oder getragen und der ballführende Spieler fast genauso behandelt: Halten, Wegdrücken und Schieben stören seinen Lauf.“"
                            },
                            {
                                "example_id": "a3f6672e-9e69-4fb7-8384-d4c032d801d1",
                                "sense_id": "ae55e7a9-077a-34a6-b59b-4525c398282f",
                                "text": "„Damit man das Spielobjekt, den Puck, die nicht mal acht Zentimeter große Scheibe aus schwarzem Hartgummi, nachher besser sehen kann, wird eine Zwischenschicht der Eisfläche mit Kalk oder Steinmehl weiß eingefärbt, und es kommen noch die roten und blauen Linien hinzu, mit denen die Torlinie, die Bullykreise und die Spielfelddrittel markiert werden.“"
                            },
                            {
                                "example_id": "1ee02fdc-c7f9-4c5c-9ebd-b75dc2fa3e09",
                                "sense_id": "ae55e7a9-077a-34a6-b59b-4525c398282f",
                                "text": "„Vom Weihnachtskauartikelset über kleine Überraschungspäckchen für Hunde, Katzen und Nager bis hin zum schrägen Spielobjekt (etwa einem Weihnachtsschwein aus Plastik, 17 Zentimeter lang und mit Stimme) reicht das Angebot in den nüchternen Supermärkten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
