                ],
                "senses": [
                    {
                        "sense_id": "a349d35a-97a1-3b66-9135-7c3429af5598",
                        "entry_id": "5bcfe200-c806-340d-b61a-10b2d9332654",
                        "glosses": [
                            "Antépisode, œuvre contant l’histoire de ce qui est arrivé avant l’histoire contée dans une autre œuvre."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "74ec21b0-5240-481f-8191-04600ac31316",
                                "sense_id": "a349d35a-97a1-3b66-9135-7c3429af5598",
                                "text": "Par rapport à Star Wars, épisode IV, les épisodes 5 et 6 sont des suites, et les épisodes 1, 2 et 3 sont des prequels."
                            },
                            {
                                "example_id": "cd7d632b-913f-4687-8453-d21950cb9717",
                                "sense_id": "a349d35a-97a1-3b66-9135-7c3429af5598",
                                "text": "Le premier prequel du film de Kubrick, Doctor Sleep, de Mike Flanagan avec Ewan McGregor sorti en 2019, a tellement floppé que Warner a renoncé à en faire un deuxième."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "833e40e9-f4b7-42a4-a50b-13a8322dab58",
                        "source_entry_id": "5bcfe200-c806-340d-b61a-10b2d9332654",
                        "source_sense_id": "a349d35a-97a1-3b66-9135-7c3429af5598",
                        "target_lang_word": "Vorläufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorläufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd6acfd-b388-3015-bd31-ff4321eb1ef4",
                                        "entry_id": "911a5789-9bbd-396a-9496-3ea380e12a5a",
                                        "glosses": [
                                            "Wegbereiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc2290f7-4599-44fc-b687-e18600c2710b",
                                                "sense_id": "1dd6acfd-b388-3015-bd31-ff4321eb1ef4",
                                                "text": "Die Vorläufer dieser Kunstrichtung waren wenig bekannt."
                                            },
                                            {
                                                "example_id": "51ccbeea-3f2d-43c4-8aac-0c94a2dc5965",
                                                "sense_id": "1dd6acfd-b388-3015-bd31-ff4321eb1ef4",
                                                "text": "„Nein, es war nicht Grimm, sondern Arthur Schopenhauer, der Philosoph des Pessimismus und – als Vorläufer unserer Sprachkritik – natürlich auch ein abgrundtiefer Sprachpessimist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b38b3df1-2a4e-3d9e-b691-5b393547d858",
                                        "entry_id": "911a5789-9bbd-396a-9496-3ea380e12a5a",
                                        "glosses": [
                                            "jemand, der einen Bewerb vor den gewerteten Sportlern bestreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d283ed2a-cb85-415c-998e-8b19b49c308f",
                                                "sense_id": "b38b3df1-2a4e-3d9e-b691-5b393547d858",
                                                "text": "Der Vorläufer startet meist als Testpilot."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5b268fba-226a-3c2b-858d-5f4c7a6ad1fd",
                                        "entry_id": "911a5789-9bbd-396a-9496-3ea380e12a5a",
                                        "glosses": [
                                            "Anfangs- oder Endstreifen eines Gewebebandes"
                                        ],
                                        "tags": [
                                            "Färberwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74930755-dcec-4b86-ba51-553c63755faa",
                                                "sense_id": "5b268fba-226a-3c2b-858d-5f4c7a6ad1fd",
                                                "text": "Die Vorläufer sind meist Ausschussware."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e6ed129c-b710-3880-a1d0-d494db144e5b",
                                        "entry_id": "911a5789-9bbd-396a-9496-3ea380e12a5a",
                                        "glosses": [
                                            "etwas, das einen Teil der Eigenschaften einer später aufkommenden Sache bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba1bd94-7246-4ceb-b0ba-90442fe99eeb",
                                                "sense_id": "e6ed129c-b710-3880-a1d0-d494db144e5b",
                                                "text": "Das Bakelit ist ein Vorläufer der heutigen Polymer-Kunststoffe."
                                            },
                                            {
                                                "example_id": "23cc932c-b491-4d7b-9b2f-14756da9399f",
                                                "sense_id": "e6ed129c-b710-3880-a1d0-d494db144e5b",
                                                "text": "„Die Endung und ihre Vorläufer lassen sich bis ins Althochdeutsche und sogar weiter zurückverfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f52b7ce2-ffbf-495e-bc2f-2a95e8c3c986",
                        "source_entry_id": "5bcfe200-c806-340d-b61a-10b2d9332654",
