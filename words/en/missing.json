{
    "word_family": [
        "miss",
        "missable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a955176d-cebd-39f8-ba8c-dbf4551edcd7",
                    "sense_definition": "Not able to be found because it is lost or misplaced.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lost_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are searching for a <w>missing</w> child.",
                            "target_lang_translations": {
                                "ru": "Полиция ищет <w>пропавшего</w> ребёнка.",
                                "de": "Die Polizei sucht nach einem <w>vermissten</w> Kind.",
                                "zh": "警方正在寻找一名<w>失踪</w>儿童。"
                            }
                        },
                        {
                            "text": "My keys have gone <w>missing</w> again.",
                            "target_lang_translations": {
                                "ru": "Мои ключи снова <w>пропали</w>.",
                                "de": "Meine Schlüssel sind schon wieder <w>verschwunden</w>.",
                                "zh": "我的钥匙又<w>不见</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lost"
                    ],
                    "common_phrases": [
                        "go missing",
                        "missing person",
                        "missing in action"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невозможно найти, так как потеряно или лежит не на месте.",
                        "de": "Nicht auffindbar, weil es verloren gegangen ist oder verlegt wurde.",
                        "zh": "指因丢失或放错地方而无法找到。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропавший",
                                "target_lang_sense_clarification": "исчезнувший; о человеке или предмете"
                            },
                            {
                                "target_lang_word": "потерянный",
                                "target_lang_sense_clarification": "утраченный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "vermisst",
                                "target_lang_sense_clarification": "besonders bei Personen"
                            },
                            {
                                "target_lang_word": "verschwunden",
                                "target_lang_sense_clarification": "allgemein für Gegenstände oder Personen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失踪的",
                                "target_lang_sense_clarification": "指人下落不明"
                            },
                            {
                                "target_lang_word": "丢失的",
                                "target_lang_sense_clarification": "指物品遗失"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b0bcfbd-7751-38c0-9b9a-b1c04d365775",
                    "sense_definition": "Not present or included when it should be.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "absent_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a button <w>missing</w> from my coat.",
                            "target_lang_translations": {
                                "ru": "На моем пальто <w>не хватает</w> пуговицы.",
                                "de": "An meinem Mantel <w>fehlt</w> ein Knopf.",
                                "zh": "我的外套上<w>缺</w>了一颗扣子。"
                            }
                        },
                        {
                            "text": "He finally found the <w>missing</w> piece of the puzzle.",
                            "target_lang_translations": {
                                "ru": "Он наконец нашел <w>недостающий</w> элемент пазла.",
                                "de": "Er hat endlich das <w>fehlende</w> Puzzleteil gefunden.",
                                "zh": "他终于找到了拼图中<w>缺失</w>的那一块。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absent"
                    ],
                    "common_phrases": [
                        "missing link",
                        "missing page",
                        "missing part"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствующий или не включённый туда, где должен быть.",
                        "de": "Nicht vorhanden oder nicht enthalten, obwohl es dort sein sollte.",
                        "zh": "指本应存在或包含在内，但实际上不在。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недостающий",
                                "target_lang_sense_clarification": "о части целого"
                            },
                            {
                                "target_lang_word": "отсутствующий",
                                "target_lang_sense_clarification": "которого нет в наличии"
                            }
                        ],
                        "de": [
