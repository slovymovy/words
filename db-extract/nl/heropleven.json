                "forms": [],
                "senses": [
                    {
                        "sense_id": "0a2caac9-f883-3d03-9f5d-9a5fe31a7fe2",
                        "entry_id": "faf32967-c955-3c7c-acab-264b6a309232",
                        "glosses": [
                            "opnieuw tot bloei komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e14f75de-1864-4354-ae62-ad461e5ff653",
                                "sense_id": "0a2caac9-f883-3d03-9f5d-9a5fe31a7fe2",
                                "text": "Nay is vol lof over de snelheid waarmee Bouterse de zaken aanpakt. De vrees die, gezien Bouterses verleden, bij sommigen heerst over het heropleven van de drugshandel, deelt Nay niet."
                            },
                            {
                                "example_id": "b49ed1a0-258a-4758-a644-5effbc7181f4",
                                "sense_id": "0a2caac9-f883-3d03-9f5d-9a5fe31a7fe2",
                                "text": ",,We willen onze cultuur van walvisjacht laten heropleven”, zegt Kiyoshi Ejima, de burgemeester van Shimonoseki, destijds een stad van walvisjagers. Ook uit zijn haven zijn weer walvisjagers vertrokken."
                            }
                        ]
                    }
                ],
