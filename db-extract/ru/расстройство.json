                            "plural"
                        ],
                        "form": "расстро́йств"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "120d60d9-c5a7-3977-b5dc-6a5faf0d4e3f",
                        "entry_id": "5d224e0b-f829-33ac-a8a0-34555b96f718",
                        "glosses": [
                            "擾亂，失望，沮喪，傷腦筋"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70fc2ce-78a8-4221-a3bc-f256dafe4c65",
                                "sense_id": "120d60d9-c5a7-3977-b5dc-6a5faf0d4e3f",
                                "text": "Проигра́в игру́, я чу́вствовал то́лько расстро́йство.",
                                "translation": "輸掉遊戲後，我只感到失望。"
                            }
                        ]
                    },
                    {
                        "sense_id": "72b3b901-cf9a-3751-9a69-dd85d8930475",
                        "entry_id": "5d224e0b-f829-33ac-a8a0-34555b96f718",
                        "glosses": [
                            "導致上述情況的東西。"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ef515e-59a0-42d1-b3d2-5ebe64835f45",
                                "sense_id": "72b3b901-cf9a-3751-9a69-dd85d8930475",
                                "text": "То что сы́н ма́том руга́ется, э́то коне́чно расстро́йство.",
                                "translation": "當然，我兒子說髒話的事實讓人失望。"
                            }
                        ]
                    },
                    {
                        "sense_id": "04c2bf9a-bea9-358f-80d7-37eb1e91f0b9",
                        "entry_id": "5d224e0b-f829-33ac-a8a0-34555b96f718",
                        "glosses": [
                            "紊亂，錯亂、失調"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "37bf96e7-3dcc-4bae-ade5-384335062ee9",
                                "sense_id": "04c2bf9a-bea9-358f-80d7-37eb1e91f0b9",
                                "text": "Расстро́йство в пото́ке во́здуха над крыло́м мо́жет вы́звать сва́ливание.",
                                "translation": "機翼上的氣流紊亂會導致失速。"
                            }
                        ]
                    },
                    {
                        "sense_id": "e589baab-a34e-359d-953a-854aca19cd08",
                        "entry_id": "5d224e0b-f829-33ac-a8a0-34555b96f718",
                        "glosses": [
                            "混亂"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7c4b2ff-c37c-4c99-b4fa-b74c73260a1a",
                                "sense_id": "e589baab-a34e-359d-953a-854aca19cd08",
                                "text": "посттравмати́ческое стре́ссовое расстро́йство",
                                "translation": "創傷後壓力症"
                            }
                        ]
                    },
                    {
                        "sense_id": "98cd1ff2-fd9e-3dcc-80fc-03c5ad88046e",
                        "entry_id": "5d224e0b-f829-33ac-a8a0-34555b96f718",
                        "glosses": [
                            "走音"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31bbd76c-475c-4dd7-a8da-43a5ffcae40c",
                                "sense_id": "98cd1ff2-fd9e-3dcc-80fc-03c5ad88046e",
                                "text": "Расстро́йство мое́й фле́йты ста́ло заме́тно как то́лько орке́стр на́чал игра́ть.",
                                "translation": "管弦樂隊一開始演奏，我的長笛就明顯走調了。"
                            }
                        ]
                    },
                    {
                        "sense_id": "db738556-5747-35b3-b8fb-d9ca38fae92a",
                        "entry_id": "5d224e0b-f829-33ac-a8a0-34555b96f718",
                        "glosses": [
                            "接收器失調的狀態。"
                        ],
                        "tags": [],
