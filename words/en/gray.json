    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c149fdcf-5baf-3a3e-b7fe-25be4c143093",
                    "sense_definition": "Of a colour between black and white, having a neutral hue and intermediate brightness.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a dark <w>gray</w> suit to the interview.",
                            "target_lang_translations": {
                                "ru": "Он надел темно-<w>серый</w> костюм на собеседование.",
                                "zh": "他穿着一套深<w>灰色</w>的西装去参加面试。"
                            }
                        },
                        {
                            "text": "The sky turned <w>gray</w> just before the storm started.",
                            "target_lang_translations": {
                                "ru": "Небо стало <w>серым</w> прямо перед началом шторма.",
                                "zh": "暴风雨开始前，天空变成了<w>灰色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grey",
                        "silver",
                        "ashen"
                    ],
                    "antonyms": [
                        "black",
                        "white"
                    ],
                    "common_phrases": [
                        "gray hair",
                        "gray suit",
                        "gray eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цвета между черным и белым, имеющего нейтральный оттенок и среднюю яркость.",
                        "zh": "介于黑色和白色之间，具有中性色调和中间亮度的颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серый",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灰色",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "593a9e96-cdd2-3d9a-9b14-c4331964f234",
                    "sense_definition": "Having hair that has turned gray or white, usually due to aging.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hair_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My father started to go <w>gray</w> in his early forties.",
                            "target_lang_translations": {
                                "ru": "Мой отец начал <w>седеть</w> в сорок с небольшим.",
                                "zh": "我父亲四十出头时头发就开始<w>花白</w>了。"
                            }
                        },
                        {
                            "text": "The <w>gray</w> man sat on the park bench feeding the birds.",
                            "target_lang_translations": {
                                "ru": "<w>Седой</w> мужчина сидел на скамейке в парке и кормил птиц.",
                                "zh": "那位<w>花白</w>头发的男人坐在公园长椅上喂鸟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gray-haired",
                        "silver-haired",
                        "white-haired",
                        "grizzled"
                    ],
                    "common_phrases": [
                        "go gray",
                        "turn gray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий волосы, ставшие серыми или белыми, обычно из-за старения.",
                        "zh": "指头发因衰老而变灰或变白。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седой",
                                "target_lang_sense_clarification": "о волосах"
                            },
                            {
                                "target_lang_word": "сивый",
                                "target_lang_sense_clarification": "о волосах, усах или масти животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "花白",
                                "target_lang_sense_clarification": "形容头发"
                            },
                            {
                                "target_lang_word": "灰白",
                                "target_lang_sense_clarification": "形容头发"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfd0a07b-4661-3be4-9b4a-53d80d607cbd",
                    "sense_definition": "Characterized by a lack of cheer, brightness, or interest; dreary or gloomy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mood_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>gray</w> and miserable day with constant rain.",
                            "target_lang_translations": {
                                "ru": "Это был <w>серый</w> и тоскливый день с непрекращающимся дождем.",
                                "zh": "那是一个<w>阴沉</w>而凄惨的日子，雨下个不停。"
                            }
                        },
                        {
                            "text": "She felt trapped in a <w>gray</w> routine of work and sleep.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя в ловушке <w>серой</w> рутины, состоящей из работы и сна.",
                                "zh": "她感到自己被困在工作与睡觉这种<w>沉闷</w>的日常生活中。"
                            }
                        }
                    ],
                    "synonyms": [
