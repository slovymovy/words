        "nl-extract.jsonl": [
            {
                "entry_id": "b167a3b9-38d4-39aa-adec-d0f948735d53",
                "word": "neodymium",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "65135922-926f-3c2f-86f9-1f815bcb7c3e",
                        "entry_id": "b167a3b9-38d4-39aa-adec-d0f948735d53",
                        "glosses": [
                            "scheikundig element met symbool Nd en atoomnummer 60. Het is een geel tot zilverwit lanthanide"
                        ],
                        "tags": [
                            "element"
                        ],
                        "examples": [
                            {
                                "example_id": "f0d2cf75-0ee3-4255-84c4-cbe827673380",
                                "sense_id": "65135922-926f-3c2f-86f9-1f815bcb7c3e",
                                "text": "Neodymium wordt toegepast in lasers en in uiterst sterke magneten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab60c68f-86ab-4a42-bc9a-36772eda4793",
                        "source_entry_id": "b167a3b9-38d4-39aa-adec-d0f948735d53",
                        "source_sense_id": "65135922-926f-3c2f-86f9-1f815bcb7c3e",
                        "target_lang_word": "Neodym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neodym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "847b59bd-2f33-376b-83f6-cdccfc02ab99",
                                        "entry_id": "b4f41ba2-e0a1-3ad5-921c-4ab7e2f34f37",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 60, das zu den Lanthanoiden gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e70c076f-970f-40d3-90af-14d34c67a4e6",
                                                "sense_id": "847b59bd-2f33-376b-83f6-cdccfc02ab99",
                                                "text": "„Die Variationen im Gehalt von Spurenelementen wie Helium, Blei, Strontium, Neodym u. a. zeigen deutlich, dass Island auch geochemisch eine Anomalie im Vergleich zum restlichen Nordatlantik darstellt.“"
                                            },
                                            {
                                                "example_id": "4f683928-a235-4c42-ac1a-2f0da34fd7cd",
                                                "sense_id": "847b59bd-2f33-376b-83f6-cdccfc02ab99",
                                                "text": "Neodym ist ein silbrigweiß glänzendes Metall."
                                            },
                                            {
                                                "example_id": "537c0829-e546-434d-9c83-8cb4e7723a44",
                                                "sense_id": "847b59bd-2f33-376b-83f6-cdccfc02ab99",
                                                "text": "„Neodym, das die Industrie zur Herstellung starker Magnete einsetzt, kostete vor knapp drei Jahren pro Kilogramm rund 500 Dollar; heute ist das Metall für etwa 100 Dollar zu haben.“"
                                            },
                                            {
                                                "example_id": "174dd999-f8d2-4b46-a8d4-935a95694370",
                                                "sense_id": "847b59bd-2f33-376b-83f6-cdccfc02ab99",
                                                "text": "„Neodym verstärkt die magnetischen Kräfte in Windgeneratoren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "130b2c42-0137-473b-b53f-17452baab8cf",
                        "source_entry_id": "b167a3b9-38d4-39aa-adec-d0f948735d53",
                        "source_sense_id": "65135922-926f-3c2f-86f9-1f815bcb7c3e",
                        "target_lang_word": "neodymium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neodymium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebc814d2-3771-35c4-8ccb-1d4b848f2fc7",
                                        "entry_id": "6fe1d5ae-0e23-37af-8713-26937ed71f51",
                                        "glosses": [
                                            "A chemical element (symbol Nd) with an atomic number of 60: a hard, slightly malleable silvery rare earth metal that quickly tarnishes in air and moisture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20032329-4f8e-4404-b343-a4461c573dfc",
                                                "sense_id": "ebc814d2-3771-35c4-8ccb-1d4b848f2fc7",
                                                "text": "Other rare elements, like neodymium, exist in more than one isotopic form, the ratios of which can provide a measure of the depth from which the flow material may ultimately have been derived."
                                            },
                                            {
                                                "example_id": "cc6f6cd9-88d3-4c29-ae93-3621fe776f42",
                                                "sense_id": "ebc814d2-3771-35c4-8ccb-1d4b848f2fc7",
                                                "text": "The most important application of dysprosium and terbium, which belong to a subgroup known as the heavy rare earths, is in devices called neodymium boron magnets, or neo magnets for short."
                                            },
                                            {
                                                "example_id": "023c405f-ca52-4246-a79e-1df6296e9982",
                                                "sense_id": "ebc814d2-3771-35c4-8ccb-1d4b848f2fc7",
                                                "text": "But the government also gave MP Materials a decade-long guaranteed price floor for its products, such as the rare earths neodymium-praseodymium, at twice recent market rates (leaving aside the fact prices have soared this week as MP Materials has cut ties with China)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a624be0-c2b4-32ba-9a96-f435ba02525b",
                                        "entry_id": "6fe1d5ae-0e23-37af-8713-26937ed71f51",
                                        "glosses": [
                                            "A single atom of this element."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f998cea-4843-43ea-8f3a-f3b640ad9f7c",
                        "source_entry_id": "b167a3b9-38d4-39aa-adec-d0f948735d53",
                        "source_sense_id": "65135922-926f-3c2f-86f9-1f815bcb7c3e",
                        "target_lang_word": "néodyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néodyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11252625-ccd4-35b9-99c9-e099d0bccf77",
                                        "entry_id": "8be408fb-9e9a-32b1-970e-537b2c5e8291",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 60 et de symbole Nd qui fait partie de la série chimique des lanthanides et des terres rares."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4914247-cd6a-448d-88cc-837f16e20dc8",
                                                "sense_id": "11252625-ccd4-35b9-99c9-e099d0bccf77",
                                                "text": "Le néodyme, comme tous les lanthanides, est une terre rare."
                                            },
                                            {
                                                "example_id": "d977160d-af88-4c63-8e1a-ce0f776fd261",
                                                "sense_id": "11252625-ccd4-35b9-99c9-e099d0bccf77",
                                                "text": "Une partie des éoliennes actuelles utilise du néodyme, mais l’on peut s’en affranchir complètement."
                                            },
                                            {
                                                "example_id": "e2a81543-fa11-4e94-af68-66f654cc3dad",
                                                "sense_id": "11252625-ccd4-35b9-99c9-e099d0bccf77",
                                                "text": "Selon Quantum, Torrenueva et le village voisin de Torre de Juan Abad regorgent de néodyme, une terre rare qui s’extrait de la monazite et qui sert à fabriquer des aimants permanents (notamment des moteurs électriques et des haut-parleurs miniatures)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c25dc95-4633-3f38-91bc-7f1ca4b4a99f",
                                        "entry_id": "8be408fb-9e9a-32b1-970e-537b2c5e8291",
                                        "glosses": [
                                            "Métal pur de cet élément, gris-argenté, ductile, malléable, et rapidement oxydé à l’air à température ambiante."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
