                                        "glosses": [
                                            "Féminin singulier de étranger."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2e5078f-31b5-4d3c-8be7-c43d5e58ada4",
                                                "sense_id": "baa2bd0c-491e-3685-ab38-b2c646574937",
                                                "text": "L’idée d’une Ecriture sainte de la nouvelle alliance a été tout à fait étrangère au premier siècle chrétien qui n’a pas connu d’autre recueil canonique que l’Ancien Testament."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "235a74f1-d69a-4729-a09d-046587c3dbd0",
