                        "examples": [
                            {
                                "example_id": "a9bc8cfb-1bd4-49f6-bcc1-5f529a8138f9",
                                "sense_id": "ad11131b-eb44-3836-be74-9353407c0d8d",
                                "text": "Segers: „Holland Casino is door de staat in het leven geroepen om het gokken en de speelzucht te kanaliseren en beheersbaar te maken. Het is op z'n zachtst gezegd vreemd dat dat bedrijf nu 24 uur per dag de deuren mag openen. Daarmee zet je juist aan tot gokken.”"
                            },
                            {
                                "example_id": "40f224e8-f7eb-48a9-b5ee-3a2f189fae38",
                                "sense_id": "ad11131b-eb44-3836-be74-9353407c0d8d",
                                "text": "Ik had ontdekt dat ik erg weinig van mijn eigen familie af wist; Miriam, Xavier en mijn ouders waren als schimmen in een flauwverlichte kamer, een kamer waar de lichten half waren gedoofd toen de Eikenhof door de speelzucht van mijn vader voor ons verloren was gegaan."
                            }
                        ]
                    }
