                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d28d5a6-9543-4f5e-867e-bc1ed66e0372",
                                "sense_id": "972cc71f-0026-34cd-941f-16abca31f810",
                                "text": "Superschiffe werden oft in Nachrichtensendern behandelt."
                            },
                            {
                                "example_id": "e8339bf7-1ad0-4f5a-b523-635dbf441e93",
                                "sense_id": "972cc71f-0026-34cd-941f-16abca31f810",
                                "text": "„Geplant war ein Superschiff, das laut Regierungsauftrag ebenso als schwimmender Palast für 2000 Vergnügungsreisende wie als Truppentransporter für 14000 Soldaten dienen konnte.“"
                            },
                            {
                                "example_id": "b7adee2b-d4a3-4bdc-93c7-f337a31eabb6",
                                "sense_id": "972cc71f-0026-34cd-941f-16abca31f810",
                                "text": "„Das Superschiff wird zur Weihnachtszeit, wenn auf der Ostsee nicht viel los ist, zweckentfremdet für eine Kreuzfahrt nach Funchal eingesetzt.“"
                            }
                        ],
