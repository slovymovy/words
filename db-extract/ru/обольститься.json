                        "source_sense_id": "3d012e7a-c958-3681-a9e7-13770ef0730d",
                        "target_lang_word": "se leurrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se leurrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57a5d796-8533-3c65-b404-49ca293b5f04",
                                        "entry_id": "98c7d022-2280-3615-b5ec-6e6cd34e32d1",
                                        "glosses": [
                                            "Se tromper, se faire des idées, croire en des choses qui ne sont pas vraies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "964b59d1-af2b-420e-8015-a76fc0022c0e",
                                                "sense_id": "57a5d796-8533-3c65-b404-49ca293b5f04",
                                                "text": "Il s'est leurré de vaines espérances."
                                            },
                                            {
                                                "example_id": "28ffcc73-8227-48dd-998f-6a1507436801",
                                                "sense_id": "57a5d796-8533-3c65-b404-49ca293b5f04",
                                                "text": "Les manieurs d'idées ne doivent pas se leurrer. Comme l'a fort bien dit M. Th. Ribot, pour qu'une idée ait quelque emprise sur la vie, il faut qu'elle change de nature, il faut qu'elle devienne sentiment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b700abc7-ebda-4f04-92d3-72048ccfd7fe",
                        "source_entry_id": "10cdad68-f90e-3d4b-9219-73a86eab1db3",
                        "source_sense_id": "3d012e7a-c958-3681-a9e7-13770ef0730d",
                        "target_lang_word": "se faire des illusions",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se faire des illusions",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8742073-b522-34f9-81cc-8e8e61387d6e",
                                        "entry_id": "76bde77d-1f1c-3e7a-b281-957346addd91",
                                        "glosses": [
                                            "Se leurrer, se faire des idées fausses."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "pronominal"
                                        ],
                                        "note": "Principalement utilisé dans une phrase négative",
                                        "examples": [
                                            {
                                                "example_id": "0f51fded-dee0-4485-8261-7000704fbb76",
                                                "sense_id": "c8742073-b522-34f9-81cc-8e8e61387d6e",
                                                "text": "Il est convaincu qu’il sera acquitté triomphalement par les tribunaux français. Il se fait probablement des illusions."
                                            },
                                            {
                                                "example_id": "25b8bef4-95d4-4968-b6fc-61b771648ec2",
                                                "sense_id": "c8742073-b522-34f9-81cc-8e8e61387d6e",
                                                "text": "Christelle Rotach ne se faisait guère d’illusions en prenant les clés de la Santé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
