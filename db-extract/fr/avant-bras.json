                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a6a68d8b-53a8-38a4-b5fd-f5fc68fd28f7",
                        "entry_id": "bc79240a-8f26-372d-9cc5-f41d4222e88e",
                        "glosses": [
                            "Unterarm, Vorderarm"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d463114-1d1d-466b-bcaf-f6c5323fe607",
                        "source_entry_id": "bc79240a-8f26-372d-9cc5-f41d4222e88e",
                        "source_sense_id": "a6a68d8b-53a8-38a4-b5fd-f5fc68fd28f7",
                        "source_sense_description": "Unterarm, Vorderarm",
                        "target_lang_word": "Unterarm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterarm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                        "entry_id": "94cbf344-9225-3e21-932e-4eb18aeddbad",
                                        "glosses": [
                                            "Abschnitt des Armes zwischen Ellbogen und Hand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221335e8-cbf9-4605-adc4-446d83d0b74d",
                                                "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                                "text": "Er hat sich am Unterarm leicht verletzt."
                                            },
                                            {
                                                "example_id": "e2b331e9-680e-4ef2-b62d-7db1d3d9737e",
                                                "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                                "text": "„Tóvó zählte eins, zwei, drei, und während sie seinen Unterarm festhielt, warf er seinen Oberkörper zurück, und ein deutliches Knackgeräusch bewies, dass der Arm wieder im Gelenk saß.“"
                                            },
                                            {
                                                "example_id": "85521862-6013-4bd5-9abd-bd8f8a8fdef7",
                                                "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                                "text": "„Er hatte Maria erblickt und hielt sie am Unterarm gepackt.“"
                                            },
                                            {
                                                "example_id": "27474491-bb24-474b-a77f-6e1502f1879d",
                                                "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                                "text": "„Er antwortete nicht, legte nur seine Hand auf ihren Unterarm, und sie zog den Arm nicht zurück.“"
                                            },
                                            {
                                                "example_id": "c9366972-6f0e-4127-a3c8-6b4324be7572",
                                                "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                                "text": "„Er nickt, trinkt einen Schluck und wischt sich mit dem Unterarm über den Mund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcb8bc06-a17a-441d-8bdf-24e2ff475111",
