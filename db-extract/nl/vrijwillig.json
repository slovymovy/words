                                                "example_id": "84829ff1-0fbc-4d8a-888a-7c83d7e3f2b3",
                                                "sense_id": "72f68d45-1fd3-3d2b-8b3f-bf2aed1ae1db",
                                                "text": "Insbesondere in der Weihnachtszeit gibt es viele freiwillige Spenden."
                                            },
                                            {
                                                "example_id": "d37be2a1-216e-4329-801d-4a711a935cec",
                                                "sense_id": "72f68d45-1fd3-3d2b-8b3f-bf2aed1ae1db",
                                                "text": "Ich backe freiwillig den Kuchen."
                                            },
                                            {
                                                "example_id": "f43b7cb1-20ff-4069-8470-4ccd7896c534",
                                                "sense_id": "72f68d45-1fd3-3d2b-8b3f-bf2aed1ae1db",
                                                "text": "„Hunderttausende kamen ins Kiewer Zentrum nicht nur, um zu demonstrieren. Sie schmierten Schmalzbrote, schenkten Tee aus, hielten in der Nacht Wache, warfen Molotow-Cocktails und machten Musik - und das alles freiwillig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
