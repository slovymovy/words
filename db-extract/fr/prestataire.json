                        "entry_id": "54236b0f-000a-363e-b852-ec55dfecc924",
                        "glosses": [
                            "Fournisseur ou fournisseuse d’une prestation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04e3dc0d-7b18-458a-9ad3-c2543ab883b0",
                                "sense_id": "116c1ad7-ff1c-3199-a17f-0ec2b0c718a5",
                                "text": "Le prestataire doit exécuter une mission bien délimitée."
                            },
                            {
                                "example_id": "d5fc05c2-2f21-49cc-a312-08c5941da2eb",
                                "sense_id": "116c1ad7-ff1c-3199-a17f-0ec2b0c718a5",
                                "text": "Les devis des prestataires — ERDF, l’électricien de la commune et un enseigniste — étant déjà prêts, Valérie Hancy a pu commander l’enseigne très rapidement après l'obtention des fonds."
                            }
                        ]
                    },
