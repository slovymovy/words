                        "glosses": [
                            "Genre de chauve-souris, de la famille des minioptéridés, représentée en Europe, en Asie, en Afrique, en Océanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18594577-e066-4efe-9294-c9500d93b13a",
                                "sense_id": "fda8b76d-3ac4-381f-89d2-991a31aadb50",
                                "text": "Le minioptère forme parfois de grandes colonies de plusieurs centaines d'individus dans les grottes."
                            },
                            {
                                "example_id": "62621ea9-4048-4dbb-bb0c-6e385108f5a0",
                                "sense_id": "fda8b76d-3ac4-381f-89d2-991a31aadb50",
                                "text": "À quelques kilomètres de là niche une colonie de plusieurs milliers de minioptères, classés parmi les espèces vulnérables."
                            }
                        ]
                    }
