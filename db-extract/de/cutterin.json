                    {
                        "translation_id": "657ac461-bdfe-4305-9fb0-fe63ae744039",
                        "source_entry_id": "bc466954-967c-3d17-a485-a4052635e373",
                        "source_sense_id": "bdbcf6f2-56cb-348a-bf4e-e7ec25d6a37c",
                        "source_sense_description": "weibliche Person, die Filmaufnahmen/Tonaufzeichnungen schneidet und zu einem Gesamtwerk zusammensetzt",
                        "target_lang_word": "monteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "000288d0-ad36-3ec0-ad36-c2a6127dbdfd",
                                        "entry_id": "197412c7-36ab-3459-a894-a8ef8e7f78d8",
                                        "glosses": [
                                            "Ouvrière qui monte des pierres fines, des pièces d’orfèvrerie, de machines, etc."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46f6b90c-72f6-4b22-8d09-1183ae0f9a0e",
                                                "sense_id": "000288d0-ad36-3ec0-ad36-c2a6127dbdfd",
                                                "text": "C’était une fabrique de bijoux et Béatrice soudait l’or, l’argent, le cuivre, préparait les modèles pour les représentants. Elle était devenue une excellente monteuse en bijoux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe1e655-5fe6-32bd-9be4-4316a489edc0",
                                        "entry_id": "197412c7-36ab-3459-a894-a8ef8e7f78d8",
                                        "glosses": [
                                            "Celle qui est en charge d’assembler bout à bout plusieurs plans, issus du tournage, pour, lors du montage, former des séquences qui formeront à leur tour un film."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf87088-f75c-405e-a417-715cf70eba66",
                                                "sense_id": "bbe1e655-5fe6-32bd-9be4-4316a489edc0",
                                                "text": "[…] elle me répondit que la monteuse avait la maladie de Parkinson et que c’était la raison pour laquelle le réalisateur avait voulue cette technicienne."
                                            },
                                            {
                                                "example_id": "e271a6b8-836d-48a4-9051-2c2c8a9a7e08",
                                                "sense_id": "bbe1e655-5fe6-32bd-9be4-4316a489edc0",
                                                "text": "De père martiniquais et de mère bretonne, Marie-Josèphe Yoyotte est la première monteuse noire du cinéma français et est l’une des plus grandes."
                                            },
                                            {
                                                "example_id": "7216e54b-7665-4d35-9ceb-867c56a6864f",
                                                "sense_id": "bbe1e655-5fe6-32bd-9be4-4316a489edc0",
                                                "text": "Son équipe, et notamment sa monteuse, jouée dans le film par Blanche Gardin, s’arrachant les cheveux face à ses idées parfois géniales, mais souvent farfelues, comme de faire venir le chanteur Sting pour la bande-son de sa nouvelle réalisation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88185d26-bf0a-3b50-a11b-b3e78da999d4",
                                        "entry_id": "8cea28ff-f26f-3031-b890-d00a25ee4a70",
                                        "glosses": [
                                            "Féminin singulier de monteux."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83cb5381-87d2-460b-bdfc-40d21d0893dd",
                                                "sense_id": "88185d26-bf0a-3b50-a11b-b3e78da999d4",
                                                "text": "Les Galls se trouvaient trop pressés dans la région monteuse où ils avaient été repoussés ; aussi envoyèrent-ils au-dehors deux armées, ou deux colonnes militaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
