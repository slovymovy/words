{
    "word_family": [
        "incapacité",
        "capable",
        "capacité"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d57a29fe-55ef-33ad-af48-1467ca78f582",
                    "sense_definition": "Qui n'a pas la possibilité physique ou matérielle d'accomplir une action.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "impuissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué par ce long voyage, il était <w>incapable</w> de marcher plus longtemps."
                        },
                        {
                            "text": "Avec tout ce bruit incessant, je suis <w>incapable</w> de me concentrer sur mon travail."
                        }
                    ],
                    "antonyms": [
                        "capable"
                    ],
                    "common_phrases": [
                        "incapable de marcher",
                        "se sentir incapable",
                        "incapable de dormir"
                    ]
                },
                {
                    "sense_id": "ff19d1f5-10d2-37c4-b78d-1637f123d55d",
                    "sense_definition": "Qui manque d'aptitude, de compétence ou de talent pour mener à bien une tâche.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "incompetence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau directeur s'est révélé totalement <w>incapable</w> de gérer cette crise."
                        },
                        {
                            "text": "On le considère comme un employé <w>incapable</w> de diriger une équipe complète."
                        }
                    ],
                    "synonyms": [
                        "incompétent"
                    ],
                    "antonyms": [
                        "capable"
                    ],
                    "common_phrases": [
                        "totalement incapable",
                        "juger incapable"
                    ]
                },
                {
                    "sense_id": "60a8977a-f888-3f53-a06a-d48a5319e755",
                    "sense_definition": "Qui a des principes moraux ou une nature qui lui interdisent d'accomplir un acte mauvais.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un homme d'une honnêteté remarquable, tout à fait <w>incapable</w> de mentir."
                        },
                        {
                            "text": "Elle est <w>incapable</w> d'une telle trahison envers ses amis d'enfance."
                        }
                    ],
                    "common_phrases": [
                        "incapable de mentir",
                        "incapable de trahir"
                    ]
                },
                {
                    "sense_id": "dec69e30-b351-33ff-8352-059b78d62771",
                    "sense_definition": "Qui est privé par la loi de l'exercice de certains droits ou fonctions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal l'a déclaré <w>incapable</w> d'administrer seul ses biens financiers."
                        },
                        {
                            "text": "Un mineur reste juridiquement <w>incapable</w> de signer certains contrats sans ses parents."
                        }
                    ],
                    "common_phrases": [
                        "déclaré incapable",
                        "juridiquement incapable"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a3460a75-5c07-3bbd-82ed-bb3c599d2755",
                    "sense_definition": "Personne incompétente ou sans habileté, jugée inefficace dans ce qu'elle entreprend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "incompetence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chef de projet s'est comporté comme un véritable <w>incapable</w> lors des négociations."
                        },
                        {
                            "text": "En apprenant la nouvelle erreur, le directeur a traité ses assistants d'<w>incapables</w>."
                        }
                    ],
                    "synonyms": [
                        "andouille",
                        "enclume"
                    ],
                    "common_phrases": [
                        "bande d'incapables",
                        "traiter d'incapable"
                    ]
                },
                {
                    "sense_id": "19bf4732-ba7e-34d0-a77e-865fa6bc8c1c",
                    "sense_definition": "Personne privée de la capacité juridique d'exercer ses droits civils.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La loi prévoit plusieurs mesures de tutelle afin de protéger les intérêts d'un <w>incapable</w>."
                        },
                        {
                            "text": "Cette commission travaille à l'amélioration de la protection des <w>incapables</w> majeurs."
                        }
                    ],
                    "common_phrases": [
                        "incapable majeur"
                    ]
                }
            ]
        }
    ]
}