                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "indefinit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir haben leider keine Butter mehr im Haus, kannst du bitte im Supermarkt <w>welche</w> besorgen?"
                        },
                        {
                            "text": "Hast du noch kalte Limonade im Kühlschrank oder soll ich schnell <w>welche</w> kaufen?"
                        }
                    ],
                    "common_phrases": [
                        "welche besorgen",
                        "noch welche übrig"
