                        "glosses": [
                            "schot dat uit een pistool gelost wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2599135d-5d80-4cf1-9e23-9a60068de133",
                                "sense_id": "c580fc49-9c08-3cb9-9f6d-cb6d4d8e9901",
                                "text": "Een 25-jarige man die op de nationale opsporingslijst stond, is donderdag in Amsterdam opgepakt. Het gaat Soufyan M., die nog een openstaande gevangenisstraf van vier jaar heeft. Hij werd eerder dit jaar veroordeeld voor een woningoverval in juli 2016 in Rotterdam, waarbij de 35-jarige bewoner door een pistoolschot om het leven kwam."
                            },
                            {
                                "example_id": "1a3521e0-2481-4cbf-8a2a-1ec151739184",
                                "sense_id": "c580fc49-9c08-3cb9-9f6d-cb6d4d8e9901",
                                "text": "De rechter acht het drietal, variërend in leeftijd van twintig tot dertig jaar, schuldig aan de woningoverval en de fatale afloop als gevolg ervan. Het slachtoffer, de 35-jarige Mohammed Ghoumati, kwam door een pistoolschot om het leven."
                            }
                        ]
                    }
