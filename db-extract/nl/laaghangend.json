                            {
                                "example_id": "cf716fa5-1cc7-468f-b704-102e7bf6274e",
                                "sense_id": "d69d0a20-aa4f-3ceb-bca0-9abd6dd665e8",
                                "text": "Bij aankomst verkende ik meteen de tuin, die op een scène uit The Hobbit leek. Eindeloos veel tentjes stonden verdekt opgesteld onder de laaghangende boomtakken."
                            },
                            {
                                "example_id": "5af85fbb-2327-4e11-9be0-69a5695586a1",
                                "sense_id": "d69d0a20-aa4f-3ceb-bca0-9abd6dd665e8",
                                "text": "De mist in het zuiden kan hardnekkig zijn. Later op de dinsdag kan de mist zich langzaam noordwaarts uitstrekken. De dichte mist gaat dan over in nevel en laaghangende bewolking."
                            }
                        ]
                    }
