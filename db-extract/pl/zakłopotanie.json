                    {
                        "translation_id": "c8c67d3f-91e3-487c-954f-ebac5570148c",
                        "source_entry_id": "fd352f4f-5d03-3d65-93b9-96b3035d1f2e",
                        "source_sense_id": "f642dc18-55b3-313b-b077-5ae64fc5d781",
                        "target_lang_word": "Verlegenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verlegenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c69dfd8a-42c6-335f-bd8e-6844a4a02c0b",
                                        "entry_id": "2aeb2d89-112c-3240-83eb-8d3ffa2e74a5",
                                        "glosses": [
                                            "Gefühl der Unsicherheit, Verwirrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0879694f-2680-4e8f-b628-7b7dcff31af1",
                                                "sense_id": "c69dfd8a-42c6-335f-bd8e-6844a4a02c0b",
                                                "text": "Vor lauter Verlegenheit wurde er rot im Gesicht."
                                            },
                                            {
                                                "example_id": "fa9f65a5-27d4-486f-8f3e-7508cef090b4",
                                                "sense_id": "c69dfd8a-42c6-335f-bd8e-6844a4a02c0b",
                                                "text": "„Er lächelte, in einer Art, die eher auf Verlegenheit schließen ließ.“"
                                            },
                                            {
                                                "example_id": "8edbf017-36c2-458b-a716-d020fe927e21",
                                                "sense_id": "c69dfd8a-42c6-335f-bd8e-6844a4a02c0b",
                                                "text": "„Irgendwie war Consuela die Verlegenheit, die beinahe jeder mit sich herumträgt, erspart geblieben.“"
                                            },
                                            {
                                                "example_id": "08a8e2ae-e1e7-4fcf-b37c-77ed1cc7c725",
                                                "sense_id": "c69dfd8a-42c6-335f-bd8e-6844a4a02c0b",
                                                "text": "„Als aber am Sonntag nach dem Hochamt der Diener im Salon meldete, Graf Rostow sei da, liess die Prinzessin sich doch keine Verwirrung oder Verlegenheit anmerken; nur eine leichte Röte trat ihr auf die Wangen, und ihre Augen gewannen einen neuen, leuchtenden Glanz.“"
                                            },
                                            {
                                                "example_id": "44a48fa0-c21c-4837-b3f9-39925822b1e1",
                                                "sense_id": "c69dfd8a-42c6-335f-bd8e-6844a4a02c0b",
                                                "text": "„Diese litt es aber nicht, sondern umarmte sie mit einem Anflug von Verlegenheit, zugleich sichtlich bewegt durch diese Huldigung einer heiteren und liebenswürdigen Natur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "74c4e3bf-1c86-34ca-80c2-cd3ebee97b26",
                                        "entry_id": "2aeb2d89-112c-3240-83eb-8d3ffa2e74a5",
                                        "glosses": [
                                            "unangenehme Situation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c41a2334-b2d4-4232-b533-33a35168dc76",
                                                "sense_id": "74c4e3bf-1c86-34ca-80c2-cd3ebee97b26",
                                                "text": "„War er nicht vollkommen unschuldig, und würden hundert andere ältliche Herren an seiner Stelle nicht ebendasselbe getan und einem jungen hübschen Mädchen, das sie darum ansprach, aus der Verlegenheit geholfen haben?“"
                                            },
                                            {
                                                "example_id": "cdebbc35-17e6-47d7-bc18-8934ce47841f",
                                                "sense_id": "74c4e3bf-1c86-34ca-80c2-cd3ebee97b26",
                                                "text": "„Wer sich jedoch eine Basiskompetenz im Spielen angeeignet hat, gerät auch an scheinbar spielfeindlichen, anregungsarmen Orten, auch ohne jegliches Spielgerät, auch ohne Mitspieler, nicht in Verlegenheit, zu sinnvollem Spiel zu finden.“"
                                            },
                                            {
                                                "example_id": "07c2d032-14ed-4035-91ba-44cf9d5712ec",
                                                "sense_id": "74c4e3bf-1c86-34ca-80c2-cd3ebee97b26",
                                                "text": "„Jing Bo-djau hatte den vierten Fei absichtlich in Verlegenheit gesetzt, als dieser bei dem Trinken nach jener Spielregel seinen unbedachten Witz angebracht hatte.“"
                                            },
                                            {
                                                "example_id": "c1f98089-f22c-426c-a6a2-2f0b2c0d33e2",
                                                "sense_id": "74c4e3bf-1c86-34ca-80c2-cd3ebee97b26",
                                                "text": "„Ich dankte der Vorsehung, daß sie mir die Verlegenheit ersparte, das junge unverschämte Geschöpf zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3f42e07-154c-458a-93b0-ba8be0b58517",
                        "source_entry_id": "fd352f4f-5d03-3d65-93b9-96b3035d1f2e",
                        "source_sense_id": "f642dc18-55b3-313b-b077-5ae64fc5d781",
                        "target_lang_word": "Befangenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befangenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                        "entry_id": "a0b1e802-53ed-3710-bb83-b22c25c67da6",
                                        "glosses": [
                                            "Unsicherheit oder Zögern einer Sache gegenüber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e035be93-b949-4a4b-8932-3a4e008cb3dc",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "Als Anna vorgestellt wurde, wich ihre Befangenheit schnell dem Interesse an ihren neuen Klassenkameraden."
                                            },
                                            {
                                                "example_id": "09389e00-9a2d-45e0-83bd-80fa31adc820",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Er geht wie im Traum weiter, dann aber schüttelt er die Befangenheit ab, als neben ihm, hoch oben auf den Stadtbahnbögen, eine S-Bahn vorüberrasselt.“"
                                            },
                                            {
                                                "example_id": "bbfd4eef-6b3a-4dd9-a2ba-b77c530b8370",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Als Thomas seine anfängliche Befangenhet abgelegt hatte, war er bereit, bei diesem Spiel mitzuwirken, das ihn zeitweise an absurdes Theater erinnerte.“"
                                            },
                                            {
                                                "example_id": "b00b7549-3808-45be-bfb0-2877a45ec359",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Die Tanzenden hatten sich ein für allemal gesagt, sie seien eben maskiert und niemand könne sie erkennen, und darum waren sie auch von jeglicher Befangenheit frei.“"
                                            },
                                            {
                                                "example_id": "d973f468-2f22-4e9c-a33e-c108783ea752",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Vielleicht erklärte sich die Befangenheit auch daher, daß er irgendwelche Aufgaben zu versäumen glaubte, die seiner im Archiv warteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "015e9c74-4b68-3c94-88a2-b5d1b415580e",
                                        "entry_id": "a0b1e802-53ed-3710-bb83-b22c25c67da6",
                                        "glosses": [
                                            "mangelnde Fähigkeit, ein objektives und unabhängiges Urteil zu bilden, insbesondere aufgrund einer persönlichen Verwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6323d513-123a-4317-a5bc-03b5fcb1f727",
                                                "sense_id": "015e9c74-4b68-3c94-88a2-b5d1b415580e",
                                                "text": "Der Staatsanwalt unterstellt dem Richter Befangenheit, weil er ein Stammtischbruder des Angeklagten sei."
                                            },
                                            {
                                                "example_id": "8ed6a3f3-6b03-4cd2-938f-1a0e9ded2b07",
                                                "sense_id": "015e9c74-4b68-3c94-88a2-b5d1b415580e",
                                                "text": "„Das Wesen der Befangenheit besteht in der Hemmung einer unparteiischen Entschließung durch unsachliche psychologische Motive.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
