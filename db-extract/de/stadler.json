                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bde1638-a6c5-333d-bf41-5f6ec11bbec7",
                        "entry_id": "9bfebe3a-4b35-3ba0-b498-799ee0881851",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46605ad4-8e58-4ecb-9f87-a3170969fb51",
                                "sense_id": "7bde1638-a6c5-333d-bf41-5f6ec11bbec7",
                                "text": "Frau Stadler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "05ffaab9-067e-4d30-8e29-4b59a85849c9",
                                "sense_id": "7bde1638-a6c5-333d-bf41-5f6ec11bbec7",
                                "text": "Herr Stadler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "27bf2a53-4892-4b0f-83c7-49f418290312",
                                "sense_id": "7bde1638-a6c5-333d-bf41-5f6ec11bbec7",
                                "text": "Die Stadlers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a216e3b9-338b-4100-a2f5-dd41b2acd5a8",
                                "sense_id": "7bde1638-a6c5-333d-bf41-5f6ec11bbec7",
                                "text": "Der Stadler trägt nie die Schals, die die Stadler ihm strickt."
                            },
                            {
                                "example_id": "93988ef2-7a50-4bfc-a376-6fc85f39db83",
                                "sense_id": "7bde1638-a6c5-333d-bf41-5f6ec11bbec7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stadler kommt, geht der Herr Stadler.“"
                            },
                            {
                                "example_id": "4b6017c7-b323-404d-a5b4-f3365074d434",
                                "sense_id": "7bde1638-a6c5-333d-bf41-5f6ec11bbec7",
                                "text": "Stadler kommt und geht."
                            },
                            {
                                "example_id": "fda8a4e2-5948-4894-8890-8040b9f41c23",
                                "sense_id": "7bde1638-a6c5-333d-bf41-5f6ec11bbec7",
                                "text": "Stadlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
