                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da79adc-4f00-4afd-b443-74dfc6b269d5",
                                "sense_id": "608a966d-e838-30b7-a730-948c280576c6",
                                "text": "Each of two or more joint promisors may compel every other joint promisor to contribute equally with himself to the performance of the promise, unless a contrary intention appears from the contract."
                            },
                            {
                                "example_id": "8563823d-9072-48b7-a4e7-bcdb2aab5a0a",
                                "sense_id": "608a966d-e838-30b7-a730-948c280576c6",
                                "text": "[…]the creditor may request the promisor to perform his obligation to a third party."
                            },
                            {
                                "example_id": "2a878efe-8ece-4e51-9401-565650890e3f",
                                "sense_id": "608a966d-e838-30b7-a730-948c280576c6",
                                "text": "This may be attributable to a personal mistake of the promisor or negligence of her estate planner."
                            }
                        ]
