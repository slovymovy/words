{
    "word_family": [
        "report",
        "reportage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "233179b8-d838-33b4-9540-b51295ac5d5e",
                    "sense_definition": "Remettre un événement ou une action à une date ultérieure ; différer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison du mauvais temps, ils ont décidé de <w>reporter</w> la réunion de demain."
                        },
                        {
                            "text": "Le directeur <w>reporte</w> son voyage à la semaine prochaine pour régler une urgence."
                        }
                    ],
                    "synonyms": [
                        "repousser",
                        "postposer"
                    ],
                    "common_phrases": [
                        "reporter une réunion",
                        "reporter un rendez-vous",
                        "reporter à plus tard"
                    ]
                },
                {
                    "sense_id": "74634732-17b4-3d3f-bb06-7d87ccfa8802",
                    "sense_definition": "Rapporter quelque chose au lieu où il se trouvait auparavant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>reporter</w> ces livres à la bibliothèque avant la fermeture."
                        },
                        {
                            "text": "Elle a vite <w>reporté</w> les clés sur la table du salon avant de sortir."
                        }
                    ],
                    "common_phrases": [
                        "reporter un livre"
                    ]
                },
                {
                    "sense_id": "a54e3c4d-cd79-3e22-856a-3e05ad2abc51",
                    "sense_definition": "Consulter un passage ou un texte pour trouver des informations complémentaires.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour plus de détails techniques, le lecteur peut se <w>reporter</w> à l'annexe."
                        },
                        {
                            "text": "Vous devez vous <w>reporter</w> aux instructions fournies au début du manuel."
                        }
                    ],
                    "common_phrases": [
                        "se reporter à la page",
                        "se reporter au chapitre"
                    ]
                },
                {
                    "sense_id": "fc5c3885-27b3-314a-8fc3-2ee9a189dc2a",
                    "sense_definition": "Inscrire un montant ou un total à la page suivante ou sur un autre exercice comptable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comptable doit <w>reporter</w> le solde créditeur en haut du nouveau registre."
                        },
                        {
                            "text": "Il faut <w>reporter</w> cette somme sur la facture du mois suivant."
                        }
                    ],
                    "common_phrases": [
                        "reporter une somme",
                        "reporter un solde"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8cad3b84-b268-3667-9d58-a211e981cb95",
                    "sense_definition": "Journaliste chargé de recueillir des informations sur le terrain pour faire des reportages.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune <w>reporter</w> a pris son micro pour interroger les témoins sur place."
                        },
                        {
                            "text": "Cette femme travaille comme <w>reporter</w> pour une grande chaîne de télévision nationale."
                        }
                    ],
                    "synonyms": [
                        "journaliste",
                        "correspondant",
                        "reporteur"
                    ],
                    "common_phrases": [
                        "grand reporter",
                        "reporter d'images",
                        "reporter de guerre"
                    ]
                }
            ]
        }
    ]
}