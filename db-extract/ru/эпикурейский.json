                                        "glosses": [
                                            "den Epikureismus betreffend, vom Epikureismus stammend, nach Epikurs Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ac7732-d539-416a-b0e6-cb86f8dbda63",
                                                "sense_id": "866001af-8def-323a-b700-4edc76f33af5",
                                                "text": "Die epikureische Lustlehre versuchte, die Furcht, den Schmerz und die falschen Begierden zu entwerten, um die Lust als höchstes Gut verfügbar zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3848043c-459e-3b53-9e20-e6edc71dd002",
                                        "entry_id": "2f638e45-ec35-351d-a5d4-f913dd94a552",
                                        "glosses": [
                                            "dem Genuss ergeben, genusssüchtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09d8586c-3bf8-4218-af7f-618e5fc65b68",
                                                "sense_id": "3848043c-459e-3b53-9e20-e6edc71dd002",
                                                "text": "„Heute wird angesichts des Jüngsten Tages nicht mehr gebüßt, sondern genossen. Die Gesellschaft hat sich gemeinsam der epikureischen Adventsvariante verschrieben. Carpe diem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
