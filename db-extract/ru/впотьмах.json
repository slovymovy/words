        "ru-extract.jsonl": [
            {
                "entry_id": "08e2cb9a-655a-3357-84af-b7fe11f706e7",
                "word": "впотьмах",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "445bfe37-d1b3-3a45-a30e-bdd8caf38ddc",
                        "entry_id": "08e2cb9a-655a-3357-84af-b7fe11f706e7",
                        "glosses": [
                            "без света, в темноте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acc85d26-de12-4e0f-8704-fa14511e2402",
                                "sense_id": "445bfe37-d1b3-3a45-a30e-bdd8caf38ddc",
                                "text": "Впотьмах не видно, да и кто станет заглядывать, что там такое лежит у старухи!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fbde1ba-bd15-47ad-ac97-6ad3edd213c5",
                        "source_entry_id": "08e2cb9a-655a-3357-84af-b7fe11f706e7",
                        "source_sense_id": "445bfe37-d1b3-3a45-a30e-bdd8caf38ddc",
                        "target_lang_word": "in the dark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in the dark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20450eac-563b-360c-87c9-27cf9e129c8a",
                                        "entry_id": "9896b571-32ec-3541-b6fb-c28845e0f151",
                                        "glosses": [
                                            "Without information."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4a97bd0-9352-45cf-9fce-166ce1dcbac9",
                                                "sense_id": "20450eac-563b-360c-87c9-27cf9e129c8a",
                                                "text": "Management kept the board of directors completely in the dark."
                                            },
                                            {
                                                "example_id": "afb79fe2-93d1-4ea2-b3df-b840a5b0851b",
                                                "sense_id": "20450eac-563b-360c-87c9-27cf9e129c8a",
                                                "text": "They remained in the dark until the newspaper story came out."
                                            },
                                            {
                                                "example_id": "a0677129-4e50-4d3b-8061-d39318869424",
                                                "sense_id": "20450eac-563b-360c-87c9-27cf9e129c8a",
                                                "text": "You must remember, Mr Atherton, that I am wholly in the dark as to what has happened."
                                            },
                                            {
                                                "example_id": "91a0a649-8aaf-42f7-a386-bb1fc1ff1cb7",
                                                "sense_id": "20450eac-563b-360c-87c9-27cf9e129c8a",
                                                "text": "Until two or three days before Carter's December 15 announcement, the State Department spokesman was still saying that no decisions had been reached on the timing and the modality for normalization of relations with Peking. Meanwhile, the administration had been keeping Congress, including its leadership, completely in the dark. Then, taking advantage of the Christmas holidays, during which no one was watching on Capitol Hill, Carter sprang his surprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a454969-7693-38ba-8628-1ca2a0c421c7",
                                        "entry_id": "9896b571-32ec-3541-b6fb-c28845e0f151",
                                        "glosses": [
                                            "Without looking at one's hole cards, thus not knowing what they are."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e3e30e6-1a22-3b2d-b0e5-ec42567554d3",
                                        "entry_id": "9896b571-32ec-3541-b6fb-c28845e0f151",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see in, the, dark; without light, somewhere that is dark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef7aab5-72c9-457c-9f8d-6f55a88b9188",
                                                "sense_id": "1e3e30e6-1a22-3b2d-b0e5-ec42567554d3",
                                                "text": "I tripped over his suitcase in the dark."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
