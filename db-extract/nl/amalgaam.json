                                    {
                                        "sense_id": "d815ccb5-d990-3712-8b26-4314dfaabe2f",
                                        "entry_id": "2fb353cf-8d9a-333d-a671-f79344db1506",
                                        "glosses": [
                                            "Combinaison du mercure avec un autre métal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aa31e44-da44-418d-b2e2-1190cae16537",
                                                "sense_id": "d815ccb5-d990-3712-8b26-4314dfaabe2f",
                                                "text": "Faire un amalgame."
                                            },
                                            {
                                                "example_id": "5b95f17e-340d-4715-ba7a-e3afe480e341",
                                                "sense_id": "d815ccb5-d990-3712-8b26-4314dfaabe2f",
                                                "text": "Amalgame d’or, d’argent, de bismuth, etc."
                                            },
                                            {
                                                "example_id": "e92979ca-929f-46a5-890a-60649751815b",
                                                "sense_id": "d815ccb5-d990-3712-8b26-4314dfaabe2f",
                                                "text": "Le tain des glaces est un amalgame d’étain."
                                            },
                                            {
                                                "example_id": "b3855d62-1802-489f-a969-8adc210097c6",
                                                "sense_id": "d815ccb5-d990-3712-8b26-4314dfaabe2f",
                                                "text": "La production dʼargent par amalgame au mercure oscille habituellement à Zacatecas de 70 à 80% de la production totale, ce pourcentage pouvant occasionnellement sʼélever à 90%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c87c9637-c45e-371b-a847-df213a985b31",
                                        "entry_id": "2fb353cf-8d9a-333d-a671-f79344db1506",
                                        "glosses": [
                                            "Mélange de choses et de personnes qui ne sont pas ordinairement unies."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2098860d-cf69-4638-a48f-480472ea838b",
                                                "sense_id": "c87c9637-c45e-371b-a847-df213a985b31",
                                                "text": "Bien qu'il plonge ses racines dans le zen, le chanoyu ne prône donc pas de doctrine religieuse. Il faut plutôt le considérer comme l’amalgame d'un vaste ensemble d'idéaux philosophiques et esthétiques […]."
                                            },
                                            {
                                                "example_id": "7bde4e1c-7c52-4acf-a362-fb7cb75736ee",
                                                "sense_id": "c87c9637-c45e-371b-a847-df213a985b31",
                                                "text": "Cette société offre un étrange amalgame de tous les rangs et de toutes les opinions."
                                            }
                                        ]
                                    }
                                ]
                            },
