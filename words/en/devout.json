{
    "word_family": [
        "devotion",
        "devotee",
        "devotedly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "854c44e2-c94f-3369-8c4d-562f6a09c546",
                    "sense_definition": "Deeply committed to religious beliefs and practices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>devout</w> man attended church services every single morning.",
                            "target_lang_translations": {
                                "de": "Der <w>tiefgläubige</w> Mann besuchte jeden Morgen den Gottesdienst."
                            }
                        },
                        {
                            "text": "She is a <w>devout</w> believer who finds great comfort in her daily prayers.",
                            "target_lang_translations": {
                                "de": "Sie ist eine <w>fromme</w> Gläubige, die in ihren täglichen Gebeten großen Trost findet."
                            }
                        }
                    ],
                    "synonyms": [
                        "pious",
                        "religious",
                        "godly"
                    ],
                    "antonyms": [
                        "irreligious",
                        "secular"
                    ],
                    "common_phrases": [
                        "devout believer",
                        "devout follower"
                    ],
                    "target_lang_definitions": {
                        "de": "Tief in religiösen Überzeugungen und Praktiken verwurzelt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "tiefgläubig",
                                "target_lang_sense_clarification": "Beschreibt jemanden mit einem sehr tiefen, aufrichtigen Glauben."
                            },
                            {
                                "target_lang_word": "fromm",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für eine religiös observante Person."
                            },
                            {
                                "target_lang_word": "strenggläubig",
                                "target_lang_sense_clarification": "Betont die strikte Einhaltung religiöser Regeln und Vorschriften."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c5c3fa5-c028-39fd-ab09-5dffbf86c9ff",
                    "sense_definition": "Showing sincere and earnest feeling or commitment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sincere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered his <w>devout</w> wishes for their future happiness.",
                            "target_lang_translations": {
                                "de": "Er sprach seine <w>aufrichtigen</w> Wünsche für ihr zukünftiges Glück aus."
                            }
                        },
                        {
                            "text": "The team expressed a <w>devout</w> commitment to finishing the project on time.",
                            "target_lang_translations": {
                                "de": "Das Team drückte seine <w>innige</w> Entschlossenheit aus, das Projekt pünktlich abzuschließen."
                            }
                        }
                    ],
                    "synonyms": [
                        "earnest",
                        "sincere",
                        "heartfelt"
                    ],
                    "antonyms": [
                        "insincere",
                        "half-hearted"
                    ],
                    "common_phrases": [
                        "devout wish"
                    ],
                    "target_lang_definitions": {
                        "de": "Aufrichtige und ernsthafte Gefühle oder Verpflichtungen zeigend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufrichtig",
                                "target_lang_sense_clarification": "Bezieht sich auf die Ehrlichkeit und Ernsthaftigkeit einer Absicht."
                            },
                            {
                                "target_lang_word": "innig",
                                "target_lang_sense_clarification": "Beschreibt eine tiefe, herzliche und ernsthafte emotionale Bindung."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d90958ca-812c-3351-a0ef-8c31278b9535",
                    "sense_definition": "Characterized by or reflecting religious devotion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She knelt in a <w>devout</w> posture during the ceremony.",
                            "target_lang_translations": {
                                "de": "Sie kniete während der Zeremonie in einer <w>andächtigen</w> Haltung."
                            }
                        },
                        {
                            "text": "The choir sang a <w>devout</w> hymn that filled the entire cathedral.",
                            "target_lang_translations": {
                                "de": "Der Chor sang einen <w>andächtigen</w> Hymnus, der die gesamte Kathedrale erfüllte."
                            }
                        }
                    ],
                    "synonyms": [
                        "reverent"
                    ],
                    "target_lang_definitions": {
                        "de": "Religiöse Hingabe ausdrückend oder widerspiegelnd."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "andächtig",
                                "target_lang_sense_clarification": "Beschreibt eine Haltung der inneren Sammlung und Ehrfurcht."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9b203b3-0246-3995-9a87-78ca4eba1be8",
                    "sense_definition": "A person who is strongly dedicated to a cause or religion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>devouts</w> gathered at the temple before dawn.",
                            "target_lang_translations": {
                                "de": "Die <w>Gläubigen</w> versammelten sich vor Sonnenaufgang am Tempel."
                            }
                        },
                        {
                            "text": "Many <w>devouts</w> traveled long distances to attend the festival.",
                            "target_lang_translations": {
                                "de": "Viele <w>Anhänger</w> reisten weite Strecken, um am Fest teilzunehmen."
                            }
                        }
                    ],
                    "synonyms": [
                        "devotee"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This noun usage is now rare."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die einer Sache oder Religion stark gewidmet ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gläubiger",
                                "target_lang_sense_clarification": "Eine Person, die einem Glauben angehört."
                            },
                            {
                                "target_lang_word": "Anhänger",
                                "target_lang_sense_clarification": "Jemand, der einer Sache oder Bewegung treu ergeben ist."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82efcff5-a16e-3a2f-be85-00c259d732f8",
                    "sense_definition": "A short religious text or prayer used for worship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book contains several <w>devouts</w> for morning meditation.",
                            "target_lang_translations": {
                                "de": "Das Buch enthält mehrere <w>Andachten</w> für die morgendliche Meditation."
                            }
                        },
                        {
                            "text": "He read a quiet <w>devout</w> before starting his day.",
                            "target_lang_translations": {
                                "de": "Er las eine stille <w>Andacht</w>, bevor er seinen Tag begann."
                            }
                        }
                    ],
                    "synonyms": [
                        "devotion"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely obsolete."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kurzer religiöser Text oder ein Gebet zur Andacht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Andacht",
                                "target_lang_sense_clarification": "Bezeichnet sowohl die religiöse Übung als auch den Text dazu."
                            },
                            {
                                "target_lang_word": "Gebet",
                                "target_lang_sense_clarification": "Ein an Gott gerichtetes Wort oder Text."
                            }
                        ]
                    }
                }
            ]
        }
    ]
