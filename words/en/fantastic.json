            "senses": [
                {
                    "sense_id": "700d9d55-3817-3681-a2f8-cec6d146e4a1",
                    "sense_definition": "A person who is fanciful, whimsical, or eccentric.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a <w>fantastic</w> who spent his days dreaming of impossible inventions.",
                            "target_lang_translations": {
                                "ru": "Он был известен как <w>фантазер</w>, который проводил свои дни, мечтая о невозможных изобретениях."
                            }
                        },
                        {
                            "text": "The salon was a gathering place for poets, artists, and other <w>fantastics</w> of the era.",
                            "target_lang_translations": {
                                "ru": "Салон был местом сбора поэтов, художников и других <w>чудаков</w> той эпохи."
