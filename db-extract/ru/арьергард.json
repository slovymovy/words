                ],
                "senses": [
                    {
                        "sense_id": "a54137e9-6a37-3df4-9bf1-36e54b0d2766",
                        "entry_id": "b98b0648-1a4f-3eae-9181-5b34ec8d0942",
                        "glosses": [
                            "воен. силы прикрытия (охранения), выделяемые от соединений (частей) сухопутных войск при отходе; замыкающий отряд"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9245770b-80fc-4410-9594-acb236c98590",
                                "sense_id": "a54137e9-6a37-3df4-9bf1-36e54b0d2766",
                                "text": "Несколько улан верхами провожали нас до русского арьергарда, в виду которого они пожелали счастливого пути и поскакали назад."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1c55f95-94c9-3d93-bae5-1b22cf5a5742",
                        "entry_id": "b98b0648-1a4f-3eae-9181-5b34ec8d0942",
                        "glosses": [
                            "разг. те, кто замыкает процессию, движение и т. п.; замыкающие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2a6e25c-dbdb-42d3-b27c-2c57a983601a",
                                "sense_id": "d1c55f95-94c9-3d93-bae5-1b22cf5a5742",
                                "text": "Мы сидели в арьергарде полуторатысячной толпы в главном зале отеля «Дюны»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ff30a9b-8c53-4f33-a513-f314280d1bde",
                        "source_entry_id": "b98b0648-1a4f-3eae-9181-5b34ec8d0942",
                        "target_lang_word": "achterhoede",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achterhoede",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b5c494b8-ab23-34e2-aff3-f2d122ac7074",
                                        "entry_id": "8ac58b3f-2113-38f8-abec-e3480ff13def",
                                        "glosses": [
                                            "de posities op het speelveld het dichtste bij het eigen doel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa60b701-6de1-4a8a-a7b4-cd11a63ba4b2",
                                                "sense_id": "b5c494b8-ab23-34e2-aff3-f2d122ac7074",
                                                "text": "Als kleine jongen speelde ik altijd in de achterhoede."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad06c82-3c31-3ec1-93f7-a00f7e3a0845",
                                        "entry_id": "8ac58b3f-2113-38f8-abec-e3480ff13def",
                                        "glosses": [
                                            "de laatsten van een groep"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b92138-4cf8-4ac7-a7d5-315a17f5d14c",
                                                "sense_id": "aad06c82-3c31-3ec1-93f7-a00f7e3a0845",
                                                "text": "Vaak moesten we meer dan een uur wachten op So it Goes, die zich niet goed voelde en steeds langzamer ging lopen. Barbie bleef altijd trouw bij haar, terwijl de anderen vooruitliepen om de weg te verkennen. Bij elke splitsing wachtten we op de achterhoede."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
