                                        "entry_id": "58a57bba-5a6e-3a61-87a6-914cd8a63b67",
                                        "glosses": [
                                            "Blasinstrument aus Holz, das aus mehreren parallel angeordneten Schnabelflöten unterschiedlicher Größe besteht"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c54d39cc-3a83-4c04-bcc7-b5f209b39c6e",
                                                "sense_id": "7534aa0a-d96e-3ae4-b3a1-54993f3bb3ff",
                                                "text": "Die Musik der Panflöte eignet sich zum Meditieren."
                                            },
                                            {
                                                "example_id": "45189024-b4b7-41d5-b999-1cc13b65b0b8",
                                                "sense_id": "7534aa0a-d96e-3ae4-b3a1-54993f3bb3ff",
                                                "text": "„Anmutig zum Klang von Panflöten tanzend, brachte er vor dem Altar Opfer dar.“"
                                            },
                                            {
                                                "example_id": "60e062ef-cb87-4009-8405-f24d15f65857",
                                                "sense_id": "7534aa0a-d96e-3ae4-b3a1-54993f3bb3ff",
                                                "text": "„Dafür spielen diese zur Strafe bis zum heutigen Tag Panflöte in der Fußgängerzone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
