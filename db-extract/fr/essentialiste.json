                            {
                                "example_id": "b1f69a93-8ef2-4b68-88b7-cadfb063f24b",
                                "sense_id": "ba670fa9-92b3-391d-be69-c26fc6cb84aa",
                                "text": "L’accueil des réfugiés, pourtant au coeur de la tradition biblique la plus ancienne, rencontre une forte résistance au nom d’une conception essentialiste de l’identité socioculturelle."
                            },
                            {
                                "example_id": "ff3b832c-4611-42fb-b48a-ab2696167826",
                                "sense_id": "ba670fa9-92b3-391d-be69-c26fc6cb84aa",
                                "text": "Le féminisme essentialiste affirme une essence féminine. Il met au centre de son analyse l'expérience féminine plutôt que la construction sociale des genres. Il réclame l'égalité dans la différence."
                            }
                        ]
                    }
