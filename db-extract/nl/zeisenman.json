                                        "glosses": [
                                            "Sinnbild des Todes, personifizierte Allegorie des Todes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0015511b-b016-49ba-87d2-1075c6206fb6",
                                                "sense_id": "e089abd7-b280-3552-9256-28d0b4408aff",
                                                "text": "Irgendwann einmal holt der Sensenmann jeden Menschen ab."
                                            }
                                        ],
