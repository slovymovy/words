{
    "word_family": [
        "trampler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18156412-572e-3729-9e8a-bb16c99beddd",
                    "sense_definition": "To crush or damage something by walking heavily on it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd began to <w>trample</w> the flowers in the garden during the festival.",
                            "target_lang_translations": {
                                "zh": "节日期间，人群开始<w>践踏</w>花园里的花草。"
                            }
                        },
                        {
                            "text": "Be careful not to <w>trample</w> the grass while you are walking through the park.",
                            "target_lang_translations": {
                                "zh": "穿过公园时小心不要<w>踩踏</w>草坪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tread"
                    ],
                    "common_phrases": [
                        "trample underfoot"
                    ],
                    "target_lang_definitions": {
                        "zh": "重踩或踩踏，使某物受损或被踩碎"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "踩踏",
                                "target_lang_sense_clarification": "行走践踏使损坏"
                            },
                            {
                                "target_lang_word": "践踏",
                                "target_lang_sense_clarification": "踩坏、踏伤"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e1b680f-877c-388c-b28b-cc78a938a02f",
                    "sense_definition": "To walk with heavy, noisy, or destructive steps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry protesters continued to <w>trample</w> through the streets shouting slogans.",
                            "target_lang_translations": {
                                "zh": "愤怒的抗议者一边高呼口号，一边继续<w>重步走过</w>街道。"
                            }
                        },
                        {
                            "text": "Heavy boots <w>trample</w> across the wooden floorboards every morning.",
                            "target_lang_translations": {
                                "zh": "每天早晨，沉重的靴子都会在木地板上<w>重重走过</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "步履沉重、喧闹或具破坏性地走过"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重步走过",
                                "target_lang_sense_clarification": "迈着沉重粗鲁的步子"
                            },
                            {
                                "target_lang_word": "踏步",
                                "target_lang_sense_clarification": "沉重喧闹地迈步"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb1d07ec-0b01-39e0-b7fb-519e98b0cbb8",
                    "sense_definition": "To ignore or violate someone's rights or feelings in a cruel way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy seems to <w>trample</w> on the basic rights of the employees.",
                            "target_lang_translations": {
                                "zh": "这项新政策似乎在<w>践踏</w>员工的基本权利。"
                            }
                        },
                        {
                            "text": "It is wrong to <w>trample</w> on the dignity of others for personal gain.",
                            "target_lang_translations": {
                                "zh": "为了个人利益而<w>践踏</w>他人的尊严是不对的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trample on rights"
                    ],
                    "target_lang_definitions": {
                        "zh": "残忍或公然侵犯、漠视（权利、尊严或情感）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "践踏",
                                "target_lang_sense_clarification": "侵犯、摧残尊严或权利"
                            },
                            {
                                "target_lang_word": "肆意侵犯",
                                "target_lang_sense_clarification": "轻视并破坏他人权益"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05a4934d-48a3-386a-a971-0954fd3fb16a",
                    "sense_definition": "To treat someone with extreme harshness or lack of respect.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator continued to <w>trample</w> his political opponents without mercy.",
                            "target_lang_translations": {
                                "zh": "独裁者继续毫不留情地<w>蹂躏</w>他的政敌。"
                            }
                        },
                        {
                            "text": "They felt the company would <w>trample</w> anyone who stood in its way.",
                            "target_lang_translations": {
                                "zh": "他们觉得这家公司会<w>摧残</w>任何挡它道的人。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "极其严酷或毫无尊重地对待、打压某人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蹂躏",
                                "target_lang_sense_clarification": "残酷折磨、打压对手"
                            },
                            {
                                "target_lang_word": "摧残",
                                "target_lang_sense_clarification": "无情压迫、伤害"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3cadbe32-716a-3043-953b-ddc622f3e985",
                    "sense_definition": "The act of stepping heavily on something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>trample</w> of many feet could be heard coming from the hallway.",
                            "target_lang_translations": {
                                "zh": "可以听到走廊里传来的纷纷<w>踩踏</w>。"
                            }
                        },
                        {
                            "text": "The grapes were prepared for a traditional <w>trample</w> in the large vat.",
                            "target_lang_translations": {
                                "zh": "葡萄准备妥当，放入大桶中进行传统的<w>踩踏</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "重踩或踩踏的动作"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "踩踏",
                                "target_lang_sense_clarification": "重重践踏的动作"
                            },
                            {
                                "target_lang_word": "践踏",
                                "target_lang_sense_clarification": "用脚踩压的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6cb2475-2478-326d-bf6a-15b320f53230",
                    "sense_definition": "The sound produced by heavy, forceful footsteps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard the loud <w>trample</w> of boots on the gravel path outside.",
                            "target_lang_translations": {
                                "zh": "我们听到了外面碎石小路上靴子发出的大声<w>踏步声</w>。"
                            }
                        },
                        {
                            "text": "The rhythmic <w>trample</w> of the soldiers echoed through the quiet square.",
                            "target_lang_translations": {
                                "zh": "士兵们有节奏的<w>脚步声</w>在安静的广场上回荡。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "沉重、有力的脚步声"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脚步声",
                                "target_lang_sense_clarification": "沉重有力的步伐声响"
                            },
                            {
                                "target_lang_word": "踏步声",
                                "target_lang_sense_clarification": "重踏发出的声响"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}