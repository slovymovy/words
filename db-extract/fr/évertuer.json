        "fr-extract.jsonl": [
            {
                "entry_id": "3b753cc3-82da-32fc-b8f8-2c2ce17a69dc",
                "word": "évertuer",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a6a50bc2-a915-4fd4-96e7-ade9691fbdf0",
                        "entry_id": "3b753cc3-82da-32fc-b8f8-2c2ce17a69dc",
                        "tags": [
                            "pronominal"
                        ],
                        "form": "s’évertuer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "83d2d981-4282-377c-8930-40a1749f5e9e",
                        "entry_id": "3b753cc3-82da-32fc-b8f8-2c2ce17a69dc",
                        "glosses": [
                            "Faire un effort pour réussir quelque chose ; consacrer toute son énergie à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c0f7abd-e47a-45d0-afae-0c21ccf42456",
                                "sense_id": "83d2d981-4282-377c-8930-40a1749f5e9e",
                                "text": "[…], et il se mit en quête de la sœur Sainte-Marthe, qu'il ne rencontra qu'à l'autre bout de la salle, au chevet d'un blessé qui geignait et qu'elle s’évertuait à consoler."
                            },
                            {
                                "example_id": "69f2f73a-ad78-4d43-b703-c4c4c1a7b9fc",
                                "sense_id": "83d2d981-4282-377c-8930-40a1749f5e9e",
                                "text": "Puisque j'arrivais à tenir et à diriger un porte-plume, pourquoi pas aussi un petit pinceau ? En cachette, j’essayai, je m’évertuai, j’éduquai mes doigts et mon poignet et j’arrivai à un résultat relativement satisfaisant."
                            },
                            {
                                "example_id": "d10822b3-af0f-4aef-99da-6955a96b0356",
                                "sense_id": "83d2d981-4282-377c-8930-40a1749f5e9e",
                                "text": "Pour peu que la police s’évertuât, les deux autres seraient cueillis, et le simple fait d’être pris les armes à la main, leur vaudrait une mise à l’ombre qui permettrait à l’Allemand d'agir en temps."
                            },
                            {
                                "example_id": "69b962ae-5830-4630-9bc9-d777dc2c41e3",
                                "sense_id": "83d2d981-4282-377c-8930-40a1749f5e9e",
                                "text": "…ces infortunés, depuis les temps les plus anciens, se sont évertués à épierrer ces immensités du Causse, ces plateaux calcaires que leur industrie mal rétribuée a compartimenté de murets innombrables d'un gris bleuâtre."
                            },
                            {
                                "example_id": "9a3bf56d-b92f-4eb4-b005-3a59541854f5",
                                "sense_id": "83d2d981-4282-377c-8930-40a1749f5e9e",
                                "text": "Il s'évertua en français à expliquer à l’irlandais les subtilités des différents plats de poisson, particulièrement du « Tronçon de turbot grillé aux oignons caramélisés, arlésienne de légumes, sauce choron. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d901cd7-66bd-4327-840c-d8118df030b8",
                        "source_entry_id": "3b753cc3-82da-32fc-b8f8-2c2ce17a69dc",
                        "source_sense_id": "83d2d981-4282-377c-8930-40a1749f5e9e",
                        "source_sense_description": "Faire un grand effort pour réussir",
                        "target_lang_word": "strive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f873482-b717-370d-8188-82625028008e",
                                        "entry_id": "cc9f5314-4fb8-39c9-9fbe-0c0e89a5ed5f",
                                        "glosses": [
                                            "To try to achieve a result; to make strenuous effort; to try earnestly and persistently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5439c81-e5ce-42df-b02f-054d373b09f2",
                                                "sense_id": "1f873482-b717-370d-8188-82625028008e",
                                                "text": "He strove to excel."
                                            },
                                            {
                                                "example_id": "f1f765d6-e275-473b-9259-ed5f9afd7205",
                                                "sense_id": "1f873482-b717-370d-8188-82625028008e",
                                                "text": "We strive for the truth."
                                            },
                                            {
                                                "example_id": "1bb255e6-e6c5-4c2f-9eee-adf7c7b62d45",
                                                "sense_id": "1f873482-b717-370d-8188-82625028008e",
                                                "text": "Though the writer has striven to dwell on aspects that have passed, or are passing away, it will be apparent that many features of Midland practice have been adopted as standard for the L.M.S.R. and other railways."
                                            },
                                            {
                                                "example_id": "db784356-9197-478a-a6cd-74b4353f9847",
                                                "sense_id": "1f873482-b717-370d-8188-82625028008e",
                                                "text": "Moreover, on several occasions, terminus stations such as Nine Elms, Bishop's Bridge, Maiden Lane and Bishopgate were built rather further away from the centre of London, only to be dispensed with as the various railway companies strove to get as near as possible to the lucrative markets of the City and the West End."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d3a752e-29e6-32fa-ac93-f5a2b5de4e58",
                                        "entry_id": "cc9f5314-4fb8-39c9-9fbe-0c0e89a5ed5f",
                                        "glosses": [
                                            "To struggle in opposition; to be in contention or dispute; to contend; to contest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e44c2cc-0c17-4285-b5cb-2a3c2a4aa85d",
                                                "sense_id": "2d3a752e-29e6-32fa-ac93-f5a2b5de4e58",
                                                "text": "to strive against fate"
                                            },
                                            {
                                                "example_id": "d44a1c7a-c3f3-4612-a892-d02737f4bb73",
                                                "sense_id": "2d3a752e-29e6-32fa-ac93-f5a2b5de4e58",
                                                "text": "Now private pity strove with public hate, / Reason with rage, and eloquence with fate."
                                            },
                                            {
                                                "example_id": "6d91badd-5bee-4647-8a34-cb91e9898b4f",
                                                "sense_id": "2d3a752e-29e6-32fa-ac93-f5a2b5de4e58",
                                                "text": "We have met this new thing that has come upon the earth and have striven against its armies, but could not drive them forth; and the new thing is beautiful but very angry, and is creeping towards the gods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19884d18-1e23-3ca0-881c-b1c5732fc814",
                                        "entry_id": "cc9f5314-4fb8-39c9-9fbe-0c0e89a5ed5f",
                                        "glosses": [
                                            "To vie; to compete as a rival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "363c6e27-d846-430e-8bf7-850908935de6",
                                                "sense_id": "19884d18-1e23-3ca0-881c-b1c5732fc814",
                                                "text": "[Not] that sweet grove\n Of Daphne, by Orontes and the inspired\n Castalian spring, might with this paradise\n Of Eden strive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "strive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5736d838-f7f4-31be-8628-a920fa8d4421",
                                        "entry_id": "5c9147cb-3309-3a1d-8364-0aa712263089",
                                        "glosses": [
                                            "Alternative form of strife."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
