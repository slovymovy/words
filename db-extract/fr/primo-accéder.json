                "senses": [
                    {
                        "sense_id": "00f8f2a4-06f1-376c-9828-8d7ed1acdd46",
                        "entry_id": "fca51ae3-0457-39f8-8dd6-f591a7b38953",
                        "glosses": [
                            "Accéder à la propriété immobilière pour la première fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb2801bf-69e0-417e-bf06-47d2bf18a0fc",
                                "sense_id": "00f8f2a4-06f1-376c-9828-8d7ed1acdd46",
                                "text": "Mais il est clair qu’à avoir trop tardé à prendre en compte les conséquences que la hausse des prix a pu imprimer sur le fonctionnement des marchés immobiliers, les pouvoirs publics paraissent aujourd’hui désemparés : comment, par exemple, peut-on imaginer inciter les ménages modestes à primo-accéder ?"
                            },
                            {
                                "example_id": "7385b621-2610-413a-8c58-e1e03fc50fa8",
                                "sense_id": "00f8f2a4-06f1-376c-9828-8d7ed1acdd46",
                                "text": "Sans PTZ+ dans l’ancien et sans Scellier, la chaîne du logement perd deux maillons essentiels et se rompt : comment le locataire du parc HLM va-t-il primo-accéder désormais ?"
                            },
                            {
                                "example_id": "a5611a02-60f7-44a5-89c0-ec903b7c5243",
                                "sense_id": "00f8f2a4-06f1-376c-9828-8d7ed1acdd46",
                                "text": "Et je vous parle même pas de la famille qui ne peut primo-accéder, et qui ne peut louer, les étudiants avec APL squattant le marché…"
                            }
                        ]
                    }
                ],
