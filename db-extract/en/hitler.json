                "senses": [
                    {
                        "sense_id": "f02cce94-8668-383a-8b43-3fd631ad3e72",
                        "entry_id": "e8b7284e-c56e-32dc-b094-d0c56d0c905f",
                        "glosses": [
                            "A dictatorial person; someone who loves to exert their power and influence over others. (often used as a term of abuse)"
                        ],
                        "tags": [
                            "derogatory",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "7640c3c2-6ec9-4871-accc-eb39f10be5c5",
                                "sense_id": "f02cce94-8668-383a-8b43-3fd631ad3e72",
                                "text": "Don't you think you could try sorting your rubbish instead of tossing everything out together? Ok, Hitler."
                            },
                            {
                                "example_id": "09c08c60-ec58-4f64-a1b3-7c7638e7a196",
                                "sense_id": "f02cce94-8668-383a-8b43-3fd631ad3e72",
                                "text": "How does he support his position against the prima facie case in favor of the strongly counterintuitive claim that non-violence would necessarily defeat a Hitler?"
                            },
                            {
                                "example_id": "e3fe523c-f0e9-4b7c-b34e-9ade1e54c2cf",
                                "sense_id": "f02cce94-8668-383a-8b43-3fd631ad3e72",
                                "text": "“He was called a ‘little Hitler’ yesterday,” Stevens said. “A guy pointed at him in his car and then he said that we didn’t like brown people. I don’t understand that at all.”"
                            }
                        ]
                    }
                ],
