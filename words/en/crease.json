                    "target_lang_definitions": {
                        "cs": "Lehce někoho zranit nebo škrtnout projektilem.",
                        "ru": "Слегка задеть или ранить по касательной пулей или другим снарядом.",
                        "zh": "（子弹等投射物）擦伤，擦过。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "škrtnout",
                                "target_lang_sense_clarification": "lehce zasáhnout povrch"
                            },
                            {
                                "target_lang_word": "líznout",
                                "target_lang_sense_clarification": "hovorově, lehce zasáhnout"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "задеть по касательной",
                                "target_lang_sense_clarification": "легко ранить или повредить пулей"
                            },
                            {
                                "target_lang_word": "чиркнуть",
                                "target_lang_sense_clarification": "задеть скользнув по поверхности"
