                "senses": [
                    {
                        "sense_id": "37d6199e-bb49-308f-a6d6-e2a8696004ac",
                        "entry_id": "aba7f6b7-8fc9-34b6-bd74-ab0f6de6d464",
                        "glosses": [
                            "Qui est niais, sot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20ced30a-5d0b-4eca-a7df-517336ff8a8e",
                                "sense_id": "37d6199e-bb49-308f-a6d6-e2a8696004ac",
                                "text": "Voilà un homme bien benêt."
                            },
                            {
                                "example_id": "529e0a04-acd5-47e9-87ab-352134cbf58e",
                                "sense_id": "37d6199e-bb49-308f-a6d6-e2a8696004ac",
                                "text": "Le chapitre XX, qui raconte le mariage, est écrit sur le mode du grotesque, un grotesque grinçant, qui ménage un contraste perpétuel entre l’ahurissement angoissé des deux époux et la satisfaction benête de leur entourage."
                            },
                            {
                                "example_id": "d249da77-c8ed-494a-ab2c-88d1feaefd44",
                                "sense_id": "37d6199e-bb49-308f-a6d6-e2a8696004ac",
                                "text": "— Vous pouvez avoir toute confiance en lui.\n— Autant qu’en vous ?\nIl y avait des moments – c’était rare, d’ailleurs ! – où Maigret ne pouvait s’empêcher de lancer une petite phrase de ce genre, avec un air benêt qui lui donnait tout son sel."
                            },
                            {
                                "example_id": "afeabb9b-5a51-47d2-9f8c-8cce89377928",
                                "sense_id": "37d6199e-bb49-308f-a6d6-e2a8696004ac",
                                "text": "Bref, nous étions aussi benêts qu'il est possible de l'être à cet âge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7df02665-cd85-401b-a089-a8d88924b74e",
                        "source_entry_id": "aba7f6b7-8fc9-34b6-bd74-ab0f6de6d464",
