        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a12731f7-b511-32bc-bfb6-5a88c807db84",
                    "sense_definition": "D'un point de vue historique, au cours de l'histoire ou dans le temps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Historiquement</w>, cette région a toujours été un carrefour commercial majeur entre l'Europe et l'Asie."
                        },
                        {
                            "text": "Ces deux nations sont <w>historiquement</w> liées par des traités de paix très anciens."
                        }
                    ],
                    "common_phrases": [
                        "historiquement parlant",
                        "être historiquement lié"
                    ]
                },
                {
                    "sense_id": "8f6e4008-6086-3a73-8bd8-4952fb054bec",
                    "sense_definition": "En conformité avec la réalité des faits historiques attestés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'existence de ce personnage légendaire n'a jamais pu être <w>historiquement</w> prouvée par les chercheurs."
                        },
                        {
                            "text": "Cet événement est <w>historiquement</w> attesté par de nombreux documents d'époque conservés aux archives."
                        }
                    ],
                    "common_phrases": [
                        "historiquement prouvé",
                        "historiquement attesté"
                    ]
                },
                {
                    "sense_id": "0efdd498-c5ab-3fd7-93c7-312d6ca6628e",
                    "sense_definition": "Dans un style narratif simple et factuel, sans ornements rhétoriques.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin a préféré raconter <w>historiquement</w> les faits sans exprimer la moindre émotion personnelle."
                        },
                        {
                            "text": "Il a exposé la situation <w>historiquement</w>, en rapportant les paroles exactes sans aucune exagération oratoire."
                        }
                    ],
                    "common_phrases": [
                        "raconter historiquement"
                    ],
