                        "cross_references": []
                    },
                    {
                        "translation_id": "04aee37e-2895-4510-b18e-35f85b22d7de",
                        "source_entry_id": "4bacf3bd-fafd-3ee1-8847-12926ba4adb7",
                        "source_sense_id": "c0485463-4e83-353d-90c8-05acb6570854",
                        "target_lang_word": "in a nutshell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in a nutshell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "134c54e3-3cb7-33a9-a0d9-e1504415e046",
                                        "entry_id": "ef6fb1a2-b754-3fb2-b486-16e98da3efc4",
                                        "glosses": [
                                            "In summary; briefly or simply."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b9d0ecd-7811-4e0a-817f-601d029f1a82",
                                                "sense_id": "134c54e3-3cb7-33a9-a0d9-e1504415e046",
                                                "text": "He had a lot to say, but his answer, in a nutshell, was no."
                                            },
                                            {
                                                "example_id": "0f599965-8c3f-4646-9322-46fe478a3e04",
                                                "sense_id": "134c54e3-3cb7-33a9-a0d9-e1504415e046",
                                                "text": "Sadio Mané wasted a glorious chance in the first half and, late on, Mohamed Salah turned his shot against a post after a goal-line clearance had spun his way. That, in a nutshell, perhaps sums up the difference between Messi and the players on the next rung below – the ones who can be described as great footballers without necessarily being football greats."
                                            },
                                            {
                                                "example_id": "e8e9587b-6675-4c0d-923e-00039bd6c524",
                                                "sense_id": "134c54e3-3cb7-33a9-a0d9-e1504415e046",
                                                "text": "The yarns of seamen have a direct simplicity, the whole meaning of which lies within the shell of a cracked nut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33942c29-6920-4a8a-92d8-df14f3b14595",
