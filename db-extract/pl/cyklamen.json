                "translations": [
                    {
                        "translation_id": "ae2f8c0d-78d3-4611-9c59-137726fe5c9b",
                        "source_entry_id": "1e3e3b90-7d33-3f50-adcf-b9e3663cef8d",
                        "source_sense_id": "280f12c1-f424-3acb-a237-f34003d63da5",
                        "target_lang_word": "cyclamen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyclamen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20320903-3971-3e46-8442-3c48f085d45c",
                                        "entry_id": "e2b0f023-9f2b-3692-a86b-9c5d7adfca89",
                                        "glosses": [
                                            "Any of various primulaceous flowering plants, of the genus Cyclamen, widely cultivated as a houseplant, having decorative leaves and solitary flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35a110da-8301-4748-b03e-a926e46c66fe",
                                                "sense_id": "20320903-3971-3e46-8442-3c48f085d45c",
                                                "text": "An expectant mother would avoid cyclamen, stepping over it being an ominous sign."
                                            },
                                            {
                                                "example_id": "abe14cb9-6d22-42f7-9d2c-3a2e0c56b762",
                                                "sense_id": "20320903-3971-3e46-8442-3c48f085d45c",
                                                "text": "The root of the cyclamen, sowbread, was used in ancient times as an ingredient in love potions."
                                            },
                                            {
                                                "example_id": "9b42d727-7f1b-4cfd-852c-0d53a6c8dbdd",
                                                "sense_id": "20320903-3971-3e46-8442-3c48f085d45c",
                                                "text": "An interesting cyclamen was also found here with dark rounded unmarbled leaves, but unfortunately without flowers […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cc5ea1b-8a9a-3b4c-b5a3-09d0b4b3289e",
                                        "entry_id": "e2b0f023-9f2b-3692-a86b-9c5d7adfca89",
                                        "glosses": [
                                            "A purplish-red colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e53afc61-8faf-4971-9f08-26285ae7d7db",
                                                "sense_id": "6cc5ea1b-8a9a-3b4c-b5a3-09d0b4b3289e",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ac0af72-861a-4180-9e3c-fddbf70ee3b4",
                        "source_entry_id": "1e3e3b90-7d33-3f50-adcf-b9e3663cef8d",
                        "source_sense_id": "280f12c1-f424-3acb-a237-f34003d63da5",
