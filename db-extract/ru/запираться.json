                "senses": [
                    {
                        "sense_id": "c1379f04-98d4-3f5d-99e8-52d23f6fa076",
                        "entry_id": "95c8f688-8b0a-3817-bed4-c1ec041be55f",
                        "glosses": [
                            "to lock (oneself) up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f8c390-921a-4f05-8eaa-aaf0b9b7f47e",
                                "sense_id": "c1379f04-98d4-3f5d-99e8-52d23f6fa076",
                                "text": "– Ска́зочная систе́ма безопа́сности! – не вы́держал Илю́шин. – Нет живо́й охра́ны но́чью, кабине́т дире́ктора фо́нда не запира́ется на ключ…\n– Запира́ется! – вспы́хнул завхо́з. – Про́сто Ни́на Константи́новна э́тим часте́нько… ка́к бы сказа́ть… пренебрега́ет."
                            }
                        ]
                    },
                    {
