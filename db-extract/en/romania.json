                                                "sense_id": "ffbc0a5c-adb1-32e4-a73b-c86493489fd1",
                                                "text": "Die Donau fließt über 1000 Kilometer durch Rumänien."
                                            },
                                            {
                                                "example_id": "1efcd4bc-7428-4130-ba31-7aa0bbea9bcb",
                                                "sense_id": "ffbc0a5c-adb1-32e4-a73b-c86493489fd1",
                                                "text": "Bukarest ist die Hauptstadt von Rumänien."
                                            },
                                            {
                                                "example_id": "c17e4ab7-358f-404e-a940-5867471b37da",
                                                "sense_id": "ffbc0a5c-adb1-32e4-a73b-c86493489fd1",
                                                "text": "„Rumänien hat als säkulares Land keine Staatsreligion.“"
                                            },
                                            {
                                                "example_id": "b5030c26-7ed1-44af-a691-e1d27945a93d",
                                                "sense_id": "ffbc0a5c-adb1-32e4-a73b-c86493489fd1",
                                                "text": "„Mein erster Tag in Rumänien begann also mit einem Schrecken.“"
