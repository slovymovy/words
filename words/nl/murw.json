    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "de909640-922a-33e7-b4b6-98dac0c64b65",
                    "sense_definition": "Gedwee en niet langer in staat om weerstand te bieden, vaak door uitputting of aanhoudende druk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geestelijke_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na uren van ondervraging was de verdachte eindelijk <w>murw</w> gemaakt.",
                            "target_lang_translations": {
                                "en": "After hours of interrogation, the suspect was finally <w>worn down</w>."
                            }
                        },
                        {
                            "text": "De constante kritiek maakte hem uiteindelijk helemaal <w>murw</w>.",
                            "target_lang_translations": {
                                "en": "The constant criticism eventually made him completely <w>submissive</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "moegestreden",
                        "tam",
                        "gedwee",
                        "uitgeput"
                    ],
                    "antonyms": [
                        "weerbaar",
                        "opstandig",
                        "krachtig"
                    ],
                    "common_phrases": [
                        "murw maken",
                        "murw geslagen"
                    ],
                    "target_lang_definitions": {
                        "en": "Submissive and no longer able to resist, often due to exhaustion or persistent pressure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "worn down",
                                "target_lang_sense_clarification": "exhausted and unable to resist"
                            },
                            {
                                "target_lang_word": "mellowed",
                                "target_lang_sense_clarification": "softened or broken down by pressure"
                            },
                            {
                                "target_lang_word": "submissive",
                                "target_lang_sense_clarification": "yielding to power or authority"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "129fb30f-d1d9-376d-a27a-ca09257959c1",
                    "sense_definition": "Zacht of week gemaakt, zodanig dat alle stevigheid of hardheid verdwenen is.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vlees moet urenlang stoven tot het helemaal <w>murw</w> is.",
                            "target_lang_translations": {
                                "en": "The meat needs to stew for hours until it is completely <w>tender</w>."
                            }
                        },
                        {
                            "text": "Door de vorst zijn de achtergebleven bieten op het land <w>murw</w> geworden.",
                            "target_lang_translations": {
                                "en": "Due to the frost, the beets left behind on the land have become <w>mushy</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "week",
                        "zacht",
                        "mals"
                    ],
                    "antonyms": [
                        "hard",
                        "taai",
                        "stevig"
                    ],
                    "common_phrases": [
                        "murw koken"
                    ],
                    "target_lang_definitions": {
                        "en": "Softened or made tender, such that all firmness or hardness has disappeared."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tender",
                                "target_lang_sense_clarification": "soft and easy to chew or cut, like meat"
                            },
                            {
                                "target_lang_word": "soft",
                                "target_lang_sense_clarification": "lacking firmness or hardness"
                            },
                            {
                                "target_lang_word": "mushy",
                                "target_lang_sense_clarification": "soft and wet, having lost structure"
                            }
                        ]
                    }
                }
            ]
        },
