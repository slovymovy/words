                "senses": [
                    {
                        "sense_id": "3ce588e2-c9a6-3846-bc27-581bc45e0be6",
                        "entry_id": "9687cd38-f689-3ea2-a696-4d8747a22385",
                        "glosses": [
                            "instelling die als doel heeft mensen een prettige tijd te laten hebben"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "99148528-656f-3947-9713-172e5748a9f2",
                        "entry_id": "9687cd38-f689-3ea2-a696-4d8747a22385",
                        "glosses": [
                            "iets waar je plezier aan beleeft maar verder nutteloos is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8f3b68-045e-4fa5-b3fe-f0bbc8d21806",
                                "sense_id": "99148528-656f-3947-9713-172e5748a9f2",
                                "text": "Naast flessen ontvang ik ook regelmatig zaken ter beoordeling in de periferie van de wijnbeleving. En daar ben ik dol op. Gadgets die de wijndrinker helpen zijn genot te verdiepen. De vermakelijkheid is groot. De effectiviteit in de meeste gevallen nihil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6684c673-5f5a-485e-a2bb-4096d8296f55",
                        "source_entry_id": "9687cd38-f689-3ea2-a696-4d8747a22385",
                        "source_sense_id": "99148528-656f-3947-9713-172e5748a9f2",
                        "source_sense_description": "iets waar je plezier aan beleeft maar verder nutteloos is",
                        "target_lang_word": "entertainment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entertainment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abb57c31-ed1a-3039-a3f2-b5486c9a5ec8",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "An activity designed to give pleasure, enjoyment, diversion, amusement, or relaxation to an audience, no matter whether the audience participates passively as in watching opera or a movie, or actively as in games."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325a70f4-d30f-4477-875b-193ff02e0a1a",
                                                "sense_id": "abb57c31-ed1a-3039-a3f2-b5486c9a5ec8",
                                                "text": "The delinquents are generally the adventurous type, who have little use for reading and other non-active entertainment."
                                            },
                                            {
                                                "example_id": "93ce923a-1f09-428e-ba91-7a5cb22b01ba",
                                                "sense_id": "abb57c31-ed1a-3039-a3f2-b5486c9a5ec8",
                                                "text": "Such abundance must be laid out on superfluous recreations, buildings, ornaments, furniture, equipage, attendants, entertainments, visitations, braveries, and a world of need-nots […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45dd979a-3ad7-3b0a-a2f1-ea1aa6abe29c",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "A show put on for the enjoyment or amusement of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "108f38ec-008e-3073-8b62-0e00cd978927",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "Maintenance or support."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d52b3d36-f6c3-412f-9153-d8ea8a2f3c30",
                                                "sense_id": "108f38ec-008e-3073-8b62-0e00cd978927",
                                                "text": "\"This,\" said the matronly presence, ushering me into a low room on the right, \"is where the Travellers sit by the fire, and cook what bits of suppers they buy with their fourpences.\"\n\"O! Then they have no Entertainment?\" said I. For the inscription over the outer door was still running in my head, and I was mentally repeating, in a kind of tune, \"Lodging, entertainment, and fourpence each.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d3d541d-04e9-32ec-8a53-2690a4454551",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "Admission into service; service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7397a25-e708-4111-ac23-ca6cf73453d2",
                                                "sense_id": "9d3d541d-04e9-32ec-8a53-2690a4454551",
                                                "text": "He must think us some band of strangers i' the adversary's entertainment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30693a60-9ea7-300b-9b48-819d4208654b",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "Payment of soldiers or servants; wages."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a8e9ef-4444-43f0-a270-aebc16f0f1fb",
                                                "sense_id": "30693a60-9ea7-300b-9b48-819d4208654b",
                                                "text": "The entertainment of the general upon his first arrival was but six shillings and eight pence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6e94862-783e-3242-aa40-ae37ac59a68c",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "Reception; (provision of) food to guests or travellers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6340b628-b257-463c-bc12-66c3622f2eb1",
                                                "sense_id": "f6e94862-783e-3242-aa40-ae37ac59a68c",
                                                "text": "I prithee, shepherd, if that love or gold\nCan in this desert place buy entertainment,\nBring us where we may rest ourselves and feed."
                                            },
                                            {
                                                "example_id": "269ecc95-0e1e-4bac-8788-7ef2841bf719",
                                                "sense_id": "f6e94862-783e-3242-aa40-ae37ac59a68c",
                                                "text": "Tho’ they cut [the beef] into long Pieces, (like Ropes) with the Hide; and dress’d, and eat it half-roasted according to their Custom, and gave it me in the same Manner; yet I thought this contemptible Food, and what a Beggar in England would not have touch’d, the most delicious Entertainment I ever met with."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73c0a46d-e0e2-43fc-98f9-43e656b5d293",
                        "source_entry_id": "9687cd38-f689-3ea2-a696-4d8747a22385",
                        "source_sense_id": "99148528-656f-3947-9713-172e5748a9f2",
                        "source_sense_description": "iets waar je plezier aan beleeft maar verder nutteloos is",
                        "target_lang_word": "amusement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amusement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                        "entry_id": "e1bca45e-7d33-3ee3-b6f5-743a380f7c24",
                                        "glosses": [
                                            "Entertainment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "247c70fa-286d-4bef-bebb-e0e7702ea5d2",
                                                "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                                "text": "To my great amusement, the dog kept on chasing its tail and yelped when it bit it."
                                            },
                                            {
                                                "example_id": "0e737311-22aa-422b-bf9b-65a918b4bb94",
                                                "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                                "text": "This is some form of amusement you're talking about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                        "entry_id": "e1bca45e-7d33-3ee3-b6f5-743a380f7c24",
                                        "glosses": [
                                            "An activity that is entertaining or amusing, such as dancing, gunning, or fishing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5d70d6-fdd6-425e-afd2-45ab4bad3bd4",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "\"What a charming amusement for young people this is, Mr. Darcy! There is nothing like dancing after all. I consider it as one of the first refinements of polished society.\""
                                            },
                                            {
                                                "example_id": "0bdd7367-bdd2-498d-9848-56ca96262f11",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "His chief amusements were gunning and fishing, or sauntering along the beach and through the myrtles, in quest of shells or entomological specimens--his collection of the latter might have been envied by a Swammerdamm."
                                            },
                                            {
                                                "example_id": "7013f761-b22d-467a-bb84-05d69a48f281",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "The Cat was sour-tempered and grumpy, at first, but before they had journeyed far, the crystal creature had discovered a fine amusement. The long tails of the monkeys were constantly sticking through the bars of their cage, and when they did, the Glass Cat would slyly seize the tails in her paws and pull them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
