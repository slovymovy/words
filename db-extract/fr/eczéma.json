                                        "entry_id": "4608842f-ef0f-3dcb-b5a3-da95d7182f44",
                                        "glosses": [
                                            "Eine Entzündung der Haut, die sich durch Rötung, Juckreiz und die Bildung von schuppigen oder verkrusteten, zeitweise Flüssigkeit ausscheidenden, Flecken bemerkbar macht."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88f1865-deaf-4fd7-8b65-00f5d8fc16b1",
                                                "sense_id": "56bbc56f-e9c8-3315-9994-8a3b1cace271",
                                                "text": "Er hatte ein ekliges Ekzem auf dem Arm."
