                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "930204f3-173e-3a92-afcd-35f1fd7ae833",
                                        "entry_id": "78013772-32c5-3851-b5d2-1526b9449d74",
                                        "glosses": [
                                            "способность живого организма оставаться в живых при болезни или травмах и выздоравливать впоследствии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e545e4a-b4cc-48e2-b5c1-04b30e8b3195",
                                                "sense_id": "930204f3-173e-3a92-afcd-35f1fd7ae833",
                                                "text": "Тем не менее прогресс медицины и необычайная живучесть некоторых людей позволили врачам сделать одно немаловажное наблюдение: речь нарушается при поражении левого полушария!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66da4d90-e5ce-32d3-914a-36efb63a014e",
                                        "entry_id": "78013772-32c5-3851-b5d2-1526b9449d74",
                                        "glosses": [
                                            "техн. способность машины или какой-либо системы продолжать работу при поломках, повреждениях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85cc6d2e-230c-4545-a004-58be1b5b8170",
                                                "sense_id": "66da4d90-e5ce-32d3-914a-36efb63a014e",
                                                "text": "По сообщениям специалистов фирмы «Моваг», увеличенное количество осей обеспечивает более высокую живучесть машины при повреждении узлов ходовой части, лучшие условия для работы экипажа при движении по пересеченной местности, дополнительную защиту корпуса от мин и осколков снарядов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd5727a-bd1c-3d2a-9daa-d28c817875bf",
                                        "entry_id": "78013772-32c5-3851-b5d2-1526b9449d74",
                                        "glosses": [
                                            "воен. способность боевой единицы оставаться боеспособной в боевых условиях, при повреждениях или потерях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4990a241-a57f-4217-926e-0f8e6ebd7e1b",
                                                "sense_id": "cbd5727a-bd1c-3d2a-9daa-d28c817875bf",
                                                "text": "Наличие в группе опытного снайпера резко повысит боевую результативность и живучесть малого подразделения."
                                            },
                                            {
                                                "example_id": "cf71e0d4-b689-4c62-876d-a38d29dbe983",
                                                "sense_id": "cbd5727a-bd1c-3d2a-9daa-d28c817875bf",
                                                "text": "Применение такой тактики позволяет сохранять живучесть системы в условиях контрбатарейной борьбы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54685aea-fe75-3ef3-ad74-8729e4efe69c",
                                        "entry_id": "78013772-32c5-3851-b5d2-1526b9449d74",
                                        "glosses": [
                                            "морск. способность плавательного средства оставаться на плаву при повреждениях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5809e60e-4ae1-45a4-80d0-c61562582105",
                                                "sense_id": "54685aea-fe75-3ef3-ad74-8729e4efe69c",
                                                "text": "…создан специализированный центр с макетом корабельных отсеков для отработки борьбы за живучесть корабля…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
