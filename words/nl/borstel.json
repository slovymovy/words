{
    "word_family": [
        "borstelen",
        "borsteling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9274a7da-8773-36e6-b855-b53e419a1bab",
                    "sense_definition": "Een gebruiksvoorwerp bestaande uit een bundel haren of vezels in een houder om mee te reinigen of te verzorgen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je me die <w>borstel</w> even aanreiken?",
                            "target_lang_translations": {
                                "ru": "Можешь подать мне ту <w>щётку</w>?"
                            }
                        },
                        {
                            "text": "Zij gebruikt elke ochtend een <w>borstel</w> voor haar lange haar.",
                            "target_lang_translations": {
                                "ru": "Она каждое утро использует <w>щётку</w> для своих длинных волос."
                            }
                        }
                    ],
                    "common_phrases": [
                        "haar borstel",
                        "kleding borstel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет для чистки или ухода, состоящий из пучка щетины или волокон, закрепленных в корпусе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щётка",
                                "target_lang_sense_clarification": "хозяйственный инструмент для чистки или ухода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5c7ef6d-e76e-3831-adfd-12f6b5139ff6",
                    "sense_definition": "Een grove kwast of een op een bezem gelijkend gereedschap voor zwaar schoonmaakwerk.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gebruik een harde <w>borstel</w> om de tegels in de tuin schoon te maken.",
                            "target_lang_translations": {
                                "ru": "Используй жесткую <w>щётку</w>, чтобы почистить плитку в саду."
                            }
                        },
                        {
                            "text": "De straatveger gebruikt een grote <w>borstel</w> om het vuil weg te vegen.",
                            "target_lang_translations": {
                                "ru": "Дворник использует большую <w>щётку</w>, чтобы смести мусор."
                            }
                        }
                    ],
                    "synonyms": [
                        "schuier"
                    ],
                    "common_phrases": [
                        "harde borstel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубая щетка или инструмент, похожий на метлу, для тяжелой уборки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щётка",
                                "target_lang_sense_clarification": "жесткая щетка для уборки"
                            },
                            {
                                "target_lang_word": "метла",
                                "target_lang_sense_clarification": "инструмент для подметания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b09bb8d-310f-367a-be3c-d7e5a3c92422",
                    "sense_definition": "Een instrument met haren om verf mee aan te brengen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doop de <w>borstel</w> in de verf en begin met schilderen.",
                            "target_lang_translations": {
                                "ru": "Окуни <w>кисть</w> в краску и начинай красить."
                            }
                        },
                        {
                            "text": "Na het schilderen moet je de <w>borstel</w> goed uitwassen met water.",
                            "target_lang_translations": {
                                "ru": "После покраски нужно хорошо промыть <w>кисть</w> водой."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwast"
                    ],
                    "common_phrases": [
                        "verf borstel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент с волосками для нанесения краски."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кисть",
                                "target_lang_sense_clarification": "инструмент для рисования или покраски"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8548d6fe-aeb9-3880-920c-a8a9a4fc0f53",
                    "sense_definition": "Een stijve haar of vezel die uitsteekt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het zwijn heeft een stugge <w>borstel</w> op zijn rug.",
                            "target_lang_translations": {
                                "ru": "У кабана на спине жесткая <w>щетина</w>."
                            }
                        },
                        {
                            "text": "De <w>borstel</w> van het insect helpt bij het voelen van de omgeving.",
                            "target_lang_translations": {
                                "ru": "<w>Щетинка</w> насекомого помогает ему чувствовать окружающую среду."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жесткий волос или волокно, которое торчит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щетина",
                                "target_lang_sense_clarification": "жесткие волосы или волоски"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13438bda-8ca5-3d9f-a338-e2d4428547c3",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>borstelen</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "handeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>borstel</w> elke dag mijn hond om losse haren te verwijderen.",
                            "target_lang_translations": {
                                "ru": "Я каждый день <w>вычесываю</w> свою собаку, чтобы удалить выпавшую шерсть."
                            }
                        },
                        {
                            "text": "Ik <w>borstel</w> mijn tanden grondig voordat ik naar bed ga.",
                            "target_lang_translations": {
                                "ru": "Я тщательно <w>чищу</w> зубы перед сном."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Первое лицо единственного числа настоящего времени глагола «чистить щеткой» или «расчесывать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чищу",
                                "target_lang_sense_clarification": "действие по очистке щеткой"
                            },
                            {
                                "target_lang_word": "расчесываю",
                                "target_lang_sense_clarification": "действие по уходу за волосами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e89812af-e897-385a-9a9b-c480c53f944d",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>borstelen</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "handeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Borstel</w> jij je haar voordat je naar school gaat?",
                            "target_lang_translations": {
                                "ru": "<w>Расчесываешь</w> ли ты волосы перед тем, как идти в школу?"
                            }
                        },
                        {
                            "text": "Waarom <w>borstel</w> jij de kleding niet even af?",
                            "target_lang_translations": {
                                "ru": "Почему ты не <w>почистишь</w> одежду?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Второе лицо единственного числа настоящего времени глагола «чистить щеткой» или «расчесывать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистишь",
                                "target_lang_sense_clarification": "действие по очистке щеткой"
                            },
                            {
                                "target_lang_word": "расчесываешь",
                                "target_lang_sense_clarification": "действие по уходу за волосами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e3aa05b-6f6e-318f-bfd1-a455be5a939b",
                    "sense_definition": "Gebiedende wijs van <w>borstelen</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "handeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Borstel</w> de modder van je schoenen voordat je naar binnen gaat.",
                            "target_lang_translations": {
                                "ru": "<w>Счисти</w> грязь с обуви, прежде чем войти."
                            }
                        },
                        {
                            "text": "<w>Borstel</w> je jas even af, want er zit veel stof op.",
                            "target_lang_translations": {
                                "ru": "<w>Почисти</w> куртку, а то на ней много пыли."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повелительное наклонение глагола «чистить щеткой» или «расчесывать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почисти",
                                "target_lang_sense_clarification": "призыв к действию по очистке"
                            },
                            {
                                "target_lang_word": "расчеши",
                                "target_lang_sense_clarification": "призыв к действию по уходу за волосами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}