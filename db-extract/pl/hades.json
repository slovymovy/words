                        "cross_references": []
                    },
                    {
                        "translation_id": "4ce6b715-160b-425a-b75b-016d3c6665f0",
                        "source_entry_id": "c5bf359f-f9e4-36f4-bc55-6080e2efc7d0",
                        "source_sense_id": "4dac79ba-53ed-30eb-b3bd-3ad73c53fc28",
                        "target_lang_word": "аид",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аид",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "774be117-0067-3d10-8fed-1a3e8580499c",
                                        "entry_id": "f4b627eb-e8da-3d61-b37c-9952bf298c47",
                                        "glosses": [
                                            "мифол. в представлении древних греков — подземное царство мёртвых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd67ce33-1e80-4e95-9cd9-bc70874b6678",
                                                "sense_id": "774be117-0067-3d10-8fed-1a3e8580499c",
                                                "text": "Не знаю, что стал бы делать Платон, окажись он в моем положении. Наверно, решил бы, что умер и попал в аид."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "аид",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "51154512-198d-3fbd-85f8-262e329ad0ca",
                                        "entry_id": "fb9fcfa1-0427-3638-bf1c-920fc85d852d",
                                        "glosses": [
                                            "еврей"
                                        ],
                                        "tags": [
                                            "еврейск. жарг."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33bb78b8-258e-4363-9ea1-3d5af7dc49a2",
                                                "sense_id": "51154512-198d-3fbd-85f8-262e329ad0ca",
                                                "text": "Ты не знаешь, что значит жить в провинции... Мои родители жили как в девятнадцатом веке. Тёти, дяди, братья, сёстры, кузены, бабушки, дедушки - и все аиды. Никто в синагогу не ходит, даже на идише никто не говорит, но все обсуждают, сколько в том и в том еврейской крови."
                                            },
                                            {
                                                "example_id": "2a1e32f6-38fe-49c6-8367-c43d42081f0b",
                                                "sense_id": "51154512-198d-3fbd-85f8-262e329ad0ca",
                                                "text": "Среди этих людей диссонансом смотрелась пара: русская красавица в косынке и пожилой печальный аид."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
