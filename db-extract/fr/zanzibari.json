                "senses": [
                    {
                        "sense_id": "cdce586d-e305-3641-978a-128031280767",
                        "entry_id": "554ad14b-4c07-382d-9460-166041551a58",
                        "glosses": [
                            "Relatif à Zanzibar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0400ef-906a-4c42-83f7-b042df01311a",
                                "sense_id": "cdce586d-e305-3641-978a-128031280767",
                                "text": "La « citoyenneté » zanzibarie devenait donc une condition sine qua non pour participer à la vie politique des îles."
                            },
                            {
                                "example_id": "d63b5baf-f6e0-4380-91a5-1211a4821608",
                                "sense_id": "cdce586d-e305-3641-978a-128031280767",
                                "text": "C’est dans ce contexte de plus en plus tendu qu’un mouvement autonomiste et anti-continental a commencé à enfler dans l’île tout en réactivant dans le même temps les fondements identitaires de la société zanzibarie, brandis comme une justification, voire comme une légitimation de la revendication nationaliste."
                            },
                            {
                                "example_id": "515c09b3-d2c6-4608-9396-86a5b683cca0",
                                "sense_id": "cdce586d-e305-3641-978a-128031280767",
                                "text": "« Nous poursuivons nos opérations de recherche », a indiqué le ministre zanzibari, appelant les familles qui n’ont pas encore retrouvé les leurs à le signaler aux autorités."
                            }
                        ]
                    }
