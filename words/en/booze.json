                    "sense_id": "2affbf47-4c80-34aa-9b7d-cb12cadb85c2",
                    "sense_definition": "Any alcoholic beverage, especially beer or hard liquor.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought some cheap <w>booze</w> for the party.",
