                            {
                                "target_lang_word": "жаркий",
                                "target_lang_sense_clarification": "о погоде или климате"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26ee301f-71f7-325f-bf7c-68d54a0a8ae7",
                    "sense_definition": "Feeling the sensation of heat, especially to the point of discomfort.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am so <w>hot</w> from being in the sun for too long today.",
                            "target_lang_translations": {
                                "ru": "Мне так <w>жарко</w> оттого, что я сегодня слишком долго был на солнце."
                            }
                        },
                        {
                            "text": "Aren't you <w>hot</w> with that thick winter coat on inside the house?",
                            "target_lang_translations": {
                                "ru": "Разве тебе не <w>жарко</w> в этом толстом зимнем пальто внутри дома?"
                            }
                        }
                    ],
                    "synonyms": [
                        "overheated"
                    ],
                    "antonyms": [
                        "cold",
                        "chilly"
                    ],
                    "common_phrases": [
                        "get hot",
                        "feel hot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ощущение жара, особенно до степени дискомфорта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жарко",
                                "target_lang_sense_clarification": "об ощущении человека"
