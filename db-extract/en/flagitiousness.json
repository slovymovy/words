                        "glosses": [
                            "The state or quality of being flagitious; wickedness, infamy."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8461ad70-70e5-4190-bf45-dec12fb196cd",
                                "sense_id": "2453c581-2ce1-3061-941e-8ec65d3b771d",
                                "text": "Anſelm calls a Synod at St. Paul’s, where was this Statute made; We condemn this Sodomitical Flagitiouſneſs in any, and thoſe that aſſiſt them, with a heavy Anathema."
                            },
                            {
                                "example_id": "658c7b3f-cc0e-46ce-80cb-16800a3b14a7",
                                "sense_id": "2453c581-2ce1-3061-941e-8ec65d3b771d",
                                "text": "[H]ow can he esteem himself, when conscience will ever upbraid him with the participation in an act, whose flagitiousness is so great, that unless he renounces the character of man, his very share would be sufficient to sink him under the most ignominious contempt […]?"
                            },
                            {
                                "example_id": "3fea60b2-9c99-4547-b5a2-3cd4d33bacd0",
                                "sense_id": "2453c581-2ce1-3061-941e-8ec65d3b771d",
                                "text": "[T]he man of sensibility, who thus, perhaps, complains, by his promiscuous amours produces a most destructive barrenness and contagious flagitiousness of manners."
                            },
                            {
                                "example_id": "e286126d-fa41-454e-bca6-b9298aae9656",
                                "sense_id": "2453c581-2ce1-3061-941e-8ec65d3b771d",
                                "text": "The papers have lately advanced in boldness and flagitiousness beyond even themselves."
                            }
                        ]
                    }
