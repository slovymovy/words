{
    "word_family": [
        "proper",
        "properly",
        "impropriety"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fd2f5ce-ea40-345d-9ea6-de09c25344c7",
                    "sense_definition": "The quality of being suitable or appropriate for a particular situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "appropriateness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee questioned the <w>propriety</w> of using public funds for such a private event.",
                            "target_lang_translations": {
                                "zh": "委员会质疑将公共资金用于此类私人活动是否具有<w>恰当性</w>。"
                            }
                        },
                        {
                            "text": "He debated the <w>propriety</w> of his actions before deciding to speak to the board.",
                            "target_lang_translations": {
                                "zh": "他在决定与董事会谈话前，反复斟酌了自己行为的<w>适宜性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suitability",
                        "fitness",
                        "appropriateness"
                    ],
                    "antonyms": [
                        "impropriety",
                        "unsuitability"
                    ],
                    "common_phrases": [
                        "with propriety"
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物在特定情况下是否合适或恰当的性质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "恰当性",
                                "target_lang_sense_clarification": "强调事物与环境或目的的匹配程度。"
                            },
                            {
                                "target_lang_word": "适宜性",
                                "target_lang_sense_clarification": "指事物是否符合某种标准或要求。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c679f28-cebd-305d-ba61-e52a287784c3",
                    "sense_definition": "Conformity to established standards of behavior, morals, or social etiquette.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "appropriateness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was known for her strict adherence to social <w>propriety</w> in all public settings.",
                            "target_lang_translations": {
                                "zh": "她以在所有公共场合严格遵守社交<w>礼节</w>而闻名。"
                            }
                        },
                        {
                            "text": "His behavior at the formal dinner was a clear violation of basic <w>propriety</w>.",
                            "target_lang_translations": {
                                "zh": "他在正式晚宴上的行为显然违背了基本的<w>礼节</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decorum",
                        "seemliness",
                        "etiquette"
                    ],
                    "antonyms": [
                        "impropriety",
                        "indecency"
                    ],
                    "common_phrases": [
                        "sense of propriety"
                    ],
                    "target_lang_definitions": {
                        "zh": "指符合社会公认的行为准则、道德规范或礼仪。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "礼节",
                                "target_lang_sense_clarification": "指社交场合中应遵守的礼貌和规矩。"
                            },
                            {
                                "target_lang_word": "得体",
                                "target_lang_sense_clarification": "形容行为举止符合社会规范，不失礼。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d36900e1-1293-3409-8d3d-20d1ab753795",
                    "sense_definition": "The use of correct language, grammar, or pronunciation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor insisted on linguistic <w>propriety</w> in all academic essays submitted to the department.",
                            "target_lang_translations": {
                                "zh": "教授坚持要求提交给系里的所有学术论文都必须具备语言<w>规范性</w>。"
                            }
                        },
                        {
                            "text": "He was often criticized for his lack of <w>propriety</w> when using slang in formal speeches.",
                            "target_lang_translations": {
                                "zh": "他因在正式演讲中使用俚语而常被批评缺乏语言<w>规范性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "correctness"
                    ],
                    "target_lang_definitions": {
                        "zh": "指语言使用、语法或发音的规范性与准确性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "规范性",
                                "target_lang_sense_clarification": "指语言表达符合标准语法和用法。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}