                "senses": [
                    {
                        "sense_id": "23a3de3d-9f7b-37ba-a0bf-027f8e2bf893",
                        "entry_id": "4f6f29fb-de42-3c34-a9f1-7aba555bc36e",
                        "glosses": [
                            "Zerteilung bestimmter Größen in kleine Teile; diese Größen können also nur diskrete Werte aus einem gestuften Wertvorrat annehmen, statt kontinuierlich veränderbar zu sein"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "bbe2df2f-3bdf-4028-8a87-1bcf5c0bac3c",
                                "sense_id": "23a3de3d-9f7b-37ba-a0bf-027f8e2bf893",
                                "text": "„Die ersten Versuche einer Quantisierung des elektromagnetischen Feldes zielten darauf ab, die Emission von Photonen durch ein Atom beschreiben zu können.“"
                            },
                            {
                                "example_id": "faad609f-9ab7-44a6-a411-564d35431310",
                                "sense_id": "23a3de3d-9f7b-37ba-a0bf-027f8e2bf893",
                                "text": "„Die dem Schalenmodell zugrundeliegenden Elektronenschalen ergeben sich durch die Quantisierung der Elektronenenergien im Kraftfeld des Atomkerns nach den Regeln der Quantenmechanik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
