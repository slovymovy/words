                "senses": [
                    {
                        "sense_id": "057fd8db-13c1-3977-8db1-36a2b3a7ba77",
                        "entry_id": "fcb68b5b-0643-3392-96b6-179d483378a4",
                        "glosses": [
                            "hochgestelltes, entscheidungsbefugtes Mitglied einer Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aac31378-7fb7-44f2-baee-3bf4271d7f86",
                                "sense_id": "057fd8db-13c1-3977-8db1-36a2b3a7ba77",
                                "text": "„Zum Glück erlaubte der von allem Antiken begeisterte Kirchenfürst sehr bald, dass Abschriften hergestellt wurden.“"
                            },
                            {
                                "example_id": "c38ba812-e062-43ed-89f6-d5e27c58388f",
                                "sense_id": "057fd8db-13c1-3977-8db1-36a2b3a7ba77",
                                "text": "„Dieser würdige Kirchenfürst war ein natürlicher Sohn des Herzogs von Orléans, des berühmten Regenten von Frankreich, und einer Schauspielerin.“"
                            },
                            {
                                "example_id": "be6ddd0f-7cf8-49f0-9f1c-438ba5c5781f",
                                "sense_id": "057fd8db-13c1-3977-8db1-36a2b3a7ba77",
                                "text": "„Wie die Kirchenfürsten und die Fürsten der Reformation wurde auch Luther in Rollenbilder gebannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
