            "senses": [
                {
                    "sense_id": "85978b94-0977-329c-85bd-4491feb4ffd7",
                    "sense_definition": "A police officer or prison guard.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "law enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cop</w> asked the driver for his license and registration.",
                            "target_lang_translations": {
                                "ru": "<w>Коп</w> попросил у водителя права и техпаспорт.",
                                "zh": "<w>警察</w>要求司机出示驾照和行驶证。"
                            }
                        },
                        {
                            "text": "You should call a <w>cop</w> if you see someone breaking into that car.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит вызвать <w>полицию</w>, если увидишь, как кто-то взламывает ту машину.",
                                "zh": "如果你看到有人撬那辆车，你应该报警，叫个<w>警察</w>来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "police officer",
                        "policeman",
                        "copper",
                        "lawman"
                    ],
                    "antonyms": [
                        "criminal",
                        "lawbreaker"
                    ],
                    "common_phrases": [
