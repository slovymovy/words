                                    },
                                    {
                                        "sense_id": "65bc32dd-3ab9-3f96-b9f0-3f472217881e",
                                        "entry_id": "9e2b7daf-f271-3208-8c38-2f96fc39bd1a",
                                        "glosses": [
                                            "Trial by danger or by affliction; adventure; risk; hardship; state of being tried."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c6377a-fcb8-4b68-8e68-4bef9a336952",
                                                "sense_id": "65bc32dd-3ab9-3f96-b9f0-3f472217881e",
                                                "text": "Through many hard assayes which did betide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66db0b17-d6cc-3405-8317-d073a9b0fe65",
                                        "entry_id": "9e2b7daf-f271-3208-8c38-2f96fc39bd1a",
                                        "glosses": [
                                            "Tested purity or value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18032aa0-14a5-41cb-8ecc-fa1ee630fb7e",
                                                "sense_id": "66db0b17-d6cc-3405-8317-d073a9b0fe65",
                                                "text": "Purfled with gold and pearl of rich assay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e249709-84d4-3ad5-94d4-53d0e519a437",
                                        "entry_id": "9e2b7daf-f271-3208-8c38-2f96fc39bd1a",
                                        "glosses": [
                                            "The act or process of ascertaining the proportion of a particular metal in an ore or alloy; especially, the determination of the proportion of gold or silver in bullion or coin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e681c4c5-a677-3f98-bad0-24e9fbc19dfb",
                                        "entry_id": "9e2b7daf-f271-3208-8c38-2f96fc39bd1a",
                                        "glosses": [
                                            "The alloy or metal to be assayed."
                                        ],
