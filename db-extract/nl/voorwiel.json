                                "sense_id": "f6795fd4-366f-3825-965d-be4d3e6eed11",
                                "text": "Hij controleert het voorwiel van zijn fiets voordat hij vertrekt.",
                                "translation": "He checks the front wheel of his bike before he leaves.",
                                "english": "He checks the front wheel of his bike before he leaves."
                            },
