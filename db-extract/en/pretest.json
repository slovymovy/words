                    },
                    {
                        "translation_id": "534faf2c-6eb4-486d-b194-97e6c64f6689",
                        "source_entry_id": "7a6fc220-629c-3fca-9625-b3f9ee49ae03",
                        "source_sense_id": "d28bc54f-1fa7-32bf-956a-c2df9d9515dc",
                        "source_sense_description": "A test given in advance of instruction or evaluation",
                        "target_lang_word": "Ersttest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f6aec93b-3097-40d8-9a60-abebac3f85d0",
                        "source_entry_id": "7a6fc220-629c-3fca-9625-b3f9ee49ae03",
                        "source_sense_id": "d28bc54f-1fa7-32bf-956a-c2df9d9515dc",
                        "source_sense_description": "A test given in advance of instruction or evaluation",
                        "target_lang_word": "Prätest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prätest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b99b4c97-40b1-3f1f-9fa3-f451740f9d48",
                                        "entry_id": "f6228d2e-189f-3a9c-9c24-0fa3957db5c2",
                                        "glosses": [
                                            "Test zur Untersuchung der Qualität eines Untersuchungsinstruments, der vor dem eigentlichen Test eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "024b0d4d-349e-4df1-9dd2-930af41d6f17",
                                                "sense_id": "b99b4c97-40b1-3f1f-9fa3-f451740f9d48",
                                                "text": "„Vor der Durchführung der auf Herbst 1986 und Frühjahr 1987 beschränkten Hauptuntersuchung war es notwendig, mittels sog. Prätests die Funktionalität der ersten Version unseres Fragebuchs zu überprüfen.“"
                                            },
                                            {
                                                "example_id": "238f29b3-3959-4248-8076-9a952e4ad9d9",
                                                "sense_id": "b99b4c97-40b1-3f1f-9fa3-f451740f9d48",
                                                "text": "„Die Antwortmöglichkeiten auf die Frage nach den Motiven für das Erlernen eines Instruments (Frage 9) wurden auf Grund der Ergebnisse des Prätests entwickelt.“"
                                            },
                                            {
                                                "example_id": "32be9ae4-1840-4423-9b63-8c67c81aa2be",
                                                "sense_id": "b99b4c97-40b1-3f1f-9fa3-f451740f9d48",
                                                "text": "„Das Ziel des dritten Prätests bestand in einer genaueren Überprüfung des vorläufigen Instruments.“"
                                            },
                                            {
                                                "example_id": "01305efb-0c10-4ab8-b686-558df830a69b",
                                                "sense_id": "b99b4c97-40b1-3f1f-9fa3-f451740f9d48",
                                                "text": "„Diese Prätests haben primär die Funktion, uns auf die Probleme aufmerksam zu machen, die bei der Ausführung der Tests in einem weiteren Rahmen auf uns zukommen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3f0175d-4ca9-394d-b5f1-990b6e10672f",
                                        "entry_id": "f6228d2e-189f-3a9c-9c24-0fa3957db5c2",
                                        "glosses": [
                                            "Test zur Ermittlung der gegenwärtigen Ausprägung eines (Persönlichkeits-)Merkmals, bevor eine Intervention/ein Treatment eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bb5dba9-4e56-41a9-98cb-5b01a5e4c2ac",
                                                "sense_id": "a3f0175d-4ca9-394d-b5f1-990b6e10672f",
                                                "text": "„Der Prätest für die Schülerinnen und Schüler erfolgte im September und Oktober 2004, also einige Monate nach Start des Schuljahres, um sicherzstellen, dass sie valide Aussagen über ihre Kompetenzen im Fach Mathematik treffen konnten.“"
                                            },
                                            {
                                                "example_id": "406839de-987e-4441-95da-ca0646624c18",
                                                "sense_id": "a3f0175d-4ca9-394d-b5f1-990b6e10672f",
                                                "text": "„Wenn nun die beiden Messzeitpunkte einen großen Teil an wahrer Varianz gemeinsam haben, dann gehen mögliche Unterschiede zwischen Prä- und Posttest vor allem auf Messfehler zurück.“"
                                            },
                                            {
                                                "example_id": "6125da98-d09d-4f85-ad72-742075b57c07",
                                                "sense_id": "a3f0175d-4ca9-394d-b5f1-990b6e10672f",
                                                "text": "„Die Ergebnisse der Gespräche sind zum Zeitpunkt des Posttests aus der Perspektive des Ratsuchenden genauso zufriedenstellend wie zum Zeitpunkt des Prätests, es kommt nicht zu einem Anstieg des Beratungserfolgs.“"
                                            },
                                            {
                                                "example_id": "d1a93ef3-a4c1-49d4-84dc-5624c68408fe",
                                                "sense_id": "a3f0175d-4ca9-394d-b5f1-990b6e10672f",
                                                "text": "„Die Befunde des Prätests zeigten wie erwartet, dass bei den Studienteilnehmenden im Bereich Berufsorientierung zu Beginn der Untersuchung nur eine geringe Wissensbasis und Lösungsideen für Probleme der Berufsorientierung in der Schule vorhanden waren.“"
                                            },
                                            {
                                                "example_id": "31a6ff2e-d49f-4637-9af4-91291faef818",
                                                "sense_id": "a3f0175d-4ca9-394d-b5f1-990b6e10672f",
                                                "text": "„Wie in Tabelle 5.20 dargestellt, wurden im Prätest, der meist eine Woche vor Intervention und Posttest stattfand, die Kontrollvariablen erhoben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
