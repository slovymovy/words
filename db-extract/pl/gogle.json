                                                "example_id": "291e1588-7b24-4fd0-9ed0-6149164b20fe",
                                                "sense_id": "5655cfe3-3ecf-3903-b408-de3c8d9157ce",
                                                "text": "We had to put on our goggles as it was snowing outside."
                                            },
                                            {
                                                "example_id": "27108c70-afa6-4409-a079-3a202ea283e2",
                                                "sense_id": "5655cfe3-3ecf-3903-b408-de3c8d9157ce",
                                                "text": "Regretted that I had not provided myself with goggles, as the road is so constantly traveled that the dust became a most serious nuisance."
                                            }
