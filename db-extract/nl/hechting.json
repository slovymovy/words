                                        "entry_id": "f915d775-fc29-36a8-b5a7-0f6a3ec36750",
                                        "glosses": [
                                            "A thin stratum, especially of an economically viable material such as coal or mineral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef8d1dc-b2ce-4586-92d5-b9d90f4d6814",
                                                "sense_id": "cfe680d9-84d7-3cb4-a820-e97f54321b6f",
                                                "text": "He even roused himself to go to the mines once more: […]. He sat there, crippled, in a tub, with the under-ground manager showing him the seam with a powerful torch."
                                            }
                                        ]
                                    },
