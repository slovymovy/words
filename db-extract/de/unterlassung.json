                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b532e10-006d-3a4f-a026-5e95f2215a53",
                        "entry_id": "03f54dc9-3126-3e4a-9835-edaa88e44212",
                        "glosses": [
                            "(oft absichtliches) Ausbleiben einer Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cfae152-9e0a-4c00-ae5d-235ca78ef7d5",
                                "sense_id": "9b532e10-006d-3a4f-a026-5e95f2215a53",
                                "text": "„Politik muss lernen, dass auch die Unterlassung einer Regelung gute Politik sein kann.“"
                            },
                            {
                                "example_id": "4382c77c-2b17-43af-ac0f-35a565ddfa2d",
                                "sense_id": "9b532e10-006d-3a4f-a026-5e95f2215a53",
                                "text": "„Wird die Angabe der Zeitung oder Zeitschrift unterlassen, so stehen ihrem Herausgeber oder, wenn ein solcher nicht genannt ist, ihrem Verleger die gleichen Ansprüche zu wie einem Urheber im Fall einer rechtswidrigen Unterlassung der Angabe der Urheberbezeichnung.“"
                            },
                            {
                                "example_id": "5a8775f9-eff3-4c7e-acd2-75a25c17e0fc",
                                "sense_id": "9b532e10-006d-3a4f-a026-5e95f2215a53",
                                "text": "„Wer in einer der ihm aus einer Marke zustehenden Befugnisse verletzt wird oder eine solche Verletzung zu besorgen hat, kann auf Unterlassung klagen.“"
                            },
                            {
                                "example_id": "ace7ef45-7657-4247-a8a7-4d6780fbee88",
                                "sense_id": "9b532e10-006d-3a4f-a026-5e95f2215a53",
                                "text": "„Läßt sich aber im Sinne dieser Rechtsauffassung der Anspruch auf Unterlassung kreditschädigender Tatsachenbehauptungen entgegen der für den deutschen Rechtsbereich vertretenen Ansicht nicht schon aus einer allgemeinen Rechtspflicht zur Unterlassung rechtswidriger Handlungen, sondern im Sinne der […] ausführlich dargelegten Erwägungen allein im Wege eines Größenschlusses aus dem […] Widerrufsanspruch ableiten, dann folgt daraus, daß auch die rechtlichen Voraussetzungen dieser beiden Ansprüche die gleichen sein müssen, der Verletzer also nur dann auf Unterlassung in Anspruch genommen werden kann, wenn er die Unwahrheit der von ihm Tatsachenbehauptungen kannte oder kennen mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92d4a1ba-4b53-4cbf-b434-8bdf1723534d",
                        "source_entry_id": "03f54dc9-3126-3e4a-9835-edaa88e44212",
                        "source_sense_id": "9b532e10-006d-3a4f-a026-5e95f2215a53",
