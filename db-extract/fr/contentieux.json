                                "target_senses": [
                                    {
                                        "sense_id": "915f6021-fb39-36c9-95b7-47358451d7b8",
                                        "entry_id": "c6f3d856-1f06-33a9-8f47-364dc1f86574",
                                        "glosses": [
                                            "Marked by heated arguments or controversy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d505c3-dcd9-4f45-a850-b32120024d45",
                                                "sense_id": "915f6021-fb39-36c9-95b7-47358451d7b8",
                                                "text": "Ukraine, however, will complain long and hard about a contentious second-half incident when Marko Devic's shot clearly crossed the line before it was scrambled away by John Terry, only for the officials to remain unmoved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6ed546f-c138-346a-8bdb-080c51d0f9bc",
                                        "entry_id": "c6f3d856-1f06-33a9-8f47-364dc1f86574",
                                        "glosses": [
                                            "Given to struggling with others out of jealousy or discord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a057315e-8e7f-4a7c-8c11-4cad8eeff575",
                                                "sense_id": "f6ed546f-c138-346a-8bdb-080c51d0f9bc",
                                                "text": "She was not a contentious person as the Other had been; she did not argue and contradict everything I said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
