                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew scrambled up the <w>yards</w> to furl the sails before the storm hit.",
                            "target_lang_translations": {
