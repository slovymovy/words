                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34fc7060-d4bb-485c-9d6d-82f69b3a41a0",
                                                "sense_id": "17330843-e76d-3ee8-bcd1-1c11ee3d4bc7",
                                                "text": "So you punched out a window for ventilation. Was that before or after you noticed you were standing in a lake of gasoline?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ea15b43-58d9-3339-af1c-fb488946e919",
                                        "entry_id": "75ca4602-3d62-3730-a002-470054901e26",
                                        "glosses": [
                                            "The mechanical system used to circulate and replace air."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28a2f2e7-c2dd-31b9-80bd-c6238b7b2feb",
                                        "entry_id": "75ca4602-3d62-3730-a002-470054901e26",
