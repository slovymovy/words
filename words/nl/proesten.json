{
    "word_family": [
        "geproest",
        "proestbui"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4581b6c1-c2f6-318a-94f6-8fbaa0613cc4",
                    "sense_definition": "een kort, stotend geluid maken door de neus of mond, vaak bij het proberen in te houden van een lach",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij die gekke bek trok, moest zij hardop <w>proesten</w> van het lachen.",
                            "target_lang_translations": {
                                "en": "When he made that funny face, she couldn't help but <w>snort</w> with laughter."
                            }
                        },
                        {
                            "text": "De komische vergissing deed de hele kerk <w>proesten</w>.",
                            "target_lang_translations": {
                                "en": "The comical mistake made the whole church <w>burst out laughing</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "proestlachen",
                        "snuiven"
                    ],
                    "common_phrases": [
                        "proesten van het lachen",
                        "in lachen proesten"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a short, explosive sound through the nose or mouth, often when trying to suppress a laugh"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to snort",
                                "target_lang_sense_clarification": "to make a sudden sound through the nose while laughing"
                            },
                            {
                                "target_lang_word": "to sputter",
                                "target_lang_sense_clarification": "to make explosive sounds when laughing or speaking"
                            },
                            {
                                "target_lang_word": "to burst out laughing",
                                "target_lang_sense_clarification": "to suddenly start laughing loudly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd412964-c2cd-3089-a6b8-a97e6e736a84",
                    "sense_definition": "op een krachtige manier lucht door de neus naar buiten drijven; <w>niezen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lichaamsfunctie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het stof in de oude kamer begon hij onbedaarlijk te <w>proesten</w>.",
                            "target_lang_translations": {
                                "en": "Because of the dust in the old room, he started <w>sneezing</w> uncontrollably."
                            }
                        },
                        {
                            "text": "Het paard stond luidruchtig te <w>proesten</w> in de wei.",
                            "target_lang_translations": {
                                "en": "The horse was <w>snorting</w> loudly in the meadow."
                            }
                        }
                    ],
                    "synonyms": [
                        "niezen"
                    ],
                    "common_phrases": [
                        "luidruchtig proesten"
                    ],
                    "target_lang_definitions": {
                        "en": "to forcefully expel air through the nose; to sneeze or snort"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sneeze",
                                "target_lang_sense_clarification": "to expel air through the nose due to irritation"
                            },
                            {
                                "target_lang_word": "to snort",
                                "target_lang_sense_clarification": "to force air through the nose, often used for animals like horses"
                            },
                            {
                                "target_lang_word": "to puff",
                                "target_lang_sense_clarification": "to blow out air forcefully"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}