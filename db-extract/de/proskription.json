                                            {
                                                "example_id": "9b711f4d-b269-42ef-b4cb-e5a73a67d3d0",
                                                "sense_id": "3568559d-b746-390a-9f59-7dded9e86c88",
                                                "text": "He was wholly unopposed, for the boldest spirits had fallen in battle, or in the proscription [...]"
                                            }
                                        ]
