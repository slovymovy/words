                        "entry_id": "f869d1e2-d925-3600-8e1d-5759c4218149",
                        "glosses": [
                            "A mathematical function that describes the propagation of the quantum mechanical wave associated with a particle (or system of particles), related to the probability of finding the particle in a particular region of space."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb6c198e-998e-4c83-88d8-27fd605405e4",
                                "sense_id": "e5117e19-1724-3ff8-8975-4fb98b0c2064",
                                "text": "The interpretation of the wavefunction was one of the thorny issues facing the early pioneers of quantum theory."
                            }
                        ]
                    }
