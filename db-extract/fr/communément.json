                                        "sense_id": "6f5b0547-3691-3c1f-bd57-ad4355008a4f",
                                        "entry_id": "527efa7a-447e-30cb-b74b-dd8bcdda11ca",
                                        "glosses": [
                                            "zoals de ervaring leert dat het meestal is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0792415-13ad-41c7-b94e-952e40d5df72",
                                                "sense_id": "6f5b0547-3691-3c1f-bd57-ad4355008a4f",
                                                "text": "Zouden we hier weer zoals gewoonlijk de maand augustus doorbrengen? Zouden we elk weekend terugkomen als Malcolmm Als Malcolm."
                                            },
                                            {
                                                "example_id": "33bd6ecd-fe22-422a-a8b9-0f884c2a11bd",
                                                "sense_id": "6f5b0547-3691-3c1f-bd57-ad4355008a4f",
                                                "text": "Hoewel ik gewoonlijk niet over mijn ouders sprak, voelde ik me nu toch verplicht om door te gaan."
                                            },
                                            {
                                                "example_id": "87651a7a-61c7-4eba-8a23-70be09b6fac3",
                                                "sense_id": "6f5b0547-3691-3c1f-bd57-ad4355008a4f",
                                                "text": "Dat is de gewoonlijkste zaak van de wereld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5007a648-3adf-4368-b172-d1b6c177689d",
                        "source_entry_id": "b59bcb3b-faf6-3589-bc31-294d3d38f4e0",
                        "source_sense_id": "cb4ce31a-1b78-3035-a37e-36a0736e68d5",
                        "source_sense_description": "Le plus ordinairement.",
                        "target_lang_word": "doorgaans",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
