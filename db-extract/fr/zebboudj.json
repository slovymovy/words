                        "sense_id": "2374f5d2-8967-33f2-aaf0-8b27da09ed6a",
                        "entry_id": "fcb85289-375b-3139-aaa8-2cb5cfb51b1b",
                        "glosses": [
                            "Espèce d’olivier sauvage."
                        ],
                        "tags": [
                            "Maroc",
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "83d270ef-a331-460a-bb53-96a353d12944",
                                "sense_id": "2374f5d2-8967-33f2-aaf0-8b27da09ed6a",
                                "text": "[…]; il est plus répandu dans le nord du Maroc et de l'Algérie, où il atteint un développement plus considérable. Il en est de même du zebboudj (Olea oleaster) dont le bois sert à la construction; de son fruit noir, plus petit que l’olive, on tire une huile alimentaire assez estimée."
                            },
                            {
                                "example_id": "f71bffe8-78b7-4664-90ae-23bf616436a9",
                                "sense_id": "2374f5d2-8967-33f2-aaf0-8b27da09ed6a",
                                "text": "Maigre et voûtée comme le sont vite les bédouines porteuses d’enfants, elle s’appuie sur un bâton de zebboudj."
                            }
                        ]
                    }
