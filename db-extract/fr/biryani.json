                        "entry_id": "b4f3bb65-ea0f-3def-b87f-3ca328a0c8d3",
                        "glosses": [
                            "Sorte de plat épicé à base de riz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a79cfac7-7e94-4965-b9c6-8c45cffc0f7e",
                                "sense_id": "f7bd58d1-5ff6-3b47-9b3e-bde7bfc50345",
                                "text": "Il attaqua son agneau Biryani avec enthousiasme, mais considéra avec suspicion le plat de Jed."
                            },
                            {
                                "example_id": "fb036f94-685e-4224-8f2f-b9b5287096a2",
                                "sense_id": "f7bd58d1-5ff6-3b47-9b3e-bde7bfc50345",
                                "text": "C’est ainsi qu’à sa propre surprise et à celle de sa femme, Girija Prasad le carnivore devient végétarien. Afin de gagner quelques heures de repos, il renonce définitivement aux œufs brouillés, à l’agneau biryani et aux steaks de bœuf."
                            },
                            {
                                "example_id": "7c817c9b-a418-42b4-a759-62f05173892e",
                                "sense_id": "f7bd58d1-5ff6-3b47-9b3e-bde7bfc50345",
                                "text": "De la cuisine s’échappent des odeurs de sambar et de biryani — des plats réservés aux grandes occasions qu’elle n’a pas coutume de préparer."
                            }
                        ]
                    }
