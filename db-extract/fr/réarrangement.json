                "senses": [
                    {
                        "sense_id": "332bd484-468f-3de7-ae8b-30353dbdc164",
                        "entry_id": "3d569088-f9f7-3369-82bd-805823592877",
                        "glosses": [
                            "Réorganisation selon un nouvel ordre, action de réarranger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef423440-78b7-4736-99e2-346f245e053f",
                                "sense_id": "332bd484-468f-3de7-ae8b-30353dbdc164",
                                "text": "Prend en charge le réarrangement du noircissement, défiligrane, adapté pour tous les amateurs d'apprentissage."
                            },
                            {
                                "example_id": "fd669222-6aca-4a7f-b963-0ff1513fbdf0",
                                "sense_id": "332bd484-468f-3de7-ae8b-30353dbdc164",
                                "text": "En conséquence, lorsque l’on observe le réarrangement du squelette, l’équilibre rapide des doubles liaisons a lieu dès le début de l’isomérisation."
                            },
                            {
                                "example_id": "6fedcae3-b76f-4bac-b222-de1ae7b30162",
                                "sense_id": "332bd484-468f-3de7-ae8b-30353dbdc164",
                                "text": "Les réarrangements programmés du génome sont utilisés par des organismes très divers pour réguler l’expression de certains gènes."
                            }
                        ]
                    }
                ],
