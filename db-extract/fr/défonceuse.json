                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "517dd02e-3473-330d-8b31-b0feb2ae02ce",
                                        "entry_id": "ca304b81-dbdb-3526-ab72-67588cce7e06",
                                        "glosses": [
                                            "Someone who routes or directs items from one location to another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb4a5882-accf-43dd-b212-a39e3557bc7d",
                                                "sense_id": "517dd02e-3473-330d-8b31-b0feb2ae02ce",
                                                "text": "The router directed the movement of the company's trucks."
                                            },
                                            {
                                                "example_id": "3c94f402-658d-4c63-8d4e-18a73febfa54",
                                                "sense_id": "517dd02e-3473-330d-8b31-b0feb2ae02ce",
                                                "text": "When the router receives the package, he places the route number on it as well as on the triplicate part of the attached salescheck."
                                            },
                                            {
                                                "example_id": "f60022ed-809e-42a5-91c9-4ad4e00d22e2",
                                                "sense_id": "517dd02e-3473-330d-8b31-b0feb2ae02ce",
                                                "text": "Obviously, the production control department might consist of one man or it might occupy a score of production control experts: routers, schedulers, expediters, and dispatchers."
                                            },
                                            {
                                                "example_id": "ef87ce35-4156-4ee8-8650-0575cdf83e8d",
                                                "sense_id": "517dd02e-3473-330d-8b31-b0feb2ae02ce",
                                                "text": "The system benefits include reduced delivery costs, increased vehicle use, and improved route decision making by dispatchers and routers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9de520bc-888a-3935-b81c-b9dbb50258f7",
                                        "entry_id": "ca304b81-dbdb-3526-ab72-67588cce7e06",
                                        "glosses": [
                                            "Any device that directs packets of information using the equivalent of Open Systems Interconnection layer 3 (network layer) information. Most commonly used in reference to Internet Protocol routers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b1f72d-c036-4c05-bccd-e6fe64cb2e4b",
                                                "sense_id": "9de520bc-888a-3935-b81c-b9dbb50258f7",
                                                "text": "That’s one of the biggest hurdles of managing a router and your network security in general, it’s a massive chore that is fraught with technical jargon, hurdles and screens saying ‘no’, ‘invalid’ or ‘not available’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd84cdd3-6291-3143-b11b-261630cd7be0",
                                        "entry_id": "ca304b81-dbdb-3526-ab72-67588cce7e06",
                                        "glosses": [
                                            "A device that connects local area networks to form a larger internet by, at minimum, selectively passing those datagrams having a destination IP address to the network which is able to deliver them to their destination; a network gateway."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2791ab17-bee3-45d5-afe3-3047dfa8a6d7",
                                                "sense_id": "dd84cdd3-6291-3143-b11b-261630cd7be0",
                                                "text": "The router was configured to forward packets outside of a certain range of IP addresses to its internet uplink port."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fb8f62a-e7aa-31fe-899f-6a999fee97f7",
                                        "entry_id": "ca304b81-dbdb-3526-ab72-67588cce7e06",
                                        "glosses": [
                                            "In integrated circuit or printed circuit board design, an algorithm for adding all wires needed to properly connect all of the placed components while obeying all design rules."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "router",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de090da3-12e8-3e67-89fd-07858e5e6425",
                                        "entry_id": "a606e2cf-027f-3d13-9eb7-389d82b3a52a",
