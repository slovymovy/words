                        "target_lang_word": "Fruchtsaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fruchtsaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b9f41ec-bf1b-382b-8504-6222efe74887",
                                        "entry_id": "a8a79f93-627a-3a69-9e7a-03634b3adfba",
                                        "glosses": [
                                            "aus Früchten gepresster Saft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c8bc5f-3aeb-4a3e-bc03-7c7b33d61ecd",
                                                "sense_id": "6b9f41ec-bf1b-382b-8504-6222efe74887",
                                                "text": "Statt alkoholhaltiger Getränke sollte man öfter mal Fruchtsäfte trinken."
                                            },
                                            {
                                                "example_id": "41cd3ffb-aff8-4d29-bf45-964d116b9c19",
                                                "sense_id": "6b9f41ec-bf1b-382b-8504-6222efe74887",
                                                "text": "„Ich bleibe vor einem Stand mit frischen Fruchtsäften stehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff259f0c-5335-3e05-b67e-89a7f235476c",
                                        "entry_id": "a8a79f93-627a-3a69-9e7a-03634b3adfba",
                                        "glosses": [
                                            "Flüssigkeit, die in Früchten gespeichert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "876befa9-f345-4b8b-8987-49b951ddc8ab",
                                                "sense_id": "ff259f0c-5335-3e05-b67e-89a7f235476c",
                                                "text": "„Es gab leider keine Schokolade zu trinken, keinen Fruchtsaft, nur irgendein dünnes, grünlich gefärbtes Zeug.“"
                                            },
                                            {
                                                "example_id": "0eeee1ea-b7ce-457b-94b5-da1e1e81637f",
                                                "sense_id": "ff259f0c-5335-3e05-b67e-89a7f235476c",
                                                "text": "Manche Früchte enthalten viel, andere weniger Fruchtsaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
