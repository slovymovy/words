                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa4a0f6-1e78-3df9-a038-f533d2856394",
                                        "entry_id": "a388e8c5-6fb3-3980-b21a-fec2c1ea1870",
                                        "glosses": [
                                            "An insular state of the United States, formerly a territory. Capital: Honolulu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe62fd57-8ee9-4f64-a1cc-d0a56e2ca9ad",
                                                "sense_id": "5fa4a0f6-1e78-3df9-a038-f533d2856394",
                                                "text": "I've learned a lot by watching my Democratic colleague from Hawaii Senator Daniel Inouye. He’s a man of uncommon decency. I’ve never seen him demand political loyalty because of party or friendship, and I’ve never known him to go back on his word."
                                            },
                                            {
                                                "example_id": "1e9e697f-3e0b-48d6-bd56-65f56cfe4b96",
                                                "sense_id": "5fa4a0f6-1e78-3df9-a038-f533d2856394",
                                                "text": "The state where most intermarriages took place was Hawaii, where more than four in 10 newlyweds (42.4%) were intermarried."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91811725-79f4-3e2b-b92f-1ccdd112b3ae",
                                        "entry_id": "a388e8c5-6fb3-3980-b21a-fec2c1ea1870",
                                        "glosses": [
                                            "An archipelago of the Pacific Ocean, between North America and Oceania."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcac5786-000d-3156-a5e9-71c289b1c536",
                                        "entry_id": "a388e8c5-6fb3-3980-b21a-fec2c1ea1870",
                                        "glosses": [
                                            "An island of Hawaii archipelago, Pacific Ocean, of Hawaii County, State of Hawaii, United States. The largest of the Hawaiian Islands."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b227471c-e053-3ccd-a9c2-5b241316bd60",
                                        "entry_id": "a388e8c5-6fb3-3980-b21a-fec2c1ea1870",
                                        "glosses": [
                                            "A former kingdom in the Hawaiian Islands, Pacific Ocean."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b360349a-9fe0-4958-86d1-62b333d1ea46",
                        "source_entry_id": "fa8509dd-6fd1-3202-8b34-a4b85f648433",
