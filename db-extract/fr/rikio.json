                        "sense_id": "db7829eb-7d5e-33bb-ba93-fa2f00597e8a",
                        "entry_id": "c070cd3e-e2c2-3011-b2b3-cc4f517629c4",
                        "glosses": [
                            "Arbre africain de la famille des Euphorbiacées dont le bois est considéré comme imputrescible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc9d9a1-ab68-43e6-ad95-08902017e270",
                                "sense_id": "db7829eb-7d5e-33bb-ba93-fa2f00597e8a",
                                "text": "Les essences dominantes sont l’acajou, l’azobé, le niangon (principalement dans la forêt de Diécké), le dibétan, l’iraké, l’iroko, le sampa, le rikio et le lingué."
                            },
                            {
                                "example_id": "ac7ee28c-ee96-4025-9bc5-ca3c68e18022",
                                "sense_id": "db7829eb-7d5e-33bb-ba93-fa2f00597e8a",
                                "text": "Les rikios s’alignaient en cohortes mercenaires, leurs racines aériennes se touchaient formant un immense filet suintant aux mailles d’acier trempé, imbibé, imprégné de saleté repoussante, comme des rets posés là pour emprisonner et contaminer les vivants mystifiés."
                            }
                        ]
                    }
