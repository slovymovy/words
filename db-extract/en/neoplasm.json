                                        "entry_id": "af7c3888-c4ca-31af-88cf-d7e8e2687b09",
                                        "glosses": [
                                            "Schwellung des Gewebes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eddfb37-480e-4fbc-91b5-d3128330e0d9",
                                                "sense_id": "7d58e45d-a356-3bdf-9f83-e2153aba254d",
                                                "text": "Am Hals hatte sich eine Geschwulst gebildet."
                                            },
                                            {
                                                "example_id": "6e2e959a-822c-4b5d-8d3e-09d30467c242",
                                                "sense_id": "7d58e45d-a356-3bdf-9f83-e2153aba254d",
                                                "text": "„In der Nacht wurde die Geschwulst so dick wie eine große Birne, so daß ich am Ostersonntag nicht aufstehen und zur Messe gehen konnte.“"
                                            },
                                            {
                                                "example_id": "5c0e68bd-f678-4826-9113-3f2a5b294cf7",
                                                "sense_id": "7d58e45d-a356-3bdf-9f83-e2153aba254d",
                                                "text": "„Die Initiatoren der Studie kommen klar und unmissverständlich zu dem Schluss, dass die Behandlungsergebnisse deutlich besser sind, wenn man nach der chirurgischen Entfernung der Geschwulst eine Chemotherapie anstelle der bisher üblichen Strahlentherapie durchführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f256072-9e89-4da3-81d4-f56feb8c63a9",
                        "source_entry_id": "81da8bc4-97ae-3f97-b6ef-9932a828695c",
                        "source_sense_id": "4e7c0ef3-d40d-3946-a4b0-b0fb139ded20",
