                "senses": [
                    {
                        "sense_id": "a946901e-d60e-3853-9bac-71ecce514e3d",
                        "entry_id": "ef3fe20d-d652-383e-9b56-88a0e52e34f4",
                        "glosses": [
                            "Uriner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0585e8ba-1c74-4ae6-bc63-c8cdff720a2a",
                                "sense_id": "a946901e-d60e-3853-9bac-71ecce514e3d",
                                "text": "L'Art Total c'est d'uriner normalement à 7 h et de réuriner à 7 h en œuvre d'art."
                            },
                            {
                                "example_id": "facfee9c-69a5-40a4-aeec-33791c9592be",
                                "sense_id": "a946901e-d60e-3853-9bac-71ecce514e3d",
                                "text": "Par contre, dès que j'ai fini d'uriner, j'ai tout de suite envie de réuriner, je me retiens et ça diminue mais l'envie reste présente."
                            },
                            {
                                "example_id": "3d0aff5d-d6d3-425c-ba57-01401ded55dc",
                                "sense_id": "a946901e-d60e-3853-9bac-71ecce514e3d",
                                "text": "Il avait réussi à réuriner, mais là, il n'y arrive pas tout le temps."
                            }
                        ]
                    }
