                        "entry_id": "2420a5d0-9463-3c6b-beca-3c897f689922",
                        "glosses": [
                            "In Old Norse society, a female practitioner of magic divination and prophecy."
                        ],
                        "tags": [
                            "Germanic",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "17d2f8c7-6128-4256-bf45-381d372dadc2",
                                "sense_id": "91ccceb3-f37f-3be1-bad6-d268b1db1f67",
                                "text": "In the Eddas, Odin conjures up a dead volva and questions her about Baldur's fate."
                            },
                            {
                                "example_id": "59d646ab-3515-4316-bd51-addeafb2afc2",
                                "sense_id": "91ccceb3-f37f-3be1-bad6-d268b1db1f67",
                                "text": "In another account a volva was paid by a king to find his nephews who had been hidden by a man skilled in magick."
                            },
                            {
                                "example_id": "fafcce84-0f72-4fca-9a80-75f0d57a8d51",
                                "sense_id": "91ccceb3-f37f-3be1-bad6-d268b1db1f67",
                                "text": "There is another story in Landnamabok telling of a volva who actively brought prosperity to the fishing activity of the people through her use of seidr."
                            }
                        ]
                    },
                    {
                        "sense_id": "1107b851-bbea-3532-a941-7f2f171fec28",
                        "entry_id": "2420a5d0-9463-3c6b-beca-3c897f689922",
                        "glosses": [
                            "Any prophetess, sooth-sayer, or witch."
                        ],
                        "tags": [
                            "broadly"
                        ],
