        "nl-extract.jsonl": [
            {
                "entry_id": "2b2050b1-9d1f-3c19-8a3e-ad631fe8d6e4",
                "word": "niemand",
                "pos": "pron",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fb71084d-213b-3bd8-b3d0-8cfea674dbce",
                        "entry_id": "2b2050b1-9d1f-3c19-8a3e-ad631fe8d6e4",
                        "glosses": [
                            "geen enkel persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493952a6-73bc-4eba-91a3-1d5a84907a3e",
                                "sense_id": "fb71084d-213b-3bd8-b3d0-8cfea674dbce",
                                "text": "Ik heb helemaal niemand gezien!"
                            },
                            {
                                "example_id": "51815389-0b2d-46c2-86f1-e6e9d9580933",
                                "sense_id": "fb71084d-213b-3bd8-b3d0-8cfea674dbce",
                                "text": "Niemand wist wat dat blauwe licht was geweest, misschien statische energie van de storm of een bolbliksem?"
                            },
                            {
                                "example_id": "fd84b7a1-e8e8-49e4-9b5e-c22213777ef3",
                                "sense_id": "fb71084d-213b-3bd8-b3d0-8cfea674dbce",
                                "text": "Niemand had iets verkeerds gedaan, althans niets aantoonbaar verkeerds, hijzelf niet en niemand anders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66a52db9-b5f5-4166-9243-a0c663bd18f5",
                        "source_entry_id": "2b2050b1-9d1f-3c19-8a3e-ad631fe8d6e4",
                        "source_sense_id": "fb71084d-213b-3bd8-b3d0-8cfea674dbce",
                        "source_sense_description": "geen enkel persoon",
                        "target_lang_word": "niemand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niemand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "448d0bb2-cd2a-34d6-8930-c04f77677179",
                                        "entry_id": "ee9b5196-dd7c-399b-b32f-590a10aabe50",
                                        "glosses": [
                                            "keiner, kein Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e9f7dc-51f1-4401-8053-e0bb70aa1720",
                                                "sense_id": "448d0bb2-cd2a-34d6-8930-c04f77677179",
                                                "text": "Diesen Begriff kann niemand leicht erklären."
                                            },
                                            {
                                                "example_id": "327dd4b7-e301-4e0d-92cb-6e53f2fa79b1",
                                                "sense_id": "448d0bb2-cd2a-34d6-8930-c04f77677179",
                                                "text": "„Politische Herrschaftsrechte […] waren vererbbar, übertragbar, verpfändbar, und ihr Inhaber war prinzipiell niemand Rechenschaft schuldig.“"
                                            },
                                            {
                                                "example_id": "2dbbbc67-3a44-47f8-9d8c-89894cc40c8f",
                                                "sense_id": "448d0bb2-cd2a-34d6-8930-c04f77677179",
                                                "text": "„Hineinreden in seine Lebensführung läßt er sich überhaupt von niemandem mehr, nicht von Vater und Mutter und schon gar nicht von einem Hansnarren.“"
                                            },
                                            {
                                                "example_id": "ad149bf6-5d04-4c0e-b210-0abe9420ed22",
                                                "sense_id": "448d0bb2-cd2a-34d6-8930-c04f77677179",
                                                "text": "„In diesem Papier werde ein für allemal festgelegt, dass niemand anderes als die Gebrüder Wright als erste Motorflieger genannt werden dürften; zwei Amerikaner und nicht der Bayer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf8830a9-4c78-467a-b4e6-bf501e2ffd8b",
                        "source_entry_id": "2b2050b1-9d1f-3c19-8a3e-ad631fe8d6e4",
                        "source_sense_id": "fb71084d-213b-3bd8-b3d0-8cfea674dbce",
                        "source_sense_description": "geen enkel persoon",
                        "target_lang_word": "no one",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "no one",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                        "entry_id": "df5ff650-89e7-318f-92d1-9d04ba3bae12",
                                        "glosses": [
                                            "Used in contrast to anyone, someone or everyone: not one person; nobody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bafefd09-c705-4017-945c-fd73535c2b0d",
                                                "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                                "text": "We went to the store but no one was there."
                                            },
                                            {
                                                "example_id": "1c338ef6-2ede-4ebc-b4d7-92e31cdd8b47",
                                                "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                                "text": "Sundrie greate perſonages bothe learned and well acquainted with affaires, haue both learnedly, and wiſely written of Politique matters, [...] howbeit there is no one among them all, that hath once buſied himſelfe about the ruling, or direction of the Publique eſtate, in that point, that apperteineth to the vocation of men, [...]"
                                            },
                                            {
                                                "example_id": "74004157-cc02-4782-9cc1-4a1e7d569f42",
                                                "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                                "text": "Where Love preſumeth into place, / Let no one ſing in Loves diſgrace."
                                            },
                                            {
                                                "example_id": "24346939-b81b-43f0-84e5-0dcac6ae6586",
                                                "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                                "text": "Many may boaſt finer eyes, a handſomer mouth, a more commanding figure; but no one can have a better turned ſhape, a fairer complexion, a whiter hand, a more delicate foot, a more benign aſpect, a more bewitching countenance. Without dazzling, ſhe engages, ſhe charms, and no one can tell how."
                                            },
                                            {
                                                "example_id": "64e547fc-19ce-4d22-9b86-1feee94f1e9c",
                                                "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                                "text": "Receive us. We have wronged noöne, we have corrupted noöne, we have taken advantage of noöne."
                                            },
                                            {
                                                "example_id": "2e191b12-2067-4478-9692-c30acc46ea08",
                                                "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                                "text": "'The doctor was confined to the house,' Poole said, 'and saw no one.' On the 15th, he tried again, and was again refused; and having now been used for the last two months to see his friend almost daily, he found this return of solitude to weigh upon his spirits."
                                            },
                                            {
                                                "example_id": "0a2df860-cc9e-4954-9e84-59dfb40559a2",
                                                "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                                "text": "Thus, when he drew up instructions in lawyer language, he expressed the important words by an initial, a medial, or a final consonant, and made scratches for all the words between. His clerks, however, understood him very well. If he had written a love letter or a farce, or a ballade or a story, no one—neither clerks nor friends nor compositors—would have understood anything but a word here and a word there."
                                            },
                                            {
                                                "example_id": "58987b1d-34a3-4e84-9d36-0f97e3f25d92",
                                                "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen. No one queried it. It was in the classic pattern of human weakness, mean and embarrassing and sad."
                                            },
                                            {
                                                "example_id": "1e08167a-23c4-4791-a911-c5dbbda4fb0f",
                                                "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                                "text": "However, the transcendence of 2#92;sqrt#123;2#125; was so difficult a problem that noöne in the audience would live to see its solution. Within a few years, [Carl Ludwig] Siegel had proven this transcendence!"
                                            },
                                            {
                                                "example_id": "d3893959-9079-4bf0-aadb-87d59b7f6745",
                                                "sense_id": "84c1cd3d-2505-356a-8f98-947291bc6ebe",
                                                "text": "And why has no one in the [rail] industry advocated for a universal requirement for face covering (even if it's just a scarf or old tea towel), [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d77d491-bf35-3c56-b603-3f003262da00",
                                        "entry_id": "df5ff650-89e7-318f-92d1-9d04ba3bae12",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see no, one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa663719-00a5-4c47-9880-229419b1547c",
                                                "sense_id": "3d77d491-bf35-3c56-b603-3f003262da00",
                                                "text": "No one athlete could pull off such a stunt!"
                                            },
                                            {
                                                "example_id": "c5f7be48-7eda-454d-9a8a-76ab9bea9fa7",
                                                "sense_id": "3d77d491-bf35-3c56-b603-3f003262da00",
                                                "text": "No one solution on its own can generate successful change."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a271b77d-17c2-4a92-b535-9fd84f6e913e",
                        "source_entry_id": "2b2050b1-9d1f-3c19-8a3e-ad631fe8d6e4",
                        "source_sense_id": "fb71084d-213b-3bd8-b3d0-8cfea674dbce",
                        "source_sense_description": "geen enkel persoon",
                        "target_lang_word": "nobody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nobody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea47474b-66c3-3350-8236-754462b4ad08",
                                        "entry_id": "6f0bbe33-964b-3046-a9a6-7f32578acd88",
                                        "glosses": [
                                            "Not any person; the logical negation of somebody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec4e1db-231d-4592-8c90-71e2fd171096",
                                                "sense_id": "ea47474b-66c3-3350-8236-754462b4ad08",
                                                "text": "I asked several people, but nobody knew how."
                                            },
                                            {
                                                "example_id": "e61473e0-9065-42fd-83b1-92316f52677b",
                                                "sense_id": "ea47474b-66c3-3350-8236-754462b4ad08",
                                                "text": "As nobody who is not blind can have failed to notice, I had my hair cut just yesterday."
                                            },
                                            {
                                                "example_id": "f6312fbb-7dd0-4e6d-9a41-9c65434fc3de",
                                                "sense_id": "ea47474b-66c3-3350-8236-754462b4ad08",
                                                "text": "Nobody phoned, did they?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nobody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "677bd015-d6d2-3e38-bc54-5cb75f9f8e11",
                                        "entry_id": "4965220c-c628-3ec5-898d-26fde3bf7344",
                                        "glosses": [
                                            "Someone who is not important or well-known."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebdf8f63-e257-482f-b6a8-23d941d7c420",
                                                "sense_id": "677bd015-d6d2-3e38-bc54-5cb75f9f8e11",
                                                "text": "“‘The nobody you once thought me!’ I repeated, and my face grew a little hot; but I would not be angry: of what importance was a school-girl’s crude use of the terms nobody and somebody?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab931c0-b66e-31c7-b015-b731643c30b9",
                                        "entry_id": "4965220c-c628-3ec5-898d-26fde3bf7344",
                                        "glosses": [
                                            "Something that has no body or an especially small one."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d72714d5-d0ef-4368-9b93-8d8612a5003a",
