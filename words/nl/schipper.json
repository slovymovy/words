                            }
                        },
                        {
                            "text": "Als <w>schipper</w> op dit schip heb je een prachtig uitzicht over de zee.",
                            "target_lang_translations": {
                                "en": "As a <w>passenger</w> on this ship, you have a beautiful view of the sea."
                            }
                        }
                    ],
                    "synonyms": [
                        "passagier"
                    ],
                    "target_lang_definitions": {
