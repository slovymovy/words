                        "glosses": [
                            "niet luid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "709a9d5c-90ad-4ab8-8254-a79d7996458f",
                                "sense_id": "cf73b9c0-ce24-36ee-a5ce-5c569f7ec6ff",
                                "text": "De oproep tot het gebed is niet schel, niet hoog, niet hard, zoals bij zoveel andere moskeeën in de stad. Uit de 550 jaar oude Fatih-moskee klinkt de oproep zijdezacht. Op het marmeren plein aan de voet van de minaret spelen kinderen, oude mannen wassen hun voeten en handen. Het conservatieve hart van Istanbul maakt zich klaar voor het avondgebed."
                            }
                        ]
