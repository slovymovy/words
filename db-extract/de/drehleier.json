                    {
                        "form_id": "404f8a90-6da3-4340-b1d8-de9ca8cbc057",
                        "entry_id": "42ef761a-3d3a-36e6-8795-96448cb01e74",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Drehleiern"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0957e350-5398-301e-baf1-22c99922e9b3",
                        "entry_id": "42ef761a-3d3a-36e6-8795-96448cb01e74",
                        "glosses": [
                            "Streichinstrument, bei dem die Saiten durch ein eingebautes Rad gestrichen werden"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "d1629bc6-dca6-47fc-96cb-1764598cd24a",
                                "sense_id": "0957e350-5398-301e-baf1-22c99922e9b3",
                                "text": "Die Drehleier war vor allem in der Renaissance ein beliebtes Instrument."
                            },
                            {
                                "example_id": "a270c043-1fa7-4bb7-988e-c6e7a6381fb2",
                                "sense_id": "0957e350-5398-301e-baf1-22c99922e9b3",
                                "text": "„Er baute für mich eine mittelalterliche Drehleier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3cba8312-1cb2-3bad-baa5-312bd2eb4598",
                        "entry_id": "42ef761a-3d3a-36e6-8795-96448cb01e74",
                        "glosses": [
                            "handbetriebener Bohrer"
                        ],
                        "tags": [
                            "Handwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "feb60e73-dc29-497f-87c3-f61aa6fa35b2",
                                "sense_id": "3cba8312-1cb2-3bad-baa5-312bd2eb4598",
                                "text": "„Darüber hinaus war in der Wagnerei das Vorhandensein von Sägen der verschiedensten Art, spezieller Hobel wie Stab-, Kehl-, Nut-, und Falzhobel, Zugmesser mit gerader und gebogener Schneide, verschiedene Bohrer wie Schnecken-, Löffel- und Zentrumbohrer erforderlich, die mit Hilfe der Drehleier oder der Bohrmaschine bewegt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fc314d0-f4b6-40ba-951f-588d1fa2e8c0",
                        "source_entry_id": "42ef761a-3d3a-36e6-8795-96448cb01e74",
                        "source_sense_id": "0957e350-5398-301e-baf1-22c99922e9b3",
                        "source_sense_description": "Musik: Streichinstrument, bei dem die Saiten durch ein eingebautes Rad gestrichen werden",
                        "target_lang_word": "hurdy-gurdy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hurdy-gurdy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ab06aa6-0eec-388b-a6b3-fca8e1a161a8",
                                        "entry_id": "458ea9d4-9601-3e13-8735-ca95f04894ea",
                                        "glosses": [
                                            "A stringed instrument that produces a droning sound by turning a handle that connects to a wheel that rubs against a rosined string, with a keyboard also used to alter the pitch of the string."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20977003-92be-3e8b-a06c-ddee0afce68f",
                                        "entry_id": "458ea9d4-9601-3e13-8735-ca95f04894ea",
                                        "glosses": [
                                            "Synonym of street organ, often considered a misnomer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d343b6c-74d0-4f8b-998f-f94460088f7d",
                                                "sense_id": "20977003-92be-3e8b-a06c-ddee0afce68f",
                                                "text": "He flung open the door, and found there only a ragged boy with a hurdy-gurdy on his back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968d1b9d-6eea-3860-be8d-ce7eb55d2df3",
                                        "entry_id": "458ea9d4-9601-3e13-8735-ca95f04894ea",
                                        "glosses": [
                                            "A water wheel with radial buckets, driven by the impact of a jet."
                                        ],
                                        "tags": [
                                            "California",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30b9f4ba-eb9b-3117-995f-2aa77b68b122",
                                        "entry_id": "458ea9d4-9601-3e13-8735-ca95f04894ea",
                                        "glosses": [
                                            "A winch, a windlass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "910f681e-b6ff-4f0b-936b-8baff0ca9e9e",
                                                "sense_id": "30b9f4ba-eb9b-3117-995f-2aa77b68b122",
                                                "text": "A pair of oars, a small mast and sail, pen boards to contain the fish, a bailer, a water jar, a bait knife, a compass, a small wooden winch called a hurdy gurdy, a fish gaff, and the tubs, trawls, floats, and anchors used to set gear was all that was required to equip it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hurdy-gurdy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa302087-7570-3dd8-ad46-3d995017c015",
                                        "entry_id": "531c18fa-35df-3790-90e4-245f5ad46da5",
                                        "glosses": [
                                            "Sounding like the Swedish language."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a97b8e-f7b9-4f92-a602-783ff1e8292d",
                                                "sense_id": "fa302087-7570-3dd8-ad46-3d995017c015",
                                                "text": "Just don’t do what the Swedish chef from The Muppet Show does and start playing tennis with the meatballs, or start waving your cooking utensils about the kitchen and shouting ‘hurdy gurdy’ at your mates."
                                            },
                                            {
                                                "example_id": "f2b9cae2-272e-42b6-a99c-ee52b30ea6d0",
                                                "sense_id": "fa302087-7570-3dd8-ad46-3d995017c015",
                                                "text": "“You mean when she read that God-awful poem in her hurdy-gurdy Swedish chef accent?"
                                            },
                                            {
                                                "example_id": "e742b23d-307c-4f80-81a3-51d9d431eaa1",
                                                "sense_id": "fa302087-7570-3dd8-ad46-3d995017c015",
                                                "text": "Swedes are often said to sing while they speak. (Listen to Floyd, the Muppet’s Swedish chef, singing “Hurdy Gurdy” and you’ll understand this.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5700ba55-bb3e-4157-8afb-a242cd922497",
                        "source_entry_id": "42ef761a-3d3a-36e6-8795-96448cb01e74",
                        "source_sense_id": "0957e350-5398-301e-baf1-22c99922e9b3",
                        "source_sense_description": "Musik: Streichinstrument, bei dem die Saiten durch ein eingebautes Rad gestrichen werden",
                        "target_lang_word": "vielle à roue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vielle à roue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1150ca0-3dba-36ee-8349-0d81ca0f0e76",
                                        "entry_id": "3be1c473-a14c-3b31-aa68-49514213e29e",
                                        "glosses": [
                                            "Instrument de musique à cordes frottées par une roue en bois (au lieu d’un archet), tournée avec une manivelle, pendant que la main gauche du musicien joue la mélodie sur un clavier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa8b62db-205a-422b-94d8-07c7ff5052e3",
                                                "sense_id": "c1150ca0-3dba-36ee-8349-0d81ca0f0e76",
                                                "text": "La vielle à roue apparaît au Moyen Âge, dès le IXe siècle, approximativement un siècle après l’invention de la manivelle."
                                            },
                                            {
                                                "example_id": "b67d5cc3-471a-4707-87ec-26e9b1a7917b",
                                                "sense_id": "c1150ca0-3dba-36ee-8349-0d81ca0f0e76",
                                                "text": "Lundi matin, deux intervenants, Daniel et Françoise Guichard, sont venus en classe pour présenter des instruments utilisés au Moyen Âge : la vielle à roue et la cornemuse."
                                            },
                                            {
                                                "example_id": "6da1015d-c6d8-44ac-860c-1355cb1fab5f",
                                                "sense_id": "c1150ca0-3dba-36ee-8349-0d81ca0f0e76",
                                                "text": "Le musicien jouait de la vielle. De la vielle à roue. Un instrument des campagnes qu’il ne s’attendait pas à trouver dans un lieu si moderne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
