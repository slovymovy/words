                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f4e9662-48ac-3ea0-a239-00350c68794f",
                        "entry_id": "e9fb0057-e6ce-37fa-b0f5-d25b167e075c",
                        "glosses": [
                            "Relatif à ce culte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "010c5d7a-f277-458c-b12e-55624c8ee6a3",
                                "sense_id": "2f4e9662-48ac-3ea0-a239-00350c68794f",
                                "text": "Le panthéon vaudou est avant tout constitué des forces de la nature."
                            },
                            {
                                "example_id": "c46084ed-95ad-45fc-baee-b39380e454c6",
                                "sense_id": "2f4e9662-48ac-3ea0-a239-00350c68794f",
                                "text": "Une grande-prêtresse vaudoue."
                            },
                            {
                                "example_id": "7f091b31-8e02-4f86-aa10-81f4d62ac8f9",
                                "sense_id": "2f4e9662-48ac-3ea0-a239-00350c68794f",
                                "text": "Peut-être la musique, qui rappelait quelque incantation vaudoue, agissait-elle sur les nerfs tendus, car nul ne parlait, ne touchait à son verre […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
