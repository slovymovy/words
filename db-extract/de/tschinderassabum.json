                        "examples": [
                            {
                                "example_id": "fc13208e-c793-4f11-8f06-d0e488819b39",
                                "sense_id": "49acce16-6272-32d6-8283-82afe07e443c",
                                "text": "„Und wenn vor dem Haus die Pimpfe in ihren schneidigen Uniformen mit Tschinderassabum vorbeimarschieren, öffnet sie das Fenster, […]“"
                            },
                            {
                                "example_id": "bd244daf-aaf6-481c-9f7a-765d93d414f8",
                                "sense_id": "49acce16-6272-32d6-8283-82afe07e443c",
                                "text": "„Immer noch geisterte das Tschinderassabum in ihren Köpfen herum.“"
                            },
                            {
                                "example_id": "38194029-8bea-4354-847b-fce3d684d7f7",
                                "sense_id": "49acce16-6272-32d6-8283-82afe07e443c",
                                "text": "„»Die 200 000 waren von Honecker befohlen«, schrieb ihr Chefredakteur. »Sie kamen mit Tschinderassabum und mußten singen ›Hoch soll er leben‹. […]«“"
                            },
                            {
                                "example_id": "d0731981-3583-4f60-a6ca-04ddfcca239f",
                                "sense_id": "49acce16-6272-32d6-8283-82afe07e443c",
                                "text": "„Dabei enthalten sie sich jeder Art von propagandistischem Tschinderassabum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
