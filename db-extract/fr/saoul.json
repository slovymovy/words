                                        "glosses": [
                                            "Habitually or frequently in a state of intoxication."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dccebae-25c5-34f8-bedd-b4b49af69cf5",
                                        "entry_id": "9e699198-aa94-3335-bfd4-4b118b60b4f9",
                                        "glosses": [
                                            "Elated or emboldened."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4ad7de8-cd55-4b11-a95f-b9177f896bbb",
                                                "sense_id": "6dccebae-25c5-34f8-bedd-b4b49af69cf5",
                                                "text": "Drunk with power, he immediately ordered a management reshuffle."
                                            },
                                            {
