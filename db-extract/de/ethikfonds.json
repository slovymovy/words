                "senses": [
                    {
                        "sense_id": "dd38f661-2c2c-3ba9-b7f0-eb5663fdbaa7",
                        "entry_id": "070acda4-d88f-345c-8626-50a671fd6853",
                        "glosses": [
                            "Investmentfonds, der bei der Geldanlage auf die Einhaltung ethischer Aspekte achtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2abdb632-b223-4412-9dd5-89976ef15cf6",
                                "sense_id": "dd38f661-2c2c-3ba9-b7f0-eb5663fdbaa7",
                                "text": "„Zahlreiche Studien haben mittlerweile nachgewiesen, dass Öko- und Ethikfonds im Schnitt nicht besser oder schlechter abschneiden als andere Fonds.“"
                            },
                            {
                                "example_id": "c097cf53-5698-4918-b22f-89ec5cabbb85",
                                "sense_id": "dd38f661-2c2c-3ba9-b7f0-eb5663fdbaa7",
                                "text": "„Vor knapp zwei Jahren ließ sich die Bank sogar mit einem ökumenischen Umweltpreis aus der Hand des Berliner Kardinals Georg Sterzinsky und des damaligen EKD-Ratsvorsitzenden auszeichnen. Dabei hielt ihr Ethikfonds KCD-Union Nachhaltig Aktien schon damals Anteile von BP und Statoil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
