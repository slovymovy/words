                "senses": [
                    {
                        "sense_id": "0126100b-5870-376d-8fa9-94d18f54424f",
                        "entry_id": "d44b691a-76b0-392a-92a5-2d168c4fb490",
                        "glosses": [
                            "Exciter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c8f6ad2-c0e6-4bbf-8be2-c8062b8df833",
                                "sense_id": "0126100b-5870-376d-8fa9-94d18f54424f",
                                "text": "le corps cambré aux fins d’auticher le cave évoquera plus par sa raideur la dalle d’autopsie que la carrée douillette."
                            },
                            {
                                "example_id": "722bfee3-0116-41a7-a86c-7c80f92411ed",
                                "sense_id": "0126100b-5870-376d-8fa9-94d18f54424f",
                                "text": "C’est juste que j’essaie d’auticher mais ça ne mord guère."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d0f547b-526b-371f-9664-a7776c31253a",
                        "entry_id": "d44b691a-76b0-392a-92a5-2d168c4fb490",
                        "glosses": [
                            "Provoquer, se moquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2a265e0-7b4a-46b6-a006-29e3fad12100",
                                "sense_id": "3d0f547b-526b-371f-9664-a7776c31253a",
                                "text": "Y’a des condés.\nQui viennent te chambrer, allez !\nJe peux les narguer\nEt les auticher\nCarte d’identité, montrez, montrez !"
                            }
                        ]
                    }
