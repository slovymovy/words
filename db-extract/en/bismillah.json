                            {
                                "example_id": "6b9f77ec-4aa4-4fdb-b904-08ee2399c9de",
                                "sense_id": "4f328e54-5f0f-370f-9aee-7c28dfc2e3ff",
                                "text": "Finally, the boy told the king that he would succeed only if he gathered all his citizens as witnesses, declared bismillah rab al-gholam—“in the name of Allah, the God of this boy”—and fired an arrow."
                            }
                        ]
                    }
