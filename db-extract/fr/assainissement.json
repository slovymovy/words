                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanalisation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b88c88d-871b-3bb9-9bdc-e1c78df03a30",
                                        "entry_id": "6eca6e4c-aff2-38a8-bbc9-94d0875bcf62",
                                        "glosses": [
                                            "Netz von Rohrleitungen das Abwasser von Abwasserleitungen zu Kläranlagen oder anderen Entsorgungsstellen ableitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49639ff3-f7ba-4603-ad8e-5abbb49dc2bb",
                                                "sense_id": "1b88c88d-871b-3bb9-9bdc-e1c78df03a30",
                                                "text": "In der Kanalisation fühlen sich die Ratten wohl, da nicht nur Scheiße daher schwimmt."
                                            },
                                            {
                                                "example_id": "ee2d39be-e46b-4f06-8a83-c2e1ff8dd775",
                                                "sense_id": "1b88c88d-871b-3bb9-9bdc-e1c78df03a30",
                                                "text": "Nach §55 (2) WHG soll Niederschlagswasser ortsnah versickert oder direkt oder über eine Kanalisation ohne Vermischung mit Schmutzwasser in ein Gewässer eingeleitet werden, d.h. die Mischkanalisation sollte daher in der Regel für neue öffentliche Abwasseranalagen nicht mehr hergestellt werden."
                                            },
                                            {
                                                "example_id": "5b8fe4fc-556a-433f-9d42-4a291bff85bc",
                                                "sense_id": "1b88c88d-871b-3bb9-9bdc-e1c78df03a30",
                                                "text": "„Längst nicht alle Häuser und Hütten sind an die Kanalisation angeschlossen, entsprechend riecht es in den Straßen.“"
                                            },
                                            {
                                                "example_id": "266321f8-0e7a-4d83-8dfe-781db8df6415",
                                                "sense_id": "1b88c88d-871b-3bb9-9bdc-e1c78df03a30",
                                                "text": "„Es gab in der Stadt weder Straßen, noch Elektrizität oder eine Kanalisation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8b325c2-ec71-3758-970a-316b8468a1bd",
                                        "entry_id": "6eca6e4c-aff2-38a8-bbc9-94d0875bcf62",
                                        "glosses": [
                                            "bauliche Veränderung eines Flusslaufes zu einem dann schiffbaren Kanal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e4d52c0-91ab-4206-ace2-23d6ab0b8c45",
                                                "sense_id": "b8b325c2-ec71-3758-970a-316b8468a1bd",
                                                "text": "Die Kanalisation der Mosel, mit allen Wehren und Uferbefestigungen machte diese zu einem viel befahrenen Schiffahrtskanal."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
