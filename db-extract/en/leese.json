                "senses": [
                    {
                        "sense_id": "2bdd50c1-134d-3734-8ead-1eb5608ce387",
                        "entry_id": "6d764870-4867-30e7-b1ce-5312ae91042e",
                        "glosses": [
                            "To lose."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1db2c9d7-9e18-464f-a48c-ae8261264bc7",
                                "sense_id": "2bdd50c1-134d-3734-8ead-1eb5608ce387",
                                "text": "But flowers distill'd though they with winter meet,\nLeese but their show; their substance still lives sweet."
                            },
                            {
                                "example_id": "63c0f655-f961-4013-8fa0-ae78558d137c",
                                "sense_id": "2bdd50c1-134d-3734-8ead-1eb5608ce387",
                                "text": "They would rather leese their friend than their jest."
                            },
                            {
                                "example_id": "eec7e0f5-9a5b-4d9e-a527-3e87f198c4ca",
                                "sense_id": "2bdd50c1-134d-3734-8ead-1eb5608ce387",
                                "text": "Yet better leave off with a little losse,\nThen by much wrestling to leese the grosse"
                            },
                            {
                                "example_id": "42762145-9019-4aab-b6ef-a2be56857270",
                                "sense_id": "2bdd50c1-134d-3734-8ead-1eb5608ce387",
                                "text": "Take heed you leeſe it not Signior, ere you come there: preſerue it."
                            }
                        ]
                    }
                ],
