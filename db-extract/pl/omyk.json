                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02804e3b-d735-47aa-b2ed-603154bf1946",
                        "source_entry_id": "188df2e9-5bc0-3250-a00f-f445e1ac1d1a",
                        "source_sense_id": "92dc49b5-4b3e-316c-b698-fa6a9203a2ba",
                        "target_lang_word": "Blume",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blume",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc69a0f7-c658-3f09-9765-0b8dfb245133",
                                        "entry_id": "001178dc-6d36-3b33-b426-204b6fc30f29",
                                        "glosses": [
                                            "blühende Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac6972e3-3e8e-4f52-9c5a-bb98d581d74e",
                                                "sense_id": "fc69a0f7-c658-3f09-9765-0b8dfb245133",
                                                "text": "Eine schöne Blume, die du da gepflückt hast."
                                            },
                                            {
                                                "example_id": "2386af48-7442-4d92-846b-c337facecf5e",
                                                "sense_id": "fc69a0f7-c658-3f09-9765-0b8dfb245133",
                                                "text": "„Blumen produzieren Pollenkörner. Sie sind klein und leicht und einige von ihnen so geformt, dass sie über lange Entfernungen durch die Luft treiben können.“"
                                            },
                                            {
                                                "example_id": "0b2e4404-5040-4e3c-a3d1-ba3b76536f10",
                                                "sense_id": "fc69a0f7-c658-3f09-9765-0b8dfb245133",
                                                "text": "„Die beiden waren in die getäfelte Eingangshalle getreten, die mit Blumen und Blattpflanzen geschmückt war.“"
                                            },
                                            {
                                                "example_id": "becd25fd-792f-4c86-9cb4-871e4f58f88b",
                                                "sense_id": "fc69a0f7-c658-3f09-9765-0b8dfb245133",
                                                "text": "„Er gab nun die Blumen auf und schritt auf einen der beiden Laubengänge zu, die den großen Parkgarten flanierten und von der Höhe bis fast an den Fuß des Schloßhügels herniederstiegen.“"
                                            },
                                            {
                                                "example_id": "ed2f2b47-6e0d-4a1e-8183-3e0d7eb9250b",
                                                "sense_id": "fc69a0f7-c658-3f09-9765-0b8dfb245133",
                                                "text": "„Die Ägypter wünschten sich, dass ihr Dasein wie eine blühende Blume sein möge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c2a62d13-dff8-32d1-ac76-e27f903e9b94",
                                        "entry_id": "001178dc-6d36-3b33-b426-204b6fc30f29",
                                        "glosses": [
                                            "Schaumkrone auf einem gefüllten Bierglas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d04ba0-027a-4e44-a8ad-f95725b5e005",
                                                "sense_id": "c2a62d13-dff8-32d1-ac76-e27f903e9b94",
                                                "text": "Je größer die Blume, desto mehr ist die Verdienstspanne des Wirtes."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c30ce7a4-a4c8-3143-bed5-bd3516832c13",
                                        "entry_id": "001178dc-6d36-3b33-b426-204b6fc30f29",
                                        "glosses": [
                                            "Schwanz eines Hasen oder eines Kaninchens"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ac9522-c34d-4da8-862d-769c85418b44",
                                                "sense_id": "c30ce7a4-a4c8-3143-bed5-bd3516832c13",
                                                "text": "Vom Hasen war nur noch die verschwindende Blume zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ae00c8c6-b293-326d-b0f5-f93e84d6ccda",
                                        "entry_id": "001178dc-6d36-3b33-b426-204b6fc30f29",
                                        "glosses": [
                                            "typischer Geruch eines Weines"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a056e5-2801-47f8-840c-6428725c4ad7",
                                                "sense_id": "ae00c8c6-b293-326d-b0f5-f93e84d6ccda",
                                                "text": "Dieser Wein hat eine feine, rebsortentypische Blume."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "fb93417f-5194-384a-b1f1-b6654cc22c4f",
                                        "entry_id": "001178dc-6d36-3b33-b426-204b6fc30f29",
                                        "glosses": [
                                            "Grünpflanze (auch nicht blühende)"
                                        ],
                                        "tags": [
                                            "allgemein für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82541235-1d80-4584-a67e-8775e71ef215",
                                                "sense_id": "fb93417f-5194-384a-b1f1-b6654cc22c4f",
                                                "text": "So mancher Pflanzenfreund spricht mit seinen Blumen, wenn er sie gießt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
