                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ddbdc9d-239a-3204-b206-b9eeffcf15bd",
                        "entry_id": "5b04391d-3522-3b17-bad5-a3588cba21f4",
                        "glosses": [
                            "уйти глубже (в землю, воду и т. п.), сместиться вниз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c318304c-3509-4e0f-b9eb-01325360274b",
                                "sense_id": "5ddbdc9d-239a-3204-b206-b9eeffcf15bd",
                                "text": "Фундамент осел. Стены осели."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b7a6202-9995-3ebd-9a50-c7a79b0fd860",
                        "entry_id": "5b04391d-3522-3b17-bad5-a3588cba21f4",
                        "glosses": [
                            "в результате уплотнения, подмыва нижних слоев понизиться в уровне"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10aa2ab2-0a7a-4a9a-b97d-27dc33c5dbb7",
                                "sense_id": "4b7a6202-9995-3ebd-9a50-c7a79b0fd860",
                                "text": "Гора осела. Дно озера осело."
                            }
                        ]
                    },
                    {
                        "sense_id": "25f8e705-ba2c-3234-82b2-b12ee79835f0",
                        "entry_id": "5b04391d-3522-3b17-bad5-a3588cba21f4",
                        "glosses": [
                            "медленно опуститься, упасть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3bcc10d-20bd-4dce-96ea-313be71ab4c4",
                                "sense_id": "25f8e705-ba2c-3234-82b2-b12ee79835f0",
                                "text": "Она вскрикнула, но очень слабо, и вдруг вся осела к полу, хотя и успела еще поднять обе руки к голове."
                            }
                        ]
                    },
                    {
                        "sense_id": "46469fc7-84c4-316e-922b-e6d5467a7e9b",
                        "entry_id": "5b04391d-3522-3b17-bad5-a3588cba21f4",
                        "glosses": [
                            "опуститься на какую-либо поверхность, покрывая слоем"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ee9723ab-eff5-31c0-8914-3c7fa0ed0ee5",
                        "entry_id": "5b04391d-3522-3b17-bad5-a3588cba21f4",
                        "glosses": [
                            "выделиться из раствора в виде осадка"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1d9a6e8c-7761-35d1-b1c6-6f2c83445fa8",
                        "entry_id": "5b04391d-3522-3b17-bad5-a3588cba21f4",
                        "glosses": [
                            "поселиться где-либо на постоянное жительство, прочно обосноваться где-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e37a397-8bc8-4352-8419-5e53d01b0024",
                                "sense_id": "1d9a6e8c-7761-35d1-b1c6-6f2c83445fa8",
                                "text": "Кочевники осели в долинах рек."
                            }
                        ]
                    }
                ],
