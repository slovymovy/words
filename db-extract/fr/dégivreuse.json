                        "glosses": [
                            "Machine utilisée dans les aéroports pour le dégivrage des avions au sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e5fc09-10a4-4866-b3d3-0f2f1ff77efe",
                                "sense_id": "47449aa4-3907-38e5-9daf-3530ec4a9913",
                                "text": "Samedi, c’est un problème technique sur la dégivreuse de l’aéroport, qui avait provoqué un léger retard de trois-quarts d’heure au départ du vol Rodez-Paris."
                            },
                            {
                                "example_id": "567afde6-cb4e-488c-adb8-9467f40d44d3",
                                "sense_id": "47449aa4-3907-38e5-9daf-3530ec4a9913",
                                "text": "Pour ces raisons, le commandant de bord décide de faire appel à la dégivreuse afin qu’elle débarrasse l’avion de son givre ou de sa neige en l’aspergeant d’un liquide chauffé à 180°."
                            },
                            {
                                "example_id": "561441c1-249a-4b6c-9d98-e689ef02780f",
                                "sense_id": "47449aa4-3907-38e5-9daf-3530ec4a9913",
                                "text": "L’aéroport de Clermont-Ferrand Auvergne, géré par VINCI Airports, a reçu la toute première dégivreuse 100% électrique pour avion au monde."
                            }
                        ]
                    }
