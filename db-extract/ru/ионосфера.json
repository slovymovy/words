                    {
                        "translation_id": "79f3b911-bfa8-4218-9dcc-352aa63d26cf",
                        "source_entry_id": "1d8a72f7-8125-3079-abc9-ebe0e5b8fe0e",
                        "source_sense_id": "504a2bb9-c4c4-3d63-9cd4-b1c365606dc9",
                        "target_lang_word": "Ionosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ionosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cd0fc61-3068-344f-b501-08a3a6595cd3",
                                        "entry_id": "977ac710-4c33-38cd-bb70-d4f109aaed66",
                                        "glosses": [
                                            "äußerste Schicht der Atmosphäre eines Himmelskörpers (meist der Erde), die durch Sonnenstrahlung Ionen und freie Elektronen enthält"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c15dcf8-5a1b-466b-8f45-076d710201fa",
                                                "sense_id": "7cd0fc61-3068-344f-b501-08a3a6595cd3",
                                                "text": "„Die Ionosphäre — jene Schicht, die zwischen 80 und 500 Kilometern unseren Planeten umgibt — ist bis heute so gut wie unerforscht.“"
                                            },
                                            {
                                                "example_id": "2bfc00bc-833f-4642-883a-c5fbc2a15cff",
                                                "sense_id": "7cd0fc61-3068-344f-b501-08a3a6595cd3",
                                                "text": "„Diesmal wird die besondere Aufmerksamkeit der Himmelsforscher verschiedenen noch wenig ergründeten Phänomenen gelten, die sich vor allem in der Ionosphäre und der oberen Atmosphäre abspielen.“"
                                            },
                                            {
                                                "example_id": "c8756257-f583-4e01-95d8-b803c1b05af0",
                                                "sense_id": "7cd0fc61-3068-344f-b501-08a3a6595cd3",
                                                "text": "„Denn hier in Polnähe trifft der wechselnde Sonnenwind besonders intensiv auf die Erde, beeinflusst die Ionosphäre – und möglicherweise auch das Klima.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1890b615-98e3-4715-9d94-2f41e4215ae3",
                        "source_entry_id": "1d8a72f7-8125-3079-abc9-ebe0e5b8fe0e",
                        "source_sense_id": "504a2bb9-c4c4-3d63-9cd4-b1c365606dc9",
