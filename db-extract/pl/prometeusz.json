                        "cross_references": [
                            {
                                "target_word": "Prométhée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74f520e6-90d4-385b-8199-9dc8f1ba9cc2",
                                        "entry_id": "483b1b3a-ec64-3c91-9663-c03447842de5",
                                        "glosses": [
                                            "Titan, fils de Japet, père de Deucalion, frère d’Épiméthée, créa l’homme d’argile et vola le feu des dieux pour lui insuffler la vie. Il fut condamné au supplice pour ce vol, et libéré par Héraclès."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acfed279-8d63-4669-9927-d3cd57589a19",
                                                "sense_id": "74f520e6-90d4-385b-8199-9dc8f1ba9cc2",
                                                "text": "Enfin, Bert demeura seul, Prométhée triste et déçu, victime d’un feu qu’il n’avait pas dérobé."
                                            },
                                            {
                                                "example_id": "0b025c90-c7cf-409b-97c5-25203011959a",
                                                "sense_id": "74f520e6-90d4-385b-8199-9dc8f1ba9cc2",
                                                "text": "Le mythe de Prométhée signifie que toute la tristesse du monde a son siège dans le foie. Mais qui oserait reconnaître une vérité si humble ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3832dd55-53da-3358-a95b-801d6590504b",
                                        "entry_id": "483b1b3a-ec64-3c91-9663-c03447842de5",
                                        "glosses": [
                                            "Satellite naturel de la planète Saturne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c50094eb-ea52-353d-bdfb-a92f58757383",
                                        "entry_id": "483b1b3a-ec64-3c91-9663-c03447842de5",
                                        "glosses": [
                                            "(1809) Prométhée, internationalement (1809) Prometheus, planète mineure."
