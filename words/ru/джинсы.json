                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В магазине не оказалось нужной мне <w>джинсы</w> для пошива куртки.",
                            "target_lang_translations": {
                                "en": "The store did not have the <w>denim</w> I needed to sew a jacket.",
