                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6b475a3-db38-4032-a4b0-1551203baa56",
                        "source_entry_id": "bf493d34-df29-3b8b-a776-3f1268de5f09",
                        "source_sense_id": "96d60df5-364e-3b6f-b599-ab311017cd9d",
                        "target_lang_word": "fiat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8794a331-4892-399c-84dd-e8764537a204",
                                        "entry_id": "88981ae1-e516-389b-8826-980e01403a7c",
                                        "glosses": [
                                            "An arbitrary or authoritative command or order to do something; an effectual decree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c906e7b9-1e87-4d79-9c7d-b18785128861",
                                                "sense_id": "8794a331-4892-399c-84dd-e8764537a204",
                                                "text": "A royal fiat."
                                            },
                                            {
                                                "example_id": "2577cc9d-9566-47b4-a515-4d79b0a46c6a",
                                                "sense_id": "8794a331-4892-399c-84dd-e8764537a204",
                                                "text": "A presidential fiat."
                                            },
                                            {
                                                "example_id": "f80d918e-54a0-4a5d-b440-599e2519fa65",
                                                "sense_id": "8794a331-4892-399c-84dd-e8764537a204",
                                                "text": "The reflection that the fate of a fellow-creature depended on his sole fiat, would naturally inspire scrupulousness and caution; [...]"
                                            },
                                            {
                                                "example_id": "48a2535e-46fb-47ab-ab14-832808dcdac2",
                                                "sense_id": "8794a331-4892-399c-84dd-e8764537a204",
                                                "text": "Beatrice raised her head: she looked at me as if on my words hung the fiat of life or death, fear and earnestness dilating her dark eyes—for an unconfessed hope had arisen within her."
                                            },
                                            {
                                                "example_id": "0ce3e258-e353-47ba-b991-bf471dc36a29",
                                                "sense_id": "8794a331-4892-399c-84dd-e8764537a204",
                                                "text": "It must be an absolute fiat - something of the nature of a Mystery or of Religion or Magic - and not to be disputed."
                                            },
                                            {
                                                "example_id": "7582dd99-2a93-4522-ab05-79f69ff28d88",
                                                "sense_id": "8794a331-4892-399c-84dd-e8764537a204",
                                                "text": "The increases from December 4 in the prices of table d'hôte meals in British Railways restaurant cars were expected, in view both of a general upward trend in meal prices in the catering trade and of the fiat that train meals must pay for themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c3fa63a-1ff3-3b90-97a1-1614c1736b4f",
                                        "entry_id": "88981ae1-e516-389b-8826-980e01403a7c",
                                        "glosses": [
                                            "Authorization, permission or (official) sanction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f33e7f5-c2a5-4ed4-8121-40ecb8c8c2b6",
                                                "sense_id": "2c3fa63a-1ff3-3b90-97a1-1614c1736b4f",
                                                "text": "A government fiat."
                                            },
                                            {
                                                "example_id": "1e837d8a-ce76-429e-8bd8-2984cba84c7c",
                                                "sense_id": "2c3fa63a-1ff3-3b90-97a1-1614c1736b4f",
                                                "text": "To rule by fiat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a79f34d0-39f6-38f2-a557-34b2b2ddcd46",
                                        "entry_id": "88981ae1-e516-389b-8826-980e01403a7c",
                                        "glosses": [
                                            "A warrant of a judge for certain processes."
                                        ],
                                        "tags": [
                                            "English",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "867b3e4e-ff48-3f46-9121-799674b77e7e",
                                        "entry_id": "88981ae1-e516-389b-8826-980e01403a7c",
                                        "glosses": [
                                            "An authority for certain proceedings given by the Lord Chancellor's signature."
                                        ],
                                        "tags": [
                                            "English",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4525f51-5bd0-3349-9794-2747f287d7d5",
                                        "entry_id": "88981ae1-e516-389b-8826-980e01403a7c",
                                        "glosses": [
                                            "(Pertaining to) fiat currency."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "931b5384-a318-4fe6-a805-a5deda2f6d17",
                                                "sense_id": "b4525f51-5bd0-3349-9794-2747f287d7d5",
                                                "text": "But let us trace a little more particularly the differences between the \"fiat\" dollar and the greenback. The greenback, in common with every bank note any of you have ever seen, contains a promise to pay dollars."
                                            },
                                            {
                                                "example_id": "dc31e97f-afe8-4fcc-84a0-fa3dd22621c5",
                                                "sense_id": "b4525f51-5bd0-3349-9794-2747f287d7d5",
                                                "text": "But, say these men who claim for our Congress creative power, we will pass a law making these 'fiat' dollars legal tender for all debts, public and private."
                                            },
                                            {
                                                "example_id": "3d3f3c6e-9d3a-4ad8-95de-1534a8286995",
                                                "sense_id": "b4525f51-5bd0-3349-9794-2747f287d7d5",
                                                "text": "The gold dollar is as much a fiat dollar as the silver dollar or a paper dollar, for none of them are money without this fiat [of the government, that it is legal tender]."
                                            },
                                            {
                                                "example_id": "114d5398-c049-4883-9c23-4105a093a1fe",
                                                "sense_id": "b4525f51-5bd0-3349-9794-2747f287d7d5",
                                                "text": "All silver content in coins had to be removed from the currency supply, and fiat coins (or tokens) had to take their place."
                                            },
                                            {
                                                "example_id": "37544d0e-83da-4c29-a004-8010fd6ca76a",
                                                "sense_id": "b4525f51-5bd0-3349-9794-2747f287d7d5",
                                                "text": "[…] a unit of a fiat medium of exchange like the dollar bill. Like fiat money, gold has an unstable value in relation to other goods and services. The stock of gold is historically given and cannot rapidly accommodate changes in demand."
                                            }
                                        ]
                                    }
                                ]
                            },
