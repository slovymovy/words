                    },
                    {
                        "form_id": "10aa80de-6a49-4b25-92ae-ab80b7958b8e",
                        "entry_id": "fab49ac2-de65-3a2a-a989-f20807184b3a",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "abdominales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7e30096-aecd-32a5-af1a-18ce99ae0cb3",
                        "entry_id": "fab49ac2-de65-3a2a-a989-f20807184b3a",
                        "glosses": [
                            "Relatif à l’abdomen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f3ed28f-94af-4dd2-9437-dd9dcee5dedf",
                                "sense_id": "f7e30096-aecd-32a5-af1a-18ce99ae0cb3",
                                "text": "Elles sont orientées principalement sur les régions abdominales, au niveau du plexus solaire, puis cervicodorsales, scapulaires et lombaires."
                            },
                            {
                                "example_id": "f1dc494a-8067-491a-a898-ec965641d876",
                                "sense_id": "f7e30096-aecd-32a5-af1a-18ce99ae0cb3",
                                "text": "Une rupture brutale d’un anévrysme aortique abdominal s’accompagne d’une douleur intense dans l’abdomen et dans le dos."
                            },
                            {
                                "example_id": "679d732b-f163-4f0b-9e87-a64bd0274d22",
                                "sense_id": "f7e30096-aecd-32a5-af1a-18ce99ae0cb3",
                                "text": "En dégageant de l’histamine, ils provoquent des céphalées, voire, selon les allergologues, des rhinorrhées, des éternuements, des démangeaisons, de l’urticaire, des douleurs abdominales et même, pour les plus sensibles, de l’asthme… — (« Sulfites : Ça sulfite comme ça », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 77)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5538b69-41d9-4fcd-97eb-a662b6b4fdc3",
                        "source_entry_id": "fab49ac2-de65-3a2a-a989-f20807184b3a",
                        "source_sense_id": "f7e30096-aecd-32a5-af1a-18ce99ae0cb3",
                        "target_lang_word": "abdominal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abdominal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "696a679c-0981-31b2-bb2d-319fb3e26711",
                                        "entry_id": "d2d45e15-209c-3a8f-868e-507508c798e3",
                                        "glosses": [
                                            "den Bauch des Menschen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74496a6d-ea0a-4a52-9c05-c1c4a27bdc83",
                                                "sense_id": "696a679c-0981-31b2-bb2d-319fb3e26711",
                                                "text": "Der Patient muss abdominal untersucht werden."
                                            },
                                            {
                                                "example_id": "d9e63c0e-ffb3-45aa-91c0-4b8cb3ef1471",
                                                "sense_id": "696a679c-0981-31b2-bb2d-319fb3e26711",
                                                "text": "Diese unklare abdominale Erkrankung klang im Verlauf von zwei bis drei Wochen ab, aber seither bekam das Kind in unregelmäßigen Abständen Stören von Bauchweh und Durchfällen, meist nur kurz dauernd, ein bis zwei Tage."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ca23e7f-e0b6-3d17-871b-5e5ca810671c",
                                        "entry_id": "d2d45e15-209c-3a8f-868e-507508c798e3",
                                        "glosses": [
                                            "den Hinterleib des Insekts betreffend"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001e0f55-0ffe-4501-9465-00286abd7931",
                                                "sense_id": "5ca23e7f-e0b6-3d17-871b-5e5ca810671c",
                                                "text": "Bei Insekten wird der Vorderabschnitt des abdominalen Tergums als Notum bezeichnet, der hintere Abschnitt als Postnotum."
                                            },
                                            {
                                                "example_id": "3ccb8e1d-8e4e-4036-80d1-52ef0bc6c640",
                                                "sense_id": "5ca23e7f-e0b6-3d17-871b-5e5ca810671c",
                                                "text": "Vom abdominal liegenden Röhrenherz der Insekten wird eine mit Nährstoffen angereicherte Hämolymphe im Körper verteilt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
