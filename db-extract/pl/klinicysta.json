                                    {
                                        "sense_id": "33b95e19-4a52-3ee3-839e-8c684476171e",
                                        "entry_id": "241244b1-40bd-370b-9d9e-2218187f79bd",
                                        "glosses": [
                                            "Any healthcare practitioner working at the point of care, in clinical practice (e.g., physicians in clinical medicine, nurses in nursing practice, or allied health providers in practice)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a59b47f-6e4f-3715-ad64-872d55ad7cf1",
                                        "entry_id": "241244b1-40bd-370b-9d9e-2218187f79bd",
                                        "glosses": [
                                            "Someone who conducts a clinic; an expert or skilled practitioner in a particular field, such as business or education. In this sense, a clinician is someone who provides practical advice or hands-on assistance to others in a specific area of expertise. For example, a business clinician might be an experienced consultant who helps companies improve their operations, while an education clinician might be a skilled teacher who provides professional development and support to other educators."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dec7b632-bc38-46ff-a830-88d3d68489aa",
                        "source_entry_id": "6ef129ca-e73a-31ef-bfdd-7958c7186f57",
                        "source_sense_id": "005eab71-91b4-3a9f-861c-7694cafb458e",
                        "target_lang_word": "clinicien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clinicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b79bc1a3-376b-3f12-9aef-489a0346fe02",
                                        "entry_id": "fdd1a3a6-b5ac-31af-90b6-2b45a5db645c",
                                        "glosses": [
                                            "De clinique médicale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13652cd-4941-41fc-a82d-c9af9fc0e71e",
                                                "sense_id": "b79bc1a3-376b-3f12-9aef-489a0346fe02",
                                                "text": "Hélène Romano, psychologue clinicienne et urgentiste au Samu 94, indique que «cette asphyxie dangereuse est notamment évoquée dans des films sadomasochistes»."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clinicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eeb59579-0f69-37ee-9e5b-66eb330aa146",
                                        "entry_id": "95e8a47f-92ce-3a2c-b74e-c106784d7354",
                                        "glosses": [
                                            "Médecin qui œuvre essentiellement en clinique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d33c0c7-939d-4a3d-b95e-d9dbe963cc9e",
                                                "sense_id": "eeb59579-0f69-37ee-9e5b-66eb330aa146",
                                                "text": "Néanmoins la préoccupation constante des cliniciens à l'égard de l’amibiase, et cette tendance à la voir partout peut-être parce qu'elle est partout, prennent figure de manie aux yeux des parasitologues."
                                            },
                                            {
                                                "example_id": "9eaf2eba-7302-42fb-8c64-baf905b0758e",
                                                "sense_id": "eeb59579-0f69-37ee-9e5b-66eb330aa146",
                                                "text": "En 1878, le professeur S. Botkine, éminent clinicien russe, offrit au jeune physiologiste plein de talent un poste de manipulateur."
                                            },
                                            {
                                                "example_id": "63b4c733-f214-4aa3-9716-8791aa2ab6e9",
                                                "sense_id": "eeb59579-0f69-37ee-9e5b-66eb330aa146",
                                                "text": "Le diagnostic différentiel de l’apathie et de la dépression reste un véritable défi lancé au clinicien, certains symptômes étant communs, le manque de motivation en particulier."
                                            },
                                            {
                                                "example_id": "70b11075-d782-4b35-a836-3f46ab33807e",
                                                "sense_id": "eeb59579-0f69-37ee-9e5b-66eb330aa146",
                                                "text": "Il faudrait aussi une représentation interdisciplinaire avec des spécialistes du développement de l'enfant, des accidentologues, des ingénieurs, des urbanistes, des cliniciens, des sociologues et d'autres encore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
