                "senses": [
                    {
                        "sense_id": "c65f4846-2654-3f1f-b735-572dde4c33b0",
                        "entry_id": "7ea183c0-4473-34a0-ae2f-f602a6ec2892",
                        "glosses": [
                            "Ausrichter eines Marathonlaufs; Institution/Organisation beziehungsweise Einzelperson, die einen Marathon plant, organisiert und durchführt"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "d2dfdbe7-738e-4166-b0d3-b1091239c80c",
                                "sense_id": "c65f4846-2654-3f1f-b735-572dde4c33b0",
                                "text": "„Zu den größten Sorgen eines Marathonorganisators gehören Baustellen auf der Strecke, von denen zunächst weder der Veranstalter noch die Stadtverwaltung Kenntnis hat.“"
                            },
                            {
                                "example_id": "b5243661-471c-4d5c-8191-c27b7ea60f75",
                                "sense_id": "c65f4846-2654-3f1f-b735-572dde4c33b0",
                                "text": "„‚Unser damaliges Konzept, den Breitensport in den Vordergrund zu stellen und weiter in den Service für die Sportler und die Qualität der Veranstaltung zu investieren, ist voll aufgegangen‘, sagt Marathonorganisator Klaus Malorny von der Master Logistics GmbH.“"
                            },
                            {
                                "example_id": "9c9112a5-d43b-449d-a710-0b111f5ec6b0",
                                "sense_id": "c65f4846-2654-3f1f-b735-572dde4c33b0",
                                "text": "„Die Marathonorganisatoren bescheinigen der Landjugend die höchste Teilnehmerzahl unter den Firmenwertungen.“"
                            },
                            {
                                "example_id": "8ecb51c0-7eff-4489-8d0b-161008e85e88",
                                "sense_id": "c65f4846-2654-3f1f-b735-572dde4c33b0",
                                "text": "„So sieht es eine Idee der Marathonorganisatoren vor.“"
                            },
                            {
                                "example_id": "ffa301b3-7f80-4da2-b0be-7e9fc2641782",
                                "sense_id": "c65f4846-2654-3f1f-b735-572dde4c33b0",
                                "text": "„Für Freude bei den Leipziger Marathonorganisatoren sorgte die Nachricht des DRIV (Deutscher Rollsport- und Inline-Verband), dass der Inline-Halbmarathon wieder als Wertungsrennen der Klasse C bestätigt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
