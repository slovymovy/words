                "senses": [
                    {
                        "sense_id": "2d50d5b8-0eb4-37a2-a000-628b01714423",
                        "entry_id": "673addb5-3d9c-3a82-8edd-40c1a63a888b",
                        "glosses": [
                            "очистить от шкуры и выпотрошить убитое животное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16b950b4-b670-42ca-b138-4a25cb4aa846",
                                "sense_id": "2d50d5b8-0eb4-37a2-a000-628b01714423",
                                "text": "Чтобы потешить меня, Николай Матвеич убил её и очень ловко освежевал, то есть снял шкуру, как перчатку."
                            },
                            {
                                "example_id": "ad23b37d-7cb0-45a2-836b-888a3a771c66",
                                "sense_id": "2d50d5b8-0eb4-37a2-a000-628b01714423",
                                "text": "Поросёнка ж освежевать, сварить иль испечь — самое разлюбезное, самое сподручное дело."
                            }
                        ]
                    }
