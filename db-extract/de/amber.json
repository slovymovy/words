                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b16cafcd-84ac-370c-846f-f32930bcb7fa",
                        "entry_id": "1f7f2d7a-4393-3e0a-ae08-29777874fcbb",
                        "glosses": [
                            "weiblicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82976916-0c0a-4769-af30-f35eb7b9e6e3",
                                "sense_id": "b16cafcd-84ac-370c-846f-f32930bcb7fa",
                                "text": "Lukas und Hinnerk, ihr sollt doch die kleine Amber nicht immer ärgern!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaa2f402-12f5-46c5-aa85-16603e292cf6",
                        "source_entry_id": "1f7f2d7a-4393-3e0a-ae08-29777874fcbb",
                        "source_sense_id": "b16cafcd-84ac-370c-846f-f32930bcb7fa",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Amber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edb613c8-e933-3b70-b646-bfcb87cf74af",
                                        "entry_id": "c9d08380-14bc-3c35-919c-277f81665e29",
                                        "glosses": [
                                            "A female given name from English, popular in the 1980s and the 1990s."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edb3eda6-cb6c-4edc-943d-688f7d6dc508",
                                                "sense_id": "edb613c8-e933-3b70-b646-bfcb87cf74af",
                                                "text": "The youngest daughter of the Marchioness of Summerdown had one of these quaint, pretty names - Amber! - and what a pretty creature she was!"
                                            },
                                            {
                                                "example_id": "a3f3cf00-427c-4267-a89e-2f6c8e8a4e38",
                                                "sense_id": "edb613c8-e933-3b70-b646-bfcb87cf74af",
                                                "text": "And then she said softly, \"Sarah - I think I'll name her Amber - for the colour of her father's eyes - \""
                                            },
                                            {
                                                "example_id": "5c43cfdb-2227-4e9b-a30f-3d93c9aeef27",
                                                "sense_id": "edb613c8-e933-3b70-b646-bfcb87cf74af",
                                                "text": "A bit raddled, maybe thirty, maybe older, tanned like a hitchhiker, dressed like a road protester, one of those older women still determinedly being a girl; all those eighties feministy still-political women were terribly interested in what Eve did. Hippie name. Amber. Ridiculous name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b3e91e2-563c-3a36-a436-21aaa0dbebf5",
                                        "entry_id": "c9d08380-14bc-3c35-919c-277f81665e29",
                                        "glosses": [
                                            "A surname of uncertain origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3698b4f0-5020-4f42-8355-1a5ddcf7faa6",
                                                "sense_id": "3b3e91e2-563c-3a36-a436-21aaa0dbebf5",
                                                "text": "Amber, the half, generally waltzed round our forwards, and when he secured he passed the ball on to Aspinall."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Amber",
