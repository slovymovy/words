                "senses": [
                    {
                        "sense_id": "504e836f-e53e-3cf9-b6b5-2eea42a562d2",
                        "entry_id": "52b03f78-220f-320c-bec5-f097be131559",
                        "glosses": [
                            "glanzend zwart, vaak gebruikt om een haarkleur aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f38b0a1-1702-414e-aef4-9968df1ef5f1",
                                "sense_id": "504e836f-e53e-3cf9-b6b5-2eea42a562d2",
                                "text": "Eerst in zijn lange regenjas, daarna met handdoek rond de nek, zijn ravenzwarte haar achteruit zwiepend, tot groot genoegen van de meiden vooraan. In zijn stem huisde soms een sexy Alex Turner. Zijn gitaar gebruikte hij maar mondjesmaat om een loopje te samplen of wat afropopriedels toe te voegen."
                            },
                            {
                                "example_id": "5c4af7e9-3217-46a2-a186-369524d09cee",
                                "sense_id": "504e836f-e53e-3cf9-b6b5-2eea42a562d2",
                                "text": "Hoofd omhoog, ravenzwart van kleur , brede schouders met overvloedig behang. Dat kenmerkt een Fries paard dat opgenomen kan worden in het stamboek. Op de negende editie van de fokdag van fokvereniging Het Friesche Paard Twente-Achterhoek werden gisteren 163 paarden gekeurd door de vakkundige jury in paardensportcentrum de Hoffmeijer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "222d66de-d9c1-4cfb-a896-a1c277eb6462",
                        "source_entry_id": "52b03f78-220f-320c-bec5-f097be131559",
                        "source_sense_id": "504e836f-e53e-3cf9-b6b5-2eea42a562d2",
                        "source_sense_description": "(kleur) glanzend zwart, vaak gebruikt om een haarkleur aan te geven",
                        "target_lang_word": "raven",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raven",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ae7c283-567f-3b03-bee9-258f98de8861",
                                        "entry_id": "a5c6b3a4-3dd8-30d1-a291-3a6cf026d5c6",
                                        "glosses": [
                                            "Any of several, generally large and lustrous black species of birds in the genus Corvus, especially the common raven (Corvus corax)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4df219c6-1bae-4a37-80f0-d36a3432620e",
                                                "sense_id": "5ae7c283-567f-3b03-bee9-258f98de8861",
                                                "text": "Some ſay that Rauens foſter forlorne children, / The vvhilſt their ovvne birds famiſh in their neſts: / Oh be to me though thy hard hart ſay no, / Nothing ſo kinde but ſomething pittifull."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0643e33f-de09-36e6-8e17-a644ef836119",
                                        "entry_id": "a5c6b3a4-3dd8-30d1-a291-3a6cf026d5c6",
                                        "glosses": [
                                            "A jet-black color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c94249af-03fe-4002-b6e4-b40019411760",
                                                "sense_id": "0643e33f-de09-36e6-8e17-a644ef836119",
                                                "text": "A lone man walks the shores of Nantucket; his noble form is slightly bent, and with the raven of his hair is blended the faintest tinge of gray, though he is evidently a man to whom the meridian of life is yet far in the distance […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raven",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39df9db5-4c10-34de-a250-a713504ef6e3",
                                        "entry_id": "bce62bd0-591e-3e96-b413-5fd903d03688",
                                        "glosses": [
                                            "Of the color of the raven; jet-black."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9dd54a-7799-4916-b451-0bba8eef6a4b",
                                                "sense_id": "39df9db5-4c10-34de-a250-a713504ef6e3",
                                                "text": "raven curls; raven darkness"
                                            },
                                            {
                                                "example_id": "51bb3dda-ed4d-450a-9e85-dfd7ada70bd3",
                                                "sense_id": "39df9db5-4c10-34de-a250-a713504ef6e3",
                                                "text": "She was a tall, sophisticated, raven-haired beauty."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raven",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73cc8fb6-7bfd-3308-a464-319d5abfdd20",
                                        "entry_id": "fe3fb5d6-9a99-3f14-8738-5086c99c18bf",
                                        "glosses": [
                                            "Rapine; rapacity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6d14166-b31c-3a4c-9b95-fc746a218373",
                                        "entry_id": "fe3fb5d6-9a99-3f14-8738-5086c99c18bf",
                                        "glosses": [
                                            "Prey; plunder; food obtained by violence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "raven",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40e8eee2-2a72-396f-bb2e-7076a2cc2dac",
                                        "entry_id": "8f297019-215d-33a4-a058-521a1b537270",
                                        "glosses": [
                                            "To obtain or seize by violence; to plunder."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "989b1475-a157-40e1-85ae-f5fc71b87515",
                                                "sense_id": "40e8eee2-2a72-396f-bb2e-7076a2cc2dac",
                                                "text": "[…] ravening and destroying his goodes, they spoyled his wife and chyldren of all theyr apparell […]"
                                            },
                                            {
                                                "example_id": "bb025fe2-9393-49a1-9894-a287765b472e",
                                                "sense_id": "40e8eee2-2a72-396f-bb2e-7076a2cc2dac",
                                                "text": "Hee … sought to eat him up, and to raven all hee could get from him."
                                            },
                                            {
                                                "example_id": "bb57225e-5e1b-4848-aaff-4aca723213a4",
                                                "sense_id": "40e8eee2-2a72-396f-bb2e-7076a2cc2dac",
                                                "text": "Nor had the Wolf raven'd away so much as one."
                                            },
                                            {
                                                "example_id": "6b75cb03-72c7-408b-8559-a93b8080a83e",
                                                "sense_id": "40e8eee2-2a72-396f-bb2e-7076a2cc2dac",
                                                "text": "That they might not be disturbed whilst busie ravening after Booty."
                                            },
                                            {
                                                "example_id": "6e1a31c4-ff75-4e63-bda6-4e3be655fef7",
                                                "sense_id": "40e8eee2-2a72-396f-bb2e-7076a2cc2dac",
                                                "text": "... his Croats and loose hordes went openly ravening about, bent on mere 'housebreaking, street-robbery and insolent violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc0701a6-d514-3fcd-8fde-c925d148a385",
                                        "entry_id": "8f297019-215d-33a4-a058-521a1b537270",
                                        "glosses": [
                                            "To devour with great eagerness; to feed (on something) hungrily or greedily."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ffb0044-fee2-4988-8d75-26b5f6ee0a99",
                                                "sense_id": "cc0701a6-d514-3fcd-8fde-c925d148a385",
                                                "text": "And the hound Time, when all the Worlds and cities are swept away whereon he used to raven, having no more to devour, shall suddenly die."
                                            },
                                            {
                                                "example_id": "aa15977f-549f-40ab-9856-14b1fd248a99",
                                                "sense_id": "cc0701a6-d514-3fcd-8fde-c925d148a385",
                                                "text": "A Lion new returnde from rauening pray [sic] […]"
                                            },
                                            {
                                                "example_id": "8ecb43fe-9cfd-49d6-ae44-80c5012dad51",
                                                "sense_id": "cc0701a6-d514-3fcd-8fde-c925d148a385",
                                                "text": "... the Bowels, thence to diffuse itself throughout, mix with the vital spirit, and convert that kindly heat which should animate, into those wild irregular flames which ravine and consume. And this is done by that Pestilential spirit[…]"
                                            },
                                            {
                                                "example_id": "9c2005fe-f0e4-4fd2-b975-30d10feb78ae",
                                                "sense_id": "cc0701a6-d514-3fcd-8fde-c925d148a385",
                                                "text": "Clusters of grapes, the which they raven'd quick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d5a0f43-278f-33c9-b31a-5cd719702af4",
                                        "entry_id": "8f297019-215d-33a4-a058-521a1b537270",
                                        "glosses": [
                                            "To prey on with rapacity; to attack with violence in order to, or as if to, devour."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09588703-95a5-4942-9f42-e74a5aeff0c7",
                                                "sense_id": "6d5a0f43-278f-33c9-b31a-5cd719702af4",
                                                "text": "I refer to the danger of keeping a dog of this nature and disposition in a bedroom, where it can spring out ravening on anyone who enters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e034b236-4234-312e-9b52-669f4534dc39",
                                        "entry_id": "8f297019-215d-33a4-a058-521a1b537270",
                                        "glosses": [
                                            "To show rapacity; to be greedy (for something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f325d80d-88fd-44e8-9ea2-dd22403976e1",
                                                "sense_id": "e034b236-4234-312e-9b52-669f4534dc39",
                                                "text": "[…] because hogs are commonly rauening for their meat, more then other cattel, it is meet therefore to haue them ringed, or else they wil doe much hurt in digging and turning vp corne fieldes […]"
                                            },
                                            {
                                                "example_id": "dcdfe2ff-4099-4bb6-83dc-e856434334d1",
                                                "sense_id": "e034b236-4234-312e-9b52-669f4534dc39",
                                                "text": "They passed along towards the great hall-door, where the winds howled and ravened for their prey […]"
                                            },
                                            {
                                                "example_id": "1024f0a5-da12-41e1-8446-d66575c6f83e",
                                                "sense_id": "e034b236-4234-312e-9b52-669f4534dc39",
                                                "text": "The Greek were-wolf is closely related to the vampire. The lycanthropist falls into a cataleptic trance, during which his soul leaves his body, enters that of a wolf and ravens for blood."
                                            },
                                            {
                                                "example_id": "9765c6d1-37b6-43a0-9e74-4f32d017c467",
                                                "sense_id": "e034b236-4234-312e-9b52-669f4534dc39",
                                                "text": "On one side the great temple where you can gather the good harvest—on the other a dirty little scandal that you’ve nosed out to fling to paper scavengers who feed it to their readin’ millions ravening for pornographic dirt."
