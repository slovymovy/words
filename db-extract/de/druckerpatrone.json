                            {
                                "example_id": "003a3309-5758-413b-bf06-f7c48c3ff2b4",
                                "sense_id": "cdae18e1-d940-3d3c-8afe-84b0c2044114",
                                "text": "Weil die Druckerpatrone leer ist, kann er das Bild nicht ausdrucken.",
                                "translation": "L’image ne peut pas être imprimée, car la cartouche d’imprimante est vide."
                            },
                            {
                                "example_id": "88425610-3540-4b31-aa89-a435a532a7ae",
                                "sense_id": "cdae18e1-d940-3d3c-8afe-84b0c2044114",
                                "text": "Gerade heute morgen hat die Sekretärin ihre letzte vorrätige Druckerpatrone in Gebrauch genommen.",
                                "translation": "Ce matin, la secrétaire a utilisé les dernières cartouches d’imprimantes disponibles."
                            }
                        ]
                    }
