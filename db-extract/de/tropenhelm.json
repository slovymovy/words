                ],
                "senses": [
                    {
                        "sense_id": "fe53b996-cb3f-309a-91ea-d8ea38e98975",
                        "entry_id": "443ff645-43fd-3b88-8264-b9c3c2b36b78",
                        "glosses": [
                            "Kopfbedeckung, die meist in tropischen Regionen zum Schutz vor Sonneneinstrahlung, Niederschlag und mechanischen Gefahren getragen wird; dies typischerweise von Auswärtigen (Reisenden, Kolonialherren)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "968fabfa-60fa-44b4-9952-73b345f8a63c",
                                "sense_id": "fe53b996-cb3f-309a-91ea-d8ea38e98975",
                                "text": "„Ein Mann mit weißem Tropenhelm konnte in den Augen der Söldner nur ein Vertreter des Freistaats sein, der ihre Arbeit begutachten wollte.“"
                            },
                            {
                                "example_id": "b7da20bb-cff3-42a4-9d17-3a2c64fc5448",
                                "sense_id": "fe53b996-cb3f-309a-91ea-d8ea38e98975",
                                "text": "„Dessen exotische Erscheinung passte durchaus in das Ambiente des Kaffeehauses: weißer Anzug mit Einstecktuch, Schal mit Lilienmuster, spitze Krokodillederschuhe, nur der Tropenhelm fehlte.“"
                            },
                            {
                                "example_id": "333f060d-3537-4940-94bf-a6e2121a7722",
                                "sense_id": "fe53b996-cb3f-309a-91ea-d8ea38e98975",
                                "text": "„Herr Pangalos und Herr Ho Irawadi wollten Tropenhelme kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3c30de9-84c4-4af5-bb42-6ed3a42a456e",
                        "source_entry_id": "443ff645-43fd-3b88-8264-b9c3c2b36b78",
                        "source_sense_id": "fe53b996-cb3f-309a-91ea-d8ea38e98975",
                        "target_lang_word": "topee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "topee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3515afcc-1850-3632-ae58-11d6dff57faa",
                                        "entry_id": "de18c62b-6dff-36ff-9eab-ce29f62946db",
                                        "glosses": [
                                            "A pith helmet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d84d2bb4-8756-4106-b66e-e7f3bfad51ed",
                                                "sense_id": "3515afcc-1850-3632-ae58-11d6dff57faa",
                                                "text": "I lent my topee to Camarião, who looked extremely odd in it."
                                            },
                                            {
                                                "example_id": "2ec1cf9a-68b1-46bb-83a0-ffa4210d6d3d",
                                                "sense_id": "3515afcc-1850-3632-ae58-11d6dff57faa",
                                                "text": "There were a few people on the platform, among them two Indian police, and a station oflicial with a white topee."
                                            },
                                            {
                                                "example_id": "93d640c5-131a-4d69-ae67-c0b542dba577",
                                                "sense_id": "3515afcc-1850-3632-ae58-11d6dff57faa",
                                                "text": "'Not a drop of perspiration on his face,' Ned had commented, 'and in the tropics now no one wears a topee, except certain regiments, and Peter the Planter's type of topee blows off in anything over a five-knot breeze.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8a3f469-ba51-451e-a507-1b965d29710d",
                        "source_entry_id": "443ff645-43fd-3b88-8264-b9c3c2b36b78",
                        "source_sense_id": "fe53b996-cb3f-309a-91ea-d8ea38e98975",
