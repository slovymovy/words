                ],
                "translations": [
                    {
                        "translation_id": "3a0b3001-de71-440a-b5c2-19499405b6f9",
                        "source_entry_id": "a9b21d9c-5c2d-309d-9297-a1e916b01eb9",
                        "source_sense_id": "f1a4f149-5d0a-316d-8064-1ec08ac828fd",
                        "target_lang_word": "exciter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exciter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9deb36df-3dec-3545-afa4-03e46c5368df",
                                        "entry_id": "96ba6bf1-1a20-3345-aa6e-71fe946aa263",
                                        "glosses": [
                                            "Engager ; porter à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9375fb10-5f8f-4122-a21d-a12c87175f14",
                                                "sense_id": "9deb36df-3dec-3545-afa4-03e46c5368df",
                                                "text": "Exciter quelqu’un à boire, à manger."
                                            },
                                            {
                                                "example_id": "cc2aab49-c783-4509-a901-0257d14e4e35",
                                                "sense_id": "9deb36df-3dec-3545-afa4-03e46c5368df",
                                                "text": "Exciter au travail, à l’étude."
                                            },
                                            {
                                                "example_id": "757700a7-0b54-427d-87d7-225dfd58ebd3",
                                                "sense_id": "9deb36df-3dec-3545-afa4-03e46c5368df",
                                                "text": "L’exemple de ses ancêtres l’excite à se distinguer."
                                            },
                                            {
                                                "example_id": "fbaee0e1-a66f-4a94-af79-45d2ba7496d2",
                                                "sense_id": "9deb36df-3dec-3545-afa4-03e46c5368df",
                                                "text": "Exciter les peuples à la révolte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd7eaf55-b8db-3467-ae96-74a45910962f",
                                        "entry_id": "96ba6bf1-1a20-3345-aa6e-71fe946aa263",
                                        "glosses": [
                                            "Animer ; encourager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9554fd96-00dd-4d00-ac4a-d70d34d36ad6",
                                                "sense_id": "dd7eaf55-b8db-3467-ae96-74a45910962f",
                                                "text": "Tout de suite, Jean enraya, à la place où il avait dérayé la veille ; et, faisant mordre le soc, les mains aux mancherons de la charrue, il jeta à son cheval le cri rauque dont il l’excitait."
                                            },
                                            {
                                                "example_id": "6283f20a-3922-4e0b-88ae-0ef79fa04a2a",
                                                "sense_id": "dd7eaf55-b8db-3467-ae96-74a45910962f",
                                                "text": "Ce capitaine excitait ses soldats par ses discours et par son exemple."
                                            },
                                            {
                                                "example_id": "fbf64343-d103-4dff-b0b1-199bbc46a878",
                                                "sense_id": "dd7eaf55-b8db-3467-ae96-74a45910962f",
                                                "text": "Exciter les organes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a87a30-2515-32bb-a02d-9b2f2d023d73",
                                        "entry_id": "96ba6bf1-1a20-3345-aa6e-71fe946aa263",
                                        "glosses": [
                                            "Provoquer, causer ou faire naître une réaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31ab30cd-8cae-4900-9d6c-a48ce2c4b39f",
                                                "sense_id": "f2a87a30-2515-32bb-a02d-9b2f2d023d73",
                                                "text": "Sous la première République, au moment même où toute l’Europe nous tombait sur le dos, c'est les curés qui ont excité la guerre civile en Vendée, fanatisant les paysans, les menant au combat, et leur promettant le paradis s'ils étaient tués."
                                            },
                                            {
                                                "example_id": "9405a992-28d6-4954-bf37-b4e518b4c1d0",
                                                "sense_id": "f2a87a30-2515-32bb-a02d-9b2f2d023d73",
                                                "text": "Des créanciers qui réclament le remboursement de leurs dettes excitent toujours les rancœurs de leurs débiteurs."
                                            },
                                            {
                                                "example_id": "8266230a-45f4-4a07-8ca7-818ce55fbe50",
                                                "sense_id": "f2a87a30-2515-32bb-a02d-9b2f2d023d73",
                                                "text": "La glorieuse défense de Mazagran a excité, dans toute la France, des transports unanimes d'admiration. De toutes parts des souscriptions ont été spontanément ouvertes […]."
                                            },
                                            {
                                                "example_id": "19ef2f2b-f9d2-4d77-a445-cc4abcc1baa5",
                                                "sense_id": "f2a87a30-2515-32bb-a02d-9b2f2d023d73",
                                                "text": "Chose étrange, elles excitèrent la convoitise de Gaubertin qui, tout en se promettant de mettre les Aigues en pièces, se réserva dès lors, in petto, ce pavillon splendide."
                                            },
                                            {
                                                "example_id": "38b1aa8c-3f69-48f4-b3c0-e02a5cfb7d5a",
                                                "sense_id": "f2a87a30-2515-32bb-a02d-9b2f2d023d73",
                                                "text": "Exciter la pitié."
                                            },
                                            {
                                                "example_id": "31916e44-5f86-482f-b828-7bdf43cd588c",
                                                "sense_id": "f2a87a30-2515-32bb-a02d-9b2f2d023d73",
                                                "text": "Exciter l’envie, la jalousie."
                                            },
                                            {
                                                "example_id": "5265a53e-e8ef-4e5a-aa10-a9911b157e3e",
                                                "sense_id": "f2a87a30-2515-32bb-a02d-9b2f2d023d73",
                                                "text": "Exciter l’admiration, la curiosité."
                                            },
                                            {
                                                "example_id": "57ccc7e3-7c7c-4cfe-9532-3afd9ad03d35",
                                                "sense_id": "f2a87a30-2515-32bb-a02d-9b2f2d023d73",
                                                "text": "Cela ne fait qu’exciter son audace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e2bbd6-6fc9-3da4-b902-8c232e506b6b",
                                        "entry_id": "96ba6bf1-1a20-3345-aa6e-71fe946aa263",
                                        "glosses": [
                                            "Échauffer sexuellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0db2c870-30b3-43ac-81cc-575632d89643",
                                                "sense_id": "d8e2bbd6-6fc9-3da4-b902-8c232e506b6b",
                                                "text": "M’sieur le curé et la bonne, Mongénéral et la putain. Tu m'admires, je t’encense; tu m’excites, je t’enchose. C'est pas plus difficile que ça. C'était tout simple, en 1928."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e52fa2a-0984-4866-a65e-d062cee4b220",
                        "source_entry_id": "a9b21d9c-5c2d-309d-9297-a1e916b01eb9",
                        "source_sense_id": "f1a4f149-5d0a-316d-8064-1ec08ac828fd",
                        "target_lang_word": "troubler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troubler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b37f3e0-928c-3003-9dfd-0d2a6a9c36ab",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Rendre trouble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1816636b-f434-4a05-8214-a7f7980abf4a",
                                                "sense_id": "9b37f3e0-928c-3003-9dfd-0d2a6a9c36ab",
                                                "text": "Les pluies ont troublé la rivière."
                                            },
                                            {
                                                "example_id": "c6a165d9-174f-408c-916a-8853d73e62fc",
                                                "sense_id": "9b37f3e0-928c-3003-9dfd-0d2a6a9c36ab",
                                                "text": "Si vous remuez ce vin, vous le troublerez."
                                            },
                                            {
                                                "example_id": "2e63a059-4770-4b83-8bbe-79d30eea9d23",
                                                "sense_id": "9b37f3e0-928c-3003-9dfd-0d2a6a9c36ab",
                                                "text": "Troubler l’eau."
                                            },
                                            {
                                                "example_id": "42d0e179-2e0d-4667-bd17-00f5026ad5b4",
                                                "sense_id": "9b37f3e0-928c-3003-9dfd-0d2a6a9c36ab",
                                                "text": "Ce vin est sujet à se troubler."
                                            },
                                            {
                                                "example_id": "506d8e9f-4d87-4463-a44b-90b74e59a6c1",
                                                "sense_id": "9b37f3e0-928c-3003-9dfd-0d2a6a9c36ab",
                                                "text": "Je suis troublé car je ne vois plus rien"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ef608c7-b6a2-3230-bcf0-0e57acbb73ea",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Perdre de sa netteté, de sa clarté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9fae60c-44c0-4f54-acae-0b1750d4f792",
                                                "sense_id": "7ef608c7-b6a2-3230-bcf0-0e57acbb73ea",
                                                "text": "Le soleil pâlit au milieu de son cours, et l'azur du ciel, traversé de bandes verdâtres, semble se décomposer dans une lumière louche et troublée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c59e74e-5425-3ad3-9e79-f358a536cef5",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Causer une agitation désordonnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7d106f-1935-4642-8555-63123a036dbd",
                                                "sense_id": "2c59e74e-5425-3ad3-9e79-f358a536cef5",
                                                "text": "La tempête trouble l’atmosphère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef13b265-75bf-310a-a2a2-4b075256a501",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Perturber une fonction physiologique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43af74cc-cbf0-4baa-8f79-3c8919bbb575",
                                                "sense_id": "ef13b265-75bf-310a-a2a2-4b075256a501",
                                                "text": "Les rêves affreux qui troublent son sommeil."
                                            },
                                            {
                                                "example_id": "84f4bc82-fe2a-47df-94f8-433868fb612b",
                                                "sense_id": "ef13b265-75bf-310a-a2a2-4b075256a501",
                                                "text": "Cela trouble la digestion, les fonctions digestives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9585feb9-b3f9-3463-90e4-748d6c7a249b",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Perturber les sens, la raison et les facultés de l’âme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "248817ee-0d3b-4a8b-9b1d-273c9ac806f5",
                                                "sense_id": "9585feb9-b3f9-3463-90e4-748d6c7a249b",
                                                "text": "Troubler le jugement, l’esprit, la mémoire."
                                            },
                                            {
                                                "example_id": "be9ca9ac-f7d5-4a09-b383-9b22b5d76639",
                                                "sense_id": "9585feb9-b3f9-3463-90e4-748d6c7a249b",
                                                "text": "La peur lui trouble la raison."
                                            },
                                            {
                                                "example_id": "86ea765c-ae93-4972-a53b-adcec09b35e7",
                                                "sense_id": "9585feb9-b3f9-3463-90e4-748d6c7a249b",
                                                "text": "Le vin lui avait troublé la tête, la cervelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d781c5e-e824-3c9e-8aa4-351d8555d1d9",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Émouvoir."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfce63ff-816c-46e3-8cfe-3226a5069cf5",
                                                "sense_id": "6d781c5e-e824-3c9e-8aa4-351d8555d1d9",
                                                "text": "Quant aux « désespoir du peintre », la finesse des petites taches rouges sur le blanc des pétales m'attirait sans que jamais j'aie pu savoir pourquoi leur irréalité me troublait autant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db8eb366-91db-31c4-92b6-53127a0f6aaf",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "S’égarer, en parlant de l'esprit."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b79b4c28-d7db-4e0a-ae27-49f68da6b199",
                                                "sense_id": "db8eb366-91db-31c4-92b6-53127a0f6aaf",
                                                "text": "Son esprit se trouble, ses idées se confondent, et il éprouve une sorte d’égarement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65d764ab-b991-3f29-b97e-3e7e37e9d5bb",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Ôter sa présence d’esprit à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eee49ab-6e61-45b2-a162-c12f4c519abc",
                                                "sense_id": "65d764ab-b991-3f29-b97e-3e7e37e9d5bb",
                                                "text": "Ne faites pas tant de bruit, vous me troublez."
                                            },
                                            {
                                                "example_id": "2b4cbeb5-61e1-47c9-99da-2cc2e6e555b8",
                                                "sense_id": "65d764ab-b991-3f29-b97e-3e7e37e9d5bb",
                                                "text": "Trop de sévérité de la part du juge peut troubler un prévenu, un accusé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a48d361b-b48a-3ce9-a60b-3b6ad1f2bca0",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Inquiéter une personne dans la possession, dans la jouissance de quelque bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "666bf2b4-594d-48cf-9498-c15f9a2af2b3",
                                                "sense_id": "a48d361b-b48a-3ce9-a60b-3b6ad1f2bca0",
                                                "text": "Il a été troublé dans la possession de cette terre, dans la jouissance de sa propriété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29ea4d6b-7abf-3347-aa47-a69aafe87931",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Interrompre d’une manière désagréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bec70bc3-92a5-4d79-ace5-0ac4893a0dc9",
                                                "sense_id": "29ea4d6b-7abf-3347-aa47-a69aafe87931",
                                                "text": "Et puis le silence , ce grand silence qui plane au-dessus des solitudes islandaises , et que trouble seul le sifflement du vent ou le cri des pluviers dorés."
                                            },
                                            {
                                                "example_id": "212baa67-fa25-42eb-bb3e-160670e1b8a0",
                                                "sense_id": "29ea4d6b-7abf-3347-aa47-a69aafe87931",
                                                "text": "Invisible et sans rien troubler de ma présence, comme un Zeus vêtu d'air aux âges d'innocence, que ne puis-je « inspecter » le grand travail des champs !"
                                            },
                                            {
                                                "example_id": "5bf82664-0868-4743-9d5f-76cad60ea1ee",
                                                "sense_id": "29ea4d6b-7abf-3347-aa47-a69aafe87931",
                                                "text": "On peut même couper avec des ciseaux les deux antennes d'un Zygène sans troubler son repas, bien qu'une goutte de sang jaune vienne perler sur la surface de section."
                                            },
                                            {
                                                "example_id": "bac4646e-f6bd-4e64-8a86-3fadc8d3eacb",
                                                "sense_id": "29ea4d6b-7abf-3347-aa47-a69aafe87931",
                                                "text": "Il troubla leur tête-à-tête. — Un accident troubla la fête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfc18157-1170-308a-8452-a42bb078c8ef",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Apporter du trouble, du désordre ; causer de la mésintelligence ; perturber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2cd60d1-d426-4d33-b9a4-3c48555baf12",
                                                "sense_id": "dfc18157-1170-308a-8452-a42bb078c8ef",
                                                "text": "Ernestine passa trois années chez son maître, sans que rien troublât la paisible uniformité de sa vie."
                                            },
                                            {
                                                "example_id": "8fefcd7f-4cfd-4d2b-920c-c361c00df49e",
                                                "sense_id": "dfc18157-1170-308a-8452-a42bb078c8ef",
                                                "text": "L'administration romaine était extrêmement dure pour tout homme qui lui semblait susceptible de troubler la tranquillité publique."
                                            },
                                            {
                                                "example_id": "78ca483d-0ef7-4ec1-b346-9e384bb01759",
                                                "sense_id": "dfc18157-1170-308a-8452-a42bb078c8ef",
                                                "text": "De Bilma, par câble, nous apprenons que la situation se trouble là-bas. Les Toubbou menacent nos positions du Tibesti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0181d15f-b80f-3fef-a2b8-39efec94fed1",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Éprouver une émotion, un trouble qui fait qu’on s’embarrasse, qu’on ne sait plus que dire, que faire."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c49ce5c9-c1b1-4d59-9644-f808986d3923",
                                                "sense_id": "0181d15f-b80f-3fef-a2b8-39efec94fed1",
                                                "text": "Non, François ne se troublait pas. Cette jouvencelle aux yeux de paille mûre, cette blondeur capiteuse de la chevelure, cet arôme violent d'un corps en plein épanouissement, le remarquait-il ?"
                                            },
                                            {
                                                "example_id": "fcce38ac-f89d-4700-ae29-a5158f1254ad",
                                                "sense_id": "0181d15f-b80f-3fef-a2b8-39efec94fed1",
                                                "text": "L’orateur s’est troublé au milieu de son discours et n’a pu continuer."
                                            },
                                            {
                                                "example_id": "3cd184ad-f20c-41a0-a4a8-3a0cb2db3d1d",
                                                "sense_id": "0181d15f-b80f-3fef-a2b8-39efec94fed1",
                                                "text": "L’accusé s’est troublé dans son interrogatoire."
                                            },
                                            {
                                                "example_id": "8cbc900a-1c6f-431b-9959-4ecdc684ee73",
                                                "sense_id": "0181d15f-b80f-3fef-a2b8-39efec94fed1",
                                                "text": "Il s’est troublé et n’a pu répondre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd99384-4b4d-3745-9747-4ac655a1f32f",
                                        "entry_id": "ef706969-7dc5-3ecd-ae74-7b68db4f8f19",
                                        "glosses": [
                                            "Perdre de sa netteté, de sa précision, en parlant d'un sens ou de la mémoire"
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96c0d594-3d2d-4590-807c-0cbb0d7c6882",
                                                "sense_id": "8fd99384-4b4d-3745-9747-4ac655a1f32f",
                                                "text": "Sa mémoire se trouble."
                                            },
                                            {
                                                "example_id": "745c86ab-dee9-4ea5-b285-a2030f08d249",
                                                "sense_id": "8fd99384-4b4d-3745-9747-4ac655a1f32f",
                                                "text": "Mes yeux se troublent."
                                            },
                                            {
                                                "example_id": "4f12f8ed-a5a4-497e-9eec-20965f31566d",
                                                "sense_id": "8fd99384-4b4d-3745-9747-4ac655a1f32f",
                                                "text": "L’ouïe se trouble lorsqu’on injecte de l’air dans l’oreille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
