                        "cross_references": [
                            {
                                "target_word": "vuvuzela",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f7cc928-f4fe-3cba-adc3-60be6f7e47ff",
                                        "entry_id": "be60b53d-afcb-3c57-bcaf-d11197637023",
                                        "glosses": [
                                            "A trumpet-shaped horn, now usually plastic, that produces a loud buzzing sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df0bd89-b6a9-4b13-b53f-b11d0b3ce609",
                                                "sense_id": "1f7cc928-f4fe-3cba-adc3-60be6f7e47ff",
                                                "text": "When the Manchester United squad walked through the arrival gates at Durban International yesterday, most players heard a vuvuzela for the first time."
                                            },
                                            {
                                                "example_id": "f677ce6a-5f42-4824-ac26-1bca9554c60e",
                                                "sense_id": "1f7cc928-f4fe-3cba-adc3-60be6f7e47ff",
                                                "text": "I’m talking, of course, about the vuvuzela. Essentially, a metre-long blowhorn, which you may struggle to get past a steward at an English football ground."
                                            },
                                            {
                                                "example_id": "dbace0c4-f78b-4477-af04-3ea882a332a5",
                                                "sense_id": "1f7cc928-f4fe-3cba-adc3-60be6f7e47ff",
                                                "text": "For some, the vuvuzelas herald the country’s piercing emergence from the forced racial hush of apartheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
