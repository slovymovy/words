                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fd378e8-8656-341b-9e7d-5d307a961128",
                        "entry_id": "984d9db4-d8da-33be-bc02-33a2dc30c53a",
                        "glosses": [
                            "Unaffected by time; timeless; permanent or unchanging."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9bd14ad-01be-44f9-b241-d2a4f34d41b3",
                                "sense_id": "2fd378e8-8656-341b-9e7d-5d307a961128",
                                "text": "The machinery, when activated, would create atemporal bubbles wherein nothing was affected by the flow of time."
                            },
                            {
                                "example_id": "0927b570-d0ca-4440-9bed-635eefb51aff",
                                "sense_id": "2fd378e8-8656-341b-9e7d-5d307a961128",
                                "text": "The greatest music is atemporal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdcbf13d-799c-47c0-9170-6326c124aa57",
                        "source_entry_id": "984d9db4-d8da-33be-bc02-33a2dc30c53a",
                        "source_sense_id": "2fd378e8-8656-341b-9e7d-5d307a961128",
                        "source_sense_description": "unaffected by time",
                        "target_lang_word": "atemporel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atemporel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51420320-52b4-3ef9-8375-119f76004cbc",
                                        "entry_id": "492b71e7-bd91-33ef-9b8d-19fd5d6db2a7",
                                        "glosses": [
                                            "Qui ne s’inscrit pas dans le temps."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "801449a4-6237-4f3b-b4b5-b259df43ef46",
                                                "sense_id": "51420320-52b4-3ef9-8375-119f76004cbc",
                                                "text": "L’Écriture Sainte nous présente le Christ tantôt sous l’un, tantôt sous l’autre de ces deux points de vue, qu’on peut appeler temporel et atemporel."
                                            },
                                            {
                                                "example_id": "50f82eae-20f2-4d55-b4b2-5f237be9b8e0",
                                                "sense_id": "51420320-52b4-3ef9-8375-119f76004cbc",
                                                "text": "L'inconscient étant rigoureusement atemporel pour l’enfant et pour le vieillard, ce dernier se trouvera encombré d’un inconscient spatialement démesuré, ce qui est un non-sens : c’est la topique qui devient à son tour un espace hors espace, sans limites."
                                            },
                                            {
                                                "example_id": "399c066e-8852-4383-9f12-5934d01d78c0",
                                                "sense_id": "51420320-52b4-3ef9-8375-119f76004cbc",
                                                "text": "Au contraire, la liberté, l’émancipation, la réflexion, l’indépendance et l’ouverture d’esprit et les moyens qui les sous-tendent et permettent de les réaliser eux sont atemporels, agéographiques et asociaux, ou en tout cas visent à l’être."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84fb318-9b20-33e8-a6f2-9057ebe412a8",
                                        "entry_id": "492b71e7-bd91-33ef-9b8d-19fd5d6db2a7",
                                        "glosses": [
                                            "Qualifie une forme verbale énonçant un procès non daté, conçu comme indépendant de la durée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7935fbb9-9cb7-42c7-a34d-547f7effa056",
                                                "sense_id": "c84fb318-9b20-33e8-a6f2-9057ebe412a8",
                                                "text": "Les descriptions des Histoires Naturelles avec le temps du présent nous font sans doute penser au présent indéfini, général, au présent « atemporel » (Marouzeau, Précis, p. 108), mais avec une nuance."
                                            },
                                            {
                                                "example_id": "ab516fb1-eb61-4269-bc30-03392e1ba5c8",
                                                "sense_id": "c84fb318-9b20-33e8-a6f2-9057ebe412a8",
                                                "text": "L’exégèse juive oscille entre deux temps de la prophétie : un futur relativement proche, en tous cas antérieur au moment où l’exégète écrit ; un futur atemporel, temps eschatologique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd6fc40a-ae0c-42b0-9838-33914d0efa2e",
                        "source_entry_id": "984d9db4-d8da-33be-bc02-33a2dc30c53a",
