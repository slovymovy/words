                    "sense_id": "aac65c26-9472-39ef-93f4-fb1a560e64b1",
                    "sense_definition": "Blesser quelqu'un dans son amour-propre, le froisser ou le dépiter.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "froisser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est très susceptible et se <w>vexe</w> pour un rien lors des réunions.",
                            "target_lang_translations": {
                                "en": "He is very touchy and <w>gets offended</w> over nothing during meetings.",
                                "ru": "Он очень обидчивый и <w>обижается</w> по пустякам на совещаниях.",
                                "nl": "Hij is erg prikkelig en voelt zich tijdens vergaderingen om niets snel <w>beledigd</w>.",
                                "de": "Er ist sehr empfindlich und fühlt sich bei Besprechungen wegen jeder Kleinigkeit schnell <w>gekränkt</w>.",
                                "pl": "Jest bardzo drażliwy i <w>obraża się</w> o byle co podczas zebrań.",
                                "it": "È molto suscettibile e si <w>offende</w> per un nulla durante le riunioni.",
                                "cs": "Je velmi citlivý a <w>urazí</w> <w>se</w> pro každou maličkost na poradách.",
                                "tr": "Çok alıngandır ve toplantılarda en ufak bir şeye <w>gücenir</w>.",
                                "es": "Es muy susceptible y se <w>ofende</w> por cualquier tontería durante las reuniones.",
                                "zh": "他非常敏感，开会时为了一点小事就<w>生气</w>。"
                            }
                        },
                        {
                            "text": "Sans vouloir te <w>vexer</w>, ta proposition ne semble pas du tout adaptée à la situation.",
                            "target_lang_translations": {
                                "en": "Without meaning to <w>offend</w> you, your proposal doesn't seem at all suitable for the situation.",
                                "ru": "Не хочу тебя <w>обидеть</w>, но твоё предложение, похоже, совсем не подходит к ситуации.",
                                "nl": "Zonder je te willen <w>kwetsen</w>, lijkt je voorstel helemaal niet geschikt voor de situatie.",
                                "de": "Ohne dich <w>kränken</w> zu wollen, scheint dein Vorschlag überhaupt nicht zur Situation zu passen.",
                                "pl": "Nie chcę cię <w>urazić</w>, ale twoja propozycja w ogóle nie wydaje się odpowiednia do sytuacji.",
                                "it": "Senza volerti <w>offendere</w>, la tua proposta non sembra affatto adatta alla situazione.",
                                "cs": "Aniž bych tě chtěl <w>urazit</w>, tvůj návrh se k situaci vůbec nehodí.",
                                "tr": "Seni <w>gücendirmek</w> istemem, ama önerin duruma hiç uygun görünmüyor.",
                                "es": "Sin ánimo de <w>ofender</w>, tu propuesta no parece adecuada en absoluto para la situación.",
                                "zh": "我无意<w>冒犯</w>你，但你的提议似乎完全不适合当前的情况。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blesser",
                        "froisser",
                        "offenser"
                    ],
                    "antonyms": [
                        "flatter"
                    ],
                    "common_phrases": [
                        "se vexer pour un rien",
                        "sans vouloir te vexer"
                    ],
                    "target_lang_definitions": {
                        "en": "To hurt someone's pride, or to upset or annoy them.",
                        "ru": "Задевать чьё-либо самолюбие, огорчать или раздражать кого-либо.",
                        "nl": "Iemands eigenliefde aantasten, waardoor die persoon zich gekrenkt of geërgerd voelt.",
                        "de": "Jemandes Stolz oder Selbstwertgefühl verletzen, sodass die Person verärgert oder gekränkt reagiert.",
                        "pl": "Urazić czyjąś dumę, zranić czyjeś uczucia albo wywołać u kogoś irytację.",
                        "it": "Ferire l'amor proprio di qualcuno, urtandolo o irritandolo.",
                        "cs": "Zasáhnout něčí hrdost, zranit jeho sebeúctu nebo ho podráždit a rozzlobit.",
                        "tr": "Birinin gurur ve duygularını incitmek, onu gücendirmek ya da üzmek.",
                        "es": "Herir el amor propio de alguien, disgustarlo o molestarlo.",
                        "zh": "伤害某人的自尊心，使其感到受辱、不快或恼怒。"
                    },
