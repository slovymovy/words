                        "examples": [
                            {
                                "example_id": "9022a347-6a55-4fbd-8386-b85a8b3a80dc",
                                "sense_id": "d4ce5561-0ff7-39ef-9ef8-d6593ea9d2c9",
                                "text": "„Gordins Anstellung in Jerusalem fiel mit dem größten Projekt zusammen, das AMZIC je in Angriff nahm: der Gründung der Stadt Afula, die das urbane Zentrum des Jesreel-Tals werden sollte.“"
                            },
                            {
                                "example_id": "c9bde0f8-5f5c-4e6f-ba03-6dfb26c616c5",
                                "sense_id": "d4ce5561-0ff7-39ef-9ef8-d6593ea9d2c9",
                                "text": "„Nachdem Nasrallah auch den Beschuss weiter im Süden liegender Städte angekündigt hatte, schlug erstmals eine Fadschr-5-Rakete in der Nähe der Stadt Afula ein.“"
                            }
                        ],
