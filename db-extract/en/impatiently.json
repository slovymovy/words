                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impatiemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6937f2ff-4541-3a15-990d-c670001064c5",
                                        "entry_id": "fff9c002-1cd8-3033-b601-861a57890a7a",
                                        "glosses": [
                                            "Avec impatience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941cf915-18a6-47af-82b0-aef7b982d042",
                                                "sense_id": "6937f2ff-4541-3a15-990d-c670001064c5",
                                                "text": "Dédaigner ceux qui lui viennent faire leur cour [à un grand], ou attendre impatiemment qu’ils se retirent."
                                            },
                                            {
                                                "example_id": "a207da29-f499-4e24-a9e7-950998ace5df",
                                                "sense_id": "6937f2ff-4541-3a15-990d-c670001064c5",
                                                "text": "En général les habitants des parties septentrionales [de l’Écosse], plutôt subjugués qu’unis [à l’Angleterre], supportaient impatiemment cette réunion."
                                            },
                                            {
                                                "example_id": "23028c69-dc65-411a-94fb-a411175c80d1",
                                                "sense_id": "6937f2ff-4541-3a15-990d-c670001064c5",
                                                "text": "Le précepteur Albert attendait impatiemment dans une chambre voisine le retour de Bois-Guilbert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28f32569-1c6f-34e1-9905-8df4d9ed31f3",
                                        "entry_id": "fff9c002-1cd8-3033-b601-861a57890a7a",
                                        "glosses": [
                                            "Avec chagrin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa8b5a01-4c38-4a31-b7ef-cabc0fd06f7d",
                                                "sense_id": "28f32569-1c6f-34e1-9905-8df4d9ed31f3",
                                                "text": "Néron porta impatiemment la mort de Narcisse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
