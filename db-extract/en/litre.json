                                        "entry_id": "c7ca5135-d42f-3e0c-bad4-78907087a343",
                                        "glosses": [
                                            "metrisches Hohlmaß, SI-Einheit, von einem Kubikdezimeter (1 dm³ = 1/1000 m³), als Volumeneinheit meist bei Flüssigkeiten oder Gasen verwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a67e6a23-3439-4cf6-8a8f-573180640dbc",
                                                "sense_id": "264cf38c-85bb-3089-8d96-0c87f3b4ecf8",
                                                "text": "Sie kaufte Brot und ein[en] Liter Milch."
                                            },
                                            {
                                                "example_id": "8869737d-3098-49f8-b20b-1283c05ec08d",
                                                "sense_id": "264cf38c-85bb-3089-8d96-0c87f3b4ecf8",
                                                "text": "Das Auto hat einen Hubraum von 2,6 Litern."
                                            },
                                            {
                                                "example_id": "c7e9d967-f9ae-4467-8df9-43374938919c",
                                                "sense_id": "264cf38c-85bb-3089-8d96-0c87f3b4ecf8",
                                                "text": "„Dem Federgewicht-Franzosen gelang es als erstem Benziner, die Normverbrauchsmarke von vier Liter pro 100 Kilometer zu unterbieten.“"
                                            },
                                            {
                                                "example_id": "b51903d4-2069-4ff9-bcce-3ba0632b4fe0",
                                                "sense_id": "264cf38c-85bb-3089-8d96-0c87f3b4ecf8",
                                                "text": "„Als Alarmschwelle wurde eine Intensität des Starkregens von fünf Liter/Quadratmter [sic] in fünf Minuten festgelegt.“"
                                            },
                                            {
                                                "example_id": "f44df7f5-f872-4bc6-94d1-e7c6a04421c5",
                                                "sense_id": "264cf38c-85bb-3089-8d96-0c87f3b4ecf8",
                                                "text": "„»In der Atmosphäre macht es etwa zwei Millionstel aus«, erklärt Nisbet. In einer Millionen Liter Luft stecken demnach zwei Liter Methan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
