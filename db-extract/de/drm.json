                        "glosses": [
                            "Abkürzung für Digital Rights Management (digitale Rechteverwaltung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f30fef4f-bd0c-452f-823d-76f0bdafca8e",
                                "sense_id": "2ca14fc5-3c31-373c-9134-33f76ba83ef8",
                                "text": "Unter anderem wird DRM zum Schutz von digitalen Musikstücken verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ce8c61b5-5acc-375b-b0d2-d56407df4ca5",
                        "entry_id": "630cc882-0356-3ebb-8232-91d44c354d61",
                        "glosses": [
                            "Abkürzung für Digital Radio Mondiale (digitales Radio, Nachfolger von LW, MW, KW)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89f26e9a-b5c4-4b6a-ae2c-b24da75f58be",
                                "sense_id": "ce8c61b5-5acc-375b-b0d2-d56407df4ca5",
                                "text": "„Digital Radio Mondiale (DRM) nutzt als erster internationaler Rundfunkstandard den neuen MPEG-Audiocodec Extended HE-AAC (xHE-AAC).“"
                            },
                            {
                                "example_id": "6c556a03-2baa-4998-afdc-1701404cc861",
                                "sense_id": "ce8c61b5-5acc-375b-b0d2-d56407df4ca5",
                                "text": "„Digital Radio Mondiale (DRM) ist seit dem 16. Juni offiziell in Betrieb, und den Verlautbarungen des DRM-Konsortiums zufolge soll auch der engagierte Laie im Stande sein, Sendungen nach dem neuen Standard zu empfangen - prinzipiell zumindest.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
