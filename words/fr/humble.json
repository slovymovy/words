            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e894e929-2996-3d5b-9ea9-58d219419126",
                    "sense_definition": "Qui fait preuve d'humilité, qui ne s'enorgueillit pas et reste modeste.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré son immense succès, cet écrivain est resté très <w>humble</w> et accessible."
                        },
                        {
                            "text": "À mon <w>humble</w> avis, nous devrions examiner d'autres solutions avant de décider."
                        }
                    ],
                    "synonyms": [
                        "modeste",
                        "simple"
                    ],
                    "antonyms": [
                        "arrogant",
                        "orgueilleux",
                        "prétentieux"
                    ],
                    "common_phrases": [
