            {
                "entry_id": "cdec6d3f-222c-3561-9a17-ecddcbaf9d50",
                "word": "Doris",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "39e2bdda-e035-32e3-bb51-206584b5f7f6",
                        "entry_id": "cdec6d3f-222c-3561-9a17-ecddcbaf9d50",
                        "glosses": [
                            "Prénom épicène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9637cf17-492e-409a-ad71-54f1e6c998b0",
                                "sense_id": "39e2bdda-e035-32e3-bb51-206584b5f7f6",
                                "text": "Son père, Doris, travaillait pour la Banque Royale et ses nombreux déplacements ont obligé la famille à déménager un peu partout au Québec."
                            },
                            {
                                "example_id": "28238dc4-4b5b-4a9c-86f9-72cc9a621221",
                                "sense_id": "39e2bdda-e035-32e3-bb51-206584b5f7f6",
                                "text": "Doris Roberts."
                            },
                            {
                                "example_id": "8f576348-7292-45aa-bab0-b6ccc5abcbeb",
                                "sense_id": "39e2bdda-e035-32e3-bb51-206584b5f7f6",
                                "text": "Doris Lussier, écrivain et humoriste québécois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45d24461-13a6-4874-ac4b-d83af424d0f7",
