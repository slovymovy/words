                        "examples": [
                            {
                                "example_id": "7c930237-128e-44ad-8560-1e788dd378f7",
                                "sense_id": "7917844d-29c7-3775-9f9e-04d46526da95",
                                "text": "Es wurden mancherlei Köstlichkeiten serviert."
                            },
                            {
                                "example_id": "822e886e-4907-44cf-af2f-4f624e55b6f1",
                                "sense_id": "7917844d-29c7-3775-9f9e-04d46526da95",
                                "text": "Er hat noch mancherlei aufzuholen."
                            },
                            {
                                "example_id": "4a8115cb-4137-49c0-9b59-922f084323fb",
                                "sense_id": "7917844d-29c7-3775-9f9e-04d46526da95",
                                "text": "Das ist eine in mancherlei Hinsicht interessante Information."
