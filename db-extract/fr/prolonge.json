            {
                "entry_id": "e87dbbad-24c4-34b6-93e0-26764224d28f",
                "word": "prolonge",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "223e99f2-f65b-4c9e-8f0e-824f0fa18bb0",
                        "entry_id": "e87dbbad-24c4-34b6-93e0-26764224d28f",
                        "tags": [
                            "plural"
                        ],
