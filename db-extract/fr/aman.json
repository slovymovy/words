                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dd094c37-aeb7-43e7-9d6a-3b1c44ecb198",
                        "entry_id": "6ede3f4b-1efc-3aba-a33e-3fc6fab946b0",
                        "tags": [
