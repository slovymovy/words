                "senses": [
                    {
                        "sense_id": "6ef63eb1-a09d-3c88-a400-dc3370c15eab",
                        "entry_id": "8cb28444-1e72-3a8a-98d0-4ce713bfbcad",
                        "glosses": [
                            "Primula sleutelbloem, een bloem die vroeg in het voorjaar bloeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89195700-3b77-4efb-a8fc-b41ef77657af",
                                "sense_id": "6ef63eb1-a09d-3c88-a400-dc3370c15eab",
                                "text": "Tripodi's team heeft dus een sojaplant ontwikkeld die dankzij twee extra genen (afkomstig uit primula en uit een paddenstoel) stoffen (SDA) maakt die beter in de juiste omega-3 vetzuren worden omgezet, en die gekruist met de beste Roundup Ready soja. 'Het heeft ons 12 jaar gekost, maar het product is nu in fase vier, en vrijwel klaar voor de markt.'"
                            },
                            {
                                "example_id": "4a83cb88-7410-4d17-8ce3-e40570d44b19",
                                "sense_id": "6ef63eb1-a09d-3c88-a400-dc3370c15eab",
                                "text": "Inwisselbaar is het logo allerminst, meent de conrector. „Het is niet zomaar een plaatje.” In het logo komt het oude embleem terug van de sleutelbloem, de primula veris, met de kleuren purper, goud en groen. Purper voor vorstelijk gedrag. Goud voor het adellijke karakter. Groen voor de verwachting en de toekomst. De bloembladeren zijn getransformeerd tot menselijke figuren die vanuit de school de wereld met open armen tegemoet treden. En onder dat alles is nog altijd de negentig jaar oude lijfspreuk van de school te lezen: Het pad der rechtvaardigen is als de morgenglans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd6f21f4-6aab-4b81-b8fb-6210f6b04eb7",
                        "source_entry_id": "8cb28444-1e72-3a8a-98d0-4ce713bfbcad",
                        "source_sense_id": "6ef63eb1-a09d-3c88-a400-dc3370c15eab",
                        "source_sense_description": "Primula sleutelbloem, een bloem die vroeg in het voorjaar bloeit",
                        "target_lang_word": "Primel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Primel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50b2c1ac-8004-35bb-906c-ea99bb11ecbd",
                                        "entry_id": "a3e05892-32ec-3725-8709-1991e86edde3",
                                        "glosses": [
                                            "auf der Nordhalbkugel verbreitete, artenreiche, meist sommergrüne Pflanzengattung mit glockenförmigen Kelchblättern"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ff0fe8d-e3e0-4489-95fa-1cdb51812989",
                                                "sense_id": "50b2c1ac-8004-35bb-906c-ea99bb11ecbd",
                                                "text": "„Wählen Sie für die Primeln einen halbschattigen Standort.“"
                                            },
                                            {
                                                "example_id": "e7a72dff-004a-4aed-8412-f5ea9012d8cb",
                                                "sense_id": "50b2c1ac-8004-35bb-906c-ea99bb11ecbd",
                                                "text": "„Bei der Standortwahl für die Primeln im Freien sollte man sich an den Bedingungen orientieren, die die natürlichen Standorte der Wildarten bieten.“"
                                            },
                                            {
                                                "example_id": "dad47e37-6828-46e7-974c-b5886d721a97",
                                                "sense_id": "50b2c1ac-8004-35bb-906c-ea99bb11ecbd",
                                                "text": "„Ursprünglich hatten die Primeln ihren Platz in den Doppelfenstern, die vor mehr als 100 Jahren gerne gebaut wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "217c1dd4-e795-39d1-b821-4684c9c978c3",
                                        "entry_id": "a3e05892-32ec-3725-8709-1991e86edde3",
                                        "glosses": [
                                            "Vertreter der Pflanzengattung [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ceb1ddf-d4bc-4b60-b114-eb7137104aed",
                                                "sense_id": "217c1dd4-e795-39d1-b821-4684c9c978c3",
                                                "text": "„Ab Januar ist die Primel bereits im Handel zu finden, die Blütezeit beginnt im Februar und reicht bis ins Frühjahr hinein.“"
                                            },
                                            {
                                                "example_id": "3cda03ec-a98a-4799-a78b-890d7892df33",
                                                "sense_id": "217c1dd4-e795-39d1-b821-4684c9c978c3",
                                                "text": "„Seit die Primel den Gärtnern in die Hände fiel, ist ihre Vielfalt förmlich explodiert.“"
                                            },
                                            {
                                                "example_id": "54dadb00-80bb-4884-aaa0-e9979972b4be",
                                                "sense_id": "217c1dd4-e795-39d1-b821-4684c9c978c3",
                                                "text": "„An den Rändern blühten Primeln und Veilchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f49a1562-6fec-4756-8ea9-f6a208ec5c87",
                        "source_entry_id": "8cb28444-1e72-3a8a-98d0-4ce713bfbcad",
                        "source_sense_id": "6ef63eb1-a09d-3c88-a400-dc3370c15eab",
