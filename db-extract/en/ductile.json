                                "target_senses": [
                                    {
                                        "sense_id": "0266bb12-83be-342d-ab48-f813d7a929ab",
                                        "entry_id": "5a9d4a78-4c82-3cde-8993-b40f80c50ca9",
                                        "glosses": [
                                            "sich verformen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dcbdeb8-c99c-4fa5-a499-3ee7fac6174e",
                                                "sense_id": "0266bb12-83be-342d-ab48-f813d7a929ab",
                                                "text": "„Der beziehungsweise das Kaugummi ist eine leicht verformbare, meist süß, manchmal auch sauer schmeckende Masse, auf der man oft einige Stunden lang kauen kann, ohne dass sie zerfällt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
