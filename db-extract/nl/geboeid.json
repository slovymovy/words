                            {
                                "example_id": "e00c1c7e-76d5-4540-b092-a626cabba9cb",
                                "sense_id": "3c877f5c-e912-34d5-8e6e-bf3c16b39db0",
                                "text": "De geboeide gevangene is naar een andere gevangenis gebracht."
                            },
                            {
                                "example_id": "956c55ba-f7bc-496e-97aa-ee2d1463170b",
                                "sense_id": "3c877f5c-e912-34d5-8e6e-bf3c16b39db0",
                                "text": "Maar Harald? Ontvoerde landgenoten, geboeid bij een graf, neerschieten? Of hoe die rechtse partijgangers het in de praktijk ook aanpakten."
                            }
                        ]
                    }
