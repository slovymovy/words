                "senses": [
                    {
                        "sense_id": "627a3d27-b814-3714-93a9-92a29fec4f08",
                        "entry_id": "e8b21bbe-7bab-3833-8a9d-b5b78685ac68",
                        "glosses": [
                            "Puppenfigur im Verkehrstheater in der Rolle des Verführers und Gegenspielers des Verkehrskaspers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22eec525-a611-4828-bf5e-047627c436d1",
                                "sense_id": "627a3d27-b814-3714-93a9-92a29fec4f08",
                                "text": "„Als das Zebra in den Zirkus zurückgebracht wird, gehen Kasperl und Seppel zur Großmutter, die als Lotse arbeitet und die Kinder im Straßenverkehr beschützt. Keine leichte Aufgabe, denn der Verkehrsteufel versucht immer wieder, den Fußgängern Dummheiten einzureden und sie in Gefahr zu bringen.“"
                            },
                            {
                                "example_id": "be051d39-6e46-4bb7-a283-a0f4e25693e5",
                                "sense_id": "627a3d27-b814-3714-93a9-92a29fec4f08",
                                "text": "„Der Verkehrsteufel ist wieder in seinen Höllenschlund hinabgefahren, weil er keinen von uns verführen konnte.“"
                            },
                            {
                                "example_id": "0024dae3-037d-4070-a607-f6113ae1ff60",
                                "sense_id": "627a3d27-b814-3714-93a9-92a29fec4f08",
                                "text": "„Wider den Verkehrsteufel: Einen spannenden und lehrreichen Vormittag erlebten die 70 Vorschulkinder in Karlstadt mit Polizeioberkommissar Winfried Gehrig und den Abenteuern von Joscha und Charlotte.“"
                            },
                            {
                                "example_id": "6415755c-f734-4fb1-94e7-f1aad9c16e6d",
                                "sense_id": "627a3d27-b814-3714-93a9-92a29fec4f08",
                                "text": "„Die paar Meter weiter kannst du ruhig gehen, […] sonst holt dich der Verkehrsteufel, der treibt hier sein Unwesen.“"
                            },
                            {
                                "example_id": "96d8e076-dabd-4760-9c14-05a6ef8ea2d1",
                                "sense_id": "627a3d27-b814-3714-93a9-92a29fec4f08",
                                "text": "„Mit dem Spiel ‚Der Verkehrsteufel’ begann 1952 Hamanns Engagement in der Verkehrserziehung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
