                        "translation_id": "41d85aee-5bb6-44c6-9360-ef5bded7dd98",
                        "source_entry_id": "0f848397-b60f-3592-b487-ed046b650302",
                        "source_sense_id": "031c5100-569a-3f55-949e-7bb361deecd2",
                        "target_lang_word": "Neugotik",
