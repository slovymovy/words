                "senses": [
                    {
                        "sense_id": "0a96a7d1-89f0-317b-add4-7b56ea804bc0",
                        "entry_id": "55c4a5fe-14df-3953-b122-73ec844a3abc",
                        "glosses": [
                            "żeliwne kółko zakrywające otwór w płycie pieca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fff62c9-545e-4ae0-88d3-3b24a20c7b0f",
                                "sense_id": "0a96a7d1-89f0-317b-add4-7b56ea804bc0",
                                "text": "Płomyk lizał szczapki, strzelał przez krążki fajerek, osmalał brzuchaty czajnik."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fa188988-0b84-3366-a3dc-b79fd800188a",
                        "entry_id": "55c4a5fe-14df-3953-b122-73ec844a3abc",
                        "glosses": [
                            "przenośny piecyk"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d379d84-8d96-4d19-8098-8b739b230079",
                        "source_entry_id": "55c4a5fe-14df-3953-b122-73ec844a3abc",
                        "source_sense_id": "0a96a7d1-89f0-317b-add4-7b56ea804bc0",
                        "target_lang_word": "Herdring",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herdring",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "473b8e18-c968-33ed-8ade-aaa16d4f1fbe",
                                        "entry_id": "784ae74f-d12f-3610-9f51-23131c1d65d8",
                                        "glosses": [
                                            "Metallring, mit dem die offene Feuerfläche eines Herdes (zum Beispiel eines Kohleherdes) vergrößert oder verkleinert werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4f40d0a-0d5d-4254-bdf1-e1689a13c838",
                                                "sense_id": "473b8e18-c968-33ed-8ade-aaa16d4f1fbe",
                                                "text": "„Frau Mörschel schob die Pfanne beiseite und hantierte mit den Herdringen.“"
                                            },
                                            {
                                                "example_id": "e9ca57f1-b3c2-47b8-9e7b-699f1c1c8447",
                                                "sense_id": "473b8e18-c968-33ed-8ade-aaa16d4f1fbe",
                                                "text": "„Die Mutter ließ die Herdringe klappern, zaghafter als die Großmutter, aber immerhin.“"
                                            },
                                            {
                                                "example_id": "959b53bc-3541-4486-91f8-230fe9f9d009",
                                                "sense_id": "473b8e18-c968-33ed-8ade-aaa16d4f1fbe",
                                                "text": "„Eine Petroleumlampe hing in der Küche an dem Balken, und aus den Herdringen lohte die Glut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
