                "translations": [
                    {
                        "translation_id": "ff4112c6-d075-41be-b421-818aa28b9ef9",
                        "source_entry_id": "0249270f-90ef-388a-b8f7-6838183c188d",
                        "source_sense_id": "9b925d16-daf7-3028-b4ac-1adaa98fb1c0",
                        "target_lang_word": "parkán",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f0592581-b179-4b53-9db2-c448db55f764",
                        "source_entry_id": "0249270f-90ef-388a-b8f7-6838183c188d",
                        "source_sense_id": "9b925d16-daf7-3028-b4ac-1adaa98fb1c0",
                        "target_lang_word": "забор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "забор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "72c6b19a-37f4-3f96-a831-690f54072eb2",
                                        "entry_id": "2e74e2d7-85d9-3f16-bec9-131f2ca02749",
                                        "glosses": [
                                            "сооружение из досок, слег, планок, сетки, камня, кирпича, металлических стержней и т. п., ограждающее что-либо; ограда по периметру чего-либо (часто — высокая) [Даль]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9992e71-2be2-4435-8ac8-5d9188e91882",
                                                "sense_id": "72c6b19a-37f4-3f96-a831-690f54072eb2",
                                                "text": "Привязав лошадь у забора, он вошёл ко мне."
                                            },
                                            {
                                                "example_id": "1bd5e4b8-93e7-4df0-bb47-d33f3813876d",
                                                "sense_id": "72c6b19a-37f4-3f96-a831-690f54072eb2",
                                                "text": "Дотащи доску до забору, да кинь её там."
                                            },
                                            {
                                                "example_id": "f84bf1ec-d46e-486f-91bc-4e848c3e2cf5",
                                                "sense_id": "72c6b19a-37f4-3f96-a831-690f54072eb2",
                                                "text": "Новый мой знакомец повёл меня туда, и через господский двор, обнесённый частым забором, пришли мы к низенькому домику."
                                            },
                                            {
                                                "example_id": "42de1e85-7365-43a1-bd2b-1a72f8e59611",
                                                "sense_id": "72c6b19a-37f4-3f96-a831-690f54072eb2",
                                                "text": "Берёзки, которые при нём только что были посажены около забора, выросли и стали теперь высокими ветвистыми деревьями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffde2117-90f6-3eb7-be2a-a2bc66f707a0",
                                        "entry_id": "2e74e2d7-85d9-3f16-bec9-131f2ca02749",
                                        "glosses": [
                                            "спорт. высотно-широтное препятствие в конно-спортивных соревнованиях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04283b80-f157-44ba-a8ae-879720d89a94",
                                                "sense_id": "ffde2117-90f6-3eb7-be2a-a2bc66f707a0",
                                                "text": "А вот конь прыгает через забор. Седок низко наклонился вперёд, — так коню легче прыгать."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "забор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "081256c2-0e8c-38dc-8bde-d8d2718c8c07",
                                        "entry_id": "bdbf9f5a-09bb-320d-907f-2432250f6125",
                                        "glosses": [
                                            "действие по значению гл. забирать, забрать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5ab2b0f-772f-40d3-90a7-7e47127d88d6",
                                                "sense_id": "081256c2-0e8c-38dc-8bde-d8d2718c8c07",
                                                "text": "В тех случаях, когда забор воды осуществляется из озера или реки, которые находятся на значительном удалении от дома, и требуется большой напор, можно применить скважинный насос.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e4c00e2-6882-3f2c-ace3-229117474ad1",
                                        "entry_id": "bdbf9f5a-09bb-320d-907f-2432250f6125",
                                        "glosses": [
                                            "геол., мед., биохим. извлечение небольшого количества минералов, жидкостей и т. п. для исследования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c91b112-be57-41fd-8df9-d75d96e09d70",
                                                "sense_id": "9e4c00e2-6882-3f2c-ace3-229117474ad1",
                                                "text": "Утром провели эксперимент «Эритроцит» — забор крови из пальца в пробирки для возвращения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "007f4bda-3fb7-372d-9c79-90fa8114c786",
                                        "entry_id": "bdbf9f5a-09bb-320d-907f-2432250f6125",
                                        "glosses": [
                                            "мед. извлечение внутренних органов для пересадки или исследования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79bdd790-a074-49e7-a8f6-45c66d277df7",
                                                "sense_id": "007f4bda-3fb7-372d-9c79-90fa8114c786",
                                                "text": "Надо уточнить: во многих странах на забор органов тоже требуется согласие родственников."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1916bd10-5f8f-38e0-bcae-dcb9f4e9cb16",
                                        "entry_id": "bdbf9f5a-09bb-320d-907f-2432250f6125",
                                        "glosses": [
                                            "устар. приобретение товаров по безналичному расчёту или в долг с последующей оплатой."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbe5ffe3-8d6e-4e45-8d90-79ea71112124",
                                                "sense_id": "1916bd10-5f8f-38e0-bcae-dcb9f4e9cb16",
                                                "text": "По окончании месяца, являясь в контору за получением денег, они получают записки, разрешающие им забор в заводской лавке на заработанную сумму, а деньгами — ни копейки."
                                            },
                                            {
                                                "example_id": "8515f277-9a7d-42c4-8c86-53ddee0480d3",
                                                "sense_id": "1916bd10-5f8f-38e0-bcae-dcb9f4e9cb16",
                                                "text": "Расчёт происходил по субботам в конторе, с вычетом забора в лавке."
                                            }
                                        ]
                                    }
                                ]
                            },
