                "senses": [
                    {
                        "sense_id": "be5329cf-7f9e-342e-86d0-62c4ef9a6a9f",
                        "entry_id": "d8552656-0e76-3822-bfe2-38c81f1ec6fd",
                        "glosses": [
                            "Wagen in einem Personenzug, der für einen anderen Zielort bestimmt ist als der Zug, zu dem er zunächst gehört"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "e49808df-1838-49cd-ad57-924b69849190",
                                "sense_id": "be5329cf-7f9e-342e-86d0-62c4ef9a6a9f",
                                "text": "Bei einem Zug, der Kurswagen mitführt, muss man aufpassen, dass man nicht im falschen Waggon landet und dadurch sein Ziel verfehlt."
                            },
                            {
                                "example_id": "6c5a80d6-2f60-4975-8127-eee073a14828",
                                "sense_id": "be5329cf-7f9e-342e-86d0-62c4ef9a6a9f",
                                "text": "„Zum Einsatz kommt der rauchende Veteran vor den Kurswagen der IC-Züge 2074 (aus Dresden–Hamburg), 2171 (nach Hamburg–Frankfurt) und 2310 (aus Frankfurt–Köln–Hamburg).“"
                            },
                            {
                                "example_id": "31406a84-6f12-4f87-8776-614a0da8cbb4",
                                "sense_id": "be5329cf-7f9e-342e-86d0-62c4ef9a6a9f",
                                "text": "„Unser Kurswagen war nicht stark besetzt, aber die anderen Wagen waren sehr voll.“"
                            },
                            {
                                "example_id": "5aa0d222-873b-4e3a-bf60-e8a12e959264",
                                "sense_id": "be5329cf-7f9e-342e-86d0-62c4ef9a6a9f",
                                "text": "„Bis zwei Uhr morgens musste er warten, bis der Kurswagen aus Den Haag ankam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
