                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nevermore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b538900d-f83d-3aeb-80a6-9c6199fb2f0e",
                                        "entry_id": "ceb7ccd5-4a87-32e3-9a0b-2c4008d035ce",
                                        "glosses": [
                                            "Never again."
                                        ],
                                        "tags": [
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9cabe24-c462-467c-a86b-4055c0168caa",
                                                "sense_id": "b538900d-f83d-3aeb-80a6-9c6199fb2f0e",
                                                "text": "And my soul from out that shadow that lies floating on the floor\n Shall be lifted—nevermore!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "611f8d3f-e64d-499b-8979-1508c8df5033",
                        "source_entry_id": "2286ed77-4a36-3c99-aa2c-957935654ee7",
                        "source_sense_id": "45fcdf50-1bf3-3c90-95e1-c0b7301b10d0",
                        "source_sense_description": "geen enkele keer; nooit meer",
                        "target_lang_word": "never",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "never",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                        "entry_id": "e92bab11-f545-3a1d-b9c6-b9d91325f67c",
                                        "glosses": [
                                            "At no time; on no occasion; in no circumstance."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d3dc271-8ba3-402b-9c25-ec6d42fe8663",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "I finally finished, and I never do wanna do it again."
                                            },
                                            {
                                                "example_id": "7eb84767-e693-4e2b-b218-d9662c591c03",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "We were at the same college, but happened never to meet."
                                            },
                                            {
                                                "example_id": "eac52bb3-1dfb-4d8f-99a7-521ac4f9727f",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "I'll never not like you."
                                            },
                                            {
                                                "example_id": "5d56e62e-970c-47e5-8830-81dc94a2ad19",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "Why should I love this Gentleman? Tis odds / He never will affect me;"
                                            },
                                            {
                                                "example_id": "8f878594-0075-4ea4-a675-3ea46321fae2",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            },
                                            {
                                                "example_id": "194a4f51-a514-43f8-b862-75149774953d",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "\"I never thought you were so fond of Mr. Phillips that you'd require two handkerchiefs to dry your tears just because he was going away,\" said Marilla."
                                            },
                                            {
                                                "example_id": "e4e844e1-03c0-4c32-8ec1-db02d35cd330",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "Never speak of the symptoms of your patient in his presence, unless questioned by the doctor, whose orders you are always to obey implicitly."
                                            },
                                            {
                                                "example_id": "eccacf82-3594-4247-a345-26baec99a048",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "\"You don't believe the Soviet Union is going to reduce its defense budget, do you?\" Boggs asked.\nPremier Chou didn't wait for the translator to finish. \"Never, never, never,\" he replied in perfect English."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37f4e3af-6948-3d27-b228-79bc6eec21da",
                                        "entry_id": "e92bab11-f545-3a1d-b9c6-b9d91325f67c",
                                        "glosses": [
                                            "Not at any other time; not on any other occasion; not previously."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45cace57-6971-405c-bb8c-b94380566cf3",
                                                "sense_id": "37f4e3af-6948-3d27-b228-79bc6eec21da",
                                                "text": "There is no jewel, be it of never so rich a price, which I set before this jewel: I mean your love."
                                            },
                                            {
                                                "example_id": "087214b7-23df-4be4-b930-d45ee349aa84",
                                                "sense_id": "37f4e3af-6948-3d27-b228-79bc6eec21da",
                                                "text": "\"He is just what a young man ought to be,\" said she, \"sensible, good-humoured, lively; and I never saw such happy manners!--so much ease, with such perfect good breeding!\""
                                            },
                                            {
                                                "example_id": "ca84eb67-55d8-4588-84f9-1d275b4fcef6",
                                                "sense_id": "37f4e3af-6948-3d27-b228-79bc6eec21da",
                                                "text": "1908, Lucy Maud Montgomery, Anne of Green Gables, Chapter XIII: The Delights of Anticipation,\nI never saw such an infatuated man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304c1e91-723a-37ab-8e63-123088fde291",
                                        "entry_id": "e92bab11-f545-3a1d-b9c6-b9d91325f67c",
                                        "glosses": [
                                            "Negative particle (used to negate verbs in the simple past tense; also used absolutely)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54d40e00-d5fd-4b5d-838b-e7ff84231337",
                                                "sense_id": "304c1e91-723a-37ab-8e63-123088fde291",
                                                "text": "The police say I stole the car, but I never did it."
                                            },
                                            {
                                                "example_id": "7bebde1c-c551-4888-a1e3-8245559a932c",
                                                "sense_id": "304c1e91-723a-37ab-8e63-123088fde291",
                                                "text": "You said you were going to mow the lawn today. – I never!"
                                            },
                                            {
                                                "example_id": "3f3e3876-bc92-4842-bc6d-c886bbf80b7b",
                                                "sense_id": "304c1e91-723a-37ab-8e63-123088fde291",
                                                "text": "\"You're never going to break in?\"\n\"This instant, if you'll, help me; in five or ten minutes, if you won't.\""
                                            },
                                            {
                                                "example_id": "55c71787-b90d-44da-99d8-d3c62c643286",
                                                "sense_id": "304c1e91-723a-37ab-8e63-123088fde291",
                                                "text": "Well I looked at Jay and I said \"hey, did you hear what I just heard?\"\nHe nodded his head and his face turned red and he never said a word"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "never",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60e9d419-b132-33b9-a552-fd6572944f9a",
                                        "entry_id": "3a9bf5b9-2d13-3a29-bf7e-433d6e15baa4",
                                        "glosses": [
                                            "Did not; didn't."
                                        ],
                                        "tags": [
                                            "Manglish",
                                            "Singlish",
                                            "auxiliary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca2b07f-124e-4981-bb44-da7ed533f472",
                                                "sense_id": "60e9d419-b132-33b9-a552-fd6572944f9a",
                                                "text": "I told him to go to Woodlands to buy durian for me. He came back and said no durian. But he some more said-ah, he got see people selling durian in Bukit Timah. I ask him-ah. Why you never buy from Bukit Timah."
                                            },
                                            {
                                                "example_id": "c89a0e02-c659-4448-aa3e-ad945e42168e",
                                                "sense_id": "60e9d419-b132-33b9-a552-fd6572944f9a",
                                                "text": "That's what he said. But I never see anything. Maybe it's an invisible dog. Or very good at hiding."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "never",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e218272-1c0c-3463-adfa-c7e842f086f3",
                                        "entry_id": "d2b63603-15d6-3d2e-a2d8-229038f6d5af",
                                        "glosses": [
                                            "A statement of defiance"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "360c2ac8-88bb-42c8-a57a-a11a7ed1da2b",
                                                "sense_id": "1e218272-1c0c-3463-adfa-c7e842f086f3",
                                                "text": "‘Guess what, I've won the pools!’ ‘Never!’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
