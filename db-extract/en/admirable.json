                        "source_entry_id": "d070268b-f6b1-3642-8c55-6d08efc1ccb8",
                        "source_sense_description": "deserving of the highest esteem or admiration",
                        "target_lang_word": "bewonderenswaardig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bewonderenswaardig",
