                            {
                                "example_id": "f566a8c1-0cc8-4c45-9616-d1e8f81ab8af",
                                "sense_id": "542e6ccc-c7c0-3d49-935e-d33136323def",
                                "text": "L'applicateur et le coussin éponge agissent en association pour répartir la crème de façon homogène et “retexturiser” votre peau."
                            },
                            {
                                "example_id": "f36dcf1b-ad8a-453c-b8cd-ecb667903df7",
                                "sense_id": "542e6ccc-c7c0-3d49-935e-d33136323def",
                                "text": "Une formule unique, ultralégère, resserre les pores et retexturise la peau pour révéler une peau plus lisse, d'apparence plus jeune."
                            }
                        ]
