                    },
                    {
                        "translation_id": "07efb924-8a7d-4bd3-ab36-e1902760b0e2",
                        "source_entry_id": "3d62a7fb-5b1b-38bb-b09a-a94643832c1a",
                        "source_sense_id": "9d4539fb-6472-3f6f-8a24-067dbf8c64a4",
                        "target_lang_word": "cirrosis",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cirrosis",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e46dad45-83b6-378b-b429-e0527d02a45d",
                                        "entry_id": "e2fcfbba-7846-3232-805c-1802ab1622b0",
                                        "glosses": [
                                            "Destrucción del hígado con formación de tejido fibroso y nódulos. Es una enfermedad irreversible que se da sobre todo entre los alcohólicos y los enfermos de hepatitis."
                                        ],
                                        "tags": [
                                            "Enfermedades"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d74b0a54-01fc-4e37-81c2-93549f8b116f",
                                                "sense_id": "e46dad45-83b6-378b-b429-e0527d02a45d",
                                                "text": "«Las muertes por cirrosis constituyen un índice de grado de alcoholismo de la población»."
                                            },
                                            {
                                                "example_id": "d9be7a2b-a5f4-4904-9e9b-f3c8aa14f8d1",
                                                "sense_id": "e46dad45-83b6-378b-b429-e0527d02a45d",
                                                "text": "«Todos los muertos acuden ahora a mi memoria: mi padre, que murió de cirrosis sin haber probado el vino y sin fumar»."
                                            },
                                            {
                                                "example_id": "71dbb503-d3e3-4ecc-9152-655d820fe7aa",
                                                "sense_id": "e46dad45-83b6-378b-b429-e0527d02a45d",
                                                "text": "«Tal es la situación de la muerte por cirrosis hepática (cuadro 15), en la que México ocupa el segundo lugar en América, inmediatamente después de las Bahamas»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a86d227-704e-474e-9221-d1fcd29cad71",
                        "source_entry_id": "3d62a7fb-5b1b-38bb-b09a-a94643832c1a",
                        "source_sense_id": "9d4539fb-6472-3f6f-8a24-067dbf8c64a4",
                        "target_lang_word": "Zirrhose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zirrhose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e528a603-9bc0-3a31-9827-22cc625b8a39",
                                        "entry_id": "f6159544-6225-34f8-a495-2d35764df1e4",
                                        "glosses": [
                                            "chronische Wucherung von Bindegewebe in einem Körperorgan, die zur Verhärtung und Schrumpfung des Organs führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2631b172-5fec-4b52-a8ec-48bbfc79db8e",
                                                "sense_id": "e528a603-9bc0-3a31-9827-22cc625b8a39",
                                                "text": "Nach ihren Angaben ist der Inhaftierte, der an einer Zirrhose leidet, nach wie vor geschwächt."
                                            },
                                            {
                                                "example_id": "27838fa3-7c94-4729-9f19-82038b59cf31",
                                                "sense_id": "e528a603-9bc0-3a31-9827-22cc625b8a39",
                                                "text": "Penner: \"Handelt es sich um eine unkomplizierte Zirrhose, kann man sie mit Medikamenten ganz gut in den Griff bekommen, ansonsten ist eine Lebertransplantation nicht zu umgehen.\""
                                            },
                                            {
                                                "example_id": "ae3da4f8-cc51-4ed0-919c-4032bc296116",
                                                "sense_id": "e528a603-9bc0-3a31-9827-22cc625b8a39",
                                                "text": "Durch vier bis acht Wochen absolute Abstinenz kann sich die Fettleber wieder zurückbilden. Ansonsten kommt irgendwann eine Entzündung hinzu, bis schließlich nach ein paar Jahren eine Zirrhose die Leber funktionsunfähig macht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
