                ],
                "senses": [
                    {
                        "sense_id": "2cb84a23-0375-3b1a-887b-d0c609a7d362",
                        "entry_id": "ac41e886-b716-3207-b6ca-63a8751fe9fb",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9c1b286-6486-4a5d-b087-d83f63ce53a9",
                                "sense_id": "2cb84a23-0375-3b1a-887b-d0c609a7d362",
                                "text": "Frau Fränckle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4e8d5075-fe7f-44d7-9b1f-2eca92ebbe0a",
                                "sense_id": "2cb84a23-0375-3b1a-887b-d0c609a7d362",
                                "text": "Herr Fränckle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bd7539fe-0591-4190-9a1a-2c668bc4a3b1",
                                "sense_id": "2cb84a23-0375-3b1a-887b-d0c609a7d362",
                                "text": "Die Fränckles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2c3734eb-e6af-4eef-8a0f-d45f19147c22",
                                "sense_id": "2cb84a23-0375-3b1a-887b-d0c609a7d362",
                                "text": "Der Fränckle trägt nie die Schals, die die Fränckle ihm strickt."
                            },
                            {
                                "example_id": "1134ce7f-cea7-450b-abb6-91175f558f07",
                                "sense_id": "2cb84a23-0375-3b1a-887b-d0c609a7d362",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fränckle kommt, geht der Herr Fränckle.“"
                            },
                            {
                                "example_id": "7752ee31-d4d5-4534-bd44-00a0b234fbce",
                                "sense_id": "2cb84a23-0375-3b1a-887b-d0c609a7d362",
                                "text": "Fränckle kommt und geht."
                            },
                            {
                                "example_id": "705411e8-48f4-4caf-9c96-c60b96381815",
                                "sense_id": "2cb84a23-0375-3b1a-887b-d0c609a7d362",
                                "text": "Fränckles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
