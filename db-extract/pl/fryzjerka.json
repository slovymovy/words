                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f2b4b11-40db-4af9-84f5-05282b88988b",
                                "sense_id": "8277e88a-ccf7-33e4-9d17-dc891eeab840",
                                "text": "Fryzjerka zrobiła mi trwałą, ale trochę ją przypaliła."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d38866f3-59a6-3f82-b4d9-5d0e3d0b971f",
                        "entry_id": "7d1e3d9a-a425-389c-a13f-67619cfe07f1",
