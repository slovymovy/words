                        "glosses": [
                            "Spécialiste de la céramologie."
                        ],
                        "tags": [
                            "Céramique"
                        ],
                        "examples": [
                            {
                                "example_id": "7d5972dc-b525-46d5-8ba1-c8f38229e5f9",
                                "sense_id": "1d95c2ea-2d19-320b-8b2f-f713159f5070",
                                "text": "Les céramologues pensent à un transport conjoint de productions de plusieurs ateliers de potiers du centre de la Gaule, de La Garaufesenque et de Lyon, et émettent l’hypothèse de leur regroupement en entrepôt à Lyon, avant leur rediffusion pour commercialisation vers tout le nord de la Gaule."
                            },
                            {
                                "example_id": "dc5aadd1-fc68-4480-8cd9-1730e55f5a34",
                                "sense_id": "1d95c2ea-2d19-320b-8b2f-f713159f5070",
                                "text": "Même si le nombre de spécialistes s’est sensiblement accru ces dernières années, le céramologue médiéviste reste une denrée rare dans la communauté scientifique."
                            }
                        ]
                    }
