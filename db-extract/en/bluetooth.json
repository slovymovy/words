                "senses": [
                    {
                        "sense_id": "cd9dfb15-e7d4-343b-9379-48dc6ff37d5a",
                        "entry_id": "ec150929-12a9-3bed-996b-82649428da30",
                        "glosses": [
                            "Alternative letter-case form of Bluetooth."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d7ed91fa-88e7-495e-9754-3899da83fa61",
                                "sense_id": "cd9dfb15-e7d4-343b-9379-48dc6ff37d5a",
                                "text": "Everyone’s bluetoothing each other the latest ring tones and pictures."
                            },
                            {
                                "example_id": "30ee31a8-a3b5-4514-a974-531ac48eec10",
                                "sense_id": "cd9dfb15-e7d4-343b-9379-48dc6ff37d5a",
                                "text": "If someone heard this, it was not merely a case of bluetoothing the song across, you had to go to the ringtone creator on your phone, edit the tune and then write down the instructions, in the form of key presses for your mate."
                            },
                            {
                                "example_id": "cc4035a4-d80f-4ec3-93cb-5202e63a69fb",
                                "sense_id": "cd9dfb15-e7d4-343b-9379-48dc6ff37d5a",
                                "text": "Monitors were hooked up and they updated the patient’s vitals every five second, which were then bluetoothed to a large interactive smart board on the near wall in letters big enough for everyone to read easily."
                            }
                        ]
                    }
