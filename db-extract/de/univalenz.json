                "senses": [
                    {
                        "sense_id": "a5cd8e8b-a6e1-3502-9078-7573f0ebda5e",
                        "entry_id": "18d43082-577e-356a-9c2f-83e5bde57f40",
                        "glosses": [
                            "Eigenschaft, nur eine Deutung zuzulassen; Eindeutigkeit"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "02b0308d-6e27-48c0-9815-48e28c80f16b",
                                "sense_id": "a5cd8e8b-a6e1-3502-9078-7573f0ebda5e",
                                "text": "„Da jedoch ein schmaler Grat zwischen der erfolgreichen Umwandlung von Ambivalenz hin zur positiven oder negativen Univalenz besteht, sind weitere Forschungsarbeiten zu diesem Thema unabdingbar.“"
                            },
                            {
                                "example_id": "9a453b8f-52f3-41bd-b731-b3fdbe40cab8",
                                "sense_id": "a5cd8e8b-a6e1-3502-9078-7573f0ebda5e",
                                "text": "„Ziel all dieser Krisen- und Konfliktarbeit in der Ambivalenzphase eines Paares mit Trennungsthemen ist die Univalenz, die Eindeutigkeit und die Übernahme der Eigenverantwortlichkeit.“"
                            },
                            {
                                "example_id": "bef9cd63-c25a-4a26-a46b-908084a510d7",
                                "sense_id": "a5cd8e8b-a6e1-3502-9078-7573f0ebda5e",
                                "text": "„Für ihn handelte es sich auch darum, sein Publikum von der Univalenz seiner Vision zu überzeugen.“"
                            },
                            {
                                "example_id": "9498aa82-21a9-4b17-a15a-aad01e715661",
                                "sense_id": "a5cd8e8b-a6e1-3502-9078-7573f0ebda5e",
                                "text": "„In Abhängigkeit vom gesellschaftlichen Ausmaß an Ambivalenz können Vergesellschaftungsprozesse tendenziell auf die Herstellung von Univalenz oder auf die Herstellung von Ambivalenz angelegt sein.“"
                            },
                            {
                                "example_id": "17f4847e-0207-45c8-af78-37a80df46e05",
                                "sense_id": "a5cd8e8b-a6e1-3502-9078-7573f0ebda5e",
                                "text": "„Anfangs mehrdeutige Symptome erhielten nach dem Auftreten weiterer Merkmale Univalenz, zunächst unvereinbare Zeichen konnten nach Auftreten besonderer Anhaltspunkte zugeordnet werden.“"
                            },
                            {
                                "example_id": "2814fc1e-7061-4fdb-8ab3-bd1a2a78e978",
                                "sense_id": "a5cd8e8b-a6e1-3502-9078-7573f0ebda5e",
                                "text": "„Das Ziel ist nun einmal die Höherhebung alles irdisch Zwiegestaltigen zu Gottes Eindeutigkeit und emotionalaffektiver Univalenz, zur himmlischen ‚sancta simplicitas‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "304c9101-316a-34f7-badf-b6c77f3dce83",
                        "entry_id": "18d43082-577e-356a-9c2f-83e5bde57f40",
                        "glosses": [
                            "Eigenschaft, nur mit einem anderen Atom eine chemische Bindung einzugehen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "af05d3c0-188e-43da-949b-28c753adc751",
                                "sense_id": "304c9101-316a-34f7-badf-b6c77f3dce83",
                                "text": "„Die Verf. führen aus, daß die nach dem entworfenen Strukturbilder des NaCl und KCl nicht mit den bisherigen Ansichten über die chemische Valenz vereinbar sind und konstruieren eine Raumgitteranordnung für NaCl, welche die Univalenz von Na und Cl veranschaulicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
