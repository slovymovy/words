                        "entry_id": "4cd9be3e-b6d1-3e28-aed0-b326c6640bfb",
                        "glosses": [
                            "Qui est la conséquence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae6dcc1f-7b0b-438f-83ba-59482ae70a2c",
                                "sense_id": "ba5d233d-dc35-3fc2-97f2-b9b63f390f11",
                                "text": "La Spécialité consiste à voir les choses du monde matériel aussi bien que celles du monde spirituel dans leurs ramifications originelles et conséquentielles."
                            },
                            {
                                "example_id": "31b915df-aa2d-4747-bb68-45d75df48ec5",
                                "sense_id": "ba5d233d-dc35-3fc2-97f2-b9b63f390f11",
                                "text": "Les nouvelles créances indirectes ou conséquentielles, s’il est permis de s’exprimer ainsi, ne seront en aucune façon soumises à l’arbitrage [de Genève]."
                            }
                        ]
                    }
