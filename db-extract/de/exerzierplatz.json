                "senses": [
                    {
                        "sense_id": "f496f235-0cb5-3682-b90b-0e525709a372",
                        "entry_id": "38727e2e-9e29-3d76-a9f3-26f187d79648",
                        "glosses": [
                            "Fläche zur Durchführung militärischer Übungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb9c9070-de7e-4e8e-a4f3-396a4ca5add9",
                                "sense_id": "f496f235-0cb5-3682-b90b-0e525709a372",
                                "text": "„Am Nachmittag des 25. Juni bombardierte die CIA den Exerzierplatz des größten Militärlagers in Guatemala-Stadt.“"
                            },
                            {
                                "example_id": "de12e563-3ee8-4574-b712-5b53a1100473",
                                "sense_id": "f496f235-0cb5-3682-b90b-0e525709a372",
                                "text": "„An der Nordseite des Exerzierplatzes befanden sich ein Unteroffiziersfamilienhaus sowie die noch heute bestehende Exerzierhalle.“"
                            },
                            {
                                "example_id": "afd5ad12-de1a-48ae-a1dc-5227315fc0ab",
                                "sense_id": "f496f235-0cb5-3682-b90b-0e525709a372",
                                "text": "„Der Exerzierplatz war voll von weißem Licht, als läge Schnee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
