                        "examples": [
                            {
                                "example_id": "d999ac0b-6abd-46d0-ad0e-167004af3995",
                                "sense_id": "7074af23-1a15-34d6-99e4-193705b4a7ec",
                                "text": "Some of green Boughs their slender Cabbins frame, / Some lodged were Tortoſa's streets about, / Of all the Hoſt the Chief of Worth and Name / Aſſembled been, a Senate grave and ſtout;"
                            },
                            {
                                "example_id": "cca79415-bf1b-400e-b561-1a61829d3962",
                                "sense_id": "7074af23-1a15-34d6-99e4-193705b4a7ec",
                                "text": "My love is fair, my love is gay, / As fresh as been the flowers in May;"
                            },
                            {
                                "example_id": "aefd690a-d279-4350-a5b8-e85ac0910012",
                                "sense_id": "7074af23-1a15-34d6-99e4-193705b4a7ec",
                                "text": "Theſe Beaſtes been of higheſt Regard and Price / To pleaſure Princes and to murder vice."
                            },
                            {
                                "example_id": "12b59751-03a2-4340-b98e-1c5dd4614bb9",
                                "sense_id": "7074af23-1a15-34d6-99e4-193705b4a7ec",
                                "text": "Where when men been, there's ſeldome eaſe,"
                            },
                            {
                                "example_id": "c5e0d31d-7280-4725-af03-a087be8ef2f5",
                                "sense_id": "7074af23-1a15-34d6-99e4-193705b4a7ec",
                                "text": "O Friar, those are faults that are not seen, / Ours open, and of worse example been."
                            }
                        ]
                    }
                ],
