                                "ru": "Я <w>сдаю</w> свою квартиру, когда нахожусь в путешествии."
                            }
                        },
                        {
                            "text": "Ik <w>verhuur</w> deze kamer aan een student.",
                            "target_lang_translations": {
                                "en": "I <w>rent out</w> this room to a student.",
                                "ru": "Я <w>сдаю</w> эту комнату студенту."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of <w>verhuren</w> (to rent out).",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола verhuren (сдавать в аренду)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rent out",
                                "target_lang_sense_clarification": "to allow use for payment"
                            },
                            {
                                "target_lang_word": "let",
                                "target_lang_sense_clarification": "formal or British usage for property"
                            }
                        ],
                        "ru": [
                            {
