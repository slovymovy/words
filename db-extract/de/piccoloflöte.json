                "senses": [
                    {
                        "sense_id": "b398be51-8a87-3978-a5e2-54226beed4e1",
                        "entry_id": "c3a46761-aae1-34dd-aac6-70d5fc2c91c9",
                        "glosses": [
                            "kleine Flöte, die sehr hoch spielt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "70c1bf5a-8a61-42e2-9ef4-3cf1e0d3818d",
                                "sense_id": "b398be51-8a87-3978-a5e2-54226beed4e1",
                                "text": "„Auch manche Nuancen der Bläser-Riege gerieten diesmal wie absichtslos, mit selbstverständlicher Nonchalance hingestreut – das legendäre wienerische „picksüße Hölzel“ ist am Beginn der „Dorfschwalben aus Österreich“ zu ahnen, die Piccoloflöte führt in diesem Joseph-Strauß-Juwel später die ganze Partie – das Klangbild changiert tatsächlich von Komposition zu Komposition.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f8f4918-dc68-4f55-951b-c4e8e9e3149a",
                        "source_entry_id": "c3a46761-aae1-34dd-aac6-70d5fc2c91c9",
                        "source_sense_id": "b398be51-8a87-3978-a5e2-54226beed4e1",
                        "source_sense_description": "Musik: kleine Flöte, die sehr hoch spielt",
