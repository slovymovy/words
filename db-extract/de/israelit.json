                    },
                    {
                        "translation_id": "5da6adf4-11f6-4c13-9a57-66d4e4f6e390",
                        "source_entry_id": "6e8800db-b072-3f80-8a9f-ed1f03ea9158",
                        "source_sense_id": "4174a9de-ecf8-3f5c-a69a-718edaba9f8b",
                        "source_sense_description": "im Alten Testament: Angehöriger des Volkes Israel",
                        "target_lang_word": "израильтянин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "израильтянин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "46ec1269-438a-37b2-b53c-0757eb74e817",
                                        "entry_id": "283be88f-aa99-3ed3-9e51-24127366bf91",
                                        "glosses": [
                                            "истор. представитель древнееврейского народа, история которого легла в основу сюжетов Библии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d0d15c8-0630-4a93-9d8d-d9ee08c2e2aa",
                                                "sense_id": "46ec1269-438a-37b2-b53c-0757eb74e817",
                                                "text": "Полагают также, что тут же и место перехода израильтян через Иордан; против монастыря, на другом берегу, жила некогда св. Мария Магдалина."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c628f121-e933-3c39-af11-bb9052f0ce60",
                                        "entry_id": "283be88f-aa99-3ed3-9e51-24127366bf91",
                                        "glosses": [
                                            "житель, уроженец или гражданин Израиля"
                                        ],
                                        "tags": [
                                            "обычно о евреях"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1fef467-d91e-457a-bf3a-315b27c4f030",
                                                "sense_id": "c628f121-e933-3c39-af11-bb9052f0ce60",
                                                "text": "У израильтян все время находится повод для посадки деревьев: по дереву за каждого еврея, погибшего при Холокосте (так в Израиле называют массовое уничтожение евреев гитлеровцами в годы Второй мировой войны), по дереву за каждого еврея, живущего в диаспоре, по три за каждую жертву террористов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "118aeab5-ae40-347b-916c-20ef5ce255ab",
                                        "entry_id": "283be88f-aa99-3ed3-9e51-24127366bf91",
                                        "glosses": [
                                            "разг. еврей, иудей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4191c60d-6048-434a-bb4f-024d772a38b6",
                                                "sense_id": "118aeab5-ae40-347b-916c-20ef5ce255ab",
                                                "text": "Аксаков был прав; избави нас Боже от множества обруселых католиков и обруселых евреев; и дай нам Господи побольше православных ляхов и даже православных израильтян!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
