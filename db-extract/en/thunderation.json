                "senses": [
                    {
                        "sense_id": "39c78c73-1732-35a2-816a-26e94bdba20a",
                        "entry_id": "d22383e9-1531-3ff1-abd9-a9bfa8c6fbcf",
                        "glosses": [
                            "An exclamation of surprise, agitation or petulance."
                        ],
                        "tags": [
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3e4370ed-fa17-479c-8723-ba780fee7358",
                                "sense_id": "39c78c73-1732-35a2-816a-26e94bdba20a",
                                "text": "Thunderation! I've lost my glasses!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1eb60812-f16d-46e2-bfb3-65acff3ea87a",
                        "source_entry_id": "d22383e9-1531-3ff1-abd9-a9bfa8c6fbcf",
                        "source_sense_id": "39c78c73-1732-35a2-816a-26e94bdba20a",
                        "source_sense_description": "exclamation of surprise",
                        "target_lang_word": "tonnerre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tonnerre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97d7d21c-0947-3869-8350-ba62962baa54",
                                        "entry_id": "1365bbf4-def5-3b20-8616-cfebfa02f8b0",
                                        "glosses": [
                                            "Bruit de la foudre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b621a0-2946-4451-92e0-aca537008de1",
                                                "sense_id": "97d7d21c-0947-3869-8350-ba62962baa54",
                                                "text": "Il est possible que les coups de tonnerre se produisent en raison du roulement du vent dans les cavités des nuages, comme c’est le cas dans nos viscères, […]."
                                            },
                                            {
                                                "example_id": "f39445b8-8f19-4887-91c3-2d581edc60ee",
                                                "sense_id": "97d7d21c-0947-3869-8350-ba62962baa54",
                                                "text": "Bientôt les roulements d’un tonnerre lointain, se prolongeant dans ces bois aussi vieux que le monde, en firent sortir des bruits sublimes."
                                            },
                                            {
                                                "example_id": "1a455b6a-7f0a-49fe-836b-6ee5b214b987",
                                                "sense_id": "97d7d21c-0947-3869-8350-ba62962baa54",
                                                "text": "Le tonnerre éclata avec une force épouvantable, un tourbillon de vent s’engouffra dans la salle en défonçant une fenêtre."
                                            },
                                            {
                                                "example_id": "9444dea2-1c08-4f20-8fdd-d89c205b96de",
                                                "sense_id": "97d7d21c-0947-3869-8350-ba62962baa54",
                                                "text": "De tradition ardennaise, la fête de l’Assomption est un jour d'orage. Ce dicton, aujourd'hui, se confirmera: le tonnerre commence de se faire entendre."
                                            },
                                            {
                                                "example_id": "179682eb-a11d-43c7-9037-77c04bcbc83e",
                                                "sense_id": "97d7d21c-0947-3869-8350-ba62962baa54",
                                                "text": "Elle disait avoir entendu parler d’une place qui allait peut-être se libérer, pour lui, chez un collègue quand plusieurs bruits énormes, résonnant tels des coups de tonnerre successifs lui coupèrent la parole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46102f45-33bd-3a7b-8911-1096289202ed",
                                        "entry_id": "1365bbf4-def5-3b20-8616-cfebfa02f8b0",
                                        "glosses": [
                                            "La foudre elle-même."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "709c79e5-201d-4da8-87a0-5bf985563b04",
                                                "sense_id": "46102f45-33bd-3a7b-8911-1096289202ed",
                                                "text": "Remarquez, d’autre part, cette tendance du tonnerre à choir non sur le clocher vieux, mais sur le clocher neuf ; […]."
                                            },
                                            {
                                                "example_id": "b4e16537-8d11-470d-9aa9-b7d73c74eeb2",
                                                "sense_id": "46102f45-33bd-3a7b-8911-1096289202ed",
                                                "text": "Je fus arraché à mes pensées par un bruit semblable à celui du plus épouvantable ouragan. Il semblait que tous les arbres allaient être déracinés, et que le tonnerre allait tomber sur nous"
                                            },
                                            {
                                                "example_id": "a86b2fec-200e-467d-962d-b197aeda4d0e",
                                                "sense_id": "46102f45-33bd-3a7b-8911-1096289202ed",
                                                "text": "Les éclairs sillonnaient les nuages sombres et je vis à quelque distance tomber le tonnerre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d12a6bd1-7c4e-30dc-9074-85927bfd5c80",
                                        "entry_id": "1365bbf4-def5-3b20-8616-cfebfa02f8b0",
                                        "glosses": [
                                            "Manifestation bruyante, grondement."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01dd142f-a6ca-46b9-8c4a-8a253f4c3db9",
                                                "sense_id": "d12a6bd1-7c4e-30dc-9074-85927bfd5c80",
                                                "text": "Un tonnerre d’acclamations s’ensuivit, et le prince Jean lui-même, dans son admiration pour l’adresse de Locksley, oublia pour un moment l’aversion que le yeoman lui avait inspirée."
                                            },
                                            {
                                                "example_id": "df771afd-e93f-4e30-8fe4-50dfcb2c9e06",
                                                "sense_id": "d12a6bd1-7c4e-30dc-9074-85927bfd5c80",
                                                "text": "J’avais beau lever le poing et jouer de mon tonnerre : il voyait le rire au coin de l’œil de Jupiter."
                                            },
                                            {
                                                "example_id": "396654df-afd6-44e8-a796-34532905356e",
                                                "sense_id": "d12a6bd1-7c4e-30dc-9074-85927bfd5c80",
                                                "text": "Le curé de Melotte […] n’était plus craint. Ses foudres de carton, ses tonnerres lointains, l’évocation des bûchers infernaux, la promesse des félicités paradisiaques dans un éden, somme toute, passablement morne et fort problématique, ne faisaient plus guère frémir que quelques vieilles dévotes et les gosses de neuf à onze ans […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99739846-8ed2-3025-96bc-262133d2a472",
                                        "entry_id": "1365bbf4-def5-3b20-8616-cfebfa02f8b0",
                                        "glosses": [
                                            "Endroit du canon d’un fusil, d’un pistolet où se met la charge et où se produit l’explosion au moment du tir."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e289e7b-0998-3fa6-9903-00f96e42f76f",
                                        "entry_id": "1365bbf4-def5-3b20-8616-cfebfa02f8b0",
                                        "glosses": [
                                            "Personne méprisable."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea06d088-1781-4261-8780-b87ff53158e1",
                                                "sense_id": "8e289e7b-0998-3fa6-9903-00f96e42f76f",
                                                "text": "-- Ce tonnerre de carabin-là mérite deux fois la mort !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tonnerre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e96c78d4-678b-3e8e-b244-2643d247eb38",
                                        "entry_id": "40b27144-9ed9-362c-aaed-39833d3cb29b",
                                        "glosses": [
                                            "Pour marquer l’étonnement ou l'énervement."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df1b6a38-a424-44bc-84ed-bbaf45f716ef",
                                                "sense_id": "e96c78d4-678b-3e8e-b244-2643d247eb38",
                                                "text": "– Tonnerre… grinça-t-il, le papier n’y est pas… Tu m’as roulé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
