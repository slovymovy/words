                "senses": [
                    {
                        "sense_id": "a82a5cdb-6450-3002-b2f5-7ce52a748fd1",
                        "entry_id": "a03397f8-a5fe-339d-b7df-a788378f66d2",
                        "glosses": [
                            "die Grenze im Norden eines Gebietes, Ortes oder Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad7f8bce-78c6-4986-8fbb-5a19d73069b0",
                                "sense_id": "a82a5cdb-6450-3002-b2f5-7ce52a748fd1",
                                "text": "Die Tour erkundet die Nordgrenze des Ludwigsburger Landkreises."
                            },
                            {
                                "example_id": "72abbc00-71cb-49ad-b626-512e5f4dda00",
                                "sense_id": "a82a5cdb-6450-3002-b2f5-7ce52a748fd1",
                                "text": "Jetzt attackiert die Dänische Volkspartei den Kompromiss von 1920 und stellt die deutsche Nordgrenze in Frage."
                            },
                            {
                                "example_id": "25731a3a-24e6-44d6-88f3-f65593024bfe",
                                "sense_id": "a82a5cdb-6450-3002-b2f5-7ce52a748fd1",
                                "text": "Höchste Erhebung ist der Dörenberg (331,2 Meter) an der Nordgrenze der Stadt."
                            },
                            {
                                "example_id": "42e04d47-4de1-4d84-964c-56be878385bd",
                                "sense_id": "a82a5cdb-6450-3002-b2f5-7ce52a748fd1",
                                "text": "Die sogenannte Operation Olivenzweig gegen die kurdischen Volksverteidigungseinheiten YPG ist eine Reaktion auf die Pläne der USA, entlang der syrischen Nordgrenze eine 30.000 Mann starke, kurdisch dominierte Truppe aufzustellen."
                            },
                            {
                                "example_id": "8ef9454f-34f3-42c8-b4e7-099dc7408790",
                                "sense_id": "a82a5cdb-6450-3002-b2f5-7ce52a748fd1",
                                "text": "Im Norden reicht das Hungergebiet bis zur Nordgrenze der Waldsteppenregion."
                            },
                            {
                                "example_id": "acb9f985-c81a-47c9-bfe8-a5247df42651",
                                "sense_id": "a82a5cdb-6450-3002-b2f5-7ce52a748fd1",
                                "text": "Im März mehrten sich schwerere Zwischenfälle entlang der Waffenstillstandslinie zwischen Israel und Syrien sowie an der Nordgrenze zum Libanon."
                            },
                            {
                                "example_id": "5201a92b-9377-4a55-a188-4b80bf64205f",
                                "sense_id": "a82a5cdb-6450-3002-b2f5-7ce52a748fd1",
                                "text": "Die Nordgrenze ging von Michmetat ostwärts nach Taanat-Schilo bis nach Janoach."
                            },
                            {
                                "example_id": "d9d99d4a-ab92-4b4b-85f4-967ed21c4099",
                                "sense_id": "a82a5cdb-6450-3002-b2f5-7ce52a748fd1",
                                "text": "„Die Nordgrenze verlief mitten durch die Siedlungsgebiete der Usbeken und Turkmenen und teilte auch das kulturell recht homogene Fürstentum Badakhschan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
