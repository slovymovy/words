            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3543b72-b9ab-3cd6-a64e-ffbf88fcc43b",
                    "sense_definition": "Заниматься игрой ради развлечения или участвовать в спортивном состязании по определённым правилам.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети любят <играть> в прятки во дворе.",
                            "target_lang_translations": {
                                "en": "Children love to <play> hide-and-seek in the yard.",
                                "zh": "孩子们喜欢在院子里<w>玩</w>捉迷藏。"
                            }
                        },
                        {
                            "text": "Мой брат умеет хорошо <играть> в футбол.",
                            "target_lang_translations": {
                                "en": "My brother can <play> football well.",
                                "zh": "我弟弟很擅长<w>踢</w>足球。"
                            }
                        },
                        {
                            "text": "Мы будем <играть> в карты весь вечер.",
                            "target_lang_translations": {
                                "en": "We will <play> cards all evening.",
                                "zh": "我们整个晚上都要<w>玩</w>牌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "развлекаться",
                        "забавляться",
                        "резвиться",
                        "соревноваться"
                    ],
                    "antonyms": [
                        "работать"
                    ],
                    "common_phrases": [
                        "играть в футбол",
                        "играть в шахматы",
                        "играть в куклы",
                        "играть с детьми",
                        "играть в игры"
                    ],
                    "target_lang_definitions": {
                        "en": "To engage in a game for entertainment or participate in a sports competition according to certain rules.",
                        "zh": "为了娱乐而进行游戏，或按照特定规则参加体育比赛。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "play",
                                "target_lang_sense_clarification": "games, sports"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玩",
                                "target_lang_sense_clarification": "游戏、娱乐"
                            },
                            {
                                "target_lang_word": "比赛",
                                "target_lang_sense_clarification": "体育竞技"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f4859ae-d5b5-33e9-918d-10395adef887",
                    "sense_definition": "Исполнять музыкальное произведение или извлекать звуки из музыкального инструмента.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она учится <играть> на скрипке в музыкальной школе.",
                            "target_lang_translations": {
                                "en": "She is learning to <play> the violin at music school.",
                                "zh": "她正在音乐学校学习<w>拉</w>小提琴。"
                            }
                        },
                        {
                            "text": "Пианист начал <играть> красивую мелодию.",
                            "target_lang_translations": {
                                "en": "The pianist started to <play> a beautiful melody.",
                                "zh": "钢琴家开始<w>弹奏</w>一首优美的旋律。"
                            }
                        },
                        {
                            "text": "Сосед громко <играет> на гитаре по вечерам.",
                            "target_lang_translations": {
                                "en": "The neighbor <plays> the guitar loudly in the evenings.",
                                "zh": "邻居每天晚上都大声地<w>弹</w>吉他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "музицировать",
                        "исполнять"
                    ],
                    "common_phrases": [
                        "играть на гитаре",
                        "играть на пианино",
                        "играть на скрипке",
                        "играть музыку",
                        "играть вальс"
                    ],
                    "target_lang_definitions": {
                        "en": "To perform a musical piece or extract sounds from a musical instrument.",
                        "zh": "演奏乐曲或从乐器中发出声音。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "play",
                                "target_lang_sense_clarification": "musical instrument"
                            }
