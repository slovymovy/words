                                    },
                                    {
                                        "sense_id": "28b4d791-fb98-3507-b4fb-3ba5f4d830b7",
                                        "entry_id": "3a93372a-b385-3eeb-a8bb-64ac84ad88eb",
                                        "glosses": [
                                            "grüner Farbton, ein bestimmter Abschnitt des sichtbaren Lichts im Spektrum der elektromagnetischen Wellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e9f4dd2-d635-4007-a5e3-286929f89391",
                                                "sense_id": "28b4d791-fb98-3507-b4fb-3ba5f4d830b7",
                                                "text": "Fenster- und Türrahmen sind in einem dezenten Grün gehalten."
                                            },
                                            {
                                                "example_id": "9357f89e-76f6-41a0-8e94-6629ef6b64e0",
                                                "sense_id": "28b4d791-fb98-3507-b4fb-3ba5f4d830b7",
                                                "text": "Grün ist die Farbe der Hoffnung."
                                            },
                                            {
                                                "example_id": "74a91e63-cd7b-4920-b42d-07516355a896",
                                                "sense_id": "28b4d791-fb98-3507-b4fb-3ba5f4d830b7",
                                                "text": "„Am Portal des gründerzeitlichen Eckhauses beißt sich ein blauer Schriftzug sehr schön mit dem giftigen Grün der Eingangstür.“"
                                            },
                                            {
                                                "example_id": "5fc47445-97b3-42f1-94b2-d177d3402787",
                                                "sense_id": "28b4d791-fb98-3507-b4fb-3ba5f4d830b7",
                                                "text": "„Sehr lange wurde die Farbe Grün in der Malerei vermieden, sie war verpönt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd8a1c8e-57d2-38f9-96dc-57b6375dcc00",
                                        "entry_id": "3a93372a-b385-3eeb-a8bb-64ac84ad88eb",
                                        "glosses": [
                                            "Genitiv: Grüns, kein Plural"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5d0154f-897f-3cce-80d8-4b01f4ae6222",
                                        "entry_id": "3a93372a-b385-3eeb-a8bb-64ac84ad88eb",
                                        "glosses": [
                                            "kurz für Grünfläche, grünes Blattwerk, grüne Pflanzenteile und Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3973f328-1277-48eb-99fd-64c297506c46",
                                                "sense_id": "b5d0154f-897f-3cce-80d8-4b01f4ae6222",
                                                "text": "Für das öffentliche Grün ist das Gartenbauamt zuständig."
                                            },
                                            {
                                                "example_id": "24dbb18c-ed7c-4109-88fd-02c1d0d28609",
                                                "sense_id": "b5d0154f-897f-3cce-80d8-4b01f4ae6222",
                                                "text": "„Lichtes Grün brach aus dem schwarzen Geäst, und die ersten Veilchen schienen mir den endgültigen Sieg des Guten über das Böse zu verkünden.“"
                                            },
                                            {
                                                "example_id": "a15c386f-6ee1-4d8f-86ab-9fc9a3b4ac6e",
                                                "sense_id": "b5d0154f-897f-3cce-80d8-4b01f4ae6222",
                                                "text": "„Ich legte sie auf ihr Bett, in Papier gewickelt, wie sie waren, und beobachtete, wie sie sie auspackte, die Knospen zurechtlegte, an dem Grün zupfte.“"
                                            },
                                            {
                                                "example_id": "cde618dc-c686-4eed-a99a-d28ae3afa990",
                                                "sense_id": "b5d0154f-897f-3cce-80d8-4b01f4ae6222",
                                                "text": "„Hinter ihnen, durch den offenen romanischen Säulengang, leuchtete im ersten Grün der Domgarten.“"
                                            },
                                            {
                                                "example_id": "a7587916-69ac-413d-8e42-f417d33f4ef8",
                                                "sense_id": "b5d0154f-897f-3cce-80d8-4b01f4ae6222",
                                                "text": "„Dazwischen hoben sich abgestorbene, schwarze Baumstämme von dem Grün der Landschaft ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d3e72620-95dc-33bc-ad10-d3943382ad5c",
                                        "entry_id": "3a93372a-b385-3eeb-a8bb-64ac84ad88eb",
                                        "glosses": [
                                            "ohne Artikel"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "604a2580-eae4-30ff-bfbd-c742c9d94c3e",
                                        "entry_id": "3a93372a-b385-3eeb-a8bb-64ac84ad88eb",
                                        "glosses": [
                                            "eine Farbe im deutschen Kartenblatt mit einem Blatt (häufig Lindenblatt) als Symbol; eine Karte in dieser Farbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0133649d-c0d8-4f6c-8d4d-98e4ace23b4a",
                                                "sense_id": "604a2580-eae4-30ff-bfbd-c742c9d94c3e",
                                                "text": "Grün ist Trumpf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d8b3a287-b887-3db5-a70c-0a93ebb3d7b9",
                                        "entry_id": "3a93372a-b385-3eeb-a8bb-64ac84ad88eb",
                                        "glosses": [
