                                "example_id": "f47d74a3-7ecf-49f5-b435-f4c117c94009",
                                "sense_id": "46e043e2-1fc3-3c08-9813-d3654ff7f455",
                                "text": "“Understood. F.A.B., sir.” Their pilot hung the microphone back on its hook."
