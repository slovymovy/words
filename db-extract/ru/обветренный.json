                "senses": [
                    {
                        "sense_id": "8a310309-1229-393d-8ab3-bd6bf275d6dd",
                        "entry_id": "7db763cb-a6fa-33ab-ba28-b8d598e7eaba",
                        "glosses": [
                            "действ. прич. прош. вр. от обветрить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ec2d432a-4972-33c2-9971-f5ff6978cb83",
                        "entry_id": "7db763cb-a6fa-33ab-ba28-b8d598e7eaba",
                        "glosses": [
                            "страд. прич. прош. вр. от обветрить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cedcf8b8-3796-30f0-93f9-b7ba0e99e2d2",
                        "entry_id": "7db763cb-a6fa-33ab-ba28-b8d598e7eaba",
                        "glosses": [
                            "разрушенный действием ветра"
                        ],
                        "tags": [
                            "в знач. прил."
                        ],
                        "examples": [
                            {
                                "example_id": "fa9e5558-c300-4db9-8874-011036556d99",
                                "sense_id": "cedcf8b8-3796-30f0-93f9-b7ba0e99e2d2",
                                "text": "Из-под снегу торчат суровые глыбы обледенелых, обветренных скал."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbf35159-eac8-38fb-9544-715c7de62436",
                        "entry_id": "7db763cb-a6fa-33ab-ba28-b8d598e7eaba",
                        "glosses": [
                            "огрубевший, ставший шершавым от ветра, от длительного пребывания на воздухе и т. п."
                        ],
                        "tags": [
                            "в знач. прил."
                        ],
                        "examples": [
                            {
                                "example_id": "b6621e30-4041-4512-8bab-f8c5809a2c66",
                                "sense_id": "bbf35159-eac8-38fb-9544-715c7de62436",
                                "text": "Обветренные руки."
                            },
                            {
                                "example_id": "f96a2c1f-3a7e-4e9d-9491-21ee2ebf8b30",
                                "sense_id": "bbf35159-eac8-38fb-9544-715c7de62436",
                                "text": "Лицо у него было ещё не старое, загорелое, обветренное."
                            },
                            {
                                "example_id": "77882a16-66dd-41cf-b43e-81193157cf4a",
                                "sense_id": "bbf35159-eac8-38fb-9544-715c7de62436",
                                "text": "На смуглом, худом лице паренька с обветреннными, потрескавшимися губами резко выделялись светлые глаза."
                            }
                        ]
                    }
