                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2a8536f-7a86-3948-bbf7-4755c0cf596d",
                                        "entry_id": "9b80fc8f-6ddd-332d-a1bb-0e44c33c8a9a",
                                        "glosses": [
                                            "vom 16. bis 18. Jahrhundert verbreitete Kleinform des Cembalos, dessen Saiten schräg-seitlich zur Klaviatur verlaufen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd700200-4705-4117-87b7-2c341e4a6046",
                                                "sense_id": "d2a8536f-7a86-3948-bbf7-4755c0cf596d",
                                                "text": "Das Spinett ist ein Vorläufer des Klaviers, das in Deutschland sehr beliebt war."
                                            },
                                            {
                                                "example_id": "b62f458f-7fa2-4c3d-beca-d09bd5686d04",
                                                "sense_id": "d2a8536f-7a86-3948-bbf7-4755c0cf596d",
                                                "text": "„Schon als sie ein kleines Kind war, hatte das Spinett der Mutter eine magische Anziehung auf sie ausgeübt.“"
                                            },
                                            {
                                                "example_id": "2119b2db-6819-4213-8987-8235e9cb8507",
                                                "sense_id": "d2a8536f-7a86-3948-bbf7-4755c0cf596d",
                                                "text": "„Auf Drängen von Don Sancho setzte sich nach Tisch Bellino – so hieß der Kastrat, der die Primadonna spielte – an das Spinett und begleitete sich zu einer Arie, die er mit Engelsstimme und betörender Anmut sang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
