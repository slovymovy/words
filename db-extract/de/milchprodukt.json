                ],
                "senses": [
                    {
                        "sense_id": "107c3d7f-366b-31b5-8b27-dfb76f9a9164",
                        "entry_id": "ec88d95a-c4ed-3a4d-9eae-9acf17468155",
                        "glosses": [
                            "Nahrungsmittel, das aus Milch (meist Kuhmilch) hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b130c35-6bc7-4ee2-a543-19446e460467",
                                "sense_id": "107c3d7f-366b-31b5-8b27-dfb76f9a9164",
                                "text": "Milchprodukte werden trotz des niedrigen Milchpreises nicht immer billig verkauft."
                            },
                            {
                                "example_id": "2af86ebb-d57d-421a-842b-121c4858f5a9",
                                "sense_id": "107c3d7f-366b-31b5-8b27-dfb76f9a9164",
                                "text": "Frische Milchprodukte sollte man im Kühlschrank lagern, da sie schnell verderben."
                            },
                            {
                                "example_id": "6b948078-1295-47aa-b4d3-0b7316324b0a",
                                "sense_id": "107c3d7f-366b-31b5-8b27-dfb76f9a9164",
                                "text": "„Auch hier sei die kontaminierte Erde abgetragen worden, beruhigt uns der Biologe, und im Übrigen werde jedes Gemüse und Milchprodukt auf Cäsium, Strontium und andere Nuklide gemessen, bevor es in den Handel gelange.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76f9abdd-e098-4fb9-909c-fe827d45d888",
                        "source_entry_id": "ec88d95a-c4ed-3a4d-9eae-9acf17468155",
                        "source_sense_id": "107c3d7f-366b-31b5-8b27-dfb76f9a9164",
                        "source_sense_description": "Nahrungsmittel, das aus Milch (meist Kuhmilch) hergestellt wird",
