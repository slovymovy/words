                ],
                "senses": [
                    {
                        "sense_id": "2a489db6-a6c5-30ac-9d16-054610611a95",
                        "entry_id": "7f035354-444d-394a-9429-bab71b87626f",
                        "glosses": [
                            "Gast, der bei einem bestimmten Ereignis besonders geehrt wird/besondere Vergünstigungen genießt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b674631-b533-4fa7-8e2a-1bd02bb4413f",
                                "sense_id": "2a489db6-a6c5-30ac-9d16-054610611a95",
                                "text": "„Wir sind keine Eindringlinge, sondern Ehrengäste.“"
                            },
                            {
                                "example_id": "70fc75b3-2f1e-470b-b92b-f1bc7c3549b6",
                                "sense_id": "2a489db6-a6c5-30ac-9d16-054610611a95",
                                "text": "„Da Blixa der Einzige ist, der einen Anzug trägt und das Im-Mittelpunkt-Stehen in den letzten Jahrzehnten ja schon ein bisschen geübt hat, wird er schließlich vom Wirt messerscharf als der Ehrengast erkannt und mit großer Geste begrüßt.“"
                            },
                            {
                                "example_id": "7cf782f9-6a74-4311-8e79-c75a53941af1",
                                "sense_id": "2a489db6-a6c5-30ac-9d16-054610611a95",
                                "text": "„Ein paar Jahre später sollte auf diesem Festival der Ehrengast Roman Polanski den Preis des Filmfestes entgegennehmen.“"
                            },
                            {
                                "example_id": "943f0cfd-abfb-4181-b641-6346792bfa97",
                                "sense_id": "2a489db6-a6c5-30ac-9d16-054610611a95",
                                "text": "„Dann nahm ich als Ehrengast den ersten Schluck.“"
                            },
                            {
                                "example_id": "ecf35538-3799-4e95-96c1-47e20cbe8e8a",
                                "sense_id": "2a489db6-a6c5-30ac-9d16-054610611a95",
                                "text": "„Er durfte nicht auf die Bühne zu den Ehrengästen, sondern der riesige Mann saß kaum sichtbar im Halbdunkel neben seiner wegen dieser Erniedrigung weinenden Ehefrau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
