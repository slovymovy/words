                ],
                "senses": [
                    {
                        "sense_id": "ebe0a600-ffb9-3ba7-8247-f41ab87c8519",
                        "entry_id": "7454eeb8-5a59-3753-b831-ae3d46759698",
                        "glosses": [
                            "Ensemble des idées et de la manière des prophètes dans l’Ancien Testament."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa837b46-f8cf-4efd-93d5-f55d6e29820b",
                                "sense_id": "ebe0a600-ffb9-3ba7-8247-f41ab87c8519",
                                "text": "L’extinction à peu près totale du prophétisme, cette fleur admirable du génie d’Israël."
                            },
                            {
                                "example_id": "a4a2e8ad-9f39-4b9a-b312-bb4754c554a3",
                                "sense_id": "ebe0a600-ffb9-3ba7-8247-f41ab87c8519",
                                "text": "Il est notre Isaïe… Il a ressuscité la tradition du prophétisme apocalyptique…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d283175-513e-34ac-9e08-74778af48385",
                        "entry_id": "7454eeb8-5a59-3753-b831-ae3d46759698",
                        "glosses": [
                            "Mouvement de prédictions et de prédication par des prophètes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f553399-11ce-46c6-8043-6e919f8790b3",
                                "sense_id": "7d283175-513e-34ac-9e08-74778af48385",
                                "text": "Le pasteur-historien devait avoir bien des continuateurs, notamment Napoléon Peyrat (Histoire des pasteurs du Désert, 1842), qui réhabilite les camisards et le phénomène du prophétisme, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba0850ae-361f-338b-a4fe-f66b8fff6852",
                        "entry_id": "7454eeb8-5a59-3753-b831-ae3d46759698",
                        "glosses": [
                            "Propension à donner des prévisions d’un avenir plus ou moins éloigné."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "9d415aa4-f351-4964-8c02-14f2bc1be01d",
                                "sense_id": "ba0850ae-361f-338b-a4fe-f66b8fff6852",
                                "text": "Pour elle, la réfutation des maîtres à penser et du prophétisme, en particulier sartrien, comme de la médiatisation béachélienne, forme le noyau le plus incisif et le plus polémique des premiers numéros de la revue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c905cd4-ae2c-4f5e-b298-0f139e548994",
                        "source_entry_id": "7454eeb8-5a59-3753-b831-ae3d46759698",
