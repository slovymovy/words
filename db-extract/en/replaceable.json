                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "123a8eda-611d-4456-949c-ec01e8c71b31",
                                                "sense_id": "c4e9f9d9-c9f8-32e9-b655-b29e341ba22c",
                                                "text": "Iedereen is vervangbaar al kost dat soms wat tijd en moeite."
