{
    "word_family": [
        "escapism",
        "escapist",
        "escapee",
        "escapement",
        "escapable",
        "inescapable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d538b88-f503-3392-8ca8-d0fd51c8950d",
                    "sense_definition": "To get free from a place where you are kept or stuck.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "get free",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoners <w>escaped</w> by jumping over a high wall during the night.",
                            "target_lang_translations": {
                                "ru": "Заключенные <w>сбежали</w>, перепрыгнув через высокую стену ночью.",
                                "pl": "Więźniowie <w>uciekli</w>, przeskakując przez wysoki mur w nocy."
                            }
                        },
                        {
                            "text": "The bird managed to <w>escape</w> from its cage when the door was left open.",
                            "target_lang_translations": {
                                "ru": "Птице удалось <w>вырваться</w> из клетки, когда дверь оставили открытой.",
                                "pl": "Ptakowi udało się <w>wydostać</w> z klatki, gdy drzwiczki zostały otwarte."
                            }
                        }
                    ],
                    "synonyms": [
                        "break loose"
                    ],
                    "common_phrases": [
                        "escape from prison",
                        "narrowly escape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освободиться из места, где вас удерживают или где вы застряли.",
                        "pl": "Wydostać się na wolność z miejsca, w którym jest się przetrzymywanym lub uwięzionym."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбежать",
                                "target_lang_sense_clarification": "из тюрьмы или плена"
                            },
                            {
                                "target_lang_word": "совершить побег",
                                "target_lang_sense_clarification": "официальное выражение"
                            },
                            {
                                "target_lang_word": "вырваться",
                                "target_lang_sense_clarification": "из клетки или заточения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uciec",
                                "target_lang_sense_clarification": "z więzienia lub zamknięcia"
                            },
                            {
                                "target_lang_word": "wydostać się",
                                "target_lang_sense_clarification": "z trudnego położenia lub klatki"
                            },
                            {
                                "target_lang_word": "zbiec",
                                "target_lang_sense_clarification": "dokonać ucieczki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f86f8c8b-f677-337b-a83d-5039db52dbd3",
                    "sense_definition": "To avoid an unpleasant or dangerous person, thing, or situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children climbed out of the window to <w>escape</w> the fire.",
                            "target_lang_translations": {
                                "ru": "Дети вылезли из окна, чтобы <w>спастись</w> от огня.",
                                "pl": "Dzieci wygramoliły się przez okno, aby <w>uciec</w> przed ogniem."
                            }
                        },
                        {
                            "text": "He moved to the countryside to <w>escape</w> the noise of the city.",
                            "target_lang_translations": {
                                "ru": "Он переехал в сельскую местность, чтобы <w>укрыться</w> от городского шума.",
                                "pl": "Przeprowadził się na wieś, aby <w>odpocząć</w> od miejskiego zgiełku."
                            }
                        }
                    ],
                    "synonyms": [
                        "break loose"
                    ],
                    "common_phrases": [
                        "escape the heat",
                        "escape the crowd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Избежать встречи с неприятным или опасным человеком, предметом или ситуацией.",
                        "pl": "Uniknąć nieprzyjemnej lub niebezpiecznej osoby, rzeczy lub sytuacji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избежать",
                                "target_lang_sense_clarification": "опасности или ситуации"
                            },
                            {
                                "target_lang_word": "спастись",
                                "target_lang_sense_clarification": "от пожара или беды"
                            },
                            {
                                "target_lang_word": "укрыться",
                                "target_lang_sense_clarification": "от шума или жары"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uniknąć",
                                "target_lang_sense_clarification": "niebezpieczeństwa lub kary"
                            },
                            {
                                "target_lang_word": "umknąć",
                                "target_lang_sense_clarification": "przed kimś lub czymś"
                            },
                            {
                                "target_lang_word": "uchronić się",
                                "target_lang_sense_clarification": "przed negatywnym skutkiem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f14483d5-2ab6-3194-a736-675091c3e3f2",
                    "sense_definition": "To not be noticed or remembered by someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The name of the hotel <w>escapes</w> me at present.",
                            "target_lang_translations": {
                                "ru": "Название отеля сейчас <w>вылетело у меня из головы</w>.",
                                "pl": "Nazwa hotelu w tej chwili <w>wyleciała mi z głowy</w>."
                            }
                        },
                        {
                            "text": "The detective examined the crime scene, but one clue <w>escaped</w> his notice.",
                            "target_lang_translations": {
                                "ru": "Детектив осмотрел место преступления, но одна улика <w>ускользнула</w> от его внимания.",
                                "pl": "Detektyw zbadał miejsce zbrodni, ale jeden ślad <w>umknął</w> jego uwadze."
                            }
                        }
                    ],
                    "common_phrases": [
                        "escape one's notice",
                        "escape one's memory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть незамеченным или забытым кем-либо.",
                        "pl": "Zostać niezauważonym lub zapomnianym przez kogoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылететь из головы",
                                "target_lang_sense_clarification": "о памяти или имени"
                            },
                            {
                                "target_lang_word": "ускользнуть",
                                "target_lang_sense_clarification": "от чьего-либо внимания"
                            },
                            {
                                "target_lang_word": "забыться",
                                "target_lang_sense_clarification": "перестать помниться"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "umknąć",
                                "target_lang_sense_clarification": "czyjejś uwadze"
                            },
                            {
                                "target_lang_word": "wylecieć z pamięci",
                                "target_lang_sense_clarification": "o nazwisku lub słowie"
                            },
                            {
                                "target_lang_word": "ujść",
                                "target_lang_sense_clarification": "czyjejś uwagi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89b3f613-f136-371e-a0ee-e724b8e98347",
                    "sense_definition": "To use a special character to indicate that the following character should be treated literally in computing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When using the shell, you can <w>escape</w> the ampersand character with a backslash.",
                            "target_lang_translations": {
                                "ru": "При использовании оболочки вы можете <w>экранировать</w> символ амперсанда обратным слэшем.",
                                "pl": "Używając powłoki, możesz <w>maskować</w> znak ampersand za pomocą ukośnika wstecznego."
                            }
                        },
                        {
                            "text": "You must <w>escape</w> the string before sending it to the database.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>экранировать</w> строку перед отправкой её в базу данных.",
                                "pl": "Musisz <w>zabezpieczyć</w> ciąg znaków przed wysłaniem go do bazy danych."
                            }
                        }
                    ],
                    "common_phrases": [
                        "escape the character",
                        "escape the string"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать специальный символ, чтобы указать, что следующий за ним символ должен восприниматься буквально (в программировании).",
                        "pl": "Użyć znaku specjalnego, aby wskazać, że następny znak powinien być traktowany dosłownie w informatyce."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экранировать",
                                "target_lang_sense_clarification": "символ в коде"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "eskapić",
                                "target_lang_sense_clarification": "slang informatyczny"
                            },
                            {
                                "target_lang_word": "maskować",
                                "target_lang_sense_clarification": "znaki w kodzie"
                            },
                            {
                                "target_lang_word": "używać znaków ucieczki",
                                "target_lang_sense_clarification": "termin techniczny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24fa224d-0747-3202-84e3-6b96ebd2af82",
                    "sense_definition": "The act of getting away from a dangerous or unpleasant situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "get free",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoners made their <w>escape</w> by digging a tunnel under the fence.",
                            "target_lang_translations": {
                                "ru": "Заключенные совершили <w>побег</w>, прокопав туннель под забором.",
                                "pl": "Więźniowie dokonali <w>ucieczki</w>, kopiąc tunel pod ogrodzeniem."
                            }
                        },
                        {
                            "text": "She had a narrow <w>escape</w> when the car nearly hit her.",
                            "target_lang_translations": {
                                "ru": "Она чудом <w>спаслась</w>, когда машина чуть не сбила её.",
                                "pl": "O włos uniknęła wypadku i cudem się <w>uratowała</w>, gdy o mało nie potrącił jej samochód."
                            }
                        }
                    ],
                    "common_phrases": [
                        "narrow escape",
                        "make an escape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт ухода из опасной или неприятной ситуации.",
                        "pl": "Czynność wydostania się z niebezpiecznej lub nieprzyjemnej sytuacji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побег",
                                "target_lang_sense_clarification": "из места заключения"
                            },
                            {
                                "target_lang_word": "бегство",
                                "target_lang_sense_clarification": "поспешный уход"
                            },
                            {
                                "target_lang_word": "спасение",
                                "target_lang_sense_clarification": "избежание гибели"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ucieczka",
                                "target_lang_sense_clarification": "z więzienia lub niewoli"
                            },
                            {
                                "target_lang_word": "wydostanie się",
                                "target_lang_sense_clarification": "z opresji"
                            },
                            {
                                "target_lang_word": "ratunek",
                                "target_lang_sense_clarification": "uniknięcie zagrożenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99790212-c75f-37d6-9438-bf7fb9b3212c",
                    "sense_definition": "A way of forgetting about your problems or a holiday away from daily life.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reading is a great <w>escape</w> from the stress of work.",
                            "target_lang_translations": {
                                "ru": "Чтение — отличная <w>отдушина</w> от рабочего стресса.",
                                "pl": "Czytanie to świetna <w>odskocznia</w> od stresu w pracy."
                            }
                        },
                        {
                            "text": "The weekend trip to the mountains was a perfect <w>escape</w>.",
                            "target_lang_translations": {
                                "ru": "Поездка в горы на выходные была идеальной <w>сменой обстановки</w>.",
                                "pl": "Weekendowy wypad w góry był idealną <w>ucieczką</w> od codzienności."
                            }
                        }
                    ],
                    "common_phrases": [
                        "perfect escape",
                        "weekend escape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ забыть о проблемах или отдых от повседневной жизни.",
                        "pl": "Sposób na zapomnienie o problemach lub wyjazd wypoczynkowy od codzienności."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдушина",
                                "target_lang_sense_clarification": "способ отвлечься"
                            },
                            {
                                "target_lang_word": "бегство от реальности",
                                "target_lang_sense_clarification": "эскапизм"
                            },
                            {
                                "target_lang_word": "смена обстановки",
                                "target_lang_sense_clarification": "отдых"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odskocznia",
                                "target_lang_sense_clarification": "od codziennych problemów"
                            },
                            {
                                "target_lang_word": "ucieczka",
                                "target_lang_sense_clarification": "od rzeczywistości"
                            },
                            {
                                "target_lang_word": "wypad",
                                "target_lang_sense_clarification": "krótki wyjazd wypoczynkowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9be6e4f-7db3-3881-bc85-921e5e5950a2",
                    "sense_definition": "A leak or outflow of a gas or liquid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "leakage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician checked the pipes for any <w>escape</w> of gas.",
                            "target_lang_translations": {
                                "ru": "Техник проверил трубы на наличие <w>утечки</w> газа.",
                                "pl": "Technik sprawdził rury pod kątem ewentualnego <w>wycieku</w> gazu."
                            }
                        },
                        {
                            "text": "An <w>escape</w> of steam from the valve caused a loud whistling sound.",
                            "target_lang_translations": {
                                "ru": "<w>Выход</w> пара из клапана вызвал громкий свистящий звук.",
                                "pl": "<w>Ulatnianie się</w> pary z zaworu spowodowało głośny gwizd."
                            }
                        }
                    ],
                    "common_phrases": [
                        "escape of gas",
                        "escape of steam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утечка или выход газа или жидкости.",
                        "pl": "Wyciek lub wydostanie się gazu lub cieczy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "газа или воды"
                            },
                            {
                                "target_lang_word": "выход",
                                "target_lang_sense_clarification": "пара или газа"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyciek",
                                "target_lang_sense_clarification": "płynu lub gazu"
                            },
                            {
                                "target_lang_word": "ulotnienie się",
                                "target_lang_sense_clarification": "gazu"
                            },
                            {
                                "target_lang_word": "wydostawanie się",
                                "target_lang_sense_clarification": "substancji z naczynia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80e52af5-0b43-3180-bdd4-3bb341cafca1",
                    "sense_definition": "The key on a computer keyboard used to cancel an action or close a menu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Press <w>escape</w> to exit the full-screen mode.",
                            "target_lang_translations": {
                                "ru": "Нажмите <w>эскейп</w>, чтобы выйти из полноэкранного режима.",
                                "pl": "Naciśnij <w>escape</w>, aby wyjść z trybu pełnoekranowego."
                            }
                        },
                        {
                            "text": "If the program freezes, try hitting the <w>escape</w> key.",
                            "target_lang_translations": {
                                "ru": "Если программа зависнет, попробуйте нажать клавишу <w>Esc</w>.",
                                "pl": "Jeśli program się zawiesi, spróbuj nacisnąć <w>klawisz Esc</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "press escape",
                        "escape key"
                    ],
                    "target_lang_definitions": {
                        "ru": "Клавиша на клавиатуре компьютера, используемая для отмены действия или закрытия меню.",
                        "pl": "Klawisz na klawiaturze komputera służący do anulowania akcji lub zamykania menu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эскейп",
                                "target_lang_sense_clarification": "название клавиши"
                            },
                            {
                                "target_lang_word": "клавиша Esc",
                                "target_lang_sense_clarification": "компьютерный термин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Escape",
                                "target_lang_sense_clarification": "nazwa klawisza"
                            },
                            {
                                "target_lang_word": "klawisz Esc",
                                "target_lang_sense_clarification": "termin komputerowy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}