    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8778174a-adf7-3b8f-a288-7a33ed9496d1",
                    "sense_definition": "Een gemeen of onbetrouwbaar persoon die moreel verwerpelijk gedrag vertoont.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon_met_slecht_gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>smeerlap</w> heeft al mijn geld gestolen en is daarna spoorloos verdwenen.",
                            "target_lang_translations": {
                                "en": "That <w>bastard</w> stole all my money and then vanished without a trace."
                            }
                        },
                        {
                            "text": "Iedereen wist dat hij een <w>smeerlap</w> was, maar niemand durfde er iets van te zeggen.",
                            "target_lang_translations": {
                                "en": "Everyone knew he was a <w>scoundrel</w>, but no one dared to say anything about it."
                            }
                        }
                    ],
                    "synonyms": [
                        "rotzak"
                    ],
                    "common_phrases": [
                        "een gemene smeerlap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt als scheldwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A mean, untrustworthy, or morally reprehensible person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bastard",
                                "target_lang_sense_clarification": "vulgar, highly offensive term for a despicable person"
                            },
                            {
                                "target_lang_word": "scoundrel",
                                "target_lang_sense_clarification": "dishonorable or unprincipled person"
                            },
                            {
                                "target_lang_word": "jerk",
                                "target_lang_sense_clarification": "informal term for a mean or obnoxious person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf2944e5-8f80-36f9-938f-200701b50ba4",
                    "sense_definition": "Iemand die zichzelf of zijn omgeving erg vies maakt; een onhygiënisch persoon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vies_persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Was je handen eens, je bent echt een <w>smeerlap</w> als je zo aan tafel gaat zitten.",
                            "target_lang_translations": {
                                "en": "Go wash your hands, you are a real <w>grubby person</w> if you sit at the table like that."
                            }
                        },
                        {
                            "text": "De kinderen speelden in de modder en kwamen als echte <w>smeerlappen</w> weer naar binnen.",
                            "target_lang_translations": {
                                "en": "The children played in the mud and came back inside looking like real <w>mucky pups</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "smeerkees",
                        "smeerpoets",
                        "vuilak",
                        "viezerik"
                    ],
                    "common_phrases": [
                        "een vieze smeerlap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel gebruikt voor iemand die vies is"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who makes themselves or their surroundings very dirty; an unhygienic person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grubby person",
                                "target_lang_sense_clarification": "someone who is physically dirty or messy"
                            },
