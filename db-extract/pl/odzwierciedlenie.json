        "pl-extract.jsonl": [
            {
                "entry_id": "ae1cde67-029e-3d14-9893-05b0ea7bd4b1",
                "word": "odzwierciedlenie",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ae0a98d5-ab07-3c45-b8c2-d4720bdd034a",
                        "entry_id": "ae1cde67-029e-3d14-9893-05b0ea7bd4b1",
                        "glosses": [
                            "dokładne przedstawienie, wyrażenie czegoś; wierny obraz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a900d91c-5ce8-4f5c-84a5-2352add18bce",
                                "sense_id": "ae0a98d5-ab07-3c45-b8c2-d4720bdd034a",
                                "text": "Jest odzwierciedleniem naszej epoki, ostatnim niewinnym w czasach, kiedy Ameryka utraciła swą niewinność"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c501c8c8-5229-348d-a603-4edd26aad849",
                        "entry_id": "ae1cde67-029e-3d14-9893-05b0ea7bd4b1",
                        "glosses": [
                            "obraz odbity w tafli czegoś"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "676defe0-1716-4c98-9326-f235bc5007ef",
                        "source_entry_id": "ae1cde67-029e-3d14-9893-05b0ea7bd4b1",
                        "source_sense_id": "ae0a98d5-ab07-3c45-b8c2-d4720bdd034a",
                        "target_lang_word": "reflection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reflection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d9a05a6-f1de-3e95-a0d3-835f5c2c48b8",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The act of reflecting or the state of being reflected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04accaef-5b08-3a53-8d65-2dc9e3f535d9",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The property of a propagated wave being thrown back from a surface (such as a mirror)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39485565-099e-387b-8983-6531d2e54442",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "Something, such as an image, that is reflected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f049bd06-037c-4698-8e82-5855b570b943",
                                                "sense_id": "39485565-099e-387b-8983-6531d2e54442",
                                                "text": "The dog barked at his own reflection in the mirror."
                                            },
                                            {
                                                "example_id": "fada00df-0069-4381-b16b-ac431e3f859f",
                                                "sense_id": "39485565-099e-387b-8983-6531d2e54442",
                                                "text": "A body of black that carried no reflection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e446014-0858-36e7-927d-d2a836500b52",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "Careful thought or consideration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "642fc9da-1073-467f-bfcc-1aca32e4159d",
                                                "sense_id": "2e446014-0858-36e7-927d-d2a836500b52",
                                                "text": "After careful reflection, I have decided not to vote for that proposition."
                                            },
                                            {
                                                "example_id": "c2e42dd5-b911-4dc2-a15a-9dfd14287fe4",
                                                "sense_id": "2e446014-0858-36e7-927d-d2a836500b52",
                                                "text": "But Richmond, his grandfather's darling, after one thoughtful glance cast under his lashes at that uncompromising countenance appeared to lose himself in his own reflections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a98e8b6-ce5f-31c8-a788-5ab948a3763a",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "A representative manifestation or outcome of a condition, trend or trait."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5a0e80-9377-4914-80f6-d2ca735cab39",
                                                "sense_id": "2a98e8b6-ce5f-31c8-a788-5ab948a3763a",
                                                "text": "Our recent results are a reflection of the progress we've made as a team."
                                            },
                                            {
                                                "example_id": "8596d24a-1480-4e82-a4ed-e8d67d373d28",
                                                "sense_id": "2a98e8b6-ce5f-31c8-a788-5ab948a3763a",
                                                "text": "Zuckerberg said last month that the name change was a reflection of how much Facebook had evolved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26e47bea-06fc-3804-b69c-ca70c2b863e7",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "A representative manifestation or outcome of a condition, trend or trait.",
                                            "Used to make an implied criticism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "209d4a4b-ef36-4d22-b4b1-6eb9e33dd7fb",
                                                "sense_id": "26e47bea-06fc-3804-b69c-ca70c2b863e7",
                                                "text": "It is a reflection on his character that he never came back to see them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f635385d-64fa-3950-b7fc-1b034fca1fba",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The process or mechanism of determining the capabilities of an object at run-time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f713b35-1477-44de-b3e2-dc9a724c2e46",
                                                "sense_id": "f635385d-64fa-3950-b7fc-1b034fca1fba",
                                                "text": "DynamicMBeanFacade uses Java's reflection API to introspect the managed resource and discover data type information for attributes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e18a4f05-9b6e-31d4-8594-bd0377670c51",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The folding of a part; a fold."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9164650b-1cfc-4635-81c5-ee043b9c7e54",
                        "source_entry_id": "ae1cde67-029e-3d14-9893-05b0ea7bd4b1",
                        "source_sense_id": "ae0a98d5-ab07-3c45-b8c2-d4720bdd034a",
                        "target_lang_word": "reflexion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reflexion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1d13f9a-9dbc-316b-adcf-2a4ce022ddae",
                                        "entry_id": "d3a4ddb4-43af-3303-b174-90e856419adf",
                                        "glosses": [
                                            "Alternative spelling of reflection."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "027ebda0-d78a-4fcc-bcb1-f6ba30ee8014",
                                                "sense_id": "c1d13f9a-9dbc-316b-adcf-2a4ce022ddae",
                                                "text": "He gets off the train, determined not to leave town after all. But a little further reflexion shows him the folly of such a course."
                                            },
                                            {
                                                "example_id": "8e5211e6-6185-4c16-b7a6-438a8c9a1c57",
                                                "sense_id": "c1d13f9a-9dbc-316b-adcf-2a4ce022ddae",
                                                "text": "Now, I say, why Time should be so burthensome to such as these, or what should betray them to such infrugal Expences of it, I can give no account without making severe Reflexions on their Discretion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57e6c7f7-f58c-3f69-a23e-ddba295937c2",
                                        "entry_id": "d3a4ddb4-43af-3303-b174-90e856419adf",
                                        "glosses": [
                                            "An act or instance of referring back to the subject of a sentence, or of having an object equal to the subject."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
