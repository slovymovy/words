                                        "glosses": [
                                            "Qui montre ou exprime de l’empathie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f960a6b7-a096-410c-84cb-926afc9b9d2f",
                                                "sense_id": "6b81737a-ee35-3f4e-a72e-b6e8095ab28b",
                                                "text": "La clef d’une meilleure communication entre époux se trouve dans le développement de l’écoute empathique ou compréhensive."
                                            },
                                            {
                                                "example_id": "a17d8fac-ea5e-4ba3-b6a1-014198d5ca02",
                                                "sense_id": "6b81737a-ee35-3f4e-a72e-b6e8095ab28b",
                                                "text": "\"On est toujours à évaluer le dossier … On est empathique de ce que vit la famille car on ne souhaite pas éterniser les délais, mais c'est malheureusement la machine administrative qui fait en sorte que cela prend du temps pour obtenir des réponses\", ajoute-t-elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "172713ec-3805-4909-a667-721a5abde55d",
                        "source_entry_id": "543a27bf-aee4-3cc6-93c8-dad21b665728",
                        "source_sense_description": "showing or expressing empathy",
                        "target_lang_word": "empathisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empathisch",
