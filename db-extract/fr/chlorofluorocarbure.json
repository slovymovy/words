                                        "glosses": [
                                            "Kohlenwasserstoff mit Fluor und Chlor als Substituenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a768b50-aa53-4f5c-b688-b423e4fe1c4b",
                                                "sense_id": "965a4ae8-7c89-363d-8fd0-097a5966819f",
                                                "text": "Fluorchlormethan und Fluorchlorethan mit den Summenformeln FClCH₂ und FClC₂H₄ sind Fluorchlorkohlenwasserstoffe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
