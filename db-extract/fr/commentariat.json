                "senses": [
                    {
                        "sense_id": "f256c321-7227-3e61-a9da-9f18372ca209",
                        "entry_id": "361e9901-f291-35b4-8662-57a277787674",
                        "glosses": [
                            "Ensemble des personnes (journalistes, politicologues, critiques littéraires, blogueurs, etc.) qui présentent des analyses ou des opinions dans les médias."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "042f704d-9049-405f-a3bd-57aea8a8f395",
                                "sense_id": "f256c321-7227-3e61-a9da-9f18372ca209",
                                "text": "Il n’en fallait pas plus pour que divers membres du commentariat officiel proclament, pour la énième fois, l’impasse absolue dans laquelle se trouve selon eux le mouvement indépendantiste."
                            },
                            {
                                "example_id": "9a9e2562-1d11-4678-96d5-6101e770dbcb",
                                "sense_id": "f256c321-7227-3e61-a9da-9f18372ca209",
                                "text": "Pendant ce temps, le commentariat médiatique est plié en deux parce que des politiciennes travaillent à modifier les codes pour plus d’égalité."
                            },
                            {
                                "example_id": "e5cfa345-2501-4dc9-bf89-89d29867c665",
                                "sense_id": "f256c321-7227-3e61-a9da-9f18372ca209",
                                "text": "Le commentariat surtout anglophone de Toronto devra canaliser ailleurs que sur la scène fédérale son indignation."
                            },
                            {
                                "example_id": "26cf1126-091b-4b48-b7cc-bd62d619cce0",
                                "sense_id": "f256c321-7227-3e61-a9da-9f18372ca209",
                                "text": "Voyez comme ils sont pittoresques, ces députés RN. C’est comme cette histoire de cravates (Le Pen a demandé à “ses” députés masculins de porter cravate, consigne aussitôt rapportée et disséquée par tout le commentariat)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6865db2-7e2e-4924-a9e9-1408af35d8a1",
                        "source_entry_id": "361e9901-f291-35b4-8662-57a277787674",
                        "source_sense_id": "f256c321-7227-3e61-a9da-9f18372ca209",
