                            {
                                "example_id": "312967d5-2b0f-4b7a-b400-96090a94cecf",
                                "sense_id": "9347b369-04ce-38c3-b00c-b318f2880c86",
                                "text": "De wereldberoemde Russische clown Oleg Popov is op 86-jarige leeftijd overleden in Rostov aan de Don. Dat heeft directeur Edward Zapasjni van het Moskouse Staatscircus bekendgemaakt."
                            },
                            {
                                "example_id": "bf216962-6a32-4537-b02b-40aefadde28c",
                                "sense_id": "9347b369-04ce-38c3-b00c-b318f2880c86",
                                "text": "Dat kwam goed uit, want het Russische staatscircus treedt deze maand op in Tver:"
                            },
                            {
                                "example_id": "03893974-048d-4754-b479-3dc72fffe185",
                                "sense_id": "9347b369-04ce-38c3-b00c-b318f2880c86",
                                "text": "Het Staatscircus van Moskou heeft in Tilburg zijn voorstelingen van vandaag, morgen en woensdag afgelast. Volgens het circus is het beter dat bezoekers niet naar de tent komen. De dieren hebben geen problemen met de kou."
                            }
                        ]
