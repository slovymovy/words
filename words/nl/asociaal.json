{
    "word_family": [
        "asocialiteit",
        "sociaal",
        "socialiseren",
        "socialisme",
        "socialist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8cc4c27d-00d9-3e1c-abf0-c89b045f6bb1",
                    "sense_definition": "zonder sociaal besef of rekening te houden met anderen; vaak hinderlijk of egoïstisch gedrag vertonend",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is erg <w>asociaal</w> om je afval zomaar op straat te gooien.",
                            "target_lang_translations": {
                                "en": "It is very <w>antisocial</w> to just throw your trash on the street."
                            }
                        },
                        {
                            "text": "Sommige mensen vertonen in het verkeer heel <w>asociaal</w> gedrag door anderen af te snijden.",
                            "target_lang_translations": {
                                "en": "Some people show very <w>inconsiderate</w> behavior in traffic by cutting others off."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbeschoft",
                        "egoïstisch",
                        "onaangepast"
                    ],
                    "antonyms": [
                        "sociaal",
                        "beleefd",
                        "attent"
                    ],
                    "common_phrases": [
                        "asociaal gedrag",
                        "heel asociaal",
                        "asociaal rijden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt als verwijt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "lacking social awareness or consideration for others; often exhibiting disruptive or selfish behavior"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "antisocial",
                                "target_lang_sense_clarification": "behaving in a way that is harmful or annoying to others"
                            },
                            {
                                "target_lang_word": "inconsiderate",
                                "target_lang_sense_clarification": "not thinking of other people's feelings or needs"
                            },
                            {
                                "target_lang_word": "selfish",
                                "target_lang_sense_clarification": "caring only about oneself"
                            },
                            {
                                "target_lang_word": "rude",
                                "target_lang_sense_clarification": "lacking manners or politeness"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6003696a-00fc-382a-85fb-6bc82412ee54",
                    "sense_definition": "iemand die zich niet aanpast aan de sociale normen en daardoor overlast veroorzaakt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De buurt klaagde over de nieuwe bewoner en noemde hem een echte <w>asociaal</w>.",
                            "target_lang_translations": {
                                "en": "The neighborhood complained about the new resident and called him a real <w>antisocial person</w>."
                            }
                        },
                        {
                            "text": "Die <w>asociaal</w> parkeerde zijn auto midden op de stoep.",
                            "target_lang_translations": {
                                "en": "That <w>jerk</w> parked his car right in the middle of the sidewalk."
                            }
                        }
                    ],
                    "synonyms": [
                        "tokkie",
                        "onverlaat"
                    ],
                    "common_phrases": [
                        "een echte asociaal"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak pejoratief bedoeld"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a person who does not conform to social norms and thereby causes a nuisance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "antisocial person",
                                "target_lang_sense_clarification": "someone who behaves without regard for others"
                            },
                            {
                                "target_lang_word": "nuisance",
                                "target_lang_sense_clarification": "a person causing inconvenience or annoyance"
                            },
                            {
                                "target_lang_word": "chav",
                                "target_lang_sense_clarification": "British slang for a person perceived as coarse or low-class"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}