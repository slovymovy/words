                "senses": [
                    {
                        "sense_id": "f0c679bb-d4a0-3432-b607-b5da947c9493",
                        "entry_id": "e769ea33-da82-3224-b127-278d1cbddf07",
                        "glosses": [
                            "Regent meist über ein kleines Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea137e7-c06d-4879-9ee9-06dacd0c54e9",
                                "sense_id": "f0c679bb-d4a0-3432-b607-b5da947c9493",
                                "text": "„In den Herren von Friesack und von Plotho hat man zur Erklärung ihrer Stellung ebenfalls Nachkommen wendischer Dynasten erblickt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "063b8193-41c6-4b1b-8330-dfd35a487053",
                        "source_entry_id": "e769ea33-da82-3224-b127-278d1cbddf07",
                        "source_sense_id": "f0c679bb-d4a0-3432-b607-b5da947c9493",
                        "source_sense_description": "Regent meist über ein kleines Gebiet",
                        "target_lang_word": "dynast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69bb0bd9-ac38-39d1-b7fd-3f354127d40b",
                                        "entry_id": "1e8050bb-1a38-3a99-8385-766e6eaaef37",
                                        "glosses": [
                                            "A ruler or governor, especially a hereditary ruler or someone who founded or is part of a dynasty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9b9eba-c53a-42aa-97d7-99d504380407",
                                                "sense_id": "69bb0bd9-ac38-39d1-b7fd-3f354127d40b",
                                                "text": "Now the dynasts who rule each country are cementing political ties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a776da71-b4b7-4806-ba6c-75c9f3d20634",
                        "source_entry_id": "e769ea33-da82-3224-b127-278d1cbddf07",
                        "source_sense_id": "f0c679bb-d4a0-3432-b607-b5da947c9493",
                        "source_sense_description": "Regent meist über ein kleines Gebiet",
                        "target_lang_word": "dynaste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynaste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7eb05b2-2d96-3ec5-bbeb-11801deb3eb3",
                                        "entry_id": "117c8a0f-a4c8-34ef-90cc-f50416e164f5",
                                        "glosses": [
                                            "Qualifie une personne, une branche, etc., d’une famille régnante ou ayant régné qui possède des droits successoraux ; terme souvent précédé de non."
                                        ],
                                        "tags": [
                                            "Généalogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97edd898-dc9a-423c-93f7-0c6a33b9b24d",
                                                "sense_id": "f7eb05b2-2d96-3ec5-bbeb-11801deb3eb3",
                                                "text": "La maison de Bourbon Busset est la branche aînée, mais non dynaste, de la maison capétienne de Bourbon, qui remonte à Saint Louis par Robert de France, comte de Clermont dont le frère aîné fut Philippe III le Hardi."
                                            },
                                            {
                                                "example_id": "e4a63a74-e3dd-4c95-ae62-baa5e9ad7b5f",
                                                "sense_id": "f7eb05b2-2d96-3ec5-bbeb-11801deb3eb3",
                                                "text": "Autre enfant non dynaste, son demi-frère, Alexandre Coste, 11 ans, qu’Albert a eu avec une ancienne hôtesse de l’air d’origine togolaise."
                                            },
                                            {
                                                "example_id": "b76f6e29-a449-4fb5-b64e-620b436c633a",
                                                "sense_id": "f7eb05b2-2d96-3ec5-bbeb-11801deb3eb3",
                                                "text": "Le nouvel empire du Mexique devait s’appuyer - outre sur le Vieux Monde, y compris le khédive d’Égypte qui lui envoya des soldats - sur l’empire indépendant, déjà fort, et lui aussi latino-catholique, installé au Brésil depuis le début du XIXᵉ siècle par des dynastes portugais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dynaste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfc193a5-8a64-39e9-913a-bb21d728cc7e",
                                        "entry_id": "2a6b9111-391b-3474-a66e-31b6741a8c16",
                                        "glosses": [
                                            "Petit souverain qui gouvernait sous la dépendance d’un État plus puissant."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7125a90-dce5-40b8-8d48-754dd9b582f1",
                                                "sense_id": "dfc193a5-8a64-39e9-913a-bb21d728cc7e",
                                                "text": "Thyus, issu de cet antique Pylémène, qu’Homère dit avoir été tué par Patrocle dans la guerre de Troie, était alors dynaste de la Paphlagonie"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7fbf51c-3a62-3bd8-b954-d5a043eb3f78",
                                        "entry_id": "2a6b9111-391b-3474-a66e-31b6741a8c16",
                                        "glosses": [
                                            "Souverain local très puissant."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f42f49aa-34c4-47ac-8c5c-4b8b1c349f83",
                                                "sense_id": "f7fbf51c-3a62-3bd8-b954-d5a043eb3f78",
                                                "text": "L’État au sens du règne d’un dynaste, d’un satrape ou d’un despote, n’en semble pas moins être la structure la plus durable d’organisation du pouvoir dans l’islam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b110b304-051f-354e-a14e-be0a7fb4155b",
                                        "entry_id": "2a6b9111-391b-3474-a66e-31b6741a8c16",
                                        "glosses": [
                                            "Scarabée d’Amérique centrale, de grande taille, dont le mâle porte deux longues cornes formant une pince puissante."
                                        ],
                                        "tags": [
                                            "Coléoptérologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af979cc8-b27d-4984-957c-9a4e69dd5bd1",
                                                "sense_id": "b110b304-051f-354e-a14e-be0a7fb4155b",
                                                "text": "Alors que le dynaste Hercule, gros scarabée d’Amérique du Sud et d’Amérique centrale, est capable, lui, de soulever jusqu’à 850 fois son poids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
