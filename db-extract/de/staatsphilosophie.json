                "senses": [
                    {
                        "sense_id": "9ecf5e19-78f2-3ac9-a4cd-56b2b493c6cf",
                        "entry_id": "4c1a1713-7427-3116-bebd-394c6226d32b",
                        "glosses": [
                            "die philosophische Lehre vom Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4005d091-31f6-4f91-977c-378d9dc1ef9a",
                                "sense_id": "9ecf5e19-78f2-3ac9-a4cd-56b2b493c6cf",
                                "text": "Die Staatsphilosophie „ist gegenüber den staatsbezogenen Theorien modernere Einzelwissenschaften wie Politik-, Rechts- und Wirtschaftswissenschaft durch ihre auf das Allgemeine, Grundlegende und Normative gerichtete Betrachtungsweise abgrenzbar; […]“"
                            },
                            {
                                "example_id": "1986943e-e246-4841-8267-724bb31fcbc7",
                                "sense_id": "9ecf5e19-78f2-3ac9-a4cd-56b2b493c6cf",
                                "text": "„Philip hatte mich in einer Vorlesung zur Staatsphilosophie, die ich in meinem zweiten Semester aus purer Neugier besuchte und die nichts mit meinem Studiengang zu tun hatte, angesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7fe9b0f4-b299-3f91-83e9-6116534d4e19",
                        "entry_id": "4c1a1713-7427-3116-bebd-394c6226d32b",
                        "glosses": [
                            "spezielle Staatstheorie auf philosophischer Grundlage (bspw. die Staatstheorie Rousseaus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e1a69ff-b69a-4c5d-848e-796014f30e81",
                                "sense_id": "7fe9b0f4-b299-3f91-83e9-6116534d4e19",
                                "text": "„Sie erklärt nicht etwa, Hobbes wolle durch Rückgriff auf den biblischen Mythos seine rationale Staatsphilosophie zusätzlich absichern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
