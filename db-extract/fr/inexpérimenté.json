                    {
                        "translation_id": "182ee725-42e9-458d-9fc7-2eecef3a9789",
                        "source_entry_id": "5054268d-2072-3f38-acfa-937860dc883f",
                        "source_sense_id": "7677d60b-3b3f-32da-871c-25c685a8c1cd",
                        "target_lang_word": "inexperienced",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexperienced",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2eea235-90fa-3268-9192-9eedee2da134",
                                        "entry_id": "5fe9830e-954b-3113-b679-e10ee6c97e1b",
                                        "glosses": [
                                            "Not experienced; lacking knowledge because lacking experience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad7e990-0d3c-43e0-a45b-10a9bc240034",
                                                "sense_id": "f2eea235-90fa-3268-9192-9eedee2da134",
                                                "text": "Veteran Wiktionary editors frustrated with inexperienced newcomers should remember that they were once in that position."
                                            },
                                            {
                                                "example_id": "9d11a508-cc58-41d5-96f9-faf94907f4e8",
                                                "sense_id": "f2eea235-90fa-3268-9192-9eedee2da134",
                                                "text": "A group of young, inexperienced volunteers was tasked with securing much-needed medical supplies for hospitals fighting coronavirus, hampering the government’s response to a growing pandemic, according to reports by The New York Times and The Washington Post."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1272bef9-da80-4b7d-b3f5-8f7bb6ea8b07",
                        "source_entry_id": "5054268d-2072-3f38-acfa-937860dc883f",
                        "source_sense_id": "7677d60b-3b3f-32da-871c-25c685a8c1cd",
                        "target_lang_word": "fledgling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fledgling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9183c393-abc6-3a8c-b129-aec581f4b9ee",
                                        "entry_id": "382968ab-320f-3e3c-b9e8-9539903afb1a",
                                        "glosses": [
                                            "Untried or inexperienced."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0b730cf-b64e-4720-9dfc-3a745631f784",
                                                "sense_id": "9183c393-abc6-3a8c-b129-aec581f4b9ee",
                                                "text": "His trenchant criticisms of the Church's repression […] include a discussion of the considerable 1938 success of the fledgling NODL in getting magazines removed from various points of sale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "289f2454-3e8a-3ee2-862d-3b998ed83bd8",
                                        "entry_id": "382968ab-320f-3e3c-b9e8-9539903afb1a",
                                        "glosses": [
                                            "Emergent or rising."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33510df5-6033-4114-9664-30f0be7e82a9",
                                                "sense_id": "289f2454-3e8a-3ee2-862d-3b998ed83bd8",
                                                "text": "Harry Boland was born in Dublin in 1884 and educated with his younger brother Gerry in Clontarf. His father James, who greatly influenced him was politically active in the Irish Republican Brotherhood and the fledgling GAA. Harry Boland fought at the GPO in April 1916 and was interned in Dartmoor and Lewes jail."
                                            },
                                            {
                                                "example_id": "6909fad4-250f-477c-b179-956d6bc3254e",
                                                "sense_id": "289f2454-3e8a-3ee2-862d-3b998ed83bd8",
                                                "text": "Less than 24 hours later, Aker’s fledgling green energy and technology unit, Aker Horizons, revealed it had landed a bigger catch, with its planned purchase of Roscommon native Eddie O’Connor’s Mainstream Renewable Power for up to €1 billion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fledgling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ec13866-b8f3-341c-b4ea-58c72677074e",
                                        "entry_id": "05e357e8-bcef-3638-8ff7-30a293ec2d02",
                                        "glosses": [
                                            "A young bird which has just developed its flight feathers (notably wings)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aac53eff-79e2-3949-8775-d02801d21bfa",
                                        "entry_id": "05e357e8-bcef-3638-8ff7-30a293ec2d02",
                                        "glosses": [
                                            "An insect that has just fledged, i.e. undergone its final moult to become an adult or imago."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5f6fe33-9e35-3782-a49e-d429aa28cc97",
                                        "entry_id": "05e357e8-bcef-3638-8ff7-30a293ec2d02",
                                        "glosses": [
                                            "An immature, naïve or inexperienced person."
                                        ],
