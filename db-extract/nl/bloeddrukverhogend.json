                        "sense_id": "47ff63f0-7c43-3212-a9fb-06d33e0f72fb",
                        "entry_id": "aa86d50c-d4d4-3c25-8ab5-9edd07da6187",
                        "glosses": [
                            "van iets dat het de druk in het bloedvatstelsel hoger maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3097141e-8f89-4321-bbc6-58497ea77a6b",
                                "sense_id": "47ff63f0-7c43-3212-a9fb-06d33e0f72fb",
                                "text": "Tierolf wijst er op dat kalium een van de weinige geschikte alternatieven is voor natrium, onder andere voor conservering. Natrium is bij te veel gebruik bloeddrukverhogend."
                            },
                            {
                                "example_id": "c0f15c10-089c-413a-8546-a07c5eb1044c",
                                "sense_id": "47ff63f0-7c43-3212-a9fb-06d33e0f72fb",
                                "text": "Koude werkt namelijk bloeddrukverhogend - in de winter vernauwen onze bloedvaten, zodat minder warmte verloren gaat - en het gezicht is een uitstekende plek voor snelle warmte- (of koude-)uitwisseling."
                            }
                        ]
                    }
