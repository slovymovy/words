                    {
                        "sense_id": "8c822d31-42de-3324-91b1-fc47689be67b",
                        "entry_id": "205a4428-cee8-3f5b-987d-acfff27c279b",
                        "glosses": [
                            "znajdujący się na plaży, związany z plażą, odbywający się na plaży"
