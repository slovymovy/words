                                "target_senses": [
                                    {
                                        "sense_id": "4bbb72ec-51ae-3384-9ee7-f519450b424a",
                                        "entry_id": "108169e2-62c4-39a4-8a00-705e16b8b169",
                                        "glosses": [
                                            "een balk waaraan goederen omhoog of omlaag kunnen worden getransporteerd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47ccd21a-01b7-4b0c-bac3-98c3fe335527",
                                                "sense_id": "4bbb72ec-51ae-3384-9ee7-f519450b424a",
                                                "text": "Kunnen we hem aan de hijsbalk optakelen? Misschien verloor de droom zijn geloofwaardigheid doordat het bellen, ondanks de geopende deur, almaar doorging, en was dat eerder dan het bellen zelf de oorzaak van zijn ontwaken."
                                            },
                                            {
                                                "example_id": "0e373ce7-5227-4dfd-ac95-3a5217b77287",
                                                "sense_id": "4bbb72ec-51ae-3384-9ee7-f519450b424a",
                                                "text": "De hijsbalken verraden dat het vroeger een pakhuis was."
                                            },
                                            {
                                                "example_id": "9be23557-9de8-4a00-8e98-501836122458",
                                                "sense_id": "4bbb72ec-51ae-3384-9ee7-f519450b424a",
                                                "text": "Het afmonteren van de Pieter Schelte vindt plaats op het binnenmeer van de Tweede Maasvlakte. Speciaal voor het schip wordt daar een put gebaggerd. In de Rotterdamse haven zullen de 65 meter lange balken van het hefsysteem worden geïnstalleerd. De hijsbalken worden in Italië gebouwd en komen per schip naar Nederland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
