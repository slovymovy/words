                            {
                                "target_lang_word": "читала",
                                "target_lang_sense_clarification": "прошедшее время, женский род"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fb368c5-e5fd-31ce-9db6-7ea171bb231b",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>lassen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "welding_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>las</w> de twee metalen platen stevig aan elkaar vast.",
