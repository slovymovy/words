                        ],
                        "form": "die Sommervögel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a9693c2-2f82-39c5-91a5-66d5f2b985a6",
                        "entry_id": "84fc7e4d-26bd-37ae-b752-45cef8f55fef",
                        "glosses": [
                            "Vogel, der nur über den Sommer in unseren Regionen bleibt"
                        ],
                        "tags": [
                            "Vogelkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "eba8e5a0-5649-4076-bc39-28ace07e4403",
                                "sense_id": "6a9693c2-2f82-39c5-91a5-66d5f2b985a6",
                                "text": "„Zahlreiche Sommervögel landeten und zeigten die Pracht und die Unterseite ihrer Flügel.“"
                            },
                            {
                                "example_id": "63cee586-b406-4b2e-bd30-cbced0421c1e",
                                "sense_id": "6a9693c2-2f82-39c5-91a5-66d5f2b985a6",
                                "text": "„Sonst aber weckten die Sommervögel Frau Holle täglich in der Früh.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32c45169-4f04-3260-8e0f-36a868633286",
                        "entry_id": "84fc7e4d-26bd-37ae-b752-45cef8f55fef",
                        "glosses": [
                            "Schmetterling"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "a4a776aa-dc18-478d-83f3-8114334a5c90",
                                "sense_id": "32c45169-4f04-3260-8e0f-36a868633286",
                                "text": "„Er ist beschrieben irgendwo am Anfang von Gottfried Kellers Geschichte «Der grüne Heinrich»: Eine fröhliche Wiese voller wilder Blumen und Insekten und Sommervögel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3f8205e-e178-4729-840d-47f13a2f3aff",
                        "source_entry_id": "84fc7e4d-26bd-37ae-b752-45cef8f55fef",
                        "source_sense_id": "6a9693c2-2f82-39c5-91a5-66d5f2b985a6",
                        "source_sense_description": "Vogelkunde: Vogel, der nur über den Sommer in unseren Regionen bleibt",
                        "target_lang_word": "oiseau estival",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bfb5d74b-1409-4fa5-9512-0782877cc67b",
                        "source_entry_id": "84fc7e4d-26bd-37ae-b752-45cef8f55fef",
                        "source_sense_id": "32c45169-4f04-3260-8e0f-36a868633286",
                        "source_sense_description": "Insektenkunde, landschaftlich, schlesisch, siebenbürgisch, schweizerisch: Schmetterling",
                        "target_lang_word": "papillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "papillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a3508a6-99f2-3a01-9b70-5f034c0b1bb0",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Insecte qui a quatre ailes couvertes de fines écailles colorées, c’est le stade imaginal du lépidoptère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9131aaf-2eb7-400b-9b4e-84de2752f3ee",
                                                "sense_id": "1a3508a6-99f2-3a01-9b70-5f034c0b1bb0",
                                                "text": "Samuel était hardi comme les papillons, les hannetons et les poëtes ; il se jetait dans toutes les flammes et entrait par toutes les fenêtres."
                                            },
                                            {
                                                "example_id": "d5053647-ec8f-45f9-bd74-51d0f6075511",
                                                "sense_id": "1a3508a6-99f2-3a01-9b70-5f034c0b1bb0",
                                                "text": "Le ver le secrète lorsqu’il est arrivé au moment où il doit se métamorphoser en papillon."
                                            },
                                            {
                                                "example_id": "eae8d363-69a2-430d-be1e-4a9f6395fc2d",
                                                "sense_id": "1a3508a6-99f2-3a01-9b70-5f034c0b1bb0",
                                                "text": "« La vie est partout », elle jaillit même en direct dans un éclosoir où l’on peut voir la métamorphose de la chrysalide en papillon et le premier envol de celui-ci."
                                            },
                                            {
                                                "example_id": "326cd325-2832-4720-8f87-dd3bcbf78e2a",
                                                "sense_id": "1a3508a6-99f2-3a01-9b70-5f034c0b1bb0",
                                                "text": "La reconversion des oublieux a eu, au début du siècle dernier, un introït esthétisant, sans lequel ce retour à la chlorophylle, aux papillons et au bocage, ne nous paraîtrait pas aujourd'hui couler de source."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8108a7e0-d439-3d4a-91d6-13f94cf7ee38",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Personne qui, se laissant tromper par des apparences brillantes, est près de tomber dans un piège."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e6407c1-d852-4632-a345-e1737d82de26",
                                                "sense_id": "8108a7e0-d439-3d4a-91d6-13f94cf7ee38",
                                                "text": "Il va se brûler à la chandelle comme un papillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c25384a1-54dc-3ba6-ae8f-33d274a30569",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Esprit léger qui voltige d’objets en objets."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1dbc183-6031-404a-a46f-1ec28ee19565",
                                                "sense_id": "c25384a1-54dc-3ba6-ae8f-33d274a30569",
                                                "text": "C’est un papillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6087b42a-3957-3f3f-ad69-56707e2ba675",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Bagatelle, considération futile."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88a6835f-2f16-476f-8c90-2180adbec362",
                                                "sense_id": "6087b42a-3957-3f3f-ad69-56707e2ba675",
                                                "text": "Courir après les papillons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e26cd828-4b38-3130-b269-1869ba328e04",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Petit papier détachable à bande semi-adhésive ou simple papier collé à l’intérieur d’un livre, d’une revue, pour donner un avis au lecteur, indiquer un erratum, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a2edd16-9704-40b9-8ad8-32e4c9969508",
                                                "sense_id": "e26cd828-4b38-3130-b269-1869ba328e04",
                                                "text": "Mettre un papillon."
                                            },
                                            {
                                                "example_id": "c5d25344-8181-4003-8b13-376e848d6301",
                                                "sense_id": "e26cd828-4b38-3130-b269-1869ba328e04",
                                                "text": "Le petit caporal chef avait devant lui un énorme registre, des papillons de différentes couleurs et de grandes feuilles imprimées. Par moments il griffonnait quelque chose sur un papillon, recopiait ce qu'il venait d'écrire sur le registre, puis épinglait le papillon sur le registre, prenait une des grandes feuilles imprimées, la sabrait de grands coups de crayon bleu, et l'épinglait à son tour sur le registre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14aa0456-c7af-3f2a-a2db-9c7aedc0af9b",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Procès verbal de contravention que les agents de la circulation glissent sous les essuie-glaces."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c33b109-aa73-442c-b31c-759fc9cc1a19",
                                                "sense_id": "14aa0456-c7af-3f2a-a2db-9c7aedc0af9b",
                                                "text": "Charlotte lui désigne un papillon de contravention sur le pare-brise de la Porsche."
                                            },
                                            {
                                                "example_id": "6967b5d9-dc2c-43f4-b6ba-8561edbe100e",
                                                "sense_id": "14aa0456-c7af-3f2a-a2db-9c7aedc0af9b",
                                                "text": "En posant mes petits papillons Parfois je tombe sur des garçons Qui pour avoir une réduction Me font d'étranges propositions Je prends mon Bic Et je leur dis : « Contravention, sens interdit »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c14fc8ca-1e50-3fd2-9fcc-b8cdb9c3b4f6",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Volet orientable posé dans un conduit et permettant de réguler le débit d’un fluide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b40e1b74-2c8b-4747-bcdf-0dff582082d2",
                                                "sense_id": "c14fc8ca-1e50-3fd2-9fcc-b8cdb9c3b4f6",
                                                "text": "La pédale (auto) ou manette (moto) d’accélérateur n’agit que sur le papillon des gaz, réglant le débit d’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082fec10-0f29-324e-9588-7e9185913883",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Écrou en forme de papillon pouvant être serré sans outil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "925f3edb-b85f-3e6a-88ee-400b346e3a4f",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Style de nage ventrale, où les bras et les jambes agissent symétriquement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0f9ebf-f7e5-4f47-b21d-b004052f4e7a",
                                                "sense_id": "925f3edb-b85f-3e6a-88ee-400b346e3a4f",
                                                "text": "Avec un chrono de 22 sec 97, Maxime Grousset a fini deuxième du 50 m papillon, derrière l’Italien Thomas Ceccon, sacré champion d’Europe en 22 sec 89."
                                            },
                                            {
                                                "example_id": "17c410e2-01ac-43a6-be31-7aaa58df81f9",
                                                "sense_id": "925f3edb-b85f-3e6a-88ee-400b346e3a4f",
                                                "text": "Camille Replumaz, grand espoir du club détient, après deux années d'entraînement, quatre records de l’histoire de l’UAS dans sa catégorie en dos et en papillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8775e073-b473-35fa-bc4f-528b31b16b25",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Sorte de bec de gaz dont la flamme evoque les ailes d'un papillon."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad5ecdc1-7cd0-4309-a030-c4a603958359",
                                                "sense_id": "8775e073-b473-35fa-bc4f-528b31b16b25",
                                                "text": "Petite et misérable gargote de la rue Sainte-Geneviève où je me nourrissais jadis si mal […], je ne vous oublie pas, […], ni vous cinquième étage de Montmartre où sur le papillon du gaz de l’escalier je rôtissais un bifteck sans épaisseur."
                                            },
                                            {
                                                "example_id": "ccf3b3e0-ccea-48dc-ac55-89a20360741b",
                                                "sense_id": "8775e073-b473-35fa-bc4f-528b31b16b25",
                                                "text": "Un bec de gaz, de ceux qu’on appelle, je crois, papillon, siffle et crache au-dessus de ma tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a7c9d24-a42b-3570-b9ba-cc5869258aef",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c2372b-33f2-4699-84cc-7943828c2630",
                                                "sense_id": "5a7c9d24-a42b-3570-b9ba-cc5869258aef",
                                                "text": "D’azur semé alternativement de fleurs de lys d’argent et de papillons d’or, qui est de Saint-Médard-sur-Ille → voir illustration « armoiries avec des papillons »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5799fc-acb4-3d17-9592-809c862a66b8",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Grande douve du foie des ruminants."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b74748-230e-42cb-bde6-46630e6289de",
                                                "sense_id": "2c5799fc-acb4-3d17-9592-809c862a66b8",
                                                "text": "[…] ; mais il est certain, par compensation, que le limon qu'elle laisse lorsqu'on arrose les pâturages à certaines époques, et qu'on y conduit trop tôt les bêtes à laine, leur occasionne une maladie connue sous le nom de gamige, espèce de pourriture mortelle, pendant laquelle naît et se développe dans le foie de l'animal le fasciola hepatica, vulgairement papillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8ecc6d5-edbc-33d5-a95f-14d0650f7889",
                                        "entry_id": "1d834638-63fe-34ce-8767-388c8817f6ab",
                                        "glosses": [
                                            "Nœud papillon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb77622-a04d-42c4-8453-2c77641419f5",
                                                "sense_id": "c8ecc6d5-edbc-33d5-a95f-14d0650f7889",
                                                "text": "Enfin Manu, vêtu de neuf des pieds à la tête, d’un complet bleu marine que sa mère avait jugé plus habillé, chaussé de souliers vernis qui sentaient le neuf aussi et qui craquaient… Ne venait-elle pas de lui arranger le papillon de sa cravate à pois ?"
                                            },
                                            {
                                                "example_id": "ad426f64-375e-4263-8edd-88bf15d76a32",
                                                "sense_id": "c8ecc6d5-edbc-33d5-a95f-14d0650f7889",
                                                "text": "Pas difficile à deviner : il s'est rhabillé tout en blanc, pantalon et chemise, avec un papillon noir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
