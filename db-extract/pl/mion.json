                "senses": [
                    {
                        "sense_id": "414af41b-c39f-3678-9726-0839c3349882",
                        "entry_id": "6add4a58-aad6-3c46-8301-8499c851a826",
                        "glosses": [
                            "nietrwała cząstka elementarna należąca do leptonów, podobna do elektronu, ale cięższa od niego"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d95f0ffb-089b-4907-9023-6bb05f033b8b",
                        "source_entry_id": "6add4a58-aad6-3c46-8301-8499c851a826",
                        "source_sense_id": "414af41b-c39f-3678-9726-0839c3349882",
                        "target_lang_word": "muon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6db1e4b9-4f7a-304a-9d35-a2720167fe53",
                                        "entry_id": "28b3bd39-b592-366d-ba4d-ff5872407aea",
                                        "glosses": [
                                            "An unstable elementary particle in the lepton family, having similar properties to the electron but with a mass 207 times greater."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3640b4f-53a1-4b79-b6b7-35246d3b0182",
                                                "sense_id": "6db1e4b9-4f7a-304a-9d35-a2720167fe53",
                                                "text": "The μ-meson of Powell (called here muon) is instead a disintegration product of the pion, only weakly linked to the nucleons and therefore of little importance in the explanation of nuclear forces."
                                            },
                                            {
                                                "example_id": "ad6ab89e-7010-4dfa-9ae4-0fc68c4f7137",
                                                "sense_id": "6db1e4b9-4f7a-304a-9d35-a2720167fe53",
                                                "text": "The spectrum of electrons arising from the decay of the negative mu meson has been determined. The muons are arrested in the gas of a high pressure hydrogen filled diffusion cloud chamber."
                                            },
                                            {
                                                "example_id": "0bee3996-50e4-4fe6-a1cc-b40ffa89b0bd",
                                                "sense_id": "6db1e4b9-4f7a-304a-9d35-a2720167fe53",
                                                "text": "The data comes from experiments at the Fermilab US particle accelerator facility, which explored how subatomic particles called muons – similar to electrons but about 200 times heavier – move in a magnetic field."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06510ea7-b401-41c8-8369-20c2f3650faa",
                        "source_entry_id": "6add4a58-aad6-3c46-8301-8499c851a826",
                        "source_sense_id": "414af41b-c39f-3678-9726-0839c3349882",
                        "target_lang_word": "muon",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muon",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e5a75577-6db5-3cd0-9d72-805c38e2d50c",
                                        "entry_id": "f3a2b470-25fb-3d57-a439-342aa82c19bb",
                                        "glosses": [
                                            "Patícula subatómica con propiedades similares al electrón pero con una masa 200 veces mayor, puede tener carga eléctrica positiva o negativa. Su vida media es de 2 millonésimas de segundo después de este tiempo se desintegra espontáneamente en un electrón y dos neutrinos."
                                        ],
                                        "tags": [
                                            "Física"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c80e09f-adf2-42ff-b50b-1c9c762d2764",
                        "source_entry_id": "6add4a58-aad6-3c46-8301-8499c851a826",
                        "source_sense_id": "414af41b-c39f-3678-9726-0839c3349882",
                        "target_lang_word": "Myon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Myon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "060ba27a-1654-356b-af79-406845393ad8",
                                        "entry_id": "b3a3a316-03fd-3f10-adf3-75640e1dba09",
                                        "glosses": [
                                            "ein Elementarteilchen aus der Gruppe der Leptonen; verwandt mit dem Elektron"
                                        ],
                                        "tags": [
                                            "physics",
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dbf44f9-3e9b-4f32-aec0-63074fd2f06a",
                                                "sense_id": "060ba27a-1654-356b-af79-406845393ad8",
                                                "text": "Myonen können, genauso wie Elektronen, um Atomkerne kreisen."
                                            },
                                            {
                                                "example_id": "44b47a59-4efe-43ca-90d9-9d5c2960a3b7",
                                                "sense_id": "060ba27a-1654-356b-af79-406845393ad8",
                                                "text": "Das Myon war das erste Elementarteilchen, das außerhalb eines Atomes gefunden wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "981b09d5-a6df-30e3-97bb-ca2f6dcf61a3",
                                        "entry_id": "b3a3a316-03fd-3f10-adf3-75640e1dba09",
                                        "glosses": [
                                            "kleinste Funktionseinheit eines Muskels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa8c565-fc3d-42ae-8ecf-a5e8746313b5",
                                                "sense_id": "981b09d5-a6df-30e3-97bb-ca2f6dcf61a3",
                                                "text": "Ein Muskel besteht aus mehreren Myonen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
