                        "target_lang_word": "bombardier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bombardier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be66e418-eed9-39c5-8b84-0d3bd2357b2d",
                                        "entry_id": "01b42877-b045-34e9-89a7-d166644a4075",
                                        "glosses": [
                                            "Artilleur qui lance des bombes."
                                        ],
                                        "tags": [
                                            "Ancien sens"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d81780a-4053-434d-8aed-acb16624d3a8",
                                                "sense_id": "be66e418-eed9-39c5-8b84-0d3bd2357b2d",
                                                "text": "Masquant ses bombardiers et sa bombarderie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc7ee14-526c-3d49-b493-92da6f538f80",
                                        "entry_id": "01b42877-b045-34e9-89a7-d166644a4075",
                                        "glosses": [
                                            "Désignation du grade d’un membre d’un régiment d’artillerie détenant le grade de caporal."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "083d0b6c-a6d6-3db5-9528-ee9fe7fc0682",
                                        "entry_id": "01b42877-b045-34e9-89a7-d166644a4075",
                                        "glosses": [
                                            "Aviateur chargé du largage des bombes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "323f8c77-ec2b-4292-8c67-17ebb52be9ac",
                                                "sense_id": "083d0b6c-a6d6-3db5-9528-ee9fe7fc0682",
                                                "text": "Être le meilleur bombardier de l'escadrille."
                                            },
                                            {
                                                "example_id": "dc106608-f03f-43dc-be95-5e3ef56a45f7",
                                                "sense_id": "083d0b6c-a6d6-3db5-9528-ee9fe7fc0682",
                                                "text": "Ils ont des télémètres ! dit le bombardier. À peine Leclerc voyait-il le combat des avions de chasse […]. Les mitrailleurs épiaient le combat, le bombardier la terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "791f31f1-c1ba-3fd5-a779-e86153980fa5",
                                        "entry_id": "01b42877-b045-34e9-89a7-d166644a4075",
                                        "glosses": [
                                            "Avion de guerre chargé de larguer des bombes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d8fd76f-3afb-4e77-af90-452d9c639b3c",
                                                "sense_id": "791f31f1-c1ba-3fd5-a779-e86153980fa5",
                                                "text": "Pendant la nuit et malgré la mauvaise visibilité, nos bombardiers ont lancé seize tonnes de projectiles sur les grandes gares et les points de rassemblement importants et en particulier sur les gares d'Hirson, Vervins, […], sur les vastes dépôts de Provizy."
                                            },
                                            {
                                                "example_id": "913eb0d1-9715-4b34-98cb-3be65b82f83a",
                                                "sense_id": "791f31f1-c1ba-3fd5-a779-e86153980fa5",
                                                "text": "Notre wing doit escorter seul la première formation de bombardiers américains."
                                            },
                                            {
                                                "example_id": "cfdc0c3c-f2b2-456b-94b4-b7e504acff85",
                                                "sense_id": "791f31f1-c1ba-3fd5-a779-e86153980fa5",
                                                "text": "Le 7 mai au matin, 151 bombardiers américains reçoivent la mission de détruire les installations ferroviaires de Mohon ; quatre-vingt-cinq réussissent à larguer tout ou partie de leurs mortelles cargaisons : 263 bombes s'écrasent sur la cible."
                                            },
                                            {
                                                "example_id": "cca042d7-ee79-45d9-8f70-125b52db74ec",
                                                "sense_id": "791f31f1-c1ba-3fd5-a779-e86153980fa5",
                                                "text": "Mais aucun des 136 bombardiers français et anglais ayant effectué des missions n'aura été envoyé ce jour-là sur la principale brèche du front, le pont de Gaulier. Les mille Panzers pourront donc traverser la Meuse sans être inquiétés […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9827ef71-7b10-333f-ac0e-7c3c2da7533f",
                                        "entry_id": "01b42877-b045-34e9-89a7-d166644a4075",
                                        "glosses": [
                                            "Type de blouson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b7108df-3aca-4354-b961-2e3462690484",
                                                "sense_id": "9827ef71-7b10-333f-ac0e-7c3c2da7533f",
                                                "text": "D’abord, une sensation de déjà-vu : une tête blonde surgit du haut des marches, seule, un bombardier, couleur havane, sur les épaules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
