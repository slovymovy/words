                "senses": [
                    {
                        "sense_id": "b5227e0c-f5bd-3a73-84c2-e4ceb8d5f8bd",
                        "entry_id": "3ecbcc9e-7589-325b-82ab-e061df238875",
                        "glosses": [
                            "Existence de deux ou de plusieurs personnes, de deux ou de plusieurs choses, dans la même période de temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22909097-a69f-4df0-af4e-28a040753669",
                                "sense_id": "b5227e0c-f5bd-3a73-84c2-e4ceb8d5f8bd",
                                "text": "Quelques paléontologues soutiennent la contemporanéité de l’homme avec certaines espèces d’animaux fossiles."
                            },
                            {
                                "example_id": "a2c0d513-1292-4f5a-b111-357a6c608857",
                                "sense_id": "b5227e0c-f5bd-3a73-84c2-e4ceb8d5f8bd",
                                "text": "Comprenons là qu’un monument historique qui serait, en outre, un monument aurait pour spécificité de transcender la contemporanéité, en perpétuant, par reviviscence continue, la pérennité de quelque souvenir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "263ea273-ca40-4336-9692-a6fbee274a8a",
                        "source_entry_id": "3ecbcc9e-7589-325b-82ab-e061df238875",
                        "source_sense_id": "b5227e0c-f5bd-3a73-84c2-e4ceb8d5f8bd",
                        "target_lang_word": "Gleichzeitigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gleichzeitigkeit",
                                "target_lang_code": "de",
