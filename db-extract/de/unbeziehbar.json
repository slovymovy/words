                                                "sense_id": "1332f0f7-484c-3dfa-8118-1e6161c83bc1",
                                                "text": "This product is unavailable at the moment, but we hope to order more by next week."
                                            },
                                            {
                                                "example_id": "fae69c8e-c7c7-469c-840b-fb07600b1e4b",
                                                "sense_id": "1332f0f7-484c-3dfa-8118-1e6161c83bc1",
                                                "text": "A cold, reserved man, he was seen as emotionally unavailable."
                                            },
                                            {
                                                "example_id": "a46819d0-3d93-4547-9b3e-609a828519d7",
                                                "sense_id": "1332f0f7-484c-3dfa-8118-1e6161c83bc1",
                                                "text": "They are also needed to cover for unavailable Hitachi Azumas that require modifications to their inter-car connectors."
                                            }
