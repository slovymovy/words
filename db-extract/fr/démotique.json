                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1eda3037-b215-4b3a-a971-be7f26057833",
                        "entry_id": "475dad52-5046-3a4b-8c6f-522a2d1ac4ff",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "démotiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11eef25f-25a4-33ee-97dc-ed0b63e6aaf2",
                        "entry_id": "475dad52-5046-3a4b-8c6f-522a2d1ac4ff",
                        "glosses": [
                            "Populaire, courant, en parlant de la langue ou de l’écriture, en particulier l’égyptien ancien et le grec moderne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9557b7c2-bd95-4c3f-86b2-95ca3aa35bbc",
                                "sense_id": "11eef25f-25a4-33ee-97dc-ed0b63e6aaf2",
                                "text": "L’écriture hiératique donne ensuite naissance à l’écriture « démotique » qui simplifie plus encore les hiéroglyphes et en outre soude les signes, ce qui rend sa lecture très difficile et son apparence très différente des graphies d’origine."
                            },
                            {
                                "example_id": "4981d809-b45e-4cd8-95f7-ddc13d783d40",
                                "sense_id": "11eef25f-25a4-33ee-97dc-ed0b63e6aaf2",
                                "text": "Ses recherches avaient été poussées si loin qu’à présent il déchiffrait les hiéroglyphes et, bien plus, rédigeait chaque mois, de sa main, un journal en langue démotique,^([sic]) (langue vulgaire de l’Égypte pharaonique), journal à un seul exemplaire que personne ne lisait, et pour cause, sinon lui-même et sa famille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73fa303f-35d8-4c42-b6ea-707390a941e8",
                        "source_entry_id": "475dad52-5046-3a4b-8c6f-522a2d1ac4ff",
                        "source_sense_id": "11eef25f-25a4-33ee-97dc-ed0b63e6aaf2",
                        "source_sense_description": "(Linguistique) Populaire",
                        "target_lang_word": "demotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec7e0a3a-9970-350e-923a-abd71627df45",
                                        "entry_id": "a576cb97-5488-3138-83c7-47f86d8b0750",
                                        "glosses": [
                                            "Of or for the common people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b0692a9-f634-472e-a30d-754c55a627e5",
                                                "sense_id": "ec7e0a3a-9970-350e-923a-abd71627df45",
                                                "text": "demotic writing style"
                                            },
                                            {
                                                "example_id": "3fda0381-61dc-4733-ba64-ded4bd4d604c",
                                                "sense_id": "ec7e0a3a-9970-350e-923a-abd71627df45",
                                                "text": "Anything grandiose or historically based tends to sound flat and banal when it reaches English, partly because translators get stuck between contradictory imperatives: juggling fidelity to the original sense with what is vocally viable, they tend to resort to a genteel fustian which lacks either poetic resonance or demotic realism, adding to a sense of artificiality rather than enhancing credibility."
                                            },
                                            {
                                                "example_id": "0bc53930-61eb-4be9-ba39-6e4417ba5975",
                                                "sense_id": "ec7e0a3a-9970-350e-923a-abd71627df45",
                                                "text": "An enthusiastic literary critical response ranged from Graham Greene, who admired Byron’s demotic, conversational brilliance, to the rivalrous Evelyn Waugh, who had to concede the book’s high spirits, via the Sunday Times, which linked Byron to his namesake (no relation) and declared him “the last and finest fruit of the insolent humanism of the 18th century”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e517c12-e875-304c-9cc0-2632a50b2c81",
                                        "entry_id": "a576cb97-5488-3138-83c7-47f86d8b0750",
                                        "glosses": [
                                            "Of, relating to, or written in the ancient Egyptian script that developed from Lower Egyptian hieratic writing starting from around 650 BCE and was chiefly used to write the Demotic phase of the Egyptian language, with simplified and cursive characters that no longer corresponded directly to their hieroglyphic precursors."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc093273-c23b-31ba-8b19-abfefbe3c730",
                                        "entry_id": "a576cb97-5488-3138-83c7-47f86d8b0750",
                                        "glosses": [
                                            "Of, relating to, or written in the form of modern vernacular Greek."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a623e4ba-72cb-4733-b933-3798d67bd424",
                                                "sense_id": "fc093273-c23b-31ba-8b19-abfefbe3c730",
                                                "text": "demotic Greek"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe7db7f8-6ecb-39f3-858f-0ffce7eed47e",
                                        "entry_id": "962605f6-2b3c-34f3-820b-90e7239c0e19",
                                        "glosses": [
                                            "Language as spoken or written by the common people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8309fdcc-6ac5-4c69-862e-94824a0ca04e",
                                                "sense_id": "fe7db7f8-6ecb-39f3-858f-0ffce7eed47e",
                                                "text": "Near-synonym: vernacular"
                                            },
                                            {
                                                "example_id": "4114464f-2688-4a56-bd66-980e21206c0b",
                                                "sense_id": "fe7db7f8-6ecb-39f3-858f-0ffce7eed47e",
                                                "text": "2010, John C. Wells, accents map\nNote the intrusion into British demotic (“me and Cheryl were having”) of the valley-girl quotative be, like."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
