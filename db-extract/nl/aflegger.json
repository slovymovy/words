                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6cd83d4-1d58-3bb7-89dd-ec6e9764467e",
                        "entry_id": "bfc0a5b6-f397-3c71-a098-e9f024ee6e04",
                        "glosses": [
                            "een voorwerp (met name kleiding) dat de oorspronkelijke eigenaar niet meer gebruikt maar nog niet helemaal versleten is en dus nog door iemand anders als tweedehandsje gebruikt kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f17c8267-dfb0-4c44-a0e2-05999cd4c22b",
                                "sense_id": "b6cd83d4-1d58-3bb7-89dd-ec6e9764467e",
                                "text": "Het gebouw van architect Frank Gehry staat er al sinds 1997, maar de bezoekersaantallen blijven hoog, al bestaat de kunst voor een groot deel uit afleggers van het Guggenheim in New York."
                            }
                        ]
                    },
                    {
                        "sense_id": "edce28c9-3fe7-3944-802a-77cbb781e3b2",
                        "entry_id": "bfc0a5b6-f397-3c71-a098-e9f024ee6e04",
                        "glosses": [
                            "een nieuwe plant die ontstaat waart takken van de moederplant de grond raken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "616a174b-964a-40ae-b5e2-5fbeb60e8241",
                                "sense_id": "edce28c9-3fe7-3944-802a-77cbb781e3b2",
                                "text": "Afleggen is geschikt voor meerjarige, houtige kruiden zoals salie, rozemarijn, tijm, majoraan, lavendel of de razend populaire verveine (citroenverbena). Buig een gezond takje onderaan de plant naar de grond (of naar een pot aarde die u naast de plant zet); graaf het halverwege in en zet het vast; laat de taktop uit de aarde steken: grote kans dat deze aflegger aan het eind van de zomer goed is geworteld."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e81ab53-876b-3e62-b0ca-f821bd69fdbf",
                        "entry_id": "bfc0a5b6-f397-3c71-a098-e9f024ee6e04",
                        "glosses": [
                            "iemand die een lijk aflegt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "54018540-3dc9-3155-9745-728c9c1a730c",
                        "entry_id": "bfc0a5b6-f397-3c71-a098-e9f024ee6e04",
                        "glosses": [
                            "een voorzet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14e516a-ac5f-431f-adac-e837e74fe918",
                                "sense_id": "54018540-3dc9-3155-9745-728c9c1a730c",
                                "text": "Het mooiste doelpunt van de avond kwam echter op naam van Pedro, die na een aflegger van Willian de 0-3 in de winkelhaak schilderde."
                            },
                            {
                                "example_id": "9188713e-9a74-48f9-9394-1cb419229a26",
                                "sense_id": "54018540-3dc9-3155-9745-728c9c1a730c",
                                "text": "Op het uur kwam Vossen erin voor Diaby en de spits kreeg tot driemaal toe een unieke kans om de wedstrijd te beslissen: eerste trapte hij alleen voor Dutoit onbesuisd over, even later kreeg hij een aflegger niet onder controle en in het slot wilde hij met het hoofd Vormer bedienen hoewel hij beter zelf naar doel had gekopt."
                            }
                        ]
                    },
                    {
                        "sense_id": "08a77934-436a-33fc-b6a9-4c1ab537ce9f",
                        "entry_id": "bfc0a5b6-f397-3c71-a098-e9f024ee6e04",
                        "glosses": [
                            "iemand die een examen maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bacda52-6482-40de-91b7-4b8eddf9ffe8",
                                "sense_id": "08a77934-436a-33fc-b6a9-4c1ab537ce9f",
                                "text": "“Wij mogen straks gaan werven onder de beste tien procent van de afleggers van het Chinese staatsexamen. Daar helpt onze partner, de China Agriculture University mee. Dat president Xi Jinping bij de ondertekening van de overeenkomst was helpt publicitair enorm.”"
                            }
                        ]
                    }
                ],
