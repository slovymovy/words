                        "glosses": [
                            "Genre de beignet italien ou tunisien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81b91044-a058-4639-8834-3534ade5722d",
                                "sense_id": "8eeeec28-2356-3363-8b74-1d7f87989696",
                                "text": "Les bombolonis sont des beignets italiens mais aussi tunisiens."
                            },
                            {
                                "example_id": "a5348270-4de7-4121-9a01-634b0d6c74ce",
                                "sense_id": "8eeeec28-2356-3363-8b74-1d7f87989696",
                                "text": "Les bombolonis, également connus sous le nom de “bomboloni”, sont des pâtisseries traditionnelles italiennes qui ressemblent à des beignets ou des beignes."
                            },
                            {
                                "example_id": "133d58e8-55cd-40ef-962f-4604e8c2524d",
                                "sense_id": "8eeeec28-2356-3363-8b74-1d7f87989696",
                                "text": "Originaire de la Sicile, les bombolonis sont connus comme étant des bouchées de paradis."
                            }
                        ]
                    }
