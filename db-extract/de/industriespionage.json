                                    {
                                        "sense_id": "4f4be76a-44b8-3368-ab01-5651bbc00826",
                                        "entry_id": "67376cff-5996-3f1d-ba3e-cd72c4a1b7da",
                                        "glosses": [
                                            "Espionnage d’une entreprise sur un concurrent afin d’en voler les secrets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b44c0ad-52de-4620-902c-473b3b3b008e",
                                                "sense_id": "4f4be76a-44b8-3368-ab01-5651bbc00826",
                                                "text": "Cette nouvelle affaire intervient dans un contexte d’inquiétudes de dirigeants d’entreprises et de responsables politiques dans le monde entier qui soupçonnent la Chine de se livrer à de l’espionnage industriel."
                                            },
                                            {
                                                "example_id": "b7960495-8c6b-4375-b141-ae29cdf149ae",
                                                "sense_id": "4f4be76a-44b8-3368-ab01-5651bbc00826",
                                                "text": "On peut dès lors envisager des scénarios de menace de type espionnage industriel, dans lesquels les hackers deviennent des instruments contre les concurrents de leurs donneurs d’ordre."
                                            },
                                            {
                                                "example_id": "26f0df46-2f30-4476-a544-5b29d7bfa453",
                                                "sense_id": "4f4be76a-44b8-3368-ab01-5651bbc00826",
                                                "text": "La FAA reconnait avoir connaissance de situations dans lesquelles les drones sont utilisés à des fins d’espionnage industriel ou pour « mener à bien des cyber-activités malveillantes »."
                                            }
                                        ]
                                    }
