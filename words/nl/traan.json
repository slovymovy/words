                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "water",
                                "target_lang_sense_clarification": "command to produce tears"
                            },
                            {
                                "target_lang_word": "tear up",
                                "target_lang_sense_clarification": "command to start crying"
                            }
                        ]
                    }
                }
            ]
        }
