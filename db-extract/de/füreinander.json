                        "examples": [
                            {
                                "example_id": "e4301c9c-dc85-4619-9151-67dec0b16ced",
                                "sense_id": "2fc29ef6-3108-3f60-8e9a-d81fa4165293",
                                "text": "Wir fühlen uns weiterhin sehr nah und empfinden große Bewunderung füreinander",
