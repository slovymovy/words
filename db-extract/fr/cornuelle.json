                        "entry_id": "2e88f0c0-a7e3-3f73-83e0-00b845474530",
                        "glosses": [
                            "Biscuit sec et sablé, de forme triangulaire, généralement percé d'un trou en son centre et souvent décoré de grains d'anis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "765757cf-6e55-44f4-844c-114462d242c5",
                                "sense_id": "4b38e419-c72b-3a3a-8c59-7c6320b44de3",
                                "text": "La cornuelle est composée d’une pâte sablée, de forme triangulaire, dorée au jaune d’œuf, ce qui lui procure une belle dorure brillante."
                            }
                        ]
