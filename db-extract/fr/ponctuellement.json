        "fr-extract.jsonl": [
            {
                "entry_id": "f47c3392-c7a6-3fce-8917-d03026a99d68",
                "word": "ponctuellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "68b94b2a-8255-33ee-b8c2-d8943ca5f2c2",
                        "entry_id": "f47c3392-c7a6-3fce-8917-d03026a99d68",
                        "glosses": [
                            "Avec ponctualité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619504ee-6bdc-4852-a651-44c44aacbc43",
                                "sense_id": "68b94b2a-8255-33ee-b8c2-d8943ca5f2c2",
                                "text": "Il y aurait assez de compliment dans la lettre que j'ai reçue pour m’ôter à jamais la parole, et me faire fuir jusqu'aux Indes, s’il m’y fallait répondre ponctuellement,"
                            },
                            {
                                "example_id": "3d1f8bc0-327a-4312-9da7-27b6442dafe1",
                                "sense_id": "68b94b2a-8255-33ee-b8c2-d8943ca5f2c2",
                                "text": "Je ne savais que trop que Pythias reviendrait ponctuellement, et qu’il craindrait bien plus de manquer à sa parole que de perdre la vie."
                            },
                            {
                                "example_id": "87eb3cd2-790a-42ff-b65f-d48f84cf6b4d",
                                "sense_id": "68b94b2a-8255-33ee-b8c2-d8943ca5f2c2",
                                "text": "Adieu le temps où les fêtes duraient ponctuellement sept jours après le mariage!"
                            }
                        ]
                    },
                    {
                        "sense_id": "49d7285d-1e13-33bd-96df-7a3b7bbd8ddc",
                        "entry_id": "f47c3392-c7a6-3fce-8917-d03026a99d68",
                        "glosses": [
                            "D'une manière peu fréquente, ponctuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1321929c-fb72-4a4c-8d99-2de75803b655",
                                "sense_id": "49d7285d-1e13-33bd-96df-7a3b7bbd8ddc",
                                "text": "Le revêtement en place, souvent recouvert de gravillons, n'est pas conçu pour être normalement circulable, mais seulement ponctuellement emprunté dans le cadre d'interventions de maintenance."
                            },
                            {
                                "example_id": "cbc0d4ad-b025-4499-bf19-604cb2331272",
                                "sense_id": "49d7285d-1e13-33bd-96df-7a3b7bbd8ddc",
                                "text": "Le chargement des grumiers est le plus souvent effectué au moyen d'un chargeur frontal, mais il peut également être effectué ponctuellement au moyen d'un tracteur à chenille équipé d'une pelle […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc81a246-56da-492d-a5ad-9c0597c8ce47",
                        "source_entry_id": "f47c3392-c7a6-3fce-8917-d03026a99d68",
                        "source_sense_id": "68b94b2a-8255-33ee-b8c2-d8943ca5f2c2",
