                "senses": [
                    {
                        "sense_id": "d74d56ad-0a53-313c-9615-9aeb0c45454e",
                        "entry_id": "5b027997-2749-377f-9ad3-170169b1b899",
                        "glosses": [
                            "mobile Vorrichtung zur Anbringung von Plakaten mit drei senkrechten Stützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "393fa5dd-09aa-49e8-9b2e-562d810ffd0a",
                                "sense_id": "d74d56ad-0a53-313c-9615-9aeb0c45454e",
                                "text": "„Das beklagte Medienunternehmen hat – ohne über eine nach § 82 Abs 1 StVO erforderliche Bewilligung zu verfügen – Straßen dadurch zur Werbung für ihr Printmedium benützt, dass sie von wahlwerbenden Parteien im Zuge des Nationalratswahlkampfes 2013 aufgestellte Dreieckständer an 228 Standorten in Wien mit eigenen Plakaten überklebt hat.“"
                            },
                            {
                                "example_id": "98a65e3f-1f88-40ee-b358-fa839cbfb2fb",
                                "sense_id": "d74d56ad-0a53-313c-9615-9aeb0c45454e",
                                "text": "„Mit seiner Forderung nach Abschaffung der Dreieckständer, die auch Probleme im Bereich der Verkehrssicherheit bringen, beißt Kopietz bei anderen Parteien auf Granit.“"
                            },
                            {
                                "example_id": "bb566a2b-436f-46aa-bb21-7510eb6d990d",
                                "sense_id": "d74d56ad-0a53-313c-9615-9aeb0c45454e",
                                "text": "„Auch wenn es auf den ersten Blick nicht so aussieht: Im Wald an Dreieckständern in Wien gibt es eine strenge Ordnung.“"
                            },
                            {
                                "example_id": "473b2ec1-6b4f-4dcb-9568-0d6ab05e9017",
                                "sense_id": "d74d56ad-0a53-313c-9615-9aeb0c45454e",
                                "text": "„Dreieckständer seien hässlich, auf die Ortseingangstafeln der Stadt passten nur A 3-Plakate.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
