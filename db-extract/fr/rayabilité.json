                            {
                                "example_id": "12e0310e-5ad4-4f5e-992f-95759730a242",
                                "sense_id": "3afd5218-a94c-3ee4-893f-da30c7c8abbb",
                                "text": "L'écran est en cristal de saphir, matière utilisée par les grandes marques d'horlogerie pour les verres de montres et dont la rayabilité est la plus faible après le diamant."
                            },
                            {
                                "example_id": "ba84d368-0fa8-4144-af5d-cfc15ad17a59",
                                "sense_id": "3afd5218-a94c-3ee4-893f-da30c7c8abbb",
                                "text": "La prédiction du comportement surfacique pour une propriété d'usage aussi « simple » que la rayabilité est encore limitée à une réponse semi-qualitative."
                            },
                            {
                                "example_id": "ffeb9543-25aa-4616-9709-11f4ccf3ee31",
                                "sense_id": "3afd5218-a94c-3ee4-893f-da30c7c8abbb",
                                "text": "La porcelaine Philippe Deshoulières est cuite à 1400°C: […]. De ce fait, elle bénéficie d'une très grande résistance à la rayabilité. Elle ne s'écaille pas et ne se craquelle pas."
                            }
