                                        "glosses": [
                                            "Sexually attracted to many (sometimes specifically multiple but not all) genders."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4a02f5e-eac3-39ab-a0a3-6ff5a14558a3",
                                        "entry_id": "30f47888-e231-3c41-ba6e-b69abfb42e5c",
                                        "glosses": [
                                            "Sexually polyamorous; that is, having multiple sexual relationships."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c6ba5e5-1bff-4881-833a-a0cef236b6d7",
                                                "sense_id": "a4a02f5e-eac3-39ab-a0a3-6ff5a14558a3",
                                                "text": "Some queer relationships are monogamous (married/committed couple), some agree to polyfidelity (married/committed group), some are polysexual (open sexually), and others are polyamorous (open romantically)."
                                            }
                                        ]
