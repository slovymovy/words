                        ]
                    },
                    {
                        "translation_id": "d9286eec-5d65-4d50-9ab7-f30071bf4c75",
                        "source_entry_id": "647f6321-69b9-36a8-b487-8f0a0efef768",
                        "target_lang_word": "dedillo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "872e07bd-6a5e-495e-9303-324a5f707082",
                        "source_entry_id": "647f6321-69b9-36a8-b487-8f0a0efef768",
                        "target_lang_word": "doigt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doigt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad9df7bd-36c5-360a-8c6d-0616bcb08cd1",
                                        "entry_id": "72cb9028-134e-3e38-851c-0b3569f75ee4",
                                        "glosses": [
                                            "Extrémité articulée des mains de l’être humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "178dd10b-eea1-4c8b-9553-873871d8b394",
                                                "sense_id": "ad9df7bd-36c5-360a-8c6d-0616bcb08cd1",
                                                "text": "Il m’a salué à sa manière, en portant deux doigts à sa tête et en souriant d’un air bonasse."
                                            },
                                            {
                                                "example_id": "03c5aff5-e5e6-4d29-b480-d8d1a9250f9d",
                                                "sense_id": "ad9df7bd-36c5-360a-8c6d-0616bcb08cd1",
                                                "text": "Il appuya sa tête livide sur l’épaule de la jeune femme, et ses doigts crispés se cramponnèrent, en la déchirant, à la fine batiste brodée qui couvrait d’un flot de gaze le corps de Marguerite."
                                            },
                                            {
                                                "example_id": "076ed861-bd86-43e9-a39c-a3c722c18eb7",
                                                "sense_id": "ad9df7bd-36c5-360a-8c6d-0616bcb08cd1",
                                                "text": "La Vierge aux paupières endolories écartait la main gauche en un geste rapace, tandis que l’autre main se crispait, avec des doigts surprotecteurs, sur un enfant agenouillé (à la forte calvitie frontale) qui priait, béni à distance par un autre chérubin, lequel s’appuyait à un androgyne au regard louche et à la bouche pincée, tendant, sans aucun souci des convenances, un index indécent en direction de son vis-à-vis."
                                            },
                                            {
                                                "example_id": "e7ff82e9-e226-4959-8b18-492d6e0be099",
                                                "sense_id": "ad9df7bd-36c5-360a-8c6d-0616bcb08cd1",
                                                "text": "Au cours de ses fantastiques aventures, le doigt enchanteur est doté de plusieurs vies et subit des métamorphoses ; il sait aussi devenir prothèse et se dédoubler en une barre rigide pour glisser sur la guitare jouée à plat : la « lap steel guitare »."
                                            },
                                            {
                                                "example_id": "b4028bd8-8ffd-4e45-961f-3afb526f77a7",
                                                "sense_id": "ad9df7bd-36c5-360a-8c6d-0616bcb08cd1",
                                                "text": "Hélène, avec la patience mélancolique des malades, s’amusait à entortiller autour de ses doigts une chaînette d’argent qui lui servait de bracelet."
                                            },
                                            {
                                                "example_id": "12c82816-08e8-467f-812c-e3010733c377",
                                                "sense_id": "ad9df7bd-36c5-360a-8c6d-0616bcb08cd1",
                                                "text": "Malgré moi, les doigts de mes deux mains s’agitèrent follement."
                                            },
                                            {
                                                "example_id": "ccb91a60-53ee-448a-80be-6ffc6e75cf4e",
                                                "sense_id": "ad9df7bd-36c5-360a-8c6d-0616bcb08cd1",
                                                "text": "Ses doigts tordaient et retordaient une fibre imaginaire qu’il simulait de nouer gravement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fec60767-864e-3a95-b975-cff140b4e36e",
                                        "entry_id": "72cb9028-134e-3e38-851c-0b3569f75ee4",
                                        "glosses": [
                                            "Partie du gant dans laquelle entre le doigt de la main ; → voir doigt de gant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff7b55ca-f6d4-4afa-93d2-c758b93ee507",
                                                "sense_id": "fec60767-864e-3a95-b975-cff140b4e36e",
                                                "text": "Les doigts d’un gant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c906594-3c65-34a9-adca-1d7f231ae8ca",
                                        "entry_id": "72cb9028-134e-3e38-851c-0b3569f75ee4",
                                        "glosses": [
                                            "Orteil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5962813-15bb-400e-870e-34b9190452b2",
                                                "sense_id": "7c906594-3c65-34a9-adca-1d7f231ae8ca",
                                                "text": "Doigt de pied."
                                            },
                                            {
                                                "example_id": "8259aaa9-3b06-413c-b73d-2ae2b1f16317",
                                                "sense_id": "7c906594-3c65-34a9-adca-1d7f231ae8ca",
                                                "text": "Le tabi est un brodequin d’étoffe blanche dans lequel l’orteil est séparé des autres doigts, pour laisser passer les attaches des sandales de paille ou des guétas de bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3605ce03-a893-3bfe-b8e0-e8143d363ece",
                                        "entry_id": "72cb9028-134e-3e38-851c-0b3569f75ee4",
                                        "glosses": [
                                            "Extrémité plus ou moins agile et articulées d’un pied d’un animal."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0f215ff-c780-47df-a9c5-2842ae6c9d82",
                                                "sense_id": "3605ce03-a893-3bfe-b8e0-e8143d363ece",
                                                "text": "Les doigts du canard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fefea744-1c2a-35c5-820a-be4f8d500b07",
                                        "entry_id": "72cb9028-134e-3e38-851c-0b3569f75ee4",
                                        "glosses": [
                                            "Chacune des bananes d'un \\\"bouquet\\\" ou d'une \\\"main\\\"."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2765873e-d9b6-46b1-9f6a-c84249f96354",
                                                "sense_id": "fefea744-1c2a-35c5-820a-be4f8d500b07",
                                                "text": "Une \"main\" de douze doigts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5bd6f07-01a2-3e0a-b46c-5cf337382912",
                                        "entry_id": "72cb9028-134e-3e38-851c-0b3569f75ee4",
                                        "glosses": [
                                            "Mesure de longueur, approximativement le travers d’un doigt, soit 1,8 à 2 centimètres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4822a020-be63-42a7-8f11-5be442f4b537",
                                                "sense_id": "f5bd6f07-01a2-3e0a-b46c-5cf337382912",
                                                "text": "Celle qui était assise à ses côtés avait des cheveux d’un blond plus que hasardé, près de cinq pieds quatre pouces, une grande robe blanche et une ceinture verte de six doigts de hauteur, qui marquait admirablement une taille plate et maigre."
                                            },
                                            {
                                                "example_id": "ca47512f-328f-42f3-ae5c-b31abd5d70fb",
                                                "sense_id": "f5bd6f07-01a2-3e0a-b46c-5cf337382912",
                                                "text": "Ma grand’mère, un soir à sa fête,\nDe vin pur ayant bu deux doigts,\nNous disait en branlant la tête :\nQue d’amoureux j’eus autrefois !"
                                            },
                                            {
                                                "example_id": "a5028509-11e4-47b4-a21c-30ea3a35cc16",
                                                "sense_id": "f5bd6f07-01a2-3e0a-b46c-5cf337382912",
                                                "text": "Avec le bord du quart, il m’entr’ouvrait les lèvres. Il n’y avait laissé qu’un doigt de liquide et je voyais l’eau fraîche s’agiter au fond, mais je ne pouvais en absorber une goutte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7fa4fca-0dd5-327c-be7c-a7fd718a57b5",
                                        "entry_id": "72cb9028-134e-3e38-851c-0b3569f75ee4",
                                        "glosses": [
                                            "Petite quantité ; → voir à deux doigts de."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dfa2fa4-0a3c-4296-82c7-92b64d220e35",
                                                "sense_id": "e7fa4fca-0dd5-327c-be7c-a7fd718a57b5",
                                                "text": "Cette femme se met un doigt de rouge sur le visage."
                                            },
                                            {
                                                "example_id": "3b047061-ff6f-41a9-a6a1-b7acc108edc1",
                                                "sense_id": "e7fa4fca-0dd5-327c-be7c-a7fd718a57b5",
                                                "text": "Faire un doigt de cour à une femme, lui dire des galanteries, lui faire un moment la cour sans conviction profonde."
                                            },
                                            {
                                                "example_id": "4fdc8cab-21cb-4a87-9a48-7d3eb173d6cc",
                                                "sense_id": "e7fa4fca-0dd5-327c-be7c-a7fd718a57b5",
                                                "text": "Faire dix doigts de cour à une femme."
                                            },
                                            {
                                                "example_id": "52f7bad8-f678-4799-a9a1-92be4d7cab74",
                                                "sense_id": "e7fa4fca-0dd5-327c-be7c-a7fd718a57b5",
                                                "text": "Nous nous taisons tous deux ; et il semble bien que tous deux nous pensons la même chose ; c’est qu’il va falloir que je lui fasse quelques doigts de cour : cette obligation de politesse n’échauffe ni son cœur, sans doute, ni le mien."
                                            },
                                            {
                                                "example_id": "7e12ba3b-fade-4d2e-b36e-621d95930d38",
                                                "sense_id": "e7fa4fca-0dd5-327c-be7c-a7fd718a57b5",
                                                "text": "– Tu boiras bien un verre d'eau avec un doigt de vin blanc ; j'ai des figues sèches."
                                            },
                                            {
                                                "example_id": "65743a96-8794-4956-9241-7e27945ad712",
                                                "sense_id": "e7fa4fca-0dd5-327c-be7c-a7fd718a57b5",
                                                "text": "Un instant, sa main qui tenait la bouteille resta en suspens. Il versa néanmoins, mais à peine un demi-doigt de vin, comme par pudeur."
                                            },
                                            {
                                                "example_id": "9ec8bb6f-5e1c-492c-aded-613d051bcb18",
                                                "sense_id": "e7fa4fca-0dd5-327c-be7c-a7fd718a57b5",
                                                "text": "Il trempa deux biscuits dans un doigt de vin, prit sa canne et tira sa porte sans la fermer."
                                            },
                                            {
                                                "example_id": "b446f15c-47ce-4dca-a736-0c16420a58f6",
                                                "sense_id": "e7fa4fca-0dd5-327c-be7c-a7fd718a57b5",
                                                "text": "Armide avait aidé le vieux dès le réveil et de temps en temps m’apportait de l’eau parfumée, un doigt de lait, le journal, un sourire, un baiser, me recommandant de prendre patience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c5590c5-65ec-3a41-bd96-dcd431c99624",
                                        "entry_id": "72cb9028-134e-3e38-851c-0b3569f75ee4",
                                        "glosses": [
                                            "Doigt d’honneur"
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28d69d16-a1ef-4271-8d7d-f392c1043d8f",
                                                "sense_id": "0c5590c5-65ec-3a41-bd96-dcd431c99624",
                                                "text": "Le pilote ambulancier a gueulé et, toi, tu lui as fait un doigt tendu pour te donner le genre « fuck you »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
