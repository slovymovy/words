                "senses": [
                    {
                        "sense_id": "5d0e9fe9-8d6f-3da3-831d-65f68d81cff1",
                        "entry_id": "1c6c5e33-a898-342d-a2e2-d9db0fee2229",
                        "glosses": [
                            "Bonus, part variable de la rémunération de certains dirigeants d’entreprise, sous forme d’option sur titres dont l’actif sous-jacent est l’action de l’entreprise qu’ils dirigent."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "7c8eec95-fa49-4c83-890a-403bc0cf6a35",
                                "sense_id": "5d0e9fe9-8d6f-3da3-831d-65f68d81cff1",
                                "text": "En pratique, les stock options attribuées aux salariés ne sont pas comptabilisées dans leur rémunération en comptabilité nationale."
                            },
                            {
                                "example_id": "1d2bacc8-7e2e-4a21-841c-b55ee0368fa1",
                                "sense_id": "5d0e9fe9-8d6f-3da3-831d-65f68d81cff1",
                                "text": "Les stocks-options, en particulier les golden parachutes et autres bonus attribués aux dirigeants, ont fait l'actualité de nombreux journaux, soulignant les limites de ces pratiques salariales."
                            }
                        ]
                    }
                ],
