                "senses": [
                    {
                        "sense_id": "cf08dd8c-e6e8-383d-8eaf-b35a1b599f95",
                        "entry_id": "2e32f03f-b0b9-3f54-b5a9-436f14bdd964",
                        "glosses": [
                            "kobieta zajmująca się astrologią, przepowiadająca przyszłość z położenia ciał niebieskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d335adc1-2e29-4b82-93af-0f71619b6208",
                                "sense_id": "cf08dd8c-e6e8-383d-8eaf-b35a1b599f95",
                                "text": "Wróżka, kabalarka, astrolożka, przepowiadaczka przyszłości – to zawód?"
                            },
                            {
                                "example_id": "3e41db3e-4616-44f2-aca2-9e97359ae8f5",
                                "sense_id": "cf08dd8c-e6e8-383d-8eaf-b35a1b599f95",
                                "text": "Jutro pójdę do astrolożki."
                            },
                            {
                                "example_id": "a6262837-2f6b-4329-8d8b-ef42984a73b7",
                                "sense_id": "cf08dd8c-e6e8-383d-8eaf-b35a1b599f95",
                                "text": "Pani Maria zna się na sprawach pozaziemskich, ponieważ jest astrolożką i numerolożką."
                            },
                            {
                                "example_id": "e6a475e2-d8b6-4351-a1fa-fd400cd15aa7",
                                "sense_id": "cf08dd8c-e6e8-383d-8eaf-b35a1b599f95",
                                "text": "Basia jest astrolożką z zawodu i z zamiłowania."
                            },
                            {
                                "example_id": "7c4281c3-0ab3-43b9-a61a-783c7584802e",
                                "sense_id": "cf08dd8c-e6e8-383d-8eaf-b35a1b599f95",
                                "text": "Astrolożki przepowiadają przyszłość z położenia planet, Słońca i Księżyca na tle zodiaku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
