                    {
                        "translation_id": "fca23c83-38b2-468f-97df-08ae5e7c1491",
                        "source_entry_id": "290ae3ea-6348-3b04-9e5e-6b6f91e00bb1",
                        "source_sense_id": "295e0552-31b6-30d8-b7bb-2db34d55ff1e",
                        "source_sense_description": "jemand, der den Tod einer großen Anzahl Menschen zu verantworten hat",
                        "target_lang_word": "massacreur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "massacreur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd14ff4-5a5a-3e8d-9f67-253ead1d2c0b",
                                        "entry_id": "c1d753aa-ecf3-3e19-bd61-7ceb01665011",
                                        "glosses": [
                                            "Qui massacre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd24895-4cd0-4876-ba41-e432ed19a0f3",
                                                "sense_id": "ffd14ff4-5a5a-3e8d-9f67-253ead1d2c0b",
                                                "text": "Le massacre fut commandé par le premier lieutenant Nagj. K.X. était à trente ou quarante pas des soldats massacreurs."
                                            },
                                            {
                                                "example_id": "b91648ca-fcc0-44bb-9624-009519e2e40c",
                                                "sense_id": "ffd14ff4-5a5a-3e8d-9f67-253ead1d2c0b",
                                                "text": "J'ai appelé un célèbre unioniste et massacreur nommé Kélim qui est le premier secrétaire de l'administration des Travaux publics."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "massacreur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ffb2e50-5067-3a4a-9635-8cb18174b0f7",
                                        "entry_id": "527398ec-ade2-34b6-b309-09b0da78e68b",
                                        "glosses": [
                                            "Celui qui prend part à un massacre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74c9670b-a690-48df-baa8-e99aa07edc0d",
                                                "sense_id": "2ffb2e50-5067-3a4a-9635-8cb18174b0f7",
                                                "text": "J’étais un violeur et un massacreur : j’ai subi ma métamorphose."
                                            },
                                            {
                                                "example_id": "d6706d1c-9a1a-47c4-ba68-ab5093171d39",
                                                "sense_id": "2ffb2e50-5067-3a4a-9635-8cb18174b0f7",
                                                "text": "Quelques uns, anciens massacreurs de la Saint-Barthélémy, ou bien descendants de ces bouchers qui avaient dominé Paris en 1413, ne voyaient d’autre voie pour arriver à cette solution que le système du duc d’Albe : les échafauds et les proscriptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e15cccd4-52c1-30ee-8b92-1219d1d8ef20",
                                        "entry_id": "527398ec-ade2-34b6-b309-09b0da78e68b",
                                        "glosses": [
                                            "Celui qui gâche un ouvrage ou une œuvre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dde4f7f5-29d7-4cb7-a407-65b944376bbe",
                                                "sense_id": "e15cccd4-52c1-30ee-8b92-1219d1d8ef20",
                                                "text": "Massacreur de besogne. Massacreur de Mozart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
