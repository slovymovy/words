                "senses": [
                    {
                        "sense_id": "fde5965e-31f6-393a-b766-023ce1f3dd9f",
                        "entry_id": "9324f8cf-ba48-3910-a0c4-6ce1db4c5918",
                        "glosses": [
                            "Embranchement de vers plats acœlomates, sans appendices, souvent hermaphrodites, libres ou parasites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5cb3d9f-b0e0-4d6d-ada1-3f4aaebe0e67",
                                "sense_id": "fde5965e-31f6-393a-b766-023ce1f3dd9f",
                                "text": "On dirait qu'elle n'est plus humaine physiquement, qu'elle a régressé à un stade primaire de plathelminthe, bref de ver plat, conclut-elle sarcastiquement avec cet épais accent traînant de Géorgie qui me fait toujours penser à du caramel."
                            },
                            {
                                "example_id": "a5888d06-894d-4b3f-9d36-e842a9700bb9",
                                "sense_id": "fde5965e-31f6-393a-b766-023ce1f3dd9f",
                                "text": "« Pour le Bipalium kewense [originaire d’Asie du Sud-Est], jusqu’ici limité à la petite bordure sud de la France, on a fait des modèles climatiques en fonction de l’évolution du climat et on se rend compte que ces plathelminthes vont envahir toute l’Europe, certaines espèces pourront même aller jusqu’en Suède », pointe Jean-Lou Justine."
                            }
                        ]
                    }
                ],
