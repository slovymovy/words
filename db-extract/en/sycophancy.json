                ],
                "senses": [
                    {
                        "sense_id": "00cf63ff-00fb-3c61-aa96-90ca4f70f137",
                        "entry_id": "092637ec-e866-3bb5-b04b-b5acf27c7214",
                        "glosses": [
                            "The fawning behavior of a sycophant; servile flattery; fawningness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bc5151ec-24ad-440f-a15e-6942f21cac37",
                                "sense_id": "00cf63ff-00fb-3c61-aa96-90ca4f70f137",
                                "text": "I have always been taken aback at the high number of people in whom an astonishingly high income led to additional sycophancy as they became more dependent on their clients and employers and more addicted to making even more money."
                            },
                            {
                                "example_id": "b1b7da95-4b39-4236-a8f2-6efb20664a8e",
                                "sense_id": "00cf63ff-00fb-3c61-aa96-90ca4f70f137",
                                "text": "“I don’t want to get myself into trouble,” he added, “but she’s very, she’s a great woman.”\nVictoria [Starmer] looked a little creeped out. Her husband might be a master Trump-wrangler, an expert at sycophancy and genuflection, but she wasn’t."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4c4ebd6-99b1-342d-901a-c60a753466b2",
                        "entry_id": "092637ec-e866-3bb5-b04b-b5acf27c7214",
                        "glosses": [
                            "The tendency of a language model to produce answers that flatter or agree with a user’s beliefs or biases rather than giving accurate or truthful information, or to give strategically false answers when it infers that it is being evaluated in terms of alignment."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
