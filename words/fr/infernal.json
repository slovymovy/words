                        "esprits infernaux"
                    ]
                },
                {
                    "sense_id": "5bb437d8-61e9-36ac-9d13-e6bf31f6da56",
                    "sense_definition": "Qui manifeste une grande perversité, de la cruauté ou une ingéniosité malfaisante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "moralite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le criminel avait imaginé un plan <w>infernal</w> pour tromper les enquêteurs."
                        },
                        {
                            "text": "Ils ont réussi à déjouer la machination <w>infernale</w> préparée par leurs adversaires."
