                        "examples": [
                            {
                                "example_id": "0f0e2ebd-6b4b-4b0d-b3c0-52a47363564b",
                                "sense_id": "2f410118-40d2-3efd-8767-1dbd1e7c5c37",
                                "text": "en quoi cet aveu d'incompétence peut-il constituer une école et un enseignement puisque actuellement, les élèves s'autoenseignent, (...)"
                            },
                            {
                                "example_id": "363a6f98-5caa-4b2b-af91-ef18b774c46a",
                                "sense_id": "2f410118-40d2-3efd-8767-1dbd1e7c5c37",
                                "text": "Mais tant bien que mal on descend la foutue piste. je m'apprête à prévenir le moniteur que je ne peux pas continuer la journée à m'autoenseigner le ski."
                            }
                        ]
                    }
