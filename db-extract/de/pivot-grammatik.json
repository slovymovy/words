                "senses": [
                    {
                        "sense_id": "0f11f6aa-da80-333b-af0d-d0b32f015978",
                        "entry_id": "5efc5404-e429-31de-9a56-4c551a4f7a92",
                        "glosses": [
                            "Grammatik für frühe Spracherwerbsschritte im Bereich der Syntax. Sie beruht auf der Unterscheidung von \\\"Pivot-Wörtern\\\" (= grammatische Wörter) und Wörtern der offenen Klassen (Substantiv, Verb, Adjektiv, Adverb) und fußt auf der Beobachtung, dass die Pivot-Wörter in den Sätzen der ganz frühen Entwicklung stärker an ihre Position im Satz gebunden sind als die Wörter der offenen Klassen."
                        ],
                        "tags": [
                            "speziell Spracherwerbsforschung"
                        ],
                        "examples": [
                            {
                                "example_id": "71d15127-a8cc-4d56-a0c0-3b645568e3ac",
                                "sense_id": "0f11f6aa-da80-333b-af0d-d0b32f015978",
                                "text": "Die Pivot-Grammatik hat eine spezielle strukturalistische Grundlage, den Distributionalismus."
                            },
                            {
                                "example_id": "ddd42101-f620-4997-b071-8a409fe167a1",
                                "sense_id": "0f11f6aa-da80-333b-af0d-d0b32f015978",
                                "text": "„Mit der Pivot-Grammatik in Tabelle 4.9 ist das früheste eigentlich syntaktische Sprachentwicklungsniveau exemplifiziert.“"
                            },
                            {
                                "example_id": "30dcac4a-cbb1-4c82-9e03-981b6762e516",
                                "sense_id": "0f11f6aa-da80-333b-af0d-d0b32f015978",
                                "text": "„Ihre eigenen Analysen zweier finnischer Kinder beweisen, daß ihre Zweiwortsätze den Regeln der Pivot-Grammatik nicht entsprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
