                "senses": [
                    {
                        "sense_id": "0e4110b4-7e6c-3d5b-ba77-60b9a86eb125",
                        "entry_id": "4e6218fe-7732-3bab-a1c0-9242619dd76c",
                        "glosses": [
                            "schlechtes Land"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "90cd4397-a6ca-4191-9e81-c67c22eca1b8",
                                "sense_id": "0e4110b4-7e6c-3d5b-ba77-60b9a86eb125",
                                "text": "„Möglich, dass Krieg die Hölle ist, aber eins kann ich dir sagen, die Hölle ist besser als dieses Scheißland hier.“"
                            },
                            {
                                "example_id": "ecf23c84-0cf0-41ca-865e-4b3e6e8d9ff1",
                                "sense_id": "0e4110b4-7e6c-3d5b-ba77-60b9a86eb125",
                                "text": "„Du stehst bei mir für alles... ...was ich an deinem Scheißland hasse.“"
                            },
                            {
                                "example_id": "979e134c-7be1-4d50-967c-c51973a1848b",
                                "sense_id": "0e4110b4-7e6c-3d5b-ba77-60b9a86eb125",
                                "text": "„Himmel noch mal, dachte er, ich kann doch nicht jeden Arsch in diesem Scheißland retten.“"
                            },
                            {
                                "example_id": "b43d8f2a-3973-4957-b120-45064ee96b33",
                                "sense_id": "0e4110b4-7e6c-3d5b-ba77-60b9a86eb125",
                                "text": "„›Nein, sie werden mich erwischen, Tiny. Es sei denn, ich tauche hier irgendwo in Europa unter. Aber das kann ich nicht. Ich liebe dieses Scheißland zu sehr.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
