                                "target_senses": [
                                    {
                                        "sense_id": "379841f9-bf3c-316f-924d-469d0994b43c",
                                        "entry_id": "43ee5006-7feb-3a78-bfb0-7cd9434b6903",
                                        "glosses": [
                                            "The framing of potential conflict in social relations in terms of enmity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "428215b6-e3af-477d-8067-6ad435df3d2b",
                                                "sense_id": "379841f9-bf3c-316f-924d-469d0994b43c",
                                                "text": "Animism taken to its final conclusion ... is not only a perspectivism but an \"enemyism.\""
                                            },
                                            {
                                                "example_id": "057d3244-7566-42e2-a7cf-b085fbced266",
                                                "sense_id": "379841f9-bf3c-316f-924d-469d0994b43c",
                                                "text": "I think free-range \"enemyism\" can keep us from solutions, and needlessly subject groups to a position of \"forever enemy-hood.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
