                                                "example_id": "a1061530-b39f-412b-af91-7a9df78f6c29",
                                                "sense_id": "df8f7425-7138-3b5a-a402-317e341cfe42",
                                                "text": "He spoke : the brawny spearman let his cheek Bulge with the unswallow'd piece, and turning stared;"
                                            },
                                            {
                                                "example_id": "0403e607-b36a-47bb-8b62-73eae68e6a15",
                                                "sense_id": "df8f7425-7138-3b5a-a402-317e341cfe42",
