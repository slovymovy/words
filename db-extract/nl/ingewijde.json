        "nl-extract.jsonl": [
            {
                "entry_id": "f6ba628c-a153-3af0-8910-361019d0f5e1",
                "word": "ingewijde",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "189a5f6e-1039-49d6-9da3-5650e04a36d0",
                        "entry_id": "f6ba628c-a153-3af0-8910-361019d0f5e1",
                        "tags": [
                            "plural"
                        ],
                        "form": "ingewijden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ac6c335-9983-3945-8c42-7dad69629e49",
                        "entry_id": "f6ba628c-a153-3af0-8910-361019d0f5e1",
                        "glosses": [
                            "iemand die bekend is met een geheim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e91ee36-3c2f-47ae-9686-11e140a296af",
                                "sense_id": "1ac6c335-9983-3945-8c42-7dad69629e49",
                                "text": "Bovendien, de lezer kan de betrouwbaarheid van al die zegslieden natuurlijk niet controleren. Wie zijn al die ‘betrokkenen’, ‘welingelichte bronnen’ en ‘ingewijden’ die opstaan met een glas spraakwater? En is het wáár wat ze vertellen?"
                            },
                            {
                                "example_id": "48601370-5689-4edc-ae23-d7e0d5df8cd0",
                                "sense_id": "1ac6c335-9983-3945-8c42-7dad69629e49",
                                "text": "Ik dacht dat ik als enige het geheim kende, en daarom vroeg ik nooit door. Als je iets geheim wilt houden: kom met een ander geheim en de quasi-ingewijde doet er het zwijgen toe. Ik heb pas contact gezocht toen mijn moeder op sterven lag, ik dacht: misschien wil hij zijn zieltogende ex—maîtresse nog een keer zien. Maar er kwam geen antwoord op mijn brief, en ik besloot een streep te zetten onder de vaderqueeste. Een vent die op zo'n moment niet komt opdagen heeft voor mij afgedaan. Pas later begreep ik dat hij toen al dood was.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "37608401-6c69-3ffb-8842-cf019557bd2f",
                        "entry_id": "f6ba628c-a153-3af0-8910-361019d0f5e1",
                        "glosses": [
                            "iemand die bekend is met een ingewikkelde zaak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3530b629-a1db-43fc-8906-67cdd92a8e70",
                                "sense_id": "37608401-6c69-3ffb-8842-cf019557bd2f",
                                "text": "Waren de onderzoeken naar de cognitieve effecten van games vijftien jaar geleden op de vingers van twee handen te tellen, nu zijn er honderden onderzoeken over te vinden en verschillende meta-analyses. Niet alleen voor niet-ingewijden is het lastig nog door de bomen het bos te zien, maar soms ook voor wetenschappers zelf. Niettemin onderkennen de meesten dat tegenspraak en kritiek de essentie zijn van wetenschap en dat de veelheid van gegevens het vak dynamischer en boeiender maakt dan ooit."
                            }
                        ]
                    },
                    {
                        "sense_id": "85d7aa4d-433c-3973-9ef4-9dbd596d4836",
                        "entry_id": "f6ba628c-a153-3af0-8910-361019d0f5e1",
                        "glosses": [
                            "iemand die op de hoogte is gesteld van een religieus geheim"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12337c4c-0e71-4ec1-ae00-f4bf7fd0ed3b",
                        "source_entry_id": "f6ba628c-a153-3af0-8910-361019d0f5e1",
                        "source_sense_id": "1ac6c335-9983-3945-8c42-7dad69629e49",
                        "source_sense_description": "iemand die bekend is met een geheim",
                        "target_lang_word": "insider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad762c0e-6306-3a19-813f-45c5d9e5295d",
                                        "entry_id": "b1a0eb87-dbb6-3e15-848d-3d75283dd55e",
                                        "glosses": [
                                            "A person who has special knowledge about the inner workings of a group, organization, or institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e2ac29-da59-4e28-b2c5-4d0650b7793d",
                                                "sense_id": "ad762c0e-6306-3a19-813f-45c5d9e5295d",
                                                "text": "Near-synonyms: initiate, old hand, habitué"
                                            },
                                            {
                                                "example_id": "56a483be-fdaf-4612-a228-a68b75aaadca",
                                                "sense_id": "ad762c0e-6306-3a19-813f-45c5d9e5295d",
                                                "text": "Heavy losses were sustained in Simms Petroleum, which took a greater toll from supposed \"Wall Street insiders\" than from the general public."
                                            },
                                            {
                                                "example_id": "62710243-4e98-48b8-8ee3-24852e250f20",
                                                "sense_id": "ad762c0e-6306-3a19-813f-45c5d9e5295d",
                                                "text": "He is also an astute ANC insider who spent ten years on Robben Island alongside Nelson Mandela and the other “grandees” of the movement."
                                            },
                                            {
                                                "example_id": "dc3c9760-fc11-4f03-864c-f00195164934",
                                                "sense_id": "ad762c0e-6306-3a19-813f-45c5d9e5295d",
                                                "text": "In a thread called “Calm Before the Storm”, and in subsequent posts, Q established his legend as a government insider with top security clearance who knew the truth about a secret struggle for power involving Donald Trump, the “deep state”, Robert Mueller, the Clintons, pedophile rings, and other stuff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c80b078e-086b-3dfc-a6b6-cd48b6bac2d3",
                                        "entry_id": "b1a0eb87-dbb6-3e15-848d-3d75283dd55e",
                                        "glosses": [
                                            "A person who is within an enclosed space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "325d4a63-f945-4fc1-a94a-490b6712d4c5",
                                                "sense_id": "c80b078e-086b-3dfc-a6b6-cd48b6bac2d3",
                                                "text": "To the insider, the ceiling is like a small firmament twinkling with astral radiations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
