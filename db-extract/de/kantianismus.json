                        "entry_id": "19dba765-705a-33ae-ba93-e96a26a0ce2f",
                        "glosses": [
                            "an das Werk von Immanuel Kant ^(→ WP) anschließende oder sich auf ihn berufende philosophische Positionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea9dcf9-577b-42be-9d55-439d2cbd619d",
                                "sense_id": "cb3159bc-89a1-31bd-be77-0a21e8b28bcf",
                                "text": "„Bekannt wurde Williams vor allem als Kritiker des Utilitarismus, des Kantianismus und allgemein systematischer Ansätze in der Moralphilosophie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
