    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "341f31c4-bb48-3c1a-bb93-2db9e5a1e677",
                    "sense_definition": "Przemieszczać się z góry na dół, na przykład po schodach lub zboczu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Codziennie rano <w>schodzę</w> do kuchni na śniadanie.",
                            "target_lang_translations": {
                                "ru": "Каждое утро я <w>спускаюсь</w> на кухню к завтраку.",
                                "en": "Every morning I <w>come down</w> to the kitchen for breakfast."
                            }
                        },
                        {
                            "text": "Musimy ostrożnie <w>schodzić</w> ze szczytu, bo robi się ciemno.",
                            "target_lang_translations": {
                                "ru": "Мы должны осторожно <w>спускаться</w> с вершины, потому что темнеет.",
                                "en": "We must <w>descend</w> from the summit carefully because it is getting dark."
                            }
                        }
                    ],
                    "synonyms": [
                        "złazić"
                    ],
                    "antonyms": [
                        "wchodzić"
                    ],
                    "common_phrases": [
                        "schodzić po schodach",
                        "schodzić na dół",
                        "schodzić z drogi"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаться сверху вниз, например, по лестнице или склону.",
                        "en": "To move from a higher to a lower position, such as on stairs or a slope."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спускаться",
                                "target_lang_sense_clarification": "двигаться вниз"
                            },
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "со ступеньки или возвышенности"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "descend",
                                "target_lang_sense_clarification": "to move from a higher to a lower position"
                            },
                            {
                                "target_lang_word": "come down",
                                "target_lang_sense_clarification": "to move downwards, often used for stairs or slopes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "250c4a7d-7a12-30aa-a04a-b62d7a6f4c86",
                    "sense_definition": "O plamach, farbie, skórze lub śniegu: znikać, oddzielać się od powierzchni lub ustępować.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disappearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po opalaniu skóra zaczęła mi <w>schodzić</w> z pleców.",
                            "target_lang_translations": {
                                "ru": "После загара у меня начала <w>облезать</w> кожа со спины.",
                                "en": "After sunbathing, my skin started to <w>peel</w> off my back."
                            }
                        },
                        {
                            "text": "Ta tłusta plama nie chce <w>schodzić</w> z obrusu mimo prania.",
                            "target_lang_translations": {
                                "ru": "Это жирное пятно не хочет <w>сходить</w> со скатерти, несмотря на стирку.",
                                "en": "This grease stain won't <w>come off</w> the tablecloth despite washing."
                            }
                        }
                    ],
                    "synonyms": [
                        "ustępować"
                    ],
                    "antonyms": [
                        "zalegać"
                    ],
                    "common_phrases": [
                        "śnieg schodzi",
                        "skóra schodzi",
                        "plama nie schodzi"
                    ],
                    "target_lang_definitions": {
                        "ru": "О пятнах, краске, коже или снеге: исчезать, отслаиваться или таять.",
                        "en": "Regarding stains, paint, skin, or snow: to disappear, peel off, or melt away."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "исчезать (о пятнах, снеге)"
                            },
                            {
                                "target_lang_word": "облезать",
                                "target_lang_sense_clarification": "отслаиваться (о коже)"
                            },
                            {
                                "target_lang_word": "отходить",
                                "target_lang_sense_clarification": "отделяться от поверхности"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "come off",
                                "target_lang_sense_clarification": "to be removed or detached from a surface (stains, paint)"
                            },
                            {
                                "target_lang_word": "peel",
                                "target_lang_sense_clarification": "to come off in layers (skin)"
                            },
                            {
                                "target_lang_word": "melt",
                                "target_lang_sense_clarification": "to disappear due to heat (snow)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45122ea1-ef24-363c-91e4-cd7a7e9fcfcf",
                    "sense_definition": "Gromadzić się w jednym miejscu, przybywając z różnych stron (używane z „się”).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy goście powoli <w>schodzą</w> się do salonu na uroczystość.",
                            "target_lang_translations": {
                                "ru": "Все гости медленно <w>собираются</w> в гостиной на торжество.",
                                "en": "All the guests are slowly <w>gathering</w> in the living room for the celebration."
                            }
                        },
                        {
                            "text": "Wieczorami sąsiedzi <w>schodzili</w> się na pogawędki przed domem.",
                            "target_lang_translations": {
                                "ru": "По вечерам соседи <w>сходились</w> поболтать перед домом.",
                                "en": "In the evenings, neighbors would <w>assemble</w> for chats in front of the house."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbierać się",
                        "gromadzić się"
                    ],
                    "common_phrases": [
                        "schodzić się do domu",
                        "ludzie się schodzą"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собираться в одном месте, приходя с разных сторон.",
                        "en": "To gather in one place, arriving from different directions."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходиться",
                                "target_lang_sense_clarification": "встречаться в одном месте"
                            },
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "группироваться"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "gather",
                                "target_lang_sense_clarification": "to come together in one place"
                            },
                            {
                                "target_lang_word": "assemble",
                                "target_lang_sense_clarification": "to meet or collect in a group"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c702130-cf1d-3401-b344-90a4d8a7cecb",
                    "sense_definition": "O towarach: być szybko kupowanym i znikać ze sklepu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Świeże bułki <w>schodzą</w> w naszej piekarni błyskawicznie.",
                            "target_lang_translations": {
                                "ru": "Свежие булочки <w>расходятся</w> в нашей пекарне молниеносно.",
                                "en": "Fresh rolls <w>fly off the shelves</w> in our bakery instantly."
                            }
                        },
                        {
                            "text": "Bilety na ten koncert <w>schodziły</w> jak świeże bułeczki.",
                            "target_lang_translations": {
                                "ru": "Билеты на этот концерт <w>расходились</w> как горячие пирожки.",
                                "en": "Tickets for this concert <w>sold out</w> like hotcakes."
                            }
                        }
                    ],
                    "antonyms": [
                        "zalegać"
                    ],
                    "common_phrases": [
                        "schodzić na pniu",
                        "towar dobrze schodzi"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О товарах: быстро раскупаться и исчезать с прилавков.",
                        "en": "Regarding goods: to be sold quickly and disappear from store shelves."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расходиться",
                                "target_lang_sense_clarification": "быстро продаваться"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sell out",
                                "target_lang_sense_clarification": "to be completely sold"
                            },
                            {
                                "target_lang_word": "fly off the shelves",
                                "target_lang_sense_clarification": "idiomatic expression for selling very quickly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1705cd77-0c27-3f23-9fbc-ad72fa031f4b",
                    "sense_definition": "Zgadzać się na niższą cenę lub mniejsze wymagania podczas negocjacji.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sprzedawca nie chciał <w>schodzić</w> z ustalonej ceny ani o grosz.",
                            "target_lang_translations": {
                                "ru": "Продавец не хотел <w>уступать</w> в установленной цене ни на грош.",
                                "en": "The seller wouldn't <w>come down</w> on the set price by even a penny."
                            }
                        },
                        {
                            "text": "Podczas negocjacji rzadko <w>schodzi</w> ze swoich wymagań.",
                            "target_lang_translations": {
                                "ru": "Во время переговоров он редко <w>отступает</w> от своих требований.",
                                "en": "During negotiations, he rarely <w>lowers</w> his demands."
                            }
                        }
                    ],
                    "synonyms": [
                        "maleć"
                    ],
                    "common_phrases": [
                        "schodzić z ceny",
                        "schodzić z kosztów"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соглашаться на более низкую цену или снижать требования во время переговоров.",
                        "en": "To agree to a lower price or reduce demands during negotiations."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уступать",
                                "target_lang_sense_clarification": "соглашаться на меньшее"
                            },
                            {
                                "target_lang_word": "снижать",
                                "target_lang_sense_clarification": "уменьшать цену или требования"
                            },
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "разг. уменьшать цену"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lower",
                                "target_lang_sense_clarification": "to reduce a price or requirement"
                            },
                            {
                                "target_lang_word": "concede",
                                "target_lang_sense_clarification": "to yield or agree to a lower demand"
                            },
                            {
                                "target_lang_word": "come down",
                                "target_lang_sense_clarification": "to reduce one's price or expectations"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d81295f6-ed6e-3355-9cc3-af7dbe658a9e",
                    "sense_definition": "O drogach, liniach lub krawędziach: łączyć się lub stykać w jednym punkcie (używane z „się”).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym miejscu <w>schodzą</w> się trzy główne szlaki turystyczne.",
                            "target_lang_translations": {
                                "ru": "В этом месте <w>сходятся</w> три главных туристических маршрута.",
                                "en": "Three main hiking trails <w>converge</w> at this point."
                            }
                        },
                        {
                            "text": "Tutaj <w>schodzą</w> się dwa rurociągi doprowadzające wodę.",
                            "target_lang_translations": {
                                "ru": "Здесь <w>сходятся</w> два трубопровода, подающих воду.",
                                "en": "Two water supply pipelines <w>meet</w> here."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drogi się schodzą",
                        "linie się schodzą"
                    ],
                    "target_lang_definitions": {
                        "ru": "О дорогах, линиях или краях: соединяться или пересекаться в одной точке.",
                        "en": "Regarding roads, lines, or edges: to join or meet at a single point."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходиться",
                                "target_lang_sense_clarification": "соединяться в точке"
                            },
                            {
                                "target_lang_word": "пересекаться",
                                "target_lang_sense_clarification": "встречаться (о путях)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "converge",
                                "target_lang_sense_clarification": "to meet at a single point"
                            },
                            {
                                "target_lang_word": "meet",
                                "target_lang_sense_clarification": "to join or intersect"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}