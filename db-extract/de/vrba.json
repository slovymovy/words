                ],
                "senses": [
                    {
                        "sense_id": "cfcfd568-1e2d-3188-8ff6-c93c1d7fd534",
                        "entry_id": "0db96f78-61e4-3124-94a0-a2b1fdc9c143",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295483b3-d5f5-4f7b-af25-261e299758d8",
                                "sense_id": "cfcfd568-1e2d-3188-8ff6-c93c1d7fd534",
                                "text": "Frau Vrba ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c27db544-3a83-422c-b150-849942362dc1",
                                "sense_id": "cfcfd568-1e2d-3188-8ff6-c93c1d7fd534",
                                "text": "Herr Vrba wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "587add3d-a303-4b50-a1ff-acaf54d40940",
                                "sense_id": "cfcfd568-1e2d-3188-8ff6-c93c1d7fd534",
                                "text": "Die Vrbas fliegen heute nach Wien."
                            },
                            {
                                "example_id": "489743ca-d753-4ad0-9e17-430ff9f7b093",
                                "sense_id": "cfcfd568-1e2d-3188-8ff6-c93c1d7fd534",
                                "text": "Der Vrba trägt nie die Pullover, die die Vrba ihm strickt."
                            },
                            {
                                "example_id": "f68904a8-3a0c-4e4d-be55-e4a4a4eaf74c",
                                "sense_id": "cfcfd568-1e2d-3188-8ff6-c93c1d7fd534",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vrba kommt, geht der Herr Vrba.“"
                            },
                            {
                                "example_id": "7ee23114-d42d-4372-84a1-d822563537a0",
                                "sense_id": "cfcfd568-1e2d-3188-8ff6-c93c1d7fd534",
                                "text": "Vrba kommt und geht."
                            },
                            {
                                "example_id": "7772741c-da0e-49ea-925e-adad273c810c",
                                "sense_id": "cfcfd568-1e2d-3188-8ff6-c93c1d7fd534",
                                "text": "Vrbas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
