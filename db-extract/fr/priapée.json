                "senses": [
                    {
                        "sense_id": "cefc19df-bbfe-3ecb-ac64-e16906bdd256",
                        "entry_id": "09b7e967-ba51-3b63-ad23-8c831d71b31f",
                        "glosses": [
                            "Pièce de poésie obscène, peinture licencieuse…"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "77d0e951-c8f4-4cd1-84b7-9e42c7099f47",
                                "sense_id": "cefc19df-bbfe-3ecb-ac64-e16906bdd256",
                                "text": "Les priapées sont des fêtes en l’honneur du dieu des jardins."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cec24e0-5c16-3e70-a0d9-82aab5b9a6f9",
                        "entry_id": "09b7e967-ba51-3b63-ad23-8c831d71b31f",
                        "glosses": [
                            "Orgie sexuelle."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "ce338ac0-c135-4cd0-9c7d-07d0cc8f9041",
                                "sense_id": "9cec24e0-5c16-3e70-a0d9-82aab5b9a6f9",
                                "text": "Ah ! me précipiter, le fouet en main, au milieu de ces priapées, et zébrer ces corps d’ineffaçables plaies, éparpiller des coulées de sang chaud, des morceaux de chair vive, sur les glaces, sur les tapis, les lits…"
                            },
                            {
                                "example_id": "ea838307-0e3a-41ac-b3a8-2863254d65d3",
                                "sense_id": "9cec24e0-5c16-3e70-a0d9-82aab5b9a6f9",
                                "text": "Une humanité douloureusement concupiscente hantait l’apparence de ma chair ; l’appel de la luxure faisait lever dans mon imagination des rêves lourds et brûlants, des tumultes de priapées."
                            },
                            {
                                "example_id": "611b7e16-0ce4-4ea3-a78e-8f4e98c011bb",
                                "sense_id": "9cec24e0-5c16-3e70-a0d9-82aab5b9a6f9",
                                "text": "C’était au printemps […] les fleurs du ghetto avaient beau être laides, elles n’en faisaient pas moins leur boulot de fleurs […]. Il y avait de la priapée dans l’air."
                            },
                            {
                                "example_id": "a28c594e-ec20-40ea-b32e-0855bb863293",
                                "sense_id": "9cec24e0-5c16-3e70-a0d9-82aab5b9a6f9",
                                "text": "Tout dépendait de la compréhension que l’on avait d’Édimbourg comme ville fort cultivée et respectable en apparence, mais dissimulant tout un monde de priapées."
                            }
                        ]
                    }
                ],
