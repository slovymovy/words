{
    "word_family": [
        "foreteller"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a2e584f-773a-3bb5-bf03-97ec70cf3e73",
                    "sense_definition": "To state what will happen in the future; to predict or prophesy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient myths claimed that the oracle could accurately <w>foretell</w> the outcome of any war.",
                            "target_lang_translations": {
                                "ru": "Древние мифы утверждали, что оракул мог безошибочно <w>предсказать</w> исход любой войны."
                            }
                        },
                        {
                            "text": "Economists tried to <w>foretell</w> the consequences of the sudden policy shift, but few agreed.",
                            "target_lang_translations": {
                                "ru": "Экономисты пытались <w>предсказать</w> последствия внезапного изменения политики, но мало кто сошёлся во мнении."
                            }
                        }
                    ],
                    "synonyms": [
                        "foresay",
                        "forespeak"
                    ],
                    "common_phrases": [
                        "foretell the future",
                        "foretell disaster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить заранее о том, что произойдёт в будущем; предсказывать или пророчествовать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предсказывать",
                                "target_lang_sense_clarification": "о будущем в целом или на основе анализа"
                            },
                            {
                                "target_lang_word": "пророчить",
                                "target_lang_sense_clarification": "вещать о грядущих событиях, предрекать"
                            },
                            {
                                "target_lang_word": "предрекать",
                                "target_lang_sense_clarification": "заранее объявлять о неизбежном исходе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dea0b88-1e0a-3811-9f3e-047314722f91",
                    "sense_definition": "To inform someone beforehand about what will happen.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seer <w>foretold</w> him of the great trials he would soon face on his journey.",
                            "target_lang_translations": {
                                "ru": "Провидец <w>предвестил</w> ему великие испытания, с которыми тому вскоре предстояло столкнуться на своём пути."
                            }
                        },
                        {
                            "text": "She claimed an angel had appeared to <w>foretell</w> her of the coming victory.",
                            "target_lang_translations": {
                                "ru": "Она утверждала, что ей явился ангел, чтобы <w>предсказать</w> грядущую победу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used with a personal direct object followed by 'of'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заранее оповещать кого-либо о том, что произойдёт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвещать",
                                "target_lang_sense_clarification": "заранее сообщать или сулить кому-либо"
                            },
                            {
                                "target_lang_word": "предупреждать",
                                "target_lang_sense_clarification": "заранее оповещать о грядущих событиях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}