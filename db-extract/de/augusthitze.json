                        "examples": [
                            {
                                "example_id": "ce5f3a2c-321c-4f81-9dc9-9a3de3f99152",
                                "sense_id": "be533ba1-e963-31e7-b954-1c060fe22295",
                                "text": "„Hinter ihnen reihten sich ein paar Zwei-Sterne-Generäle, Panzerkommandanten und batteriebetriebene Bodenventilatoren, die einen kleinen Sandsturm hervorriefen, ohne tatsächlich Erleichterung von der drückenden Augusthitze zu bringen.“"
                            },
                            {
                                "example_id": "44cb989c-0254-42f4-8d83-fc4f90087f4f",
                                "sense_id": "be533ba1-e963-31e7-b954-1c060fe22295",
                                "text": "„Er hatte oft genug mörderische Football- und Lacrosse-Trainings in der sengenden Augusthitze von Virginia absolviert.“"
                            },
                            {
                                "example_id": "f2171a26-f57f-48bf-92d3-55d60c1d7ee2",
                                "sense_id": "be533ba1-e963-31e7-b954-1c060fe22295",
                                "text": "„Die Augusthitze war brutal, und er schwitzte sogar noch in seinem leichten hellen Anzug.“"
                            },
                            {
                                "example_id": "7e1ac56b-b7a2-42e0-8154-bbd7ce1b0f7f",
                                "sense_id": "be533ba1-e963-31e7-b954-1c060fe22295",
                                "text": "„Die schwüle Augusthitze ließ in wieder einmal nicht schlafen.“"
                            }
                        ],
