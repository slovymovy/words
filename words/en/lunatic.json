{
    "word_family": [
        "lunacy",
        "lunar",
        "lunation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66cc7b45-0a65-3a56-a19a-1e193df4699c",
                    "sense_definition": "A person who is mentally ill or who behaves in a very reckless or foolish manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver was speeding through the narrow streets like a total <w>lunatic</w>.",
                            "target_lang_translations": {
                                "ru": "Водитель несся по узким улицам как законченный <w>псих</w>."
                            }
                        },
                        {
                            "text": "Only a <w>lunatic</w> would try to climb that mountain in the middle of a blizzard.",
                            "target_lang_translations": {
                                "ru": "Только <w>безумец</w> попытается взобраться на эту гору в разгар метели."
                            }
                        }
                    ],
                    "synonyms": [
                        "madman",
                        "maniac",
                        "crackpot",
                        "nutcase"
                    ],
                    "common_phrases": [
                        "total lunatic",
                        "dangerous lunatic",
                        "raving lunatic"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe foolish behavior rather than clinical insanity"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, страдающий психическим заболеванием или ведущий себя крайне безрассудно или глупо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумасшедший",
                                "target_lang_sense_clarification": "человек с психическим расстройством или ведущий себя безумно"
                            },
                            {
                                "target_lang_word": "псих",
                                "target_lang_sense_clarification": "разговорное обозначение неуравновешенного или безумного человека"
                            },
                            {
                                "target_lang_word": "безумец",
                                "target_lang_sense_clarification": "человек, совершающий крайне безрассудные поступки"
                            },
                            {
                                "target_lang_word": "чокнутый",
                                "target_lang_sense_clarification": "разговорное, о человеке со странностями или ведущем себя глупо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "919627e7-ffdf-3c9b-9feb-09f4e64839a4",
                    "sense_definition": "Extremely foolish, eccentric, or mentally ill.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He came up with a <w>lunatic</w> scheme to make millions by selling bottled air.",
                            "target_lang_translations": {
                                "ru": "Он придумал <w>безумную</w> схему, как заработать миллионы на продаже бутилированного воздуха."
                            }
                        },
                        {
                            "text": "The <w>lunatic</w> fringe of the party began to demand impossible changes.",
                            "target_lang_translations": {
                                "ru": "<w>Экстремистское</w> крыло партии начало требовать невозможных перемен."
                            }
                        }
                    ],
                    "synonyms": [
                        "insane",
                        "mad",
                        "crazed",
                        "demented"
                    ],
                    "antonyms": [
                        "sane",
                        "sensible",
                        "rational"
                    ],
                    "common_phrases": [
                        "lunatic fringe",
                        "lunatic idea",
                        "lunatic asylum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне глупый, эксцентричный или безумный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безумный",
                                "target_lang_sense_clarification": "крайне безрассудный или нелепый"
                            },
                            {
                                "target_lang_word": "сумасшедший",
                                "target_lang_sense_clarification": "о крайне глупой идее или поведении"
                            },
                            {
                                "target_lang_word": "бредовый",
                                "target_lang_sense_clarification": "о нелепом или неосуществимом плане"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16374634-d0a4-366a-b264-8fa869df9a61",
                    "sense_definition": "Relating to or resembling the moon; lunar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lunar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old text described the <w>lunatic</w> cycles and their effect on the tides.",
                            "target_lang_translations": {
                                "ru": "В старинном тексте описывались <w>лунные</w> циклы и их влияние на приливы."
                            }
                        },
                        {
                            "text": "The landscape had a strange <w>lunatic</w> glow under the full moon.",
                            "target_lang_translations": {
                                "ru": "Пейзаж озаряло странное <w>лунное</w> сияние в свете полной луны."
                            }
                        }
                    ],
                    "synonyms": [
                        "lunar"
                    ],
                    "antonyms": [
                        "solar"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "now almost exclusively replaced by 'lunar'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к луне или напоминающий её; лунный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лунный",
                                "target_lang_sense_clarification": "связанный с луной (устаревшее в данном контексте)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}