        "fr-extract.jsonl": [
            {
                "entry_id": "e326bd2d-7d5f-3853-aaef-37694a2d39bb",
                "word": "portrait-robot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dbffd97e-32da-4373-98a9-49fe7b7546a1",
                        "entry_id": "e326bd2d-7d5f-3853-aaef-37694a2d39bb",
                        "tags": [
                            "plural"
                        ],
                        "form": "portraits-robots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2dbfc5da-e13c-3be3-bddb-9249a27620ed",
                        "entry_id": "e326bd2d-7d5f-3853-aaef-37694a2d39bb",
                        "glosses": [
                            "Outil d'enquête en police judiciaire qui vise à faire le portrait le plus ressemblant possible du visage d’un criminel inconnu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "662ca80c-9268-42e6-a10c-9f1e07527a23",
                                "sense_id": "2dbfc5da-e13c-3be3-bddb-9249a27620ed",
                                "text": "Le portrait-robot était dessiné, composé et redessiné à partir de bandes de photo (cheveux, yeux, nez, bouche, menton) en fonction des indications données par les victimes ou les témoins. Aujourd’hui, il existe des logiciels capables d’informatiser la création d’un portrait-robot."
                            }
                        ]
                    },
                    {
                        "sense_id": "2954516f-2007-317c-806b-87dcefdf0ea6",
                        "entry_id": "e326bd2d-7d5f-3853-aaef-37694a2d39bb",
                        "glosses": [
                            "Personne rassemblant en elle différents éléments disparates."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0ead42ac-a6f5-470f-b317-11ade35b1dcc",
                                "sense_id": "2954516f-2007-317c-806b-87dcefdf0ea6",
                                "text": "Ce n’est plus un compositeur : c’est un portrait-robot du compositeur au vingtième siècle."
                            },
                            {
                                "example_id": "83ade720-0d23-4d9f-bb60-ac15597b12df",
                                "sense_id": "2954516f-2007-317c-806b-87dcefdf0ea6",
                                "text": "S'il y avait un portrait robot de la personne la plus à risque sur la route, il s'agirait donc d'un homme, conducteur de voiture, entre 18 et 44 ans, et qui roule majoritairement hors agglomération."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3fb2909-e1b6-4122-8c96-f48da00042d2",
                        "source_entry_id": "e326bd2d-7d5f-3853-aaef-37694a2d39bb",
                        "target_lang_word": "Phantombild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phantombild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e2ec4d3-18d6-304a-876f-c56794f7c11d",
                                        "entry_id": "55c7e951-c02b-3aaa-9c6b-47f3dfcd7d93",
                                        "glosses": [
                                            "Bild eines mutmaßlichen Täters, das anhand von Zeugenaussagen und/oder anderer Informationen (früher manuell, heutzutage per Computerprogramm) erstellt worden ist"
                                        ],
                                        "tags": [
                                            "Kriminalistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bf2c664-621f-4199-be85-ae759704fd8c",
                                                "sense_id": "4e2ec4d3-18d6-304a-876f-c56794f7c11d",
                                                "text": "Aufgrund eines Phantombildes hielten die Nachbarn Herrn K. für den gesuchten Bankräuber."
                                            },
                                            {
                                                "example_id": "f2dc11ec-e256-4108-9928-1428ad1f48c6",
                                                "sense_id": "4e2ec4d3-18d6-304a-876f-c56794f7c11d",
                                                "text": "„Schwerer wiegt schon, daß Kraft sich nach Veröffentlichung des Phantombildes einen Bart wachsen ließ und eine modernere Brille aufsetzte.“"
                                            },
                                            {
                                                "example_id": "39bace3a-07d1-454f-895f-1cbaef6fa980",
                                                "sense_id": "4e2ec4d3-18d6-304a-876f-c56794f7c11d",
                                                "text": "„Sechs Tage nach dem Mord setzt die Polizei ein Phantombild des mutmaßlichen Täters in Umlauf, das das Bundeskriminalamt in Wiesbaden nach einer Zeichnung angefertigt hat.“"
                                            },
                                            {
                                                "example_id": "77b3e0d7-c3a4-48c5-9ffd-9cd246e5bf83",
                                                "sense_id": "4e2ec4d3-18d6-304a-876f-c56794f7c11d",
                                                "text": "„Die 850 Hinweise, die bis Sonntag nach der Veröffentlichung eines Phantombilds und neuer Fragen einlangten, brachten einen ersten Erfolg: Noch am Freitag gab es drei Hausdurchsuchungen.“"
                                            },
                                            {
                                                "example_id": "74d16a3d-7b8a-4411-8636-438af7241fd5",
                                                "sense_id": "4e2ec4d3-18d6-304a-876f-c56794f7c11d",
                                                "text": "„Kaum war der Entführer aus dem Taxi gestiegen, begann eine Großfahndung mit Phantombildern.“"
                                            },
                                            {
                                                "example_id": "ac8d24e2-8cde-4591-a6db-00bac0dd0f0e",
                                                "sense_id": "4e2ec4d3-18d6-304a-876f-c56794f7c11d",
                                                "text": "„Nach Zeugenaussagen ließ die Polizei Phantombilder des Tatverdächtigen anfertigen und öffentlich nach ihm fahnden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
