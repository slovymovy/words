                        "glosses": [
                            "тесьма, лямка, поддерживающая на плечах сарафан, юбку, сорочку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d7a48e-97ff-48e3-b721-54d335a11bd6",
                                "sense_id": "1f357e07-eac5-374e-a19a-256182f0d3fb",
                                "text": "Она тоже одета была в косоклинный сарафан из синего изгребного холста с жёлтой оторочкой на проймах."
                            }
                        ]
                    }
