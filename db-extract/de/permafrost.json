                "senses": [
                    {
                        "sense_id": "85fea53b-f537-396d-bb5f-171675a364fa",
                        "entry_id": "3535c017-e68d-3d55-a464-6f5d859d665a",
                        "glosses": [
                            "Erdschicht, welche über das ganze Jahr gefroren ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "869c4080-b1ae-47ee-a720-d94649f7250e",
                                "sense_id": "85fea53b-f537-396d-bb5f-171675a364fa",
                                "text": "Der Permafrost muss also mit dem gleichen Ernst untersucht werden wie das schmelzende Gletscher- und Meereis."
                            },
                            {
                                "example_id": "356a1d71-caef-4f62-a0f0-eaf7a0d184e4",
                                "sense_id": "85fea53b-f537-396d-bb5f-171675a364fa",
                                "text": "Der Permafrost an der Zugspitze könnte nach neuen Berechnungen des Bayerischen Landesamts für Umwelt (LfU) schon um das Jahr 2080 verschwunden sein."
                            },
                            {
                                "example_id": "ad5a1ac0-20ba-4c8a-bba2-1df60e06796e",
                                "sense_id": "85fea53b-f537-396d-bb5f-171675a364fa",
                                "text": "„Der arktische Permafrost weicht schneller auf, als bislang angenommen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f78e616-b395-4373-883a-eb574f22d0b5",
                        "source_entry_id": "3535c017-e68d-3d55-a464-6f5d859d665a",
                        "source_sense_id": "85fea53b-f537-396d-bb5f-171675a364fa",
                        "source_sense_description": "Erdschicht, welche über das ganze Jahr gefroren ist",
                        "target_lang_word": "永久冻土",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c6abbfc4-5404-4246-9732-a4841fae43dc",
                        "source_entry_id": "3535c017-e68d-3d55-a464-6f5d859d665a",
                        "source_sense_id": "85fea53b-f537-396d-bb5f-171675a364fa",
                        "source_sense_description": "Erdschicht, welche über das ganze Jahr gefroren ist",
                        "target_lang_word": "permafrost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permafrost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f349978e-f7ad-3b0e-aec0-465f167c455b",
                                        "entry_id": "3599bc32-b07a-35c8-8c8d-1b9547583800",
                                        "glosses": [
                                            "Permanently frozen ground, or a specific layer thereof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f599144e-5918-41b1-8d8d-30619a55a8f4",
                                                "sense_id": "f349978e-f7ad-3b0e-aec0-465f167c455b",
                                                "text": "Nevertheless, the water molecule is present, as ice, in a solid form in frozen soils or permafrosts, which cover large regions characterised by a polar climate."
                                            },
                                            {
                                                "example_id": "835ffc5f-9f47-4425-b14a-2c5ee7e2b534",
                                                "sense_id": "f349978e-f7ad-3b0e-aec0-465f167c455b",
                                                "text": "In agreement with our overall trends within the permafrost samples, lower nirK and nirS and higher nosZ diversity have been identified in cryoturbated peat vs. unturbated peat soils (Palmer and Horn, 2012 )."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8ee04fc-ea4d-4287-a2f1-58c9a25cfcfc",
                        "source_entry_id": "3535c017-e68d-3d55-a464-6f5d859d665a",
                        "source_sense_id": "85fea53b-f537-396d-bb5f-171675a364fa",
                        "source_sense_description": "Erdschicht, welche über das ganze Jahr gefroren ist",
                        "target_lang_word": "permafrost",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permafrost",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81c50508-5564-36ff-9fcb-ccf146cd2e61",
                                        "entry_id": "411fa167-9528-3ec2-b9d4-2157a4335af8",
                                        "glosses": [
                                            "Couche de sol gelé en permanence."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9faab851-9444-46ba-a934-ad008dbd0f60",
                                                "sense_id": "81c50508-5564-36ff-9fcb-ccf146cd2e61",
                                                "text": "Le permafrost représente environ 20 % de la surface de terre du monde, 25 millions de km², dont un quart des terres émergées de l’hémisphère Nord."
                                            },
                                            {
                                                "example_id": "da2ce07d-315f-4998-a093-29bcae48ba65",
                                                "sense_id": "81c50508-5564-36ff-9fcb-ccf146cd2e61",
                                                "text": "Les petites fentes de gel et les nombreuses déformations dues à la géliturbation indiquent un climat très froid ; l’humidité (taches d’hydromorphie) était sans doute favorisée par la présence d’un permafrost discontinu."
                                            },
                                            {
                                                "example_id": "934cc5c4-d5a2-44e5-a8c0-4e45d7cb4c9c",
                                                "sense_id": "81c50508-5564-36ff-9fcb-ccf146cd2e61",
                                                "text": "La plupart des scientifiques s’accordent à dire que ce phénomène est résultat du réchauffement climatique, qui entraînera des effets secondaires risquant fort d’accélérer le processus : par exemple, la fonte du permafrost libèrera du méthane, qui est un gaz à effet de serre très persistant, et la fonte de la glace de l’Arctique engendrera la perte d’une partie sa capacité de réflexion, puisque l’eau absorbe plus d’énergie solaire que la glace et la neige."
                                            },
                                            {
                                                "example_id": "98b9a909-4367-4185-99b0-680f76f8cd27",
                                                "sense_id": "81c50508-5564-36ff-9fcb-ccf146cd2e61",
                                                "text": "Le permafrost, qui cimentait les rochers, fond, les pierres chutent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aff7af36-de48-4d16-9809-0a14f6141053",
                        "source_entry_id": "3535c017-e68d-3d55-a464-6f5d859d665a",
                        "source_sense_id": "85fea53b-f537-396d-bb5f-171675a364fa",
                        "source_sense_description": "Erdschicht, welche über das ganze Jahr gefroren ist",
                        "target_lang_word": "pergélisol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pergélisol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d0d5cb9-6d35-3e58-9788-8b1ae82ceec2",
                                        "entry_id": "3650d358-e844-397e-a2a5-c2f533211017",
                                        "glosses": [
                                            "Couche de sol gelé en permanence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cdb36cd-250d-49ab-8376-3eab57447a49",
                                                "sense_id": "5d0d5cb9-6d35-3e58-9788-8b1ae82ceec2",
                                                "text": "L’exposition en adret provoque la disparition du pergélisol et celui-ci s’y réduit comme une peau de chagrin et s’amincit."
                                            },
                                            {
                                                "example_id": "5fc66d6f-36a8-4233-93d3-51bc8268fd75",
                                                "sense_id": "5d0d5cb9-6d35-3e58-9788-8b1ae82ceec2",
                                                "text": "Mais il ne s’agit jamais de pergélisol continu. De fait, seule la taïga russe est affectée par ce phénomène."
                                            },
                                            {
                                                "example_id": "ac29e571-e587-4d80-aa05-2115907e5aed",
                                                "sense_id": "5d0d5cb9-6d35-3e58-9788-8b1ae82ceec2",
                                                "text": "L’organosol insaturé, constitué d'un hydromor à sphaignes, repose sur un pergélisol d'environ 15 mètres d'épaisseur, et ceci à une altitude de 1100 mètres seulement!"
                                            },
                                            {
                                                "example_id": "10ef3401-1a4b-4558-9ce9-8009b01a2160",
                                                "sense_id": "5d0d5cb9-6d35-3e58-9788-8b1ae82ceec2",
                                                "text": "Cependant, comme les plus anciens dépôts de pergélisol datent du Pléistocène précoce — il y a environ 2,6 millions d’années — cela pourrait, malheureusement, nous empêcher de remonter plus loin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd0393df-4120-4fb2-99ee-a02df761c15c",
                        "source_entry_id": "3535c017-e68d-3d55-a464-6f5d859d665a",
