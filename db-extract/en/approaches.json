                        "glosses": [
                            "Movements to gain favour; advances."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dbba8545-a9e9-39a8-ae9f-e6b41f5bc840",
                        "entry_id": "653e20c8-5fff-3b05-a962-7f1442794165",
                        "glosses": [
                            "The covered roads, trenches, or other works made by besiegers or soldiers in their advances toward a place such as a fortress or military post."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b25a4cb-055a-4bef-9b13-9d6e3cc4bd54",
                        "source_entry_id": "653e20c8-5fff-3b05-a962-7f1442794165",
                        "source_sense_description": "movements to gain favour — see also advances",
                        "target_lang_word": "benadering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benadering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ee275a32-8190-3a92-91b2-03ff90589c7f",
                                        "entry_id": "22b87116-172e-3800-a1ba-2c5305bd4444",
                                        "glosses": [
                                            "getalswaarde die voor een bepaald praktisch doel voldoende dicht in de buurt ligt van de exacte waarde van die grootheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab3c40d-6867-458b-9d75-03a8bcdc2faf",
                                                "sense_id": "ee275a32-8190-3a92-91b2-03ff90589c7f",
                                                "text": "In een mol stof zitten bij benadering zeshonderdtwee tweehonderdveertien triljoen moleculen."
                                            },
                                            {
                                                "example_id": "5a79a078-7666-40f5-8189-2a8e691414c4",
                                                "sense_id": "ee275a32-8190-3a92-91b2-03ff90589c7f",
                                                "text": "Bovendien zou wegen slechts een benadering van het totaalbedrag opleveren en aan benaderingen doen ze bij de Duitse centrale bank niet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b8eb9c7-b5bf-367e-a926-9aabaa1e3347",
                                        "entry_id": "22b87116-172e-3800-a1ba-2c5305bd4444",
                                        "glosses": [
                                            "gezichtspunt, de richting van waaruit men naar iets beschouwd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b5751f2-da31-45be-ba55-871ad3ae78a4",
                                                "sense_id": "0b8eb9c7-b5bf-367e-a926-9aabaa1e3347",
                                                "text": "Een rationele benadering van het geschil in het Midden-Oosten is vaak ver te zoeken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bec9af51-83f6-3ab7-880c-07c039dc149c",
                                        "entry_id": "22b87116-172e-3800-a1ba-2c5305bd4444",
                                        "glosses": [
                                            "een manier om (dichter) bij een doel te komen of een probleem op te lossen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e64f0531-74fe-4f1c-800a-3ee6645f58f6",
                                                "sense_id": "bec9af51-83f6-3ab7-880c-07c039dc149c",
                                                "text": "De kwestie vraagt om een originele benadering."
                                            },
                                            {
                                                "example_id": "69537319-18ca-44df-8270-cb28592d6c35",
                                                "sense_id": "bec9af51-83f6-3ab7-880c-07c039dc149c",
                                                "text": "Hoewel ze in het begin wat moeite met de directe benadering had gehad, voelde ze hoe gaandeweg het gesprek haar gereserveerdheid verdween."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b80257e1-3786-3bb8-a224-56d71717b793",
                                        "entry_id": "22b87116-172e-3800-a1ba-2c5305bd4444",
                                        "glosses": [
                                            "het dichterbij komen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e9b2d9d-a04e-4f99-90b1-f656ccc7a82c",
                                                "sense_id": "b80257e1-3786-3bb8-a224-56d71717b793",
                                                "text": "De benadering van de stad duurde langer dan was voorzien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "060cb85d-852a-46ea-9b28-ff04375092af",
