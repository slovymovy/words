{
    "word_family": [
        "nijptang",
        "nijpend",
        "knijpen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "809902a7-1ba6-3e2c-a160-191b4d416289",
                    "sense_definition": "In een moeilijke of knellende situatie brengen; knellen of dringend worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "knellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De afhankelijkheid van fossiele brandstoffen <w>nijpt</w> meer en meer.",
                            "target_lang_translations": {
                                "en": "The dependence on fossil fuels is <w>pinching</w> more and more."
                            }
                        },
                        {
                            "text": "De financiële situatie begint nu echt te <w>nijpen</w> voor het jonge gezin.",
                            "target_lang_translations": {
                                "en": "The financial situation is really starting to <w>pinch</w> for the young family."
                            }
                        }
                    ],
                    "synonyms": [
                        "knellen",
                        "drukken"
                    ],
                    "common_phrases": [
                        "te nijpen beginnen"
                    ],
                    "target_lang_definitions": {
                        "en": "To put in a difficult, tight, or pressing situation; to pinch, squeeze, or become urgent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pinch",
                                "target_lang_sense_clarification": "to cause financial or situational hardship"
                            },
                            {
                                "target_lang_word": "squeeze",
                                "target_lang_sense_clarification": "to put under pressure or create a tight situation"
                            },
                            {
                                "target_lang_word": "bite",
                                "target_lang_sense_clarification": "to begin to have a painful or difficult effect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53156c39-f730-3cff-9b43-81054ad56cd2",
                    "sense_definition": "Met de vingers of een tang stevig vastpakken en samendrukken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "knijpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij was hevig ontsteld toen ze per ongeluk in haar arm werd <w>genepen</w>.",
                            "target_lang_translations": {
                                "en": "She was deeply upset when she was accidentally <w>pinched</w> in her arm."
                            }
                        },
                        {
                            "text": "Je moet niet zo hard in die zachte vrucht <w>nijpen</w>.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>squeeze</w> that soft fruit so hard."
                            }
                        }
                    ],
                    "synonyms": [
                        "knijpen",
                        "samendrukken",
                        "knellen"
                    ],
                    "common_phrases": [
                        "in de arm nijpen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Vaak vervangen door 'knijpen' in modern Nederlands."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To grip tightly and squeeze with the fingers or pliers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pinch",
                                "target_lang_sense_clarification": "to squeeze skin or an object between fingers"
                            },
                            {
                                "target_lang_word": "squeeze",
                                "target_lang_sense_clarification": "to press firmly with hands or fingers"
                            }
                        ]
                    }
                }
            ]
        }
    ]
