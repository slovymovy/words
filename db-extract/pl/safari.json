                                        "glosses": [
                                            "Reise (durch Afrika), auf der Großwild gejagt oder beobachtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c623171-7342-4eab-bf08-a5e013f0f303",
                                                "sense_id": "c081c0ac-f4dd-360a-924c-3437924c6b39",
                                                "text": "Auf einer Safari sollte man Kaffernbüffel, Elefant, Löwe, Leopard und Nashorn – die „Big Five“ – gesehen haben."
                                            },
                                            {
                                                "example_id": "efe39422-942b-477d-9181-df2c57556a43",
                                                "sense_id": "c081c0ac-f4dd-360a-924c-3437924c6b39",
                                                "text": "„Er, Robert Wilson, hatte auf Safari immer eine Zweierpritsche dabei, man konnte ja nie wissen, was sich so ergab.“"
                                            },
                                            {
                                                "example_id": "6cf1a4a6-91da-48ac-93b0-bba820eedb43",
                                                "sense_id": "c081c0ac-f4dd-360a-924c-3437924c6b39",
                                                "text": "„Nach ihrer ersten Safari war sie wie berauscht.“"
                                            },
                                            {
                                                "example_id": "4ab459b5-3b8f-4a11-afb0-0e33751a0249",
                                                "sense_id": "c081c0ac-f4dd-360a-924c-3437924c6b39",
                                                "text": "„Er hat sich auf seiner Safari zum großen Afrikakenner und Helden entwickelt.“"
                                            }
                                        ],
