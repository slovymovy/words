                    {
                        "sense_id": "0daff539-cbf6-3160-8208-aa1a6b787e4e",
                        "entry_id": "b0ea6039-d52e-3447-8d52-67c5f35a4e89",
                        "glosses": [
                            "een stelsel van riemen en verbindingsstukken waarmee het paard ingezet kan worden voor het werk dat er met hem gedaan gaat worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae62021b-55a4-4f24-a71e-0abf573eb09a",
                                "sense_id": "0daff539-cbf6-3160-8208-aa1a6b787e4e",
                                "text": "Het ergerde Levin dat zij hem gestoord hadden juist toen hij wilde schieten en dat zij zijn paarden in het moeras hadden laten zakken en vooral dat, terwijl hij bezig was de paarden uit te spannen om ze weer op het droge te krijgen, Oblonski noch Veslovski hem en de koetsier daarbij hielpen, daar zij geen van beiden enig begrip van een paardentuig hadden."
                            },
                            {
                                "example_id": "e5b27dd1-1232-49fe-a2e7-b89a0ebfabc2",
                                "sense_id": "0daff539-cbf6-3160-8208-aa1a6b787e4e",
                                "text": "Sieraden, naaigerei, pannen, pijpen, potten, muntjes, paardentuig, kogels, één schaats, afgekloven botjes van verorberde vogels, marmeren scherven uit Maurits' lusthof, papbordjes, tinnen soldaatjes, pruikenrollers en de funderingen van de verdwenen Spuipoort en Uiterste Poort; honderden voorwerpen vertellen het verhaal van de plek waar al eeuwen het regeringscentrum is gevestigd."
                            }
                        ]
                    }
                ],
