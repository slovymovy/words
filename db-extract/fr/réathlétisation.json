                "senses": [
                    {
                        "sense_id": "b20aea84-2c2b-315c-8653-8227d5e8f54e",
                        "entry_id": "64a9856f-9f2f-335d-8787-7e6da3612feb",
                        "glosses": [
                            "Préparation physique d’un athlète qu’encadre une équipe médicotechnique, en vue d’un retour à la compétition après une interruption due, par exemple, à une blessure, à une grossesse ou à un choc émotionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77d09316-297d-4d72-a511-b2c11d548f6b",
                                "sense_id": "b20aea84-2c2b-315c-8653-8227d5e8f54e",
                                "text": "Mais entre ce moment et le retour sur le terrain, à l’entraînement, avec l’intégrité de ses qualités physiques, se place la réhabilitation sportive, qui est en fait une rééducation de moins en moins médicale et de plus en plus sportive, ce que certains appellent « réathlétisation »."
                            },
                            {
                                "example_id": "5f0bf649-5f1b-4ccb-af4e-5b39dae344d8",
                                "sense_id": "b20aea84-2c2b-315c-8653-8227d5e8f54e",
                                "text": "Mounié (talon), Uronen (réathlétisation), Saïd et Philippoteaux (choix) sont les seuls absents pour ce dernier match amical."
                            },
                            {
                                "example_id": "65d91bf6-a5fa-41d2-bb5b-52fd66b8ca0d",
                                "sense_id": "b20aea84-2c2b-315c-8653-8227d5e8f54e",
                                "text": "Sous contrat jusqu’en 2026, le Hondurien termine sa réathlétisation suite à sa fracture du bras de début juillet."
                            }
                        ]
                    }
                ],
