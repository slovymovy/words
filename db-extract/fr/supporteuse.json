                ],
                "translations": [
                    {
                        "translation_id": "d908fe8a-b906-45c4-9e84-8b0718eb36c7",
                        "source_entry_id": "cadb8ab8-10b1-36a3-8f0a-384cd05a149d",
                        "source_sense_id": "46a21cea-174c-3c72-a57d-6b75304be30a",
                        "target_lang_word": "supporter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supporter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b44ab537-ded3-3c86-a031-d308ed608f2b",
                                        "entry_id": "3888a428-b2e3-3c40-8a15-621fa4c37a07",
                                        "glosses": [
                                            "A person who gives support to someone or something.",
                                            "A person who supports, promotes, advocates or champions a cause, movement, or political party; an adherent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94fbfeb0-d3a1-4a18-bfe0-77546cf593a5",
                                                "sense_id": "b44ab537-ded3-3c86-a031-d308ed608f2b",
                                                "text": "During the latter part of the rebellion, he has pretended to be a warm supporter of the Government, and he may have been sincere; but, from what others have told me, he said to them he was not during the early part of the rebellion."
                                            },
                                            {
                                                "example_id": "86b52b98-1f07-4e98-8460-bfb5f087451c",
                                                "sense_id": "b44ab537-ded3-3c86-a031-d308ed608f2b",
                                                "text": "Linda Sanchez […] Strong supporter of intellectual property rights; consistently voted in favor of artists and songwriters on bills before the intellectual property subcommittee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76be8b55-65d9-3ebe-bad6-ffd14e466ee3",
                                        "entry_id": "3888a428-b2e3-3c40-8a15-621fa4c37a07",
                                        "glosses": [
                                            "A person who gives support to someone or something.",
                                            "A person who provides moral or physical support to another; an attendant participating in a ceremony or procession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19241aec-3a15-48fe-9959-3bbe30358266",
                                                "sense_id": "76be8b55-65d9-3ebe-bad6-ffd14e466ee3",
                                                "text": "The Inthronization. The King ascended the Theatre, accompanied by the two Bishops his Supporters, the Great Officers of State, the Lords carrying the Swords, and the Lords who had borne Their Majesties' Regalia, and was Inthroned by the Archbishops, Bishops, and the other Peers, who then stood about the steps of the Throne."
                                            },
                                            {
                                                "example_id": "59bc5c8f-7fff-4c8c-9cd5-6adbfa0a0360",
                                                "sense_id": "76be8b55-65d9-3ebe-bad6-ffd14e466ee3",
                                                "text": "People who have not had a personal relationship with an LGBT individual are often unaware of the issues facing the community. By being an advocate and supporter of LGBT equality, you are leading by example. Odds are others will follow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c78bb22f-7380-34d9-8bcd-e5d2cc57adcd",
                                        "entry_id": "3888a428-b2e3-3c40-8a15-621fa4c37a07",
                                        "glosses": [
                                            "A person who gives support to someone or something.",
                                            "Someone who is a fan of a certain sports team or sportsperson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2bb328d-31e5-498b-8621-b34d0bf645fb",
                                                "sense_id": "c78bb22f-7380-34d9-8bcd-e5d2cc57adcd",
                                                "text": "More than 10,000 supporters attended the last match."
                                            },
                                            {
                                                "example_id": "1a142399-21b6-4a3c-ae07-a149404a2eb4",
                                                "sense_id": "c78bb22f-7380-34d9-8bcd-e5d2cc57adcd",
                                                "text": "On February 14, Mr. S. F. Sanders observed two trainloads of football supporters from Bolton which were conveyed to Luton by Nos. 45710, Irresistible, and 45712, Victory, respectively."
                                            },
                                            {
                                                "example_id": "553b81c1-f140-452b-9772-b3f34fb28c70",
                                                "sense_id": "c78bb22f-7380-34d9-8bcd-e5d2cc57adcd",
                                                "text": "With the Stoke supporters jeering Ziv's every subsequent touch, the pantomime atmosphere created by the home crowd reached a crescendo when Ziv was shown a straight red shortly after the break in extraordinary circumstances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01362115-cf1c-34f0-b866-f2b071af5f24",
                                        "entry_id": "3888a428-b2e3-3c40-8a15-621fa4c37a07",
                                        "glosses": [
                                            "Something that supports another thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ad9f45-1262-49e1-8735-a87352d086bb",
                                                "sense_id": "01362115-cf1c-34f0-b866-f2b071af5f24",
                                                "text": "Combustibility, then, is not a quality of the combustible, taken by itself. It is merely a faculty which may be brought into action through the instrumentality of a corresponding faculty in some other body. It is, in the case now before us, the union of the combustible with oxygen, and which, for this reason, is called the \"supporter\"; neither of which, however, when taken alone, can be consumed. To effect combustion, then, we must have a combustible and a supporter of combustion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34aed0c2-4df0-3f45-8468-99096f421e66",
                                        "entry_id": "3888a428-b2e3-3c40-8a15-621fa4c37a07",
                                        "glosses": [
                                            "Something that supports another thing.",
                                            "Something that supports a structure such as a building or a sculpture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69d6f3f9-0ddb-4be7-8028-81ac55462c92",
                                                "sense_id": "34aed0c2-4df0-3f45-8468-99096f421e66",
                                                "text": "Plane surfaces predominate in this factory. The glass and iron walls are joined cleanly at the corners without the intervention of piers[…]. [Peter] Behrens bounded the glass walls of his famous Turbine Hall right and left with monumental cyclopean walls. These have disappeared with [Walter] Gropius. His walls show that they are no longer supporters of the building, but simple curtains, protection against inclement weather, as Gropius put it."
                                            },
                                            {
                                                "example_id": "0ff4e60e-cc26-4e8f-9407-5e6c462243e1",
                                                "sense_id": "34aed0c2-4df0-3f45-8468-99096f421e66",
                                                "text": "[Joseph] Paxton had made this enormous water-plant [Victoria amazonica] to flower for the first time outside its native South American rivers at Chatsworth on 9 November 1848, and with its ‘radiating cantilevers and cross girders’ it had a similar structural principle, he told the Society of Arts, to the ‘longitudinal and transverse girders and supporters’ of the building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e6adac-05b6-3793-90d7-1219158ca339",
                                        "entry_id": "3888a428-b2e3-3c40-8a15-621fa4c37a07",
                                        "glosses": [
                                            "Something that supports another thing.",
                                            "An animal or figure that supports a shield in a coat of arms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b16339-e12a-495e-8d68-5cfbf27520f3",
                                                "sense_id": "f3e6adac-05b6-3793-90d7-1219158ca339",
                                                "text": "[…] I am fully perſuaded that there cannot remain a doubt of the uſe of ſupporters having originated from the fancy of ſeal-engravers. Supporters were likewiſe anciently uſed by divers perſons in private life, as appears by their ſeals, who had offices of high dignity in the ſtate, and more eſpecially by thoſe whoſe employments had the title of Lord prefixed to the ſtile; as Lord Deputy of Ireland, Lord Warden of the Cinque Ports, Lord Preſident of the Council, Lord of the Marches of Wales, Lord Warden of the Stanneries, &c."
                                            },
                                            {
                                                "example_id": "4dd81128-f0a7-44b4-9896-0e85a0cb5f26",
                                                "sense_id": "f3e6adac-05b6-3793-90d7-1219158ca339",
                                                "text": "The Unicorn is the well-known dexter Supporter of England. […] A pair of unicorns also support the shield of the Duke of Rutland. […] A Monster, a compound of a Lion and a Fish, or a Sea-Lion, is known in the fabulous menagerie of Heraldry. Two of these Sea-Lions are Supporters of the Viscount Falmouth. So are the Pegasus[…], the winged Horse of Classic antiquity, the dexter Supporter of the Baron Berwick; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a547be1-a131-3155-a650-ab1b66da6f70",
                                        "entry_id": "3888a428-b2e3-3c40-8a15-621fa4c37a07",
                                        "glosses": [
                                            "Something that supports another thing.",
                                            "A garter worn around the leg to support a sock or stocking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de12b27e-9056-4ef0-b5f3-0209c69124c2",
                                                "sense_id": "6a547be1-a131-3155-a650-ab1b66da6f70",
                                                "text": "From the radiator, where he was attaching supporters to his socks, Zooey glanced up at her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24d166eb-d19f-363a-b2a9-aeaa6526a79f",
                                        "entry_id": "3888a428-b2e3-3c40-8a15-621fa4c37a07",
                                        "glosses": [
                                            "Something that supports another thing.",
                                            "Clipping of athletic supporter."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
