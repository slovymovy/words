                ],
                "senses": [
                    {
                        "sense_id": "1fbf2374-4160-307d-ada8-9045b5a22f23",
                        "entry_id": "36543fe0-ddb2-3fab-9226-47f53586e0e5",
                        "glosses": [
                            "Faire perdre son caractère enraidi à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa4db102-79ce-4c59-abbd-796abf36a4af",
                                "sense_id": "1fbf2374-4160-307d-ada8-9045b5a22f23",
                                "text": "M. Delorme met des appareils là où je ne veux pas en mettre, et puis, après avoir enraidi ses fracturés par des appareils, il veut les désenraidir."
                            },
                            {
                                "example_id": "f9a3c772-945c-499e-8a52-791e4d28f8ac",
                                "sense_id": "1fbf2374-4160-307d-ada8-9045b5a22f23",
                                "text": "On y trouve des appareils, tantôt mis en mouvement par le pied ou la main du blessé, tantôt mobilisant le membre supérieur ou le membre inférieur, mais progressivement, sans à-coup, sans secousse, massant les muscles, y provoquant une circulation plus active, désenraidissant les articulations, les gaines tendineuses, dissipant les œdèmes et, en définitive, rétablissant la fonction compromise."
                            }
                        ]
                    }
                ],
