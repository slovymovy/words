                        "cross_references": []
                    },
                    {
                        "translation_id": "14e37b89-ab31-441b-a433-5c093ad039a3",
                        "source_entry_id": "919efa93-7154-3013-90f1-632d649cadf6",
                        "source_sense_id": "a99139ee-82ff-3ae6-9751-d4fb52a9a1fa",
                        "target_lang_word": "chum",
