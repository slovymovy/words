                            "active",
                            "past"
                        ],
                        "form": "обжёгшийся"
                    },
                    {
                        "form_id": "4037ef5f-17de-4ebc-8e0c-c72d5f975ffe",
                        "entry_id": "38061894-9c77-3b09-b26d-993a1b8ab66c",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "обжёгшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8cdfbb3-39f8-3467-a601-ae450cee4e38",
                        "entry_id": "38061894-9c77-3b09-b26d-993a1b8ab66c",
                        "glosses": [
                            "повредить себе кожный покров, соприкоснувшись с огнём, чем-либо горячим, едким или жгучим"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "624f549d-a28a-45cd-aec0-540040105b7a",
                                "sense_id": "a8cdfbb3-39f8-3467-a601-ae450cee4e38",
                                "text": "Только мазать нужно сейчас же, как обожжешься, пока не сошла кожа."
                            },
                            {
                                "example_id": "c9f375ad-8aa4-40ca-8265-a988ee98ab43",
                                "sense_id": "a8cdfbb3-39f8-3467-a601-ae450cee4e38",
                                "text": "И снова обжегся, не заметив, что касаюсь раскаленного чайника."
                            },
                            {
                                "example_id": "8a681afe-6e6e-46cb-b010-51d90c06f47f",
                                "sense_id": "a8cdfbb3-39f8-3467-a601-ae450cee4e38",
                                "text": "Один раз он сильно обжегся о раскаленную печную дверцу."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c9e40a7-aae0-3abf-a6c1-8b71a2e2c0b8",
                        "entry_id": "38061894-9c77-3b09-b26d-993a1b8ab66c",
                        "glosses": [
                            "перен., разг. совершать ошибку, терпеть сильную неудачу, получать резкий отпор при попытке сделать что-либо, добиться чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3216bfda-1c34-4ab5-88c7-3ada31262822",
                                "sense_id": "0c9e40a7-aae0-3abf-a6c1-8b71a2e2c0b8",
                                "text": "Однако, как всем известно, на этом суде власти сильно обожглись, и вряд ли этот опыт когда-либо будет повторен."
                            },
                            {
                                "example_id": "18dc5080-8c87-42fe-804c-c5814488374a",
                                "sense_id": "0c9e40a7-aae0-3abf-a6c1-8b71a2e2c0b8",
                                "text": "К тому же я крепко обжегся на предыдущей женитьбе и боялся повторения."
                            }
                        ]
                    },
                    {
                        "sense_id": "e74305de-922c-35c7-b34c-d271835afcdf",
                        "entry_id": "38061894-9c77-3b09-b26d-993a1b8ab66c",
                        "glosses": [
                            "страд. к обжечь"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "cd8d4750-8ed0-47e9-868b-30ab2208b803",
                                "sense_id": "e74305de-922c-35c7-b34c-d271835afcdf",
                                "text": "Остается ему обвянуть, в тени под навесом, на легком продувном ветерке, а уж потом закалиться, обжечься в специальной печи."
                            }
                        ]
                    }
                ],
