                ],
                "translations": [
                    {
                        "translation_id": "66bccf9c-f8c7-4888-88de-92e12e95a6f9",
                        "source_entry_id": "f01e1f1b-0b34-3097-9726-2208b9662000",
                        "source_sense_id": "3cd97b49-2a8c-371f-bbf2-4b35839985c2",
                        "target_lang_word": "hobbyist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hobbyist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20bc0d0a-418f-35fc-aedb-7c3fb3cd2b6d",
                                        "entry_id": "94db1a44-679a-3231-8bb5-beca0ce94494",
                                        "glosses": [
                                            "A person who is interested in an activity or a subject as a hobby."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3c8ac76-287f-41b2-b37e-2e366cfb66d6",
                                                "sense_id": "20bc0d0a-418f-35fc-aedb-7c3fb3cd2b6d",
                                                "text": "This computer magazine is targeted at both professionals and hobbyists."
                                            },
                                            {
                                                "example_id": "1d2ea5af-e84b-48f3-8919-865db71e96ce",
                                                "sense_id": "20bc0d0a-418f-35fc-aedb-7c3fb3cd2b6d",
                                                "text": "[Letters will not be answered if addressed] to a lady who is so busy with his own verses, or a scholar with a Greek scholium, or a hobbyist with his hobby, or any many with his own schemes and projects however good and important they may be, that he feels no interest in the concerns of others."
                                            },
                                            {
                                                "example_id": "1b9ef4ac-d2d9-4f8e-840e-31c8aeaab4c5",
                                                "sense_id": "20bc0d0a-418f-35fc-aedb-7c3fb3cd2b6d",
                                                "text": "If the Transmississippi Congress shall be left free to work out its normal purposes, to stand as a free platform for the discussion of matters proper and vital to the western side of the continent, it will survive and continue an agency of vast usefulness. But if it is to be victimized by every enthusiast, hobbyist, and crank; if it is to be forced to consider the issues of prohibition, woman's suffrage, parcels-post proposals, and every other kindred agitation, it must speedily be ridden to its death."
                                            },
                                            {
                                                "example_id": "cb0697d7-b48d-4431-b41d-e9228374d7a9",
                                                "sense_id": "20bc0d0a-418f-35fc-aedb-7c3fb3cd2b6d",
                                                "text": "The typical hobbyist – if there is such a creature – is usually a professional in a field that is oriented toward technology, according to [Alan P.] Hald. […] Most of the hobbyists are still involved with 8-bit machines, Hald said."
                                            },
                                            {
                                                "example_id": "dbcafad9-6d8f-4c3b-bdf1-869686441f53",
                                                "sense_id": "20bc0d0a-418f-35fc-aedb-7c3fb3cd2b6d",
                                                "text": "In summary, you would have to be an expert, not a beginning hobbyist, at the outset to understand and apply much of the beekeeping information available on the Internet."
                                            },
                                            {
                                                "example_id": "351c0e46-6055-43cc-a5e0-c3f7609a0673",
                                                "sense_id": "20bc0d0a-418f-35fc-aedb-7c3fb3cd2b6d",
                                                "text": "Presently the skies are cluttered with drones—2.5 million of which were purchased in 2016 by American hobbyists and businesses."
                                            },
                                            {
                                                "example_id": "82cc41d0-0dff-45f3-b652-eee181aecc72",
                                                "sense_id": "20bc0d0a-418f-35fc-aedb-7c3fb3cd2b6d",
                                                "text": "Rail is one of the few industries that can call on a wider netwok of supporters - the hobbyists who support heritage railways, or who take the chance to ride rail tours over rare track or behind heritage locomotives, remain a joyous part of our railways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b49de3c4-d8f6-381c-9753-7089ec3d661c",
                                        "entry_id": "94db1a44-679a-3231-8bb5-beca0ce94494",
                                        "glosses": [
                                            "A client in a girlfriend experience."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e0e475-81a6-4a09-8c3a-86d7c007c5a0",
                                                "sense_id": "b49de3c4-d8f6-381c-9753-7089ec3d661c",
                                                "text": "In other words, a hobbyist wants to feel special, like he is the provider's boyfriend. This interest in extra-sexual experiences by men who frequent prostitutes is well known (Stein 41; Bernstein 126)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
