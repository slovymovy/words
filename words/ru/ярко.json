    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a4fd8914-46ea-3ea7-907a-96673a1fd8fc",
                    "sense_definition": "С большим количеством света или насыщенным цветом.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "literal_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летнее солнце <w>ярко</w> освещало зелёную поляну.",
                            "target_lang_translations": {
                                "en": "The summer sun illuminated the green meadow <w>brightly</w>.",
                                "es": "El sol de verano iluminaba <w>brillantemente</w> el verde prado.",
                                "fr": "Le soleil d'été éclairait <w>brillamment</w> la claire-voie verte."
                            }
                        },
                        {
                            "text": "В окнах дома напротив <w>ярко</w> горел свет.",
                            "target_lang_translations": {
                                "en": "Lights were burning <w>brightly</w> in the windows of the house opposite.",
                                "es": "En las ventanas de la casa de enfrente la luz ardía <w>intensamente</w>.",
                                "fr": "La lumière brûlait <w>intensément</w> aux fenêtres de la maison d'en face."
                            }
                        }
                    ],
                    "synonyms": [
                        "светло",
                        "красочно"
                    ],
                    "antonyms": [
                        "тускло"
                    ],
                    "common_phrases": [
                        "ярко светить",
                        "ярко гореть",
                        "ярко освещать"
                    ],
                    "target_lang_definitions": {
                        "en": "With a large amount of light or saturated color.",
                        "es": "Con mucha luz o con un color muy intenso y vivo.",
                        "fr": "Avec beaucoup de lumière ou une couleur intense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brightly",
                                "target_lang_sense_clarification": "emitting or reflecting much light"
                            },
                            {
                                "target_lang_word": "vividly",
                                "target_lang_sense_clarification": "intense color"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "brillantemente",
                                "target_lang_sense_clarification": "con mucha luz"
                            },
                            {
                                "target_lang_word": "intensamente",
                                "target_lang_sense_clarification": "referido a colores vivos"
                            },
                            {
                                "target_lang_word": "vivamente",
                                "target_lang_sense_clarification": "con gran fuerza de color o luz"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "brillamment",
                                "target_lang_sense_clarification": "émettant beaucoup de lumière"
                            },
                            {
                                "target_lang_word": "vivement",
                                "target_lang_sense_clarification": "pour des couleurs intenses"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffd48ebb-11de-36c2-8121-911ddfd9a9f6",
                    "sense_definition": "Впечатляюще, выразительно, привлекая внимание.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_impressive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Актриса <w>ярко</w> сыграла свою роль в новом фильме.",
                            "target_lang_translations": {
                                "en": "The actress played her role <w>brilliantly</w> in the new film.",
                                "es": "La actriz interpretó <w>brillantemente</w> su papel en la nueva película.",
                                "fr": "L'actrice a joué son rôle <w>brillamment</w> dans le nouveau film."
                            }
                        },
                        {
                            "text": "Спортсмены нашей команды <w>ярко</w> выступили на соревнованиях.",
                            "target_lang_translations": {
                                "en": "Our team's athletes performed <w>impressively</w> at the competition.",
                                "es": "Los atletas de nuestro equipo tuvieron una actuación <w>impresionante</w> en la competición.",
                                "fr": "Les athlètes de notre équipe ont performé <w>avec éclat</w> lors de la compétition."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ярко выступить",
                        "ярко одеваться",
                        "ярко жить"
                    ],
                    "target_lang_definitions": {
                        "en": "Impressively, expressively, or attracting attention.",
                        "es": "De manera impresionante, expresiva o llamando la atención.",
                        "fr": "De manière impressionnante, expressive ou en attirant l'attention."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brilliantly",
                                "target_lang_sense_clarification": "regarding performance or talent"
                            },
                            {
                                "target_lang_word": "strikingly",
                                "target_lang_sense_clarification": "attracting attention"
                            },
                            {
                                "target_lang_word": "impressively",
                                "target_lang_sense_clarification": "evoking admiration"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "brillantemente",
                                "target_lang_sense_clarification": "de forma destacada o con gran talento"
                            },
                            {
                                "target_lang_word": "impresionantemente",
                                "target_lang_sense_clarification": "causando gran impresión"
                            },
                            {
                                "target_lang_word": "llamativamente",
                                "target_lang_sense_clarification": "atrayendo la atención"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "brillamment",
                                "target_lang_sense_clarification": "avec du talent ou du succès"
                            },
                            {
                                "target_lang_word": "avec éclat",
                                "target_lang_sense_clarification": "de manière spectaculaire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43fbdf91-b760-314a-9d08-25a4d0758d1a",
                    "sense_definition": "Очень заметно, отчётливо или очевидно.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_obvious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта ситуация <w>ярко</w> показала все недостатки системы.",
                            "target_lang_translations": {
                                "en": "This situation <w>starkly</w> showed all the flaws of the system.",
                                "es": "Esta situación mostró <w>claramente</w> todos los defectos del sistema.",
                                "fr": "Cette situation a <w>clairement</w> montré tous les défauts du système."
                            }
                        },
                        {
                            "text": "В романе <w>ярко</w> отражены исторические события того времени.",
                            "target_lang_translations": {
                                "en": "The historical events of that time are <w>vividly</w> reflected in the novel.",
                                "es": "En la novela se reflejan <w>vividamente</w> los acontecimientos históricos de aquella época.",
                                "fr": "Les événements historiques de cette époque sont <w>nettement</w> reflétés dans le roman."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ярко выраженный",
                        "ярко демонстрировать",
                        "ярко иллюстрировать"
                    ],
                    "target_lang_definitions": {
                        "en": "Very noticeably, distinctly, or obviously.",
                        "es": "De manera muy perceptible, clara u obvia.",
                        "fr": "Très visiblement, nettement ou clairement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clearly",
                                "target_lang_sense_clarification": "easy to perceive or understand"
                            },
                            {
                                "target_lang_word": "vividly",
                                "target_lang_sense_clarification": "producing strong, clear images in the mind"
                            },
                            {
                                "target_lang_word": "starkly",
                                "target_lang_sense_clarification": "unpleasantly clear or obvious"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "claramente",
                                "target_lang_sense_clarification": "de forma evidente u obvia"
                            },
                            {
                                "target_lang_word": "vividamente",
                                "target_lang_sense_clarification": "de forma nítida y detallada"
                            },
                            {
                                "target_lang_word": "marcadamente",
                                "target_lang_sense_clarification": "de manera muy acentuada"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "clairement",
                                "target_lang_sense_clarification": "de manière évidente et compréhensible"
                            },
                            {
                                "target_lang_word": "nettement",
                                "target_lang_sense_clarification": "de façon bien marquée"
                            }
                        ]
                    }
                }
            ]
        },
        {
