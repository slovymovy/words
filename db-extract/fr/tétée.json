                ],
                "senses": [
                    {
                        "sense_id": "e6fdedc3-6850-348c-b3c1-866bf85ac8ac",
                        "entry_id": "87684125-17b1-3c79-9ad4-4aa7274d3ca7",
                        "glosses": [
                            "Action pour un bébé humain ou animal de téter le sein de sa mère ou d'une nourrice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9a2fcb-55f0-4743-b7cc-f2cc3e4f1558",
                                "sense_id": "e6fdedc3-6850-348c-b3c1-866bf85ac8ac",
                                "text": "L’heure de la tétée."
                            },
                            {
                                "example_id": "6d2b36ac-b495-41dc-8825-f8ed443e159c",
                                "sense_id": "e6fdedc3-6850-348c-b3c1-866bf85ac8ac",
                                "text": "Une tétée copieuse."
                            },
                            {
                                "example_id": "5a922632-64e2-4236-a386-408a789c9255",
                                "sense_id": "e6fdedc3-6850-348c-b3c1-866bf85ac8ac",
                                "text": "Destiné à la boucherie, il n’avait presque jamais quitté la bergerie d’où sa mère sortait le matin avec le troupeau, pour ne rentrer qu’aux heures de tétées."
                            },
                            {
                                "example_id": "b9734d9a-317d-4bbd-b602-9c3a01346f54",
                                "sense_id": "e6fdedc3-6850-348c-b3c1-866bf85ac8ac",
                                "text": "Attendris comme des agneaux après la tétée, nous nous regardons les yeux pleins d'eau."
                            },
                            {
                                "example_id": "2c236b30-0307-4a8a-8b74-9443ed564fb7",
                                "sense_id": "e6fdedc3-6850-348c-b3c1-866bf85ac8ac",
                                "text": "Dès sa première tétée, l’enfant commence à tâter le monde."
                            },
                            {
                                "example_id": "6d73e87d-16e0-4f35-8eeb-24741fc73828",
                                "sense_id": "e6fdedc3-6850-348c-b3c1-866bf85ac8ac",
                                "text": "La promotion de la tétée est l’un des objectifs du Programme national nutrition santé (PNNS), qui a pour ambition d’ici 2010 d’amener le taux d’allaitement à 70 % des mères et d’en augmenter la durée, actuellement de deux mois et demi en moyenne."
                            },
                            {
                                "example_id": "16ae7d05-82d7-4d7c-ad42-958ece1db8cf",
                                "sense_id": "e6fdedc3-6850-348c-b3c1-866bf85ac8ac",
                                "text": "La molécule qui procure une sensation de plaisir pendant l’orgasme — l’ocytocine — est aussi celle qui favorise le lien unissant la mère et l’enfant au moment de la tétée […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a918e2b7-9530-46ed-b4ca-0a461e25c37e",
                        "source_entry_id": "87684125-17b1-3c79-9ad4-4aa7274d3ca7",
                        "source_sense_id": "e6fdedc3-6850-348c-b3c1-866bf85ac8ac",
