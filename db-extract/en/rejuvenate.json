                                                "example_id": "4286425d-b08b-4ae5-960e-9db0ef886f97",
                                                "sense_id": "3a1cb614-6e36-350f-a384-660eb040b1ce",
                                                "text": "Das Rohr verjüngt sich nach unten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "082cad40-450c-3c71-8821-2bb1298b7c3a",
                                        "entry_id": "39bb6036-5071-3da5-970d-a08e0026dd8e",
                                        "glosses": [
                                            "den Altersdurchschnitt einer Menschengruppe, eines Tier- oder Pflanzenbestandes durch Einbringung junger Individuen senken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb959905-030a-4806-8754-36ac2f062d0b",
                                                "sense_id": "082cad40-450c-3c71-8821-2bb1298b7c3a",
                                                "text": "Ein Dauerwald verjüngt sich permanent, währen ein Altersklassenwald nur gleichaltrige Bäume enthält."
                                            },
                                            {
                                                "example_id": "254a6196-8a9c-4602-904d-0efa7b5addc1",
                                                "sense_id": "082cad40-450c-3c71-8821-2bb1298b7c3a",
                                                "text": "Das Parlament muss dringend verjüngt werden, wenn es weiterhin einen Querschnitt der Gesellschaft darstellen soll."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "57fc6db4-0abf-351a-9b56-89fc365846a7",
                                        "entry_id": "39bb6036-5071-3da5-970d-a08e0026dd8e",
                                        "glosses": [
                                            "etwas jünger erscheinen lassen, als es tatsächlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b56881-9e07-42c0-8428-10feb04e0204",
                                                "sense_id": "57fc6db4-0abf-351a-9b56-89fc365846a7",
                                                "text": "Durch diese Hautcreme verjüngt sich ihre Haut um mindestens 10 Jahre."
                                            },
                                            {
                                                "example_id": "fd85c671-f277-4716-b56c-ff07428f6a08",
                                                "sense_id": "57fc6db4-0abf-351a-9b56-89fc365846a7",
                                                "text": "Die neue Liebe verjüngt ihn um Jahre, er führt sich manchmal auf wie ein Teenager."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
