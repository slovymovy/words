                    {
                        "sense_id": "4c13046a-f31a-3ccf-badc-db374763a86a",
                        "entry_id": "af12b22b-68a5-3460-ae13-d6406d95fc08",
                        "glosses": [
                            "bepaald soort langerekte parasitaire vis, Petromyzon marinus, die voorkomt in de Atlantische Oceaan"
                        ],
                        "tags": [
                            "kaaklozen"
                        ],
                        "examples": [
                            {
                                "example_id": "a21f9030-2cf8-41ef-ad36-dd73e2c6a937",
                                "sense_id": "4c13046a-f31a-3ccf-badc-db374763a86a",
                                "text": "De Amerikaanse wetenschappers keken met een microscoop naar de buik van de zeeprik, een lampreisoort die in de Atlantische oceaan voorkomt."
                            },
                            {
                                "example_id": "d501cba9-f3c5-4d0d-a080-3cc572a8dd5a",
                                "sense_id": "4c13046a-f31a-3ccf-badc-db374763a86a",
                                "text": "‘Oke biologietwitter, wat is dit in ’s hemelsnaam?’, met die woorden postte Preeti Desai enkele foto’s van een aangespoelde visachtige op het strand in Texas. Ogen had het dier ogenschijnlijk niet, maar wel een bek vol scherpe tanden. ‘Ik dacht eerst dat het een zeeprik was, maar toen ik die tanden bekeek, wist ik dat dat niet kon.’"
                            }
                        ]
                    }
