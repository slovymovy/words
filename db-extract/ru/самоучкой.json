                        "cross_references": [
                            {
                                "target_word": "tout seul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8e4ae3c-2f36-3838-90d7-d7ce3da8e1ea",
                                        "entry_id": "c5bd9e81-f8fd-30d0-b492-1cea11964613",
                                        "glosses": [
                                            "Soi-même, en propre, par ses propres moyens, sans être aidé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbe1551b-529a-4d59-a3d0-03d0049ce568",
                                                "sense_id": "b8e4ae3c-2f36-3838-90d7-d7ce3da8e1ea",
                                                "text": "Le café s’achève. « Les vaches ne vont pas se sortir toutes seules », plaisante Adrien, en traversant une vaste grange en bois."
                                            },
                                            {
                                                "example_id": "f09f63a6-9c56-4631-860a-1ec4a16c5d12",
                                                "sense_id": "b8e4ae3c-2f36-3838-90d7-d7ce3da8e1ea",
                                                "text": "Elle a fait un bébé toute seule."
                                            },
                                            {
                                                "example_id": "be2d0e73-632f-4768-8549-a53dd2223e68",
                                                "sense_id": "b8e4ae3c-2f36-3838-90d7-d7ce3da8e1ea",
                                                "text": "[…] un enfant veut faire quelque chose au-delà de ses forces, les aînés veulent l’aider ou faire la chose à sa place mais l’enfant trépigne et piaille : « Non, moi tout seul, moi tout seul !» et il se met à le faire."
                                            },
                                            {
                                                "example_id": "19c4fcc9-9abc-48ac-a4a6-5412346c9dbb",
                                                "sense_id": "b8e4ae3c-2f36-3838-90d7-d7ce3da8e1ea",
                                                "text": "Le mur de Berlin n’est pas tombé tout seul."
                                            },
                                            {
                                                "example_id": "236c9968-45f9-45ad-bb49-b84e70a781f7",
                                                "sense_id": "b8e4ae3c-2f36-3838-90d7-d7ce3da8e1ea",
                                                "text": "Tu n'enquêteras pas avec mon argent. Paye le détective toute seule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cae488f-8b47-3625-adfa-858fa4f12455",
                                        "entry_id": "c5bd9e81-f8fd-30d0-b492-1cea11964613",
                                        "glosses": [
                                            "Absolument seul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce39c290-57f5-4bdb-bd96-fa2cd81e8f12",
                                                "sense_id": "6cae488f-8b47-3625-adfa-858fa4f12455",
                                                "text": "Dutocq s’avança donc tout seul au milieu de ce congrès de gueux, et il entendit son nom répété par la foule, car il était difficile qu’il ne rencontrât pas quelque justiciable, comme Théodose y eût rencontré des clients."
                                            }
                                        ]
                                    }
