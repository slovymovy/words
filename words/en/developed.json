                    ],
                    "common_phrases": [
                        "developed film"
                    ],
                    "target_lang_definitions": {
                        "ru": "О фотопленке: прошедшая химическую обработку для проявления изображения.",
                        "nl": "Met betrekking tot fotografische film: chemisch bewerkt om het beeld zichtbaar te maken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявленный",
                                "target_lang_sense_clarification": "фотография"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ontwikkeld",
                                "target_lang_sense_clarification": "fotografische film"
                            }
                        ]
                    }
                }
            ]
        }
    ]
