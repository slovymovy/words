                    },
                    {
                        "translation_id": "abd5082e-6c08-4880-931c-20b74272b0aa",
                        "source_entry_id": "48940bad-636e-3325-8c5c-98757e40a530",
                        "source_sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                        "source_sense_description": "Eröffnung des Spiels im Mittelkreis, beim dem der Ball vom Schiedsrichter senkrecht zwischen zwei Spielern der beiden Mannschaften hochgeworfen wird",
                        "target_lang_word": "entre-deux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entre-deux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4d3d34b-22ef-31e3-bf87-8bea7542972b",
                                        "entry_id": "3c3c3c19-ff4f-3636-b556-9ff2f0ae0df1",
                                        "glosses": [
                                            "Espace entre deux choses, contigu à deux choses, au milieu de deux choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1976e27-c78b-4206-b546-8439e3c87cf1",
                                                "sense_id": "c4d3d34b-22ef-31e3-bf87-8bea7542972b",
                                                "text": "En effet, deux cartes tenaient les entre-deux des fenêtres."
                                            },
                                            {
                                                "example_id": "88368202-65db-4bdf-ad82-2d6f5b8d0a40",
                                                "sense_id": "c4d3d34b-22ef-31e3-bf87-8bea7542972b",
                                                "text": "Le plafond montrait trois poutres en saillie, mais peintes, et dont les entre-deux étaient plafonnés."
                                            },
                                            {
                                                "example_id": "3b5fefea-48aa-48bb-aa69-9c61da7e4e2e",
                                                "sense_id": "c4d3d34b-22ef-31e3-bf87-8bea7542972b",
                                                "text": "Le moindre détail rustique s’agrandit sur le fond glauque de la mer toujours présente au détour des sentiers, dans l’entre-deux des toits, l’ébrèchement des murs, au fond d’une ruelle."
                                            },
                                            {
                                                "example_id": "6419dfb8-2dcd-4b68-b6e5-743974311b9c",
                                                "sense_id": "c4d3d34b-22ef-31e3-bf87-8bea7542972b",
                                                "text": "— On a mis une ferrure pour remplir l’entre-deux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab7a9846-4ed5-3bf4-ba69-eb5784f9ffb2",
                                        "entry_id": "3c3c3c19-ff4f-3636-b556-9ff2f0ae0df1",
                                        "glosses": [
                                            "Temps entre deux périodes, deux événements."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7e44a7b-aaa8-429b-938c-e7ab170d5d64",
                                                "sense_id": "ab7a9846-4ed5-3bf4-ba69-eb5784f9ffb2",
                                                "text": "Moment de l’entre-deux où l'on sait ce que l'on laisse derrière soi sans pouvoir anticiper ce qui sera."
                                            },
                                            {
                                                "example_id": "ce3e5495-0fc7-4fd7-905b-073d796c8025",
                                                "sense_id": "ab7a9846-4ed5-3bf4-ba69-eb5784f9ffb2",
                                                "text": "Pour lutter contre les violences faites aux femmes dans notre monde politique, nous sommes aujourd’hui dans un entre-deux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "176e00f3-ab57-3d6e-9a00-54cd4a3a4d41",
                                        "entry_id": "3c3c3c19-ff4f-3636-b556-9ff2f0ae0df1",
                                        "glosses": [
                                            "Au figuré en parlant d’alternatives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af254ef5-139e-4a5b-83ab-6be639d6ac20",
                                                "sense_id": "176e00f3-ab57-3d6e-9a00-54cd4a3a4d41",
                                                "text": "[…] il faut ou bien suivre Greta ou bien s'opposer à elle. Il n’y a pas d’entre-deux. L'indifférence est un choix, comme l'engagement."
                                            },
                                            {
                                                "example_id": "11ff627a-d5c0-45d7-85fb-82d44e8425c4",
                                                "sense_id": "176e00f3-ab57-3d6e-9a00-54cd4a3a4d41",
                                                "text": "J’avais le choix entre leur mentir ou trahir la confiance de Rachel. J’ai choisi un entre-deux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6544d01b-e012-3a16-ab7a-33946a8962a6",
                                        "entry_id": "3c3c3c19-ff4f-3636-b556-9ff2f0ae0df1",
                                        "glosses": [
                                            "Petit plat servi entre deux autres plats, par exemple pour faire goûter quelque chose ou faire plaisir à une personne importante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6709e0c8-4ba5-4b3f-9679-a424617c39ec",
                                                "sense_id": "6544d01b-e012-3a16-ab7a-33946a8962a6",
                                                "text": "Il reconnaissait immédiatement ce à quoi personne n'eût jamais fait attention, et cela aussi bien dans les œuvres d'art que dans les mets d'un dîner (et de la peinture à la cuisine tout l'entre-deux était compris)."
                                            },
                                            {
                                                "example_id": "7c5e51fc-c62e-4add-afb7-0870e7803ad1",
                                                "sense_id": "6544d01b-e012-3a16-ab7a-33946a8962a6",
                                                "text": "Conseil d’ami : préférez la formule Festina ! (deux services et mignardises, à 45 $ par personne) à la formule Festa ! (trois services, plus un entre-deux et un dessert, à 85 $ par personne), beaucoup trop copieuse pour deux personnes, ou alors, partagez-la à plusieurs !"
                                            },
                                            {
                                                "example_id": "088ab295-b26a-427b-9ff5-fde59e165f14",
                                                "sense_id": "6544d01b-e012-3a16-ab7a-33946a8962a6",
                                                "text": "Mises en bouche\nDeux entrées\nUn entre-deux\nUn plat\nUn dessert\nMignardises — (site auberge-au-boeuf.secretbox.fr)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "086db266-296a-3730-923a-b49301644093",
                                        "entry_id": "3c3c3c19-ff4f-3636-b556-9ff2f0ae0df1",
                                        "glosses": [
                                            "Bande de dentelle, de tulle, de broderie qui sépare ou qui réunit les deux parties d’un tissu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e35fd3-975b-4f89-b2c0-c507f50c94fb",
                                                "sense_id": "086db266-296a-3730-923a-b49301644093",
                                                "text": "C’était un bonnet dont la passe, très ornée, se composait d’étroits bouillonnés alternant avec des entre-deux brodés. Aussi s’appliquait-elle, muette, soigneuse, repassant les bouillonnés et les entre-deux au coq, un œuf de fer fiché par une tige dans un pied de bois."
                                            },
                                            {
                                                "example_id": "616dece9-1f16-4e10-9f16-f90c89de4116",
                                                "sense_id": "086db266-296a-3730-923a-b49301644093",
                                                "text": "Bonne de Boisrosé est en guipure, le buste posé sur des draps à entre-deux de valenciennes, comme une tête de coiffeur sur le bouillonné du socle."
                                            },
                                            {
                                                "example_id": "e445dabf-b502-46b0-b3e0-91f11bec8529",
                                                "sense_id": "086db266-296a-3730-923a-b49301644093",
                                                "text": "Comprenez-moi, madame Erminia ! Je veux faire un entre-deux de dentelle, semblable à cet autre là-bas, sur l’autel du Sacré-Cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cd6d950-d56a-3eb4-a7d4-a5182590bf57",
                                        "entry_id": "3c3c3c19-ff4f-3636-b556-9ff2f0ae0df1",
                                        "glosses": [
                                            "Lancer du ballon par l’arbitre à la verticale du rond central et à mi-distance de deux adversaires, pour engager la partie et dans quelques autres situations particulières."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca2d3f58-e793-33d4-a22e-7f1437c3568f",
                                        "entry_id": "3c3c3c19-ff4f-3636-b556-9ff2f0ae0df1",
                                        "glosses": [
                                            "Situation de l'homme entre le néant et le tout, telle que l'a définie le philosophe Blaise Pascal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb632737-178e-4652-999c-05872845b6b9",
                                                "sense_id": "ca2d3f58-e793-33d4-a22e-7f1437c3568f",
                                                "text": "Cette anecdote peint l’esprit vif et complet de la Palferine, car il a l’entre-deux que voulait Pascal ; il est tendre et impitoyable ; il est comme Épaminondas, également grand aux extrémités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e11bad52-76e5-394a-8777-63663e7aa255",
                                        "entry_id": "3c3c3c19-ff4f-3636-b556-9ff2f0ae0df1",
                                        "glosses": [
                                            "Sorte de petit buffet bas qui est destiné à être positionné entre deux fenêtres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd0ed50f-25ba-404a-8ed3-9c067afb7ee0",
                                                "sense_id": "e11bad52-76e5-394a-8777-63663e7aa255",
                                                "text": "Maison Drapier : un assortiment composé d'une armoire, d'un entre-deux, de porte-fleurs, d'une bibliothèque noire élégante ; le tout très-bien fini, style Louis XIV."
                                            },
                                            {
                                                "example_id": "11560d2b-a6fe-4553-bbcb-b0e6a9fbc372",
                                                "sense_id": "e11bad52-76e5-394a-8777-63663e7aa255",
                                                "text": "Puis un entre-deux de salon en quatre bois, avec moulures noires et ornements en or mat ; cinq panneaux en fleurs de porcelaine le décorent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
