                    },
                    {
                        "sense_id": "ea2117b5-1a12-34e1-9058-2a2d8a98c7f2",
                        "entry_id": "799a129b-9a62-339c-96a0-17b9fc88d29a",
                        "glosses": [
                            "kobieta taktowna"
                        ],
                        "tags": [
                            "colloquial",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "1c72627f-4df4-43d3-bc7c-f09bd0f28f21",
                                "sense_id": "ea2117b5-1a12-34e1-9058-2a2d8a98c7f2",
                                "text": "Wśród ludzi, którzy mnie znają uchodzę za wyjątkową dyplomatkę. Szkoda, że poznałeś mnie od gorszej strony."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "547a5410-5925-4ccc-a9c5-cdd2bcfd8b8b",
                        "source_entry_id": "799a129b-9a62-339c-96a0-17b9fc88d29a",
                        "source_sense_id": "15897eb4-df34-3d4e-8826-9db2ea50895c",
                        "target_lang_word": "Aktentasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktentasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                                        "entry_id": "7d46d79a-1d16-30b2-9904-2c71140e1028",
                                        "glosses": [
                                            "Tasche für den Transport von Akten, Büchern und sonstigen Büromaterialien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a97fb5-fbfe-4d34-864e-9a36d29c0cf9",
                                                "sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                                                "text": "„Während er sprach, schaufelten seine Hände geschäftig Papierbündel aus seiner Aktentasche und ordneten sie auf dem Tisch scheinbar automatisch zu einem exakt abgezirkelten Muster.“"
                                            },
                                            {
                                                "example_id": "0261a994-428b-4634-8b45-8383ce770117",
                                                "sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                                                "text": "„Er stellt seine Aktentasche auf den Boden, nimmt mir den Besen aus der Hand und beginnt mit vorsichtigen Bewegungen – er trägt Lederschuhe – den Schnee von der Markise zu schütteln.“"
                                            },
                                            {
                                                "example_id": "4845d34f-99f3-4fea-9dff-7f5797d66f7a",
                                                "sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                                                "text": "„Jonas zog die Collegemappe aus seiner Aktentasche und überreichte sie seinem Gegenüber.“"
                                            },
                                            {
                                                "example_id": "d426ea2c-3e4b-4a02-94e3-da1ee6673c1f",
                                                "sense_id": "2067e7e8-0272-319d-bda9-f32d5eacdb24",
                                                "text": "„Sie stellte sich hinter einen großen Schwarzen, der sich eine braune Aktentasche an die Brust drückte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b518023-8b90-439e-910b-7b4c36b99670",
                        "source_entry_id": "799a129b-9a62-339c-96a0-17b9fc88d29a",
