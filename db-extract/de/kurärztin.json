                "senses": [
                    {
                        "sense_id": "b0175ff0-b3ba-3ea3-900d-6fd81ce455c0",
                        "entry_id": "7cccaa16-f0a9-3cfe-b663-b8e48089478c",
                        "glosses": [
                            "an einem Bade- und Kurort ansässige Ärztin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "014ce306-9b0c-416d-8afb-848505957365",
                                "sense_id": "b0175ff0-b3ba-3ea3-900d-6fd81ce455c0",
                                "text": "„Die dritte Bewerberin war Anfang Sechzig und hatte bisher als Kurärztin gearbeitet.“"
                            },
                            {
                                "example_id": "6d4e794a-019c-4b84-acc6-beac68bb43e3",
                                "sense_id": "b0175ff0-b3ba-3ea3-900d-6fd81ce455c0",
                                "text": "„Die Kurärztin nahm seine Schilderung mit Erstaunen auf und je mehr sie von seiner Geschichte zu hören bekam, desto Warmherziger behandelte sie ihn.“"
                            },
                            {
                                "example_id": "abc4111b-87e8-410c-9dd7-95a2a6adfbf3",
                                "sense_id": "b0175ff0-b3ba-3ea3-900d-6fd81ce455c0",
                                "text": "„Die beiden hier erwähnten Herren, deren Gesundheitsprobleme der Kurärztin seit vielen Jahren bekannt waren, waren von dieser Prozedur befreit.“"
                            },
                            {
                                "example_id": "854ee569-c42d-4e3a-9ee2-6ce662d5bde1",
                                "sense_id": "b0175ff0-b3ba-3ea3-900d-6fd81ce455c0",
                                "text": "„Die Kurärztin war schockiert und ich begeistert, denn ich konnte gut ein paar Pfund weniger gebrauchen, um wieder an mein Idealgewicht von etwas über sechzig Kilogramm heranzukommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
