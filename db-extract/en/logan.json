                    {
                        "sense_id": "f0cc6716-408f-32cf-9d03-5067921c2a75",
                        "entry_id": "d75bc75c-d9ec-3200-bc70-cb917c135b9f",
                        "glosses": [
                            "A male given name transferred from the surname. Used since at least the 19th century, and popular in the 2000s."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d32758a-7f3a-43ba-b787-e25a92a9f71b",
                                "sense_id": "f0cc6716-408f-32cf-9d03-5067921c2a75",
                                "text": "Col. Cresop, the last spring, in cold blood, and unprovoked, murdered all the relations of Logan, not sparing even my women and children. - - - Logan never felt fear. He will not turn on his heel to save his life. Who is there to mourn for Logan? No one."
                            },
                            {
                                "example_id": "0dee370a-0144-4eab-9743-cb0dd209fb71",
                                "sense_id": "f0cc6716-408f-32cf-9d03-5067921c2a75",
                                "text": "\"How about Logan?\"\n\"That's it. The perfect name!\" I exclaimed. Starla liked the name, and I thought it was exceedingly cool because one of the most exciting characters in the X-Men comics is also named Logan (nicknamed Wolverine). - - - I didn't tell Starla about the comic book connection because she would probably think I was being stupid."
                            }
                        ]
                    },
