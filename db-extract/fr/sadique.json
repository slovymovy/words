                            "feminine"
                        ],
                        "form": "sadiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73b56bb0-4754-3262-8184-3a126f913e62",
                        "entry_id": "ce5dfa59-95b7-308f-bfb6-e8b994f9f0a5",
                        "glosses": [
                            "Qui prend plaisir à faire souffrir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f56f6ce-8a0c-42e4-9858-55d22686938a",
                                "sense_id": "73b56bb0-4754-3262-8184-3a126f913e62",
                                "text": "La partie repart, les clients sadiques s’approchent, soudain intéressés de voir un froggy en situation délicate, et arrive mon tour."
                            },
                            {
                                "example_id": "a2a066d5-cfa3-4ba7-bd1a-879b4dbd5166",
                                "sense_id": "73b56bb0-4754-3262-8184-3a126f913e62",
                                "text": "On songe que les victimes de bourreaux sadiques mises en scène Wajdi Mouawad rêvaient peut-être en vain d’une ambulance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cc90a79-c6a8-4f35-beda-ea1e1f2a257d",
                        "source_entry_id": "ce5dfa59-95b7-308f-bfb6-e8b994f9f0a5",
                        "source_sense_id": "73b56bb0-4754-3262-8184-3a126f913e62",
                        "target_lang_word": "sadistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1444909e-8f73-38fc-b244-7e7747fd95dc",
                                        "entry_id": "ba925d65-f13a-35c8-a1af-dbc8e1c1f13e",
                                        "glosses": [
                                            "nach Art eines Sadisten verfahrend, den Sadismus betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ce288d-5d04-4e3c-86f5-4ec3de75a733",
                                                "sense_id": "1444909e-8f73-38fc-b244-7e7747fd95dc",
                                                "text": "„Bei ihm war ich ganz oft ziemlich sadistisch.“"
                                            },
                                            {
                                                "example_id": "818ef248-eec1-4119-8d0d-6b91ec6754b9",
                                                "sense_id": "1444909e-8f73-38fc-b244-7e7747fd95dc",
                                                "text": "„Das Bild der sadistischen Vernichtung der Großfamilie löst vielfältige Konnotationen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ad3243d-47ba-452d-8d49-acbe5eb1852b",
                        "source_entry_id": "ce5dfa59-95b7-308f-bfb6-e8b994f9f0a5",
