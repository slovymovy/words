                        "glosses": [
                            "ein Gewölbe, das sich in einer Schraubenlinie um eine Achse (Pfeiler etc.) z. B. als Unterbau einer Treppe emporwindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
