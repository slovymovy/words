                        "target_lang_word": "absorbé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absorbé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1847fa0f-9197-36ef-ae9a-3f9c5aa907fa",
                                        "entry_id": "6d5f14ea-1478-34f4-a38f-6e92007472d0",
                                        "glosses": [
                                            "Qualifie une personne profondément appliquée à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73daffb9-8bb1-479f-a7a4-2fa6ae781af0",
                                                "sense_id": "1847fa0f-9197-36ef-ae9a-3f9c5aa907fa",
                                                "text": "En vérité, monsieur Punèz, je pense que vous êtes absorbé par l’amour ou que j’ai trop auguré de votre intelligence."
                                            },
                                            {
                                                "example_id": "2d281bab-53f5-4b51-9c85-38923eaa0848",
                                                "sense_id": "1847fa0f-9197-36ef-ae9a-3f9c5aa907fa",
                                                "text": "Nora Blume fixait ses ongles, absorbée. Elle les comparait à ceux parsemés de brillants de Madame Hermani."
                                            },
                                            {
                                                "example_id": "086b296f-fdb8-4594-873a-47c71f156a92",
                                                "sense_id": "1847fa0f-9197-36ef-ae9a-3f9c5aa907fa",
                                                "text": "Il est entièrement absorbé dans l’étude des mathématiques."
                                            },
                                            {
                                                "example_id": "c2f13236-4d3a-464f-8cb7-5b58661b2b73",
                                                "sense_id": "1847fa0f-9197-36ef-ae9a-3f9c5aa907fa",
                                                "text": "Il était absorbé dans ses réflexions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absorbé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca08f793-c922-3be6-a6bf-43a0484a6234",
                                        "entry_id": "2903ebbf-fa5b-30dd-b6c8-ce1cd30cee43",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe absorber."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0c6d3c0-da91-4e4b-8d9b-92eb9084b72c",
                                                "sense_id": "ca08f793-c922-3be6-a6bf-43a0484a6234",
                                                "text": "Mais il est assez probable que la couche d’oxide a absorbé une portion de carbone des parties environnantes, et les a désacérées plus ou moins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
