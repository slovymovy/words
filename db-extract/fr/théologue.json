                        ],
                        "examples": [
                            {
                                "example_id": "81bca14e-6742-4880-8a34-1c9bdcb6a221",
                                "sense_id": "f30975e7-cb5e-3784-8645-f1fee267c641",
                                "text": "De sorte que le moindre bourgeon, en se développant, m'explique mieux à moi-même que toutes les ratiocinations des théologues."
                            },
                            {
                                "example_id": "1e7d666d-63e2-41b7-a137-c025a061b119",
                                "sense_id": "f30975e7-cb5e-3784-8645-f1fee267c641",
                                "text": "Sont présentement théologues tous les ecclésiastiques sortis de Halki, théologues en titre, mais en fait ?"
                            },
                            {
                                "example_id": "ac98d9df-a3e3-47ff-843d-dc29a8ed4fc2",
                                "sense_id": "f30975e7-cb5e-3784-8645-f1fee267c641",
                                "text": "L’Explication était sans nom d’auteur ni d’imprimeur ; mais on sut bientôt qu’elle venait des théologues de Wittemberg, qui ne cessaient de la recommander et d’en répandre des exemplaires de toutes parts."
                            },
                            {
                                "example_id": "c0514293-3daf-45ad-a872-d94c701fd23f",
                                "sense_id": "f30975e7-cb5e-3784-8645-f1fee267c641",
                                "text": "Les théologues sunnites essayèrent d’expliquer la raison d’être de l’institution califale, quels buts vise-t-elle à servir, quelles sont les qualifications qui devraient être requises pour pouvoir prétendre à cet office et qu’est-ce qui détermine les obligations des sujets."
                            }
                        ]
                    }
