                        "entry_id": "51272f13-40fc-3d1a-b839-4978e1f9ecba",
                        "glosses": [
                            "Première personne du singulier de l’imparfait du subjonctif du verbe devoir lors de la postposition du sujet principalement dans une phrase interrogative ou interronégative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "554a6134-9014-475e-95dc-fbc95eb3a485",
                                "sense_id": "13f27d0c-c313-3aab-a773-f50453f87abd",
                                "text": "Maîtres, pères, fils, et aïeuls, oncles, beaux-pères, petits-fils, gendres et proches parents : je ne désire leur mort rien au monde, dussè-je en périr."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95634f49-0072-41a6-8f93-997ebc5c3ded",
                        "source_entry_id": "51272f13-40fc-3d1a-b839-4978e1f9ecba",
                        "source_sense_id": "13f27d0c-c313-3aab-a773-f50453f87abd",
                        "target_lang_word": "should",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "should",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d780aac4-7958-3f56-90e5-fb2f1ac0785f",
                                        "entry_id": "edd338f6-4a50-32b9-9ac8-b5f9ae06b250",
                                        "glosses": [
                                            "simple past of shall"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79097835-1db5-4732-8d89-03f85fad402f",
                                                "sense_id": "d780aac4-7958-3f56-90e5-fb2f1ac0785f",
                                                "text": "I told him that I should be busy tomorrow."
                                            },
                                            {
                                                "example_id": "611aed9a-6bb3-4643-a30c-3fdb2c0d8609",
                                                "sense_id": "d780aac4-7958-3f56-90e5-fb2f1ac0785f",
                                                "text": "I was astonished at this polite offer, which my modesty induced me to ascribe more to my uniform than to my own merits, and, as I felt no inclination to refuse the compliment, I said that I should be most happy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "should",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45e36543-c585-37de-8942-552b549d5b5d",
                                        "entry_id": "d6174c07-7198-350c-af67-bbb74e3f3983",
                                        "glosses": [
                                            "Ought to; indicating opinion, advice, or instruction, about what is required or desirable.",
                                            "Used to issue an instruction (traditionally seen as carrying less force of authority than alternatives such as 'shall' or 'must')."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past",
                                            "no-present-participle",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8404738-86d4-4f0f-9b5c-ca770abb2191",
                                                "sense_id": "45e36543-c585-37de-8942-552b549d5b5d",
                                                "text": "You should never drink and drive."
                                            },
                                            {
                                                "example_id": "9e0572fd-fda5-4059-9ea3-2c486aa7104a",
                                                "sense_id": "45e36543-c585-37de-8942-552b549d5b5d",
                                                "text": "The law is clear that you should always wear a seat belt."
                                            },
                                            {
                                                "example_id": "5bbae738-9f94-4075-95b0-90600b8fb018",
                                                "sense_id": "45e36543-c585-37de-8942-552b549d5b5d",
                                                "text": "The manual says that this switch should be in the 'off' position."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7a8db23-16b7-3822-a34b-2ad1f1baf94c",
                                        "entry_id": "d6174c07-7198-350c-af67-bbb74e3f3983",
                                        "glosses": [
                                            "Ought to; indicating opinion, advice, or instruction, about what is required or desirable.",
                                            "Used to give advice or opinion that an action is, or would have been, beneficial or desirable."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past",
                                            "no-present-participle",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa63bb0b-9ed0-4cb4-9790-9d33402506ff",
                                                "sense_id": "d7a8db23-16b7-3822-a34b-2ad1f1baf94c",
                                                "text": "You should go and see that film. I think you'll enjoy it."
                                            },
                                            {
                                                "example_id": "17a0b8de-a8f6-4997-9ff1-3875d547b188",
                                                "sense_id": "d7a8db23-16b7-3822-a34b-2ad1f1baf94c",
                                                "text": "Should we go and see the police, do you think?"
                                            },
                                            {
                                                "example_id": "8e0bb8cc-6f80-4823-91c4-d3526d9ae52d",
                                                "sense_id": "d7a8db23-16b7-3822-a34b-2ad1f1baf94c",
                                                "text": "She should not have been so rude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "037ee025-ed15-3da5-b504-4e99cdd80209",
                                        "entry_id": "d6174c07-7198-350c-af67-bbb74e3f3983",
                                        "glosses": [
                                            "Ought to; indicating opinion, advice, or instruction, about what is required or desirable.",
                                            "With verbs such as 'see' or 'hear', usually in the second person, used to point out something remarkable in either a good or bad way."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "informal",
                                            "modal",
                                            "no-past",
                                            "no-present-participle",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "448bcbe7-37b0-4f91-bb68-a70ee5f1f5cb",
                                                "sense_id": "037ee025-ed15-3da5-b504-4e99cdd80209",
                                                "text": "You should see his new apartment. It's like a palace!"
                                            },
                                            {
                                                "example_id": "67b61e9d-32e1-4f87-84bb-549ce39bcd40",
                                                "sense_id": "037ee025-ed15-3da5-b504-4e99cdd80209",
                                                "text": "If you think her piano playing is bad, you should hear her sing!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47f14756-b958-345b-9c5d-a6eecce0429a",
                                        "entry_id": "d6174c07-7198-350c-af67-bbb74e3f3983",
                                        "glosses": [
                                            "Ought to; indicating opinion, advice, or instruction, about what is required or desirable.",
                                            "In questions, asks what is correct, proper, desirable, etc."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past",
                                            "no-present-participle",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d3caf8-97d3-440e-9791-242a5c426cfd",
                                                "sense_id": "47f14756-b958-345b-9c5d-a6eecce0429a",
                                                "text": "What do you think? What should I do?"
                                            },
                                            {
                                                "example_id": "69df2e06-24f3-4011-9acf-c083be52e0ad",
                                                "sense_id": "47f14756-b958-345b-9c5d-a6eecce0429a",
                                                "text": "Next month, Clemons will be brought before a court presided over by a \"special master\", who will review the case one last time. The hearing will be unprecedented in its remit, but at its core will be a simple issue: should Reggie Clemons live or die?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36446bd6-eb1e-3d08-8a9c-00d1d11a7063",
                                        "entry_id": "d6174c07-7198-350c-af67-bbb74e3f3983",
                                        "glosses": [
                                            "Ought to; expressing expectation.",
                                            "Indicates that something is expected to have happened or to be the case now."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past",
                                            "no-present-participle",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb491a40-73d5-46b9-bd91-5b0cc177c714",
                                                "sense_id": "36446bd6-eb1e-3d08-8a9c-00d1d11a7063",
                                                "text": "They should have finished by now; I'll call them to check."
                                            },
                                            {
                                                "example_id": "b2f3e12e-1220-4292-b607-ab035dae4f15",
                                                "sense_id": "36446bd6-eb1e-3d08-8a9c-00d1d11a7063",
                                                "text": "My fruit trees should be in flower, but the cold spring has set them back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d644588-253e-3690-ad9c-806f5c9f0ca7",
                                        "entry_id": "d6174c07-7198-350c-af67-bbb74e3f3983",
                                        "glosses": [
                                            "Ought to; expressing expectation.",
                                            "Will be likely to (become or do something); indicates a degree of possibility or probability that the stated thing will happen or be true in the future."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past",
                                            "no-present-participle",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d53d2a3c-3c13-4dc9-bf2d-8f1f81bf3ac7",
                                                "sense_id": "0d644588-253e-3690-ad9c-806f5c9f0ca7",
                                                "text": "They should have it finished by Friday."
                                            },
                                            {
                                                "example_id": "3eb4b5ab-d85b-4720-a4ad-6d163fce5b29",
                                                "sense_id": "0d644588-253e-3690-ad9c-806f5c9f0ca7",
                                                "text": "When you press this button, the pilot flame should ignite."
                                            },
                                            {
                                                "example_id": "f322480a-5083-49de-8670-caa77cf0bfd1",
                                                "sense_id": "0d644588-253e-3690-ad9c-806f5c9f0ca7",
                                                "text": "You should be warm enough with that coat."
                                            },
                                            {
                                                "example_id": "fc389962-c033-41a6-baad-98b1ea63ce81",
                                                "sense_id": "0d644588-253e-3690-ad9c-806f5c9f0ca7",
                                                "text": "We’re spending the winter in Ibiza. ~ That should be nice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7f94e2d-7b51-37a9-b13b-7607346be305",
                                        "entry_id": "d6174c07-7198-350c-af67-bbb74e3f3983",
                                        "glosses": [
                                            "Used to form a variant of the present subjunctive, expressing a state or action that is hypothetical, potential, mandated, etc."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past",
                                            "no-present-participle",
                                            "participle",
                                            "past",
                                            "subjunctive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "884b9b87-48de-4455-ae57-b148b0880f4d",
                                                "sense_id": "a7f94e2d-7b51-37a9-b13b-7607346be305",
                                                "text": "If I should be late, I should hope that you are prepared to go on without me."
                                            },
                                            {
                                                "example_id": "0da635c0-9efa-48ec-b3c4-3fc2cad70902",
                                                "sense_id": "a7f94e2d-7b51-37a9-b13b-7607346be305",
                                                "text": "Should you need extra blankets, you will find them in the closet."
                                            },
                                            {
                                                "example_id": "423035b8-5fd8-44fa-b2e5-1dc6a561afeb",
                                                "sense_id": "a7f94e2d-7b51-37a9-b13b-7607346be305",
                                                "text": "It's his proposal that there (should) not be several dozen units."
                                            },
                                            {
                                                "example_id": "2d4c88d3-7003-471f-9d50-3435d2ff3fff",
                                                "sense_id": "a7f94e2d-7b51-37a9-b13b-7607346be305",
                                                "text": "I regret that it should have happened, but I was really shocked that he should say that."
                                            },
                                            {
                                                "example_id": "f4ee6469-8358-4e1a-b821-9dfccfdb7b49",
                                                "sense_id": "a7f94e2d-7b51-37a9-b13b-7607346be305",
                                                "text": "'One kiss, my bonny sweetheart, I'm after a prize to-night, / But I shall be back with the yellow gold before the morning light; / Yet, if they press me sharply, and harry me through the day, / Then look for me by moonlight, / Watch for me by moonlight, / I'll come to thee by moonlight, though Hell should bar the way.'"
                                            },
                                            {
                                                "example_id": "c58d3e81-a3eb-4610-beba-9ef8d745b1c0",
                                                "sense_id": "a7f94e2d-7b51-37a9-b13b-7607346be305",
                                                "text": "It was a long weary time, for the Boy was too ill to play, and the little Rabbit found it rather dull with nothing to do all day long. But he snuggled down patiently, and looked forward to the time when the Boy should be well again, and they would go out in the garden amongst the flowers and the butterflies and play splendid games in the raspberry thicket like they used to."
                                            },
                                            {
                                                "example_id": "7844367f-5de3-410b-951b-6f087d0300cc",
                                                "sense_id": "a7f94e2d-7b51-37a9-b13b-7607346be305",
                                                "text": "And I'd be a fool right now\nIf I should hurt you girl\nAnd I'd be a fool right now\nIf I should leave you girl"
                                            },
                                            {
                                                "example_id": "618b43e8-dd24-46b8-b992-41989981b2f0",
                                                "sense_id": "a7f94e2d-7b51-37a9-b13b-7607346be305",
                                                "text": "He is noted for coming up with his 'wager', in which he argued that he was prepared to believe in God on the grounds that he had nothing to lose if he was wrong, and everything to gain should he be right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa3b4ea-9440-3e4e-863c-af77dd6faecb",
                                        "entry_id": "d6174c07-7198-350c-af67-bbb74e3f3983",
                                        "glosses": [
                                            "An alternative to would with first person subjects.",
                                            "Used to express a conditional outcome."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "formal",
                                            "literary",
                                            "modal",
                                            "no-past",
                                            "no-present-participle",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e2f753f-bf2f-40e4-9375-a369d48b7ba2",
                                                "sense_id": "5fa3b4ea-9440-3e4e-863c-af77dd6faecb",
                                                "text": "If I had not been so tired, I should have laughed heartily."
                                            },
                                            {
                                                "example_id": "b4270537-6002-4357-9758-0e7f9605a2d6",
                                                "sense_id": "5fa3b4ea-9440-3e4e-863c-af77dd6faecb",
                                                "text": "\"If our friends, the Scarecrow and the Tin Woodman, were only with us,\" said the Lion, \"I should be quite happy.\""
                                            },
                                            {
                                                "example_id": "39f0a4e4-8c70-48ca-ab0d-e3d1e662e8f6",
                                                "sense_id": "5fa3b4ea-9440-3e4e-863c-af77dd6faecb",
                                                "text": "\"Your Silver Shoes will carry you over the desert,\" replied Glinda. \"If you had known their power you could have gone back to your Aunt Em the very first day you came to this country.\" \"But then I should not have had my wonderful brains!\" cried the Scarecrow. \"I might have passed my whole life in the farmer's cornfield.\""
                                            },
                                            {
                                                "example_id": "f8cf2197-64ef-4f50-aaf6-29342d46ac88",
                                                "sense_id": "5fa3b4ea-9440-3e4e-863c-af77dd6faecb",
                                                "text": "\"Good God! I don't want another accident here. I should go dotty if I had to face all that again.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37896a84-3f6e-3d25-b2b7-db341c1bb5ed",
                                        "entry_id": "d6174c07-7198-350c-af67-bbb74e3f3983",
                                        "glosses": [
                                            "An alternative to would with first person subjects.",
                                            "Used to impart a tentative, conjectural or polite nuance."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past",
                                            "no-present-participle",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29b1e0f4-3620-4c70-9292-a3b9c56e4096",
                                                "sense_id": "37896a84-3f6e-3d25-b2b7-db341c1bb5ed",
                                                "text": "I should imagine that they have arrived by now."
                                            },
                                            {
                                                "example_id": "f7706ee7-0d0b-4ea6-9df9-62b4c4fcdc0a",
                                                "sense_id": "37896a84-3f6e-3d25-b2b7-db341c1bb5ed",
                                                "text": "I should think you would apologize."
                                            },
                                            {
                                                "example_id": "896e671e-1bd1-4596-a9d5-e04ee95476f7",
                                                "sense_id": "37896a84-3f6e-3d25-b2b7-db341c1bb5ed",
                                                "text": "I should be very grateful to receive your prompt reply. (formal or old-fashioned)"
                                            },
                                            {
                                                "example_id": "aaa9c83e-c32f-4146-8320-452c83bbf57c",
                                                "sense_id": "37896a84-3f6e-3d25-b2b7-db341c1bb5ed",
                                                "text": "We should very much like to meet her. (formal or old-fashioned)"
                                            },
                                            {
                                                "example_id": "5fc86893-e9cd-49d4-b71a-5c802535ed01",
                                                "sense_id": "37896a84-3f6e-3d25-b2b7-db341c1bb5ed",
                                                "text": "It didn’t turn out as we intended it should."
                                            },
                                            {
                                                "example_id": "0a50dd67-e857-4607-a936-eeb473a1ed7f",
                                                "sense_id": "37896a84-3f6e-3d25-b2b7-db341c1bb5ed",
                                                "text": "I should like to dine with him. I dare say he gives famous dinners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c52b7d5e-871a-3ffc-8d43-bf660f0a6a1b",
                                        "entry_id": "d6174c07-7198-350c-af67-bbb74e3f3983",
                                        "glosses": [
                                            "An alternative to would with first person subjects.",
                                            "Used to express what the speaker would do in another person's situation, as a means of giving a suggestion or recommendation."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past",
                                            "no-present-participle",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f28ac88c-1bc4-4883-a1db-058c6d931823",
                                                "sense_id": "c52b7d5e-871a-3ffc-8d43-bf660f0a6a1b",
                                                "text": "It's disgraceful the way that they've treated you. I should write and complain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "should",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "415ca769-a68e-366e-afae-78e5fe556ff8",
                                        "entry_id": "bd921a2d-8ae4-33c1-9e97-cea1f246afc9",
                                        "glosses": [
                                            "To make a statement of what ought to be true, as opposed to reality."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cae9e86f-2119-3bc1-8de6-3fa841a2c60e",
                                        "entry_id": "bd921a2d-8ae4-33c1-9e97-cea1f246afc9",
                                        "glosses": [
                                            "To suggest (that someone do something) by using the word should."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2e50ffe-ba03-4ae0-a897-9130620dc5b0",
                                                "sense_id": "cae9e86f-2119-3bc1-8de6-3fa841a2c60e",
                                                "text": "I'd prefer that she stop shoulding me. I prefer that I stop shoulding me. I prefer that I stop shoulding her."
                                            },
                                            {
                                                "example_id": "68e57d77-c9d5-4e19-91b5-fce2fef8c62b",
                                                "sense_id": "cae9e86f-2119-3bc1-8de6-3fa841a2c60e",
                                                "text": "[…] for her to be kind to herself and less susceptible to others shoulding her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "should",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35beef20-6bfe-3782-8c33-0479dc3a75a0",
                                        "entry_id": "5410c0d0-5e21-3c83-841b-08230ac46ffd",
                                        "glosses": [
                                            "Something that ought to be the case as opposed to already being the case."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41a640c4-8e32-4d31-a420-1dd7ba1458d7",
                                                "sense_id": "35beef20-6bfe-3782-8c33-0479dc3a75a0",
                                                "text": "When the golf ball is there, the whole self-interference package — the hopes, worries, and fears; the thoughts on how-to and how-not-to; the woulds, the coulds, and the shoulds — is there too."
                                            },
                                            {
                                                "example_id": "40b7e606-6a8c-4679-bdac-e20402722e36",
                                                "sense_id": "35beef20-6bfe-3782-8c33-0479dc3a75a0",
                                                "text": "However, we can address maladaptive shoulds by examining the differences between prior events, causes, proximate causes, and moral responsibility."
                                            },
                                            {
                                                "example_id": "96544383-502e-4031-a38a-9db5685333f5",
                                                "sense_id": "35beef20-6bfe-3782-8c33-0479dc3a75a0",
                                                "text": "Being a list-o-maniac, I suggested we make a list of the \"shoulds\" and \"shouldn'ts.\" So in the darkness of hazy sleep, I began to mentally prepare mine. The first item on the \"should\" side was easy: a sibling for our 3-year-old daughter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
