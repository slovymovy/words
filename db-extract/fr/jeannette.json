                ],
                "senses": [
                    {
                        "sense_id": "a76c73cd-a9cf-3d5a-bc20-5d0979684c13",
                        "entry_id": "3e67ca20-ed42-3c40-b07d-217520263e89",
                        "glosses": [
                            "Prénom féminin correspondant au prénom masculin Jeannot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87b2f006-d02e-489a-a465-0f13b89f50de",
                                "sense_id": "a76c73cd-a9cf-3d5a-bc20-5d0979684c13",
                                "text": "Une voix, derrière la porte, appela: « Jeannette! »"
                            },
                            {
                                "example_id": "bec2ff16-5402-403d-9f79-7049231ed881",
                                "sense_id": "a76c73cd-a9cf-3d5a-bc20-5d0979684c13",
                                "text": "Il a une affreuse fille que nous haïssions, Laurent et moi. Elle s’appelle Jeannette mais nous ne l’appelions que « Le Pou »."
                            },
                            {
                                "example_id": "648ed71c-3415-4547-a119-9a51eac63a38",
                                "sense_id": "a76c73cd-a9cf-3d5a-bc20-5d0979684c13",
                                "text": "Pour nombre de Saujonnais, Jeannette Grenon restera cette monitrice d’auto-école, connue pour sa grande gentillesse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "158c6c1c-8e52-40ad-b02b-6bfcccde385c",
                        "source_entry_id": "3e67ca20-ed42-3c40-b07d-217520263e89",
                        "source_sense_id": "a76c73cd-a9cf-3d5a-bc20-5d0979684c13",
                        "target_lang_word": "Janet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Janet",
