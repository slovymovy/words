                            {
                                "target_lang_word": "unterdrückt",
                                "target_lang_sense_clarification": "Lachen oder Schrei zurückgehalten"
                            },
                            {
                                "target_lang_word": "verhalten",
                                "target_lang_sense_clarification": "leise, zurückhaltend im Ton"
                            }
                        ],
                        "es": [
                            {
