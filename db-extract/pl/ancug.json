                        ],
                        "examples": [
                            {
                                "example_id": "ed7c3479-f76e-4354-89df-d48d9e3b4cff",
                                "sense_id": "f5674fd5-e06d-3919-b4fa-f07218efa926",
                                "text": "Mój fater łaziłby w tym ancugu durś, bez niedziela i bez tydzień."
                            },
                            {
                                "example_id": "eacce57f-5466-4bdd-a93d-f409b3993615",
                                "sense_id": "f5674fd5-e06d-3919-b4fa-f07218efa926",
                                "text": "O, zaraz, mam tu piękny ancug z westką i do tego jeszcze elegancki kapelinder, w sam raz wszystko dla pana, jakby było specjalnie uszyte na miarę"
                            }
                        ],
