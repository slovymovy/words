{
    "word_family": [
        "initiation",
        "initiateur",
        "initiatrice",
        "initiatique"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a70ed24-8e44-3425-bd32-8b334fc9104b",
                    "sense_definition": "Donner à quelqu'un les premières notions d'un art, d'une technique ou d'une discipline.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "apprentissage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père a voulu m'<w>initier</w> au jeu d'échecs dès mon plus jeune âge."
                        },
                        {
                            "text": "Pendant les vacances, les enfants s'<w>initient</w> à la poterie dans cet atelier artisanal."
                        }
                    ],
                    "common_phrases": [
                        "initier à l'art",
                        "initier à l'informatique"
                    ]
                },
                {
                    "sense_id": "4249fd41-7249-39b8-99eb-d5a9b8e2382c",
                    "sense_definition": "Prendre l'initiative de commencer ou de mettre en place une action, une démarche ou un projet.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "commencement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur souhaite <w>initier</w> un projet de modernisation pour améliorer la productivité de l'entreprise."
                        },
                        {
                            "text": "Le gouvernement a <w>initié</w> des négociations avec les syndicats afin d'éviter une grève générale."
                        }
                    ],
                    "synonyms": [
                        "commencer",
                        "démarrer"
                    ],
                    "antonyms": [
                        "arrêter",
                        "cesser",
                        "finir",
                        "terminer"
                    ],
                    "common_phrases": [
                        "initier un projet",
                        "initier des démarches",
                        "initier des négociations"
                    ]
                },
                {
                    "sense_id": "75ff5ecb-3d5e-3075-af42-e40215bfb42e",
                    "sense_definition": "Admettre une personne à la connaissance de doctrines secrètes, de mystères ou de rites particuliers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion_culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la Grèce antique, il fallait accomplir plusieurs rituels de purification avant d'<w>initier</w> un nouveau membre."
                        },
                        {
                            "text": "Le prêtre a <w>initié</w> les jeunes disciples aux cérémonies sacrées du temple."
                        }
                    ],
                    "common_phrases": [
                        "initier aux mystères"
                    ]
                },
                {
                    "sense_id": "0f8b8f24-6487-3879-aa97-c67e3d5b5571",
                    "sense_definition": "Déclencher ou amorcer une réaction chimique ou un mécanisme biologique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sciences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ajout d'une faible quantité d'acide permet d'<w>initier</w> la réaction en chaîne dans le réacteur."
                        },
                        {
                            "text": "Certains signaux moléculaires précis <w>initient</w> la division cellulaire au sein des tissus vivants."
                        }
                    ],
                    "common_phrases": [
                        "initier une réaction"
                    ]
                }
            ]
        }
    ]
}