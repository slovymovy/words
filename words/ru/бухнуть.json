{
    "word_family": [
        "буханье",
        "бух",
        "разбухание",
        "набухание",
        "выпивка"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc7bc9d7-a7dd-390c-b9e2-5732af7ac90a",
                    "sense_definition": "увеличиваться в объёме, впитывая влагу; <w>набухать</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "swell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От постоянных дождей старые деревянные двери в доме начали <w>бухнуть</w> и теперь плохо закрываются.",
                            "target_lang_translations": {
                                "en": "Due to the constant rain, the old wooden doors in the house began to <w>swell</w> and now they don't close well."
                            }
                        },
                        {
                            "text": "Семена в тёплой воде быстро <w>бухнут</w> и готовятся к прорастанию.",
                            "target_lang_translations": {
                                "en": "Seeds in warm water quickly <w>swell</w> and prepare for germination."
                            }
                        }
                    ],
                    "synonyms": [
                        "набухать",
                        "разбухать"
                    ],
                    "antonyms": [
                        "опадать",
                        "спадать"
                    ],
                    "common_phrases": [
                        "двери бухнут",
                        "семена бухнут"
                    ],
                    "target_lang_definitions": {
                        "en": "to increase in volume by absorbing moisture; to swell up"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swell",
                                "target_lang_sense_clarification": "to expand due to moisture"
                            },
                            {
                                "target_lang_word": "bloat",
                                "target_lang_sense_clarification": "to become swollen with liquid"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a5723dc5-3df4-3206-b1dc-6bb08190d43b",
                    "sense_definition": "произвести громкий, глухой звук при ударе или падении",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он со всей силы <w>бухнул</w> кулаком по столу, требуя тишины в комнате.",
                            "target_lang_translations": {
                                "en": "He <w>thumped</w> his fist on the table with all his might, demanding silence in the room."
                            }
                        },
                        {
                            "text": "Где-то вдалеке тяжело <w>бухнул</w> колокол, созывая людей на вечернюю службу.",
                            "target_lang_translations": {
                                "en": "Somewhere in the distance, a bell <w>tolled</w> heavily, summoning people to the evening service."
                            }
                        }
                    ],
                    "common_phrases": [
                        "бухнуть кулаком",
                        "тяжело бухнуть"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to produce a loud, dull sound upon impact or falling"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thump",
                                "target_lang_sense_clarification": "to hit making a muffled sound"
                            },
                            {
                                "target_lang_word": "bang",
                                "target_lang_sense_clarification": "to strike with a loud noise"
                            },
                            {
                                "target_lang_word": "thud",
                                "target_lang_sense_clarification": "to make a dull sound on impact"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca63c8c1-8340-35ab-a24a-698023422e42",
                    "sense_definition": "сказать что-либо резко, неожиданно или не подумав",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не подумал о последствиях и <w>бухнул</w> правду прямо в лицо начальнику.",
                            "target_lang_translations": {
                                "en": "He didn't think about the consequences and <w>blurted out</w> the truth right to his boss's face."
                            }
                        },
                        {
                            "text": "Она может внезапно <w>бухнуть</w> какую-нибудь глупость в самый неподходящий момент.",
                            "target_lang_translations": {
                                "en": "She might suddenly <w>blurt out</w> some nonsense at the most inappropriate moment."
                            }
                        }
                    ],
                    "synonyms": [
                        "сморозить"
                    ],
                    "common_phrases": [
                        "бухнуть правду",
                        "бухнуть невпопад"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to say something abruptly, unexpectedly, or without thinking"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blurt out",
                                "target_lang_sense_clarification": "to say something suddenly"
                            },
                            {
                                "target_lang_word": "let slip",
                                "target_lang_sense_clarification": "to reveal something unintentionally"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "873e8525-0ca6-3f9a-93e4-776c8cdc668c",
                    "sense_definition": "тяжело и шумно бросить что-либо или упасть самому",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Грузчики с грохотом <w>бухнули</w> тяжелый сундук на деревянный пол.",
                            "target_lang_translations": {
                                "en": "The movers <w>thumped</w> the heavy chest onto the wooden floor with a crash."
                            }
                        },
                        {
                            "text": "Устав после долгого похода, он <w>бухнул</w> мешок на землю и сел рядом.",
                            "target_lang_translations": {
                                "en": "Tired after the long hike, he <w>dropped</w> his bag heavily on the ground and sat down next to it."
                            }
                        }
                    ],
                    "common_phrases": [
                        "бухнуть на пол",
                        "бухнуть мешок"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to throw something down or fall oneself heavily and noisily"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plonk down",
                                "target_lang_sense_clarification": "to set something down heavily"
                            },
                            {
                                "target_lang_word": "dump",
                                "target_lang_sense_clarification": "to drop something heavily"
                            },
                            {
                                "target_lang_word": "thump",
                                "target_lang_sense_clarification": "to drop with a heavy sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1569604c-8ced-34dd-ac36-0762f73f57c7",
                    "sense_definition": "произвести мощный выстрел или взрыв (обычно об орудиях)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вдалеке гулко <w>бухнули</w> пушки, возвещая о начале наступления.",
                            "target_lang_translations": {
                                "en": "In the distance, the cannons <w>boomed</w> resonantly, announcing the start of the offensive."
                            }
                        },
                        {
                            "text": "На рассвете внезапно <w>бухнуло</w> орудие, и все в лагере проснулись.",
                            "target_lang_translations": {
                                "en": "At dawn, a gun suddenly <w>fired</w> with a bang, and everyone in the camp woke up."
                            }
                        }
                    ],
                    "common_phrases": [
                        "бухнули орудия",
                        "пушка бухнула"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to produce a powerful shot or explosion, typically referring to artillery"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boom",
                                "target_lang_sense_clarification": "to make a deep resonant sound"
                            },
                            {
                                "target_lang_word": "thunder",
                                "target_lang_sense_clarification": "to make a loud booming noise"
                            },
                            {
                                "target_lang_word": "bang",
                                "target_lang_sense_clarification": "the sound of a gun firing"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a645a28c-27da-33af-a6ee-fb994f2974b6",
                    "sense_definition": "выпить большое количество алкоголя",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Друзья решили <w>бухнуть</w> в пятницу вечером после тяжелой рабочей недели.",
                            "target_lang_translations": {
                                "en": "The friends decided to <w>go boozing</w> on Friday night after a hard work week."
                            }
                        },
                        {
                            "text": "Они зашли в бар, чтобы немного <w>бухнуть</w> и обсудить последние новости.",
                            "target_lang_translations": {
                                "en": "They went into a bar to <w>have a few drinks</w> and discuss the latest news."
                            }
                        }
                    ],
                    "common_phrases": [
                        "пойти бухнуть",
                        "немного бухнуть"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "вульгарное, сленг"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to drink a large amount of alcohol"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "booze",
                                "target_lang_sense_clarification": "to drink alcohol heavily"
                            },
                            {
                                "target_lang_word": "get hammered",
                                "target_lang_sense_clarification": "to drink to intoxication"
                            },
                            {
                                "target_lang_word": "hit the bottle",
                                "target_lang_sense_clarification": "to start drinking heavily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30253594-b890-3695-a311-fb00c5e745c1",
                    "sense_definition": "резко броситься вниз или упасть (обычно в ноги для просьбы)",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она решила <w>бухнуть</w> мужу в ноги и честно рассказать о своей ошибке.",
                            "target_lang_translations": {
                                "en": "She decided to <w>throw herself</w> at her husband's feet and honestly tell him about her mistake."
                            }
                        },
                        {
                            "text": "Старик хотел <w>бухнуть</w> на колени перед иконой, но силы покинули его.",
                            "target_lang_translations": {
                                "en": "The old man wanted to <w>drop</w> to his knees before the icon, but his strength failed him."
                            }
                        }
                    ],
                    "synonyms": [
                        "бу́хнуться"
                    ],
                    "common_phrases": [
                        "бухнуть в ноги",
                        "бухнуть на колени"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to throw oneself down or fall abruptly, often at someone's feet to plead"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throw oneself",
                                "target_lang_sense_clarification": "to fall at someone's feet"
                            },
                            {
                                "target_lang_word": "flop down",
                                "target_lang_sense_clarification": "to fall down suddenly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}