                    },
                    {
                        "translation_id": "0456d75a-7135-434b-8bb0-f895c84409a2",
                        "source_entry_id": "c4dfe61e-611a-32e5-bea5-a34a06b8074c",
                        "source_sense_id": "2104cc9f-5933-3a05-bf22-f9c6aeb0fb2f",
                        "source_sense_description": "road or path on an airport for taxiing",
                        "target_lang_word": "Rollbahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rollbahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9fd1a9b-722e-39ce-9392-2fd65f95957f",
                                        "entry_id": "70ae65b5-59d5-3d24-b4ea-6244abb8a5e0",
                                        "glosses": [
                                            "von Flugzeugen befahrbarer Weg, der das Vorfeld eines Flugplatzes mit den Start- und Landebahnen verbindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af01560e-8eab-4b25-9b31-3717ea9d3d66",
                                                "sense_id": "a9fd1a9b-722e-39ce-9392-2fd65f95957f",
                                                "text": "„Experten sollen nun klären, wie es zu dem Kontakt kommen konnte. Dafür sei ein Teil der Rollbahn gesperrt worden, berichtete der Sender RTE.“"
                                            },
                                            {
                                                "example_id": "4950a3a7-0b02-4db7-9253-d09e76db394e",
                                                "sense_id": "a9fd1a9b-722e-39ce-9392-2fd65f95957f",
                                                "text": "„Über einen Zufahrtsweg, der ausschließlich für Luftfahrtpersonal gedacht ist, lotste der Dienst die Fahrer bis auf eine Rollbahn, den \"Taxiway Bravo\".“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47686f7b-f9ee-46ff-a363-4c0d28bd60fb",
                        "source_entry_id": "c4dfe61e-611a-32e5-bea5-a34a06b8074c",
                        "source_sense_id": "2104cc9f-5933-3a05-bf22-f9c6aeb0fb2f",
                        "source_sense_description": "road or path on an airport for taxiing",
                        "target_lang_word": "Rollfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rollfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "757a6943-5763-3ea1-8c26-3c921d2ca783",
                                        "entry_id": "6446b1e4-bcdf-314f-a8ae-cdf7b819776d",
                                        "glosses": [
                                            "alle Bereiche auf einem Flugplatz, die von Flugzeugen befahren werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0d773ad-47ab-4296-87f3-2a7de5bc36ec",
                                                "sense_id": "757a6943-5763-3ea1-8c26-3c921d2ca783",
                                                "text": "„Am Abend wollten wir mit Royal Air Maroc weiter nach Marrakesch, und es war ein so herrliches Gefühl, ohne Liebeskummer über das Rollfeld zu gehen.“"
                                            },
                                            {
                                                "example_id": "f04723c6-8295-4550-8cdd-2a194e04c96f",
                                                "sense_id": "757a6943-5763-3ea1-8c26-3c921d2ca783",
                                                "text": "„Auf dem Rollfeld nimmt die Militärpolizei von Katanga die blutverschierten Häftlinge in Empfang.“"
                                            },
                                            {
                                                "example_id": "8e1b5b54-0a34-45a9-90a2-ac8a011b3c85",
                                                "sense_id": "757a6943-5763-3ea1-8c26-3c921d2ca783",
                                                "text": "„In der späten Morgendämmerung stand das Kreuz des Südens klar und schön über der Betonbahn des Rollfeldes.“"
                                            },
                                            {
                                                "example_id": "371fc3fc-cb43-4aa8-9d45-3cbe6e0f4a4d",
                                                "sense_id": "757a6943-5763-3ea1-8c26-3c921d2ca783",
                                                "text": "„Mit dem Feldstecher verschaffte er sich einen Überblick vom Rollfeld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
