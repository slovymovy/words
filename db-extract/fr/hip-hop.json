                "entry_id": "2a0a5ffa-473b-31d8-aab3-a2fceb7114ef",
                "word": "hip-hop",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "94088f8b-7da2-4870-8a2b-6815b437f8fc",
