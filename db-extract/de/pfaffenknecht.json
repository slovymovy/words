                        "entry_id": "17ba8c82-0d51-3dca-884e-70ee0b252edf",
                        "glosses": [
                            "Anhänger der Geistlichkeit, unterwürfiger Kirchendiener"
                        ],
                        "tags": [
                            "abschätzig"
                        ],
                        "examples": [
                            {
                                "example_id": "9bbd1859-1ea4-4c36-a4aa-f32294f57f3e",
                                "sense_id": "7b3b8481-c194-386e-8567-d98aeaa4cff2",
                                "text": "„Er halte dafür, an den Schweizern sei Hopfen und Malz verloren, sie seien alle geborne Aristokraten und dumme Pfaffenknechte, darum wolle er so schnell wie möglich nach Paris hinein.“"
                            },
                            {
                                "example_id": "9100447e-9c7a-4081-b315-faae842b5524",
                                "sense_id": "7b3b8481-c194-386e-8567-d98aeaa4cff2",
                                "text": "„Er sprach von absolutistischen Narren, aristokratischen Heuchlern, weibischen Pfaffenknechten und liberalen Marktschreiern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
