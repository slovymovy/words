                                "target_senses": [
                                    {
                                        "sense_id": "ecaafc8d-ea9e-3e02-8d10-939053a58089",
                                        "entry_id": "51d76a2f-ad20-3740-8415-db39c1d44f3e",
                                        "glosses": [
                                            "To bring to, or direct toward, a common center; to unite more closely; to gather into one body, mass, or force."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013916c2-9864-4b44-b224-1dc74c9d3fb8",
                                                "sense_id": "ecaafc8d-ea9e-3e02-8d10-939053a58089",
                                                "text": "to concentrate rays of light into a focus"
                                            },
                                            {
                                                "example_id": "674a8206-112a-4586-801a-097693b503be",
                                                "sense_id": "ecaafc8d-ea9e-3e02-8d10-939053a58089",
                                                "text": "to concentrate the attention"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3741ad95-c692-3f4a-a09f-7d1ae11a9d1a",
                                        "entry_id": "51d76a2f-ad20-3740-8415-db39c1d44f3e",
                                        "glosses": [
                                            "To increase the strength and diminish the bulk of, as of a liquid or an ore; to intensify, by getting rid of useless material; to condense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7869c7c6-0c2d-4980-907d-3f0392b0b5cc",
                                                "sense_id": "3741ad95-c692-3f4a-a09f-7d1ae11a9d1a",
                                                "text": "to concentrate acid by evaporation"
                                            },
                                            {
                                                "example_id": "6e00cf58-606c-493d-8a36-23145368c1b5",
                                                "sense_id": "3741ad95-c692-3f4a-a09f-7d1ae11a9d1a",
                                                "text": "to concentrate by washing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "962951df-9de9-346c-8300-8643763e0657",
                                        "entry_id": "51d76a2f-ad20-3740-8415-db39c1d44f3e",
                                        "glosses": [
                                            "To approach or meet in a common center; to consolidate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55860284-e93c-4471-b4b8-38226949073c",
                                                "sense_id": "962951df-9de9-346c-8300-8643763e0657",
                                                "text": "Population tends to concentrate in cities."
                                            },
                                            {
                                                "example_id": "8bd4148f-7d45-4101-a167-333c12eb05fa",
                                                "sense_id": "962951df-9de9-346c-8300-8643763e0657",
                                                "text": "Buried within the Mediterranean littoral are some seventy to ninety million tons of slag from ancient smelting, about a third of it concentrated in Iberia. This ceaseless industrial fueling caused the deforestation of an estimated fifty to seventy million acres of woodlands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98513def-1d15-3d86-a1e6-39074e244bce",
                                        "entry_id": "51d76a2f-ad20-3740-8415-db39c1d44f3e",
                                        "glosses": [
                                            "To focus one's thought or attention (on)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a8f1e1-c41c-4e9b-90b4-a0734c371af1",
                                                "sense_id": "98513def-1d15-3d86-a1e6-39074e244bce",
                                                "text": "(oneself)"
                                            },
                                            {
                                                "example_id": "75747334-3739-46a2-8cdb-8a71d0480f74",
                                                "sense_id": "98513def-1d15-3d86-a1e6-39074e244bce",
                                                "text": "Let me concentrate!"
                                            },
                                            {
                                                "example_id": "ee823333-24c2-488c-be09-2cd24d7146bc",
                                                "sense_id": "98513def-1d15-3d86-a1e6-39074e244bce",
                                                "text": "The Group has recently concentrated on two main objectives, the implementation of a Code of Practice on minor station improvements and the preparation of a stock list of approved items of equipment for railway stations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "concentrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ed8c898-072b-376e-9218-53ec6522e8fa",
                                        "entry_id": "75abbb74-8c11-3f05-b2fe-4a89a7b00c30",
                                        "glosses": [
                                            "concentrated"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5ced7f0-8b95-47d8-9595-460beb3639a0",
                                                "sense_id": "5ed8c898-072b-376e-9218-53ec6522e8fa",
                                                "text": "It is, when good, a concentrate yellow."
                                            },
                                            {
                                                "example_id": "2fc7ed4d-c3ab-4476-929d-b5e202a666c9",
                                                "sense_id": "5ed8c898-072b-376e-9218-53ec6522e8fa",
                                                "text": "Subtracting the liters of concentrate fluid required in the diluted operation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "concentrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29e8bfe2-42b9-3c82-a75a-b606c534f747",
                                        "entry_id": "8df3c912-609d-3055-b2be-00d6e51b01c8",
                                        "glosses": [
                                            "A substance that is in a condensed form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c48098c-9b0b-496a-a6f0-e7f32db52506",
                                                "sense_id": "29e8bfe2-42b9-3c82-a75a-b606c534f747",
                                                "text": "orange concentrate"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "760de2c1-fb61-4896-ad6d-00210cdc72e5",
                        "source_entry_id": "7749c19f-6696-3f31-b1a7-a49b59eb2230",
                        "source_sense_id": "520f4436-baa5-3c9c-a0e9-618f2b0c46e1",
                        "target_lang_word": "concentré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concentré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ace4cde1-dd56-341a-99c1-aa23bf844fcc",
                                        "entry_id": "1f693191-7f63-38da-a8a5-edba7c3339e5",
                                        "glosses": [
                                            "Se dit d’une substance dont on a augmenté la concentration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "903409ac-956f-49a3-833d-35d26d9d721f",
                                                "sense_id": "ace4cde1-dd56-341a-99c1-aa23bf844fcc",
                                                "text": "Du lait concentré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "824c3c10-a851-387a-a44e-655c6fcaeb3d",
                                        "entry_id": "1f693191-7f63-38da-a8a5-edba7c3339e5",
                                        "glosses": [
                                            "Se dit d’une personne qui se concentre sur une activité, une réflexion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5555ed8-d53f-4f29-bf67-3ac1344a77c2",
                                                "sense_id": "824c3c10-a851-387a-a44e-655c6fcaeb3d",
                                                "text": "Ne dérange pas ta sœur, elle est concentrée sur son devoir de maths."
                                            },
                                            {
                                                "example_id": "a6c92c46-872f-4510-804b-84fbca21c8ba",
                                                "sense_id": "824c3c10-a851-387a-a44e-655c6fcaeb3d",
                                                "text": "Je verrai ça plus tard à tête reposée, je ne suis pas suffisamment concentré pour le moment."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "concentré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9cab8c8-01ea-3d35-91df-e8738b53e382",
                                        "entry_id": "ea80a72a-191c-3bdb-ac4c-6ca966453db4",
                                        "glosses": [
                                            "Substance qui a été densifiée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bbe9115-65e6-4fdb-8454-43ec7d8a4f11",
                                                "sense_id": "c9cab8c8-01ea-3d35-91df-e8738b53e382",
                                                "text": "Le nectar d’orange est obtenu par addition d’eau et de sucre à un concentré d’orange."
                                            },
                                            {
                                                "example_id": "8a5f8a41-c49e-4a33-8e2c-665484556208",
                                                "sense_id": "c9cab8c8-01ea-3d35-91df-e8738b53e382",
                                                "text": "Le travail de Jean-Michel commence par la mise au point du concentré de parfum."
                                            },
                                            {
                                                "example_id": "a1adeb2a-a3b0-4556-861d-8daed83a5b1a",
                                                "sense_id": "c9cab8c8-01ea-3d35-91df-e8738b53e382",
                                                "text": "Des vaches peuvent produire 22 kg de lait, sans complémentation, avec un pâturage de luzerne x brome. Au delà, un apport de concentré est nécessaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "concentré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fcf5b52-11a9-302d-8cad-5761dfdd4cc2",
                                        "entry_id": "facc6e85-99cb-35dc-ae83-1c27238e0eec",
                                        "glosses": [
                                            "Participe passé masculin singulier de concentrer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2b51451-173c-448b-9957-4d3e66b364d7",
                                                "sense_id": "1fcf5b52-11a9-302d-8cad-5761dfdd4cc2",
                                                "text": "Soutenus dans le ciel par les avions de la coalition (qui, à partir de la fin septembre, avaient concentré quasiment tous leurs efforts sur Kobané), ultra-déterminés, ultra-organisés, renforcés par leurs bataillons féminins d’une redoutable efficacité, les YPG reconquirent, mètre après mètre, la moitié de la ville que les djihadistes leur avaient prise, avant de les en chasser complètement le 25 janvier."
                                            },
                                            {
                                                "example_id": "445f29ec-80bd-4b49-a234-e9a1f35fb995",
                                                "sense_id": "1fcf5b52-11a9-302d-8cad-5761dfdd4cc2",
                                                "text": "L’essentiel des recherches s’est concentré sur le départ et les virages, les deux moments qui font la différence, et sur Maxime Grousset, tête de pont à l’Insep."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
