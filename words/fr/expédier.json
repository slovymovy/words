                {
                    "sense_id": "ea286c59-a130-3d20-91e4-c50d04d353d8",
                    "sense_definition": "Se débarrasser rapidement de quelqu'un en le congédiant ou en abrégeant la rencontre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Occupé par un dossier prioritaire, le directeur a rapidement <w>expédié</w> ce visiteur.",
                            "target_lang_translations": {
                                "en": "Busy with a priority case, the director quickly <w>dismissed</w> this visitor.",
                                "ru": "Занятый срочным делом, директор быстро <w>выпроводил</w> этого посетителя.",
                                "de": "Mit einer vorrangigen Akte beschäftigt, <w>wimmelte</w> der Direktor diesen Besucher rasch <w>ab</w>.",
                                "es": "Ocupado con un asunto prioritario, el director <w>despachó</w> rápidamente a este visitante.",
                                "zh": "因为手头有一份要紧的文件，主任很快就把这位访客<w>打发</w>走了。"
                            }
                        },
                        {
                            "text": "Elle n'avait aucun temps à perdre et <w>expédia</w> poliment le démarcheur.",
                            "target_lang_translations": {
                                "en": "She had no time to waste and politely <w>brushed off</w> the salesman.",
                                "ru": "Ей было некогда терять время, и она вежливо <w>спровадила</w> назойливого продавца.",
                                "de": "Sie hatte keine Zeit zu verlieren und <w>wimmelte</w> den Vertreter höflich <w>ab</w>.",
                                "es": "No tenía tiempo que perder y <w>despachó</w> con cortesía al vendedor importuno.",
                                "zh": "她没有时间可耗，客客气气地把推销员<w>送走</w>了。"
                            }
                        }
