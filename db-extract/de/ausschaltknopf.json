                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f309d506-b0d6-4a9a-b9cd-53fd4f4045c6",
                                "sense_id": "44a4c8ef-4f55-399a-af25-3dca697a714c",
                                "text": "„Ein- und Ausschaltknöpfe landen auf der Rückseite der Geräte – garantiert unhandlich –, um einige Zentimeter Kabel zu sparen.“"
                            },
                            {
                                "example_id": "e1f7f1f4-f861-4348-8545-9108c94888df",
                                "sense_id": "44a4c8ef-4f55-399a-af25-3dca697a714c",
                                "text": "„Doch mittlerweile fahren neue Systeme ohnehin ordnungsgemäß herunter, wenn der Ausschaltknopf betätigt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
