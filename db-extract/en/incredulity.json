                    {
                        "translation_id": "b66d7793-4847-4639-b9e5-a88ac0a8e80d",
                        "source_entry_id": "066b0394-ce23-3878-800f-61c82876292a",
                        "source_sense_description": "unwillingness to believe; doubt about the truth of something",
                        "target_lang_word": "недове́рие",
