                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "furtive",
                                "target_lang_sense_clarification": "done with evasive or guilty secrecy"
                            },
                            {
                                "target_lang_word": "secret",
                                "target_lang_sense_clarification": "kept hidden from others"
                            },
                            {
                                "target_lang_word": "stealthy",
                                "target_lang_sense_clarification": "behaving in a cautious and surreptitious manner"
                            },
                            {
                                "target_lang_word": "surreptitious",
                                "target_lang_sense_clarification": "kept secret, especially because it would not be approved of"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1727d155-cf6a-3373-81bb-d2e58a6d49cb",
                    "sense_definition": "gekenmerkt door een verlangen om zaken verborgen te houden voor anderen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geheimhouding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een <w>heimelijk</w> genoegen om alleen in het bos te wandelen.",
