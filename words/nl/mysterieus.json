            "senses": [
                {
                    "sense_id": "9074e499-050a-3ea5-a453-0b90edead702",
                    "sense_definition": "iets dat geheimzinnig is of moeilijk te begrijpen of te verklaren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geheimzinnig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man vertelde een <w>mysterieus</w> verhaal over het verlaten huis in het bos.",
                            "target_lang_translations": {
                                "en": "The old man told a <w>mysterious</w> story about the abandoned house in the woods."
                            }
                        },
                        {
                            "text": "Om <w>mysterieuze</w> redenen werkte de computer gisteren ineens niet meer.",
                            "target_lang_translations": {
                                "en": "For <w>mysterious</w> reasons, the computer suddenly stopped working yesterday."
                            }
                        }
                    ],
                    "synonyms": [
