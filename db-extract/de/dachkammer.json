                ],
                "senses": [
                    {
                        "sense_id": "d42806d9-bff2-3c39-8fd3-5190f5ade850",
                        "entry_id": "fbd03734-5698-36fe-94c0-9fdb5663c8d5",
                        "glosses": [
                            "abgeschlossener Raum im Bereich des Dachbodens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d3e4613-fd58-43f9-8f5d-d72268a4134c",
                                "sense_id": "d42806d9-bff2-3c39-8fd3-5190f5ade850",
                                "text": "Als Spielzimmer kann man in diesem Haus auch die Dachkammer nutzen."
                            },
                            {
                                "example_id": "23b332b0-f3e7-4a8e-845d-14bb10ce1e0e",
                                "sense_id": "d42806d9-bff2-3c39-8fd3-5190f5ade850",
                                "text": "Dachkammern sind in der Regel wenig komfortabel."
                            },
                            {
                                "example_id": "442e6ecf-37d8-4cc0-aeba-45a282ecb264",
                                "sense_id": "d42806d9-bff2-3c39-8fd3-5190f5ade850",
                                "text": "„In der Dachkammer war eine Schnake, ein Riesenvieh mit langen Flügeln und viel zu vielen Beinen.“"
                            },
                            {
                                "example_id": "ca55604f-ed4c-4034-8732-4030a935a598",
                                "sense_id": "d42806d9-bff2-3c39-8fd3-5190f5ade850",
                                "text": "„Als ich ein Baby war, wohnten meine Eltern mit mir in einer winters nur durch einen kleinen Kohleofen beheizbaren Dachkammer im Esslinger Haus meiner Großeltern.“"
                            },
                            {
                                "example_id": "c771726c-70ea-44d8-a5b3-186dcde7ac57",
                                "sense_id": "d42806d9-bff2-3c39-8fd3-5190f5ade850",
                                "text": "„Das Zimmer oben war nicht sehr groß, aber auch nicht bloß eine Dachkammer, obwohl das Fenster zwischen schrägen Wänden saß.“"
                            },
                            {
                                "example_id": "054c3484-381f-4038-a642-e91035ea3d73",
                                "sense_id": "d42806d9-bff2-3c39-8fd3-5190f5ade850",
                                "text": "„Die Tür zur Dachkammer war offen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52cbffe4-5dfe-442f-b3cf-c1046599a7ff",
                        "source_entry_id": "fbd03734-5698-36fe-94c0-9fdb5663c8d5",
                        "source_sense_id": "d42806d9-bff2-3c39-8fd3-5190f5ade850",
                        "source_sense_description": "abgeschlossener Raum im Bereich des Dachbodens",
                        "target_lang_word": "мансарда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мансарда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ed3ad45d-334a-3dd4-9624-143299bdcba2",
                                        "entry_id": "e9eb86ba-7404-306c-98f1-7f68746d7d98",
                                        "glosses": [
                                            "жилое помещение чердачного типа под самой крышей, с косым потолком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42c2123c-35ea-4c0e-b109-3ce68e10d6c8",
                                                "sense_id": "ed3ad45d-334a-3dd4-9624-143299bdcba2",
                                                "text": "В глубине стоял большой трехэтажный дом с фронтоном и мансардой, построенный в самом начале XVIII века."
                                            },
                                            {
                                                "example_id": "654b4fc7-fbaa-433e-b906-5278f9c1374d",
                                                "sense_id": "ed3ad45d-334a-3dd4-9624-143299bdcba2",
                                                "text": "А с последнего этажа можно пробить люк на чердак и там сделать в мансарде студию."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
