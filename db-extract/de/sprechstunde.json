                ],
                "senses": [
                    {
                        "sense_id": "f7785c32-4333-362d-b6d1-77f0eb09348d",
                        "entry_id": "9fa39b8c-09a5-3c57-aec0-d4dc6dd23816",
                        "glosses": [
                            "diejenige Zeit, in der (zum Beispiel) ein Arzt oder Rechtsanwalt einem Patienten beziehungsweise Klienten zur Beratung zur Verfügung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8456ebf5-729d-4dbf-9140-e3a2bc8981b4",
                                "sense_id": "f7785c32-4333-362d-b6d1-77f0eb09348d",
                                "text": "„Inuit neigen sonst eigentlich nicht zum Klartext, aber diese Sprechstunde ist für Menschen gedacht, die mit Selbstmord in Berührung gekommen sind.“"
                            },
                            {
                                "example_id": "273b2f83-3c86-4bd5-928e-85a81afbebbf",
                                "sense_id": "f7785c32-4333-362d-b6d1-77f0eb09348d",
                                "text": "„Die Sprechstunde fängt erst in einer Viertelstunde an, gut, so werde ich warten.“"
                            },
                            {
                                "example_id": "e900e49a-333c-4cf3-821a-b44b24a66a0c",
                                "sense_id": "f7785c32-4333-362d-b6d1-77f0eb09348d",
                                "text": "„Einen Termin in seiner Sprechstunde bekam ich schnell.“"
                            },
                            {
                                "example_id": "942b2818-8e28-4389-bc54-64ed212835cb",
                                "sense_id": "f7785c32-4333-362d-b6d1-77f0eb09348d",
                                "text": "„Impotenzwitze spielen nicht selten in der ärztlichen Sprechstunde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58f6af1c-374b-4106-888b-b733469373da",
