                        "examples": [
                            {
                                "example_id": "6ebc650c-2a1c-4172-b5f3-8670e3ee3aee",
                                "sense_id": "9b752a32-4e2e-3131-9b06-e71222405e79",
                                "text": "Daarvan bestaat een tweede uitgave."
                            },
                            {
                                "example_id": "5c6c65df-513f-45e2-bf12-ec04a920d726",
                                "sense_id": "9b752a32-4e2e-3131-9b06-e71222405e79",
                                "text": "Ik heb zonnecellen op mijn dak. Het voordeel daarvan is dat de elektriciteitsrekening lager is."
                            },
                            {
                                "example_id": "89dbd79e-58eb-4a74-95d2-d481b560f3b2",
                                "sense_id": "9b752a32-4e2e-3131-9b06-e71222405e79",
                                "text": "De eerste helft van deze eeuw was het een rommeltje in de kunsthandel, en we zitten nog steeds met de brokken daarvan."
                            },
                            {
                                "example_id": "405f1dad-8843-416f-b86f-18990ee6e74a",
                                "sense_id": "9b752a32-4e2e-3131-9b06-e71222405e79",
                                "text": "Ook hier geen tapijten of kleden op de grond, geen schilderijen aan de muur, slechts een bed zonder matras en een kledingkast. Toen ik de deur daarvan opendeed, zag ik een heel slagwerk aan ijzeren hangertjes hangen, maar verder was hij leeg."
                            }
                        ]
                    }
