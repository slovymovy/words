                        "source_entry_id": "dd8e9143-2540-33b6-aa78-27f12177f934",
                        "source_sense_description": "plant in the family Elaeagnaceae, especially, a plant in the genus Elaeagnus, especially, the species Elaeagnus angustifolia",
                        "target_lang_word": "лох",
                        "target_lang_code": "ru",
