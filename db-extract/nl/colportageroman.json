                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84270a7d-5b8a-4257-9057-21d7fe7a479a",
                                "sense_id": "e6606bae-7d54-318f-b075-08acf90c0d0c",
                                "text": "Winnetou hoort thuis in het genre van de colportageroman, een enorm populair genre in die dagen (boeken in afleveringen, deur-aan-deur uitgevent). Vele auteurs werden er rijk mee. Eugène Sue liep binnen met zijn Les Mystères de Paris (1843), de late colportageauteur als Victor von Falk overkwam hetzelfde met zijn grootscheeps verkochte, zwaarlijvige trilogie Giuseppe Musolino, der kühnste und verwegenste Räuber-Hauptmann (1907). (NRC 30 maart 2012)"
                            }
                        ]
                    }
