                    "frequency": "Low",
                    "semantic_group_id": "decay_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists studied the continuous <w>decaying</w> of organic materials on the forest floor.",
                            "target_lang_translations": {
                                "de": "Wissenschaftler untersuchten die kontinuierliche <w>Zersetzung</w> organischer Materialien auf dem Waldboden."
                            }
                        },
                        {
                            "text": "The rapid <w>decaying</w> of ancient structures was worsened by pollution.",
                            "target_lang_translations": {
                                "de": "Der rasche <w>Verfall</w> antiker Bauwerke wurde durch die Umweltverschmutzung noch verschlimmert."
                            }
