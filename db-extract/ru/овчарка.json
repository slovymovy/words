                                        "sense_id": "dc163076-5b48-368e-acc5-1b146e230570",
                                        "entry_id": "6804092b-b7a2-3939-b7fb-69ff8c66a0a6",
                                        "glosses": [
                                            "Race de chien domestique lupoïde adaptée au départ à la garde et la conduite des troupeaux de moutons, et classée dans le groupe 1 ou le groupe 2 par la société centrale canine ou SCC."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ad00af6-a353-4f7d-b24b-2b3691b730aa",
                                                "sense_id": "dc163076-5b48-368e-acc5-1b146e230570",
                                                "text": "La ribambelle traversait la place de la Concorde et remontait les Champs-Élysées, sous le rose sorbet de la lune printanière. Je faisais le chien de berger, courant de Santiago à Toulet et colportant les à-peu-près de Curnonsky."
                                            },
                                            {
                                                "example_id": "98fd3f28-e203-474b-a658-b700c6de2926",
                                                "sense_id": "dc163076-5b48-368e-acc5-1b146e230570",
                                                "text": "Sa voix qui évoquait jusque-là les aboiements d'un chien de berger, avait atteint la limite du sanglot."
                                            }
                                        ]
                                    }
                                ]
