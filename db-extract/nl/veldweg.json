                ],
                "senses": [
                    {
                        "sense_id": "ffec0bc6-35d3-395b-9c54-4ba0f242a3d7",
                        "entry_id": "d0e98087-61c4-3e46-9033-32414737aad4",
                        "glosses": [
                            "onverharde weg buiten de bebouwde kom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93da615-92ab-48e0-a5cf-28f9522bb414",
                                "sense_id": "ffec0bc6-35d3-395b-9c54-4ba0f242a3d7",
                                "text": "De man ijvert er al jaren voor afgesloten en verdwenen paden en veldwegen in de gemeente opnieuw open te stellen. Landbouwers palmen weggetjes in. Andere paadjes raken overwoekerd door onkruid of een omheining verspert de weg."
                            },
                            {
                                "example_id": "e97bbd7b-93fe-4b65-9d6a-50a5ababb879",
                                "sense_id": "ffec0bc6-35d3-395b-9c54-4ba0f242a3d7",
                                "text": "Een 32-jarige exhibitionist had bepaald geen mazzel toen hij zich op een veldweggetje in Wiesbaden naakt voor een voorbijrijdende vrouw wierp. Zijn slachtoffer bleek namelijk een politievrouw in burger die na haar dienst op weg was naar huis, aldus de Frankfurter Allgemeine Zeitung woensdag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "483f6f2c-b14c-4457-ae08-ca9e96140779",
                        "source_entry_id": "d0e98087-61c4-3e46-9033-32414737aad4",
                        "source_sense_id": "ffec0bc6-35d3-395b-9c54-4ba0f242a3d7",
                        "target_lang_word": "Feldweg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feldweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dde23d49-c9d1-3c90-ae20-f3ffad398ce6",
                                        "entry_id": "b76a61bb-392d-3c24-804d-cdad15c82f46",
                                        "glosses": [
                                            "schmaler, meist unbefestigter Weg zwischen Feldern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc8fc3f9-9bff-4d50-acd7-71ef38124ecd",
                                                "sense_id": "dde23d49-c9d1-3c90-ae20-f3ffad398ce6",
                                                "text": "Er wich auf einen holprigen Feldweg aus."
                                            },
                                            {
                                                "example_id": "5652b30e-10d8-4b7f-b377-981f757b31c9",
                                                "sense_id": "dde23d49-c9d1-3c90-ae20-f3ffad398ce6",
                                                "text": "„Die endlosen Knicks neben den aufgeweichten Feldwegen verdeckten die Weite, verhinderten den Überblick.“"
                                            },
                                            {
                                                "example_id": "5ceb2a97-d209-492c-856f-04e13911c5d4",
                                                "sense_id": "dde23d49-c9d1-3c90-ae20-f3ffad398ce6",
                                                "text": "„Neben dem Bahndamm führt ein baumloser Feldweg entlang.“"
                                            },
                                            {
                                                "example_id": "1d1112d2-d7e0-45a9-9775-ad9108e9cfab",
                                                "sense_id": "dde23d49-c9d1-3c90-ae20-f3ffad398ce6",
                                                "text": "„Sie hielt vor einem Krämerladen, der an der Ecke jenes Feldwegs einsam in die Landschaft gebaut war.“"
                                            },
                                            {
                                                "example_id": "c3b6d07a-a3db-4d43-82a7-7d683a6b5bd8",
                                                "sense_id": "dde23d49-c9d1-3c90-ae20-f3ffad398ce6",
                                                "text": "„Roman Bertini lief um die Ecke, auf den Feldweg gegen den nahen Horizont zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
