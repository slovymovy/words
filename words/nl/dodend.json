            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "04ee88a7-af09-3682-a590-eaf2a193d0ac",
                    "sense_definition": "In staat om een levend organisme te doden; dodelijk of giftig.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fataal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het gif van deze slang is uiterst <w>dodend</w> voor kleine zoogdieren.",
                            "target_lang_translations": {
                                "en": "The venom of this snake is extremely <w>deadly</w> to small mammals."
                            }
                        },
                        {
                            "text": "Zonder snelle medische hulp kan een <w>dodend</w> virus zich snel verspreiden.",
                            "target_lang_translations": {
                                "en": "Without prompt medical attention, a <w>lethal</w> virus can spread rapidly."
                            }
                        }
                    ],
                    "synonyms": [
                        "dodelijk",
                        "vergiftig"
                    ],
                    "common_phrases": [
                        "een dodend gif",
                        "dodend virus"
                    ],
                    "target_lang_definitions": {
                        "en": "Capable of killing a living organism; lethal or poisonous."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lethal",
                                "target_lang_sense_clarification": "causing death"
                            },
                            {
                                "target_lang_word": "deadly",
                                "target_lang_sense_clarification": "fatal or toxic"
                            },
                            {
                                "target_lang_word": "fatal",
                                "target_lang_sense_clarification": "resulting in death"
                            }
                        ]
