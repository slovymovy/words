                "senses": [
                    {
                        "sense_id": "f237ba0f-7a73-33e3-8a2f-6814c951872b",
                        "entry_id": "407e4900-eba4-349d-9425-847fe05aeb93",
                        "glosses": [
                            "für gleichaltrige Kinder veranstaltetes Geburtstagsfest eines Kindes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c619a8e-9e3a-4c74-b21a-db6d5eb94d4d",
                                "sense_id": "f237ba0f-7a73-33e3-8a2f-6814c951872b",
                                "text": "Auf Kindergeburtstagen gibt es lustige und spannende Spiele für die Kinder."
                            },
                            {
                                "example_id": "192922e5-c633-4bbf-9ea5-876ba8c6aaf0",
                                "sense_id": "f237ba0f-7a73-33e3-8a2f-6814c951872b",
                                "text": "Kindergeburtstage sind Chaostage."
                            },
                            {
                                "example_id": "72759cbb-773c-4fdd-b5fe-4de79e7ab850",
                                "sense_id": "f237ba0f-7a73-33e3-8a2f-6814c951872b",
                                "text": "Aber - ich spreche aus Erfahrung - im großen und ganzen machen Kindergeburtstage Spaß."
                            },
                            {
                                "example_id": "db32db19-3687-4000-9a82-dc38dfdf84ef",
                                "sense_id": "f237ba0f-7a73-33e3-8a2f-6814c951872b",
                                "text": "Und dass der KaTe schon damals etwas ganz Besonderes gewesen sei: »Wenn bei uns Kindergeburtstag gefeiert wurde, haben die anderen Jungs herumgetobt, aber der KaTe hat am Tisch gesessen und die Bücher gelesen, die mein Sohn geschenkt bekommen hat.«"
                            },
                            {
                                "example_id": "ad435a9e-95ee-404d-b870-8acdfa5e171a",
                                "sense_id": "f237ba0f-7a73-33e3-8a2f-6814c951872b",
                                "text": "Zum Kindergeburtstag eines Elfjährigen bringen die kleinen Gäste neuerdings nicht mehr Lego Technik mit, sondern Adidas Active Showergel und das passende Deo dazu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
