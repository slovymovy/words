                ],
                "senses": [
                    {
                        "sense_id": "b2eef6ac-273c-3316-b476-aec6d3b68ec3",
                        "entry_id": "55bb1d1e-eb40-3999-8bd9-7d8691197754",
                        "glosses": [
                            "Überdachung/Überspannung für Throne, Altäre, Betten oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "297be919-3794-4160-a4f5-d356d0f630d4",
                                "sense_id": "b2eef6ac-273c-3316-b476-aec6d3b68ec3",
                                "text": "„Der Papst verfolgte die Rede vom Balkon des Petersdoms aus, ein Baldachin schützte ihn vor dem leichten Regen.“"
                            },
                            {
                                "example_id": "b174fb97-9e32-476f-b8eb-dae609fa14d0",
                                "sense_id": "b2eef6ac-273c-3316-b476-aec6d3b68ec3",
                                "text": "„Über uns bauscht sich die Seide des Überwurfs als Baldachin.“"
                            },
                            {
                                "example_id": "651c162d-2b3e-4aa9-ba14-282aa839537a",
                                "sense_id": "b2eef6ac-273c-3316-b476-aec6d3b68ec3",
                                "text": "„Lambe ritt dann ohne Sattel auf einem Pferd, das ihm zur Verfügung gestellt wurde, während der König in einer Sänfte getragen wurde, die mit einem Baldachin und Vorhängen aus golddurchwirktem Stoff versehen war.“"
                            },
                            {
                                "example_id": "8b2362c8-62c3-4cf3-9db4-ab10ff189382",
                                "sense_id": "b2eef6ac-273c-3316-b476-aec6d3b68ec3",
                                "text": "„War die Beerdigung zu Ende, und kurz bevor sie mit dem Baldachin und dem Rasenteppich abzogen, spießte einer von den Beckworths das kleine Täfelchen am Fuß des Grabes in den Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25acfbfa-df42-4630-ad61-58665e5c8490",
                        "source_entry_id": "55bb1d1e-eb40-3999-8bd9-7d8691197754",
                        "source_sense_id": "b2eef6ac-273c-3316-b476-aec6d3b68ec3",
                        "source_sense_description": "Überdachung/Überspannung für Throne, Altäre, Betten oder Ähnliches",
                        "target_lang_word": "baldachin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baldachin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbd0b7a-89af-3e0c-aa50-7c66a8cc546e",
                                        "entry_id": "4c9b7980-2e62-3b89-9ae6-0f3200979314",
                                        "glosses": [
                                            "Alternative spelling of baldacchin."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26f8946f-08a6-4d2d-b271-cd740ebf0f16",
                                                "sense_id": "4dbd0b7a-89af-3e0c-aa50-7c66a8cc546e",
                                                "text": "She rode beneath a purple baldachin, which the doctors of Ferrara--that is, the members of the faculties of law, medicine, and mathematics--supported in turn."
                                            },
                                            {
                                                "example_id": "c40536f2-2761-4b9f-838f-073d86bac312",
                                                "sense_id": "4dbd0b7a-89af-3e0c-aa50-7c66a8cc546e",
                                                "text": "The bronze that formerly ornamented this temple was made use of to fabricate the baldachin of St Peter's."
                                            },
                                            {
                                                "example_id": "17b39268-87da-4e15-9167-9f66d757cef0",
                                                "sense_id": "4dbd0b7a-89af-3e0c-aa50-7c66a8cc546e",
                                                "text": "People will spend thirty thousand francs on an altar baldachin, and ruin themselves for music, and they have to have gas in their churches, and Lord knows what all besides, but when you mention bells they shrug their shoulders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
