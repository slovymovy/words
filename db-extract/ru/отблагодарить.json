        "fr-extract.jsonl": [
            {
                "entry_id": "e1d15a61-8294-3b62-a58d-398390b00ba1",
                "word": "отблагодарить",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f8e1efa1-ac1d-3dd4-8a79-3371e997d018",
                        "entry_id": "e1d15a61-8294-3b62-a58d-398390b00ba1",
                        "glosses": [
                            "(ково-либо за + accusatif) Remercier (quelqu’un pour quelque chose)."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "b099cd29-7799-4db8-99fc-9f5fa41fd903",
                                "sense_id": "f8e1efa1-ac1d-3dd4-8a79-3371e997d018",
                                "text": "благодарю́ : merci."
                            },
                            {
                                "example_id": "b0d4c3dc-49d1-495e-9315-28ff1d7ef0b5",
                                "sense_id": "f8e1efa1-ac1d-3dd4-8a79-3371e997d018",
                                "text": "За всё, за всё тебя благодарю я. : Pour tout, pour tout, je te remercie."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3e8e4f1-f53f-32af-bb01-037c1e731c5e",
                        "entry_id": "e1d15a61-8294-3b62-a58d-398390b00ba1",
                        "glosses": [
                            "Récompenser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d12c0228-9e90-4d94-828d-6fd0cbfcd409",
                                "sense_id": "f3e8e4f1-f53f-32af-bb01-037c1e731c5e",
                                "text": "Рады вы, маточка, что бог вам случай послал в свою очередь за добро добром отслужить и меня отблагодарить. : Soyez heureuse, bonne mère, que Dieu vous ait envoyé tous ces gens afin de bien le servir et ainsi me récompenser."
                            }
                        ]
                    }
                ],
                "translations": [],
