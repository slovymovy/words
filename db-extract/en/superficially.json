                                                "example_id": "cd8b5383-49f7-4412-a96a-53b7267c5ae9",
                                                "sense_id": "57d9a5af-3a30-3e6c-b967-fecac681119a",
                                                "text": "De rednecks zijn agressief en gevaarlijk, anderen zijn juist weer oppervlakkig en overdreven vriendelijk in de supermarkt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec436a6d-e69c-3e5e-8dec-4b41e8dbda23",
