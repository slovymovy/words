                                                "sense_id": "e9d213eb-8c58-3441-ab8a-e2842aebf552",
                                                "text": "Petříku, vezmi si čepičku na hlavičku, ať ti není zima."
                                            },
                                            {
                                                "example_id": "acc104f9-b605-4abb-abb6-ad26a1a9b5d7",
                                                "sense_id": "e9d213eb-8c58-3441-ab8a-e2842aebf552",
                                                "text": "Náš doktor nesvítí,/ honí živobytí,/ pokývá hlavičkú,/ dívá sa trubičkú,/ do ucha, do řiti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b09e400a-02ca-3466-abdf-7d83c2034446",
                                        "entry_id": "5fac42cc-9d69-3801-a09c-c7ca5be69c1c",
                                        "glosses": [
                                            "rozšířená část hřebíku, nýtu apod."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d589db5-ee7a-4256-9e4e-68cd603abc80",
                                                "sense_id": "b09e400a-02ca-3466-abdf-7d83c2034446",
                                                "text": "Netrefíte-li kladivem hlavičku hřebíku, uhodíte se do prstu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1df5686d-8204-33fa-b7cd-16252204656b",
                                        "entry_id": "5fac42cc-9d69-3801-a09c-c7ca5be69c1c",
                                        "glosses": [
                                            "horní část dokumentu či stránky papíru zpravidla obsahující adresu nebo alespoň logo vystavitele"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea208471-b766-4bda-a658-bde873ea7f70",
                                                "sense_id": "1df5686d-8204-33fa-b7cd-16252204656b",
                                                "text": "Náš nový hlavičkový papír má v hlavičce logo firmy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d85bcb3-48c4-3dcf-8af2-57da961190de",
                                        "entry_id": "5fac42cc-9d69-3801-a09c-c7ca5be69c1c",
                                        "glosses": [
                                            "způsob odehrání míče ve fotbalu pomocí hlavy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "932acbcf-dbea-4139-ae12-12ab0d3f5013",
                                                "sense_id": "3d85bcb3-48c4-3dcf-8af2-57da961190de",
                                                "text": "Útočník našeho týmu dal v závěru utkání gól hlavičkou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "068c3a09-9768-375e-acfa-b37b2ea71e44",
                                        "entry_id": "5fac42cc-9d69-3801-a09c-c7ca5be69c1c",
                                        "glosses": [
                                            "někdo bystrý, inteligentní (zejména dítě)"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a73effa-6dfa-4c7e-864f-6becf9a0beb0",
                                                "sense_id": "068c3a09-9768-375e-acfa-b37b2ea71e44",
                                                "text": "Ten váš Toník, to je ale hlavička! Přišel na řešení úplně sám!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f3ff48e-0394-3112-a902-0c9c1c9beebd",
                                        "entry_id": "5fac42cc-9d69-3801-a09c-c7ca5be69c1c",
                                        "glosses": [
                                            "úder hlavou (zpravidla do čela nebo hrudi druhého člověka)"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc6fd574-3703-4790-9b9f-a599e9fe7d75",
                                                "sense_id": "3f3ff48e-0394-3112-a902-0c9c1c9beebd",
                                                "text": "Za hlavičku řediteli školy dostal rodič podmínku"
