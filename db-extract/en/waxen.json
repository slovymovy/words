                    {
                        "sense_id": "67fa571f-932d-3bff-8dfe-44ff22788d2f",
                        "entry_id": "ab30d58f-d578-3df8-82ac-428b142ef3c0",
                        "glosses": [
                            "plural simple present of wax"
                        ],
                        "tags": [
                            "form-of",
