{
    "word_family": [
        "snuffer",
        "snuffbox"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2ac779f-1c3f-3fa8-905c-77791ea6dbc0",
                    "sense_definition": "Finely ground tobacco intended to be inhaled into the nose.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tobacco",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler observed the local custom of using a fine <w>snuff</w> during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Путешественник наблюдал местный обычай употреблять тонко измельчённый <w>нюхательный табак</w> во время церемонии."
                            }
                        },
                        {
                            "text": "He kept his <w>snuff</w> in a small silver box.",
                            "target_lang_translations": {
                                "ru": "Он держал свой <w>нюхательный табак</w> в маленькой серебряной табакерке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонко измельчённый табак, предназначенный для втягивания носом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нюхательный табак",
                                "target_lang_sense_clarification": "традиционный термин"
                            },
                            {
                                "target_lang_word": "снафф",
                                "target_lang_sense_clarification": "заимствованное обозначение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9b917ff-0830-30a7-9cb5-3d758e38e3bb",
                    "sense_definition": "Finely ground tobacco placed between the lip and gum.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tobacco",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many workers in the region used dip <w>snuff</w> throughout the long shift.",
                            "target_lang_translations": {
                                "ru": "Многие рабочие в регионе употребляли <w>сосательный табак</w> на протяжении всей долгой смены."
                            }
                        },
                        {
                            "text": "The habit of using moist <w>snuff</w> is common in some rural areas.",
                            "target_lang_translations": {
                                "ru": "Привычка употреблять влажный <w>снафф</w> распространена в некоторых сельских районах."
                            }
                        }
                    ],
                    "synonyms": [
                        "dip"
                    ],
                    "common_phrases": [
                        "dip snuff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелко измельчённый табак, помещаемый между губой и десной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосательный табак",
                                "target_lang_sense_clarification": "бездымный табак"
                            },
                            {
                                "target_lang_word": "снафф",
                                "target_lang_sense_clarification": "жевательный или оральный табак"
                            },
                            {
                                "target_lang_word": "снюс",
                                "target_lang_sense_clarification": "разновидность влажного табака под губу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dad56bfb-422e-33ef-9879-33d7f18ec686",
                    "sense_definition": "The burnt, charred end of a candle wick.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "candle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room smelled of the <w>snuff</w> left on the candle after it was blown out.",
                            "target_lang_translations": {
                                "ru": "В комнате пахло <w>нагаром</w>, оставшимся на свече после того, как её задули."
                            }
                        },
                        {
                            "text": "He used a tool to remove the black <w>snuff</w> from the wick.",
                            "target_lang_translations": {
                                "ru": "Он воспользовался инструментом, чтобы снять чёрный <w>нагар</w> с фитиля."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обуглившийся, сгоревший конец свечного фитиля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагар",
                                "target_lang_sense_clarification": "на фитиле свечи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b13d37de-a99e-335d-a8ee-7e7c54f34325",
                    "sense_definition": "To put an end to something or to kill someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "extinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden economic crisis <w>snuffed</w> out all hopes for the new business.",
                            "target_lang_translations": {
                                "ru": "Внезапный экономический кризис <w>похоронил</w> все надежды нового бизнеса."
                            }
                        },
                        {
                            "text": "A single scandal <w>snuffed</w> out the senator's career overnight.",
                            "target_lang_translations": {
                                "ru": "Один-единственный скандал в одночасье <w>погубил</w> карьеру сенатора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snuff out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положить конец чему-либо, разрушить планы или убить кого-либо (обычно snuff out)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положить конец",
                                "target_lang_sense_clarification": "разрушить, оборвать"
                            },
                            {
                                "target_lang_word": "загубить",
                                "target_lang_sense_clarification": "уничтожить"
                            },
                            {
                                "target_lang_word": "прикончить",
                                "target_lang_sense_clarification": "убить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12dc3596-105c-3531-9976-a87ab5e378d4",
                    "sense_definition": "To extinguish a flame by covering the wick.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "extinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She reached over to <w>snuff</w> the candle before going to sleep.",
                            "target_lang_translations": {
                                "ru": "Она протянула руку, чтобы <w>погасить</w> свечу перед сном."
                            }
                        },
                        {
                            "text": "It is safer to <w>snuff</w> the flame than to blow it out.",
                            "target_lang_translations": {
                                "ru": "Безопаснее <w>колпачком тушить</w> пламя, чем задувать его."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потушить пламя (свечи), накрыв или обрезав фитиль колпачком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гасить",
                                "target_lang_sense_clarification": "колпачком или щипцами"
                            },
                            {
                                "target_lang_word": "тушить",
                                "target_lang_sense_clarification": "свечу"
                            },
                            {
                                "target_lang_word": "снимать нагар",
                                "target_lang_sense_clarification": "подрезать фитиль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50aa6282-4860-3b5a-892d-e2882e828311",
                    "sense_definition": "To inhale air or scents through the nose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inhale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog began to <w>snuff</w> at the ground to find the hidden trail.",
                            "target_lang_translations": {
                                "ru": "Собака принялась <w>обнюхивать</w> землю, пытаясь найти скрытый след."
                            }
                        },
                        {
                            "text": "He could <w>snuff</w> the fresh scent of pine in the morning air.",
                            "target_lang_translations": {
                                "ru": "Он <w>вдыхал</w> свежий запах хвои в утреннем воздухе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Втягивать воздух или запахи через нос; принюхиваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нюхать",
                                "target_lang_sense_clarification": "втягивать запах носом"
                            },
                            {
                                "target_lang_word": "принюхиваться",
                                "target_lang_sense_clarification": "разнюхивать, искать след"
                            },
                            {
                                "target_lang_word": "сопеть",
                                "target_lang_sense_clarification": "шумно втягивать воздух носом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}