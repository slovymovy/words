                "senses": [
                    {
                        "sense_id": "c9fcb7ea-4f02-3f33-b49b-c5a9d2424566",
                        "entry_id": "2de832d1-cf55-39ca-a570-f9b5e4ed9c5c",
                        "glosses": [
                            "прост. то же, что залезать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f71c5f-c4c2-4bc4-a5cc-02d951817403",
                                "sense_id": "c9fcb7ea-4f02-3f33-b49b-c5a9d2424566",
                                "text": "Вот вы бежите по безводной голодной степи, жгучий песок пустыня слепит глаза и залазит в рот и ноздри."
                            },
                            {
                                "example_id": "3d1a2aa2-e3c4-43f5-b5ec-553755ec55e3",
                                "sense_id": "c9fcb7ea-4f02-3f33-b49b-c5a9d2424566",
                                "text": "Крикни там, связист, саперам, чтоб сюда залазили."
                            }
                        ]
                    }
                ],
