                "senses": [
                    {
                        "sense_id": "a2b16b57-1fa5-3ffb-ba6d-cf25012c29f0",
                        "entry_id": "d9d006c8-728c-3c93-999d-c76e4ab5637c",
                        "glosses": [
                            "charakterystyczny dla kukułki; dotyczący, odnoszący się do kukułki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fba53e-8a88-4a40-938b-9bedbb99ed82",
                                "sense_id": "a2b16b57-1fa5-3ffb-ba6d-cf25012c29f0",
                                "text": "Jest tylko 3 rekordzistów nagrodzonych w 5 najważniejszych kategoriach: \"Ich noce\" Franca Capry, \"Lot nad kukułczym gniazdem\" Formana i \"Milczenie owiec\" Jonathana Demme'a"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08e5b2ee-19be-433b-b483-e3442660f64e",
                        "source_entry_id": "d9d006c8-728c-3c93-999d-c76e4ab5637c",
                        "source_sense_id": "a2b16b57-1fa5-3ffb-ba6d-cf25012c29f0",
                        "target_lang_word": "кукушкин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кукушкин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f8b9bf54-a754-36e6-bab2-f687523c4b4c",
                                        "entry_id": "8797936b-a4f0-3402-9264-0ab0c93a4483",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным кукушка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9626d3ad-c88f-4881-a272-d26ce9ec4872",
                                                "sense_id": "f8b9bf54-a754-36e6-bab2-f687523c4b4c",
                                                "text": "В кукушкин счёт не верят даже те, кто её спрашивает."
                                            },
                                            {
                                                "example_id": "dc1375a9-ae5f-4477-933f-8a970ed17634",
                                                "sense_id": "f8b9bf54-a754-36e6-bab2-f687523c4b4c",
                                                "text": "Любовь к соловьям ― специальность моя, в различных коленах я толк понимаю: за дешёвой дудкой вразброд стукотня, кукушкина песня и дробь рассыпная…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "469723b3-fb50-3136-aee8-73ed617b4df1",
                                        "entry_id": "8797936b-a4f0-3402-9264-0ab0c93a4483",
                                        "glosses": [
                                            "принадлежащий кукушке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9895bcc9-774d-40c3-bef9-059cb307cf09",
                                                "sense_id": "469723b3-fb50-3136-aee8-73ed617b4df1",
                                                "text": "Даже кукушку не забыли, в гадалки при орлице определили, а для кукушкиных сирот воспитательный дом выстроили."
                                            },
                                            {
                                                "example_id": "08f1261b-e69b-49f1-a2e0-315fe9933096",
                                                "sense_id": "469723b3-fb50-3136-aee8-73ed617b4df1",
                                                "text": "Представьте, что я там нашел! Кукушкино яйцо в гнезде у горихвостки! чудеса!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
