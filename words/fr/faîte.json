    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99a0e619-f8e6-35dc-821c-f922e32bc315",
                    "sense_definition": "Degré le plus élevé d'une situation, d'un état ou d'un pouvoir ; apogée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "point_culminant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette artiste célèbre est parvenue au <w>faîte</w> de sa gloire après vingt ans de travail acharné."
                        },
                        {
                            "text": "À cette époque prospère, l'empire se trouvait au <w>faîte</w> de sa puissance militaire et économique."
                        }
                    ],
                    "synonyms": [
                        "apogée",
                        "sommet",
                        "zénith",
                        "pinacle"
                    ],
                    "antonyms": [
                        "déclin",
                        "nadir"
                    ],
                    "common_phrases": [
                        "faîte de la gloire",
                        "faîte de la puissance"
                    ]
                },
                {
                    "sense_id": "9c3b7b55-0e99-3b0b-b513-c982f03b50cf",
                    "sense_definition": "Arête supérieure d'un toit où se rejoignent deux versants.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des oiseaux migrateurs se sont posés sur le <w>faîte</w> du toit pour observer les alentours."
                        },
                        {
                            "text": "Le couvreur doit monter jusqu'au <w>faîte</w> pour remplacer les tuiles brisées par la tempête."
                        }
                    ],
                    "synonyms": [
                        "faîtage"
                    ],
                    "common_phrases": [
                        "faîte du toit"
                    ]
                },
                {
                    "sense_id": "ac9dc7f2-23ac-3c88-b9b7-79fe42d2479e",
                    "sense_definition": "Partie la plus haute de certaines choses élevées comme un arbre ou une colline.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sommet_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent d'automne agitait vigoureusement le <w>faîte</w> des arbres de la forêt voisine."
                        },
                        {
                            "text": "Depuis le <w>faîte</w> de la colline, les randonneurs admiraient l'ensemble de la vallée."
                        }
                    ],
                    "synonyms": [
                        "cime",
                        "sommet"
                    ],
                    "antonyms": [
                        "base",
                        "pied"
                    ],
                    "common_phrases": [
                        "faîte des arbres"
                    ]
                },
                {
                    "sense_id": "a434984d-4cdd-32b4-8f6f-8b620e9b79ce",
                    "sense_definition": "Partie la plus élevée d'un bâtiment ou d'un édifice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une immense croix en pierre se dresse fièrement sur le <w>faîte</w> de la vieille cathédrale."
                        },
                        {
                            "text": "La fumée de la cheminée montait bien au-dessus du <w>faîte</w> de l'édifice communal."
                        }
                    ],
                    "synonyms": [
                        "sommet",
                        "comble"
                    ],
                    "antonyms": [
                        "base",
                        "fondation"
                    ]
                }
            ]
        }
    ]
