                    {
                        "translation_id": "e8c8c72b-8fdd-41f0-9111-55e5e5159cc8",
                        "source_entry_id": "3af3bafc-5eed-3ba9-8b5f-9de687853237",
                        "target_lang_word": "wandelaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wandelaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2124b263-46cb-35bd-a805-372d03c058f6",
                                        "entry_id": "5c0905fc-180d-3064-a8c2-917fe929b5c8",
                                        "glosses": [
                                            "iemand die buitenshuis een stuk loopt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e264e5-d9e8-4803-8c79-0e951ab293fa",
                                                "sense_id": "2124b263-46cb-35bd-a805-372d03c058f6",
                                                "text": "Vanwege het mooie weer waren er op de dijk een heel aantal wandelaars."
                                            },
                                            {
                                                "example_id": "c58e6f2c-d31a-41da-a48b-5dce5ffed915",
                                                "sense_id": "2124b263-46cb-35bd-a805-372d03c058f6",
                                                "text": "Hij was, net als Scout & Frodo, een zogenaamde Trail Angel: iemand die de Pacific Crest Trail (PCT)-gemeenschap een warm hart toedraagt en de wandelaars vrijwillig een lift geeft, een bed biedt en advies en water geeft."
                                            }
