                        "translation_id": "a3f19ce8-ac1e-4b87-97d9-529b8a785a6f",
                        "source_entry_id": "9fcc6f3c-9d90-3235-9750-e9dacc25e001",
                        "source_sense_id": "1c05bbd8-6d62-3e29-9164-1fc5b7968286",
