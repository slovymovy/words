    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9673d148-36c7-3377-b41e-510327afd30c",
                    "sense_definition": "Forte inclination, disposition ou penchant naturel pour une profession, un art ou un mode de vie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès son plus jeune âge, elle a découvert sa véritable <w>vocation</w> pour la médecine."
                        },
                        {
                            "text": "Ce professeur passionné a su éveiller des <w>vocations</w> artistiques chez ses élèves."
                        }
                    ],
                    "synonyms": [
                        "penchant",
                        "inclination",
                        "attrait"
                    ],
                    "antonyms": [
                        "aversion",
                        "dégoût"
                    ],
                    "common_phrases": [
                        "trouver sa vocation",
                        "rater sa vocation",
                        "susciter des vocations"
                    ]
                },
                {
                    "sense_id": "67a21f09-8920-348f-88e4-419c56bce4c7",
                    "sense_definition": "Destination naturelle, rôle ou fonction attribuée à une chose ou à une institution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouvel établissement a pour <w>vocation</w> d'accueillir les chercheurs du monde entier."
                        },
                        {
                            "text": "La <w>vocation</w> première de ce parc naturel est de protéger les espèces menacées."
                        }
                    ],
                    "synonyms": [
                        "destination",
                        "finalité",
                        "mission"
                    ],
                    "common_phrases": [
                        "avoir pour vocation",
                        "vocation première"
                    ]
                },
                {
                    "sense_id": "896a9b86-3155-3fbd-8cc6-8340552a1586",
                    "sense_definition": "Appel intérieur ressenti comme d'origine divine invitant à entrer dans les ordres religieux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spiritualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des années d'hésitation, il a enfin suivi sa <w>vocation</w> religieuse au monastère."
                        },
                        {
                            "text": "Le jeune homme affirme avoir reçu une <w>vocation</w> qui a bouleversé son existence."
                        }
                    ],
                    "synonyms": [
                        "appel"
                    ],
                    "common_phrases": [
                        "vocation religieuse",
                        "vocation sacerdotale"
                    ]
                },
                {
                    "sense_id": "2e327f18-2c18-3b67-a83e-4f0150bdff75",
                    "sense_definition": "Mission morale ou rôle transcendant qu'un individu ou une collectivité estime devoir accomplir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle consacre ses journées à soulager les pauvres car elle y voit sa haute <w>vocation</w>."
                        },
                        {
                            "text": "L'association rappelle constamment la <w>vocation</w> humanitaire qui guide toutes ses actions."
                        }
                    ],
                    "synonyms": [
                        "devoir",
                        "rôle"
                    ],
                    "common_phrases": [
                        "vocation humanitaire",
                        "accomplir sa vocation"
                    ]
                }
            ]
        }
    ]
