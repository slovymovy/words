                "senses": [
                    {
                        "sense_id": "d627795d-cb2a-344e-99e2-f69f79c786dc",
                        "entry_id": "87386d44-2dcb-3780-924b-2f60c61b975b",
                        "glosses": [
                            "Anhänger des Hardrocks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d68a0ce4-2160-4226-b7e6-21235b534ec7",
                                "sense_id": "d627795d-cb2a-344e-99e2-f69f79c786dc",
                                "text": "In der Kneipe an der Ecke treffen sich immer die Hardrocker."
                            },
                            {
                                "example_id": "59372abe-5f10-445e-9a2d-2ffb53a81618",
                                "sense_id": "d627795d-cb2a-344e-99e2-f69f79c786dc",
                                "text": "„Die Dresdner Waldschlößchenbrücke wurde im Juni vorübergehend nach einem britischen Hardrocker umbenannt - jedenfalls auf Google Maps.“"
                            },
                            {
                                "example_id": "5669c672-08b5-406e-b954-428e5d0849ac",
                                "sense_id": "d627795d-cb2a-344e-99e2-f69f79c786dc",
                                "text": "„Der amerikanische Hardrocker Paul Gray, Bassist von Slipknot, ist am Montag in einem Hotelzimmer in Urbandale tot aufgefunden worden.“"
                            },
                            {
                                "example_id": "6f28f46f-4955-493f-bc20-c1fdcdea36b5",
                                "sense_id": "d627795d-cb2a-344e-99e2-f69f79c786dc",
                                "text": "„Nun sind ja die Finnen außer den Iren das Volk mit den meisten Verrückten, und so haben die vier Männer von Apocalyptica die Sache mit dem Klassikrock umgedreht - die Absolventen der Sibelius Academy nehmen ihre Violoncellos, um Klang und Attitüde der Hardrocker zu imitieren.“"
                            },
                            {
                                "example_id": "30c34fde-0910-4360-b632-7fb2cb103116",
                                "sense_id": "d627795d-cb2a-344e-99e2-f69f79c786dc",
                                "text": "„AC/DC-Gründungsmitglied Malcolm Young wird nicht mehr mit den Hardrockern spielen.“"
                            },
                            {
                                "example_id": "d94a27d1-6916-48f0-a731-951f5c923cdb",
                                "sense_id": "d627795d-cb2a-344e-99e2-f69f79c786dc",
                                "text": "„Sind Motörhead die zeitlosen Hardrocker schlechthin, so stehen Linkin Park für junge laute Rockmusik mit Scratches und Beats.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
