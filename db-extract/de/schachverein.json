                        "glosses": [
                            "Verein, dessen Mitglieder sich zum Schachspielen treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b56654ad-0521-4d24-8d01-def3c283accb",
                                "sense_id": "a9c62f2a-8fde-3153-ac2a-c0d8547edea3",
                                "text": "„Mit sechs Jahren zog es den kleinen Blondschopf in den Schachverein von Maria Saal, drei Jahre später setzte er allmählich die Familie matt.“"
                            },
                            {
                                "example_id": "56105995-d113-4ada-af60-f85d72512826",
                                "sense_id": "a9c62f2a-8fde-3153-ac2a-c0d8547edea3",
                                "text": "„Gleichzeitig wachsen die Jugendabteilungen vieler Schachvereine - allerdings zieht es selten Mädchen dorthin.“"
                            }
                        ],
