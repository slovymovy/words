                        "target_lang_word": "multimètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multimètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05eb8b95-5d20-3494-992d-09e37870f130",
                                        "entry_id": "dde7f027-6dfa-3525-9f42-8e6a41d801ac",
                                        "glosses": [
                                            "Instrument de mesure qui peut mesurer différentes grandeurs électriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9279a857-595e-4c65-8ee8-462a84b17099",
                                                "sense_id": "05eb8b95-5d20-3494-992d-09e37870f130",
                                                "text": "Mais si vous êtes soigneux et que vous procédez de façon intelligente au moment de la mise au point, […], vous pourrez sans doute un jour réaliser vous-même un amplificateur de 100 W et le régler avec un simple multimètre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de2d5e69-b01c-4d41-ad43-7321c3c87237",
                        "source_entry_id": "9f35eee9-f6f2-32bd-a8d7-fa7c914eed5a",
                        "source_sense_id": "4732f0ab-8e70-31ea-8a06-5275a7764f14",
                        "source_sense_description": "measuring instrument",
                        "target_lang_word": "Multimeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Multimeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "928004ec-adcf-36f3-8689-1d3d9147d8ed",
                                        "entry_id": "febe4c1b-96aa-349b-bc70-056843e69eed",
                                        "glosses": [
                                            "Gerät, das für mehrere Messgrößen (zum Beispiel Spannung und Stromstärke) sowie für mehrere Messbereiche ausgelegt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecb29270-0ffc-4548-b8b1-d826822f8115",
                                                "sense_id": "928004ec-adcf-36f3-8689-1d3d9147d8ed",
                                                "text": "„Die in der Abbildung zu sehende Spannung auf dem Multimeter liegt mit rund 7,2 V etwas höher.“"
                                            },
                                            {
                                                "example_id": "7936612b-00cb-43cd-a1b9-27524497dabf",
                                                "sense_id": "928004ec-adcf-36f3-8689-1d3d9147d8ed",
                                                "text": "„Messen Sie mitdem Multimeter die Ausgangsspannung mit und ohne Ladekondensator.“"
                                            },
                                            {
                                                "example_id": "5735ca85-62ee-41bc-99b0-c38c5febaf05",
                                                "sense_id": "928004ec-adcf-36f3-8689-1d3d9147d8ed",
                                                "text": "„Mit dem Multimeter wird Stück für Stück der elektrische Widerstand des Silbergarns gemessen, um schlecht leitende Stellen zu finden.“"
                                            },
                                            {
                                                "example_id": "3e340a73-d32c-460e-af7a-f806dd03ffa3",
                                                "sense_id": "928004ec-adcf-36f3-8689-1d3d9147d8ed",
                                                "text": "„Sie war nämlich mit einer zusätzlichen Plastikschicht versehen, sodass sie nicht leitfähig war, wie ein Test mit dem Multimeter ergab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
