                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weasel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c80d056-e68f-3c58-bdb2-f09a3ca636e5",
                                        "entry_id": "1b2b7f5b-195f-374d-b04f-746dac3f30a4",
                                        "glosses": [
                                            "Any of the carnivorous mammals of the genera Mustela, Neogale, Poecilogale, and Lyncodon, having a slender body, a long tail and usually a light brown upper coat and light-coloured belly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd3ae83b-98a6-438f-b936-31afd5ad0df0",
                                                "sense_id": "9c80d056-e68f-3c58-bdb2-f09a3ca636e5",
                                                "text": "An old traditional prescription for provoking erotic inclinations ran as follows, The toe of the foot of a man, anointed with oil, or honey, or the ashes of a weasel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e82605c3-1f28-391f-b933-864d9b8c2580",
                                        "entry_id": "1b2b7f5b-195f-374d-b04f-746dac3f30a4",
                                        "glosses": [
                                            "A least weasel (Mustela nivalis)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2c25e5b-ee94-33d6-9881-eaddb4898160",
                                        "entry_id": "1b2b7f5b-195f-374d-b04f-746dac3f30a4",
                                        "glosses": [
                                            "Any of certain other species of the family Mustelidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de74236d-499d-33ac-aa49-3881475467f8",
                                        "entry_id": "1b2b7f5b-195f-374d-b04f-746dac3f30a4",
                                        "glosses": [
                                            "A devious or sneaky person or animal."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60d0acdc-9f22-4b27-8cc5-c004fcdad578",
                                                "sense_id": "de74236d-499d-33ac-aa49-3881475467f8",
                                                "text": "Once you've gone beyond the scripted speeches, soundbites and cliches, you'll notice how the debate about leadership is primarily divided between the three governors and two senators, the other two weasels, Donald Trump and Ben Carson notwithstanding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44b2b41d-85fe-3065-8189-540830e8dd56",
                                        "entry_id": "1b2b7f5b-195f-374d-b04f-746dac3f30a4",
                                        "glosses": [
                                            "A type of yarn winder used for counting the yardage of handspun yarn. It most commonly has a wooden peg or dowel that pops up from the gearing mechanism after a certain number of yards have been wound onto the winder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "weasel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6af052e0-8eea-3bb3-8778-e67740a1a789",
                                        "entry_id": "9c82fca9-2694-3087-9871-9f6acb4eadac",
                                        "glosses": [
                                            "To achieve by clever or devious means."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "804dfd94-d420-4464-bb56-618c2655a71a",
                                                "sense_id": "6af052e0-8eea-3bb3-8778-e67740a1a789",
                                                "text": "Prisoners are notorious for weaseling day passes to get out of lockup […] ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "277ac58a-a145-3ff7-8521-e52d9c45e413",
                                        "entry_id": "9c82fca9-2694-3087-9871-9f6acb4eadac",
                                        "glosses": [
                                            "To gain something for oneself by clever or devious means."
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d342bb14-12c3-4bdc-bbcc-003cbbc568c1",
                                                "sense_id": "277ac58a-a145-3ff7-8521-e52d9c45e413",
                                                "text": "He's weaseled himself into a position where he can influence the outcome of this election."
                                            },
                                            {
                                                "example_id": "01046770-1494-43d3-8080-3d54883c28ec",
                                                "sense_id": "277ac58a-a145-3ff7-8521-e52d9c45e413",
                                                "text": "Within just a couple of days, she [a dog] had weaseled her way into our hearts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "961614e3-db07-3044-bb89-3b0b29619970",
                                        "entry_id": "9c82fca9-2694-3087-9871-9f6acb4eadac",
                                        "glosses": [
                                            "To engage in clever or devious behavior."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dba3926-e6ee-42aa-b83b-ba796ae07b74",
                                                "sense_id": "961614e3-db07-3044-bb89-3b0b29619970",
                                                "text": "Authority figures have a history of weaseling on this topic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c013842-cee4-4784-9de2-440623a69604",
                        "source_entry_id": "3b76b4eb-599b-3d26-8278-11aa179e397c",
                        "source_sense_id": "ba91960b-0d9b-3439-9ed1-f347b293f1b0",
                        "source_sense_description": "bepaald soort zoogdier, Mustela nivales",
                        "target_lang_word": "belette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "856d9bda-7fac-352f-aa40-e4c22f0d618c",
                                        "entry_id": "89c832f6-794f-3525-8f10-a0d28e3999bd",
                                        "glosses": [
                                            "Petit mammifère carnassier, de forme effilée et de couleur rousse, qui a le museau pointu et les pattes courtes (Mustela nivalis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b64955e-c000-4ad6-ab3b-39854a538f42",
                                                "sense_id": "856d9bda-7fac-352f-aa40-e4c22f0d618c",
                                                "text": "Autour de la chambre, le long de la plinthe, des belettes courent, bondissent, se poursuivent…"
                                            },
                                            {
                                                "example_id": "43d3c17a-ba9b-4a72-b194-13bca39e24eb",
                                                "sense_id": "856d9bda-7fac-352f-aa40-e4c22f0d618c",
                                                "text": "Le long des murs de ma chambre, des belettes se poursuivaient, bondissaient, se livraient à des jeux obscènes…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90ba1d24-c7da-3206-a52c-b4eb426df48d",
                                        "entry_id": "89c832f6-794f-3525-8f10-a0d28e3999bd",
                                        "glosses": [
                                            "Jeune fille ou jeune femme charmante."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88b5c4d5-19b6-4205-b0d4-b9a353001f52",
                                                "sense_id": "90ba1d24-c7da-3206-a52c-b4eb426df48d",
                                                "text": "« Lorsqu'un chef entre dans un bureau où il y a des femmes, il nous lance : “Salut les belettes !” Dirait-il “Bonjour les blaireaux !” à des hommes ? »"
                                            },
                                            {
                                                "example_id": "df879770-0957-4896-86ec-a25e3e2787d4",
                                                "sense_id": "90ba1d24-c7da-3206-a52c-b4eb426df48d",
                                                "text": "Jasper : \"Qu'est-ce qu'elles veulent, les belettes\" ? Elles sortent de la voiture. Zoë : \"Bonjour ! C'est vous qui avez une Dodge Challenger de 70 à vendre ?\""
                                            },
                                            {
                                                "example_id": "c57b5a27-35f7-4eb1-81dc-a689dd3cef86",
                                                "sense_id": "90ba1d24-c7da-3206-a52c-b4eb426df48d",
                                                "text": "Salut, jolie belette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a115484-df53-3ad0-88d2-bda4c10d3d45",
                                        "entry_id": "89c832f6-794f-3525-8f10-a0d28e3999bd",
                                        "glosses": [
                                            "Fille naïve et idiote, féminin argotique de « blaireau »."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43adb9e9-9437-4660-b2b3-1e4f3a3d3b33",
                                                "sense_id": "0a115484-df53-3ad0-88d2-bda4c10d3d45",
                                                "text": "Quelle belette celle-là !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7823c1a3-0933-3fe4-bb0b-23d035ec3909",
                                        "entry_id": "89c832f6-794f-3525-8f10-a0d28e3999bd",
                                        "glosses": [
                                            "Curieux, personne curieuse."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d158d918-d0a2-41ea-a17b-ac4154ba1f9a",
                                                "sense_id": "7823c1a3-0933-3fe4-bb0b-23d035ec3909",
                                                "text": "Elle veut tout savoir ; c'est une vraie belette !"
                                            },
                                            {
                                                "example_id": "324f14fb-7770-4153-b55a-ba228242923c",
                                                "sense_id": "7823c1a3-0933-3fe4-bb0b-23d035ec3909",
                                                "text": "Ma mère est curieuse, veut tout savoir et pose énormément de questions. Sa soif de savoir lui a valu le surnom de « la belette » dans sa famille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
