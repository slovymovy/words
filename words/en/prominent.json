{
    "word_family": [
        "prominence",
        "prominently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d030326e-fab6-3714-8d4d-ea0ceb8f4ab2",
                    "sense_definition": "Important, famous, and respected within a particular field or society.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>prominent</w> lawyer who handles high-profile cases.",
                            "target_lang_translations": {
                                "ru": "Она — <w>выдающийся</w> юрист, занимающийся громкими делами.",
                                "fr": "C'est une avocate <w>éminente</w> qui s'occupe d'affaires très médiatisées."
                            }
                        },
                        {
                            "text": "Several <w>prominent</w> members of the community attended the meeting.",
                            "target_lang_translations": {
                                "ru": "На собрании присутствовали несколько <w>видных</w> членов общины.",
                                "fr": "Plusieurs membres <w>en vue</w> de la communauté ont assisté à la réunion."
                            }
                        }
                    ],
                    "synonyms": [
                        "eminent",
                        "distinguished",
                        "notable",
                        "noteworthy",
                        "outstanding"
                    ],
                    "common_phrases": [
                        "prominent figure",
                        "prominent role",
                        "prominent member",
                        "prominent family"
                    ],
                    "target_lang_definitions": {
                        "ru": "Важный, известный и уважаемый в определенной области или обществе.",
                        "fr": "Important, célèbre et respecté dans un domaine particulier ou dans la société."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдающийся",
                                "target_lang_sense_clarification": "исключительный, превосходящий других"
                            },
                            {
                                "target_lang_word": "видный",
                                "target_lang_sense_clarification": "значительный, известный"
                            },
                            {
                                "target_lang_word": "известный",
                                "target_lang_sense_clarification": "популярный, знаменитый"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "éminent",
                                "target_lang_sense_clarification": "qui se distingue par sa supériorité ou son mérite"
                            },
                            {
                                "target_lang_word": "prominent",
                                "target_lang_sense_clarification": "qui occupe une place importante ou influente"
                            },
                            {
                                "target_lang_word": "en vue",
                                "target_lang_sense_clarification": "très connu et influent"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "295cbf7c-7585-3356-8f67-6bfcd16ad68d",
                    "sense_definition": "Easy to see or notice because of size, position, or appearance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The notice was displayed in a <w>prominent</w> position on the board.",
                            "target_lang_translations": {
                                "ru": "Объявление было размещено на доске на <w>видном</w> месте.",
                                "fr": "L'avis était affiché bien <w>en évidence</w> sur le panneau."
                            }
                        },
                        {
                            "text": "The statue stands in a <w>prominent</w> spot in the town square.",
                            "target_lang_translations": {
                                "ru": "Статуя стоит на <w>заметном</w> месте на городской площади.",
                                "fr": "La statue se dresse à un endroit <w>bien visible</w> sur la place du village."
                            }
                        }
                    ],
                    "synonyms": [
                        "noticeable",
                        "eye-catching",
                        "attention-grabbing",
                        "observable"
                    ],
                    "common_phrases": [
                        "prominent position",
                        "prominent place",
                        "prominent display",
                        "prominent feature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко заметный благодаря размеру, положению или внешнему виду.",
                        "fr": "Facile à voir ou à remarquer en raison de sa taille, de sa position ou de son apparence."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заметный",
                                "target_lang_sense_clarification": "привлекающий внимание"
                            },
                            {
                                "target_lang_word": "видный",
                                "target_lang_sense_clarification": "находящийся на виду (о месте)"
                            },
                            {
                                "target_lang_word": "бросающийся в глаза",
                                "target_lang_sense_clarification": "яркий, очевидный"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "en évidence",
                                "target_lang_sense_clarification": "placé de manière à être bien visible"
                            },
                            {
                                "target_lang_word": "visible",
                                "target_lang_sense_clarification": "qui attire facilement l'attention"
                            },
                            {
                                "target_lang_word": "marquant",
                                "target_lang_sense_clarification": "qui se remarque aisément"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a112f6ab-4c0d-3420-94c0-a810860c1ad2",
                    "sense_definition": "Sticking out physically from a surface or a part of the body.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a <w>prominent</w> nose that defines his profile.",
                            "target_lang_translations": {
                                "ru": "У него <w>выступающий</w> нос, определяющий его профиль.",
                                "fr": "Il a un nez <w>proéminent</w> qui caractérise son profil."
                            }
                        },
                        {
                            "text": "The bird perched on a <w>prominent</w> rock overlooking the valley.",
                            "target_lang_translations": {
                                "ru": "Птица сидела на <w>выступающей</w> скале, возвышающейся над долиной.",
                                "fr": "L'oiseau s'est posé sur un rocher <w>saillant</w> surplombant la vallée."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prominent chin",
                        "prominent nose",
                        "prominent cheekbones",
                        "prominent jaw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически выступающий над поверхностью или являющийся выдающейся частью тела.",
                        "fr": "Qui dépasse physiquement d'une surface ou d'une partie du corps."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступающий",
                                "target_lang_sense_clarification": "торчащий, выдающийся вперед"
                            },
                            {
                                "target_lang_word": "выпуклый",
                                "target_lang_sense_clarification": "имеющий округлую, выступающую форму"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "proéminent",
                                "target_lang_sense_clarification": "qui dépasse ou fait relief"
                            },
                            {
                                "target_lang_word": "saillant",
                                "target_lang_sense_clarification": "qui avance ou sort en dehors"
                            },
                            {
                                "target_lang_word": "protubérant",
                                "target_lang_sense_clarification": "qui forme une bosse ou une avancée"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7845f65-94d3-31f8-83cc-22e5aa9015ec",
                    "sense_definition": "A type of moth that typically has a projection on the edge of its wings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>prominent</w> is often found resting on tree trunks.",
                            "target_lang_translations": {
                                "ru": "<w>Хохлатку</w> часто можно найти отдыхающей на стволах деревьев.",
                                "fr": "Le <w>notodonte</w> se repose souvent sur le tronc des arbres."
                            }
                        },
                        {
                            "text": "We identified the insect as a species of <w>prominent</w>.",
                            "target_lang_translations": {
                                "ru": "Мы определили это насекомое как вид <w>хохлатки</w>.",
                                "fr": "Nous avons identifié l'insecte comme une espèce de <w>notodonte</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "notodontid",
                        "prominent moth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность моли, обычно имеющая выступ на краю крыльев.",
                        "fr": "Type de papillon de nuit ayant généralement une saillie sur le bord de ses ailes (notodontidé)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хохлатка",
                                "target_lang_sense_clarification": "семейство бабочек"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "notodonte",
                                "target_lang_sense_clarification": "papillon de la famille des Notodontidae"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfb671e5-b62a-312c-8edd-b2ff7f4fe944",
                    "sense_definition": "A prisoner in a Nazi concentration camp who was given special duties and privileges.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>prominents</w> were treated differently from the other inmates.",
                            "target_lang_translations": {
                                "ru": "К <w>проминентам</w> относились иначе, чем к другим заключенным.",
                                "fr": "Les <w>prominents</w> étaient traités différemment des autres détenus."
                            }
                        },
                        {
                            "text": "Survival often depended on the whims of the <w>prominents</w> in the camp.",
                            "target_lang_translations": {
                                "ru": "Выживание часто зависело от прихотей <w>проминентов</w> в лагере.",
                                "fr": "La survie dépendait souvent des caprices des <w>prominents</w> du camp."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заключенный в нацистском концлагере, наделенный особыми обязанностями и привилегиями.",
                        "fr": "Prisonnier d'un camp de concentration nazi bénéficiant de fonctions et de privilèges particuliers."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проминенты",
                                "target_lang_sense_clarification": "исторический термин"
                            },
                            {
                                "target_lang_word": "привилегированный заключенный",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "prominent",
                                "target_lang_sense_clarification": "détenu privilégié dans un camp nazi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}