                "senses": [
                    {
                        "sense_id": "4bccd986-a809-3a45-a47f-46c78bf95250",
                        "entry_id": "b4993716-9b6a-30b7-8f3d-5791ad6fec62",
                        "glosses": [
                            "großes Einzelhandelsgeschäft, in dem es in erster Linie Pflanzen und Gartenzubehör zu kaufen gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8dfd4da-cbd2-4159-a882-a460cad999fd",
                                "sense_id": "4bccd986-a809-3a45-a47f-46c78bf95250",
                                "text": "„Radieschen, Spinat und Frühlingszwiebeln dürfen jetzt schon ins Beet – die Gartencenter haben ja endlich wieder geöffnet.“"
                            },
                            {
                                "example_id": "b630c103-b3b2-4fc1-b1ea-a59f2ae7b272",
                                "sense_id": "4bccd986-a809-3a45-a47f-46c78bf95250",
                                "text": "„Wenn Sie demnächst im Gartencenter nach gestreiften Maiglöckchen fragen, lassen Sie sich von der Antwort ‚Wir haben nur karierte‘ nicht aus der Fassung bringen – es gibt sie wirklich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
