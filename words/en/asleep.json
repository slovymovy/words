                    "sense_definition": "In a state of sleep; resting and unconscious.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>asleep</w> when you called.",
                            "target_lang_translations": {
                                "ru": "Я <w>спал</w>, когда ты позвонил.",
                                "pl": "<w>Spałem</w>, kiedy zadzwoniłeś.",
                                "nl": "Ik <w>sliep</w> toen je belde.",
                                "de": "Ich habe <w>geschlafen</w>, als du angerufen hast.",
                                "fr": "J'étais <w>endormi</w> quand tu as appelé.",
                                "it": "Stavo <w>dormendo</w> quando hai chiamato.",
                                "cs": "Když jsi volal, <w>spal</w> jsem.",
                                "tr": "Aradığında <w>uyuyordum</w>.",
                                "es": "Estaba <w>dormido</w> cuando llamaste.",
                                "zh": "你打电话时我正<w>睡着</w>。",
                                "ja": "電話をくれたとき、私は<w>寝ていました</w>。",
                                "pt": "Eu estava <w>a dormir</w> quando me ligaste."
                            }
                        },
                        {
                            "text": "The baby is fast <w>asleep</w> in the crib.",
                            "target_lang_translations": {
                                "ru": "Ребенок крепко <w>спит</w> в кроватке.",
                                "pl": "Dziecko mocno <w>śpi</w> w łóżeczku.",
                                "nl": "De baby is diep <w>in slaap</w> in de wieg.",
                                "de": "Das Baby <w>schläft</w> tief und fest in der Wiege.",
                                "fr": "Le bébé est profondément <w>endormi</w> dans son berceau.",
                                "it": "Il bambino è profondamente <w>addormentato</w> nella culla.",
                                "cs": "Miminko v postýlce tvrdě <w>spí</w>.",
                                "tr": "Bebek beşikte mışıl mışıl <w>uyuyor</w>.",
                                "es": "El bebé está profundamente <w>dormido</w> en la cuna.",
                                "zh": "婴儿在婴儿床里<w>熟睡</w>。",
                                "ja": "赤ちゃんはベビーベッドでぐっすり<w>眠っています</w>。",
                                "pt": "O bebé está profundamente <w>adormecido</w> no berço."
                            }
                        }
