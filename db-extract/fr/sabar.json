                        "glosses": [
                            "Instrument de musique à percussion sénégalais et gambien en bois, dont la membrane est en peau de chèvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "041a898b-c1f4-4df7-87fd-c64275d1de12",
                                "sense_id": "0d3489f6-047f-3113-8f28-f7477675a142",
                                "text": "— Cette formation organisée selon la demande est consacrée aux polyrythmies jouées par les tambours djembé et dundun au Mali et en Guinée et à celles de l'ensemble de tambours sabar du Sénégal."
                            }
                        ]
                    },
                    {
                        "sense_id": "220e7d20-679b-3138-869b-e97a5f27f119",
                        "entry_id": "31b40a7a-73af-3f27-964f-21d62414d4e8",
                        "glosses": [
                            "Style de musique, de danse, et fête traditionnelle associés à cet instrument."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c780e5-d00f-4919-8ba3-fb1767a3ad39",
                                "sense_id": "220e7d20-679b-3138-869b-e97a5f27f119",
                                "text": "En effet, le sabar est omniprésent en toutes occasions de réjouissances, à tel point que le mot est devenu synonyme de « fête »."
                            }
                        ]
