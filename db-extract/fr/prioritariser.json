                        "glosses": [
                            "Donner un caractère prioritaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02df4326-5077-453e-b3ab-9fd718ac997a",
                                "sense_id": "dff56087-891c-3efd-b935-a8330bc65d7e",
                                "text": "Et ce même concept constitue la base des «thèmes majeurs d’une culture» les éléments à prioritariser en cherchant le contenu commun qui est essentiel, en situation pluraliste, à la poursuite d’une civilisation partagée."
                            },
                            {
                                "example_id": "a3cbf044-8581-47ef-a1a8-504aebdddcda",
                                "sense_id": "dff56087-891c-3efd-b935-a8330bc65d7e",
                                "text": "Il / elle a efficacement prioritarisé les programmes, les fêtes, les activités, les collectes d’aliments, les séminaires, les événements d’échange de cadeaux, etc."
                            }
                        ]
                    }
