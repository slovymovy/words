                {
                    "sense_id": "1dccdc18-7e35-3b8d-b8b1-d500d0084955",
                    "sense_definition": "the specific long, rising and falling sound made by an emergency vehicle siren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambulance driver switched the siren from a yelp to a steady <w>wail</w> as they cleared the intersection.",
                            "target_lang_translations": {
                                "ru": "Водитель скорой помощи переключил сирену с прерывистого звука на ровный <w>вой</w>, проезжая перекресток.",
                                "cs": "Řidič sanitky přepnul sirénu z přerušovaného tónu na táhlé <w>houkání</w>, jakmile projeli křižovatkou."
                            }
                        },
                        {
                            "text": "The constant <w>wail</w> of sirens is a common background noise for those living in the city center.",
                            "target_lang_translations": {
                                "ru": "Постоянный <w>вой</w> сирен — привычный фоновый шум для тех, кто живет в центре города.",
                                "cs": "Neustálé <w>houkání</w> sirén je běžnou zvukovou kulisou pro ty, kteří žijí v centru města."
                            }
                        }
                    ],
                    "common_phrases": [
