                        "sense_id": "bc1d097f-8ec1-3303-92e1-34e19131edd0",
                        "entry_id": "29a1a917-1f64-37cd-b130-1b4cf802cae0",
                        "glosses": [
                            "den eigenen Vorstellungen entsprechender fester Zeitpunkt, zu dem etwas stattfindet/stattfinden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9784c59-2a70-4c9b-a45e-c9d05ea8d58d",
                                "sense_id": "bc1d097f-8ec1-3303-92e1-34e19131edd0",
                                "text": "„Berliner sollen in Zukunft einfacher einen Wunschtermin beim Bürgeramt finden.“"
                            },
                            {
                                "example_id": "d71f521d-df16-4fe1-98a2-677fc8ac2784",
                                "sense_id": "bc1d097f-8ec1-3303-92e1-34e19131edd0",
                                "text": "„Der nächste große Sturm auf die Standesämter folgt bereits am 20.08.2008. Exakt ein halbes Jahr vor dem Wunschtermin konnte man sich beim Standesamt seiner Wahl für diesen Tag bewerben.“"
                            }
                        ],
