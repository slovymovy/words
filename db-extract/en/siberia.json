                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "983d4129-4404-32e4-8271-8eed3dc9c852",
                        "entry_id": "d35f0ee5-75a5-38a2-b6cc-4c81513ad5d7",
                        "glosses": [
                            "Sibirien"
                        ],
                        "tags": [],
