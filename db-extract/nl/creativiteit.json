        "nl-extract.jsonl": [
            {
                "entry_id": "e14ede8a-ae69-3c5c-9811-353aea45e127",
                "word": "creativiteit",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "9b4a222f-6124-4ba3-9426-2260643d69c4",
                        "entry_id": "e14ede8a-ae69-3c5c-9811-353aea45e127",
                        "tags": [
                            "plural"
                        ],
                        "form": "creativiteiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1188782-3bcc-3e61-9f84-d6ad7cd78156",
                        "entry_id": "e14ede8a-ae69-3c5c-9811-353aea45e127",
                        "glosses": [
                            "gedrevenheid of vaardigheid om iets oorspronkelijks te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0274a280-295a-44be-83cf-067a5868892d",
                                "sense_id": "f1188782-3bcc-3e61-9f84-d6ad7cd78156",
                                "text": "Deze jongen had blijkbaar besloten zijn hele PCT tocht in stilte te lopen, vijf maanden lang. Hij wilde zichzelf beter leren begrijpen en zijn fantasie en innerlijke creativiteit de ruimte te geven."
                            },
                            {
                                "example_id": "89bec411-d757-4e5e-8e53-b8b3c9a92986",
                                "sense_id": "f1188782-3bcc-3e61-9f84-d6ad7cd78156",
                                "text": "Zijn cursus diende om de eigen, sluimerende creativiteiten te ontdekken, de persoonlijke affiniteit met de verschillende materialen te onderzoeken en om de bewustwording te bevorderen van de universele basiselementen en -principes van de kunst."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53c41ce4-ad2f-4f62-ad9f-855d174b13d6",
                        "source_entry_id": "e14ede8a-ae69-3c5c-9811-353aea45e127",
                        "source_sense_id": "f1188782-3bcc-3e61-9f84-d6ad7cd78156",
                        "source_sense_description": "gedrevenheid of vaardigheid om iets oorspronkelijks te maken",
                        "target_lang_word": "Kreativität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreativität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "218e9cb3-2d24-320c-8e2d-5e6958b28ab5",
                                        "entry_id": "0d0ae8a1-8dc8-35c3-be14-9e974b1e7ad4",
                                        "glosses": [
                                            "Fähigkeit zu neuen, schöpferischen Ideen und/oder Taten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc781c42-36b0-41fc-8280-1a6cc4753043",
                                                "sense_id": "218e9cb3-2d24-320c-8e2d-5e6958b28ab5",
                                                "text": "Ohne eine Veranlagung zur Kreativität kann man keine Kunstwerke hervorbringen."
                                            },
                                            {
                                                "example_id": "a67d6de9-18d3-4e7c-9808-767afc0c76c4",
                                                "sense_id": "218e9cb3-2d24-320c-8e2d-5e6958b28ab5",
                                                "text": "„Doch neben fundiertem Sprachwissen seien auch ein hohes Maß an Allgemeinbildung, Kreativität und kulturelle Kompetenz von ausdrücklicher Bedeutung.“"
                                            },
                                            {
                                                "example_id": "52828e05-1746-4176-be5d-e2888f203c32",
                                                "sense_id": "218e9cb3-2d24-320c-8e2d-5e6958b28ab5",
                                                "text": "„Der Kreativität sollten dabei keine Grenzen gesetzt sein.“"
                                            },
                                            {
                                                "example_id": "34b36211-d52c-4eb0-9e4f-fc3ec5da902d",
                                                "sense_id": "218e9cb3-2d24-320c-8e2d-5e6958b28ab5",
                                                "text": "„Von frei fließender Kreativität findet sich anfangs keine Spur.“"
                                            },
                                            {
                                                "example_id": "688bbded-794e-432f-8677-cb5342da4469",
                                                "sense_id": "218e9cb3-2d24-320c-8e2d-5e6958b28ab5",
                                                "text": "„Eine katholische Schule ist kein Ort für Kreativität und unabhängiges Denken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "637587a8-56a2-35d4-a024-dc8fcd6c84c3",
                                        "entry_id": "0d0ae8a1-8dc8-35c3-be14-9e974b1e7ad4",
                                        "glosses": [
                                            "Fähigkeit, von endlichen sprachlichen Mitteln einen unendlichen Gebrauch zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b1f0db-f73b-49e9-b7b2-9af3e7f89a41",
                                                "sense_id": "637587a8-56a2-35d4-a024-dc8fcd6c84c3",
                                                "text": "„Es gibt auch keine Grenze hinsichtlich der Kreativität der Sprache: In jeder kommunikativen Sprachhandlung können neue Zeichen gebildet werden, um damit neue Sachverhalte, Empfindungen, Gedanken mitzuteilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3389a511-6b54-4ca8-b4c5-484ea7009c66",
                        "source_entry_id": "e14ede8a-ae69-3c5c-9811-353aea45e127",
                        "source_sense_id": "f1188782-3bcc-3e61-9f84-d6ad7cd78156",
                        "source_sense_description": "gedrevenheid of vaardigheid om iets oorspronkelijks te maken",
                        "target_lang_word": "creativity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creativity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63473be5-3e9a-388c-ab11-cf34e1943ec7",
                                        "entry_id": "39cf81a8-23ec-3461-9f7c-dc0fdb0f0200",
                                        "glosses": [
                                            "The ability to use imagination to produce a novel idea or product."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79b9f5f-f1dd-4c1e-af9f-e00c87c07993",
                                                "sense_id": "63473be5-3e9a-388c-ab11-cf34e1943ec7",
                                                "text": "His creativity is unsurpassed by his fellow students in the art class."
                                            },
                                            {
                                                "example_id": "f7d0082b-cbcd-4653-93c7-74175127371d",
                                                "sense_id": "63473be5-3e9a-388c-ab11-cf34e1943ec7",
                                                "text": "Netherlands, one of the pre-tournament favourites, combined their undoubted guile, creativity, pace and attacking quality with midfield grit and organisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e72b0f2-3e0a-4ba0-b72e-f26d37cca962",
                        "source_entry_id": "e14ede8a-ae69-3c5c-9811-353aea45e127",
                        "source_sense_id": "f1188782-3bcc-3e61-9f84-d6ad7cd78156",
                        "source_sense_description": "gedrevenheid of vaardigheid om iets oorspronkelijks te maken",
                        "target_lang_word": "créativité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "créativité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6921eac2-578e-33b6-bd73-a80f67d377ec",
                                        "entry_id": "90e5d8fa-3b38-3006-a495-fd057c7eba12",
                                        "glosses": [
                                            "Façon créative de faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "855268a5-5119-475b-8e2c-2d878e88afe3",
                                                "sense_id": "6921eac2-578e-33b6-bd73-a80f67d377ec",
                                                "text": "La psychologie de la vieillesse n’est encore qu’esquissée. La créativité, qui est prospection dans le temps, s’épuise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5dbed21-c8d6-32e5-9737-f69203ffe6c2",
                                        "entry_id": "90e5d8fa-3b38-3006-a495-fd057c7eba12",
                                        "glosses": [
                                            "Capacité, faculté, d’inventer du nouveau, de nouvelles choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70d8def1-3222-4b34-ab81-28429da35677",
                                                "sense_id": "b5dbed21-c8d6-32e5-9737-f69203ffe6c2",
                                                "text": "Vos supérieurs aiment votre créativité et vous pourriez obtenir une prime. Youhou !"
                                            },
                                            {
                                                "example_id": "cf9d1de7-9aab-4e5e-89e4-2968601ce830",
                                                "sense_id": "b5dbed21-c8d6-32e5-9737-f69203ffe6c2",
                                                "text": "La créativité, c’est l’aptitude à avoir de bonnes idées de solutions de façon répétées, si possibles nouvelles (inattendues aux yeux des autres)."
                                            },
                                            {
                                                "example_id": "04d88fe7-f3fe-43a9-a1ff-bd753974f8cd",
                                                "sense_id": "b5dbed21-c8d6-32e5-9737-f69203ffe6c2",
                                                "text": "Des scientifiques ont découvert une série de gènes liés à la créativité qui pourraient avoir donné à l'Homo sapiens un avantage significatif sur l'Homo neanderthalensis, lui permettant d'éviter l'extinction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5179c5b8-7de2-30d9-8224-68c74d0e01c5",
                                        "entry_id": "90e5d8fa-3b38-3006-a495-fd057c7eba12",
                                        "glosses": [
                                            "Partie d’un processus de conception qui se situe après l’analyse et avant la synthèse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b4f11f-d82b-40f5-b792-99e6edf22509",
                                                "sense_id": "5179c5b8-7de2-30d9-8224-68c74d0e01c5",
                                                "text": "Ainsi, la créativité est la faculté de composer, de construire, à partir d’éléments déconstruits, un concept, en effectuant sa synthèse. C’est une succession ou une alternance de moments créatifs (d’imagination) et créateurs (de création)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c4bf02f-2d72-423d-a8eb-674eb4cb2d02",
                        "source_entry_id": "e14ede8a-ae69-3c5c-9811-353aea45e127",
