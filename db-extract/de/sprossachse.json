                    {
                        "translation_id": "7622422c-cc16-4e96-a363-7a7193111314",
                        "source_entry_id": "cb4e93a4-2bb7-3cbb-9d3d-881017bc9a7c",
                        "source_sense_id": "f934dfe2-8223-3fae-b1f6-311e5cab2e50",
