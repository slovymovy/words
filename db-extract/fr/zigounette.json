                "senses": [
                    {
                        "sense_id": "854855b9-6be3-3310-a3fd-9019d5e09c49",
                        "entry_id": "e97cccf0-d730-39aa-853a-cc94a76b4aa9",
                        "glosses": [
                            "Pénis, mot rigolo qu’utilisent les enfants pour désigner le pénis."
                        ],
                        "tags": [
                            "childish"
                        ],
                        "examples": [
                            {
                                "example_id": "bd22d3de-7247-47e2-8350-80c880a1697c",
                                "sense_id": "854855b9-6be3-3310-a3fd-9019d5e09c49",
                                "text": "L’auteur nous conte la passion brûlante et désespérée de ces deux êtres fragiles mais tremblants d’amour qui vont vers leur destin, la main dans la main et la zigounette dans le pilou-pilou."
                            },
                            {
                                "example_id": "990436f9-e2c3-423e-941e-a9fea7e78bbb",
                                "sense_id": "854855b9-6be3-3310-a3fd-9019d5e09c49",
                                "text": "Les papes suivants affecteront en revanche d’être offusqués par tant de poitrines opulentes, tant de zigounettes ainsi impudiquement dévoilées. Clément VIII, Paul III et Paul IV songèrent à détruire la fresque..."
                            },
                            {
                                "example_id": "c8a55b3c-8d3f-42aa-8e1c-2c7fdbfbdee5",
                                "sense_id": "854855b9-6be3-3310-a3fd-9019d5e09c49",
                                "text": "L’un d’eux lui expliqua à mi-voix que la ronde nocturne et la lampe de poche permettaient juste le zieutage des craquettes et des zigounettes de celles et ceux qui sortaient de leurs cases pour pisser la nuit dans la nature."
                            }
                        ]
                    }
                ],
