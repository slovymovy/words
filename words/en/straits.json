                    "frequency": "Middle",
                    "semantic_group_id": "difficulty_or_waterway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company found itself in dire <w>straits</w> after the unexpected market crash.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf kwam na de onverwachte beurscrisis ernstig in het <w>nauw</w>."
                            }
                        },
                        {
                            "text": "Several cargo ships waited near the <w>straits</w> before receiving clearance to cross.",
                            "target_lang_translations": {
                                "nl": "Verscheidene vrachtschepen wachtten in de buurt van de <w>zeestraten</w> voordat ze toestemming kregen om over te steken."
                            }
                        }
                    ],
                    "synonyms": [
