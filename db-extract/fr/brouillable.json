                ],
                "senses": [
                    {
                        "sense_id": "cfc41f8f-8e85-30e3-a8e6-81ed0d258c2e",
                        "entry_id": "4d05aad4-88d0-3c3e-a9af-eaf9acc7444e",
                        "glosses": [
                            "Que l’on peut brouiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7619b5d1-9d1f-4b80-a6be-1d1dd449f3b7",
                                "sense_id": "cfc41f8f-8e85-30e3-a8e6-81ed0d258c2e",
                                "text": "Certains objectifs sont eux-mêmes émetteurs de rayonnement, ce rayonnement étant difficilement brouillable ; tels sont, par exemple, dans une certaine mesure, les navires, les locomotives et, généralement, les sources thermiques, car elles émettent des rayonnements infra-rouges."
                            },
                            {
                                "example_id": "6798e2f5-48cc-4cd6-a1de-4828378ef94e",
                                "sense_id": "cfc41f8f-8e85-30e3-a8e6-81ed0d258c2e",
                                "text": "Ni les téléphones facilement destructibles par l’ennemi, ni la télégraphie sans fil (T.S.F.) aisément brouillable et tributaire de fortes sources d’électricité , ni la télégraphie par le sol (T.P.S.) capricieuse, ne pouvaient assurer de liaisons avec certitude."
                            },
                            {
                                "example_id": "943d1d20-b855-43dd-a94b-2ea5b90ef43f",
                                "sense_id": "cfc41f8f-8e85-30e3-a8e6-81ed0d258c2e",
                                "text": "Pour joindre Bassora et le commandement sud de ses troupes, le chef d’état-major iraquien ne disposait plus que de la classique radio aisément brouillable et interceptable."
                            }
                        ]
                    }
