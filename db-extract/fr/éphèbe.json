                    {
                        "translation_id": "7c177bd6-0694-4bdd-843c-b1b82c121616",
                        "source_entry_id": "9f4f2104-0e18-32ca-a9b9-3c4d75cb6619",
                        "source_sense_id": "b9b70751-8d4d-3535-9573-610093eff851",
                        "source_sense_description": "Jeune homme",
                        "target_lang_word": "Jüngling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jüngling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34f69286-a6fb-359c-a05b-580226158ba3",
                                        "entry_id": "1ff26dbe-d596-3c23-ae20-992d2d3772c3",
                                        "glosses": [
                                            "junger, fast erwachsener Mann"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38364542-a321-4b51-a71f-69d64f4e814a",
                                                "sense_id": "34f69286-a6fb-359c-a05b-580226158ba3",
                                                "text": "Der schöne blonde Jüngling, fast nackt, schaut dämonisch in die Kamera, vielleicht auch bloß ein bißchen dümmlich. Der Jüngling ist nämlich Dressman, und er steht Modell für jenes Stück Unterwäsche, das seine Blöße notdürftig bedeckt."
                                            },
                                            {
                                                "example_id": "ef940ac5-8183-4a81-b650-18eff226cad2",
                                                "sense_id": "34f69286-a6fb-359c-a05b-580226158ba3",
                                                "text": "„Der Jüngling wird sich des Charmes bewußt, über den er verfügt und den er bald taktisch einzusetzen versteht, wo immer es ihm genehm scheint.“"
                                            },
                                            {
                                                "example_id": "6fddfc1b-b475-45a5-873f-451b2dde62c8",
                                                "sense_id": "34f69286-a6fb-359c-a05b-580226158ba3",
                                                "text": "„Daß der Jüngling seine allzu direkte Frage fürs erste ausflüchtig mit einem Gähnen quittiert hatte, zeugte von Einfühlungsvermögen, um nicht zu sagen: von Herzenstakt.“"
                                            },
                                            {
                                                "example_id": "2249841a-dbe1-41af-b4c7-531daef9c5a1",
                                                "sense_id": "34f69286-a6fb-359c-a05b-580226158ba3",
                                                "text": "„Alf Bertini war zu einem mittelgroßen Jüngling herangewachsen, der sich nach wie vor für ein Wunderkind hielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1f018b98-1f77-300b-9b1a-bcdbbcfd08e3",
                                        "entry_id": "1ff26dbe-d596-3c23-ae20-992d2d3772c3",
                                        "glosses": [
                                            "einen halbwüchsigen beziehungsweise unreifen/unfertigen Menschen/Heranwachsenden"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78a04c02-2b8d-4dfc-938e-6534a198410a",
                                                "sense_id": "1f018b98-1f77-300b-9b1a-bcdbbcfd08e3",
                                                "text": "Der schöne blonde Jüngling, fast nackt, schaut dämonisch in die Kamera, vielleicht auch bloß ein bißchen dümmlich. Der Jüngling ist nämlich Dressman, und er steht Modell für jenes Stück Unterwäsche, das seine Blöße notdürftig bedeckt."
                                            },
                                            {
                                                "example_id": "117ebc35-f3f3-4770-9786-ffc133f8a71f",
                                                "sense_id": "1f018b98-1f77-300b-9b1a-bcdbbcfd08e3",
                                                "text": "„Ganz abgesehen von der Theorie ist mir auch schleierhaft, was an der Praxis von mittelalterlichen Frauen, die sich mit Jünglingen vergnügen, so heiss, so selbstermächtigend, so befreiend sein soll, dass aufgeklärte Frauen die neue Katzenschublade plötzlich mitfeiern.“"
                                            },
                                            {
                                                "example_id": "fa45d602-b7c0-4c03-a5e0-32ee8ffbbbf3",
                                                "sense_id": "1f018b98-1f77-300b-9b1a-bcdbbcfd08e3",
                                                "text": "„Coach Frank Rijkaard, ebenfalls erst im Sommer zu Barca gestoßen, konnte mit dem taktisch unreifen Jüngling nicht viel anfangen und verbannte ihn des Öfteren auf die Bank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
