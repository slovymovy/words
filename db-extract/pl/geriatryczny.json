                    {
                        "translation_id": "3c07c590-0eca-48ac-861f-56c94b38f941",
                        "source_entry_id": "433fbc8e-8f6f-3b2a-beaa-3648a4cd22d1",
                        "source_sense_id": "b53871b2-c2aa-339f-9342-00eca47d2b67",
                        "target_lang_word": "gériatrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gériatrique",
