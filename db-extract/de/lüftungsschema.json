                "senses": [
                    {
                        "sense_id": "59bcebbc-a0d8-395f-abe8-5de915538c0b",
                        "entry_id": "da7d2c2f-b151-3ed4-b94f-1670e10b4336",
                        "glosses": [
                            "grundsätzliches, gedankliches Konzept als Orientierungshilfe für die Herangehensweise bei der Lüftung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09d2d400-5d38-4b31-9c8c-5f2cc2a3da5e",
                                "sense_id": "59bcebbc-a0d8-395f-abe8-5de915538c0b",
                                "text": "„Zum Ausfüllen des Blattes 2 wird ein Lüftungsschema (resp. mehrere Schemata), aus dem die Abluftströme ersichtlich sind, benötigt.“"
                            },
                            {
                                "example_id": "1f3dc925-3350-43eb-98b7-6f1c27706638",
                                "sense_id": "59bcebbc-a0d8-395f-abe8-5de915538c0b",
                                "text": "„Lüftungsschema für dichten Gebäudeabschluss.“"
                            },
                            {
                                "example_id": "0610031c-3daa-4138-8e05-66f09ed20169",
                                "sense_id": "59bcebbc-a0d8-395f-abe8-5de915538c0b",
                                "text": "„Achten Sie auch auf ein angepasstes Lüftungsschema.“"
                            },
                            {
                                "example_id": "8eae18f9-4f30-41c3-8c78-0abc8120f293",
                                "sense_id": "59bcebbc-a0d8-395f-abe8-5de915538c0b",
                                "text": "„Grundlagen der Untersuchung waren Lüftungsschema, tabellarische Aufstellungen der Volumenstromregler, sowie Begehungen zur Überprüfung von Einzeldetails.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ff34ff67-ea00-37f5-b6a7-99977be4f4c9",
                        "entry_id": "da7d2c2f-b151-3ed4-b94f-1670e10b4336",
                        "glosses": [
                            "auf das Wesentliche reduzierte, grafische, übersichtliche Darstellung zur Lüftung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "675a5299-3af0-4412-9662-a65a924bd931",
                                "sense_id": "ff34ff67-ea00-37f5-b6a7-99977be4f4c9",
                                "text": "„Grundlagen der Untersuchung waren Lüftungsschema, tabellarische Aufstellungen der Volumenstromregler, sowie Begehungen zur Überprüfung von Einzeldetails.“"
                            },
                            {
                                "example_id": "1dffdbb4-4907-4911-816a-1de9d9fd85b9",
                                "sense_id": "ff34ff67-ea00-37f5-b6a7-99977be4f4c9",
                                "text": "„In einem Lüftungsschema sollten wesentliche Lüftungs- und Klimaanlagen sowie Luftleitungen mit deren relevanten Verknüpfungen und Durchlässen dargestellt werden, um die Bemessung von Luftleitungen und deren Einbauteilen vornehmen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
