{
    "word_family": [
        "blistery",
        "blisteringly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "820ef7c2-4998-3faf-949f-59412b105c92",
                    "sense_definition": "A small fluid-filled bubble on the skin caused by friction, heat, or damage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "swelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wearing tight new shoes gave me a painful <w>blister</w> on my heel.",
                            "target_lang_translations": {
                                "cs": "Z nošení těsných nových bot se mi na patě udělal bolestivý <w>puchýř</w>."
                            }
                        },
                        {
                            "text": "Try not to pop the <w>blister</w> on your hand so it does not get infected.",
                            "target_lang_translations": {
                                "cs": "Snaž se ten <w>puchýř</w> na ruce nepropíchnout, aby se do něj nedostala infekce."
                            }
                        }
                    ],
                    "synonyms": [
                        "bleb"
                    ],
                    "common_phrases": [
                        "blister pack"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý váček naplněný tekutinou na kůži, způsobený třením, teplem nebo poškozením."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "puchýř",
                                "target_lang_sense_clarification": "na kůži"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2c03613-92d5-3243-9040-7aca267e9ca7",
                    "sense_definition": "A bubble resembling a blister on the surface of paint, metal, or another material.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "swelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moisture trapped underneath the wall created a small <w>blister</w> in the paint.",
                            "target_lang_translations": {
                                "cs": "Vlhkost zachycená pod stěnou vytvořila v barvě malý <w>puchýř</w>."
                            }
                        },
                        {
                            "text": "Each <w>blister</w> on the wooden door must be sanded down before repainting.",
                            "target_lang_translations": {
                                "cs": "Každá <w>bublina</w> na dřevěných dveřích se musí před novým nátěrem zbrousit."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Bublina připomínající puchýř na povrchu laku, kovu nebo jiného materiálu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "puchýř",
                                "target_lang_sense_clarification": "na laku či povrchu"
                            },
                            {
                                "target_lang_word": "bublina",
                                "target_lang_sense_clarification": "na nátěru či omítce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fab47f07-c3b9-3c02-a18a-a7f8399dcdfc",
                    "sense_definition": "An annoying, troublesome, or unpleasant person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He proved to be a real <w>blister</w> at dinner, complaining about everything.",
                            "target_lang_translations": {
                                "cs": "Při večeři se ukázal jako hotová <w>otrava</w>, když si pořád na všechno stěžoval."
                            }
                        },
                        {
                            "text": "I hope that old <w>blister</w> stays home instead of ruining our party.",
                            "target_lang_translations": {
                                "cs": "Doufám, že ten protivný <w>protiva</w> zůstane doma a nezkazí nám večírek."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Otravný, nepříjemný nebo problematický člověk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otrava",
                                "target_lang_sense_clarification": "otravný člověk"
                            },
                            {
                                "target_lang_word": "osina v zadku",
                                "target_lang_sense_clarification": "nepříjemný člověk, expresivně"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d6d6603-91bc-338c-8b13-b258eb9847f2",
                    "sense_definition": "To form bubbles or blisters, as the skin or a painted surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_blister",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot sun caused the old paint on the deck to <w>blister</w>.",
                            "target_lang_translations": {
                                "cs": "Horké slunce způsobilo, že stará barva na terase začala <w>puchýřovatět</w>."
                            }
                        },
                        {
                            "text": "After a day in the sun without sunscreen, his shoulders began to <w>blister</w>.",
                            "target_lang_translations": {
                                "cs": "Po celém dni na slunci bez opalovacího krému se mu na ramenou začaly <w>dělat puchýře</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Tvořit puchýře nebo bubliny (o kůži, barvě či jiném povrchu)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dělat se puchýře",
                                "target_lang_sense_clarification": "na kůži i nátěru"
                            },
                            {
                                "target_lang_word": "puchýřovatět",
                                "target_lang_sense_clarification": "odborněji, o materiálu či kůži"
                            },
                            {
                                "target_lang_word": "loupat se",
                                "target_lang_sense_clarification": "o barvě tvořící bubliny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94ba1584-6857-36f4-b5d5-34064b202b94",
                    "sense_definition": "To cause blisters to form on the skin or another surface.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_blister",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat from the furnace can easily <w>blister</w> the wooden frames.",
                            "target_lang_translations": {
                                "cs": "Silný žár z pece může na dřevěných rámech snadno <w>způsobit puchýře</w>."
                            }
                        },
                        {
                            "text": "Rowing without gloves for hours will quickly <w>blister</w> your hands.",
                            "target_lang_translations": {
                                "cs": "Když budete hodiny veslovat bez rukavic, rychle vám na rukou <w>naskáčou puchýře</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vesicate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit vznik puchýřů na kůži nebo bublin na jiném povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "způsobit puchýře",
                                "target_lang_sense_clarification": "na kůži"
                            },
                            {
                                "target_lang_word": "napuchýřovat",
                                "target_lang_sense_clarification": "zvednout do bublin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1503e6e4-db78-3ff9-aec1-b3cabc8dbdcb",
                    "sense_definition": "To criticize someone or something intensely and harshly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reviewer took every opportunity to <w>blister</w> the director for the weak plot.",
                            "target_lang_translations": {
                                "cs": "Recenzent využil každou příležitost, aby režiséra za slabý děj pořádně <w>strhal</w>."
                            }
                        },
                        {
                            "text": "Her speech began to <w>blister</w> the opposition over their recent policy changes.",
                            "target_lang_translations": {
                                "cs": "Její projev začal ostře <w>tepat</w> do opozice kvůli jejím nedávným změnám v politice."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ostře, intenzivně a tvrdě zkritizovat někoho nebo něco."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zdrbnout",
                                "target_lang_sense_clarification": "tvrdě zkritizovat"
                            },
                            {
                                "target_lang_word": "strhat",
                                "target_lang_sense_clarification": "např. film či výkon"
                            },
                            {
                                "target_lang_word": "zostudit",
                                "target_lang_sense_clarification": "při kritice"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}