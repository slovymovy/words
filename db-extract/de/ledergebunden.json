                        "form": "es ist ledergebunden"
                    },
                    {
                        "form_id": "8edca16a-160c-44bb-b2ca-8488a11013fe",
                        "entry_id": "dbb1faef-c521-3772-b5eb-d259445a09ee",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind ledergebunden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ec7b742-6894-3e8f-8d73-664f74f996ca",
                        "entry_id": "dbb1faef-c521-3772-b5eb-d259445a09ee",
                        "glosses": [
                            "in Leder gebunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "679382ba-122a-47d9-8c2f-bf7327705b72",
                                "sense_id": "8ec7b742-6894-3e8f-8d73-664f74f996ca",
                                "text": "„Bücherschränke mit Glastüren enthielten ledergebundene Ausgaben von Dickens, Emerson, Thoreau und natürlich Melville.“"
                            },
                            {
                                "example_id": "bf006786-75b6-4a8d-b2a9-f87cd76e7fc0",
                                "sense_id": "8ec7b742-6894-3e8f-8d73-664f74f996ca",
                                "text": "„Gerahmte Diplome und ledergebundene juristische Fachbücher zierten die Wände des Büros.“"
                            },
                            {
                                "example_id": "ba89b6d9-32b2-4dd1-971d-edfff1dadc42",
                                "sense_id": "8ec7b742-6894-3e8f-8d73-664f74f996ca",
                                "text": "„»Parfait«, sagte der Sommelier und legte die ledergebundene Weinkarte auf den Tisch.“"
                            },
                            {
                                "example_id": "2b236ad5-a02e-41d7-8762-2703b0619c30",
                                "sense_id": "8ec7b742-6894-3e8f-8d73-664f74f996ca",
                                "text": "„Er nahm Braithwhites Mitbringsel vom Tresen und überbrachte es Lancaster. Der stellte sein Glas ab, schob die Zigarre zwischen die Lippen und nahm das Buch - einen einzelnen ledergebundenen Band - in beide Hände.“"
                            },
                            {
                                "example_id": "bdcf2912-c606-406e-9029-25e6dd180b86",
                                "sense_id": "8ec7b742-6894-3e8f-8d73-664f74f996ca",
                                "text": "„›Überhaupt glaube ich nicht, dass es jemals ein ledergebundenes Buch gegeben hat, wie du es beschreibst.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
