                "translations": [
                    {
                        "translation_id": "a31f6c1b-c368-4739-a149-13b79b0cb39d",
                        "source_entry_id": "9554437b-0054-3673-8bf3-825f0cd3308e",
                        "target_lang_word": "invitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e8fbbfc-e542-324c-86e2-76d1affabcaf",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "The act of inviting; solicitation; the requesting of a person's company."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8a0be5-ff1d-4df0-ad73-c63d32a691bc",
                                                "sense_id": "3e8fbbfc-e542-324c-86e2-76d1affabcaf",
                                                "text": "an invitation to a party, to a dinner, or to visit a friend"
                                            },
                                            {
                                                "example_id": "3df9fe4d-0e32-448e-9973-a295396129db",
                                                "sense_id": "3e8fbbfc-e542-324c-86e2-76d1affabcaf",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4e0d995-ddda-3539-932d-4997e72d78bb",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "A document or verbal message conveying an invitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db65b92a-ebd3-4ff6-944d-e111cf9d4cb2",
                                                "sense_id": "c4e0d995-ddda-3539-932d-4997e72d78bb",
                                                "text": "We need to print off fifty invitations for the party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e9b326-2c3f-3f1c-b88b-eec992e0b401",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "Allurement; enticement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92d3e307-cd03-39eb-8bdb-3f0dc0777830",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "A line that is intentionally left open to encourage the opponent to attack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a385a878-72ba-3c05-86ac-24126eb36f36",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "The brief exhortation introducing the confession in the Anglican communion-office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7a7c78d-36f3-3c74-b48a-160d2cd0e200",
                                        "entry_id": "809f0bdf-6474-3060-8b5f-fb5252f9fb19",
                                        "glosses": [
                                            "A bid that tells one's partner that game or slam is likely if their hand is at the strong end of what they have indicated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5964b8d1-679b-454a-9b4c-ae3d8d4bca12",
                                                "sense_id": "f7a7c78d-36f3-3c74-b48a-160d2cd0e200",
                                                "text": "I assume also that opener would have shown no interest in slam by either bidding 4NT or 50 after the slam invitation of 46."
                                            },
                                            {
                                                "example_id": "2d0144c0-d914-4513-b5ca-d6b324c3f51b",
                                                "sense_id": "f7a7c78d-36f3-3c74-b48a-160d2cd0e200",
                                                "text": "To any other invitation made by the captain, acceptance or refusal of the invitation is exclusively a question of points within the range advertised in the opening statement, and the invitation is always in the last called suit."
                                            }
                                        ]
                                    }
                                ]
                            }
