                    {
                        "sense_id": "ad8a00bd-a182-3206-9c56-07a0cb8ef9ac",
                        "entry_id": "fce49fed-3afb-30b1-883f-c6cd14072619",
                        "glosses": [
                            "een bedrijf dat halffabricaten levert aan een bedrijf dat daarvan complete producten maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "179437ff-609a-4a1b-80ec-009cc734f791",
                                "sense_id": "ad8a00bd-a182-3206-9c56-07a0cb8ef9ac",
                                "text": "Mariasteen, in 1963 opgestart, is een toeleveringsbedrijf verbonden aan het dienstencentrum Gid(t)s. Als een van de grootste maatwerkbedrijven van Vlaanderen bedient Mariasteen met meer dan achthonderdvijftig medewerkers tal van grote bedrijven en openbare besturen. De organisatie stelt mensen met een arbeidsbeperking te werk."
                            },
                            {
                                "example_id": "7286345c-c4dc-4dcc-bda7-d70d242a4c43",
                                "sense_id": "ad8a00bd-a182-3206-9c56-07a0cb8ef9ac",
                                "text": "De VVD in Almelo voelt ervoor om, na de verkoop van het toeleveringsbedrijf van Cogas Energie, ook het Cogas kabelbedrijf te verkopen. Volgens fractievoorzitter G. van Woudenbergh lijdt het geen twijfel dat er veel geld verdiend kan worden met een eventuele verkoop. Met de opbrengst zou de financiële positie van Almelo versterkt kunnen worden."
                            }
                        ]
                    }
