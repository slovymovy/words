                "senses": [
                    {
                        "sense_id": "7eb60082-5ce9-3b1b-904c-1ae39b448e47",
                        "entry_id": "1f4084c7-d807-31aa-907f-04731b858342",
                        "glosses": [
                            "Infester par des mouches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f1b0019-9c29-4fa0-8ba2-8ff61a3097e1",
                                "sense_id": "7eb60082-5ce9-3b1b-904c-1ae39b448e47",
                                "text": "Les généticiens du Pacte de Varsovie emmouchent les états occidentaux."
                            },
                            {
                                "example_id": "55fce66f-334d-4bcd-a836-a7c1a7366bd2",
                                "sense_id": "7eb60082-5ce9-3b1b-904c-1ae39b448e47",
                                "text": "C'est ce qui s'appelle se faire emmoucher"
                            },
                            {
                                "example_id": "b5549cf2-1498-4aba-b17d-6380e4877a73",
                                "sense_id": "7eb60082-5ce9-3b1b-904c-1ae39b448e47",
                                "text": "Et dire qu'elles voudraient ressembler à celles qui se font emmoucher !"
                            },
                            {
                                "example_id": "eac00fbc-709e-4d48-9757-478923136e24",
                                "sense_id": "7eb60082-5ce9-3b1b-904c-1ae39b448e47",
                                "text": "Moi aussi je veux me faire emmoucher dans l'outback, surfer même si l'eau est froide, voir les 12 apôtres, rencontrer des australiens tout rouges et avoir un van pourri qui déchire!"
                            }
                        ]
                    }
