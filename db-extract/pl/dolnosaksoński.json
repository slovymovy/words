                        ]
                    },
                    {
                        "translation_id": "e73af3f4-7f9e-42b0-8d76-f08ea01059a4",
                        "source_entry_id": "4c33b5bd-f136-383f-bf66-ccc1728b7f49",
                        "source_sense_id": "a7629aff-17fa-3caf-95c5-7833fda2241d",
                        "target_lang_word": "niedersächsisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niedersächsisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f493ecd1-33ac-3346-9619-2cd663016c54",
                                        "entry_id": "108c41d6-a350-3ba2-a3b1-527c339337f4",
                                        "glosses": [
                                            "auf Niedersachsen bezogen, zu ihm gehörig oder aus ihm stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3f1e75e-8a0d-4cc2-aea2-b90860e82cce",
                                                "sense_id": "f493ecd1-33ac-3346-9619-2cd663016c54",
                                                "text": "Die niedersächsische Bevölkerung ist meist sehr freundlich."
                                            },
                                            {
                                                "example_id": "d4e306c4-307c-403f-85da-d101e18096cd",
                                                "sense_id": "f493ecd1-33ac-3346-9619-2cd663016c54",
                                                "text": "„Die niedersächsische Wissenschaftsministerin warf der Universitätsführung und der Vorgängerregierung vor, jahrelang schöngerechnet zu haben und von üblichen Standards abgewichen zu sein, setzte selbst aber auch erst spät eine professionelle Projektsteuerung durch.“"
                                            },
                                            {
                                                "example_id": "4b4f4b88-aa07-4dba-8b4f-a1d9d0d62bdd",
                                                "sense_id": "f493ecd1-33ac-3346-9619-2cd663016c54",
                                                "text": "„Insgesamt durchsuchten die Beamten mit Hilfe von Spezialkräften 16 Wohnungen und Geschäftsräume im Raum Hamburg, ein Objekt in Bremen, eins im niedersächsischen Sittensen und drei in der Altmark.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
