                                    },
                                    {
                                        "sense_id": "91f83bc5-aa57-3c92-8524-6efd4135b879",
                                        "entry_id": "6d8ed0b3-2f38-3c60-afce-3033f4595f14",
                                        "glosses": [
                                            "występować w sposób agresywny przeciw komuś lub czemuś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42ac7b50-8ac9-439b-9e56-94d85324e0b3",
                                                "sense_id": "91f83bc5-aa57-3c92-8524-6efd4135b879",
                                                "text": "Dzieci znajdujące się przy stadzie są całkiem bezpieczne, gdyż nawet tygrys nie ośmieli się zaatakować trzody"
                                            },
                                            {
                                                "example_id": "34b164b0-d206-4388-98dd-f9d5c037f91b",
                                                "sense_id": "91f83bc5-aa57-3c92-8524-6efd4135b879",
                                                "text": "Atakował nas ciągle na zebraniu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "21fea6fd-9548-3ccc-a38f-f14937eef16e",
                                        "entry_id": "6d8ed0b3-2f38-3c60-afce-3033f4595f14",
                                        "glosses": [
                                            "o chorobach: dotyczyć pewnego organu, układu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a8a0482-38b8-4776-b97e-a882fd7fda90",
                                                "sense_id": "21fea6fd-9548-3ccc-a38f-f14937eef16e",
                                                "text": "Cukrzyca bardzo często atakuje układ nerwowy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "4c3fe0d6-788e-3a7f-ae24-6448daf6e8b2",
                                        "entry_id": "6d8ed0b3-2f38-3c60-afce-3033f4595f14",
                                        "glosses": [
                                            "o chorobach, szkodnikach i innych plagach: szerzyć się w określonym środowisku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c6bb4e-316d-4164-8d00-3d040666d3d5",
                                                "sense_id": "4c3fe0d6-788e-3a7f-ae24-6448daf6e8b2",
                                                "text": "Rotawirus atakuje przede wszystkim małe dzieci."
                                            },
                                            {
                                                "example_id": "d33780e3-8ce7-434d-addb-a18bf7f413f3",
                                                "sense_id": "4c3fe0d6-788e-3a7f-ae24-6448daf6e8b2",
                                                "text": "Zima znów atakuje."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "ce8e9a5f-1333-3a2b-8b66-5ea4a2f3df85",
                                        "entry_id": "6d8ed0b3-2f38-3c60-afce-3033f4595f14",
                                        "glosses": [
                                            "działać niszcząco"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "969ab06c-c564-4126-8af0-6f3420fe9ad0",
                                                "sense_id": "ce8e9a5f-1333-3a2b-8b66-5ea4a2f3df85",
                                                "text": "Korozja międzykrystaliczna atakuje stale nierdzewne wzdłuż granic ziaren."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "2baa76ee-9792-33f4-8e0d-9b5d33cf8098",
                                        "entry_id": "6d8ed0b3-2f38-3c60-afce-3033f4595f14",
                                        "glosses": [
                                            "podejmować energiczne działania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de51234-a555-4a06-ab49-dc2ffa9ed333",
                                                "sense_id": "2baa76ee-9792-33f4-8e0d-9b5d33cf8098",
                                                "text": "Anna Rogowska atakuje rekord świata w halowym skoku o tyczce."
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "eaf5ec60-7cf0-3dc2-866d-aff225ba3b63",
                                        "entry_id": "6d8ed0b3-2f38-3c60-afce-3033f4595f14",
                                        "glosses": [
                                            "zwracać się do kogoś"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d78ea956-b0f8-46af-ac62-bc10b0df0efb",
                                                "sense_id": "eaf5ec60-7cf0-3dc2-866d-aff225ba3b63",
                                                "text": "Możesz z tym problemem atakować helpdesk, to w końcu ich praca."
                                            }
                                        ],
                                        "sense_index_json": "\"1.7\""
                                    },
                                    {
                                        "sense_id": "95e29000-ec2b-3c8a-a024-0513181ae53a",
                                        "entry_id": "6d8ed0b3-2f38-3c60-afce-3033f4595f14",
