                "senses": [
                    {
                        "sense_id": "5c5355c3-4048-37d7-94cc-0757257953e1",
                        "entry_id": "cdb0bb2f-5819-300e-ae1c-41813085d3d0",
                        "glosses": [
                            "Donner un caractère arbitraire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b761a6-38a8-4feb-9c2b-37014e32f251",
                                "sense_id": "5c5355c3-4048-37d7-94cc-0757257953e1",
                                "text": "L’exagération est double : soit dans les tentatives des Sprach-wissen-schaft-l-er allemands de motiver la langue par le côté concret de son passé, soit dans les tentatives des linguistes français de l’« arbitrariser » par le côté abstrait de son présent."
                            },
                            {
                                "example_id": "15d0ea3e-5675-4296-a9aa-7215146d98fb",
                                "sense_id": "5c5355c3-4048-37d7-94cc-0757257953e1",
                                "text": "Il marque, au contraire, une coupure explicite, riche de contenu, bien que d’un contenu mutilé, « arbitrarisé », rendu a-signifiant, c’est-à-dire coupé de ses bases syntagmatiques comme de ses attaches paradigmatiques."
                            }
                        ]
                    }
