                        "source_sense_id": "590e953e-fac1-3b30-b32a-0a2b988b4f33",
                        "target_lang_word": "treatment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treatment",
