                    {
                        "translation_id": "e59c5cca-b0ef-4575-a34b-e7b0f81a7327",
                        "source_entry_id": "cb2b5bb6-7b94-3b2e-91b9-83eba909ee0d",
                        "source_sense_id": "808b30a7-e2b2-39ab-8b0f-f98c981a6ef8",
                        "source_sense_description": "winged indehiscent fruit",
                        "target_lang_word": "samare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
