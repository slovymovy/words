                    {
                        "translation_id": "41977198-5c06-433e-90c5-0331aec20968",
                        "source_entry_id": "b3523642-8442-321a-a317-b8e756f85f53",
                        "source_sense_id": "84ad7665-1767-3795-b969-b7186df1e304",
