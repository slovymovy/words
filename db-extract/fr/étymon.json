            {
                "entry_id": "8a04b28b-aace-3082-b847-58836336e641",
                "word": "étymon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1d07eca6-c644-460b-bb20-2a63ea2d1e0f",
                        "entry_id": "8a04b28b-aace-3082-b847-58836336e641",
                        "tags": [
                            "plural"
                        ],
                        "form": "étymons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f93d4658-7ce0-3f2f-9a5c-2132f457219d",
                        "entry_id": "8a04b28b-aace-3082-b847-58836336e641",
                        "glosses": [
                            "Mot le plus ancien à l’origine du mot nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f04c01f7-1697-4f4f-a8e6-d62b676e8bb4",
                                "sense_id": "f93d4658-7ce0-3f2f-9a5c-2132f457219d",
                                "text": "Le latin operari est l’étymon de ouvrer, devenu œuvrer, et de opérer."
                            },
                            {
                                "example_id": "e0e695db-bf34-441b-ab99-8cc4652dcf26",
                                "sense_id": "f93d4658-7ce0-3f2f-9a5c-2132f457219d",
                                "text": "S’il existe un consensus pour rattacher « ironie » à l’étymon eirôneia, les avis divergent quant à la signification du mot grec."
                            },
                            {
                                "example_id": "6cb01cd6-8396-4966-8681-1f15de133cf0",
                                "sense_id": "f93d4658-7ce0-3f2f-9a5c-2132f457219d",
                                "text": "C’est l’époque où l’on commençait à mettre en relation le nom Ingrande, dérivé de l’étymon celtique equoranda, avec le passage d’une frontière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df379e70-43ee-45d9-9467-ada4198c4f19",
                        "source_entry_id": "8a04b28b-aace-3082-b847-58836336e641",
                        "source_sense_id": "f93d4658-7ce0-3f2f-9a5c-2132f457219d",
                        "target_lang_word": "Grundform",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grundform",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7574f60-d133-35a1-bf03-f1913222ceab",
                                        "entry_id": "b6d47c18-d039-3fd3-8c53-abe0d8fbd7b2",
                                        "glosses": [
                                            "ursprüngliche Form"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c772764e-3821-48c5-af6c-879c50bd55ec",
                                                "sense_id": "c7574f60-d133-35a1-bf03-f1913222ceab",
                                                "text": "„Es bezeichne Palingenesia, das griechische Äquivalent von deutsch »Wiedergeburt«, in seiner etymologischen Grundform.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "94b2b094-65f3-32ed-9765-21bbb54580a9",
                                        "entry_id": "b6d47c18-d039-3fd3-8c53-abe0d8fbd7b2",
                                        "glosses": [
                                            "zugrunde liegende Form"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c39f59ee-7990-4603-9070-241d87614ab2",
                                                "sense_id": "94b2b094-65f3-32ed-9765-21bbb54580a9",
                                                "text": "„Dieses Spiel ist eine interessante Variante der Grundform.“"
                                            },
                                            {
                                                "example_id": "58194c8e-05de-4114-bde9-61492c03cad9",
                                                "sense_id": "94b2b094-65f3-32ed-9765-21bbb54580a9",
                                                "text": "„Für die Ordenssterne schneidet man eine Grundform von Pappe und beklebt sie so schön als möglich mit sternförmigen Scheiben von Gold- und farbigem Glanzpapier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "15cf319a-5ac9-3b53-8cd4-45daeb6dd0fd",
                                        "entry_id": "b6d47c18-d039-3fd3-8c53-abe0d8fbd7b2",
                                        "glosses": [
                                            "Ausgangsform eines flektierbaren Wortes im Flexionsparadigma"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f9e5e72-d1ef-4d06-bf6a-68eb1cd210b7",
                                                "sense_id": "15cf319a-5ac9-3b53-8cd4-45daeb6dd0fd",
                                                "text": "„Diejenige Form eines Paradigmas, die nie eine besondere Endung zeigt, also ökonomischerweise »negativ« abgehoben ist, kann man als »Grundform« werten, im Kasussystem etwa die Form des Nominativs (…).“"
                                            },
                                            {
                                                "example_id": "f4efcd78-73c4-4a97-ac27-5813ce15ad4e",
                                                "sense_id": "15cf319a-5ac9-3b53-8cd4-45daeb6dd0fd",
                                                "text": "„Zu entscheiden ist also jeweils, ob die zweisilbige Grundform eine derivationell aktive Einheit enthält, die zu einer internen morphologischen Grenze führt.“"
                                            },
                                            {
                                                "example_id": "34fcd752-c494-48d1-8078-2078a40bc6f0",
                                                "sense_id": "15cf319a-5ac9-3b53-8cd4-45daeb6dd0fd",
                                                "text": "„Als sogenannte Nennform fungiert in der Regel die Grundform, also beispielsweise der Infinitiv bei Verben, der Nominativ Singular bei Substantiven, der Positiv bei Adjektiven.“"
                                            },
                                            {
                                                "example_id": "359fa1a2-6c55-42f8-a9e6-56dd2fb157dc",
                                                "sense_id": "15cf319a-5ac9-3b53-8cd4-45daeb6dd0fd",
                                                "text": "„Der Wortschatz der deutschen Gegenwartssprache wird im Allgemeinen zwischen 300000 und 500000 Wörtern (Grundformen) angesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8ad8d477-f400-3fdb-a24e-d6d847ca4155",
                                        "entry_id": "b6d47c18-d039-3fd3-8c53-abe0d8fbd7b2",
                                        "glosses": [
                                            "Ausgangsform eines Verbs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b1570c0-d948-45d2-891f-ca57c07e2f6f",
                                                "sense_id": "8ad8d477-f400-3fdb-a24e-d6d847ca4155",
                                                "text": "„Als sogenannte Nennform fungiert in der Regel die Grundform, also beispielsweise der Infinitiv bei Verben, der Nominativ Singular bei Substantiven, der Positiv bei Adjektiven.“"
                                            },
                                            {
                                                "example_id": "4f998aed-76f5-497a-8386-e514c391a3ca",
                                                "sense_id": "8ad8d477-f400-3fdb-a24e-d6d847ca4155",
                                                "text": "„Der Wortschatz der deutschen Gegenwartssprache wird im Allgemeinen zwischen 300000 und 500000 Wörtern (Grundformen) angesetzt.“"
                                            },
                                            {
                                                "example_id": "5af3749a-c1cb-434f-a651-13e3c786e005",
                                                "sense_id": "8ad8d477-f400-3fdb-a24e-d6d847ca4155",
                                                "text": "„Ansonsten läßt sich die Grundform des Tätigkeitswortes einfach als Befehlsform verwenden: …“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9caa18ef-9fd6-4dfd-b81e-c71b4263d895",
                        "source_entry_id": "8a04b28b-aace-3082-b847-58836336e641",
                        "source_sense_id": "f93d4658-7ce0-3f2f-9a5c-2132f457219d",
