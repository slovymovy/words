                                        "examples": [
                                            {
                                                "example_id": "e4713fd7-6f46-46ce-a34a-5a56185bc4d4",
                                                "sense_id": "abb4068a-5f00-329d-aa91-9af823996c81",
                                                "text": "He always ate his eggs fried, never scrambled."
