                "senses": [
                    {
                        "sense_id": "f1c31d45-979d-33af-9c31-33bbdd641165",
                        "entry_id": "7893c2f8-cca7-33cd-9159-d439cf4f925a",
                        "glosses": [
                            "Personengruppe, die für die Organisation und Leitung eines Autorennens zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a25aabc5-9a79-44e6-9a41-1791cb4d8abb",
                                "sense_id": "f1c31d45-979d-33af-9c31-33bbdd641165",
                                "text": "„Schon vor dem Qualifying am Vortag hatte die Rennleitung des Automobil-Weltverbands Fia beschlossen, dass das Rennen wie geplant um 15 Uhr Ortszeit gestartet werden sollte.“"
                            },
                            {
                                "example_id": "b8d4ea43-3d10-475e-86ff-c41e2c87c04c",
                                "sense_id": "f1c31d45-979d-33af-9c31-33bbdd641165",
                                "text": "„Sie hatte noch mehr Angst als vorher; es konnte von der Rennleitung sein, über einen Unfall, aber es war ebenfalls von Clerfayt.“"
                            },
                            {
                                "example_id": "a7a65c3b-ae05-4f0c-90bc-7ec4bfd61377",
                                "sense_id": "f1c31d45-979d-33af-9c31-33bbdd641165",
                                "text": "„Eilfertige Funktionäre der Rennleitung kamen und gingen, ihre Listen und Eintragungen ergänzend.“"
                            }
                        ],
