                {
                    "sense_id": "85bb0587-b379-3721-acbb-f35a0d90d050",
                    "sense_definition": "Mettre fin à une relation personnelle, amoureuse ou commerciale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rupture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues querelles, ils ont résolu de <w>cesser</w> définitivement toute relation.",
                            "target_lang_translations": {
                                "en": "After long quarrels, they resolved to <w>end</w> all ties between them for good.",
                                "ru": "После долгих ссор они решили окончательно <w>разорвать</w> всякие отношения.",
                                "nl": "Na lange ruzies hebben ze besloten om alle betrekkingen voorgoed te <w>verbreken</w>.",
                                "de": "Nach langen Streitigkeiten haben sie beschlossen, jegliche Beziehung endgültig zu <w>beenden</w>.",
                                "pl": "Po długich kłótniach postanowili na dobre <w>zerwać</w> wszelkie relacje.",
                                "it": "Dopo lunghi litigi hanno deciso di <w>troncare</w> definitivamente ogni relazione.",
                                "cs": "Po dlouhých hádkách se rozhodli definitivně <w>ukončit</w> veškeré vztahy mezi nimi.",
                                "tr": "Uzun süren tartışmaların ardından aralarındaki her türlü ilişkiyi kesin olarak <w>bitirmeye</w> karar verdiler.",
                                "es": "Tras largas disputas, resolvieron <w>terminar</w> definitivamente toda relación.",
                                "zh": "经过长时间的争吵，他们决定彻底<w>断绝</w>一切关系。"
                            }
                        },
                        {
                            "text": "Après plusieurs retards de livraison, l'entreprise a décidé de <w>cesser</w> toute collaboration avec ce fournisseur.",
                            "target_lang_translations": {
                                "en": "After several delivery delays, the company decided to <w>end</w> all collaboration with this supplier.",
                                "ru": "После нескольких задержек с поставками компания решила <w>прекратить</w> сотрудничество с этим поставщиком.",
                                "nl": "Na meerdere vertragingen bij de levering heeft het bedrijf besloten alle samenwerking met deze leverancier <w>stop</w> te <w>zetten</w>.",
                                "de": "Nach mehreren Lieferverzögerungen hat das Unternehmen beschlossen, die Zusammenarbeit mit diesem Lieferanten <w>einzustellen</w>.",
                                "pl": "Po kilku opóźnieniach w dostawach firma postanowiła <w>zakończyć</w> wszelką współpracę z tym dostawcą.",
                                "it": "Dopo diversi ritardi nelle consegne, l'azienda ha deciso di <w>interrompere</w> ogni collaborazione con questo fornitore.",
                                "cs": "Po několika zpožděních dodávek se firma rozhodla <w>ukončit</w> veškerou spolupráci s tímto dodavatelem.",
                                "tr": "Birkaç teslimat gecikmesinin ardından şirket, bu tedarikçiyle her türlü iş birliğini <w>sonlandırmaya</w> karar verdi.",
                                "es": "Tras varios retrasos en las entregas, la empresa decidió <w>cesar</w> toda colaboración con este proveedor.",
                                "zh": "由于几次交货延误，公司决定与这家供应商<w>结束</w>一切合作。"
                            }
                        }
                    ],
