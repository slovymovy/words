                    {
                        "translation_id": "ef792c30-0285-4db7-9938-c2f6194dde1a",
                        "source_entry_id": "9172a08c-bc0d-32f2-be22-811bfa13423b",
                        "source_sense_id": "7aa769d9-2f07-3db9-b2e3-3abfc81d32df",
