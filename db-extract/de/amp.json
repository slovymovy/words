                                        "sense_id": "85c991c9-e155-3cbb-879f-8bd89be73e09",
                                        "entry_id": "9a5d6f60-1fbb-3c0c-80e3-aec4e33f22f2",
                                        "glosses": [
                                            "To amplify."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "usually",
                                            "with-up"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c34357-e194-484e-ad91-4a97fc4b920d",
                                                "sense_id": "85c991c9-e155-3cbb-879f-8bd89be73e09",
                                                "text": "He asked the disk jockey to amp it up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "101b28b2-e7db-3557-babe-541874e69085",
                                        "entry_id": "9a5d6f60-1fbb-3c0c-80e3-aec4e33f22f2",
                                        "glosses": [
                                            "To excite."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "usually",
                                            "with-up"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75d088d3-c3f6-4cd4-9614-f357bbc0a244",
                                                "sense_id": "101b28b2-e7db-3557-babe-541874e69085",
                                                "text": "Well you're very amped up today, what's got you so excited?"
                                            },
                                            {
                                                "example_id": "77030e27-fa4d-47db-9485-e0ee7430e52a",
                                                "sense_id": "101b28b2-e7db-3557-babe-541874e69085",
                                                "text": "In the distance, the music thumped, amping the crowd higher."
                                            },
                                            {
                                                "example_id": "74c301f4-e300-41e7-ac8c-000b2803008a",
                                                "sense_id": "101b28b2-e7db-3557-babe-541874e69085",
                                                "text": "And it's raining, a little bit of drizzle, but the crowd is amped up and ready for a big event today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "439f889c-d6f4-34ec-8360-ae6b64ce8718",
                                        "entry_id": "9a5d6f60-1fbb-3c0c-80e3-aec4e33f22f2",
                                        "glosses": [
                                            "To intensify or increase."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "usually",
                                            "with-up"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d858cd4-a0b9-440d-83b0-e7b5796a8189",
                                                "sense_id": "439f889c-d6f4-34ec-8360-ae6b64ce8718",
                                                "text": "Amping the Justin Timberlake cameos and revving up Jiggytron 5000, these Peas want to be on Middle America's fickle plate — losing little dread-whippin' imaginativeness in the wizzash."
                                            },
                                            {
                                                "example_id": "31b03cf2-b9a2-4d21-b992-d1108e22f4fd",
                                                "sense_id": "439f889c-d6f4-34ec-8360-ae6b64ce8718",
                                                "text": "2014, Andy Paul, Amp Up Your Sales, AMACOM Books"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bade398-53fb-3028-94b7-8db40902f27e",
                                        "entry_id": "9a5d6f60-1fbb-3c0c-80e3-aec4e33f22f2",
                                        "glosses": [
                                            "To connect to amplifiers."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "usually",
                                            "with-up"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3d0e9c-30f6-47bd-9708-da6c1e60683a",
                                                "sense_id": "7bade398-53fb-3028-94b7-8db40902f27e",
                                                "text": "and even the Velvet Underground were still only amping up conventional instruments"
                                            }
                                        ]
                                    }
                                ]
                            }
