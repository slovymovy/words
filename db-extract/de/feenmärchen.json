                "senses": [
                    {
                        "sense_id": "4a66c2dc-6147-3cec-a594-175ddd224631",
                        "entry_id": "ef105263-25df-3dcd-87ba-5c4f989dce8b",
                        "glosses": [
                            "Märchen, in dem gute und/oder böse Feen eine Rolle spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "316bd0c2-859f-4129-9280-bc9ed03bb555",
                                "sense_id": "4a66c2dc-6147-3cec-a594-175ddd224631",
                                "text": "„Dieser Kampf zwischen guten und bösen Feen bildet in der Regel den Inhalt der Feenmärchen, die, meist orientalischen Ursprungs, im letzten Viertel des 17. Jahrhunderts in Europa an die Tagesordnung kamen und namentlich in Frankreich seit 1681 beliebt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96d8a7e6-ec48-4f26-92d6-ad27801bcc50",
                        "source_entry_id": "ef105263-25df-3dcd-87ba-5c4f989dce8b",
                        "source_sense_id": "4a66c2dc-6147-3cec-a594-175ddd224631",
                        "source_sense_description": "Literatur: Märchen, in dem gute und/oder böse Feen eine Rolle spielen",
                        "target_lang_word": "fairy tale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fairy tale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5249cbe1-0c04-342c-a7c0-882c78854c94",
                                        "entry_id": "7c2b235c-9d44-30f1-867b-d104f349e4b7",
                                        "glosses": [
                                            "A folktale or literary story featuring fairies or similar fantasy characters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27f0f434-1ea9-4d7e-97b5-797c4c897ab3",
                                                "sense_id": "5249cbe1-0c04-342c-a7c0-882c78854c94",
                                                "text": "I used to love reading fairy tales when I was a child."
                                            },
                                            {
                                                "example_id": "388331c8-b211-403c-a4d8-d65fd2c7224d",
                                                "sense_id": "5249cbe1-0c04-342c-a7c0-882c78854c94",
                                                "text": "The Wife of Bathes Tale is evidently a Fairy-tale. It thus commences: In olde dayes of the king Artour, / Of which that Bretons speken gret honour, / All was this land fulfilled of faerie."
                                            },
                                            {
                                                "example_id": "99f0739e-f2eb-4393-b3e5-3a27e1b433b8",
                                                "sense_id": "5249cbe1-0c04-342c-a7c0-882c78854c94",
                                                "text": "The Arabian Nights rehears'd in bed! / The Fairy Tales in school-time read."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae16a890-6610-32c8-9aa4-c2d1612fffb9",
                                        "entry_id": "7c2b235c-9d44-30f1-867b-d104f349e4b7",
                                        "glosses": [
                                            "The literary genre of these stories."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a4afda4-4b97-4aeb-9c01-8227d91c1be2",
                                                "sense_id": "ae16a890-6610-32c8-9aa4-c2d1612fffb9",
                                                "text": "Their dresses were rich, and when they came bounding forward, their shapes of silver tissue, with their feathered diadems and faces of animated beauty, they might be imagined into scarcely less than the creations of fairy tale."
                                            },
                                            {
                                                "example_id": "cf918547-8a03-4d4a-88e7-a7751906af8a",
                                                "sense_id": "ae16a890-6610-32c8-9aa4-c2d1612fffb9",
                                                "text": "Mr. Shimerda kneels in front of the tree in prayer; a praying figure under a magic tree is a common one in fairy tale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec85b314-46ab-3df0-a76d-68fd9c3f53f7",
                                        "entry_id": "7c2b235c-9d44-30f1-867b-d104f349e4b7",
                                        "glosses": [
                                            "A story presented as true that is not believable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4dff712-96c5-44ce-9958-1c898536b03e",
                                                "sense_id": "ec85b314-46ab-3df0-a76d-68fd9c3f53f7",
                                                "text": "He's telling us another fairy tale about how great the software will be."
                                            },
                                            {
                                                "example_id": "5895ec9d-739f-4443-947e-dbf7339b4c59",
                                                "sense_id": "ec85b314-46ab-3df0-a76d-68fd9c3f53f7",
                                                "text": "If emigrants will submit to the \"fairy tales\" of Mr. Thomas, and fall in with his suggestions, they must patiently submit to the disagreeable consequences."
                                            },
                                            {
                                                "example_id": "87b7aab7-e81e-4f6f-8bc5-21a66f5eb41f",
                                                "sense_id": "ec85b314-46ab-3df0-a76d-68fd9c3f53f7",
                                                "text": "Comedy as satire is acceptable, as fun it is a pleasant haven of escape, but the fairy tale of happiness ever after cannot be taken seriously; it belongs to the never-never land of childhood, which is protected from the realities that will become terribly known soon enough[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471eaf86-fd3a-34d6-997a-2d7ccb9912c8",
                                        "entry_id": "7c2b235c-9d44-30f1-867b-d104f349e4b7",
                                        "glosses": [
                                            "A delightful and ideal situation of a kind attained by very few."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57342547-2caf-40a6-9cb0-083e72c877c1",
                                                "sense_id": "471eaf86-fd3a-34d6-997a-2d7ccb9912c8",
                                                "text": "I've been living in a fairy tale since I met Joe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
