                    {
                        "translation_id": "d91b01fa-8c3a-4f50-ab0f-0b65311551dc",
                        "source_entry_id": "7cb72f93-17a5-303d-bfb1-70da50cf94f4",
                        "source_sense_id": "e032b4f8-530d-3fcc-8767-556c8731d1ae",
                        "target_lang_word": "dreist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "956890eb-d534-34c9-8a8c-046af133254d",
                                        "entry_id": "088ffb91-d2e7-3740-b991-f94f37024aba",
                                        "glosses": [
                                            "ohne Respekt, ohne Zurückhaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2754d4d3-dbc9-430a-8890-5b563b6c3f0c",
                                                "sense_id": "956890eb-d534-34c9-8a8c-046af133254d",
                                                "text": "Ganz schön dreist, der Bursche."
                                            },
                                            {
                                                "example_id": "bc44a18b-8883-4cba-8450-e2422d87b215",
                                                "sense_id": "956890eb-d534-34c9-8a8c-046af133254d",
                                                "text": "„Nein, er gefällt mir nicht, der neue Bürgermeister.“ / „Nun, da er's ist, wird er nur täglich dreister.“ („Osterspaziergang“; J. W. Goethe, Faust I)"
                                            },
                                            {
                                                "example_id": "8043b28e-68e5-4e02-a9c6-ddaef77037f4",
                                                "sense_id": "956890eb-d534-34c9-8a8c-046af133254d",
                                                "text": "„Seine millionenschweren Manipulationen werteten die Staatsanwälte in ihrem Plädoyer jedenfalls nicht als organisierte Kriminalität, sondern als dreistes Bubenstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b54b1b8-dd83-42a3-b9a5-d450558af8a3",
                        "source_entry_id": "7cb72f93-17a5-303d-bfb1-70da50cf94f4",
                        "source_sense_id": "e032b4f8-530d-3fcc-8767-556c8731d1ae",
                        "target_lang_word": "unverschämt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverschämt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                        "entry_id": "5555604c-9737-31c1-b457-9b365d68e045",
                                        "glosses": [
                                            "im Verhalten und in den Äußerungen provozierend und/oder auch aggressiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ed7b73-5f57-4a55-bec4-b3e8a90509a7",
                                                "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                                "text": "Das ist ein unverschämter Angriff gegen die gesamte Stadt und schadet dem Wirtschaftsstandort Köln."
                                            },
                                            {
                                                "example_id": "6c99ab81-7937-4449-a687-2d8f7466c46d",
                                                "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                                "text": "Werd bloß nicht unverschämt!"
                                            },
                                            {
                                                "example_id": "1ed31b8e-29d1-44c8-b75d-b3276225d134",
                                                "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                                "text": "„In Amerika hingegen ist der Depp in unverschämter Weise stolz auf seine Dummheit, so sehr, dass er letztlich zum Führer politischer Diskurse und ideologisch dominanter Fraktionen einer ganzen Partei werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                        "entry_id": "5555604c-9737-31c1-b457-9b365d68e045",
                                        "glosses": [
                                            "verstärkend, betonend, hervorhebend: über ein übliches Maß hinausgehend, sehr groß/intensiv; übermäßig, überaus, sehr, allzu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd7a2d6-2586-4599-8066-9224531c146d",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "Du hast unverschämt viel Glück."
                                            },
                                            {
                                                "example_id": "8bf8e22c-7313-4158-8364-2eceeddea44e",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "Das ist unverschämt teuer."
                                            },
                                            {
                                                "example_id": "0bf63e29-b186-462f-a7ec-2f70ce13228b",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "Du siehst unverschämt gut aus."
                                            },
                                            {
                                                "example_id": "a7ebf312-1331-46f0-ada2-8b8d8d6c2cf0",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "„Die fragmentierende, auch unverschämt komische, halsbrecherisch Töne und Themen konfrontierende Technik Hemons verstärkt seinen kräftigen Appell, den der Muslim Rora ausspricht: Diesseits des Bildes zu bleiben.“"
                                            },
                                            {
                                                "example_id": "5c329984-6c78-4066-adcf-04e58b2e51df",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "»Da haben Sie unverschämtes Glück gehabt, dass mein Kollege die Dame oder Sie offenbar kennt!«"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d5cc8e94-23e9-369f-8c66-918ffd29d37c",
                                        "entry_id": "5555604c-9737-31c1-b457-9b365d68e045",
                                        "glosses": [
                                            "sich sittlich und moralisch nicht gesellschaftskonform verhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c023cd-9827-4ea8-b1ea-fd9331d9f129",
                                                "sense_id": "d5cc8e94-23e9-369f-8c66-918ffd29d37c",
                                                "text": "Dieses Mädchen zeigt sich unverschämt, es schämt sich nicht im geringsten mit der Entblößung ihres Busens und ihrer Waden."
                                            },
                                            {
                                                "example_id": "6aa4b863-7f60-44d8-a631-79ecda53f036",
                                                "sense_id": "d5cc8e94-23e9-369f-8c66-918ffd29d37c",
                                                "text": "Das Fräulein ist eine verwöhnte und unverschämte Göre, die allen schöne Augen macht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
