{
    "word_family": [
        "racjonować",
        "racjonalny",
        "racjonalizować",
        "racjonalizm"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed4de88e-86e7-3e12-ae45-caa17eded54b",
                    "sense_definition": "Stan zgodności z prawdą, faktami lub rzeczywistością; słuszność czyjegoś sądu, opinii lub postępowania.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "truth_logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę przyznać ci <w>rację</w>, to był świetny pomysł.",
                            "target_lang_translations": {
                                "ru": "Я должен признать твою <w>правоту</w>, это была отличная идея.",
                                "en": "I have to admit you were <w>right</w>, that was a great idea.",
                                "zh": "我不得不承认你很<w>有道理</w>，这确实是个好主意。"
                            }
                        },
                        {
                            "text": "Nauczyciel miał <w>rację</w>, mówiąc, że ten egzamin będzie trudny.",
                            "target_lang_translations": {
                                "ru": "Учитель был <w>прав</w>, говоря, что этот экзамен будет трудным.",
                                "en": "The teacher was <w>right</w> when he said that this exam would be difficult.",
                                "zh": "老师说得<w>没错</w>，这场考试确实会很难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "słuszność"
                    ],
                    "common_phrases": [
                        "mieć rację",
                        "przyznać rację",
                        "mieć świętą rację"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние соответствия истине, фактам или действительности; правильность чьего-либо суждения или поступка.",
                        "en": "The state of being right, correct, or justified; conformity with truth or facts.",
                        "zh": "符合事实或真理；某人的判断、看法或做法的正确性、有理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правота",
                                "target_lang_sense_clarification": "правильность действий или мыслей"
                            },
                            {
                                "target_lang_word": "правда",
                                "target_lang_sense_clarification": "разговорное выражение согласия с чьей-то правотой"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "point",
                                "target_lang_sense_clarification": "valid reason or correctness in an argument"
                            },
                            {
                                "target_lang_word": "being right",
                                "target_lang_sense_clarification": "correctness of judgment or opinion"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "道理",
                                "target_lang_sense_clarification": "指合乎情理或正确"
                            },
                            {
                                "target_lang_word": "对",
                                "target_lang_sense_clarification": "正确、有理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64a47328-8f89-35c7-9e0a-afa12a058dee",
                    "sense_definition": "Przyczyna, powód lub uzasadnienie jakiegoś zdarzenia, stanu rzeczy lub decyzji.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "causality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z <w>racji</w> pełnionego stanowiska, dyrektor musiał podjąć tę trudną decyzję.",
                            "target_lang_translations": {
                                "ru": "По <w>причине</w> занимаемой должности директор должен был принять это трудное решение.",
                                "en": "By <w>virtue</w> of his position, the director had to make this difficult decision.",
                                "zh": "出于职位的<w>原因</w>，主任不得不做出这个艰难的决定。"
                            }
                        },
                        {
                            "text": "Sklep był zamknięty z <w>racji</w> trwającego remontu.",
                            "target_lang_translations": {
                                "ru": "Магазин был закрыт по <w>причине</w> идущего ремонта.",
                                "en": "The shop was closed on <w>account</w> of ongoing renovations.",
                                "zh": "这家店<w>因为</w>正在装修而暂停营业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "powód",
                        "przyczyna"
                    ],
                    "common_phrases": [
                        "z racji tego",
                        "bez żadnej racji",
                        "z racji wieku"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formalny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причина, повод или обоснование какого-либо события, состояния или решения.",
                        "en": "Cause, reason, or grounds for a situation, event, or decision.",
                        "zh": "某事、某种状态或决定的原因、理由或依据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причина",
                                "target_lang_sense_clarification": "основание для чего-либо"
                            },
                            {
                                "target_lang_word": "основание",
                                "target_lang_sense_clarification": "обоснование"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "reason",
                                "target_lang_sense_clarification": "cause or justification"
                            },
                            {
                                "target_lang_word": "account",
                                "target_lang_sense_clarification": "grounds or cause, as in 'on account of'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理由",
                                "target_lang_sense_clarification": "事情的根据或缘由"
                            },
                            {
                                "target_lang_word": "原因",
                                "target_lang_sense_clarification": "引起某种结果的事情"
                            },
                            {
                                "target_lang_word": "因为",
                                "target_lang_sense_clarification": "表示原因或理由（介词/连词用法）"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0a2871e-9df3-33e9-8aae-17bbcafbc53c",
                    "sense_definition": "Argument, dowód lub stanowisko przedstawiane w dyskusji w celu przekonania kogoś.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "truth_logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sędzia wysłuchał uważnie <w>racji</w> obu stron przed wydaniem wyroku.",
                            "target_lang_translations": {
                                "ru": "Судья внимательно выслушал <w>доводы</w> обеих сторон перед вынесением приговора.",
                                "en": "The judge carefully listened to the <w>arguments</w> of both sides before delivering the verdict.",
                                "zh": "法官在宣判前仔细听取了双方的<w>理由</w>。"
                            }
                        },
                        {
                            "text": "Twoje <w>racje</w> są logiczne, ale emocje mówią mi coś innego.",
                            "target_lang_translations": {
                                "ru": "Твои <w>доводы</w> логичны, но эмоции говорят мне другое.",
                                "en": "Your <w>points</w> are logical, but my emotions tell me otherwise.",
                                "zh": "你的<w>论据</w>合乎逻辑，但我的直觉却告诉我另一回事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "argument"
                    ],
                    "common_phrases": [
                        "wymiana racji",
                        "przedstawić swoje racje",
                        "zważyć racje"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аргумент, довод или позиция, представляемые в дискуссии для убеждения кого-либо.",
                        "en": "An argument, reasoning, or position put forward in a discussion to convince someone.",
                        "zh": "讨论或辩论中为说服他人而提出的论据、理由或观点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "довод",
                                "target_lang_sense_clarification": "аргумент в споре"
                            },
                            {
                                "target_lang_word": "аргумент",
                                "target_lang_sense_clarification": "логическое обоснование"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "argument",
                                "target_lang_sense_clarification": "reasoning or claim in a discussion"
                            },
                            {
                                "target_lang_word": "point",
                                "target_lang_sense_clarification": "valid argument or contention"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理由",
                                "target_lang_sense_clarification": "辩解或说明的依据"
                            },
                            {
                                "target_lang_word": "论据",
                                "target_lang_sense_clarification": "用来证明论点的根据"
                            },
                            {
                                "target_lang_word": "道理",
                                "target_lang_sense_clarification": "辩论中的论点或情理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bdc7fa4-3e46-31fa-a0ba-ea2e3a489b7f",
                    "sense_definition": "Wyznaczona ilość żywności lub innej substancji, przysługująca danej osobie na określony czas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food_portion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Żołnierze otrzymali suchą <w>rację</w> żywnościową na czas misji w terenie.",
                            "target_lang_translations": {
                                "ru": "Солдаты получили сухой <w>паёк</w> на время полевой миссии.",
                                "en": "The soldiers received a dry food <w>ration</w> for the duration of the field mission.",
                                "zh": "士兵们领到了用于野外任务的干<w>口粮</w>。"
                            }
                        },
                        {
                            "text": "W trudnych czasach każda dzienna <w>racja</w> chleba była na wagę złota.",
                            "target_lang_translations": {
                                "ru": "В трудные времена каждая дневная <w>порция</w> хлеба была на вес золота.",
                                "en": "In hard times, each daily <w>ration</w> of bread was worth its weight in gold.",
                                "zh": "在艰苦岁月里，每天配给的一<w>份</w>面包都珍贵如金。"
                            }
                        }
                    ],
                    "synonyms": [
                        "porcja"
                    ],
                    "common_phrases": [
                        "racja żywnościowa",
                        "żelazna racja",
                        "dzienna racja"
                    ],
                    "target_lang_definitions": {
                        "ru": "Установленное количество еды или другой субстанции, полагающееся человеку на определенное время.",
                        "en": "A fixed portion of food or other provision allotted to a person for a specific period.",
                        "zh": "配给个人在特定时间内享用的一定数量的食物或其他物资。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паёк",
                                "target_lang_sense_clarification": "выданное продовольствие"
                            },
                            {
                                "target_lang_word": "рацион",
                                "target_lang_sense_clarification": "состав и количество пищи"
                            },
                            {
                                "target_lang_word": "порция",
                                "target_lang_sense_clarification": "часть еды"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "ration",
                                "target_lang_sense_clarification": "allotted portion of food or supplies"
                            },
                            {
                                "target_lang_word": "portion",
                                "target_lang_sense_clarification": "allocated amount"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口粮",
                                "target_lang_sense_clarification": "配给的口粮或食物"
                            },
                            {
                                "target_lang_word": "配给量",
                                "target_lang_sense_clarification": "定额分配的份额"
                            },
                            {
                                "target_lang_word": "份",
                                "target_lang_sense_clarification": "定量的食物份数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2faa22f1-4c38-3a49-b9c0-bbb00fde18ac",
                    "sense_definition": "Nadrzędny interes państwa lub grupy społecznej, ważniejszy od interesu jednostki.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Politycy często powołują się na <w>rację</w> stanu, podejmując kontrowersyjne decyzje.",
                            "target_lang_translations": {
                                "ru": "Политики часто ссылаются на государственные <w>интересы</w>, принимая спорные решения.",
                                "en": "Politicians often cite the national <w>interest</w> when making controversial decisions.",
                                "zh": "政客们在做出争议性决定时，往往会诉诸<w>国家利益</w>。"
                            }
                        },
                        {
                            "text": "W tym przypadku polska <w>racja</w> stanu wymagała zawarcia kompromisu.",
                            "target_lang_translations": {
                                "ru": "В данном случае польские государственные <w>интересы</w> требовали компромисса.",
                                "en": "In this case, the Polish <w>reason of state</w> required reaching a compromise.",
                                "zh": "在这种情况下，波兰的<w>国家利益</w>要求做出妥协。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interes",
                        "sprawa"
                    ],
                    "common_phrases": [
                        "racja stanu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высший интерес государства или социальной группы, стоящий выше интересов отдельной личности.",
                        "en": "The overriding political interest or fundamental welfare of a state or society.",
                        "zh": "国家或社会群体的最高利益，高于个人利益。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интерес",
                                "target_lang_sense_clarification": "в контексте 'государственный интерес'"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "national interest",
                                "target_lang_sense_clarification": "the goals and ambitions of a state"
                            },
                            {
                                "target_lang_word": "reason of state",
                                "target_lang_sense_clarification": "formal justification for government actions"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "国家利益",
                                "target_lang_sense_clarification": "国家层面的根本利益（racja stanu）"
                            },
                            {
                                "target_lang_word": "利益",
                                "target_lang_sense_clarification": "宏观或政治层面的益处"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "33ce3b9b-c03d-3dfa-871a-7d3e1aadc0a3",
                    "sense_definition": "Słowo używane do wyrażenia zgody z rozmówcą lub potwierdzenia słuszności jego wypowiedzi.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "truth_logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Racja</w>, zapomniałem całkowicie o naszym dzisiejszym spotkaniu.",
                            "target_lang_translations": {
                                "ru": "<w>Верно</w>, я совсем забыл о нашей сегодняшней встрече.",
                                "en": "<w>True</w>, I completely forgot about our meeting today.",
                                "zh": "<w>确实</w>，我完全忘了我们今天的碰面。"
                            }
                        },
                        {
                            "text": "Oczywiście, <w>racja</w>, zrobimy to dokładnie tak, jak proponujesz.",
                            "target_lang_translations": {
                                "ru": "Конечно, <w>ты прав</w>, сделаем именно так, как ты предлагаешь.",
                                "en": "Of course, <w>right</w>, we'll do it exactly as you suggest.",
                                "zh": "当然，<w>没错</w>，我们就完全按照你的建议来做。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "święta racja",
                        "twoja racja"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, используемое для выражения согласия с собеседником или подтверждения правильности его слов.",
                        "en": "An exclamation used to express agreement or confirm that someone is correct.",
                        "zh": "用于表示赞同对方或确认其说法正确的应答语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верно",
                                "target_lang_sense_clarification": "выражение согласия"
                            },
                            {
                                "target_lang_word": "правда",
                                "target_lang_sense_clarification": "подтверждение истинности"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "true",
                                "target_lang_sense_clarification": "expressing agreement"
                            },
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "affirming someone's statement"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没错",
                                "target_lang_sense_clarification": "表示赞同对方的观点"
                            },
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "赞同对方的说法"
                            },
                            {
                                "target_lang_word": "对",
                                "target_lang_sense_clarification": "简短的赞同表达"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}