                {
                    "sense_id": "eed6321e-13c1-3b23-bc25-dfa7224f8d40",
                    "sense_definition": "Trouble caractérisé par une absence involontaire de sommeil ou des difficultés persistantes à s'endormir et à rester endormi.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "trouble_du_sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis plusieurs semaines, elle souffre d'<w>insomnie</w> à cause de la pression au travail."
                        },
                        {
                            "text": "Le médecin lui a conseillé de faire du sport pour lutter contre son <w>insomnie</w> chronique."
                        }
                    ],
                    "antonyms": [
                        "hypersomnie"
                    ],
                    "common_phrases": [
                        "insomnie chronique",
                        "souffrir d'insomnie"
                    ]
                },
                {
                    "sense_id": "125c2e90-d8a9-340a-a4fe-ba63f15cea84",
                    "sense_definition": "Nuit ou épisode nocturne passé sans dormir en raison de ce trouble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trouble_du_sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir bu un grand café tard le soir, il a fait une <w>insomnie</w> complète."
                        },
                        {
                            "text": "Elle a passé une nuit d'<w>insomnie</w> à tourner dans son lit sans trouver le repos."
                        }
                    ],
                    "synonyms": [
                        "nuit blanche"
                    ],
                    "common_phrases": [
                        "faire une insomnie",
                        "nuit d'insomnie"
                    ]
                },
                {
                    "sense_id": "815acfd6-0a28-3cae-b5eb-2b2b3d773977",
                    "sense_definition": "Nuit passée éveillé de manière délibérée, souvent pour travailler, étudier ou veiller.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "etat_de_veille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant a dû consacrer une semaine d'<w>insomnies</w> à la préparation de ses concours."
                        },
                        {
                            "text": "Ces longues <w>insomnies</w> d'écriture lui ont permis de terminer son roman à temps."
