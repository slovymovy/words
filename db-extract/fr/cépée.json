        "fr-extract.jsonl": [
            {
                "entry_id": "9cfd21a8-5354-34a4-87ee-42cc8fbfb8b7",
                "word": "cépée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e2d5a03f-2b69-4865-9e32-3324a2798a4e",
                        "entry_id": "9cfd21a8-5354-34a4-87ee-42cc8fbfb8b7",
                        "tags": [
                            "plural"
                        ],
                        "form": "cépées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7466dcf0-40c6-3746-bbfb-50c6848a6717",
                        "entry_id": "9cfd21a8-5354-34a4-87ee-42cc8fbfb8b7",
                        "glosses": [
                            "Touffe de plusieurs tiges de bois qui sortent d’une même souche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d89e8a-75ac-4668-9750-b46f87333937",
                                "sense_id": "7466dcf0-40c6-3746-bbfb-50c6848a6717",
                                "text": "Il aimait aussi voir passer les chevrettes, derrière les cépées, et bondir les écureuils, la queue en l’air, au bout des pins..."
                            },
                            {
                                "example_id": "90b263d0-7989-4eea-81a4-bddcf81513d9",
                                "sense_id": "7466dcf0-40c6-3746-bbfb-50c6848a6717",
                                "text": "Par une belle nuit d’été elle pouvait très bien coucher en plein air, à l’abri d’un arbre ou d’une cépée."
                            },
                            {
                                "example_id": "f3e775ea-6dc4-4cb3-bd06-e3b944884f66",
                                "sense_id": "7466dcf0-40c6-3746-bbfb-50c6848a6717",
                                "text": "[…] ; il se rendit auprès du monoplan brisé, subtilisa la trousse et la cacha dans une cépée."
                            },
                            {
                                "example_id": "dd4d1f21-eedf-47a3-a320-d003ddf2ddb7",
                                "sense_id": "7466dcf0-40c6-3746-bbfb-50c6848a6717",
                                "text": "La brume s'effaçait, se résolvait en une buée plus légère, chaude... Les bois s'égouttaient de l'humidité cotonneuse, remplissant les cépées de frênes d'une eau sombre où venaient tomber les toutes premières feuilles mortes."
                            },
                            {
                                "example_id": "2a8821a8-c096-4ca2-9a14-e717f9b3348d",
                                "sense_id": "7466dcf0-40c6-3746-bbfb-50c6848a6717",
                                "text": "Les brins qui atteignent le houppier des chênes et le concurrencent concourent à freiner leur accroissement (ils peuvent, soit empêcher le développement du houppier, soit le faire régresser en faisant mourir des branches) ; aussi, les plus gros brins de chaque cépée doivent être coupés progressivement."
                            }
                        ]
                    },
                    {
                        "sense_id": "627229a8-84d5-3fea-b719-72b503d1d141",
                        "entry_id": "9cfd21a8-5354-34a4-87ee-42cc8fbfb8b7",
                        "glosses": [
                            "Cette souche elle-même."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "82c79dbe-6682-382a-9111-f111c8351973",
                        "entry_id": "9cfd21a8-5354-34a4-87ee-42cc8fbfb8b7",
                        "glosses": [
                            "Terrain qui en est couvert."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "cf20ff9c-108c-47aa-bebd-237bd7bc4efe",
                                "sense_id": "82c79dbe-6682-382a-9111-f111c8351973",
                                "text": "Toute cette végétation disparaît peu à peu devant l'envahissement des cépées de plus en plus touffues."
                            },
                            {
                                "example_id": "0656a759-d7c3-4517-a876-80b89c522df1",
                                "sense_id": "82c79dbe-6682-382a-9111-f111c8351973",
                                "text": "Arsène s'oriente au travers des cépées et se met à courir, tantôt dans un layon, tantôt dans une piste de sangliers."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc9de99a-9c6e-37cb-bd89-393c7c73f436",
                        "entry_id": "9cfd21a8-5354-34a4-87ee-42cc8fbfb8b7",
                        "glosses": [
                            "Terrain couvert de buissons"
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a76fba5c-3e43-3df0-9347-aaf6d0591cf0",
                        "entry_id": "9cfd21a8-5354-34a4-87ee-42cc8fbfb8b7",
                        "glosses": [
                            "Jeune bois d’un à deux ans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "311249ef-3845-4a66-bd17-bbbce0f6d45a",
                                "sense_id": "a76fba5c-3e43-3df0-9347-aaf6d0591cf0",
                                "text": "La neige avait repris depuis longtemps et elle tombait toujours avec la même persistance ; d’heure en heure on voyait la couche qu’elle formait sur le sol monter le long des jeunes cépées, dont les tiges seules émergeaient encore de la marée blanche, qui allait bientôt les engloutir."
                            },
                            {
                                "example_id": "daa1e745-4104-46f9-b6d0-028d3612af34",
                                "sense_id": "a76fba5c-3e43-3df0-9347-aaf6d0591cf0",
                                "text": "Les grands arbres que la coupe du sous-bois avait isolés, se courbaient, leurs tiges se tordaient, et des branches mortes tombaient partout avec des bruits sourds, écrasant les jeunes cépées."
                            }
                        ]
                    }
                ],
