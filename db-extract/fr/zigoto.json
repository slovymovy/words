                            {
                                "example_id": "3b20c978-58ee-41c0-bfd4-f396b0d0ca8e",
                                "sense_id": "0a7071f1-7733-3bc9-972f-54a4538304a6",
                                "text": "Ce Carlos est un drôle de zigoto.",
                                "translation": "Die Carlos is een rare snuiter."
                            }
                        ]
