                ],
                "senses": [
                    {
                        "sense_id": "499394a4-ead9-3ead-89d7-cdab0298f2fe",
                        "entry_id": "4bbfaff4-87dd-30fa-bd92-00772bef034b",
                        "glosses": [
                            "Catégorie générique, mot dont le sens présente l’ensemble des sèmes communs aux différentes unités d’une même série lexicale, comme par exemple [SIÈGE] pour « pouf », « tabouret » et « fauteuil », etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dda5ebd-5fd6-4fec-bdf5-d9c1fad295cb",
                                "sense_id": "499394a4-ead9-3ead-89d7-cdab0298f2fe",
                                "text": "Nous considérons qu’il existe un archilexème qui englobe les proverbes et les termes connexes : la parémie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1ed5998-f44c-4ede-ab26-d8e074ab8ec0",
                        "source_entry_id": "4bbfaff4-87dd-30fa-bd92-00772bef034b",
                        "source_sense_id": "499394a4-ead9-3ead-89d7-cdab0298f2fe",
                        "target_lang_word": "Hyperonym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hyperonym",
