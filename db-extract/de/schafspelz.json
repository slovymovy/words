                "senses": [
                    {
                        "sense_id": "e582d1ed-8a7e-3518-8ed9-b41fb14e3a74",
                        "entry_id": "dc61ddb7-5f02-3b6d-821c-dde3835d1777",
                        "glosses": [
                            "Pelz aus Schafswolle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a80314-442e-41ab-b14f-ae06279e88c3",
                                "sense_id": "e582d1ed-8a7e-3518-8ed9-b41fb14e3a74",
                                "text": "„Schliesslich setzte der Reisende sich in einem abgetragenen, mit Nanking überzogenen Schafspelz, Filzstiefel an den mageren, knochigen Beinen, auf den Diwan, legte seinen sehr grossen, an den Schläfen auffallend breiten, kurzgeschorenen Kopf gegen die Lehne und sah jetzt Besuchow an.“"
                            },
                            {
                                "example_id": "de861b66-d9db-48ce-a1de-26928136198d",
                                "sense_id": "e582d1ed-8a7e-3518-8ed9-b41fb14e3a74",
                                "text": "„Da ist einer in einem jugoslawischen Schafspelz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
