                "entry_id": "50853b6c-96c2-3e70-b517-5c7e2ac5b979",
                "word": "lignite",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "af3982f3-576e-49eb-bc24-10b737fdc580",
                        "entry_id": "50853b6c-96c2-3e70-b517-5c7e2ac5b979",
                        "tags": [
                            "plural"
                        ],
                        "form": "lignites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "477533f3-6cbf-3dfe-b0b9-b4c6fe47a75d",
                        "entry_id": "50853b6c-96c2-3e70-b517-5c7e2ac5b979",
                        "glosses": [
                            "A low-grade, brownish-black coal."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a29e1363-71d3-4b26-b4f1-20ccf1fb3f17",
                                "sense_id": "477533f3-6cbf-3dfe-b0b9-b4c6fe47a75d",
                                "text": "Texas industry is turning to lignite, a kind of poor man's coal, to replace its dwindling allocations of natural gas. The Lone Star State now gets an estimated 12 percent of its electricity from lignite, and that figure is expected to double by 1985."
                            },
                            {
                                "example_id": "80b72c0f-483a-4fa2-97d1-196e321d46b0",
                                "sense_id": "477533f3-6cbf-3dfe-b0b9-b4c6fe47a75d",
                                "text": "[Robert] Habeck, who has found himself in the extremely uncomfortable position of turning from a long-term campaigner against fossil fuels to a short-term defender of them, said: “Putin’s war of aggression is forcing us to temporarily make greater use of lignite so that we save gas in electricity generation. This is painful but necessary in view of the shortage of gas.”"
                            }
                        ]
                    }
                ],
