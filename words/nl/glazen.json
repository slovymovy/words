                    "examples": [
                        {
                            "text": "Er stond een mooie <w>glazen</w> vaas op de tafel.",
                            "target_lang_translations": {
                                "en": "There was a beautiful <w>glass</w> vase on the table.",
                                "ru": "На столе стояла красивая <w>стеклянная</w> ваза.",
                                "fr": "Il y avait un beau vase <w>en verre</w> sur la table.",
                                "pl": "Na stole stał piękny <w>szklany</w> wazon.",
                                "de": "Es stand eine schöne <w>gläserne</w> Vase auf dem Tisch.",
                                "it": "C'era un bel vaso <w>di vetro</w> sul tavolo.",
                                "cs": "Na stole stála krásná <w>skleněná</w> váza.",
                                "tr": "Masada güzel bir <w>cam</w> vazo duruyordu.",
                                "es": "Había un hermoso florero <w>de vidrio</w> sobre la mesa.",
                                "zh": "桌上放着一个漂亮的<w>玻璃</w>花瓶。"
                            }
                        },
                        {
                            "text": "Voorzichtig zette hij het <w>glazen</w> beeldje terug in de kast.",
                            "target_lang_translations": {
                                "en": "He carefully put the <w>glass</w> figurine back in the cupboard.",
                                "ru": "Он осторожно поставил <w>стеклянную</w> статуэтку обратно в шкаф.",
                                "fr": "Il a remis prudemment la statuette <w>en verre</w> dans l'armoire.",
                                "pl": "Ostrożnie odstawił <w>szklaną</w> figurkę do szafki.",
                                "de": "Vorsichtig stellte er die <w>gläserne</w> Figur zurück in den Schrank.",
                                "it": "Rimise con cautela la statuetta <w>di vetro</w> nell'armadietto.",
                                "cs": "Opatrně vrátil <w>skleněnou</w> sošku zpět do skříně.",
                                "tr": "Dikkatlice <w>cam</w> heykelciği dolaba geri koydu.",
                                "es": "Colocó con cuidado la estatuilla <w>de vidrio</w> de vuelta en el armario.",
                                "zh": "他小心翼翼地把<w>玻璃</w>小雕像放回柜子里。"
