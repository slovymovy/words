                        "glosses": [
                            "The sound of a kiss, to indicate blowing a kiss to someone."
                        ],
                        "tags": [
                            "Internet",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "a0250f8b-65aa-42e1-8581-afd2c95cc9f3",
                                "sense_id": "270259f2-ca8d-3936-be30-3721078df6ff",
                                "text": "Thanks guys. 3 kisses for you all: mwah mwah mwah!"
                            },
                            {
                                "example_id": "aed04691-0ea4-46e2-817e-5390df6e454e",
                                "sense_id": "270259f2-ca8d-3936-be30-3721078df6ff",
                                "text": "'Cause he looks like how Bayboy draws Sam the dog / With the beard I can sink my lips into like mwah"
                            }
                        ]
                    }
