                        ],
                        "examples": [
                            {
                                "example_id": "3cb8562a-fb09-4633-a5d0-f59a62a7eb2a",
                                "sense_id": "00d4d327-210e-3395-bf0d-1e01dfde0d2b",
                                "text": "J’ai décanté l’alcohol, j’ai fait sécher la chaux dans une étuve, et quand elle a été refroidie, j’ai versé dessus 24 grammes d’eau."
                            },
                            {
                                "example_id": "1b375a86-b398-4fa0-9975-dc4994c078b2",
                                "sense_id": "00d4d327-210e-3395-bf0d-1e01dfde0d2b",
                                "text": "L'acide acétique se forme dans beaucoup de circonstances ; mais, considéré œnologiquement, il est toujours le produit d'une décomposition de l’alcohol."
                            }
                        ]
