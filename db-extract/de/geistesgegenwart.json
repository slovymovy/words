                        ],
                        "form": "die Geistesgegenwart"
                    },
                    {
                        "form_id": "43910ad1-e2b0-4ec5-b090-9ff9ef61687b",
                        "entry_id": "ed507786-18ef-3cef-ad32-7bc53153b333",
                        "tags": [
