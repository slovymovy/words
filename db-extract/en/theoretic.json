                                        "entry_id": "608dcd38-bf68-353f-b219-b539c5b58b1a",
                                        "glosses": [
                                            "Qui a trait ou qui vise à la connaissance conceptuelle, au savoir, ou à la théorie, non à l’action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "théorétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ed9e56c-1fa7-3783-bcaf-c28582466630",
                                        "entry_id": "0c34c94b-3af8-349e-b010-1077feb19a49",
                                        "glosses": [
                                            "Une des trois divisions de la philosophie selon Aristote, qui renferme la physique, la mathématique et la théologie. Cette théorie de la connaissance renonce aux considérations ontologiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adeab9ae-f5b4-4823-9e15-3334dbee55fa",
                                                "sense_id": "4ed9e56c-1fa7-3783-bcaf-c28582466630",
                                                "text": "La théorétique s’oppose à deux autres parties de la philosophie : pratique, et poïétique. La pratique se divise en économique, éthique et politique ; la poïétique comprend toutes les activités qui produisent une œuvre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1deea63a-9d95-4f72-9801-b2c52b9d5d19",
                        "source_entry_id": "489d75e7-c34a-385e-ab3e-875c720334d9",
                        "source_sense_description": "concerned with theories or hypotheses",
                        "target_lang_word": "theoretisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theoretisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "502710cd-04ae-3301-9f84-4180fd7344a5",
                                        "entry_id": "d1a5526b-58bc-3f02-ac75-2bf15a61be7d",
                                        "glosses": [
                                            "auf eine Theorie bezogen, in der Art und Weise einer Theorie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bde18f6-8939-4253-9ac2-687281cc25cc",
                                                "sense_id": "502710cd-04ae-3301-9f84-4180fd7344a5",
                                                "text": "„Damit soll theoretisch bewiesen worden sein, dass diese Technologie als Basis für noch leistungsfähigere Kommunikationsnetze einsetzbar ist.“"
                                            },
                                            {
                                                "example_id": "294d6a1b-2f51-4ab6-9a3c-a1848ffb4ed3",
                                                "sense_id": "502710cd-04ae-3301-9f84-4180fd7344a5",
                                                "text": "„Theoretischer geht es bei der Plattdeutsch-Prüfung und der Ostfrieslandkunde zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
