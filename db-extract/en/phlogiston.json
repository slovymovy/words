                    },
                    {
                        "translation_id": "02f4a2e8-906b-43d1-b161-13fc6ace8772",
                        "source_entry_id": "a75a431d-d884-3da7-be78-ed87bc8a55b9",
                        "source_sense_id": "4f4e5476-b9f5-37d2-a9c1-1cf0b0f744ec",
                        "source_sense_description": "hypothetical fiery principle",
                        "target_lang_word": "Phlogiston",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phlogiston",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a543448-64d4-331a-9c1e-c83a7a303c16",
                                        "entry_id": "aed1c1cb-df11-3bb6-b4db-da5bcbb94b18",
                                        "glosses": [
                                            "Substanz, die beim Verbrennen von brennbaren Körpern entweicht"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed724a94-00e6-4ed5-8629-656343ab4524",
                                                "sense_id": "6a543448-64d4-331a-9c1e-c83a7a303c16",
                                                "text": "„Humboldt verschränkte die Arme. Erstens, die Sonne brenne nicht aus, sie erneuere ihr Phlogiston und werde in Ewigkeit scheinen.“"
                                            },
                                            {
                                                "example_id": "fdf48714-443d-406f-a4fe-d30deefb53d7",
                                                "sense_id": "6a543448-64d4-331a-9c1e-c83a7a303c16",
                                                "text": "„Auch diese Theorie erklärt vieles, zum Beispiel warum die Flammen so schön nach oben züngeln - eben weil der Brennstoff entweicht, der in der Fachsprache Phlogiston (Betonung erste Silbe) heißt.“"
                                            },
                                            {
                                                "example_id": "781d88d3-9a8a-4085-b18f-c4c75482c38f",
                                                "sense_id": "6a543448-64d4-331a-9c1e-c83a7a303c16",
                                                "text": "„Wer in dieses Weltbild eintaucht, für den erschließt sich sofort: Eisen besteht aus Rost und Phlogiston. Wenn es zerfällt, wird Phlogiston frei und Rost bleibt übrig.“"
                                            },
                                            {
                                                "example_id": "8443e32d-b327-4c43-9db8-a757ba8878e0",
                                                "sense_id": "6a543448-64d4-331a-9c1e-c83a7a303c16",
                                                "text": "[Über Atmen und Verbrennen:] „Und weiter führt er aus: Wie gut Luft sich zum Atmen eigne, das hänge ja davon ab, wie bereitwillig sie das ausgeatmete Phlogiston aufnehme. Und diese neu entdeckte Art Luft sei nun ganz außerordentlich begierig nach Phlogiston. Aus einem glimmenden Holzspan habe sie es geradezu herausgesaugt - der sei sofort aufgeflammt, weil so viel Phlogiston frei geworden sei.“"
                                            },
                                            {
                                                "example_id": "d59b5015-0dc7-4079-91a8-ad3577b2d824",
                                                "sense_id": "6a543448-64d4-331a-9c1e-c83a7a303c16",
                                                "text": "[…] „Priestleys neue Luft konnte man problemlos auffangen, doch mit Phlogiston gelang das nicht, trotz zahlloser Versuche.“"
                                            },
                                            {
                                                "example_id": "80819ea6-1b9d-49bf-b6b9-ba3e158ce513",
                                                "sense_id": "6a543448-64d4-331a-9c1e-c83a7a303c16",
                                                "text": "„Außerdem fiel auf, dass Stoffe beim Verbrennen schwerer werden, obwohl ja vermeintlich Phlogiston entweicht.“"
                                            },
                                            {
                                                "example_id": "1036ea09-e440-4f09-aa85-58016c5e825c",
                                                "sense_id": "6a543448-64d4-331a-9c1e-c83a7a303c16",
                                                "text": "„Drei Jahre nach Priestleys Experiment formulierte der Franzose Antoine Lavoisier dann eine revolutionäre Theorie, die sich durchgesetzt hat: Phlogiston gibt es nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
