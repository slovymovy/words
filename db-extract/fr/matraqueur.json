                    {
                        "form_id": "6da3529b-b45f-467d-821a-9896ee1e8fce",
                        "entry_id": "afceaa73-9d87-3b3f-885a-9eacc0c768b9",
                        "tags": [
                            "feminine"
                        ],
                        "form": "matraqueuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e32cd5b-60ce-362e-a3c4-9c8f2a3080c2",
                        "entry_id": "afceaa73-9d87-3b3f-885a-9eacc0c768b9",
                        "glosses": [
                            "Personne qui matraque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b103ac7b-47b5-4d38-84c0-4c054a7438a3",
                                "sense_id": "3e32cd5b-60ce-362e-a3c4-9c8f2a3080c2",
                                "text": "Le matraqueur accusa nettement le coup et poussa un rugissement de douleur."
                            },
                            {
                                "example_id": "39d88920-fb75-4f84-9b0d-3b0512b054d4",
                                "sense_id": "3e32cd5b-60ce-362e-a3c4-9c8f2a3080c2",
                                "text": "Ils ne sont pas des hommes selon notre espèce et notre règle, et le seul espoir est placé dans les mitrailleuses de la guerre civile, mais voici qu'il faut penser que ces déchets humains, ces matraqueurs casqués aux joues rouges, font le même travail que les purs et vénérables penseurs auprès de qui nous avons grandi."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ea02059-0700-3fc5-ac85-20c0ab604aca",
                        "entry_id": "afceaa73-9d87-3b3f-885a-9eacc0c768b9",
                        "glosses": [
                            "Attaquant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3b9a617c-922b-4442-987c-68b09ca1f94a",
                                "sense_id": "1ea02059-0700-3fc5-ac85-20c0ab604aca",
                                "text": "Jusqu'à ce que l'arbitre, un vendu, envoie les matraqueurs se calmer sur la touche."
                            }
                        ]
                    }
                ],
