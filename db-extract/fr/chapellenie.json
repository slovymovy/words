                        "glosses": [
                            "Bénéfice d’un chapelain ; titre de chapelain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0962a505-aae1-41cc-976a-628e632e1809",
                                "sense_id": "f9709651-d8bf-33ab-8326-bf1c30d98e14",
                                "text": "Il venait de Saint-Amand où, pendant deux ans, il avait été titulaire de la chapellenie Notre-Dame dans l’église paroissiale : sorte de sinécure, d’ailleurs peu payée, qui n’obligeait qu’à célébrer les quelques messes prévues par le fondateur."
                            },
                            {
                                "example_id": "4a3ed2eb-e64d-42f4-9dd8-7ed21c688717",
                                "sense_id": "f9709651-d8bf-33ab-8326-bf1c30d98e14",
                                "text": "On peut citer à ce sujet le duc de Médinacéli, qui pouvait certainement placer en canonicats, cures, provendes, chapellenies, aumôneries, etc., plus de mille sujets, plusieurs de ces bénéfices n’exigeant point que les titulaires fussent prêtres."
                            }
                        ]
                    }
