                                    {
                                        "sense_id": "23a33df6-5ee7-32da-8833-b6a487645656",
                                        "entry_id": "43183faf-fdf4-3de3-88e8-0c99f3dde8fc",
                                        "glosses": [
                                            "aus der getrockneten Rotalge Chondrus crispus gewonnener Rohstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49220dd-4e2f-4958-a198-1dc160114ea3",
                                                "sense_id": "23a33df6-5ee7-32da-8833-b6a487645656",
                                                "text": "„Das wichtigste Algenprodukt ist das aus Rotalgen gewonnene Carrageen.“"
                                            },
                                            {
                                                "example_id": "afe3953f-b5b1-4c7c-87ef-f9be26730801",
                                                "sense_id": "23a33df6-5ee7-32da-8833-b6a487645656",
                                                "text": "„Carrageen ist ein Gemisch unverzweigter Polysaccharide, die aus teilweise sulfatveresterten D-Galactose- und 3,6-Dehydrogalactoseresten bestehen.“"
                                            }
                                        ],
