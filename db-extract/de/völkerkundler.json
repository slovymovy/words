                        "entry_id": "1e0fe9d8-4754-3b41-b203-c08536100c2d",
                        "glosses": [
                            "Wissenschaftler, der sich mit Völkerkunde befasst"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "30f3e554-07d7-4df0-ba84-e0b5b81918cf",
                                "sense_id": "943d3980-06df-307d-8b07-46fcc58bf7fa",
                                "text": "„Es geschah in Oklahoma, denn dorthin führt mich meine Arbeit als Völkerkundler und Erforscher der indianischen Kultur regelmäßig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
