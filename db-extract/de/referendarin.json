                ],
                "senses": [
                    {
                        "sense_id": "80147455-d4e9-3dcf-a8d4-b0bc9adafe16",
                        "entry_id": "8da360b7-6f3b-3cdb-b685-e29c15bfcef1",
                        "glosses": [
                            "Beamtenanwärterin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cafc652-1f2c-436e-9ac0-9f15d18916eb",
                                "sense_id": "80147455-d4e9-3dcf-a8d4-b0bc9adafe16",
                                "text": "„Umso eindrucksvoller ist das Traktat, mit dem Caroline Heinrich ihre Zeit als Referendarin aufarbeitet - und dabei von der Sprechakttheorie bis zur Philosophie Kants, Foucaults und Baudrillards schwerste philosophische Geschütze auffährt.“"
                            },
                            {
                                "example_id": "e65ae2ba-cf28-470f-9e0b-6bd83add113a",
                                "sense_id": "80147455-d4e9-3dcf-a8d4-b0bc9adafe16",
                                "text": "„Die Referendarin beobachtete den Auftritt eines Richters, notierte seine Arroganz, die wohlgesetzten Worte, die Melodie der Selbstherrlichkeit hinter den Worten.“"
                            },
                            {
                                "example_id": "17d6d2da-b39b-4af5-8cb3-9f9979dea38f",
                                "sense_id": "80147455-d4e9-3dcf-a8d4-b0bc9adafe16",
                                "text": "„Die Referendarin – damals 29 Jahre alt – wollte, dass das Verfahren gegen sie eingestellt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
