                    }
                ],
                "senses": [
                    {
                        "sense_id": "920509b2-3c85-32b7-b833-06da73463013",
                        "entry_id": "57bf7917-9bab-3fa4-8818-87c9fda96927",
                        "glosses": [
                            "To give unending life to, to make immortal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf50d96f-4fd8-4963-b6cb-2993269cee68",
                                "sense_id": "920509b2-3c85-32b7-b833-06da73463013",
                                "text": "The meek intelligence of thoſe dear eyes / (Bleſt be the art that can immortalize, / The art that baffles time's tyrannic claim / To quench it) here ſhines on me ſtill the ſame."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c85299a-9524-31cf-b72b-f961a2909e21",
                        "entry_id": "57bf7917-9bab-3fa4-8818-87c9fda96927",
                        "glosses": [
                            "To make eternally famous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a9e607-b869-45f5-ad99-52d20ce55969",
                                "sense_id": "4c85299a-9524-31cf-b72b-f961a2909e21",
                                "text": "His heroic deeds were immortalised in song and tale."
                            },
                            {
                                "example_id": "aab65d49-bb42-4851-824a-b32498566d3e",
                                "sense_id": "4c85299a-9524-31cf-b72b-f961a2909e21",
                                "text": "There is a local rhyme which says:\nCulbone, Oare and Stoke Pero\nAre three such places as you seldom hear o'.\nStoke Pero and Culbone are equally remote hamlets, respectively 5 miles south-east and 2½ miles east of Oare, a village of which few would have heard had not Blackmore [(R. D. Blackmore)] immortalised it."
                            },
                            {
                                "example_id": "47114b93-4e01-4c5d-9ef5-9b56f2310c80",
                                "sense_id": "4c85299a-9524-31cf-b72b-f961a2909e21",
                                "text": "The clocks at either end of the stadium had just ticked past 92 minutes when Branislav Ivanovic made the run that will immortalise him in Chelsea's history."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f8bf35b-679b-469f-a6e6-4ed2e34ab6db",
                        "source_entry_id": "57bf7917-9bab-3fa4-8818-87c9fda96927",
                        "source_sense_description": "to give unending life to",
                        "target_lang_word": "immortaliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immortaliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a21fd8d-8539-36f4-9891-31de7f489dc6",
                                        "entry_id": "5b673e79-d43a-3b96-874e-cf57281f48d4",
                                        "glosses": [
                                            "Rendre immortel."
                                        ],
                                        "tags": [
                                            "literally",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb0e5cd9-02f5-461b-aec4-a8691c3dad30",
                                                "sense_id": "8a21fd8d-8539-36f4-9891-31de7f489dc6",
                                                "text": "Certains alchimistes se vantaient d’avoir trouvé des moyens pour rajeunir ou immortaliser le corps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "745677dd-55f3-306e-9118-bd0cebb2d4ea",
                                        "entry_id": "5b673e79-d43a-3b96-874e-cf57281f48d4",
                                        "glosses": [
                                            "Rendre immortel dans la mémoire collective."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ff447c4-5e52-4732-b48b-9b4a7356a104",
                                                "sense_id": "745677dd-55f3-306e-9118-bd0cebb2d4ea",
                                                "text": "C’est la fontaine que M. de Florian a immortalisée, en faisant passer sur ses bords la première scène de son roman de Claudine."
                                            },
                                            {
                                                "example_id": "f044b361-9d23-4c09-9d7f-33f55abbee72",
                                                "sense_id": "745677dd-55f3-306e-9118-bd0cebb2d4ea",
                                                "text": "Victor prit son téléphone, shoota quelques objets, son canapé, sa psyché, son tapis de course et, depuis son balcon en saillie, il immortalisa la ville repoussant la lumière qui l’orangeait."
                                            },
                                            {
                                                "example_id": "aada79b1-aee6-4ab5-a6a5-2dbeabf8d887",
                                                "sense_id": "745677dd-55f3-306e-9118-bd0cebb2d4ea",
                                                "text": "Mais cette sonate née d’un songe luciférien, qui serait immortalisé par Goethe, avait le génie de certaines forces du mal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
