                                "target_senses": [
                                    {
                                        "sense_id": "8cbf72c1-afd8-392b-9d40-3a046847f93d",
                                        "entry_id": "dd5c7502-a0ff-35c9-bacb-22020187884f",
                                        "glosses": [
                                            "A person to whom a debt is owed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e5f6e7-9268-4278-926a-cc1e6b42975a",
                                                "sense_id": "8cbf72c1-afd8-392b-9d40-3a046847f93d",
                                                "text": "The creditor demanded immediate payment."
                                            },
                                            {
                                                "example_id": "0b4365de-f41b-4e22-bded-dabf8deaeb91",
                                                "sense_id": "8cbf72c1-afd8-392b-9d40-3a046847f93d",
                                                "text": "She met with her creditors to negotiate the debt."
                                            },
                                            {
                                                "example_id": "9f193497-4b94-4c29-b1b3-048e4da7d84c",
                                                "sense_id": "8cbf72c1-afd8-392b-9d40-3a046847f93d",
                                                "text": "The creditor took legal action against the bankrupt company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eea7df45-3fea-35e2-a410-b11455099653",
                                        "entry_id": "dd5c7502-a0ff-35c9-bacb-22020187884f",
                                        "glosses": [
                                            "One who gives credence to something; a believer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eddca866-b0a0-478d-9bb5-997cd602be7f",
                        "source_entry_id": "491e30a4-3456-3436-9e51-79fec9ab22c2",
                        "source_sense_id": "4a2c2c1f-44ed-394a-a5fd-7d7db130b611",
                        "target_lang_word": "lender",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5b49381-0f8f-3a95-8422-b416f26b968c",
                                        "entry_id": "70430b20-7c0d-3cb4-9d2f-b6ba6e52db77",
                                        "glosses": [
                                            "One who lends, especially money; specifically, a bank or other entity that specializes in granting loans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddfa1ae9-cc9b-437a-b09c-43a986ade09f",
                                                "sense_id": "d5b49381-0f8f-3a95-8422-b416f26b968c",
                                                "text": "[Polonius]: Neither a borrower nor a lender be:\nFor loan oft loses both itself and friend;\nAnd borrowing dulls the edge of husbandry."
                                            },
                                            {
                                                "example_id": "c34b2921-734b-4fa8-94ce-d4dc7bf85555",
                                                "sense_id": "d5b49381-0f8f-3a95-8422-b416f26b968c",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91e483b5-7e25-4bb4-8f7a-414bd46035b5",
                        "source_entry_id": "491e30a4-3456-3436-9e51-79fec9ab22c2",
                        "source_sense_id": "4a2c2c1f-44ed-394a-a5fd-7d7db130b611",
