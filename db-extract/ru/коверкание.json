                    }
                ],
                "senses": [
                    {
                        "sense_id": "b828bbb8-94e6-3aa7-bf62-347944ec3f66",
                        "entry_id": "5a85a083-e41f-35c8-af5c-481776c1bf3b",
                        "glosses": [
                            "действие по значению гл. коверкать; невольное или преднамеренное искажение произношения, написания или смысла высказывания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69ebff73-7932-4320-9561-84ff56a7a41c",
                                "sense_id": "b828bbb8-94e6-3aa7-bf62-347944ec3f66",
                                "text": "А коверкание языка применительно к носителю этого языка, это проявление неуважения и оскорбление и языка и его носителя."
                            }
                        ]
                    },
                    {
                        "sense_id": "acc02cf6-962c-3b3e-b5ce-64d0072b3285",
                        "entry_id": "5a85a083-e41f-35c8-af5c-481776c1bf3b",
                        "glosses": [
                            "порча, искажение, уродование чего-либо не имеющего прямого отношения к языку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79ff1ec-c178-4dda-82e9-3f15623e764c",
                                "sense_id": "acc02cf6-962c-3b3e-b5ce-64d0072b3285",
                                "text": "Коверкание цвета и коверкание диапазона яркости."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64a0c2e0-d895-4f88-9910-40806fb00a35",
                        "source_entry_id": "5a85a083-e41f-35c8-af5c-481776c1bf3b",
                        "source_sense_description": "речи, текста и т. п.",
                        "target_lang_word": "distortion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distortion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c32f96b-7964-3259-b92a-2c759a6e9871",
                                        "entry_id": "ade8c729-fd91-3f8b-a2b8-59f0dbad5c1e",
                                        "glosses": [
                                            "An act of distorting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2669dfb3-ebfa-3a15-95cb-7eacfe7e534e",
                                        "entry_id": "ade8c729-fd91-3f8b-a2b8-59f0dbad5c1e",
                                        "glosses": [
                                            "A result of distorting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1f07c1d-1639-38f8-b386-eef911bbf39e",
                                        "entry_id": "ade8c729-fd91-3f8b-a2b8-59f0dbad5c1e",
                                        "glosses": [
                                            "A misrepresentation of the truth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da74df58-ae7c-4a0d-973a-84ed7e9d989b",
                                                "sense_id": "f1f07c1d-1639-38f8-b386-eef911bbf39e",
                                                "text": "The story he told was a bit of a distortion."
                                            },
                                            {
                                                "example_id": "98a6e5c5-f794-4617-b8de-3502cdb9d2d1",
                                                "sense_id": "f1f07c1d-1639-38f8-b386-eef911bbf39e",
                                                "text": "The conscious mind refuses to admit any failure to perceive, and puts in its place a series of rationalisations which are fabrications and distortions of the real nature of things."
                                            },
                                            {
                                                "example_id": "f7eef325-7b2b-4219-84c6-473c570ad3ea",
                                                "sense_id": "f1f07c1d-1639-38f8-b386-eef911bbf39e",
                                                "text": "Remembering is an act of re-creation and therefore subject to distortion and fictionalization: 'real' memories become tales, and tales become 'memories'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "402712a1-aa54-3e64-bf6e-41460328beed",
                                        "entry_id": "ade8c729-fd91-3f8b-a2b8-59f0dbad5c1e",
                                        "glosses": [
                                            "Noise or other artifacts caused in the electronic reproduction of sound or music."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbc205de-6749-4a11-9263-48d3866f7692",
                                                "sense_id": "402712a1-aa54-3e64-bf6e-41460328beed",
                                                "text": "This recording sounds awful due to the distortion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa3c6b9-0e1c-3385-a0c1-b004a6204f23",
                                        "entry_id": "ade8c729-fd91-3f8b-a2b8-59f0dbad5c1e",
                                        "glosses": [
                                            "An effect used in music, most commonly on guitars in rock or metal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cb38ac8-7a2d-35d4-b9ee-6f7e6d06f0cb",
                                        "entry_id": "ade8c729-fd91-3f8b-a2b8-59f0dbad5c1e",
                                        "glosses": [
                                            "An aberration that causes magnification to change over the field of view."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
