{
    "word_family": [
        "slyly",
        "slyness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6a521ba0-c145-3e9b-be6e-83c371b5237d",
                    "sense_definition": "Artfully cunning, wily, or secretly mischievous in a way that hides one's true intentions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cunning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sly</w> fox managed to steal the chicken without waking up the farm dog.",
                            "target_lang_translations": {
                                "ru": "<w>Хитрому</w> лису удалось украсть курицу, не разбудив фермерскую собаку."
                            }
                        },
                        {
                            "text": "He gave her a <w>sly</w> smile, suggesting that he knew more than he was letting on.",
                            "target_lang_translations": {
                                "ru": "Он <w>лукаво</w> улыбнулся ей, давая понять, что знает больше, чем говорит."
                            }
                        }
                    ],
                    "synonyms": [
                        "artful",
                        "crafty",
                        "cunning",
                        "shrewd",
                        "wily"
                    ],
                    "antonyms": [
                        "honest",
                        "naive",
                        "straightforward"
                    ],
                    "common_phrases": [
                        "sly smile",
                        "sly grin",
                        "sly as a fox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусно хитрый, коварный или скрытно озорной, скрывающий свои истинные намерения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитрый",
                                "target_lang_sense_clarification": "проявляющий хитрость"
                            },
                            {
                                "target_lang_word": "лукавый",
                                "target_lang_sense_clarification": "игриво хитрый или коварный"
                            },
                            {
                                "target_lang_word": "коварный",
                                "target_lang_sense_clarification": "злонамеренно хитрый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afdb10a8-6ecc-3f85-a68f-4fca48e343ae",
                    "sense_definition": "Performed or marked by clever secrecy or subtle deception to avoid being noticed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cunning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician performed a <w>sly</w> trick that left the entire audience wondering how he did it.",
                            "target_lang_translations": {
                                "ru": "Иллюзионист проделал <w>хитрый</w> трюк, заставивший всю аудиторию гадать, как он это сделал."
                            }
                        },
                        {
                            "text": "She made a <w>sly</w> comment about his new haircut that only a few people understood.",
                            "target_lang_translations": {
                                "ru": "Она сделала <w>тонкое</w> замечание по поводу его новой стрижки, которое поняли лишь немногие."
                            }
                        }
                    ],
                    "synonyms": [
                        "shifty",
                        "knowing",
                        "sharp"
                    ],
                    "antonyms": [
                        "obvious",
                        "overt"
                    ],
                    "common_phrases": [
                        "sly trick",
                        "sly glance",
                        "sly wink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполненный или характеризующийся умной секретностью или тонким обманом, чтобы избежать внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрытный",
                                "target_lang_sense_clarification": "сделанный тайком"
                            },
                            {
                                "target_lang_word": "хитрый",
                                "target_lang_sense_clarification": "содержащий скрытый смысл"
                            },
                            {
                                "target_lang_word": "искусный",
                                "target_lang_sense_clarification": "тонко выполненный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b20583e-8026-3df1-a607-70069e4f1ac6",
                    "sense_definition": "Skillful or dexterous in acting so as to escape observation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "skillful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pickpocket was <w>sly</w> enough to remove the wallet without the owner feeling a thing.",
                            "target_lang_translations": {
                                "ru": "Карманник был достаточно <w>ловким</w>, чтобы вытащить кошелек так, что владелец ничего не почувствовал."
                            }
                        },
                        {
                            "text": "With <w>sly</w> movements, the cat crept through the tall grass toward the unsuspecting bird.",
                            "target_lang_translations": {
                                "ru": "<w>Незаметными</w> движениями кошка пробиралась сквозь высокую траву к ничего не подозревающей птице."
                            }
                        }
                    ],
                    "synonyms": [
                        "nimble",
                        "skillful"
                    ],
                    "antonyms": [
                        "clumsy",
                        "awkward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умелый или ловкий в действиях, позволяющих избежать наблюдения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловкий",
                                "target_lang_sense_clarification": "быстрый и незаметный"
                            },
                            {
                                "target_lang_word": "пронырливый",
                                "target_lang_sense_clarification": "умеющий действовать скрытно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94920de0-6f47-3032-8f35-7e3638f25617",
                    "sense_definition": "Delicate, thin, or slight in nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "delicate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fabric had a <w>sly</w> texture that felt almost like a second skin.",
                            "target_lang_translations": {
                                "ru": "Ткань имела <w>тонкую</w> текстуру, которая ощущалась почти как вторая кожа."
                            }
                        },
                        {
                            "text": "A <w>sly</w> breeze blew through the window, barely moving the curtains.",
                            "target_lang_translations": {
                                "ru": "<w>Легкий</w> ветерок подул в окно, едва шевеля занавески."
                            }
                        }
                    ],
                    "synonyms": [
                        "slim"
                    ],
                    "antonyms": [
                        "thick",
                        "heavy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нежный, тонкий или незначительный по своей природе (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "едва заметный"
                            },
                            {
                                "target_lang_word": "легкий",
                                "target_lang_sense_clarification": "незначительный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c0a30f01-37c8-3379-9969-d61cd5f2f962",
                    "sense_definition": "In a manner that is <w>sly</w>; secretly or cunningly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked at her <w>sly</w> and winked before leaving the room.",
                            "target_lang_translations": {
                                "ru": "Он <w>хитро</w> посмотрел на нее и подмигнул, прежде чем выйти из комнаты."
                            }
                        },
                        {
                            "text": "The fox crept <w>sly</w> along the fence, hoping to remain unseen.",
                            "target_lang_translations": {
                                "ru": "Лис <w>украдкой</w> крался вдоль забора, надеясь остаться незамеченным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often replaced by the adverb 'slyly' in formal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хитро или скрытно (наречное использование)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитро",
                                "target_lang_sense_clarification": "с хитростью"
                            },
                            {
                                "target_lang_word": "украдкой",
                                "target_lang_sense_clarification": "незаметно для других"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fa61b8bd-a5ce-3c72-a7b7-c02978798178",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author Christopher <w>Sly</w> is a character mentioned in the induction of Shakespeare's play.",
                            "target_lang_translations": {
                                "ru": "Автор Кристофер <w>Слай</w> — персонаж, упоминаемый во вступлении к пьесе Шекспира."
                            }
                        },
                        {
                            "text": "We invited the <w>Sly</w> family over for dinner last weekend.",
                            "target_lang_translations": {
                                "ru": "В прошлые выходные мы пригласили семью <w>Слай</w> на ужин."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Слай",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2964ed3-ef85-3138-8c59-150de04295b4",
                    "sense_definition": "A diminutive of the male given name <w>Sylvester</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "His friends called him <w>Sly</w> instead of using his full name, Sylvester.",
                            "target_lang_translations": {
                                "ru": "Друзья называли его <w>Слай</w> вместо полного имени Сильвестр."
                            }
                        },
                        {
                            "text": "<w>Sly</w> Stallone is a famous actor known for his action movies.",
                            "target_lang_translations": {
                                "ru": "<w>Слай</w> Сталлоне — знаменитый актер, известный своими боевиками."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a nickname."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма мужского имени Сильвестр."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Слай",
                                "target_lang_sense_clarification": "уменьшительное имя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}