                "senses": [
                    {
                        "sense_id": "62df3b97-427e-336a-94a1-974cbb61c96b",
                        "entry_id": "b4c4cd3b-a769-31f9-8e3c-bf651b9152f7",
                        "glosses": [
                            "Betätigungsform, die auf Spannung und Erlebnissteigerung ausgerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62717cd5-e811-4934-9cd4-399df79d7649",
                                "sense_id": "62df3b97-427e-336a-94a1-974cbb61c96b",
                                "text": "„Besucher der Kölner Spielemesse Gamescom konnten bereits testen, wie sich die Tanz-, Sport und Abenteuerspiele im Ganzkörpereinsatz anfühlen.“"
                            },
                            {
                                "example_id": "757cb4c9-15df-4e5c-a245-0b99d0d433f5",
                                "sense_id": "62df3b97-427e-336a-94a1-974cbb61c96b",
                                "text": "„Mit Abenteuerspielen und Radiospots wird die Jugend umworben.“"
                            },
                            {
                                "example_id": "6e1ae1db-2c31-40f2-b43d-08a0aaa63b3e",
                                "sense_id": "62df3b97-427e-336a-94a1-974cbb61c96b",
                                "text": "„Abenteuerspiele hat es schon vorher gegeben – englischsprachige interaktive Geschichten mithilfe von Texteingaben.“"
                            },
                            {
                                "example_id": "0ca1e35e-2002-41ec-af4c-1f5e21e5f9ee",
                                "sense_id": "62df3b97-427e-336a-94a1-974cbb61c96b",
                                "text": "„Das Abenteuerspiel trägt ernste Züge. Es offenbart den Charakter und das Leistungsvermögen der Spielenden.“"
                            },
                            {
                                "example_id": "3c2c20d0-ae6c-4ec9-9bcd-1fb913ccfbce",
                                "sense_id": "62df3b97-427e-336a-94a1-974cbb61c96b",
                                "text": "„Die drei Beispielaktionen zeigen auf ihre Art und Weise eindrucksvoll die Möglichkeit auf, wie unterschiedlich […] in der Spielgeschichte kooperative Abenteuerspiele sein können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da3038aa-bcb7-4678-a66a-74b27bab5a80",
                        "source_entry_id": "b4c4cd3b-a769-31f9-8e3c-bf651b9152f7",
