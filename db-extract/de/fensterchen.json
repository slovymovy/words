                            {
                                "example_id": "c10e400f-f1a1-4c9e-bfbc-931a7b283c51",
                                "sense_id": "3c7f2357-6fc6-3738-b756-cd587c6d28ba",
                                "text": "„Als ich nach ein paar Minuten aus meinem Fensterchen schaute, sah ich, daß bereits das ganze Haus umstellt war.“"
