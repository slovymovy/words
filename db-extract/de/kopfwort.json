                ],
                "senses": [
                    {
                        "sense_id": "c80320db-49c1-31e9-9da7-fab0e89d3485",
                        "entry_id": "0f09fad9-8b2c-3162-b3d9-898956d742eb",
                        "glosses": [
                            "Kurzwort, das durch Kürzung eines längeren Wortes entstanden ist und bei dem eine oder mehr Anfangssilbe(n) des gekürzten Wortes erhalten blieb(en)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b55bdd1-1227-46a9-9603-7f3e5a38ef04",
                                "sense_id": "c80320db-49c1-31e9-9da7-fab0e89d3485",
                                "text": "\"Ober\" (für \"Oberkellner\"), \"Auto\" (für \"Automobil\") sind Kopfwörter im Deutschen."
                            },
                            {
                                "example_id": "097d62ee-d71a-4eb3-b3fa-2250bba4a710",
                                "sense_id": "c80320db-49c1-31e9-9da7-fab0e89d3485",
                                "text": "„Unisegmentale Kurzwörter sind Anfangs- oder Endsegmente (auch als Kopf- oder Schwanzwörter, initiale oder finale Segmente bezeichnet) der Vollformen.“"
                            },
                            {
                                "example_id": "dfc7a188-746a-44f8-9c91-3c41cd156fad",
                                "sense_id": "c80320db-49c1-31e9-9da7-fab0e89d3485",
                                "text": "„Kopf- und Schwanzwörter sind Wörter aus jeweils ersten oder letzten Teilen von Wörtern oder Wortgruppen.“"
                            },
                            {
                                "example_id": "70dc22af-a905-4178-839b-74167e0c0fd2",
                                "sense_id": "c80320db-49c1-31e9-9da7-fab0e89d3485",
                                "text": "„In größerem Umfang aufgenommen sind gekürzte Wörter, sogenannte Kopfwörter, bei denen nur der Anfang geblieben und der Schluß weggelassen ist (…), und Schwanzwörter (bei denen der Schluß geblieben und der Anfang weggelassen ist…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
