                                                "example_id": "adbe9469-d073-47c9-92bf-1735ae267cb7",
                                                "sense_id": "cb8d5767-f6b3-3e8a-b64d-2ec74bd59bf9",
                                                "text": "Une fois l’intermittence des signaux quantifiée, il est possible de séparer l’influence de cette disparition sur la fluctuation de fréquence."
                                            },
                                            {
                                                "example_id": "1b4c7953-1551-4482-9cd1-67bfcf693518",
                                                "sense_id": "cb8d5767-f6b3-3e8a-b64d-2ec74bd59bf9",
                                                "text": "Une des lois de l’âme humaine est l’intermittence."
