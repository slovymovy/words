                        "entry_id": "021ff86c-a55b-3061-a282-6e79e701ed02",
                        "glosses": [
                            "A book or an encyclopedia of recipes and cookery tips."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e650b854-90c1-4d63-ba9a-a3aa45bb034c",
                                "sense_id": "e20cdb3e-53fe-3978-b710-0dd640f97b54",
                                "text": "They inherited an interesting nineteenth-century cookbook from their grandparents. It tells how to render lard."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7df34b3-c2bb-386f-91ce-4388393bb528",
                        "entry_id": "021ff86c-a55b-3061-a282-6e79e701ed02",
                        "glosses": [
                            "Any book or set of strategies and tips."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5cda4509-aa60-4224-b529-f416421f5b1a",
                                "sense_id": "d7df34b3-c2bb-386f-91ce-4388393bb528",
                                "text": "Near-synonym: playbook"
                            },
                            {
                                "example_id": "4eeaf4ac-b547-4e52-bcb2-230d2b95b226",
                                "sense_id": "d7df34b3-c2bb-386f-91ce-4388393bb528",
                                "text": "The Anarchist Cookbook"
                            },
                            {
                                "example_id": "f4939f24-0da6-4776-8539-52896f906250",
                                "sense_id": "d7df34b3-c2bb-386f-91ce-4388393bb528",
                                "text": "Reading business biographies is interesting, but they are not cookbooks that can teach hacks how to be greats."
                            }
                        ]
