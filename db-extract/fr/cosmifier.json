                "senses": [
                    {
                        "sense_id": "1865fbb9-4e8b-34b8-8268-c86fbdf083fc",
                        "entry_id": "68b11e1e-eb98-36be-ab61-affbb261c2d4",
                        "glosses": [
                            "Donner un caractère cosmique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "642e56c2-d259-4a04-8d37-d8f582aa2f86",
                                "sense_id": "1865fbb9-4e8b-34b8-8268-c86fbdf083fc",
                                "text": "Or si seuls les endroits sacrés sont propices à l’homme son devoir est de choisir les espaces et de les cosmifier, étant donné que « s’installer quelque part, habiter un espace c’est réitérer la cosmogonie et donc imiter l’oeuvre des dieux »."
                            },
                            {
                                "example_id": "d4641247-b193-4643-a1e4-978bf3633614",
                                "sense_id": "1865fbb9-4e8b-34b8-8268-c86fbdf083fc",
                                "text": "L’idéal, c’est de se « cosmifier » (διαϰοσμεἵν)."
                            }
                        ]
                    }
                ],
