                        "glosses": [
                            "Administrer un médicament à (un malade) avant une intervention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d26dc29-7e00-4902-8b19-d158457f1c36",
                                "sense_id": "697d71d7-3439-3266-befd-75aa1e469edb",
                                "text": "Prémédiquer le malade selon les prescriptions de l'anesthésiste."
                            },
                            {
                                "example_id": "cf29daf4-91d9-44b2-b8d0-42cee463a3b7",
                                "sense_id": "697d71d7-3439-3266-befd-75aa1e469edb",
                                "text": "Cet examen non invasif est mal vécu par les patients claustrophobes : ne pas hésiter à les prémédiquer."
                            },
                            {
                                "example_id": "619d903d-c944-4a5a-8d8c-0284cd358978",
                                "sense_id": "697d71d7-3439-3266-befd-75aa1e469edb",
                                "text": "Peu avant onze heures, Flora, suivie de la grosse infirmière blonde, entra dans la chambre pour préparer et prémédiquer Carlotta."
                            }
                        ]
