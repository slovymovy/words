                "entry_id": "8766dc09-09ec-3e7e-930e-8f802c2d093f",
                "word": "anderszins",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8a5b9d32-79c0-31e4-bef5-3751ed1e5196",
                        "entry_id": "8766dc09-09ec-3e7e-930e-8f802c2d093f",
                        "glosses": [
                            "otherwise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6bc8995-5ff2-4d09-b7d0-a12437a51aee",
                                "sense_id": "8a5b9d32-79c0-31e4-bef5-3751ed1e5196",
                                "text": "Ik kan vanavond niet uitgaan, anderszins had ik graag meegegaan.",
                                "translation": "I can't go out tonight, otherwise I would have liked to join.",
                                "english": "I can't go out tonight, otherwise I would have liked to join."
                            },
                            {
                                "example_id": "eaa7ef24-64ff-41e3-92b6-bc9e93584849",
                                "sense_id": "8a5b9d32-79c0-31e4-bef5-3751ed1e5196",
                                "text": "Het is belangrijk om voldoende rust te nemen, anderszins kun je snel oververmoeid raken.",
                                "translation": "It is important to get enough rest, otherwise you can quickly become overfatigued.",
                                "english": "It is important to get enough rest, otherwise you can quickly become overfatigued."
                            },
                            {
                                "example_id": "5a8406d1-8158-4791-8cdd-9a90f76284f5",
                                "sense_id": "8a5b9d32-79c0-31e4-bef5-3751ed1e5196",
                                "text": "Je moet eerlijk zijn in je antwoorden, anderszins heeft de test geen zin.",
                                "translation": "You must be honest in your answers, otherwise the test is meaningless.",
                                "english": "You must be honest in your answers, otherwise the test is meaningless."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
