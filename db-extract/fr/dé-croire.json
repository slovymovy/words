                        "glosses": [
                            "Variante orthographique de décroire (cesser de croire)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502b38f1-d699-418a-a906-7ae6d29489b4",
                                "sense_id": "8abfd9ba-eb53-37e6-8bab-d74dc6fa3a9c",
                                "text": "Ils le dé-croient, le décrochent quitte à le remettre en croix plus tard pour relancer la machine."
                            },
                            {
                                "example_id": "91acc5b9-550a-469f-8d00-cbe2669b29c1",
                                "sense_id": "8abfd9ba-eb53-37e6-8bab-d74dc6fa3a9c",
                                "text": "Croître en savoir, pour dé-croire les billevesées."
                            },
                            {
                                "example_id": "11152e70-c02b-4e4c-af16-5a4c7cad10a1",
                                "sense_id": "8abfd9ba-eb53-37e6-8bab-d74dc6fa3a9c",
                                "text": "Sortir de nos conditionnements, \"dé-croire\" comme le dit joliment un de mes lecteurs, est la condition de notre liberté."
                            }
                        ]
