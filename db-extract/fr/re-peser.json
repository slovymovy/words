                        "glosses": [
                            "Autre orthographe, parfois rencontrée, pour repeser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62bd21a8-f78c-4485-a8a0-f162d25b256a",
                                "sense_id": "3fe2d096-9433-362f-9b16-614bd2bc85e2",
                                "text": "Au regard de cette tentative d'explication, ce que l'on pourrait principalement faire valoir contre Kelsen est le fait que ce qui est refoulé ne semble pas pour autant perdu et peut donc revenir et re-peser dans la balance des accords sous la forme de violences susceptibles de contrarier l'accord recherché."
                            },
                            {
                                "example_id": "14ba49d5-48ed-4170-aaee-cacd5a80fc13",
                                "sense_id": "3fe2d096-9433-362f-9b16-614bd2bc85e2",
                                "text": "La peser, la re-peser et la soupeser a fait l'objet de mon livre sur la monnaie africaine."
                            },
                            {
                                "example_id": "de144412-bf26-4b90-88fa-2c4d2b7a970f",
                                "sense_id": "3fe2d096-9433-362f-9b16-614bd2bc85e2",
                                "text": "j'utilise des fûts bois que je re-spine et re-pèse moi même."
                            }
                        ]
                    }
