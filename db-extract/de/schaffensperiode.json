                                "example_id": "b8d2a71a-362f-4a0c-90e1-bea1d8a1f5a5",
                                "sense_id": "336f2dc6-5ea1-35e6-9f0c-79de5c2eab32",
                                "text": "„Diese theoretische Einsicht, die nach den eigenen großen Schaffensperioden von 1930 an und von 1950 an formuliert wurde, ist weit von dem entfernt, was er damals in Zürich zustande bringt.“"
                            },
                            {
                                "example_id": "327defeb-5346-4fe8-93aa-1b0740d24fd2",
                                "sense_id": "336f2dc6-5ea1-35e6-9f0c-79de5c2eab32",
                                "text": "„Auch bei Wilhelm Busch ist es nicht so einfach, von eindeutigen Schaffensperioden zu sprechen.“"
