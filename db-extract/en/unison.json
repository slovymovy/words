            {
                "entry_id": "94745002-6f07-3835-b519-60e01698d613",
                "word": "unison",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2c149087-76a7-4b91-b674-f210594a016d",
                        "entry_id": "94745002-6f07-3835-b519-60e01698d613",
                        "tags": [
                            "plural"
                        ],
                        "form": "unisons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6193e70-53e0-383d-bb75-831d861acacb",
                        "entry_id": "94745002-6f07-3835-b519-60e01698d613",
                        "glosses": [
                            "Identical pitch between two notes or sounds; the simultaneous playing of notes of identical pitch (or separated by one or more octaves)."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5cbf7502-3654-4bb3-b52d-a8a75beef734",
                                "sense_id": "e6193e70-53e0-383d-bb75-831d861acacb",
                                "text": "The unison has a pitch ratio of 1:1."
                            },
                            {
                                "example_id": "2bf77d63-5bb2-45dd-a4e2-b6da901dc519",
                                "sense_id": "e6193e70-53e0-383d-bb75-831d861acacb",
                                "text": "The young principal timpanist, Timothy Genis, was superb throughout, though his sidekick timpanist sometimes lagged in the final unisons."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6fdb38d-edb2-33c7-880a-94e3f94ed088",
                        "entry_id": "94745002-6f07-3835-b519-60e01698d613",
                        "glosses": [
                            "A sound or note having the same pitch as another, especially when used as the base note for an interval; a unison string."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "6fb49658-51f7-4ec7-be5c-c766400a1d7e",
                                "sense_id": "f6fdb38d-edb2-33c7-880a-94e3f94ed088",
                                "text": "I could not behold him without emotion; when he accosted me, his well-known voice made my heart vibrate, like a musical chord, when its unison is struck."
                            }
                        ]
                    },
                    {
                        "sense_id": "b841e4bf-41da-35e7-a2d4-8ba14e9fcd82",
                        "entry_id": "94745002-6f07-3835-b519-60e01698d613",
                        "glosses": [
                            "The state of being in harmony or agreement; harmonious agreement or togetherness, synchronisation."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "0cd5be4f-39f1-4e1c-a23b-740948e43ebd",
                                "sense_id": "b841e4bf-41da-35e7-a2d4-8ba14e9fcd82",
                                "text": "Everyone moved in unison, but the sudden change in weight distribution capsized the boat."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bf30018-e662-35d3-b3f2-424ee4e3bc28",
                        "entry_id": "94745002-6f07-3835-b519-60e01698d613",
                        "glosses": [
                            "Two or more voices speaking or singing the same words together."
                        ],
                        "tags": [
                            "broadly",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4ddd15d-9aba-491a-abe4-e8c48c254229",
                        "source_entry_id": "94745002-6f07-3835-b519-60e01698d613",
                        "source_sense_description": "the state of being together, in harmony, at the same time",
                        "target_lang_word": "Einklang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einklang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af17e775-74bc-3074-bee7-ca92691e41c3",
                                        "entry_id": "310a0852-59d5-39f5-b77e-f712acf65051",
                                        "glosses": [
                                            "Übereinstimmung, Harmonie; in einem Zustand, in dem sich zwei Dinge miteinander so vereinbaren lassen, dass sie nicht widersprüchlich sind"
                                        ],
                                        "tags": [
                                            "im Einklang mit etwas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1778b5d3-5463-444c-935e-c0f54e709254",
                                                "sense_id": "af17e775-74bc-3074-bee7-ca92691e41c3",
                                                "text": "Ich beneide ihn, weil er seine privaten und beruflichen Interessen miteinander in Einklang bringen kann."
                                            },
                                            {
                                                "example_id": "4a806d1a-1a34-445f-bf91-10edec0c09ae",
                                                "sense_id": "af17e775-74bc-3074-bee7-ca92691e41c3",
                                                "text": "Die moderne Industrie produziert häufig nicht nachhaltig, geschweige denn im Einklang mit der Natur."
                                            },
                                            {
                                                "example_id": "881ffdc0-7b77-49b2-bcf0-88c327ed6396",
                                                "sense_id": "af17e775-74bc-3074-bee7-ca92691e41c3",
                                                "text": "„Die Beleuchtung des Ladens und die des Schaufensters müssen in harmonischen Einklang gebracht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5411a82d-dc73-3374-b723-cfcf3999a5cf",
                                        "entry_id": "310a0852-59d5-39f5-b77e-f712acf65051",
                                        "glosses": [
                                            "die gleiche Meinung haben (wie ein anderer/andere)"
                                        ],
                                        "tags": [
                                            "sich (mit jemandem) in Einklang (über etwas) befinden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d54bb562-c2ac-474f-99fe-237d25c9037f",
                                                "sense_id": "5411a82d-dc73-3374-b723-cfcf3999a5cf",
                                                "text": "Bei unserer Klassendiskussion befand ich mich mit vielen im Einklang."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b7cdbcbc-4c03-3cb6-bd52-e5d42e3a67d1",
                                        "entry_id": "310a0852-59d5-39f5-b77e-f712acf65051",
                                        "glosses": [
                                            "Zusammenklang zweier oder mehrerer Stimmen auf dem gleichen Ton oder im Oktavabstand"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fac20ffd-59b1-4f73-9ae0-ba1454900d20",
                        "source_entry_id": "94745002-6f07-3835-b519-60e01698d613",
