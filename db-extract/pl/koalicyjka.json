                        "target_lang_word": "Sam Browne belt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sam Browne belt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae07e5a-b12e-326c-a778-a54c24b0d566",
                                        "entry_id": "3e814f1a-aed2-3606-9ee7-e2f59ed73a0c",
                                        "glosses": [
                                            "A wide military belt, usually leather, supported by a strap going diagonally over the right shoulder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "705a726c-bb06-4839-a5b5-2ae1ad9ddbd8",
                                                "sense_id": "8ae07e5a-b12e-326c-a778-a54c24b0d566",
                                                "text": "You see that? The moths haven't got this, then. - You kept the old Sam Browne all these years? - Certainly. - And kept it polished. Might come in useful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecab2eac-0898-41de-87c5-0375cdab2943",
                        "source_entry_id": "f43603a9-0dfa-339e-a76a-5c5e9c5cfc08",
                        "source_sense_id": "99f10adf-5122-373d-9b20-71957c9d6afd",
                        "target_lang_word": "Portepee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Portepee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58b4a6ae-a74b-3338-bbe7-57fa5b4ba6cd",
                                        "entry_id": "a1aa0dcb-1c93-320f-abb4-634d3a955a4c",
                                        "glosses": [
                                            "Quaste am Degen, Säbel, Dolch oder Bajonett, die versilbert oder vergoldet ist und zur Kennzeichnung eines Offiziers oder Unteroffiziers mit besonderen Rechten dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf8e8fdc-366a-4433-85c8-d98f031fc7f6",
                                                "sense_id": "58b4a6ae-a74b-3338-bbe7-57fa5b4ba6cd",
                                                "text": "„Gegen Unteroffiziere, welche das Portepee tragen, wird mittlerer Arrest nicht verhängt.“"
                                            },
                                            {
                                                "example_id": "c26155cf-0468-4c91-9a2b-5176f7860679",
                                                "sense_id": "58b4a6ae-a74b-3338-bbe7-57fa5b4ba6cd",
                                                "text": "„Da bin ich zum erstenmal in meinem Leben schwach und ein erbarmungswürdiger Narr gewesen; wir zogen ab, ich mit meinem Portepee und meine Frau mit sehr hoher Nase, und ließen das Kind hier zurück, […]“"
                                            },
                                            {
                                                "example_id": "3c936b2f-c7e8-4bb4-ae25-89d5cdb97f30",
                                                "sense_id": "58b4a6ae-a74b-3338-bbe7-57fa5b4ba6cd",
                                                "text": "„Aber er lachte immer mehr und gab mir nur das Portepee in die Hand und ging voraus.“"
                                            },
                                            {
                                                "example_id": "c9aead6b-76e6-4b46-8f65-c73819e4b368",
                                                "sense_id": "58b4a6ae-a74b-3338-bbe7-57fa5b4ba6cd",
                                                "text": "„Du siehst ja aus, als ob du dein Portepee schon hättest und gerade aus dem Manöver kämst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
