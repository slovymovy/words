{
    "word_family": [
        "unveil",
        "veil"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3db99487-e33d-3fb0-b174-74e2415d0793",
                    "sense_definition": "Wearing or covered by a veil.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>veiled</w> bride slowly walked down the aisle toward her husband.",
                            "target_lang_translations": {
                                "de": "Die <w>verschleierte</w> Braut schritt langsam den Mittelgang entlang auf ihren Mann zu."
                            }
                        },
                        {
                            "text": "A <w>veiled</w> woman stood quietly near the entrance of the temple.",
                            "target_lang_translations": {
                                "de": "Eine <w>verschleierte</w> Frau stand still nahe dem Eingang des Tempels."
                            }
                        }
                    ],
                    "synonyms": [
                        "covered",
                        "shrouded"
                    ],
                    "antonyms": [
                        "unveiled",
                        "bareheaded"
                    ],
                    "common_phrases": [
                        "veiled woman",
                        "veiled bride"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Schleier tragend oder von einem Schleier bedeckt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschleiert",
                                "target_lang_sense_clarification": "Personen oder Gegenstände, die von einem Schleier bedeckt sind"
                            },
                            {
                                "target_lang_word": "verhüllt",
                                "target_lang_sense_clarification": "durch Stoff, ein Tuch oder Ähnliches bedeckt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "228a3c43-6789-3c0f-8994-f5c9479404ad",
                    "sense_definition": "Expressed in an indirect, disguised, or partly hidden way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His polite remark was actually a <w>veiled</w> threat to force them to resign.",
                            "target_lang_translations": {
                                "de": "Seine höfliche Bemerkung war in Wirklichkeit eine <w>verschleierte</w> Drohung, um sie zum Rücktritt zu zwingen."
                            }
                        },
                        {
                            "text": "She responded to the criticism with a <w>veiled</w> insult that only a few people understood.",
                            "target_lang_translations": {
                                "de": "Sie reagierte auf die Kritik mit einer <w>versteckten</w> Beleidigung, die nur wenige verstanden."
                            }
                        }
                    ],
                    "synonyms": [
                        "disguised",
                        "indirect",
                        "implicit",
                        "masked"
                    ],
                    "antonyms": [
                        "direct",
                        "explicit",
                        "overt"
                    ],
                    "common_phrases": [
                        "veiled threat",
                        "veiled criticism",
                        "veiled reference"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf indirekte, verdeckte oder nur teilweise erkennbare Weise geäußert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschleiert",
                                "target_lang_sense_clarification": "im übertragenen Sinne; verdeckt oder indirekt formuliert"
                            },
                            {
                                "target_lang_word": "versteckt",
                                "target_lang_sense_clarification": "nicht offen ausgesprochen, hintergründig"
                            },
                            {
                                "target_lang_word": "verhüllt",
                                "target_lang_sense_clarification": "durch Worte verdeckt oder angedeutet"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6359ec1-91da-3919-8145-1f118137e0fb",
                    "sense_definition": "Simple past and past participle of <w>veil</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick mist <w>veiled</w> the distant mountains early in the morning.",
                            "target_lang_translations": {
                                "de": "Dichter Nebel <w>verhüllte</w> am frühen Morgen die fernen Berge."
                            }
                        },
                        {
                            "text": "She <w>veiled</w> her face before stepping into the bright sunlight.",
                            "target_lang_translations": {
                                "de": "Sie <w>verschleierte</w> ihr Gesicht, bevor sie in das helle Sonnenlicht trat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Präteritum und Partizip Perfekt des Verbs veil (verschleiern, verhüllen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschleierte",
                                "target_lang_sense_clarification": "Präteritum von verschleiern"
                            },
                            {
                                "target_lang_word": "verhüllte",
                                "target_lang_sense_clarification": "Präteritum von verhüllen"
                            },
                            {
                                "target_lang_word": "verschleiert",
                                "target_lang_sense_clarification": "Partizip Perfekt von verschleiern"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}