                "senses": [
                    {
                        "sense_id": "f72f4cb1-d6a8-395a-88fa-552e61a730f0",
                        "entry_id": "3d655f9e-37cf-31d6-b301-66a1559c0d30",
                        "glosses": [
                            "eine Backware ähnlich den Brötchen, die aus zwei runden, aneinander gebackenen Teilen besteht, deren Teig nur aus Mehl, Salz und Wasser hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3880be13-d36c-42a9-beb8-8ff17c551897",
                                "sense_id": "f72f4cb1-d6a8-395a-88fa-552e61a730f0",
                                "text": "Schösschen kann man am Mittelrhein in einigen Bäckereien bekommen."
                            },
                            {
                                "example_id": "7cfd66c4-74dd-495c-bd49-fb8ac9a47ebd",
                                "sense_id": "f72f4cb1-d6a8-395a-88fa-552e61a730f0",
                                "text": "Wenn ich mal in der Gegend von Koblenz bin, suche ich immer nach Schösschen, weil ich die so gerne esse."
                            },
                            {
                                "example_id": "96d0f5f6-6b76-45cb-b313-00a7393259b0",
                                "sense_id": "f72f4cb1-d6a8-395a-88fa-552e61a730f0",
                                "text": "„Gegenüber ist die Bäckerei; dort hole ich dann ein Schösschen, was so viel [ist] wie ein Doppelbrötchen, das mit Wasser statt Milch gebacken wurde. Und dann kommt noch ein Bier dazu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
