                        "entry_id": "8623c823-0f00-3a14-b290-b6b60484205c",
                        "glosses": [
                            "Habitants de la région du Nil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76a96d94-5e10-408d-a0f7-d9916d1cb552",
                                "sense_id": "30f57160-d191-3f1b-9a2b-c7f16e5335aa",
                                "text": "L'agriculture tempérée a été inventée par les enfants de l'Euphrate et les Nilotiques, les uns et les autres vivant dans des milieux généralement calcaires ou argilo-calcaires; aussi la plupart des céréales qui nous viennent de cette source sont-elles à préférences calcicoles."
                            }
                        ]
                    }
                ],
