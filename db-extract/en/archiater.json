                                        "entry_id": "ffc21b2d-c7da-3d7f-9ba7-40c22d4b9cc5",
                                        "glosses": [
                                            "persönlicher Arzt einer hochgestellten Persönlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c8cf411-8bad-48bc-8a34-aab6a09e8899",
                                                "sense_id": "fd7be807-e0e4-36a5-b631-8629d59ecd58",
                                                "text": "„Der päpstliche Leibarzt musste sich schließlich in einer Pressekonferenz für sein umstrittenes Vorgehen rechtfertigen.“"
                                            },
                                            {
                                                "example_id": "3feb0445-bf22-4750-81ed-30e3b14be34a",
                                                "sense_id": "fd7be807-e0e4-36a5-b631-8629d59ecd58",
                                                "text": "„Der Leibarzt von Franz Josef Strauß, der gebürtige Bulgare Valentin Argirov, kommt nach dem Tod seines prominenten Patienten in große Bedrängnis: Unbemerkt von der Öffentlichkeit hat er sich binnen weniger Jahre mit Geldern des Freistaats ein ansehnliches Klinik-Imperium aufgebaut.“"
                                            },
                                            {
                                                "example_id": "175e2438-1786-4d52-88d6-a7cacde9336e",
                                                "sense_id": "fd7be807-e0e4-36a5-b631-8629d59ecd58",
                                                "text": "„Churchills Leibarzt bückte sich nach einem Paar verbrannter Handschuhe.“"
                                            },
                                            {
                                                "example_id": "ecb675ab-5d7a-4a58-9edd-4ca6a068fa4d",
                                                "sense_id": "fd7be807-e0e4-36a5-b631-8629d59ecd58",
                                                "text": "„Einige Male wurde sein Leibarzt Villiers zu ihm gerufen.“"
                                            }
