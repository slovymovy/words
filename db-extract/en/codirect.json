                                        "glosses": [
                                            "Diriger conjointement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5675c675-88cf-4cf7-b609-c27b03a65421",
                                                "sense_id": "e5645d4f-4be1-3368-bead-3a73ae58469f",
                                                "text": "Tout porte à croire qu’il s’agit d’un rameau du genre Homo resté sans descendance, pense José-Maria Bermudes de Castro, qui codirige les fouilles."
                                            },
                                            {
                                                "example_id": "f2b86d8c-e2d9-446e-a72b-91f84bc814e7",
                                                "sense_id": "e5645d4f-4be1-3368-bead-3a73ae58469f",
                                                "text": "« C’est un brillant succès », a déclaré Michael Hecht, du MIT, qui codirige cette expérience."
                                            },
                                            {
                                                "example_id": "43429aee-cb82-4966-b3b6-1b77caad11d9",
                                                "sense_id": "e5645d4f-4be1-3368-bead-3a73ae58469f",
                                                "text": "« Aller chercher un jeu vidéo à succès pour le porter à l’écran est assez routinier », rappelle Alexis Blanchet, maître de conférences à l’université Sorbonne nouvelle, qui a codirigé Lire les magazines de jeux vidéo, Couverture(s) de la presse spécialisée française (Presses universitaires de Liège, 2022)."
                                            }
                                        ]
                                    }
                                ]
