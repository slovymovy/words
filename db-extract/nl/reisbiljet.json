                                                "sense_id": "812a896a-8799-3257-ab5d-1c72792019a7",
                                                "text": "I've got two tickets for the match on Saturday; want to come?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bfeadb9-3a1e-39d4-990b-78164f7a7295",
                                        "entry_id": "93271122-f14f-3b82-9bb8-6f0c72713992",
                                        "glosses": [
                                            "A small document that acts as proof of something, often thereby granting the holder some ability.",
                                            "A pass entitling the holder to board a train, a bus, a plane, or other means of transportation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89bb6ddd-f360-43c6-a133-c4130a387722",
                                                "sense_id": "3bfeadb9-3a1e-39d4-990b-78164f7a7295",
                                                "text": "train ticket   bus ticket   plane ticket"
                                            },
                                            {
                                                "example_id": "cf091d90-e943-4e8f-a65d-941c676cb1b5",
                                                "sense_id": "3bfeadb9-3a1e-39d4-990b-78164f7a7295",
                                                "text": "You must show your ticket to the conductor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3e5016e-b263-32c1-97a3-def21b64ad81",
