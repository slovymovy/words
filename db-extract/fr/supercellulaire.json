                        "glosses": [
                            "Orage plus grand et intense que la plupart."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85f060e9-8aac-4ec2-9301-a3ab0f7e3e44",
                                "sense_id": "cadf2d3e-7c96-3a5b-80c2-f32f7f41d472",
                                "text": "Cette fabuleuse scène d’orage dit supercellulaire, un type particulier de perturbation associée à des vents violents, des pluies torrentielles, de la grêle ou des tornades, est l’œuvre de l’Australien Vin Moult."
                            },
                            {
                                "example_id": "bb56eceb-0afc-4f38-a676-9d1575750660",
                                "sense_id": "cadf2d3e-7c96-3a5b-80c2-f32f7f41d472",
                                "text": "Le cumulonimbus se rapproche, c’est un supercellulaire, mais il est loin d’être classique."
                            }
                        ]
                    }
