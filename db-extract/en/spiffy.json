                                            "form-of",
                                            "imperative",
                                            "present",
                                            "singular"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feec2f7b-4290-4c2e-90e6-5b4c8ce09cba",
                        "source_entry_id": "468a27ca-3918-3ba1-b144-71d8da3b25ac",
                        "source_sense_id": "ca224b79-3752-3655-8931-87a3e95c0417",
                        "source_sense_description": "dapper, fine or neat",
                        "target_lang_word": "нарядный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нарядный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e8a16128-0506-3b77-9085-2a5509508a15",
                                        "entry_id": "a453cdc3-3b30-3c12-b629-67fdee6a8cf5",
                                        "glosses": [
                                            "красиво одетый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "301dd1f1-60d7-4032-a647-6ce7d711c505",
                                                "sense_id": "e8a16128-0506-3b77-9085-2a5509508a15",
                                                "text": "Кортомиха выходила в лавку нарядная, в розовой шляпе, в перчатках, в улыбке."
                                            },
                                            {
                                                "example_id": "f6ba93df-f973-4133-9aa8-44f710adcc82",
                                                "sense_id": "e8a16128-0506-3b77-9085-2a5509508a15",
                                                "text": "Он нарядный, весь заграничный, петушиный галстук, булавка с фальшивым бриллиантом — и они…"
                                            },
                                            {
                                                "example_id": "8c47e434-70c7-4a1c-9591-e1048e641d7c",
                                                "sense_id": "e8a16128-0506-3b77-9085-2a5509508a15",
                                                "text": "На Новый год 85-летний учёный надел новый костюм и новый галстук. Таким нарядным его давно не видели. Сидел с домашними до двух ночи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c99c33c-8bec-3666-86df-7cd277200c4e",
                                        "entry_id": "a453cdc3-3b30-3c12-b629-67fdee6a8cf5",
                                        "glosses": [
                                            "пышный, богато украшенный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "013f49ae-1f1f-410a-959a-35b22de13664",
                                                "sense_id": "4c99c33c-8bec-3666-86df-7cd277200c4e",
                                                "text": "Она стала накрывать на стол: красное богемское стекло, нарядная скатерть, серебряные приборы."
                                            },
                                            {
                                                "example_id": "eba55008-30b1-45a9-a778-8ef175339b81",
                                                "sense_id": "4c99c33c-8bec-3666-86df-7cd277200c4e",
                                                "text": "Да и деревья представляли собою не облезлые брёвна с содранной корой, — заботливо укутанные почти незаметной сеткой, они весело зеленели нарядной листвой."
                                            },
                                            {
                                                "example_id": "f4757e76-a577-4e20-b65e-831dc531033b",
                                                "sense_id": "4c99c33c-8bec-3666-86df-7cd277200c4e",
                                                "text": "А утром они увидели такую нарядную ёлку и столько подарков под ней — что их хватило бы на весь лес."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
