                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a4328e23-5f83-4554-aa59-530d384fc63c",
                                "sense_id": "b12f3e47-5751-36dc-98ec-461f3454477f",
                                "text": "„Der Barkarole am Steuer dachte, ich wolle die Gelegenheit benützen, um billiger nach Mestre zu kommen, und sagte dem Barkarolen auf dem Schiffshinterteil, er solle auf das Ufer zuhalten.“"
