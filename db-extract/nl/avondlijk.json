                        "entry_id": "809c586d-1332-3230-8c7e-219889827480",
                        "glosses": [
                            "gedurende de avond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea73e76d-1b98-4dde-861e-4e70d098c27b",
                                "sense_id": "a46d4298-4eca-32ba-9399-5954050c91a0",
                                "text": "En voor de herdenking van de wapenstilstand een avondlijk samenzijn in het Hótel des Invalides! Zo ongeveer met gesloten deuren!'"
                            },
                            {
                                "example_id": "421f64af-9176-4a2a-8497-f5adbdee0f8c",
                                "sense_id": "a46d4298-4eca-32ba-9399-5954050c91a0",
                                "text": "De komst van de junks is gekoppeld aan een aantal voorwaarden, als beperkte ontvangst van (avondlijk) bezoek en geen gebruik van drugs en drank op straat."
                            }
                        ]
                    }
                ],
