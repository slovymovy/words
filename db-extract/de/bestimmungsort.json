                                            "The act of destining or appointing."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9be9fc97-b675-3688-b178-5161ab1e5547",
                                        "entry_id": "ca30e611-3974-34a7-9552-fb59feb19870",
                                        "glosses": [
                                            "Purpose for which anything is destined; predetermined end, object, or use; ultimate design."
                                        ],
