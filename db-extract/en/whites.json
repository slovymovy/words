                    },
                    {
                        "sense_id": "14a22d2a-5c02-35ec-a646-967831dbf7e1",
                        "entry_id": "cd92a853-4211-3e05-8f14-e626c73ae9f3",
                        "glosses": [
                            "Any of several sports teams whose uniform is predominantly white, particularly",
                            "The chariot-racing faction of the Roman circus and Constantinopolitan hippodrome that wore white."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e05e323d-7d5c-4126-9c26-97cc035da6f4",
                                "sense_id": "14a22d2a-5c02-35ec-a646-967831dbf7e1",
                                "text": "Directly opposite the imperial box in the Hippodrome were the seats assigned to the Blues, the Reds, the Whites, and the Greens. These were the colours of the chariot-racing factions, the professional organizations initially responsible for fielding the teams, though at some point in the fifth century they took charge of other public spectacles as well, and thus we can find factions even in cities which had no hippodromes."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5a5c89c-5c11-3a07-bd1e-443fb6918d41",
                        "entry_id": "cd92a853-4211-3e05-8f14-e626c73ae9f3",
                        "glosses": [
                            "Any of several sports teams whose uniform is predominantly white, particularly",
                            "The away team during international matches."
                        ],
                        "tags": [
                            "UK",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5f9b23b4-b869-4063-867f-dd85e8b863f0",
                                "sense_id": "a5a5c89c-5c11-3a07-bd1e-443fb6918d41",
                                "text": "1996, S. Greenfield, \"When the Whites Go Marching In? Racism and Resistances in English Football\", Marquette Sports Law Review, Vol. 6, No. 2, Art. 7, p. 315: #*: \"When the Whites go Marching In\" is a version of the hymn \"When the Saints Go Marching In\" and has been sung by football fans whilst attending \"away\" matches in other countries... In this context the reference is to English supporters indicating their disapproval of black players."
                            },
                            {
                                "example_id": "9cf45b10-bc9e-4db9-a168-fcbe9fa8c600",
                                "sense_id": "a5a5c89c-5c11-3a07-bd1e-443fb6918d41",
                                "text": "When the Whites go marching in, oh, when the Whites go marching in, oh, I wanna be in that number when the Whites go marching in!"
                            }
                        ]
                    },
                    {
                        "sense_id": "774cee1e-e9c0-3538-9c05-e2985923a19c",
