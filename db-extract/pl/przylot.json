                "senses": [
                    {
                        "sense_id": "82c8967c-e163-3d45-ad12-22d9b8497f3c",
                        "entry_id": "8c89d464-9e3c-3fb3-8939-5176cc4a5841",
                        "glosses": [
                            "przybycie lecąc, przybycie drogą powietrzną"
                        ],
                        "tags": [],
