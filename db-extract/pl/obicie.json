                ],
                "senses": [
                    {
                        "sense_id": "4d19cdf3-a2ac-38c6-9d0d-dd3296800c40",
                        "entry_id": "18405398-98da-3764-9f7e-ce63130dd2a4",
                        "glosses": [
                            "Bezug, Überzug, Polster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51aca074-f38f-4f92-a5b2-f01520216793",
                                "sense_id": "4d19cdf3-a2ac-38c6-9d0d-dd3296800c40",
                                "text": "„Też same widzi sprzęty, też same obicia, / S któremi się zabawiać lubił od powicia; / Lecz mniéj wielkie, mniéj piękne niż się dawniéj zdały. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c25037e-58fb-46dc-8151-22de64e09b93",
                        "source_entry_id": "18405398-98da-3764-9f7e-ce63130dd2a4",
                        "source_sense_id": "4d19cdf3-a2ac-38c6-9d0d-dd3296800c40",
                        "source_sense_description": "Bezug, Überzug, Polster",
                        "target_lang_word": "Bezug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bezug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b2842f2-b5bd-347f-8033-5e690e924936",
                                        "entry_id": "ce848029-b3f4-3e83-b297-95f1f886eee2",
                                        "glosses": [
                                            "wechselbare Umhüllung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc0d778-6ff1-40c9-9bc2-6575b15ec6eb",
                                                "sense_id": "4b2842f2-b5bd-347f-8033-5e690e924936",
                                                "text": "Der Bezug dieses Kissens ist aus Leinen."
                                            },
                                            {
                                                "example_id": "d1533068-6d99-4136-98da-4b0bd4cd21f0",
                                                "sense_id": "4b2842f2-b5bd-347f-8033-5e690e924936",
                                                "text": "„Er hatte ein Bett, ein paar Sessel mit grünen Bezügen, die Bücher, einen Schreibtisch im Biedermeierstil und wirkte altmodisch und friedlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c661058-cced-3d37-a951-576e20dd586a",
                                        "entry_id": "ce848029-b3f4-3e83-b297-95f1f886eee2",
                                        "glosses": [
                                            "Relation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8f856d5-85e0-4bb1-b34d-5b9c533bc11f",
                                                "sense_id": "3c661058-cced-3d37-a951-576e20dd586a",
                                                "text": "Größe und Gewicht stehen nicht immer in einem Bezug."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "49a30c57-8f13-3bcc-9318-93a17b1ed1ab",
                                        "entry_id": "ce848029-b3f4-3e83-b297-95f1f886eee2",
                                        "glosses": [
                                            "Erwerben oder Erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6734fa4c-373b-43f6-a6ed-1d175d9ba448",
                                                "sense_id": "49a30c57-8f13-3bcc-9318-93a17b1ed1ab",
                                                "text": "Der Bezug von Sozialleistungen ist an bestimmte Bedingungen geknüpft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fce2a40b-eb95-3a1e-b980-4d10695011ed",
                                        "entry_id": "ce848029-b3f4-3e83-b297-95f1f886eee2",
                                        "glosses": [
                                            "Einkünfte"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d46ffaa-838a-4055-8c2f-256bd6017b3c",
                                                "sense_id": "fce2a40b-eb95-3a1e-b980-4d10695011ed",
                                                "text": "Die Bezüge der Angestellten sind durchschnittlich."
                                            },
                                            {
                                                "example_id": "36d17340-c3bb-49ed-862b-8d3c56d708d9",
                                                "sense_id": "fce2a40b-eb95-3a1e-b980-4d10695011ed",
                                                "text": "„Der Anspruch auf Bezüge beginnt mit dem Tag der Angelobung und endet mit dem Tag des Ausscheidens aus der Funktion.“"
                                            },
                                            {
                                                "example_id": "4f64eae4-e258-4c7b-a379-fb7686c9160f",
                                                "sense_id": "fce2a40b-eb95-3a1e-b980-4d10695011ed",
                                                "text": "„Im Oktober wurden ihm sämtliche Bezüge und Pensionsansprüche gestrichen, bald entzog ihm das preußische Innenministerium die Lehrbefugnis, die deutsche Staatsabgehörigkeit wurde ihm aberkannt, sein Vermögen beschlagnahmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
