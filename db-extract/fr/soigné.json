                ],
                "senses": [
                    {
                        "sense_id": "dba08dff-eaf3-32a8-b048-ab21cb23a4d2",
                        "entry_id": "ddf238c1-9cd9-3375-8f5c-644edf8f42f0",
                        "glosses": [
                            "Qui est fait avec soin, où l’on voit du soin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bcfe302-737c-4c3b-995c-0fa21588c9d7",
                                "sense_id": "dba08dff-eaf3-32a8-b048-ab21cb23a4d2",
                                "text": "Ouvrage soigné."
                            },
                            {
                                "example_id": "11db18c9-888e-476d-bb05-8a877608171f",
                                "sense_id": "dba08dff-eaf3-32a8-b048-ab21cb23a4d2",
                                "text": "Ce devoir n’est pas soigné."
                            },
                            {
                                "example_id": "39c66397-5815-4bb0-b05a-d41db77c29e7",
                                "sense_id": "dba08dff-eaf3-32a8-b048-ab21cb23a4d2",
                                "text": "Une tenue soignée."
                            },
                            {
                                "example_id": "bc7090f4-ce64-4b74-a618-d73eadf00a79",
                                "sense_id": "dba08dff-eaf3-32a8-b048-ab21cb23a4d2",
                                "text": "Deux fois par jour, Langlois remettait ses bottes et faisait une inspection soignée, fouinant dans toutes les cours, les basses-cours, les recoins, les culs-de-sac."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b73d05fd-3125-4ef1-a702-13cd3584f3d1",
                        "source_entry_id": "ddf238c1-9cd9-3375-8f5c-644edf8f42f0",
                        "source_sense_id": "dba08dff-eaf3-32a8-b048-ab21cb23a4d2",
                        "target_lang_word": "immaculate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immaculate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4d15b25-ff68-3139-9da2-29ea915652d0",
                                        "entry_id": "1cea6360-a9a8-3599-acf0-730ec08c24bb",
                                        "glosses": [
                                            "Having no blemish or stain; absolutely clean and tidy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2eb7f4d-0802-4ede-a664-4c06bd18c01a",
                                                "sense_id": "b4d15b25-ff68-3139-9da2-29ea915652d0",
                                                "text": "O loyall Father, of a treacherous Sonne, / Thou ſheere immaculate and ſiluer Fountaine, / From vvhence this ſtreame, through muddy paſſages, / Hath held his current, and defild himſelfe."
                                            },
                                            {
                                                "example_id": "744fc412-bf56-480a-826a-c02d5518a176",
                                                "sense_id": "b4d15b25-ff68-3139-9da2-29ea915652d0",
                                                "text": "So in immaculate clothes, and Symetrie / Perfect as circles, vvith ſuch nicetie / As a young Preacher at his firſt time goes / To preach, he enters, […]"
                                            },
                                            {
                                                "example_id": "0d65c097-4975-434c-a6d5-b591c5f10511",
                                                "sense_id": "b4d15b25-ff68-3139-9da2-29ea915652d0",
                                                "text": "So firſt to preach a vvhite-glov'd Chaplain goes, / VVith Band of Lily, and vvith Cheek of Roſe, / Svveeter than Sharon, in immaculate trim, / Neatneſs itſelf impertinent in him."
                                            },
                                            {
                                                "example_id": "9f197a63-2af4-4a5a-9f83-15c51aa8a6bf",
                                                "sense_id": "b4d15b25-ff68-3139-9da2-29ea915652d0",
                                                "text": "Every rustle of her silvery silk gown, every fold of the snowy kerchief on her neck, every plait of her immaculate cap, spoke a soul long retired from this world and its cares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa572b6-0123-3512-ba60-1e96359e2de4",
                                        "entry_id": "1cea6360-a9a8-3599-acf0-730ec08c24bb",
                                        "glosses": [
                                            "Containing no mistakes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6772d98-5941-3860-b74e-467e407c9a6f",
                                        "entry_id": "1cea6360-a9a8-3599-acf0-730ec08c24bb",
                                        "glosses": [
                                            "Containing no mistakes.",
                                            "Of a book, manuscript, etc.: having no textual errors."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d491288-b199-3d68-ade2-bae00347a634",
                                        "entry_id": "1cea6360-a9a8-3599-acf0-730ec08c24bb",
                                        "glosses": [
                                            "Free from sin; morally pure; sinless."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a240a17b-607b-4d84-8858-04f4785a1db2",
                                                "sense_id": "3d491288-b199-3d68-ade2-bae00347a634",
                                                "text": "Alas! vve have made a nevv faith; vve have exchanged piety for impiety; vve have betrayed the immaculate ſacrifice [of Jesus]; […]"
                                            },
                                            {
                                                "example_id": "1d86dd2f-3f00-48bf-bdd7-c88ca6c0e64a",
                                                "sense_id": "3d491288-b199-3d68-ade2-bae00347a634",
                                                "text": "Take not thy flight ſo ſoone immaculate ſpirit."
                                            },
                                            {
                                                "example_id": "ad387aff-2d37-4db7-b6e0-2a2be0080ad6",
                                                "sense_id": "3d491288-b199-3d68-ade2-bae00347a634",
                                                "text": "Were but my ſoul as pure / From other guilts as that, Heaven did not hold / One more immaculate."
                                            },
                                            {
                                                "example_id": "c8f64be9-3110-404f-83c9-0268bb33192e",
                                                "sense_id": "3d491288-b199-3d68-ade2-bae00347a634",
                                                "text": "And this Life is pure and immaculate Love, and this Love is God, as he is communicable unto man, and is the ſole Life and Eſſence of Vertue truly ſo called; […]"
                                            },
                                            {
                                                "example_id": "0301491c-bafd-472b-a74c-48ac81eeb91b",
                                                "sense_id": "3d491288-b199-3d68-ade2-bae00347a634",
                                                "text": "The VVorld's infectious; fevv bring back at Eve / Immaculate, the Manners of the Morn."
                                            },
                                            {
                                                "example_id": "49ecfe17-4efd-4fde-bba6-a62e1c082470",
                                                "sense_id": "3d491288-b199-3d68-ade2-bae00347a634",
                                                "text": "That immaculate manliness we feel within ourselves, so far within us, that it remains intact though all the outer character seem gone; bleeds with keenest anguish at the undraped spectacle of a valor-ruined man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e62f402-d350-3d04-b51f-fd1db29b2846",
                                        "entry_id": "1cea6360-a9a8-3599-acf0-730ec08c24bb",
                                        "glosses": [
                                            "Of the Virgin Mary or her womb: pure, undefiled."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "337e521f-a508-3266-9b35-58d02e5bd6e7",
                                        "entry_id": "1cea6360-a9a8-3599-acf0-730ec08c24bb",
                                        "glosses": [
                                            "Lacking blotches, spots, or other markings."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60fc69f7-41f5-4758-9c11-6cfb4264d2b3",
                        "source_entry_id": "ddf238c1-9cd9-3375-8f5c-644edf8f42f0",
