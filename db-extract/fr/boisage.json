                ],
                "senses": [
                    {
                        "sense_id": "15c2ac30-f81f-3aa5-91bf-2f8c96ded384",
                        "entry_id": "0bac3b8a-1e29-3eb4-80cb-05d9876bb56d",
                        "glosses": [
                            "Action de boiser."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "89246744-ac6e-3ccc-ba63-45a1c2c7f26b",
                        "entry_id": "0bac3b8a-1e29-3eb4-80cb-05d9876bb56d",
                        "glosses": [
                            "Ensemble des étais en bois qui soutiennent les galeries de mines et des fouilles."
                        ],
                        "tags": [
                            "Industrie minière"
                        ],
                        "examples": [
                            {
                                "example_id": "a3258e9d-c520-4d55-8465-c96bdbc255dc",
                                "sense_id": "89246744-ac6e-3ccc-ba63-45a1c2c7f26b",
                                "text": "Il y avait aussi des rats qui couraient partout et des chauves-souris cramponnées aux boisages par leurs pieds, la tête en bas."
                            }
                        ]
                    },
                    {
                        "sense_id": "efa68a1e-e865-3390-8ae6-0ba0478460c9",
                        "entry_id": "0bac3b8a-1e29-3eb4-80cb-05d9876bb56d",
                        "glosses": [
                            "Technique de menuiserie destinée à retenir les terres lors du creusement de tranchées ou de galeries de mine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae23e94e-dee6-4cbd-88db-8ca1d4cd41f4",
                                "sense_id": "efa68a1e-e865-3390-8ae6-0ba0478460c9",
                                "text": "Les galeries, qui forment avec les puits l’ensemble de l’édifice souterrain d’une mine, sont horizontales ou inclinées, et généralement à sections relativement petites. Là encore, le défaut de solidité du terrain est combattu par un boisage ou un muraillement. Ce dernier mode de soutènement, naturellement plus cher, mais aussi d’une durée indéfinie, est réservé pour les galeries de roulage et d’écoulement qui doivent servir longtemps."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c4ce1ba-1fe9-393b-a4ff-d8f6cfe95a73",
                        "entry_id": "0bac3b8a-1e29-3eb4-80cb-05d9876bb56d",
                        "glosses": [
                            "Décoration intérieure des murs et plafonds d’une pièce d’habitation en les recouvrant de bois."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fc1f7560-8b03-38f3-b5b5-915d3c7dd014",
                        "entry_id": "0bac3b8a-1e29-3eb4-80cb-05d9876bb56d",
                        "glosses": [
                            "En vinification, phénomène par lequel le vin stocké dans des barriques (de chêne) prend le goût du bois."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "49befb0b-5804-3bb6-957d-80ca4e6f3f1d",
                        "entry_id": "0bac3b8a-1e29-3eb4-80cb-05d9876bb56d",
                        "glosses": [
                            "En vinification, procédé artificiel qui consiste à rajouter des copeaux ou de la sciure dans des cuves de vin pour obtenir un goût boisé."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
