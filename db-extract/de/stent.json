                "senses": [
                    {
                        "sense_id": "de56cce0-3394-320a-ade8-a37b9541d486",
                        "entry_id": "cbe3a2e9-9339-3cdc-bc25-1787e00ab658",
                        "glosses": [
                            "Hilfsmittel zur Erweiterung eines Gefäßes oder Hohlorgans, meist in Form einer Röhre und aus Metall, das von einem Chirurgen eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d45d342-4701-4657-aa0b-043580386213",
                                "sense_id": "de56cce0-3394-320a-ade8-a37b9541d486",
                                "text": "[Bei einem Herzinfarkt] hilft, wenn der Patient überlebt, oft nur noch ein sogenannter Stent, ein kleines Röhrchen, das mit einem Katheter an die verstopfte Stelle geschoben wird."
                            },
                            {
                                "example_id": "fb5e6094-ff38-4d33-adff-49a72a75a9cc",
                                "sense_id": "de56cce0-3394-320a-ade8-a37b9541d486",
                                "text": "Die Ärzte [müssen] einen Gefäßverschluss behandeln und möglicherweise einen Stent einsetzen, teilte der 73-Jährige [Thomas Markle …] mit."
                            },
                            {
                                "example_id": "409d6958-4f5c-4821-bb40-04a6e20e847c",
                                "sense_id": "de56cce0-3394-320a-ade8-a37b9541d486",
                                "text": "Der Mikrokatheter ist extrem dünn - etwa einen halben Millimeter, und aus diesem Katheter wird sozusagen eine Art Innenleben vorgeschoben, ein zusammengefalteter Stent, ein winziges Metallgeflecht."
                            },
                            {
                                "example_id": "b080d1d7-753b-45e7-b5ec-c17408f3f3be",
                                "sense_id": "de56cce0-3394-320a-ade8-a37b9541d486",
                                "text": "Sich langsam auflösende Stents aus Milchsäure sollen kranke Gefäße auf Dauer offen halten."
                            },
                            {
                                "example_id": "58629a6b-1135-45ae-8043-45fbf6f9c644",
                                "sense_id": "de56cce0-3394-320a-ade8-a37b9541d486",
                                "text": "Nachdem der Stent in den Körper eingepflanzt wurde, setzt der Kunststoff sukzessive diese Medikamente frei."
                            },
                            {
                                "example_id": "9612e608-898b-48f0-b5e6-f30e53552cab",
                                "sense_id": "de56cce0-3394-320a-ade8-a37b9541d486",
                                "text": "Bei einigen Patienten können winzige Röhrchen aus hauchdünnem Titan (\"Stents\") den Augendruck senken und dadurch die Ursache des Glaukoms beseitigen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f903d6d9-a2b8-45d9-9daf-076219cff497",
                        "source_entry_id": "cbe3a2e9-9339-3cdc-bc25-1787e00ab658",
                        "source_sense_id": "de56cce0-3394-320a-ade8-a37b9541d486",
                        "source_sense_description": "Hilfsmittel zur Erweiterung eines Gefäßes oder Hohlorgans, das von einem Chirurgen eingesetzt wird",
                        "target_lang_word": "stent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9b429f4-2afd-3ff5-a847-cf1bd277fafa",
                                        "entry_id": "0146108c-4cf6-321c-915a-73d23d516b05",
                                        "glosses": [
                                            "A slender tube inserted into a blood vessel, a ureter or the oesophagus in order to provide support and to prevent disease-induced closure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df13ddfe-ed4f-47f8-9e60-2eaf48e67fd5",
                                                "sense_id": "e9b429f4-2afd-3ff5-a847-cf1bd277fafa",
                                                "text": "Tiny metal sleeves placed in arteries to keep blood flowing, stents have become such a popular quick fix for clogged coronary vessels that Americans will receive more than 1.5 million of them this year."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "485c9dfd-124c-37eb-b667-4d7510d4da62",
                                        "entry_id": "9048c574-4378-30de-807c-75cf688e0b5f",
                                        "glosses": [
                                            "To insert a stent or tube into a blood vessel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "939ddf08-e9de-3e05-b2df-7a301d507e57",
                                        "entry_id": "413c71e9-629b-3885-bccf-94e0d8fb1fde",
                                        "glosses": [
                                            "An allotted portion; a stint."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3675f0c5-0061-4732-9c2f-234289156017",
                                                "sense_id": "939ddf08-e9de-3e05-b2df-7a301d507e57",
                                                "text": "The hundred-and-oneth stitch was my stent, and it's done. I'm not ever going to take the hundred and twoth. I've decided."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "194bba65-3ac8-3f83-836b-8c0398bb865f",
                                        "entry_id": "af61a481-04ed-3b07-8d88-539bf0a3a2db",
                                        "glosses": [
                                            "To keep within limits; to restrain; to cause to stop, or cease; to stint."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a099a404-1ca1-42ef-b429-c3d2f1002650",
                                                "sense_id": "194bba65-3ac8-3f83-836b-8c0398bb865f",
                                                "text": "Yet n'ould she stent / Her bitter railing and foule revilement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5773d58b-28f9-3c0d-87b5-4bfee16715f8",
                                        "entry_id": "af61a481-04ed-3b07-8d88-539bf0a3a2db",
                                        "glosses": [
                                            "To stint; to stop; to cease."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
