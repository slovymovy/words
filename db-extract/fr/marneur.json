                "senses": [
                    {
                        "sense_id": "ebfa45ad-be85-3c18-a141-f77c1fa3916f",
                        "entry_id": "5851fc66-1e79-3cc0-b169-ad07cedcd9c8",
                        "glosses": [
                            "Synonyme de marneron, ouvrier qui travaille dans une marnière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b359e95-b8c1-4602-95bd-425a653c7abc",
                                "sense_id": "ebfa45ad-be85-3c18-a141-f77c1fa3916f",
                                "text": "Le marneur, par la nature de son travail, tient un peu de la famille des troglodytes."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a49762d-4be9-31e8-b34e-5b80914873ba",
                        "entry_id": "5851fc66-1e79-3cc0-b169-ad07cedcd9c8",
                        "glosses": [
                            "Ouvrier qui répand la marne comme amendement sur les champs."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "330e08f9-3d47-49ad-9680-323bb67f7262",
                                "sense_id": "7a49762d-4be9-31e8-b34e-5b80914873ba",
                                "text": "Cette troupe joyeuse composait la famille d’un paysan du village voisin, dont le métier était de transporter des marnes dans les terres arables …. Le marneur, perché sur une ânesse en chaleur, assaillait à coups de bâton la bête incivile ; …."
                            }
                        ]
                    },
                    {
                        "sense_id": "3243d82f-8a99-3213-9c72-eee5f746be13",
                        "entry_id": "5851fc66-1e79-3cc0-b169-ad07cedcd9c8",
                        "glosses": [
                            "Travailleur, ouvrier."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d81610c5-c79a-4675-9c61-41a0e369e10d",
                                "sense_id": "3243d82f-8a99-3213-9c72-eee5f746be13",
                                "text": "Des marneurs de grand style, passés pros depuis belle lurette, vont au turbin, sans joie, en tétant leur première gauloise, cependant que la leur finit un rêve consacré à Georges Guétary."
                            }
                        ]
                    }
