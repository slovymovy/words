                        "sense_id": "bba0adbd-5d6d-3e58-8195-0a3a849693a3",
                        "entry_id": "e946e1e1-d12e-3a19-805f-6a8352ffd561",
                        "glosses": [
                            "To dismiss (a suit or plaintiff) on the grounds of his or her lawsuit having been brought without cause, prior to an adjudication on the merits."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "235702de-9212-4a81-8f2f-71b7875f447d",
                                "sense_id": "bba0adbd-5d6d-3e58-8195-0a3a849693a3",
                                "text": "[W]here an appeal is brought at the ſuit of the party, and the plaintiff is nonſuit upon that appeal, yet the offender ſhall be arraigned at the king's ſuit upon ſuch appeal; […]"
                            },
                            {
                                "example_id": "1a8c5436-23d5-4933-937d-67a08f86b40b",
                                "sense_id": "bba0adbd-5d6d-3e58-8195-0a3a849693a3",
                                "text": "In short, the attorney was nonsuited, to the satisfaction of all who knew him […]."
                            },
                            {
                                "example_id": "190c2145-ba12-4b39-92f2-901945922b40",
                                "sense_id": "bba0adbd-5d6d-3e58-8195-0a3a849693a3",
                                "text": "he shall be nonsuited , and pay cost to the defendant"
                            }
                        ]
                    }
