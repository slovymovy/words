                ],
                "senses": [
                    {
                        "sense_id": "afe7be73-2d9b-3caf-bdb2-713c286d1206",
                        "entry_id": "039fdec1-0765-37d1-ae1f-398ce3c4494b",
                        "glosses": [
                            "(abgezogenes) Fell eines Kojoten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7da7948e-c3ee-41d1-9c41-95b32d9a80e9",
                                "sense_id": "afe7be73-2d9b-3caf-bdb2-713c286d1206",
                                "text": "„Es gibt zum Beispiele Modelle aus Straußen- und Marabufedern oder aus Kojotenfell mit bestickten Intarsien.“"
                            },
                            {
                                "example_id": "43aa78ee-51cb-4232-b482-fdb5f7109e3d",
                                "sense_id": "afe7be73-2d9b-3caf-bdb2-713c286d1206",
                                "text": "„Beuys selber hätte sich wohl in einem Bildnis für die Nachwelt, wenn es schon ohne Hut, Weste oder Kojotenfell sein müsste, lieber als Hasen dargestellt gesehen.“"
                            },
                            {
                                "example_id": "e2607d1b-c51a-49bc-8c14-90ae9f602922",
                                "sense_id": "afe7be73-2d9b-3caf-bdb2-713c286d1206",
                                "text": "„Überraschend viele Gesichter sind in Kojotenfell eingepackt. Der Kojote ist ein wolfsähnliches Wesen, das sich gar nicht so sehr von dem Hund unterscheidet, den der Träger der Pelzkragenjacke gewöhnlich an der Leine mit sich führt.“"
                            },
                            {
                                "example_id": "7579496d-c847-4331-a57d-3c4c35713a32",
                                "sense_id": "afe7be73-2d9b-3caf-bdb2-713c286d1206",
                                "text": "„Der andere Treiber, mit einem Kojotenfell bekleidet, musste ständig hinter der Herde hin und her laufen, um die Herde in die gewünschte Richtung zu treiben.“"
                            },
                            {
                                "example_id": "85f1a555-f129-4e7b-94a0-888d79f73257",
                                "sense_id": "afe7be73-2d9b-3caf-bdb2-713c286d1206",
                                "text": "„Die Designer schwelgen im Rausch der Ornamente. Mäntel schmücken sich mit Straußenfedern und Kojotenfell, Leder wird plissiert, und der hohe Fransenstiefel feiert ein Comeback.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
