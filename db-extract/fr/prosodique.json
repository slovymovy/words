                    {
                        "translation_id": "6a5840db-0375-4f7e-b5fe-b751ba2c0f0c",
                        "source_entry_id": "2a7d2c5e-1941-307a-856b-ef844c197afa",
                        "source_sense_id": "0aa4a2a4-ec2e-314a-9f08-64514f7a7dd7",
