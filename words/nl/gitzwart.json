                            {
                                "target_lang_word": "jet-black",
                                "target_lang_sense_clarification": "extremely dark or black"
                            },
                            {
                                "target_lang_word": "pitch-black",
                                "target_lang_sense_clarification": "completely dark or black"
                            }
                        ]
                    }
                },
                {
