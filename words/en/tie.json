                            {
                                "target_lang_word": "завязка",
                                "target_lang_sense_clarification": "шнурок или лента для мешка"
                            },
                            {
                                "target_lang_word": "крепление",
                                "target_lang_sense_clarification": "общее название фиксатора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcf1a80f-0c53-365f-ac72-cfe2bbe67fbd",
                    "sense_definition": "A specific match or meeting between two teams in a tournament.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The upcoming cup <w>tie</w> against the local rivals will be very exciting.",
                            "target_lang_translations": {
                                "ru": "Предстоящий кубковый <w>матч</w> против местных соперников будет очень захватывающим."
                            }
