                ],
                "senses": [
                    {
                        "sense_id": "074b2d4b-6bab-3d1f-9935-a76ddc8633ca",
                        "entry_id": "2bf4d3b9-b10b-3731-ad02-8b2c4122da58",
                        "glosses": [
                            "Déesses messagères d’Odin, qui conduisaient au Walhalla, ou paradis d’Odin, les héros morts sur le champ de bataille, chez les anciens Scandinaves."
                        ],
                        "tags": [
                            "Mythologie nordique"
                        ],
                        "examples": [
                            {
                                "example_id": "27de3fa2-e364-4f44-b382-41e5ef0d707d",
                                "sense_id": "074b2d4b-6bab-3d1f-9935-a76ddc8633ca",
                                "text": "D’ailleurs, il ne se crée plus de légendes au déclin de ce pratique et positif dix-neuvième siècle, ni en Bretagne, la contrée des farouches korrigans, ni en Écosse, la terre des brownies et des gnomes, ni en Norvège, la patrie des ases, des elfes, des sylphes et des valkyries, ni même en Transylvanie, où le cadre des Carpathes se prête si naturellement à toutes les évocations psychagogiques."
                            },
                            {
                                "example_id": "3f3f8c7c-f73d-4482-a756-1d875996e0fb",
                                "sense_id": "074b2d4b-6bab-3d1f-9935-a76ddc8633ca",
                                "text": "Vers le sud, à cent mètres environ au-dessus des eaux, chevauchant, telles des Valkyries, les étranges montures dont la mécanique européenne avait été l’inspiratrice, les Japonais s’avançaient sur leurs monoplans rouges."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4543c00-5dd0-37ac-8b2e-2f5c7a485110",
                        "entry_id": "2bf4d3b9-b10b-3731-ad02-8b2c4122da58",
                        "glosses": [
                            "Femme à l’allure guerrière."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fa6b2689-f2bd-4aa2-9807-d8dc93a7daee",
                                "sense_id": "a4543c00-5dd0-37ac-8b2e-2f5c7a485110",
                                "text": "Croyez-vous qu’il ne se soit pas déjà consolé avec une autre valkyrie, de la mort de celle-là ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0ef4eb8-f2c5-4584-afc9-930070c90a49",
                        "source_entry_id": "2bf4d3b9-b10b-3731-ad02-8b2c4122da58",
                        "target_lang_word": "Walküre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Walküre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e782f4e8-1dd3-3391-9059-b9292ca32cfd",
                                        "entry_id": "1c566649-3e2b-337c-9e3e-dc102ce2b317",
                                        "glosses": [
                                            "weibliche Sagengestalt der nordischen Mythologie, die ehrenvoll Gefallene nach Walhall bringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beecaeda-7deb-478e-a36f-edcc7818fe72",
                                                "sense_id": "e782f4e8-1dd3-3391-9059-b9292ca32cfd",
                                                "text": "Die Walküren geleiten die Einherier, die ehrenvoll Gefallenen, ins Totenreich Walhall."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
