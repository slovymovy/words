                "senses": [
                    {
                        "sense_id": "1e7df0c1-c603-32a7-bb58-5e33bd59d70b",
                        "entry_id": "14b9c4d5-c850-3ba0-9f26-2bc02b5eb7db",
                        "glosses": [
                            "Obtenir l’exposant qu’il faut appliquer au deuxième terme de l’opération pour obtenir le premier (64 exponenté par 4 est égal à 3 car 64 = 4³)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a0baa1f-e3e6-4713-8b9d-e864eece18a1",
                                "sense_id": "1e7df0c1-c603-32a7-bb58-5e33bd59d70b",
                                "text": "Exponenter 64 par 4, par exemple, c’est chercher combien de fois 4 est facteur de 64."
                            }
                        ]
                    },
                    {
                        "sense_id": "6771962a-6eca-39b6-9714-71e0cd3ccdcf",
                        "entry_id": "14b9c4d5-c850-3ba0-9f26-2bc02b5eb7db",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07f7f74d-793f-459f-8809-f277d05fe4bc",
                                "sense_id": "6771962a-6eca-39b6-9714-71e0cd3ccdcf",
                                "text": "Il pose, il s’expose, il s’exponente dans tout ce qu’il dit, pense, rêve, accomplit et désaccomplit."
                            }
                        ]
                    }
