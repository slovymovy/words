                ],
                "senses": [
                    {
                        "sense_id": "29b54678-c6db-30e5-ac30-7c7ee39b1795",
                        "entry_id": "b6dea339-4d2e-347a-a6d0-ab04b36e2124",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a778014-dc81-49f5-99c5-e9262dc5398b",
                                "sense_id": "29b54678-c6db-30e5-ac30-7c7ee39b1795",
                                "text": "Frau Ulrichs ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "040d1ca5-d9a2-49fc-a156-6a5cef19f7e4",
                                "sense_id": "29b54678-c6db-30e5-ac30-7c7ee39b1795",
                                "text": "Herr Ulrichs wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3110aaa2-820c-4191-b58b-29809cd6d3ca",
                                "sense_id": "29b54678-c6db-30e5-ac30-7c7ee39b1795",
                                "text": "Die Ulrichsens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5d6462ab-f33a-4f41-83e9-fcffd81a2375",
                                "sense_id": "29b54678-c6db-30e5-ac30-7c7ee39b1795",
                                "text": "Der Ulrichs trägt nie die Schals, die die Ulrichs ihm strickt."
                            },
                            {
                                "example_id": "50921665-d481-45a8-8e94-1a98773f64eb",
                                "sense_id": "29b54678-c6db-30e5-ac30-7c7ee39b1795",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ulrichs kommt, geht der Herr Ulrichs.“"
                            },
                            {
                                "example_id": "1a3cf8dc-23ab-4501-b20c-b42f73878103",
                                "sense_id": "29b54678-c6db-30e5-ac30-7c7ee39b1795",
                                "text": "Ulrichs kommt und geht."
                            },
                            {
                                "example_id": "aa19a95c-c12e-4222-8150-4ade4c64c08e",
                                "sense_id": "29b54678-c6db-30e5-ac30-7c7ee39b1795",
                                "text": "Ulrichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
