                        "zh": "在小程度上；有一点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "немного",
                                "target_lang_sense_clarification": "слегка"
                            },
                            {
                                "target_lang_word": "чуть-чуть",
                                "target_lang_sense_clarification": "совсем немного"
                            },
                            {
                                "target_lang_word": "слегка",
                                "target_lang_sense_clarification": "в малой степени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有点",
                                "target_lang_sense_clarification": "稍微；有一点"
                            },
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "数量或程度都可用"
                            },
                            {
                                "target_lang_word": "稍微",
                                "target_lang_sense_clarification": "较正式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4af8aed-0a19-3b42-9552-6e36ea577506",
                    "sense_definition": "The smallest unit of data in a computer, having a value of either 0 or 1.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A byte is composed of eight <w>bits</w>.",
                            "target_lang_translations": {
                                "ru": "Байт состоит из восьми <w>битов</w>.",
                                "zh": "一个字节由八个<w>比特</w>组成。"
                            }
                        },
                        {
                            "text": "The new processor can handle 64 <w>bits</w> of data at once.",
                            "target_lang_translations": {
                                "ru": "Новый процессор может обрабатывать 64 <w>бита</w> данных одновременно.",
                                "zh": "这款新处理器一次可以处理64<w>位</w>数据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "binary digit"
                    ],
                    "common_phrases": [
                        "bit rate",
                        "bit depth"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наименьшая единица данных в компьютере, имеющая значение 0 или 1.",
                        "zh": "计算机中最小的数据单位，取值只能是0或1。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бит",
                                "target_lang_sense_clarification": "единица информации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "比特",
                                "target_lang_sense_clarification": "计算机中最小的信息单位"
                            },
                            {
                                "target_lang_word": "位",
                                "target_lang_sense_clarification": "计算机术语简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f1a312a-00a2-386b-99b4-6a08aed73cae",
