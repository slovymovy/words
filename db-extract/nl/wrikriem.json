                                        "glosses": [
                                            "To row a boat using a scull or sculls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36fb2e73-44ce-44e4-a15d-48c0c4728c23",
                                                "sense_id": "1653c256-6b93-372c-9c10-0ec9a597acb2",
                                                "text": "The afternoon sun was getting low as the Rat sculled gently homewards in a dreamy mood, murmuring poetry-things over to himself, and not paying much attention to Mole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf77bf00-9731-3f61-96f6-dcb217ef6366",
