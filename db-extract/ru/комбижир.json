                "senses": [
                    {
                        "sense_id": "4b4710d1-050c-3d95-94b8-ed68e585aedf",
                        "entry_id": "06df68eb-891e-312b-934f-f19f9521a46f",
                        "glosses": [
                            "комбинированный кухонный маргарин"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a26e8dd-e740-4666-8270-a401aff34439",
                                "sense_id": "4b4710d1-050c-3d95-94b8-ed68e585aedf",
                                "text": "Если кто не в курсе, комбижир (гидрогенезированный жир) в основном скармливают солдатам в армии."
                            },
                            {
                                "example_id": "1203acc8-53e8-4cac-8fb0-8f58f4343936",
                                "sense_id": "4b4710d1-050c-3d95-94b8-ed68e585aedf",
                                "text": "А под благозвучным названием кондитерский жир, кулинарный жир, или шортенинг, комбижир скармливают всему остальному населению."
                            }
                        ]
                    }
