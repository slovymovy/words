                "senses": [
                    {
                        "sense_id": "24717acc-7d03-3827-a9b9-7db8c9221fa8",
                        "entry_id": "cc26ec68-e512-30ca-88f5-952c1dea0e33",
                        "glosses": [
                            "минер., старин. то же, что асбест"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f94f5af-a42e-4802-9d96-03221f010c8c",
                                "sense_id": "24717acc-7d03-3827-a9b9-7db8c9221fa8",
                                "text": "Государь понимает уже, что то обман, повелевает лоскут тот принести к себе, и доказывает тому же собранию, что они обмануты плутом, и что мнимая та святыня есть соткана из амианта (каменного льна), которой не сгорает, и проч."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78e8148b-dd0a-4e20-bbea-5829cf6283ab",
                        "source_entry_id": "cc26ec68-e512-30ca-88f5-952c1dea0e33",
                        "source_sense_id": "24717acc-7d03-3827-a9b9-7db8c9221fa8",
                        "target_lang_word": "amiante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amiante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81c2d804-2f8f-311b-bf3f-1bb48426290e",
                                        "entry_id": "548c70b4-9eb3-3bdc-84a0-60e741e1527a",
                                        "glosses": [
                                            "Terme générique désignant des silicates filamenteux dont une serpentine et cinq amphiboles dont on faisait de la toile et des mèches incombustibles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fcf13d1-6e62-4dc0-a8ba-32472294edd1",
                                                "sense_id": "81c2d804-2f8f-311b-bf3f-1bb48426290e",
                                                "text": "L’amiante est incombustible et infusible ; ce qui fait qu’on en fait des étoffes permettant d’être utilisées contre le feu, […]."
                                            },
                                            {
                                                "example_id": "1150451c-b9ec-4d3b-9036-ecfd93e3ed00",
                                                "sense_id": "81c2d804-2f8f-311b-bf3f-1bb48426290e",
                                                "text": "Ce fourneau tenait le centre d’une seconde pièce, d’une grandeur double de la première, et que le prince n’avait pas aperçue, masquée qu’elle était par le rideau d’amiante."
                                            },
                                            {
                                                "example_id": "6258be15-91a5-4df6-919e-4b1119af7907",
                                                "sense_id": "81c2d804-2f8f-311b-bf3f-1bb48426290e",
                                                "text": "L’amiante, classé cancérogène depuis les années 1970, peut se retrouver à proximité lorsque le talc est extrait des mines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
