                                "sense_id": "6b95ae06-624a-379e-955e-6ac2927e6851",
                                "text": "reparative justice"
                            },
                            {
                                "example_id": "90b73ae3-622c-4503-aa62-359e472e9962",
                                "sense_id": "6b95ae06-624a-379e-955e-6ac2927e6851",
                                "text": "Intended for offenders of misdemeanor or nonviolent felony crimes, the Reparative Probation Program directly involves community members meeting face to face with offenders to negotiate a “reparative agreement” that specifies how offenders will make reparation to their victims and other community members."
                            },
                            {
                                "example_id": "a8a43f09-8e21-4cef-a0c9-4548c7a9e3c4",
                                "sense_id": "6b95ae06-624a-379e-955e-6ac2927e6851",
                                "text": "[…] social media was ablaze for days in anticipation of this month’s Atlantic cover story arguing in favor of reparative payments to African-Americans for state-sanctioned slavery and segregation."
                            }
                        ]
                    }
