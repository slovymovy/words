                "senses": [
                    {
                        "sense_id": "4fd1fb2f-bd63-361d-b25d-c6a7e027b78d",
                        "entry_id": "0c4d188d-6786-3d6d-934a-b545ad9c3ef4",
                        "glosses": [
                            "Gesamtheit der Arzneimittel, die nach einer stationären Behandlung eingenommen werden sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8105f09-5207-4a66-bf26-0c9d2fd455c5",
                                "sense_id": "4fd1fb2f-bd63-361d-b25d-c6a7e027b78d",
                                "text": "„Die Durchführung der Arzneimittelanamnese durch die Apotheke und die Erstellung von Empfehlungen zur Entlassmedikation optimiert die Betreuung der Patienten an den Schnittstellen ambulant-stationär-ambulant.“"
                            },
                            {
                                "example_id": "dc93a41f-1d44-4f07-b734-8503062293e4",
                                "sense_id": "4fd1fb2f-bd63-361d-b25d-c6a7e027b78d",
                                "text": "„Erste gute Erfolge können hierzu beim Überleitungsmanagement oder Arzneimittelmanagement im Zuge stationärer Entlassmedikationen verzeichnet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
