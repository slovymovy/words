                    },
                    {
                        "form_id": "70a3f252-ff5e-4dbc-a0a5-3d1c638b012b",
                        "entry_id": "cb5799b4-9c5e-3eae-b274-2d9ab5643ae9",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Würfelspiel"
                    },
                    {
                        "form_id": "5893a90b-9f71-489a-bc9d-d25be69887f7",
                        "entry_id": "cb5799b4-9c5e-3eae-b274-2d9ab5643ae9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Würfelspiele"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "09e7fad5-a928-3a59-8e45-3849b17dffd9",
                        "entry_id": "cb5799b4-9c5e-3eae-b274-2d9ab5643ae9",
                        "glosses": [
                            "ein Spiel, das mit einem oder mehreren Würfeln gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3472c8-2bd9-44aa-8ca0-e12e4058b3a4",
                                "sense_id": "09e7fad5-a928-3a59-8e45-3849b17dffd9",
                                "text": "Mensch-Ärgere-Dich-Nicht ist auch ein Würfelspiel."
                            },
                            {
                                "example_id": "bd7b533f-dcfb-4577-b5e8-d5f64f2881fb",
                                "sense_id": "09e7fad5-a928-3a59-8e45-3849b17dffd9",
                                "text": "„Simen Tjing und Jing Bo-djau hatten sich zunächst die Festbeleuchtung in der Stadt angesehen, dann waren sie in das Haus gekommen, hatten sich in das obere Stockwerk begeben und sich aufs Würfelspiel verlegt.“"
                            },
                            {
                                "example_id": "243df37d-0aad-402a-85db-da380512284b",
                                "sense_id": "09e7fad5-a928-3a59-8e45-3849b17dffd9",
                                "text": "„Bei unserer Heimkehr trafen wir Crosin und Conti, die auch gewonnen hatten, Conti etwa zwanzig Louis im Pharao und Crosin hundert und mehr Guineen beim Würfelspiel in einem englischen Klub, in den er, wie weiß ich nicht mehr, eingeführt worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "355f0117-29fa-497f-9a81-f989cefc0681",
                        "source_entry_id": "cb5799b4-9c5e-3eae-b274-2d9ab5643ae9",
                        "source_sense_id": "09e7fad5-a928-3a59-8e45-3849b17dffd9",
                        "source_sense_description": "ein Spiel, das mit einem oder mehreren Würfeln gespielt wird",
                        "target_lang_word": "dice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f695bb-295c-3a74-abd5-9d79df4d8833",
                                        "entry_id": "a2137a58-b916-3307-901f-114b31fe4137",
                                        "glosses": [
                                            "Gaming with one or more dice."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d568c2b4-52eb-43d7-84db-a79b97700e39",
                                                "sense_id": "f8f695bb-295c-3a74-abd5-9d79df4d8833",
                                                "text": "Or think of a decent young citizen in a toga—perhaps too much dice, you know—coming out here in the train of some prefect, or tax-gatherer, or trader even, to mend his fortunes."
                                            },
                                            {
                                                "example_id": "d5e9aee4-66f8-4654-9c27-34824d962064",
                                                "sense_id": "f8f695bb-295c-3a74-abd5-9d79df4d8833",
                                                "text": "On the other hand, evolution is not a matter of chance, even in the sense in which a game of dice is a game of chance."
                                            },
                                            {
                                                "example_id": "5fb193c0-addc-40fd-8a9c-6d707814ad71",
                                                "sense_id": "f8f695bb-295c-3a74-abd5-9d79df4d8833",
                                                "text": "I, at any rate, am convinced that He is not playing at dice."
                                            },
                                            {
                                                "example_id": "3a5b5128-037e-4658-9710-3d9dd2dfe37c",
                                                "sense_id": "f8f695bb-295c-3a74-abd5-9d79df4d8833",
                                                "text": "The problem is that no one can throw a die twice in precisely the same way, and this is why dice is a game of chance and not a skill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fd5cdac-9303-333d-b9eb-a2ef61bc6d39",
                                        "entry_id": "a2137a58-b916-3307-901f-114b31fe4137",
                                        "glosses": [
                                            "A die."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45b608e7-a660-4de3-a74a-acc0184d103c",
                                                "sense_id": "3fd5cdac-9303-333d-b9eb-a2ef61bc6d39",
                                                "text": "1980, Benny Andersson and Björn Ulvaeus, “The Winner Takes It All”, Super Trouper, Polar Music\nThe gods may throw a dice / Their minds as cold as ice"
                                            },
                                            {
                                                "example_id": "f7f4e375-8ca4-4736-85a0-d458662fe8c3",
                                                "sense_id": "3fd5cdac-9303-333d-b9eb-a2ef61bc6d39",
                                                "text": "A white house set like a dice on a rock already venerable with the scars of wind and water."
                                            },
                                            {
                                                "example_id": "19977935-1362-4cfc-b030-1b20a455ba42",
                                                "sense_id": "3fd5cdac-9303-333d-b9eb-a2ef61bc6d39",
                                                "text": "When we see a dice, we see an object which has six sides, some of which can be seen from where we are, others can be seen if we twist it or move around it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "378c8fbf-c0d0-3644-aded-d57347e39566",
                                        "entry_id": "a2137a58-b916-3307-901f-114b31fe4137",
                                        "glosses": [
                                            "That which has been diced."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9a07fcb-9b09-4edf-9721-01c4a931d34f",
                                                "sense_id": "378c8fbf-c0d0-3644-aded-d57347e39566",
                                                "text": "Cut onions, carrots and celery into medium dice."
                                            },
                                            {
                                                "example_id": "2ef36559-4efe-470e-b104-a0aded8911a7",
                                                "sense_id": "378c8fbf-c0d0-3644-aded-d57347e39566",
                                                "text": "If your worship is inclined to take a small draught of good wine, though not very cool, I have here a calabash full of the best, and some dices of Tronchon cheese"
                                            }
                                        ]
                                    }
                                ]
                            },
