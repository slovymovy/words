                "senses": [
                    {
                        "sense_id": "75223354-d7df-3033-bcc3-703ac69cff53",
                        "entry_id": "6ca6a9aa-ed5c-3cab-8354-34bcea7336b9",
                        "glosses": [
                            "op een heel uitgesproken, extreme, fanatieke manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e0b143-bd19-479a-9314-7f15d196e053",
                                "sense_id": "75223354-d7df-3033-bcc3-703ac69cff53",
                                "text": "Zoals ze weleens zeggen: van boven lijk ik op mijn moeder en van onder op mijn vader. Nee, ik draag de familienaam, maar verder lijk ik in weinig op hem. Het was een goudeerlijke man, maar fanatisch links. En dat ben ik niet."
                            },
                            {
                                "example_id": "296e995a-6d6a-4902-9651-74f7aadfdd3d",
                                "sense_id": "75223354-d7df-3033-bcc3-703ac69cff53",
                                "text": "Bijzonder knap is hoe de auteurs in hun boek deze urgentie overbrengen. Dat geeft vaart en kracht aan het boek. De lezer ziet telkens weer die vreselijke T-splitsing op zich afkomen. Maar het geeft dit pamflet ook iets fanatisch, met uitdrukkingen als „nu of nooit” en „alles of niets.”"
                            }
                        ]
                    }
