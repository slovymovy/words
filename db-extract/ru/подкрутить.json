                "senses": [
                    {
                        "sense_id": "f943f2ac-f928-33e3-8856-6ee13a1f7ad4",
                        "entry_id": "bc137914-7cc8-377a-b037-04481427eb0c",
                        "glosses": [
                            "закрутить дополнительно или слегка, немного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44b279fb-77b4-43dc-bedb-e03d1cccfb84",
                                "sense_id": "f943f2ac-f928-33e3-8856-6ee13a1f7ad4",
                                "text": "Кондратий Петрович подкрутил усы и, обращаясь к Махаладзе предусмотрительно добавил."
                            },
                            {
                                "example_id": "c5429e68-165d-4ea8-84ff-22a11c65ef27",
                                "sense_id": "f943f2ac-f928-33e3-8856-6ee13a1f7ad4",
                                "text": "Пантелей Прокофьевич подкрутил фитиль у лампы, сопя и вздыхая."
                            },
                            {
                                "example_id": "9c7e94bb-2641-400d-a7c6-131b5ff8c387",
                                "sense_id": "f943f2ac-f928-33e3-8856-6ee13a1f7ad4",
                                "text": "― Надо вымыть в керосине, почистить, подкрутить винтики, покрасить, ― сказал Тима."
                            }
                        ]
                    }
