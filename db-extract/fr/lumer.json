                        "entry_id": "a4a5dbd8-9039-3814-9d28-94b195c6cd5c",
                        "glosses": [
                            "Éclairer (une galerie de mine) en utilisant une lampe de mineur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf72b59-7ef3-43e8-ab66-aa5c9a78035f",
                                "sense_id": "81382dea-8489-318f-8fc3-472bfd619fce",
                                "text": "Symbole de toute la corporation minière, la lampe à flamme a lumé le quotidien des mineurs pendant plus de 270 ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "7720c46d-97f4-3ef7-89fd-e2ae35dd27b5",
                        "entry_id": "a4a5dbd8-9039-3814-9d28-94b195c6cd5c",
                        "glosses": [
