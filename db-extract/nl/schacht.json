                                        "entry_id": "d2d0099f-5b5d-3091-b379-9f38c1faad3e",
                                        "glosses": [
                                            "A vertical passage housing a lift or elevator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
