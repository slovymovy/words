                    "synonyms": [
                        "border",
                        "edging",
                        "molding"
                    ],
                    "common_phrases": [
                        "interior trim",
                        "window trim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративный материал или молдинг, используемый вдоль краев или границ чего-либо."
                    },
                    "translations": {
