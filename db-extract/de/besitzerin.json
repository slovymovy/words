                ],
                "senses": [
                    {
                        "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                        "entry_id": "325cfe21-3d38-357e-9f2b-0aa46dcbeb02",
                        "glosses": [
                            "weibliche Person, die etwas in ihrem Besitz hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a92702-be1c-4da7-9da1-3722458d9e8f",
                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                "text": "„Die Besitzerin des Geschäftes umarmte mich zum Abschied und gab mir wieder drei Schillerlocken mit.“"
                            },
                            {
                                "example_id": "4f809061-d331-410a-8de8-3274aca7f639",
                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                "text": "„Nach vielem Hin und Her mit der Besitzerin hatte ich es geschafft, dass im Gästehaus eine Klimaanlage eingebaut wurde.“"
                            },
                            {
                                "example_id": "e7fdbdcf-0cc5-4e7c-8d99-cf6bc58a43bb",
                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                "text": "„Die Besitzerin führte sie in einen Raum hinter dem Laden, der abgeblendet war.“"
                            },
                            {
                                "example_id": "7904b344-faeb-4c40-8529-67f59b32efe5",
                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                "text": "„Eine Woche später waren sie stolze Besitzerinnen eines kleinen blauen Citroën.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25976bd1-595c-4532-8498-47c983e85572",
                        "source_entry_id": "325cfe21-3d38-357e-9f2b-0aa46dcbeb02",
                        "source_sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                        "source_sense_description": "weibliche Person, die etwas in ihrem Besitz hat",
                        "target_lang_word": "κυρία",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "κυρία",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "e69d5948-596f-37e4-94c6-d6b9f693078c",
                                        "entry_id": "83dc0970-3a71-358d-bead-4351ce84c960",
                                        "glosses": [
                                            "ενήλικη γυναίκα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4e563a-2dd9-418c-9e6b-2c202a6dee5d",
                                                "sense_id": "e69d5948-596f-37e4-94c6-d6b9f693078c",
                                                "text": "Τότε μπήκαν στο κατάστημα δύο κυρίες για να ψωνίσουν."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "397c85d4-100c-374b-9521-d123a66945d9",
                                        "entry_id": "83dc0970-3a71-358d-bead-4351ce84c960",
                                        "glosses": [
                                            "λέξη που προτάσσεται πριν από κύρια γυναικεία ονόματα. Παλιότερα αποδιδόταν μόνο σε παντρεμένες γυναίκες, ενώ τώρα αποδίδεται γενικά σε οποιαδήποτε ενήλικη γυναίκα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf439e5-54ea-4691-812a-95a29c93c95c",
                                                "sense_id": "397c85d4-100c-374b-9521-d123a66945d9",
                                                "text": "η κυρία Μαρία, η κυρία Παναγιωτοπούλου"
                                            },
                                            {
                                                "example_id": "dccef034-8af1-43f1-a8d6-1177d0b21996",
                                                "sense_id": "397c85d4-100c-374b-9521-d123a66945d9",
                                                "text": "Η κυρία Τίνα μαζί με την κόρη της, τη Δήμητρα, κάνουν τα ψώνια τους στη λαϊκή αγορά."
                                            },
                                            {
                                                "example_id": "38bcb869-6ea7-42ee-a9ff-d915a88d2f67",
                                                "sense_id": "397c85d4-100c-374b-9521-d123a66945d9",
                                                "text": "συντομογραφία: κ., συχνά στην αλληλογραφία: Κα"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7eb0aa4-bde5-3b47-b745-6df19da95f32",
                                        "entry_id": "83dc0970-3a71-358d-bead-4351ce84c960",
                                        "glosses": [
                                            "γυναίκα που χαρακτηρίζεται από αρετές όπως αξιοπρέπεια, ευγένεια"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae6eeac3-124e-43a6-adcc-d84c7b3e272c",
                                                "sense_id": "c7eb0aa4-bde5-3b47-b745-6df19da95f32",
                                                "text": "μια πραγματική κυρία"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ac69a1c-35b4-3b42-8e6f-049b4d09ff79",
                                        "entry_id": "83dc0970-3a71-358d-bead-4351ce84c960",
                                        "glosses": [
                                            "έτσι αποκαλείται, από τους μαθητές της, μια δασκάλα ή καθηγήτρια"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478d4a5f-8bcf-4db9-9b45-797148b62147",
                                                "sense_id": "0ac69a1c-35b4-3b42-8e6f-049b4d09ff79",
                                                "text": "Η κυρία μας θα μας πάει εκδρομή αύριο."
                                            },
                                            {
                                                "example_id": "b48ed956-2d28-4cde-a828-465d91859b8e",
                                                "sense_id": "0ac69a1c-35b4-3b42-8e6f-049b4d09ff79",
                                                "text": "Κυρία! κυρία! Να πάω έξω;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663399be-e4c4-3964-a729-574f91669b42",
                                        "entry_id": "83dc0970-3a71-358d-bead-4351ce84c960",
                                        "glosses": [
                                            "τιμητικά, ή σε όρους για την Παναγία"
                                        ],
                                        "tags": [
                                            "συχνά με κεφαλαίο"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ad72c5a-869c-44c2-a3ec-721bf0c6794b",
                                                "sense_id": "663399be-e4c4-3964-a729-574f91669b42",
                                                "text": "Κυρία των Αγγέλων (η Παναγία)"
                                            },
                                            {
                                                "example_id": "2e7babac-f619-4ba7-aa59-75d397d40667",
                                                "sense_id": "663399be-e4c4-3964-a729-574f91669b42",
                                                "text": "παλιότερα στην αλληλογραφία: Κα"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a6fc8f3-0b00-38b9-8b6b-acdbdc4dea19",
                                        "entry_id": "83dc0970-3a71-358d-bead-4351ce84c960",
                                        "glosses": [
                                            "κακοποιός που δε μιλάει στις αρχές για τους συναδέλφους του (σαν κυρία με πρέπουσα συμπεριφορά)\\n"
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28855a41-f41b-4979-a13b-8f081c5e0ba7",
                                                "sense_id": "8a6fc8f3-0b00-38b9-8b6b-acdbdc4dea19",
                                                "text": "※ Βαγγέλης Παπάζογλου, Κάτω στα Λεμονάδικα [ρεμπέτικο τραγούδι], 1η στροφή",
                                                "translation": "Κάτω στα λε-, κάτω στα λε-, κάτω στα λεμονάδικα\nκάτω στα λεμονάδικα, έγινε φασαρία\nδυό λαχανάδες πιάσανε\nκι έκαναν την \"κυρία\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
