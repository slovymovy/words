                        "form": "die Erstsprache"
                    },
                    {
                        "form_id": "07571148-91d3-4513-9edd-0251589988e9",
                        "entry_id": "4c305192-2344-3392-9ed2-77deddb7888f",
                        "tags": [
                            "accusative",
