                "senses": [
                    {
                        "sense_id": "fe926eac-a128-37b7-bd09-c0e8269db1eb",
                        "entry_id": "a6d185fb-be91-384e-a814-9ac791bcd3a4",
                        "glosses": [
                            "Fahrstreifen für abbiegende Fahrzeuge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b29d674-121c-4dbe-ba04-52e09c0205e9",
                                "sense_id": "fe926eac-a128-37b7-bd09-c0e8269db1eb",
                                "text": "„Als Linkabbieger fahren Sie zur Mitte der Straße. Achten Sie auch auf besondere Abbiegestreifen für Radfahrer.“"
                            },
                            {
                                "example_id": "69708ce1-99b0-42ab-b8aa-ab725b393037",
                                "sense_id": "fe926eac-a128-37b7-bd09-c0e8269db1eb",
                                "text": "„Ein 18-jähriger Herforder fuhr mit seinem BMW in Richtung Lübbecke und beabsichtigte, die B61 an der Abfahrt zur Bielefelder Straße zu verlassen. Dafür fuhr der 18-Jährige auf den Abbiegestreifen.“"
                            },
                            {
                                "example_id": "ce33ca61-a237-43b3-ae3b-b35abc1e5477",
                                "sense_id": "fe926eac-a128-37b7-bd09-c0e8269db1eb",
                                "text": "„Zu einem Unfall kam es laut Polizei am Dienstag, 8. Juni, gegen 17.15 Uhr, dabei haben sich zwei Fahrzeuge auf dem Abbiegestreifen in die Jurastraße in Bad Säckingen gestreift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
