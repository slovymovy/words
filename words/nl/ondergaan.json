                    "sense_id": "1f52401a-2cb2-37a4-a4fe-afa8abb77465",
                    "sense_definition": "Achter de horizon verdwijnen (van hemellichamen zoals de zon of maan).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verdwijnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zomer <w>gaat</w> de zon pas laat <w>onder</w>.",
                            "target_lang_translations": {
                                "en": "In the summer, the sun <w>sets</w> late.",
                                "ru": "Летом солнце поздно <w>садится</w>.",
                                "pl": "Latem słońce <w>zachodzi</w> dopiero późno.",
                                "de": "Im Sommer <w>geht</w> die Sonne erst spät <w>unter</w>.",
                                "fr": "En été, le soleil ne <w>se couche</w> que tard.",
                                "it": "In estate il sole <w>tramonta</w> tardi.",
                                "cs": "V létě slunce <w>zapadá</w> až pozdě.",
                                "tr": "Yazın güneş çok geç <w>batıyor</w>.",
                                "es": "En verano, el sol <w>se pone</w> tarde.",
                                "zh": "夏天太阳很晚才<w>落下</w>。"
                            }
                        },
                        {
                            "text": "We keken samen naar de prachtige <w>ondergaande</w> zon.",
                            "target_lang_translations": {
                                "en": "We watched the beautiful <w>setting</w> sun together.",
                                "ru": "Мы вместе смотрели на красивое <w>заходящее</w> солнце.",
                                "pl": "Oglądaliśmy razem piękne <w>zachodzące</w> słońce.",
                                "de": "Wir schauten gemeinsam auf die wunderschöne <w>untergehende</w> Sonne.",
                                "fr": "Nous avons regardé ensemble le magnifique soleil <w>couchant</w>.",
                                "it": "Abbiamo guardato insieme il bellissimo sole <w>al tramonto</w>.",
                                "cs": "Společně jsme se dívali na nádherné <w>zapadající</w> slunce.",
                                "tr": "Birlikte güzel <w>batan</w> güneşi izledik.",
                                "es": "Vimos juntos la hermosa puesta de sol / el sol <w>poniéndose</w>.",
                                "zh": "我们一起看着美丽的<w>落日</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "opkomen"
                    ],
                    "common_phrases": [
                        "zon gaat onder"
                    ],
                    "target_lang_definitions": {
                        "en": "To disappear behind the horizon (of celestial bodies like the sun or moon).",
                        "ru": "Исчезать за горизонтом (о небесных телах, таких как солнце или луна).",
                        "pl": "Znikać za horyzontem (w odniesieniu do ciał niebieskich, takich jak słońce lub księżyc).",
                        "de": "Hinter den Horizont verschwinden (von Himmelskörpern wie Sonne oder Mond).",
                        "fr": "Disparaître derrière l'horizon (pour des corps célestes comme le soleil ou la lune).",
                        "it": "Scomparire dietro l'orizzonte (riferito a corpi celesti come il sole o la luna).",
                        "cs": "Zmizet za obzorem (u nebeských těles, jako je slunce nebo měsíc).",
                        "tr": "Gök cisimlerinin (güneş veya ay gibi) ufuk çizgisinin altına inerek gözden kaybolması.",
                        "es": "Desaparecer tras el horizonte (de cuerpos celestes como el sol o la luna).",
                        "zh": "指天体（如太阳或月亮）落到地平线以下。"
                    },
