                                "pl": "Cenię jego <w>bezpośredni</w> sposób mówienia podczas spotkań.",
                                "de": "Ich schätze seine <w>direkte</w> Art zu sprechen bei Besprechungen.",
                                "fr": "J'apprécie sa façon <w>directe</w> de parler pendant les réunions.",
                                "it": "Apprezzo il suo modo <w>diretto</w> di parlare durante le riunioni.",
                                "cs": "Oceňuji jeho <w>přímý</w> způsob mluvení během schůzí.",
                                "tr": "Toplantılardaki <w>açık sözlü</w> konuşma tarzını takdir ediyorum.",
                                "es": "Aprecio su forma <w>directa</w> de hablar durante las reuniones."
                            }
                        },
                        {
                            "text": "Ze gaf een heel <w>direct</w> antwoord waar niemand van terug had.",
                            "target_lang_translations": {
                                "ru": "Она дала очень <w>прямой</w> ответ, на который нечего было возразить.",
                                "en": "She gave a very <w>direct</w> answer that left everyone speechless.",
                                "pl": "Dała bardzo <w>bezpośrednią</w> odpowiedź, na którą nikt nie potrafił odpowiedzieć.",
                                "de": "Sie gab eine sehr <w>direkte</w> Antwort, auf die niemand etwas zu erwidern wusste.",
                                "fr": "Elle a donné une réponse très <w>directe</w> qui a laissé tout le monde sans voix.",
                                "it": "Ha dato una risposta molto <w>diretta</w> che ha lasciato tutti senza parole.",
                                "cs": "Dala velmi <w>přímou</w> odpověď, na kterou nikdo nedokázal reagovat.",
                                "tr": "Kimsenin itiraz edemeyeceği çok <w>net</w> bir cevap verdi.",
                                "es": "Dio una respuesta muy <w>directa</w> a la que nadie pudo replicar."
                            }
