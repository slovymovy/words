                ],
                "senses": [
                    {
                        "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                        "entry_id": "ad886cca-b20f-3c17-858e-3f50ef315e74",
                        "glosses": [
                            "Wirkung, die durch eine Schutzimpfung erzielt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51a326e-ab7b-4747-a734-1b3880b79bc2",
                                "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                                "text": "„Der Impfeffekt hält so lange an, bis diese Immunglobuline durch den Geimpften abgebaut bzw. inaktiviert worden sind.“"
                            },
                            {
                                "example_id": "c6e4236e-3bf2-464e-a84d-2e13d2d3a9c3",
                                "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                                "text": "„Studien haben gezeigt, dass Impfungen mit anschließendem kurzzeitigem Schlafentzug einen schlechteren Impfeffekt erzielen.“"
                            },
                            {
                                "example_id": "e121add3-2ef7-4062-b549-b1778111d38d",
                                "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                                "text": "„Auch Streptomycin und Sulfathiazol, nicht aber Prontosil, können den Impfeffekt aufheben oder zumindest verringern.“"
                            },
                            {
                                "example_id": "7b8906e4-cd0a-4f37-820f-b86b74386d12",
                                "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                                "text": "„Auch bei Säuglingen im ersten Vierteljahr kann man schon einen Impfeffekt erzielen, der allerdings von kürzerer Dauer ist.“"
                            },
                            {
                                "example_id": "62e3cdc2-61bb-4900-a40e-f65db732e51f",
                                "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                                "text": "„Daraus wurde die Hypothese abgeleitet, dass durch eine leicht ansteigende Viruslast in Therapiepausen das Immunsystem zu erneuter Auseinandersetzung mit dem Virus stimuliert werden könnte, was einer Art Impfeffekt entsprechen würde.“"
                            },
                            {
                                "example_id": "22793131-fa8d-4218-b946-654529350a80",
                                "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                                "text": "„Der Impfeffekt überholte in diesen Fällen die Entwicklung des Pocken-Virus im Infizierten.“"
                            },
                            {
                                "example_id": "51c763f9-174c-4b21-97b7-3b14e307ae1b",
                                "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                                "text": "„Intensivmediziner berichten dem Tagesspiegel, dass schon ab einer Impfquote von 27 Prozent unter den über 60-Jährigen ein deutlicher Impfeffekt zumindest auf die Belastung der Intensivstationen zu erwarten sei – ein Hauptkriterium für die Rückkehr zum normalen Leben.“"
                            },
                            {
                                "example_id": "c639e47a-c796-48ac-8e43-452a52e6614d",
                                "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                                "text": "„Wichtig ist, dass Sie unmittelbar vor, während und drei Tage nach der Impfung keine Malariamittel, Antibiotika oder Abführmittel einnehmen – dies würde den Impfeffekt stark beeinträchtigen.“"
                            },
                            {
                                "example_id": "1670a413-e96a-44d7-a896-b79f8e0b7253",
                                "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                                "text": "„Einen Monat nach dieser Totimpfstoffreihe könnte man dann einen Lebendimpfstoff geben, damit die positiven Impfeffekte wieder überwiegen.“"
                            },
                            {
                                "example_id": "0bcc0dac-dc75-482c-8056-474703005725",
                                "sense_id": "958cce60-b2d9-301c-9ee8-6c350a9e9d40",
                                "text": "„Auch SPD-Gesundheitspolitiker Karl Lauterbach geht von einer spürbaren Verbesserung der Lage aus und verweist auf die deutlichen Impfeffekte, sobald die Hälfte der Bevölkerung eine erste Impfung bekommen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
