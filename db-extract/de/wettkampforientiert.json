                "senses": [
                    {
                        "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                        "entry_id": "e83d089f-052d-3de4-8cc1-7e7fbb575566",
                        "glosses": [
                            "den Vergleich mit anderen Sportlern suchend und darauf hintrainierend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afba207a-f9f1-4a35-a996-88b6825f974a",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "Die Leichtathletikdisziplin 'Gehen' betreibt man wettkampforientiert, 'Walking' ist das Pendant für Freizeitsportler."
                            },
                            {
                                "example_id": "f8d90f0a-d530-4a5b-b25a-44242bcf39fc",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "[Beim Breitensport geht es um körperliche Fitness und Spaß am Sport, damit] „grenzt sich der Breitensport vom wettkampforientierten und trainingsintensiven Leistungssport ab.“"
                            },
                            {
                                "example_id": "36af734d-dd64-4e05-9afc-1fb4fe136746",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "„Ju Jutsu Do ist auf effektive Selbstverteidigung ausgelegt und nicht wettkampforientiert.“"
                            },
                            {
                                "example_id": "31faa2d6-6863-4b86-b95c-108f631c849d",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "„Der Kampfsportverein orientiert sich an jungen Menschen, die wettkampforientiert Boxen möchten.“"
                            },
                            {
                                "example_id": "aec99555-04b4-44fc-b90d-5a8845b297f1",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "„Tennis betreiben nur etwa 20% der Mitglieder wettkampforientiert.“"
                            },
                            {
                                "example_id": "206226f1-6396-4904-865d-7f338f27a7e2",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "„Der Massen, Volks- bzw. Freizeit- und Erholungssport der DDR war vornehmlich leistungs- sowie wettkampforientiert.“"
                            },
                            {
                                "example_id": "30ccc1b5-05fa-4fe5-93b2-b771bfcefcc6",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "„Kilian Bock: »Väter gehen mit ihren Kindern anders um als Mütter. Sie zeigen etwa ein anderes Spieleverhalten. So sind väterliche Spiele eher körperbetont und wettkampforientiert.«“"
                            },
                            {
                                "example_id": "c52078ce-e513-4d4f-ab2f-d8ea99d5d040",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "„Manche Sportpsychologen raten Paaren vom gemeinsamen Training ab, weil Männer wettkampforientierter und genetisch bevorteilt seien.“"
                            },
                            {
                                "example_id": "110960d0-be6d-4028-be9f-6459d075c3b9",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "„Dieser Stress kann auch Freude bringen: »Wer wettkampforientiert ist, schneller werden will und sich mit anderen vergleicht, für den können hier Trainingserfolge eine zusätzliche Belohnung und Motivation sein«, erklärt Dihsmaier“ […]."
                            },
                            {
                                "example_id": "fbf65ee9-34f5-486e-8541-3becfd71dd89",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "[Coronapandemie 2020:] „Die englische Regierung erlaubt den Premier-League-Klubs die Rückkehr ins Mannschaftstraining. Die Teams können wieder wettkampforientiert und ohne Einhaltung von Sicherheitsabständen mit dem gesamten Kader gemeinsam trainieren.“"
                            },
                            {
                                "example_id": "f82ae411-e37d-467e-b958-481eb68078f3",
                                "sense_id": "3578ea88-c361-3ed4-99f8-78c68467997a",
                                "text": "„Als aerobe Zone wird der Bereich von 70 bis 80 Prozent der Maximalleistung bezeichnet.“ […] „Die anaerobe Schwelle liegt über diesen 80 Prozent und spielt im Hobbysportbereich keine Rolle. In dieser Zone sollten Sie nur trainieren, wenn Sie leistungs- und wettkampforientiert sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
