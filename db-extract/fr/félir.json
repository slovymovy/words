                "senses": [
                    {
                        "sense_id": "d43f2fbf-9098-3c0d-9ed6-ee469fa2f8a3",
                        "entry_id": "910f3d1d-03e0-3fd3-8851-61d500c6d4df",
                        "glosses": [
                            "Feuler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0c45808-9523-40d0-8160-1e1f749f8e5f",
                                "sense_id": "d43f2fbf-9098-3c0d-9ed6-ee469fa2f8a3",
                                "text": "Grondant et félissant, les oreilles couchées en arrière, elle fixait ses yeux mauvais sur la chose intrépide qui gisait là, enveloppée de couvertures, et dont les regards hardis et brillants n’avaient encore jamais rencontrés les siens…"
                            },
                            {
                                "example_id": "a8b27ebd-7042-4852-ac64-8fa73487a89a",
                                "sense_id": "d43f2fbf-9098-3c0d-9ed6-ee469fa2f8a3",
                                "text": "Par contre, de terreur on peut me voir pâlir\nQuand dans la nuit soudain j'entends le chat félir."
                            }
                        ]
                    }
                ],
