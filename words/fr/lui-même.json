{
    "word_family": [
        "même",
        "mêmement"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "09eb8c42-e1b7-303e-9e67-60b25662249e",
                    "sense_definition": "Pronom réfléchi renforcé de la troisième personne du masculin singulier : il désigne la même personne ou la même chose que le sujet de la phrase.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pronom réfléchi renforcé",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marc ne pense qu'à <w>lui-même</w> et jamais aux autres."
                        },
                        {
                            "text": "Pierre est très fier de <w>lui-même</w> après son examen."
                        }
                    ],
                    "common_phrases": [
                        "pour lui-même",
                        "fier de lui-même",
                        "penser à lui-même"
                    ]
                },
                {
                    "sense_id": "880f8f7c-36cc-318c-ba24-e69afd5cdef1",
                    "sense_definition": "Pronom d'insistance : lui en personne, utilisé pour souligner que c'est bien lui le sujet naturellement ou directement responsable de l'action ou concerné par elle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pronom réfléchi renforcé",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur <w>lui-même</w> a répondu à ma lettre."
                        },
                        {
                            "text": "<w>Lui-même</w> a reconnu son erreur devant tout le monde."
                        }
                    ],
                    "common_phrases": [
                        "le directeur lui-même",
                        "le président lui-même"
                    ]
                },
                {
                    "sense_id": "3fe709bb-9814-313a-bac9-40d37f90a786",
                    "sense_definition": "Pronom renvoyant au sujet de la phrase pour insister, quand lui est complément d'un verbe ou d'une préposition, ou encore le possesseur ou le créateur de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pronom réfléchi renforcé",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son succès, il est devenu très sûr de <w>lui-même</w>."
                        },
                        {
                            "text": "Mon père a peint <w>lui-même</w> tous les murs du salon."
                        }
                    ],
                    "common_phrases": [
                        "sûr de lui-même",
                        "à lui-même",
                        "parler à lui-même"
                    ]
                },
                {
                    "sense_id": "dd9a3d4b-a237-3d94-a443-e42224c2d263",
                    "sense_definition": "De façon naturelle, spontanée ou directe, sans intervention extérieure : par sa propre action ou par son propre fonctionnement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le problème s'est réglé de <w>lui-même</w> après quelques jours."
                        },
                        {
                            "text": "Le moteur s'est arrêté de <w>lui-même</w>, sans aucune intervention."
                        }
                    ],
                    "common_phrases": [
                        "de lui-même",
                        "par lui-même"
                    ]
                }
            ]
        }
    ]
}