                "senses": [
                    {
                        "sense_id": "118afcd9-2fe1-331f-9541-2eef0bbbf329",
                        "entry_id": "3199c266-9617-3356-9f75-4c1d41f87949",
                        "glosses": [
                            "Donner un caractère rhotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27da1e11-db16-4fdb-a7c9-3597ee82bdd6",
                                "sense_id": "118afcd9-2fe1-331f-9541-2eef0bbbf329",
                                "text": "Pour Bartlett (1992 cité dans Gordon &. Maclagan, 2008 : 67), /r/ est réalisé sous la forme d’une voyelle rhoticisée dans ce contexte."
                            },
                            {
                                "example_id": "2e590e79-d0dc-4dc8-b8ee-c39c05df9f3f",
                                "sense_id": "118afcd9-2fe1-331f-9541-2eef0bbbf329",
                                "text": "Que ce dernier ne soit pas un « r » a par ailleurs été démontré par l’observation échographique de la bouche d’un sujet prononçant successivement « calar » à la française, puis en rhoticisant le « l », puis enfn en prononçant « carar » avec un vrai « r »."
                            },
                            {
                                "example_id": "4c9de2b1-730a-4353-8a62-2bbbb6e6cfb6",
                                "sense_id": "118afcd9-2fe1-331f-9541-2eef0bbbf329",
                                "text": "Du point de vue de la phonétique articulatoire, il existe plusieurs façons de rhoticiser une voyelle."
                            }
                        ]
                    }
                ],
