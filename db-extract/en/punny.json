                "senses": [
                    {
                        "sense_id": "27e2717b-c3d5-3853-abfc-426f83c7dd29",
                        "entry_id": "0f8de709-7f5a-3be4-936e-91b0cb37fbb4",
                        "glosses": [
                            "Resembling a pun; involving the use of a pun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee6fe0fd-6048-4559-9a33-0a5f1a51cedb",
                                "sense_id": "27e2717b-c3d5-3853-abfc-426f83c7dd29",
                                "text": "And though [Terry] Border's overly punny captions fall flat for me, the images themselves exude enough delight to make it all a treat."
                            },
                            {
                                "example_id": "73f0446a-c1fe-4f5f-b0e2-d7f25321e78f",
                                "sense_id": "27e2717b-c3d5-3853-abfc-426f83c7dd29",
                                "text": "Along Main Street, where crowds popped in and out of boutiques, one woman savored samples at the specialty food store. A punny T-shirt urging “SOCIALism DISTANCING” hung prominently in one of the shop windows […]."
                            },
                            {
                                "example_id": "5db9646c-1afb-488f-8bab-0194f2e3a79f",
                                "sense_id": "27e2717b-c3d5-3853-abfc-426f83c7dd29",
                                "text": "This is typical [Maurizio] Cattelan, whose work toys with double meanings and punny juxtapositions, flirting with the boundaries between good and bad, to expose bigger truths."
                            }
                        ]
                    },
                    {
                        "sense_id": "204895a9-e06c-3dcd-baa7-c5adb3441b72",
                        "entry_id": "0f8de709-7f5a-3be4-936e-91b0cb37fbb4",
                        "glosses": [
                            "Fond of puns."
                        ],
                        "tags": [
                            "of a person"
                        ],
                        "examples": [
                            {
                                "example_id": "8ac3b422-6bd8-4a85-9755-e4dd3a69f7f5",
                                "sense_id": "204895a9-e06c-3dcd-baa7-c5adb3441b72",
                                "text": "From Battersea Flower Station to Blonde Dye Bleach, everyone wants to be punny. What's your favourite?"
                            }
                        ]
                    },
