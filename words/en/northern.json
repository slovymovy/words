{
    "word_family": [
        "north",
        "northerly",
        "northerner",
        "northernmost",
        "northernness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "77461589-01fe-3ad5-8752-2ed4b55aef0e",
                    "sense_definition": "Of, facing, situated in, or related to the north.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>northern</w> part of the country experiences much colder winters than the south.",
                            "target_lang_translations": {
                                "ru": "В <w>северной</w> части страны зимы гораздо холоднее, чем на юге.",
                                "zh": "该国<w>北方</w>地区的冬天比南方冷得多。"
                            }
                        },
                        {
                            "text": "Many people travel to see the <w>northern</w> lights during the winter months.",
                            "target_lang_translations": {
                                "ru": "Многие люди путешествуют, чтобы увидеть <w>северное</w> сияние в зимние месяцы.",
                                "zh": "许多人在冬季旅行去观看<w>北极光</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "boreal",
                        "septentrional"
                    ],
                    "antonyms": [
                        "southern",
                        "austral",
                        "meridional"
                    ],
                    "common_phrases": [
                        "northern lights",
                        "northern hemisphere",
                        "northern border"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к северу, расположенный на севере или обращенный к нему.",
                        "zh": "指位于北方、朝向北方或与北方有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "северный",
                                "target_lang_sense_clarification": "о направлении или местоположении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "北方的",
                                "target_lang_sense_clarification": "指地理位置或方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3bc3109-6b57-312e-ad9b-1cf6890c128c",
                    "sense_definition": "Characteristic of the North of England.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regional_culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a very strong <w>northern</w> accent that is hard for foreigners to understand.",
                            "target_lang_translations": {
                                "ru": "У него очень сильный <w>северный</w> акцент, который иностранцам трудно понять.",
                                "zh": "他有很重的<w>北部</w>口音，外国人很难听懂。"
                            }
                        },
                        {
                            "text": "The comedian was famous for his <w>northern</w> humor and stories about his childhood.",
                            "target_lang_translations": {
                                "ru": "Комик был знаменит своим <w>северным</w> юмором и историями о своем детстве.",
                                "zh": "这位喜剧演员以其<w>北部</w>幽默和童年故事而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "northern accent",
                        "northern soul"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный для севера Англии.",
                        "zh": "指英国北部地区的特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "северный",
                                "target_lang_sense_clarification": "о диалекте или культуре севера Англии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "北部的",
                                "target_lang_sense_clarification": "指英国北部文化或口音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "748e312f-0cd2-375f-bef7-d29afb0bc9c3",
                    "sense_definition": "Blowing from the north; used to describe winds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A cold <w>northern</w> wind began to blow across the empty fields.",
                            "target_lang_translations": {
                                "ru": "Холодный <w>северный</w> ветер начал дуть над пустыми полями.",
                                "zh": "一阵寒冷的<w>北风</w>开始吹过空旷的田野。"
                            }
                        },
                        {
                            "text": "The sailors struggled to keep the ship on course against the <w>northern</w> gale.",
                            "target_lang_translations": {
                                "ru": "Моряки изо всех сил старались удержать корабль на курсе против <w>северного</w> шторма.",
                                "zh": "水手们努力顶着<w>北</w>风暴使船保持航向。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "northern wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дующий с севера (о ветре).",
                        "zh": "指从北方吹来的风。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "северный",
                                "target_lang_sense_clarification": "о ветре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "北风",
                                "target_lang_sense_clarification": "指风向"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7dd628a8-9fa6-3f98-9911-04596079efc3",
                    "sense_definition": "An inhabitant of the northern regions of a country or the world.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>northern</w>, she was not used to the intense heat of the tropical summer.",
                            "target_lang_translations": {
                                "ru": "Как <w>северянка</w>, она не привыкла к сильной жаре тропического лета.",
                                "zh": "作为一名<w>北方人</w>，她不习惯热带夏季的酷热。"
                            }
                        },
                        {
                            "text": "The <w>northerns</w> and southerners had very different views on the new law.",
                            "target_lang_translations": {
                                "ru": "У <w>северян</w> и южан были очень разные взгляды на новый закон.",
                                "zh": "<w>北方人</w>和南方人对这项新法律的看法截然不同。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Житель северных регионов страны или мира.",
                        "zh": "居住在北方地区的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "северянин",
                                "target_lang_sense_clarification": "житель севера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "北方人",
                                "target_lang_sense_clarification": "指居住在北方的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dae9dec-cfdb-3345-bc37-8844ded26d0c",
                    "sense_definition": "A type of large freshwater fish, specifically the northern pike.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the whole afternoon at the lake trying to catch a large <w>northern</w>.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день на озере, пытаясь поймать крупную <w>щуку</w>.",
                                "zh": "他在湖边待了一整个下午，试图钓到一条大<w>白斑狗鱼</w>。"
                            }
                        },
                        {
                            "text": "The female <w>northern</w> may broadcast eggs over several hundred yards of the river.",
                            "target_lang_translations": {
                                "ru": "Самка <w>щуки</w> может метать икру на протяжении нескольких сотен ярдов реки.",
                                "zh": "雌性<w>白斑狗鱼</w>可能会在几百码长的河道中产卵。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип крупной пресноводной рыбы, в частности северная щука.",
                        "zh": "一种大型淡水鱼，即白斑狗鱼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щука",
                                "target_lang_sense_clarification": "обыкновенная или северная щука"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白斑狗鱼",
                                "target_lang_sense_clarification": "指淡水鱼类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7e2814d-e047-3887-8346-641e9a7cbd22",
                    "sense_definition": "A film or dramatic work set in the northern territories of North America, often featuring Mounties.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "media_genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The classic <w>northern</w> often depicted the rugged life of lawmen in the Canadian wilderness.",
                            "target_lang_translations": {
                                "ru": "Классический <w>«северный» вестерн</w> часто изображал суровую жизнь законников в канадской глуши.",
                                "zh": "经典的<w>北方题材电影</w>经常描绘加拿大荒野中执法人员的艰苦生活。"
                            }
                        },
                        {
                            "text": "Fans of historical dramas might enjoy this old <w>northern</w> set during the gold rush.",
                            "target_lang_translations": {
                                "ru": "Любителям исторических драм может понравиться этот старый <w>фильм о севере</w>, действие которого происходит во время золотой лихорадки.",
                                "zh": "历史剧迷可能会喜欢这部以淘金热为背景的旧式<w>北方题材电影</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фильм или драматическое произведение, действие которого происходит на северных территориях Северной Америки.",
                        "zh": "以北美北部地区为背景的电影或戏剧作品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«северный» вестерн",
                                "target_lang_sense_clarification": "жанр кино о севере Канады или Аляске"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "北方题材电影",
                                "target_lang_sense_clarification": "指电影类型"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "31d015dc-638a-3bfb-a051-23be9405205f",
                    "sense_definition": "The Northern Line of the London Underground.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "I need to take the <w>Northern</w> to get to Camden Town this evening.",
                            "target_lang_translations": {
                                "ru": "Мне нужно сесть на <w>Северную линию</w>, чтобы добраться до Кэмден-Тауна сегодня вечером.",
                                "zh": "我今晚需要坐<w>北线</w>去卡姆登镇。"
                            }
                        },
                        {
                            "text": "The <w>Northern</w> is often one of the busiest lines on the tube network.",
                            "target_lang_translations": {
                                "ru": "<w>Линия Нордерн</w> часто является одной из самых загруженных линий в сети метро.",
                                "zh": "<w>北线</w>通常是伦敦地铁网络中最繁忙的线路之一。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "London"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Северная линия лондонского метрополитена.",
                        "zh": "伦敦地铁的北线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Северная линия",
                                "target_lang_sense_clarification": "линия Нордерн в Лондоне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "北线",
                                "target_lang_sense_clarification": "伦敦地铁线路名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ebf3242-7c3c-3853-b21f-6b76eb6a7883",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named James <w>Northern</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Джеймс <w>Нортерн</w>.",
                                "zh": "这本书的作者是一位名叫詹姆斯·<w>诺森</w>的男士。"
                            }
                        },
                        {
                            "text": "We are meeting with the <w>Northerns</w> for dinner at their house tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы встречаемся с семьей <w>Нортерн</w> за ужином у них дома.",
                                "zh": "我们今晚要去<w>诺森</w>一家家里共进晚餐。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нортерн",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诺森",
                                "target_lang_sense_clarification": "英语姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
