                        "sense_id": "f91344ec-e0dc-3fff-9a90-7dc5c581ea31",
                        "entry_id": "d523af06-65d2-3479-8cc8-1fc86ec9da35",
                        "glosses": [
                            "im Frühjahr gesäte Nutzpflanze; Sommersaat, Sommerfrucht, Sommergetreide"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c538d7f8-5cbd-4768-a58d-4806147dfce5",
                        "source_entry_id": "d523af06-65d2-3479-8cc8-1fc86ec9da35",
                        "source_sense_id": "ed2277f6-5a7c-3b38-b4ac-6004db720a30",
                        "source_sense_description": "essbare Teile von Gemüsepflanzen; Gemüse",
                        "target_lang_word": "Gemüse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemüse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc713287-759e-319c-b261-991906f37825",
                                        "entry_id": "254cb630-5be1-34a8-a6f4-56b68604ed23",
                                        "glosses": [
                                            "essbare Pflanzenteile ein- bis zweijähriger Pflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27c8d26a-0d3f-430a-8099-be9c931ce52f",
                                                "sense_id": "cc713287-759e-319c-b261-991906f37825",
                                                "text": "Obst und Gemüse enthalten viele Vitamine."
                                            },
                                            {
                                                "example_id": "a8a95376-ffd1-4259-9c53-8ac7ccdaa438",
                                                "sense_id": "cc713287-759e-319c-b261-991906f37825",
                                                "text": "„Darin wurde vor allem Sauerampfer angebaut, der früher als Salat, Gemüse und Heilpflanze von großer Bedeutung war.“"
                                            },
                                            {
                                                "example_id": "f661c513-851a-471b-b64f-dc554daa2410",
                                                "sense_id": "cc713287-759e-319c-b261-991906f37825",
                                                "text": "„In einer wurde Gemüse feilgeboten, in einer anderen Milchtee und altbackene Brötchen für die Schulkinder.“"
                                            },
                                            {
                                                "example_id": "1882e330-de96-4fb3-98f6-a0ba91aa8432",
                                                "sense_id": "cc713287-759e-319c-b261-991906f37825",
                                                "text": "„Auf dem weitläufigen, farbenfreudigen Markt gab es alles: von Gemüse und Gewürzen, die auf dem Boden aufgehäuft waren, bis zu Handys und Imitationen von Designer-Sonnenbrillen.“"
                                            },
                                            {
                                                "example_id": "5ad61dfc-18e3-4389-b238-0b6cd90764d3",
                                                "sense_id": "cc713287-759e-319c-b261-991906f37825",
                                                "text": "„Viel schlimmer als mit Obst und Gemüse steht es mit dem Fleisch, mit Fett und mit Eiern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47fe754c-3c94-3214-b6a4-0a14179b5d43",
                                        "entry_id": "254cb630-5be1-34a8-a6f4-56b68604ed23",
                                        "glosses": [
                                            "Gericht aus Gemüse, Gemüsegericht"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
