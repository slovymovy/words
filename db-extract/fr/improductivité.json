                        "glosses": [
                            "État de ce qui est improductif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e40d753-bf5c-4895-bfbf-d9b2a0903a01",
                                "sense_id": "33fe61d1-2367-3fee-b503-19c8f628e3ee",
                                "text": "Hé bien, pour obtenir les bonnes réponses, il faut se poser les bonnes questions : quelles sont les causes de l’improductivité au travail, selon vous ?"
                            },
                            {
                                "example_id": "bd81327c-e9f8-4e8d-a13f-b590f466e2b5",
                                "sense_id": "33fe61d1-2367-3fee-b503-19c8f628e3ee",
                                "text": "L’improductivité de ceux qui demandent le droit à la paresse oblige ceux qui ont « le cœur à l’ouvrage » de travailler plus pour les faire vivre."
                            },
                            {
                                "example_id": "b416c6e2-9b6d-40ca-94e5-2936f7bb2f8e",
                                "sense_id": "33fe61d1-2367-3fee-b503-19c8f628e3ee",
                                "text": "L’improductivité de ce pays."
                            }
                        ]
                    }
