                ],
                "senses": [
                    {
                        "sense_id": "ffc933e9-04cc-3f70-8d4c-0ab8b5588e35",
                        "entry_id": "13090712-229d-371b-bb0d-5de7cc46e9a3",
                        "glosses": [
                            "freiwilliger oder erzwungener Wechsel des Wohnortes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2176fc20-37a9-43b5-86ec-5151dd5fe580",
                                "sense_id": "ffc933e9-04cc-3f70-8d4c-0ab8b5588e35",
                                "text": "„Von den 1,5 Millionen Volksdeutschen, die nach den vorangegangenen Umsiedlungen dort lebten, gelangten nur etwa 400.000 aufs Reichsgebiet.“"
                            },
                            {
                                "example_id": "c64c68bc-3fff-42c6-aa5f-8561110d0da8",
                                "sense_id": "ffc933e9-04cc-3f70-8d4c-0ab8b5588e35",
                                "text": "„Für die von 1948 bis 1950 vorgenommenen, zahlenmäßig geringen Umsiedlungen, deren Summe nur einen Bruchteil jener von 1946 bis 1947 erreichte (erfasst wurden knapp 140000 Personen), wäre schon der Begriff der Zwangsaussiedlung, geschweige denn der Vertreibung, irreführend.“"
                            },
                            {
                                "example_id": "55048b3c-e41f-4c43-b5e5-21409c7b739c",
                                "sense_id": "ffc933e9-04cc-3f70-8d4c-0ab8b5588e35",
                                "text": "„Wenn die staatlichen Stellen jetzt nicht handelten, würden die Arbeiter aus den Fabriken die Umsiedlung der Deutschen selber durchführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd6ac853-ea48-44ca-81f6-ae15afd3adac",
                        "source_entry_id": "13090712-229d-371b-bb0d-5de7cc46e9a3",
                        "source_sense_id": "ffc933e9-04cc-3f70-8d4c-0ab8b5588e35",
                        "source_sense_description": "freiwilliger oder erzwungener Wechsel des Wohnortes",
                        "target_lang_word": "déplacement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déplacement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8425afd9-696f-3bb4-ba7c-38e063d31cdc",
                                        "entry_id": "a136ffb9-d8bf-3eab-bf48-a871a46c2756",
                                        "glosses": [
                                            "Action de déplacer ou de se déplacer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ede0068-b5a4-4146-a98d-94445b652368",
                                                "sense_id": "8425afd9-696f-3bb4-ba7c-38e063d31cdc",
                                                "text": "Bien protégé derrière le pare-brise, le déplacement d’air provoqué par la rotation de l’hélice m’effleurait à peine les joues."
                                            },
                                            {
                                                "example_id": "01fcd7af-0472-4952-ae62-6a272939397e",
                                                "sense_id": "8425afd9-696f-3bb4-ba7c-38e063d31cdc",
                                                "text": "La question du déplacement des pôles n’a pas encore rallié, non plus, tous les suffrages, j’y ferai simplement allusion."
                                            },
                                            {
                                                "example_id": "ce55c9fe-f500-493d-891e-63cc1965c648",
                                                "sense_id": "8425afd9-696f-3bb4-ba7c-38e063d31cdc",
                                                "text": "Le déplacement des poches à fonte entre les divers postes de travail situés à des niveaux différents et les mouvements de versage sont effectués par un pont roulant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e798e15-d041-3215-acd8-73e04db7e160",
                                        "entry_id": "a136ffb9-d8bf-3eab-bf48-a871a46c2756",
                                        "glosses": [
                                            "Changement de résidence ou d’affectation d’un fonctionnaire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f6b2a70-34cc-3838-a69b-a8573082cffa",
                                        "entry_id": "a136ffb9-d8bf-3eab-bf48-a871a46c2756",
                                        "glosses": [
                                            "Le poids du volume d’eau déplacé par un navire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87574368-4627-3207-8d8a-6c236c78a838",
                                        "entry_id": "a136ffb9-d8bf-3eab-bf48-a871a46c2756",
                                        "glosses": [
                                            "Les voyages."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fec52d8-7351-48ce-8f98-c0bb0d816cb3",
                                                "sense_id": "87574368-4627-3207-8d8a-6c236c78a838",
                                                "text": "La plupart des Parisiens rencontrés au fil des archives criminelles se déplacent en effet à pied, et crotter ses vêtements n'est pas le pire qui puisse arriver au piéton lors de ses déplacements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1a6f249-9a62-40df-8af7-1c652361e806",
                        "source_entry_id": "13090712-229d-371b-bb0d-5de7cc46e9a3",
                        "source_sense_id": "ffc933e9-04cc-3f70-8d4c-0ab8b5588e35",
                        "source_sense_description": "freiwilliger oder erzwungener Wechsel des Wohnortes",
                        "target_lang_word": "déportation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déportation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c819fb5-453c-3d81-b5b0-94aa01767a69",
                                        "entry_id": "8aedea6a-9d89-361f-9e78-905f8f7bb84a",
                                        "glosses": [
                                            "Peine afflictive et infamante qui consiste en une résidence forcée sur un point déterminé en dehors du territoire continental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72cc476d-a263-4fe1-a59c-1959fdc3d74e",
                                                "sense_id": "7c819fb5-453c-3d81-b5b0-94aa01767a69",
                                                "text": "Réunis en \"quarter sessions\", à chaque trimestre, ils prononcent, avec l’assistance du jury, sur les délits et les crimes qui n’emportent pas plus de quatorze années de déportation, les affaires plus graves étant renvoyées au assises : […]."
                                            },
                                            {
                                                "example_id": "0c84212f-ec7f-4d13-90be-710aee738306",
                                                "sense_id": "7c819fb5-453c-3d81-b5b0-94aa01767a69",
                                                "text": "Enfin, le 7 prairial, après des délibérations pendant lesquelles s’étaient exercées les plus fortes pressions sur les rares jurés susceptibles de prononcer l’acquittement général, […], le jury de Vendôme acquittait presque tous les accusés, mais condamnait sept d’entre eux (Buonarroti, Germain, Moroy, Cazin, Blondeau, Mennessier, Bouin) à la déportation, et deux d’entre eux, Babeuf et Darthé, à la peine capitale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e03c4ddd-7ff6-3235-b31f-771f0e86d95f",
                                        "entry_id": "8aedea6a-9d89-361f-9e78-905f8f7bb84a",
                                        "glosses": [
                                            "Action de déporter un peuple contre ses droits naturels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13693113-bdc9-4243-b1cb-5ae08b8ff50a",
                                                "sense_id": "e03c4ddd-7ff6-3235-b31f-771f0e86d95f",
                                                "text": "La déportation de tous les Indiens de l’Union au-delà du Mississipi paraît définitivement résolue. Se soumettront-ils paisiblement à cette cruelle mesure? La chose est peu probable."
                                            },
                                            {
                                                "example_id": "864216cb-8c50-4fed-acdd-0fda61115a1e",
                                                "sense_id": "e03c4ddd-7ff6-3235-b31f-771f0e86d95f",
                                                "text": "Cette défaite des Russes aurait sans doute été mieux acceptée si le thème de la chanson de Jamala, une Tatare de Crimée (région annexée par la Russie en 2014), n'évoquait pas la déportation de son peuple par les autorités soviétiques lors de la seconde guerre mondiale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e54b05-e5e8-3ac4-b58f-873a808b2951",
                                        "entry_id": "8aedea6a-9d89-361f-9e78-905f8f7bb84a",
                                        "glosses": [
                                            "Action, par les nazis durant la Seconde Guerre mondiale, de déplacer et d'enfermer dans les camps de concentration et d’extermination."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
