                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63fd2559-e1c3-4e71-9035-1a4f89773838",
                                                "sense_id": "87e3546b-d9c2-33b2-b608-1b6e0129db1d",
                                                "text": "Hij moest eerst de telefoon opnemen."
                                            },
                                            {
                                                "example_id": "1aa2b6d9-3290-40c4-b41e-146d4ffa1181",
                                                "sense_id": "87e3546b-d9c2-33b2-b608-1b6e0129db1d",
                                                "text": "' Ik vis mijn telefoon uit mijn zak en bel Gijs, maar hij neemt niet op."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2076d611-7bad-3eb2-ab23-83959db9de5d",
                                        "entry_id": "86c60fdd-7904-3099-9556-40c1bee9c9f0",
                                        "glosses": [
                                            "het resultaat vaststellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aead132b-1c34-4cf1-843d-c1e00ecdff6c",
                                                "sense_id": "2076d611-7bad-3eb2-ab23-83959db9de5d",
                                                "text": "De verpleegster kwam de temperatuur opnemen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79cff4c0-ddbe-3ff8-a955-e25c934cc2c9",
