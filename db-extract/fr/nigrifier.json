                ],
                "senses": [
                    {
                        "sense_id": "103a4412-2eac-39fa-85c1-4a1be41ff945",
                        "entry_id": "865c5394-8a4c-36eb-8fc7-7f835f78de4a",
                        "glosses": [
                            "Teindre en noir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b94e1a-743c-4fc8-a73c-547d3d68449d",
                                "sense_id": "103a4412-2eac-39fa-85c1-4a1be41ff945",
                                "text": "Ça ne va donc pas, les amoureux ? dit Favières à la grosse Lolotte, une servante de trente ans qui mettait sa coquetterie à ne pas nigrifier une mèche blanche balafrant sa sombre tignasse."
                            }
                        ]
                    },
                    {
                        "sense_id": "493c5c05-2812-3163-acdf-db62d9adabfd",
                        "entry_id": "865c5394-8a4c-36eb-8fc7-7f835f78de4a",
                        "glosses": [
                            "Donner un caractère noir (au sens de la couleur de peau) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d74e925-e2cf-4b1b-9312-f13d973c5279",
                                "sense_id": "493c5c05-2812-3163-acdf-db62d9adabfd",
                                "text": "Cela n’aurait été que passer au cirage le noir de fumée et non pas nigrifier initialement un nègre."
                            },
                            {
                                "example_id": "f25c9702-b8f2-44dc-9473-b4e4fc26f7d0",
                                "sense_id": "493c5c05-2812-3163-acdf-db62d9adabfd",
                                "text": "Ces Békés saotoméens vont progressivement se « nigrifier », en raison de la raréfaction d’apport de sang de Blanc dans la formation de la population saotoméenne ultérieure."
                            },
                            {
                                "example_id": "ec3b2ae7-e34c-47c8-be0a-19cd5470fbc9",
                                "sense_id": "493c5c05-2812-3163-acdf-db62d9adabfd",
                                "text": "Mais il y avait dans le pays des populations qui avaient hérité du sang nègre des Sahariens néolithiques, et cette population allait se nigrifier davantage encore au cours du moyen âge, par suite des apports incessants d’esclaves du Soudan."
                            }
                        ]
                    }
                ],
