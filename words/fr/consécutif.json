{
    "word_family": [
        "conséquence",
        "conséquemment",
        "consécutivement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "84c5e1d6-66eb-3e23-9bbe-519dca6e3eb2",
                    "sense_definition": "Qui se suit immédiatement et sans interruption dans le temps ou dans l'espace.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a plu pendant trois jours <w>consécutifs</w>, ce qui a inondé tout le jardin."
                        },
                        {
                            "text": "L'équipe a remporté cinq victoires <w>consécutives</w> depuis le début du championnat."
                        }
                    ],
                    "synonyms": [
                        "successif"
                    ],
                    "antonyms": [
                        "discontinu",
                        "intermittent"
                    ],
                    "common_phrases": [
                        "jours consécutifs",
                        "années consécutives",
                        "victoires consécutives"
                    ]
                },
                {
                    "sense_id": "7418d4f0-bd59-3060-beec-5141eba586f1",
                    "sense_definition": "Qui résulte directement d'un fait ou d'un événement antérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resultat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fermeture de cette route est un problème <w>consécutif</w> aux récentes intempéries."
                        },
                        {
                            "text": "Elle souffre d'une grande fatigue <w>consécutive</w> à une longue période de surmenage."
                        }
                    ],
                    "synonyms": [
                        "résultant"
                    ],
                    "antonyms": [
                        "antérieur",
                        "préalable"
                    ],
                    "common_phrases": [
                        "consécutif à"
                    ]
                },
                {
                    "sense_id": "7156c7be-953a-3f64-843e-bfd25c750c12",
                    "sense_definition": "En grammaire, qualifie une proposition qui exprime la conséquence d'une action ou d'un état.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette phrase complexe, l'auteur a employé une proposition subordonnée <w>consécutive</w>."
                        },
                        {
                            "text": "Le professeur explique la différence entre une proposition causale et une proposition <w>consécutive</w>."
                        }
                    ],
                    "common_phrases": [
                        "proposition consécutive"
                    ]
                },
                {
                    "sense_id": "cfe65413-5329-30c9-8650-9f295c69bf47",
                    "sense_definition": "En médecine, qui survient ou persiste à la suite d'une maladie ou d'une lésion.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medecine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient présente une raideur articulaire <w>consécutive</w> à son opération du genou."
                        },
                        {
                            "text": "Les médecins surveillent de près toute complication <w>consécutive</w> à cette infection virale."
                        }
                    ],
                    "common_phrases": [
                        "troubles consécutifs"
                    ]
                }
            ]
        }
    ]
}