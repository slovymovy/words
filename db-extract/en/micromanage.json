                        "sense_id": "7cc62d8b-69d4-3cc8-a242-cb558f8b0c1d",
                        "entry_id": "5fc92cf8-0336-3f7b-bcd4-d11f29ea1682",
                        "glosses": [
                            "To manage, direct, or control a person, group, or system to an unnecessary level of detail or precision."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2bf826be-a3f4-47c0-b6fc-4b9cb4c1ba45",
                                "sense_id": "7cc62d8b-69d4-3cc8-a242-cb558f8b0c1d",
                                "text": "As GBR is intended to operate at arm's length from government while also being responsible for implementing a 30-year strategy, it is hoped that the industry will be less micro-managed by ministers and officials at both the DfT and within the Treasury."
                            },
                            {
                                "example_id": "a8ca6c6a-ea3b-4cf6-998b-38480e5b8058",
                                "sense_id": "7cc62d8b-69d4-3cc8-a242-cb558f8b0c1d",
                                "text": "The employees complained that their boss was micromanaging when she insisted that they account for their time in fifteen-minute intervals."
                            }
                        ]
                    }
