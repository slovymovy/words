                "senses": [
                    {
                        "sense_id": "4215a47f-2c35-3aba-b75f-5b4cf8f0563c",
                        "entry_id": "206a2427-0d11-34b8-bc9e-b603ffafdb8a",
                        "glosses": [
                            "größere lederne Aktentasche in der auch Reisegepäck Platz findet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cb7cf93-bba2-435c-9927-f1d93f3435fa",
                                "sense_id": "4215a47f-2c35-3aba-b75f-5b4cf8f0563c",
                                "text": "Ca. 185 cm groß, schlank, ca. 30 Jahre alt, bekleidet mit modernen grauen Mantel und vermutlich braunem Reiselord"
                            },
                            {
                                "example_id": "341e16fe-0fdc-42a0-809b-fd3c50bb791e",
                                "sense_id": "4215a47f-2c35-3aba-b75f-5b4cf8f0563c",
                                "text": "…wo die männliche Person einen dort abgeparkten PKW Wartburg aufschloß und der H. seinen schwarzen Reiselord auf den Rücksitz des PKW legte (Auszug aus der Stasi Akte des G. Hansen)"
                            },
                            {
                                "example_id": "6ce3d6c2-8122-41b1-9e43-11f9585be84d",
                                "sense_id": "4215a47f-2c35-3aba-b75f-5b4cf8f0563c",
                                "text": "In seinem schwarzen Reiselord - einer Spezialanfertigung - stecken im Geheimfach 1500 D-Mark und ein Westberliner Personalausweis auf den Namen Peter Burger, Reinickendorf. Das Dokument weist den 43-Jährigen als Kaufmann aus."
                            },
                            {
                                "example_id": "eb6efc26-783b-4ae9-9819-24eb5bd8e6d8",
                                "sense_id": "4215a47f-2c35-3aba-b75f-5b4cf8f0563c",
                                "text": "Doch schon nach einiger Zeit wir hatten Berlin kaum verlassen, regte er sich, schnappte das Schloß seines Reiselords auf und kramte ein Stullenpaket heraus."
                            },
                            {
                                "example_id": "fdbbff1b-fdc1-44af-bf7f-132842d856be",
                                "sense_id": "4215a47f-2c35-3aba-b75f-5b4cf8f0563c",
                                "text": "Feingekleidete Kurgäste überlassen ihm ihre Koffer und Reiselords und Hutschachteln, die er auf seinen Wagen verlädt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
