{
    "word_family": [
        "expulsion",
        "expulsif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d66bc38-89fa-3e1f-a197-e6fd80196031",
                    "sense_definition": "Chasser une personne d'un lieu, d'un logement ou d'un pays par une décision d'autorité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chasser_exclure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a ordonné d'<w>expulser</w> ce locataire après plusieurs mois d'impayés."
                        },
                        {
                            "text": "Les autorités ont décidé d'<w>expulser</w> les ressortissants étrangers en situation irrégulière."
                        }
                    ],
                    "synonyms": [
                        "bannir"
                    ],
                    "common_phrases": [
                        "expulser un locataire",
                        "expulser du pays"
                    ]
                },
                {
                    "sense_id": "fac94163-06e1-38fb-831a-5d524f2057a3",
                    "sense_definition": "Renvoyer ou éliminer quelqu'un d'un groupe, d'une école ou d'une organisation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chasser_exclure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conseil de discipline a voté pour <w>expulser</w> cet élève violent."
                        },
                        {
                            "text": "Ce membre indiscipliné a été définitivement <w>expulsé</w> de notre association."
                        }
                    ],
                    "synonyms": [
                        "exclure"
                    ],
                    "common_phrases": [
                        "expulser un élève"
                    ]
                },
                {
                    "sense_id": "f5dae69d-0306-3cd4-9202-5b7ee1eb0d1d",
                    "sense_definition": "Ordonner à un joueur de quitter le terrain suite à une infraction aux règles du jeu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport_penalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arbitre n'a pas hésité à <w>expulser</w> le défenseur après ce tacle dangereux."
                        },
                        {
                            "text": "L'attaquant s'est fait <w>expulser</w> du terrain pour avoir contesté une décision arbitrale."
                        }
                    ],
                    "synonyms": [
                        "exclure"
                    ],
                    "common_phrases": [
                        "expulser du terrain"
                    ]
                },
                {
                    "sense_id": "7c34ec10-7ff3-349f-bda3-6d5340065fd1",
                    "sense_definition": "Faire sortir ou rejeter vigoureusement au dehors un corps ou une substance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "evacuation_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moteur utilise une forte pression pour <w>expulser</w> les gaz de combustion."
                        },
                        {
                            "text": "Le patient doit tousser fortement afin d'<w>expulser</w> tout le mucus accumulé."
                        }
                    ],
                    "synonyms": [
                        "éjecter",
                        "rejeter"
                    ],
                    "common_phrases": [
                        "expulser l'air"
                    ]
                }
            ]
        }
    ]
}