                    {
                        "sense_id": "982446b9-79c6-3e50-afb7-51482c03295a",
                        "entry_id": "97e9c2a3-1e69-3163-a51a-be4a9d5f517d",
                        "glosses": [
                            "een inspectieput die ervoor dient om inspecties in een rioolstelsel uit te kunnen voeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "551ccddd-4a00-4fe7-9c2f-13fceaf966a9",
                                "sense_id": "982446b9-79c6-3e50-afb7-51482c03295a",
                                "text": "In het Groningse Hoogezand zijn vandaag aan het eind van de middag negentig woningen ontruimd vanwege een gaslek dat was ontstaan doordat vuurwerk op straat in een rioolput was gegooid."
                            },
                            {
                                "example_id": "536ae924-88bd-460a-b57e-a834b44f1e3b",
                                "sense_id": "982446b9-79c6-3e50-afb7-51482c03295a",
                                "text": "Na een zoektocht naar eten is een wasbeer in de Amerikaanse stad Chicago blijven steken in een rioolput. Dankzij de snelle reactie van voorbijgangers, die tevens een creatieve manier verzonnen om het beest te bevrijden, liep het tafereel met een sisser af."
                            }
                        ]
