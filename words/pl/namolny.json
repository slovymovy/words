                },
                {
                    "sense_id": "af1e7a10-f8f2-3f17-bd9d-0d2e7f86bac0",
                    "sense_definition": "przejawiający się z wielką intensywnością, uciążliwy i trudny do zniesienia",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "natręctwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy mieli już dość tej <w>namolnej</w> reklamy przerywającej ciekawy film.",
                            "target_lang_translations": {
                                "ru": "Всем уже порядком надоела эта <w>назойливая</w> реклама, прерывающая интересный фильм."
                            }
                        },
                        {
                            "text": "W telewizji dominował <w>namolny</w> patriotyzm i głośne hasła wyborcze.",
                            "target_lang_translations": {
                                "ru": "На телевидении преобладал <w>навязчивый</w> патриотизм и громкие предвыборные лозунги."
                            }
                        }
                    ],
                    "synonyms": [
                        "nachalny",
                        "natarczywy",
                        "natrętny"
                    ],
                    "common_phrases": [
