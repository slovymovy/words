                        "glosses": [
                            "een hoeveelheid verdiend geld dat overeenkomt met inkomsten verkregen uit een baan met het minimumloon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b577ae2-2eb1-4611-a779-049865a8dd29",
                                "sense_id": "9e8bcad4-bce7-3003-a504-6b357fc52425",
                                "text": "Ruim 17.000 Amsterdamse basisschoolleerlingen in Amsterdam kunnen gebruikmaken van de stadspas. Die wordt verstrekt aan mensen met een minimuminkomen. Ouders kunnen de pas bij de basisschool laten scannen. De gemeente maakt vervolgens 50 euro ouderbijdrage over om de kosten te dekken. De gemiddelde ouderbijdrage in Amsterdam ligt op 112 euro."
                            },
                            {
                                "example_id": "9ab018f4-0076-482e-a40c-b568ff39f5d3",
                                "sense_id": "9e8bcad4-bce7-3003-a504-6b357fc52425",
                                "text": "Per fragment dat hij beluistert, krijgt hij een paar eurocent. Hij moet dus tienduizenden Nederlandstalige fragmenten per maand beluisteren om een minimuminkomen te verdienen."
                            }
                        ]
                    }
