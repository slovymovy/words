                        "wettern"
                    ]
                },
                {
                    "sense_id": "13b1f13d-e1a9-3816-95f2-5342325b6362",
                    "sense_definition": "einen Polterabend feiern und dabei nach altem Brauch Geschirr zerschlagen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "brauch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor der eigentlichen Hochzeit <w>polterten</w> die Freunde des Brautpaares bis spät in die Nacht."
                        },
                        {
                            "text": "Auf der Straße wurde ausgiebig <w>gepoltert</w>, um dem Paar Glück für die Zukunft zu bringen."
