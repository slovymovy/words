                        "glosses": [
                            "Personne qui produit du cidre et ses produits transformés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af2c3097-8f19-476f-b8c4-91bbe3ac046e",
                                "sense_id": "05a4abac-ab93-3b97-86cc-6935617fb39f",
                                "text": "Quant au cidre, après sa légalisation au Québec en 1970, les cidriculteurs ont amélioré considérablement sa qualité."
                            },
                            {
                                "example_id": "662ce88a-a20f-43b1-9949-310f5bd7f240",
                                "sense_id": "05a4abac-ab93-3b97-86cc-6935617fb39f",
                                "text": "Les cidriculteurs Anne et Jean-Luc Aurignac vous proposeront tout leur savoir-faire en ce qui concerne les multiples déclinaisons du fruit défendu que le couple transforme lui-même."
                            },
                            {
                                "example_id": "438a7f3b-cddf-4fa2-8568-7d7902811ee5",
                                "sense_id": "05a4abac-ab93-3b97-86cc-6935617fb39f",
                                "text": "On peut citer à cet égard que le frère Abel, un cidriculteur bien connu, déclare que le froid ne tue pas l’anthonome et qu’il appuie cette assertion sur les recherches qu’il a faites cet hiver même."
                            }
                        ]
                    }
