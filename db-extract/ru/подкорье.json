                                        "entry_id": "22610df9-2aef-35b2-89a2-eebe9cfb8271",
                                        "glosses": [
                                            "An extremely one-sided, usually short, match."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7f83538-13f5-45e5-af4b-db441ba8c616",
                                                "sense_id": "7d73ec48-c2df-3417-a3f0-c3d935e2893e",
                                                "text": "It was one of the most shocking WWE title matches ever witnessed, and effectively a 20-minute squash match as Brock Lesnar \"conquered\" his opponent."
                                            }
