                        ]
                    },
                    {
                        "translation_id": "a58d7d04-cce6-4192-b4b5-4612fae2e34a",
                        "source_entry_id": "9c342d15-449c-3de6-b427-572aefa552f5",
                        "source_sense_description": "The state of being objective",
                        "target_lang_word": "objectivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objectivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d46388b6-d537-3cb4-bb5a-434a66398e68",
                                        "entry_id": "e005f5c7-31d4-3fe6-94a5-71bad37d463a",
                                        "glosses": [
                                            "Qualité de ce qui est objectif, existence des objets en dehors de nous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eacdd9a-8e33-404d-8f8c-bcf837219bd2",
                                                "sense_id": "d46388b6-d537-3cb4-bb5a-434a66398e68",
                                                "text": "Pour ceux-là, la vérité est apparue comme étant intrinsèquement liée à l'objectivité, c'est-à-dire à sa manifestation sous le regard de tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79b5ab91-0442-3dfe-b1d9-e5c22d3b57b8",
                                        "entry_id": "e005f5c7-31d4-3fe6-94a5-71bad37d463a",
                                        "glosses": [
                                            "Soumission de l’esprit à l’objet dans la recherche scientifique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c58efe4c-cfc8-379f-affa-60c9e030bb5a",
                                        "entry_id": "e005f5c7-31d4-3fe6-94a5-71bad37d463a",
                                        "glosses": [
                                            "Qualité de neutralité, impartialité, désintéressement, ou impersonnalité vis-à-vis d'un sujet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2a88abb-1c50-44de-9342-c82dd03e139f",
                        "source_entry_id": "9c342d15-449c-3de6-b427-572aefa552f5",
                        "source_sense_description": "The state of being objective",
                        "target_lang_word": "Objektivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Objektivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b1de23e-3142-3b73-8ca1-c9ed54ac565d",
                                        "entry_id": "4e7cdb7a-ec71-36ff-b41c-50383cc4d5b2",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße neutrales, unparteiisches (objektives) Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8df313e-57b9-4a80-8c9f-56122723222b",
                                                "sense_id": "4b1de23e-3142-3b73-8ca1-c9ed54ac565d",
                                                "text": "„Ein Ziel unserer Verlaufsuntersuchungen ist die Erreichung einer höchstmöglichen Objektivität.“"
                                            },
                                            {
                                                "example_id": "237e6423-d7b9-4ee3-bada-3fbc2e93709b",
                                                "sense_id": "4b1de23e-3142-3b73-8ca1-c9ed54ac565d",
                                                "text": "„Objektivität kann negativ bestimmt werden als: ‚Das Urteil ist frei von subjektiven Störmomenten‘ oder positiv: ‚Das Urteil wird ausschließlich von der zu beurteilenden Sache (Leistung) und durch nichts anderes bestimmt‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e846b6dc-ed6f-316e-9e06-7f1e4362ed71",
                                        "entry_id": "4e7cdb7a-ec71-36ff-b41c-50383cc4d5b2",
                                        "glosses": [
                                            "Einheit, die objektiv betrachtet werden kann; zum Beispiel: Dinge, Raum, Zeit, das Ich, der andere"
                                        ],
                                        "tags": [
                                            "mit Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc649307-3a95-48ef-9a4c-ef6be709d0dd",
                                                "sense_id": "e846b6dc-ed6f-316e-9e06-7f1e4362ed71",
                                                "text": "„Existenz sieht sich in ihrem Dasein als Subjektivität unabhängigen Objektivitäten (der bestehenden Natur, der zwingend gültigen Wahrheit, den vorgefundenen Institutionen in Staat und Kirche) gegenüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
