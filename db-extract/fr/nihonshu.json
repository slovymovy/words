                        "glosses": [
                            "Boisson alcoolisée japonaise, à base de riz, s’apparentant à la bière ou au vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69bec97e-07cc-4b10-9a70-32aa87b04427",
                                "sense_id": "a3b790d0-5c66-3973-a649-e58e5e30a775",
                                "text": "Le nihonshu, le « vrai » saké japonais est une boisson fermentée, dont le mode de fabrication s’apparente plutôt à celui du vin de raisin."
                            },
                            {
                                "example_id": "a6743720-3578-488d-a5f8-62929cb79c9f",
                                "sense_id": "a3b790d0-5c66-3973-a649-e58e5e30a775",
                                "text": "À mille lieues des alcools de riz chinois avec lesquels on le confond souvent à tort, le saké japonais, ou nihonshu, est une boisson délicate et riche en arômes dont la fabrication et la dégustation ne sont pas sans rappeler celles du vin."
                            }
                        ]
