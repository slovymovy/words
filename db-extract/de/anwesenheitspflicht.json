                        "entry_id": "17f9793a-23c5-3fe9-9b6d-df1fb4c0a21f",
                        "glosses": [
                            "die Vorgabe, bei einer Veranstaltung gegenwärtig (anwesend) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e56d184-f9c0-4b1a-b0d2-26fee2fa9c77",
                                "sense_id": "16643336-176e-30f8-b5f4-407e18ea9ffc",
                                "text": "Magister-Studenten haben keine Anwesenheitspflicht."
                            },
                            {
                                "example_id": "8e1bd3d2-a8b2-4524-85ed-073a14b1b20d",
                                "sense_id": "16643336-176e-30f8-b5f4-407e18ea9ffc",
                                "text": "Die Anwesenheitspflicht wurde im letzten Jahr wieder eingeführt."
                            },
                            {
                                "example_id": "aee2404b-2cca-49a0-ad99-02c6e3fae5df",
                                "sense_id": "16643336-176e-30f8-b5f4-407e18ea9ffc",
                                "text": "„Eine besonders verhasste Veranstaltung mit Anwesenheitspflicht war der wöchentliche Gottesdienst in Bucknell, bei den Roth sich stets stur in Schopenhauer vertiefte.“"
                            }
