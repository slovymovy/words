                "senses": [
                    {
                        "sense_id": "513ed244-84fe-3db0-a783-e114a8120527",
                        "entry_id": "4274ca1e-0443-376b-824f-2b009936d7b9",
                        "glosses": [
                            "To flatten, as if with a steamroller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90a394d-81ee-4b0b-a5fb-a602ec7ddf28",
                                "sense_id": "513ed244-84fe-3db0-a783-e114a8120527",
                                "text": "The service had one small break when it was suspended between October, 1904, and April, 1905, owing to the refusal of the Helston Rural District Council to steam roll the road. At this time there was no steam roller in use anywhere west of Plymouth, and the railway company loaned one of its steam rollers to the Cornwall County Council, to secure an improvement in the road conditions."
                            }
                        ]
                    },
                    {
                        "sense_id": "3dd0e6ab-e640-396a-b1d4-5f16ecce90f0",
                        "entry_id": "4274ca1e-0443-376b-824f-2b009936d7b9",
                        "glosses": [
                            "To ruthlessly crush or overwhelm."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a3f73b3d-4b9d-46f7-8e51-c19d7d6ac100",
                                "sense_id": "3dd0e6ab-e640-396a-b1d4-5f16ecce90f0",
                                "text": "I tried to participate in a sports tournament, but got steamrolled by the better players there."
                            },
                            {
                                "example_id": "d1c19fc0-a702-4b35-9e39-dd3fb13028a0",
                                "sense_id": "3dd0e6ab-e640-396a-b1d4-5f16ecce90f0",
                                "text": "In The Trial of Henry Kissinger the late British journalist, best known for his Vanity Fair columns, his deliberately provocative opinion that women aren’t funny and his penchant for booze and fags, steamrolls the former US National Security Advisor and Secretary of State for Presidents Nixon and Ford with a polemical brilliance so assured it cancels out the occasional flashes of arrogance and pomposity."
                            }
                        ]
                    }
                ],
                "translations": [
