                "senses": [
                    {
                        "sense_id": "db9e1c99-2e99-37c3-a361-569d65660b39",
                        "entry_id": "5bf51a96-0b52-365d-bab9-bad0d6539998",
                        "glosses": [
                            "Concentré, méditatif, qui est dans le recueillement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9209860e-5fcb-4137-8cca-6bc382b5c691",
                                "sense_id": "db9e1c99-2e99-37c3-a361-569d65660b39",
                                "text": "L’assemblée est recueillie dans la prière."
                            }
                        ]
                    },
                    {
                        "sense_id": "4340a588-14ff-3025-b247-d72642c2db5e",
                        "entry_id": "5bf51a96-0b52-365d-bab9-bad0d6539998",
                        "glosses": [
                            "Marqué par le recueillement."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "4f4e4f7c-b379-40fa-a5b9-ca76d4971f18",
                                "sense_id": "4340a588-14ff-3025-b247-d72642c2db5e",
                                "text": "Un visage recueilli."
                            },
                            {
                                "example_id": "9d611a00-a9a8-49d8-89de-17387790e45a",
                                "sense_id": "4340a588-14ff-3025-b247-d72642c2db5e",
                                "text": "Sa physionomie était profondément recueillie ; certaines félicités jettent l’âme dans une ineffable tristesse, dans une sainte mélancolie."
                            },
                            {
                                "example_id": "533ae8bf-0349-46b6-a5c1-8a20abc952c3",
                                "sense_id": "4340a588-14ff-3025-b247-d72642c2db5e",
                                "text": "Parfois, quand tous ces grotesques tapaient à bras raccourcis sur la République, on voyait ses yeux rire sans que ses lèvres perdissent leur moue d’homme grave. Sa façon recueillie d’écouter, sa complaisance inaltérable lui avaient concilié toutes les sympathies. On le jugeait nul, mais bon enfant."
                            }
                        ]
                    },
                    {
                        "sense_id": "375ac76f-96d5-3f70-8120-f2305fc8dbfa",
                        "entry_id": "5bf51a96-0b52-365d-bab9-bad0d6539998",
                        "glosses": [
                            "Rassemblé, collecté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6edca9f-7d04-40fb-8d87-8ae0718859c7",
                                "sense_id": "375ac76f-96d5-3f70-8120-f2305fc8dbfa",
                                "text": "Les spécimens recueillis sont entreposés dans la réserve du musée."
                            }
                        ]
                    }
                ],
