                                "sense_id": "6ff62fa6-4702-3ff9-a4a1-954dd0670166",
                                "text": "Der Verhaftete beteuerte seine Unschuld."
                            },
                            {
                                "example_id": "260fa5b8-8adf-445a-aa67-d07053455770",
                                "sense_id": "6ff62fa6-4702-3ff9-a4a1-954dd0670166",
                                "text": "Dem Verhafteten wurden seine Rechte vorgelesen."
                            },
                            {
                                "example_id": "d6d5bd4c-5665-48ca-a0c7-edf9a7fac175",
                                "sense_id": "6ff62fa6-4702-3ff9-a4a1-954dd0670166",
                                "text": "Mehrere Verhaftete machten keine Angaben zu den Vorwürfen."
                            },
