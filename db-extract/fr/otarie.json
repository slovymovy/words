                                                "sense_id": "0980a46a-f76a-3d5b-8839-9ed562e96780",
                                                "text": "„Fischer fangen den Tieren das Futter weg - und immer wieder landen die Seelöwen selbst als Beifang in den Netzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
