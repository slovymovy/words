                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "267eee73-6348-4d3e-b19c-71031a221b51",
                                "sense_id": "92ff22f0-82ba-3912-bc37-013308b51bb7",
                                "text": "сто́лько тем, что и не переговори́ть",
                                "translation": "there are so many things to discuss you can't cover them all",
                                "english": "there are so many things to discuss you can't cover them all"
                            }
                        ]
                    },
                    {
                        "sense_id": "3fab70cc-d5f6-32f9-8a68-a717f2df15e8",
                        "entry_id": "ee0ce0da-a425-3904-9803-4bd6c3c03961",
                        "glosses": [
