                "senses": [
                    {
                        "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                        "entry_id": "8f9b2d3f-398f-3660-a5af-25e12cd31a79",
                        "glosses": [
                            "eine Sammelbezeichnung für die fünf Bücher Mose, das heißt die ersten fünf Bücher des Alten Testaments"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "702ccd8e-0c0d-42ad-b75d-53ecb398c292",
                                "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                "text": "Das Buch Genesis ist das erste Buch des Pentateuchs."
                            },
                            {
                                "example_id": "37d53488-dba7-4b1e-a907-ff93c90b604f",
                                "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                "text": "Der Pentateuch besteht aus folgenden fünf Büchern: Genesis, Exodus, Levitikus, Numeri, Deuteronomium."
                            },
                            {
                                "example_id": "602e5265-18dc-41f1-8317-308a7354386d",
                                "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                "text": "Der Pentateuch wurde etwa 440 v. Chr. fertiggestellt."
                            },
                            {
                                "example_id": "5c32f7a6-5fa6-40fb-89f6-0a49cd3cdafa",
                                "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                "text": "„Er glaubte nicht an den Pentateuch, war aber der Meinung, daß Gott im Talmud gegenwärtig sei.“"
                            },
                            {
                                "example_id": "f1d2aa7a-1888-44a4-ad83-972932200f7f",
                                "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                "text": "„1544 erschienen in Konstanz und Augsburg zwei jiddische Übersetzungen des Pentateuch nach Manuskripten, die auf der traditionellen jiddischen Übersetzungspraxis beruhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
