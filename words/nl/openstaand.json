                },
                {
                    "sense_id": "d0369dfe-f3ed-3c4a-afb2-99171f7af68f",
                    "sense_definition": "nog niet betaald of voldaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "U moet vandaag nog een <w>openstaand</w> bedrag van vijftig euro overmaken.",
                            "target_lang_translations": {
                                "fr": "Vous devez encore virer aujourd'hui un montant <w>dû</w> de cinquante euros."
                            }
                        },
                        {
                            "text": "Het bedrijf heeft nog meerdere <w>openstaande</w> facturen bij die klant.",
                            "target_lang_translations": {
                                "fr": "L'entreprise a encore plusieurs factures <w>impayées</w> auprès de ce client."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbetaald"
                    ],
                    "antonyms": [
                        "betaald",
                        "voldaan"
                    ],
                    "common_phrases": [
                        "openstaand bedrag",
                        "openstaande rekening",
                        "openstaande factuur"
                    ],
                    "target_lang_definitions": {
                        "fr": "qui n'a pas encore été payé ou réglé"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "impayé",
                                "target_lang_sense_clarification": "facture, dette"
                            },
                            {
                                "target_lang_word": "en souffrance",
                                "target_lang_sense_clarification": "facture, compte en attente de règlement"
                            },
                            {
                                "target_lang_word": "dû",
                                "target_lang_sense_clarification": "somme restante à régler"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a905d776-d51f-3700-a94b-e55c141bd65d",
                    "sense_definition": "nog niet vervuld of bezet",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beschikbaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zijn op onze afdeling nog twee <w>openstaande</w> vacatures beschikbaar.",
                            "target_lang_translations": {
                                "fr": "Il y a encore deux postes <w>vacants</w> disponibles dans notre département."
                            }
                        },
                        {
                            "text": "Hij solliciteerde direct op die interessante <w>openstaande</w> functie.",
                            "target_lang_translations": {
                                "fr": "Il a immédiatement postulé à ce poste intéressant <w>à pourvoir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbezet",
                        "vacant"
                    ],
                    "antonyms": [
                        "bezet",
                        "vervuld"
                    ],
                    "common_phrases": [
                        "openstaande vacature"
                    ],
                    "target_lang_definitions": {
                        "fr": "qui n'a pas encore été pourvu ou occupé"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "vacant",
                                "target_lang_sense_clarification": "poste, emploi"
                            },
                            {
                                "target_lang_word": "à pourvoir",
                                "target_lang_sense_clarification": "poste, offre d'emploi"
                            }
                        ]
                    }
                }
            ]
        },
