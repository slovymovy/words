                                "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                "text": "NASA was often accused of talking over the public's head."
                            },
                            {
                                "example_id": "6d1a656e-5650-44e6-a839-87f625023fca",
                                "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                "text": "Researchers at NASA have taken an interest in 'mycotecture' and its potential role in growing structures on the Moon."
                            },
                            {
                                "example_id": "b89e801d-04ce-42e2-bbec-597cf2840464",
                                "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                "text": "A NASA spokesperson said in a statement “employees would be placed on temporary remote work agreements while NASA seeks and evaluates options for a new space for the GISS team.”"
                            }
                        ]
