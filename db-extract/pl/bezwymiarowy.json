                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9f220d61-780b-3fd9-ab62-80f94fc6137e",
                        "entry_id": "26dbb177-531f-323b-851f-0363685f2b94",
                        "glosses": [
                            "nie posiadający jednostki miary"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bf046e8-0cd3-4783-bbce-2cdb8c27a112",
                                "sense_id": "9f220d61-780b-3fd9-ab62-80f94fc6137e",
                                "text": "W hydrodynamice stosowana jest liczba Reynoldsa będąca wielkością bezwymiarową."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90474e52-ee7e-44da-8430-5623cabdba26",
                        "source_entry_id": "26dbb177-531f-323b-851f-0363685f2b94",
                        "source_sense_id": "291314b4-7de7-38c7-a1dd-eb4a1c7550e0",
                        "target_lang_word": "dimensionless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dimensionless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47fc2cdb-f67c-3faa-8c67-ab8dd1dd4058",
                                        "entry_id": "70d8073f-501a-325d-8e33-8e24a56b15b1",
                                        "glosses": [
                                            "Lacking dimensions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eb31c7e-4d77-4d24-b80f-555fc07e0143",
                                                "sense_id": "47fc2cdb-f67c-3faa-8c67-ab8dd1dd4058",
                                                "text": "To Heav'n thir prayers / Flew up, nor miſsd the way, by envious windes / Blow'n vagabond or fruſtrate: in they paſsd / Dimentionleſs through Heav'nly dores; […]"
                                            },
                                            {
                                                "example_id": "bf598ee9-5279-4796-b974-38e3fbf2b88a",
                                                "sense_id": "47fc2cdb-f67c-3faa-8c67-ab8dd1dd4058",
                                                "text": "Extended objects may be separated by dimensionless points; but dimensionless points cannot be separated, but by some real distance, or something really extended."
                                            },
                                            {
                                                "example_id": "89032994-a0da-436e-a975-2b6c2231c885",
                                                "sense_id": "47fc2cdb-f67c-3faa-8c67-ab8dd1dd4058",
                                                "text": "1930, E. E. Smith, Skylark Three, Fantasy Press, 1948, Chapter 3,\nThey saw the utter, absolute darkness of the complete absence of all light; and upon that indescribable blackness they beheld superimposed the almost unbearable brilliance of enormous suns concentrated into mathematical points, dimensionless."
                                            },
                                            {
                                                "example_id": "bc3c47f1-0a9e-4f65-bf5a-430b0c4bc1a4",
                                                "sense_id": "47fc2cdb-f67c-3faa-8c67-ab8dd1dd4058",
                                                "text": "He did not look once again toward the dark house. […] He simply went quietly as if that were his natural manner of moving and passed around the now dimensionless bulk of the house, toward the rear, where the kitchen would be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05507cd2-d4c4-3287-8dad-79dc36aaf843",
                                        "entry_id": "70d8073f-501a-325d-8e33-8e24a56b15b1",
                                        "glosses": [
                                            "Of a physical constant: lacking units."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af6432dc-02a0-4187-aa81-9ac1228d8314",
                                                "sense_id": "05507cd2-d4c4-3287-8dad-79dc36aaf843",
                                                "text": "Iron has a density of 7.8 grams per cubic centimeter: its dimensionless relative density is 7.8."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
