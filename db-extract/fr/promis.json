                        ],
                        "examples": [
                            {
                                "example_id": "529acdff-3a79-4d54-93b3-ec355988c208",
                                "sense_id": "e8cca193-86ff-3d3a-8270-885863a2ccd8",
                                "text": "Il ne savait pas que Rosalie était promise."
                            }
                        ]
                    }
