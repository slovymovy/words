                "senses": [
                    {
                        "sense_id": "84794b57-fa8b-336b-92e7-53b96950da30",
                        "entry_id": "b92ce3c5-9de5-363a-96f1-67e374e61fc4",
                        "glosses": [
                            "D'une manière rythmique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82df79ec-126f-4847-b02d-0940f877da1a",
                                "sense_id": "84794b57-fa8b-336b-92e7-53b96950da30",
                                "text": "Les spectateurs les accompagnaient en battant rythmiquement des mains et en chantant des airs tahitiens plus mélodieux que la dure langue mangarevienne."
                            },
                            {
                                "example_id": "29dd3851-ed6d-4cea-99c1-0d4b924f5284",
                                "sense_id": "84794b57-fa8b-336b-92e7-53b96950da30",
                                "text": "Dans son allégresse, elle accompagne de ses chants et de ses danses, en battant rythmiquement des mains, les ritournelles d'un gramophone […] ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9638dbb0-9b87-45e8-b61b-301f2e57e9ce",
