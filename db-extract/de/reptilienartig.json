                ],
                "senses": [
                    {
                        "sense_id": "f7126a49-773e-38d1-a15b-6b978dbbd8ec",
                        "entry_id": "e9777da3-988a-356e-8650-f0c9735399ef",
                        "glosses": [
                            "einem Reptil ähnelnd, an ein Reptil erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db01e525-78e9-46ac-9693-f34468e4a4b4",
                                "sense_id": "f7126a49-773e-38d1-a15b-6b978dbbd8ec",
                                "text": "„Ein gespenstisches, smaragdgrünes Glühen erfüllte die Stadt und die Gesichter der Menschen sahen ein bisschen reptilienartig aus.“"
                            },
                            {
                                "example_id": "4ad122aa-96cf-4185-85f4-5d639f81f879",
                                "sense_id": "f7126a49-773e-38d1-a15b-6b978dbbd8ec",
                                "text": "„Sie kannten kein Licht, hatten jedoch bereits lange, bevor die reptilienartigen Vierfüßler von Yoth existierten, große Kulturen hervorgebracht und beteten zu mächtigen Göttern.“"
                            },
                            {
                                "example_id": "f72f94a2-3e54-478c-80a1-c0a7a72b10af",
                                "sense_id": "f7126a49-773e-38d1-a15b-6b978dbbd8ec",
                                "text": "„Vor mir im Dunkeln hörte ich diese Laute nun erneut, und darunter mischten sich fürchterliche Gleitgeräusche, die klangen, als drängten unzählige reptilienartige Geschöpfe auf mich zu.“"
                            },
                            {
                                "example_id": "8811472b-1536-4ac8-bb55-25cd0d746199",
                                "sense_id": "f7126a49-773e-38d1-a15b-6b978dbbd8ec",
                                "text": "„Epiphytische Orchideen, gezeichnet mit reptilienartigen Tupfen, neigten sich von hängenden Ästen grotesk zu Thone hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
