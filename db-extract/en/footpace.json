                        "entry_id": "0ad22c37-b92c-3a74-ba39-61d1742d6414",
                        "glosses": [
                            "A walking pace or step."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35005d8b-41de-4341-a28d-7c8e73aa0bbe",
                                "sense_id": "2732c9b7-1279-3ea0-b629-0fd7fbd8c417",
                                "text": "We went at a foot-pace, but on the way back we trotted, and there was something to my mind singularly horrible in the way the driver of the hearse whipped up his horses."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8e2391d-018b-3b56-886c-8a05605d5fc1",
                        "entry_id": "0ad22c37-b92c-3a74-ba39-61d1742d6414",
                        "glosses": [
                            "A dais, or elevated platform; the highest step of the altar; a landing in a staircase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e5bea68-d1b0-4ab3-bc13-c91f54c4511d",
                                "sense_id": "f8e2391d-018b-3b56-886c-8a05605d5fc1",
                                "text": "The king has laid his crown on the ground beside him , and the covered box which represents his present stands on the footpace."
                            }
                        ]
                    }
