                "senses": [
                    {
                        "sense_id": "6994e827-ef6f-35af-86d6-d20b7e95467c",
                        "entry_id": "8da229b6-c9ed-3fff-8243-721f4f75c45d",
                        "glosses": [
                            "een stoel die ontworpen is om in een kantooromgeving gebruikt te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "778bd767-fca5-48a9-bba6-e4842b1c0121",
                                "sense_id": "6994e827-ef6f-35af-86d6-d20b7e95467c",
                                "text": "De chique, ruime schrijftafel van ebbenhout, die stijlvol was ingelegd met lichtere houtsoorten, die voor het raam was geplaatst naast de openslaande deuren naar het terras en die gepaard was aan een sobere maar degelijke en comfortabele houten bureaustoel uit de jaren dertig, had ik al meteen bij binnenkomst opgemerkt."
                            },
                            {
                                "example_id": "edb2e78b-f2fc-49b9-8e77-13c3d45ff66e",
                                "sense_id": "6994e827-ef6f-35af-86d6-d20b7e95467c",
                                "text": "Toen ze eenmaal zaten, liet hij zich in de zwartleren bureaustoel zakken en zuchtte."
                            },
                            {
                                "example_id": "fdacfa94-5331-423b-8dae-a2fabd00b689",
                                "sense_id": "6994e827-ef6f-35af-86d6-d20b7e95467c",
                                "text": "Veel bureaustoelen hebben wieltjes om te kunnen rollen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fae6c53-18a8-4165-b6fa-438f71d0b046",
                        "source_entry_id": "8da229b6-c9ed-3fff-8243-721f4f75c45d",
                        "source_sense_id": "6994e827-ef6f-35af-86d6-d20b7e95467c",
                        "source_sense_description": "een stoel die ontworpen is om in een kantooromgeving gebruikt te worden",
                        "target_lang_word": "Schreibtischstuhl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreibtischstuhl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf527682-ff3c-3365-9b51-dd2ba2fdcc0d",
                                        "entry_id": "193bf882-217f-3fa8-af9b-8e5e20bacfa9",
                                        "glosses": [
                                            "ergonomisch gestaltetes Sitzmöbel, das am Schreibtisch benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "643dfcf6-1faa-45cf-aa94-e407b6d10140",
                                                "sense_id": "bf527682-ff3c-3365-9b51-dd2ba2fdcc0d",
                                                "text": "„Dann erhob er sich von seinem Schreibtischstuhl und begleitete die beiden Männer nach draußen.“"
                                            },
                                            {
                                                "example_id": "58af744f-546a-42e3-97a6-c3b1fdeadb7f",
                                                "sense_id": "bf527682-ff3c-3365-9b51-dd2ba2fdcc0d",
                                                "text": "„Einen Augenblick lang verharrte sein massiger Körper über dem Schreibtischstuhl, dann schlug er in einem plötzlichen Anfall von Frustration mit der Faust auf den Tisch.“"
                                            },
                                            {
                                                "example_id": "9543de8e-cb36-4430-a5ae-fd0956658a7f",
                                                "sense_id": "bf527682-ff3c-3365-9b51-dd2ba2fdcc0d",
                                                "text": "„Kurzerhand zog ich mir den Tritthocker vor dem Bücherregal heran, Ben ließ sich in den Schreibtischstuhl fallen.“"
                                            },
                                            {
                                                "example_id": "f0810cf3-0123-4d0d-bbce-4a8aaeb60024",
                                                "sense_id": "bf527682-ff3c-3365-9b51-dd2ba2fdcc0d",
                                                "text": "„Nachdem Cyprian gegangen war, sank Sylvia auf ihren Schreibtischstuhl und ließ den Kopf hängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
