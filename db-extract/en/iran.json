                                "target_senses": [
                                    {
                                        "sense_id": "b437206a-69b9-3592-9fa4-6f506636a90a",
                                        "entry_id": "d045f9d9-489e-3137-ac8d-602aea1d98e7",
                                        "glosses": [
                                            "ein Staat in Vorderasien"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d838699e-c0fe-4ffa-a90f-0740e833fafa",
                                                "sense_id": "b437206a-69b9-3592-9fa4-6f506636a90a",
                                                "text": "Teheran ist die Hauptstadt von Iran."
                                            },
                                            {
                                                "example_id": "b2adc92b-ce7b-4fed-937c-6739615f1047",
                                                "sense_id": "b437206a-69b9-3592-9fa4-6f506636a90a",
                                                "text": "„Aufgrund der geologischen Gegebenheiten und der vermutlich noch anhaltenden Gebirgsbildung treten im Iran häufig Erdbeben auf.“"
                                            },
                                            {
                                                "example_id": "f0267f8a-9cbf-4c28-a952-d839ac1ede20",
                                                "sense_id": "b437206a-69b9-3592-9fa4-6f506636a90a",
                                                "text": "„Russland hat ungeachtet des Protests westlicher Länder dem Iran den Verkauf von S-300-Flugabwehrraketen zugesagt, bislang aber nicht geliefert.“"
                                            },
                                            {
                                                "example_id": "e232d819-bc7f-4bf5-8d8c-379c90bde4ce",
                                                "sense_id": "b437206a-69b9-3592-9fa4-6f506636a90a",
                                                "text": "„Im Iran habe ich ihn offenbar vor lauter Gerede über Immobilienpreise und Schönheitschirurgen immer überhört.“"
                                            },
                                            {
                                                "example_id": "1e338ef8-3a8e-4085-afb7-65b90c7096cd",
                                                "sense_id": "b437206a-69b9-3592-9fa4-6f506636a90a",
                                                "text": "„Fast täglich werden“ […] „im Iran Menschen von der Staatsmacht hingerichtet.“"
                                            },
                                            {
                                                "example_id": "050f223c-4924-48a2-9da1-37ec79127bfa",
                                                "sense_id": "b437206a-69b9-3592-9fa4-6f506636a90a",
                                                "text": "„Die entscheidende Frage ist (wie immer in der Politik): Was hat die ganze Diplomatie gebracht? In Bezug auf Iran muss man leider ernüchtert feststellen: nicht viel.“"
                                            },
                                            {
                                                "example_id": "3534af09-2cda-41cc-b103-b41370c8014c",
                                                "sense_id": "b437206a-69b9-3592-9fa4-6f506636a90a",
                                                "text": "„Die Region der Meder konzentriert sich auf das alte Babylon, die Region der Perser schließt das moderne Iran, Afghanistan und das westliche Pakistan ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
