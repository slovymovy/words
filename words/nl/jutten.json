                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger <w>jutten</w> de bewoners van het eiland regelmatig na een storm.",
                            "target_lang_translations": {
                                "en": "In the past, the inhabitants of the island regularly <w>beachcombed</w> after a storm."
                            }
                        },
                        {
                            "text": "Wij <w>jutten</w> urenlang langs de kustlijn totdat de zon helemaal onderging.",
                            "target_lang_translations": {
                                "en": "We <w>scavenged</w> along the coastline for hours until the sun set completely."
                            }
                        }
                    ],
