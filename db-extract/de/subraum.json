                                        "examples": [
                                            {
                                                "example_id": "31ecb062-53cf-457f-adde-ea91be950126",
                                                "sense_id": "66c074f0-a9e0-3288-9c4b-a1b5ed17b624",
                                                "text": "“If he reconfigures the subspace relays and uploads his own code into them, he'll have access to the computers on every planet, ship, and station.” “Alarming. He could vent oxygen, crash vessels, or even detonate warp cores.” “Everyone in the quadrant's gonna die, and it's all my fault.” “Parents are not directly responsible for the actions of their children.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f43aa9ad-61d5-32bf-975f-b6b496caee48",
                                        "entry_id": "0b016368-33ee-33a6-b452-631f3d0dc333",
                                        "glosses": [
                                            "An alternative dimension or universe, access to or use of which permits faster-than-light travel or communications; hyperspace."
