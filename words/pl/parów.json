{
    "word_family": [
        "parowaty",
        "parowisko",
        "parówek"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "465d3653-1a22-35ae-a9ec-99ce88d8845f",
                    "sense_definition": "Wąska, sucha i płaskodenna dolina o stosunkowo łagodnych, często porośniętych roślinnością zboczach.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ukształtowanie_terenu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wąska ścieżka prowadziła prosto przez zacieniony <w>parów</w>, w którym płynął niegdyś strumień.",
                            "target_lang_translations": {
                                "ru": "Узкая тропа вела прямо через тенистый <w>овраг</w>, по которому когда-то протекал ручей."
                            }
                        },
                        {
                            "text": "Turyści ostrożnie zeszli na dno głębokiego <w>parowu</w>, podziwiając porośnięte krzewami zbocza.",
                            "target_lang_translations": {
                                "ru": "Туристы осторожно спустились на дно глубокой <w>лощины</w>, любуясь заросшими кустарником склонами."
                            }
                        }
                    ],
                    "synonyms": [
                        "jar",
                        "rozdół"
                    ],
                    "common_phrases": [
                        "dno parowu",
                        "głęboki parów"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая, сухая долина с плоским дном и относительно пологими, часто заросшими склонами; овраг или лощина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овраг",
                                "target_lang_sense_clarification": "крупная ложбина, эрозионная форма рельефа"
                            },
                            {
                                "target_lang_word": "лощина",
                                "target_lang_sense_clarification": "долина с пологими заросшими склонами"
                            },
                            {
                                "target_lang_word": "балка",
                                "target_lang_sense_clarification": "сухая широкая долина с задернованными склонами"
                            },
                            {
                                "target_lang_word": "яр",
                                "target_lang_sense_clarification": "глубокий овраг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "801cb39e-ef90-3b25-8bed-c2bfab3f5c19",
                    "sense_definition": "Dopełniacz liczby mnogiej od rzeczownika <w>parówa</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "forma_gramatyczna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W menu starej stołówki nie było już tych tłustych <w>parów</w>, które pamiętał z dzieciństwa.",
                            "target_lang_translations": {
                                "ru": "В меню старой столовой уже не было тех жирных <w>сарделек</w>, которые он помнил с детства."
                            }
                        },
                        {
                            "text": "Do ugotowania tych wielkich <w>parów</w> potrzebny był wyjątkowo szeroki garnek.",
                            "target_lang_translations": {
                                "ru": "Для варки этих огромных <w>сарделек</w> требовалась необычайно широкая кастрюля."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma gramatyczna"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Родительный падеж множественного числа от существительного parówa (сарделька, сосиска, пар)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сарделек",
                                "target_lang_sense_clarification": "род. п. мн. ч. от сарделька (толстая сосиска)"
                            },
                            {
                                "target_lang_word": "сосисок",
                                "target_lang_sense_clarification": "род. п. мн. ч. от сосиска"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}