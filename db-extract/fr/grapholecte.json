                        "glosses": [
                            "Langue ou dialecte écrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d78b4f-de42-4132-9c47-e4ef87d0582c",
                                "sense_id": "86b9789b-3fe8-3d19-92ee-6167d1cb2f29",
                                "text": "C’est un public cultivé qui lit les œuvres ou regarde les pièces au XIXᵉ et dans la première moitié du XXᵉ siècle, et ses attentes en matière d’écriture vont vers le style écrit standard, le grapholecte soutenu de la langue."
                            }
                        ]
                    }
