                "senses": [
                    {
                        "sense_id": "625f1e6b-a5bd-3f94-9ccf-dbbacf945f56",
                        "entry_id": "a1ff41b5-639e-310c-95ba-57fb767cfeaa",
                        "glosses": [
                            "wereldwijde temperatuurverhoging door de aanwezigheid van broeikasgassen (vooral kooldioxide) in de dampkring"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "404c9979-8aee-4136-8363-067e80a310a8",
                                "sense_id": "625f1e6b-a5bd-3f94-9ccf-dbbacf945f56",
                                "text": "- De Franse wetenschapper Jean-Baptiste Fourier vergelijkt (in 1827) het opwarmingseffect in de atmosfeer met een broeikas."
                            },
                            {
                                "example_id": "82273f62-d9d8-4116-99e1-c2a60f6b9a3d",
                                "sense_id": "625f1e6b-a5bd-3f94-9ccf-dbbacf945f56",
                                "text": "- Zonder broeikaseffect zou de aarde onleefbaar zijn de gemiddelde temperatuur zou dan -18 graden celcius zijn i.p.v. de huidige +15 graden Celcius."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03215c83-d065-403d-a875-dd346831cabc",
                        "source_entry_id": "a1ff41b5-639e-310c-95ba-57fb767cfeaa",
                        "source_sense_id": "625f1e6b-a5bd-3f94-9ccf-dbbacf945f56",
                        "target_lang_word": "Treibhauseffekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treibhauseffekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d19b0e40-71a3-3183-af6d-e3bed9969998",
                                        "entry_id": "359ce8d7-ae83-3ce5-abcd-23088d61effd",
                                        "glosses": [
                                            "das Ansteigen der weltweiten Durchschnittstemperatur, bedingt durch die Abgabe und Anreicherung sog. Treibhausgase, vor allem Kohlendioxid, in die Erdatmosphäre"
                                        ],
                                        "tags": [
                                            "Klimatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e47aeed-f5ae-49d4-9a70-e429bee394f0",
                                                "sense_id": "d19b0e40-71a3-3183-af6d-e3bed9969998",
                                                "text": "Vergleiche mit den Daten anderer Planeten und (relativ) einfache Berechnungen zeigen, dass es nicht nur hier auf der Erde einen Treibhauseffekt gibt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6220ac94-86eb-3a69-834e-2de24d1fcd26",
                                        "entry_id": "359ce8d7-ae83-3ce5-abcd-23088d61effd",
                                        "glosses": [
                                            "die von der menschlichen Zivilisation verursachte Erderwärmung im Besonderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdeefeb2-ce51-433b-822f-86a14af2d6cd",
                                                "sense_id": "6220ac94-86eb-3a69-834e-2de24d1fcd26",
                                                "text": "Das von Fahrzeugen und Industrien ausgestoßene Kohlendioxid hat über die vergangenen 100 Jahre den Treibhauseffekt verstärkt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27096aea-cd43-4b22-9374-857a01beb847",
                        "source_entry_id": "a1ff41b5-639e-310c-95ba-57fb767cfeaa",
                        "source_sense_id": "625f1e6b-a5bd-3f94-9ccf-dbbacf945f56",
                        "target_lang_word": "greenhouse effect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greenhouse effect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd47525-23d4-3102-8f68-f302b929ae71",
                                        "entry_id": "b9239df8-da30-30f1-bb10-4244e284f93b",
                                        "glosses": [
                                            "The process by which a planet is heated by solar radiation which is retained by its atmosphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1875170-215d-4068-a8a1-7f16c9565824",
                                                "sense_id": "3bd47525-23d4-3102-8f68-f302b929ae71",
                                                "text": "Firstly, the atmosphere may act like the glass of a green-house, letting through the light rays of the sun relatively easy, and absorbing a great part of the dark rays emitted from the ground, and it thereby may raise the mean temperature of the earth's surface."
                                            },
                                            {
                                                "example_id": "b1a3c039-b3f7-451e-a492-c290d3597a03",
                                                "sense_id": "3bd47525-23d4-3102-8f68-f302b929ae71",
                                                "text": "It is time to stop waffling so much and say that the evidence is pretty strong that the greenhouse effect is here."
                                            },
                                            {
                                                "example_id": "7366608d-c7a1-497b-a284-5a0dad48a714",
                                                "sense_id": "3bd47525-23d4-3102-8f68-f302b929ae71",
                                                "text": "This contrasts strangely with Mr. Bush's campaign oratory last summer. “Those who think we are powerless to do anything about the greenhouse effect forget about the ‘White House effect’; as President, I intend to do something about it,” he said in Michigan on Aug. 31. […] Mr. Bush has not acted."
                                            },
                                            {
                                                "example_id": "17b4bafc-51ae-4ec4-a140-b80b03e28bf9",
                                                "sense_id": "3bd47525-23d4-3102-8f68-f302b929ae71",
                                                "text": "In August 1988, Hansen had given dramatic testimony to Congress asserting that “the scientific evidence for the greenhouse effect is overwhelming.” “The greenhouse effect is real, it is coming soon, and it will have major effects on all peoples.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4ff3252-310e-4c0c-89d8-518a5fa6ca47",
                        "source_entry_id": "a1ff41b5-639e-310c-95ba-57fb767cfeaa",
                        "source_sense_id": "625f1e6b-a5bd-3f94-9ccf-dbbacf945f56",
                        "target_lang_word": "effet de serre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effet de serre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af630142-fd6f-39db-a228-c70091551ca9",
                                        "entry_id": "e82524c7-effe-35d3-9e69-7013344e488f",
                                        "glosses": [
                                            "Phénomène de réchauffement d’un espace clos, comme une serre, dû à la transmission de la lumière visible et à la rétention partielle du rayonnement infrarouge."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "587b0656-6540-4fd3-8a0d-8f303b4f2e45",
                                                "sense_id": "af630142-fd6f-39db-a228-c70091551ca9",
                                                "text": "Il faut avoir soin de planter les dahlias cactus directement à demeure, à un endroit où ils peuvent être protégés contre la gelée, car ces plantes en pleine croissance ne supportent pas la transplantation. Si l’on dispose des plantes cultivées en pots, on pourra, en août-septembre, les déplanter dans un endroit que, plus tard, on pourra couvrir de vitrages, à moins que l’on ne dispose à cet effet de serre dont, pendant la belle saison, on enlève facilement les châssis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37b1914-3618-3493-ab36-d6972a25b4a3",
                                        "entry_id": "e82524c7-effe-35d3-9e69-7013344e488f",
                                        "glosses": [
                                            "Phénomène d’échauffement de la surface terrestre et de la basse atmosphère dû à l’absorption et à la réémission du rayonnement infrarouge par certains gaz atmosphériques (vapeur d’eau, dioxyde de carbone, méthane…)."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70e70c9b-58ed-47c6-8f95-26500d3706c0",
                                                "sense_id": "a37b1914-3618-3493-ab36-d6972a25b4a3",
                                                "text": "Vénus est aujourd'hui une fournaise inhabitable : l’effet de serre engendré par son atmosphère riche en gaz carbonique porte la température de sa surface à plus de 400 °C, et toute l’eau présente dans l’atmosphère équivaut à une couche de trois centimètres d’épaisseur seulement à la surface de la planète (sur Terre, la quantité d'eau des océans équivaut à une couche de trois kilomètres…)."
                                            },
                                            {
                                                "example_id": "5c0b2644-fa67-41f0-8880-b1eeee7497eb",
                                                "sense_id": "a37b1914-3618-3493-ab36-d6972a25b4a3",
                                                "text": "Sur Mars, le CO₂ constitue également plus de 90 % de l’atmosphère, mais celle-ci est extrêmement ténue, d’où un effet de serre très faible."
                                            },
                                            {
                                                "example_id": "99176654-d58a-4f0e-bb05-eb052b69d4ab",
                                                "sense_id": "a37b1914-3618-3493-ab36-d6972a25b4a3",
                                                "text": "L’effet de serre provoqué par les gaz atmosphériques, déjà mis en lumière par le physicien français Joseph Fourier en 1824, et dont Arrhenius avait estimé qu’il pouvait se renforcer avec le dioxyde de carbone (1896), commence à mobiliser la communauté des savants dans l’après-guerre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe922b1f-289b-41e7-9809-c0acc5e2d329",
                        "source_entry_id": "a1ff41b5-639e-310c-95ba-57fb767cfeaa",
                        "source_sense_id": "625f1e6b-a5bd-3f94-9ccf-dbbacf945f56",
                        "target_lang_word": "efecto invernadero",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "efecto invernadero",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "5506d987-cc1a-37b6-8ec2-c3a7a91f314d",
                                        "entry_id": "c65a079c-2df9-3f0a-a393-3ed357f450c3",
                                        "glosses": [
                                            "Fenómeno por el que determinados gases componentes de una atmósfera planetaria retienen parte de la energía que el suelo emite por haber sido calentado por la radiación solar. Afecta a todos los cuerpos planetarios dotados de atmósfera. De acuerdo con el actual consenso científico, el efecto invernadero se está viendo acentuado en la Tierra por la emisión de ciertos gases, como el dióxido de carbono y el metano, debida a la actividad económica humana. Este fenómeno evita que la energía recibida constantemente del Sol por la Tierra vuelva inmediatamente al espacio."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
