                        "source_sense_id": "34ec623f-c9f5-3581-814b-da2fd9cbb3f7",
                        "target_lang_word": "Delegierter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Delegierter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad62393f-b918-3719-a089-42ecacb58fa1",
                                        "entry_id": "1aa734dd-e72a-3c5f-b14b-6502fe2d300d",
                                        "glosses": [
                                            "gewählter oder persönlich von einer dazu befähigten Instanz beauftragter Akteur, dem die Aufgabe der konkreten Aktion per Einzelvollmacht zukommt"
