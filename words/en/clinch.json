                            },
                            {
                                "target_lang_word": "klemverbinding",
                                "target_lang_sense_clarification": "mechanisch verbindingsstuk"
                            },
                            {
                                "target_lang_word": "sluiting",
                                "target_lang_sense_clarification": "technisch vastmaakonderdeel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "943b6df4-f227-334b-81e7-14ccebd68eed",
                    "sense_definition": "The action of bending and hammering the end of a driven nail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter secured the joint with a quick <w>clinch</w> of the nail.",
                            "target_lang_translations": {
                                "nl": "De timmerman zette de verbinding vast met een snelle <w>omgeslagen spijkerpunt</w>."
