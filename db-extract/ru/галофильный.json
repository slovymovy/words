                    {
                        "translation_id": "ee3d958a-c8f7-4cfb-a6a7-63a474bbdead",
                        "source_entry_id": "d472a93c-48ad-34a7-8239-eb51abaa3a60",
                        "source_sense_id": "af2e03b2-3b96-32f9-9b74-44987a365976",
                        "target_lang_word": "halophil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halophil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77720a85-37c3-3cf8-8a9f-75e73c5175ce",
                                        "entry_id": "57ef8c70-f794-322f-9a43-80b8192c4325",
                                        "glosses": [
                                            "salzreiches Milieu benötigend oder bevorzugend"
                                        ],
                                        "tags": [
                                            "von Lebewesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b40eeeee-a169-409a-988a-8d36eca16027",
                                                "sense_id": "77720a85-37c3-3cf8-8a9f-75e73c5175ce",
                                                "text": "Einige marine Bakterien sind extrem halophil und zum Wachstum und Überleben auf einen hohen Gehalt an Kochsalz (NaCl) des Mediums angewiesen."
                                            },
                                            {
                                                "example_id": "f0b1a760-e113-4dae-9c90-5ab1ec9b5885",
                                                "sense_id": "77720a85-37c3-3cf8-8a9f-75e73c5175ce",
                                                "text": "Manche Pflanzen zeigen bei einer bestimmten Salzbelastung verstärktes Wachstum und eine erhöhte Primärproduktion; man kann sie als salzliebend (halophil) bezeichnen."
                                            },
                                            {
                                                "example_id": "abd0bcf9-c3a2-4b98-a996-f1bee99845e6",
                                                "sense_id": "77720a85-37c3-3cf8-8a9f-75e73c5175ce",
                                                "text": "Im engeren Sinne halophil sind allerdings nur einige Archaebakterien (Halobakterien, …), die obligatorisch an hohe Salzkonzentrationen in ihrem Medium gebunden sind."
                                            },
                                            {
                                                "example_id": "e18e6275-94d6-410c-9489-56e734ed77b9",
                                                "sense_id": "77720a85-37c3-3cf8-8a9f-75e73c5175ce",
                                                "text": "Viele pathogene Vibrionen sind halophil und treten in der Umwelt insbesondere in Brack- und Meerwasser auf."
                                            },
                                            {
                                                "example_id": "1dcf92b9-4d7a-44ca-8815-f9d3793b42cf",
                                                "sense_id": "77720a85-37c3-3cf8-8a9f-75e73c5175ce",
                                                "text": "Von den mikroskopischen Grünalgen können einige Süßwasserarten als halophil angesehen werden, z. B. scenedesmus quadricauda und pediastrum boryanum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
