                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ba3f43d-a731-4fb8-b4f6-29808db6e24f",
                                                "sense_id": "3ef8547a-6727-3206-b075-3c1ae7788934",
                                                "text": "Eine Satzreihe besteht aus der Koordination zweier gleichrangiger Teilsätze wie etwa: „Hans spielt und Inge lernt.“ In diesem Fall wird die Koordination durch die koordinierende Konjunktion „und“ ausgedrückt."
                                            }
