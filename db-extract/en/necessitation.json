                    {
                        "sense_id": "28615d50-83d1-38cc-905a-1475ab73a247",
                        "entry_id": "98b6a764-35e2-3a5f-a864-b1ae7ef4b71b",
                        "glosses": [
                            "Necessity, understood as a logical or other philosophical principle, or as a law or force of nature."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a04b8a29-60c3-4e09-8f2c-48dceab3e2a0",
                                "sense_id": "28615d50-83d1-38cc-905a-1475ab73a247",
                                "text": "Moral obligation is not necessitation. The moral law commands but does not coerce us."
                            },
                            {
                                "example_id": "51172009-ee0a-4fa3-9894-656f561e6fcd",
                                "sense_id": "28615d50-83d1-38cc-905a-1475ab73a247",
                                "text": "The voluntary actions of men are now seen to claim an equal freedom from the necessitation of natural causes."
                            },
                            {
                                "example_id": "c30adf88-c417-4285-8d46-fd4d07ad9952",
                                "sense_id": "28615d50-83d1-38cc-905a-1475ab73a247",
                                "text": "Determinism is an example: it alleges that all the seeming irregularities and spontaneities in the world are haunted by an omnipresent system of strict necessitation."
                            },
                            {
                                "example_id": "d2a82a4c-5d48-401a-a27e-30846b2f36ab",
                                "sense_id": "28615d50-83d1-38cc-905a-1475ab73a247",
                                "text": "In virtue of their contents, psychological states stand in logical relations like incompatibility, material implication, and conceptual necessitation."
                            }
                        ]
                    }
                ],
