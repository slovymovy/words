                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissenter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e3f4205-a718-3172-ae90-71ef6787147f",
                                        "entry_id": "717bd32b-0f0b-3777-bca3-f7ae825039ec",
                                        "glosses": [
                                            "Someone who dissents (disagrees), especially from an established church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de4987c6-4b1b-42dc-8497-6f67d421ce1b",
                                                "sense_id": "1e3f4205-a718-3172-ae90-71ef6787147f",
                                                "text": "As my study proceeded, I began to see that an investigation of organizational morality should also explore managerial dissenters, so-called whistleblowers, many of whom take stands against their organizations on grounds that they define as moral."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cb2aa15-45cf-4429-ae30-04d790ff1380",
                        "source_entry_id": "fc656d69-df04-3e12-b5c0-cc53777ecebb",
