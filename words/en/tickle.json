{
    "word_family": [
        "tickler",
        "ticklish",
        "tickly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78de0d29-1804-322f-87e2-66b4a02ebcb4",
                    "sense_definition": "To touch a person or animal lightly in a way that causes laughter or twitching.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children began to <w>tickle</w> each other until they were all laughing on the floor.",
                            "target_lang_translations": {
                                "ru": "Дети начали <w>щекотать</w> друг друга, пока все не повалились на пол от смеха."
                            }
                        },
                        {
                            "text": "If you <w>tickle</w> my feet, I will definitely jump and scream.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>пощекочешь</w> мне пятки, я точно подпрыгну и закричу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tickle my feet",
                        "tickle someone's tummy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикасаться к человеку или животному легкими движениями, вызывая смех или непроизвольное вздрагивание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щекотать",
                                "target_lang_sense_clarification": "вызывать смех прикосновением"
                            },
                            {
                                "target_lang_word": "пощекотать",
                                "target_lang_sense_clarification": "совершить действие в течение некоторого времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac240a6d-316b-3860-a1a3-59258522e019",
                    "sense_definition": "To have a physical sensation that feels like being touched lightly, often causing an itch.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My nose <w>tickles</w> because of the dust in this old room.",
                            "target_lang_translations": {
                                "ru": "У меня в носу <w>свербит</w> из-за пыли в этой старой комнате."
                            }
                        },
                        {
                            "text": "I think I am getting sick because my throat <w>tickles</w> whenever I swallow.",
                            "target_lang_translations": {
                                "ru": "Мне кажется, я заболеваю, потому что у меня <w>першит</w> в горле каждый раз, когда я глотаю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nose tickles",
                        "throat tickles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать физическое ощущение легкого прикосновения, часто вызывающее зуд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щекотать",
                                "target_lang_sense_clarification": "о физическом ощущении зуда"
                            },
                            {
                                "target_lang_word": "першить",
                                "target_lang_sense_clarification": "о горле"
                            },
                            {
                                "target_lang_word": "свербить",
                                "target_lang_sense_clarification": "в носу или коже"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80f1d0c1-1c29-3c80-870d-5dcb77c8f42c",
                    "sense_definition": "To please, amuse, or delight someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "amusement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian's jokes really <w>tickled</w> the audience during the late show.",
                            "target_lang_translations": {
                                "ru": "Шутки комика по-настоящему <w>позабавили</w> публику во время ночного шоу."
                            }
                        },
                        {
                            "text": "It <w>tickled</w> his fancy to see his old teacher at the grocery store.",
                            "target_lang_translations": {
                                "ru": "Ему <w>польстило</w> увидеть своего старого учителя в продуктовом магазине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tickle someone's fancy",
                        "tickled pink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Радовать, забавлять или доставлять удовольствие кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тешить",
                                "target_lang_sense_clarification": "самолюбие или воображение"
                            },
                            {
                                "target_lang_word": "льстить",
                                "target_lang_sense_clarification": "приятно возбуждать чувства"
                            },
                            {
                                "target_lang_word": "забавлять",
                                "target_lang_sense_clarification": "развлекать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "808de3bc-0fb5-3777-b8da-24122dad0798",
                    "sense_definition": "To appeal to someone's curiosity or specific tastes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "amusement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef tried to <w>tickle</w> the diners' palates with a unique blend of spices.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар пытался <w>пощекотать</w> вкусовые рецепторы посетителей уникальной смесью специй."
                            }
                        },
                        {
                            "text": "The mysterious headline was designed to <w>tickle</w> the curiosity of the readers.",
                            "target_lang_translations": {
                                "ru": "Загадочный заголовок был призван <w>разжечь</w> любопытство читателей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tickle the palate",
                        "tickle the curiosity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взывать к чьему-либо любопытству или специфическим вкусам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разжигать",
                                "target_lang_sense_clarification": "любопытство или аппетит"
                            },
                            {
                                "target_lang_word": "пощекотать",
                                "target_lang_sense_clarification": "нервы или вкусовые рецепторы"
                            },
                            {
                                "target_lang_word": "возбуждать",
                                "target_lang_sense_clarification": "интерес"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d7e9d9a-cfc2-39f5-8f8c-bcfa1e617b36",
                    "sense_definition": "To catch a fish by rubbing its belly with the hands until it can be grabbed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He learned how to <w>tickle</w> trout from his grandfather in the mountain streams.",
                            "target_lang_translations": {
                                "ru": "Он научился <w>ловить</w> форель <w>руками</w> у своего деда в горных ручьях."
                            }
                        },
                        {
                            "text": "It takes great patience and a very light touch to <w>tickle</w> a fish successfully.",
                            "target_lang_translations": {
                                "ru": "Требуется огромное терпение и очень легкое касание, чтобы успешно <w>поймать</w> рыбу таким способом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tickle trout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловить рыбу, поглаживая её по брюху руками, пока её не удастся схватить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловить руками",
                                "target_lang_sense_clarification": "способ рыбной ловли"
                            },
                            {
                                "target_lang_word": "щекотать",
                                "target_lang_sense_clarification": "о рыбе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "798fb4fe-ce39-36c5-b0e5-a86b014570ee",
                    "sense_definition": "To feel a sensation of titillation or internal excitement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a secret joy <w>tickle</w> within him as he watched his plan succeed.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, как тайная радость <w>щекочет</w> его изнутри, когда видел успех своего плана."
                            }
                        },
                        {
                            "text": "The anticipation of the journey began to <w>tickle</w> his nerves.",
                            "target_lang_translations": {
                                "ru": "Предвкушение путешествия начало <w>будоражить</w> его нервы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать ощущение легкого возбуждения или внутреннего трепета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щекотать",
                                "target_lang_sense_clarification": "о внутренних чувствах"
                            },
                            {
                                "target_lang_word": "будоражить",
                                "target_lang_sense_clarification": "нервы или чувства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2de4bf4-2554-38d3-85ea-9f06ccc00e49",
                    "sense_definition": "To be excited or heartened.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "amusement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young soldier's heart would <w>tickle</w> at the thought of returning home.",
                            "target_lang_translations": {
                                "ru": "Сердце молодого солдата <w>трепетало</w> при мысли о возвращении домой."
                            }
                        },
                        {
                            "text": "She felt her spirits <w>tickle</w> with hope after hearing the good news.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала, как её дух <w>воспрянул</w> от надежды после хороших новостей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть взволнованным или воодушевленным (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "от радости или надежды"
                            },
                            {
                                "target_lang_word": "радоваться",
                                "target_lang_sense_clarification": "испытывать подъем духа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0eda40c0-9de7-35bf-8913-f45d40409266",
                    "sense_definition": "An itchy or tingling sensation, especially in the throat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a persistent <w>tickle</w> in my throat that makes me want to cough.",
                            "target_lang_translations": {
                                "ru": "У меня постоянное <w>першение</w> в горле, из-за которого хочется кашлять."
                            }
                        },
                        {
                            "text": "A slight <w>tickle</w> on her arm made her think a bug was crawling there.",
                            "target_lang_translations": {
                                "ru": "Легкое <w>щекотание</w> на руке заставило её подумать, что там ползет жук."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tickle in my throat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зуд или покалывание, особенно в горле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "першение",
                                "target_lang_sense_clarification": "в горле"
                            },
                            {
                                "target_lang_word": "щекотание",
                                "target_lang_sense_clarification": "ощущение на коже"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b290153-1787-391a-a95d-01cc5fafba24",
                    "sense_definition": "The act of touching someone lightly to make them laugh.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Give the baby a little <w>tickle</w> on the tummy to see him smile.",
                            "target_lang_translations": {
                                "ru": "Немного <w>пощекочи</w> малыша за животик, чтобы он улыбнулся."
                            }
                        },
                        {
                            "text": "She gave him a playful <w>tickle</w> as she walked past his chair.",
                            "target_lang_translations": {
                                "ru": "Она игриво <w>щекотанула</w> его, проходя мимо стула."
                            }
                        }
                    ],
                    "common_phrases": [
                        "playful tickle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по значению глагола щекотать; легкое прикосновение для вызова смеха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щекотка",
                                "target_lang_sense_clarification": "процесс или действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b95bbac5-4e6d-39e5-9b8b-a789d6682390",
                    "sense_definition": "A very light touch or tap of a ball, often in sports like cricket.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batsman gave the ball a fine <w>tickle</w> down to the fine leg boundary.",
                            "target_lang_translations": {
                                "ru": "Бэтсмен сделал изящное легкое <w>касание</w> мяча в сторону границы поля."
                            }
                        },
                        {
                            "text": "The keeper thought he heard a <w>tickle</w> on the ball as it passed the bat.",
                            "target_lang_translations": {
                                "ru": "Киперу показалось, что он услышал легкий <w>чирк</w> по мячу, когда тот пролетал мимо биты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fine tickle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень легкое касание мяча, часто в спортивных играх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "касание",
                                "target_lang_sense_clarification": "легкое задевание мяча"
                            },
                            {
                                "target_lang_word": "чирк",
                                "target_lang_sense_clarification": "разговорное о легком ударе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c3a7564-e9ad-3cfd-a65d-9a0e7cec1fc7",
                    "sense_definition": "A narrow water passage or strait, particularly between an island and the mainland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat navigated through the narrow <w>tickle</w> to reach the hidden harbor.",
                            "target_lang_translations": {
                                "ru": "Лодка прошла через узкий <w>пролив</w>, чтобы добраться до скрытой гавани."
                            }
                        },
                        {
                            "text": "Local fishermen know every <w>tickle</w> along the rugged Newfoundland coast.",
                            "target_lang_translations": {
                                "ru": "Местные рыбаки знают каждую <w>протоку</w> вдоль изрезанного побережья Ньюфаундленда."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in Newfoundland and Labrador"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкий водный проход или пролив, особенно между островом и материком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролив",
                                "target_lang_sense_clarification": "узкий водный путь"
                            },
                            {
                                "target_lang_word": "протока",
                                "target_lang_sense_clarification": "узкий канал"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "341c361d-1022-3811-ad71-d8ac9dd378d1",
                    "sense_definition": "Unstable, insecure, or easily changed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political situation remained <w>tickle</w> and prone to sudden shifts in power.",
                            "target_lang_translations": {
                                "ru": "Политическая ситуация оставалась <w>шаткой</w> и склонной к внезапным сменам власти."
                            }
                        },
                        {
                            "text": "He found himself in a <w>tickle</w> position where any mistake could be fatal.",
                            "target_lang_translations": {
                                "ru": "Он оказался в <w>неустойчивом</w> положении, где любая ошибка могла стать роковой."
                            }
                        }
                    ],
                    "synonyms": [
                        "kittle"
                    ],
                    "antonyms": [
                        "stable",
                        "secure"
                    ],
                    "traits": [
