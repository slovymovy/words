                                    {
                                        "sense_id": "659d1b98-c9c3-3939-90ce-b4b6858d3998",
                                        "entry_id": "8721af78-b2f8-33db-8e57-c248d1b93263",
                                        "glosses": [
                                            "männliche Person, die einen Striptease macht"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6e11e34-70d3-4300-bf36-fc8f75444216",
                                                "sense_id": "659d1b98-c9c3-3939-90ce-b4b6858d3998",
                                                "text": "„Warum gilt ein arabischer Mann, der sich Stripperinnen ansieht, als normal, eine arabische Frau aber, die sich Stripper anschaut, als entartet?“"
                                            },
                                            {
                                                "example_id": "d3f93251-265e-4aa6-93e1-6c0ffa2ae81c",
                                                "sense_id": "659d1b98-c9c3-3939-90ce-b4b6858d3998",
                                                "text": "„Aber ich war in meiner Jugend nicht nur mit Mormonen befreundet, sondern auch mit Strippern und Spielern.“"
                                            },
                                            {
                                                "example_id": "3ab5d807-0f5b-42aa-a5e0-fec8e687beb8",
                                                "sense_id": "659d1b98-c9c3-3939-90ce-b4b6858d3998",
                                                "text": "„Die Story um sechs arbeitslose Männer, die sich des Geldes wegen als Stripper verdingen, stammt aus dem gleichnamigen britischen Film von 1997.“"
                                            },
                                            {
                                                "example_id": "523c4b5d-c445-45bf-a90a-91db00015573",
                                                "sense_id": "659d1b98-c9c3-3939-90ce-b4b6858d3998",
                                                "text": "„Die muskelbepackten Stripper aus Kalifornien, die im vergangenen Jahr durch die Lande tingelten, fanden ein begeistertes Publikum.“"
                                            },
                                            {
                                                "example_id": "3a02c740-e375-41a0-b135-8e6cd41142f2",
                                                "sense_id": "659d1b98-c9c3-3939-90ce-b4b6858d3998",
                                                "text": "„In seinem mehrstündigen Verhör verwandelte der ehemalige Drogendealer, Türsteher und Stripper den Gerichtssaal in seine ganz persönliche Showbühne.“"
                                            },
                                            {
                                                "example_id": "5b2b11c9-a1ed-4d0e-baf7-c47a75b1dcce",
                                                "sense_id": "659d1b98-c9c3-3939-90ce-b4b6858d3998",
                                                "text": "„Dessen Bierernst konkurriert mit der Müdigkeit, mit der Philosoph Carl Hegemann Hölderlin rezitiert oder mit der eines Strippers, der angewidert die Hosen rutschen lässt.“"
                                            },
                                            {
                                                "example_id": "c329773b-9491-471f-9bf8-75e80410ec89",
                                                "sense_id": "659d1b98-c9c3-3939-90ce-b4b6858d3998",
                                                "text": "„Ein schnurrbärtiger Stripper zuckt im Strobolicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "436604b9-731e-3ae6-a005-d2b2e89f0279",
                                        "entry_id": "8721af78-b2f8-33db-8e57-c248d1b93263",
                                        "glosses": [
                                            "Instrument, mit dem sich ein Blutpfropf oder eine krankhaft veränderte Vene entfernen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a24a038-a436-4804-8455-275173523353",
                                                "sense_id": "436604b9-731e-3ae6-a005-d2b2e89f0279",
                                                "text": "„Nachdem der Stripper eingeführt ist, wird die Crossektomiewunde vernäht.“"
