                    {
                        "sense_id": "5e49a66d-700c-3471-b53a-cce1d421069f",
                        "entry_id": "9f5163ba-d8d1-3ba6-b366-7c06fc13cede",
                        "glosses": [
                            "zum Verschließen eines Kochtopfes dienende Abdeckung"
