                    },
                    {
                        "translation_id": "272a2207-540c-4e09-b1c3-8c2843b4c55e",
                        "source_entry_id": "0012e285-9eb9-3936-848f-91f6503c413c",
                        "source_sense_id": "783c4a4e-18c7-3530-8a3e-c62ad5e018d3",
                        "target_lang_word": "Die Pollution",
