                    }
                ],
                "senses": [
                    {
                        "sense_id": "38d7b618-3d23-3217-9e93-2241350b1807",
                        "entry_id": "61f54ac5-d553-3f20-a301-54ad1b156328",
                        "glosses": [
                            "obojętne elektrycznie indywiduum chemiczne, złożone z więcej niż jednego atomu, które są ze sobą trwale połączone wiązaniami chemicznymi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f9babfb-eb36-43a9-9a4d-2bb99554ff57",
                                "sense_id": "38d7b618-3d23-3217-9e93-2241350b1807",
                                "text": "Molekuła wody zawiera trzy atomy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6d750e1-03ad-49c3-bf42-91f13341131e",
                        "source_entry_id": "61f54ac5-d553-3f20-a301-54ad1b156328",
                        "source_sense_id": "38d7b618-3d23-3217-9e93-2241350b1807",
                        "target_lang_word": "molecule",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "molecule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "784296f1-6aa2-3464-8788-0a5e27072f63",
                                        "entry_id": "ebf2eeb6-0aa6-3cdf-b9b6-300918b5ac4b",
                                        "glosses": [
                                            "The smallest particle of a specific element or compound that retains the chemical properties of that element or compound; two or more atoms held together by chemical bonds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88cb67b-da29-4f96-95a8-e626495bfcad",
                                                "sense_id": "784296f1-6aa2-3464-8788-0a5e27072f63",
                                                "text": "Hydrogen chloride is a diatomic molecule, consisting of a hydrogen atom and a chlorine atom."
                                            },
                                            {
                                                "example_id": "29122f07-1a92-49ea-a817-b9cd2e1ab114",
                                                "sense_id": "784296f1-6aa2-3464-8788-0a5e27072f63",
                                                "text": "The critical component of the photosynthetic system is the “water-oxidizing complex”, made up of manganese atoms and a calcium atom. This system splits water molecules and delivers some of their electrons to other molecules that help build up carbohydrates."
                                            },
                                            {
                                                "example_id": "60586b82-bab9-4872-9e98-b35674d63507",
                                                "sense_id": "784296f1-6aa2-3464-8788-0a5e27072f63",
                                                "text": "Clinical trials testing the molecule in humans have been underway for three years, Sinclair said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddadee8b-1964-34fb-bd81-9afee6cdcaf7",
                                        "entry_id": "ebf2eeb6-0aa6-3cdf-b9b6-300918b5ac4b",
                                        "glosses": [
                                            "A tiny amount."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdcc28ef-4aca-49c8-b3fd-490d2280b7e7",
                        "source_entry_id": "61f54ac5-d553-3f20-a301-54ad1b156328",
                        "source_sense_id": "38d7b618-3d23-3217-9e93-2241350b1807",
                        "target_lang_word": "molécule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "molécule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2315a36b-0642-3803-ab11-397836a63f18",
                                        "entry_id": "be35640e-7892-3fec-8865-823cf4cfa2ac",
                                        "glosses": [
                                            "Assemblage d’atomes électriquement neutre dont la composition est donnée par sa formule chimique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc1d2b6-5b08-44b5-95c2-878a29feb75d",
                                                "sense_id": "2315a36b-0642-3803-ab11-397836a63f18",
                                                "text": "Cette étape est plausible , car NO est une espèce à nombre impair d’électrons, et deux molécules peuvent former une liaison covalente quand elle se rencontrent. Le fait que le dimère N₂0₂ existe aussi dans le solide rend la suggestion plausible."
                                            },
                                            {
                                                "example_id": "a330b532-fc71-4d44-8bfe-53466142d330",
                                                "sense_id": "2315a36b-0642-3803-ab11-397836a63f18",
                                                "text": "C’est le cas par exemple de la réaction d’un diacide sur un dialcool qui donne naissance à un polyester et à de l’eau qui doit être éliminée si on souhaite que la réaction conduise effectivement à des grandes molécules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "473b0afc-8dc7-37b8-ac90-c94af9c634e3",
                                        "entry_id": "be35640e-7892-3fec-8865-823cf4cfa2ac",
                                        "glosses": [
                                            "Matière active."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07b8b993-4746-4e8c-ba25-f55d6c7f6a55",
                                                "sense_id": "473b0afc-8dc7-37b8-ac90-c94af9c634e3",
                                                "text": "Plus spécifiquement pour le secteur des grandes cultures, en Bourgogne, les données du recensement agricole se sont intéressées aux molécules effectivement utilisées en fonction des cultures traitées ([…]). Pour le blé tendre par exemple, ce sont l’époxiconazole et le boscalid, deux fongicides qui apparaissent comme les matières actives les plus utilisées (Agreste Bourgogne, 2013)."
                                            },
                                            {
                                                "example_id": "4b9ae6e6-a794-4cf8-ae1b-1c3055e183bb",
                                                "sense_id": "473b0afc-8dc7-37b8-ac90-c94af9c634e3",
                                                "text": "Il est classique de diviser les molécules limitant l’œdème en deux familles, les imperméants et les colloïdes."
                                            },
                                            {
                                                "example_id": "76249bb0-0aaf-4796-8923-1c091fa2d8e2",
                                                "sense_id": "473b0afc-8dc7-37b8-ac90-c94af9c634e3",
                                                "text": "Parmi les nombreux composés retrouvés dans le cannabis, deux molécules retiennent l’attention pour leurs propriétés relaxantes et antalgiques : le cannabidiol (CBD) et le tétrahydrocannabinol (THC)."
                                            },
                                            {
                                                "example_id": "b8a57cb5-93c2-4928-b3ea-35e209c7e5cc",
                                                "sense_id": "473b0afc-8dc7-37b8-ac90-c94af9c634e3",
                                                "text": "En mars 2023, Atlantic’eau, le syndicat départemental d’alimentation en eau potable qui gère la nappe, a révélé avoir découvert la présence de 33 molécules résistant au traitement de l’usine de potabilisation. Toutes ces molécules n’ont pu être identifiées, mais sept sont des pesticides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3773c51-f319-3044-8f3c-df60326f038e",
                                        "entry_id": "be35640e-7892-3fec-8865-823cf4cfa2ac",
                                        "glosses": [
                                            "Fraction la plus infime d’un corps."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "181a7e8f-2de0-4177-80a6-4ca9dffea4b1",
                                                "sense_id": "d3773c51-f319-3044-8f3c-df60326f038e",
                                                "text": "Ces molécules blanchâtres , confondues avec les parties butyreuses, jaunies par la bile qui domine alors sur la matière, composent ensemble la masse des excremens qui ressemble beaucoup à des œufs brouillés."
                                            },
                                            {
                                                "example_id": "b61491e2-0e7c-45a3-a7dc-8ad38ede3052",
                                                "sense_id": "d3773c51-f319-3044-8f3c-df60326f038e",
                                                "text": "Lorsque les surfaces frottantes sont appliquées l’une contre l’autre par une pression trop considérable, les enduits prennent une liquidité qui a fait supposer que leurs molécules s’écrasaient."
                                            },
                                            {
                                                "example_id": "c3c74982-080e-481f-b7e3-37eb29ac68a7",
                                                "sense_id": "d3773c51-f319-3044-8f3c-df60326f038e",
                                                "text": "Rencontrant ma fiancée dans une avenue où se pressait l’élite de la cité, je me hâtais pour la saluer d’un de mes saluts les plus respectueux, quand une molécule de je ne sais quelle matière étrangère, se logeant dans le coin de mon œil, me rendit, pour le moment, complétement aveugle."
                                            },
                                            {
                                                "example_id": "5e4f8207-8913-4d89-a4c6-7cf58b0b59fd",
                                                "sense_id": "d3773c51-f319-3044-8f3c-df60326f038e",
                                                "text": "Le vent soufflait du sud-ouest, tout chargé des chaudes molécules du continent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ef31220-c347-34e0-9990-2e4feee6e56a",
                                        "entry_id": "be35640e-7892-3fec-8865-823cf4cfa2ac",
                                        "glosses": [
                                            "Plus petite partie d’un corps qui garde les propriétés de ce corps."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d4a95cd-c4f6-4b06-824a-07a1baff265a",
                                                "sense_id": "5ef31220-c347-34e0-9990-2e4feee6e56a",
                                                "text": "Les molécules de l’air, du sang."
                                            },
                                            {
                                                "example_id": "b912e67f-4bc9-4831-82c2-a7c3c4f0029d",
                                                "sense_id": "5ef31220-c347-34e0-9990-2e4feee6e56a",
                                                "text": "[…] quand on vient de défourailler, il subsiste des molécules de poudre sur les doigts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59ffb856-07a6-464b-8970-d4a695cac6b4",
                        "source_entry_id": "61f54ac5-d553-3f20-a301-54ad1b156328",
                        "source_sense_id": "38d7b618-3d23-3217-9e93-2241350b1807",
                        "target_lang_word": "molécula",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "molécula",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2a83e705-265f-3b72-b6c0-792553a2cddb",
                                        "entry_id": "796e6664-8ece-39ae-b857-53e0e0dfc17c",
                                        "glosses": [
                                            "Unión de varios átomos que componen la menor cantidad de una sustancia que conserva todas sus propiedades químicas distintivas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e085e8e-69d4-44f7-8a7c-c3be2f8f867d",
                                                "sense_id": "2a83e705-265f-3b72-b6c0-792553a2cddb",
                                                "text": "La molécula de agua se compone de hidrógeno y oxígeno."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
