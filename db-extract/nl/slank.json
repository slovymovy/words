                    {
                        "sense_id": "fcdb4bd4-0ac8-3d38-9ebd-a1162ae892fa",
                        "entry_id": "488efe31-8147-37fe-b893-ea38ac79e3c6",
                        "glosses": [
                            "vrij van overtollig vet en enigszins smal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e7b261-6b85-4b02-bc95-b822dc117e79",
                                "sense_id": "fcdb4bd4-0ac8-3d38-9ebd-a1162ae892fa",
                                "text": "Albert Maillard. Hij was een slanke jongen met een enigszins traag, bescheiden karakter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f799a8d-b6ec-4846-996b-163e8b9ffd15",
                        "source_entry_id": "488efe31-8147-37fe-b893-ea38ac79e3c6",
                        "source_sense_id": "fcdb4bd4-0ac8-3d38-9ebd-a1162ae892fa",
                        "target_lang_word": "schlank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0e37e28-aa8a-3026-858c-91a2b0ce3d6e",
                                        "entry_id": "a3e4097e-11f4-36c7-8f3b-9c32307c7079",
                                        "glosses": [
                                            "in der Form schmal, nicht breit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed927053-e3d5-453f-b521-1d2658634a28",
                                                "sense_id": "a0e37e28-aa8a-3026-858c-91a2b0ce3d6e",
                                                "text": "Seit meiner Diät bin ich wieder so schlank wie früher."
                                            },
                                            {
                                                "example_id": "5c630fee-9936-4b8f-a6bc-003e7fe5c8db",
                                                "sense_id": "a0e37e28-aa8a-3026-858c-91a2b0ce3d6e",
                                                "text": "Die Firma braucht eine schlankere Verwaltung."
                                            },
                                            {
                                                "example_id": "d955d83c-330c-480d-be08-da1e8f2c0c89",
                                                "sense_id": "a0e37e28-aa8a-3026-858c-91a2b0ce3d6e",
                                                "text": "„Konzernchef Joe Kaeser will Siemens schlanker und effizienter machen – auf Kosten Tausender Arbeitnehmer.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6aa8faf0-600c-49f1-a923-85e04560e7f3",
                        "source_entry_id": "488efe31-8147-37fe-b893-ea38ac79e3c6",
                        "source_sense_id": "fcdb4bd4-0ac8-3d38-9ebd-a1162ae892fa",
