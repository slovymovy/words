                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7b6c6e07-0211-3afd-9b3d-35f4d4931745",
                        "entry_id": "9f336ef9-1116-3aad-a2d7-345db88147cc",
                        "glosses": [
                            "Used by multiple entities or for multiple purposes or in multiple ways."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "19465204-6447-4b8d-a343-33bc929d3065",
                                "sense_id": "7b6c6e07-0211-3afd-9b3d-35f4d4931745",
                                "text": "\"We are myth-killers, you and I, Moneo. That's the dream we share. I assure you from a God's Olympian perch that government is a shared myth. When the myth dies, the government dies.\""
                            },
                            {
                                "example_id": "316e746a-baa0-4c25-ba0b-66e6e51ba290",
                                "sense_id": "7b6c6e07-0211-3afd-9b3d-35f4d4931745",
                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: […]; […]; or perhaps to muse on the irrelevance of the borders that separate nation states and keep people from understanding their shared environment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42aa8461-729a-475c-b080-75d3dcca0bbc",
