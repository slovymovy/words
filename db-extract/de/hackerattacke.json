                "senses": [
                    {
                        "sense_id": "df4eb6ce-cc6a-389e-aabc-b6a9e0d93c24",
                        "entry_id": "93ff3d02-9511-3fc0-9836-44dff9df3361",
                        "glosses": [
                            "gezielter, illegaler Angriff auf Computersysteme durch Hacker"
