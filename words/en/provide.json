{
    "word_family": [
        "provision",
        "provider",
        "provisional",
        "provident",
        "providence"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7faf6e57-07e3-3832-bb1f-e028df00f782",
                    "sense_definition": "To give what is needed or desired, especially basic needs or services",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel will <w>provide</w> clean towels and soap for all guests.",
                            "target_lang_translations": {
                                "ru": "Отель <w>предоставит</w> чистые полотенца и мыло всем гостям."
                            }
                        },
                        {
                            "text": "Our goal is to <w>provide</w> support to families in need during the winter.",
                            "target_lang_translations": {
                                "ru": "Наша цель — <w>оказывать</w> поддержку нуждающимся семьям в зимний период."
                            }
                        }
                    ],
                    "synonyms": [
                        "afford"
                    ],
                    "antonyms": [
                        "withhold",
                        "take"
                    ],
                    "common_phrases": [
                        "provide support",
                        "provide information",
                        "provide services"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять то, что необходимо или желательно, особенно базовые потребности или услуги"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "давать доступ к услугам или вещам"
                            },
                            {
                                "target_lang_word": "обеспечивать",
                                "target_lang_sense_clarification": "снабжать всем необходимым"
                            },
                            {
                                "target_lang_word": "снабжать",
                                "target_lang_sense_clarification": "давать запасы или материалы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "104e152d-a462-348c-bf6f-6d32d3e53b99",
                    "sense_definition": "To earn enough money to pay for the necessities of life for oneself or others",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He works two jobs to <w>provide</w> for his three children.",
                            "target_lang_translations": {
                                "ru": "Он работает на двух работах, чтобы <w>содержать</w> своих троих детей."
                            }
                        },
                        {
                            "text": "It is difficult to <w>provide</w> for a family on such a low salary.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>обеспечивать</w> семью на такую низкую зарплату."
                            }
                        }
                    ],
                    "common_phrases": [
                        "provide for family",
                        "provide for oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зарабатывать достаточно денег, чтобы оплачивать жизненно необходимые нужды для себя или других"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "финансово обеспечивать семью"
                            },
                            {
                                "target_lang_word": "обеспечивать",
                                "target_lang_sense_clarification": "давать средства к существованию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da8752d8-72cc-3356-a284-737c1a47df66",
                    "sense_definition": "To make something possible or available",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new highway will <w>provide</w> an alternative route to the city center.",
                            "target_lang_translations": {
                                "ru": "Новое шоссе <w>предоставит</w> альтернативный маршрут до центра города."
                            }
                        },
                        {
                            "text": "This internship will <w>provide</w> an opportunity to learn about marketing.",
                            "target_lang_translations": {
                                "ru": "Эта стажировка <w>даст</w> возможность узнать больше о маркетинге."
                            }
                        }
                    ],
                    "synonyms": [
                        "afford"
                    ],
                    "common_phrases": [
                        "provide an opportunity",
                        "provide an alternative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо возможным или доступным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "создавать возможность"
                            },
                            {
                                "target_lang_word": "давать",
                                "target_lang_sense_clarification": "открывать доступ к шансу или пути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbe9b739-f525-3ece-b496-d4a17b479cb1",
                    "sense_definition": "To state as a condition or requirement in a legal document or agreement",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stipulate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract <w>provides</w> that the work must be completed by June.",
                            "target_lang_translations": {
                                "ru": "Контракт <w>предусматривает</w>, что работа должна быть завершена к июню."
                            }
                        },
                        {
                            "text": "The law <w>provides</w> for the protection of private data.",
                            "target_lang_translations": {
                                "ru": "Закон <w>устанавливает</w> защиту личных данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "contract provides that",
                        "law provides for"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in legal or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывать в качестве условия или требования в юридическом документе или соглашении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предусматривать",
                                "target_lang_sense_clarification": "в законе или договоре"
                            },
                            {
                                "target_lang_word": "устанавливать",
                                "target_lang_sense_clarification": "определять правила"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18ffd683-082a-3c45-b3a0-a7b9cc3fd9e9",
                    "sense_definition": "To take measures to prepare for a future event, especially a negative one",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prepare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must <w>provide</w> against the possibility of a sudden market crash.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>принять меры</w> на случай возможного внезапного краха рынка."
                            }
                        },
                        {
                            "text": "The city failed to <w>provide</w> against the flooding that occurred last year.",
                            "target_lang_translations": {
                                "ru": "Город не смог <w>подготовиться</w> к наводнению, которое произошло в прошлом году."
                            }
                        }
                    ],
                    "common_phrases": [
                        "provide against disaster",
                        "provide against risk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать меры для подготовки к будущему событию, особенно негативному"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать меры",
                                "target_lang_sense_clarification": "готовиться против рисков"
                            },
                            {
                                "target_lang_word": "предусматривать меры",
                                "target_lang_sense_clarification": "защищаться от опасностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3938f30-652f-3024-a4fa-eaeba07ebb32",
                    "sense_definition": "To foresee or consider something in advance",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "foresee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A wise leader must <w>provide</w> the potential dangers of such a policy.",
                            "target_lang_translations": {
                                "ru": "Мудрый лидер должен <w>предвидеть</w> потенциальные опасности такой политики."
                            }
                        },
                        {
                            "text": "They did not <w>provide</w> the consequences of their actions until it was too late.",
                            "target_lang_translations": {
                                "ru": "Они не <w>предусмотрели</w> последствия своих действий, пока не стало слишком поздно."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this sense is rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предвидеть или рассматривать что-либо заранее"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвидеть",
                                "target_lang_sense_clarification": "учитывать заранее"
                            },
                            {
                                "target_lang_word": "провидеть",
                                "target_lang_sense_clarification": "архаичное значение предсказания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}