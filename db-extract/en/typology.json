                    {
                        "translation_id": "7cc799a6-ec8e-4012-a02f-1dd73b02a6f6",
                        "source_entry_id": "4c96486a-2265-3123-b1f4-b10c0047a358",
                        "source_sense_description": "systematic classification of the types of something according to their common characteristics",
                        "target_lang_word": "типоло́гия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "типоло́гия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "384d9df8-8c09-348b-a423-75fd553f9ad0",
                                        "entry_id": "8755cfb2-80bb-3f70-8f81-3ca7d9725cd4",
                                        "glosses": [
                                            "научная классификация, научный метод анализа предметов или явлений по общности каких-либо признаков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bae07f9-d058-4d65-89a6-67a0493a39c2",
                                                "sense_id": "384d9df8-8c09-348b-a423-75fd553f9ad0",
                                                "text": "В основе техники проведения анкетирования лежала качественная и количественная классификация объектов изучения, т.е. типология объекта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22a7cf2f-00ac-344b-9a6c-8f2ef2269733",
                                        "entry_id": "8755cfb2-80bb-3f70-8f81-3ca7d9725cd4",
                                        "glosses": [
                                            "разделение чего-либо по группам, разновидностям, формам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a450525d-68c7-4b2d-9ebd-301fd52fc7d2",
                                                "sense_id": "22a7cf2f-00ac-344b-9a6c-8f2ef2269733",
                                                "text": "В прежней жизни у папиросы была своя типология. Была папироса перед сном, и папироса утренняя, и ленивая послеобеденная папироса, папироса делового разговора и дружеской болтовни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14ba8044-f4b9-3839-a3c5-a45e5d4eacb2",
                                        "entry_id": "8755cfb2-80bb-3f70-8f81-3ca7d9725cd4",
                                        "glosses": [
                                            "лингв. раздел лингвистики, занимающийся выяснением наиболее общих закономерностей различных языков, не связанных между собой общим происхождением или взаимным влиянием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e67a748c-6912-4be6-914a-eec75b397af1",
                                                "sense_id": "14ba8044-f4b9-3839-a3c5-a45e5d4eacb2",
                                                "text": "Насущная задача грамматической типологии ― отделить описание элементарных универсальных функций («типология категорий») от описания их выражения в конкретных языках («типология систем»)〈…〉"
                                            },
                                            {
                                                "example_id": "45df6e9f-d7e3-4ee2-b0f9-b6a6e0b0e9f2",
                                                "sense_id": "14ba8044-f4b9-3839-a3c5-a45e5d4eacb2",
                                                "text": "Сравнение исторических изменений, эволюции грамматики и звучания десятков родственных языков положило начало современной лингвистике и сравнительному языкознанию. Фридрих фон Шлегель, один из первых исследователей индоевропейских языков в начале XIX в., ввёл термин «сравнительная грамматика» и установил типологию языков, отличив флексивные, агглютинативные и изолирующие языки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
