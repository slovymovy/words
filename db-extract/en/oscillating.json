                "senses": [
                    {
                        "sense_id": "72512900-8f37-311b-b777-1a6bfb919816",
                        "entry_id": "8ab5667d-fb63-38d8-bf23-3c58d344efde",
                        "glosses": [
                            "Moving in a repeated back-and-forth motion; coming and going."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f04945-a126-4afa-9502-8adb43b6ce62",
                                "sense_id": "72512900-8f37-311b-b777-1a6bfb919816",
                                "text": "But if he be admitted to have been fixed, as he declares, it admits of proof that he has a species of fixedness belonging to him of a very oscillating kind; which may be best illustrated by that of a ship riding off at sea by a single anchor, which at every turn of the tide swings about, and brings her head round to a point of the compass diametrically opposite to that it stood toward before."
                            },
                            {
                                "example_id": "d3edd85d-0d61-478b-8606-9481afdfe3f3",
                                "sense_id": "72512900-8f37-311b-b777-1a6bfb919816",
                                "text": "In general the experiments proved that in nephritis the secretion of the gastric mucosa is vitiated. This vitiation is exceedingly oscillating."
                            },
                            {
                                "example_id": "044d7b06-0af4-483a-90a1-c12af2df1306",
                                "sense_id": "72512900-8f37-311b-b777-1a6bfb919816",
                                "text": "When examining work on the history of sociology, however, one finds a more oscillating pattern: disciplinary marginality, followed by greater centrality, followed by a return to the margins."
                            }
                        ]
                    },
                    {
                        "sense_id": "cde6ef20-4889-3462-891b-cc3388cfe800",
                        "entry_id": "8ab5667d-fb63-38d8-bf23-3c58d344efde",
                        "glosses": [
                            "Describing a function or divergent series that moves between multiple values."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8481dec6-5c02-44ac-b218-5c068aedc334",
                                "sense_id": "cde6ef20-4889-3462-891b-cc3388cfe800",
                                "text": "Highly oscillating sequences converge in the weak topology, i.e., the topology of convergence of integral means."
                            }
                        ]
                    }
