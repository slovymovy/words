                "senses": [
                    {
                        "sense_id": "ea360ece-21b4-38c1-9bd0-db8f680a7329",
                        "entry_id": "cfdbba87-a2b9-35e2-8996-2080cad07c8f",
                        "glosses": [
                            "Fleuve prenant sa source en France Alpes-Maritimes (France) et se jetant dans la Méditerranée près de Vintimille, en Italie."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "721d4561-f512-4632-9101-5e1791e7575a",
                                "sense_id": "ea360ece-21b4-38c1-9bd0-db8f680a7329",
                                "text": "Et quel contraste, ô nature ! entre la paix, le silence qui règnent aux fraîches vallées de la Roya et de la Vésubie, sur les coteaux embaumés d’Ezza, aux sommets des blanches solitudes des Alpes, et la cohue bête, haletante, qui évolue, comme dans un cercle dantesque, autour des tapis verts de Monte-Carlo !"
                            },
                            {
                                "example_id": "bdfec44f-dcaf-4c83-b3d0-fd3d671c2fe4",
                                "sense_id": "ea360ece-21b4-38c1-9bd0-db8f680a7329",
                                "text": "Selon la députée (RN) des Alpes-Maritimes Alexandra Masson, « une grosse déportation des arrivées » se ferait actuellement « sur le haut de la vallée de la Roya »."
                            }
                        ]
                    },
