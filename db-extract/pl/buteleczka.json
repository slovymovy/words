                "translations": [
                    {
                        "translation_id": "e6e06ae4-702c-48a1-9d12-6d73e635e625",
                        "source_entry_id": "9cfe336e-efef-36ef-b1aa-73eb26ff29aa",
                        "source_sense_id": "694980ad-de29-3efb-b49a-004bc49c78e1",
                        "target_lang_word": "Fläschchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fläschchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78edc6e0-aee6-3a6a-a376-d21fc08854e1",
                                        "entry_id": "d83a8a9f-a818-3760-81a1-62578ed8d602",
                                        "glosses": [
                                            "(kleine) Flasche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f1b1113-5ed9-4e7c-a813-a33d8251ca62",
                                                "sense_id": "78edc6e0-aee6-3a6a-a376-d21fc08854e1",
                                                "text": "„Hätten Kempowski und ich über unsere vom Wagen der Stubenmädchen gemopsten kleinen Tuben und Fläschchen Buch geführt, so hätten wir damit auch den Wechsel der Gerüche und Moden festgehalten.“"
                                            },
                                            {
                                                "example_id": "bfd371d6-33a5-48c7-84e7-37f04a2ffc81",
                                                "sense_id": "78edc6e0-aee6-3a6a-a376-d21fc08854e1",
                                                "text": "„Der Fetischeur nickte zufrieden, zog ein braunes Fläschchen aus der Tasche und rollte es zwischen seinen Handflächen.“"
                                            },
                                            {
                                                "example_id": "05a5d6dd-d4d5-4471-a97c-0bf0eb38a945",
                                                "sense_id": "78edc6e0-aee6-3a6a-a376-d21fc08854e1",
                                                "text": "„Die Schwester kam und hängte ein kleines Fläschchen vom Tropf ab und ein neues hinzu.“"
                                            },
                                            {
                                                "example_id": "791347aa-2a59-4253-a8a7-370cb8934939",
                                                "sense_id": "78edc6e0-aee6-3a6a-a376-d21fc08854e1",
                                                "text": "„Ich blickte auf das Fläschchen, aus dem er der Contessa zwei Pillen überreicht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
