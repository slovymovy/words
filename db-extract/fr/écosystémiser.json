                "senses": [
                    {
                        "sense_id": "3e1536b2-6f33-3fbf-9ed4-a5709b6730fa",
                        "entry_id": "6c31a2d4-1ea1-3074-abd2-4529c733ace7",
                        "glosses": [
                            "Donner un caractère d’écosystème à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb7f0160-bd37-4755-b02c-fe41c96ff5c0",
                                "sense_id": "3e1536b2-6f33-3fbf-9ed4-a5709b6730fa",
                                "text": "Nature en ville et fonctionnalité : verdir ou « écosystémiser » ?"
                            },
                            {
                                "example_id": "fbecdf00-9ef6-41d7-87db-e46ee2fa9691",
                                "sense_id": "3e1536b2-6f33-3fbf-9ed4-a5709b6730fa",
                                "text": "Ça germe, ça fleurit, ça se mélange et ça s'hybride, ça se réseaute, se rhizome, s'écosystémise, se glisse un peu partout."
                            },
                            {
                                "example_id": "213daf85-c130-490a-a2d0-c1059477f89a",
                                "sense_id": "3e1536b2-6f33-3fbf-9ed4-a5709b6730fa",
                                "text": "Dispositif expérimental pour la création d'un couvert « écosystémisé » sur le toit du département Génie Biologique de l'IUT d'Avignon."
                            }
                        ]
                    }
