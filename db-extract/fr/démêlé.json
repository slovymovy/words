        "fr-extract.jsonl": [
            {
                "entry_id": "b98deadb-2b24-3a5b-8ac1-64b9e9280ebd",
                "word": "démêlé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ccebb57-9871-49c9-9192-ac5c71aec73e",
                        "entry_id": "b98deadb-2b24-3a5b-8ac1-64b9e9280ebd",
                        "tags": [
                            "plural"
                        ],
                        "form": "démêlés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b480fa6b-57ea-37e2-9b5a-c137da0c21a7",
                        "entry_id": "b98deadb-2b24-3a5b-8ac1-64b9e9280ebd",
                        "glosses": [
                            "Discussion et débat entre deux ou plusieurs personnes, particulièrement sur des questions d’honneur ou d’intérêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4744175e-65fb-4b7b-aeea-1aa2818ceadf",
                                "sense_id": "b480fa6b-57ea-37e2-9b5a-c137da0c21a7",
                                "text": "Nous n’en finirions pas si nous voulions citer tous les démêlés des habitants d’Épinal avec les prélats de Metz."
                            },
                            {
                                "example_id": "495ae67a-a8d5-4538-9db5-b5db84305fa4",
                                "sense_id": "b480fa6b-57ea-37e2-9b5a-c137da0c21a7",
                                "text": "Parfois la liquidation des comptes frisait les moyens violents. C’était toujours un démêlé fort prolixe et souvent pénible, mais à notre époque de progrès on ne gagne pas sa vie sans batailler."
                            },
                            {
                                "example_id": "10d24669-012e-4dca-ba24-fef1b572548e",
                                "sense_id": "b480fa6b-57ea-37e2-9b5a-c137da0c21a7",
                                "text": "Mais cette effervescence sociale n’est pas du goût des autorités de l’Empire. L’activisme de Camélinat lui vaut quelques démêlés avec la justice."
                            },
                            {
                                "example_id": "234f5ce3-cdb3-4b2c-a22d-8f9f2f64f9e7",
                                "sense_id": "b480fa6b-57ea-37e2-9b5a-c137da0c21a7",
                                "text": "Depuis, Patrick Casati avait eu des démêlés."
                            }
                        ]
                    }
                ],
