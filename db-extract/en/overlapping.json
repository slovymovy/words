                    }
                ],
                "senses": [
                    {
                        "sense_id": "35c5f070-01ee-3dde-af4f-53bb1a41cdb6",
                        "entry_id": "e406c56a-c79c-38d1-906a-4e6f091177ff",
                        "glosses": [
                            "The situation in which things overlap."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f80ab2ed-ac44-4e7c-8b5c-3bfbb0fc9b18",
                                "sense_id": "35c5f070-01ee-3dde-af4f-53bb1a41cdb6",
                                "text": "This overlapping is reflective of hybrid languages, where certain features (phonetic, orthographic, semantic, syntactic) are also difficult to disentangle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fafeabc8-46a3-40d1-9feb-f55fba5d4e9d",
                        "source_entry_id": "e406c56a-c79c-38d1-906a-4e6f091177ff",
                        "source_sense_id": "35c5f070-01ee-3dde-af4f-53bb1a41cdb6",
                        "source_sense_description": "the situation in which things overlap",
                        "target_lang_word": "chevauchement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevauchement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30280321-b743-3e04-a6e9-1dd90402a5c9",
                                        "entry_id": "74f67a2a-257a-3eb1-9b08-3284d14c21a4",
                                        "glosses": [
                                            "Action de chevaucher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acdaa7dc-1d87-495e-9c23-af5ea5af4ed4",
                                                "sense_id": "30280321-b743-3e04-a6e9-1dd90402a5c9",
                                                "text": "Sous l’influence des courants, des vents, et des variations de température, de formidables pressions se produisent ; le soulèvement et le chevauchement de la glace donnent naissance à des monticules ou « hummocks » qui se présentent en lignes perpendiculaires au sens de pression."
                                            },
                                            {
                                                "example_id": "8ff09a10-20b8-4451-9922-ba4e890e3a91",
                                                "sense_id": "30280321-b743-3e04-a6e9-1dd90402a5c9",
                                                "text": "La condition inhumaine qui est la nôtre aujourd’hui est celle de l’homme, de la femme, de l’enfant qui doivent se redéfinir, accepter que leur état, leur être, leur essence ne sont possibles que par le chevauchement entre le mammifère bipède qu’ils sont et les outils, machines et technologies qui les entourent […]"
                                            },
                                            {
                                                "example_id": "1ecdd7b8-22bd-4e8e-923a-829e25b8f4cb",
                                                "sense_id": "30280321-b743-3e04-a6e9-1dd90402a5c9",
                                                "text": "Les États membres doivent se coordonner pour que les dépistages portant sur la santé soient réalisés d’un seul côté de la frontière afin d’éviter les chevauchements et les délais d’attente."
                                            },
                                            {
                                                "example_id": "e85fb7c9-ac9c-40fe-82c4-7b683ada9631",
                                                "sense_id": "30280321-b743-3e04-a6e9-1dd90402a5c9",
                                                "text": "À cet égard, les auteurs appellent à une coopération plus étroite entre l’ECDC, l’EMA et l’HERA afin d’éviter les chevauchements et de mieux coordonner la réponse de l’UE."
                                            },
                                            {
                                                "example_id": "0fd6015f-4309-4d95-9dcb-4fde658e1c04",
                                                "sense_id": "30280321-b743-3e04-a6e9-1dd90402a5c9",
                                                "text": "Chevauchement d’une ligne continue, d’une ligne jaune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b491df7-9c4b-314e-a64c-ef5e1bdb9184",
                                        "entry_id": "74f67a2a-257a-3eb1-9b08-3284d14c21a4",
                                        "glosses": [
                                            "Déplacement des fragments d’un os fracturé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
