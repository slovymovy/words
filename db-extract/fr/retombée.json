                                        "entry_id": "e55f9b0a-3368-318a-b33d-abc050023323",
                                        "glosses": [
                                            "Person, die mit etwas erst kürzlich begonnen hat und dadurch wenig Sachkenntnisse besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "684ccc62-cbe2-4f8a-b304-7da8e15b0d55",
                                                "sense_id": "e34f9c8e-6be7-37f4-a877-41a516ec06c0",
                                                "text": "Der neue Mitschüler ist ein Anfänger auf dem Gebiet des Musizierens."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b4923a36-e2a7-3c67-a6e2-d8e67e97549f",
                                        "entry_id": "e55f9b0a-3368-318a-b33d-abc050023323",
                                        "glosses": [
                                            "steinernes Widerlager eines Bogens oder Gewölbes auf einem tragenden Gesims, einem Pfeiler oder dem Kapitell einer Säule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d0357f-6dcd-43be-bbc4-c8cb3540fbda",
                                                "sense_id": "b4923a36-e2a7-3c67-a6e2-d8e67e97549f",
                                                "text": "Auf dem Kapitell sitzt der Anfänger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a72b0c13-c4a6-456e-8537-4edbe2d3fd63",
                        "source_entry_id": "b08d24ec-1f4a-3c57-bed8-567776cef4cf",
                        "source_sense_id": "ad866cf4-126f-3ce5-9261-eaa49584546e",
                        "target_lang_word": "Nebenprodukt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebenprodukt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d765b0c6-2863-3346-ac16-299f0f5ba61f",
                                        "entry_id": "dc5cee96-cec3-323e-8673-cbb827d2ecd7",
                                        "glosses": [
                                            "etwas, das bei einem Herstellungs- oder Entwicklungsprozess nebenbei, zusätzlich entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daa27cc0-6e14-4afa-8a68-cc2189daf2ac",
                                                "sense_id": "d765b0c6-2863-3346-ac16-299f0f5ba61f",
                                                "text": "„Von den 210 bekannten Dioxin-Verbindungen, die als Nebenprodukte chemischer Prozesse entstehen, sind 17 dafür bekannt, dass sie sich im Fettgewebe von Mensch und Tier anreichern […] und so Gesundheitsschäden hervorrufen können.“"
                                            },
                                            {
                                                "example_id": "77a24e7b-ba7d-4fec-a990-1353d58ecc32",
                                                "sense_id": "d765b0c6-2863-3346-ac16-299f0f5ba61f",
                                                "text": "„Wissenschaftler bezweifeln, dass Religion das Gerüst für die Moral bildet. Einige halten den Glauben eher für ein schädliches Nebenprodukt der Evolution.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50359ff5-d40f-4bb8-81c1-024df09da27a",
                        "source_entry_id": "b08d24ec-1f4a-3c57-bed8-567776cef4cf",
                        "source_sense_id": "9f05ac91-f9f5-3b1f-9b32-259198376e18",
