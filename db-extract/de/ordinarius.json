                                "target_senses": [
                                    {
                                        "sense_id": "1df9de73-b73b-316c-bbad-3d0ac7b4caf9",
                                        "entry_id": "ecd8db64-2d7c-32d8-a186-afe28d726263",
                                        "glosses": [
                                            "A person with authority; authority, ordinance.",
                                            "A person having immediate jurisdiction in a given case of ecclesiastical law, such as the bishop within a diocese."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0be97380-f35c-3d94-9ce6-5f4260828b25",
                                        "entry_id": "ecd8db64-2d7c-32d8-a186-afe28d726263",
                                        "glosses": [
                                            "A person with authority; authority, ordinance.",
                                            "A courier; someone delivering mail or post."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25f5f08b-47ff-498b-bf4e-8a747e67cf29",
                                                "sense_id": "0be97380-f35c-3d94-9ce6-5f4260828b25",
                                                "text": "I […] will lay to till you come within hail […] but pray respond by the first ordinary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f2070cc-6c7b-3f02-acf4-0c70798535f6",
                                        "entry_id": "ecd8db64-2d7c-32d8-a186-afe28d726263",
                                        "glosses": [
                                            "A person with authority; authority, ordinance.",
                                            "A judge with the authority to deal with cases himself or herself rather than by delegation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5733e3a1-ad90-35db-b589-eb360a05b92e",
                                        "entry_id": "ecd8db64-2d7c-32d8-a186-afe28d726263",
                                        "glosses": [
                                            "A person with authority; authority, ordinance.",
                                            "The chaplain of Newgate prison, who prepared condemned prisoners for death."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9df13f46-96a9-4742-bdea-3bc0f83293ce",
                                                "sense_id": "5733e3a1-ad90-35db-b589-eb360a05b92e",
                                                "text": "He died with pious composure and resolution. I have just seen the Ordinary that attended him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff7b5c68-e909-37f2-898d-a6aab1adc974",
                                        "entry_id": "ecd8db64-2d7c-32d8-a186-afe28d726263",
                                        "glosses": [
                                            "Something ordinary or regular.",
                                            "Customary fare, one's regular daily allowance of food; (hence) a regular portion or allowance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30f9ce0f-331b-320e-b807-5872d19becf1",
                                        "entry_id": "ecd8db64-2d7c-32d8-a186-afe28d726263",
                                        "glosses": [
                                            "Something ordinary or regular.",
                                            "A meal provided for a set price at an eating establishment."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6417cc0-8140-4f24-b11e-4583bdae76f1",
                                                "sense_id": "30f9ce0f-331b-320e-b807-5872d19becf1",
                                                "text": "In short, Mr. Jolter could give a very good account of the stages on the road, and […] was a connoisseur in ordinaries, from twelve to five and thirty livres […]."
                                            },
                                            {
                                                "example_id": "dcb4de91-2a4b-43fb-8ecb-286714b388a2",
                                                "sense_id": "30f9ce0f-331b-320e-b807-5872d19becf1",
                                                "text": "Here he recommended me to fix my board, there being an excellent ordinary daily at two o'clock, at which I might dine or not as I pleased."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a61ad3ae-2cc6-3601-99ae-d5a64db065a9",
                                        "entry_id": "ecd8db64-2d7c-32d8-a186-afe28d726263",
                                        "glosses": [
                                            "Something ordinary or regular.",
                                            "A place where such meals are served; a public tavern, inn."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "598084f7-56c5-40ca-9b95-87f6389e409e",
                                                "sense_id": "a61ad3ae-2cc6-3601-99ae-d5a64db065a9",
                                                "text": "Vpon feſtiuall daies he goes to Court, and ſalutes vvithout re-ſaluting: at night in an Ordinarie he confeſſeth the buſineſſe in hand, and ſeemes as conuerſant with all intents and plots, as if he begot them."
                                            },
                                            {
                                                "example_id": "e35ffe38-5e52-4267-ac81-6e66d878bf11",
                                                "sense_id": "a61ad3ae-2cc6-3601-99ae-d5a64db065a9",
                                                "text": "We are most part too inquisitive and apt to hearken after news, which Cæsar, in his Commentaries, observes of the old Gauls, they would be inquiring of every carrier and passenger what they had heard or seen, what news abroad? […] as at an ordinary with us, bakehouse, or barber's shop."
                                            },
                                            {
                                                "example_id": "d78b3b72-95d5-4f1a-9728-56c2031fcdd7",
                                                "sense_id": "a61ad3ae-2cc6-3601-99ae-d5a64db065a9",
                                                "text": "Thus furnished, they come up to town, reckon all their errors for accomplishments, borrow the newest set of phrases ; and if they take a pen into their hands, all the odd words they have picked up in a coffeehouse, or a gaming ordinary, are produced as flowers of style."
                                            },
                                            {
                                                "example_id": "d7f2e62c-400a-4396-8068-4445e3094cb0",
                                                "sense_id": "a61ad3ae-2cc6-3601-99ae-d5a64db065a9",
                                                "text": "He enjoyed a perpetual port duty of fourteen pence a ton, on vessels not owned in the province, yielding not far from five thousand dollars a year; and he exacted a tribute for licenses to hawkers and peddlers and to ordinaries."
                                            },
                                            {
                                                "example_id": "582c8102-c983-4e8a-92a0-39c63d231537",
                                                "sense_id": "a61ad3ae-2cc6-3601-99ae-d5a64db065a9",
                                                "text": "it hath been usual with the honest and well-meaning host to provide a bill of fare which all persons may peruse at their first entrance into the house; and having thence acquainted themselves with the entertainment which they may expect, may either stay and regale with what is provided for them, or may depart to some other ordinary better accommodated to their taste."
                                            },
                                            {
                                                "example_id": "13266629-1226-4f2b-9f63-b9bd6343c00b",
                                                "sense_id": "a61ad3ae-2cc6-3601-99ae-d5a64db065a9",
                                                "text": "I was at the Ordinary last fair day, and there was nothing else talked of."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7665543c-bf54-3d4c-a68f-e912a0c8f449",
                                        "entry_id": "ecd8db64-2d7c-32d8-a186-afe28d726263",
                                        "glosses": [
                                            "Something ordinary or regular.",
                                            "One of the standard geometric designs placed across the center of a coat of arms, such as a pale or fess."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bfd9034-d280-3744-93f9-8d651a4d0b60",
                                        "entry_id": "ecd8db64-2d7c-32d8-a186-afe28d726263",
                                        "glosses": [
                                            "Something ordinary or regular.",
                                            "An ordinary person or thing; something commonplace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe363989-6687-498e-8601-dc65365875e7",
                                                "sense_id": "7bfd9034-d280-3744-93f9-8d651a4d0b60",
                                                "text": "Spain had no other wars save those of the Low Countries, which were grown into an ordinary"
                                            },
                                            {
                                                "example_id": "d3462c51-507e-4c57-ad48-02c3eb81b78f",
                                                "sense_id": "7bfd9034-d280-3744-93f9-8d651a4d0b60",
                                                "text": "water-buckets, waggons, cart-wheels, plough-socks, shuttles, candlesticks, and other ordinaries"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0ac3ea-ef03-3673-b57a-2a631d406724",
                                        "entry_id": "ecd8db64-2d7c-32d8-a186-afe28d726263",
                                        "glosses": [
                                            "Something ordinary or regular.",
                                            "The usual course of things; normal condition or health; a standard way of behaviour or action."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc99d23d-c44b-406e-a350-aaecbc0ce9a9",
                                                "sense_id": "bd0ac3ea-ef03-3673-b57a-2a631d406724",
                                                "text": "I ſee no more in you than in the ordinary / Of nature's ſalework."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dee38bd-f1b5-314c-9c4c-9cba13dde2c9",
