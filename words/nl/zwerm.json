{
    "word_family": [
        "zwermen",
        "uitzwermen",
        "bijenzwerm",
        "sprinkhanenzwerm"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ef57da9-9265-38df-b046-522329f60c0b",
                    "sense_definition": "een grote groep gezamenlijk bewegende dieren (vooral insecten of vogels) of mensen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "groep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Onze hele oogst werd in één middag opgevreten door een enorme <w>zwerm</w> sprinkhanen.",
                            "target_lang_translations": {
                                "en": "Our entire harvest was eaten in a single afternoon by a huge <w>swarm</w> of locusts."
                            }
                        },
                        {
                            "text": "In de verte zagen we een <w>zwerm</w> vogels boven de bomen vliegen.",
                            "target_lang_translations": {
                                "en": "In the distance, we saw a <w>flock</w> of birds flying above the trees."
                            }
                        }
                    ],
                    "synonyms": [
                        "menigte",
                        "groep",
                        "vlucht"
                    ],
                    "common_phrases": [
                        "zwerm sprinkhanen",
                        "zwerm bijen",
                        "zwerm vogels"
                    ],
                    "target_lang_definitions": {
                        "en": "a large group of animals (especially insects or birds) or people moving together"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swarm",
                                "target_lang_sense_clarification": "large group of insects or people in motion"
                            },
                            {
                                "target_lang_word": "flock",
                                "target_lang_sense_clarification": "large group of birds"
                            },
                            {
                                "target_lang_word": "crowd",
                                "target_lang_sense_clarification": "large group of people"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28fc1c70-39a6-3d61-8636-80aa12734f94",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>zwermen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zwerm</w> vaak met mijn gedachten uit naar verre landen als ik me verveel.",
                            "target_lang_translations": {
                                "en": "My thoughts often <w>wander</w> to far-off lands when I am bored."
                            }
                        },
                        {
                            "text": "Als imker zie ik hoe ik <w>zwerm</w> na zwerm moet opvangen in de lente.",
                            "target_lang_translations": {
                                "en": "As a beekeeper, I see how I have to catch <w>swarm</w> after swarm in the spring."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first-person singular present tense of 'to swarm' or 'to wander'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swarm",
                                "target_lang_sense_clarification": "first-person singular present"
                            },
                            {
                                "target_lang_word": "wander",
                                "target_lang_sense_clarification": "first-person singular present, used figuratively for thoughts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1333954a-ded7-37e8-85f2-8f60a8b7a571",
                    "sense_definition": "de gebiedende wijs van <w>zwermen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zwerm</w> uit over het veld en zoek naar aanwijzingen, beval de officier.",
                            "target_lang_translations": {
                                "en": "<w>Fan out</w> across the field and look for clues, the officer ordered."
                            }
                        },
                        {
                            "text": "Ga je gang en <w>zwerm</w> maar rond in de tuin tot het eten klaar is.",
                            "target_lang_translations": {
                                "en": "Go ahead and <w>roam</w> around the garden until dinner is ready."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative form of 'to swarm' or 'to fan out'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swarm",
                                "target_lang_sense_clarification": "imperative form"
                            },
                            {
                                "target_lang_word": "fan out",
                                "target_lang_sense_clarification": "imperative form, meaning to spread out over an area"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}