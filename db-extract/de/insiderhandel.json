                                "target_senses": [
                                    {
                                        "sense_id": "3cd19cab-4a02-3154-b07d-c0388c4b2fe0",
                                        "entry_id": "4ce6d55d-17b2-3a40-9c30-07cbf2994cf9",
                                        "glosses": [
                                            "指股票上市或上櫃公司的董事、監察人、大股東、經理人，事先得知該公司的尚未公開的重大訊息，而早一步買進或賣出該公司股票的不正當交易行為。"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcdba320-f304-4979-8e77-b7f841bd8db3",
                        "source_entry_id": "6ec02c4b-e041-3dff-9828-9bc3d5400ed9",
                        "source_sense_id": "0f592ffe-9b2a-302d-a254-2fde396b8d36",
                        "source_sense_description": "Börsengeschäfte mit Insiderinformationen",
                        "target_lang_word": "insider trading",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insider trading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec63aac8-ad68-3260-872b-2fb3d2d2c506",
                                        "entry_id": "6a57f694-6f25-386a-a01a-1bf2bc408a9e",
                                        "glosses": [
                                            "The illegal trading of a public company's stock or other securities based on material, nonpublic information about the company."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9c69f3a-307c-4106-8806-0acd03d66344",
                                                "sense_id": "ec63aac8-ad68-3260-872b-2fb3d2d2c506",
                                                "text": "Wall Street wants repeal of the provisions for penalizing executives (and large stockholders) who trade in their company's securities. It claims that publicity on such \"insider\" trading is enough."
                                            },
                                            {
                                                "example_id": "700f2aae-be32-4fe7-b4e5-361739695390",
                                                "sense_id": "ec63aac8-ad68-3260-872b-2fb3d2d2c506",
                                                "text": "The aim of insider trading law is simple: prohibit people from profiting from advance knowledge of a stock-moving event—be it a merger, an earnings warning or a soon-to-be-published news story."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
