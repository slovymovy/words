{
    "word_family": [
        "gewuif",
        "uitwuiven",
        "toewuiven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8f634bd-26c3-3f18-b5c8-66419e18bfc8",
                    "sense_definition": "een groet brengen door met de handen te zwaaien",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "groeten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koningin <w>wuifde</w> vriendelijk naar de grote menigte op het plein.",
                            "target_lang_translations": {
                                "en": "The queen <w>waved</w> kindly to the large crowd on the square."
                            }
                        },
                        {
                            "text": "Je moet even <w>wuiven</w> naar opa als we wegrijden.",
                            "target_lang_translations": {
                                "en": "You should <w>wave</w> to grandpa for a moment as we drive away."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwaaien"
                    ],
                    "common_phrases": [
                        "wuiven naar"
                    ],
                    "target_lang_definitions": {
                        "en": "to greet someone by moving your hands back and forth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wave",
                                "target_lang_sense_clarification": "to move the hand in greeting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86938c11-31d3-3194-89ab-7a6c7026252f",
                    "sense_definition": "iemand met een handgebaar uitnodigen om dichterbij te komen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebaren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ober <w>wuifde</w> ons naar een vrije tafel in de hoek.",
                            "target_lang_translations": {
                                "en": "The waiter <w>motioned</w> us to a free table in the corner."
                            }
                        },
                        {
                            "text": "Zij <w>wuifde</w> hem dichterbij om een geheim te vertellen.",
                            "target_lang_translations": {
                                "en": "She <w>beckoned</w> him closer to tell a secret."
                            }
                        }
                    ],
                    "synonyms": [
                        "wenken"
                    ],
                    "common_phrases": [
                        "iemand dichterbij wuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "to invite someone to come closer with a hand gesture"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beckon",
                                "target_lang_sense_clarification": "to signal someone to approach"
                            },
                            {
                                "target_lang_word": "wave over",
                                "target_lang_sense_clarification": "to signal someone to come towards you"
                            },
                            {
                                "target_lang_word": "motion",
                                "target_lang_sense_clarification": "to direct someone with a gesture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce3964e8-0b58-3412-b0e9-75f2ffb2b895",
                    "sense_definition": "het rustig heen en weer bewegen door de wind of stroom",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het korenveld <w>wuifden</w> alle halmen zachtjes met de wind mee.",
                            "target_lang_translations": {
                                "en": "In the cornfield, all the stalks <w>swayed</w> gently with the wind."
                            }
                        },
                        {
                            "text": "De lange grassen <w>wuiven</w> in de zomerbries langs de kant van de weg.",
                            "target_lang_translations": {
                                "en": "The long grasses <w>wave</w> in the summer breeze along the side of the road."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiegen",
                        "zwaaien"
                    ],
                    "common_phrases": [
                        "wuiven in de wind"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt voor planten of bomen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to move gently back and forth in the wind or current"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wave",
                                "target_lang_sense_clarification": "to move back and forth loosely, like grass or flags"
                            },
                            {
                                "target_lang_word": "sway",
                                "target_lang_sense_clarification": "to move slowly from side to side"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}