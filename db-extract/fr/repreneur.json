                                    },
                                    {
                                        "sense_id": "ff9826e2-8d64-31c2-9b2d-9e59e0ff19bf",
                                        "entry_id": "01e011aa-1b4c-3b61-ba1b-a06e991efbae",
                                        "glosses": [
                                            "A person who takes or attempts to take control of a firm against the will of current management by purchasing a controlling interest of stock and acquiring proxies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c45bdcf7-aab3-3d03-a8e4-990909fe49d9",
                                        "entry_id": "01e011aa-1b4c-3b61-ba1b-a06e991efbae",
                                        "glosses": [
                                            "A special forces operative; a commando."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c1e4bd6-7bb2-377f-a31e-b73b54ae9d9c",
                                        "entry_id": "01e011aa-1b4c-3b61-ba1b-a06e991efbae",
                                        "glosses": [
                                            "A warship which is light, maneuverable, and fast-moving."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9ce719f-ac21-3bb9-b72a-cbb90161274e",
                                        "entry_id": "01e011aa-1b4c-3b61-ba1b-a06e991efbae",
                                        "glosses": [
                                            "A warplane on an air raid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fe4d3c2-c02d-4bfb-97e7-42ad898d64ff",
                                                "sense_id": "d9ce719f-ac21-3bb9-b72a-cbb90161274e",
                                                "text": "It was attacked by an evening raider while pulling a passenger train in a south-east coast area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "662677c4-e404-3b01-afb6-22a76848a63a",
                                        "entry_id": "01e011aa-1b4c-3b61-ba1b-a06e991efbae",
                                        "glosses": [
                                            "A law enforcement official who conducts a raid on a building in search for illicit goods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92b74588-150e-3272-b567-dc3daaad46b6",
                                        "entry_id": "01e011aa-1b4c-3b61-ba1b-a06e991efbae",
                                        "glosses": [
                                            "A person who uncovers evidence of improper behavior within governmental or private organizations."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44766737-6a6c-4f17-b0b6-6f2e325fc677",
                        "source_entry_id": "160fcfdc-8c3f-3957-9b6b-55a40e7203dc",
                        "source_sense_description": "finance",
                        "target_lang_word": "rescuer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rescuer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19fb928c-ab14-3e36-b009-11eced92b8ed",
                                        "entry_id": "bf171520-6f4c-3f09-a9a1-13218fce3c79",
                                        "glosses": [
                                            "A person who rescues someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff5c5fad-e6cd-4c8e-a798-6bb306fdd8a6",
                                                "sense_id": "19fb928c-ab14-3e36-b009-11eced92b8ed",
                                                "text": "As Tarzan’s heavy hand fell upon his shoulder the priest dropped his victim, and turned upon her would-be rescuer."
                                            },
                                            {
                                                "example_id": "de0bc4f8-08b3-4c3d-94e0-8f2fc2777c2c",
                                                "sense_id": "19fb928c-ab14-3e36-b009-11eced92b8ed",
                                                "text": "[…] an opportunistic relative masquerading as his rescuer, […]"
                                            },
                                            {
                                                "example_id": "da94585f-1240-4c71-9e9c-fcc2e34ade6e",
                                                "sense_id": "19fb928c-ab14-3e36-b009-11eced92b8ed",
                                                "text": "She knew from avalanche safety courses that outstretched hands might puncture the ice surface and alert rescuers. She knew that if victims ended up buried under the snow, cupped hands in front of the face could provide a small pocket of air for the mouth and nose. Without it, the first breaths could create a suffocating ice mask."
                                            },
                                            {
                                                "example_id": "72a52a80-5d2b-4c29-bc21-543b44f5ddbf",
                                                "sense_id": "19fb928c-ab14-3e36-b009-11eced92b8ed",
                                                "text": "By now, a new worry had emerged. With the rescuers working close to so many dead bodies, there was fear of disease taking hold."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
