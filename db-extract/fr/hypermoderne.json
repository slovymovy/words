                                        "entry_id": "d21cb5f6-9454-3930-b59b-d046f1eb567c",
                                        "glosses": [
                                            "met een erg actuele en toekomstgerichte opzet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c229f576-c492-41f6-af0f-8bd35e7cc486",
                                                "sense_id": "6e4808c4-38c7-3b6b-9bda-ba8da95bceb2",
                                                "text": "In hartje stad zou naast een hypermodern station een levendige stadsentree verrijzen waar Rotterdam en Europa elkaar gingen ontmoeten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aabba90f-4bee-3dc1-bde9-291d0d210e49",
                                        "entry_id": "d21cb5f6-9454-3930-b59b-d046f1eb567c",
                                        "glosses": [
                                            "zo overdreven modern dat het door velen lelijk gevonden wordt"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a741769d-fe59-4aaa-997e-44fed8b174a2",
                                                "sense_id": "aabba90f-4bee-3dc1-bde9-291d0d210e49",
                                                "text": "Die hypermoderne gebouwen uit de jaren zestig moeten nodig eens tegen de vlakte."
                                            },
                                            {
                                                "example_id": "5e1ecdf4-4471-4a86-b33e-14a9bca7750c",
                                                "sense_id": "aabba90f-4bee-3dc1-bde9-291d0d210e49",
                                                "text": "Moet er een hypermodern stadskantoor worden gebouwd in de historische binnenstad van Deventer, tegenover de Lebuïnuskerk aan het Grote Kerkhof, op de plaats van het te krap geworden stadskantoor?"
                                            }
                                        ]
                                    }
                                ]
