                        "translation_id": "8bd76c2c-69ec-4550-9393-d4779d947561",
                        "source_entry_id": "c309f788-111a-3a4b-92be-83d5370aaa20",
                        "source_sense_id": "0fd3bb28-33ea-32b7-a818-ab940751c548",
                        "target_lang_word": "bersagliere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bersagliere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55be74da-798b-3b0a-89c0-502084ace269",
                                        "entry_id": "40989c8a-de13-3bea-8867-69f353ceafc7",
                                        "glosses": [
                                            "A marksman or rifleman in certain Italian regiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd8cb3da-829f-471f-8a08-bf454bc77c0f",
                                                "sense_id": "55be74da-798b-3b0a-89c0-502084ace269",
                                                "text": "We passed a long column of loaded mules, the drivers walking along beside the mules wearing red fezzes. They were bersaglieri."
                                            },
                                            {
                                                "example_id": "3f62b62d-62f2-4e69-8656-f9ecc597ec9a",
                                                "sense_id": "55be74da-798b-3b0a-89c0-502084ace269",
                                                "text": "A small detachment of bersaglieri, which rashly went to see what was going on, was then wiped out by a force of armed peasants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16c04d10-21ed-457b-90af-ae29f860704d",
                        "source_entry_id": "c309f788-111a-3a4b-92be-83d5370aaa20",
                        "source_sense_id": "0fd3bb28-33ea-32b7-a818-ab940751c548",
                        "target_lang_word": "bersaglier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bersaglier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "affaab0d-bbf4-35b8-92d7-ac8a7b72b433",
                                        "entry_id": "f6c73961-5b29-3a6f-be83-e278cf39c3dc",
                                        "glosses": [
                                            "Soldat d’élite de l’infanterie légère de l’armée italienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f469f4-d8ab-4078-9342-fb2645162c58",
                                                "sense_id": "affaab0d-bbf4-35b8-92d7-ac8a7b72b433",
                                                "text": "Elle portait un chapeau façon bersaglieri avec une énorme plume de faisan, et cette plume la gênait terriblement."
                                            },
                                            {
                                                "example_id": "19f335d6-fe4b-49dc-9520-d547178f50db",
                                                "sense_id": "affaab0d-bbf4-35b8-92d7-ac8a7b72b433",
                                                "text": "… les poneys, les calèches à chevaux emplumés comme des bersaglieri de la petite place Torquato Tasso gardent aux rues de Sorrente un parfum 1900, plaisamment désuet."
                                            },
                                            {
                                                "example_id": "8c370921-4dad-4249-be4d-bf9bc109e089",
                                                "sense_id": "affaab0d-bbf4-35b8-92d7-ac8a7b72b433",
                                                "text": "Della Valentina finit par conclure, en bon bersaglier, qu’on pouvait toujours balancer contre les chars ennemis des mines à main nue."
                                            },
                                            {
                                                "example_id": "4960d3d8-3240-4d9a-ac0c-8ec1e491416f",
                                                "sense_id": "affaab0d-bbf4-35b8-92d7-ac8a7b72b433",
                                                "text": "Le 4 octobre 1911, le Premier ministre Giolitti donne le coup d’envoi au départ d’un corps expéditionnaire. Il va vite atteindre les 100 000 hommes, marins et bersagliers, transportés par des centaines de navires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be74b496-f79f-41a2-8942-c2bfc8770288",
                        "source_entry_id": "c309f788-111a-3a4b-92be-83d5370aaa20",
                        "source_sense_id": "0fd3bb28-33ea-32b7-a818-ab940751c548",
                        "target_lang_word": "берсалье́р",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "берсалье́р",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "65b2078e-ba28-3ca4-9eeb-042a9603c7f3",
                                        "entry_id": "3109ba4d-b530-3c7e-b834-c06ad9c279c6",
                                        "glosses": [
                                            "военнослужащий особых стрелковых частей итальянской армии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49ffbacf-b5be-4a3a-b3ee-7ad0471b3540",
                                                "sense_id": "65b2078e-ba28-3ca4-9eeb-042a9603c7f3",
                                                "text": "Вдалеке мелькнули чёрные перья на шляпах берсальеров, бегущих с ружьями наперевес своим форсированным шагом."
                                            }
                                        ]
                                    }
                                ]
