    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab38ade0-e11d-33ed-b893-ca48112bcd96",
                    "sense_definition": "Het tegen betaling tijdelijk in gebruik geven van goederen of een ruimte aan iemand anders.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf is gespecialiseerd in de <w>verhuur</w> van zware machines.",
                            "target_lang_translations": {
                                "en": "The company specializes in the <w>rental</w> of heavy machinery.",
                                "ru": "Компания специализируется на <w>аренде</w> тяжелой техники."
                            }
                        },
                        {
                            "text": "Wij hebben onze vakantiewoning in de <w>verhuur</w> gedaan.",
                            "target_lang_translations": {
                                "en": "We have put our holiday home up for <w>rental</w>.",
                                "ru": "Мы выставили наш дом для отдыха на <w>сдачу</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "verhuring"
                    ],
                    "antonyms": [
                        "huur",
                        "verkoop",
                        "aankoop"
                    ],
                    "common_phrases": [
                        "in de verhuur",
                        "voor de verhuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of giving goods or a space to someone else for temporary use in exchange for payment.",
                        "ru": "Предоставление товаров или помещений в пользование другому лицу на временной основе за плату."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rental",
                                "target_lang_sense_clarification": "general term for the business or act of renting out"
                            },
                            {
                                "target_lang_word": "letting",
                                "target_lang_sense_clarification": "specifically for property/housing"
                            },
                            {
                                "target_lang_word": "hiring out",
                                "target_lang_sense_clarification": "often used for equipment or vehicles"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "аренда",
                                "target_lang_sense_clarification": "общий термин для сдачи или найма"
                            },
                            {
                                "target_lang_word": "сдача в аренду",
                                "target_lang_sense_clarification": "процесс предоставления имущества"
                            },
                            {
                                "target_lang_word": "прокат",
                                "target_lang_sense_clarification": "обычно для оборудования, инструментов или транспорта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54b819a8-7962-3cef-a78e-7255e353650b",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>verhuren</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>verhuur</w> mijn appartement als ik op reis ben.",
                            "target_lang_translations": {
