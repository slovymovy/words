                    {
                        "sense_id": "efc9c145-11c0-3f36-9054-80ad7280fe9b",
                        "entry_id": "3f8e11b4-df94-3958-8aa6-dde3476bd8a8",
                        "glosses": [
                            "Kürbisart, deren Früchte einer mehr oder weniger bauchigen Flasche ähneln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc10833f-c52d-429a-aad9-dfca07d41b97",
                                "sense_id": "efc9c145-11c0-3f36-9054-80ad7280fe9b",
                                "text": "„Marion nahm den langstieligen Flaschenkürbis, der im Wassereimer lag, und reichte ihn dem alten Mann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9c94e61-3c4a-4e02-abdf-0ffc486bc54e",
