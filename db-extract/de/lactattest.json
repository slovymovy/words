                "senses": [
                    {
                        "sense_id": "9cb1cbb8-72ba-3282-bfc8-41cd4f6e8011",
                        "entry_id": "c798344f-040a-3df6-91a1-f36590db31a5",
                        "glosses": [
                            "Untersuchung, zur Bestimmung des Lactatwertes im Blut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a13e3de-af7b-42ad-966d-86566e1e4ea6",
                                "sense_id": "9cb1cbb8-72ba-3282-bfc8-41cd4f6e8011",
                                "text": "„Der Lactattest ist eine Möglichkeit, die Ausdauerleistungsfähigkeit zu messen.“"
                            },
                            {
                                "example_id": "e3567c78-93cf-4f82-8614-87aa2b0b0d17",
                                "sense_id": "9cb1cbb8-72ba-3282-bfc8-41cd4f6e8011",
                                "text": "„Sascha Mölders, 29, zuckt nicht einmal, als ihm am Montag beim Lactattest an seinem rechten Ohrläppchen Blut abgenommen wird.“"
                            },
                            {
                                "example_id": "a58d8426-8d54-455c-9211-d296d79a3489",
                                "sense_id": "9cb1cbb8-72ba-3282-bfc8-41cd4f6e8011",
                                "text": "„Zudem zeigt die Untersuchung, die immer auch einen Lactattest einschließt, den aktuellen Trainingszustand, den es im Laufe des Sommers zu verbessern gilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
