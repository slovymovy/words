                "senses": [
                    {
                        "sense_id": "e8bf61ea-dbd2-3624-8f8e-aa9ec42ee6ca",
                        "entry_id": "b0c7cb2d-7b54-3a0d-bb5a-4b0718bbdce2",
                        "glosses": [
                            "Name, der an zweiter Stelle einer Reihe von Vornamen einer Person steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ffe195e-b282-433b-9b1a-a2c727043a5d",
                                "sense_id": "e8bf61ea-dbd2-3624-8f8e-aa9ec42ee6ca",
                                "text": "„Traditionelle Motive wie die Namengebung nach Heiligen, nach den Paten oder nach Familienangehörigen spielen heutzutage meist nur noch bei der Vergabe des Zweitvornamens eine gewisse Rolle.“"
                            },
                            {
                                "example_id": "2491cab7-bca9-4a5f-b6ea-6e5a74bfb2bc",
                                "sense_id": "e8bf61ea-dbd2-3624-8f8e-aa9ec42ee6ca",
                                "text": "„Außerdem wird er häufig als Zweitvorname verwendet.“"
                            },
                            {
                                "example_id": "66e71a2f-7b5e-41e9-8836-f3e1af82fcc6",
                                "sense_id": "e8bf61ea-dbd2-3624-8f8e-aa9ec42ee6ca",
                                "text": "„Maria, Marie, Sophie und Luise waren beliebt als Zweitvornamen.“"
                            },
                            {
                                "example_id": "7ecd5667-e770-487f-8cde-85794d277dcb",
                                "sense_id": "e8bf61ea-dbd2-3624-8f8e-aa9ec42ee6ca",
                                "text": "„Da der Name Malin in Deutschland als ein in der Regel weiblicher Vorname und auch weiblicher Einzelvorname eingetragen wird, sollte der männliche Name Malin nur in Verbindung mit einem eindeutigen männlichen Zweitvornamen eingetragen werden (vgl. hierzu auch Namenberatungsstelle der Universität Leipzig, Leipzig 2003).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
