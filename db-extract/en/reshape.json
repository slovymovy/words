                                "target_senses": [
                                    {
                                        "sense_id": "a04f5bd2-95a2-30a1-87da-91e8eb10b53d",
                                        "entry_id": "2eed1104-0121-31dd-ab2b-ffbb0902f61d",
                                        "glosses": [
                                            "eine Sache in ihrer Struktur oder Ordnung neu gestalten oder wieder einrichten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "813cb318-e675-45d1-a8f4-0e5e41b16799",
                                                "sense_id": "a04f5bd2-95a2-30a1-87da-91e8eb10b53d",
                                                "text": "Ungarn müsse das ganze Land \"reorganisieren\", nicht nur reformieren."
                                            },
                                            {
                                                "example_id": "ee298f19-7ff1-4cd6-874c-b42875e5ada1",
                                                "sense_id": "a04f5bd2-95a2-30a1-87da-91e8eb10b53d",
                                                "text": "Gleichzeitig will er die Landesverwaltung reorganisieren und spricht offen darüber, dass es im Verhältnis zu anderen Ländern einen sehr hohen Anteil von Landesangestellten gibt, rund 40.000 verwalten die Anliegen von 500.000 Südtirolern."
                                            },
                                            {
                                                "example_id": "c1a8d6c8-c2a1-497e-97db-22fd429c5c22",
                                                "sense_id": "a04f5bd2-95a2-30a1-87da-91e8eb10b53d",
                                                "text": "Die regionale Regierung hätte den privaten Bergbau stoppen und reorganisieren müssen."
                                            },
                                            {
                                                "example_id": "ee247bba-ff33-41ba-adcc-85177380dfd4",
                                                "sense_id": "a04f5bd2-95a2-30a1-87da-91e8eb10b53d",
                                                "text": "Der Konzern wurde zur Baustelle, was innen reorganisieren und außen globalisieren hieß."
                                            },
                                            {
                                                "example_id": "a568c608-eb20-4bea-aff1-077ea1321234",
                                                "sense_id": "a04f5bd2-95a2-30a1-87da-91e8eb10b53d",
                                                "text": "Mit neuartiger Software hilft das Unternehmen aus Portland im nordöstlichen Bundesstaat Maine seinen Kunden, Geschäftsprozesse zu reorganisieren sowie im Internet aufzutreten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
