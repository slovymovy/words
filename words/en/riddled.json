{
    "word_family": [
        "riddle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "03c5942f-6d1d-331e-813c-842035b0359b",
                    "sense_definition": "Damaged throughout by many holes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damaged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden fence was <w>riddled</w> with holes after years of neglect.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный забор был <w>изрешечен</w> дырами после многих лет запустения.",
                                "nl": "Het oude houten hek was na jaren van verwaarlozing <w>doorzeefd</w> met gaten."
                            }
                        },
                        {
                            "text": "The <w>riddled</w> metal sheet could no longer protect the building from the rain.",
                            "target_lang_translations": {
                                "ru": "<w>Изрешеченный</w> металлический лист больше не мог защитить здание от дождя.",
                                "nl": "De <w>doorzeefde</w> metalen plaat kon het gebouw niet langer tegen de regen beschermen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "riddled with holes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поврежденный множеством отверстий или дыр.",
                        "nl": "Beschadigd door een groot aantal gaten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изрешеченный",
                                "target_lang_sense_clarification": "полный дыр или отверстий"
                            },
                            {
                                "target_lang_word": "продырявленный",
                                "target_lang_sense_clarification": "имеющий много дыр"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "doorzeefd",
                                "target_lang_sense_clarification": "vol gaten of openingen"
                            },
                            {
                                "target_lang_word": "geperforeerd",
                                "target_lang_sense_clarification": "voorzien van vele gaten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec4d8e19-c1f9-33f2-9f14-2201b36b386f",
                    "sense_definition": "Containing a large amount of something negative spread throughout.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "full_of",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report was <w>riddled</w> with errors and had to be rewritten completely.",
                            "target_lang_translations": {
                                "ru": "Отчет был <w>изрешечен</w> ошибками и его пришлось полностью переписать.",
                                "nl": "Het rapport was <w>vervuld van</w> fouten en moest volledig worden herschreven."
                            }
                        },
                        {
                            "text": "The entire project was <w>riddled</w> with problems from the very beginning.",
                            "target_lang_translations": {
                                "ru": "Весь проект был <w>изрешечен</w> проблемами с самого начала.",
                                "nl": "Het hele project was vanaf het begin <w>bezaaid met</w> problemen."
                            }
                        }
                    ],
                    "synonyms": [
                        "lousy",
                        "-ridden"
                    ],
                    "common_phrases": [
                        "riddled with errors",
                        "riddled with problems"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий большое количество чего-либо негативного, распределенного повсюду.",
                        "nl": "Bevattend van een grote hoeveelheid negatieve zaken die overal verspreid zijn."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кишащий",
                                "target_lang_sense_clarification": "наполненный чем-то в большом количестве"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "содержащий множество ошибок или проблем"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vervuld van",
                                "target_lang_sense_clarification": "bevat veel van iets negatiefs"
                            },
                            {
                                "target_lang_word": "bezaaid met",
                                "target_lang_sense_clarification": "vol met negatieve elementen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9af72e4c-6c69-388c-b20e-f1290536beda",
                    "sense_definition": "Used in compound adjectives to describe something heavily infested or affected by something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "full_of",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They found a <w>mouse-riddled</w> box in the basement of the old house.",
                            "target_lang_translations": {
                                "ru": "Они нашли в подвале старого дома коробку, <w>кишащую</w> мышами.",
                                "nl": "Ze vonden een door muizen <w>aangetaste</w> doos in de kelder van het oude huis."
                            }
                        },
                        {
                            "text": "The soldier wore a <w>bullet-riddled</w> jacket after the intense battle.",
                            "target_lang_translations": {
                                "ru": "После ожесточенного боя на солдате была <w>изрешеченная</w> пулями куртка.",
                                "nl": "De soldaat droeg na het hevige gevecht een met kogels <w>doorzeefd</w> jasje."
                            }
                        }
                    ],
                    "synonyms": [
                        "-ridden"
                    ],
                    "common_phrases": [
                        "bullet-riddled",
                        "mouse-riddled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в сложных прилагательных для описания чего-то сильно зараженного или пораженного чем-либо.",
                        "nl": "Gebruikt in samenstellingen om aan te duiden dat iets zwaar is aangetast of doorzeefd is door iets."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изрешеченный",
                                "target_lang_sense_clarification": "часто используется с пулями (bullet-riddled)"
                            },
                            {
                                "target_lang_word": "пораженный",
                                "target_lang_sense_clarification": "сильно затронутый чем-то негативным"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "doorzeefd",
                                "target_lang_sense_clarification": "vaak gebruikt bij kogels (bullet-riddled)"
                            },
                            {
                                "target_lang_word": "aangetast",
                                "target_lang_sense_clarification": "zwaar getroffen door iets negatiefs"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "969cd52f-9049-309a-a6da-df59596176cf",
                    "sense_definition": "Past tense and past participle of <w>riddle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The attackers <w>riddled</w> the car with bullets during the chase.",
                            "target_lang_translations": {
                                "ru": "Во время погони нападавшие <w>изрешетили</w> машину пулями.",
                                "nl": "De aanvallers <w>doorzeefden</w> de auto met kogels tijdens de achtervolging."
                            }
                        },
                        {
                            "text": "The document was <w>riddled</w> by the committee before it was finally approved.",
                            "target_lang_translations": {
                                "ru": "Документ был <w>изрешечен</w> правками комитета, прежде чем его окончательно утвердили.",
                                "nl": "Het document werd door de commissie <w>doorzeefd</w> met correcties voordat het uiteindelijk werd goedgekeurd."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола riddle (продырявить, изрешетить).",
                        "nl": "Verleden tijd en voltooid deelwoord van het werkwoord 'riddle' (doorzeven, vol gaten maken)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изрешетили",
                                "target_lang_sense_clarification": "сделали множество отверстий"
                            },
                            {
                                "target_lang_word": "продырявили",
                                "target_lang_sense_clarification": "нанесли множество повреждений"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "doorzeefden",
                                "target_lang_sense_clarification": "meervoud verleden tijd"
                            },
                            {
                                "target_lang_word": "doorzeefd",
                                "target_lang_sense_clarification": "voltooid deelwoord"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}