                                    {
                                        "sense_id": "cd751a4c-8bd4-33e2-8d9f-6d3f7c1ec44b",
                                        "entry_id": "ca94fd9c-3415-3fc5-a209-3e2d1fcd714f",
                                        "glosses": [
                                            "To firmly fix in a specified position."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fded843b-3088-4f27-96b0-16907f79c330",
                                                "sense_id": "cd751a4c-8bd4-33e2-8d9f-6d3f7c1ec44b",
                                                "text": "I've got some spinach lodged between my teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4a4d9ec-ad93-36c1-95d2-9a232a87d306",
                                        "entry_id": "ca94fd9c-3415-3fc5-a209-3e2d1fcd714f",
                                        "glosses": [
                                            "To stay in a boarding-house, paying rent to the resident landlord or landlady."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7ce9627-286c-4601-948c-0c8ff383b4f5",
                                                "sense_id": "d4a4d9ec-ad93-36c1-95d2-9a232a87d306",
                                                "text": "The detective Sherlock Holmes lodged in Baker Street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c338d3f3-349f-3373-b69f-206f8aa2292f",
                                        "entry_id": "ca94fd9c-3415-3fc5-a209-3e2d1fcd714f",
                                        "glosses": [
                                            "To stay in any place or shelter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0095819c-c41f-4880-90a2-b766574ed4c1",
                                                "sense_id": "c338d3f3-349f-3373-b69f-206f8aa2292f",
                                                "text": "Stay and lodge by me this night."
                                            },
                                            {
                                                "example_id": "35b570e8-d2d7-4d92-83fe-7ee27a6db63a",
                                                "sense_id": "c338d3f3-349f-3373-b69f-206f8aa2292f",
                                                "text": "Something holy lodges in that breast.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "48c9a28d-138d-43de-9de3-cfd62658af80",
                                                "sense_id": "c338d3f3-349f-3373-b69f-206f8aa2292f",
                                                "text": "It then becomes necessary for the men to lodge away from home, and at places on the system where large numbers require accommodation regularly, the L.M.S.R. maintains 43 permanent staff hostels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca6b1c40-f123-37df-9262-5680b7f57774",
                                        "entry_id": "ca94fd9c-3415-3fc5-a209-3e2d1fcd714f",
                                        "glosses": [
                                            "To drive (an animal) to covert."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7632cba2-e4a6-4f5c-b454-68f8054957f9",
                                                "sense_id": "ca6b1c40-f123-37df-9262-5680b7f57774",
                                                "text": "This is the time that the horseman are flung out, not having the cry to lead them to the death. When quadruped animals of the venery or hunting kind are at rest, the stag is said to be harboured, the buck lodged, the fox kennelled, the badger earthed, the otter vented or watched, the hare formed, and the rabbit set. When you find and rouse up the stag and buck, they are said to be imprimed: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "780e0131-7214-360b-96a4-b00b0cc5a3ec",
                                        "entry_id": "ca94fd9c-3415-3fc5-a209-3e2d1fcd714f",
                                        "glosses": [
                                            "To supply with a room or place to sleep in for a time."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08119822-f9f9-3635-847c-45a82f311598",
                                        "entry_id": "ca94fd9c-3415-3fc5-a209-3e2d1fcd714f",
                                        "glosses": [
                                            "To put money, jewellery, or other valuables for safety."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "554363e2-7bfe-3b72-af69-27c6ee409380",
                                        "entry_id": "ca94fd9c-3415-3fc5-a209-3e2d1fcd714f",
                                        "glosses": [
                                            "To place (a statement, etc.) with the proper authorities (such as courts, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ce08db6-4329-4032-8577-7d7bcc52f51d",
                                                "sense_id": "554363e2-7bfe-3b72-af69-27c6ee409380",
                                                "text": "to lodge a complaint"
                                            },
                                            {
                                                "example_id": "6e61a58b-1f8a-4290-a1c2-3c7e63bf6d4c",
                                                "sense_id": "554363e2-7bfe-3b72-af69-27c6ee409380",
                                                "text": "He [Harry Maguire] maintains his innocence and has lodged an appeal—which means a retrial and the conviction being set aside in the meantime—[…]."
                                            },
                                            {
                                                "example_id": "31abe81d-5d99-4cfe-8d27-48ae2d72e3bf",
                                                "sense_id": "554363e2-7bfe-3b72-af69-27c6ee409380",
                                                "text": "MPs have moved to lodge a parliamentary motion to strip Prince Andrew of his dukedom, in a rarely permitted move in the Commons. […] On Tuesday, the SNP lodged an early-day motion (EDM) to formally remove Prince Andrew’s title as Duke of York, which he has said he will no longer use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe3ae62a-f242-34dd-aa61-5e082560f058",
                                        "entry_id": "ca94fd9c-3415-3fc5-a209-3e2d1fcd714f",
                                        "glosses": [
                                            "To become flattened, as grass or grain, when overgrown or beaten down by the wind."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b48807d5-8537-4ef4-924e-64fa0e381bab",
                                                "sense_id": "fe3ae62a-f242-34dd-aa61-5e082560f058",
                                                "text": "The heavy rain caused the wheat to lodge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4e4e49e-15c7-3cb7-ba69-bffd7653502c",
                                        "entry_id": "ca94fd9c-3415-3fc5-a209-3e2d1fcd714f",
                                        "glosses": [
                                            "To cause to flatten, as grass or grain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
