                    },
                    {
                        "form_id": "b372c011-3512-44df-80d3-ca28e4038387",
                        "entry_id": "21076c32-7e50-3a0e-bf77-e44bbcc45619",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Geschwurbel"
                    },
                    {
                        "form_id": "fd5d55cc-cc65-41e2-87cf-91afc9e82ced",
                        "entry_id": "21076c32-7e50-3a0e-bf77-e44bbcc45619",
                        "tags": [
                            "accusative",
