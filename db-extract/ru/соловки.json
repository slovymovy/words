                "senses": [
                    {
                        "sense_id": "80d6e9ba-e49d-3be3-a625-75bccda4239a",
                        "entry_id": "3b7188bb-57ee-3633-82ff-37c483e5e2bd",
                        "glosses": [
                            "разг. Соловецкие острова"
