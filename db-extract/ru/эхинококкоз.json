                        "entry_id": "d923b157-d87c-3d0b-8ec3-85cf0466a576",
                        "glosses": [
                            "мед. хронически протекающие глистные инвазии, вызываемые ленточными червями из рода Echinococcus"
                        ],
                        "tags": [],
                        "examples": [
