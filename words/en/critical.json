{
    "word_family": [
        "critic",
        "criticism",
        "criticize",
        "critique",
        "critically",
        "uncritical",
        "hypercritical"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3401a6b0-67cc-330f-8268-109954dd2755",
                    "sense_definition": "Extremely important.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "importance_crisis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>critical</w> that we finish this project by Friday.",
                            "target_lang_translations": {
                                "ru": "<w>Крайне важно</w>, чтобы мы закончили этот проект к пятнице.",
                                "zh": "我们必须在周五前完成这个项目，这<w>至关重要</w>。"
                            }
                        },
                        {
                            "text": "Water plays a <w>critical</w> role in the survival of all living things.",
                            "target_lang_translations": {
                                "ru": "Вода играет <w>решающую</w> роль в выживании всех живых существ.",
                                "zh": "水在所有生物的生存中起着<w>关键</w>作用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crucial",
                        "imperative"
                    ],
                    "antonyms": [
                        "trivial",
                        "insignificant",
                        "unimportant"
                    ],
                    "common_phrases": [
                        "absolutely critical",
                        "critical role",
                        "critical factor",
                        "critical to success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно важный.",
                        "zh": "极其重要的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решающий",
                                "target_lang_sense_clarification": "определяющий исход"
                            },
                            {
                                "target_lang_word": "критически важный",
                                "target_lang_sense_clarification": "необходимый для успеха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "至关重要的",
                                "target_lang_sense_clarification": "形容极其重要，不可或缺"
                            },
                            {
                                "target_lang_word": "关键的",
                                "target_lang_sense_clarification": "对事物发展起决定性作用的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2bb9734-d1e0-35bf-907b-d57ef4f86a1f",
                    "sense_definition": "Inclined to find fault or criticize.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My boss is very <w>critical</w> of my work, even when I try my best.",
                            "target_lang_translations": {
                                "ru": "Мой начальник очень <w>критичен</w> к моей работе, даже когда я стараюсь изо всех сил.",
                                "zh": "即使我尽了最大努力，我的老板还是对我的工作非常<w>挑剔</w>。"
                            }
                        },
                        {
                            "text": "A good teacher is fair but <w>critical</w> when correcting mistakes.",
                            "target_lang_translations": {
                                "ru": "Хороший учитель справедлив, но <w>строг</w> при исправлении ошибок.",
                                "zh": "好的老师在纠正错误时既公正又<w>严厉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "judgmental",
                        "captious",
                        "censorious",
                        "exacting",
                        "fastidious"
                    ],
                    "antonyms": [
                        "complimentary",
                        "praising",
                        "uncritical"
                    ],
                    "common_phrases": [
                        "critical of",
                        "highly critical",
                        "critical eye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный находить недостатки или критиковать.",
                        "zh": "倾向于挑剔或批评的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критичный",
                                "target_lang_sense_clarification": "склонный к критике"
                            },
                            {
                                "target_lang_word": "придирчивый",
                                "target_lang_sense_clarification": "ищущий недостатки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑剔的",
                                "target_lang_sense_clarification": "过分严格，容易发现缺点"
                            },
                            {
                                "target_lang_word": "爱批评的",
                                "target_lang_sense_clarification": "习惯于对人或事提出批评"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c312bfd-e21b-3bd3-b08f-26b944148a96",
                    "sense_definition": "Relating to criticism or careful analysis, such as literary or film criticism.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "analysis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie received <w>critical</w> acclaim from reviewers around the world.",
                            "target_lang_translations": {
                                "ru": "Фильм получил <w>одобрение критиков</w> со всего мира.",
                                "zh": "这部电影获得了世界各地<w>评论界</w>的好评。"
                            }
                        },
                        {
                            "text": "Students need to develop <w>critical</w> thinking skills to solve complex problems.",
                            "target_lang_translations": {
                                "ru": "Студентам необходимо развивать навыки <w>критического</w> мышления для решения сложных задач.",
                                "zh": "学生需要培养<w>批判性</w>思维能力来解决复杂问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "critical thinking",
                        "critical acclaim",
                        "critical analysis",
                        "critical review"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к критике или тщательному анализу (литературному, научному).",
                        "zh": "与评论、分析或评估相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критический",
                                "target_lang_sense_clarification": "относящийся к разбору или анализу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批判性的",
                                "target_lang_sense_clarification": "指经过深入分析和评估的"
                            },
                            {
                                "target_lang_word": "评论的",
                                "target_lang_sense_clarification": "指文学或艺术评论方面的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9a60ced-52ae-319d-b3c0-660d1072e1d5",
                    "sense_definition": "Pertaining to, or indicating, a crisis or turning point.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "importance_crisis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have reached a <w>critical</w> moment in the negotiations.",
                            "target_lang_translations": {
                                "ru": "Мы достигли <w>критического</w> момента в переговорах.",
                                "zh": "我们已经到了谈判的<w>关键</w>时刻。"
                            }
                        },
                        {
                            "text": "The engine failed at a <w>critical</w> point in the race.",
                            "target_lang_translations": {
                                "ru": "Двигатель отказал в <w>решающий</w> момент гонки.",
                                "zh": "引擎在比赛的<w>危急</w>关头发生了故障。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crucial"
                    ],
                    "antonyms": [
                        "stable",
                        "safe"
                    ],
                    "common_phrases": [
                        "critical moment",
                        "critical point",
                        "critical stage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к кризису или поворотному моменту.",
                        "zh": "指危机或转折点的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критический",
                                "target_lang_sense_clarification": "опасный, рискованный"
                            },
                            {
                                "target_lang_word": "переломный",
                                "target_lang_sense_clarification": "меняющий ход событий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关键的",
                                "target_lang_sense_clarification": "处于决定性时刻的"
                            },
                            {
                                "target_lang_word": "危急的",
                                "target_lang_sense_clarification": "处于危险或紧急关头的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c99b8d5-b74e-3167-9c8b-289c52d7783a",
                    "sense_definition": "Of a patient condition involving unstable vital signs and a prognosis that predicts the condition could worsen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver was taken to the hospital in <w>critical</w> condition.",
                            "target_lang_translations": {
                                "ru": "Водителя доставили в больницу в <w>критическом</w> состоянии.",
                                "zh": "司机被送往医院时处于<w>危急</w>状态。"
                            }
                        },
                        {
                            "text": "Doctors said his injuries were <w>critical</w> and required immediate surgery.",
                            "target_lang_translations": {
                                "ru": "Врачи сказали, что его травмы были <w>критическими</w> и требовали немедленной операции.",
                                "zh": "医生说他的伤势<w>危急</w>，需要立即手术。"
                            }
                        }
                    ],
                    "antonyms": [
                        "stable"
                    ],
                    "common_phrases": [
                        "critical condition",
                        "in critical condition",
                        "critical care"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О состоянии пациента с нестабильными жизненными показателями.",
                        "zh": "指病人生命体征不稳定且病情可能恶化的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критический",
                                "target_lang_sense_clarification": "опасный для жизни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "危急的",
                                "target_lang_sense_clarification": "指病情严重，有生命危险"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74cd7342-00ac-3fda-8122-fda5812f54fd",
                    "sense_definition": "Of the point where a nuclear or chemical reaction becomes self-sustaining.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reactor core has gone <w>critical</w> and is producing energy.",
                            "target_lang_translations": {
                                "ru": "Активная зона реактора достигла <w>критического</w> состояния и вырабатывает энергию.",
                                "zh": "反应堆堆芯已达到<w>临界</w>状态并正在产生能量。"
                            }
                        },
                        {
                            "text": "They waited for the solution to reach <w>critical</w> temperature.",
                            "target_lang_translations": {
                                "ru": "Они ждали, пока раствор достигнет <w>критической</w> температуры.",
                                "zh": "他们等待溶液达到<w>临界</w>温度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "critical mass",
                        "go critical"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О точке, где ядерная или химическая реакция становится самоподдерживающейся.",
                        "zh": "指反应达到临界状态的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критический",
                                "target_lang_sense_clarification": "пороговый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "临界的",
                                "target_lang_sense_clarification": "指达到发生某种反应的界限"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7abde5c0-d684-3191-b530-740eaad17a3f",
                    "sense_definition": "A critical value, factor, or item.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team identified the <w>criticals</w> that could delay the launch.",
                            "target_lang_translations": {
                                "ru": "Команда определила <w>критические факторы</w>, которые могли задержать запуск.",
                                "zh": "团队确定了可能推迟发射的<w>关键因素</w>。"
                            }
                        },
                        {
                            "text": "We need to manage these <w>criticals</w> carefully to ensure success.",
                            "target_lang_translations": {
                                "ru": "Нам нужно тщательно управлять этими <w>критическими моментами</w>, чтобы обеспечить успех.",
                                "zh": "我们需要仔细管理这些<w>关键因素</w>以确保成功。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Критически важный фактор или элемент.",
                        "zh": "关键的价值、因素或项目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критический фактор",
                                "target_lang_sense_clarification": "критически важный фактор или элемент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关键因素",
                                "target_lang_sense_clarification": "起决定性作用的要素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0209a77c-aba6-35d1-a2ac-bafa33c680e9",
                    "sense_definition": "In breakdancing, a kind of airflare move in which the dancer hops from one hand to the other.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He practiced his <w>criticals</w> for the upcoming competition.",
                            "target_lang_translations": {
                                "ru": "Он отрабатывал свои <w>критикалы</w> перед предстоящими соревнованиями.",
                                "zh": "他为即将到来的比赛练习了他的<w>侧手翻跳</w>。"
                            }
                        },
                        {
                            "text": "The dancer landed a perfect <w>critical</w> during the battle.",
                            "target_lang_translations": {
                                "ru": "Танцор выполнил идеальный <w>критикал</w> во время баттла.",
                                "zh": "舞者在斗舞中完成了一个完美的<w>侧手翻跳</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "breakdancing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В брейк-дансе: вид движения (эйрфлэр) с перепрыгиванием с руки на руку.",
                        "zh": "在霹雳舞中，一种舞者从一只手跳到另一只手的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критикал",
                                "target_lang_sense_clarification": "брейк-данс: вид эйрфлэра с перескоком с руки на руку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侧手翻跳",
                                "target_lang_sense_clarification": "霹雳舞中的一种特定技巧动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}