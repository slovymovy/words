                        "glosses": [
                            "Person, die Titel vollstreckt, einen schriftlichen Anspruch durchsetzt, und im gehobenen Justizdienst steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f065b07-1482-4a6c-bb92-658510141c7e",
                                "sense_id": "262592a1-4f6c-381d-ada8-f33dc173cb35",
                                "text": "„Obergerichtsvollzieher Günther Dersch bestätigte, dass das Pfändungssiegel entfernt worden sei.“"
                            },
                            {
                                "example_id": "6338a7f1-62b1-4f9c-951a-d7e469fac3ae",
                                "sense_id": "262592a1-4f6c-381d-ada8-f33dc173cb35",
                                "text": "„Im Sommer 2001 verkaufte der Bayer Reinhard Zwanziger im Auftrag eines Freundes mehr als 20 Rinder ins Emsland, darunter ein Salerrind. Als der Kunde zahlungsunfähig war, verlangte Zwanziger die Tiere wieder zurück. Per Obergerichtsvollzieher ließ er einige seiner Rinder beschlagnahmen, doch viele Tiere waren verschwunden.“"
                            }
                        ],
