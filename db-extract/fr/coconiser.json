                ],
                "senses": [
                    {
                        "sense_id": "6800a9cc-39db-389b-85e7-a21498a6f31b",
                        "entry_id": "2e66c435-0b4f-35ec-98de-0f176515036e",
                        "glosses": [
                            "Envelopper comme dans un cocon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f64c9b6-a527-4702-a11a-b434212ade19",
                                "sense_id": "6800a9cc-39db-389b-85e7-a21498a6f31b",
                                "text": "Neutralise la rouille en place, coconise le métal et empêche une nouvelle formation de rouille."
                            }
                        ]
                    },
                    {
                        "sense_id": "205d4ba4-c30b-392b-8101-396c442e24af",
                        "entry_id": "2e66c435-0b4f-35ec-98de-0f176515036e",
                        "glosses": [
                            "Transformer pour être accueillant comme un cocon, transformer en cocon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0996334-8ee3-4e05-b8fc-7448041c41b0",
                                "sense_id": "205d4ba4-c30b-392b-8101-396c442e24af",
                                "text": "La palombière sous la pluie d'automne : au carrefour des longs couloirs d'approche couverts de fougères, un refuge accueillant, amoureusement \"coconisé\" et bien équipé."
                            }
                        ]
                    },
                    {
                        "sense_id": "1209abe3-0eda-3029-ac1d-f7160d20ed88",
                        "entry_id": "2e66c435-0b4f-35ec-98de-0f176515036e",
                        "glosses": [
                            "Devenir cocon."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "8fcb439a-315f-4172-b644-7690fbaada3e",
                                "sense_id": "1209abe3-0eda-3029-ac1d-f7160d20ed88",
                                "text": "Au bout d’une semaine les vers grimpent aux parois du bocal pour se coconiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ef6475c-2738-3a90-8d72-58f362412d55",
                        "entry_id": "2e66c435-0b4f-35ec-98de-0f176515036e",
                        "glosses": [
                            "Se placer dans une atmosphère protectrice de cocon."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "cf63330a-420f-4dcb-8e1b-158b0bf2a641",
                                "sense_id": "9ef6475c-2738-3a90-8d72-58f362412d55",
                                "text": "Marre de ce vacarme ambiant ? Besoin d’un peu de détente ? C’est le moment de vous « coconiser » ; sous la couette, un bol de thé à portée de main et la chaîne hifi allumée, profitez d’un peu de tranquillité avec le nouvel album des compères Guillaume de Chassy et Daniel Yvinec : Songs from the Last Century."
                            }
                        ]
                    }
                ],
