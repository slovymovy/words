                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plant has a <w>tubular</w> structure designed to trap small insects.",
                            "target_lang_translations": {
                                "nl": "De plant heeft een <w>buisvormige</w> structuur die ontworpen is om kleine insecten te vangen."
                            }
                        },
                        {
                            "text": "The doctor examined the <w>tubular</w> organs to look for any signs of damage.",
                            "target_lang_translations": {
                                "nl": "De arts onderzocht de <w>tubulaire</w> organen om te kijken of er tekenen van beschadiging waren."
