{
    "word_family": [
        "partnership",
        "copartner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63199a01-3928-3c68-8847-732fa855812f",
                    "sense_definition": "Someone who is associated with another in a common activity or interest.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "associate_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher told every student to choose a <w>partner</w> for the science experiment.",
                            "target_lang_translations": {
                                "ru": "Учитель велел каждому ученику выбрать <w>напарника</w> для научного эксперимента.",
                                "zh": "老师让每个学生为科学实验选一个<w>搭档</w>。"
                            }
                        },
                        {
                            "text": "I need a reliable <w>partner</w> to help me finish this project on time.",
                            "target_lang_translations": {
                                "ru": "Мне нужен надежный <w>напарник</w>, чтобы помочь мне закончить этот проект вовремя.",
                                "zh": "我需要一个可靠的<w>搭档</w>来帮我按时完成这个项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "associate",
                        "collaborator",
                        "teammate",
                        "ally",
                        "companion"
                    ],
                    "common_phrases": [
                        "project partner",
                        "lab partner",
                        "speaking partner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто связан с другим человеком общей деятельностью или интересами",
                        "zh": "指在共同活动或利益中与他人合作的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напарник",
                                "target_lang_sense_clarification": "в работе или задании"
                            },
                            {
                                "target_lang_word": "партнёр",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "товарищ",
                                "target_lang_sense_clarification": "друг или коллега"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搭档",
                                "target_lang_sense_clarification": "指工作或任务中的伙伴"
                            },
                            {
                                "target_lang_word": "伙伴",
                                "target_lang_sense_clarification": "通用术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b35dc7c2-8c2f-36a6-9993-1b849e99e106",
                    "sense_definition": "A spouse or other person with whom one shares a domestic, romantic, or sexual bond.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She lives in London with her <w>partner</w> and their two children.",
                            "target_lang_translations": {
                                "ru": "Она живет в Лондоне со своим <w>партнёром</w> и их двумя детьми.",
                                "zh": "她和她的<w>伴侣</w>以及两个孩子住在伦敦。"
                            }
                        },
                        {
                            "text": "He brought his new <w>partner</w> to the family dinner to meet his parents.",
                            "target_lang_translations": {
                                "ru": "Он привел свою новую <w>партнёршу</w> на семейный ужин, чтобы познакомить с родителями.",
                                "zh": "他带着新<w>伴侣</w>参加家庭聚餐，介绍给父母认识。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spouse",
                        "significant other",
                        "mate",
                        "husband",
                        "wife",
                        "boyfriend",
                        "girlfriend"
                    ],
                    "common_phrases": [
                        "life partner",
                        "romantic partner",
                        "long-term partner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Супруг или человек, с которым кого-либо связывают романтические или семейные отношения",
                        "zh": "指配偶或与某人有长期恋爱、同居或性关系的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партнёр",
                                "target_lang_sense_clarification": "в романтических отношениях"
                            },
                            {
                                "target_lang_word": "супруг",
                                "target_lang_sense_clarification": "муж или жена"
                            },
                            {
                                "target_lang_word": "спутник жизни",
                                "target_lang_sense_clarification": "устойчивое выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伴侣",
                                "target_lang_sense_clarification": "指恋爱或生活伴侣"
                            },
                            {
                                "target_lang_word": "配偶",
                                "target_lang_sense_clarification": "指法律上的丈夫或妻子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c24fee5-4252-3d98-b2ee-b226ab037139",
                    "sense_definition": "A member of a business or law partnership who shares ownership and responsibilities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "associate_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After ten years of hard work, she finally became a <w>partner</w> at the law firm.",
                            "target_lang_translations": {
                                "ru": "После десяти лет упорной работы она наконец стала <w>партнёром</w> в юридической фирме.",
                                "zh": "经过十年的努力工作，她终于成为了这家律师事务所的<w>合伙人</w>。"
                            }
                        },
                        {
                            "text": "My business <w>partner</w> handles the marketing while I manage the finances.",
                            "target_lang_translations": {
                                "ru": "Мой деловой <w>партнёр</w> занимается маркетингом, а я управляю финансами.",
                                "zh": "我的商业<w>合伙人</w>负责市场营销，而我负责管理财务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "co-owner"
                    ],
                    "common_phrases": [
                        "business partner",
                        "senior partner",
                        "managing partner",
                        "junior partner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участник делового или юридического товарищества, разделяющий права владения и обязанности",
                        "zh": "商业或法律合伙关系中，共同拥有所有权并承担责任的成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партнёр",
                                "target_lang_sense_clarification": "деловой"
                            },
                            {
                                "target_lang_word": "компаньон",
                                "target_lang_sense_clarification": "совладелец бизнеса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合伙人",
                                "target_lang_sense_clarification": "商业或法律领域"
                            },
                            {
                                "target_lang_word": "股东",
                                "target_lang_sense_clarification": "指拥有公司股份的合伙人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f81c1b0-988a-3a85-9b33-99fb77885532",
                    "sense_definition": "Someone with whom one plays on the same side in a game or sport.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "associate_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My tennis <w>partner</w> served the ball perfectly to win the match.",
                            "target_lang_translations": {
                                "ru": "Мой <w>партнёр</w> по теннису отлично подал мяч и выиграл матч.",
                                "zh": "我的网球<w>搭档</w>发球非常完美，赢得了比赛。"
                            }
                        },
                        {
                            "text": "You need to communicate well with your <w>partner</w> to win at bridge.",
                            "target_lang_translations": {
                                "ru": "Вам нужно хорошо общаться со своим <w>партнёром</w>, чтобы выигрывать в бридж.",
                                "zh": "玩桥牌时，你需要和<w>搭档</w>沟通好才能赢。"
                            }
                        }
                    ],
                    "synonyms": [
                        "teammate"
                    ],
                    "antonyms": [
                        "opponent"
                    ],
                    "common_phrases": [
                        "doubles partner",
                        "playing partner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, играющий на одной стороне с кем-либо в игре или спортивном состязании",
                        "zh": "在游戏或体育比赛中与某人站在同一方的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партнёр",
                                "target_lang_sense_clarification": "по команде"
                            },
                            {
                                "target_lang_word": "напарник",
                                "target_lang_sense_clarification": "в игре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搭档",
                                "target_lang_sense_clarification": "指比赛中的队友"
                            },
                            {
                                "target_lang_word": "队友",
                                "target_lang_sense_clarification": "指团队运动中的成员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5eed6897-6571-382d-86f0-9d31045a7a2c",
                    "sense_definition": "Someone with whom one dances in a two-person dance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "associate_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bowed politely to his <w>partner</w> before the waltz began.",
                            "target_lang_translations": {
                                "ru": "Он вежливо поклонился своей <w>партнёрше</w> перед началом вальса.",
                                "zh": "华尔兹开始前，他礼貌地向他的<w>舞伴</w>鞠躬。"
                            }
                        },
                        {
                            "text": "She is looking for a skilled <w>partner</w> for the upcoming salsa competition.",
                            "target_lang_translations": {
                                "ru": "Она ищет опытного <w>партнёра</w> для предстоящего соревнования по сальсе.",
                                "zh": "她正在为即将到来的萨尔萨舞比赛寻找一位技术娴熟的<w>舞伴</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dance partner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, с кем танцуют в паре",
                        "zh": "指双人舞中的舞伴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партнёр",
                                "target_lang_sense_clarification": "в танце"
                            },
                            {
                                "target_lang_word": "партнёрша",
                                "target_lang_sense_clarification": "женщина-партнёр"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舞伴",
                                "target_lang_sense_clarification": "舞蹈中的搭档"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff772f40-ef63-3b2c-9402-c5b22719ded8",
                    "sense_definition": "One of the pieces of wood comprising the framework which strengthens the deck of a wooden ship around the mast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipwright carefully inspected the <w>partners</w> to ensure the mast was secure.",
                            "target_lang_translations": {
                                "ru": "Корабельный плотник тщательно осмотрел <w>партнерс</w>, чтобы убедиться, что мачта надежно закреплена.",
                                "zh": "造船工仔细检查了<w>桅座</w>，以确保桅杆稳固。"
                            }
                        },
                        {
                            "text": "Rotten wood around the <w>partners</w> can endanger the structural integrity of the deck.",
                            "target_lang_translations": {
                                "ru": "Гнилая древесина вокруг <w>партнерса</w> может угрожать структурной целостности палубы.",
                                "zh": "桅座周围腐烂的木头可能会危及甲板的结构完整性。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Элемент конструкции палубы деревянного судна, укрепляющий её вокруг мачты",
                        "zh": "木制船只甲板上用于加固桅杆周围结构的构件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партнерс",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桅座",
                                "target_lang_sense_clarification": "航海术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d035eca-f4d4-352d-b85b-6d8f37ef73fc",
                    "sense_definition": "To join or work with someone as a partner in an activity or business.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university <w>partnered</w> with a local charity to raise funds for the community.",
                            "target_lang_translations": {
                                "ru": "Университет <w>начал сотрудничать</w> с местной благотворительной организацией для сбора средств для общества.",
                                "zh": "大学与当地一家慈善机构<w>合作</w>，为社区筹集资金。"
                            }
                        },
                        {
                            "text": "We decided to <w>partner</w> up to complete the difficult assignment together.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>объединиться</w>, чтобы вместе выполнить это трудное задание.",
                                "zh": "我们决定<w>结成伙伴</w>，共同完成这项艰巨的任务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "collaborate",
                        "team up",
                        "join forces",
                        "cooperate"
                    ],
                    "common_phrases": [
                        "partner with",
                        "partner up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединяться или работать вместе с кем-либо в качестве партнёра",
                        "zh": "与某人建立合作关系或共同开展某项活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотрудничать",
                                "target_lang_sense_clarification": "работать вместе"
                            },
                            {
                                "target_lang_word": "объединяться",
                                "target_lang_sense_clarification": "становиться партнёрами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合作",
                                "target_lang_sense_clarification": "共同工作"
                            },
                            {
                                "target_lang_word": "结成伙伴",
                                "target_lang_sense_clarification": "建立合作关系"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e03ae2c7-8ae0-32e0-aace-f2ed379619d4",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Partner</w> was listed as the primary contact on the document.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Партнер</w> был указан в качестве основного контактного лица в документе.",
                                "zh": "文件上列出的主要联系人是<w>帕特纳</w>先生。"
                            }
                        },
                        {
                            "text": "I have never met anyone with the last name <w>Partner</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не встречал никого с фамилией <w>Партнер</w>.",
                                "zh": "我以前从未见过姓<w>帕特纳</w>的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Партнер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帕特纳",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}