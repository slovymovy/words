                "senses": [
                    {
                        "sense_id": "3f03461c-655e-3929-903d-fe325cd9ac74",
                        "entry_id": "9bdf7212-f71e-36b3-a946-8cb843684870",
                        "glosses": [
                            "Durée d’un mandat politique."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "2753b481-6fd2-42b7-9bbb-e1fee183b7ba",
                                "sense_id": "3f03461c-655e-3929-903d-fe325cd9ac74",
                                "text": "SP voit comme principale « contrainte » pour l’[Île-de-France] une « faible flexibilité sur ses recettes » et pour la Ville de Paris un « ambitieux programme d’investissement de la mandature »."
                            },
                            {
                                "example_id": "b6c741c9-1b34-4cdf-8713-295589705400",
                                "sense_id": "3f03461c-655e-3929-903d-fe325cd9ac74",
                                "text": "À part le bref débat qui suivit mon intervention, le Conseil municipal de Paris et le Conseil général de la Seine n’entendirent pas parler de La Villette pendant toute cette mandature, c’est-à-dire de 1959 à 1965."
                            },
                            {
                                "example_id": "77b89c03-7ea5-481f-b6d0-88ce7511f893",
                                "sense_id": "3f03461c-655e-3929-903d-fe325cd9ac74",
                                "text": "Je vous le dis tout net et pour la troisième fois depuis le début de cette mandature cette lenteur provient du fait qu’à Paris, les pouvoirs publics n’ont pas voulu ou, plus exactement, n’ont pas su faire participer la population à ce grand éland que nous avons trouvé dans les nations proches de la France."
                            }
                        ]
                    }
                ],
