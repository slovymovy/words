                        "examples": [
                            {
                                "example_id": "fad6630d-2a95-404b-9b73-4dbf0943f89f",
                                "sense_id": "2aa6f0c4-4f1c-3324-9374-86ac91f2b70a",
                                "text": "Een omslachtige democratische besluitvorming lijkt inefficiënt maar is dat op de lange termijn niet."
                            },
                            {
                                "example_id": "b989525d-a92b-4745-98f5-c725c1e8d50a",
                                "sense_id": "2aa6f0c4-4f1c-3324-9374-86ac91f2b70a",
                                "text": "Niinisto en Marin hopen dat de besluitvorming over het NAVO-lidmaatschap in eigen land binnen een paar dagen is afgehandeld. Daarna is het de beurt aan de NAVO-landen, die moeten besluiten over het Finse lidmaatschap. In juni is er een NAVO-top waarin de toetreding besproken zal worden. Mogelijk gaat het dan ook over het lidmaatschap van Zweden. Dat land overweegt sterk om het lidmaatschap aan te vragen."
                            }
                        ]
