            {
                "entry_id": "dbec50c1-f243-33de-a4c1-fe0787f8da49",
                "word": "décime",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c325a49e-b8a6-4ed7-96e0-11236e2a8465",
                        "entry_id": "dbec50c1-f243-33de-a4c1-fe0787f8da49",
                        "tags": [
                            "plural"
                        ],
                        "form": "décimes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "971de7ae-2e31-313a-a0d2-d0f45171de4e",
                        "entry_id": "dbec50c1-f243-33de-a4c1-fe0787f8da49",
                        "glosses": [
                            "Dixième partie du franc."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "19089f41-315e-493c-a037-23a65328fe6f",
                                "sense_id": "971de7ae-2e31-313a-a0d2-d0f45171de4e",
                                "text": "Noémi ne s’oppose pas formellement à ces escapades, mais les moindres dépenses en sont calculées d’avance en famille jusqu’au dernier décime."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee3e9777-dd87-31f1-85fd-3435004356eb",
                        "entry_id": "dbec50c1-f243-33de-a4c1-fe0787f8da49",
                        "glosses": [
                            "Pièce de monnaie de dix centimes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "594c3467-311d-4665-b640-28b5a07c4143",
                                "sense_id": "ee3e9777-dd87-31f1-85fd-3435004356eb",
                                "text": "Pour tous, elle a un sourire aimable et, d’un gracieux merci, elle montre ses dents blanches lorsqu’un décime tombe dans le plateau."
                            },
                            {
                                "example_id": "042a5cd6-6d47-4539-a3cb-0d6e32421871",
                                "sense_id": "ee3e9777-dd87-31f1-85fd-3435004356eb",
                                "text": "C’est bien compris, articula le père, voilà huit sous que tu donneras à Gosey. Ne les perds pas surtout […]. Camus prit dans sa main gauche les quatre décimes […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "171a2bca-cb86-3f1b-ab5e-172718525786",
                        "entry_id": "dbec50c1-f243-33de-a4c1-fe0787f8da49",
                        "glosses": [
                            "Taxe exceptionnelle ou spéciale d’un décime par franc de la part contributive de chaque citoyen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "171fc9d1-69b6-4126-8f9b-f0dffa01aa85",
                                "sense_id": "171a2bca-cb86-3f1b-ab5e-172718525786",
                                "text": "Le pape voulait avoir l'argent d'une décime accordée sous le prétexte d'un secours pour la Terre-Sainte, qui n'était plus secourable, et qui était sous le pouvoir d'un descendant de Gengis."
                            },
                            {
                                "example_id": "1439e73d-80b4-45f4-bf6e-fd346d4029ae",
                                "sense_id": "171a2bca-cb86-3f1b-ab5e-172718525786",
                                "text": "Le chauffeur a écopé d’une amende de 40 euros (à multiplier par huit en raison des décimes additionnels)."
                            }
                        ]
                    }
                ],
