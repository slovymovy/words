                        "source_sense_id": "58c7ea40-3bd4-34a3-ba27-31b5707e67b0",
                        "target_lang_word": "rigorista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3681b960-6d82-4028-97ec-6c51e9cfe920",
                        "source_entry_id": "2e737308-40af-3986-8c03-6f2e281f094b",
                        "source_sense_id": "58c7ea40-3bd4-34a3-ba27-31b5707e67b0",
                        "target_lang_word": "rigoristico",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2a8be5d9-bf7b-4b05-9210-755177d1cae7",
                        "source_entry_id": "2e737308-40af-3986-8c03-6f2e281f094b",
                        "source_sense_id": "58c7ea40-3bd4-34a3-ba27-31b5707e67b0",
                        "target_lang_word": "rigoriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rigoriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d1c59b0-5d4d-3748-ada1-1bff46b4f08c",
                                        "entry_id": "c4b5eef3-9220-391e-9927-942db5c97d2e",
                                        "glosses": [
                                            "Personne qui pousse trop loin la sévérité de certains principes, et particulièrement de ceux de la morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d5dc3b8-f2a2-4ec6-814a-a74438bbd953",
                                                "sense_id": "2d1c59b0-5d4d-3748-ada1-1bff46b4f08c",
                                                "text": "C’est un rigoriste en matière de littérature et de goût."
                                            },
                                            {
                                                "example_id": "bd0bc122-2a86-447f-810c-9378370f7270",
                                                "sense_id": "2d1c59b0-5d4d-3748-ada1-1bff46b4f08c",
                                                "text": "– … Mon frère est-il toujours aussi rigoriste? L'âge l'a-t-il rendu plus humain, plus indulgent?\n– Un roc reste un roc, répondit Maxence, …."
                                            },
                                            {
                                                "example_id": "909de120-6453-42e8-a78f-1e46f6cea532",
                                                "sense_id": "2d1c59b0-5d4d-3748-ada1-1bff46b4f08c",
                                                "text": "C’est sous la pression des réactionnaires unionistes (protestants) et des rigoristes presbytériens que l’avortement est totalement interdit dans les six comtés nordistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b2f206e-32f9-3d0f-9982-a244e56ae5d0",
                                        "entry_id": "c4b5eef3-9220-391e-9927-942db5c97d2e",
                                        "glosses": [
                                            "Partisan d’une politique de rigueur, voire d’austérité, en réponse à un déséquilibre économique ou budgétaire."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rigoriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4eee7ec8-dca2-3017-86f1-4e151af35afd",
                                        "entry_id": "2dab90d0-365d-3ef9-a2b0-d7fcec48cb6d",
                                        "glosses": [
                                            "Qui pousse trop loin la sévérité de certains principes, et particulièrement de ceux de la morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "480289e3-270f-4fac-a548-36ba5678b250",
                                                "sense_id": "4eee7ec8-dca2-3017-86f1-4e151af35afd",
                                                "text": "« Mes parents me tueront. » Il n’en doutait pas : une famille de rustres rigoristes, piliers d’une chapelle dissidente quelconque."
                                            },
                                            {
                                                "example_id": "c1b37b25-502a-4a0a-85f3-32c5f3c51033",
                                                "sense_id": "4eee7ec8-dca2-3017-86f1-4e151af35afd",
                                                "text": "Les membres de la petite bourgeoisie sont caractérisés par un habitus fondé sur la restriction par prétention, le volontarisme rigoriste liés à leur volonté d'ascension sociale."
                                            },
                                            {
                                                "example_id": "a56e91a3-51a7-4fcd-a5ef-662ca13cb3e7",
                                                "sense_id": "4eee7ec8-dca2-3017-86f1-4e151af35afd",
                                                "text": "Depuis les attentats de novembre et la reprise en main de la mosquée de Mantes par le Maroc, ce religieux rigoriste a brusquement changé son fusil d'épaule. Il jure au \"Canard\" qu'il n'a désormais plus rien à voir avec les salafistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
