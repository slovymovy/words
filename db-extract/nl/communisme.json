                "senses": [
                    {
                        "sense_id": "86489290-894f-3c1a-9733-688407b7bdc4",
                        "entry_id": "7d868017-33d8-3d62-ab10-c53e9a760f21",
                        "glosses": [
                            "atheïstische ideologie die gericht is op gemeenschappelijk bezit van productiemiddelen en verbruiksgoederen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c7e45e-fd2d-4a9b-94e2-35cf1ef88729",
                                "sense_id": "86489290-894f-3c1a-9733-688407b7bdc4",
                                "text": "Nee, dat was even onwaarschijnlijk als een liefdesverklaring van de paus aan het communisme."
                            },
                            {
                                "example_id": "c39f23e9-f75a-4acd-b808-7a06a2c466ff",
                                "sense_id": "86489290-894f-3c1a-9733-688407b7bdc4",
                                "text": "Bij maatschappijleer kregen we een opfriscursus over het communisme, zelfs de godsdienstlessen gingen plotseling over wat Jezus gevonden zou hebben van de Sovjet-Russische intocht in Boedapest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a768f398-1aa0-416c-b01d-67f75b634a8a",
                        "source_entry_id": "7d868017-33d8-3d62-ab10-c53e9a760f21",
                        "source_sense_id": "86489290-894f-3c1a-9733-688407b7bdc4",
                        "source_sense_description": "ideologie die gericht is op gemeenschappelijk bezit van productiemiddelen en verbruiksgoederen",
                        "target_lang_word": "Kommunismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommunismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                        "entry_id": "35d7d005-7df0-3b9e-8b58-dca5415a2c31",
                                        "glosses": [
                                            "politische Theorie und Strömung (Richtung, Bewegung), die sich gegen den Kapitalismus stellt und eine zentralistisch gelenkte Wirtschafts- sowie Sozialordnung verficht"
                                        ],
                                        "tags": [
                                            "nach der Lehre von Karl Marx"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6ee7bad-6a4c-4b93-a1a4-d3bf0d3d7a87",
                                                "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                                "text": "Nach dem 1. Weltkrieg hatte der Kommunismus großen Zulauf."
                                            },
                                            {
                                                "example_id": "7c701afb-f148-4942-963c-bd31016b7417",
                                                "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                                "text": "Der Kommunismus analysiert den Kapitalismus und zeigt, wieso dieser untergehen muss."
                                            },
                                            {
                                                "example_id": "f5a879cb-5ef2-4a6e-93e4-2ae28abff1f6",
                                                "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                                "text": "„In der DDR wurde das Werk, dessen zentrale Figur sich vom Kommunismus abwendet, erst 1990 in einer billigen Reclam-Ausgabe vorgelegt.“"
                                            },
                                            {
                                                "example_id": "0a1c8d5a-d8c9-41d9-a46e-0af27ea73d99",
                                                "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                                "text": "„Der Islam, der Buddhismus und der Kommunismus sind dagegen Religionen, weil es sich um Systeme menschlicher Werte und Normen handelt, die auf dem Glauben an eine übermenschliche Ordnung basieren.“"
                                            },
                                            {
                                                "example_id": "6db67caa-a72f-42d2-93d0-a2b69c3b0049",
                                                "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                                "text": "„Der Kommunismus ist eine sehr einfache, optimistiche Religion; der Nihilismus das Ergebnis eines pessimistischen Denkens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8991b1d9-a43e-3b53-83d1-d6652befcfc3",
                                        "entry_id": "35d7d005-7df0-3b9e-8b58-dca5415a2c31",
                                        "glosses": [
                                            "Gesellschaftsform, auf den Sozialismus folgende Entwicklungsstufe, die den Zustand herrschaftsfreien Gemeineigentums anstrebt, bei der also alle Produktionsmittel sowie Erzeugnisse in das gemeinsame Eigentum der Staatsbürger übergehen und alle Klassengegensätze überwunden sind"
                                        ],
                                        "tags": [
                                            "nach der Lehre von Karl Marx"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "380ee255-41f7-48dd-8841-5855efb40dcd",
                                                "sense_id": "8991b1d9-a43e-3b53-83d1-d6652befcfc3",
                                                "text": "Nach dem Sozialismus kommt der Kommunismus."
                                            },
                                            {
                                                "example_id": "f528babd-505d-4065-88b6-4e4b54c5f6b4",
                                                "sense_id": "8991b1d9-a43e-3b53-83d1-d6652befcfc3",
                                                "text": "Im Kommunismus gibt es kein privates Eigentum mehr, Alles gehört Allen, jeder trägt mit seinem Können bei, und eines jeden Bedürfnisse werden befriedigt."
                                            },
                                            {
                                                "example_id": "fac5da7c-9b05-4875-ab75-483fcae0cd8b",
                                                "sense_id": "8991b1d9-a43e-3b53-83d1-d6652befcfc3",
                                                "text": "„Meine Mutter war nicht nur im Kommunismus aufgewachsen, sie lebte ihr ganzes Leben unter seinem Regime.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d30308a-9aef-4c1c-b0e5-be3bc70f928b",
                        "source_entry_id": "7d868017-33d8-3d62-ab10-c53e9a760f21",
                        "source_sense_id": "86489290-894f-3c1a-9733-688407b7bdc4",
                        "source_sense_description": "ideologie die gericht is op gemeenschappelijk bezit van productiemiddelen en verbruiksgoederen",
                        "target_lang_word": "communism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7547215b-32c5-3b2e-bfc7-531699f77965",
                                        "entry_id": "98cc5e00-5b0f-35da-b7ae-38a208b6a9f0",
                                        "glosses": [
                                            "Any far-left political ideology or philosophy advocating holding the production of resources collectively, especially by seizing it through revolution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c969b79-5e47-4e90-8f87-e7e1b9be5e52",
                                                "sense_id": "7547215b-32c5-3b2e-bfc7-531699f77965",
                                                "text": "I want to gather together about twenty souls and sail away from this world of war and squalor and found a little colony where there shall be no money but a sort of communism as far as necessaries of life go, and some real decency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f16f63c8-9eea-3928-a3fe-762ce78e8272",
                                        "entry_id": "98cc5e00-5b0f-35da-b7ae-38a208b6a9f0",
                                        "glosses": [
                                            "Any political social system that implements a communist political philosophy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12cfea6c-4e42-3876-8e57-cca243a6ad51",
                                        "entry_id": "98cc5e00-5b0f-35da-b7ae-38a208b6a9f0",
                                        "glosses": [
                                            "The international socialist society where classes, money, and the state no longer exist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ade1bb0-d8d9-3466-823a-099e12ff0e85",
                                        "entry_id": "98cc5e00-5b0f-35da-b7ae-38a208b6a9f0",
                                        "glosses": [
                                            "Any left-wing ideology, government regulations, or policies promoting a welfare state, nationalisation, etc."
                                        ],
                                        "tags": [
                                            "Western",
                                            "colloquial",
                                            "countable",
                                            "derogatory",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ac7f8a1-f54c-48b6-bf8c-f1c5078dad1d",
                                                "sense_id": "9ade1bb0-d8d9-3466-823a-099e12ff0e85",
                                                "text": "This tax plan is communism!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6d2ef27-9e97-339e-ab62-df963614f917",
                                        "entry_id": "98cc5e00-5b0f-35da-b7ae-38a208b6a9f0",
                                        "glosses": [
                                            "Readiness to share scientific findings (the first of the Mertonian norms)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9cfadf2-0f04-4139-99b4-2be2d7a86c57",
                                                "sense_id": "b6d2ef27-9e97-339e-ab62-df963614f917",
                                                "text": "A recent survey of 633 South Korean scientists found not only that communism was the Mertonian norm they thought most respected in practice (Kim and Kim 2018, 9), but also that younger scientists’ replies showed evidence of ‘mounting tension between the commercialisation of academic science and the norm of communalism’ (Kim and Kim 2018, 19). Our focus on scientific communism and its relationship to commercial research may thus reflect the concerns of working scientists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8484e3a-6154-3e21-bd87-26536255b1e0",
                                        "entry_id": "98cc5e00-5b0f-35da-b7ae-38a208b6a9f0",
                                        "glosses": [
                                            "communality, sharedness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b66c1c21-45d1-44fb-8091-cd93b0cbe304",
                                                "sense_id": "b8484e3a-6154-3e21-bd87-26536255b1e0",
                                                "text": "Rational expectations econometrics extends a communism of statistical models to include a “sharing with nature” that is an essential input into making maximum likelihood or generalized method of moments be good estimators."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48f2e340-72cf-43f2-918a-d297f53a86fa",
                        "source_entry_id": "7d868017-33d8-3d62-ab10-c53e9a760f21",
                        "source_sense_id": "86489290-894f-3c1a-9733-688407b7bdc4",
                        "source_sense_description": "ideologie die gericht is op gemeenschappelijk bezit van productiemiddelen en verbruiksgoederen",
                        "target_lang_word": "communisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e228c406-ac64-338c-b070-81d278588e4e",
                                        "entry_id": "f7a082f7-d235-3f13-b8f1-1c3e6a962385",
                                        "glosses": [
                                            "Mise en commun des moyens de production."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f80119ce-183f-4933-9fe5-82bc8e710e64",
                                                "sense_id": "e228c406-ac64-338c-b070-81d278588e4e",
                                                "text": "Voilà comment, dans ce pays, depuis un temps immémorial, les gens vivotaient heureux, pratiquant une espèce de communisme familial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fb94ba4-588a-38a1-9343-3a7dbce88968",
                                        "entry_id": "f7a082f7-d235-3f13-b8f1-1c3e6a962385",
                                        "glosses": [
                                            "Idéologie qui prône un système économique et social basé sur l’élimination de la propriété privée au profit de la propriété collective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "760ec4eb-2294-4c34-b871-fadec535559d",
                                                "sense_id": "0fb94ba4-588a-38a1-9343-3a7dbce88968",
                                                "text": "Toutes les sectes socialistes, qui s’entre-dévoraient, péchaient par l’arbitraire organisation du travail, asservissaient l’individu au profit de la communauté. C’était pourquoi, forcé de concilier les deux grands courants, les droits de la société, les droits de l’individu, il avait fini par mettre toute sa foi dans le communisme libertaire, cette anarchie où il rêvait l’individu délivré, évoluant, s’épanouissant, sans contrainte aucune, pour son bien et pour le bien de tous."
                                            },
                                            {
                                                "example_id": "c39b348c-0c36-4bde-98e5-0373a1148f54",
                                                "sense_id": "0fb94ba4-588a-38a1-9343-3a7dbce88968",
                                                "text": "Le communisme lui-même, pour notre bourgeoisie, n’est qu’un climat littéraire dans lequel se dissipent les réalités les plus immédiates et les plus menaçantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3682200-9ce2-337c-bc4e-ca1d98009947",
                                        "entry_id": "f7a082f7-d235-3f13-b8f1-1c3e6a962385",
                                        "glosses": [
                                            "Système économique et social, théorisé par Karl Marx et Friedrich Engels, caractérisé par la propriété collective des biens et des moyens de production."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4dfb5a0-8173-4374-a7be-943e27993085",
                                                "sense_id": "e3682200-9ce2-337c-bc4e-ca1d98009947",
                                                "text": "Le communisme, une très bonne affaire pour les malins, une duperie pour ceux qui espèrent en la transformation sociale."
                                            },
                                            {
                                                "example_id": "9a2dafa1-3f9e-4eaf-acd2-8f5d16bcb0e3",
                                                "sense_id": "e3682200-9ce2-337c-bc4e-ca1d98009947",
                                                "text": "Si le communisme ne devait pas conduire à la création d’un homme nouveau, il n’aurait aucun sens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
