                        {
                            "text": "Every <w>chap</w> who visits the market finds something interesting to buy.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>покупатель</w>, посещающий рынок, находит что-то интересное для покупки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is archaic and rarely used in modern English."
                        }
