                    },
                    {
                        "translation_id": "46f90789-dd4b-4044-acb2-5c7e662947c2",
                        "source_entry_id": "d8f84c95-2e1e-3f7a-94bc-6f9d563b50c5",
                        "source_sense_description": "disposition mauvaise",
                        "target_lang_word": "dubbelheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dubbelheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1313c267-ecad-35aa-9620-de9a3259c737",
                                        "entry_id": "b6a5f170-bffc-39f8-9e70-7e6fd0e73a55",
                                        "glosses": [
                                            "het twee (tegengestelde) dingen tegelijk zijn of willen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72a47a7a-ec19-4878-9983-96bc63c67aee",
                                                "sense_id": "1313c267-ecad-35aa-9620-de9a3259c737",
                                                "text": "Meteen nadat ik, vloekend tegen het felle licht, de gordijnen open had geschoven, kwam die dubbele gestalte van Mirjam binnen: de moeder van mijn kind, en de van haar kind beroofde moeder. Het ene oog dichtknijpen tegen deze dubbelheid verhielp niets."
                                            },
                                            {
                                                "example_id": "d0f9fa36-e487-4168-a4b0-e5c2b098d3bb",
                                                "sense_id": "1313c267-ecad-35aa-9620-de9a3259c737",
                                                "text": "In de gesprekken die Van Heest voert met haar patiënten, komt sterk naar voren dat gevoelens over de dood vaak niet zo duidelijk zijn. \"Mensen die heel ziek zijn, hangen juist aan het leven.\" Die dubbelheid ervaart de huisarts doorlopend bij haar patiënten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b510fb92-9ab8-42d4-8ded-c9ebe61615cd",
                        "source_entry_id": "d8f84c95-2e1e-3f7a-94bc-6f9d563b50c5",
                        "source_sense_description": "disposition mauvaise",
                        "target_lang_word": "dubbelhartigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dubbelhartigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f3f927a3-c6b2-3890-b40a-f90562bd7942",
                                        "entry_id": "a91091d9-73b4-3076-8b33-8082d2540383",
                                        "glosses": [
                                            "het twee tegengestelde dingen tegelijk vinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d7a39f6-747a-4872-915e-4052bdca551f",
                                                "sense_id": "f3f927a3-c6b2-3890-b40a-f90562bd7942",
                                                "text": "Wij hadden al afgesproken de hele schertsvertoning met een half oog via de live-uitzending op televisie te volgen, het scherm onze hoon niet te sparen, en de smaak van nationale dubbelhartigheid na afloop met een glas sterk spul weg te spoelen."
                                            },
                                            {
                                                "example_id": "f6ff8e64-ed4a-485b-9615-315d8484f87e",
                                                "sense_id": "f3f927a3-c6b2-3890-b40a-f90562bd7942",
                                                "text": "Assad verwijt het Westen dubbelhartigheid. \"Het Westen huilt om de vluchtelingen maar steunt de terroristen sinds het begin van deze crisis, toen ze nog spraken van een 'vreedzame opstand'. Later hadden ze het over 'gematigde oppositie'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
