                "senses": [
                    {
                        "sense_id": "babd39ff-45f1-3ff8-9080-4d6b754ff2c0",
                        "entry_id": "dd5abe60-9ea8-3a27-aeb8-56773a034e8f",
                        "glosses": [
                            "Blutung innerhalb des Gehirns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca4829f9-0732-4e8a-9825-461841baf44e",
                                "sense_id": "babd39ff-45f1-3ff8-9080-4d6b754ff2c0",
                                "text": "„Eine nicht erkannte Hirnblutung ist tödlich, zeigt jedoch erst verspätet die Zeichen eines Schlaganfalls.“"
                            },
                            {
                                "example_id": "5fb6dc24-9f28-4927-ab38-8b31639b19c6",
                                "sense_id": "babd39ff-45f1-3ff8-9080-4d6b754ff2c0",
                                "text": "„Im Grunde war seine Hirnblutung die Folge mangelnder Disziplin und seine Sprachhemmung dem fehlenden Willen geschuldet, diese zu überwinden.“"
                            },
                            {
                                "example_id": "7fed4f8f-3227-4baa-aa76-1b89d72ba64e",
                                "sense_id": "babd39ff-45f1-3ff8-9080-4d6b754ff2c0",
                                "text": "„Der »längste und traurigste Tag meines jungen amerikanischen Lebens«, sagte Roth, war der 12. April 1945, als Franklin D. Roosevelt kurz vor dem Ende des Kriegs in Europa an einer Hirnblutung starb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
