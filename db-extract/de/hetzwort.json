                "senses": [
                    {
                        "sense_id": "fefedecb-f678-3623-947d-be3857e53337",
                        "entry_id": "f6e56361-3e9d-3e18-a231-bdfd566fcddb",
                        "glosses": [
                            "Wort oder Ausspruch, die eine Hetze gegen jemand oder etwas beinhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5ca6c3-dc43-44ad-9649-f76a1c43c5d4",
                                "sense_id": "fefedecb-f678-3623-947d-be3857e53337",
                                "text": "„Folglich hat die Kirche stets eine solche Tendenz gepflegt, bis Johannes XXIII. manches in der Liturgie der Fastenwoche milderte oder es gar auslöschte, vor allem einige widerliche Aggressionen und Hetzworte, die gegen dieses Volk gerichtet waren und seit Urzeiten bestanden hatten.“"
                            },
                            {
                                "example_id": "37e44864-ab1a-49f3-b870-f32ad80666ad",
                                "sense_id": "fefedecb-f678-3623-947d-be3857e53337",
                                "text": "„Laut Rudolf Muhr von der Forschungsstelle Österreichisches Deutsch gibt es dieses Jahr keine „Hetzwörter“ zur Auswahl, wie er im Radio Arabella-Interview sagt. “"
                            },
                            {
                                "example_id": "acf321ea-a480-4f5f-b997-754bf37485c7",
                                "sense_id": "fefedecb-f678-3623-947d-be3857e53337",
                                "text": "„»Aus Langeweile« soll der Angeklagte die Hetzworte im Internet gepostet haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
