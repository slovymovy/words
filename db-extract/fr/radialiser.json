                "senses": [
                    {
                        "sense_id": "e704fd29-8855-3ed3-8715-7505a25b944b",
                        "entry_id": "5dbdf74a-28a6-33c3-abfd-e82429ea389e",
                        "glosses": [
                            "Donner un caractère radial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a62a0fa-b172-4f6a-a35c-58337642731b",
                                "sense_id": "e704fd29-8855-3ed3-8715-7505a25b944b",
                                "text": "Ainsi le territoire s’est-il trouvé plus fortement « radialisé », les axes lourds ont-ils été renforcés et les régions les moins développées ont-elles subi une sorte d'enclavement relatif supplémentaire."
                            },
                            {
                                "example_id": "5df417ca-64c5-4fe9-8867-cc80409748e3",
                                "sense_id": "e704fd29-8855-3ed3-8715-7505a25b944b",
                                "text": "Je me suis fait plaisir, j'ai hésité à faire un fond perso quand je me suis dit que radialiser la texture habituelle pourrait donner encore mieux."
                            },
                            {
                                "example_id": "c2679404-f2a5-40c7-bbb7-d5fad6dc4201",
                                "sense_id": "e704fd29-8855-3ed3-8715-7505a25b944b",
                                "text": "J'ai dessiné des arcs concentriques autour d'un point central et tenté de radialiser autant de lignes droites que possible depuis ce même point de concentration."
                            },
                            {
                                "example_id": "a95b83f6-637c-4cc1-b86c-10a148ad2582",
                                "sense_id": "e704fd29-8855-3ed3-8715-7505a25b944b",
                                "text": "Comment fais-tu pour \"radialiser\" que la partie supérieure ???"
                            }
                        ]
                    },
                    {
                        "sense_id": "56fbc8ec-b890-3ebe-a28d-e2d8f374f58d",
                        "entry_id": "5dbdf74a-28a6-33c3-abfd-e82429ea389e",
                        "glosses": [
                            "Donner au pneu radial une place importante dans un marché du pneu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55f67486-6071-40ce-bcab-c377a6bba4ba",
                                "sense_id": "56fbc8ec-b890-3ebe-a28d-e2d8f374f58d",
                                "text": "Le marché indien se « radialise », mais très lentement."
                            },
                            {
                                "example_id": "df31ecd8-8dd5-4119-a77b-c1ae512475ea",
                                "sense_id": "56fbc8ec-b890-3ebe-a28d-e2d8f374f58d",
                                "text": "Mais son succès a pour condition sa capacité à développer assez vite ses ventes au moment où le marché se radialise."
                            }
                        ]
                    }
                ],
