                    {
                        "form_id": "bff51cba-80f8-4ea9-87a1-843e4cacce93",
                        "entry_id": "183d319a-ed9f-3fc8-aff5-dea7ede4f617",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "раздева́лках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "10da3943-b659-39f3-bcdf-3f12dc85edd8",
                        "entry_id": "183d319a-ed9f-3fc8-aff5-dea7ede4f617",
                        "glosses": [
                            "разг. помещение для раздевания или переодевания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab36fbe-4ccc-487d-8fb0-4e80cfe8aafa",
                                "sense_id": "10da3943-b659-39f3-bcdf-3f12dc85edd8",
                                "text": "Баня была с печкой, парилкой и раздевалкой."
                            },
                            {
                                "example_id": "1299bc39-8b6e-4940-8c67-3c34808a9de7",
                                "sense_id": "10da3943-b659-39f3-bcdf-3f12dc85edd8",
                                "text": "К услугам спортсменов душ, массажные комнаты, раздевалки."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9b02ba4-de12-31f2-82e7-ef1a345c8213",
                        "entry_id": "183d319a-ed9f-3fc8-aff5-dea7ede4f617",
                        "glosses": [
                            "разг. помещение для хранения верхней одежды; гардероб"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8f9fcfc-42fc-4cef-8a56-550bd7b04ed8",
                                "sense_id": "a9b02ba4-de12-31f2-82e7-ef1a345c8213",
                                "text": "Выбежал Николай Иванович на улицу, даже шапку в раздевалке из хранения не взял〈…〉"
                            },
                            {
                                "example_id": "a4590fa5-cf4b-4da1-a756-7e733eb92117",
                                "sense_id": "a9b02ba4-de12-31f2-82e7-ef1a345c8213",
                                "text": "Дом сиял мне навстречу огнями, раздевалка пахнула теплом, девушка-гардеробщица отложила книгу и помогла мне раздеться."
                            },
                            {
                                "example_id": "565a8511-e96d-44a1-a79d-83a773f15e23",
                                "sense_id": "a9b02ba4-de12-31f2-82e7-ef1a345c8213",
                                "text": "К концу девочка нашла место где плакать ― в раздевалке, прижавшись к чужим пальто."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cb20b3a-275f-494b-bd52-748fb45ecdff",
                        "source_entry_id": "183d319a-ed9f-3fc8-aff5-dea7ede4f617",
                        "target_lang_word": "changing room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "changing room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0a8b90b-7987-3bd9-90e1-499943d8e703",
                                        "entry_id": "bf8aef75-1713-3272-b928-408f87eb5e98",
                                        "glosses": [
                                            "A room, especially in a gym, sports center, school, swimming pool, etc, designed for people to change their clothes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8eb4f10-de56-47ae-aea9-fccddb689830",
                                                "sense_id": "f0a8b90b-7987-3bd9-90e1-499943d8e703",
                                                "text": "We changed into our swimsuits in the changing room next to the pool."
                                            },
                                            {
                                                "example_id": "549a1e2e-5975-4767-9a6e-421f6d06c64e",
                                                "sense_id": "f0a8b90b-7987-3bd9-90e1-499943d8e703",
                                                "text": "John Betjeman would later recall that the railway 'smelt of feet', and the carriages may have continued to smell of feet after they were taken out of service in the 1920s because some of them found use as changing rooms beside the playing fields of southern England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6c9a30-6db5-3e19-a93e-d2ce6be96b6b",
                                        "entry_id": "bf8aef75-1713-3272-b928-408f87eb5e98",
                                        "glosses": [
                                            "A room or enclosure, e.g. in a clothes shop, where people try on clothes they are interested in buying."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62aef2ce-ea65-472d-bc5f-e35e789dee2c",
                        "source_entry_id": "183d319a-ed9f-3fc8-aff5-dea7ede4f617",
                        "target_lang_word": "locker room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "locker room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e805344f-394e-371f-8b5b-9ad09c9391cf",
                                        "entry_id": "21d15fa9-5015-3f70-a847-855cf28897d2",
                                        "glosses": [
                                            "A room attached to an athletic, recreational, or workplace facility, filled with lockers for storage of clothing and equipment; clothes are generally changed there."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93089457-b266-46f9-9515-02d55dc9173a",
                                                "sense_id": "e805344f-394e-371f-8b5b-9ad09c9391cf",
                                                "text": "We changed into our swimsuits in the locker room next to the pool."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "locker room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90a172c6-0914-3780-bb17-c556c92a0778",
                                        "entry_id": "3be24441-73b9-30b5-9db5-62d03363f6a8",
                                        "glosses": [
                                            "Characteristic of conversations held in locker rooms; that is boastful, juvenile, or explicitly sexual."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "102b87c4-1945-480a-a863-06199ab9bdf3",
                                                "sense_id": "90a172c6-0914-3780-bb17-c556c92a0778",
                                                "text": "The others tired of Frank's habitual locker-room boasting about various women he had \"scored\" with"
                                            },
                                            {
                                                "example_id": "9baef5d5-ef8c-4e0c-bf31-6031cc11b37f",
                                                "sense_id": "90a172c6-0914-3780-bb17-c556c92a0778",
                                                "text": "“I think of how scary it was for me starting comedy in Chicago, and then how much scarier it would have been if I was a woman starting comedy there because it really was such a boys’ club,” he says. “It was very aggressive. It was very locker room."
                                            },
                                            {
                                                "example_id": "9cdc83c5-6876-4305-bd26-beac202ad3d5",
                                                "sense_id": "90a172c6-0914-3780-bb17-c556c92a0778",
                                                "text": "It’s in a very locker room, busting-my-stones sort of way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "locker room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb850ebf-2b33-30ef-99c7-0b577c6644f4",
                                        "entry_id": "6d83bbfb-943d-3be1-88b1-0f31d9b03c66",
                                        "glosses": [
                                            "inhalants"
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
