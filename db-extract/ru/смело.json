                ],
                "senses": [
                    {
                        "sense_id": "0aac00af-6eb1-36c6-b545-9915e9755a82",
                        "entry_id": "549bfc81-c8b4-354b-9462-686aec93a1a4",
                        "glosses": [
                            "наречие к смелый; не боясь чего-либо, преодолевая страх"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "66ae4549-5d4e-47a5-98d0-91e29776dbfc",
                                "sense_id": "0aac00af-6eb1-36c6-b545-9915e9755a82",
                                "text": "Надо глядеть несчастьям в глаза смело и прямо."
                            },
                            {
                                "example_id": "5f52df27-5ee4-4ef2-aabe-257335eb52b5",
                                "sense_id": "0aac00af-6eb1-36c6-b545-9915e9755a82",
                                "text": "Теперь Сережка уж не боялся дяди Василия и говорил с ним смело."
                            },
                            {
                                "example_id": "c4fa2bae-c27c-4f8b-b46a-e1227055378b",
                                "sense_id": "0aac00af-6eb1-36c6-b545-9915e9755a82",
                                "text": "Приходите смело за щепками, никто вас не тронет, успокаивал их Квашнин."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "840a6f4c-58e5-4054-a8ec-08f6586b1d97",
                        "source_entry_id": "549bfc81-c8b4-354b-9462-686aec93a1a4",
                        "source_sense_id": "0aac00af-6eb1-36c6-b545-9915e9755a82",
                        "target_lang_word": "courageously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courageously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86b7a85b-304e-3a1b-802a-055de3b13a58",
                                        "entry_id": "2198d31f-70b1-3994-8c72-ca37087f5fd4",
                                        "glosses": [
                                            "In a courageous manner; bravely; boldly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a868d7-e886-4fcc-a724-df8bbf44c90d",
                                                "sense_id": "86b7a85b-304e-3a1b-802a-055de3b13a58",
                                                "text": "Strike vp the Drum and martch corragiouſly,\nFortune her ſelfe dooth ſit vpon our Creſts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c42619a5-735b-4ba4-aaf5-9cfe191892e1",
                        "source_entry_id": "549bfc81-c8b4-354b-9462-686aec93a1a4",
                        "source_sense_id": "0aac00af-6eb1-36c6-b545-9915e9755a82",
                        "target_lang_word": "daringly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daringly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4bb9154-0c77-3869-bd1f-85c3bd1e16a5",
                                        "entry_id": "69c9b57e-85d7-3665-af90-fa2ab5f0e960",
                                        "glosses": [
                                            "In a daring manner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17be22bd-d819-4028-9391-9812727d4008",
                                                "sense_id": "c4bb9154-0c77-3869-bd1f-85c3bd1e16a5",
                                                "text": "“Here, waiter,” cried the Johnnie who had dejeunered daringly at 12, “take this bill to the manager and tell him it’s an imposition. Why, you’ve charged more for one poached egg on toast than for an entire portion of those eggs that you scramble.”"
                                            },
                                            {
                                                "example_id": "dc71c607-4840-4b5f-bf6d-c4133fdea58f",
                                                "sense_id": "c4bb9154-0c77-3869-bd1f-85c3bd1e16a5",
                                                "text": "The corridor stinks of sweat and cigarette smoke, and I daringly open the window a little. The freshest air floats in, smelling of sappy grasses, the delicate pollens of wild flowers, the resins of the pine forests; hinting at the chill blue scent of distant snows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19e847c6-5980-4b20-b575-a2c73ca576bc",
                        "source_entry_id": "549bfc81-c8b4-354b-9462-686aec93a1a4",
                        "source_sense_id": "0aac00af-6eb1-36c6-b545-9915e9755a82",
                        "target_lang_word": "dapper",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dapper",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "09cfc611-6832-3bf4-8ad0-4d3e05a908bb",
                                        "entry_id": "e81b1aa4-0444-38c6-a1d9-5cefce3a40b9",
                                        "glosses": [
                                            "geen angst voor gevaar tonend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4a6d1f2-4ad9-4841-9ead-a6d4c486222c",
                                                "sense_id": "09cfc611-6832-3bf4-8ad0-4d3e05a908bb",
                                                "text": "De dappere ridder redde de prinses."
                                            },
                                            {
                                                "example_id": "c2eced69-5803-4475-a45a-8d65467c161f",
                                                "sense_id": "09cfc611-6832-3bf4-8ad0-4d3e05a908bb",
                                                "text": "De dappere journalist durfde zijn mening te laten horen toen alle andere mensen hun mond hielden."
                                            },
                                            {
                                                "example_id": "29329b89-a2d3-4571-b360-0658d31577c6",
                                                "sense_id": "09cfc611-6832-3bf4-8ad0-4d3e05a908bb",
                                                "text": "Gedurende het dappere maar zinloze verzet brachten ze drie Duitse kruisers en meerdere torpedojagers tot zinken, vooral in het noorden leden de Duitsers zware verliezen."
                                            },
                                            {
                                                "example_id": "22d8f44e-5560-4616-8b44-1bfa323b5589",
                                                "sense_id": "09cfc611-6832-3bf4-8ad0-4d3e05a908bb",
                                                "text": "Ik had de dapperste moeder ter wereld, ik was hartstikke trots op haar en wie iets anders zei zou ik doodslaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
