                                    {
                                        "sense_id": "5ffd881e-220a-3c74-a6f5-90810d46d5e7",
                                        "entry_id": "a689e5ed-ee68-32a1-865c-69566c792e86",
                                        "glosses": [
                                            "Introduire à nouveau."
                                        ],
