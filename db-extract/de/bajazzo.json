                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef064b6-d35e-4e12-a9e6-03c8f1cca8a1",
                                "sense_id": "bcb46a03-6ef7-38cb-b38a-33f8cad7b47d",
                                "text": "„In der Oper Der Bajazzo […] von Ruggero Leoncavallo ist der Bajazzo ein betrogener Ehemann, der sich nichts von seinem Kummer anmerken lassen darf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f936ef6-d5ec-4bf7-b2dc-142071df0744",
                        "source_entry_id": "281bb53f-24ce-3e02-8f0e-462d92a68c17",
                        "source_sense_id": "bcb46a03-6ef7-38cb-b38a-33f8cad7b47d",
                        "source_sense_description": "komische Figur oder Possenreißer im italienischen Theater",
                        "target_lang_word": "buffoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buffoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8ddb551-10c6-325e-a9fc-384a17f5b54c",
                                        "entry_id": "963bb50a-cd81-3a08-a029-8864301dec84",
                                        "glosses": [
                                            "One who performs in a silly or ridiculous fashion; a clown or fool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e29ee296-d30c-4d26-8d19-a3adbb359ee5",
                                                "sense_id": "d8ddb551-10c6-325e-a9fc-384a17f5b54c",
                                                "text": "To divert the audience with buffoon postures and antic dances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "383daa11-42a9-3c21-8c12-ed148aeade46",
                                        "entry_id": "963bb50a-cd81-3a08-a029-8864301dec84",
                                        "glosses": [
                                            "An unintentionally ridiculous person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "buffoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50fd2e9f-465e-32e6-97b5-86dede9b233a",
                                        "entry_id": "f5422fb0-5d63-368b-8987-09678c6f06b0",
                                        "glosses": [
                                            "To behave like a buffoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e60394-ae21-47f4-8eb3-685c42bf19fd",
                                                "sense_id": "50fd2e9f-465e-32e6-97b5-86dede9b233a",
                                                "text": "His mimicry of gay speech and facial expressions is analogous to an Amos 'n' Andy routine, in which white men buffooned their way through incredibly demeaning impersonations of black men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f160049-4818-4f03-a8a2-ae11168965a9",
                        "source_entry_id": "281bb53f-24ce-3e02-8f0e-462d92a68c17",
                        "source_sense_id": "bcb46a03-6ef7-38cb-b38a-33f8cad7b47d",
                        "source_sense_description": "komische Figur oder Possenreißer im italienischen Theater",
                        "target_lang_word": "paillasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paillasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cb15948-6229-3f55-a603-492ca10fe320",
                                        "entry_id": "27370b6a-3bd0-3e67-a7a5-2181ef7d2b04",
                                        "glosses": [
                                            "Grande enveloppe de toile, ordinairement remplie de paille, dont on garnissait un lit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25253f2f-9c64-44e0-ac3c-0f9e3d6efb61",
                                                "sense_id": "6cb15948-6229-3f55-a603-492ca10fe320",
                                                "text": "C’est qu’il faut vous dire que les lits suisses sont composés purement et simplement d’une paillasse, et d’un sommier sur lequel on étend, en le décorant du titre de drap, une espèce de nappe, […]."
                                            },
                                            {
                                                "example_id": "6837215f-6338-4759-a9ff-951af6d4f7b6",
                                                "sense_id": "6cb15948-6229-3f55-a603-492ca10fe320",
                                                "text": "Quand son hôte eut fini, Misère l’enveloppa dans sa vieille couverture de futaine, et le força de se coucher sur sa paillasse […]"
                                            },
                                            {
                                                "example_id": "78f4a8bd-092a-4b4b-8af1-e8e25cbb0bb0",
                                                "sense_id": "6cb15948-6229-3f55-a603-492ca10fe320",
                                                "text": "Ce qu’elle appelait un lit était une paillasse posée sur quatre pieds réunis par deux planches et des traverses ; un sac tenait lieu d’oreiller."
                                            },
                                            {
                                                "example_id": "fcce8556-bc3e-4613-89a9-a9a9490604f9",
                                                "sense_id": "6cb15948-6229-3f55-a603-492ca10fe320",
                                                "text": "[…], tel était le coin de vie personnelle où se réfugiaient ces hommes qui, pour la sécurité du pain et de la paillasse, vendaient leur liberté, la dernière des libertés humaines : aller où l’on veut, choisir le fossé où l’on subira les affres de la faim, la morsure du froid…"
                                            },
                                            {
                                                "example_id": "2dc7a87f-3636-4b77-92a9-28356fb2b1c0",
                                                "sense_id": "6cb15948-6229-3f55-a603-492ca10fe320",
                                                "text": "Pas un détenu qui ne se retourne le soir sur sa paillasse à l’idée que l’aube peut être sinistre, qui ne s’endort sans souhaiter qu’il ne se passe rien."
                                            },
                                            {
                                                "example_id": "f2e77c7c-aed3-4e36-9069-a342ebd828b7",
                                                "sense_id": "6cb15948-6229-3f55-a603-492ca10fe320",
                                                "text": "Deux paillasses de fougère occupent un chalit adroitement charpenté […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c038b6ec-0903-3e91-b9d5-69533c44e34e",
                                        "entry_id": "27370b6a-3bd0-3e67-a7a5-2181ef7d2b04",
                                        "glosses": [
                                            "Ventre."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70ec685c-78c0-4bc9-9e97-7886f5530f13",
                                                "sense_id": "c038b6ec-0903-3e91-b9d5-69533c44e34e",
                                                "text": "J’y ai crevé la paillasse à Montpernasse"
                                            },
                                            {
                                                "example_id": "ecbfa68e-9961-4612-b3ee-3e9c921006fd",
                                                "sense_id": "c038b6ec-0903-3e91-b9d5-69533c44e34e",
                                                "text": "Salaud ! Quand j’pense que c’est pour toi que je m’suis fait trouer la paillasse à Tahure et dans la Somme !"
                                            },
                                            {
                                                "example_id": "db2cc8ad-2bc5-4ab2-9559-93a4c96166fb",
                                                "sense_id": "c038b6ec-0903-3e91-b9d5-69533c44e34e",
                                                "text": "Ses premières années comme infirmier de réanimation lui secouent la paillasse : il pénètre un outremonde, un espace souterrain ou parallèle, en lisière de l'autre et troublé par leur affleurement limitrophe et continuel, ce monde perfusé de mille sommeils où lui ne dort jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c8b9c44-871f-3bfd-9a76-df7ea50c30bb",
                                        "entry_id": "27370b6a-3bd0-3e67-a7a5-2181ef7d2b04",
                                        "glosses": [
                                            "Corbeille en paille, utilisée par les boulangers (voir paneton)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69573b8-fdb7-4234-ba0d-bb5686cae217",
                                                "sense_id": "3c8b9c44-871f-3bfd-9a76-df7ea50c30bb",
                                                "text": "Il alla avec des seaux quérir de l’eau à la mare pendant qu’elle versait sur l’amas pâteux des pommes de terre une grande paillasse de son et de farine ; elle se mit ensuite à démêler le tout avec l’eau qu’il apporta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f3dcccc-9afa-3492-b862-b04f52abfc7e",
                                        "entry_id": "27370b6a-3bd0-3e67-a7a5-2181ef7d2b04",
                                        "glosses": [
                                            "Tapis de joncs servant à faire sécher le fromage. → voir paillisse"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30650aac-20fc-3d11-9d36-d5323b04f12c",
                                        "entry_id": "27370b6a-3bd0-3e67-a7a5-2181ef7d2b04",
                                        "glosses": [
                                            "Plan de travail dans un laboratoire de biologie, de chimie, etc., dans un atelier ou une cuisine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50b523bd-6502-40bf-9cfa-f4c9abd6bb9a",
                                                "sense_id": "30650aac-20fc-3d11-9d36-d5323b04f12c",
                                                "text": "Le long des murs courent des paillasses où sont posés samovars, cafetières, bouilloires, plaques chauffantes, mini-fours, presse-fruits et bien d’autres ustensiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f37929f-93b6-3635-8d99-64b6dbc2e9d9",
                                        "entry_id": "27370b6a-3bd0-3e67-a7a5-2181ef7d2b04",
                                        "glosses": [
                                            "Partie de l’évier qui sert à égoutter la vaisselle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd8c118d-5bed-48db-951b-63f94872a76d",
                                                "sense_id": "4f37929f-93b6-3635-8d99-64b6dbc2e9d9",
                                                "text": "La petite vaisselle, deux assiettes, deux couverts, deux verres et une poêle, moins que Blanche-Neige dans la maison des nains et ça séchera tout seul sur la paillasse jusqu’au prochain repas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65e64d74-480c-36db-8319-bd4a3b8d8429",
                                        "entry_id": "27370b6a-3bd0-3e67-a7a5-2181ef7d2b04",
                                        "glosses": [
                                            "Dalle inclinée qui supporte les marches et les contremarches d'un escalier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c237cadc-5e4b-35af-ace5-7d8ae2d6071e",
                                        "entry_id": "27370b6a-3bd0-3e67-a7a5-2181ef7d2b04",
                                        "glosses": [
                                            "Partie maçonnée d’une forge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d019512-ac11-4751-a962-cc02236f9aba",
                                                "sense_id": "c237cadc-5e4b-35af-ace5-7d8ae2d6071e",
                                                "text": "Il place d'abord le creuset pour l'amalgame, au milieu de la paillasse de cette même forge et y remue bien l’or et le mercure au moyen d’une tige de fer, …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paillasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e29e586-2dc9-34eb-8564-541b5b43a851",
                                        "entry_id": "cb656320-d6d1-3d85-9bd3-1dc158b2e5a1",
                                        "glosses": [
                                            "Personnage bouffon de la comédie italienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feeab351-c1ca-4c35-a3cd-b37895828d70",
                                                "sense_id": "4e29e586-2dc9-34eb-8564-541b5b43a851",
                                                "text": "Sur l'estrade goguenardait un paillasse. Le clavecin de sa frimousse exprimait la gamme des grimaces; l'histrionne bouche s'étoilait en cul de poule ou bien se cornait jusqu'aux oreilles, de telles manières que les Simples, maquillés par le graduel arc-en-ciel du rire, virevoltaient dans l'ouragan des singeries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43cc83f6-9362-3653-8c14-c95476e8ac4e",
                                        "entry_id": "cb656320-d6d1-3d85-9bd3-1dc158b2e5a1",
                                        "glosses": [
                                            "Sorte de bateleur, de saltimbanque, d’acteur bouffon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06e6d7b-3237-480f-890b-88b0537e32f7",
                                                "sense_id": "43cc83f6-9362-3653-8c14-c95476e8ac4e",
                                                "text": "[…] ; ses traits se dessinèrent plus distinctement, et il reconnut à n’en pouvoir douter, la figure blême et allongée de son ami intime Jean-Gaspard Debureau, le grand paillasse des Funambules, qui le regardait avec une expression indéfinissable de malice et de bonhomie."
                                            },
                                            {
                                                "example_id": "9a0352e9-ebae-4a5e-bcc2-cdb3ad34e98c",
                                                "sense_id": "43cc83f6-9362-3653-8c14-c95476e8ac4e",
                                                "text": "Il avait été pitre chez Bobèche et paillasse chez Bobino. Il avait joué le vaudeville à Saint-Mihiel."
                                            },
                                            {
                                                "example_id": "c6085b86-f562-4752-bee1-c8400e1709ec",
                                                "sense_id": "43cc83f6-9362-3653-8c14-c95476e8ac4e",
                                                "text": "— Mesdames et messieurs, je vends du poil à gratter !… Vous êtes chez la femme d’un ministre, vous mouchez la chandelle. Alors vous jetez ma poudre…Que veux-tu, ma fille, mes bêtises, c'est la faute de mon père, qui m'avait dressé pour être paillasse, pour l'assister dans ses tours de gobelet, manger de l'étoupe et cracher du feu... — (Eugène Sue, Les Mystères de Paris, Quarto Gallimard, p. 904.)/>Et le paillasse de dévider son boniment en allant, de temps à autre, à son tambour tanné pour en tirer un rra ou un fla, dans un jonglé de baguettes."
                                            },
                                            {
                                                "example_id": "63ce3b8c-50e8-4599-ae1c-4e0f60536db0",
                                                "sense_id": "43cc83f6-9362-3653-8c14-c95476e8ac4e",
                                                "text": "Si j'étais pas faignante je me mettrais à faire les boîtes de nuit, sérieusement, la noce sans m'amuser, j'y parviendrais : tendre ma joue à embrasser, comme un paillasse à la parade tend sa joue à claquer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6a667b-39ce-322c-9823-ecb7b4a4f5a2",
                                        "entry_id": "cb656320-d6d1-3d85-9bd3-1dc158b2e5a1",
                                        "glosses": [
                                            "Homme sans consistance, bouffon."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e915b0f-8ee3-4c51-a009-f16407c5120b",
                                                "sense_id": "1c6a667b-39ce-322c-9823-ecb7b4a4f5a2",
                                                "text": "C’est un vrai paillasse, ton copain !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paillasse",
                                "target_lang_code": "fr",
                                "target_senses": [
