                                    {
                                        "sense_id": "cf81aaf5-7dd3-3e6d-b2d7-fc90385b3e40",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
                                        "glosses": [
                                            "Excess of material, useless by-products, or damaged, unsaleable products; garbage; rubbish."
