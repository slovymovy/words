                "senses": [
                    {
                        "sense_id": "0edf115e-54d5-3b77-8fed-1eb685adbdb8",
                        "entry_id": "60c43d63-4fd0-3de2-a3e4-af4bf18c568d",
                        "glosses": [
                            "Person, die aktiv daran arbeitet, eine Gemeinschaft/Glaubensgemeinschaft zu trennen, Sektierertum unterstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d1e91ee-b61a-4a87-ae30-54e29a972d61",
                                "sense_id": "0edf115e-54d5-3b77-8fed-1eb685adbdb8",
                                "text": "„Daß der Staat als Oberhaupt der orthodoxen Kirche diesen Strömungen und den Sektierern nicht gleichgiltig zusieht, läßt sich denken.“ (1891)"
                            },
                            {
                                "example_id": "d1f1ad39-9cf9-4541-bcb8-29feea3ae92c",
                                "sense_id": "0edf115e-54d5-3b77-8fed-1eb685adbdb8",
                                "text": "„B. wird im Juli 1957 als ‚Sektierer‘ aller Partei- und Staatsämter enthoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "48d11c14-d522-3b36-a852-921c1adbc1af",
                        "entry_id": "60c43d63-4fd0-3de2-a3e4-af4bf18c568d",
                        "glosses": [
                            "Mitglied einer Sekte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1dde020-a7b6-4942-bcb0-fac16ffc4051",
                                "sense_id": "48d11c14-d522-3b36-a852-921c1adbc1af",
                                "text": "„Die Sektierer wanderten deshalb westwärts und gründeten in Illinois die Stadt Nauovo.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
