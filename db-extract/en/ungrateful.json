                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f916e6d0-0766-4fc0-8e13-f6c9cdb0f34c",
                                "sense_id": "95d7c0f1-534d-3777-bd37-9309a0222098",
                                "text": "Near-synonyms: unappreciative, unthankful"
                            },
                            {
                                "example_id": "523a7b4f-85ef-4f46-9c14-f97a69bddeda",
                                "sense_id": "95d7c0f1-534d-3777-bd37-9309a0222098",
                                "text": "“It seems to delight you to think that you are to leave Paris, and that we shall not see each other for months, perhaps. Tarzan, you are a most ungrateful beast!” and D’Arnot laughed."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c9e1bbd-4fca-3c79-a809-62b625907668",
                        "entry_id": "35fb2dc7-8dd4-3e87-8d15-ab6ba4572865",
                        "glosses": [
                            "Disagreeable, repellent, unpleasant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "123684f8-4329-4d79-b694-0cc2bf72093f",
                                "sense_id": "6c9e1bbd-4fca-3c79-a809-62b625907668",
                                "text": "If any care for what is here\n⁠Survive in spirits render’d free,\n⁠Then are these songs I sing of thee\nNot all ungrateful to thine ear."
                            }
                        ]
