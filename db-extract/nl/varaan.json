                        "sense_id": "1b311132-251f-33c2-96bb-9f5b1d5f8296",
                        "entry_id": "5f37c3c9-e438-3336-8ae7-c75e7828b5d9",
                        "glosses": [
                            "Varanidae, is van de familie van de hagedissen, hij is de grootste levende hagedis"
                        ],
