                ],
                "senses": [
                    {
                        "sense_id": "7ba74587-6fc1-3350-be38-c4c056e123fa",
                        "entry_id": "ae176bc1-70ec-357a-9c28-f05b74ead21a",
                        "glosses": [
                            "Eigenschaft, nur eine Deutung zuzulassen; Eindeutigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f5f7a8e-b4b6-49ce-8e39-236d2fb812eb",
                                "sense_id": "7ba74587-6fc1-3350-be38-c4c056e123fa",
                                "text": "„Der Wille zum Mehrdeutigen, allergisch gegen die geringsten Spuren von Monovalenz, dürstet geradezu nach antithetischen Fügungen, die neuen Zuschreibungen den Weg bereiten und Träume von fernen Oasen aufrufen.“"
                            },
                            {
                                "example_id": "99c85dca-3b1f-4f41-8e3b-c46ca38e81a1",
                                "sense_id": "7ba74587-6fc1-3350-be38-c4c056e123fa",
                                "text": "„Es ist dies ein sehr guter Weg, die Monovalenz (schwarz oder weiß) der Wahrnehmung im Konflikt wieder aufzuweichen.“"
                            },
                            {
                                "example_id": "513fd69d-346f-4d0d-a5ea-5f49cd6c5b17",
                                "sense_id": "7ba74587-6fc1-3350-be38-c4c056e123fa",
                                "text": "„Die Ambivalenz zweier Sinnpositionen, zweier Wertakzente wird der Monovalenz der einen Wahrheit gegenübergestellt.“"
                            },
                            {
                                "example_id": "58c9ff7f-a9f3-43e2-9ace-cba2d394734f",
                                "sense_id": "7ba74587-6fc1-3350-be38-c4c056e123fa",
                                "text": "„Als subtile Form der Propaganda und Hetze gegen den Anderen hat sie zu allen Zeiten dazu geführt, die Ambivalenz der Gefühle in eine Monovalenz des Hasses ausschlagen zu lassen, mit all ihren fürchterlichen Konsequenzen.“"
                            },
                            {
                                "example_id": "bb5c1089-9e0f-4cbf-ba12-13b037afa9d4",
                                "sense_id": "7ba74587-6fc1-3350-be38-c4c056e123fa",
                                "text": "„Je originärer ihre Theorien werden, desto mehr entfernen sie sich von der einfachen Strukturiertheit und der Monovalenz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e76802cd-e70d-3aa4-95fa-e8258478174e",
                        "entry_id": "ae176bc1-70ec-357a-9c28-f05b74ead21a",
                        "glosses": [
                            "Eigenschaft, nur mit einem anderen Atom eine chemische Bindung einzugehen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cf19eff6-ec3c-4d3d-b5c0-c11d3ac753cd",
                                "sense_id": "e76802cd-e70d-3aa4-95fa-e8258478174e",
                                "text": "„Die Monovalenz des Lithium-Ions begünstigt dabei dessen Diffusionseigenschaften und ermöglicht hohe spezifische Leistungsdichten.“"
                            },
                            {
                                "example_id": "5836a538-50c5-43ab-a877-7887dbb095dd",
                                "sense_id": "e76802cd-e70d-3aa4-95fa-e8258478174e",
                                "text": "„Dass dem Sauerstoff unter Umständen auch die Monovalenz zukommen kann, ist von mehreren Forschern ausgesprochen worden.“"
                            },
                            {
                                "example_id": "4d8c118d-8b56-4683-9959-29a4bc546dcb",
                                "sense_id": "e76802cd-e70d-3aa4-95fa-e8258478174e",
                                "text": "„In gleicher Weise bleibt die Monovalenz des Aethyls im Aethylchlorid erhalten, nachdem Chlor in dasselbe für ein Atom Wasserstoff eingetreten ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5738a0f-09e7-4907-8535-a1de8cfa7dfe",
                        "source_entry_id": "ae176bc1-70ec-357a-9c28-f05b74ead21a",
                        "source_sense_id": "7ba74587-6fc1-3350-be38-c4c056e123fa",
