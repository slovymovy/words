                                        "sense_id": "72693ffd-f30e-34ca-9f83-2c9036d25c03",
                                        "entry_id": "606fd5aa-5c38-3f38-ba87-d00f5671b7ac",
                                        "glosses": [
                                            "ein Bundesland in der Bundesrepublik Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68610e25-9eae-43d9-aec3-fb9a4929ee4c",
                                                "sense_id": "72693ffd-f30e-34ca-9f83-2c9036d25c03",
                                                "text": "„Wer sich den Traum vom Motorfliegen erfüllen will, dem bietet sich in Brandenburg die Möglichkeit, den Privatpilotenschein, kurz PPL genannt, zu erwerben.“"
                                            },
                                            {
                                                "example_id": "71a9c0c2-896e-457c-8adc-0ee822c0d505",
                                                "sense_id": "72693ffd-f30e-34ca-9f83-2c9036d25c03",
                                                "text": "Brandenburg liegt zwischen Elbe und Oder."
                                            },
                                            {
                                                "example_id": "44629b86-4565-4712-9ab4-ba163a0fd185",
                                                "sense_id": "72693ffd-f30e-34ca-9f83-2c9036d25c03",
                                                "text": "Das mittelalterliche Brandenburg war bedeutend."
                                            },
                                            {
                                                "example_id": "686a8287-49c8-45e6-af26-7a0e19da19ce",
                                                "sense_id": "72693ffd-f30e-34ca-9f83-2c9036d25c03",
                                                "text": "Ich bin in Brandenburg geboren."
                                            },
                                            {
                                                "example_id": "93991316-0a08-4f0c-896c-16daa913fa96",
                                                "sense_id": "72693ffd-f30e-34ca-9f83-2c9036d25c03",
                                                "text": "Ich habe in Brandenburg meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "3797d233-0467-490b-832f-eb2917cde6b5",
                                                "sense_id": "72693ffd-f30e-34ca-9f83-2c9036d25c03",
                                                "text": "Nach Brandenburg führen viele Wege."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "351804d8-3070-318a-a9c6-25e3a0ac06c6",
                                        "entry_id": "606fd5aa-5c38-3f38-ba87-d00f5671b7ac",
                                        "glosses": [
                                            "kreisfreie Stadt in ^([1]); offiziell Brandenburg an der Havel, Brandenburg^([1]), Deutschland"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4663a3ae-4686-4370-a708-8e14e55ca258",
                                                "sense_id": "351804d8-3070-318a-a9c6-25e3a0ac06c6",
                                                "text": "Brandenburg liegt an der Havel."
                                            },
                                            {
                                                "example_id": "48e2d8f0-b378-403a-95ee-77a44c998f93",
                                                "sense_id": "351804d8-3070-318a-a9c6-25e3a0ac06c6",
                                                "text": "„Und nun stockte das Gespräch wieder, und in immer rascherem Fluge ging es erst an Brandenburg und seiner Sankt-Godehards-Kirche, dann an Magdeburg und seinem Dome vorüber.“"
                                            },
