                    {
                        "sense_id": "1dcf1674-f608-327a-8d68-013d6df47b56",
                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                        "glosses": [
                            "The state of things being similar or identical."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1f94a1f6-2712-379a-bf70-307849d332ca",
                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                        "glosses": [
                            "A point of resemblance; a similarity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0bc8b66f-3f7b-3e05-b4c0-f14a5a19e707",
                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                        "glosses": [
                            "The state of being conforming, of complying with a set of rules, with a norm or standard."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a94040b5-8c91-3bd3-bfff-d4961efaf4ed",
                        "entry_id": "b9049223-5fd5-354f-af01-0af7a73ff969",
                        "glosses": [
                            "The ideology of adhering to one standard or social uniformity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "256f9ee4-e216-4321-92a3-f98904c2ac63",
                                "sense_id": "a94040b5-8c91-3bd3-bfff-d4961efaf4ed",
                                "text": "How far should one accept the rules of the society in which one lives? To put it another way: at what point does conformity become corruption? Only by answering such questions does the conscience truly define itself."
                            }
                        ]
                    }
                ],
                "translations": [
