                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df0ff667-203c-4e29-a79f-21ad4e7660c1",
                                "sense_id": "ef5e1989-1871-33f1-b662-f12ee67b4de2",
                                "text": "Na murach rozlepiono odezwę prezydenta."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "00388014-93e8-32ef-a834-1a216b7fc507",
                        "entry_id": "57981f98-449c-3a20-9d71-2ed79adf59b3",
