                            {
                                "example_id": "e8e16c00-3ffb-422c-9bc7-871b607fef5e",
                                "sense_id": "dc9dae21-1cb8-39f2-a720-39e8ad742d2d",
                                "text": "„Hat der Experimentator (\"ab 15 Jahren\") alle 41 Versuche durch, kann er erklären, wie der Gecko das macht mit der Scheibe.“"
                            },
                            {
                                "example_id": "0347e2a5-f051-4116-8b8b-b8a241381297",
                                "sense_id": "dc9dae21-1cb8-39f2-a720-39e8ad742d2d",
                                "text": "„Wir sehen hier wieder Wieland als den Experimentator, er versucht sich an etwas Neuem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
