                        "entry_id": "14acd485-1009-372c-a5fa-60f1b2f041d7",
                        "glosses": [
                            "godzina 8 rano lub wieczorem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "109bac67-0e71-4491-999d-9b2a7b65faf5",
                                "sense_id": "19c0d644-4a0b-3409-a1db-c911fe9a5056",
                                "text": "— Nie idę dalej — oświadczyłem kategorycznie — teraz jest godzina piąta, a o ósmej muszę już być na pokładzie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1469754-026b-436c-a6c6-d30d0448cc78",
                        "source_entry_id": "14acd485-1009-372c-a5fa-60f1b2f041d7",
                        "source_sense_id": "19c0d644-4a0b-3409-a1db-c911fe9a5056",
                        "target_lang_word": "eight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aed11f6-4031-378c-83c0-543148ff6442",
                                        "entry_id": "81c879bc-8f17-339c-8aef-10322d37e80e",
                                        "glosses": [
                                            "A numerical value equal to 8; the number occurring after seven and before nine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ea78b6-1615-4cf9-820a-e9ad6945ea22",
                                                "sense_id": "3aed11f6-4031-378c-83c0-543148ff6442",
                                                "text": "Jon & Kate Plus 8 is a show based on two facts: 1) Jon and Kate Gosselin have eight children, and 2) the word ‘Kate’ rhymes with the word ‘eight’. One suspects that if Kate were ever to have another child, a shady network executive would urge her to put it in a binbag with a brick and drop it down a well. But this is just a horrifying tangent."
                                            },
                                            {
                                                "example_id": "7df39202-18ac-4a9b-ba4d-05c3f089471c",
                                                "sense_id": "3aed11f6-4031-378c-83c0-543148ff6442",
                                                "text": "The statement did not specify the location of that trip, but provided further details of her romantic life, stating that Saroukos and her husband spent eight days together before she returned to Australia on Dec. 21."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f67c7850-b684-3233-adab-8fc34290b191",
                                        "entry_id": "81c879bc-8f17-339c-8aef-10322d37e80e",
                                        "glosses": [
                                            "Describing a group or set with eight elements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba62778-dad8-4f7e-90c8-1e673a7924fe",
                                                "sense_id": "f67c7850-b684-3233-adab-8fc34290b191",
                                                "text": "He works eight hours a day."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efa17d58-91ff-3dc6-9bbf-73eeb689a7e7",
                                        "entry_id": "facf2dd7-0e4f-3064-9b73-dce382deaf1f",
                                        "glosses": [
                                            "The digit/figure 8."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87993595-c172-3f9f-82b7-3486d9ab05eb",
                                        "entry_id": "facf2dd7-0e4f-3064-9b73-dce382deaf1f",
                                        "glosses": [
                                            "Any of the four cards in a normal deck with the value eight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6850a946-52a4-3176-ae5d-460aee37c1f9",
                                        "entry_id": "facf2dd7-0e4f-3064-9b73-dce382deaf1f",
                                        "glosses": [
                                            "A light, narrow rowing boat, especially one used in competitive rowing, steered by a cox, in which eight rowers each have two oars."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "baffd88f-77c0-3bc0-a742-61ed9f1b68ba",
                                        "entry_id": "facf2dd7-0e4f-3064-9b73-dce382deaf1f",
                                        "glosses": [
                                            "A race in which such craft participate."
                                        ],
                                        "tags": [
                                            "especially",
                                            "plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "102521ad-588f-342a-b91a-ad54f6e5240a",
                                        "entry_id": "facf2dd7-0e4f-3064-9b73-dce382deaf1f",
                                        "glosses": [
                                            "The eight people who crew a rowing-boat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4901929-bcab-3326-952e-2b6160ca7afe",
                                        "entry_id": "facf2dd7-0e4f-3064-9b73-dce382deaf1f",
                                        "glosses": [
                                            "Eight o'clock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42135fd2-9285-426d-a46e-05b8e28932b2",
                                                "sense_id": "a4901929-bcab-3326-952e-2b6160ca7afe",
                                                "text": "About eight on the Saturday morning, she purchases a large sheath-knife in the Palais Royal [...]"
                                            },
                                            {
                                                "example_id": "c58cc296-32b4-46ba-a365-0e77d8c86f75",
                                                "sense_id": "a4901929-bcab-3326-952e-2b6160ca7afe",
                                                "text": "Sharp at eight we were waiting on the wharf where the Messagerie boats lie, and wondering what the deuce was going to happen."
                                            },
                                            {
                                                "example_id": "210d59ba-6af8-4bfb-992a-784d332d11d2",
                                                "sense_id": "a4901929-bcab-3326-952e-2b6160ca7afe",
                                                "text": "Miranda showed him in at a quarter to eight, accompanied by a pretty young woman she introduced as Erin d'Angelo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
