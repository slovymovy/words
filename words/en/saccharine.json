    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3007811d-dbb2-30f2-a04d-3b9c94b6266a",
                    "sense_definition": "Excessively sweet in action or disposition, especially if romantic or sentimental to the point of ridiculousness; sickly sweet, syrupy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sentimental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was ruined by a <w>saccharine</w> ending that felt completely unearned and unrealistic.",
                            "target_lang_translations": {
                                "ru": "Фильм был испорчен <w>слащавым</w> финалом, который казался совершенно незаслуженным и нереалистичным."
                            }
                        },
                        {
                            "text": "I cannot stand her <w>saccharine</w> smile, which always feels forced and insincere.",
                            "target_lang_translations": {
                                "ru": "Терпеть не могу её <w>приторную</w> улыбку, которая всегда кажется натянутой и неискренней."
                            }
                        }
                    ],
                    "synonyms": [
                        "cloying",
                        "sickly sweet",
                        "twee",
                        "precious"
                    ],
                    "common_phrases": [
                        "saccharine smile",
                        "saccharine sweetness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно сладкий в поведении или характере, особенно романтичный или сентиментальный до нелепости; приторно-сладкий, слащавый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приторный",
                                "target_lang_sense_clarification": "о поведении, улыбке, тоне"
                            },
                            {
                                "target_lang_word": "слащавый",
                                "target_lang_sense_clarification": "сентиментальный до нелепости"
                            },
                            {
                                "target_lang_word": "приторно-сладкий",
                                "target_lang_sense_clarification": "о поведении или атмосфере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2eba0a04-b9ac-31b6-85d8-a4c905fdb9cf",
                    "sense_definition": "Containing a large or excessive amount of sugar.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sugary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dessert had a <w>saccharine</w> taste that overpowered the delicate flavor of the fruit.",
                            "target_lang_translations": {
