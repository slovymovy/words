                ],
                "senses": [
                    {
                        "sense_id": "473635b9-079e-3a62-b979-ee6ce16d286f",
                        "entry_id": "ca289c83-3c82-3118-b48f-0aa82eb5a76a",
                        "glosses": [
                            "Déposer son pollen sur ses propres fleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c7a26b2-9f8b-430f-9258-545fcead329d",
                                "sense_id": "473635b9-079e-3a62-b979-ee6ce16d286f",
                                "text": "Une très faible minorité de clones peuvent s'auto-polliniser."
                            },
                            {
                                "example_id": "36148eed-8275-4bb0-a68d-6eb9cc533577",
                                "sense_id": "473635b9-079e-3a62-b979-ee6ce16d286f",
                                "text": "Ils ont l'avantage de s'auto-polliniser, ce qui évite le problème de la fécondation par le pollen."
                            },
                            {
                                "example_id": "0c9155c9-bbeb-4af4-8356-e2da8d76cd18",
                                "sense_id": "473635b9-079e-3a62-b979-ee6ce16d286f",
                                "text": "Dans quelques cas elles peuvent s'auto-polliniser, ou être fécondées par des oiseaux (ex. Elleanthus par des Colibris)."
                            }
                        ]
                    }
