                "senses": [
                    {
                        "sense_id": "cf578935-5f41-33d5-b63a-e04d1293fdaf",
                        "entry_id": "7723961c-0af9-3861-a4b1-3a42921bc82b",
                        "glosses": [
                            "Variante orthographique d’Ilo-Dionysien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a4dcca1-d210-4c60-8aa9-83796a98da6d",
                                "sense_id": "cf578935-5f41-33d5-b63a-e04d1293fdaf",
                                "text": "Vous serez accueillis au chalet Lou Bric Bouchet, la résidence montagnarde de tous les Îlodionysiens…"
                            },
                            {
                                "example_id": "3ee0e58d-845b-47e0-bd33-6c860778a929",
                                "sense_id": "cf578935-5f41-33d5-b63a-e04d1293fdaf",
                                "text": "L’Île-SaintDenis, à la fois île et ville, est une rareté géographique. De ce territoire très particulier, urbain et villageois, insulaire et ouvert sur ses environs, les Îlodionysiens tirent leur force et leur faiblesse."
                            }
                        ]
                    }
