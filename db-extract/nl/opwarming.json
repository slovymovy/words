        "nl-extract.jsonl": [
            {
                "entry_id": "6a57a369-511b-390d-a293-8a91c8c441e9",
                "word": "opwarming",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1864d571-bb4e-3726-b8bc-cf4790ea3eb9",
                        "entry_id": "6a57a369-511b-390d-a293-8a91c8c441e9",
                        "glosses": [
                            "het doen stijgen van de temperatuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa2a13ca-39f4-4832-8e25-15677ee91b26",
                                "sense_id": "1864d571-bb4e-3726-b8bc-cf4790ea3eb9",
                                "text": "Bij opwarming ontleedt deze chemische verbinding."
                            }
                        ]
                    },
                    {
                        "sense_id": "48284e62-6e75-395d-be1e-5a2a4dc35b9d",
                        "entry_id": "6a57a369-511b-390d-a293-8a91c8c441e9",
                        "glosses": [
                            "het proces van temperatuursverhoging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4112064b-46f0-4e76-bd4c-501ca59af84b",
                                "sense_id": "48284e62-6e75-395d-be1e-5a2a4dc35b9d",
                                "text": "De opwarming gedurende de dag was voldoende om de sneeuw te doen smelten."
                            },
                            {
                                "example_id": "29e73b84-ee78-419a-97cb-1b656d8eb828",
                                "sense_id": "48284e62-6e75-395d-be1e-5a2a4dc35b9d",
                                "text": "De Noorse minister van Klimaat en Natuur, Ola Elvestuen, zegt dat ook tegen het instituut. De opwarming in het noorden gaat erg snel. We moeten onze uitstoot en de opwarming van de aarde snel verminderen om te voorkomen dat het zee-ijs in de zomers helemaal verdwijnt."
                            },
                            {
                                "example_id": "9c0d2856-b061-4e0a-bbf9-26d452378d19",
                                "sense_id": "48284e62-6e75-395d-be1e-5a2a4dc35b9d",
                                "text": "Klimaatverandering veroorzaakt een algehele temperatuurstijging over de hele wereld. Door de opwarming van het klimaat wordt de lucht warmer. Warme lucht kan meer waterdamp bevatten, zo'n 7 procent meer per graad. Als er meer waterdamp is in de atmosfeer, kunnen er meer extreme weersituaties ontstaan, zoals hagelbuien, wateroverlast door extreme regenval en meer onweer."
                            },
                            {
                                "example_id": "9617d9af-82d2-4078-863a-0ce7ad8a9b9e",
                                "sense_id": "48284e62-6e75-395d-be1e-5a2a4dc35b9d",
                                "text": "De opwarming van de oceanen naar recordtemperaturen heeft het afgelopen jaar tot een dramatische verbleking van de koraalriffen in de oceanen geleid. Wereldwijd lijdt 84 procent van de riffen onder hittestress, meer dan ooit eerder is vastgesteld, blijkt uit onderzoek van landen en gespecialiseerde organisaties in het International Coral Reef Initiative."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e42bbdac-d226-45f3-9a55-ae26f85e3bad",
                        "source_entry_id": "6a57a369-511b-390d-a293-8a91c8c441e9",
                        "source_sense_id": "1864d571-bb4e-3726-b8bc-cf4790ea3eb9",
                        "source_sense_description": "het doen stijgen van de temperatuur",
                        "target_lang_word": "Erhitzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erhitzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "002e0ba7-8981-390a-af7b-b5f7cd01d465",
                                        "entry_id": "58710915-a741-3dd0-8a72-2a820c1c5cd3",
                                        "glosses": [
                                            "der Vorgang, bei dem die Temperatur von etwas gesteigert (erhöht) wird, meist über 80 °C"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b916ec-623e-4c4b-bc6a-026f57e4a0a1",
                                                "sense_id": "002e0ba7-8981-390a-af7b-b5f7cd01d465",
                                                "text": "Bei Erhitzung dehnen sich die Materialien unterschiedlich aus."
                                            },
                                            {
                                                "example_id": "46738451-4c56-43c9-b333-bf40680fdf33",
                                                "sense_id": "002e0ba7-8981-390a-af7b-b5f7cd01d465",
                                                "text": "Ziemlich keimfrei bekommen wir daher ein Lebensmittel wie Milch durch Pasteurisierung, eine Erhitzung auf 80 bis 100 Grad für wenige Sekunden."
                                            },
                                            {
                                                "example_id": "78f06c51-66b2-4fbd-b3d9-7d6e3e8b538b",
                                                "sense_id": "002e0ba7-8981-390a-af7b-b5f7cd01d465",
                                                "text": "Bier aus Gräfenberg muss innerhalb weniger Wochen getrunken werden, weshalb die Meisterinnen aus dem Dorf auf Erhitzung oder Sterilisierung verzichten."
                                            },
                                            {
                                                "example_id": "69658e61-9506-414b-9fe7-ef24a87adf46",
                                                "sense_id": "002e0ba7-8981-390a-af7b-b5f7cd01d465",
                                                "text": "Das deutsche Bundesamt für Risikobewertung warnte im Januar vor schädlichem Formaldehyd, das bei der Erhitzung der Tabakflüssigkeit freigesetzt werden könne."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e07ebd9-70f0-48e2-ac68-f9a011f7f171",
                        "source_entry_id": "6a57a369-511b-390d-a293-8a91c8c441e9",
                        "source_sense_id": "48284e62-6e75-395d-be1e-5a2a4dc35b9d",
                        "source_sense_description": "het proces van temperatuursverhoging",
                        "target_lang_word": "Erwärmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erwärmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                        "entry_id": "027c3ca2-24f5-3a95-bdca-469f33c712a5",
                                        "glosses": [
                                            "kleine Erhöhung der Temperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db518bad-72ea-4758-97b5-4170cdaf584e",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "Bei der Reaktion ist mit einer Erwärmung des Substrats zu rechnen."
                                            },
                                            {
                                                "example_id": "8d816dfc-b492-4690-a0d5-8deb8f1c0215",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "Die Erwärmung der Atmosphäre scheint unabwendbar."
                                            },
                                            {
                                                "example_id": "1d2fa22c-ef1e-4ee4-8b45-287425d9b213",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„Zweitens werde diskutiert, ob die globale Erwärmung die jährlichen Schwankungen im Luftdruckunterschied zwischen Islandtief und Azorenhoch verstärkt.“"
                                            },
                                            {
                                                "example_id": "5130f4ef-3833-4c69-a610-c616d9c2df06",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„Der kleine Inselstaat setzt sich vor allem für die Belange vieler pazifischer Länder ein, die vom Meeresspiegelanstieg infolge der globalen Erwärmung bedroht sind.“"
                                            },
                                            {
                                                "example_id": "dbda1175-693a-4916-ae6d-f35f0154f4e6",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„»Wir wissen schon seit Jahrzehnten, dass eine bestimmte Menge Kohlendioxid, die in die Atmosphäre abgegeben wird, immer ein bestimmtes Maß der Erwärmung nach sich zieht. Das ist eine Grundlage der Wissenschaft«, sagt er.“"
                                            },
                                            {
                                                "example_id": "c794f95d-85ec-4ad5-89a4-010428e22906",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„Wenn Salze gelöst werden, sind oft Temperaturänderungen zu beobachten. So löst sich Kaliumchlorid unter Abkühlung, Lithiumchlorid dagegen unter Erwärmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a877241b-9ab8-4d96-823c-9045d7a6768d",
                        "source_entry_id": "6a57a369-511b-390d-a293-8a91c8c441e9",
                        "source_sense_id": "48284e62-6e75-395d-be1e-5a2a4dc35b9d",
                        "source_sense_description": "het proces van temperatuursverhoging",
                        "target_lang_word": "Erderwärmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erderwärmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "379f832a-5f85-3b91-8025-0e34dc73513c",
                                        "entry_id": "d85c5dfd-4367-33b7-8a5c-bc7d2c0762bc",
                                        "glosses": [
                                            "Temperaturerhöhung der Erdatmosphäre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55d09e6a-5c35-441b-bc61-5f9030b93381",
                                                "sense_id": "379f832a-5f85-3b91-8025-0e34dc73513c",
                                                "text": "Die Erderwärmung nimmt drastisch zu."
                                            },
                                            {
                                                "example_id": "bd045446-c5bc-4357-b9d9-f801fbc557b5",
                                                "sense_id": "379f832a-5f85-3b91-8025-0e34dc73513c",
                                                "text": "„Die Klimakurve der Erderwärmung zeigt steil nach oben.“"
                                            },
                                            {
                                                "example_id": "b7f506c0-ecc6-4849-bbb8-5920aa205afa",
                                                "sense_id": "379f832a-5f85-3b91-8025-0e34dc73513c",
                                                "text": "„Würden alle Unternehmen wie die Unternehmen des Börsenindex DAX 30 wirtschaften, würden sie eine Erderwärmung von 4,94 °C bis 2050 erzeugen.“"
                                            },
                                            {
                                                "example_id": "95993cea-364d-4c14-b3ba-cfb0d1f2743b",
                                                "sense_id": "379f832a-5f85-3b91-8025-0e34dc73513c",
                                                "text": "„Alle 195 Staaten haben sich dazu bekannt, die Erderwärmung nicht nur auf 2, sondern möglichst auf 1,5 Grad zu begrenzen.“"
                                            },
                                            {
                                                "example_id": "921305ac-8680-445b-afe6-a71508e1688b",
                                                "sense_id": "379f832a-5f85-3b91-8025-0e34dc73513c",
                                                "text": "„»2015 in Paris hat man sich darauf verständigt, die Erderwärmung auf deutlich unter 2°C zu begrenzen, wie es dort heißt.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
