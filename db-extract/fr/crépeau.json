                "senses": [
                    {
                        "sense_id": "98aa260d-01ae-32f7-8b04-1854ad3df703",
                        "entry_id": "df22b95b-fdf4-3d21-b934-296c433099f1",
                        "glosses": [
                            "Nom de famille français et québécois originaire de Vendée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "381f22ff-544e-42b0-a5a9-fd043b4d525c",
                                "sense_id": "98aa260d-01ae-32f7-8b04-1854ad3df703",
                                "text": "M. Crépeau surpris, fit un faux mouvement et tomba, sans heureusement se blesser."
                            },
                            {
                                "example_id": "7f9c7fea-94a3-49ea-9a74-a668811a0288",
                                "sense_id": "98aa260d-01ae-32f7-8b04-1854ad3df703",
                                "text": "Leur collègue radical Michel Crépeau, 68 ans (Charente-Maritime), vient de les régaler de sa voix nasillarde."
                            },
                            {
                                "example_id": "bf27fc25-b924-418f-ad13-d21cd25305ef",
                                "sense_id": "98aa260d-01ae-32f7-8b04-1854ad3df703",
                                "text": "Le Pr François Crépeau, ancien rapporteur spécial des Nations unies sur les droits de l’homme des migrants de 2011 à 2017, est accueilli à l’UCL au sein de l'Équipe droits européens et migrations (EDEM)."
                            }
                        ]
                    }
                ],
