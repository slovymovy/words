                        "examples": [
                            {
                                "example_id": "af69288f-67d6-460b-ad29-c98c1f06ca17",
                                "sense_id": "25b6a3ac-50d5-3010-9853-8c39d5fe0bb2",
                                "text": "Kenley Jansen (Los Angeles Dodgers) en Jonathan Schoop (Milwaukee Brewers) maken nog kans op de kampioenschapsring in de Major League, de Noord-Amerikaanse honkbalcompetitie. Beide honkballers wonnen maandagnacht een beslissingsduel om de titel in hun divisie."
                            },
                            {
                                "example_id": "f4f2130d-bbe8-42a7-9650-dad3f966da3e",
                                "sense_id": "25b6a3ac-50d5-3010-9853-8c39d5fe0bb2",
                                "text": "Door het beslissingsduel met de Cubs te winnen (3-1) kwalificeerden Jonathan Schoop en de zijnen zich voor de play-offs, terwijl de ploeg uit Chicago naar de wildcardgame werd verwezen. En met talentvolle spelers gecombineerd met ervaren krachten gelden de Brewers meteen als gevaarlijke outsider voor de titel."
                            }
                        ]
                    }
