                        "entry_id": "6c8922aa-7b70-3aa2-862a-6697f9996fcf",
                        "glosses": [
                            "To revolve round a central point; to move spirally about an axis, as a tornado."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dc2401dc-4567-425d-88ab-77593ddff157",
                                "sense_id": "f8d57a97-a684-3200-869d-7b703dc844fb",
                                "text": "The stripper gyrated sexily around a pole."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a5f80d4-92ac-4754-aed6-fa8b14a410b4",
