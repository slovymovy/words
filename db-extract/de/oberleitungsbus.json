                "senses": [
                    {
                        "sense_id": "16a65c60-8ff4-3199-b7fe-419e94cd08f0",
                        "entry_id": "317c2810-014d-376d-bd2f-50c371fbb1f7",
                        "glosses": [
                            "als Verkehrsmittel im öffentlichen Personennahverkehr eingesetzter Bus, der seine Antriebsenergie aus einer über der Fahrbahn aufgehängten elektrischen Leitung bezieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c17520e8-5908-4f82-a022-598db22e03de",
                                "sense_id": "16a65c60-8ff4-3199-b7fe-419e94cd08f0",
                                "text": "„Die Stadt Potsdam hält die Rückkehr zu Oberleitungsbussen für unwirtschaftlich.“"
                            },
                            {
                                "example_id": "01f56c5e-8069-46d1-a641-00890e61b410",
                                "sense_id": "16a65c60-8ff4-3199-b7fe-419e94cd08f0",
                                "text": "„Die Zukunft wird dem Elektrobus gehören. Fragt sich nur: welchem? Dem Batteriebus, dem Oberleitungsbus oder dem Wasserstoffbus, der seinen Strom aus einer Brennstoffzelle bezieht?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
