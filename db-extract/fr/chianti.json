                        "sense_id": "2def77dc-8eb2-30d8-92b1-77cc7cb65732",
                        "entry_id": "a168da26-cb30-3fd2-af9e-68942b065061",
                        "glosses": [
                            "Vin rouge italien, Denominazione di Origine Protetta (DOP : dénomination du ’origine protégée, l’équivalent de l’AOC en France) ou Denominazione di Origine Controllata e Garantita (DOCG pour la région de Chianti proprement dite) vendu dans la célèbre fiasque ou en bouteilles de forme bordelaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f743baa3-cfc8-4e0e-810c-e23387e75692",
                                "sense_id": "2def77dc-8eb2-30d8-92b1-77cc7cb65732",
                                "text": "Le lièvre mariné dans le chianti était une merveille."
                            },
                            {
                                "example_id": "cd167086-d1e8-40f8-95c4-5b5a91fb6a60",
                                "sense_id": "2def77dc-8eb2-30d8-92b1-77cc7cb65732",
                                "text": "La cuisine simple mais savoureuse de la Toscane, au cœur de l’Italie, est mise en valeur par l’un des vins italiens les plus célèbres, le chianti."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17915162-bc93-4a87-965e-81eee6c92e41",
                        "source_entry_id": "a168da26-cb30-3fd2-af9e-68942b065061",
                        "source_sense_id": "2def77dc-8eb2-30d8-92b1-77cc7cb65732",
                        "target_lang_word": "Chianti",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chianti",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aca7e4cf-b601-3fcc-b22d-fb825ecff89e",
                                        "entry_id": "5734e5cf-84ff-332d-9214-14bbc5dc10c9",
                                        "glosses": [
                                            "italienische Rotweinsorte, die im Wesentlichen aus der Sangiovese-Traube besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad05f87-c926-4fb8-b134-7de43df61812",
                                                "sense_id": "aca7e4cf-b601-3fcc-b22d-fb825ecff89e",
                                                "text": "„Chianti war früher das Synonym für italienischen Wein schlechthin, und er wurde traditionell in strohumflochtenen Flaschen […] verkauft.“"
                                            },
                                            {
                                                "example_id": "d44f1a1b-15b4-48f3-95e6-bdfcaa9939d2",
                                                "sense_id": "aca7e4cf-b601-3fcc-b22d-fb825ecff89e",
                                                "text": "„[…] Ja, Ja der Chianti-Wein, da sagt uns keine nein! - Drum schenkt die Gläser ein, die Welt soll unser sein, die Welt soll unser sein - beim Chianti-Wein […]“"
                                            },
                                            {
                                                "example_id": "d10b94fc-d38d-4683-84dd-d32e985ff650",
                                                "sense_id": "aca7e4cf-b601-3fcc-b22d-fb825ecff89e",
                                                "text": "„Vollgestopft mit Makkaroni und beschwipst vom Chianti und Montepulciano, hatten wir kein Verlangen nach Liebe, und beim Erwachen waren unsere Tollheiten nicht der Rede wert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
