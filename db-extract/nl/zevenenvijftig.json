                        "examples": [
                            {
                                "example_id": "fc9519a7-8607-4d9e-ba62-c82778e7d1f1",
                                "sense_id": "1d1d5c5c-0e88-3331-9f64-e3e75da82443",
                                "text": "Het is weer de zevenenvijftig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "407a7a78-9989-4223-92e6-a0effba2ffb5",
                                "sense_id": "1d1d5c5c-0e88-3331-9f64-e3e75da82443",
                                "text": "Haar achtenvijftigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zevenenvijftig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc0723dc-5a0e-3e07-bedd-638c5052371a",
                        "entry_id": "2da2205f-1142-30e5-9868-a0252967bfe7",
