                "senses": [
                    {
                        "sense_id": "d307b4f9-e754-3fd5-8cbd-97956fbd2923",
                        "entry_id": "6df41880-18b3-32a3-ac6b-1a9ed4adff6b",
                        "glosses": [
                            "A piece of deep-fried batter left over from frying fish, sometimes sold with chips."
                        ],
                        "tags": [
                            "Devon",
                            "UK",
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "71ecdfc8-f3cb-4343-96b3-bc112f9d1023",
                                "sense_id": "d307b4f9-e754-3fd5-8cbd-97956fbd2923",
                                "text": "The study also reveals that Wigan likely calls excess batter bits ‘Scraps’ or ‘Bits’, compared to the south west and east of the UK who are more likely to order ‘Gribbles’ or ‘Scrumps’."
                            },
                            {
                                "example_id": "34e0e987-b82e-4558-9154-edcb93e7875c",
                                "sense_id": "d307b4f9-e754-3fd5-8cbd-97956fbd2923",
                                "text": "Margaret also played her part in filling our hungry mouths by working at the local fish and chip shop in the village and by bringing home all the leftovers which we devoured ravenously—gribbles, the odd faggot etc. etc.—delicious."
                            },
                            {
                                "example_id": "32235ecd-4e5b-4759-a960-a1563a7362b7",
                                "sense_id": "d307b4f9-e754-3fd5-8cbd-97956fbd2923",
                                "text": "Went to a Chippy as a Kid.\nMe \"do you have Pigs Feet?\"\nLass Behind Counter \"Yes I do\".\nMe \"Well give us a bag of GRIBBLES then Porky!!!\""
                            }
                        ]
                    }
