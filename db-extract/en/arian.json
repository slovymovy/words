                "senses": [
                    {
                        "sense_id": "27685999-7003-361f-87e4-b07de6cfe67a",
                        "entry_id": "c487ff88-5bb8-3788-b968-a88c01f65ff9",
                        "glosses": [
                            "A supporter of the Cyrenaic monk Arius and his faction in the 4th-century Church."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7a21e110-e139-4a43-96a2-e496be380454",
                                "sense_id": "27685999-7003-361f-87e4-b07de6cfe67a",
                                "text": "The Arians celebrated the virtue of their pious confessor; the Catholics ambitiously claimed his alliance; and the Pagans, who might be susceptible of shame or remorse, were deterred from the repetition of such unavailing cruelty."
                            }
                        ]
                    },
                    {
                        "sense_id": "297953f2-c924-306f-9d8e-ea6e46559a82",
                        "entry_id": "c487ff88-5bb8-3788-b968-a88c01f65ff9",
                        "glosses": [
                            "A believer of Arianism, particularly (historical) the official Arian churches lasting to the 7th century."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "62edc7e4-3a61-3150-8b1c-45b04398edf0",
                        "entry_id": "c487ff88-5bb8-3788-b968-a88c01f65ff9",
                        "glosses": [
                            "Synonym of unitarian, any Christian who denies the Trinity."
                        ],
                        "tags": [
                            "derogatory",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
