{
    "word_family": [
        "accompagnement",
        "accompagnateur",
        "accompagnatrice"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99c1d8ca-1de2-3745-9f57-33893ae26046",
                    "sense_definition": "Aller quelque part avec quelqu'un, faire route avec une personne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je peux t'<w>accompagner</w> à la gare si tu as des valises lourdes."
                        },
                        {
                            "text": "Chaque matin, mon voisin <w>accompagne</w> ses enfants à pied jusqu'à l'école."
                        }
                    ],
                    "synonyms": [
                        "suivre",
                        "conduire"
                    ],
                    "antonyms": [
                        "abandonner",
                        "délaisser"
                    ],
                    "common_phrases": [
                        "accompagner à la porte"
                    ]
                },
                {
                    "sense_id": "e0d01ad4-30fb-37d8-9792-1e69ed921aba",
                    "sense_definition": "Guider, soutenir ou assister une personne dans une démarche, un apprentissage ou une difficulté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "soutien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette association <w>accompagne</w> les demandeurs d'emploi dans toutes leurs démarches administratives."
                        },
                        {
                            "text": "Une équipe de soignants dévoués <w>accompagne</w> les patients tout au long de leur convalescence."
                        }
                    ],
                    "synonyms": [
                        "épauler",
                        "soutenir",
                        "guider"
                    ],
                    "antonyms": [
                        "négliger"
                    ],
                    "common_phrases": [
                        "accompagner un projet",
                        "accompagner le changement"
                    ]
                },
                {
                    "sense_id": "b569c769-e77d-3630-8de3-10560b73b230",
                    "sense_definition": "Compléter harmonieusement ou servir avec quelque chose d'autre, en particulier un aliment ou une boisson.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "assortiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serveur nous a conseillé un vin blanc sec pour <w>accompagner</w> le poisson grillé."
                        },
                        {
                            "text": "Elle aime <w>accompagner</w> cette viande rôtie d'une purée maison aux herbes fraîches."
                        }
                    ],
                    "synonyms": [
                        "assortir",
                        "compléter"
                    ],
                    "common_phrases": [
                        "accompagner un plat"
                    ]
                },
                {
                    "sense_id": "79f0f901-46f4-3568-895b-577989cf4b58",
                    "sense_definition": "Jouer d'un instrument de musique pour soutenir la mélodie d'un chanteur ou d'un soliste.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pianiste <w>accompagne</w> la jeune violoniste lors de son premier concert public."
                        },
                        {
                            "text": "Il interprète ses chansons en s'<w>accompagnant</w> simplement à la guitare acoustique."
                        }
                    ],
                    "common_phrases": [
                        "accompagner au piano",
                        "s'accompagner à la guitare"
                    ]
                },
                {
                    "sense_id": "4ffe23c8-157d-3d38-a4be-8cb2370992ed",
                    "sense_definition": "Escorter une personne pour veiller à sa sécurité ou lui rendre les honneurs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs gardes du corps <w>accompagnaient</w> le ministre pendant sa visite officielle en ville."
                        },
                        {
                            "text": "Les agents de sécurité ont <w>accompagné</w> le convoi officiel jusqu'aux portes du palais."
                        }
                    ],
                    "synonyms": [
                        "escorter",
                        "convoyer"
                    ],
                    "common_phrases": [
                        "accompagner sous bonne escorte"
                    ]
                }
            ]
        }
    ]
}