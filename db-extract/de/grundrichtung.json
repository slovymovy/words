                "senses": [
                    {
                        "sense_id": "2a4e2aeb-a971-34c1-b72b-f7b4d79182e4",
                        "entry_id": "e12fa84a-31b9-349c-8b92-906848e1c950",
                        "glosses": [
                            "primäre, vorrangige, wesentliche, grundsätzliche Richtung, Haltung oder Einstellung beziehungsweise Neigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "908e4753-9e1f-498f-a75e-52fcbbf58fad",
                                "sense_id": "2a4e2aeb-a971-34c1-b72b-f7b4d79182e4",
                                "text": "„sie werfen ihnen vor, … daß die eigentliche Grundrichtung angesehener Wissenschaften gar nicht mehr eingehalten wird.“"
                            },
                            {
                                "example_id": "36bb6da4-4b1c-4a6b-a50f-530406ec49fc",
                                "sense_id": "2a4e2aeb-a971-34c1-b72b-f7b4d79182e4",
                                "text": "„Als Verleger bin ich für die Grundrichtung des Blattes verantwortlich.“"
                            },
                            {
                                "example_id": "6e7a1705-d83e-4274-ac20-c4f9af11cf34",
                                "sense_id": "2a4e2aeb-a971-34c1-b72b-f7b4d79182e4",
                                "text": "„Als Herausgeber sollte er die politische und publizistische Grundrichtung vorgeben, was eine eher allgemeine Jobbeschreibung ist.“"
                            },
                            {
                                "example_id": "1b8e6212-fa80-4b46-889b-63d56519f383",
                                "sense_id": "2a4e2aeb-a971-34c1-b72b-f7b4d79182e4",
                                "text": "„Es scheint, daß von da ab die Grundrichtung stärker nach oben tendiert.“"
                            },
                            {
                                "example_id": "8f9ebd3d-712d-4d61-ae79-15959c4e07ac",
                                "sense_id": "2a4e2aeb-a971-34c1-b72b-f7b4d79182e4",
                                "text": "„nach allen Grundrichtungen des menschlichen Denkens“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
