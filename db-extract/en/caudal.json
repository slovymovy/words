    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ece2943f-76d8-337e-b57c-4f8ea66c6210",
                "word": "caudal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "051c4070-c45d-3ab5-9e68-902af3e8f338",
                        "entry_id": "ece2943f-76d8-337e-b57c-4f8ea66c6210",
                        "glosses": [
                            "Pertaining to the tail or posterior or hind part of a body."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1fc0d0e2-428d-4e7a-a36b-cbf499db1783",
                                "sense_id": "051c4070-c45d-3ab5-9e68-902af3e8f338",
                                "text": "The male widow-bird, remarkable for his caudal plumes, […]"
                            },
                            {
                                "example_id": "9783aa19-aea1-495c-ad21-7cd8cc0d0b33",
                                "sense_id": "051c4070-c45d-3ab5-9e68-902af3e8f338",
                                "text": "Dassoud […] stepped forward with a lash composed of the caudal appendages of half a dozen wildebeests."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b6fd7dd-0786-3b4e-a569-f37b787a5be0",
                        "entry_id": "ece2943f-76d8-337e-b57c-4f8ea66c6210",
                        "glosses": [
                            "Toward the tail end (hind end) of the body; in bipeds such as humans, this direction corresponds to inferior."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b3d9df0-c471-41c6-94a1-eddeee69a9ec",
                        "source_entry_id": "ece2943f-76d8-337e-b57c-4f8ea66c6210",
                        "source_sense_description": "pertaining to the tail",
                        "target_lang_word": "ocasní",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ocasní",
