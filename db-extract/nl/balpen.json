                    {
                        "translation_id": "6f1d32cc-be96-4851-a044-ff8f2f4c73cb",
                        "source_entry_id": "d48ddfe2-b674-317f-9f99-26b122534448",
                        "source_sense_id": "548ad70c-1561-3434-9435-7357999749b1",
                        "source_sense_description": "een pen die met een bal of kogel de inkt op het papier overbrengt",
                        "target_lang_word": "Kugelschreiber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kugelschreiber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                        "entry_id": "ce65e534-44b8-327e-bc6d-e7ba227b3bed",
                                        "glosses": [
                                            "Stift, dessen Farbe über eine bewegliche Kugel abgegeben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70e8be0-aabe-4fbc-8115-fa4c3bdf64f8",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "In der Schule dürfen wir nicht mit Kugelschreibern schreiben."
                                            },
                                            {
                                                "example_id": "1e9b18fa-e620-4532-bc49-d7ce3ff158ca",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "Hast du mal ´nen Kugelschreiber?"
                                            },
                                            {
                                                "example_id": "51e5ffdc-2730-4309-ae97-449d3ac08954",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "Leih mir bitte mal eben deinen Kugelschreiber."
                                            },
                                            {
                                                "example_id": "395b7de0-bdf7-409a-8594-c0e10226a45a",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "Mit dem Kugelschreiber kann man auf das Blatt darunter durchdrücken."
                                            },
                                            {
                                                "example_id": "e10d2540-3489-4ddc-a28a-127e5b17a79e",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "„Der Kugelschreiber flog nun förmlich über die Seiten, und Perlmann schaffte es kaum, die Gedanken, die sich jagten, auf dem Papier festzuhalten.“"
                                            },
                                            {
                                                "example_id": "98d3e696-54c6-4603-8ba1-a44b04726b19",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "„Auch Kugelschreiber lagen herum, neben dem Block, auf dem jemand sie ausprobiert hatte.“"
                                            },
                                            {
                                                "example_id": "41bb94df-d77d-48b3-a0e6-ec35b5aeaf00",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "„Er schnappt sich Papier und Kugelschreiber.“"
                                            },
                                            {
                                                "example_id": "9bf84d9e-34c2-4fb4-b840-7b5ef7916484",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "„Er legte die Aktentasche auf den Tisch im Flur, zog einen Notizblock und einen Kugelschreiber hervor und trat in die Tür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c57fc80-b7fd-437a-9b8b-17375601d6de",
                        "source_entry_id": "d48ddfe2-b674-317f-9f99-26b122534448",
                        "source_sense_id": "548ad70c-1561-3434-9435-7357999749b1",
                        "source_sense_description": "een pen die met een bal of kogel de inkt op het papier overbrengt",
                        "target_lang_word": "Kuli",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kuli",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee05d385-9469-3fb0-8cdb-e62ad5f306a1",
                                        "entry_id": "9bbc8517-eb14-39b0-b9e7-00d2b6ebaf63",
                                        "glosses": [
                                            "Kugelschreiber"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2f2364-c0d8-479b-a91a-bcfc83fe244c",
                                                "sense_id": "ee05d385-9469-3fb0-8cdb-e62ad5f306a1",
                                                "text": "Reich mir mal deinen Kuli!"
                                            },
                                            {
                                                "example_id": "d3eed894-83a9-4755-8650-556e48a6319e",
                                                "sense_id": "ee05d385-9469-3fb0-8cdb-e62ad5f306a1",
                                                "text": "„Aber Big Arnie hört nicht zu, sondern zeichnet mit Schwechtersheimer Kuli auf der Speisekarte herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f383f69-11a4-38a9-89e8-36afd3006919",
                                        "entry_id": "9bbc8517-eb14-39b0-b9e7-00d2b6ebaf63",
                                        "glosses": [
                                            "Tintenkuli"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kuli",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1223932d-6f79-3e86-8f10-69c54fa4ed39",
                                        "entry_id": "f321ebd0-5ed6-3c47-9682-730096711b5f",
                                        "glosses": [
                                            "Tagelöhner in Südostasien"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a36359-07f1-4f05-b55b-84b26102019f",
                                                "sense_id": "1223932d-6f79-3e86-8f10-69c54fa4ed39",
                                                "text": "Über die portugiesische Kolonie Macao wurden auch chinesische Kulis nach Mittel- und Südamerika verschifft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d2fb12b8-4586-31f5-995f-5446c7136265",
                                        "entry_id": "f321ebd0-5ed6-3c47-9682-730096711b5f",
                                        "glosses": [
                                            "rücksichtslos ausgenutzte Person"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c54637c9-1e99-4b93-a6c7-922fab61013e",
                                                "sense_id": "d2fb12b8-4586-31f5-995f-5446c7136265",
                                                "text": "Ich würde drüben in der Fabrik nicht arbeiten wollen, da muss man schuften wie ein Kuli."
                                            },
                                            {
                                                "example_id": "073ff21a-593e-4987-b8a7-f4be6981eb07",
                                                "sense_id": "d2fb12b8-4586-31f5-995f-5446c7136265",
                                                "text": "„In der Rue de la Mortellerie, nahe dem Fluß, kannte sie einen Gerber namens Grimal, der notorischen Bedarf an jugendlichen Arbeitskräften hatte – nicht an ordentlichen Lehrlingen oder Gesellen, sondern an billigen Kulis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4632eaec-b610-317b-9fe5-d4f9e65a7a33",
                                        "entry_id": "f321ebd0-5ed6-3c47-9682-730096711b5f",
                                        "glosses": [
                                            "Kofferkuli, Gepäckwagen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f27afb-9e7c-408c-b69f-a5167d466c23",
                                                "sense_id": "4632eaec-b610-317b-9fe5-d4f9e65a7a33",
                                                "text": "„Findige Gauner haben jetzt die neue Abzock-Masche entwickelt: Steht ein Gepäckwagen scheinbar herrenlos herum, spurten sie hin, hetzen mit dem Kuli zur Abgabestelle, kassieren.“"
                                            },
                                            {
                                                "example_id": "a5c8398b-35ce-47f4-9cf4-3317927932c1",
                                                "sense_id": "4632eaec-b610-317b-9fe5-d4f9e65a7a33",
                                                "text": "„Mein Teekesselchen ist ein Gepäckwagen, der ausgeliehen werden kann. Mein Teekesselchen wird auch „Kugelschreiber“ genannt. Lösung: Kuli. Gepäckwagen auf Bahnhöfen, Synonym für Kugelschreiber.“"
                                            },
                                            {
                                                "example_id": "af0a8a7c-d722-417a-a7d4-1086d8ecce9c",
                                                "sense_id": "4632eaec-b610-317b-9fe5-d4f9e65a7a33",
                                                "text": "„»Ich hole einen Kuli.« Davon unbeeindruckt steuerte Patsy tänzelnd die Reihe ineinandergeschobener Gepäckwagen an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
