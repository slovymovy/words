                                                "sense_id": "faafc1b6-edaf-33d5-8366-68edd122fac0",
                                                "text": "Octan ist leicht brennbar."
                                            },
                                            {
                                                "example_id": "769a2d09-517e-4153-bff5-3efe1b433625",
                                                "sense_id": "faafc1b6-edaf-33d5-8366-68edd122fac0",
                                                "text": "„Benzin ist eine Mischung verschiedener Flüssigkeiten, eine davon ist Octan.“"
                                            },
                                            {
                                                "example_id": "3380dbab-3386-41fd-a67c-822c24387094",
                                                "sense_id": "faafc1b6-edaf-33d5-8366-68edd122fac0",
                                                "text": "„Octan siedet deshalb erst bei 126° C.“"
                                            }
                                        ],
