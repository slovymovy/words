                        "entry_id": "6b3005c0-e212-3f43-afae-4e7dbd1d0e86",
                        "glosses": [
                            "alle bedrijven die zich bezighouden met de in- en verkoop van groentes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a05cb37-f69b-416f-b5df-e61c13b9b066",
                                "sense_id": "eaaad59d-f62b-3acf-86b8-0d1174f61052",
                                "text": "De Nederlandse groentehandel doet er alles aan om de export en consumptie van Hollandse groenten op peil te houden."
                            }
                        ]
                    }
                ],
