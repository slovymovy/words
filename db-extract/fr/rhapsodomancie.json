                                    {
                                        "sense_id": "3ca14ab8-7570-3c35-a92d-dd46066b831b",
                                        "entry_id": "7f2f2974-a503-300b-a6ed-b3254080c55c",
                                        "glosses": [
                                            "Divination by reading a random passage from a poem."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20c52400-d129-4fea-a0f2-f019ee4d2d56",
                                                "sense_id": "3ca14ab8-7570-3c35-a92d-dd46066b831b",
                                                "text": "Rhapsodomantia sive divinatio ex rhapsodia aliqva poëtæ."
                                            },
                                            {
                                                "example_id": "de4f9f96-2551-4455-88d1-b5be62cb871f",
                                                "sense_id": "3ca14ab8-7570-3c35-a92d-dd46066b831b",
                                                "text": "1953, Gaynor (ed.), Dict. Mysticism\nRhapsodomancy: A form of divination, based on a line in a sacred book or book of poetry which strikes the eye when the book is opened, or which is the last line to be pierced by a needle stuck through the closed book."
                                            },
                                            {
                                                "example_id": "28ee0deb-b81c-46cf-b808-3d5a273b6019",
                                                "sense_id": "3ca14ab8-7570-3c35-a92d-dd46066b831b",
                                                "text": "Using chance to arrive at a particular passage in the I Ching is a form of rhapsodomancy: the seeking of guidance through the chance selection of a passage in a literary work. Another early form of rhapsodomancy is represented by the sibylline books. [...]"
                                            }
                                        ]
                                    }
