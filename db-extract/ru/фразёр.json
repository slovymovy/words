                                "target_senses": [
                                    {
                                        "sense_id": "369fc171-937b-320e-981e-264f53e0649a",
                                        "entry_id": "5860d350-782a-3d8e-a964-731e50238013",
                                        "glosses": [
                                            "Synonyme de phraseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b857f82b-7bff-4349-9940-59d0c1ba2a46",
                                                "sense_id": "369fc171-937b-320e-981e-264f53e0649a",
                                                "text": "Ils ne sont bons que pour être commentés chez les Irlandais par ce fou dʼAbbadie, ou chez les Velches par ce phrasier dʼHouteville."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
