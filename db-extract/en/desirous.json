                        "sense_id": "deb559db-d077-3298-afb8-75a7c743ef24",
                        "entry_id": "84b95df0-a381-3594-ad86-58f18ce78d96",
                        "glosses": [
                            "Feeling desire; eagerly wishing; eager to obtain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3d78b08-abee-4a0f-b49b-5469b9b7eea2",
                                "sense_id": "deb559db-d077-3298-afb8-75a7c743ef24",
                                "text": "More significantly, rigid deference to [Justin] Bieber’s still-young core fan base keeps things resolutely PG, with any acknowledgement of sex either couched in vague “touch your body” workarounds or downgraded to desirous hand-holding and eye-gazing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "727298a7-4d82-4e63-b3a7-db588b3fd156",
