                    {
                        "translation_id": "d5744cc8-1495-48e0-a424-95c312d94add",
                        "source_entry_id": "76de14ae-c289-36ee-8e73-2aaf6d2bd6be",
                        "source_sense_id": "a8ceec71-84fd-3ef7-a246-7be5f30ed720",
                        "target_lang_word": "gynaeceum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gynaeceum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c01db45f-84c1-347a-8d67-38d55d92a957",
                                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                                        "glosses": [
                                            "The women's quarters in a household; (hence, loosely) any building or area for women."
                                        ],
                                        "tags": [
                                            "Ancient-Rome"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f4057d0-33a2-4d3f-acbc-09d7dc655543",
                                                "sense_id": "c01db45f-84c1-347a-8d67-38d55d92a957",
                                                "text": "A master, however this may be, was very jealous of the inmates of his gyneceum, and he permitted no one to enter the place, which was protected as a sanctuary in the legislation of the Barbarians."
                                            },
                                            {
                                                "example_id": "0307cbb5-a9bb-4586-a40f-56b6675b606c",
                                                "sense_id": "c01db45f-84c1-347a-8d67-38d55d92a957",
                                                "text": "It was agreeable to see men, after days in this gyneceum, bringing the place to life, to see waiters speeding to their command."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2951de84-1689-372a-9d23-dc3b1b31d36a",
                                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                                        "glosses": [
                                            "An establishment in Rome where female workers made clothing and furniture for royalty."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1c768cd-f901-37fe-b017-d400554b733f",
                                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                                        "glosses": [
                                            "A gynoecium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df559b8d-2767-4465-be31-b6b874eaca1f",
                                                "sense_id": "b1c768cd-f901-37fe-b017-d400554b733f",
                                                "text": "The androecium functions by providing the pollen-grains which are necessary to bring about fertilisation of the ovules in the gynaeceum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
