                "senses": [
                    {
                        "sense_id": "1b3b428d-3af8-35d1-b4e3-e9ded7f9bf4c",
                        "entry_id": "2080fccc-1963-3875-bba2-511d7f852d53",
                        "glosses": [
                            "erstmalige (neu gemeldete und erfasste) Infektion mit einem Krankheitserreger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34398f5-6d3f-43bc-a803-317fa873fa42",
                                "sense_id": "1b3b428d-3af8-35d1-b4e3-e9ded7f9bf4c",
                                "text": "„Die Hauptwaffe zur Bekämpfung von Volksseuchen ist die Verhütung von Neuansteckungen, und somit ist der persönliche Schutz das Hauptmittel zur Bekämpfung der Geschlechtskrankheiten.“"
                            },
                            {
                                "example_id": "a48fc8bf-df43-4191-82f6-958c2e328b9a",
                                "sense_id": "1b3b428d-3af8-35d1-b4e3-e9ded7f9bf4c",
                                "text": "„Das Urlaubs- und Adrialand Kroatien hat erstmals seit dem 9. März einen Tag ohne registrierte Neuansteckung mit dem Coronavirus erlebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
