                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c320b4b8-033f-3715-bd0d-fc57f4ef60a9",
                        "entry_id": "5c4f147e-3536-3032-855f-bc8d3e10b3f0",
                        "glosses": [
