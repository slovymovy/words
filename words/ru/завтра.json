            "senses": [
                {
                    "sense_id": "6601c5ac-27ec-3073-abfd-90423a4aec7f",
                    "sense_definition": "День, который наступит сразу после сегодняшнего.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не откладывай на <w>завтра</w> то, что можно сделать сегодня.",
                            "target_lang_translations": {
                                "en": "Don't put off until <w>tomorrow</w> what can be done today.",
                                "zh": "今日事今日毕，不要拖到<w>明天</w>。",
                                "de": "Was du heute kannst besorgen, das verschiebe nicht auf <w>morgen</w>.",
                                "nl": "Stel niet uit tot <w>morgen</w> wat je vandaag kunt doen.",
                                "pl": "Nie odkładaj na <w>jutro</w> tego, co można zrobić dzisiaj.",
                                "fr": "Ne remets pas à <w>demain</w> ce que tu peux faire aujourd'hui.",
                                "it": "Non rimandare a <w>domani</w> quello che puoi fare oggi.",
                                "cs": "Neodkládej na <w>zítřek</w> to, co můžeš udělat dnes.",
                                "tr": "Bugün yapılabilecek işi <w>yarına</w> bırakma.",
                                "es": "No dejes para <w>mañana</w> lo que puedes hacer hoy."
                            }
                        },
                        {
                            "text": "Наше <w>завтра</w> будет лучше, чем вчера.",
                            "target_lang_translations": {
                                "en": "Our <w>tomorrow</w> will be better than yesterday.",
                                "zh": "我们的<w>明天</w>会比昨天更好。",
                                "de": "Unser <w>Morgen</w> wird besser sein als das Gestern.",
                                "nl": "Onze <w>morgen</w> zal beter zijn dan gisteren.",
                                "pl": "Nasze <w>jutro</w> będzie lepsze niż wczoraj.",
                                "fr": "Notre <w>demain</w> sera meilleur qu'hier.",
                                "it": "Il nostro <w>domani</w> sarà migliore di ieri.",
                                "cs": "Náš <w>zítřek</w> bude lepší než včerejšek.",
                                "tr": "<w>Yarınımız</w> dünden daha iyi olacak.",
                                "es": "Nuestro <w>mañana</w> será mejor que el ayer."
                            }
                        }
                    ],
