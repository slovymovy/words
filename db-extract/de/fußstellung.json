                "senses": [
                    {
                        "sense_id": "f19af908-de4a-3d60-8e93-73a39509d777",
                        "entry_id": "aaf1edb6-0f68-38d5-a0f4-1b7d57956b21",
                        "glosses": [
                            "Art und Weise, wie ein Fuß oder die Füße (in einer bestimmten Situation) positioniert oder ausgerichtet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c76a600-c82a-4fe0-a9a5-1d4ba26ca95a",
                                "sense_id": "f19af908-de4a-3d60-8e93-73a39509d777",
                                "text": "„In der klinischen Untersuchung werden die Fußstellung, die Stabilität und der Bewegungsumfang beurteilt und mit der Gegenseite verglichen.“"
                            },
                            {
                                "example_id": "34ba0f6d-f0b6-4e7d-8db7-cb76c678f847",
                                "sense_id": "f19af908-de4a-3d60-8e93-73a39509d777",
                                "text": "„Die große Zwischensohle und das hohe Fußgewölbe tragen zu einer natürlichen Fußstellung bei, während die schmale Passform die Verbindung zwischen Fuß und Schuh erhöht und die Stabilität verbessert.“"
                            },
                            {
                                "example_id": "adb57ade-9869-4ae5-a793-fa2241dfe718",
                                "sense_id": "f19af908-de4a-3d60-8e93-73a39509d777",
                                "text": "„Die drei unterschiedlichen Achslängen sorgen für eine physiologisch natürliche Fußstellung auf dem Pedal.“"
                            },
                            {
                                "example_id": "07792f6e-d854-45cd-b13a-56c6ae8e0005",
                                "sense_id": "f19af908-de4a-3d60-8e93-73a39509d777",
                                "text": "„Schmerzen im Rücken zum Beispiel können ihre Ursache auch in der Fußstellung haben.“"
                            },
                            {
                                "example_id": "01a7f5c7-806b-4485-93c5-ee1659a4fe1c",
                                "sense_id": "f19af908-de4a-3d60-8e93-73a39509d777",
                                "text": "„Darüber hinaus können die natürlichere Fußstellung und die stärkere Fußmuskulatur auch dazu beitragen, Verletzungen in anderen Körperbereichen wie Knie, Hüfte und Rücken zu vermeiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
