                                "target_senses": [
                                    {
                                        "sense_id": "90076c17-4f3b-3969-ab85-cf81c4f17b5d",
                                        "entry_id": "3a3c2981-935d-34d1-919b-d7f5dc2a3625",
                                        "glosses": [
                                            "Lodging in a dwelling or similar living quarters afforded to travellers in hotels or on cruise ships, or prisoners, etc."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a150085-ceb5-4baf-b38f-3d2a913c71cd",
                                                "sense_id": "90076c17-4f3b-3969-ab85-cf81c4f17b5d",
                                                "text": "The accommodations at that hotel were quite luxurious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8d1fe4d-a021-3a8d-92fd-909ecba82cb6",
                                        "entry_id": "3a3c2981-935d-34d1-919b-d7f5dc2a3625",
                                        "glosses": [
                                            "Adaptation or adjustment.",
                                            "The act of fitting or adapting, or the state of being fitted or adapted; adaptation; adjustment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable",
                                            "with-to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f9bc5b-ef70-4fb3-9b31-55e07c5ac66d",
                                                "sense_id": "e8d1fe4d-a021-3a8d-92fd-909ecba82cb6",
                                                "text": "It is true, the organization of the humane and animal Body, with accommodation to their several functions and offices, is certainly fitted with the most curious and exact Mechanism imaginable"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b978d63-d090-3759-9a31-e39b821268c3",
                                        "entry_id": "3a3c2981-935d-34d1-919b-d7f5dc2a3625",
                                        "glosses": [
                                            "Adaptation or adjustment.",
                                            "A convenience, a fitting, something satisfying a need."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bf57321-fc13-40dc-9bb3-6f2973b53dca",
                                                "sense_id": "4b978d63-d090-3759-9a31-e39b821268c3",
                                                "text": "...and Lady Anne, for the present, felt as if Fanchette and her coach full of accommodations, heavy as they might once be supposed to be, were suddenly swallowed up in that awful sea, to which so many refractory spirits have been exorcised and consigned."
                                            },
                                            {
                                                "example_id": "c453d42f-b27d-4bf6-b7f0-c6cfd02dfa38",
                                                "sense_id": "4b978d63-d090-3759-9a31-e39b821268c3",
                                                "text": "Mr. Cooke had had a sloop yacht built at Far Harbor, the completion of which had been delayed, and which was but just delivered. […] The Maria had a cabin, which was finished in hard wood and yellow plush, and accommodations for keeping things cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d3baea6-05b4-3065-9c9e-e11fcfa9829e",
                                        "entry_id": "3a3c2981-935d-34d1-919b-d7f5dc2a3625",
                                        "glosses": [
                                            "Adaptation or adjustment.",
                                            "The adaptation or adjustment of an organism, organ, or part."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "477e7a6a-d9e3-3b53-926b-f0b202b649aa",
                                        "entry_id": "3a3c2981-935d-34d1-919b-d7f5dc2a3625",
                                        "glosses": [
                                            "Adaptation or adjustment.",
                                            "The adjustment of the eye to a change of the distance from an observed object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a160b597-68a4-34a3-bcf5-4c82169232b7",
                                        "entry_id": "3a3c2981-935d-34d1-919b-d7f5dc2a3625",
                                        "glosses": [
                                            "Adaptation or adjustment.",
                                            "Willingness to accommodate; obligingness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "personal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98c2d2b4-04eb-32c7-a5ff-fc3d3e83b4cf",
                                        "entry_id": "3a3c2981-935d-34d1-919b-d7f5dc2a3625",
                                        "glosses": [
                                            "Adaptation or adjustment.",
                                            "Adjustment of differences; state of agreement; reconciliation; settlement; compromise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "personal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef02ed7-4279-4d3d-96ba-c5d3a36e2474",
                                                "sense_id": "98c2d2b4-04eb-32c7-a5ff-fc3d3e83b4cf",
                                                "text": "Some of the recent literature on the Germanic settlements reads like an account of a tea party at the Roman vicarage. A shy newcomer to the village, who is a useful prospect for the cricket team, is invited in. There is a brief moment of awkwardness, while the host finds an empty chair and pours a fresh cup of tea; but the conversation, and village life, soon flow on. The accommodation that was reached between invaders and invaded in the fifth- and sixth-century West was very much more difficult, and more interesting, than this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a636b3a-79a4-3a98-a7ad-a70759cf39a3",
                                        "entry_id": "3a3c2981-935d-34d1-919b-d7f5dc2a3625",
                                        "glosses": [
                                            "Adaptation or adjustment.",
                                            "The application of a writer's language, on the ground of analogy, to something not originally referred to or intended."
                                        ],
                                        "tags": [
                                            "countable",
                                            "personal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba9a82f0-1762-45d0-ac90-3751c41f589f",
                                                "sense_id": "0a636b3a-79a4-3a98-a7ad-a70759cf39a3",
                                                "text": "It is probable to my apprehension, that many of those quotations were intended by the writers of the New Testament as nothing more than accommodations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e284f94-afe0-39e8-849b-4daf73a67959",
                                        "entry_id": "3a3c2981-935d-34d1-919b-d7f5dc2a3625",
                                        "glosses": [
                                            "Adaptation or adjustment.",
                                            "A loan of money."
                                        ],
                                        "tags": [
                                            "countable",
