                        "target_lang_word": "Scheideweg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheideweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2b44f74-d56e-34a6-96da-8ff3b68f8f1f",
                                        "entry_id": "ad733208-0de3-3fb9-ad26-8fdd3636d5f2",
                                        "glosses": [
                                            "Stelle, an der sich ein Weg gabelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133eeb04-ef81-4919-9a76-27a375b65992",
                                                "sense_id": "d2b44f74-d56e-34a6-96da-8ff3b68f8f1f",
                                                "text": "Sie ging die Dorfstraße immer weiter, bis die Häuser aufhörten und sie zum Scheideweg kam."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b92ea5f-bf42-3246-b0e8-f417d41d2bd1",
                                        "entry_id": "ad733208-0de3-3fb9-ad26-8fdd3636d5f2",
                                        "glosses": [
                                            "Situation, in der eine Richtungsentscheidung notwendig ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33e0c5c7-c02b-4764-b3fd-83bccf3a9010",
                                                "sense_id": "6b92ea5f-bf42-3246-b0e8-f417d41d2bd1",
                                                "text": "Die Partei steht am Scheideweg: Soll eine neue Ausrichtung beschlossen werden?"
                                            },
                                            {
                                                "example_id": "33d83585-5704-4193-80ca-ba78b3674e79",
                                                "sense_id": "6b92ea5f-bf42-3246-b0e8-f417d41d2bd1",
                                                "text": "„Als dann auch noch die Sozialdemokratie im Jahre 1912 einen überwältigenden Wahlsieg errang, der ihr gleichwohl keine parlamentarische Mehrheit verschaffte, stand das System am Scheideweg.“"
                                            },
                                            {
                                                "example_id": "a99c91d7-4d6a-4f4e-b316-c04c765d7c52",
                                                "sense_id": "6b92ea5f-bf42-3246-b0e8-f417d41d2bd1",
                                                "text": "„Zwanzig Jahre nachdem er in London in die Königliche Marine eingetreten war, stand Cook im Alter von sechsundvierzig Jahren erneut vor einem Scheideweg in seiner Karriere.“"
                                            },
                                            {
                                                "example_id": "3782687e-9cfa-4184-a06f-b1ddd030d3d3",
                                                "sense_id": "6b92ea5f-bf42-3246-b0e8-f417d41d2bd1",
                                                "text": "„Der anspruchsvolle Grenzgänger am Scheideweg von Leben und Tod lebt in krassen Antinomien, die dem Durchschnittsbürger sein Verständnis erschweren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
