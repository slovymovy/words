{
    "word_family": [
        "appearance",
        "apparent",
        "reappear",
        "disappear",
        "disappearance",
        "reappearance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bbe3e3b5-6e75-35d1-8c5a-f97b8fa6367e",
                    "sense_definition": "To seem or have a certain appearance; to look a particular way.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>appeared</w> quite happy with the result of the game.",
                            "target_lang_translations": {
                                "ru": "Он <w>казался</w> вполне довольным результатом игры."
                            }
                        },
                        {
                            "text": "The task might <w>appear</w> difficult at first, but it is actually very simple.",
                            "target_lang_translations": {
                                "ru": "Задача может <w>показаться</w> сложной на первый взгляд, но на самом деле она очень простая."
                            }
                        }
                    ],
                    "synonyms": [
                        "look",
                        "see the light of day"
                    ],
                    "common_phrases": [
                        "appear happy",
                        "appear calm",
                        "appear to be"
                    ],
                    "target_lang_definitions": {
                        "ru": "Казаться или иметь определенный вид; выглядеть определенным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "казаться",
                                "target_lang_sense_clarification": "производить впечатление"
                            },
                            {
                                "target_lang_word": "выглядеть",
                                "target_lang_sense_clarification": "иметь внешний вид"
                            },
                            {
                                "target_lang_word": "показаться",
                                "target_lang_sense_clarification": "произвести впечатление (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d336e655-5dfa-3642-bea6-4319867488da",
                    "sense_definition": "To come into sight or become visible.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small boat began to <w>appear</w> on the horizon as the sun rose.",
                            "target_lang_translations": {
                                "ru": "С восходом солнца на горизонте начала <w>появляться</w> маленькая лодка."
                            }
                        },
                        {
                            "text": "Suddenly, a ghost <w>appeared</w> in the middle of the dark room.",
                            "target_lang_translations": {
                                "ru": "Внезапно посреди темной комнаты <w>появилось</w> привидение."
                            }
                        }
                    ],
                    "synonyms": [
                        "emerge",
                        "materialize",
                        "come forth"
                    ],
                    "antonyms": [
                        "disappear",
                        "vanish"
                    ],
                    "common_phrases": [
                        "suddenly appear",
                        "appear in sight",
                        "appear from nowhere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Появляться в поле зрения или становиться видимым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появляться",
                                "target_lang_sense_clarification": "становиться видимым"
                            },
                            {
                                "target_lang_word": "появиться",
                                "target_lang_sense_clarification": "возникнуть в поле зрения"
                            },
                            {
                                "target_lang_word": "показаться",
                                "target_lang_sense_clarification": "стать заметным"
                            },
                            {
                                "target_lang_word": "возникать",
                                "target_lang_sense_clarification": "внезапно появляться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a67bfda-99f4-3221-9966-64362fc58973",
                    "sense_definition": "To come before the public, such as in a performance, publication, or broadcast.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "public_presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous actor will <w>appear</w> on stage for the first time this year.",
                            "target_lang_translations": {
                                "ru": "Знаменитый актер впервые в этом году <w>появится</w> на сцене."
                            }
                        },
                        {
                            "text": "Her name <w>appeared</w> in the newspapers after she won the local competition.",
                            "target_lang_translations": {
                                "ru": "Ее имя <w>появилось</w> в газетах после того, как она выиграла местный конкурс."
                            }
                        }
                    ],
                    "common_phrases": [
                        "appear on stage",
                        "appear in print",
                        "appear on television"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предстать перед публикой, например, в спектакле, публикации или эфире."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступать",
                                "target_lang_sense_clarification": "на сцене или публично"
                            },
                            {
                                "target_lang_word": "появляться",
                                "target_lang_sense_clarification": "в печати или на экране"
                            },
                            {
                                "target_lang_word": "фигурировать",
                                "target_lang_sense_clarification": "упоминаться в списках или документах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c869e398-13ad-3aac-8231-e066afd76fe0",
                    "sense_definition": "To become obvious or manifest to the mind; to be known as a fact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>appears</w> that we have made a mistake in our calculations.",
                            "target_lang_translations": {
                                "ru": "<w>Похоже</w>, что мы допустили ошибку в расчетах."
                            }
                        },
                        {
                            "text": "From the evidence, it <w>appears</w> likely that the project will succeed.",
                            "target_lang_translations": {
                                "ru": "Судя по фактам, <w>представляется</w> вероятным, что проект будет успешным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "it appears that",
                        "make it appear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться очевидным или ясным для ума; становиться известным как факт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выясняться",
                                "target_lang_sense_clarification": "становиться известным"
                            },
                            {
                                "target_lang_word": "казаться",
                                "target_lang_sense_clarification": "судя по всему"
                            },
                            {
                                "target_lang_word": "оказываться",
                                "target_lang_sense_clarification": "в итоге быть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5dee07b-9d1f-3e4f-a373-2239b6fdd245",
                    "sense_definition": "To formally present oneself before an authority or a court of law.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness was required to <w>appear</w> before the judge on Tuesday morning.",
                            "target_lang_translations": {
                                "ru": "Свидетель был обязан <w>явиться</w> к судье во вторник утром."
                            }
                        },
                        {
                            "text": "He failed to <w>appear</w> in court and a warrant was issued for his arrest.",
                            "target_lang_translations": {
                                "ru": "Он не <w>явился</w> в суд, и был выдан ордер на его арест."
                            }
                        }
                    ],
                    "common_phrases": [
                        "appear in court",
                        "appear before a judge"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально явиться в органы власти или в суд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "являться",
                                "target_lang_sense_clarification": "официально прибывать"
                            },
                            {
                                "target_lang_word": "явиться",
                                "target_lang_sense_clarification": "предстать перед судом"
                            },
                            {
                                "target_lang_word": "предстать",
                                "target_lang_sense_clarification": "перед судьей или властью"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}