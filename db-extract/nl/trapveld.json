                    {
                        "sense_id": "cbc48dde-a6bc-3168-9b6c-af71d628bd04",
                        "entry_id": "d6b7096a-7649-3e4f-8a4c-0a49f8f8a03b",
                        "glosses": [
                            "een klein voetbalveld waar kinderen buiten clubverband straatvoetbal kunnen beoefenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbad517a-09b8-420e-9719-e1c2ec4ec066",
                                "sense_id": "cbc48dde-a6bc-3168-9b6c-af71d628bd04",
                                "text": "Tubbergen mag 84.000 euro tegemoet zien om in de wijk, waarvan Havezathe deel uitmaakt, een kunstgras-trapveld voor de jeugd te maken."
                            },
                            {
                                "example_id": "f844f8e4-f25c-4ecf-84dd-6170665b15d2",
                                "sense_id": "cbc48dde-a6bc-3168-9b6c-af71d628bd04",
                                "text": "Er komt een andere plek voor het trapveldje dat nu nog is gelegen aan de Havezatestraat in Tubbergen. Het veld moet er op de nieuwe locatie ongeveer net zo uit komen te zien als het huidige trapveld. Voor de jongste jeugd komt er op de huidige plek aan de Havezatestraat een veldje terug."
                            },
                            {
                                "example_id": "d6e4f411-c2da-4e33-9dae-c5722f98191a",
                                "sense_id": "cbc48dde-a6bc-3168-9b6c-af71d628bd04",
                                "text": "Van de Verenigde Staten tot Maleisië en van Denemarken tot Zuid-Afrika. Overal ter wereld liggen Cruyff Courts. De moderne trapveldjes staan voor het belang van buitenspelen, saamhorigheid in de buurt en veiligheid. Het is de meest in het oog springende nalatenschap van Johan Cruijff als weldoener."
                            }
                        ]
                    }
