                    {
                        "sense_id": "9681a70d-6fc4-3c13-9ea6-2e497718cb65",
                        "entry_id": "4f9405a6-4020-3578-a54d-a5279959cea8",
                        "glosses": [
                            "Appareil propre à provoquer une déflagration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5647cfe2-e154-45df-a3c0-267c6fb3ad08",
                                "sense_id": "9681a70d-6fc4-3c13-9ea6-2e497718cb65",
                                "text": "Au début des années 1820, Hare avait mis au point le « déflagrateur galvanique », une nouvelle batterie voltaïque composée de grandes plaques qui servait à créer de puissantes et rapides combustions."
                            },
                            {
                                "example_id": "4d24d65c-f6a0-4ed5-8907-2efacb49e35a",
                                "sense_id": "9681a70d-6fc4-3c13-9ea6-2e497718cb65",
                                "text": "Le programme de recherche HFD (Déflagrateur à Haute Fréquence), initié par le Dr Michael Ranger, avait pour but de contrecarrer le problème du réchauffement."
                            },
                            {
                                "example_id": "36455d11-1621-499c-ada3-7b69e2c9102a",
                                "sense_id": "9681a70d-6fc4-3c13-9ea6-2e497718cb65",
                                "text": "Non seulement on utilisera des armes nucléaires et bactériologiques mais Singapour a mis au point un déflagrateur sismique capable de ravager des régions entières."
                            }
                        ]
                    }
                ],
