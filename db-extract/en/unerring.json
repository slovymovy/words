                    },
                    {
                        "form_id": "e3ac4dd4-c074-45fb-a1e4-8e43cdeea328",
                        "entry_id": "33b7b43f-9e79-30ce-a394-dedc63eef8c6",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unerring"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91baae47-aaf3-3e73-b032-fbbd0bdf1fcb",
                        "entry_id": "33b7b43f-9e79-30ce-a394-dedc63eef8c6",
                        "glosses": [
                            "consistently accurate; not missing a target."
                        ],
                        "tags": [
                            "figuratively",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "01a431d4-6a89-4607-83f6-9a21924c7a49",
                                "sense_id": "91baae47-aaf3-3e73-b032-fbbd0bdf1fcb",
                                "text": "1717: Hissing in air the unerring weapon flew. -- John Dryden's 1697–1700 translation of \"The Story of Meleager and Atalanta\", in Ovid's Metamorphoses (tr. Garth, Dryden, et al.), book VIII, pub. 1717"
                            },
                            {
                                "example_id": "15bfbe66-f083-4b3c-8b04-434b872bd5b4",
                                "sense_id": "91baae47-aaf3-3e73-b032-fbbd0bdf1fcb",
                                "text": "One learns, as one goes through life, to spot goofiness in the other sex with an unerring eye [...]"
                            },
                            {
                                "example_id": "01705276-b3a0-429f-8d32-274646ddc7e8",
                                "sense_id": "91baae47-aaf3-3e73-b032-fbbd0bdf1fcb",
                                "text": "As the assassination of Sadat proved, the Arab irredentists, like the Zionist ultras, have always been unerring in picking off any incipient mediators."
                            },
                            {
                                "example_id": "130dba52-c48c-481b-8799-ab83b69dd977",
                                "sense_id": "91baae47-aaf3-3e73-b032-fbbd0bdf1fcb",
                                "text": "Debutant Mateo Retegui was the beneficiary of poor work from Harry Maguire, whose failed attempt to close down the danger on the edge of the box allowed the Italians to shift the ball to the 23-year-old to drill an unerring finish past Jordan Pickford after 56 minutes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5451976d-6eed-402a-b836-ff36bca15d83",
                        "source_entry_id": "33b7b43f-9e79-30ce-a394-dedc63eef8c6",
                        "source_sense_id": "91baae47-aaf3-3e73-b032-fbbd0bdf1fcb",
                        "source_sense_description": "consistently accurate",
                        "target_lang_word": "onfeilbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onfeilbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "37c9ceae-9af4-3b63-bf05-f39a2f1e3f70",
                                        "entry_id": "b4f1b48c-ffb9-35ec-8264-d775c1a8e040",
                                        "glosses": [
                                            "niet kunnen falen, altijd goed werkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e3857f-4d19-4207-903b-374ea271471f",
                                                "sense_id": "37c9ceae-9af4-3b63-bf05-f39a2f1e3f70",
                                                "text": "De zogenaamde onfeilbare kerncentrale was toch minder veilig dan altijd werd gedacht."
                                            },
                                            {
                                                "example_id": "429a81a8-3288-4f5e-b02c-6226273ec7e3",
                                                "sense_id": "37c9ceae-9af4-3b63-bf05-f39a2f1e3f70",
                                                "text": "Toen de onfeilbaare leraar een fout maakte dachten alle leerlingen dat ze hem niet goed hadden verstaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2522d2e0-33e7-4e21-8b34-83f450fb30c0",
                        "source_entry_id": "33b7b43f-9e79-30ce-a394-dedc63eef8c6",
                        "source_sense_id": "91baae47-aaf3-3e73-b032-fbbd0bdf1fcb",
                        "source_sense_description": "consistently accurate",
                        "target_lang_word": "unfehlbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfehlbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                        "entry_id": "57c14571-f3c6-38c7-aece-f1f62ccd3a8d",
                                        "glosses": [
                                            "keine Fehler machend, sich nie irrend; in seinen Entscheidungen und Urteilen keinem Fehler oder Irrtum unterworfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2c8f4c-8726-4d82-a91a-adda1a97437a",
                                                "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                                "text": "Besonders dann, wenn er [Bernd Stromberg] emotional aufgewühlt ist, spricht er nur in halben Sätzen, gibt sich aber trotzdem als fast unfehlbarer Chef aus."
                                            },
                                            {
                                                "example_id": "4240c4c2-a619-452d-9229-2da8eec6ce18",
                                                "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                                "text": "Mao wurde nicht länger als unfehlbarer Heiliger verehrt, sondern kritisch hinterfragt."
                                            },
                                            {
                                                "example_id": "e80766d2-4348-4dec-be64-33539a43528e",
                                                "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                                "text": "Der Gutachter weiß, dass er nicht unfehlbar ist."
                                            },
                                            {
                                                "example_id": "040d373f-95b5-4dc3-877d-3ae11860b626",
                                                "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                                "text": "Vor 140 Jahren, im Dezember 1869,wurde das Erste Vatikanische Konzil eröffnet. Im Kampf gegen liberale Strömungen ließ sich Papst Pius IX. dabei für unfehlbar erklären."
                                            },
                                            {
                                                "example_id": "60cfe970-9420-4679-9333-ff174035426d",
                                                "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                                "text": "Mit seinem weißen Haar, seiner sonoren Stimme und der ruhigen, überlegenen Ausstrahlung war Greene auf die Darstellung moralisch unfehlbarer Autoritätsfiguren spezialisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef20adcd-a72f-4e7a-ab09-ec501e8233bd",
                        "source_entry_id": "33b7b43f-9e79-30ce-a394-dedc63eef8c6",
