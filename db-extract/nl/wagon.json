                    {
                        "translation_id": "a2b4fdb8-eb1d-4607-827d-2562d2a6cf25",
                        "source_entry_id": "ac5c1763-a309-3443-903f-dd663774e79b",
                        "source_sense_id": "3b74cc1f-9b8e-3995-bf9f-a9468ecbd80b",
                        "source_sense_description": "een voertuig dat deel uitmaakt van een trein",
                        "target_lang_word": "wagon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wagon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb0f395-5fa9-3c06-abb5-e1ec4a85def8",
                                        "entry_id": "bf1f2c70-579f-35dd-8bd1-6235e77a9055",
                                        "glosses": [
                                            "Véhicule sur rails employé par les chemins de fer pour transporter des marchandises ou des voyageurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1313bab4-f68c-49aa-8ced-adc4fc553aee",
                                                "sense_id": "fbb0f395-5fa9-3c06-abb5-e1ec4a85def8",
                                                "text": "La minière de Rauboudin, près Sommerance, est très-bien installée ; les terres chargées dans des wagons qui roulent sur un petit chemin de fer, servent à remblayer l’excavation au fur et à mesure de l'avancement."
                                            },
                                            {
                                                "example_id": "cdeeee30-d73f-48ad-9109-06410c4a53cd",
                                                "sense_id": "fbb0f395-5fa9-3c06-abb5-e1ec4a85def8",
                                                "text": "Quand elle fut installée dans le wagon réservé aux dames seules, elle éprouva un véritable soulagement."
                                            },
                                            {
                                                "example_id": "077febe7-05be-40a1-af87-6fa999f3a831",
                                                "sense_id": "fbb0f395-5fa9-3c06-abb5-e1ec4a85def8",
                                                "text": "À ce moment, la guerre tomba brutalement, sans crier gare. Le deuxième jour de mobilisation, Fagerolle se vit jeté dans un wagon à bestiaux, parmi les vomissures et les gueulements patriotiques d’un certain nombre de citoyens français."
                                            },
                                            {
                                                "example_id": "3535cc65-6951-4097-85c5-bb4a7bd3c26b",
                                                "sense_id": "fbb0f395-5fa9-3c06-abb5-e1ec4a85def8",
                                                "text": "Dans le train de Cherbourg à Paris, le hasard voulut que je trouvasse comme compagnon de wagon un de mes anciens camarades."
                                            },
                                            {
                                                "example_id": "c18111a0-9c84-48ef-ade3-9b2c2979c1cb",
                                                "sense_id": "fbb0f395-5fa9-3c06-abb5-e1ec4a85def8",
                                                "text": "Ces wagons, d’un usage très commode, sont réunis l’un à l’autre par des passerelles, suivant le système américain. Au lieu d’être chambré dans un compartiment, le voyageur peut circuler sur toute la longueur du train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "213aa152-8c31-3ba2-b4c5-64f50ba80233",
                                        "entry_id": "bf1f2c70-579f-35dd-8bd1-6235e77a9055",
                                        "glosses": [
                                            "Vieille femme usée par la débauche."
                                        ],
