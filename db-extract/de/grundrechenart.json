                "senses": [
                    {
                        "sense_id": "f522c6ee-9096-3d6a-aa6c-15d7918615ad",
                        "entry_id": "32ba15bc-533e-3d0b-85c3-cb40d43073ba",
                        "glosses": [
                            "eine der folgenden vier grundlegenden mathematischen Operationen auf Zahlen: Addition, Subtraktion, Multiplikation oder Division"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9bf151-e6e6-4cba-9eb5-48a48db17207",
                                "sense_id": "f522c6ee-9096-3d6a-aa6c-15d7918615ad",
                                "text": "Die erste Grundrechenart, die Schüler lernen, ist meist die Addition."
                            },
                            {
                                "example_id": "a09d110c-d4ed-4ae2-ab41-02206e18dc5b",
                                "sense_id": "f522c6ee-9096-3d6a-aa6c-15d7918615ad",
                                "text": "Zwei Grundrechenarten gelten als Erweiterung der anderen beiden, welche sind diese?"
                            },
                            {
                                "example_id": "59bd5af0-69ab-4d4d-8610-e032843cb279",
                                "sense_id": "f522c6ee-9096-3d6a-aa6c-15d7918615ad",
                                "text": "„Ohne die Grundrechenarten kann man weder das Kolosseum bauen noch einen Militärapparat aufrechterhalten und schon gar nicht ein kalkulierbares Steuersystem etablieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
