                    {
                        "translation_id": "4cda9bac-d7c2-46ef-b50c-2c4d140443f1",
                        "source_entry_id": "cbe1752c-e45a-3ed8-b18a-0336df66575c",
                        "source_sense_id": "95c8231c-c071-37bb-98e7-1b1c33ac27a7",
                        "source_sense_description": "(fascism) an authoritarian leader, especially Benito Mussolini",
                        "target_lang_word": "ду́че",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ду́че",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f830830c-5cba-31a9-bcc4-ecee9057e988",
                                        "entry_id": "4cc32224-8435-3a62-99f1-b2765dda52de",
                                        "glosses": [
                                            "истор. титул Бенито Муссолини в качестве главы правительства Италии и лидера Национальной фашистской партии в 1922–1945 гг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2fee903-9bcb-4039-8ee3-0fb2de1517c9",
                                                "sense_id": "f830830c-5cba-31a9-bcc4-ecee9057e988",
                                                "text": "Интеллектуалы во множестве окружали Бенито Муссолини, причём многие из поклонников дуче не были итальянцами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59eea1d-2f41-3754-8849-79d8cf436e3c",
                                        "entry_id": "4cc32224-8435-3a62-99f1-b2765dda52de",
                                        "glosses": [
                                            "ирон. глава авторитарного государства; лидер авторитарной организации; авторитарный руководитель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a88615a4-9e81-4fe8-b659-579199acff21",
                                                "sense_id": "e59eea1d-2f41-3754-8849-79d8cf436e3c",
                                                "text": "С одной стороны, никак нельзя одобрить постноябрьские действия туркменского дуче: мировое общественное мнение не позволит, да и память россиян, не забывших сталинские процессы, оскорблена будет."
                                            },
                                            {
                                                "example_id": "a2b712e2-80ec-41a2-abd9-a9ea977a967f",
                                                "sense_id": "e59eea1d-2f41-3754-8849-79d8cf436e3c",
                                                "text": "Номер «Юности» с «Цитрусами» уже был готов к выпуску, когда Килькичев затребовал вёрстку повести. Выпуск был остановлен. Прошло несколько дней, и Ваксон вместе с главным редактором Луговым были вызваны к идеологическому дуче."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
