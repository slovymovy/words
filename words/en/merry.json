                        {
                            "text": "They spent the afternoon sharing <w>merry</w> tales of their childhood adventures.",
                            "target_lang_translations": {
                                "ru": "Они провели день, делясь <w>весёлыми</w> рассказами о своих детских приключениях."
                            }
                        }
                    ],
                    "synonyms": [
                        "delightful",
                        "gladful"
                    ],
                    "common_phrases": [
                        "merry jest",
                        "merry tale"
                    ],
                    "target_lang_definitions": {
