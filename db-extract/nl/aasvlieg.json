                "senses": [
                    {
                        "sense_id": "d808f8a6-2e0c-3cba-816c-38785d5c8fd8",
                        "entry_id": "20c8bcbe-3c3f-32f2-bf8f-fc6c44e4eb6d",
                        "glosses": [
                            "bepaalde vlieg die op kadavers eieren legt"
                        ],
                        "tags": [
