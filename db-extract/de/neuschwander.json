                ],
                "senses": [
                    {
                        "sense_id": "3691e8ee-cc3f-33f1-801c-8f205c3998cb",
                        "entry_id": "476302f7-0bc9-329e-a9d4-4884f1ee84cc",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3783fe00-d922-475d-b18f-ca869567ded2",
                                "sense_id": "3691e8ee-cc3f-33f1-801c-8f205c3998cb",
                                "text": "Frau Neuschwander ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3b02a077-a1d6-4efd-88ae-5d63b86244b5",
                                "sense_id": "3691e8ee-cc3f-33f1-801c-8f205c3998cb",
                                "text": "Herr Neuschwander wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9aa60260-6c03-40d9-94d1-bb4e1cd9550e",
                                "sense_id": "3691e8ee-cc3f-33f1-801c-8f205c3998cb",
                                "text": "Die Neuschwanders fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bb6d7f5a-45f7-4ed0-ac5f-59cdcdaa6d3e",
                                "sense_id": "3691e8ee-cc3f-33f1-801c-8f205c3998cb",
                                "text": "Der Neuschwander trägt nie die Schals, die die Neuschwander ihm strickt."
                            },
                            {
                                "example_id": "c49bd7ff-f354-462d-9545-90a999a058ec",
                                "sense_id": "3691e8ee-cc3f-33f1-801c-8f205c3998cb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Neuschwander kommt, geht der Herr Neuschwander.“"
                            },
                            {
                                "example_id": "f8da5162-1b2a-4216-9a5c-88e17e87554e",
                                "sense_id": "3691e8ee-cc3f-33f1-801c-8f205c3998cb",
                                "text": "Neuschwander kommt und geht."
                            },
                            {
                                "example_id": "0d223612-b164-4676-8b9c-2dba20fcccf6",
                                "sense_id": "3691e8ee-cc3f-33f1-801c-8f205c3998cb",
                                "text": "Neuschwanders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
