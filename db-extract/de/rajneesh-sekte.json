                "senses": [
                    {
                        "sense_id": "4492acf4-6227-3119-9748-97df8522c471",
                        "entry_id": "b7173c8e-0b7c-3140-8737-072c4fd44c61",
                        "glosses": [
                            "von Chandra Mohan Jain (Spitzname Rajneesh) gegründete Sekte/Kult"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "044d264b-90e8-4002-a61c-2717ef7dc429",
                                "sense_id": "4492acf4-6227-3119-9748-97df8522c471",
                                "text": "„Er schließt sich der Rajneesh-Sekte an und nennt sich Swami Puja Detal...“"
                            },
                            {
                                "example_id": "17244bc0-a2ee-44c6-aff6-e7aec1549a60",
                                "sense_id": "4492acf4-6227-3119-9748-97df8522c471",
                                "text": "Die bislang einzige biologische Attacke mittleren Umfangs gab es 1984, als die im US-Bundesstaat Oregon ansässige Rajneesh-Sekte in mehreren Restaurants die Salatbars mit Salmonellen verseuchte und es in der Folge 751 Fälle von Durchfallerkrankungen gab."
                            },
                            {
                                "example_id": "f044bf59-88b4-4e1e-83ac-5a69459251e6",
                                "sense_id": "4492acf4-6227-3119-9748-97df8522c471",
                                "text": "Zwei Mitglieder der religiösen Rajneesh-Sekte vergifteten 1984 Restaurants mit Salmonellen."
                            },
                            {
                                "example_id": "39f304ef-35d9-4ac1-8b8c-88da610a170a",
                                "sense_id": "4492acf4-6227-3119-9748-97df8522c471",
                                "text": "In neuerer Zeit wurden diese spirituellen Lehrtänze zum Beispiel von Mitgliedern der Rajneesh-Sekte wiederbelebt, wodurch ich Gelegenheit zur Einsicht einer Videoaufnahme bekam."
                            },
                            {
                                "example_id": "b334dc8f-f066-4ee4-afbc-614e8e195399",
                                "sense_id": "4492acf4-6227-3119-9748-97df8522c471",
                                "text": "So wurde durch die amerikanische Rajneesh-Sekte in The Dallas im Bundesstaat Oregon im Jahre 1984 in verschiedenen Restaurants insgesamt zehn Salatbars mit Salmonellen kontaminiert, wobei vorübergehend 751 Personen erkrankten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
