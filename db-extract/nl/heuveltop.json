                                        "sense_id": "9c4ced54-38c7-32f1-bda9-f60fe5e1a3e9",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "The plume of feathers, or other decoration, worn on or displayed on a helmet; the distinctive ornament of a helmet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98ff4af2-7805-3bc9-9eda-5a1f8351c35d",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "A bearing worn, not upon the shield, but usually on a helmet above it, sometimes (as for clerics) separately above the shield or separately as a mark for plate, in letterheads, and the like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f87f1790-fad0-4f50-9000-60a3b645c91e",
                                                "sense_id": "98ff4af2-7805-3bc9-9eda-5a1f8351c35d",
                                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                                            }
                                        ]
                                    },
