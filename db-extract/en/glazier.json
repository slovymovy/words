                                            {
                                                "example_id": "b9886e5f-dcb3-44c6-914d-e8dca5574fef",
                                                "sense_id": "00796f9a-6981-3635-91a5-6dd61db8b9f2",
                                                "text": "PSV heeft Santiago Arias gestraft vanwege zijn gedrag na de rode kaart die hij ontving in het duel met Willem II (2-0). De Colombiaanse rechtsback moet zich extra inzetten bij maatschappelijke activiteiten van PSV. Ook moet hij de rekening van de glaszetter betalen. Dat meldt het Eindhovens Dagblad."
                                            },
                                            {
                                                "example_id": "6651cabd-be2a-4a39-8a20-647149e981c3",
                                                "sense_id": "00796f9a-6981-3635-91a5-6dd61db8b9f2",
                                                "text": "Glaszetter Ad van Steyn zei tegen Omroep Brabant dat hij verwacht nog wel even bezig te zijn met de reparaties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
