            "senses": [
                {
                    "sense_id": "f371ce93-fcc2-357f-9411-96a1756498ee",
                    "sense_definition": "zmieniać się, przekształcać się w coś innego, często o większym nasileniu lub innym charakterze (zwykle w połączeniu z „się”)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transformacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niewinna sprzeczka powoli <w>przeradzała</w> się w poważny i głośny konflikt między sąsiadami.",
                            "target_lang_translations": {
                                "ru": "Невинная ссора медленно <w>перерастала</w> в серьёзный и громкий конфликт между соседями."
                            }
                        },
                        {
                            "text": "Na jego twarzy pojawił się wyraz wstrętu, który powoli <w>przeradzał</w> się w udrękę.",
                            "target_lang_translations": {
                                "ru": "На его лице появилось выражение отвращения, которое медленно <w>перерастало</w> в муку."
                            }
                        }
                    ],
                    "synonyms": [
                        "przekształcać się",
                        "przemieniać się",
                        "ewoluować",
                        "przeistaczać się"
                    ],
                    "common_phrases": [
                        "przeradzać się w konflikt",
                        "przeradzać się w pasję",
                        "powoli przeradzać się w"
                    ],
                    "target_lang_definitions": {
                        "ru": "постепенно изменяться, превращаться во что-то другое, часто с большей силой или иным характером (обычно с «się»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерастать",
                                "target_lang_sense_clarification": "в другое качество или более серьезную форму"
                            },
                            {
                                "target_lang_word": "перерождаться",
                                "target_lang_sense_clarification": "превращаться, трансформироваться во что-то иное"
                            },
                            {
                                "target_lang_word": "превращаться",
                                "target_lang_sense_clarification": "становиться чем-то иным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0b1c7f3-fe58-32ad-b918-90659c761e53",
                    "sense_definition": "powodować całkowitą zmianę czegoś, przekształcać coś w coś innego",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transformacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowy dyrektor powoli <w>przeradzał</w> małe przedsiębiorstwo w prężnie działającą korporację.",
                            "target_lang_translations": {
                                "ru": "Новый директор постепенно <w>превращал</w> маленькое предприятие в динамично развивающуюся корпорацию."
                            }
                        },
                        {
                            "text": "Swoją pasją i ciężką pracą artysta <w>przeradzał</w> codzienne chwile w niezwykłe dzieła sztuki.",
                            "target_lang_translations": {
                                "ru": "Своей страстью и тяжёлым трудом художник <w>преобразовывал</w> повседневные моменты в необыкновенные произведения искусства."
                            }
                        }
                    ],
                    "synonyms": [
                        "przemieniać",
                        "przekształcać",
                        "przeistaczać"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать коренное изменение чего-либо, преобразовывать что-либо во что-то иное"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преобразовывать",
                                "target_lang_sense_clarification": "коренным образом менять что-либо"
                            },
                            {
                                "target_lang_word": "превращать",
                                "target_lang_sense_clarification": "делать чем-то иным"
                            },
                            {
                                "target_lang_word": "трансформировать",
                                "target_lang_sense_clarification": "изменять структуру или сущность чего-либо"
                            }
                        ]
                    }
