                                "example_id": "80155d77-e1ae-45e5-b8da-9a65c9dd40e9",
                                "sense_id": "2d1ea32b-914e-3823-9842-43b4866de591",
                                "text": "Elles s’auto-gavent et sont très appréciées aussi pour leur chair savoureuse."
                            },
