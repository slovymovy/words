                "senses": [
                    {
                        "sense_id": "3d90637d-a6af-3823-ab7a-cccd3910d0dd",
                        "entry_id": "20bffcff-f27d-380c-9359-c58afe94d2a4",
                        "glosses": [
                            "Firmenangestellter mit vielen Vollmachten für Handelsabschlüsse seiner Firma; Inhaber der Prokura"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc748635-456f-4af8-a2fb-e6551835e8e2",
                                "sense_id": "3d90637d-a6af-3823-ab7a-cccd3910d0dd",
                                "text": "Der Prokurist unterzeichnete nach ausgiebiger Prüfung der Unterlagen den Vertrag."
                            },
                            {
                                "example_id": "2aabfa2b-e831-4554-861a-9615075b83cb",
                                "sense_id": "3d90637d-a6af-3823-ab7a-cccd3910d0dd",
                                "text": "„‚Guten Morgen, Herr Samsa,‘ rief der Prokurist freundlich dazwischen. ‚Ihm ist nicht wohl,‘ sagte die Mutter zum Prokuristen, während der Vater noch an der Tür redete, ‚ihm ist nicht wohl, glauben Sie mir, Herr Prokurist. Wie würde denn Gregor sonst einen Zug versäumen! (...)“"
                            },
                            {
                                "example_id": "b6a066a1-a93e-4d9b-a657-04038e91add6",
                                "sense_id": "3d90637d-a6af-3823-ab7a-cccd3910d0dd",
                                "text": "„Der Prokurist will seinem Chef nach dem Mund reden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c059672f-e467-412f-ba38-5729c2669ae4",
                        "source_entry_id": "20bffcff-f27d-380c-9359-c58afe94d2a4",
                        "source_sense_id": "3d90637d-a6af-3823-ab7a-cccd3910d0dd",
                        "source_sense_description": "Firmenangestellter mit vielen Vollmachten für Handelsabschlüsse seiner Firma; Inhaber der Prokura",
                        "target_lang_word": "fondé de pouvoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondé de pouvoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96c36d77-c734-3d3e-96dd-71e647756186",
                                        "entry_id": "72cd611c-b663-3cc8-a8f1-ce4e35845e9a",
                                        "glosses": [
                                            "Mandataire social qui effectue, par délégation, certaines opérations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7df9535e-1c10-470f-977b-9379f225de47",
                                                "sense_id": "96c36d77-c734-3d3e-96dd-71e647756186",
                                                "text": "Pour être receveur, on n’a pas besoin de savoir le latin ni le grec ; j’aurai, comme M. Peirotte, un fondé de pouvoir qui fera toute la besogne."
                                            },
                                            {
                                                "example_id": "96b8bdb1-94f2-424b-8bcc-5bdac07ebc7a",
                                                "sense_id": "96c36d77-c734-3d3e-96dd-71e647756186",
                                                "text": "Il s’est entendu chez les Soviets avec un fondé de pouvoir d’une fabrique de stupéfiants et lui en a commandé officiellement de la bigornette, sous prétexte de la fournir à d’autres maisons établies dans des pays où le système des certificats n’existe pas."
                                            },
                                            {
                                                "example_id": "49e67a2d-f28f-4fbe-979c-782b553dea62",
                                                "sense_id": "96c36d77-c734-3d3e-96dd-71e647756186",
                                                "text": "Il était le fondé de pouvoir de Van Leghen et c’était lui qui avait prévenu la police."
                                            },
                                            {
                                                "example_id": "8eb854b4-66b6-46dc-8559-962ff90dbafa",
                                                "sense_id": "96c36d77-c734-3d3e-96dd-71e647756186",
                                                "text": "Il s’appelait Georges Pompidou, futur Premier ministre, futur président de la République, il était alors fondé de pouvoir à la Banque Rothschild, on dirait aujourd’hui directeur."
                                            },
                                            {
                                                "example_id": "ce878968-71e4-482a-b2c2-eb7f94fa4ebe",
                                                "sense_id": "96c36d77-c734-3d3e-96dd-71e647756186",
                                                "text": "Les grands centres bourgeois et leurs fondés de pouvoir ont cette obsession: le contrôle de la populace indigène."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
