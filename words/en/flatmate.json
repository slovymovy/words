                    "frequency": "Middle",
                    "semantic_group_id": "cohabitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even though we live in a large house, I still refer to him as my <w>flatmate</w>.",
                            "target_lang_translations": {
                                "ru": "Хотя мы живем в большом доме, я все равно называю его своим <w>соседом по квартире</w>."
                            }
                        },
                        {
                            "text": "The <w>flatmate</w> who owned the house was ranting all night about her girlfriend.",
                            "target_lang_translations": {
