                ],
                "senses": [
                    {
                        "sense_id": "7b59e4c3-842c-3ffa-af7d-dc033146bf28",
                        "entry_id": "d979ea71-6845-38a7-bd9a-f28c3fff3f37",
                        "glosses": [
                            "Albumen du fruit — nommé noix de tagua — du palmier à ivoire (Phytelephas spp.), durci et devenu de l’ivoire végétal dont on faisait des boutons et des articles de tabletterie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b39d5644-5ef2-4cfa-ad54-d3e9aea543d1",
                                "sense_id": "7b59e4c3-842c-3ffa-af7d-dc033146bf28",
                                "text": "Elle rit, malicieuse, se tord en couleuvre et froisse sa peau délicate à la cheviote du veston, aux durs boutons de corozo…"
                            },
                            {
                                "example_id": "cf4c94a6-de32-4036-bb8c-f948614a4220",
                                "sense_id": "7b59e4c3-842c-3ffa-af7d-dc033146bf28",
                                "text": "Une pâte de corozo, préparée d'après une recette qu'il avait inventée, lui permettait également de fabriquer des dés d'une nuance jaunâtre, comme si l'on s'en était longtemps servi."
                            },
                            {
                                "example_id": "a16ddc46-cee5-4b1f-9f67-715b0fda5a73",
                                "sense_id": "7b59e4c3-842c-3ffa-af7d-dc033146bf28",
                                "text": "J’ai vendu des ciseaux\nEt des lames de rasoir\nDes peignes en corozo\nDes limes et des hachoirs"
                            },
                            {
                                "example_id": "a67ed364-f124-4352-a344-06de1aa4ed4f",
                                "sense_id": "7b59e4c3-842c-3ffa-af7d-dc033146bf28",
                                "text": "Boutons-olives, bleu vif ou vert cru, tous les rouges, verts et bleus des boutons en corozo encore cousus sur des cartons bordés d’un filet doré tout terni."
                            }
                        ]
                    }
                ],
