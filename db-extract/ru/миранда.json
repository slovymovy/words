                "senses": [
                    {
                        "sense_id": "dd36ceef-a37d-342c-8633-f41df63c6d50",
                        "entry_id": "8742d610-0e78-333d-9557-6b0c4e47a01b",
                        "glosses": [
                            "астрон. название спутника планеты Уран"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7370a6b-8eb3-4b5b-b576-500ca0c194e7",
                                "sense_id": "dd36ceef-a37d-342c-8633-f41df63c6d50",
                                "text": "Спутники Урана: на переднем плане — Ариэль, по часовой стрелке от него — Умбриэль, Оберон и Титания, затем Миранда и совсем небольшой спутник Пак."
                            }
                        ]
                    }
