        "fr-extract.jsonl": [
            {
                "entry_id": "782b7ded-ba99-3573-8b71-96a8b44baf66",
                "word": "gegebenenfalls",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "54ddcc3b-d749-3ec4-999a-d7b4ea87d87f",
                        "entry_id": "782b7ded-ba99-3573-8b71-96a8b44baf66",
                        "glosses": [
                            "Peut-être, le cas échéant, si nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3077356e-c2f5-4a38-b87e-f2b8be1a98f2",
                                "sense_id": "54ddcc3b-d749-3ec4-999a-d7b4ea87d87f",
                                "text": "Die Zeiten sind heroisch und unerbittlich: Einen Arbeiter, der fünf Minuten zu spät kommt, stellt man vor das Kriegsgericht, und es sind die Tschekisten, die einsperren, verurteilen und gegebenenfalls mit einer Kugel in den Nacken die Exekution ausführen.",
                                "translation": "Les temps sont héroïques et sévères : un ouvrier qui arrive cinq minutes en retard passe en conseil de guerre et ce sont les tchékistes qui arrêtent, jugent, exécutent le cas échéant, d’une balle dans la nuque."
                            },
                            {
                                "example_id": "8f99d75f-749c-4b1d-b001-4ff84bff68ca",
                                "sense_id": "54ddcc3b-d749-3ec4-999a-d7b4ea87d87f",
                                "text": "Zuletzt wird das Olivenöl wieder in einer Zentrifuge vom Fruchtwasser getrennt, gegebenenfalls gefiltert und in Flaschen oder Kanister abgefüllt.",
                                "translation": "Enfin, l’huile d’olive est séparée du liquide de l’olive dans une centrifugeuse, filtrée si nécessaire, puis mise en bouteille ou en bidon."
                            }
                        ]
                    }
                ],
                "translations": [],
