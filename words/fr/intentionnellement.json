                    "frequency": "Middle",
                    "semantic_group_id": "volontaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a affirmé qu'il n'avait pas agi <w>intentionnellement</w> lors de cette dispute."
                        },
                        {
                            "text": "Le suspect a <w>intentionnellement</w> caché des preuves essentielles pour tromper la police."
                        }
                    ],
                    "synonyms": [
