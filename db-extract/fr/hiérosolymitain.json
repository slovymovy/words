                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e55540d-143c-3e00-b77d-7d52037d30aa",
                        "entry_id": "ed16dda6-7288-3a91-b877-0c44121be641",
                        "glosses": [
                            "Habitant de Jérusalem ^([1])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dfa68f5-6ab1-4b72-a8c8-4f5aeb0c99f3",
                                "sense_id": "4e55540d-143c-3e00-b77d-7d52037d30aa",
                                "text": "Aaron est un Hiérosolymitain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f28fd62-e2e1-4dc8-8cee-d12e90103dfc",
                        "source_entry_id": "ed16dda6-7288-3a91-b877-0c44121be641",
                        "source_sense_id": "4e55540d-143c-3e00-b77d-7d52037d30aa",
                        "target_lang_word": "Jerusalemer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jerusalemer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf753cfa-f875-3709-8416-6fae661df4e1",
                                        "entry_id": "d262f685-6ed3-3f06-88e2-4d23f15bed9f",
                                        "glosses": [
                                            "Einwohner von Jerusalem, in Jerusalem geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53d21a3e-f4d5-464d-8eda-fe9ef0722d75",
                                                "sense_id": "cf753cfa-f875-3709-8416-6fae661df4e1",
                                                "text": "„Nachdem die Kommission ihr Büro in der Jerusalemer Jaffa Street eröffnet hatte, verwendeten die Mitglieder anfangs einen Großteil ihrer Energie auf die Bearbeitung der zahllosen Anfragen, mit denen die Juden, insbesondere die Jerusalemer, sie überschwemmten.“"
                                            },
                                            {
                                                "example_id": "63b6aade-1d0e-42a2-b8a4-7b19729bfe48",
                                                "sense_id": "cf753cfa-f875-3709-8416-6fae661df4e1",
                                                "text": "„Beschlagnahmung von Land, Zerstörung von Häusern und Vertreibung von Jerusalemern, die nach israelischen Willkürentscheidungen ihren Wohnsitz verloren hatten, wurden immer häufiger.“"
                                            },
                                            {
                                                "example_id": "72cb0935-48b0-40d3-8313-80be2f5da8c4",
                                                "sense_id": "cf753cfa-f875-3709-8416-6fae661df4e1",
                                                "text": "„1953 wurde in Jerusalem eine Flugschrift verbreitet, die gegen Kastner die schlimmsten Vorwürfe erhob. Verfasser war ein Malkiel Grünwald, ein älterer, allein zurückgebliebener Jerusalemer und mürrischer religiöser Extremist.“"
                                            },
                                            {
                                                "example_id": "bab0f276-f54e-4921-b571-e4dc92a76d65",
                                                "sense_id": "cf753cfa-f875-3709-8416-6fae661df4e1",
                                                "text": "„Auch brachte der jordanische Staat ostentativ zum Ausdruck, dass auf die mit der besonderen Heiligkeit des Tempelbergs verbundenen Traditionen der palästinensischen Jerusalemer Rücksicht genommen werde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Jerusalemer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                        "entry_id": "1dcd4791-8f91-3124-be38-4158220155e8",
                                        "glosses": [
                                            "sich auf Jerusalem beziehend, aus Jerusalem kommend, zu Jerusalem gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70420744-5be1-435b-923e-2428df6fe936",
                                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                                "text": "„Ein Jerusalemer Junge berichtete, ein türkischer Soldat habe ihm auf dem Schulweg sein angebissenes Fladenbrot aus der Hand gerissen.“"
                                            },
                                            {
                                                "example_id": "d4425fbc-f059-4d08-be1c-246a01668eb0",
                                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                                "text": "„Aber der Hagana-Angriff signalisierte den Beginn einer Reihe von Offensiven gegen palästinensische Dörfer an den Westhängen der Jerusalemer Berge, vor allem gegen das Dorf Lifta, das selbst nach Geheimdiensterkenntnissen der Hagana nie Konvois angegriffen hatte.“"
                                            },
                                            {
                                                "example_id": "ad47b63d-f42b-4908-9e52-0162a18b8e9b",
                                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                                "text": "„Huda nahm sie daraufhin sofort aus den Jerusalemer Schulen.“"
                                            },
                                            {
                                                "example_id": "7d5c7d7e-2442-4df1-9f5b-fafb648029fb",
                                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                                "text": "„Der Graben öffnete sich zwischen den Anhängern des Mufti, die keinen Kompromiss mit den Briten wollten, und den Gegnern des Mufti, die eher versöhnlich eingestellt waren, angeführt vom ehemaligen Jerusalemer Bürgermeister Raghib an-Naschaschibi.“"
                                            },
                                            {
                                                "example_id": "e4ebd145-0099-4d71-b26d-d7c649e71b33",
                                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                                "text": "„Nicht zuletzt gab es in der Arabischen Exekutive von Anfang an Fehden zwischen den führenden Jerusalemer Familien, insbesondere den Husseinis und den Naschaschibis, so dass sie rasch in Bedeutungslosigkeit versank.“"
                                            },
                                            {
                                                "example_id": "23fae3c3-720d-44cc-b143-f335700730cd",
                                                "sense_id": "922edf6e-d6bf-3a36-8be5-2db868581bf4",
                                                "text": "„Aber eines Tages sah ich den afrikanischen Herrscher auf unserer Terrasse unter einem Sonnenschirm sitzen, der ihn vor der sengenden Jerusalemer Sonne schützte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
