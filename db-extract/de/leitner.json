                        "examples": [
                            {
                                "example_id": "7912b6c5-d2fd-4ae4-8441-6e1464a27092",
                                "sense_id": "1a2222b6-0d99-37ed-be31-aeb35999cf69",
                                "text": "Leitner laboriert an einer Sehnenreizung im Knie, Khedira fällt mit einem Muskelfaserriss aus."
                            },
                            {
                                "example_id": "7a8640e8-d407-46e5-ac98-b39a254d71f2",
                                "sense_id": "1a2222b6-0d99-37ed-be31-aeb35999cf69",
                                "text": "Akademiker bekommen keine festen Jobs und keine Kinder mehr? Von wegen, sagt der Hochschulforscher Martin Leitner."
                            }
                        ],
