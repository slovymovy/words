            "senses": [
                {
                    "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                    "sense_definition": "die Gesamtheit aller Zähne im Kiefer eines Menschen oder Tieres",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das menschliche <w>Gebiss</w> besteht bei einem Erwachsenen normalerweise aus zweiunddreißig Zähnen."
                        },
                        {
                            "text": "Der Zahnarzt lobte ihr gesundes <w>Gebiss</w> nach der gründlichen Untersuchung."
                        }
                    ],
                    "common_phrases": [
                        "menschliches Gebiss",
                        "gesundes Gebiss"
                    ]
                },
                {
                    "sense_id": "5f60e8fa-391a-370b-9952-af016c09d885",
                    "sense_definition": "eine herausnehmbare Prothese, die fehlende Zähne im Mund ersetzt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zahnmedizin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Großvater legt sein <w>Gebiss</w> jeden Abend in ein Glas mit Wasser."
                        },
                        {
                            "text": "Nach dem Verlust mehrerer Zähne musste sie sich ein neues <w>Gebiss</w> anfertigen lassen."
                        }
                    ],
                    "synonyms": [
                        "Zahnersatz",
                        "dritte Zähne",
                        "Zahnprothese"
                    ],
                    "common_phrases": [
                        "ein Gebiss tragen",
                        "das Gebiss reinigen",
                        "künstliches Gebiss"
                    ]
                },
                {
                    "sense_id": "1e7770b4-340c-3c86-82a0-a52d197f5aff",
                    "sense_definition": "das Mundstück des Zaumzeugs beim Pferd zur Steuerung beim Reiten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reitsport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Reiterin schob dem Pferd vorsichtig das metallene <w>Gebiss</w> ins Maul."
                        },
                        {
                            "text": "Vor dem Ausritt kontrollierte er sorgfältig, ob das <w>Gebiss</w> richtig und bequem saß."
                        }
                    ],
                    "synonyms": [
                        "Trense"
                    ]
                }
            ]
        }
