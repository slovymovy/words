                "senses": [
                    {
                        "sense_id": "eaa2aab5-dd58-3a7c-a8c6-f968676551ed",
                        "entry_id": "52277a8e-6e0d-3595-b864-cce965ed7b78",
                        "glosses": [
                            "A word, phrase, number or any other sequence of units which has the property of reading the same forwards as it does backwards, character for character, sometimes disregarding punctuation, capitalization and diacritics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9dba087-0f0e-4915-a8d6-349d3e164555",
                                "sense_id": "eaa2aab5-dd58-3a7c-a8c6-f968676551ed",
                                "text": "The only thing exciting about 2002 is that it's a palindrome."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a2f5d25-96fd-34e4-bf48-32b5f4a1bb41",
                        "entry_id": "52277a8e-6e0d-3595-b864-cce965ed7b78",
                        "glosses": [
                            "A poetic form in which the sequence of words reads the same in either direction."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "723ce7a8-fa30-3888-8176-9698949584dc",
                        "entry_id": "52277a8e-6e0d-3595-b864-cce965ed7b78",
                        "glosses": [
                            "A sequence of items that follows the same pattern both forwards and backwards."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4c763291-c478-4e4d-a122-f757b50021b2",
                                "sense_id": "723ce7a8-fa30-3888-8176-9698949584dc",
                                "text": "A conjunct palindrome from notes 5 to 11, D D E F E D D, abuts the only melodically disjunct group E G D (notes 12–14), and at the same time contributes to a melodic sequence with the opening four notes."
                            },
                            {
                                "example_id": "58612897-f1c2-4abf-974d-0546ba3520f2",
                                "sense_id": "723ce7a8-fa30-3888-8176-9698949584dc",
                                "text": "The shops opposite were a High Street palindrome — Korean gorocery, courier service, letting abgents, courier service, Korean grocery — and buses passed with noisy frequency."
                            },
                            {
                                "example_id": "34963238-f674-4bd1-a49c-b78234d0eb13",
                                "sense_id": "723ce7a8-fa30-3888-8176-9698949584dc",
                                "text": "The color sequence in the palindrome skein is the same no metter whether you start from the left or right."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbb3e29c-ec5c-3b7c-a784-47cfaae0e42f",
                        "entry_id": "52277a8e-6e0d-3595-b864-cce965ed7b78",
                        "glosses": [
                            "A stretch of DNA in which the sequence of nucleotides on one strand are in the reverse order to that of the complementary strand"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
