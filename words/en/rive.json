                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрываться или производить выстрел, особенно в контексте артиллерии или взрывов."
