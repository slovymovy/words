                "senses": [
                    {
                        "sense_id": "96f2387e-2f97-3f00-994d-210857a59f85",
                        "entry_id": "651241e6-510f-3adb-b2c9-fb61230d950a",
                        "glosses": [
                            "Sorte d'engin motorisé à deux roues qui servait à ramasser les crottes de chiens sur les trottoirs de Paris."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "519c5059-3f5a-4b90-8e95-4cfe84008576",
                                "sense_id": "96f2387e-2f97-3f00-994d-210857a59f85",
                                "text": "Jacques Chirac ne laissera sans doute son nom dans l'histoire, comme le fit avant lui le préfet Poubelle, que parce qu'il inventé la chiraclette, la moto à ramasser le caca du chien."
                            },
                            {
                                "example_id": "cacb6763-66a0-4a5b-8f57-32a7b675e3ea",
                                "sense_id": "96f2387e-2f97-3f00-994d-210857a59f85",
                                "text": "AU PLACARD, les « chiraclettes » ! Mises en service par le président Jacques Chirac au début des années 1980 lorsqu'il était maire de la capitale, les fameuses motocrottes coûtent trop cher à la municipalité et ne sont pas assez efficaces : […]."
                            },
                            {
                                "example_id": "fcfacb9f-6b2c-4add-8c24-425dca4823a3",
                                "sense_id": "96f2387e-2f97-3f00-994d-210857a59f85",
                                "text": "Une chiraclette, ces motos ramasse-merde de la capitale, aurait déclaré forfait. Il fallait directement faire appel à la benne."
                            }
                        ]
                    }
