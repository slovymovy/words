                "senses": [
                    {
                        "sense_id": "00718dd0-40bd-3b34-b85d-681c6af8fad9",
                        "entry_id": "d5de4d5f-c7f5-34c4-8434-edcd1076c6de",
                        "glosses": [
                            "A tree of species Genipa americana, native to the tropical forests of North and South America, as well as the Caribbean; genipap."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e3d34846-77f3-4864-b818-23dafb2e15eb",
                                "sense_id": "00718dd0-40bd-3b34-b85d-681c6af8fad9",
                                "text": "The jagua tree is, in fact, one of the most well-disbursed native trees of the rainforests."
                            },
                            {
                                "example_id": "cd1f16a0-5573-41f6-8a0e-7e7fe89aa91d",
                                "sense_id": "00718dd0-40bd-3b34-b85d-681c6af8fad9",
                                "text": "Some Indians used a preparation concocted from the fruit of the jagua tree (Genipa americana), a sixty-foot-high deciduous tree that grows in much of tropical America and produces an elliptical yellow-brown fruit about the size of an orange."
                            },
                            {
                                "example_id": "1b860531-be20-4ded-94bc-e8d0a10e09da",
                                "sense_id": "00718dd0-40bd-3b34-b85d-681c6af8fad9",
                                "text": "Genipa americana L., or jagua, is a tree that grows (mostly) wild in Latin America."
                            }
                        ]
                    },
                    {
                        "sense_id": "f245a227-1b59-341b-afde-344f9786e76f",
                        "entry_id": "d5de4d5f-c7f5-34c4-8434-edcd1076c6de",
                        "glosses": [
                            "The oval-shaped fruit of this tree; genipap."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "89e1fd2a-a58d-465c-968b-890efaf9e508",
                                "sense_id": "f245a227-1b59-341b-afde-344f9786e76f",
                                "text": "Nothing is wasted— leaves are used to make baskets, the juice of the jagua fruit is applied as a mosquito repellent, and the river provides fresh water for bathing."
                            },
                            {
                                "example_id": "dfca5785-f17d-4461-9bf4-22e42889cf49",
                                "sense_id": "f245a227-1b59-341b-afde-344f9786e76f",
                                "text": "This concoction, which Estellita Lins claims capable of dissolving a candiru lodged in the urethra, is a hot tea made from jagua juice. Jagua is the fruit of the tropical tree Genipa americana."
                            },
                            {
                                "example_id": "26aa5113-529e-4ddc-93f9-2c22ae7536d4",
                                "sense_id": "f245a227-1b59-341b-afde-344f9786e76f",
                                "text": "Within its indigenous habitat, Jagua (Genipa americana) was and is used to summon strength, give protection in war, induce transformation, attract mates, bring on menstruation and connect to spirits, amongst other things! It is a very multi- faceted and dynamic fruit, and it is an important part of rituals throughout the Amazon basin and Caribbean, including present day Venezuela, Peru, Mexico, Puerto Rico, Suriname, Guyana, Trinidad, Ecuador, Panama, Brazil and Columbia."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1e867c9-0278-3bf2-a8eb-4c9536ab9339",
                        "entry_id": "d5de4d5f-c7f5-34c4-8434-edcd1076c6de",
                        "glosses": [
                            "The extract of this fruit, used as a dye for temporary body art and tattoos that stain the upper layer of the skin."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "29b95b9c-d382-4d92-89af-ca7fdfb22814",
                                "sense_id": "e1e867c9-0278-3bf2-a8eb-4c9536ab9339",
                                "text": "Coordinate term: henna"
                            }
                        ]
                    },
