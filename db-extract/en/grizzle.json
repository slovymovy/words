                                "example_id": "bbdf4062-2921-4884-bafc-c0f1c4f6cf8d",
                                "sense_id": "d53fd1b5-e2ce-3b4c-a15c-8a3a2c31db0b",
                                "text": "Pall Mall Magazine\nI found myself on the Nubian desert shaking hands with a grizzling man whom men addressed as Collins Bey."
                            }
