    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89c800c4-f4f3-3f0f-a067-8ca7e57eca36",
                    "sense_definition": "A common green plant with narrow leaves that grows on the ground in fields, gardens, and parks.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plant_matter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cows are eating fresh <w>grass</w> in the field.",
                            "target_lang_translations": {
                                "ru": "Коровы едят свежую <w>траву</w> на поле.",
                                "zh": "奶牛正在田野里吃新鲜的<w>草</w>。"
                            }
                        },
                        {
                            "text": "We sat on the green <w>grass</w> to have our lunch.",
                            "target_lang_translations": {
                                "ru": "Мы сели на зеленую <w>траву</w>, чтобы пообедать.",
                                "zh": "我们坐在绿色的<w>草地</w>上吃午饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lawn"
                    ],
                    "common_phrases": [
                        "green grass",
                        "blade of grass",
                        "wet grass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зеленое растение с узкими листьями, растущее на земле в полях, садах и парках.",
                        "zh": "一种常见的绿色植物，叶片细长，生长在田野、花园和公园的地面上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трава",
                                "target_lang_sense_clarification": "растение"
                            },
                            {
                                "target_lang_word": "зелень",
                                "target_lang_sense_clarification": "растительность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草",
                                "target_lang_sense_clarification": "植物总称"
                            },
                            {
                                "target_lang_word": "青草",
                                "target_lang_sense_clarification": "新鲜的草"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b247a10-7080-3ac9-a4da-b882b2cbc1a8",
                    "sense_definition": "An area of ground covered with short, mown grass, usually in a garden or park.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plant_matter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My father cuts the <w>grass</w> every Saturday morning.",
                            "target_lang_translations": {
                                "ru": "Мой отец стрижет <w>газон</w> каждое субботнее утро.",
                                "zh": "我父亲每周六早上都会修剪<w>草坪</w>。"
                            }
                        },
                        {
                            "text": "Please keep off the <w>grass</w> while walking in the park.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не ходите по <w>газону</w> во время прогулки в парке.",
                                "zh": "在公园散步时，请勿践踏<w>草坪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lawn",
                        "turf"
                    ],
                    "common_phrases": [
                        "cut the grass",
                        "mow the grass",
                        "keep off the grass"
