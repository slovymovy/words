                        "centre du village"
                    ]
                },
                {
                    "sense_id": "e86f1ddb-ff91-3a36-8ff8-06cfdb9c755d",
                    "sense_definition": "Ensemble des habitants d'une petite communauté rurale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "population",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le <w>village</w> est venu sur la place pour assister aux festivités estivales."
                        },
                        {
                            "text": "La nouvelle s'est vite propagée et le <w>village</w> entier n'a parlé que de cet événement."
                        }
                    ],
                    "common_phrases": [
                        "tout le village"
                    ]
                },
                {
                    "sense_id": "7cc58157-a11e-3929-9a80-268be620fb2c",
                    "sense_definition": "Groupement d'habitations distinct du bourg principal ; hameau.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "habitat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette région, les habitants appellent <w>village</w> ce que l'administration qualifie de simple écart."
                        },
                        {
                            "text": "Sa ferme se trouvait dans un petit <w>village</w> à l'écart du bourg central."
                        }
                    ],
                    "synonyms": [
                        "hameau"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Usité notamment dans certaines régions de France comme le Limousin"
                        }
                    ]
                },
                {
                    "sense_id": "10983e30-2e82-356a-8614-51990830edb6",
                    "sense_definition": "Dénomination géographique complémentaire pour un vin issu d'un terroir plus restreint et qualitatif au sein d'une appellation.",
