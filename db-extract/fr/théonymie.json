                        "examples": [
                            {
                                "example_id": "3c399e95-327c-46cb-ac9e-0f4fb99266a3",
                                "sense_id": "2e9b651d-f4fd-3b8b-9e3a-eb506359fb7e",
                                "text": "Entre théonymie et anthroponymie : l'onomastique divine et humaine."
