                ],
                "translations": [
                    {
                        "translation_id": "33635218-4a60-44b4-b888-ada8baf43806",
                        "source_entry_id": "5cf5cfcc-0a80-316f-b5ad-2a24a7c59cda",
                        "source_sense_id": "aa882d5e-9d7d-36e9-b56a-0bb887dbb15b",
                        "source_sense_description": "town in Corrèze Department",
                        "target_lang_word": "Tulle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tulle",
