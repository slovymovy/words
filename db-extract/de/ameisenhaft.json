                ],
                "senses": [
                    {
                        "sense_id": "f67ee47e-2f9c-3e00-b059-dbed364eb198",
                        "entry_id": "a434a6a2-4888-3acb-8874-828e14406905",
                        "glosses": [
                            "in gewisser Hinsicht mit Ameisen vergleichbar, ihnen ähnlich: so emsig, so klein, so wuselig oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a83e91c-eff9-4284-a53b-3e371f1c1c25",
                                "sense_id": "f67ee47e-2f9c-3e00-b059-dbed364eb198",
                                "text": "„Sicheres über die Persönlichkeit jenes hünenhaften Mannes verdanken wir einem kleinwüchsigen und ameisenhaft geschäftigen Gelehrten.“"
                            },
                            {
                                "example_id": "c0c1278a-9ad9-49f8-beb8-692ed52bc201",
                                "sense_id": "f67ee47e-2f9c-3e00-b059-dbed364eb198",
                                "text": "„Doch oben auf dem Kamm des Faulhorns sieht man ameisenhafte Gestalten, kurz keimt Hoffnung auf.“"
                            },
                            {
                                "example_id": "a3f5ee66-2bcb-4469-b330-66aecc75690d",
                                "sense_id": "f67ee47e-2f9c-3e00-b059-dbed364eb198",
                                "text": "„Die wiederum spiegelt sich in Andreas Gurskys riesigen Bildern von vermassten Orten der Welt: dem Gewimmel der Hongkonger Börse, der Uniformität einer klotzigen Hotelarchitektur, der ameisenhaften Menschenkette auf einer Langlaufloipe im Engadin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
