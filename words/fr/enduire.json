    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ddfe178d-2460-306c-8792-0da54d3809c6",
                    "sense_definition": "Recouvrir une surface d'une matière grasse, liquide ou pâteuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut d'abord <w>enduire</w> le moule de beurre avant de verser la pâte."
                        },
                        {
                            "text": "L'ouvrier a soigneusement <w>enduit</w> la pièce de bois d'une colle spéciale pour meubles."
                        }
                    ],
                    "common_phrases": [
                        "enduire de colle",
                        "enduire de graisse"
                    ]
                },
                {
                    "sense_id": "8ee51f57-09d3-3dc6-9bf5-c6b9e6e50244",
                    "sense_definition": "Appliquer un enduit ou du plâtre sur une maçonnerie pour la protéger ou la lisser.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "batiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan va <w>enduire</w> la façade de la maison pour la protéger contre la pluie."
                        },
                        {
                            "text": "Avant de peindre le salon, nous avons <w>enduit</w> tous les murs avec du plâtre fin."
                        }
                    ],
                    "common_phrases": [
                        "enduire un mur",
                        "enduire une façade"
                    ]
                },
                {
                    "sense_id": "a3f410d6-9605-3b1f-8207-b495750f29a2",
                    "sense_definition": "Frotter le corps ou une partie du corps avec une huile ou un baume.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "soin_rituel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce rituel ancien, le prêtre <w>enduisait</w> le front des fidèles d'une huile bénite."
                        },
                        {
                            "text": "Le médecin traditionnel a décidé d'<w>enduire</w> la blessure douloureuse d'un onguent réparateur."
                        }
                    ],
                    "synonyms": [
                        "oindre"
                    ],
                    "common_phrases": [
                        "enduire de baume"
                    ]
                }
            ]
        }
    ]
