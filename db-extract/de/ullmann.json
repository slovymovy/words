                ],
                "senses": [
                    {
                        "sense_id": "31098f93-1840-3529-b7a7-cf33a5ee2ff4",
                        "entry_id": "204ec6c6-8173-3242-b9f2-ef0beb2c339e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06eef6d5-6253-4b53-a6bb-3e44a5fb5572",
                                "sense_id": "31098f93-1840-3529-b7a7-cf33a5ee2ff4",
                                "text": "Frau Ullmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4fb35f72-0c69-4011-954c-579b32f7b48e",
                                "sense_id": "31098f93-1840-3529-b7a7-cf33a5ee2ff4",
                                "text": "Herr Ullmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8ba322c1-9768-411a-9aee-added32674ad",
                                "sense_id": "31098f93-1840-3529-b7a7-cf33a5ee2ff4",
                                "text": "Die Ullmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "eb04c913-9e82-4dbc-9f84-0d4f369b4170",
                                "sense_id": "31098f93-1840-3529-b7a7-cf33a5ee2ff4",
                                "text": "Der Ullmann trägt nie die Schals, die die Ullmann ihm strickt."
                            },
                            {
                                "example_id": "83e1673c-6ea3-4d9e-a0b8-4a701fc469d2",
                                "sense_id": "31098f93-1840-3529-b7a7-cf33a5ee2ff4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ullmann kommt, geht der Herr Ullmann.“"
                            },
                            {
                                "example_id": "d8e6ce55-1719-46ea-83ba-b0c2839cc3ce",
                                "sense_id": "31098f93-1840-3529-b7a7-cf33a5ee2ff4",
                                "text": "Ullmann kommt und geht."
                            },
                            {
                                "example_id": "58f91dd0-01f7-4503-a928-268f394280f7",
                                "sense_id": "31098f93-1840-3529-b7a7-cf33a5ee2ff4",
                                "text": "Ullmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
