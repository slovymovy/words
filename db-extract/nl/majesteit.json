                        ],
                        "examples": [
                            {
                                "example_id": "b78c0ae8-d074-411c-b7c2-6462fbf3eed3",
                                "sense_id": "dd27d005-c13b-3cd0-8f58-7be12a1032ce",
                                "text": "We konden 't echt niet geloven / Het was ongeveer vijf voor acht / Programma's werden verschoven / Wie had er zoiets nou verwacht / Natuurlijk het moest er van komen / Maar waarom dan toch nog zo snel / Ons bloed ging er sneller van stromen / Een majesteit zegt ons vaarwel",
                                "translation": "We really couldn't believe it / It was about five to eight / Programs were rescheduled / Who would have expected such a thing / Of course it had to happen / But still, why so soon / It made our blood run faster / A queen bids us farewell",
                                "english": "We really couldn't believe it / It was about five to eight / Programs were rescheduled / Who would have expected such a thing / Of course it had to happen / But still, why so soon / It made our blood run faster / A queen bids us farewell"
                            }
                        ]
