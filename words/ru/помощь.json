{
    "word_family": [
        "помогать",
        "помощник",
        "помощница",
        "помощный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cff466b4-9ecf-34b9-931f-2a2dc8427097",
                    "sense_definition": "действие, направленное на облегчение чьих-либо трудностей или выполнение задачи",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "help",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он нуждается в постороней <w>помощи</w>.",
                            "target_lang_translations": {
                                "en": "He needs outside <w>help</w>."
                            }
                        },
                        {
                            "text": "Большое спасибо за вашу <w>помощь</w>!",
                            "target_lang_translations": {
                                "en": "Thank you very much for your <w>help</w>!"
                            }
                        }
                    ],
                    "synonyms": [
                        "поддержка",
                        "содействие",
                        "подмога"
                    ],
                    "antonyms": [
                        "препятствие",
                        "помеха"
                    ],
                    "common_phrases": [
                        "оказать помощь",
                        "прийти на помощь"
                    ],
                    "target_lang_definitions": {
                        "en": "An action taken to provide assistance, support, or to help someone overcome difficulties or complete a task."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "help",
                                "target_lang_sense_clarification": "General term for assistance or aid provided to someone."
                            },
                            {
                                "target_lang_word": "assistance",
                                "target_lang_sense_clarification": "A more formal term for help or support."
                            },
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "Giving help or encouragement to someone in need."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f86a5ee1-7d92-39ec-9310-0707d8b6d145",
                    "sense_definition": "материальные средства или ресурсы, предоставляемые для поддержки нуждающихся",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "help",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Государство выделило гуманитарную <w>помощь</w> пострадавшим от наводнения.",
                            "target_lang_translations": {
                                "en": "The government provided humanitarian <w>aid</w> to the flood victims."
                            }
                        },
                        {
                            "text": "Семья получила финансовую <w>помощь</w> от благотворительного фонда.",
                            "target_lang_translations": {
                                "en": "The family received financial <w>assistance</w> from a charitable foundation."
                            }
                        }
                    ],
                    "synonyms": [
                        "пособие"
                    ],
                    "common_phrases": [
                        "получить помощь",
                        "материальная помощь"
                    ],
                    "target_lang_definitions": {
                        "en": "Material resources, funds, or supplies provided to support those in need, such as victims of disasters or the underprivileged."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aid",
                                "target_lang_sense_clarification": "Material or financial help, often used in humanitarian contexts."
                            },
                            {
                                "target_lang_word": "relief",
                                "target_lang_sense_clarification": "Assistance provided to people in urgent need, especially after a disaster."
                            },
                            {
                                "target_lang_word": "financial assistance",
                                "target_lang_sense_clarification": "Specific monetary support provided to individuals or groups."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0266ed3-8742-3390-952c-19339da14e63",
                    "sense_definition": "справочное руководство или раздел программы с инструкциями",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "help",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Откройте <w>помощь</w> в программе, чтобы узнать настройки.",
                            "target_lang_translations": {
                                "en": "Open the <w>help</w> section in the program to learn about the settings."
                            }
                        },
                        {
                            "text": "В разделе <w>помощь</w> подробно описаны все функции приложения.",
                            "target_lang_translations": {
                                "en": "The <w>help</w> section describes all the application's functions in detail."
                            }
                        }
                    ],
                    "synonyms": [
                        "справка"
                    ],
                    "common_phrases": [
                        "раздел помощь"
                    ],
                    "target_lang_definitions": {
                        "en": "A reference guide, manual, or a section within software that provides instructions and information to the user."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "help",
                                "target_lang_sense_clarification": "The standard term for the documentation or support section in software."
                            },
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "Often used to refer to the section providing technical guidance or customer service."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}