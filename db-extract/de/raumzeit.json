                ],
                "senses": [
                    {
                        "sense_id": "a4276d78-ea58-3383-ae85-37f4e640fbd1",
                        "entry_id": "6ddc32cb-e0af-3c65-9981-5bda6c245987",
                        "glosses": [
                            "durch die Relativitätstheorie vorhergesagte Vereinigung von Raum und Zeit in einer einheitlichen vierdimensionalen Struktur"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "9be33d93-05e5-42c0-8090-a13c356b9228",
                                "sense_id": "a4276d78-ea58-3383-ae85-37f4e640fbd1",
                                "text": "„Doch als Einstein 1912 nach Zürich zurückkehrte, hatte er den glücklichen Einfall, dass die Äquivalenz gültig bliebe, wenn die Geometrie der Raumzeit nicht flach, wie bislang angenommen, sondern gekrümmt wäre. Er stellte sich vor, Masse und Energie verzerrten die Raumzeit in irgendeiner Weise, die es noch zu bestimmen galt. Unter dieser Prämisse würden Objekte wie Äpfel oder Planeten versuchen, sich in geradestmöglicher Weise durch die Raumzeit zu bewegen, doch schiene ihre Bahn ähnlich wie in Anwesenheit eines Newtonschen Gravitationsfeldes verbogen zu werden, weil die Raumzeit gekrümmt wäre (Abb.1.12).“"
                            },
                            {
                                "example_id": "09ad3ad7-6cf8-450d-a77d-2d6cb393582b",
                                "sense_id": "a4276d78-ea58-3383-ae85-37f4e640fbd1",
                                "text": "„Die verlorene Zeit aber konnte sie nicht mehr aufholen. Einstein sei Dank: Mit Ringlasern lässt sich die Raumzeit verändern »Diese Uhr ist wie ein Zeitreisender aus der Vergangenheit, der zu uns in die Zukunft gekommen ist«, sagt Mallett. Einstein hatte also recht, allein die Richtung war falsch.“"
                            },
                            {
                                "example_id": "b765cfc0-08ef-416e-a249-79093c5217c8",
                                "sense_id": "a4276d78-ea58-3383-ae85-37f4e640fbd1",
                                "text": "„Seine Theorie lässt sich folgendermaßen beschreiben: Alles im Universum bewegt sich durch die Raumzeit mit einer gleichen absoluten Geschwindigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec96d330-24e6-4244-97b6-8c196aea3d51",
                        "source_entry_id": "6ddc32cb-e0af-3c65-9981-5bda6c245987",
                        "source_sense_id": "a4276d78-ea58-3383-ae85-37f4e640fbd1",
                        "target_lang_word": "spacetime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spacetime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16e69b8b-56e5-3e3b-af6c-6d41d8a16a83",
                                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                                        "glosses": [
                                            "The four-dimensional continuum of the three spatial dimensions plus time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7efebab4-cbec-449e-b404-1922421a8c42",
                                                "sense_id": "16e69b8b-56e5-3e3b-af6c-6d41d8a16a83",
                                                "text": "An event is a point in spacetime, specified by the coordinates x, y, z, and t."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                                        "glosses": [
                                            "An n-dimensional continuum consisting of dimensions of both space and time. Normally spacetime is considered as having 4 dimensions (x, y, z, t), but higher-dimensional spacetimes are often encountered in theoretical physics, e.g. the 5-dimensional spacetime of Kaluza-Klein theory or the 11 dimensions of spacetime in M-theory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "449834e5-d90b-4dec-9dd6-f49bbd03ff84",
                                                "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                                "text": "a Minkowski spacetime"
                                            },
                                            {
                                                "example_id": "19c21672-6a07-494e-9bc9-46f5323605ce",
                                                "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                                "text": "a 5-dimensional spacetime"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                                        "glosses": [
                                            "A specific region of the universe with mathematically different properties than the surrounding spacetime. Synonymous with \\\"metric\\\" within the context of general relativity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ddca0af-1816-4592-b5a0-c9f59a4baa9c",
                                                "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                                "text": "a Schwarzschild spacetime"
                                            },
                                            {
                                                "example_id": "23689b37-c434-4c81-8e00-92b84bbf842f",
                                                "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                                "text": "a Reissner-Nordström spacetime"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
