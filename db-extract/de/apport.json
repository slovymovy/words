                        "examples": [
                            {
                                "example_id": "db7bce4b-1988-4175-a8fc-f9ded8f26da1",
                                "sense_id": "8fda70af-6d36-3880-a59a-a9c571357fc0",
                                "text": "Hans Castorp, seinen Apport in der Brusttasche, hatte nichts dagegen, den ausgearteten Abend mit den anderen Herren auf Albins Zimmer mit einem Kognak zu beschließen, denn er fand, daß Vorkommnisse gleich diesen zwar weder auf das Herz noch auf den Geist, wohl aber auf die Magennerven Wirkung übten – und zwar eine nachhaltige Wirkung, so, wie der Seekranke wohl noch am Lande stundenlang die übelkeiterregenden Schwankungen zu spüren meint.",
                                "translation": "Hans Castorp, with his apport in his breast pocket, had nothing against ending the degenerate evening with the other gentlemen in Albin's room with a brandy, because he found that events like these had no effect on the heart or the mind, but did the stomach nerves exerted an effect - and a lasting effect, just as the seasick person probably thinks he can feel the nauseating fluctuations for hours on land.",
                                "english": "Hans Castorp, with his apport in his breast pocket, had nothing against ending the degenerate evening with the other gentlemen in Albin's room with a brandy, because he found that events like these had no effect on the heart or the mind, but did the stomach nerves exerted an effect - and a lasting effect, just as the seasick person probably thinks he can feel the nauseating fluctuations for hours on land."
                            }
                        ]
                    }
