                        "target_lang_word": "schlummern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlummern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87d32a1d-dd23-3af2-9daa-d868cf8adf77",
                                        "entry_id": "d439fc9d-a1b3-37d6-a7a8-8801361ac99e",
                                        "glosses": [
                                            "ruhig, seicht schlafen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ad4d22-07c0-43c5-8dc7-b0d13a3cc806",
                                                "sense_id": "87d32a1d-dd23-3af2-9daa-d868cf8adf77",
                                                "text": "Seid bitte leise, er schlummert noch!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fc61d7f-0c0d-3d53-b207-8516a9e771be",
                                        "entry_id": "d439fc9d-a1b3-37d6-a7a8-8801361ac99e",
                                        "glosses": [
                                            "noch im Verborgenen sein"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d289532a-27b1-4661-b431-215717b646a8",
                                                "sense_id": "4fc61d7f-0c0d-3d53-b207-8516a9e771be",
                                                "text": "Viele unentdeckte Talente schlummern noch in ihm."
                                            },
                                            {
                                                "example_id": "5b114e30-647d-4258-8de2-8e22ba9f4e9d",
                                                "sense_id": "4fc61d7f-0c0d-3d53-b207-8516a9e771be",
                                                "text": "„Schon vor einigen Jahrzehnten vermutete die Fachwelt, dass die Holzfragmente in Aberdeen schlummern, doch das Universitätsmuseum konnte die Stücke nicht ausfindig machen.“"
                                            }
                                        ],
