                        "tags": [],
                        "examples": [
                            {
                                "example_id": "504f8dd9-b01e-4fee-a2bf-9d9d4851caed",
                                "sense_id": "7a45a92e-324d-33fa-a250-453f5cb22076",
                                "text": "„Das Grundproblem aber dürfte wohl sein, dass Amandas Vorannahme nicht stimmt.“"
                            },
                            {
                                "example_id": "45c2a737-5ce0-4fa3-b8b8-04b3f5bcbc84",
                                "sense_id": "7a45a92e-324d-33fa-a250-453f5cb22076",
                                "text": "„Eine Alternative könnte recyceltes WC-Papier sein - doch häufig lautet die Vorannahme: zu kratzig.“"
                            },
                            {
                                "example_id": "4bd3049f-8ea3-43e9-8f4f-dc33786ef22a",
                                "sense_id": "7a45a92e-324d-33fa-a250-453f5cb22076",
                                "text": "„Dabei gilt offenbar die Vorannahme, dass jede Art der Versammlung zu einem höheren Infektionsrisiko führt.“"
                            },
                            {
                                "example_id": "716bbed3-d770-421a-a724-4a9737e816d0",
                                "sense_id": "7a45a92e-324d-33fa-a250-453f5cb22076",
                                "text": "„Manfred Kuehn kennt diese Vorannahme und versucht, nach Kräften dagegen anzugehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
