                                "target_senses": [
                                    {
                                        "sense_id": "29f91ae9-7056-31cc-b130-e0d75e7a356c",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "The state of being formal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038fe986-feac-4e68-9584-77fbf87a458a",
                                                "sense_id": "29f91ae9-7056-31cc-b130-e0d75e7a356c",
                                                "text": "[S]uch an one […] recalls as a vision of Paradise the land he has learnt to love; he exaggerates the insalubrity of a northern climate; he bewails the wretched formality of our civilised life, and so, back to the distant solitudes flies his recollection like a dove to the wilderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dbfd038-34fb-38c7-9e39-797513f6149f",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "Something said or done as a matter of form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a09a9cc8-d6f9-3fd4-9a42-ecccac545f40",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "A customary ritual without substance, real consequence, or unique meaning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ab4b6f-fc87-433f-aa5e-8152d71c368d",
                                                "sense_id": "a09a9cc8-d6f9-3fd4-9a42-ecccac545f40",
                                                "text": "The examination for priesthood is no mere formality, so we have to study well."
