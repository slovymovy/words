                        "entry_id": "da2d5a96-563b-3f97-802e-51604fb3d242",
                        "glosses": [
                            "weibliches Kind, das von Pflegeeltern betreut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7951543-7307-4248-8afe-65f1f093ae05",
                                "sense_id": "0ca3cdff-11bd-36c8-a237-a13eb16ec4a7",
                                "text": "Manche Eltern nehmen zusätzlich zu ihren eigenen Kindern auch eine Ziehtochter auf."
                            },
                            {
                                "example_id": "58186cb2-d195-40f1-a4fd-2e5f7c5083a5",
                                "sense_id": "0ca3cdff-11bd-36c8-a237-a13eb16ec4a7",
                                "text": "„Sie können sich lange daran freuen, wie gut die Ziehtochter in dem ihr einst so fremden Land Fuß gefasst hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
