                "senses": [
                    {
                        "sense_id": "f740723a-8141-36c3-8e60-f980b73a858c",
                        "entry_id": "8b3551ff-ada4-3f09-8b07-d35af94ccc91",
                        "glosses": [
                            "Donner un caractère de plus en plus discount à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ceef372-a377-40ac-88c4-5ff4b9e8df28",
                                "sense_id": "f740723a-8141-36c3-8e60-f980b73a858c",
                                "text": "En clair: pendant que Carrefour, Auchan ou Leclerc se «discountisaient», Lidl ou Aldi optaient pout le «soft discount»."
                            },
                            {
                                "example_id": "be011b92-fc2c-41b5-9072-f13b76803be5",
                                "sense_id": "f740723a-8141-36c3-8e60-f980b73a858c",
                                "text": "Ce problème, c'est le problème de la petite épicerie familiale face à l'hyper, et ça se retrouve dans tout les domaines. Tout est \"discountisé\"."
                            },
                            {
                                "example_id": "b989c295-07b4-47c0-8c41-1306a59a0612",
                                "sense_id": "f740723a-8141-36c3-8e60-f980b73a858c",
                                "text": "On est dans un monde qui se \"discountise\" sans baisser les prix, c'est la recherche du profit maximal."
                            }
                        ]
                    }
