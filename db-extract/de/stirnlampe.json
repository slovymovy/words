                ],
                "senses": [
                    {
                        "sense_id": "8f604269-edc3-34de-bb51-ef091115142e",
                        "entry_id": "601e9955-da12-31d3-8b00-d920206e8070",
                        "glosses": [
                            "tragbare Lampe, die am Kopf befestigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b3559b6-990e-4a23-8a58-1feab73d9db9",
                                "sense_id": "8f604269-edc3-34de-bb51-ef091115142e",
                                "text": "Beim Nachtangeln tragen die Angler meist eine Stirnlampe."
                            },
                            {
                                "example_id": "adef8d70-4901-4eaf-bf92-ad5ef982c6fb",
                                "sense_id": "8f604269-edc3-34de-bb51-ef091115142e",
                                "text": "„Zu den Dingen, die man für eine Grönlandfahrt im Sommer zu Hause lassen kann, gehört die Stirnlampe für Nachtwanderungen.“"
                            },
                            {
                                "example_id": "d42c6397-63c5-4bc7-9bc8-e1915559ff88",
                                "sense_id": "8f604269-edc3-34de-bb51-ef091115142e",
                                "text": "„Die Stirnlampe beleuchtet einen Ausschnitt, der kaum mehr als ein paar Beine und etwas Geröll erfasst.“"
                            },
                            {
                                "example_id": "78dd22d6-1d2a-4858-8bc2-342473da2c3a",
                                "sense_id": "8f604269-edc3-34de-bb51-ef091115142e",
                                "text": "„Ich knipste das Licht meiner Stirnlampe aus und lauschte in die nächtliche Dunkelheit.“"
                            },
                            {
                                "example_id": "7662a972-be0c-41fe-9568-2c9d171a72ea",
                                "sense_id": "8f604269-edc3-34de-bb51-ef091115142e",
                                "text": "„Der funkelnde Sternenhimmel über uns sieht genauso eiskalt wie der im Licht der Stirnlampe funkelnde Reif aus, der unsere Zelte bedeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
