                            {
                                "example_id": "38c9fa7d-b2c9-4005-a8b1-2be3f1ff12b4",
                                "sense_id": "6520a974-fbc1-3afe-8d59-d21ef218093e",
                                "text": "„Zuvor hatte die Regierung, um Kenneth Kaundas wackelndes Regime im Wahlkampf zu unterstützen, der sambischen Regierung Getreidelieferungen geschickt, so dass die Silos in Simbabwe selbst leer waren.“"
                            },
                            {
                                "example_id": "72697b94-8bfa-4025-a5c7-6d2c1bd68225",
                                "sense_id": "6520a974-fbc1-3afe-8d59-d21ef218093e",
                                "text": "„Der internationalen Verurteilung folgten Sanktionen, wie ein Technologie-Embargo und die Einstellung amerikanischer Getreidelieferungen.“"
                            }
                        ],
