                ],
                "senses": [
                    {
                        "sense_id": "364a2f7e-5f7f-3057-952b-123896e647db",
                        "entry_id": "73634359-08fd-3a66-8d86-e6c63ce08543",
                        "glosses": [
                            "Unité de mesure de grandeurs logarithmiques du Système international (SI), valant 10⁻⁹ bel, et dont le symbole est nB."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "56c07c87-313a-4155-bd97-4a5e93d83918",
                                "sense_id": "364a2f7e-5f7f-3057-952b-123896e647db",
                                "text": "Le nanobel exprime les rapports entre grandeurs de même espèce : 10⁹ nanobels signifient un rapport dont le logarithme décimal est l’unité (10⁹ nB → 10:1) ; un nanobel signifie un rapport dont le logarithme décimal vaut 10⁻⁹ (1 nB → ~1,000 000 002 303:1)."
                            },
                            {
                                "example_id": "5aebec5a-9bb8-4177-8827-96fbe3699f57",
                                "sense_id": "364a2f7e-5f7f-3057-952b-123896e647db",
                                "text": "Mais ces doigts fabuleux lui permettent, en même temps, de varier à l’infini son toucher, de doser au nanobel près l’intensité de chaque note […]"
                            }
                        ]
                    }
                ],
