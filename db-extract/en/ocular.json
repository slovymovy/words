                                    {
                                        "sense_id": "3ab23a49-210b-3b09-8947-280b3a8bb00f",
                                        "entry_id": "702be3d2-2f10-3c98-a796-a140a336ba1e",
                                        "glosses": [
                                            "týkající se oka nebo očí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b73d4f1-f8d4-464f-86c0-28a625c29ab3",
                                                "sense_id": "3ab23a49-210b-3b09-8947-280b3a8bb00f",
                                                "text": "Obličej měla zsinalý, víčka oční pevně semknutá, ústa pootevřená — jakoby chtěla volati o pomoc."
                                            }
                                        ]
                                    }
                                ]
                            },
