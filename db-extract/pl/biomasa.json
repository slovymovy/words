                    },
                    {
                        "sense_id": "947a0000-75d7-3e35-ac7d-b2d240386a97",
                        "entry_id": "c52bd37d-871d-375f-b778-eca9a86a2bc7",
                        "glosses": [
                            "masa materii zawartej w organizmach żywych (zwykle podawana na metr kwadratowy lub sześcienny)"
                        ],
                        "tags": [],
                        "examples": [],
