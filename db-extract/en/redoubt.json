                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa5eabb7-e337-45d0-8c05-d6f82981dfdd",
                                "sense_id": "d1e1e72d-1431-3db8-882e-17466eff5a76",
                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nTo the south, the vast geometrical deserts of Arabian nomads, a redoubt of feral movement, of fickle winds, of open space, of saddle leather—home to the wild Bedouin tribes."
                            }
                        ]
