                "forms": [],
                "senses": [
                    {
                        "sense_id": "cda69752-553c-3f30-abfa-bdd903718da5",
                        "entry_id": "35f46adf-58a3-3e23-a57c-f370f55cfd4a",
                        "glosses": [
                            "naast dat, naast die"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1b40bc-6d6f-4e84-bf59-28dff68531dd",
                                "sense_id": "cda69752-553c-3f30-abfa-bdd903718da5",
                                "text": "Daarnaast groeit marijuana."
                            },
                            {
                                "example_id": "7d6a5a74-9d2f-4fce-8e20-999adce43011",
                                "sense_id": "cda69752-553c-3f30-abfa-bdd903718da5",
                                "text": "Zie je die rode vrachtwagen? Daarnaast kun je je auto wel parkeren."
                            },
                            {
                                "example_id": "e04f7e6b-9b6d-49d8-9f53-256ce936ef8e",
                                "sense_id": "cda69752-553c-3f30-abfa-bdd903718da5",
                                "text": "Daarnaast stond de betekenis in het Spaans."
                            }
                        ]
                    },
                    {
                        "sense_id": "564fa7c0-e854-33ae-9da7-9808eb758f83",
                        "entry_id": "35f46adf-58a3-3e23-a57c-f370f55cfd4a",
                        "glosses": [
                            "bovendien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d4c10d3-2d4f-4278-bafd-9f2f8ff39173",
                                "sense_id": "564fa7c0-e854-33ae-9da7-9808eb758f83",
                                "text": "Hij werkte hard op school en daarnaast had hij nog een krantenwijk."
                            },
                            {
                                "example_id": "3baacb92-3704-4423-87c8-76188896ab27",
                                "sense_id": "564fa7c0-e854-33ae-9da7-9808eb758f83",
                                "text": "Betrokkenheid: Ook bijvoorbeeld de Rijksdienst voor Cultureel Erfgoed maakt gebruik van faciliteiten en kennis van de afdeling, net als grote ingenieursbureaus. Daarnaast hebben grote namen in de industrie, zoals Boskalis en Shell, veel aardwetenschappers nodig vanwege hun kennis over de bodem. En ook Energie Beheer Nederland (EBN) kan voor bijvoorbeeld vraagstukken over aardwarmte niet zonder dit soort kennis."
                            },
                            {
                                "example_id": "39767c52-7828-4135-aab5-c507cc3513fe",
                                "sense_id": "564fa7c0-e854-33ae-9da7-9808eb758f83",
                                "text": "Wat deden die kwade beesten opeens in mijn droom? Was ik gisteren stiekem bang toen ik de herder zachtjes bij zijn oren pakte? En was ik daarnaast ook bang voor het lichaam van Bibi? Freud zou hier wel raad mee weten."
                            },
                            {
                                "example_id": "e5115aed-7392-4f91-8563-b9c7b9550754",
                                "sense_id": "564fa7c0-e854-33ae-9da7-9808eb758f83",
                                "text": "Daarnaast is het de kunst om niet in paniek te raken."
                            }
                        ]
                    }
                ],
