                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88538d5c-58cd-4c8a-b4cd-edd8c3bb335f",
                                "sense_id": "7c2d7d16-65c8-34c8-8523-a9d9a033530a",
                                "text": "„Zum Abschluss der Kanadareise geht es nach Calgary, bevor die Herzogin und der Herzog von Cambridge vom 8. bis 10. Juli Kalifornien besuchen.“"
                            },
                            {
                                "example_id": "1b31ad81-2637-4f55-8f26-2fd8f63794d2",
                                "sense_id": "7c2d7d16-65c8-34c8-8523-a9d9a033530a",
                                "text": "„Von einem abenteuerlichen Erlebnis mit Bären zu erzählen gehört zu jeder Kanadareise, denn gleich drei Spezies sind hier zu Hause: Eisbären, Grizzlys und Schwarzbären.“"
                            }
