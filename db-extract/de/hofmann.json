                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                        "entry_id": "50ea65aa-8106-3939-aa3d-5e478c8d4837",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "303882ed-c875-4f7f-b404-d391e1239f38",
                                "sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                                "text": "Herr Hofmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7ae620c6-7ce7-430a-8bed-51a7ba04a183",
                                "sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                                "text": "Die Hofmanns fliegen heute nach Sri Lanka."
                            },
                            {
                                "example_id": "3e4bf1d6-acf5-4d10-b424-b1fe983fd61e",
                                "sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                                "text": "Der Hofmann trägt nie die Pullover, die die Hofmann ihm strickt."
                            },
                            {
                                "example_id": "6b76ad97-c2f3-4ee2-bfe6-cc95d111d4df",
                                "sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                                "text": "Frau Hofmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1fefa421-6ce5-469d-aedc-f2b60d437855",
                                "sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hofmann kommt, geht der Herr Hofmann.“"
                            },
                            {
                                "example_id": "f3ac36d2-e8ca-48bb-bd0c-bd5a2d8c9508",
                                "sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                                "text": "Hofmann kommt und geht."
                            },
                            {
                                "example_id": "c67d5f25-4ac6-451d-bedb-40c2f005228d",
                                "sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                                "text": "Hofmanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "8f812f82-3b48-40db-9dc9-ef71ed0e9e12",
                                "sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                                "text": "An verregneten Herbsttagen ist Familie Hofmanns liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "824a626e-085e-432a-be75-efc78e5b534e",
                                "sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Hofmann das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5af65110-5d11-4136-9b4e-950b144a9fb1",
                        "source_entry_id": "50ea65aa-8106-3939-aa3d-5e478c8d4837",
                        "source_sense_id": "9e36a2f1-66f7-302a-bb9a-7ac4919c41e0",
                        "source_sense_description": "deutschsprachiger Familienname, Nachname",
                        "target_lang_word": "courtier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68143730-edba-3be8-a000-228db5cf6fa8",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "A person in attendance at a royal court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a3d2814-dd7a-4361-81b8-a9f1b2e23413",
                                                "sense_id": "68143730-edba-3be8-a000-228db5cf6fa8",
                                                "text": "By the Lord, Horatio, this three years I have taken note of it, the age is grown so picked that the toe of the peasant comes so near the heel of the courtier he galls his kibe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "A person who flatters in order to seek favour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7325b74b-79b5-452c-ac6c-e79c9f087bfc",
                                                "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                                "text": "People shouted cheerfully and flinched, but the Prime Minister didn't flinch, she fortified her voice with a firm diapason as if rising to the challenge of a rowdy Chamber. Around her her courtiers started like pheasants."
                                            },
                                            {
                                                "example_id": "6ab65732-a2ba-492e-96a1-0983138231d5",
                                                "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                                "text": "The world’s richest person, not known for his humility, is still learning the cutthroat courtier politics of Donald Trump’s inner circle — and his ultimate influence remains an open question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ff811f-55f9-311f-b6ac-94619565a68d",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of the Asian genus Sephisa."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
