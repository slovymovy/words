    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5500de49-bc39-3a05-afaf-bc6dbe37822c",
                    "sense_definition": "Fait ou état d'attendre, ou durée pendant laquelle on attend.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "délai",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dossier reste en <w>attente</w> jusqu'à la réception des pièces justificatives manquantes."
                        },
                        {
                            "text": "Après une très longue <w>attente</w> devant le guichet, les clients ont enfin pu entrer."
                        }
                    ],
                    "common_phrases": [
                        "en attente",
                        "longue attente"
                    ]
                },
                {
                    "sense_id": "4dfe598e-0fa2-3756-8ae0-6e64c562c4bc",
                    "sense_definition": "Espérance ou prévision que l'on forme sur quelqu'un ou quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "espérance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Contre toute <w>attente</w>, cette jeune athlète a remporté la médaille d'or lors de la compétition."
                        },
                        {
                            "text": "Le nouveau directeur s'efforce de répondre aux <w>attentes</w> de tous ses collaborateurs."
                        }
                    ],
                    "common_phrases": [
                        "contre toute attente",
                        "dépasser les attentes",
                        "répondre aux attentes"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6577664-f9d9-301a-981e-eee9549d845a",
                    "sense_definition": "Troisième personne du singulier de l'indicatif présent de <w>attenter</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attenter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque citoyen proteste vivement dès qu'un décret <w>attente</w> à ses libertés fondamentales."
                        },
                        {
                            "text": "Le procureur affirme que cet individu <w>attente</w> à la sûreté de l'État."
                        }
                    ],
