                "senses": [
                    {
                        "sense_id": "81f1172e-4a20-3be2-80ae-b6cfc4d2ddb3",
                        "entry_id": "1cb6e7dd-68f5-3053-b1fe-8ded3661769e",
                        "glosses": [
                            "państwo na pograniczu Europy i Azji, ze stolicą w Astanie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea977f4d-992b-4b14-8d30-d29b744e43be",
                                "sense_id": "81f1172e-4a20-3be2-80ae-b6cfc4d2ddb3",
                                "text": "Kazachstan jest członkiem wielu międzynarodowych organizacji, między innymi ONZ, natowskiego Partnerstwa dla Pokoju czy postsowieckiej Wspólnoty Niepodległych Państw."
                            },
                            {
                                "example_id": "87db0d54-f85e-406e-9fbf-a74d6fb6a12d",
                                "sense_id": "81f1172e-4a20-3be2-80ae-b6cfc4d2ddb3",
                                "text": "Obok Hiszpanek grają dwie Argentynki, Brazylijki, Ukrainka, Holenderka, reprezentantka Kazachstanu."
                            },
                            {
                                "example_id": "00833f51-a965-450a-9442-d954f0f331c1",
                                "sense_id": "81f1172e-4a20-3be2-80ae-b6cfc4d2ddb3",
                                "text": "W tym roku ma być oddany do eksploatacji ropociąg z Atyrau w Kazachstanie do Chin (…)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80f87553-8c3c-4c45-8a6f-b1229502db97",
                        "source_entry_id": "1cb6e7dd-68f5-3053-b1fe-8ded3661769e",
                        "source_sense_id": "81f1172e-4a20-3be2-80ae-b6cfc4d2ddb3",
                        "target_lang_word": "Kazakhstan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kazakhstan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1777c41-5bc3-3dd7-b999-16aaa5d9ecc5",
                                        "entry_id": "31a992a5-2d65-3bdd-a1ff-86778f0b3453",
                                        "glosses": [
                                            "A country in Central Asia and Eastern Europe. Official name: Republic of Kazakhstan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99bef841-2de2-4ba5-9f88-a74aded40bb9",
                                                "sense_id": "b1777c41-5bc3-3dd7-b999-16aaa5d9ecc5",
                                                "text": "At a signing ceremony in the Kazakh capital, Astana, on May 29, the presidents of Russia, Belarus, and Kazakhstan ratified the Eurasian Economic Union (EEU) into existence. An EEU modeled on the European Union was first mooted back in 1994 by Kazakh President Nursultan Nazarbayev, but took off only after his Russian counterpart, Vladimir Putin, seized upon its potential as a Moscow-centered, Asia-oriented alternative to the EU."
                                            },
                                            {
                                                "example_id": "b0014592-17b5-4cae-aed7-046a191cdbdb",
                                                "sense_id": "b1777c41-5bc3-3dd7-b999-16aaa5d9ecc5",
                                                "text": "Longtime NASA astronaut Don Pettit, who has ventured to space four times, returned to Earth on Saturday night from the International Space Station. Pettit, who turned 70 on Sunday, landed at 9:20 p.m. ET in a Soyuz spacecraft with Roscosmos cosmonauts Alexey Ovchinin and Ivan Vagner near Zhezkazgan, Kazakhstan, after a seven-month stay aboard the orbiting laboratory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bab94e84-ab56-4e47-b768-17d7fd2c5f1e",
                        "source_entry_id": "1cb6e7dd-68f5-3053-b1fe-8ded3661769e",
                        "source_sense_id": "81f1172e-4a20-3be2-80ae-b6cfc4d2ddb3",
