    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eba7cadd-e9ed-31fb-b61e-e4619f16ebb9",
                    "sense_definition": "Faire quelque chose, se mettre en mouvement par opposition à l'inaction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est grand temps d'<w>agir</w> avant qu'il ne soit trop tard pour la planète."
                        },
                        {
                            "text": "Nous devons <w>agir</w> ensemble pour trouver une solution durable à ce problème."
                        }
                    ],
                    "synonyms": [
                        "intervenir"
                    ],
                    "antonyms": [
                        "attendre"
                    ],
                    "common_phrases": [
                        "agir vite",
                        "agir ensemble",
                        "agir sans tarder"
                    ]
                },
                {
                    "sense_id": "e7c7a7ef-96d8-34bd-a55e-af8de6336689",
                    "sense_definition": "Être l'objet en question ou le sujet dont il convient de traiter.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concerner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce roman policier, il s'<w>agit</w> d'un mystère particulièrement difficile à élucider."
                        },
                        {
                            "text": "Il s'<w>agissait</w> pour nous de choisir rapidement entre deux options importantes."
                        }
                    ],
                    "synonyms": [
                        "concerner"
                    ],
                    "common_phrases": [
                        "il s'agit de"
                    ]
                },
                {
                    "sense_id": "6ad650f6-4df8-3073-9505-deb609f911cb",
                    "sense_definition": "Se comporter, avoir une certaine conduite envers autrui ou face aux événements.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as très mal <w>agi</w> envers tes amis lors de cette soirée difficile."
                        },
                        {
                            "text": "Il préfère toujours <w>agir</w> avec prudence dans les situations délicates."
                        }
                    ],
                    "synonyms": [
                        "se comporter",
                        "se conduire"
                    ],
                    "common_phrases": [
                        "bien agir",
                        "mal agir",
                        "agir avec prudence"
                    ]
                },
                {
                    "sense_id": "4aedf737-1e4e-3551-a853-ab45c4aa0c9f",
                    "sense_definition": "Produire un effet physique, chimique ou moral sur quelque chose ou quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "effet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce médicament commence enfin à <w>agir</w> et soulage considérablement la douleur du patient."
                        },
                        {
                            "text": "La chaleur intense <w>agit</w> directement sur le comportement des animaux dans le désert."
                        }
                    ],
                    "synonyms": [
                        "influer",
                        "opérer"
                    ],
                    "common_phrases": [
                        "agir sur",
                        "agir efficacement"
                    ]
                },
                {
                    "sense_id": "fca81e66-6b3f-3b48-b384-05a27617b55e",
                    "sense_definition": "Entreprendre des démarches ou intervenir en faveur de quelqu'un ou en son nom.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "demarche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon avocat m'a assuré qu'il allait <w>agir</w> pour mes intérêts dès la semaine prochaine."
                        },
                        {
                            "text": "Le diplomate a le pouvoir d'<w>agir</w> au nom de son gouvernement à l'étranger."
                        }
                    ],
                    "synonyms": [
                        "intervenir",
                        "intercéder"
                    ],
                    "common_phrases": [
                        "agir pour autrui",
                        "pouvoir d'agir"
                    ]
                },
                {
                    "sense_id": "32cc07d8-6458-3152-bc13-337c5ac1b791",
                    "sense_definition": "Intenter une action en justice contre une personne ou une organisation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'association a décidé d'<w>agir</w> en justice pour faire reconnaître la pollution de la rivière."
                        },
                        {
                            "text": "Il est contraint d'<w>agir</w> contre son ancien associé pour obtenir son dû."
                        }
                    ],
                    "synonyms": [
                        "poursuivre",
                        "attaquer"
                    ],
                    "common_phrases": [
                        "agir en justice",
                        "agir civilement"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1441ea8c-ecdb-33ae-ab98-268ac2db7435",
                    "sense_definition": "Fait d'accomplir des actions concrètes, pratique humaine considérée globalement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce philosophe consacre ses recherches aux relations fondamentales entre la pensée et l'<w>agir</w> moral."
                        },
                        {
                            "text": "La responsabilité éthique doit guider l'<w>agir</w> quotidien de chaque citoyen dans la société."
                        }
                    ],
                    "synonyms": [
