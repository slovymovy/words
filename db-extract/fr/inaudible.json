                "senses": [
                    {
                        "sense_id": "d44336c1-a853-3926-bd1e-5d5c35637189",
                        "entry_id": "a81c2edf-6fd5-3240-be54-9194be64ca17",
                        "glosses": [
                            "Que l'on ne peut pas entendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cc8ca09-26cd-4d8b-93c7-43b77994806f",
                                "sense_id": "d44336c1-a853-3926-bd1e-5d5c35637189",
                                "text": "Un enregistrement inaudible."
                            },
                            {
                                "example_id": "803c82ba-c3b4-4f0d-9fc1-34d4684bc77b",
                                "sense_id": "d44336c1-a853-3926-bd1e-5d5c35637189",
                                "text": "Tout son situé en dessous de cette courbe de masquage est inaudible."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2f83cf1-6f08-3b14-929f-4deb5a6bb5e2",
                        "entry_id": "a81c2edf-6fd5-3240-be54-9194be64ca17",
                        "glosses": [
                            "Dont le son est insupportable."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cf1efcb9-d86a-411c-a7a4-0a9363e4a135",
                                "sense_id": "d2f83cf1-6f08-3b14-929f-4deb5a6bb5e2",
                                "text": "Une voix ou une musique inaudible."
                            }
                        ]
                    },
                    {
                        "sense_id": "8da8d4b7-59d7-3fbc-a673-cb84d732214b",
                        "entry_id": "a81c2edf-6fd5-3240-be54-9194be64ca17",
                        "glosses": [
                            "Dont le message est confus, voire incompréhensible."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0f1d5f93-ac8e-4c89-ba8f-153ffd5c7938",
                                "sense_id": "8da8d4b7-59d7-3fbc-a673-cb84d732214b",
                                "text": "De quoi faire monter le ton entre les deux hommes qui finissent par s’écharper dans un brouhaha inaudible, alors qu’Olivier Faure reste silencieux, l’air un peu ébahi, debout au milieu des deux roquets déchaînés."
                            },
                            {
                                "example_id": "ab277e3d-eedf-4d8b-8127-bb8b48a5101b",
                                "sense_id": "8da8d4b7-59d7-3fbc-a673-cb84d732214b",
                                "text": "Un discours inaudible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e550a163-c889-4c77-bf6a-e845e54570ed",
