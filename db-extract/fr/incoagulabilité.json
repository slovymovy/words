                        "glosses": [
                            "Qualité intrinsèque de ce qui est incoagulable."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "cffc6422-631d-4c1f-975e-acedec50a747",
                                "sense_id": "a14affa3-aba9-3ae1-abe1-96e8e0b2d710",
                                "text": "L’incoagulabilité du sang menstruel a certainement inquiété les anciens."
                            },
                            {
                                "example_id": "09613734-e9ce-4ad9-b0cd-dd64883266a3",
                                "sense_id": "a14affa3-aba9-3ae1-abe1-96e8e0b2d710",
                                "text": "On connaît, d’une manière plus certaine, la couleur foncée et l’incoagulabilité du sang après les maladies rapidement mortelles, profondément adynamiques (fièvres pétéchiales ou pourprées, hémorrhagies passives), après l’action de la foudre, après une excessive fatigue ; […]."
                            }
                        ]
