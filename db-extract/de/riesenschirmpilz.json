                ],
                "senses": [
                    {
                        "sense_id": "94499d49-b06f-348e-b98a-17b557fd7e87",
                        "entry_id": "33ff279d-1c46-35cc-bb04-cea459589f37",
                        "glosses": [
                            "große Pilzsorte aus der Familie der Agaricaceae (Champignonverwandten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6b7c7b2-0bae-469e-936a-1b60ef3c910b",
                                "sense_id": "94499d49-b06f-348e-b98a-17b557fd7e87",
                                "text": "„Auf einer sonnigen Anhöhe fanden wir unter Dornenbüschen dutzende Riesenschirmpilze.“"
                            },
                            {
                                "example_id": "3cf034b6-c51c-462d-a6b8-f7703e3a0451",
                                "sense_id": "94499d49-b06f-348e-b98a-17b557fd7e87",
                                "text": "„Eine besondere Stellung nahm der Riesenschirmpilz ein, der oft fast majestätisch mit bis zu 70 cm Höhe frei im Wald stand.“"
                            },
                            {
                                "example_id": "ee5c1872-40f1-4551-9dbe-d13da4c6efd7",
                                "sense_id": "94499d49-b06f-348e-b98a-17b557fd7e87",
                                "text": "„Die stattliche Größe von 30 bis 40 Zentimetern kommt in den weiteren Namen Riesenschirmling oder Riesenschirmpilz zum Ausdruck.“"
                            },
                            {
                                "example_id": "26d42c7b-5dbf-4090-b78a-cae5b0cb0e58",
                                "sense_id": "94499d49-b06f-348e-b98a-17b557fd7e87",
                                "text": "„Er empfiehlt zum Sammeln den Steinpilz, Maronenröhrling, Riesenschirmpilz (Parasol), Reizker und Schopf-Tintling.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7fe8a40-97d4-4b31-be7a-bd6a81873d1a",
