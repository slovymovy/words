                                        "sense_id": "c469c946-40c0-3051-a0a1-c733e0637159",
                                        "entry_id": "5dd1a379-cdd8-3ff1-a648-00b803194da0",
                                        "glosses": [
                                            "Perdu, isolé, inaccessible."
