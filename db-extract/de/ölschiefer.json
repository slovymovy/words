                ],
                "senses": [
                    {
                        "sense_id": "907440a8-89d2-3bd0-a011-43f26baf95ab",
                        "entry_id": "71cbfb6c-9300-3cc4-ae2f-c4ba9ee584d9",
                        "glosses": [
                            "dunkelgraues bis schwarzes Sedimentgestein, aus denen Öl und Gas gewonnen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a86770-a1ef-4afb-88c4-db8da3de86f3",
                                "sense_id": "907440a8-89d2-3bd0-a011-43f26baf95ab",
                                "text": "„Kleine Säugetiere, Fledermäuse, terrestrische Krokodile, Schlangen und Frösche sowie die Überreste unzähliger Arten von Insekten, Gliederfüßern, Vögeln, Fischen und Pflanzen komplettieren die sehr lange Liste der Funde. Entdeckt wurden sie im Ölschiefer, der sich am Grund eines Sees gebildet hatte.“"
                            },
                            {
                                "example_id": "2e140cf7-9ba7-47c3-a1fa-0dcc84b97b06",
                                "sense_id": "907440a8-89d2-3bd0-a011-43f26baf95ab",
                                "text": "„Alle sitzen auf tiefgründigen Vorkommen von Ölschiefer, den man damals für graues Gold hielt. Die Lager waren in der Bevölkerung bekannt, da die Gefangenen täglich aus den Baracken über die Landstraße zur Arbeit gezwungen wurden.“"
                            },
                            {
                                "example_id": "eaa33bb1-e753-4bb2-a9a2-62759e08b572",
                                "sense_id": "907440a8-89d2-3bd0-a011-43f26baf95ab",
                                "text": "„Als Ölschiefer wird ein dunkles, tonig-mergeliges Sedimentgestein bezeichnet, das bis zu 20 % Kohlenwasserstoffverbindungen enthält, die Kerogene genannt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed7c2188-8200-41ee-ab1a-ab0a0392c287",
                        "source_entry_id": "71cbfb6c-9300-3cc4-ae2f-c4ba9ee584d9",
                        "source_sense_id": "907440a8-89d2-3bd0-a011-43f26baf95ab",
                        "source_sense_description": "Sedimentgestein",
                        "target_lang_word": "oil shale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oil shale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "900f25e1-9681-34ce-bb63-a89d9fec4952",
                                        "entry_id": "100956f2-7d87-394e-980e-8d92e53cfd87",
                                        "glosses": [
                                            "A sedimentary rock containing kerogen from which petroleum-like shale oil can be produced by pyrolysis, hydrogenation, or thermal dissolution."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c030bab-44b9-4624-b692-e65f5c01345c",
                                                "sense_id": "900f25e1-9681-34ce-bb63-a89d9fec4952",
                                                "text": "Up in the mountains along both sides of Parachute Creek the Exxon Corporation and other companies have begun to pour billions of dollars into two huge projects to turn the nation's immense reserves of oil shale into shale oil."
                                            },
                                            {
                                                "example_id": "0c1659b3-3613-4e59-80a4-f465a0a556f7",
                                                "sense_id": "900f25e1-9681-34ce-bb63-a89d9fec4952",
                                                "text": "Can you imagine squeezing oil from rock? Oil shale is different from the shale gas that is extracted through fracking. It is geologically un-evolved oil: the remnants of organic matter buried underground for millions of years but never sunk deep enough, nor long enough, to be transformed into petroleum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
