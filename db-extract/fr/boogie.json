                                                "example_id": "11301442-ea35-4160-91ec-5b81bca7cfcf",
                                                "sense_id": "740b1f8e-b7c8-3733-b24f-eea3958577e3",
                                                "text": "Don't you know I wanna boogie with you / Hey, I wanna boogie with you / Down on the corner"
                                            },
                                            {
                                                "example_id": "41a2c71d-6a31-4b9f-9f1a-c417406c52be",
                                                "sense_id": "740b1f8e-b7c8-3733-b24f-eea3958577e3",
                                                "text": "Mr. Nichols said that with permits, equipment storage fees and other expenses, it costs the association about $7,000 for a season of boogieing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74b8cc2c-9e1b-369c-95eb-26dfa4c31132",
                                        "entry_id": "3ef16d2f-17de-3862-8ac8-cad90521b377",
                                        "glosses": [
                                            "To dance, especially a vigorous, nightclub-type dance."
                                        ],
                                        "tags": [
