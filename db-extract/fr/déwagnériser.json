                ],
                "senses": [
                    {
                        "sense_id": "73f566d7-4964-35d7-b2fd-b720071d6fae",
                        "entry_id": "2765d057-e697-3919-a97f-0a8416f6767c",
                        "glosses": [
                            "Enlever son caractère wagnérien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64ffde0d-ec1c-4787-a71c-0beb4225d8e9",
                                "sense_id": "73f566d7-4964-35d7-b2fd-b720071d6fae",
                                "text": "Il faut \"déwagnériser\" Wagner pour bien l’interpréter."
                            },
                            {
                                "example_id": "7e0331af-875e-49a7-aefa-827828c7b1c0",
                                "sense_id": "73f566d7-4964-35d7-b2fd-b720071d6fae",
                                "text": "En octobre 1893, Chausson dit avec soulagement réussir enfin, au troisième acte, à suivre les conseils de Debussy et à se déwagnériser : « Il me semble que ça se clarifie et déwagnérise »."
                            },
                            {
                                "example_id": "cd434a82-687e-427a-9a82-480b66ac4591",
                                "sense_id": "73f566d7-4964-35d7-b2fd-b720071d6fae",
                                "text": "Parallèlement à Wagner, il apportait une langue neuve qui permit, aux envoûtés, de se « déwagnériser » ; aux autres, de ne pas s’aventurer dans un domaine où la grande voix de Bayreuth emplissait tout l’espace."
                            }
                        ]
                    }
                ],
