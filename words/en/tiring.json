    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0c5832fb-edae-39c2-9ec9-cdb12fd660b2",
                    "sense_definition": "Causing physical or mental fatigue; making one feel tired.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Carrying my heavy bags up four flights of stairs is very <w>tiring</w>. ",
                            "target_lang_translations": {
                                "ru": "Тащить тяжелые сумки на пятый этаж очень <w>утомительно</w>.",
                                "zh": "把沉重的行李搬上四楼非常<w>费劲</w>。"
                            }
                        },
                        {
                            "text": "It was a long and <w>tiring</w> day at work, so I went to bed early.",
                            "target_lang_translations": {
                                "ru": "Это был долгий и <w>утомительный</w> день на работе, поэтому я рано лег спать.",
                                "zh": "今天工作了一整天，非常<w>劳累</w>，所以我早早就睡了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exhausting",
                        "fatiguing",
                        "tiresome",
                        "wearing",
                        "wearisome"
                    ],
                    "common_phrases": [
                        "tiring day",
                        "tiring journey",
                        "long and tiring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий физическую или умственную усталость; заставляющий чувствовать себя уставшим.",
                        "zh": "引起身体或精神上的疲劳；让人感到累的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утомительный",
                                "target_lang_sense_clarification": "требующий много сил"
                            },
                            {
                                "target_lang_word": "изнурительный",
                                "target_lang_sense_clarification": "очень сильно утомляющий"
                            },
                            {
                                "target_lang_word": "тяжёлый",
                                "target_lang_sense_clarification": "о дне, работе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "令人疲惫的",
                                "target_lang_sense_clarification": "形容事物让人感到劳累"
                            },
                            {
                                "target_lang_word": "费劲的",
                                "target_lang_sense_clarification": "形容需要耗费大量体力或精力"
                            },
                            {
                                "target_lang_word": "劳累的",
                                "target_lang_sense_clarification": "形容工作或活动让人感到辛苦"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee09ba46-052e-3ca5-972b-26beb7a41b4a",
                    "sense_definition": "The act of becoming tired or making someone tired.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The continuous <w>tiring</w> of his muscles made it difficult to finish the marathon.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>утомление</w> мышц затрудняло завершение марафона.",
                                "zh": "肌肉持续的<w>疲劳</w>使他很难跑完马拉松。"
                            }
                        },
                        {
                            "text": "She noticed the slow <w>tiring</w> of the horse after hours of travel.",
                            "target_lang_translations": {
                                "ru": "Она заметила, как лошадь медленно <w>устает</w> после долгих часов пути.",
                                "zh": "她注意到马在赶路数小时后逐渐变得<w>疲惫</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс утомления или доведения кого-либо до усталости.",
                        "zh": "变得疲劳或使某人感到疲劳的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утомление",
                                "target_lang_sense_clarification": "процесс потери сил"
                            },
                            {
                                "target_lang_word": "усталость",
                                "target_lang_sense_clarification": "состояние или процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疲劳",
                                "target_lang_sense_clarification": "指身体或精神上的疲惫状态"
                            },
                            {
                                "target_lang_word": "疲惫",
                                "target_lang_sense_clarification": "指极度劳累的过程或状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "064e9216-fc1b-31f9-a401-7a66ffbeeba5",
                    "sense_definition": "Bits of bone and tough organic material given to hawks to abate their hunger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falconer provided <w>tiring</w> to keep the bird occupied between flights.",
                            "target_lang_translations": {
                                "ru": "Сокольник дал <w>поноску</w>, чтобы занять птицу между полетами.",
                                "zh": "驯鹰人提供了<w>带骨肉</w>，让鸟在飞行间隙有事可做。"
                            }
                        },
                        {
                            "text": "The hawk pecked at the <w>tiring</w> until it was fully satisfied.",
                            "target_lang_translations": {
                                "ru": "Ястреб клевал <w>поноску</w>, пока полностью не насытился.",
                                "zh": "鹰啄食着<w>带骨肉</w>，直到完全吃饱。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in falconry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Куски костей и жёстких тканей, даваемые ястребам для утоления голода (в соколиной охоте).",
                        "zh": "在驯鹰术中，给鹰吃的带有骨头和坚硬组织的肉，用来消磨时间或缓解饥饿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поноска",
                                "target_lang_sense_clarification": "в соколиной охоте"
                            },
                            {
                                "target_lang_word": "кожа с костями",
                                "target_lang_sense_clarification": "корм для ловчих птиц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "带骨肉",
                                "target_lang_sense_clarification": "驯鹰术中用于喂食的带骨组织"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "562317b3-7cae-342e-aec9-5c83a0dc2c41",
