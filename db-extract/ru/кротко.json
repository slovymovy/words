                                    {
                                        "sense_id": "be589a4a-76c5-3575-9d4d-f2136f168215",
                                        "entry_id": "1e404b6d-4444-37fb-ab0a-75edfdac91ab",
                                        "glosses": [
                                            "In a meek manner; quietly and humbly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796dff79-ef4a-468b-9cee-fef986a2b9f8",
                                                "sense_id": "be589a4a-76c5-3575-9d4d-f2136f168215",
                                                "text": "When Faith and Love which parted from thee never\nHad ripen'd thy just soul to dwell with God,\nMeekly thou did'st resign this earthly load\nOf Death, call'd Life; which us from Life doth sever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
