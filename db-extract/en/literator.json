                    {
                        "translation_id": "3715faf5-f0fb-4df4-b985-24b31453bd24",
                        "source_entry_id": "1edc548f-20fb-3bc4-bf1a-1f891c9997a4",
                        "source_sense_id": "a8f1529f-19a8-3dd1-8fb4-37fe6ff1125f",
                        "source_sense_description": "veraltet: Literator, Autor",
                        "target_lang_word": "Autor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7469bdd4-2691-3de6-a550-4a85d3080381",
                                        "entry_id": "7add29b4-5df3-3923-a32e-f9c2c5c0724e",
                                        "glosses": [
                                            "Person, die einen oder mehrere literarische oder wissenschaftliche Texte verfasst hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bbe23ba-4f57-4ad9-8482-48a51f0a8b3f",
                                                "sense_id": "7469bdd4-2691-3de6-a550-4a85d3080381",
                                                "text": "Zu der Talkshow waren drei Autoren eingeladen."
                                            },
                                            {
                                                "example_id": "4a958699-e176-454d-bb91-d2ea9c075b60",
                                                "sense_id": "7469bdd4-2691-3de6-a550-4a85d3080381",
                                                "text": "Der Autor dieses Buches heißt Umberto Eco."
                                            },
                                            {
                                                "example_id": "614f319d-2bd7-41a9-8941-f15696e11d75",
                                                "sense_id": "7469bdd4-2691-3de6-a550-4a85d3080381",
                                                "text": "Bei Zitaten gibt man immer den Autor an."
                                            },
                                            {
                                                "example_id": "c4475e49-855d-4d76-9766-36a1190fff36",
                                                "sense_id": "7469bdd4-2691-3de6-a550-4a85d3080381",
                                                "text": "„Es ist die Aufgabe des Autors, die er niemandem abtreten kann, daß er – nach bestem Vermögen – dem Stoff jene Form gibt, die ihn zum Sprechen bringt.“"
                                            },
                                            {
                                                "example_id": "388e0eb2-2059-4270-afb5-92e6d9f220f7",
                                                "sense_id": "7469bdd4-2691-3de6-a550-4a85d3080381",
                                                "text": "„Zunächst also zu dem, was der Autor persönlich über den Lebenslauf des Helden vorliegenden Buches weiß.“"
                                            },
                                            {
                                                "example_id": "a5caf5d5-59b7-4362-b0b9-aec4238c7be1",
                                                "sense_id": "7469bdd4-2691-3de6-a550-4a85d3080381",
                                                "text": "„Ich bin zwar tatsächlich Autor geworden, schreibe aber nicht auf Arabisch, sondern auf Deutsch.“"
                                            },
                                            {
                                                "example_id": "0373930f-0694-44d2-a54e-e2644d9e0cbd",
                                                "sense_id": "7469bdd4-2691-3de6-a550-4a85d3080381",
                                                "text": "„Ihm ist, wie praktisch allen links-liberalen oder antimilitaristischen (und unabhängig von ihrer Haltung allen jüdischen) Autoren, jede Publikationsmöglichkeit im Dritten Reich genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1af5c944-a2bf-35c1-bc1f-3e79b9524705",
                                        "entry_id": "7add29b4-5df3-3923-a32e-f9c2c5c0724e",
                                        "glosses": [
                                            "Urheber eines Werks der Musik, des Films, der Kunst oder der Fotografie"
                                        ],
