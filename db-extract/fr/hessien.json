                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d951d45e-da24-32eb-bdb1-9f10fc17927e",
                                        "entry_id": "73f184bd-2982-3986-b24c-0511cafd9402",
                                        "glosses": [
                                            "ein im Bundesland Hessen (Deutschland) geborener oder dort auf Dauer lebender Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f6f9834-e135-4689-8f4f-46b9fa974923",
                                                "sense_id": "d951d45e-da24-32eb-bdb1-9f10fc17927e",
                                                "text": "Er ist Hesse und seine Frau ist Westfälin."
                                            },
                                            {
                                                "example_id": "2a6a0c8a-6110-4f95-9339-570ba41c68d7",
                                                "sense_id": "d951d45e-da24-32eb-bdb1-9f10fc17927e",
                                                "text": "Was, du bist Hesse?"
                                            },
                                            {
                                                "example_id": "de8b3188-ff8c-447c-b9fb-6e18064b8ac2",
                                                "sense_id": "d951d45e-da24-32eb-bdb1-9f10fc17927e",
                                                "text": "Seit 1989 ist Gerald ein Hesse."
                                            },
                                            {
                                                "example_id": "ef01366d-21ac-4239-8d1b-85c44e85dc9a",
                                                "sense_id": "d951d45e-da24-32eb-bdb1-9f10fc17927e",
                                                "text": "Im Urlaub haben wir eine Familie aus waschechten Hessen getroffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hesse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3498f799-6770-3747-b082-ffece2e10e89",
                                        "entry_id": "39a77f95-82e7-3d7a-9c39-03c3545c10bc",
                                        "glosses": [
                                            "Teile des Unterschenkels von Rind und Kalb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "246fc83e-57e0-4134-a9d9-12d160380dc9",
                                                "sense_id": "3498f799-6770-3747-b082-ffece2e10e89",
                                                "text": "\"Was beim Kalb als Hachse bekannt ist, wird beim Rind als Hesse bezeichnet. Die Hesse wird geschnitten als Beinscheibe auf den Markt gebracht und als Kochfleisch verwendet für z. B. Suppen oder Kraftbrühen.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hesse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "570c4efb-ff20-3573-8170-f81b1f65e931",
                                        "entry_id": "0a657042-565c-3b7b-92d7-f1664838b02c",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89e59cc3-9615-4e1c-b9de-4da77469f00f",
                                                "sense_id": "570c4efb-ff20-3573-8170-f81b1f65e931",
                                                "text": "Frau Hesse ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "6f55cd2d-33a2-4488-b55c-34963455c41d",
                                                "sense_id": "570c4efb-ff20-3573-8170-f81b1f65e931",
                                                "text": "Herr Hesse wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "385b6504-da9b-4c45-bf23-b973b16804b1",
                                                "sense_id": "570c4efb-ff20-3573-8170-f81b1f65e931",
                                                "text": "Die Hesses fahren heute nach Bern."
                                            },
                                            {
                                                "example_id": "824b3b40-3e4d-4e22-8df5-5e00aea452d0",
                                                "sense_id": "570c4efb-ff20-3573-8170-f81b1f65e931",
                                                "text": "Der Hesse trägt nie die Schals, die die Hesse ihm strickt."
                                            },
                                            {
                                                "example_id": "2d930fe1-8980-468b-b143-164d4451e52b",
                                                "sense_id": "570c4efb-ff20-3573-8170-f81b1f65e931",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hesse kommt, geht der Herr Hesse.“"
                                            },
                                            {
                                                "example_id": "803d3f96-bc55-4f57-88ed-c37feb936d63",
                                                "sense_id": "570c4efb-ff20-3573-8170-f81b1f65e931",
                                                "text": "Hesse kommt und geht."
                                            },
                                            {
                                                "example_id": "e2aa4ce1-63fa-4e6d-bbb5-5193762058f2",
                                                "sense_id": "570c4efb-ff20-3573-8170-f81b1f65e931",
                                                "text": "Hesses kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
