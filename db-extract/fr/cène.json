        "fr-extract.jsonl": [
            {
                "entry_id": "42a4b707-67ab-3caa-ad02-88c0b62ff3fb",
                "word": "cène",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7046af17-2d7d-40f1-93a7-cad1910fdd3b",
                        "entry_id": "42a4b707-67ab-3caa-ad02-88c0b62ff3fb",
                        "tags": [
                            "plural"
                        ],
                        "form": "cènes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5440cebe-41cd-3724-b884-bc8cae1f20c6",
                        "entry_id": "42a4b707-67ab-3caa-ad02-88c0b62ff3fb",
                        "glosses": [
                            "Variante orthographique de Cène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9e82b0d-575c-4fbb-b626-81e2ff772353",
                                "sense_id": "5440cebe-41cd-3724-b884-bc8cae1f20c6",
                                "text": "Au centre de la table d’honneur étaient deux chaises plus élevées que les autres, destinées au maître et à la maîtresse de la maison, qui présidaient à la cène hospitalière, et, en faisant ainsi, ils méritaient le titre de partageurs de pain, titre d’honneur chez les Saxons."
                            },
                            {
                                "example_id": "c672a445-6583-4bcb-b63e-23dd2ae5f0dd",
                                "sense_id": "5440cebe-41cd-3724-b884-bc8cae1f20c6",
                                "text": "Il y a un genre de zwinglianisme sec et superficiel qui réduit la cène du Seigneur à n’être qu’un souvenir vide, et le baptême une pantomime à laquelle on se soumet par obéissance seulement."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0b9f205-e924-30f7-94fa-6763dc5f32bc",
                        "entry_id": "42a4b707-67ab-3caa-ad02-88c0b62ff3fb",
                        "glosses": [
                            "Repas pris en commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88633192-2c9a-4cab-851a-53ac5ffde852",
                                "sense_id": "b0b9f205-e924-30f7-94fa-6763dc5f32bc",
                                "text": "Que dire de l'incongru, complice d'un bon menu, d'une indéniable entente et du chauffage central ? Elle se tassait, par moments, elle se laissait aller, arrondie, engourdie, bénigne et dardant comme un chat des prunelles amincies sur notre aimable cène."
                            },
                            {
                                "example_id": "3f9c2277-feea-4491-9754-bd9ca29dd133",
                                "sense_id": "b0b9f205-e924-30f7-94fa-6763dc5f32bc",
                                "text": "Il ne soupçonnait pas que sa protégée détestait ces repas pris en commun. Elle eût préféré jeûner dans sa chambre que d’avoir à affronter cette cène."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2570872c-b8dd-4ec5-816e-3ba106a2e276",
                        "source_entry_id": "42a4b707-67ab-3caa-ad02-88c0b62ff3fb",
                        "target_lang_word": "Abendmahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abendmahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16272978-b420-347a-9d2e-1cfa0a36205d",
                                        "entry_id": "06d10b5b-2aa3-3008-8154-eda268213d0f",
                                        "glosses": [
                                            "eigentlich »Letztes Abendmahl«, das letzte feierliche Essen des Jesus von Nazaret mit seinen zwölf erstberufenen Jüngern (Aposteln)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7781f9a4-54d7-4589-a8c4-3b15f52dcea9",
                                                "sense_id": "16272978-b420-347a-9d2e-1cfa0a36205d",
                                                "text": "„Die Feier am Gründonnerstagabend erinnert an das letzte Abendmahl, an das Gebet am Ölberg, die Auslieferung an die Verfolger.“"
                                            },
                                            {
                                                "example_id": "6c4d75a4-8d4f-4ce4-b803-6e53546d7d12",
                                                "sense_id": "16272978-b420-347a-9d2e-1cfa0a36205d",
                                                "text": "„Es stellt das letzte Abendmahl mit den zwölf Aposteln dar, welche die Gesichtszüge bekannter zeitgenössischer Färinger tragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8df82660-b501-3fb0-9560-41336fa068fc",
                                        "entry_id": "06d10b5b-2aa3-3008-8154-eda268213d0f",
                                        "glosses": [
                                            "Handlung im Rahmen des Gottesdienstes, die an [1] erinnert (vor allem nach protestantischem Verständnis)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5288d9ff-838b-44da-902e-8c061e5d2499",
                                                "sense_id": "8df82660-b501-3fb0-9560-41336fa068fc",
                                                "text": "Das Abendmahl ist eine Handlung im Rahmen eines christlichen Gottesdienstes, die an das heilvolle Sterben Jesu Christi erinnert und dieses vergegenwärtigt."
                                            },
                                            {
                                                "example_id": "4607912d-7216-4909-a810-9e6ce30cc3ab",
                                                "sense_id": "8df82660-b501-3fb0-9560-41336fa068fc",
                                                "text": "„Am Abendmahl durfte ich noch nicht teilnehmen.“"
                                            },
                                            {
                                                "example_id": "f3e6ef4f-d467-4b8c-aeef-3250ac032723",
                                                "sense_id": "8df82660-b501-3fb0-9560-41336fa068fc",
                                                "text": "„Er nahm sich vor, seinem Vater von dieser Art Abendmahl im russischen Gotteshaus nichts zu erzählen, weil Anton Millbacher ein solcher Frevel kränken müsse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b7007203-73bd-359d-8445-4e71cc2fdf43",
                                        "entry_id": "06d10b5b-2aa3-3008-8154-eda268213d0f",
                                        "glosses": [
                                            "gemeinsames Essen am Abend"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b9dc44-609f-434e-aa3a-7c1e4ea003ad",
                                                "sense_id": "b7007203-73bd-359d-8445-4e71cc2fdf43",
                                                "text": "Das beste Abendmahl ist das vor dem letzten Abendstrahl. (Zitat: Abu Mohammed Kasim ibn Ali, irakischer Dichter und Sprachgelehrter)"
                                            },
                                            {
                                                "example_id": "6746ecc0-8110-45c6-bef3-4bdcb8f8049c",
                                                "sense_id": "b7007203-73bd-359d-8445-4e71cc2fdf43",
                                                "text": "Alle schwiegen sich beim Abendmahl an und stocherten in ihrem Essen herum."
                                            },
                                            {
                                                "example_id": "89746aab-8931-4f56-a97e-0479467f9357",
                                                "sense_id": "b7007203-73bd-359d-8445-4e71cc2fdf43",
                                                "text": "„Sattel und Decken hatte er mit hereingebracht; die letzteren breitete er jetzt vor der freundlichen Glut aus, verzehrte als sehr frugales Abendmahl ein kleines Stück getrochnetes Hirschfleisch und warf sich dann auf das harte, doch ihm vollkommen genügende Lager nieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "5b4656bf-c7dd-3c7a-86cf-79fe611143fe",
                "word": "Cène",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a19db044-49b5-4dc8-9f18-ca8dc4c827b5",
                        "entry_id": "5b4656bf-c7dd-3c7a-86cf-79fe611143fe",
                        "tags": [],
                        "form": "cène"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b71e2965-3dce-3cc1-a01f-d8dd65bf07df",
                        "entry_id": "5b4656bf-c7dd-3c7a-86cf-79fe611143fe",
                        "glosses": [
                            "Dernier repas que fit Jésus-Christ avec ses apôtres le soir de la veille de sa mort, et au cours duquel il lava les pieds de ses apôtres et institua l’Eucharistie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a41abf36-ba24-4176-84f9-0dbdf6b8a7e5",
                                "sense_id": "b71e2965-3dce-3cc1-a01f-d8dd65bf07df",
                                "text": "Il y a près de soixante ans qu’ils demeuraient hors la ville, sur le mont de Sion, au même lieu où Notre-Seigneur fit la Cène avec ses apôtres."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fde3eba-bfb4-3c10-96c4-2483626c9bdf",
                        "entry_id": "5b4656bf-c7dd-3c7a-86cf-79fe611143fe",
                        "glosses": [
                            "Commémoration eucharistique, en parlant du pape, des prélats et des princes ; cérémonie du Jeudi saint, où ils servent des pauvres (parfois 12) après leur avoir lavé les pieds en mémoire de la Cène du Christ."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "095326cc-6f79-3d3b-acde-d71f63fb9131",
                        "entry_id": "5b4656bf-c7dd-3c7a-86cf-79fe611143fe",
                        "glosses": [
                            "Tableau représentant la Cène."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7c17d569-6f79-3757-910a-9895f3f5852c",
                        "entry_id": "5b4656bf-c7dd-3c7a-86cf-79fe611143fe",
                        "glosses": [
                            "Communion que font les protestants sous les deux espèces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c76f5cb-2a89-411b-b9a3-7e181ea63be2",
                                "sense_id": "7c17d569-6f79-3757-910a-9895f3f5852c",
                                "text": "Brenz, au contraire, avait développé jusqu’à son maximum la doctrine de l’ubiquité, dont le but était d’expliquer la présence du corps du Christ dans le pain de la Cène —ce qu’on nomme la consubstantiation— d’une manière qui tend à rapprocher la cène luthérienne de l’eucharistie catholique, laquelle se définit par la transsubstantiation."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac31ef68-1140-3223-801e-f0bf0789b19b",
                        "entry_id": "5b4656bf-c7dd-3c7a-86cf-79fe611143fe",
                        "glosses": [
                            "Repas sacré dans d’autres religions que le christianisme."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b5abd340-20ae-3088-994d-b45ed4ef5a9c",
                        "entry_id": "5b4656bf-c7dd-3c7a-86cf-79fe611143fe",
                        "glosses": [
                            "Repas amical."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "b581f174-2764-4e59-bff9-e7868b3da502",
                                "sense_id": "b5abd340-20ae-3088-994d-b45ed4ef5a9c",
                                "text": "André, qui avait appris au Québec somment sensibiliser les Rwandais à la capote et à l'abstinence, arriva le premier pour ce festin funéraire que Méthode avait appelé la Dernière Cène, précisant en poussant un petit rire brisé par la toux qu'il ne se prenait pas pour le Christ."
                            }
                        ]
                    }
                ],
