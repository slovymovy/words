            {
                "entry_id": "3e72cd3f-2a15-3e01-a3e0-e0fde47a102b",
                "word": "esclavagisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8c4b27b3-1aa5-4ccc-b93b-0e3ee4741383",
                        "entry_id": "3e72cd3f-2a15-3e01-a3e0-e0fde47a102b",
                        "tags": [
                            "plural"
                        ],
                        "form": "esclavagismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b6c7534-60e8-3cf5-9bc0-ceeeaa60f62d",
                        "entry_id": "3e72cd3f-2a15-3e01-a3e0-e0fde47a102b",
                        "glosses": [
                            "Système social fondé sur l'esclavage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654cdf10-3ef5-4149-97c2-5bb5bae2ceb5",
                                "sense_id": "2b6c7534-60e8-3cf5-9bc0-ceeeaa60f62d",
                                "text": "Finalement, la fin de l’esclavagisme et du travail forcé avait laissé la place à un autre système, celui du travail obligé. Et ce dernier était encore plus profitable à l’homme blanc que le précédent."
                            }
                        ]
                    },
                    {
                        "sense_id": "f230fee4-8d61-3fe4-b121-217a215969cc",
                        "entry_id": "3e72cd3f-2a15-3e01-a3e0-e0fde47a102b",
                        "glosses": [
                            "Doctrine favorable à l'esclavage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8c52724-b0a3-4761-a14c-5ae8618d49bf",
                                "sense_id": "f230fee4-8d61-3fe4-b121-217a215969cc",
                                "text": "Cependant, le maintien du statut colonial et du pouvoir des grands planteurs fait que la liberté et la citoyenneté vont être « colorées » par le colonialisme et l’héritage de l’esclavagisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "610c2254-f003-4a9e-9df8-1f9d9128cb7d",
                        "source_entry_id": "3e72cd3f-2a15-3e01-a3e0-e0fde47a102b",
                        "target_lang_word": "proslavery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proslavery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "985b05ff-73f0-3111-ab5f-a24652ceafab",
                                        "entry_id": "b61ec861-00e3-3735-8078-f738d7f49e2e",
                                        "glosses": [
                                            "Supporting slavery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0fc07ac-31dd-4739-b424-ca2310a9da87",
                                                "sense_id": "985b05ff-73f0-3111-ab5f-a24652ceafab",
                                                "text": "By 1835 the excitement was at its height, and especially along the line of the moral and religious argumentation, where the proslavery men met talk with talk."
                                            },
                                            {
                                                "example_id": "14e0d051-fe14-41e3-b5aa-4a24a421b844",
                                                "sense_id": "985b05ff-73f0-3111-ab5f-a24652ceafab",
                                                "text": "When it seemed later that the cause of freedom would eventually triumph the proslavery element undertook to perpetuate slavery through a system of indentured servant labor."
                                            },
                                            {
                                                "example_id": "6ec5b451-8c9b-402c-ae11-89fbadab08ae",
                                                "sense_id": "985b05ff-73f0-3111-ab5f-a24652ceafab",
                                                "text": "His proslavery views were shaped not only by money and status but also by his deeply racist views, which he tried to justify through pseudoscience."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "proslavery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2fcc7b2-a5de-39c9-a0b4-7101ab786d8e",
                                        "entry_id": "67415690-f238-3aa6-b9e3-4d5c4368db28",
                                        "glosses": [
                                            "Support for the institution of slavery."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63b42d99-178d-4e62-b26c-4a35c86bc404",
                                                "sense_id": "a2fcc7b2-a5de-39c9-a0b4-7101ab786d8e",
                                                "text": "The old wisdom that southerners rose up in unison in 1831 after a decade of preparation in the tenets of proslavery is patently an erroneous interpretation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebca1fb3-bb94-4e09-836c-7b9cb83e52f5",
                        "source_entry_id": "3e72cd3f-2a15-3e01-a3e0-e0fde47a102b",
                        "target_lang_word": "schiavismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schiavismo",
