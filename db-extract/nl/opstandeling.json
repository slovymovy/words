                "senses": [
                    {
                        "sense_id": "52ee4897-fead-3719-bfe0-64eca14fa6e1",
                        "entry_id": "424dfc30-d0ca-3602-83b4-b0685bc10dd0",
                        "glosses": [
                            "iemand die zich gewapenderhand verzet tegen het heersende gezag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c4e91ab-5ed9-49d8-aee8-f005de82aebd",
                                "sense_id": "52ee4897-fead-3719-bfe0-64eca14fa6e1",
                                "text": "De opstandelingen kregen het zwaar te verduren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb1997bf-258a-439f-b876-d7aa0eb02bdb",
                        "source_entry_id": "424dfc30-d0ca-3602-83b4-b0685bc10dd0",
                        "source_sense_id": "52ee4897-fead-3719-bfe0-64eca14fa6e1",
                        "source_sense_description": "iemand die zich gewapenderhand verzet tegen het heersende gezag",
                        "target_lang_word": "Aufständischer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufständischer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "304808fb-02b8-35dd-ba0e-5213b66a21cc",
                                        "entry_id": "1430d929-5aa5-3a87-aa94-56d96cfc57b6",
                                        "glosses": [
                                            "eine an einem Aufstand beteiligte (männliche^☆) Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0eb3004-b6a9-4f56-abd1-c9d0f238027a",
                                                "sense_id": "304808fb-02b8-35dd-ba0e-5213b66a21cc",
                                                "text": "„Von Badschis Raffinerie sowie einem nahe gelegenen Energiekraftwerk aus wird vor allem Bagdad mit Benzin und Strom versorgt, was diese Installationen zu bevorzugten Anschlagsorten der sunnitischen Aufständischen gemacht hat - etwa bei der Abstimmung über die irakische Verfassung im vergangenen Oktober, als mehrere Anschläge die Stromversorgung im halben Irak lahm legten.“"
                                            },
                                            {
                                                "example_id": "ad3ccec7-9d3c-4baf-a5a5-bed3af1f340e",
                                                "sense_id": "304808fb-02b8-35dd-ba0e-5213b66a21cc",
                                                "text": "„Bei Kämpfen im Norden von Afghanistan sind nach Nato-Angaben mindestens 130 Aufständische getötet worden.“"
                                            },
                                            {
                                                "example_id": "22245b4c-80d1-403e-ab05-b651b13821e4",
                                                "sense_id": "304808fb-02b8-35dd-ba0e-5213b66a21cc",
                                                "text": "„Da die Regierung seit 1994 weder bereit ist, den politischen Preis für einen vernichtenden Militärschlag gegen die Zapatistische Befreiungsarmee zu zahlen, noch ernsthaft mit den Aufständischen verhandeln will, hofft sie auf das Erlahmen der Widerstandskraft in der Bevölkerung.“"
                                            },
                                            {
                                                "example_id": "9f9c8dff-f7b5-48a3-91d4-daefededfc3b",
                                                "sense_id": "304808fb-02b8-35dd-ba0e-5213b66a21cc",
                                                "text": "„Für 26 Dollar bekommt man dem \"Wall Street Journal\" (\"WSJ\") zufolge die Software, mit der irakische Aufständische die High-Tech-Waffen der USA überlisten. Es sei Aufständischen damit gelungen, die Videoübertragungen von ferngesteuerten Drohnen vom Typ Predator abzufangen.“"
                                            },
                                            {
                                                "example_id": "56c73943-c37f-4416-8602-958c1ca53de7",
                                                "sense_id": "304808fb-02b8-35dd-ba0e-5213b66a21cc",
                                                "text": "„Das Verteidigungsministerium in der Hauptstadt Sanaa erklärte, die \"Säuberung\" Saadas von Aufständischen befinde sich in der \"Schlussphase\". Die Aufständischen warfen der Armee auf ihrer Website vor, sie wollten \"die Stadt zerstören\". Bulldozer seien im Einsatz, um Häuser, Moscheen und historische Monumente niederzuwalzen, hieß es. Bei Kämpfen um die Vormacht in der nordjemenitischen Stadt wurden nach offiziellen Angaben 17 Aufständische und acht Soldaten getötet.“"
                                            },
                                            {
                                                "example_id": "23a643e9-9a7a-4913-9215-085175921b95",
                                                "sense_id": "304808fb-02b8-35dd-ba0e-5213b66a21cc",
                                                "text": "„Wie die Behörden der Nordwestprovinz mitteilten, eröffneten am Montag morgen rund zehn bewaffnete Aufständische das Feuer auf den Tanklaster, der Benzin für die Truppen in Afghanistan geladen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
