                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1761f5-a130-4f2f-8ba6-c42d54f85c06",
                                "sense_id": "2d9962c3-426b-3215-9e24-4715a898d791",
                                "text": "„Eine von vielen Historikern akzeptierte Grundwahrheit besagt, dass Geschichte von Menschen gemacht wird und den Launen des Zufalls unterworfen ist, der bestimmt, welche politischen Führer zu bestimmten kritischen Zeitpunkten die Hebel der Macht bedienen.“"
                            },
                            {
                                "example_id": "1d736cc7-88d7-4ccd-9bea-014b208739dc",
                                "sense_id": "2d9962c3-426b-3215-9e24-4715a898d791",
                                "text": "„Es war auch eine Grundwahrheit, dass Israel immer alles getan hat, um in Verhandlungen zu kommen, und die arabischen Nachbarn sich geweigert haben, mit Israel zu reden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
