                                "example_id": "3bad70b6-10b6-4d2a-8ef0-0673bebb7cb5",
                                "sense_id": "2beeb6b2-b50e-3f10-b021-5938ed93c175",
                                "text": "Il y eut tant de voix pour l’affirmative. Ceux qui soutenaient l’affirmative."
