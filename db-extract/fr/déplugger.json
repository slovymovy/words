                "senses": [
                    {
                        "sense_id": "b03ea337-56aa-3aee-be1d-b77bf84064f5",
                        "entry_id": "5cfc2796-b497-35f3-8608-ca3f962a1a79",
                        "glosses": [
                            "Débrancher."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "87f2fb9e-6502-4dff-aca5-5e3d31e513fe",
                                "sense_id": "b03ea337-56aa-3aee-be1d-b77bf84064f5",
                                "text": "Restarter mon computer, déplugger la batterie?"
                            },
                            {
                                "example_id": "683393ac-0a9d-48a8-b667-f02345ab3f70",
                                "sense_id": "b03ea337-56aa-3aee-be1d-b77bf84064f5",
                                "text": "Il est possible de se déplacer à condition de ne pas se déplugger."
                            },
                            {
                                "example_id": "86e195b1-1733-4d0c-960e-9e0547c02df7",
                                "sense_id": "b03ea337-56aa-3aee-be1d-b77bf84064f5",
                                "text": "Ouais tu peux surement déplugger le sensor aussi, ça doit être plus simple."
                            },
                            {
                                "example_id": "9388c789-719e-4a6d-bad2-7a7b93f77c80",
                                "sense_id": "b03ea337-56aa-3aee-be1d-b77bf84064f5",
                                "text": "Mon pote m’a dit de tenter de déplugger/replugger ma carte graphique tout en brûlant un cierge et en citant trois « je vous salue Marie »…"
                            },
                            {
                                "example_id": "c56957e0-e762-42f7-b9b1-02f68e74e4be",
                                "sense_id": "b03ea337-56aa-3aee-be1d-b77bf84064f5",
                                "text": "L’avantage est que l’on n’a rien à plugger ou déplugger pendant l’émission, ce qui élimine tout risque d’erreur de manipulation au patch."
                            }
                        ]
                    }
