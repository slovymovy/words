                                        "entry_id": "a7d3f5aa-6f58-357d-9ed6-934ebd3bfff8",
                                        "glosses": [
                                            "A serious and often fatal disease caused by the infection of an open wound with the anaerobic bacterium Clostridium tetani, found in soil and the intestines and faeces of animals."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57461bb3-9871-4fea-a49c-1b9d7eb24d87",
                                                "sense_id": "33c69696-469a-3647-a604-5d24f3e11387",
                                                "text": "Compared to 290 children with TQQ negative, CWDs were significantly less likely to receive antenatal care (P=0.003), to get a maternal tetanus shot during antenatal care (P=0.004) and to receive full vaccination (P=0.01)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1bd0ded-255f-3caf-acf3-f395e3b35fe6",
                                        "entry_id": "a7d3f5aa-6f58-357d-9ed6-934ebd3bfff8",
                                        "glosses": [
                                            "A state of muscle tension caused by sustained contraction arising from a rapid series of nerve impulses which do not allow the muscle to relax."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1435bf2a-7276-4466-9330-cafcd56e5d51",
                                                "sense_id": "c1bd0ded-255f-3caf-acf3-f395e3b35fe6",
                                                "text": "We first saturated LTP in one pathway by applying repetitive tetani that had no effect on the control pathway […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
