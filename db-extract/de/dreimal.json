                        "examples": [
                            {
                                "example_id": "8c972af9-fe4a-41e9-9428-1cbb016ba269",
                                "sense_id": "43e56dc7-f7d7-3f9c-bf22-c776aeaf8016",
                                "text": "Jesus sprach zu ihm: Wahrlich ich sage dir: In dieser Nacht, ehe der Hahn kräht, wirst du mich dreimal verleugnen.",
                                "translation": "Иисус сказал ему: истинно говорю тебе, что в эту ночь, прежде нежели пропоет петух, трижды отречешься от Меня."
                            }
