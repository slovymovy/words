                        "glosses": [
                            "Assurer son propre recrutement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfea0102-5169-4ef9-ba9f-2616764f3679",
                                "sense_id": "e5835f99-37ba-31a1-9116-0f71cc6586bd",
                                "text": "Crise de candidats, choix délibéré du corps de ville de s’autorecruter ?"
                            },
                            {
                                "example_id": "33e72bbb-0b7f-4bf4-9f78-e662654d4833",
                                "sense_id": "e5835f99-37ba-31a1-9116-0f71cc6586bd",
                                "text": "Il laisse les fiefs s’autorecruter, n’opère aucun contrôle réel sur l’usage qu’ils font de leurs ressources et leur assure de facto une quasi-immunité judiciaire."
                            },
                            {
                                "example_id": "c917f95a-2e4e-41f0-a560-ba64017be5b1",
                                "sense_id": "e5835f99-37ba-31a1-9116-0f71cc6586bd",
                                "text": "C’est le contraire qui va se produire, vos contacts vont s’autorecruter."
                            }
                        ]
