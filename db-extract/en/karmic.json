                        ],
                        "examples": [
                            {
                                "example_id": "ca6eaeca-8a05-4591-a83d-306cfb2b43f6",
                                "sense_id": "db900105-9e1a-3a59-a8eb-6a969c8583db",
                                "text": "Ken Kesey was one who supported abortion only to save the life of the mother, arguing that society needed to care about everyone, including “the un-dead old [and]^([sic]) the un-born young.” As he put it, “Abortions are a terrible karmic bummer.”"
                            }
                        ]
