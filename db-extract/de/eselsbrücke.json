                "senses": [
                    {
                        "sense_id": "f3eab2e4-6469-3867-b3e4-93bd400cf122",
                        "entry_id": "c6bc975d-4c2c-332d-9f6c-be2e5844c5ca",
                        "glosses": [
                            "Hilfe, kurzer Spruch, um sich etwas besser merken zu können"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c914a3bd-b5fb-4f2c-89e7-31a62d3bf854",
                                "sense_id": "f3eab2e4-6469-3867-b3e4-93bd400cf122",
                                "text": "„Zwar verspürte ich weiterhin Abscheu und Ohnmacht vor den tückischen Zeichen, tat aber mein Bestes, ihnen über Eselsbrücken näherzukommen.“"
                            },
                            {
                                "example_id": "98540b5b-2755-4665-ae21-abd9ab9fb2bd",
                                "sense_id": "f3eab2e4-6469-3867-b3e4-93bd400cf122",
                                "text": "Eine Eselsbrücke, mit der man sich die Reihenfolge der Gitarrensaiten merken kann, lautet: Eine alte Dame geht heute einkaufen. (E-A-D-G-H-E)"
                            },
                            {
                                "example_id": "1716cae1-acc8-433a-b438-4ba373181a71",
                                "sense_id": "f3eab2e4-6469-3867-b3e4-93bd400cf122",
                                "text": "Die Himmelsrichtungen bringt man nicht mehr durcheinander mit der Eselsbrücke: Nie ohne Seife waschen! (Nord-Ost-Süd-West)"
                            },
                            {
                                "example_id": "f417fac9-be4c-484c-8926-0249e57a6e78",
                                "sense_id": "f3eab2e4-6469-3867-b3e4-93bd400cf122",
                                "text": "Eine Eselsbrücke für die Zeitumstellungen auf Sommer-/Winterzeit im März und Oktober mit Hilfe von Vokalen lautet: Im SOmmer nach vOrne, im WInter nach hInten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1c8be15-920f-455b-8eab-a7274dd1e4aa",
                        "source_entry_id": "c6bc975d-4c2c-332d-9f6c-be2e5844c5ca",
                        "source_sense_id": "f3eab2e4-6469-3867-b3e4-93bd400cf122",
                        "source_sense_description": "umgangssprachlich: Hilfe, kurzer Spruch, um sich etwas besser merken zu können",
                        "target_lang_word": "mnemonic",
