                "senses": [
                    {
                        "sense_id": "ea354311-67c5-34f5-9b84-422699ce6400",
                        "entry_id": "859c88f8-5576-30dc-ab91-60cc0b670be3",
                        "glosses": [
                            "für den Einzelhandel besonders umsatzstarke Zeitspanne vor den Weihnachtsfeiertagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1108cc4-dd54-480b-95e1-10e8ffe5b996",
                                "sense_id": "ea354311-67c5-34f5-9b84-422699ce6400",
                                "text": "Der Buchhandel war im letzten Jahr mit dem Weihnachtsgeschäft zufrieden."
                            },
                            {
                                "example_id": "7445bacc-92cd-41d6-9189-e0d0c373333e",
                                "sense_id": "ea354311-67c5-34f5-9b84-422699ce6400",
                                "text": "Die Gewerkschaft kündigte an, ihren Streik auf das Weihnachtsgeschäft auszuweiten."
                            },
                            {
                                "example_id": "182207f7-ed5e-4514-9e82-000458633588",
                                "sense_id": "ea354311-67c5-34f5-9b84-422699ce6400",
                                "text": "„Anscheinend hat sich schnell rumgesprochen, dass es bei uns jetzt ein bisschen mehr Platz gibt, denn im nächsten Weihnachtsgeschäft kommen tatsächlich noch mehr Kunden.“"
                            },
                            {
                                "example_id": "e4ffc1c1-6064-4bca-b8e8-560d9416e866",
                                "sense_id": "ea354311-67c5-34f5-9b84-422699ce6400",
                                "text": "„Von Westen robbte sich das Tief heran, die Berliner Freunde brauchten ihr Wohnzimmer zurück, daheim wartete die Katze, und dann musste auch das Weihnachtsgeschäft vorbereitet werden: Hauptsaison.“"
                            },
                            {
                                "example_id": "64ac67b1-44b1-49ef-9ab6-3b0ea6ce8540",
                                "sense_id": "ea354311-67c5-34f5-9b84-422699ce6400",
                                "text": "„Das Weihnachtsgeschäft 1931 war enttäuschend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
