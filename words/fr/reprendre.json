{
    "word_family": [
        "reprise",
        "reprisage",
        "repriseur",
        "repreneur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a945fe41-3353-3504-84e1-b0dc2e76f11e",
                    "sense_definition": "Prendre de nouveau d'un aliment ou d'une boisson, se resservir.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voulez-vous <w>reprendre</w> un peu de café ou préférez-vous de l'eau ?"
                        },
                        {
                            "text": "Le repas était si bon que les invités ont voulu en <w>reprendre</w>."
                        }
                    ],
                    "synonyms": [
                        "se resservir"
                    ],
                    "common_phrases": [
                        "reprendre du café",
                        "reprendre du dessert"
                    ]
                },
                {
                    "sense_id": "908754b9-4df4-3ed5-9814-8f33d12f916a",
                    "sense_definition": "Recommencer une activité ou se remettre à une tâche après une interruption.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette courte pause pour déjeuner, nous allons <w>reprendre</w> le travail."
                        },
                        {
                            "text": "Mon frère a décidé de <w>reprendre</w> ses études après deux ans d'expérience professionnelle."
                        }
                    ],
                    "synonyms": [
                        "continuer",
                        "poursuivre",
                        "recommencer"
                    ],
                    "antonyms": [
                        "arrêter",
                        "interrompre"
                    ],
                    "common_phrases": [
                        "reprendre le travail",
                        "reprendre les cours",
                        "reprendre ses études"
                    ]
                },
                {
                    "sense_id": "db8655d4-29f2-3da3-b43b-a59c7952e5e9",
                    "sense_definition": "Prendre de nouveau possession de ce qu'on avait perdu, cédé ou laissé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir voyagé pendant un an, elle a pu <w>reprendre</w> sa place dans l'entreprise."
                        },
                        {
                            "text": "Il a fallu quelques minutes au coureur pour <w>reprendre</w> son souffle après l'effort."
                        }
                    ],
                    "synonyms": [
                        "recouvrer",
                        "récupérer"
                    ],
                    "antonyms": [
                        "abandonner",
                        "céder"
                    ],
                    "common_phrases": [
                        "reprendre possession",
                        "reprendre sa place",
                        "reprendre ses esprits"
                    ]
                },
                {
                    "sense_id": "b332e44f-a0b2-3e76-8992-c9664dc88f7f",
                    "sense_definition": "Interpréter ou enregistrer un morceau musical créé par un autre artiste.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune groupe a décidé de <w>reprendre</w> une chanson très célèbre des années quatre-vingt."
                        },
                        {
                            "text": "L'artiste a <w>repris</w> ce grand classique dans une version acoustique originale."
                        }
                    ],
                    "common_phrases": [
                        "reprendre un morceau",
                        "reprendre une chanson"
                    ]
                },
                {
                    "sense_id": "ad529d87-6b80-3b58-94e7-fb428d16ceba",
                    "sense_definition": "Continuer de parler après une pause, ou répliquer dans un dialogue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un bref silence, l'orateur a pu <w>reprendre</w> la parole devant un public attentif."
                        },
                        {
                            "text": "« Nous réglerons cette question demain matin », <w>reprit</w>-il d'un ton résolu."
                        }
                    ],
                    "synonyms": [
                        "enchaîner",
                        "poursuivre"
                    ],
                    "common_phrases": [
                        "reprendre la parole"
                    ]
                },
                {
                    "sense_id": "1460f34c-2317-31e5-9320-e384a7afbdbb",
                    "sense_definition": "Faire une remarque à quelqu'un afin de rectifier une erreur ou de lui adresser un reproche.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur doit régulièrement <w>reprendre</w> les enfants sur leur manière de s'exprimer."
                        },
                        {
                            "text": "Elle déteste qu'on la <w>reprenne</w> en public lorsqu'elle commet une faute involontaire."
                        }
                    ],
                    "synonyms": [
                        "blâmer",
                        "corriger",
                        "réprimander"
                    ],
                    "antonyms": [
                        "approuver",
                        "féliciter"
                    ],
                    "common_phrases": [
                        "reprendre un élève",
                        "se faire reprendre"
                    ]
                },
                {
                    "sense_id": "5fb4d773-d748-340f-bdcd-b6224e9e05c1",
                    "sense_definition": "Se ressaisir, retrouver son calme ou son sang-froid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un instant de panique sur scène, la comédienne a su se <w>reprendre</w>."
                        },
                        {
                            "text": "Troublé par la mauvaise nouvelle, il lui a fallu plusieurs minutes pour se <w>reprendre</w>."
                        }
                    ],
                    "synonyms": [
                        "se ressaisir"
                    ],
                    "antonyms": [
                        "paniquer"
                    ]
                },
                {
                    "sense_id": "a92ae584-fbdf-3cb8-9fca-d40c4a59e090",
                    "sense_definition": "Recommencer à se manifester ou retrouver un cours normal, en parlant d'un phénomène ou d'une activité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès les premiers jours de l'été, le commerce commence enfin à <w>reprendre</w> dans la région."
                        },
                        {
                            "text": "Le calme était revenu dans la vallée, mais la pluie a soudainement <w>repris</w> en soirée."
                        }
                    ],
                    "synonyms": [
                        "redémarrer"
                    ],
                    "antonyms": [
                        "cesser"
                    ],
                    "common_phrases": [
                        "l'activité reprend",
                        "les affaires reprennent"
                    ]
                }
            ]
        }
    ]
}