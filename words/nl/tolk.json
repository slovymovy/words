{
    "word_family": [
        "tolken",
        "tolkencabine",
        "tolkdienst"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad9e8bc8-9887-3a15-ad78-3562f4d60fef",
                    "sense_definition": "Een persoon die gesproken of gebaarde taal ter plekke vertaalt naar een andere taal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vertaler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De minister had een professionele <w>tolk</w> nodig om met de buitenlandse gasten te kunnen spreken.",
                            "target_lang_translations": {
                                "en": "The minister needed a professional <w>interpreter</w> to be able to speak with the foreign guests."
                            }
                        },
                        {
                            "text": "Zij werkt als <w>tolk</w> bij de Europese Unie en spreekt vloeiend vier talen.",
                            "target_lang_translations": {
                                "en": "She works as an <w>interpreter</w> at the European Union and speaks four languages fluently."
                            }
                        }
                    ],
                    "synonyms": [
                        "tolker",
                        "vertaler"
                    ],
                    "common_phrases": [
                        "beëdigd tolk",
                        "werken als tolk"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who translates spoken or signed language on the spot into another language."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "interpreter",
                                "target_lang_sense_clarification": "for spoken or signed language"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcf6d415-fe37-399b-b568-c5c3ed4ff0f0",
                    "sense_definition": "Iemand die namens een andere persoon of groep spreekt; een woordvoerder.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "woordvoerder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakbondsleider trad op als de <w>tolk</w> van de ontevreden werknemers.",
                            "target_lang_translations": {
                                "en": "The union leader acted as the <w>spokesperson</w> for the dissatisfied employees."
                            }
                        },
                        {
                            "text": "Zij was de <w>tolk</w> van de gevoelens die leefden binnen de gemeenschap.",
                            "target_lang_translations": {
                                "en": "She was the <w>interpreter</w> of the feelings that existed within the community."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de tolk van"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who speaks on behalf of another person or group; a spokesperson."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spokesperson",
                                "target_lang_sense_clarification": "speaking on behalf of others"
                            },
                            {
                                "target_lang_word": "mouthpiece",
                                "target_lang_sense_clarification": "person expressing the views of others"
                            },
                            {
                                "target_lang_word": "interpreter",
                                "target_lang_sense_clarification": "figurative, expressing others' feelings or thoughts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b043c586-3fbe-359f-8176-04e1c57329b7",
                    "sense_definition": "Iemand die de betekenis van iets (zoals kunst of een tekst) uitlegt of interpreteert.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interpretator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze pianist wordt beschouwd als een uitstekende <w>tolk</w> van de muziek van Chopin.",
                            "target_lang_translations": {
                                "en": "This pianist is considered an excellent <w>interpreter</w> of Chopin's music."
                            }
                        },
                        {
                            "text": "Als <w>tolk</w> van oude geschriften probeert de historicus de ware betekenis te achterhalen.",
                            "target_lang_translations": {
                                "en": "As an <w>interpreter</w> of ancient writings, the historian tries to discover the true meaning."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who explains or interprets the meaning of something (such as art or a text)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "interpreter",
                                "target_lang_sense_clarification": "of art, music, or texts"
                            },
                            {
                                "target_lang_word": "exponent",
                                "target_lang_sense_clarification": "of an artistic style or composer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68401bf6-7e60-3681-9916-d6366397d02a",
                    "sense_definition": "Een zejaarsterm voor een (vouw)duimstok om boutgaten mee op te meten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meetgereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman vroeg de matroos om de <w>tolk</w> aan te geven om de gaten op te meten.",
                            "target_lang_translations": {
                                "en": "The carpenter asked the sailor to hand him the <w>folding rule</w> to measure the holes."
                            }
                        },
                        {
                            "text": "Met een houten <w>tolk</w> bepaalde hij nauwkeurig de diepte van het boutgat.",
                            "target_lang_translations": {
                                "en": "With a wooden <w>rule</w> he accurately determined the depth of the bolt hole."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "sailors' jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A shipwright's term for a (folding) rule used to measure bolt holes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "folding rule",
                                "target_lang_sense_clarification": "used for measuring bolt holes in shipbuilding"
                            },
                            {
                                "target_lang_word": "rule",
                                "target_lang_sense_clarification": "measuring tool"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b45ae84-2133-331b-93b1-6ac683f37666",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>tolken</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>tolk</w> vandaag tijdens de internationale conferentie in Den Haag.",
                            "target_lang_translations": {
                                "en": "I am <w>interpreting</w> today during the international conference in The Hague."
                            }
                        },
                        {
                            "text": "Als ik voor de rechtbank <w>tolk</w>, moet ik heel nauwkeurig zijn.",
                            "target_lang_translations": {
                                "en": "When I <w>interpret</w> for the court, I have to be very precise."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'tolken' (to interpret)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "interpret",
                                "target_lang_sense_clarification": "first-person singular present"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca0cdc04-e54a-36ff-8c65-cf0acc4ee4a4",
                    "sense_definition": "Inversievorm of tweede persoon enkelvoud tegenwoordige tijd van <w>tolken</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tolk</w> je morgen ook bij die belangrijke vergadering?",
                            "target_lang_translations": {
                                "en": "Are you <w>interpreting</w> at that important meeting tomorrow too?"
                            }
                        },
                        {
                            "text": "Waarom <w>tolk</w> je eigenlijk niet vaker voor Franstalige groepen?",
                            "target_lang_translations": {
                                "en": "Why don't you actually <w>interpret</w> more often for French-speaking groups?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present inversion"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Inversion form or second-person singular present tense of 'tolken' (to interpret)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "interpret",
                                "target_lang_sense_clarification": "second-person singular present"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed3005f5-5da7-3827-8c01-893fda27283d",
                    "sense_definition": "Gebiedende wijs van <w>tolken</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tolk</w> nu eens wat die man daar aan het vertellen is!",
                            "target_lang_translations": {
                                "en": "Now <w>interpret</w> what that man over there is telling!"
                            }
                        },
                        {
                            "text": "Luister goed en <w>tolk</w> de zinnen zo letterlijk mogelijk.",
                            "target_lang_translations": {
                                "en": "Listen carefully and <w>interpret</w> the sentences as literally as possible."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'tolken' (to interpret)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "interpret",
                                "target_lang_sense_clarification": "imperative"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}