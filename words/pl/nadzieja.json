                        "en": "A surname used in Poland."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Надзея",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "Nadzieja",
                                "target_lang_sense_clarification": "a Polish surname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
