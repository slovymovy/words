                                "target_lang_sense_clarification": "short form for Brussels sprout"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a369700d-ba06-3bc2-a181-e1e6ca757483",
                    "sense_definition": "Verkleinwoord van <w>spruit</w>, een jonge plantenscheut of nazaat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verkleinwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uit het pas gezaaide zaadje kwam al snel een klein groen <w>spruitje</w> tevoorschijn.",
                            "target_lang_translations": {
                                "en": "A tiny green <w>sprout</w> quickly emerged from the newly sown seed."
                            }
                        },
                        {
                            "text": "Zij wees vol trots naar het jonge <w>spruitje</w> in haar vensterbank.",
                            "target_lang_translations": {
                                "en": "She proudly pointed to the young <w>shoot</w> on her windowsill."
                            }
