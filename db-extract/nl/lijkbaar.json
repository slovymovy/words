                    {
                        "translation_id": "452f1ed6-df2a-4884-b2b6-b53345a19457",
                        "source_entry_id": "605980fe-75e0-3e8b-9b47-fd01110109e7",
                        "source_sense_id": "a36c2845-43e2-3398-9db7-b202a5ebcf4b",
