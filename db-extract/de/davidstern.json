                    },
                    {
                        "translation_id": "94de3546-d6fe-4ec4-b28c-71292fe5bd51",
                        "source_entry_id": "147a5621-adb3-3764-8b89-be85a539ed80",
                        "source_sense_id": "e8bec922-4cb7-3918-8154-b3293517c3f6",
                        "source_sense_description": "sechseckiger Stern als Symbol für das Judentum",
