                        "entry_id": "09dd0d4d-3fce-3fe6-b449-68bba4264352",
                        "glosses": [
                            "Évocation de la mémoire, du souvenir de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "781bd384-a624-4dc1-a87e-bad4e97351a0",
                                "sense_id": "0dc1ef9c-8b48-36ed-9d23-cc5fac38c235",
                                "text": "La mémoration de l’abolition de l’esclavage par la République française."
                            },
                            {
                                "example_id": "6ab10631-675b-42fc-921b-a10491397b75",
                                "sense_id": "0dc1ef9c-8b48-36ed-9d23-cc5fac38c235",
                                "text": "Le narrateur [Proust] rentre chez lui pour construire le passé : on ne vit le présent que dans la mémoration."
                            },
                            {
                                "example_id": "1ebd75e8-8bde-46f0-ad40-fc82bc24d669",
                                "sense_id": "0dc1ef9c-8b48-36ed-9d23-cc5fac38c235",
                                "text": "La mémoration des sensations non sensuelles n’est habituellement pas de longue durée, mais, généralement, très vite effacée."
                            }
                        ]
                    }
                ],
