        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "16406568-d947-356a-aa1d-b9cf6db89be0",
                "word": "pseudohermaphrodite",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "52bba757-9ad9-3a37-b45b-01c5921299aa",
                        "entry_id": "16406568-d947-356a-aa1d-b9cf6db89be0",
                        "glosses": [
                            "Having external genitalia of one sex, but the internal sex organs of the other."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5aae6310-6f0b-46fd-9aee-9c5063ba7700",
                                "sense_id": "52bba757-9ad9-3a37-b45b-01c5921299aa",
                                "text": "In the case described by Recasens himself of a pseudohermaphrodite woman there was a formation of testicular appearance on the labia majora; but its histological examination demonstrated that this was not a gonad, but a glandular mass of a nature which defied diagnosis."
                            },
                            {
                                "example_id": "3d378bc1-76db-4f38-b236-e4ff6e106c02",
                                "sense_id": "52bba757-9ad9-3a37-b45b-01c5921299aa",
                                "text": "The chief psychologic and psychiatric problems encountered in the adrenogenital syndrome are those associated with the sex orientation of untreated and undiagnosed pseudohermaphrodite women (33)."
                            },
                            {
                                "example_id": "6f41a48b-2c1a-4ab0-97f1-ab7940dc68a6",
                                "sense_id": "52bba757-9ad9-3a37-b45b-01c5921299aa",
                                "text": "However, prostate cancer does not appear to occur in a cohort of pseudohermaphrodite men in whom 5-alpha reductase is absent."
                            },
                            {
                                "example_id": "fbb4494c-2703-4324-9cfb-1f88969d8931",
                                "sense_id": "52bba757-9ad9-3a37-b45b-01c5921299aa",
                                "text": "They form one group of the pseudohermaphrodite men mentioned above: their prostate glands remain in the pre-pubertal state, and never become cancerous."
                            }
                        ]
                    }
                ],
