                                "target_senses": [
                                    {
                                        "sense_id": "7793249c-0034-3f71-a442-3c90b2add885",
                                        "entry_id": "1d03d156-e580-39c1-8c99-df77639bc05b",
                                        "glosses": [
                                            "Fired ceramic wares that contain clay when formed."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4ed578b-17ce-46e1-a4bb-cb901ab71c36",
                                                "sense_id": "7793249c-0034-3f71-a442-3c90b2add885",
                                                "text": "The shelves were lined with pottery of all shapes and sizes."
                                            },
                                            {
                                                "example_id": "7de7649b-2c6d-4937-8396-2da386239721",
                                                "sense_id": "7793249c-0034-3f71-a442-3c90b2add885",
                                                "text": "But through the oligopoly, charcoal fuel proliferated throughout London's trades and industries. By the 1200s, brewers and bakers, tilemakers, glassblowers, pottery producers, and a range of other craftsmen all became hour-to-hour consumers of charcoal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad8a199a-f089-376d-831d-7ea69199e67a",
                                        "entry_id": "1d03d156-e580-39c1-8c99-df77639bc05b",
                                        "glosses": [
                                            "A potter's shop or workshop, where pottery is made."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "250a583e-320e-46c3-b0d6-4dc3d2f8606f",
                                                "sense_id": "ad8a199a-f089-376d-831d-7ea69199e67a",
                                                "text": "I visited the old potteries and saw the pots being made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f68596a9-a8b8-3772-9951-bf54dde9fbac",
                                        "entry_id": "1d03d156-e580-39c1-8c99-df77639bc05b",
                                        "glosses": [
                                            "The potter's craft or art: making vessels from clay."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "619ca974-3a87-4790-816d-a4bf27eb3d3d",
                                                "sense_id": "f68596a9-a8b8-3772-9951-bf54dde9fbac",
                                                "text": "Bernard Leach was skilled at pottery."
                                            }
                                        ]
                                    }
                                ]
