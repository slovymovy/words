                                                "sense_id": "49c57eba-3668-3114-ab43-03c7405d2a2a",
                                                "text": "Uns steht eine strenge Zeit der Enthaltsamkeit bevor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bf4f973d-ed39-32f7-8f90-5338e5c99483",
                                        "entry_id": "bae82eaf-fa33-3285-82e6-52c1130b499c",
                                        "glosses": [
                                            "sich durch betonte Einfachheit auszeichnend"
