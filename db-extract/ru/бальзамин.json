                        "examples": [
                            {
                                "example_id": "0d086a6d-f143-409d-8350-46e39377ff78",
                                "sense_id": "518c6053-cc49-3079-8f08-a4ebceb4c1c1",
                                "text": "На окнах стояли цветы: бальзамины, алоэ, розан."
                            },
