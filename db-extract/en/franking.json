                                        "entry_id": "841c9bef-703b-3551-b268-559f08cb85d4",
                                        "glosses": [
                                            "Postwertzeichen (Briefmarke, Freistempel oder Ähnliches), das die Entrichtung der Postgebühr für eine Sendung bestätigt"
                                        ],
                                        "tags": [
                                            "Postwesen"
                                        ],
