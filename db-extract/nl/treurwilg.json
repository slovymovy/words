                ],
                "translations": [
                    {
                        "translation_id": "cd8c6c0e-3e86-423f-8316-db752c71fd23",
                        "source_entry_id": "c259c92a-0252-3cb7-a1d9-a8217e9f81b0",
                        "source_sense_id": "b9882f29-c5a6-31a7-a603-c1d79fda8e84",
                        "source_sense_description": "(plantkunde) wilg met dunne neerhangende takken van het plantengeslacht Salix",
                        "target_lang_word": "Trauerweide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trauerweide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf97d8c8-d9e6-3103-b0ca-eb523f9dce92",
                                        "entry_id": "7e8efb44-41a7-3824-a144-e9e684f35cc7",
                                        "glosses": [
                                            "Weide (mit einer speziellen Wuchsform), deren Äste nach unten hängen (Salix babylonica)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37acb81d-42c9-4198-826e-e63ae51575ec",
                                                "sense_id": "bf97d8c8-d9e6-3103-b0ca-eb523f9dce92",
                                                "text": "Auf dem Hügel stand eine Trauerweide."
                                            },
                                            {
                                                "example_id": "ab68e74b-5054-450b-8236-b14915a59e43",
                                                "sense_id": "bf97d8c8-d9e6-3103-b0ca-eb523f9dce92",
                                                "text": "„Ich wünschte, die Trauerweide wäre nie richtig angegangen, wäre eingegangen, verkümmert.“"
                                            },
                                            {
                                                "example_id": "e60cf086-a4a3-4a1a-b523-dee05af7c640",
                                                "sense_id": "bf97d8c8-d9e6-3103-b0ca-eb523f9dce92",
                                                "text": "„Hinter den Fenstern, an denen das Wasser in Strömen herabrann, stand eine Trauerweide mit ausgehöhltem Stamm, deren haarfeine Äste in alle Richtungen gepeitscht wurden.“"
                                            },
                                            {
                                                "example_id": "ad50f773-ccbe-4054-b03a-63d464b00528",
                                                "sense_id": "bf97d8c8-d9e6-3103-b0ca-eb523f9dce92",
                                                "text": "„Ich blickte auf die mit dreckigem Schnee bedeckte deutsche Erde in unserem Garten, zum Rhein, über die Trauerweiden hinweg aufs Siebengebirge, und diese ganze Szenerie kam mir idiotisch vor.“"
                                            },
                                            {
                                                "example_id": "cbe45569-6e9b-4040-90cd-d24d3c675be5",
                                                "sense_id": "bf97d8c8-d9e6-3103-b0ca-eb523f9dce92",
                                                "text": "„Die Trauerweiden waren umgestürzt; die Wurzeln schienen dadurch die Äste zu sein, und die Zweige lange, schleifende grüne Wurzeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53b6d2b5-1a5c-3e52-92c4-917a0e74907e",
                                        "entry_id": "7e8efb44-41a7-3824-a144-e9e684f35cc7",
                                        "glosses": [
                                            "Mensch, der oft bekümmert und wehleidig ist"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94dde409-2bdf-47b7-9a09-6c76e6724deb",
                                                "sense_id": "53b6d2b5-1a5c-3e52-92c4-917a0e74907e",
                                                "text": "„Weißt was, du kleine Trauerweide? Wir wollen für heute Schluss machen!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
