                                        "glosses": [
                                            "Synonyme de corticostéroïde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1a060f-06ac-4c5a-8344-7e8377b9c139",
                                                "sense_id": "8af11bbd-8551-3fd7-baa5-b09d8d5735b1",
                                                "text": "En revanche, les corticoïdes semblent accroître le risque de rupture prématurée des membranes et de survenue de diabète, hypertension artérielle et d’ostéoporose."
                                            }
