    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "8af2864a-15f7-39eb-94fd-900e375c0bcf",
                "word": "versjacheren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e5169a8c-fe59-3bc1-ada2-99994381e9cf",
                        "entry_id": "8af2864a-15f7-39eb-94fd-900e375c0bcf",
                        "glosses": [
                            "op een oneerlijke manier iets verhandelen, verkopen of verruilen voor iets anders, vaak gaat het om onbetaalbare, onvervangbare (immateriële) zaken die verruilt voor geld (het slijk der aarde) of aanzien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35e2543-4484-43f7-8d67-f992870f18d8",
                                "sense_id": "e5169a8c-fe59-3bc1-ada2-99994381e9cf",
                                "text": "De locatie zou het hele jaar open moeten zijn, maar is in plaats daarvan maar een korte periode van het jaar te bezoeken, want ja: vleermuizen. Volgens natuurdeskundigen verkwanselen en versjacheren we de leefwereld van deze unieke diersoort. Maar zijn het niet de vleermuizen die een vuursteenmijn kraken en ons mensen buitensluiten? Wat een terreur"
                            },
                            {
                                "example_id": "ed8f9add-0128-4c9d-8778-dfab30b1285b",
                                "sense_id": "e5169a8c-fe59-3bc1-ada2-99994381e9cf",
                                "text": "Vaak dreigen ze met vertrek, zelden gaan ze . Want wie eenmaal weg is, mag nooit meer bij Pauw & Witteman aanschuiven voor een potje vrij mopperen over het versjacheren van principes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34d5a31c-b317-42d6-950a-3bdf3a9c146e",
                        "source_entry_id": "8af2864a-15f7-39eb-94fd-900e375c0bcf",
                        "source_sense_id": "e5169a8c-fe59-3bc1-ada2-99994381e9cf",
                        "target_lang_word": "flog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e26169d6-a853-3d38-955a-8aac64ef2b59",
                                        "entry_id": "6e6b7e81-ba94-3de9-bd23-5280f7e13382",
                                        "glosses": [
                                            "To whip or scourge as punishment."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2ab15f9-c940-32dc-b3c5-3dab37dd48dc",
                                        "entry_id": "6e6b7e81-ba94-3de9-bd23-5280f7e13382",
                                        "glosses": [
                                            "To use something to extreme; to abuse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9899db1a-ee89-47b5-ad00-1109085bbd92",
                                                "sense_id": "c2ab15f9-c940-32dc-b3c5-3dab37dd48dc",
                                                "text": "I did seven laps of Fyshwick with the mechanic today. I was turning lots of heads on the last few, people must of thought I was nuts, flogging the car then stopping, then driving slow then flogging it again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12c4b5a2-6cd3-349b-b91e-9b982003c77b",
                                        "entry_id": "6e6b7e81-ba94-3de9-bd23-5280f7e13382",
                                        "glosses": [
                                            "To sell."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6f762af-0a6c-4975-9e03-cfe78ad4f561",
                                                "sense_id": "12c4b5a2-6cd3-349b-b91e-9b982003c77b",
                                                "text": "And then there's my part time job at Telstra Bigpond flogging their cable network for just $67.55/month long term cost, a BARGAIN, and the other part time job flogging Foxtel at something like $50/month."
                                            },
                                            {
                                                "example_id": "c7f7e291-ca8e-4b68-a0f6-36afbdaf512b",
                                                "sense_id": "12c4b5a2-6cd3-349b-b91e-9b982003c77b",
                                                "text": "Flanders was able to flog his piece of land, for which he had originally paid £4,000, to one of the largest gold-mining corporations for something like a couple of million smackers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d431e841-4e3e-3cad-914d-c8280e355aee",
                                        "entry_id": "6e6b7e81-ba94-3de9-bd23-5280f7e13382",
                                        "glosses": [
                                            "To steal something."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37452720-da38-3e78-8c6b-ec99b6a2c553",
                                        "entry_id": "6e6b7e81-ba94-3de9-bd23-5280f7e13382",
                                        "glosses": [
                                            "To defeat easily or convincingly."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e25e8895-38ef-4e51-86cd-392dd4dd885f",
                                                "sense_id": "37452720-da38-3e78-8c6b-ec99b6a2c553",
                                                "text": "The Swannies got on a real roll over rounds 16/17 & 18 of 1987. In consecutive SCG matches, they flogged the Eags 30.21 to 10.11, followed that with a 36.20 to 11.7 demolition of the Dons and finally a 31.12 to 15.17 thrashing of Richmond."
                                            },
                                            {
                                                "example_id": "311b27b5-ef67-4432-b17f-be0f5ee1d077",
                                                "sense_id": "37452720-da38-3e78-8c6b-ec99b6a2c553",
                                                "text": "Anyone with cable watch this on ESPN \"History of Cricket\" last night? Australia got flogged by an innings in the fourth test."
                                            },
                                            {
                                                "example_id": "fc21a411-1725-424c-9a79-640be33e3549",
                                                "sense_id": "37452720-da38-3e78-8c6b-ec99b6a2c553",
                                                "text": "It'll make the Raiders look good. Getting flogged by a team that got flogged by a team that got flogged by the Bulldogs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3825ccf3-c541-3839-a06e-0f634cbafbf8",
                                        "entry_id": "6e6b7e81-ba94-3de9-bd23-5280f7e13382",
                                        "glosses": [
                                            "To overexploit (land), as by overgrazing, overstocking, etc."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd085e8b-7411-4d07-9817-05eb70974ca1",
                                                "sense_id": "3825ccf3-c541-3839-a06e-0f634cbafbf8",
                                                "text": "The environment is paying dearly as producers flog their land. Sustainable agriculture needs a new generation of energised science and technology-trained farmers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1960bebd-1767-30b5-9aca-cb30de5ee509",
                                        "entry_id": "6e6b7e81-ba94-3de9-bd23-5280f7e13382",
                                        "glosses": [
                                            "To beat away charcoal dust etc. using a flogger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "592242d3-2fda-34fc-8a3e-ecc2efc32d76",
                                        "entry_id": "431bc12f-c8d2-3add-81ee-37b9faa5116f",
                                        "glosses": [
                                            "A contemptible, often arrogant person; a wanker."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06bc3ea0-832f-479c-bec8-7d3702735218",
                                                "sense_id": "592242d3-2fda-34fc-8a3e-ecc2efc32d76",
                                                "text": "It follows the ejection of a supporter who allegedly ran towards umpire Mathew Nicholls while calling him a \"bald-headed flog\" at half-time of the Carlton-Brisbane Lions match last Saturday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26d5e1d6-2c53-3706-8233-a38f2665b944",
                                        "entry_id": "9cb15e35-1510-378c-b32d-878410ffe7e1",
                                        "glosses": [
                                            "A weblog designed to look authentic, but actually developed as part of a commercial marketing strategy to promote some product or service."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e3d278d-7a62-47b2-b0e2-34ffb5d2d87b",
                                                "sense_id": "26d5e1d6-2c53-3706-8233-a38f2665b944",
                                                "text": "Though a handful of viral videos and flogs have captured significant interest, the vast majority hardly register with consumers."
                                            },
                                            {
                                                "example_id": "8d7f3b97-d9d5-45de-abb6-9b6ba96ec15e",
                                                "sense_id": "26d5e1d6-2c53-3706-8233-a38f2665b944",
                                                "text": "An element more problematic […] in the move of corporate communications and practices online is the sometimes masked nature of such initiatives, for example through blogola and flogs."
                                            },
                                            {
                                                "example_id": "561bf232-bb90-4fd1-92b0-dd0c01a2b100",
                                                "sense_id": "26d5e1d6-2c53-3706-8233-a38f2665b944",
                                                "text": "[…] hidden advertising and flogs (the use of “personal blogs” for unfair commercial and political purposes), […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b306718-10a3-44b6-834e-8c54343e7c44",
