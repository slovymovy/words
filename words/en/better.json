{
    "word_family": [
        "betterment",
        "unbettered"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "62f1c657-5c3a-3e2b-af1d-6f5f739db7b9",
                    "sense_definition": "The comparative form of <w>good</w>, meaning of a higher quality or more excellent.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am feeling much <w>better</w> today than I was yesterday.",
                            "target_lang_translations": {
                                "ru": "Сегодня я чувствую себя гораздо <w>лучше</w>, чем вчера."
                            }
                        },
                        {
                            "text": "This new phone has a <w>better</w> camera than my old one.",
                            "target_lang_translations": {
                                "ru": "У этого нового телефона камера <w>лучше</w>, чем у моего старого."
                            }
                        }
                    ],
                    "antonyms": [
                        "worse"
                    ],
                    "common_phrases": [
                        "better than ever",
                        "much better",
                        "even better"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень прилагательного good (хороший), означающая более высокое качество или превосходство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лучше",
                                "target_lang_sense_clarification": "сравнительная степень"
                            },
                            {
                                "target_lang_word": "лучший",
                                "target_lang_sense_clarification": "более качественный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b92091ce-6d35-3515-b587-c3d8bfd0d09d",
                    "sense_definition": "Fully recovered or healed from an illness, injury, or pain.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should stay in bed until you are <w>all</w> <w>better</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит оставаться в постели, пока ты совсем не <w>поправишься</w>."
                            }
                        },
                        {
                            "text": "Is your leg feeling <w>better</w> after the surgery?",
                            "target_lang_translations": {
                                "ru": "Твоей ноге <w>лучше</w> после операции?"
                            }
                        }
                    ],
                    "synonyms": [
                        "top"
                    ],
                    "antonyms": [
                        "sick",
                        "ill"
                    ],
                    "common_phrases": [
                        "all better",
                        "feel better",
                        "get better"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью восстановившийся или излечившийся от болезни, травмы или боли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лучше",
                                "target_lang_sense_clarification": "о состоянии здоровья"
                            },
                            {
                                "target_lang_word": "здоров",
                                "target_lang_sense_clarification": "выздоровевший"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89e136a0-e3fd-3628-a2d6-63835b7e0e92",
                    "sense_definition": "Greater or more advantageous in terms of value, distance, or time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete finished the race in <w>better</w> <w>than</w> two minutes.",
                            "target_lang_translations": {
                                "ru": "Атлет закончил гонку <w>быстрее</w>, чем за две минуты."
                            }
                        },
                        {
                            "text": "We are looking for a deal that is <w>better</w> than the current offer.",
                            "target_lang_translations": {
                                "ru": "Мы ищем сделку, которая будет <w>выгоднее</w> текущего предложения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "better than",
                        "or better"
                    ],
                    "target_lang_definitions": {
                        "ru": "Более значительный или выгодный с точки зрения ценности, расстояния или времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лучше",
                                "target_lang_sense_clarification": "более выгодный"
                            },
                            {
                                "target_lang_word": "более",
                                "target_lang_sense_clarification": "превышающий значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edca7e64-7ba2-3efd-b653-2d16cbe594da",
                    "sense_definition": "Greater in amount, quantity, or degree.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>better</w> <w>part</w> of the afternoon was spent cleaning the garage.",
                            "target_lang_translations": {
                                "ru": "<w>Большая</w> часть дня была потрачена на уборку гаража."
                            }
                        },
                        {
                            "text": "He has lived in this city for the <w>better</w> part of a decade.",
                            "target_lang_translations": {
                                "ru": "Он прожил в этом городе <w>большую</w> часть десятилетия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "better part of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая часть по количеству, объему или степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "большая",
                                "target_lang_sense_clarification": "о части чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1223c59a-07b6-34bf-b701-9023e2a73bb4",
                    "sense_definition": "The comparative form of <w>well</w>, meaning in a more excellent or effective manner.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She speaks French much <w>better</w> now that she lives in Paris.",
                            "target_lang_translations": {
                                "ru": "Она говорит по-французски гораздо <w>лучше</w> теперь, когда живет в Париже."
                            }
                        },
                        {
                            "text": "I <w>know</w> <w>better</w> than to leave my keys in the car.",
                            "target_lang_translations": {
                                "ru": "Я не настолько глуп, чтобы оставлять ключи в машине (я <w>знаю</w>, что так делать не стоит)."
                            }
                        }
                    ],
                    "antonyms": [
                        "worse"
                    ],
                    "common_phrases": [
                        "know better",
                        "work better",
                        "suit better"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень наречия well (хорошо), означающая более качественный или эффективный способ действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лучше",
                                "target_lang_sense_clarification": "более эффективно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7caea38-c0c9-3b03-91c1-91bf55417600",
                    "sense_definition": "Used to express that someone should do something or that something is advisable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "advice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You <w>had</w> <w>better</w> finish your homework before you go out.",
                            "target_lang_translations": {
                                "ru": "Тебе <w>лучше</w> закончить домашнее задание, прежде чем идти гулять."
                            }
                        },
                        {
                            "text": "We <w>better</w> leave now if we want to catch the train.",
                            "target_lang_translations": {
                                "ru": "Нам <w>лучше</w> уйти сейчас, если мы хотим успеть на поезд."
                            }
                        }
                    ],
                    "synonyms": [
                        "top"
                    ],
                    "common_phrases": [
                        "had better",
                        "you better"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used without 'had' in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения совета или рекомендации сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лучше",
                                "target_lang_sense_clarification": "в значении совета"
                            },
                            {
                                "target_lang_word": "следовало бы",
                                "target_lang_sense_clarification": "рекомендация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c022dce-3d7d-3fc9-af74-8960da838c56",
                    "sense_definition": "To improve something or make it of a higher quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took the course to <w>better</w> <w>herself</w> and find a new job.",
                            "target_lang_translations": {
                                "ru": "Она пошла на курсы, чтобы <w>совершенствоваться</w> и найти новую работу."
                            }
                        },
                        {
                            "text": "The organization works to <w>better</w> the lives of people in need.",
                            "target_lang_translations": {
                                "ru": "Организация работает над тем, чтобы <w>улучшить</w> жизнь нуждающихся людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "top",
                        "top"
                    ],
                    "antonyms": [
                        "worsen"
                    ],
                    "common_phrases": [
                        "better oneself",
                        "better the situation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать что-либо или делать это более высокого качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улучшать",
                                "target_lang_sense_clarification": "делать лучше"
                            },
                            {
                                "target_lang_word": "улучшить",
                                "target_lang_sense_clarification": "совершенствовать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90305275-540f-303b-b1ee-408a03ef146c",
                    "sense_definition": "To surpass or exceed a previous achievement or record.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surpass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It will be difficult to <w>better</w> the world record set last year.",
                            "target_lang_translations": {
                                "ru": "Будет трудно <w>превзойти</w> мировой рекорд, установленный в прошлом году."
                            }
                        },
                        {
                            "text": "The team hopes to <w>better</w> their performance in the next game.",
                            "target_lang_translations": {
                                "ru": "Команда надеется <w>улучшить</w> свои показатели в следующей игре."
                            }
                        }
                    ],
                    "synonyms": [
                        "top"
                    ],
                    "common_phrases": [
                        "better a record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходить или превышать предыдущее достижение или рекорд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превзойти",
                                "target_lang_sense_clarification": "побить рекорд"
                            },
                            {
                                "target_lang_word": "превосходить",
                                "target_lang_sense_clarification": "быть выше по показателям"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb181c21-42b6-303d-9355-20c8f01117ad",
                    "sense_definition": "A person who is superior to another in rank, status, or ability.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was taught to always respect his <w>betters</w>.",
                            "target_lang_translations": {
                                "ru": "Его учили всегда уважать тех, кто <w>выше</w> его по положению."
                            }
                        },
                        {
                            "text": "In the competition, she quickly found her <w>better</w>.",
                            "target_lang_translations": {
                                "ru": "В соревновании она быстро нашла того, кто <w>превосходит</w> её."
                            }
                        }
                    ],
                    "common_phrases": [
                        "respect your betters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, превосходящий другого по рангу, статусу или способностям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старшие",
                                "target_lang_sense_clarification": "по положению или возрасту"
                            },
                            {
                                "target_lang_word": "лучшие",
                                "target_lang_sense_clarification": "превосходящие люди"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}