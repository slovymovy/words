                                        "glosses": [
                                            "Religion: sich auf den Pantheismus beziehend, nach Art/Auffassung des Pantheismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e59d002f-dc1f-4cfd-bf9b-3ed8bb28bff3",
