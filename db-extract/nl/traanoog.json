                "senses": [
                    {
                        "sense_id": "5b420aa4-378c-39f6-96d3-12bc28a50307",
                        "entry_id": "e6508ed2-3896-338d-87f3-db746157d89f",
                        "glosses": [
                            "een oog waaruit tranen druppelen als teken van verdriet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc85830-92fe-4105-80d3-cde5222c1855",
                                "sense_id": "5b420aa4-378c-39f6-96d3-12bc28a50307",
                                "text": "De oud-Hengelose pakte het EU-logo erbij en liet vervolgens haar creativiteit de vrije loop. Het resultaat: het EU-logo als verdrietig gezichtje met een traanoog."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce13e0a0-71ff-335c-a15e-cae4a680f33d",
                        "entry_id": "e6508ed2-3896-338d-87f3-db746157d89f",
                        "glosses": [
                            "een vochtig oog waaruit tranen druppelen door een oogaandoening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b64d309-c759-4d5a-a751-3f5df93a8847",
                                "sense_id": "ce13e0a0-71ff-335c-a15e-cae4a680f33d",
                                "text": "Mijn zus Ellen is cabaretière. Haar nieuwe theatershow Horten en Stoten gaat over het dagelijks leed dat wij met ons meedragen aan kwaaltjes. Ze beschrijft haar omgeving waarin iedereen tegenwoordig wel wat heeft; vage klachten variërend van enkelpijn tot traanogen. Ik voel me meteen aangesproken. Heeft ze het nou over mij?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0513634c-34ab-4f49-97f1-be814e56db1d",
                        "source_entry_id": "e6508ed2-3896-338d-87f3-db746157d89f",
                        "source_sense_id": "5b420aa4-378c-39f6-96d3-12bc28a50307",
                        "source_sense_description": "huilen",
                        "target_lang_word": "weep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d57342d4-48e5-39f2-a3eb-aa6ea74a9ef1",
                                        "entry_id": "23045ef0-601c-3459-af0f-5bdd030d166b",
                                        "glosses": [
                                            "To cry; to shed tears, especially when accompanied with sobbing or other difficulty speaking, as an expression of emotion such as sadness or joy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78d47d75-3c54-4267-8e2d-0ebe5ae911f4",
                                                "sense_id": "d57342d4-48e5-39f2-a3eb-aa6ea74a9ef1",
                                                "text": "They wept together in silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a6eee28-ae7b-399b-b559-5b9034b070c7",
                                        "entry_id": "23045ef0-601c-3459-af0f-5bdd030d166b",
                                        "glosses": [
                                            "To lament; to complain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b39c3cc5-767a-46f9-bd44-70c4c6f8b286",
                                                "sense_id": "4a6eee28-ae7b-399b-b559-5b9034b070c7",
                                                "text": "They weep unto me, saying, Give us flesh, that we may eat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65a88547-cea6-3f4e-bf4d-db96451d5e24",
                                        "entry_id": "23045ef0-601c-3459-af0f-5bdd030d166b",
                                        "glosses": [
                                            "To give off moisture in small quantities, e.g. due to condensation.",
                                            "To produce secretions."
                                        ],
                                        "tags": [
                                            "of a wound or sore"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56dad267-26c3-34a2-b6c5-bfb7cd088fd1",
                                        "entry_id": "23045ef0-601c-3459-af0f-5bdd030d166b",
                                        "glosses": [
                                            "To give off moisture in small quantities, e.g. due to condensation.",
                                            "To flow in drops; to run in drops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8508c0ba-f1eb-45fd-aad8-3e638437dc92",
                                                "sense_id": "56dad267-26c3-34a2-b6c5-bfb7cd088fd1",
                                                "text": "a weeping spring, which discharges water slowly"
                                            },
                                            {
                                                "example_id": "69abf58e-b5a0-4a3c-9115-c5c828724148",
                                                "sense_id": "56dad267-26c3-34a2-b6c5-bfb7cd088fd1",
                                                "text": "The blood weeps from my heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e588be6c-0182-35fa-a7b2-5874eb7776ea",
                                        "entry_id": "23045ef0-601c-3459-af0f-5bdd030d166b",
                                        "glosses": [
                                            "To hang the branches, as if in sorrow; to be pendent; to droop; said of a plant or its branches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "024f7f90-a690-4c2a-a1b2-7461123cf931",
                                                "sense_id": "e588be6c-0182-35fa-a7b2-5874eb7776ea",
                                                "text": "The willows weep and the moonbeams sleep / On the mariner's silent grave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6007fff-c2e5-3595-a28d-3d2b6bfe4f81",
                                        "entry_id": "23045ef0-601c-3459-af0f-5bdd030d166b",
                                        "glosses": [
                                            "To weep over; to bewail."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "481cec1e-c9da-43e9-8741-6b44a25ada16",
                                                "sense_id": "f6007fff-c2e5-3595-a28d-3d2b6bfe4f81",
                                                "text": "Fair Venus wept the sad disaster\n Of having lost her favorite dove."
                                            },
                                            {
                                                "example_id": "40e15c74-73ad-4100-aa44-69b13565ce2a",
                                                "sense_id": "f6007fff-c2e5-3595-a28d-3d2b6bfe4f81",
                                                "text": "[…] Which weep a loss for ever new,\n⁠A void where heart on heart reposed;\n⁠And, where warm hands have prest and closed,\nSilence, till I be silent too."
                                            }
                                        ]
                                    }
                                ]
                            },
