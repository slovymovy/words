{
    "word_family": [
        "odnajdywać",
        "odnalezienie",
        "znaleźć",
        "znalezisko",
        "odnajdować"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82cb7a76-df30-3ffa-9aaa-747d328b804c",
                    "sense_definition": "trafić na kogoś lub na coś zgubionego, ukrytego bądź poszukiwanego",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "poszukiwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj wieczorem wreszcie <w>odnalazłem</w> swoje zgubione klucze do mieszkania.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером я наконец-то <w>нашёл</w> свои потерянные ключи от квартиры."
                            }
                        },
                        {
                            "text": "Policja po kilku dniach starań pomyślnie <w>odnalazła</w> zaginionego psa sąsiadów.",
                            "target_lang_translations": {
                                "ru": "Полиция после нескольких дней поисков успешно <w>разыскала</w> пропавшую собаку соседей."
                            }
                        }
                    ],
                    "synonyms": [
                        "znaleźć"
                    ],
                    "common_phrases": [
                        "odnaleźć zgubę",
                        "odnaleźć drogę"
                    ],
                    "target_lang_definitions": {
                        "ru": "обнаружить, разыскать кого-либо или что-либо потерянное, спрятанное или искомое"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "найти",
                                "target_lang_sense_clarification": "обнаружить потерянное или искомое"
                            },
                            {
                                "target_lang_word": "отыскать",
                                "target_lang_sense_clarification": "найти в результате целенаправленных поисков"
                            },
                            {
                                "target_lang_word": "разыскать",
                                "target_lang_sense_clarification": "найти пропавшего человека или вещь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2ec42a5-3987-36de-b2a1-858f0caffa8f",
                    "sense_definition": "uzyskać lub na nowo odkryć pożądany stan emocjonalny, sens lub wartość",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emocje_i_wartosci",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po wielu trudnych latach wreszcie <w>odnalazł</w> upragniony spokój w małej wsi.",
                            "target_lang_translations": {
                                "ru": "После многих трудных лет он наконец-то <w>обрёл</w> желанный покой в маленькой деревне."
                            }
                        },
                        {
                            "text": "Dzięki nowej pasji ona <w>odnalazła</w> prawdziwy sens życia i radość.",
                            "target_lang_translations": {
                                "ru": "Благодаря новому увлечению она <w>нашла</w> истинный смысл жизни и радость."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odnaleźć spokój",
                        "odnaleźć sens życia"
                    ],
                    "target_lang_definitions": {
                        "ru": "обрести или заново открыть для себя желаемое душевное состояние, смысл или ценность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрести",
                                "target_lang_sense_clarification": "получить желаемое душевное состояние, смысл жизни"
                            },
                            {
                                "target_lang_word": "найти",
                                "target_lang_sense_clarification": "найти покой, радость или смысл"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4246762-8615-3d3d-aad3-0d1a1e274e00",
                    "sense_definition": "zauważyć, rozpoznać określoną cechę lub podobieństwo w kimś albo w czymś",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "percepcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jego zachowaniu krytycy <w>odnaleźli</w> cechy dawnego mistrza malarstwa.",
                            "target_lang_translations": {
                                "ru": "В его поведении критики <w>разглядели</w> черты старого мастера живописи."
                            }
                        },
                        {
                            "text": "Z czasem <w>odnalazła</w> w sobie wielką odwagę do podjęcia trudnej decyzji.",
                            "target_lang_translations": {
                                "ru": "Со временем она <w>нашла</w> в себе огромное мужество, чтобы принять трудное решение."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "заметить, распознать определенную черту, качество или сходство в ком-либо или чем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "найти",
                                "target_lang_sense_clarification": "обнаружить в ком-то или чём-то черты, качества"
                            },
                            {
                                "target_lang_word": "обнаружить",
                                "target_lang_sense_clarification": "разглядеть свойство, сходство или способность"
                            },
                            {
                                "target_lang_word": "разглядеть",
                                "target_lang_sense_clarification": "усмотреть определенные черты или особенности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}