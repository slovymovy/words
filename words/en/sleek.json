                },
                {
                    "sense_id": "459078b2-9b92-325f-a2ad-63355bdc034f",
                    "sense_definition": "appearing attractive or persuasive but often untrustworthy or insincere",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sleek</w> salesman tried to convince us to buy the car despite its obvious flaws.",
                            "target_lang_translations": {
                                "ru": "<w>Елейный</w> продавец пытался убедить нас купить машину, несмотря на ее очевидные недостатки.",
                                "zh": "那位<w>油滑</w>的推销员试图说服我们买下那辆车，尽管它有明显的缺陷。"
                            }
                        },
                        {
                            "text": "I didn't trust his <w>sleek</w> manner and felt he was hiding something from the board.",
                            "target_lang_translations": {
                                "ru": "Я не доверял его <w>скользкой</w> манере поведения и чувствовал, что он что-то скрывает от совета директоров.",
                                "zh": "我不信任他那<w>圆滑</w>的态度，觉得他在向董事会隐瞒什么。"
                            }
                        }
                    ],
                    "synonyms": [
