                        "examples": [
                            {
                                "example_id": "60397605-db62-4b52-a61b-e19c41634b97",
                                "sense_id": "5bc50d77-08a8-3b07-bf87-6f1cab90476d",
                                "text": "Pourtant, j’ai bien cru, récemment, entendre zinzonner des moustiques, […]"
                            },
                            {
                                "example_id": "636811b2-5aa4-48c8-9ff4-171379fbda5f",
                                "sense_id": "5bc50d77-08a8-3b07-bf87-6f1cab90476d",
                                "text": "Mais là, j’ai le prétexte de la dure loi de la sélection naturelle: une mouche sensée et propre à perpétuer son espèce a le bon gout d’aller zinzonner hors de mes murs…"
                            }
                        ]
                    }
