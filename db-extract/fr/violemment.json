                                        "entry_id": "a0ec34e2-1ecf-3b90-b001-9db887bd910c",
                                        "glosses": [
                                            "mit großer Intensität; sehr stark"
                                        ],
                                        "tags": [
                                            "adjektivisch und adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06c037e3-1c32-4803-8288-80f617dffc27",
                                                "sense_id": "c54b59c8-5aa3-375a-b6e6-35e921a1c000",
                                                "text": "Heftiger Wind schlug uns ins Gesicht."
                                            },
                                            {
                                                "example_id": "178145a6-5f9d-4f1b-9817-412125b595ae",
                                                "sense_id": "c54b59c8-5aa3-375a-b6e6-35e921a1c000",
                                                "text": "Was er uns anbot, war ganz schön heftig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9f677e4-b3e1-3549-878e-d36ae1588c3e",
                                        "entry_id": "a0ec34e2-1ecf-3b90-b001-9db887bd910c",
                                        "glosses": [
