                    {
                        "sense_id": "b6f7fbe7-2a96-35ec-a78f-7ed8d6ff11aa",
                        "entry_id": "beb0c48c-6bb4-3ca0-992f-816bcacdd8d2",
                        "glosses": [
                            "Timber from the Manilkara bidentata tree."
