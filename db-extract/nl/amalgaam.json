                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e936fd4-1b14-3f88-b7ff-4531b9d74e0d",
                                        "entry_id": "fbbff192-288f-3dad-a466-c5bc111f39aa",
                                        "glosses": [
                                            "A combination of different things."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b84821-4d82-4de2-aa08-13f0e3d019bf",
                                                "sense_id": "1e936fd4-1b14-3f88-b7ff-4531b9d74e0d",
                                                "text": "[…] nor must we overlook, in quite recent times, the ingenious \"Dukedog\", a little 4-4-0 (officially 90XX class) whose Victorian lineaments arise from an economical amalgam of obsolete \"Duke\" and \"Bulldog\" components."
                                            },
                                            {
                                                "example_id": "2e981b40-a98f-4099-b1b1-3391637e910f",
                                                "sense_id": "1e936fd4-1b14-3f88-b7ff-4531b9d74e0d",
                                                "text": "This was the Ambergate, Nottingham & Boston & Eastern Junction Railway, an amalgam of a number of separate schemes put forward in 1845, which secured its Act on July 16, 1846."
                                            },
                                            {
                                                "example_id": "bb6a65e1-42aa-4945-a047-55412e67bccd",
                                                "sense_id": "1e936fd4-1b14-3f88-b7ff-4531b9d74e0d",
                                                "text": "A church where spirit, pain, and joy formed a holy amalgam and were righteously acknowledged out loud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e1656f-8e5f-326f-8c7e-bb2e964adf4b",
                                        "entry_id": "fbbff192-288f-3dad-a466-c5bc111f39aa",
                                        "glosses": [
                                            "One of the ingredients in an alloy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b43c9a2d-c3e5-3453-aa24-84e43feceed8",
                                        "entry_id": "fbbff192-288f-3dad-a466-c5bc111f39aa",
                                        "glosses": [
                                            "An alloy of mercury used to fill tooth cavities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "amalgam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8be94275-88b3-3c5e-b111-71700e56631a",
                                        "entry_id": "6afa5c69-7548-382b-a76b-4766f267ff41",
                                        "glosses": [
                                            "To amalgamate (something) with a thing."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2280c500-00c2-49ac-83ea-d95db8a43e34",
                                                "sense_id": "8be94275-88b3-3c5e-b111-71700e56631a",
                                                "text": "gold t’amalgam with some six of mercury"
                                            },
                                            {
                                                "example_id": "1bc845f9-4244-49ac-8ba7-959a16197e30",
                                                "sense_id": "8be94275-88b3-3c5e-b111-71700e56631a",
                                                "text": "[…] I had once occaſion to diſtil in a ſmall Retort ſome Gold amalgamed vvith ſuch a fine and ſubtile Mercury, that being (vvithout the addition of any Salt) put to the Gold in the cold, they preſently grevv hot together."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d3f4940-6708-44c8-82d1-78743e1713e8",
                        "source_entry_id": "a3cc1f4e-eaf5-3025-be62-db047a616f49",
