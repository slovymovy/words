                ],
                "senses": [
                    {
                        "sense_id": "4f440504-76c2-378f-95bc-5ee021e2117c",
                        "entry_id": "6e288cdd-8b71-399b-92fe-e30ec85cede4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "614711ed-7dde-43e0-9b05-e7815e9fad69",
                                "sense_id": "4f440504-76c2-378f-95bc-5ee021e2117c",
                                "text": "Frau Kiessle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "08417b6c-ce9f-44b6-a26a-72a84f83c936",
                                "sense_id": "4f440504-76c2-378f-95bc-5ee021e2117c",
                                "text": "Herr Kiessle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1babbb96-78a7-4742-8b35-db26878eeacf",
                                "sense_id": "4f440504-76c2-378f-95bc-5ee021e2117c",
                                "text": "Die Kiessles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a500aaad-4785-4f49-a403-5227c99359af",
                                "sense_id": "4f440504-76c2-378f-95bc-5ee021e2117c",
                                "text": "Der Kiessle trägt nie die Pullover, die die Kiessle ihm strickt."
                            },
                            {
                                "example_id": "fcfdd2c7-7d0d-4f33-aff1-108835534905",
                                "sense_id": "4f440504-76c2-378f-95bc-5ee021e2117c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kiessle kommt, geht der Herr Kiessle.“"
                            },
                            {
                                "example_id": "255669cb-e5de-431a-9ccd-57de72d4cc3d",
                                "sense_id": "4f440504-76c2-378f-95bc-5ee021e2117c",
                                "text": "Kiessle kommt und geht."
                            },
                            {
                                "example_id": "248eb53e-8b92-451e-889b-721b6c4489e5",
                                "sense_id": "4f440504-76c2-378f-95bc-5ee021e2117c",
                                "text": "Kiessles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
