                                "example_id": "d4500bac-f1f0-4e83-b196-f8bf91064df4",
                                "sense_id": "b53c7c42-807c-345e-a693-2a78cfa5261b",
                                "text": "„Johnny Torrio, Capones geistiger Ziehvater, kam gerade aus Italien zurück und berichtete von Mussolinis Schwarzhemden.“"
                            },
                            {
                                "example_id": "50e3270d-ae24-4951-bddf-255fb44c712e",
                                "sense_id": "b53c7c42-807c-345e-a693-2a78cfa5261b",
                                "text": "„Mal schlenderte zu einem besonders grellen Stück, das Dämmerung der Gerechten anpries - ein edler Russki, der einem geifernden, mit der Pistole herumfuchtelnden Schwarzhemd die Stirn bot.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
