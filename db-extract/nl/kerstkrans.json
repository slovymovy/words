                            "kerst"
                        ],
                        "examples": [
                            {
                                "example_id": "a156dbb2-cbe5-4e86-abed-a83586daf179",
                                "sense_id": "7fb59534-2c56-3570-bce2-f3d9ef06ffd2",
                                "text": "Volgens Lustig is met name fructose in hoge dosis puur vergif. En dat is problematisch, want nogal wat voedingsmiddelen en (fris)dranken bevatten deze vorm van suiker. Onder meer: veel soorten champagne, poedersuiker, oliebollen en de laatste chocolade kerstkransjes die je over hebt. Het zit eigenlijk in bijna alles wat zoet is. En vooral: in bijna alles wat zoet is gemaakt."
                            }
                        ]
                    }
