                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e066f33-762f-429a-94b6-ac1aa2e50c9c",
                                                "sense_id": "bcf66847-faa5-3556-8aef-24e8dfa4fe1d",
                                                "text": "Спешить на поезд."
