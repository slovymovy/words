                "senses": [
                    {
                        "sense_id": "067c443a-5545-36f1-a4aa-f45a925c3349",
                        "entry_id": "ba5e7672-eeac-340b-aa64-25cd8b869d47",
                        "glosses": [
                            "Zimmermädchen, Hausmädchen - mit Schwerpunkt Esstisch und Eingangstür"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d38fcf5-2189-473d-8474-41b560eccc79",
                                "sense_id": "067c443a-5545-36f1-a4aa-f45a925c3349",
                                "text": "She had only one option - to earn her money as a parlourmaid.",
                                "translation": "Sie blieb nur eine Möglichkeit - ihr Auskommen als Zimmermädchen zu finden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e4347ea-b4ae-45fa-a489-fe095ccb5153",
                        "source_entry_id": "ba5e7672-eeac-340b-aa64-25cd8b869d47",
                        "source_sense_id": "067c443a-5545-36f1-a4aa-f45a925c3349",
                        "source_sense_description": "Zimmermädchen, Hausmädchen - mit Schwerpunkt Esstisch und Eingangstür",
                        "target_lang_word": "Zimmermädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zimmermädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                        "entry_id": "91e2e99b-c8ca-3f32-a7ea-f826a833f408",
                                        "glosses": [
                                            "weibliche Person, die für die Pflege von Hotelzimmern beschäftigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ae3a4e-4708-4f0a-bb20-1ea6a2403535",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Man will sich ansehen, was am schönsten ist, man fragt den Portier, den Hausdiener, den Kellner und das Zimmermädchen und bekommt von jedem eine andere Antwort, und schließlich hält man sich an den Baedeker und läuft die Sternchen ab, jeder auf seine Weise.“"
                                            },
                                            {
                                                "example_id": "35ff84d8-3650-442c-9270-f1281e6e71a1",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Die Zimmermädchen machen mir spitze Lippen und geben küssende Laute von sich.“"
                                            },
                                            {
                                                "example_id": "4f337ee1-683d-474d-a825-0bc6f2d19c76",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Dort entdeckte ich ein Zimmermädchen in ihren Unterröcken, die gerade dabei war, sich das Korsett zurechtzurücken, und leise Verwünschungen ausstieß.“"
                                            },
                                            {
                                                "example_id": "816b799e-9b09-4bce-84d9-b41ddaacb543",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Um acht Uhr klingelte er nach dem Zimmermädchen und ließ sich ein Bad richten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3894b18-2f31-4f30-852c-ff314e26bc58",
                        "source_entry_id": "ba5e7672-eeac-340b-aa64-25cd8b869d47",
                        "source_sense_id": "067c443a-5545-36f1-a4aa-f45a925c3349",
                        "source_sense_description": "Zimmermädchen, Hausmädchen - mit Schwerpunkt Esstisch und Eingangstür",
                        "target_lang_word": "Hausmädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausmädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                        "entry_id": "04d52abf-65bd-3b74-afdd-13447fe1645b",
                                        "glosses": [
                                            "weibliche Person, die zur Verrichtung von Haushaltsaufgaben angestellt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148e3d9c-b5d1-4087-af87-b65076ce4725",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "Sie soll als Hausmädchen einer reichen Familie die schwangere Mutter des Hauses entlasten."
                                            },
                                            {
                                                "example_id": "2919263a-0cd4-40dd-b3e1-bcde631b7f4f",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "„Abends, in meiner Pension, kreischt das dicke Hausmädchen auf, sie hält mich für ein Gespenst, sie befühlt meinen Arm, sie überzeugt sich, daß er aus Fleisch und Blut ist.“"
                                            },
                                            {
                                                "example_id": "69ea6bb8-716a-4888-877a-646b95f1783a",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "„Sonja steht dann auf, sitzt neben Eva am Tisch, wo das Hausmädchen ihnen Frühstück mit Wein serviert.“"
                                            },
                                            {
                                                "example_id": "5b89f9cb-bd25-4131-97dc-9fbaf5eb5a0d",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "„Die vergoldeten kleinen Ringe, die Belle den Hausmädchen schenkte, kosteten Geld.“"
                                            },
                                            {
                                                "example_id": "7f499ee7-abf4-43c4-ba17-f0b43ee3b0ad",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "„Da sie auch Diener und Hausmädchen mitgenommen hätten, stünden ihre Villen und Paläste leer.“"
                                            },
                                            {
                                                "example_id": "8c99cc8c-5169-4d3a-a4a3-722a0c6c5088",
                                                "sense_id": "316e1ad2-8228-3e07-a6fa-5c35ee49f8e4",
                                                "text": "„Des öfteren wird Klein-Erna als Hausmädchen engagiert, und so können viele wohlbekannte Dienstmädchenwitze unbedenklich auf sie übertragen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
