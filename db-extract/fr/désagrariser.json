                        "glosses": [
                            "Enlever son caractère agraire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2dc0faf-ae96-4c8b-abca-870a3d524773",
                                "sense_id": "8166cbe1-2bb0-3535-9d5c-d2200fa4e295",
                                "text": "E. Léonard et B. Losch notent le risque de divergence entre un Mexique agricole « utile » et un Mexique rural pauvre et « désagrarisé »."
                            },
                            {
                                "example_id": "449b1db1-0e9f-4de1-a277-0d5f50ba0f2f",
                                "sense_id": "8166cbe1-2bb0-3535-9d5c-d2200fa4e295",
                                "text": "La décollectivisation a « désagrarisé » les campagnes dans le sens où la part des actifs agricoles a considérablement diminué en quinze ans."
                            }
                        ]
                    }
