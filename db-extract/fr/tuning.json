                "senses": [
                    {
                        "sense_id": "f46677f8-3dac-386e-bd8b-39b32e17b319",
                        "entry_id": "ff04babf-8c88-34dc-97dd-38d351bb6bf5",
                        "glosses": [
                            "Ensemble d'améliorations sur un véhicule de série pour le modifier ou le personnaliser."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "a7f3b81f-6a8f-4fa3-983e-cf27ee4118a1",
                                "sense_id": "f46677f8-3dac-386e-bd8b-39b32e17b319",
                                "text": "Ça vous inspire quoi ? demanda-t-elle après quelques minutes […]. Les artifices, reprit-elle, les gadgets sophistiqués, pour une bagnole, ou une moto, ça s'appelle le customing ou le tuning."
                            },
                            {
                                "example_id": "5f8c8c42-8088-4592-ab85-1d576d4cbfc7",
                                "sense_id": "f46677f8-3dac-386e-bd8b-39b32e17b319",
                                "text": "Les barakis conduisent souvent de vieilles voitures roulant encore à l'essence « normale » ou « avec plomb », couvertes d'autocollants […]. Les barakis ayant un peu plus de sous s'adonnent à une activité particulièrement barakiesque : le tuning."
                            }
                        ]
                    }
