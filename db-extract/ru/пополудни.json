                    {
                        "translation_id": "3a2b4168-83dd-4e30-94ad-a848cc573f19",
                        "source_entry_id": "6240b63a-d94c-327f-a772-f2dbd9155ee8",
                        "source_sense_id": "b9e93b82-d285-363a-a659-ba1c4a358973",
