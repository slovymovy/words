                                                "sense_id": "94174f88-1aff-3b72-889b-9fb7ddbffaee",
                                                "text": "The insurgent provinces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62984c03-cdd4-3ecf-bb17-f5b93b8b4409",
                                        "entry_id": "e83825ca-dccc-3338-a465-e7f986957a6e",
                                        "glosses": [
                                            "Of water: surging or rushing in."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9854928d-e2f8-4c03-88ac-f59bf5014099",
                                                "sense_id": "62984c03-cdd4-3ecf-bb17-f5b93b8b4409",
                                                "text": "Vesuvio groans through all his echoing caves, / And Etna thunders o'er the insurgent waves."
                                            }
                                        ]
                                    }
                                ]
                            },
