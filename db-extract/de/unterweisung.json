                                "target_senses": [
                                    {
                                        "sense_id": "537f9559-9ca0-3535-b94f-69dcd49f8373",
                                        "entry_id": "52bda495-8bfb-32e4-ba1b-6bf1b664f866",
                                        "glosses": [
                                            "Training or instruction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fae7297-80a2-32f5-9da4-f480076c8a26",
                                        "entry_id": "52bda495-8bfb-32e4-ba1b-6bf1b664f866",
                                        "glosses": [
                                            "Institutional education; attendance of school."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ab827e1-a6d1-441e-9fe5-5bdf976a6250",
                                                "sense_id": "7fae7297-80a2-32f5-9da4-f480076c8a26",
                                                "text": "I never let my schooling interfere with my education."
                                            },
                                            {
                                                "example_id": "0cb9bb11-5036-414a-8a07-8c57ed9d0346",
                                                "sense_id": "7fae7297-80a2-32f5-9da4-f480076c8a26",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b859d0-3422-393a-b9ab-170478fa7088",
                                        "entry_id": "52bda495-8bfb-32e4-ba1b-6bf1b664f866",
                                        "glosses": [
                                            "The training of a horse at dressage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5fee887-5820-367f-b27f-df30b1a7c59d",
                                        "entry_id": "52bda495-8bfb-32e4-ba1b-6bf1b664f866",
                                        "glosses": [
                                            "Discipline; reproof; reprimand."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "980ff51d-0327-4db5-8662-1af21d5db59e",
                                                "sense_id": "c5fee887-5820-367f-b27f-df30b1a7c59d",
                                                "text": "He gave his son a good schooling."
                                            },
                                            {
                                                "example_id": "0debafae-79bf-4bba-97c0-69bff99f0df6",
                                                "sense_id": "c5fee887-5820-367f-b27f-df30b1a7c59d",
                                                "text": "[…] I thought the schooling as severe as the case merited, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb1ea54a-c631-3b89-9ae8-b5fd43812627",
                                        "entry_id": "52bda495-8bfb-32e4-ba1b-6bf1b664f866",
