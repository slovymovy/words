                        "target_lang_word": "extubieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extubieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf1c656-1a07-3bae-a306-a66652422de1",
                                        "entry_id": "88a3af26-b115-3f6b-a828-94a2bf1cb225",
                                        "glosses": [
                                            "einen Tubus aus dem Mund oder der Nase entfernen, wenn die Atmung wieder normal funktioniert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c10b6e9f-fe0b-45c7-a95b-9aa63c306f25",
                                                "sense_id": "4cf1c656-1a07-3bae-a306-a66652422de1",
                                                "text": "„Als Alternative besteht stets die Möglichkeit, das Kind nach kurzem schonendem Absaugen des Oropharynx wach zu extubieren.“"
                                            },
                                            {
                                                "example_id": "b8bad665-ef06-4950-ada1-50f520a5209e",
                                                "sense_id": "4cf1c656-1a07-3bae-a306-a66652422de1",
                                                "text": "„Alternativ ist es günstig, unter Überdruck zu extubieren. Dann ist die Lunge gut gefüllt und der Patient kann gleich kräftig abhusten.“"
                                            },
                                            {
                                                "example_id": "532c44a5-bd4a-47db-934f-523ea72402a1",
                                                "sense_id": "4cf1c656-1a07-3bae-a306-a66652422de1",
                                                "text": "„Weil der Patient erneut gegen den Tubus hustet, entschließt sich der Anästhesist, ihn zu extubieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
