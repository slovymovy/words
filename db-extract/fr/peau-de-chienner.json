                        "glosses": [
                            "Polir en frottant avec de la peau de chien de mer (type de requin)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28e7bd8c-8b04-4583-9b90-7df52da4eef1",
                                "sense_id": "cfcd8bdb-5f4f-358b-8447-253f3d820f44",
                                "text": "Il y a dix-sept opérations principales pour finir un ouvrage de dorure en détrempe : savoir, encoller, blanchir, reboucher & peau-de-chienner, adoucir & poncer, réparer, dégraisser, préler, jaunir, égrainer, coucher d'assiette, frotter, dorer, brunir, matter, ramender, vermeillonner & repasser."
                            },
                            {
                                "example_id": "a956242e-e5e7-4807-af19-c5eff96c0ddd",
                                "sense_id": "cfcd8bdb-5f4f-358b-8447-253f3d820f44",
                                "text": "Reboucher et peau-de-chienner."
                            }
                        ]
