                "senses": [
                    {
                        "sense_id": "df7c1686-541e-3301-a755-a764a5fc0db2",
                        "entry_id": "c93c5890-6da8-3cc8-9f90-6f70ead54bc9",
                        "glosses": [
                            "feste Exkremente eines Hundes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b678552-e502-43b8-bce5-5edb792dae04",
                                "sense_id": "df7c1686-541e-3301-a755-a764a5fc0db2",
                                "text": "Die Stadt hat den Hundehaufen auf dem Bürgersteig den Kampf angesagt."
                            },
                            {
                                "example_id": "b21d4d46-5b47-48c7-9121-9a2b35383cf2",
                                "sense_id": "df7c1686-541e-3301-a755-a764a5fc0db2",
                                "text": "„Als ich ihn darauf ansprach, wurde er zornig und teilte mir mit, dass es in Anbetracht der vielen Hundehaufen auf den Straßen doch auf dieses Häufchen nun wirklich nicht mehr ankäme.“"
                            },
                            {
                                "example_id": "5675db76-1eb3-40f2-8c00-ebb493edd1bc",
                                "sense_id": "df7c1686-541e-3301-a755-a764a5fc0db2",
                                "text": "„Und jedes Mal, wenn sie über einen großen Hundehaufen stieg, dachte sie, dass Antwerpen eine einzige große Müllhalde sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
