                        "glosses": [
                            "bril die tijdens het skiën en snowboarden gedragen wordt ter bescherming van de ogen tegen sneeuwblindheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70d5222d-e070-4d03-8e45-331f98c1ebbf",
                                "sense_id": "70afa35b-56b5-3e84-b8cc-c9d9b0f9d581",
                                "text": "De verf begon net te drogen toen er een jonge man met lang haar en een grote skibril bij me kwam zitten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a89b8e90-f91f-40ce-8ea2-f0f27fc66c3f",
