                "senses": [
                    {
                        "sense_id": "42951513-e3ff-398b-8c1e-3537a9329bd5",
                        "entry_id": "cb9a6a69-8f46-3929-9225-7d1bb6dbcd83",
                        "glosses": [
                            "Substanz, die den Nachweis von Doping erschweren oder verhindern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e9b9405-f67c-4a62-ab07-2e119dfdc734",
                                "sense_id": "42951513-e3ff-398b-8c1e-3537a9329bd5",
                                "text": "„In der Verbotsliste wird Epitestosteron seit dem 1. Januar 2009 nicht mehr in der Substanzklasse der Maskierungsmittel, sondern unter Anabolika aufgelistet.“"
                            },
                            {
                                "example_id": "aca9b91c-e308-4a4b-b102-89ced6ed8214",
                                "sense_id": "42951513-e3ff-398b-8c1e-3537a9329bd5",
                                "text": "„Hydrochlorothiazid ist ein Blutdrucksenker, der zugleich das Risiko für weißen Hautkrebs erhöht, Chloraminophenamid wirkt als Beruhigungsmittel. Hört sich erst einmal harmlos an, aber als ‚Maskierungsmittel‘ sind das eben nachgewiesenermaßen auch Substanzen, die helfen, Doping zu verschleiern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
