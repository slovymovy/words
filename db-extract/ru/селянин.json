                "senses": [
                    {
                        "sense_id": "0a849535-5806-35d3-8bc9-6b49a80ba29b",
                        "entry_id": "5e9f4838-8d2f-3d34-a26a-767d965d95be",
                        "glosses": [
                            "устар. крестьянин, земледелец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "865293ed-3c0f-49a0-aca0-3d16c335d97b",
                                "sense_id": "0a849535-5806-35d3-8bc9-6b49a80ba29b",
                                "text": "Знакомое вижу лицо селяни́на, лицо бородатое, мощь исполи́на."
                            },
                            {
                                "example_id": "17fc39b7-a1c7-4c90-b880-74d6b66a8e91",
                                "sense_id": "0a849535-5806-35d3-8bc9-6b49a80ba29b",
                                "text": "Усталый селянин идёт, задумавшись, в шалаш спокойный свой."
                            },
                            {
                                "example_id": "42f4e5bb-8fdb-45ff-815e-73112ae95aca",
                                "sense_id": "0a849535-5806-35d3-8bc9-6b49a80ba29b",
                                "text": "Рожок пастуший будит селянина."
                            }
                        ]
                    }
                ],
