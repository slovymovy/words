                    {
                        "translation_id": "a4b834a7-8f55-4bce-90c3-9123f99e1951",
                        "source_entry_id": "86fe22e6-b4aa-331e-94a6-a4f025bad893",
                        "source_sense_id": "235fc267-30d1-3442-944e-a9b99a02687b",
                        "target_lang_word": "carnavalsstoet",
                        "target_lang_code": "nl",
