                "senses": [
                    {
                        "sense_id": "d5e3d336-8a2e-32f9-a170-d0f50b04b900",
                        "entry_id": "be84ef38-c523-32c0-be0d-fdcdacf7ac8d",
                        "glosses": [
                            "Literaturwissenschaft, Zeit des Sturm und Drang, einer Strömung in der deutschen Literatur von etwa 1767 bis 1785"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "94361930-5d77-40fa-aaf8-3c3ad4cb6e91",
                                "sense_id": "d5e3d336-8a2e-32f9-a170-d0f50b04b900",
                                "text": "Während seines Studiums hat er sich wiederholt mit der Sturm-und-Drang-Zeit beschäftigt."
                            },
                            {
                                "example_id": "2fa58260-a7bc-4e57-92de-b5ad7ce5553a",
                                "sense_id": "d5e3d336-8a2e-32f9-a170-d0f50b04b900",
                                "text": "Jonas erforschte bisher wenig untersuchte Aspekte der Sturm-und-Drang-Zeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5c6b5934-0bab-3fce-b08b-d24203936a99",
                        "entry_id": "be84ef38-c523-32c0-be0d-fdcdacf7ac8d",
                        "glosses": [
                            "Phase in der Jugendzeit eines Menschen, die durch Aufbegehren gegen Überkommenes gekennzeichnet ist"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "f99af8da-d8a0-42fd-bb44-b27114347184",
                                "sense_id": "5c6b5934-0bab-3fce-b08b-d24203936a99",
                                "text": "Während ihrer Sturm-und-Drang-Zeiten haben Jugendliche aller Generationen viel Unsinn angestellt."
                            },
                            {
                                "example_id": "45d49490-bca4-4457-adaf-2503bea713e2",
                                "sense_id": "5c6b5934-0bab-3fce-b08b-d24203936a99",
                                "text": "Als sie sich in ihrer Sturm-und-Drang-Zeit befand, rasierte Grete sich die Haare ab."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
