                "senses": [
                    {
                        "sense_id": "ac7c7b9b-6ab6-30a4-be59-8c47a7d80592",
                        "entry_id": "c4dc2ffb-d6a0-3e72-bf89-df4a56a5ef39",
                        "glosses": [
                            "door de wind veroorzaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "409e592e-c94e-45b9-9afb-5fff26bb822b",
                                "sense_id": "ac7c7b9b-6ab6-30a4-be59-8c47a7d80592",
                                "text": "Die paddenstoelrots is ontstaan door een eolisch proces."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c0c5a10-6318-31b8-9963-f734a02389a6",
                        "entry_id": "c4dc2ffb-d6a0-3e72-bf89-df4a56a5ef39",
                        "glosses": [
                            "door de wind bespeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da3d3f7d-344b-4961-b116-7e5fda21fa9c",
                                "sense_id": "7c0c5a10-6318-31b8-9963-f734a02389a6",
                                "text": "Er klonken plots de ijle klanken van een eolische harp."
                            }
                        ]
                    },
                    {
                        "sense_id": "500d579e-0fce-3b9e-ab76-9c152bda8966",
                        "entry_id": "c4dc2ffb-d6a0-3e72-bf89-df4a56a5ef39",
                        "glosses": [
                            "wat betreft de kerktoonsoort gebaseerd op a"
                        ],
