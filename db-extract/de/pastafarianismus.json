                "senses": [
                    {
                        "sense_id": "87b0729e-778c-31a9-8c5f-6c658742dc3c",
                        "entry_id": "788b83a2-01c0-3bd2-930e-a145617cdac3",
                        "glosses": [
                            "eine im Juni 2005 vom US-amerikanischen Physiker Bobby Henderson ^(→ WP) begründete Religionsparodie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef8a782e-d2be-4ef7-bb85-6aff92f250a9",
                                "sense_id": "87b0729e-778c-31a9-8c5f-6c658742dc3c",
                                "text": "„Und warum machen mir der Hinduismus, der Buddhismus, der Pastafarianismus und der Dalai Lama keine Angst?“"
                            },
                            {
                                "example_id": "da89ca3f-1ae1-4d3e-8a1f-b14598caae6d",
                                "sense_id": "87b0729e-778c-31a9-8c5f-6c658742dc3c",
                                "text": "„Gemäß Punkt b) ist der »Pastafarianismus undogmatisch und respektiert die Gewissenfreiheit des Individuums«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6495e847-a18f-49f1-9856-18b46797ec69",
                        "source_entry_id": "788b83a2-01c0-3bd2-930e-a145617cdac3",
                        "source_sense_id": "87b0729e-778c-31a9-8c5f-6c658742dc3c",
                        "target_lang_word": "Flying Spaghetti Monsterism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flying Spaghetti Monsterism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87ddaa9f-fc0f-3986-af5a-1a4705be10e4",
                                        "entry_id": "771578ca-6ada-341d-ba5a-90f0aedd8dcb",
                                        "glosses": [
                                            "A parody religion centered around the Flying Spaghetti Monster, a creator deity who resembles spaghetti and meatballs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d118352-4522-4536-b137-81c2f2e120a0",
                                                "sense_id": "87ddaa9f-fc0f-3986-af5a-1a4705be10e4",
                                                "text": "When the Kansas Board of Education took up the question of teaching intelligent design as an alternative to Darwinian evolution, Henderson wrote an open letter (posted at www.venganza.org) demanding equal classroom time for Flying Spaghetti Monsterism as well."
                                            },
                                            {
                                                "example_id": "bec8fb07-305b-4772-87fb-8aefd07c7451",
                                                "sense_id": "87ddaa9f-fc0f-3986-af5a-1a4705be10e4",
                                                "text": "Meanwhile, Flying Spaghetti Monsterism (FSM-ism to its \"adherents\") has thrived — particularly on college campuses and in Europe."
                                            },
                                            {
                                                "example_id": "bd4447ba-3958-44e7-9282-c3241e251828",
                                                "sense_id": "87ddaa9f-fc0f-3986-af5a-1a4705be10e4",
                                                "text": "Despite the inherent ridiculousness of Flying Spaghetti Monsterism, he said Mr. Canuel’s case is a legitimate religious freedom issue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "479943dd-1009-476f-8c82-5e78bcc45d0c",
                        "source_entry_id": "788b83a2-01c0-3bd2-930e-a145617cdac3",
                        "source_sense_id": "87b0729e-778c-31a9-8c5f-6c658742dc3c",
                        "target_lang_word": "Pastafarianism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pastafarianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e47835ad-2332-3ae7-a96e-90824f7efd8b",
                                        "entry_id": "643b9531-2459-351c-9939-f207c826472f",
                                        "glosses": [
                                            "A parody religion centered around the Flying Spaghetti Monster, a creator deity who resembles spaghetti and meatballs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb3a9c9f-5ff7-406a-9406-67409fefd6d2",
                                                "sense_id": "e47835ad-2332-3ae7-a96e-90824f7efd8b",
                                                "text": "One third time for Intelligent Design, one third time for Flying Spaghetti Monsterism (Pastafarianism), and one third time for logical conjecture based on overwhelming observable evidence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
