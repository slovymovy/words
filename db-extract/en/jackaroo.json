                    {
                        "sense_id": "9f183314-9a6a-390e-8979-57a64c66e4df",
                        "entry_id": "77d126d9-e7fe-3fc8-a69b-5bc8e1e1e85f",
                        "glosses": [
                            "A white man living outside of a white settlement."
                        ],
                        "tags": [
                            "Australia",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d1702ecf-bbb8-3f7e-af7b-ee8d638fb81f",
                        "entry_id": "77d126d9-e7fe-3fc8-a69b-5bc8e1e1e85f",
                        "glosses": [
                            "A trainee station manager or owner, working as a stockman or farm hand; formerly, a young man of independent means working at a station in a supernumerary capacity to gain experience."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "091d70fb-7f31-4f27-974f-7094d018c106",
                                "sense_id": "d1702ecf-bbb8-3f7e-af7b-ee8d638fb81f",
                                "text": "But this is the tale of a Jackaroo that came from a foreign strand, / And the fight that he fought with Saltbush Bill, the King of the Overland."
                            },
                            {
                                "example_id": "83029115-80a8-4b02-8970-7c65ac756355",
                                "sense_id": "d1702ecf-bbb8-3f7e-af7b-ee8d638fb81f",
                                "text": "A Jackeroo lived, as a kind of gentleman apprentice, in the squatter′s or manager′s homestead, not in the men′s huts; but most of his daily work was done side by side with the working ‘hands’."
                            },
                            {
                                "example_id": "6cddb744-cc1e-4473-a98c-ecc777a7b338",
                                "sense_id": "d1702ecf-bbb8-3f7e-af7b-ee8d638fb81f",
                                "text": "Frequently the overseer would come to me and say a certain jackeroo was useless, and would never be any good, when the boy had only just started."
                            }
                        ]
                    }
                ],
