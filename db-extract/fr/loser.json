                    },
                    {
                        "form_id": "3ced2c21-5a52-4f81-a003-6d23bdc0713e",
                        "entry_id": "986300e2-5a3f-318e-a82b-553bf248a579",
                        "tags": [],
                        "form": "loseur"
                    },
                    {
                        "form_id": "8eba019e-2991-49af-a4c7-ac74607a926e",
                        "entry_id": "986300e2-5a3f-318e-a82b-553bf248a579",
                        "tags": [],
                        "form": "louseur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "77df3666-7c74-3c59-b133-3bc5701378c9",
                        "entry_id": "986300e2-5a3f-318e-a82b-553bf248a579",
                        "glosses": [
                            "Personne sans succès social ou professionnel. Perdant, raté dans la vie."
                        ],
                        "tags": [
                            "Anglicism",
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "037e06fc-161d-45fe-8aa7-5bf0ecd114c0",
                                "sense_id": "77df3666-7c74-3c59-b133-3bc5701378c9",
                                "text": "Maintenant, il n’y a plus d’un côté le groupe cool et de l’autre les losers."
                            },
                            {
                                "example_id": "a9ebf455-d5c7-44a2-89a5-1174c8f6ca9d",
                                "sense_id": "77df3666-7c74-3c59-b133-3bc5701378c9",
                                "text": "Je sentais la colère s’échapper de moi, vite, comme un ballon qui se dégonfle. Il ne fallait pas me laisser à l’aigreur. Tu n’es pas un loser, me dis-je à haute voix. Tu n’es pas battu."
                            },
                            {
                                "example_id": "530c743e-9ed1-4a8d-bf3f-0e845df2a2e0",
                                "sense_id": "77df3666-7c74-3c59-b133-3bc5701378c9",
                                "text": "La langue parisienne cynique accable certains malheureux d'un terme atroce, le mot loser, prononcé louseur ou louzère, qui signifie « perdant ». Une fois qu'il est collé, on ne s'en débarrasse plus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ef5cb43-2a6c-425a-9ff9-de31cbcb74e8",
                        "source_entry_id": "986300e2-5a3f-318e-a82b-553bf248a579",
                        "source_sense_id": "77df3666-7c74-3c59-b133-3bc5701378c9",
                        "target_lang_word": "loser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f18b2040-94e4-3178-a12d-5ba7fb9781d1",
                                        "entry_id": "b8ed29ae-5b10-355f-afab-a1cd5edeff85",
                                        "glosses": [
                                            "A person who loses; one who fails to win or thrive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4568a70e-c295-4be1-98c7-5645bc45b19c",
                                                "sense_id": "f18b2040-94e4-3178-a12d-5ba7fb9781d1",
                                                "text": "In a two-horse race there is always one winner and one loser."
                                            },
                                            {
                                                "example_id": "f97db1c5-5bd7-4462-948a-d561f70c1cc3",
                                                "sense_id": "f18b2040-94e4-3178-a12d-5ba7fb9781d1",
                                                "text": "He was always a good loser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a72b4ead-93bf-3c91-9a66-b0a6ecd1109d",
                                        "entry_id": "b8ed29ae-5b10-355f-afab-a1cd5edeff85",
                                        "glosses": [
                                            "Something of poor quality."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95f6caa0-8f49-3a8f-bbf3-389fd1172303",
                                        "entry_id": "b8ed29ae-5b10-355f-afab-a1cd5edeff85",
                                        "glosses": [
                                            "A person who is frequently unsuccessful in life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd78e16a-cae7-4e38-bbf5-25023272c278",
                                                "sense_id": "95f6caa0-8f49-3a8f-bbf3-389fd1172303",
                                                "text": "That guy is a born loser!"
                                            },
                                            {
                                                "example_id": "3e94b048-18e2-4fd5-8cbb-72e592de7a85",
                                                "sense_id": "95f6caa0-8f49-3a8f-bbf3-389fd1172303",
                                                "text": "I'm a constant loser in love."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "904146e1-8daf-3b7c-8cdc-ddb104ea7f68",
                                        "entry_id": "b8ed29ae-5b10-355f-afab-a1cd5edeff85",
                                        "glosses": [
                                            "A contemptible or unfashionable person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0f6ea86-cb71-4c5f-a2b5-1b7a72eddc6e",
                                                "sense_id": "904146e1-8daf-3b7c-8cdc-ddb104ea7f68",
                                                "text": "Mike didn't work but insisted that Jewell have a job. He would stay home and do whatever — smoke pot, screw around. He was a total loser, and she picked up the slack. That's around the time that Mom met her soon-to-be-next husband. He immediately moved in. He was a loser, too, with the same work ethic Mike had."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d390639d-2454-3761-a158-d76d52fa66c6",
                                        "entry_id": "b8ed29ae-5b10-355f-afab-a1cd5edeff85",
                                        "glosses": [
                                            "One who or that which loses something, such as extra weight, car keys, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64f67d40-0ced-41fb-8323-d5c54725b351",
                                                "sense_id": "d390639d-2454-3761-a158-d76d52fa66c6",
                                                "text": "Another way to speed search (in general) is to order or bias the hypothesis space based on some heuristic. Suppose you are a habitual car key loser and that you keep track of where your keys turn up after each search."
                                            },
                                            {
                                                "example_id": "3edffcad-c2d4-4635-a831-3fc924789740",
                                                "sense_id": "d390639d-2454-3761-a158-d76d52fa66c6",
                                                "text": "But a West German reporting a lost passport in East Berlin during the years of the Wall was treated to a criminal investigation, with the passport loser as the potential criminal."
                                            },
                                            {
                                                "example_id": "ef4d87ab-13bd-4a29-bb7f-c1578255d7b2",
                                                "sense_id": "d390639d-2454-3761-a158-d76d52fa66c6",
                                                "text": "You're counting on this insurance company to pay you a check many years in the future. But for some companies, disability coverage has been a money loser."
                                            },
                                            {
                                                "example_id": "8cfcdb8d-4400-4832-aaab-2d67b41b8205",
                                                "sense_id": "d390639d-2454-3761-a158-d76d52fa66c6",
                                                "text": "You have to think of yourself as an already amazing person who's hiding behind extra weight—a superhero in a disguise. If you follow the program, […] change the message from “I'm a big loser” to “I'm a big weight loser.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "064f4a2e-a5d7-3272-8147-309312bd914f",
                                        "entry_id": "b8ed29ae-5b10-355f-afab-a1cd5edeff85",
                                        "glosses": [
                                            "A losing proposition, one that is likely to lose or already has lost (such as a losing bet or, analogously, a predictably fruitless task or errand)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7608025-04ec-4529-b956-f16298e2403f",
                                                "sense_id": "064f4a2e-a5d7-3272-8147-309312bd914f",
                                                "text": "A new Guard came to town and decided to flex his muscles with George. We could have told him that he was on a loser but bright young men, then as now, know it all."
                                            },
                                            {
                                                "example_id": "aedad777-0955-4780-a5f7-e6c6e197951f",
                                                "sense_id": "064f4a2e-a5d7-3272-8147-309312bd914f",
                                                "text": "Hardway bets are losers if they are rolled in any other combination—called \"soft\" or \"easy\" numbers. For instance, a Hardway bet on a 4 is a loser if the dice show as 3 and 1. Betting on a Hard 8 is a loser if the dice are rolled as a 5 and 3, or a 6 and 2. Naturally, if the 7 is rolled before the Hardway number shows, the bet is also a loser."
                                            },
                                            {
                                                "example_id": "95176f07-78d3-46a0-9b17-986997d97775",
                                                "sense_id": "064f4a2e-a5d7-3272-8147-309312bd914f",
                                                "text": "In terms of betting on outcomes, Mars is a clear loser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fbf963c-f6d1-31c1-992e-e39295128ad7",
                                        "entry_id": "b8ed29ae-5b10-355f-afab-a1cd5edeff85",
                                        "glosses": [
                                            "A person convicted of a crime, especially more than once."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e24ec527-f59f-43ec-955c-ebf8da9fc393",
                                                "sense_id": "6fbf963c-f6d1-31c1-992e-e39295128ad7",
                                                "text": "He's a three-time loser doing twenty years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
