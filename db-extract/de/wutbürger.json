                ],
                "senses": [
                    {
                        "sense_id": "28c66745-2ac2-3192-8a43-c440221a7ca8",
                        "entry_id": "1eebca2d-c055-3146-9c02-394450cc0bd6",
                        "glosses": [
                            "ein eher konservativer, gut situierter Bürger der Gesellschaft, der sich darüber empört und dagegen protestiert, dass politische Entscheidungen ohne seine direkte persönliche Einflussnahme gewissermaßen über seinen Kopf hinweg getroffen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "325da409-c2b3-44ca-b832-36fd8a78db49",
                                "sense_id": "28c66745-2ac2-3192-8a43-c440221a7ca8",
                                "text": "„Die deutsche Gesellschaft für Sprache (GfdS) hat den ‚Wutbürger‘ zum Wort des Jahres gewählt. ‚Wutbürger‘ stehe für die Empörung in der Bevölkerung, dass politische Entscheidungen über ihren Kopf hinweg getroffen werden‘.“"
                            },
                            {
                                "example_id": "936c6aa6-538b-43ad-bb9a-d079775b5720",
                                "sense_id": "28c66745-2ac2-3192-8a43-c440221a7ca8",
                                "text": "Wutbürger wollen das Projekt „Stuttgart 21“ verhindern."
                            },
                            {
                                "example_id": "a6432460-4e27-4682-bf5f-9390b8863fb9",
                                "sense_id": "28c66745-2ac2-3192-8a43-c440221a7ca8",
                                "text": "Der Sozialpsychologe Harald Welzer nannte den Begriff des Wutbürgers in der taz bezüglich der Proteste gegen Stuttgart 21 „denunziatorisch formuliert“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "351165ef-0f83-4deb-9750-8bcf026769b0",
                        "source_entry_id": "1eebca2d-c055-3146-9c02-394450cc0bd6",
                        "source_sense_id": "28c66745-2ac2-3192-8a43-c440221a7ca8",
                        "target_lang_word": "citoyen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citoyen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12d06ff0-a7b2-3d58-a02e-93b2bc298a22",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Homme libre de l’Empire romain, doté de droits politiques dans une cité. En 212, l’empereur Caracalla étend le droit de citoyenneté romaine à l’ensemble des hommes libres de l’empire romain."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fce926e1-42cf-3fd0-93d9-d510ebe7fa0c",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Homme libre appartenant au corps civique dans les cités de la Grèce antique."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f916cf68-3f96-43cb-8a70-666f357b83cb",
                                                "sense_id": "fce926e1-42cf-3fd0-93d9-d510ebe7fa0c",
                                                "text": "Si les thètes sont citoyens d’Athènes, c’est parce que leurs parents étaient citoyens d’Athènes et ainsi de suite comme cela jusqu'à… Erichthonios."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Personne faisant partie de ceux qui, dans un État organisé, jouissent des mêmes droits et obéissent aux mêmes lois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6127c51-9104-46cb-a234-950b5d637db6",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "Il faut entrer de force dans le domicile du citoyen : il faut arrêter administrativement l’homme qui ne peut être arrêté qu’en vertu d’une loi ; il faut violer la liberté de l’opinion et la liberté individuelle ; il faut en un mot mettre en péril la constitution même de l’État."
                                            },
                                            {
                                                "example_id": "47c1fb76-7513-48bf-b897-59bfa1622da9",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "Nous sommes militaires, en France, et nous sommes citoyens. Autre motif d’orgueil, que d’être citoyen ! Cela consiste pour les pauvres à soutenir et à conserver les riches dans leur puissance et leur oisiveté. Ils y doivent travailler devant la majestueuse égalité des lois, qui interdit au riche comme au pauvre de coucher sous les ponts, de mendier dans les rues et de voler du pain. C’est un des bienfaits de la Révolution."
                                            },
                                            {
                                                "example_id": "114c75bd-15a0-4118-b55a-2406dd015ebb",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "Sumner Maine fait observer que les rapports des gouvernements et des citoyens ont été bouleversés de fond en comble depuis la fin du XVIIIᵉ siècle […]"
                                            },
                                            {
                                                "example_id": "55eea921-3305-4e01-8fe1-aeaf3ea6a153",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "À ce moment, la guerre tomba brutalement, sans crier gare. Le deuxième jour de mobilisation, Fagerolle se vit jeté dans un wagon à bestiaux, parmi les vomissures et les gueulements patriotiques d’un certain nombre de citoyens français."
                                            },
                                            {
                                                "example_id": "83e94972-b340-4220-a2fd-355c6df57459",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "Pourquoi ne ferions nous pas bûcher davantage nos citoyens afin de pouvoir dorloter nos citoyennes ? Cela serait profondément naturel et juste."
                                            },
                                            {
                                                "example_id": "61532504-8413-408f-b973-3f1b056a46b5",
                                                "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                                                "text": "Les jurisconsultes civils donnèrent aussi leur avis et Valin dans son Commentaire sur l’Ordonnance de la Marine déclara « que les philosophes (sic) qui désapprouvaient la guerre de course étaient de mauvais citoyens. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55884138-6401-3218-879b-dd124bd91148",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Personne faisant partie de ceux qui, dans un État organisé, jouissent des mêmes droits et obéissent aux mêmes lois.",
                                            "En particulier, qualités civiques attendue de cette personne dans ses décisions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd1feab-3298-4238-84cf-de085a631b72",
                                                "sense_id": "55884138-6401-3218-879b-dd124bd91148",
                                                "text": "Moi je suis Français, j'agis, je pense, je me décide en tant que citoyen français, j'ai été élevé dans le culte de cette République qui ne reconnaît que des citoyens français et je suis profondément outré par cette réduction permanente dans un sens ou dans l'autre"
                                            },
                                            {
                                                "example_id": "c7d7eb32-b6e4-4f0e-b931-54f8614ace2a",
                                                "sense_id": "55884138-6401-3218-879b-dd124bd91148",
                                                "text": "Résister à la bêtise est donc un devoir fondamental du citoyen dont la dignité est étroitement liée au fait qu’il est un « être doué de raison et de conscience"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Celui qui habite dans une ville et y jouit du droit de cité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14ac9661-4098-4176-9c77-ca843c2d4c17",
                                                "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                                                "text": "Quant aux citoyens de Tours, ils accueillirent pacifiquement le général gallo-romain, qui prit possession de la place au nom du roi Sighebert."
                                            },
                                            {
                                                "example_id": "ea3ae037-f582-4224-a839-7ec576893f19",
                                                "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                                                "text": "\"Puisque j'ai essuyé, dit-il, un si cruel caprice d'une fille élevée à la cour, il faut que j'épouse une citoyenne.\" Il choisit Azora, la plus sage et la mieux née de la ville."
                                            },
                                            {
                                                "example_id": "658e6e8e-ca06-4446-93de-701d6563b518",
                                                "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                                                "text": "Quoiqu’il résidât dans la ville principale de Mars, Ulfète, nulle cité ne le réclamait comme citoyen."
                                            },
                                            {
                                                "example_id": "081e4228-271f-4de9-b3f2-cc56489a821b",
                                                "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                                                "text": "Ces tensions entre citoyens et élus traduisent le pourrissement de la situation depuis l’installation, le 24 septembre 2021, des consommateurs de crack du jardin d’Éole sur le site de Forceval, adjacent à la porte de la Villette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28136bcb-7c69-31a3-a5e9-33724b9b4bf0",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Appellation que, dans certains milieux, en particulier pendant la Révolution française, on substitue à monsieur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64cd5a65-5594-32db-b74d-757876ffe972",
                                        "entry_id": "ebd36b34-2d1c-3f03-8b3f-b30b0936cb2a",
                                        "glosses": [
                                            "Type, gars, individu."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3adb093b-aff3-4a31-a8a4-00bd0e5471c4",
                                                "sense_id": "64cd5a65-5594-32db-b74d-757876ffe972",
                                                "text": "– Eh bien ! dites donc ! Il est drôlement malade, le citoyen !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "citoyen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bdbc93a-0105-38d7-b6ad-2b386925cf83",
                                        "entry_id": "c0e3f69d-76f7-3992-96e5-37baa8cc5cc7",
                                        "glosses": [
                                            "(Par apposition) Qui est citoyen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0748fb35-f65d-4cc9-b2df-287a49b49f08",
                                                "sense_id": "9bdbc93a-0105-38d7-b6ad-2b386925cf83",
                                                "text": "Louis-Philippe, le roi-citoyen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                        "entry_id": "c0e3f69d-76f7-3992-96e5-37baa8cc5cc7",
                                        "glosses": [
                                            "Qui se rapporte à la citoyenneté ou au civisme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29822029-b434-4f64-8506-a3066e99ed8a",
                                                "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                                "text": "Un sursaut citoyen est nécessaire."
                                            },
                                            {
                                                "example_id": "701dfc50-bc9b-4c0a-8e55-bc98d405eb99",
                                                "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                                "text": "Le Mouvement républicain et citoyen (MRC) est un parti politique français de gauche républicaine qui a été fondé en 2003,"
                                            },
                                            {
                                                "example_id": "d4d2d3d5-f3c7-441b-bfcb-8cb6fb251215",
                                                "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                                                "text": "Mais faire un petit effort pour écarter les fautes d'orthographe et de grammaire est un acte citoyen : il démontre un souci de l'autre, un respect pour la conversation en cours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80f32d1b-e7f3-4bb4-bc39-a70a567873c2",
                        "source_entry_id": "1eebca2d-c055-3146-9c02-394450cc0bd6",
                        "source_sense_id": "28c66745-2ac2-3192-8a43-c440221a7ca8",
                        "target_lang_word": "enragé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enragé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76f67ad9-627a-3815-8e4e-a178f88b842b",
                                        "entry_id": "cf4fb6ef-20a9-3884-8bb4-57c15fa9cec8",
                                        "glosses": [
                                            "Qui est atteint de la rage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc9577ca-4d67-4930-a1ee-f18c08138085",
                                                "sense_id": "76f67ad9-627a-3815-8e4e-a178f88b842b",
                                                "text": "– Si enragé que cela ! s’écria M. Bernard indigné, si vous l’aviez vu, si vous aviez vu l’écume, et les yeux injectés, et les poils hérissés. Ce n’était plus un chien, c’était un tigre, un tigre, un tigre !"
                                            },
                                            {
                                                "example_id": "9717a635-b29d-4cda-8039-9f7ea446587a",
                                                "sense_id": "76f67ad9-627a-3815-8e4e-a178f88b842b",
                                                "text": "La malbête a encore attaqué ! répète-t-il. Le grand Berlot est blessé ! Tandis que le garçon raconte le combat acharné du solide moissonneur contre le loup enragé, les habitants de Mosnay se tournent vers la maison des Aufour en deuil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca0462fc-c190-3e05-b35e-c31890c15f15",
                                        "entry_id": "cf4fb6ef-20a9-3884-8bb4-57c15fa9cec8",
                                        "glosses": [
                                            "Qui rend comme atteint de la rage ou de folie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d817ebb-b4a3-4d35-943a-2249cd469934",
                                                "sense_id": "ca0462fc-c190-3e05-b35e-c31890c15f15",
                                                "text": "Une douleur enragée."
                                            },
                                            {
                                                "example_id": "ca75a914-a785-4830-90ae-015549f204d8",
                                                "sense_id": "ca0462fc-c190-3e05-b35e-c31890c15f15",
                                                "text": "Une faim enragée."
                                            },
                                            {
                                                "example_id": "05c3d2b3-913f-45e3-b11f-5758b57255b1",
                                                "sense_id": "ca0462fc-c190-3e05-b35e-c31890c15f15",
                                                "text": "Une passion enragée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca36a3a7-cf6c-3c1d-ba1e-bef44232c44d",
                                        "entry_id": "cf4fb6ef-20a9-3884-8bb4-57c15fa9cec8",
                                        "glosses": [
                                            "Extrêmement acharné, avec une sorte de rage."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cdb00b1-38e8-4c78-ad2c-c25d586e198c",
                                                "sense_id": "ca36a3a7-cf6c-3c1d-ba1e-bef44232c44d",
                                                "text": "L'art n'effraie plus personne, aujourd'hui, tu n'as plus besoin d'être enragé pour te faire entendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6dca4dc-01fc-36af-b8c8-d8dc917487de",
                                        "entry_id": "cf4fb6ef-20a9-3884-8bb4-57c15fa9cec8",
                                        "glosses": [
                                            "Qui est dans une grande colère."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52e855c8-4c8c-43cb-9ec6-d2bc03593ed2",
                                                "sense_id": "c6dca4dc-01fc-36af-b8c8-d8dc917487de",
                                                "text": "Être enragé contre quelqu’un."
                                            },
                                            {
                                                "example_id": "da5be3d9-92e7-4b19-be83-7c68df3a2bc9",
                                                "sense_id": "c6dca4dc-01fc-36af-b8c8-d8dc917487de",
                                                "text": "Marthe n’aime pas les enfants. Les enfants gâtés. Mais elle a toujours été émue par les autres : les mal-aimés, les enfants tristes, les enfants en larmes, les enfants enragés de chagrin;."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b88b46f-577a-34fa-973c-8640aa346e62",
                                        "entry_id": "cf4fb6ef-20a9-3884-8bb4-57c15fa9cec8",
                                        "glosses": [
                                            "Qui se laisse emporter à faire quelque chose hors de raison."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114344d7-8842-4707-bf5c-792dbeffaf57",
                                                "sense_id": "1b88b46f-577a-34fa-973c-8640aa346e62",
                                                "text": "Il faut que vous soyez enragé, si vous prenez cette résolution."
                                            },
                                            {
                                                "example_id": "8670ba38-28a0-4a79-9d59-1076844b0e4b",
                                                "sense_id": "1b88b46f-577a-34fa-973c-8640aa346e62",
                                                "text": "Il faut être enragé pour faire cela, pour se conduire ainsi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a5409fb-b72b-34f1-9dd4-60f88bd77a44",
                                        "entry_id": "cf4fb6ef-20a9-3884-8bb4-57c15fa9cec8",
                                        "glosses": [
                                            "Passionné"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3342379c-30a7-4301-a217-3ae22c846371",
                                                "sense_id": "3a5409fb-b72b-34f1-9dd4-60f88bd77a44",
                                                "text": "Un collectionneur enragé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91d26d8b-88a3-39f5-8ce0-d3df195343b7",
                                        "entry_id": "cf4fb6ef-20a9-3884-8bb4-57c15fa9cec8",
                                        "glosses": [
                                            "Ce qui est exécuté avec une sorte de rage, de folie bruyante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e2dc7a-5521-4293-a450-37a4aad5207e",
                                                "sense_id": "91d26d8b-88a3-39f5-8ce0-d3df195343b7",
                                                "text": "Une musique enragée."
                                            },
                                            {
                                                "example_id": "ef78adfe-4436-4d99-87f6-03654a852c90",
                                                "sense_id": "91d26d8b-88a3-39f5-8ce0-d3df195343b7",
                                                "text": "Une polémique enragée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enragé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44fad6da-4e8f-3c82-b866-3837f86c4b4a",
                                        "entry_id": "dd5a219d-b04b-332e-b731-09ed65570401",
                                        "glosses": [
                                            "Homme fougueux, impétueux ou qui s’acharne à quelque chose."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b89d5d9e-fc91-4930-9198-9441d09fc6b1",
                                                "sense_id": "44fad6da-4e8f-3c82-b866-3837f86c4b4a",
                                                "text": "Oh! ce sont de très bons gentilshommes, tous nobles de nom et d'armes, mais qui ont des idées de l'autre monde, et y tiennent comme des enragés; …."
                                            }
                                        ]
                                    }
                                ]
                            },
