                    {
                        "translation_id": "e89f1217-57bc-43bf-b17c-55a59d54c11e",
                        "source_entry_id": "3670f95a-dc2c-349e-94d9-bfbb6c4060aa",
                        "source_sense_id": "893f911d-e411-3ab5-ae0a-f5b6bcd1668c",
                        "target_lang_word": "Pedanterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pedanterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "676c06b1-bb61-3d63-a9e4-81f996f55107",
                                        "entry_id": "d5fec1ca-655a-3df7-b16e-46728bb8438d",
                                        "glosses": [
                                            "die Eigenschaft, übergenau oder sehr kleinlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "792f0c7e-3da9-452b-8526-70d72420d507",
                                                "sense_id": "676c06b1-bb61-3d63-a9e4-81f996f55107",
                                                "text": "„Mystifikation war so sehr zu seiner zweiten Natur geworden wie die Pedanterie für Burch.“"
                                            },
                                            {
                                                "example_id": "b6edcdbe-0052-4e5e-91d0-25afebe5aebe",
                                                "sense_id": "676c06b1-bb61-3d63-a9e4-81f996f55107",
                                                "text": "„Er war ein kauziger, hochgebildeter, gleichzeitig distanzierter und herzlicher Mitstreiter, von großer Pedanterie und schalkhaftem Witz, und ich möchte keine Stunde mit ihm missen, auch nicht ein gemeinsames Sylvester in Kreienshoop.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5faceb3-2ab2-49eb-9ccc-6e48eba77264",
                        "source_entry_id": "3670f95a-dc2c-349e-94d9-bfbb6c4060aa",
                        "source_sense_id": "893f911d-e411-3ab5-ae0a-f5b6bcd1668c",
                        "target_lang_word": "Akribie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akribie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                        "entry_id": "6a3d8b4f-54d7-3544-a579-72df21b92a87",
                                        "glosses": [
                                            "höchste Sorgsamkeit, höchste Genauigkeit, äußerste Gründlichkeit"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b59fa24-481a-4580-b843-30b99190daab",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "Er erledigte diese Aufgabe mit großer Akribie."
                                            },
                                            {
                                                "example_id": "d936c86c-6249-48db-a20c-77fb4d227a7c",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "„Mir wurde bald deutlich, daß man sogenannter objektiver Wahrheit nicht ohne alle erdenkliche Akribie habhaft werden kann.“"
                                            },
                                            {
                                                "example_id": "2b04487e-9a0c-4906-9c01-42686ac26bf7",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "In der Orthodoxie ist Akribie die äußerste Genauigkeit, nach der alle Gebote gewissenhaft befolgt werden müssen."
                                            },
                                            {
                                                "example_id": "c1519b5c-fa35-4172-b230-cdef38c0ef13",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "„Aber die Akribie derartiger Zusammenstellungen verrät einen Hang zur Eindeutigkeit, den die folgenden Ausschweifungen nicht teilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
