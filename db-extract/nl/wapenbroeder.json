                ],
                "senses": [
                    {
                        "sense_id": "85a92325-241b-39b1-8a48-42a0c498e0ab",
                        "entry_id": "151c8bd7-d77c-3597-a129-431cf2fd15c3",
                        "glosses": [
                            "maat in het leger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f9ac2fb-e071-45cb-b45a-edc6c9244759",
                                "sense_id": "85a92325-241b-39b1-8a48-42a0c498e0ab",
                                "text": "Dat was smullen, maar bij het Nationaal Veteraan Treffen werd het nog veel mooier. De jaarlijkse bijeenkomst op het Exercitieterrein in Woerden is, anders dan de naam wellicht doet vermoeden, geen terugkomdag van voormalige wapenbroeders, maar een verzameling van motorisch erfgoed."
                            },
                            {
                                "example_id": "e95b9fcf-a163-40bf-b667-8257b5cc6cd3",
                                "sense_id": "85a92325-241b-39b1-8a48-42a0c498e0ab",
                                "text": "De verrassingsaanval van de Taliban werd uit drie richtingen ingezet. Bij de aanvallen werd ook de gevangenis ingenomen. Honderden gevangenen, onder wie veel wapenbroeders van de Taliban, werden bevrijd. Regeringstroepen en politie-eenheden kregen nauwelijks steun van buitenlandse eenheden."
                            }
                        ]
                    },
                    {
                        "sense_id": "62a97bda-3423-3923-8388-4054be0c8ba3",
                        "entry_id": "151c8bd7-d77c-3597-a129-431cf2fd15c3",
                        "glosses": [
                            "iemand die dezelfde strijd voert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7db0b34-f712-43eb-a50a-1d1a194fbfb1",
                                "sense_id": "62a97bda-3423-3923-8388-4054be0c8ba3",
                                "text": "De jury van de Bob den Uyl Prijs roemde Westerman omdat hij \"zoekt naar de verhalen achter de propaganda, de oneliners van Twitter en de gehackte sociale media. Schrijvers en journalisten zijn wapenbroeders in de strijd tegen leugen en bedrog.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6771626e-b575-4ab6-9d98-c1d177b38e33",
                        "source_entry_id": "151c8bd7-d77c-3597-a129-431cf2fd15c3",
                        "source_sense_id": "85a92325-241b-39b1-8a48-42a0c498e0ab",
                        "target_lang_word": "brother-in-arms",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brother-in-arms",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59a452af-fae2-35e9-8fda-5f44e3239887",
                                        "entry_id": "5c388201-24ba-3f88-9f33-cc46083fb01b",
                                        "glosses": [
                                            "comrade in arms (fellow combatant or soldier)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c32e6392-75d9-4f39-8e90-7d643ca5edd8",
                                                "sense_id": "59a452af-fae2-35e9-8fda-5f44e3239887",
                                                "text": "But the vengeance I told myself I was getting for Wrex felt like a lie. I could win the game but he wasn't coming back. Being forced to lose my in-game comrade-who I thought of as a virtual person of color and as a brother-in-arms-affected me in a forceful way that I never expected. Mass Effect made me look at myself and think about the way races, classes and individuals bring their histories to bear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aed03fda-7c08-4574-baa4-5a4206b5e0c6",
                        "source_entry_id": "151c8bd7-d77c-3597-a129-431cf2fd15c3",
                        "source_sense_id": "85a92325-241b-39b1-8a48-42a0c498e0ab",
                        "target_lang_word": "fellow combatant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ff5c3099-2343-451b-a2e5-892db4ce6543",
                        "source_entry_id": "151c8bd7-d77c-3597-a129-431cf2fd15c3",
                        "source_sense_id": "85a92325-241b-39b1-8a48-42a0c498e0ab",
                        "target_lang_word": "comrade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comrade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37351855-39e9-34a9-b7df-049c75efba32",
                                        "entry_id": "71d5bc83-a3cd-30c8-a29a-32e247ebd1fa",
                                        "glosses": [
                                            "A mate, companion, or associate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e537c8dd-ea2b-4941-947f-0759c3d8bdc6",
                                                "sense_id": "37351855-39e9-34a9-b7df-049c75efba32",
                                                "text": "[… these tears] Which weep the comrade of my choice,\n⁠An awful thought, a life removed,\n⁠The human-hearted man I loved,\nA spirit, not a breathing voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cceeea89-eb40-3113-8050-16202cc23347",
                                        "entry_id": "71d5bc83-a3cd-30c8-a29a-32e247ebd1fa",
                                        "glosses": [
                                            "A mate, companion, or associate.",
                                            "A companion in battle; fellow soldier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af4949e-f05f-4ad9-80f9-a098693848df",
                                                "sense_id": "cceeea89-eb40-3113-8050-16202cc23347",
                                                "text": "Wierzbowski and his men were so exhausted that they could hardly stay awake, but they knew they could not abandon their wounded comrades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5629d850-cc95-3bc2-98d1-8bcf755805c9",
                                        "entry_id": "71d5bc83-a3cd-30c8-a29a-32e247ebd1fa",
                                        "glosses": [
                                            "A fellow socialist, communist or other similarly politically aligned person."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94923d27-fd6e-495b-a9ab-9b31b13bfd20",
                                                "sense_id": "5629d850-cc95-3bc2-98d1-8bcf755805c9",
                                                "text": "Hello, comrade. Are you going to the Communist Party meeting tonight?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8074cee5-3145-3482-bbdd-0e8b5ccf724a",
                                        "entry_id": "71d5bc83-a3cd-30c8-a29a-32e247ebd1fa",
                                        "glosses": [
                                            "A non-hierarchical title, functionally similar to \\\"Mr.\\\", \\\"Mrs.\\\", \\\"Miss\\\", \\\"Ms.\\\" etc, in a communist, socialist, or rarely in an Islamist state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78086df8-b4e3-4be6-a017-d7d0a3ee59c1",
                                                "sense_id": "8074cee5-3145-3482-bbdd-0e8b5ccf724a",
                                                "text": "Comrade Lenin inspired our people to undertake great works."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comrade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d2a84be-95b5-32b6-ba87-1f3dc155c2b2",
                                        "entry_id": "0f637d6a-1f75-35bc-897d-f03cce7f31c9",
                                        "glosses": [
                                            "To associate with someone in a friendly way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "861ccf55-1935-4ae0-a0a0-82af27c46f74",
                                                "sense_id": "8d2a84be-95b5-32b6-ba87-1f3dc155c2b2",
                                                "text": "But she was happy, for she was far away under another sky, and comrading again with her Rangers, and her animal friends, and the soldiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
