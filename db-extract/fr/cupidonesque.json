                                "sense_id": "e6303e89-a136-34b8-a137-3eae7728731b",
                                "text": "Tel était le menu de ce festin cupidonesque.\nA peine le couple palpitant était-il attablé, qu'on frappa à la porte."
                            },
                            {
                                "example_id": "cb520c76-d7a5-4fee-958a-a7b830fb9ec2",
                                "sense_id": "e6303e89-a136-34b8-a137-3eae7728731b",
                                "text": "Pieds nus,en chemise, le bossu préparait du thé. « C'est la grande vie nocturne et cupidonesque, ricanai-je."
                            },
                            {
                                "example_id": "16bce1ad-b24e-43a6-857e-41e25745c0b3",
                                "sense_id": "e6303e89-a136-34b8-a137-3eae7728731b",
                                "text": "Son sourire fait l'effet d'une flèche cupidonesque qui fait mouche."
                            }
                        ]
                    }
