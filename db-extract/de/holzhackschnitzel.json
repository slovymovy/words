                                "example_id": "6642cd51-b157-4c54-bc73-4c3de383eafa",
                                "sense_id": "39f941b2-7fe1-3721-a88d-12a82939050f",
                                "text": "Holzhackschnitzel werden beispielsweise in Biogasanlagen als Brennstoff oder auf Kinderspielplätzen als Bodenbelag verwendet."
                            },
                            {
                                "example_id": "e38dc8dc-c99c-4437-a999-ca2cfe15769b",
                                "sense_id": "39f941b2-7fe1-3721-a88d-12a82939050f",
                                "text": "„Holzhackschnitzel sind nach Meinung der Energieagentur Ebersberg-München der Brennstoff der Wahl für das geplante Nahwärmenetz in Höhenkirchen-Siegertsbrunn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
