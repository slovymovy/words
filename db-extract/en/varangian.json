                ],
                "senses": [
                    {
                        "sense_id": "23e5e270-2e0d-3b8f-930a-f4c0536b09f2",
                        "entry_id": "08c27e7e-514b-3c63-98b9-f77d06f28660",
                        "glosses": [
                            "A member of the ethnically Scandinavian people around the borders of Constantinople in the ninth and tenth centuries."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e198fd0e-253d-3098-8cee-18868c06b2a9",
                        "entry_id": "08c27e7e-514b-3c63-98b9-f77d06f28660",
                        "glosses": [
                            "A member of the imperial body guard at Constantinople from 955."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "424e277a-c5bf-40df-ac42-ae1cdc778206",
                                "sense_id": "e198fd0e-253d-3098-8cee-18868c06b2a9",
                                "text": "The Byzantines continued to recruit elite warriors from the north, not merely from Rus’ but directly from far-off Scandinavia; from the end of the tenth century, they referred to them as ‘Varangians’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84bb4308-bcdf-4e46-867d-72a430f20912",
                        "source_entry_id": "08c27e7e-514b-3c63-98b9-f77d06f28660",
                        "source_sense_description": "member of a Scandinavian tribe",
                        "target_lang_word": "Varjaag",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4f64afd8-b1e3-4a2d-98f5-07da9bfa0549",
                        "source_entry_id": "08c27e7e-514b-3c63-98b9-f77d06f28660",
                        "source_sense_description": "member of a Scandinavian tribe",
                        "target_lang_word": "Varègue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Varègue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f1469f2-4312-39e2-bc10-e106697549bb",
                                        "entry_id": "8025ea3c-61b5-3069-b89f-b3b3aad7df16",
                                        "glosses": [
                                            "Viking de Suède opérant à l’est entre le IXᵉ et le XIᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ff11f61-3f27-4af6-8804-0176f3cb5791",
                                                "sense_id": "6f1469f2-4312-39e2-bc10-e106697549bb",
                                                "text": "Les Varègues étaient des conquérants ou des princes élus par les Slaves, constitués alors en une espèce de république, dont la capitale était Novgorod."
                                            },
                                            {
                                                "example_id": "266ab712-10e5-4dd7-a7db-89d411fbf442",
                                                "sense_id": "6f1469f2-4312-39e2-bc10-e106697549bb",
                                                "text": "Ce que suggère l’analyse du système familial russe, qui semble inclure simultanément des éléments scandinaves et centre-asiatiques, c’est que l’influence suédoise ne fut pas simplement politique et marginale, mais que les Varègues, pénétrant la Russie par la Baltique et la Volga, participèrent assez massivement à la formation même du peuple russe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa0f3f2a-fefe-45a9-abdb-e250981e9e31",
                        "source_entry_id": "08c27e7e-514b-3c63-98b9-f77d06f28660",
                        "source_sense_description": "member of a Scandinavian tribe",
                        "target_lang_word": "Waräger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waräger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33666106-7bfa-352e-a6ca-284e557cc2ff",
                                        "entry_id": "2a71f20e-755a-3b6a-96c6-ca9f911f26ea",
                                        "glosses": [
                                            "in Ost- und Südosteuropa gebräuchliche Bezeichnung für einen Angehörigen eines ursprünglich in Skandinavien beheimateten Volksstammes"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f624b80a-78f4-4546-b916-6d8b7341147a",
                                                "sense_id": "33666106-7bfa-352e-a6ca-284e557cc2ff",
                                                "text": "„Die Waräger erwarben sich nicht den schrecklichen Ruf ihrer stammverwandten Normannen im Westen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3382029c-9bf9-4227-af17-2b5edfce0949",
                        "source_entry_id": "08c27e7e-514b-3c63-98b9-f77d06f28660",
                        "source_sense_description": "member of a Scandinavian tribe",
                        "target_lang_word": "variago",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "15645d90-056e-4c69-8bc0-05939a9611ea",
                        "source_entry_id": "08c27e7e-514b-3c63-98b9-f77d06f28660",
                        "source_sense_description": "member of a Scandinavian tribe",
                        "target_lang_word": "варя́г",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "варя́г",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a3a07763-8f21-37bc-bcb2-19737302a68d",
                                        "entry_id": "f4550646-b25a-3187-b84e-80dec503f15f",
                                        "glosses": [
                                            "истор. русское название скандинавского викинга"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "229e7ad4-6827-46b6-8855-ecf664bac53c",
                                                "sense_id": "a3a07763-8f21-37bc-bcb2-19737302a68d",
                                                "text": "Поперёк её были уложены короткие тонкие брёвнышки, по которым переволакивают в обход порогов лодки — это был «волок», вероятно ни на волос не отличавшийся от тех, по каким волочили свои ладьи из рек в реки древние варяги и новгородцы."
                                            },
                                            {
                                                "example_id": "da1c71dd-ab70-4a90-ab99-00b87e1fd95a",
                                                "sense_id": "a3a07763-8f21-37bc-bcb2-19737302a68d",
                                                "text": "Ведь она по воспитанию, по положению, по духу, наконец, скорее русинка, чем славянка, так для чего же ей, любимице конунга, понадобилось, чтобы он, варяг без роду и племени, знал славянские обычаи?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eab71b6-f021-3719-b056-d5ef87f4aa63",
                                        "entry_id": "f4550646-b25a-3187-b84e-80dec503f15f",
                                        "glosses": [
                                            "перен., шутл. человек (обычно руководитель), приходящий в организацию со стороны, приглашённый для помощи, усиления чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254e65b4-21bb-4d1b-ae71-5108b409d9ca",
                                                "sense_id": "1eab71b6-f021-3719-b056-d5ef87f4aa63",
                                                "text": "Прошло двадцать лет тех пор, как Болгария пережила своего рода призвание варяга."
                                            },
                                            {
                                                "example_id": "4159a2c8-a63b-4b88-9b42-14a9951e2e2e",
                                                "sense_id": "1eab71b6-f021-3719-b056-d5ef87f4aa63",
                                                "text": "Убедившись, что при полной возможности взять власть в свои руки у них не хватает вождей, солдаты послали за варягами в Новороссийск."
                                            },
                                            {
                                                "example_id": "dfd51732-bff7-4dd9-8238-bedf57661404",
                                                "sense_id": "1eab71b6-f021-3719-b056-d5ef87f4aa63",
                                                "text": "Гораздо существенней и интересней, кто будет печататься в журнале. То есть что там появятся новые лица, варяги ― в этом я не сомневаюсь. А вот как поведут себя старые авторы?"
                                            },
                                            {
                                                "example_id": "7a3379d6-9398-4bef-9df5-ce0cf8f69cc8",
                                                "sense_id": "1eab71b6-f021-3719-b056-d5ef87f4aa63",
                                                "text": "Ответственными за различные направления проекта стали не «варяги», а молодые выдвиженцы из числа прежних сотрудников технического отдела."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad4eee0a-74bc-3060-8d3f-40ed3afb6372",
                                        "entry_id": "f4550646-b25a-3187-b84e-80dec503f15f",
                                        "glosses": [
                                            "устар. коробейник, мелкий торговец вразнос"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
