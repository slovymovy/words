        "fr-extract.jsonl": [
            {
                "entry_id": "411ccf2f-f014-3025-bd7c-2ba2a23c0b2a",
                "word": "compatissance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6ffdfb6-3ca7-40c4-9840-6db649f3cd3b",
                        "entry_id": "411ccf2f-f014-3025-bd7c-2ba2a23c0b2a",
                        "tags": [
                            "plural"
                        ],
                        "form": "compatissances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5f44040-8651-3682-a319-5a391c96e714",
                        "entry_id": "411ccf2f-f014-3025-bd7c-2ba2a23c0b2a",
                        "glosses": [
                            ", qualité de celui qui est compatissant."
                        ],
                        "tags": [
                            "Caractère"
                        ],
                        "examples": [
                            {
                                "example_id": "08890306-8697-40d8-8323-b9d5e367f450",
                                "sense_id": "c5f44040-8651-3682-a319-5a391c96e714",
                                "text": "Cette noble compatissance, cette intuition des difficultés du travail, ce culte du talent est une des plus rares fantaisies qui jamais aient voleté dans des âmes de femme."
                            },
                            {
                                "example_id": "c02d883c-a275-4176-bb52-dfed46092bc6",
                                "sense_id": "c5f44040-8651-3682-a319-5a391c96e714",
                                "text": "La première femme qui m’aperçut, sortit de sa boutique, me donna le bras avec un air de compatissance, et m’aida à me traîner."
                            },
                            {
                                "example_id": "15aae1f0-0f3b-4446-95e1-a3d2efde6b10",
                                "sense_id": "c5f44040-8651-3682-a319-5a391c96e714",
                                "text": "Mais une vieille fille chez qui les sentiments que nourrit la famille n’avaient jamais été réveillés, à qui les besoins de l’enfance, les précautions voulues par l’adolescence étaient inconnus, ne pouvait avoir aucune des indulgences et des compatissances inspirées par les mille événements de la vie ménagère conjugale."
                            },
                            {
                                "example_id": "e0ea5dc6-c30b-41bb-94a6-d1885c9ee1b5",
                                "sense_id": "c5f44040-8651-3682-a319-5a391c96e714",
                                "text": "Cette paternelle, disons mieux, avunculaire, compatissance à l’égard de ses subordonnés aidait M. Duchesne à surmonter son propre et seul problème : sa taille, qui était celle d’un Français moyen de 1876."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79c30680-0e81-40d9-a7e1-156f6278bbe1",
                        "source_entry_id": "411ccf2f-f014-3025-bd7c-2ba2a23c0b2a",
                        "source_sense_id": "c5f44040-8651-3682-a319-5a391c96e714",
                        "target_lang_word": "mededogen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mededogen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                        "entry_id": "24d7a00d-da32-34a6-9daa-ab06835a8302",
                                        "glosses": [
                                            "welwillend medelijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41e6b977-be2a-4a82-b46a-88924038da3a",
                                                "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                                "text": "Hij kreeg geen mededogen van zijn vrienden."
                                            },
                                            {
                                                "example_id": "f2269054-a593-44c2-ae59-37d4e949c4bd",
                                                "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                                "text": "Engeland was ook het probleem niet, er was geen enkele reden voor mededogen met de onmenselijke Engelsen."
                                            },
                                            {
                                                "example_id": "fd97d86f-5ea9-4652-9e2d-3a91b408f136",
                                                "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                                "text": "Koning Willem-Alexander en koningin Máxima zeggen \"diep getroffen\" te zijn door zijn dood. \"Vanuit een rotsvast geloof in Gods liefde pleitte hij voor mededogen en menselijkheid. Sober en eenvoudig levend koos hij steeds de kant van de kwetsbaren en behoeftigen.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
