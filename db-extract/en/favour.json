    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "45982d3a-62d8-3b52-9619-3364fa82692a",
                "word": "favour",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b5fa7fb1-2dc2-41a2-b830-cdd1528c8e4a",
                        "entry_id": "45982d3a-62d8-3b52-9619-3364fa82692a",
                        "tags": [
                            "plural"
                        ],
                        "form": "favours"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db317304-3007-32ab-b7e5-1996ce968fa7",
                        "entry_id": "45982d3a-62d8-3b52-9619-3364fa82692a",
                        "glosses": [
                            "British standard spelling of favor."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ccd88361-835e-4284-a800-3a36838c2b00",
                                "sense_id": "db317304-3007-32ab-b7e5-1996ce968fa7",
                                "text": "Can you do me a favour and drop these letters in the post box?"
                            },
                            {
                                "example_id": "0586b0ca-bb7c-48b9-b2ab-c00a712f6cee",
                                "sense_id": "db317304-3007-32ab-b7e5-1996ce968fa7",
                                "text": "I need a favour. Could you lend me £5 until tomorrow, please?"
                            },
                            {
                                "example_id": "947398e2-cebb-4f29-8bd3-db6d06e0b470",
                                "sense_id": "db317304-3007-32ab-b7e5-1996ce968fa7",
                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5ace0661-342c-305e-8a7e-4519a83642da",
                "word": "favour",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7c428e10-53f0-46da-b49f-060db6a29da4",
                        "entry_id": "5ace0661-342c-305e-8a7e-4519a83642da",
