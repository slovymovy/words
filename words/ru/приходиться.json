                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На каждого участника <w>приходится</w> по два билета."
                        },
                        {
                            "text": "На одного врача <w>приходится</w> слишком много пациентов."
