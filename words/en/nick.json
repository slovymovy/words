                    "sense_definition": "A shortened name or username used to identify a person, especially in online chat or gaming.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can change your <w>nick</w> in the profile settings if you want a new identity.",
                            "target_lang_translations": {
                                "ru": "Вы можете изменить свой <w>ник</w> в настройках профиля, если хотите новую личность.",
                                "zh": "如果你想要一个新的身份，可以在个人资料设置里更改你的<w>昵称</w>。"
                            }
