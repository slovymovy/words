                                        "entry_id": "d21b62e8-853d-39fa-a244-02ac15496701",
                                        "glosses": [
                                            "The removal of hair from the skin in such a way that removes or destroys the root."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
