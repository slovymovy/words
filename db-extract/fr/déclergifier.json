                "senses": [
                    {
                        "sense_id": "b2130599-3dee-3840-bddf-f2a98fcd6f0b",
                        "entry_id": "2d5bdc12-ad0b-3079-9997-6d875aa2a7db",
                        "glosses": [
                            "Ne plus réserver au clergé, ouvrir aux laïcs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b698bd-df6c-40b9-a221-063dacc9a1b4",
                                "sense_id": "b2130599-3dee-3840-bddf-f2a98fcd6f0b",
                                "text": "DÉCLERGIFIER LE SACERDOCE ?"
                            },
                            {
                                "example_id": "be77f8ad-8b36-4047-9d32-9809c5777f22",
                                "sense_id": "b2130599-3dee-3840-bddf-f2a98fcd6f0b",
                                "text": "On y dénonce l'existence d'une caste cléricale et on se propose de « déclergifier » les prêtres en trois étapes : le célibat, le travail et le droit de prendre des options et des engagements politiques."
                            },
                            {
                                "example_id": "0047ccf3-b9a5-4417-b9b3-1673f29e934d",
                                "sense_id": "b2130599-3dee-3840-bddf-f2a98fcd6f0b",
                                "text": "Il me paraissait nécessaire au premier chef de « déclergifier » pour retrouver un sens plus profond du sacerdoce du Christ."
                            }
                        ]
                    }
