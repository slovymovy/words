                                        "glosses": [
                                            "zodanig, dit soort: bij ontelbare begrippen en meervouden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44959458-8500-4e8c-b97c-4596df2d7349",
                                                "sense_id": "17e0f6ad-8623-3413-8533-5f372040dc56",
                                                "text": "Zulk weer kan alleen maar het gevolg van het broeikaseffect zijn."
                                            },
                                            {
                                                "example_id": "2561d03e-135c-4a51-9236-9aceb0ed393d",
                                                "sense_id": "17e0f6ad-8623-3413-8533-5f372040dc56",
                                                "text": "Zulke taal kun je beter niet in zijn bijzijn gebruiken."
                                            },
                                            {
                                                "example_id": "193c5725-4400-48fa-8e0b-2b09b2af4d3e",
                                                "sense_id": "17e0f6ad-8623-3413-8533-5f372040dc56",
                                                "text": "Zulke wegen zijn erg moeilijk te onderhouden."
                                            },
                                            {
                                                "example_id": "deb120f1-abdf-46fe-a38f-4eb1b58af398",
                                                "sense_id": "17e0f6ad-8623-3413-8533-5f372040dc56",
                                                "text": "Zelden had ik in zulk ijzig water gezwommen, 1.1 °C om precies te zijn, en ik was er al snel weer uit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fb8aae9-f4b2-32bf-b6ff-d69dc11b57d1",
                                        "entry_id": "b17fe0a9-14fd-345f-8b77-fd8012921444",
                                        "glosses": [
                                            "~ een bij telbare enkelvouden: zodanige."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37296dd5-7cc6-48ba-a9a3-2f0208348c2e",
                                                "sense_id": "0fb8aae9-f4b2-32bf-b6ff-d69dc11b57d1",
                                                "text": "Zulk een man hebben we nodig."
                                            },
                                            {
                                                "example_id": "0e9c1f5d-8b7f-449d-befd-d8b5ed9c9f58",
                                                "sense_id": "0fb8aae9-f4b2-32bf-b6ff-d69dc11b57d1",
                                                "text": "De abt vond het spotternij om die heilige ruimte te vullen met gezang voor zulk een wereldse geestelijke."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zulk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f561acd3-50ce-3616-adfc-9f8b22a93953",
                                        "entry_id": "b9284d5f-2f86-3a27-86c6-61e31b645ef1",
                                        "glosses": [
                                            "wat een"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
