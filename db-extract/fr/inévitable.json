                                        "entry_id": "e306110a-acd1-3df7-b538-6f1e1f5db896",
                                        "glosses": [
                                            "so, dass es nicht zu vermeiden, nicht zu verhindern, nicht abzuwenden ist, es mit Sicherheit passieren, eintreten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e516990-0a7b-4156-aa22-ffbbf08a426a",
                                                "sense_id": "3daea808-f86c-3d17-bbf1-1fa082d9c7b0",
                                                "text": "„Sollte Griechenland seinen Sparkurs aufgeben, sei es nach Ansicht der Bundesregierung unausweichlich, dass Griechenland die Euro-Zone verlassen müsse.“"
                                            },
                                            {
                                                "example_id": "fdcac4ef-7ad7-4ad3-84af-31c741a8daa6",
                                                "sense_id": "3daea808-f86c-3d17-bbf1-1fa082d9c7b0",
                                                "text": "Das unausweichliche Schicksal nahm seinen Lauf."
                                            }
                                        ],
