                        "sense_id": "78c1a10e-0600-3d8f-bb2f-f6bc4ebf782f",
                        "entry_id": "50fa6fc0-c374-36a1-93d6-271d92304842",
                        "glosses": [
                            "Zimmer, in dem Personen beruflich arbeiten"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "34d37777-5aa5-499d-9cfa-7c892853df7c",
                                "sense_id": "78c1a10e-0600-3d8f-bb2f-f6bc4ebf782f",
                                "text": "„Insgesamt durchsuchten die Beamten mit Hilfe von Spezialkräften 16 Wohnungen und Geschäftsräume im Raum Hamburg, ein Objekt in Bremen, eins im niedersächsischen Sittensen und drei in der Altmark.“"
                            },
                            {
                                "example_id": "7ca9d289-547d-4cfb-936d-a5a1f8ba6988",
                                "sense_id": "78c1a10e-0600-3d8f-bb2f-f6bc4ebf782f",
                                "text": "„Damit würde er morgen um acht Uhr den Geschäftsraum von Singer-Nähmaschinen aufschließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
