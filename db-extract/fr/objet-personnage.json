                        "sense_id": "140bc9ad-04c3-3600-92ea-e27ad61fa71b",
                        "entry_id": "6c7b43e8-4185-34fd-8627-3aa2c23899ff",
                        "glosses": [
                            "Objet qui représente un personnage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fa3894f-22ad-43fa-aee4-596d92f00d2f",
                                "sense_id": "140bc9ad-04c3-3600-92ea-e27ad61fa71b",
                                "text": "Aux côtés de l’objet-personnage, anthropomorphe ou zoomorphe, animé au moyen de fils, de tiges, de tringles ou en prise directe, on trouve également toutes sortes de formes abstraites, d’objets manufacturés, de matières brutes, d’ombres ou encore de créations vidéo ou numériques."
                            },
                            {
                                "example_id": "3950320b-d8a9-4cff-8e80-2b3ef6a2c0d3",
                                "sense_id": "140bc9ad-04c3-3600-92ea-e27ad61fa71b",
                                "text": "Tu le pousses derrière le mur que forment deux objets-personnages — ceux contre lesquels tu étais appuyée quand tu attendais indéfiniment l’arrivée de quelqu’un."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cd82bae-27a7-3af6-8c4f-eefe5a8cea01",
                        "entry_id": "6c7b43e8-4185-34fd-8627-3aa2c23899ff",
                        "glosses": [
                            "Objet tellement important dans un récit qu’on peut le considérer comme un des personnages de ce récit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e877a37-d3a1-4d57-82b5-7cce44e61aa9",
                                "sense_id": "9cd82bae-27a7-3af6-8c4f-eefe5a8cea01",
                                "text": "Un des plus célèbres objets-personnages de la littérature est certainement le tableau du portrait de Dorian Gray mis en scène dans « Le Portrait de Dorian Gray » écrit par notre ami Oscar Wilde."
                            }
                        ]
                    }
