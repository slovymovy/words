                        "form": "riflemen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f4ecd2c-f12d-33ab-ada6-e56a47858a17",
                        "entry_id": "ba7029c1-deea-36c2-bbf9-e59a3943f05e",
                        "glosses": [
                            "A soldier trained to use a rifle as a primary weapon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90f08888-af86-46e3-bbfb-209b8a761633",
                                "sense_id": "6f4ecd2c-f12d-33ab-ada6-e56a47858a17",
                                "text": "The riflemen had not been issued their weapons yet, and hence they trained with wooden mock-up rifles."
                            },
                            {
                                "example_id": "371da285-c47c-42b8-a8be-69bc17412158",
                                "sense_id": "6f4ecd2c-f12d-33ab-ada6-e56a47858a17",
                                "text": "Anil Gurung joined the Army in 2006 as a rifleman with the 2nd Royal Gurkha Regiment."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b58c29b-2ba5-3e78-8789-d262b754dd14",
                        "entry_id": "ba7029c1-deea-36c2-bbf9-e59a3943f05e",
                        "glosses": [
                            "A person especially skilled in the use of a rifle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9eb966-4cb5-4636-81c8-fbcbf58fb58b",
                                "sense_id": "6b58c29b-2ba5-3e78-8789-d262b754dd14",
                                "text": "She was quite the rifleman and could pick off a squirrels with a .22 from across the field with amazing accuracy."
                            }
                        ]
                    },
                    {
                        "sense_id": "c109d109-4c07-305d-8f2e-5bbaffd8c9e4",
                        "entry_id": "ba7029c1-deea-36c2-bbf9-e59a3943f05e",
                        "glosses": [
                            "A small wrenlike insectivorous passerine bird endemic to New Zealand, Acanthisitta chloris, the titipounamu."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b83fae12-a492-4487-8b47-8158a0e8726f",
                        "source_entry_id": "ba7029c1-deea-36c2-bbf9-e59a3943f05e",
