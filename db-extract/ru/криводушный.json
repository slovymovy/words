                        "glosses": [
                            "устар. неискренний, лживый, поступающий против совести"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cefc77f9-804a-4dbc-b31e-045dccd2208a",
                                "sense_id": "1fcb6abf-489d-309f-a3bd-43861c72f5cc",
                                "text": "Дед не велит судиям лихоимствовать: внук определяет тяжкую денежную пеню за их лихоимство и неправосудие умышленное, оставляя только неумышленное без наказания: криводушных дьяков сажали в темницу, подьячих секли кнутом."
                            }
                        ]
                    }
