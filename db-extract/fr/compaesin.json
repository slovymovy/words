                    {
                        "sense_id": "a39e319c-6864-3401-8f7e-c7c4004513a9",
                        "entry_id": "78951eb0-4d80-301d-9568-6fb5da8971f8",
                        "glosses": [
                            "Citoyen de la même ville qu’un autre et, par extension, de la même région, de la même nation."
                        ],
                        "tags": [
                            "Vallée d’Aoste"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32189c8d-6e18-4bb2-a03e-8542166e56b0",
                        "source_entry_id": "78951eb0-4d80-301d-9568-6fb5da8971f8",
                        "source_sense_id": "a39e319c-6864-3401-8f7e-c7c4004513a9",
                        "target_lang_word": "citizen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citizen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da345249-1dd6-3114-9f19-497b24828b49",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A resident of a city or town, especially one with legally recognized rights or duties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d13012-078e-479c-9000-66ca7c0fcdad",
                                                "sense_id": "da345249-1dd6-3114-9f19-497b24828b49",
                                                "text": "[T]hat large body of the working men who were not counted as citizens and had not so much as a vote to serve as an anodyne to their stomachs were likely to get impatient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A legally recognized member of a state, with associated rights and obligations; a person considered in terms of this role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb44d00e-cc7f-4195-b9c0-eb8a20dd1cfe",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "I am a Roman citizen."
                                            },
                                            {
                                                "example_id": "ada4b222-0dd6-4f0e-8e09-3086b4b59b98",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "Assistant: You'll meet with the managing director and Dr Sinita Brahmachari, the engineer who designed the chair.\nPeter Mackenzie: Indian, is he?\nAssistant: She is a British citizen, Minister. Born in Coventry."
                                            },
                                            {
                                                "example_id": "20e989f2-1d1d-40e8-8d7c-aee57d9f43c9",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "Libertarian paternalism is the view that, because the way options are presented to citizens affects what they choose, society should present options in a way that “nudges” our intuitive selves to make choices that are more consistent with what our more deliberative selves would have chosen if they were in control."
                                            },
                                            {
                                                "example_id": "a8faac22-f95c-4c36-9297-17a0ee3cae2b",
                                                "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                                                "text": "He is also a citizen of Antigua, because he purchased a home – where he now resides with his family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a51ccc71-2fd5-3085-800f-e01af95005cd",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "An inhabitant or occupant: a member of any place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fdafd5d-ba2c-48a1-accd-6a006de13e03",
                                                "sense_id": "a51ccc71-2fd5-3085-800f-e01af95005cd",
                                                "text": "Diogenes reckoned himself a citizen of the world."
                                            },
                                            {
                                                "example_id": "3d96c168-5fa4-4c8b-933f-f895b775fd95",
                                                "sense_id": "a51ccc71-2fd5-3085-800f-e01af95005cd",
                                                "text": "A jellyfish... carries poison cells that can sting other citizens of the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf5c5c64-3ca2-3add-bdfd-adb3a4e359d8",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A resident of the heavenly city or (later) of the kingdom of God: a Christian; a good Christian."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad3b978a-95d4-34a7-b748-2c7e56352fd4",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A civilian, as opposed to a police officer, soldier, or member of some other specialized (usually state) group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eb707cd-5377-36d0-9a2a-c7d455f6a489",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "An ordinary person, as opposed to nobles and landed gentry on one side and peasants, craftsmen, and laborers on the other."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0162a3-fc2b-44f1-a36b-11a6676b669f",
                                                "sense_id": "6eb707cd-5377-36d0-9a2a-c7d455f6a489",
                                                "text": "[W]ould Mr. Delvile, who hardly ever spoke but to the high-born, without seeming to think his dignity somewhat injured, deign to receive for a daughter in law the child of a citizen and tradesman?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2436c10e-c0f9-3f80-9e66-8649890e4d87",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A term of address among supporters of the French Revolution in France or elsewhere; (later, dated) a term of address among socialists and communists."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "historical",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b38505-a36c-47b2-ad0e-8a672d303113",
                                                "sense_id": "2436c10e-c0f9-3f80-9e66-8649890e4d87",
                                                "text": "Citizen, I desire nothing more than to get to Paris, though I could dispense with the escort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05426ce7-2511-35b4-90ae-898f4de551d1",
                                        "entry_id": "f41840ac-1b02-32db-81a8-4af5b14cfdb7",
                                        "glosses": [
                                            "A notional inhabitant of a software system; an object or a software application."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ff3b5fe-d30b-4384-be71-be75784d5249",
                                                "sense_id": "05426ce7-2511-35b4-90ae-898f4de551d1",
                                                "text": "The HIG delivers Apple's design commandments, the company's definition of what it means to be a good iPhone citizen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
