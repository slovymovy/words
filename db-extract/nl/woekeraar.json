                                    },
                                    {
                                        "sense_id": "3080808c-00a9-3a63-88c1-cc7a12c3e7fa",
                                        "entry_id": "19555969-bfb6-3d35-85fa-8a95fb2aa484",
                                        "glosses": [
                                            "Persona que en cualquier negocio obtiene ganancias o beneficios desproporcionados."
                                        ],
                                        "tags": [],
                                        "examples": [
