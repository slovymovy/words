                ],
                "senses": [
                    {
                        "sense_id": "58fd9de1-11d5-3a63-89ac-bd280e032ad1",
                        "entry_id": "c2c23403-ef39-3e36-8320-14474a9489e8",
                        "glosses": [
                            "Sortir du néant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0dd572f-8139-40df-938b-6f038d08d3d7",
                                "sense_id": "58fd9de1-11d5-3a63-89ac-bd280e032ad1",
                                "text": "Le matin où (après une régression très étudiée, toute en nuances, du fluide cloétique) je fus désanéanti, j’éprouvai un agrément indéfinissable."
                            },
                            {
                                "example_id": "76afd009-3598-4399-9109-ef99b6973616",
                                "sense_id": "58fd9de1-11d5-3a63-89ac-bd280e032ad1",
                                "text": "Parler ou écrire était une façon de mettre le corps et l’esprit en mouvement face à une énigme fondamentale : comment se désanéantir ?"
                            },
                            {
                                "example_id": "9f4e099f-6cfc-4901-8ceb-5c6b1d914429",
                                "sense_id": "58fd9de1-11d5-3a63-89ac-bd280e032ad1",
                                "text": "Bon c’est possible on sait jamais mais faut qu’il soit vachement fort pour se désanéantir…"
                            }
                        ]
                    }
                ],
