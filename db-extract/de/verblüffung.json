                "senses": [
                    {
                        "sense_id": "f750ce8d-a42e-3bef-a8fc-605b3964ee21",
                        "entry_id": "5380c92d-6b50-3d29-86bc-b80f62edefa9",
                        "glosses": [
                            "Stupéfaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02687e0-851a-4fdd-9cbb-dd1b85ab8713",
                                "sense_id": "f750ce8d-a42e-3bef-a8fc-605b3964ee21",
                                "text": "Die Hongkonger reagierten mit einer Mischung aus Verblüffung und Belustigung auf den Vorfall.",
                                "translation": "Les Hongkongais ont réagi à cet incident avec un mélange de stupéfaction et d'amusement."
                            },
                            {
                                "example_id": "84cde115-77d5-4263-81d9-366e65aee28a",
                                "sense_id": "f750ce8d-a42e-3bef-a8fc-605b3964ee21",
                                "text": "Der allgemeinen Verblüffung, die er damit hervorrufen würde, bewusst und um die Diskussion ein bisschen anzuheizen, bezeichnete er Jesus Christus und Mohammed als Schwindler. Sich selber sah er als direkten Nachfolger Mose.",
                                "translation": "Conscient de l’ébahissement général il en profita pour élever le débat, dénonçant les imposteurs qu'avaient été Jésus-Christ et Mahomet ; il se réclamait par contre de Moïse."
                            }
                        ]
                    }
                ],
