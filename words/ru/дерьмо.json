                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Смотри под ноги, чтобы случайно не наступить в собачье <w>дерьмо</w>.",
                            "target_lang_translations": {
                                "en": "Watch your step so you don't accidentally step in dog <w>shit</w>.",
                                "de": "Pass auf, wo du hintrittst, damit du nicht versehentlich in die <w>Scheiße</w> von einem Hund trittst."
                            }
                        },
                        {
                            "text": "В хлеву сильно пахло <w>дерьмом</w> и прелым сеном.",
                            "target_lang_translations": {
                                "en": "The barn smelled strongly of <w>shit</w> and rotting hay.",
                                "de": "Im Stall roch es stark nach <w>Scheiße</w> und verrottetem Heu."
