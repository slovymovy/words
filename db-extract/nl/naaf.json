                                    {
                                        "sense_id": "c2060c53-16d4-363d-b066-1e027d74bec0",
                                        "entry_id": "2afe06c4-e560-329d-9aee-b94006e0fcc6",
                                        "glosses": [
                                            "The middle or body of a church, extending from the transepts to the principal entrances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d05a95fb-f446-4194-8189-af1e60eab018",
                                                "sense_id": "c2060c53-16d4-363d-b066-1e027d74bec0",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c8142f1-2b19-3e83-affa-a5df015e3dd7",
                                        "entry_id": "2afe06c4-e560-329d-9aee-b94006e0fcc6",
                                        "glosses": [
                                            "The ground-level middle cavity of a barn."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f43a2dd8-5ce5-33d5-8693-507c87cb1cd6",
                                        "entry_id": "935b1cdd-dfdf-385d-9e1d-dfdac9c19922",
                                        "glosses": [
                                            "A hub of a wheel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22570d32-7dc6-49c4-8d36-2348a1f194d7",
                                                "sense_id": "f43a2dd8-5ce5-33d5-8693-507c87cb1cd6",
                                                "text": "'Out, out, thou strumpet Fortune! All you gods,\nIn general synod take away her power;\nBreak all the spokes and fellies from her wheel,\nAnd bowl the round nave down the hill of heaven[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c43983e2-fe3f-3518-82d8-694e8a015746",
                                        "entry_id": "935b1cdd-dfdf-385d-9e1d-dfdac9c19922",
                                        "glosses": [
                                            "The navel."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa3b706-6996-4c63-a160-5f24804e2819",
                                                "sense_id": "c43983e2-fe3f-3518-82d8-694e8a015746",
                                                "text": "Till he faced the slave; / Which ne'er shook hands, nor bade farewell to him, / Till he unseam'd him from the nave to the chaps, / And fix'd his head upon our battlements"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87b76fc6-1692-4dc7-a9a8-4d89242af94f",
                        "source_entry_id": "475eb6aa-8035-3ed3-974a-4f1e79ebd86f",
