{
    "word_family": [
        "verdomd",
        "verdomme",
        "verdomming"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28ae3015-f331-32d9-b14e-3063d2a38d92",
                    "sense_definition": "iets beslist weigeren te doen, vaak ondanks druk of verplichting",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weigeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>verdom</w> het om daaraan mee te werken.",
                            "target_lang_translations": {
                                "en": "I'll be <w>damned</w> if I'll cooperate with that."
                            }
                        },
                        {
                            "text": "Hij <w>verdomde</w> het om zijn excuses aan te bieden na die ruzie.",
                            "target_lang_translations": {
                                "en": "He flatly <w>refused</w> to apologize after that argument."
                            }
                        }
                    ],
                    "synonyms": [
                        "verrekken",
                        "vertikken"
                    ],
                    "common_phrases": [
                        "het verdommen om"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en krachtig uitgedrukt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To flatly refuse to do something, often despite pressure or obligation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "refuse",
                                "target_lang_sense_clarification": "to flatly decline"
                            },
                            {
                                "target_lang_word": "be damned if",
                                "target_lang_sense_clarification": "informal, strong refusal"
                            },
                            {
                                "target_lang_word": "refuse point-blank",
                                "target_lang_sense_clarification": "to refuse decisively"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb387ea8-ba9d-3f70-826d-11926a442e69",
                    "sense_definition": "iemand of iets vervloeken of verdoemen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervloeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In zijn woede begon hij de hele wereld te <w>verdommen</w>.",
                            "target_lang_translations": {
                                "en": "In his anger, he began to <w>damn</w> the whole world."
                            }
                        },
                        {
                            "text": "Je moet niet zo staan te <w>verdommen</w> op alles wat misgaat.",
                            "target_lang_translations": {
                                "en": "You shouldn't stand there <w>cursing</w> everything that goes wrong."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdoemen",
                        "vervloeken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt als krachtterm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To curse or damn someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "damn",
                                "target_lang_sense_clarification": "to curse"
                            },
                            {
                                "target_lang_word": "curse",
                                "target_lang_sense_clarification": "to express anger towards"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d743e71-b44b-3ecb-a469-55e5c00c6f99",
                    "sense_definition": "dommer maken of dommer worden",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "domheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sommige mensen beweren dat te veel televisie kijken de jeugd zal <w>verdommen</w>.",
                            "target_lang_translations": {
                                "en": "Some people claim that watching too much television will <w>dumb down</w> the youth."
                            }
                        },
                        {
                            "text": "Door het eentonige werk voelde hij zichzelf langzaam <w>verdommen</w>.",
                            "target_lang_translations": {
                                "en": "Because of the monotonous work, he felt himself slowly <w>becoming stupider</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make or become more stupid or dull-witted."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dumb down",
                                "target_lang_sense_clarification": "to make less intellectually demanding"
                            },
                            {
                                "target_lang_word": "stupefy",
                                "target_lang_sense_clarification": "to make someone unable to think clearly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}