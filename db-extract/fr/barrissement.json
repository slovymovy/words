                ],
                "senses": [
                    {
                        "sense_id": "8f18b50d-73c0-38f1-b780-171fa7e0da46",
                        "entry_id": "b83eaccb-ec6c-30d5-8206-ea7203e77e63",
                        "glosses": [
                            "Cri de l’éléphant ou du rhinocéros."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d510d85d-692d-4212-aed6-c5e24b86e19b",
                                "sense_id": "8f18b50d-73c0-38f1-b780-171fa7e0da46",
                                "text": "Nous avons pu entendre comme des barrissements, sans toutefois voir d’éléphant."
                            },
                            {
                                "example_id": "691c39a1-eea0-46bd-91d5-79c2afe9b913",
                                "sense_id": "8f18b50d-73c0-38f1-b780-171fa7e0da46",
                                "text": "Les petits prirent peur. Alors la trompe du vieil éléphant se redressa, se recourba et un barrissement plus sonore, plus aigu, plus effrayant que l’éclat de cent trompettes de guerre retentit dans la sérénité de la brousse."
                            },
                            {
                                "example_id": "e9e0d111-4a3c-4d7d-a897-5d4e01bd142a",
                                "sense_id": "8f18b50d-73c0-38f1-b780-171fa7e0da46",
                                "text": "Les éléphants sont réputés pour avoir une mémoire prodigieuse : ils reconnaissent le barrissement de plus de 100 de leurs congénères, auxquels ils répondent."
                            }
                        ]
                    },
                    {
                        "sense_id": "e89ea766-ed44-385c-b250-f32625332d09",
                        "entry_id": "b83eaccb-ec6c-30d5-8206-ea7203e77e63",
                        "glosses": [
                            "En parlant de l’éléphant ou du rhinocéros : action de pousser son cri (barrir)."
                        ],
                        "tags": [],
                        "examples": []
                    }
