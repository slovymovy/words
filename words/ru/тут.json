                {
                    "sense_id": "e5aa081f-8014-3a48-92e4-b61db5e76d89",
                    "sense_definition": "В этот момент; в это время.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "И <w>тут</w> мы увидели море.",
                            "target_lang_translations": {
                                "en": "And <w>then</w> we saw the sea.",
                                "zh": "就在<w>当时</w>，我们看见了大海。",
                                "nl": "En <w>toen</w> zagen we de zee.",
                                "pl": "I <w>wtedy</w> zobaczyliśmy morze.",
                                "de": "Und <w>da</w> sahen wir das Meer.",
                                "fr": "Et <w>alors</w> nous avons vu la mer.",
                                "it": "E <w>allora</w> abbiamo visto il mare.",
                                "cs": "A <w>tu</w> jsme uviděli moře.",
                                "tr": "Ve <w>o anda</w> denizi gördük.",
                                "es": "Y <w>entonces</w> vimos el mar."
                            }
                        },
                        {
                            "text": "Он <w>тут</w> же согласился помочь нам.",
                            "target_lang_translations": {
                                "en": "He <w>immediately</w> agreed to help us.",
                                "zh": "他<w>随即</w>答应了帮助我们。",
                                "nl": "Hij stemde er <w>meteen</w> mee in om ons te helpen.",
                                "pl": "On <w>natychmiast</w> zgodził się nam pomóc.",
                                "de": "Er stimmte <w>sofort</w> zu, uns zu helfen.",
                                "fr": "Il a <w>immédiatement</w> accepté de nous aider.",
                                "it": "Lui ha accettato <w>immediatamente</w> di aiutarci.",
                                "cs": "On <w>ihned</w> souhlasil, že nám pomůže.",
                                "tr": "Bize yardım etmeyi <w>hemen</w> kabul etti.",
                                "es": "Él <w>inmediatamente</w> aceptó ayudarnos."
                            }
                        }
                    ],
