                "senses": [
                    {
                        "sense_id": "15f8da93-f0c9-3249-9b5e-863f1e782851",
                        "entry_id": "e1881668-fa14-3553-977d-6ac3fa13f912",
                        "glosses": [
                            "Orthographe ancienne, en particulier utilisée pendant la période coloniale, de Mỹ Tho, ville du sud du Viêt Nam."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df61a61-3273-4af6-8480-81e2d2ebc499",
                                "sense_id": "15f8da93-f0c9-3249-9b5e-863f1e782851",
                                "text": "Mais ici, à Mytho, Chaudoc et Long Xuyen sont loin."
                            }
                        ]
                    }
                ],
