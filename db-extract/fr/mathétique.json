                        "tags": [],
                        "examples": [
                            {
                                "example_id": "289771cd-7d86-4239-8665-cc6f197966e6",
                                "sense_id": "d53a3f20-6c0b-394f-a52c-ffb28c810c54",
                                "text": "Pour faire simple, à la pédagogie qui serait l’art d’enseigner, la mathétique serait l’art d’apprendre."
                            },
                            {
                                "example_id": "601d056b-c0bd-4a9e-9b8f-e7bb5a10f677",
                                "sense_id": "d53a3f20-6c0b-394f-a52c-ffb28c810c54",
                                "text": "Comment devient-on un expert en construction de savoir ? Quelles sont les techniques requises ? Sont-elles identiques pour tous les types de connaissance ? Le terme de mathétique donne à ce genre de question une certaine légitimité."
                            }
                        ]
