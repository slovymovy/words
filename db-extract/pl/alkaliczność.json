                                        "glosses": [
                                            "État ou caractère d'une substance qui possède les propriétés des alcalis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fda0e5b-85c3-4d51-99c8-1bd0dde5c6d1",
                                                "sense_id": "57057c6f-03f5-358f-b26d-e41a880bf76c",
                                                "text": "Cette méthode se résume essentiellement en une potentiométrie ponctuelle où un seul point de la courbe de dosage est noté et utilisé pour le calcul de l'alcalinité."
                                            }
                                        ]
