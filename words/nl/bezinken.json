{
    "word_family": [
        "bezinking",
        "bezonkenheid",
        "zinken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a45d93c7-4ae5-33bf-82e7-1ffa05ace441",
                    "sense_definition": "Geleidelijk inwerken op de gedachten, zodat men tot een rustig en helder oordeel kan komen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mentaal_proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet dit slechte nieuws eerst even laten <w>bezinken</w> voordat je een beslissing neemt.",
                            "target_lang_translations": {
                                "en": "You need to let this bad news <w>sink in</w> first before you make a decision."
                            }
                        },
                        {
                            "text": "Na een drukke dag vol emoties liet hij alle indrukken rustig <w>bezinken</w>.",
                            "target_lang_translations": {
                                "en": "After a busy day full of emotions, he quietly let all the impressions <w>settle</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwerken",
                        "indalen"
                    ],
                    "common_phrases": [
                        "laten bezinken",
                        "alles laten bezinken"
                    ],
                    "target_lang_definitions": {
                        "en": "To gradually sink in or be processed in one's mind, allowing one to reach a calm and clear judgment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sink in",
                                "target_lang_sense_clarification": "of information, news, or ideas"
                            },
                            {
                                "target_lang_word": "settle",
                                "target_lang_sense_clarification": "of thoughts or emotions"
                            },
                            {
                                "target_lang_word": "digest",
                                "target_lang_sense_clarification": "to mentally process information"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "652e34e9-f6e2-32cb-89b1-4e7ee0fd1b18",
                    "sense_definition": "Het langzaam naar de bodem zakken van vaste deeltjes die in een vloeistof zweven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysisch_proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je het troebele water een tijdje laat staan, zal het vuil vanzelf naar de bodem <w>bezinken</w>.",
                            "target_lang_translations": {
                                "en": "If you leave the cloudy water for a while, the dirt will <w>settle</w> to the bottom on its own."
                            }
                        },
                        {
                            "text": "In deze put van driehonderd meter breed zou het zand eerst <w>bezinken</w>.",
                            "target_lang_translations": {
                                "en": "In this three-hundred-meter-wide pit, the sand would first <w>settle</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "neerslaan",
                        "bezakken"
                    ],
                    "common_phrases": [
                        "naar de bodem bezinken"
                    ],
                    "target_lang_definitions": {
                        "en": "The slow sinking to the bottom of solid particles suspended in a liquid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "settle",
                                "target_lang_sense_clarification": "of particles in a liquid"
                            },
                            {
                                "target_lang_word": "precipitate",
                                "target_lang_sense_clarification": "chemical process of forming sediment"
                            },
                            {
                                "target_lang_word": "subside",
                                "target_lang_sense_clarification": "of suspended matter"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}