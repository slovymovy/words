                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b43e49-c4b1-4503-8ec0-3eb8d4980ae9",
                                                "sense_id": "43cc4f2d-7e25-33a6-9e8c-02a9d07dcc29",
                                                "text": "Udělalo se mi šoufl, hodil jsem šavli."
                                            }
