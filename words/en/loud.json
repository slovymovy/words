                    "target_lang_definitions": {
                        "ru": "Шумно; с высокой громкостью.",
                        "tr": "Çok gürültü yapacak şekilde; yüksek sesle.",
                        "zh": "以发出很大噪音的方式；以高音量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громко",
                                "target_lang_sense_clarification": "наречие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yüksek sesle",
                                "target_lang_sense_clarification": "zarf olarak"
                            },
                            {
                                "target_lang_word": "sesli",
                                "target_lang_sense_clarification": "konuşmak/gülmek için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大声地",
                                "target_lang_sense_clarification": "副词"
                            },
                            {
                                "target_lang_word": "响亮地",
                                "target_lang_sense_clarification": "副词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "721a1134-55e9-3988-96f2-3ef032892865",
                    "sense_definition": "A sound or part of a sound that has high volume.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audio engineer adjusted the mix to balance the <w>louds</w> and the softs.",
                            "target_lang_translations": {
                                "ru": "Звукорежиссер настроил микс, чтобы сбалансировать <w>громкие звуки</w> и тихие.",
                                "tr": "Ses mühendisi, <w>yüksek sesler</w> ile alçak sesleri dengelemek için miksi ayarladı.",
                                "zh": "音响工程师调整了混音，以平衡<w>高音</w>和低音。"
                            }
                        },
                        {
                            "text": "The recording captured all the sudden <w>louds</w> of the fireworks.",
                            "target_lang_translations": {
                                "ru": "Запись запечатлела все внезапные <w>громкие звуки</w> фейерверка.",
                                "tr": "Kayıt, havai fişeklerin tüm ani <w>yüksek seslerini</w> yakaladı.",
                                "zh": "录音捕捉到了烟花所有突然的<w>巨响</w>。"
                            }
                        }
