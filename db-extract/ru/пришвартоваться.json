                "senses": [
                    {
                        "sense_id": "9d0ab1a1-a171-360f-8869-5ef176561a4e",
                        "entry_id": "eb4265a2-8415-3f71-85c2-37b5f586ae83",
                        "glosses": [
                            "морск., авиац. прикрепиться к чему-либо швартовами (о судах и воздухоплавательных аппаратах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "846031a0-c84c-40d7-97ae-15d05d99560e",
                                "sense_id": "9d0ab1a1-a171-360f-8869-5ef176561a4e",
                                "text": "Сидя на бонах, Тарашкин видел, как пришвартовалась и затем ушла двухвёсельная лодка."
                            },
                            {
                                "example_id": "3896ef57-4dd0-47e5-ac02-cef9084ed6ea",
                                "sense_id": "9d0ab1a1-a171-360f-8869-5ef176561a4e",
                                "text": "Вот через пол часика пришвартуемся, тогда и ловите своего политического."
                            }
                        ]
                    }
