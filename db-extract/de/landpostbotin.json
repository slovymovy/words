                ],
                "senses": [
                    {
                        "sense_id": "288617e7-3747-39da-91d0-cf161fa61122",
                        "entry_id": "c2c6bd75-4d39-3957-a421-dea7faeab9ba",
                        "glosses": [
                            "Zustellerin von Postsendungen, die in ländlichen Gebieten tätig ist"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f5f8d3db-46cd-4b28-aba1-c6222b43b35c",
                                "sense_id": "288617e7-3747-39da-91d0-cf161fa61122",
                                "text": "„Die alten Schwalben galten damals als Vehikel von Landpostbotinnen oder Rentnern […].“ (Anmerkung: Schwalben: Kleinroller Simson Schwalbe ^(→ WP))"
                            },
                            {
                                "example_id": "8f86582f-19a8-4d5b-b48d-8ec67928a52e",
                                "sense_id": "288617e7-3747-39da-91d0-cf161fa61122",
                                "text": "„›Vierhundert Mark beziehungsweise zwanzig Zigaretten für einen alten Muff, […] Eindeutig zuviel für eine kleine Landpostbotin wie mich.‹“"
                            },
                            {
                                "example_id": "ada0366b-7b54-4eb8-9035-01181c1aee90",
                                "sense_id": "288617e7-3747-39da-91d0-cf161fa61122",
                                "text": "„Und seit einem Jahr ist sie als Landpostbotin unterwegs. Halb elf. Es geht kreuz und quer durch Ebnat.“"
                            },
                            {
                                "example_id": "da61ebee-10cc-42f8-8485-3f61f7e9ab01",
                                "sense_id": "288617e7-3747-39da-91d0-cf161fa61122",
                                "text": "„Sie erinnert sich, während sie auch über ihre Aufgabe als Landpostbotin und die schwierigen Bedingungen, die weit auseinanderliegenden Höfe zu erreichen, nachdenkt, an ihre Anfänge als Schauspielerin und die Realität als quasi allein- verantwortliche Mutter […]“"
                            },
                            {
                                "example_id": "dd29fc79-6fe5-4654-869f-946e18a56c14",
                                "sense_id": "288617e7-3747-39da-91d0-cf161fa61122",
                                "text": "„Als Schriftsteller, der mit Ihrer Behörde täglichen Kontakt hat, habe ich vielfältigen Anlaß zur Bewunderung gefunden für die Arbeit einer Landpostbotin, die seit mehr als einem Vierteljahrhundert ihren Dienst vorsieht.“"
                            },
                            {
                                "example_id": "27556ba7-8fee-478d-8b5a-124cc0fdf155",
                                "sense_id": "288617e7-3747-39da-91d0-cf161fa61122",
                                "text": "(1869:) „Kleinfüßen, Postamt: Himpel, Postamtsvorstand, […] / 1 Postpraktikant / 1 Unterbediensteter, 1 Landpostbotin, 1 Landpostbote […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
