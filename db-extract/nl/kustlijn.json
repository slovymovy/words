                ],
                "senses": [
                    {
                        "sense_id": "ad326afd-500f-3bfa-a61b-f50b4a98a5fd",
                        "entry_id": "a7d8f9b1-70c5-3eff-bb69-e61aee3aefd1",
                        "glosses": [
                            "grens tussen land en zee, wijze waarop de kust gevormd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26fd49e8-b5fb-4bb1-9cb5-9d653ec84316",
                                "sense_id": "ad326afd-500f-3bfa-a61b-f50b4a98a5fd",
                                "text": "Wie de kustlijn van al die 267.750 Zweedse eilanden afloopt, moet in totaal 67.000 kilometer afleggen."
                            },
                            {
                                "example_id": "872c715d-3b77-44da-95b6-9232ef8e3336",
                                "sense_id": "ad326afd-500f-3bfa-a61b-f50b4a98a5fd",
                                "text": "Koraalriffen zijn van levensbelang voor het leven in de oceanen en daardoor ook voor de mensheid. 25 procent van het zeeleven leeft in en rond koraalriffen. Ze zijn van belang voor de visserij, toerisme en bescherming van kustlijnen tegen erosie en stormen. Het is nog onduidelijk of en wanneer het huidige proces van verbleking stopt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f48d271-2205-452a-b325-392dde4dd0ca",
                        "source_entry_id": "a7d8f9b1-70c5-3eff-bb69-e61aee3aefd1",
                        "source_sense_id": "ad326afd-500f-3bfa-a61b-f50b4a98a5fd",
                        "source_sense_description": "grens tussen land en zee, wijze waarop de kust gevormd is",
                        "target_lang_word": "Küste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Küste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                        "entry_id": "8cbdf2fb-d0ac-37d0-b569-f48acfe260f6",
                                        "glosses": [
                                            "Grenzsaum zwischen Land und Meer"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4e44c2a-092a-4b10-9d8f-98eb906f834d",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "Sie gingen an der Küste entlang."
                                            },
                                            {
                                                "example_id": "6fc72d9d-be0d-403f-89a1-cff928420c8b",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "Vier Wochen nachdem sich ein Wal in London verirrt hatte, strandete ein toter Wal an der belgischen Küste."
                                            },
                                            {
                                                "example_id": "ca7671f9-617d-4930-9fa0-2611a0a223c4",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "„Am nächsten Morgen hielt das Rettungsboot mit der Mutter erneut auf die Küste zu.“"
                                            },
                                            {
                                                "example_id": "c9dd8634-8fce-4d3a-808c-c1dc75f676b7",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "„Kolumbus war überzeugt, dass er an einer kleinen Insel vor der Küste Ostasiens angelangt war, und dass die Menschen, denen er am Strand begegnete, Inder waren (weshalb die Ureinwohner bis heute als »Indios« oder »Indianer« bezeichnet werden).“"
                                            },
                                            {
                                                "example_id": "8891ade7-c85e-469f-be53-0252b7d38e3d",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "„Jeden Sommer nehme ich mir eine Woche frei, um an der europäischen Küste entlangzuwandern.“"
                                            },
                                            {
                                                "example_id": "d40db231-5e21-4abd-a376-e8956118816f",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "„Ursprünglich wollten wir nun auf die italienische Seite der Adria wechseln, um an der Italienischen Küste wieder nach Norden zu segeln. Alle erfahrenen Fahrensleute rieten uns jedoch davon ab, da die Küste mit Bohrtürmen, Reusen und Fischernetzen total verunstaltet sei. Das Befahren dieser Küste sei bis kurz vor Venedig nur sehr schlecht möglich.“"
                                            },
                                            {
                                                "example_id": "752068cb-2dd0-4165-81f7-8f5436560e41",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "„Die Wetterbehörde gab wegen des Sturmtiefs \"Arwen\" eine ungewöhnliche Warnung der Alarmstufe rot aus. »Die Menschen sollten den Küsten fernbleiben, da durch Flutwellen Lebensgefahr besteht«, warnte die Behörde.“"
                                            },
                                            {
                                                "example_id": "860b2b90-47cb-42db-9d7f-8b024a9ac85b",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "[Es] „ist der senegalesischen Armee Anfang November gelungen, alle 82 Insassen eines vor der Küste havarierten Boots zu bergen.“"
                                            },
                                            {
                                                "example_id": "8298457e-4c5b-4f2a-b1de-8bf7c4819c90",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "„Die Besatzung eines Bootes der französischen Marine sah am Nachmittag vor der Küste von Calais Menschen im Wasser treiben.“"
                                            },
                                            {
                                                "example_id": "603e07d3-828f-4fa1-8507-6c8c1baf90bd",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "„In einem überfüllten Flüchtlingsboot vor der libyschen Küste sind die Leichen von zehn Migranten gefunden worden.“"
                                            },
                                            {
                                                "example_id": "ef56575d-e145-445c-b99c-8cd1e96cb858",
                                                "sense_id": "8db0bbe0-321f-3d39-a069-4ff29ae88eb7",
                                                "text": "„In Griechenland stehen Dutzende von Aktivisten vor Gericht […]. Sie alle gehören zu einer NGO, die Flüchtlinge vor der griechischen Küste vor dem Ertrinken gerettet hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
