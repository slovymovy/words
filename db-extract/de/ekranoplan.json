                        "entry_id": "83851b66-a28e-3a10-8ba4-be10d30e8610",
                        "glosses": [
                            "Fluggerät, das in sehr geringer Höhe über ebene Oberflächen wie Wasser fliegt und dabei den Bodeneffekt ausnutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb1fe8a2-d2df-422f-8f45-c47b5dfca1b0",
                                "sense_id": "5f59f364-9c2d-3da6-8c0c-4a56668883a5",
                                "text": "„Das bisher unbenannte Ekranoplan wirkt ähnlich klobig wie seine sowjetischen Vorbilder.“"
                            }
                        ],
