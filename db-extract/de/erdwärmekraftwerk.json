                "senses": [
                    {
                        "sense_id": "d9ddb177-fa22-387f-892a-947d59e191d2",
                        "entry_id": "2912de1b-4df8-3a12-be06-5d94bc705bbe",
                        "glosses": [
                            "Kraftwerk, das Erdwärme zur Stromerzeugung nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0eb780-4fde-4761-9490-d21504186f8c",
                                "sense_id": "d9ddb177-fa22-387f-892a-947d59e191d2",
                                "text": "Erdwärmekraftwerke emittieren kein Kohlendioxid."
                            },
                            {
                                "example_id": "d2d6b157-9dae-4c7e-ab9e-8d6a4f474227",
                                "sense_id": "d9ddb177-fa22-387f-892a-947d59e191d2",
                                "text": "„Kritiker wiesen auf ähnliche Probleme im rheinland-pfälzischen Landau hin, die ein Erdwärmekraftwerk dort hervorgerufen habe.“"
                            },
                            {
                                "example_id": "e4b880ba-591b-4865-b0e2-5258223a6831",
                                "sense_id": "d9ddb177-fa22-387f-892a-947d59e191d2",
                                "text": "„Die Stadtwerke planen, München bis 2040 komplett erneuerbar zu beheizen, den Löwenanteil sollen neue Erdwärmekraftwerke beisteuern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
