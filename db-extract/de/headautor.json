                "senses": [
                    {
                        "sense_id": "2aaf4ffd-4507-365d-b57c-8d991d7ff729",
                        "entry_id": "58a7e5fd-6ded-3565-bebc-cf1d1b27e8cb",
                        "glosses": [
                            "hauptverantwortlicher Autor einer Fernsehserie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b90b7d-2b01-464e-a6b8-1f7549a588d4",
                                "sense_id": "2aaf4ffd-4507-365d-b57c-8d991d7ff729",
                                "text": "„Und so lag Felicitas Woll, seit vier Jahren beliebte Hauptdarstellerin Lolle in der ARD-Serie ‚Berlin, Berlin‘, während der diesjährigen Emmy-Verleihung am 22. November in ihrem Berliner Bett, während sich in New York Producer Holger Ellermann und Headautor David Safier darüber freuten, überhaupt nominiert zu sein.“"
                            },
                            {
                                "example_id": "b4fd4d63-a76d-4682-a926-0001c4349865",
                                "sense_id": "2aaf4ffd-4507-365d-b57c-8d991d7ff729",
                                "text": "„Seit der vierten Staffel ist Johannes Rotter als Headautor für die Drehbücher verantwortlich.“"
                            },
                            {
                                "example_id": "45486ed2-8778-4a8a-84d2-16ea2e348cec",
                                "sense_id": "2aaf4ffd-4507-365d-b57c-8d991d7ff729",
                                "text": "„An seriellen Programmen arbeiten meist mehrere AutorInnen [sic], es gibt aber stets einen Headautor bzw. eine Headautorin, der/die entweder bei geringerer Anzahl die Bücher selber schreibt oder mit den anderen AutorInnen [sic] koordiniert und diese brieft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
