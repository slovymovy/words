                "senses": [
                    {
                        "sense_id": "29500019-e01b-3314-b5e8-856d75db26d8",
                        "entry_id": "c736a5d0-9d1e-3521-8fee-b4cd23c23e71",
                        "glosses": [
                            "Marktform mit einer großen Zahl von Anbietern, bei der kein einzelner Akteur Einfluss auf den geltenden Preis nehmen kann"
                        ],
                        "tags": [
                            "Wirtschaft (Mikroökonomie)"
                        ],
                        "examples": [
                            {
                                "example_id": "7f2902e9-8389-4bc0-b980-c2073ac7975d",
                                "sense_id": "29500019-e01b-3314-b5e8-856d75db26d8",
                                "text": "In homogenen Wettbewerbsmärkten wird im Gegensatz zu Monopolmärkten ein effizientes Marktergebnis erzielt."
                            },
                            {
                                "example_id": "c9e013d4-5afd-4899-b162-8404ebd06621",
                                "sense_id": "29500019-e01b-3314-b5e8-856d75db26d8",
                                "text": "Es ist schwierig, in der Realität vollkommene Wettbewerbsmärkte zu finden, da es nur selten überhaupt keine Marktmacht auf Verkäuferseite gibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
