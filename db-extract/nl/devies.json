                                        "entry_id": "c010e446-4679-32c6-add2-095b7ef70663",
                                        "glosses": [
                                            "eine – oft schlagwortartige – programmatische Aussage, die eine Person, Institution oder Veranstaltung charakterisieren oder prägen soll"
                                        ],
