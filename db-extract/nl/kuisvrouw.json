                "senses": [
                    {
                        "sense_id": "b61a5245-5e59-3aad-956a-e238498b1334",
                        "entry_id": "71f2ecbf-3d4d-3400-a556-b66d46f90c69",
                        "glosses": [
                            "vrouw die schoonmaakt voor haar beroep"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "25b8889a-883e-47b5-9d88-fc7f95f65ad3",
                                "sense_id": "b61a5245-5e59-3aad-956a-e238498b1334",
                                "text": "‘Vijftien jaar geleden werkte ik al op het hoofdkwartier, samen met Piet’, vertelt Duchateau. ‘Wel, toen waren we met zijn zevenen. En dan tel ik de kuisvrouw mee. Dan moet je op mekaar kunnen rekenen.’"
                            },
                            {
                                "example_id": "c98f7709-84ea-4f67-befe-3c19ecd7b830",
                                "sense_id": "b61a5245-5e59-3aad-956a-e238498b1334",
                                "text": "‘Ik ben vooral nieuwsgierig naar de dood. Zoals ik ook zonder angst naar lijden kijk. Ik ga er niet van lopen, ik probeer er open voor te staan. Elke week ga ik naar mijn demente stiefmoeder en tantes. Dit is het, denk ik dan, hier zitten ze bij elkaar: de kuisvrouw en de ceo, te wauwelen en in hun pamper te stinken.’"
                            }
                        ]
                    }
