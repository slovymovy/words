                                        "glosses": [
                                            "einen Stein (Pflasterstein) neben dem nächsten verlegen und so eine Fläche bedecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c9109ab-2fe9-443b-abeb-3844e9c6430b",
                                                "sense_id": "04c5e18f-ce4e-3ba5-b1d1-eeef8c848e91",
                                                "text": "Wir haben die Garagenauffahrt mit Doppelverbundsteinen bepflastern lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96473e6c-42ee-363b-a2ee-23f9c94a6f19",
                                        "entry_id": "f6856ec2-e77e-3b7a-a4f8-e33f0a7fd80c",
