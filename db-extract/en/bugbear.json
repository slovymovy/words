                                                "example_id": "367be560-fdc0-4ce8-a69f-bdf25a3de7eb",
                                                "sense_id": "cd7ba385-4fa3-39ff-8264-8a26f21524f4",
                                                "text": "Veel kinderen geloven in boemannen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3064fa90-e1ba-30e4-82dc-d69674dc91ae",
                                        "entry_id": "375c4413-aa45-37e2-834f-54c555c1a812",
                                        "glosses": [
                                            "iemand die de schuld is van alles"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b95b499-746f-4628-8d3e-37ec9f448dfa",
                                                "sense_id": "3064fa90-e1ba-30e4-82dc-d69674dc91ae",
                                                "text": "Ze voelde zich schuldig. Dat dit nergens op sloeg deed niet ter zake. Gevoelsmatig was zij de boeman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9feefc31-5632-4f24-87a2-147e6650c416",
                        "source_entry_id": "9c5569c8-21fa-34c3-804d-803592df3c16",
                        "source_sense_description": "source of dread, resentment or irritation",
                        "target_lang_word": "schrikbeeld",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schrikbeeld",
