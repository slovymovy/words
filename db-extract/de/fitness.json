                    {
                        "form_id": "b485cbe0-eb3a-403f-a22d-a3f807b06705",
                        "entry_id": "0c07f0ef-5fc4-3863-a801-fcb935dc55a9",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
