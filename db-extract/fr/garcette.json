                "forms": [
                    {
                        "form_id": "624f8558-0bcc-413f-9f00-e1fdd1216cc5",
                        "entry_id": "7193e8df-fec5-3de5-990e-c679b4ed6432",
                        "tags": [
                            "plural"
                        ],
                        "form": "garcettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b45bc8ff-8721-3dc9-812f-4dccb7349358",
                        "entry_id": "7193e8df-fec5-3de5-990e-c679b4ed6432",
                        "glosses": [
                            "Tresse de bitord ou de fil de caret, plate, plus ou moins large, et terminée en pointe, parfois utilisée comme instrument de punition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11052506-564d-4159-916b-866ac6045d80",
                                "sense_id": "b45bc8ff-8721-3dc9-812f-4dccb7349358",
                                "text": "Kernok fit un signe, la garcette siffla et retentit sur le dos de Lescoët."
                            },
                            {
                                "example_id": "9f18d7fc-75d1-4321-8d1d-5ea9d3b72116",
                                "sense_id": "b45bc8ff-8721-3dc9-812f-4dccb7349358",
                                "text": "Je propose que Nutts reçoive des mains de Price, six coups de garcette, puisque c'est notre droit de lui infliger cette punition."
                            },
                            {
                                "example_id": "2eacb134-7bd3-4ea6-9c02-84c9668c34a0",
                                "sense_id": "b45bc8ff-8721-3dc9-812f-4dccb7349358",
                                "text": "Je regrette que la Marine ait jugé bon d’abandonner l’usage de la garcette — je parle pour les enseignes — vraiment dommage…"
                            }
                        ]
                    },
                    {
                        "sense_id": "d2034da0-52d0-3213-b500-a9cf9b35e533",
                        "entry_id": "7193e8df-fec5-3de5-990e-c679b4ed6432",
                        "glosses": [
                            "garcette de ris, pour réduire la surface d’une voile par gros temps"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8b6521d2-7071-4bbb-bfdf-6151b40cb23e",
                                "sense_id": "d2034da0-52d0-3213-b500-a9cf9b35e533",
                                "text": "Je ne serais peut-être pas embarrassée de prendre un riz ou de tresser une garcette."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ca7e9af-f5b9-382f-bac1-8cd72bddaf1b",
                        "entry_id": "7193e8df-fec5-3de5-990e-c679b4ed6432",
                        "glosses": [
                            "Petite matraque souple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b89c197-9194-42d6-8d6c-1593f052d53b",
                                "sense_id": "3ca7e9af-f5b9-382f-bac1-8cd72bddaf1b",
                                "text": "Seuls leurs menottes, garcettes ou autres bâtons servant à châtier les détenus sont montrés au public."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96631d9f-c28d-43b0-ab07-da51d7d9d2f1",
