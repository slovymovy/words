                    {
                        "translation_id": "bf6eb03b-a334-4cc7-8684-c79927e33c93",
                        "source_entry_id": "ddd79a1d-84c1-3d31-876f-a6ec9df4a429",
                        "source_sense_id": "63adf9d6-91b5-3282-a37d-e41b72fa9fb7",
