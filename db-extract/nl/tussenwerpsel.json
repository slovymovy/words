                                    {
                                        "sense_id": "7daad24e-bf0a-3a96-80ea-241d1c78a0b2",
                                        "entry_id": "973b3c56-2aaa-3d2b-afec-532f88061813",
                                        "glosses": [
                                            "parte del discorso invariabile usata per enfatizzare un concetto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ededdcd5-7a88-45d3-addb-f572bc808637",
                                                "sense_id": "7daad24e-bf0a-3a96-80ea-241d1c78a0b2",
                                                "text": "l'interiezione è, insieme alla preposizione, alla congiunzione ed all'avverbio, una delle quattro parti invariabili del discorso"
                                            },
                                            {
                                                "example_id": "c828c97d-2983-49cb-a221-c61d82dd57f3",
                                                "sense_id": "7daad24e-bf0a-3a96-80ea-241d1c78a0b2",
                                                "text": "\"Ohibò\" è un'interiezione"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
