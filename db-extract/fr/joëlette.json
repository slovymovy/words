                ],
                "senses": [
                    {
                        "sense_id": "555d5828-a47e-36d0-8168-173b2a1b93c5",
                        "entry_id": "955355b4-ed59-3b83-b2e8-95e4c248ee8c",
                        "glosses": [
                            "Variante de Joëlette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b876cfd1-1207-445b-8280-5a89e3ec45ab",
                                "sense_id": "555d5828-a47e-36d0-8168-173b2a1b93c5",
                                "text": "Cette fois ci j'ai l'impression qu'il s'agira de ma joëlette, mon fauteuil tout terrain."
                            },
                            {
                                "example_id": "1dd8de56-54c9-4cc7-a1a9-2202b3e251e0",
                                "sense_id": "555d5828-a47e-36d0-8168-173b2a1b93c5",
                                "text": "La joëlette est un fauteuil roulant tout-terrain, muni d'une seule roue, ce qui lui permet de se faufiler sur les sentiers, même les plus étroits ou les plus escarpés. Le siège, adapté en fonction du handicap, se situe au-dessus de la roue."
                            },
                            {
                                "example_id": "b6e1a594-ddc9-4f46-b726-79ed7b86fb1b",
                                "sense_id": "555d5828-a47e-36d0-8168-173b2a1b93c5",
                                "text": "Les trajets ont lieu dans des véhicules adaptés et des visites des parcs sont rendues possibles par l'utilisation de joëlettes (fauteuils de randonnée tout-terrain)."
                            }
                        ]
                    }
