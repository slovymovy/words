                "senses": [
                    {
                        "sense_id": "3547c9c6-197c-3e31-bd61-575d7891402c",
                        "entry_id": "9e16bd4a-9530-312d-bc96-b7351fd0173f",
                        "glosses": [
                            "(об усах или бороде) красить, натирать фаброй"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "131c4309-6da7-474b-9753-c34165f45ec7",
                                "sense_id": "3547c9c6-197c-3e31-bd61-575d7891402c",
                                "text": "Летом Петров очень часто ездил на одну дачу, носил красный галстук, фабрил усики и говорил Федоту, что с осени переедет на другую квартиру, а потом перестал ездить на дачу и на целый месяц запил."
                            }
                        ]
                    }
