                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cda54245-cadc-4507-87af-23b58063d879",
                                "sense_id": "b6feac0d-81f0-3589-a66c-b0f07e1c2956",
                                "text": "Oui, le cinéma engage à un débat entre intime et politique, c’est notre actuel. Actuel où se meut un mythe en voie de constitution, où séjourne le couplage sous-tendu par les jouissances de meurtres à symboliser, fantasmatiser, filmer, celui de victimes-coupables."
                            },
                            {
                                "example_id": "7d9e37f4-dd1d-4c2c-b6c3-cfbf03db89b5",
                                "sense_id": "b6feac0d-81f0-3589-a66c-b0f07e1c2956",
                                "text": "S’il me plaît de me fantasmatiser moi-même, cela ne regarde personne."
                            }
                        ]
                    }
