                        "entry_id": "3cdcc472-30fa-34a3-9a67-7f9b2214c48f",
                        "glosses": [
                            "Cépage donnant de grosses grappes de petits raisins de couleur jaune d'or. En 2008 on en cultivait presque 10000 hectares en France, on le cultive aussi en Argentine, en Australie, aux USA, etc."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "60b7e27b-85b9-4dae-8d5f-b4121208b476",
                                "sense_id": "92409ef7-6f02-3873-b3f1-10bee08b8728",
                                "text": "Les grands vins blancs du val de Loire sont issus du chenin blanc, appelé aussi pineau de Loire"
                            },
                            {
                                "example_id": "aecba295-9d28-43d9-b79e-bb7c71e7507a",
                                "sense_id": "92409ef7-6f02-3873-b3f1-10bee08b8728",
                                "text": "Le pineau d'Aunis est parfois nommé chenin noir"
                            },
                            {
                                "example_id": "0db8bb18-ade1-479d-aa2e-b0bfd671281e",
                                "sense_id": "92409ef7-6f02-3873-b3f1-10bee08b8728",
                                "text": "Une cuvée originale à base de cépages locaux, le sémillon en sélection massale et le sauvignon, mais également avec 20 % de chenin, cépage ligérien planté récemment."
                            }
                        ]
                    }
