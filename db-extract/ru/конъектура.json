                        ]
                    },
                    {
                        "translation_id": "255113c5-db87-4278-b854-e7792724cae7",
                        "source_entry_id": "d7c17480-7145-3df9-ace1-5aaa2f3c250f",
                        "source_sense_description": "восстановление испорченного или не поддающегося прочтению текста",
                        "target_lang_word": "koniektura",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8e192400-7e19-440e-bc63-e0b289f1dd1a",
                        "source_entry_id": "d7c17480-7145-3df9-ace1-5aaa2f3c250f",
                        "source_sense_description": "восстановление испорченного или не поддающегося прочтению текста",
                        "target_lang_word": "conjecture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjecture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17fea2f2-768f-30a8-bb80-382393d913d6",
                                        "entry_id": "1e559591-c35d-3fab-9ff5-256b58e25e94",
                                        "glosses": [
                                            "Jugement probable, opinion que l’on fonde sur des apparences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fd5faeb-12c9-494e-8103-09999e903137",
                                                "sense_id": "17fea2f2-768f-30a8-bb80-382393d913d6",
                                                "text": "Les cent millions que lui accordait Süssmilch, et les évaluations de Raynal, ne sont et ne pouvaient être que des conjectures, vu l’époque où ces auteurs écrivaient."
                                            },
                                            {
                                                "example_id": "34366fdb-ac2d-4c5b-894d-2fcf7c5db1d2",
                                                "sense_id": "17fea2f2-768f-30a8-bb80-382393d913d6",
                                                "text": "Au reste, l’événement seulement fit naître ces conjectures toutes insolubles."
                                            },
                                            {
                                                "example_id": "8f4a8589-6905-4fdb-a8fc-f66b710dba6a",
                                                "sense_id": "17fea2f2-768f-30a8-bb80-382393d913d6",
                                                "text": "On ne peut se livrer qu’à de vagues conjectures sur ce qu’il advint de Carcassonne pendant quatre siècles […] ."
                                            },
                                            {
                                                "example_id": "54fa6830-233c-4fa4-829f-269250e8a094",
                                                "sense_id": "17fea2f2-768f-30a8-bb80-382393d913d6",
                                                "text": "Ces conjectures et ces raisonnements se pressaient dans la cervelle de Scaër, pendant que les assassins fuyaient en emportant ce qu'on appelle en style judiciaire le corps du délit."
                                            },
                                            {
                                                "example_id": "a209e939-b776-4a6f-8a42-128bef469feb",
                                                "sense_id": "17fea2f2-768f-30a8-bb80-382393d913d6",
                                                "text": "Quelle est au juste la nature du travail électrochimique qui se produit dans l’électrolyte, il est difficile de le dire, on en est réduit à des conjectures."
                                            },
                                            {
                                                "example_id": "be9d6a17-1a23-49ac-be43-cac06ff1ab9e",
                                                "sense_id": "17fea2f2-768f-30a8-bb80-382393d913d6",
                                                "text": "On ne peut que se demander ce qui explique un tel écart, tout en devant se contenter de conjectures pour l'expliquer."
                                            }
                                        ]
                                    },
                                    {
