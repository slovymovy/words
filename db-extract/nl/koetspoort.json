                            {
                                "example_id": "a8459ca4-b3ef-4d03-812c-44828bb80cc6",
                                "sense_id": "73844444-cc10-37ba-baeb-411d3d45c6e6",
                                "text": "Op de Quai des Saint Augustins, achter een lage blinde muur, staat een rococopaleisje met een stukgeslagen wapenschild boven de koetspoort."
                            },
                            {
                                "example_id": "44731fe7-8731-41d5-a77a-a84f6fea0f16",
                                "sense_id": "73844444-cc10-37ba-baeb-411d3d45c6e6",
                                "text": "Maar het voertuig is de koetspoort al door, zijn aide de camp is bezig de bagage af te laden en de waard komt buigend en handenwrijvend naar hem toe en verzekert de citoyen général dat hij hem een uitstekende kamer en een voortreffelijk maal zal kunnen verschaffen."
                            }
                        ]
