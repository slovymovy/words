                "senses": [
                    {
                        "sense_id": "5d2fd7bc-bce6-369b-a507-354e3c250da7",
                        "entry_id": "17af7c49-2efe-3972-8c69-394721bdb3b4",
                        "glosses": [
                            "grafische Darstellung des Lernerfolgs in Relation zum Zeitaufwand; auch : das erfassen Müssen vieler oder komplexer Informationen auf einmal"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "25216256-4a90-4bf5-93ae-4a6d8923a109",
                                "sense_id": "5d2fd7bc-bce6-369b-a507-354e3c250da7",
                                "text": "Die Steigung der Lernkurve ist auch von der Lehrmethode abhängig."
                            },
                            {
                                "example_id": "6309aa03-db6f-4995-81fe-e55af7c1b212",
                                "sense_id": "5d2fd7bc-bce6-369b-a507-354e3c250da7",
                                "text": "„Welche Lernkurve hat diese Regierung in dieser Zeit hingelegt, wenn sie denn überhaupt eine hingelegt hat?“"
                            },
                            {
                                "example_id": "8326e5f5-215a-437e-aac1-e36734585581",
                                "sense_id": "5d2fd7bc-bce6-369b-a507-354e3c250da7",
                                "text": "„Inzwischen bescheinigen Beobachter Rösler aber eine positive Lernkurve.“"
                            },
                            {
                                "example_id": "371096ac-8391-470a-8950-79ed9695eb53",
                                "sense_id": "5d2fd7bc-bce6-369b-a507-354e3c250da7",
                                "text": "Inzwischen bin ich ganz gut, aber am Anfang habe ich überhaupt nichts verstanden – das war eine steile Lernkurve!"
                            },
                            {
                                "example_id": "989a1895-ae11-4c85-abc8-545438319f2f",
                                "sense_id": "5d2fd7bc-bce6-369b-a507-354e3c250da7",
                                "text": "Er denkt, er kennt das schon, aber ich sagte zu ihm: ‚Achtung, steile Lernkurve voraus!‘."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41d45741-8af6-4572-8dd1-c980ac8193e1",
                        "source_entry_id": "17af7c49-2efe-3972-8c69-394721bdb3b4",
                        "source_sense_id": "5d2fd7bc-bce6-369b-a507-354e3c250da7",
                        "target_lang_word": "learning curve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "learning curve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c91f4d2-e027-37e9-9dd4-d3e8a6d0e86f",
                                        "entry_id": "1df10dbe-5366-38d8-a559-5c9132e3ef2c",
                                        "glosses": [
                                            "A visualization of the progress of learning as function of experience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f38499f-82c3-4a95-9c22-f0cfa6e4c584",
                                                "sense_id": "5c91f4d2-e027-37e9-9dd4-d3e8a6d0e86f",
                                                "text": "We shall return to these personal differences later in discussing the individual features of the learning curves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52556eed-ccef-363f-b22e-90380a8f18d0",
                                        "entry_id": "1df10dbe-5366-38d8-a559-5c9132e3ef2c",
                                        "glosses": [
                                            "A measure of how much there is to learn in a restricted amount of time."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f102a888-c883-4672-832a-e07ceaed8b4e",
                                                "sense_id": "52556eed-ccef-363f-b22e-90380a8f18d0",
                                                "text": "Damen told BBC Sport: \"The crowd were phenomenal they carried me through the last few metres. I don't think you can ever prepare enough for this event. It's a massive learning curve for me. From here, I'd like to work on my shorter distances and get some speed back.\""
                                            },
                                            {
                                                "example_id": "78aea9df-cd49-473b-9ddd-bc0b2d51aae2",
                                                "sense_id": "52556eed-ccef-363f-b22e-90380a8f18d0",
                                                "text": "Toronto Transit Corporation had real issues. [...] My boss was removed in a coup three months after my arrival. I stood in and my learning curve went through the roof. Over five years, we went from being a laughing stock to winning awards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
