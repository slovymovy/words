                        "glosses": [
                            "Qualifie tout quadrupède qui a les jambes de derrière tournées en dedans, et si peu ouvertes que les deux jarrets se touchent presque en marchant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01bb4d6a-d9cd-47b1-bea8-a5f2719d415e",
                                "sense_id": "14ba9a7e-d1a9-354e-bd45-a410b2f4c754",
                                "text": "Je ne veux point de ce mulet, il est jarreté. - Cette jument serait belle, si elle n’était pas jarretée."
                            }
                        ]
                    },
                    {
                        "sense_id": "7314405e-383b-37c8-a279-4dc356689e6e",
                        "entry_id": "0f94d8dc-5cf4-3735-8056-4dfdce0effdd",
                        "glosses": [
                            "Qualifie une surface qui a un jarret."
                        ],
                        "tags": [],
                        "examples": [
