{
    "word_family": [
        "agitation",
        "agitator",
        "agitational"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc118682-8d07-3045-9167-b954664ac8c7",
                    "sense_definition": "To make someone feel worried, nervous, or upset.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_disturbance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad news began to <w>agitate</w> the crowd.",
                            "target_lang_translations": {
                                "ru": "Плохие новости начали <w>волновать</w> толпу."
                            }
                        },
                        {
                            "text": "He was greatly <w>agitated</w> by the sudden change in plans.",
                            "target_lang_translations": {
                                "ru": "Он был сильно <w>взволнован</w> внезапной переменой планов."
                            }
                        }
                    ],
                    "synonyms": [
                        "disturb",
                        "upset",
                        "perturb"
                    ],
                    "antonyms": [
                        "appease",
                        "calm",
                        "quieten"
                    ],
                    "common_phrases": [
                        "visibly agitate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо чувство беспокойства, тревоги или волнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волновать",
                                "target_lang_sense_clarification": "вызывать беспокойство или эмоциональное возбуждение"
                            },
                            {
                                "target_lang_word": "тревожить",
                                "target_lang_sense_clarification": "лишать спокойствия, вызывать тревогу"
                            },
                            {
                                "target_lang_word": "будоражить",
                                "target_lang_sense_clarification": "вызывать сильное беспокойство или возбуждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5b43710-5cbe-35b2-a208-df1adcdc84ba",
                    "sense_definition": "To move a liquid or substance with a fast, irregular, or shaking motion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>agitate</w> the mixture thoroughly before use.",
                            "target_lang_translations": {
                                "ru": "Перед использованием необходимо тщательно <w>взболтать</w> смесь."
                            }
                        },
                        {
                            "text": "Strong winds <w>agitate</w> the surface of the ocean.",
                            "target_lang_translations": {
                                "ru": "Сильные ветры <w>колеблют</w> поверхность океана."
                            }
                        }
                    ],
                    "synonyms": [
                        "shake",
                        "roil"
                    ],
                    "common_phrases": [
                        "agitate the mixture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить жидкость или вещество в движение путем быстрого, нерегулярного или резкого встряхивания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взбалтывать",
                                "target_lang_sense_clarification": "интенсивно перемешивать жидкость встряхиванием"
                            },
                            {
                                "target_lang_word": "размешивать",
                                "target_lang_sense_clarification": "приводить в движение для смешивания компонентов"
                            },
                            {
                                "target_lang_word": "колебать",
                                "target_lang_sense_clarification": "вызывать движение поверхности, например, воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6608af2b-cd6d-3e4d-8f20-5d6024656ffa",
                    "sense_definition": "To campaign or protest publicly to achieve political or social change.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "political_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Activists continue to <w>agitate</w> for better working conditions.",
                            "target_lang_translations": {
                                "ru": "Активисты продолжают <w>агитировать</w> за улучшение условий труда."
                            }
                        },
                        {
                            "text": "They <w>agitated</w> against the new law for several months.",
                            "target_lang_translations": {
                                "ru": "Они несколько месяцев <w>выступали</w> против нового закона."
                            }
                        }
                    ],
                    "common_phrases": [
                        "agitate for change",
                        "agitate against"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публично выступать или проводить кампанию с целью достижения политических или социальных изменений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агитировать",
                                "target_lang_sense_clarification": "вести активную пропаганду за что-либо"
                            },
                            {
                                "target_lang_word": "выступать",
                                "target_lang_sense_clarification": "активно бороться за достижение какой-либо цели"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}