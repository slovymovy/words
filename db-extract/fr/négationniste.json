                        "entry_id": "917b5831-e25f-3140-b07f-059c7f7e756d",
                        "glosses": [
                            "Relatif au négationnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee603743-0623-4750-835f-f686546da26f",
                                "sense_id": "dfd05b35-d8a3-3854-b02e-c14414ddc4d8",
                                "text": "Une quatrième forme très minoritaire se manifeste dans les courants révisionnistes et négationnistes, autour de Paul R., la librairie La Vieille Taupe et Roger G."
                            },
                            {
                                "example_id": "38179007-a4ff-4447-82dc-29fb3ea3564c",
                                "sense_id": "dfd05b35-d8a3-3854-b02e-c14414ddc4d8",
                                "text": "Les tensions entre catholiques et juifs avaient été ravivées en décembre, quand Benoît XVI avait accéléré le processus de béatification du pape Pie XII, accusé de s'être tu face à l'Holocauste et, début 2009, lors de la levée de l'excommunication d'un évêque négationniste, Richard Williamson."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1a55444-b8f2-4301-bcb8-fc425bf29e23",
                        "source_entry_id": "917b5831-e25f-3140-b07f-059c7f7e756d",
                        "source_sense_id": "dfd05b35-d8a3-3854-b02e-c14414ddc4d8",
                        "target_lang_word": "denialist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
