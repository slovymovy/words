                ],
                "senses": [
                    {
                        "sense_id": "558ea83a-afc0-3142-8f90-eb4f01510a1c",
                        "entry_id": "28fe7853-d03a-3153-a7d9-853a56f299fe",
                        "glosses": [
                            "angenehm riechendes Öl, Salbe oder Flüssigkeit; (öliges) Arzneimittel, Naturheilmittel"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "e9f8950d-55be-4018-b362-02507958b2d4",
                                "sense_id": "558ea83a-afc0-3142-8f90-eb4f01510a1c",
                                "text": "„Den Liquorem so du von dem gefällten Mercurio vitæ abgossen / filtrine / und laß die aquositatem, darvon abreichen/ so wird deine gelbe Olität schön anzusehen dahinden bleiben.“"
                            },
                            {
                                "example_id": "f4051b4e-c35f-49e4-ad91-15e9a3b76ee9",
                                "sense_id": "558ea83a-afc0-3142-8f90-eb4f01510a1c",
                                "text": "„Zu den Gegenständen, mit welchen im Umherziehen nicht gehandelt werden darf, gehören auch Olitäten und Medicamente.“"
                            },
                            {
                                "example_id": "16f13ed5-b56d-44af-80c6-fc0472dcdcff",
                                "sense_id": "558ea83a-afc0-3142-8f90-eb4f01510a1c",
                                "text": "„Unterthanen wird die Schwefelblühe und Wacholderbrandweine, keineswegs aber Olitäten; Salien, Spiritus und chemische Erzeugnisse einzuführen gestattet.“"
                            },
                            {
                                "example_id": "48841bfb-e242-4ef0-b005-41e9aefc09df",
                                "sense_id": "558ea83a-afc0-3142-8f90-eb4f01510a1c",
                                "text": "„Von hohem Bekanntheitsgrad waren auch die Olitäten, deren Herstellung schon um die Mitte des 17. Jahrhunderts im Gebiet von Sachsen, Thüringen und Schlesien Aufnahme gefunden hatte.“"
                            },
                            {
                                "example_id": "bec12944-6b06-461b-8ac2-694cc4758bfe",
                                "sense_id": "558ea83a-afc0-3142-8f90-eb4f01510a1c",
                                "text": "„Nun nimmt die Phlegma mit dem Oleo, so in der Vorlag funden wird, thue es in einen andern Kolben, samt einem Helm in Baln. Mariæ, abgezogen ganz lind, bis auf die Olität; In diese Olität thue, was sich aufgelöset hat, welches ich dich vor der Luft habe bewahren heissen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
