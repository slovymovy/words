                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "dfd9c9a3-f142-4d24-b0b3-a9833df9a17d",
                                "sense_id": "cc473c83-ac93-3667-9a1f-e85007d1ff38",
                                "text": "Sie schwoabt de Wäsch im Wassa, damit de Seifalaung rausgeht."
                            },
                            {
                                "example_id": "2fa2e897-0473-401a-9fb3-096902c638bb",
                                "sense_id": "cc473c83-ac93-3667-9a1f-e85007d1ff38",
                                "text": "„Vom Ausguck rutscht der Obermaat und schwoabt'n beinah über Deck, oan Masten reißts mi'n Segel weg […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
