                        "sense_id": "f59dc880-d852-3f95-a9d1-78b8d725e8ec",
                        "entry_id": "57de323d-fdfc-389a-bd5a-6788f0fe374f",
                        "glosses": [
                            "Supporter, adherent, partisan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f69565-413e-47f3-9356-258d72aca72a",
                                "sense_id": "f59dc880-d852-3f95-a9d1-78b8d725e8ec",
                                "text": "The effect of the ſtatute of 16 R. 2 [Statute of Praemunire (16 Ric. II, chapter 5)] is, if any purſue or cauſe to be purſued in the court of Rome, or elſewhere, any thing with toucheth the king, againſt him, his crowne and regality, or his realme, their notaries, procurators, &c. fautors, &c. ſhall be out of the kings protection."
                            },
                            {
                                "example_id": "ec56a21d-cb0d-4f36-bb1f-031d35282dd0",
                                "sense_id": "f59dc880-d852-3f95-a9d1-78b8d725e8ec",
                                "text": "...Edmund Wyld, Esq., also, then a member of Parliament and a great fautor of ingenious and good men for mere merit's sake..."
                            }
                        ]
                    }
