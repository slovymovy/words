                ],
                "senses": [
                    {
                        "sense_id": "1644aa4d-2a0d-339e-8066-57e48472d2d4",
                        "entry_id": "86bbaa9a-a253-3438-b076-3c7de00636ed",
                        "glosses": [
                            "to suck in"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca0c57ab-94bf-4eef-88e4-1bc5f1d8c99e",
                                "sense_id": "1644aa4d-2a0d-339e-8066-57e48472d2d4",
                                "text": "Так тру́дно одолева́ть простра́нство и вре́мя, когда́ торо́пишься! Земля́ то́чно приса́сывает к себе́, ка́ждый шаг покупа́ешь уси́лием и уста́лостью. До бо́ли и ломо́ты в и́крах.",
                                "translation": "It is difficult to conquer space and time when one is in a hurry. The earth itself seems to suck you in, and at each step you feel impotence and tiredness—you feel it like a rheumatism in the marrow.",
                                "english": "It is difficult to conquer space and time when one is in a hurry. The earth itself seems to suck you in, and at each step you feel impotence and tiredness—you feel it like a rheumatism in the marrow."
                            }
                        ]
                    }
                ],
