                {
                    "sense_id": "f51f82a2-7ff6-353c-8f90-ad02ff7e7778",
                    "sense_definition": "Used to indicate that a person or thing is well-known, typical, or characteristic.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is not <w>your</w> average travel guide.",
                            "target_lang_translations": {
                                "ru": "Это не <w>обычный</w> путеводитель.",
                                "nl": "Dit is niet <w>je</w> gemiddelde reisgids.",
                                "pl": "To nie jest <w>zwykły</w> przewodnik turystyczny.",
                                "de": "Dies ist nicht <w>dein</w> typischer Reiseführer.",
                                "fr": "Ce n'est pas <w>votre</w> guide de voyage habituel.",
                                "it": "Questa non è la <w>solita</w> guida turistica.",
                                "cs": "Tohle není <w>obyčejný</w> průvodce.",
