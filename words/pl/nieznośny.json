                    "sense_id": "1a5c1ce3-8bfd-3004-b265-5f6bd3555013",
                    "sense_definition": "taki, którego nie da się znieść; bardzo męczący",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "trudny do zniesienia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W upalne lato słońce bywało wręcz <w>nieznośne</w> dla pracujących na zewnątrz ludzi.",
                            "target_lang_translations": {
                                "ru": "Жарким летом солнце бывало просто <w>несносным</w> для людей, работающих на улице."
                            }
                        },
                        {
                            "text": "Hałas dochodzący z placu budowy stał się dla mieszkańców zupełnie <w>nieznośny</w>.",
                            "target_lang_translations": {
                                "ru": "Шум, доносящийся со стройплощадки, стал для жителей совершенно <w>невыносимым</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uciążliwy",
                        "męczący",
                        "nie do zniesienia"
                    ],
                    "antonyms": [
                        "znośny"
                    ],
                    "common_phrases": [
                        "nieznośny upał",
                        "nieznośny hałas"
                    ],
                    "target_lang_definitions": {
                        "ru": "такой, который невозможно вынести; крайне утомительный или тяжелый"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несносный",
                                "target_lang_sense_clarification": "о чем-то крайне тяжелом для восприятия"
                            },
                            {
                                "target_lang_word": "невыносимый",
                                "target_lang_sense_clarification": "о ситуации или явлении, которое невозможно терпеть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "443b11a1-b2a9-3e4d-acb8-3071c3954698",
                    "sense_definition": "o człowieku: nieprzyjemny w obejściu, w zachowaniu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trudny do zniesienia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój nowy sąsiad jest wyjątkowo <w>nieznośny</w> i ciągle narzeka na wszystko dookoła.",
                            "target_lang_translations": {
                                "ru": "Мой новый сосед — человек исключительно <w>несносный</w>, он постоянно на всё жалуется."
                            }
                        },
                        {
                            "text": "Dziecko było dzisiaj wyjątkowo <w>nieznośne</w> i nie chciało słuchać żadnych poleceń rodziców.",
                            "target_lang_translations": {
                                "ru": "Ребенок сегодня был на редкость <w>несносным</w> и не хотел слушать никаких указаний родителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "dokuczliwy",
                        "naprzykrzony",
                        "uprzykrzony"
                    ],
                    "common_phrases": [
                        "nieznośny człowiek",
                        "nieznośne dziecko"
                    ],
                    "target_lang_definitions": {
                        "ru": "о человеке: неприятный в общении, капризный, раздражающий своим поведением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несносный",
                                "target_lang_sense_clarification": "о человеке с тяжелым характером"
                            },
                            {
                                "target_lang_word": "невыносимый",
                                "target_lang_sense_clarification": "о человеке, чье поведение трудно терпеть"
