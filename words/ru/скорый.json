                    ],
                    "synonyms": [
                        "поспешный",
                        "нетерпеливый"
                    ],
                    "antonyms": [
                        "медлительный"
                    ],
                    "common_phrases": [
                        "скорый на расправу"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
