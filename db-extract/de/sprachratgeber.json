                ],
                "senses": [
                    {
                        "sense_id": "b97be7fc-db6f-3b65-807b-a839888da111",
                        "entry_id": "7edde94d-1e4d-3e30-bbd7-8ce1abdba87a",
                        "glosses": [
                            "Buch mit Hinweisen für den Umgang mit sprachlichen Zweifelsfällen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92e6cee9-29b6-46cf-9e82-fabe0da335d8",
                                "sense_id": "b97be7fc-db6f-3b65-807b-a839888da111",
                                "text": "„Ein Sprachratgeber kann, mit anderen Worten, vielerlei Formen annehmen;…“"
                            },
                            {
                                "example_id": "21dc0cad-ff10-40c6-becd-0f7f6d240362",
                                "sense_id": "b97be7fc-db6f-3b65-807b-a839888da111",
                                "text": "„Ein Sprachratgeber ist ein Buch, in dem Ratschläge zum Gebrauch der Muttersprache gegeben werden oder in dem zum Gebrauch der Muttersprache angeleitet wird.“"
                            },
                            {
                                "example_id": "912ccc78-0726-4037-a7ce-ba830fb043af",
                                "sense_id": "b97be7fc-db6f-3b65-807b-a839888da111",
                                "text": "„Bis in die jüngste Vergangenheit haben jedoch auch Sprachwissenschaftler (normative) Sprachratgeber und normative Handbücher (Grammatiken und Wörterbücher) herausgegeben, besonders im deutschen Sprachraum.“"
                            },
                            {
                                "example_id": "44f2255a-f62e-45a1-9741-78fe94a497df",
                                "sense_id": "b97be7fc-db6f-3b65-807b-a839888da111",
                                "text": "„Ob Grammatik, Rechtschreibung, Wortherkunft oder guter Stil: Der Sprachratgeber gibt Hintergrundwissen zur deutschen Sprache, von wichtigen Regeln bis zu kuriosen Phänomenen.“"
                            },
                            {
                                "example_id": "74ebf3ee-905a-49a1-8f28-1a95e65f8e98",
                                "sense_id": "b97be7fc-db6f-3b65-807b-a839888da111",
                                "text": "„Im Seminar werden, ausgehend von einer deskriptiv-wissenschaftlichen Beschäftigung mit dem Stilbegriff, solche Sprachratgeber aus verschiedenen Epochen kritisch gelesen und begutachtet.“"
                            },
                            {
                                "example_id": "371aa196-de6e-47b3-b8a8-0d3a93481214",
                                "sense_id": "b97be7fc-db6f-3b65-807b-a839888da111",
                                "text": "„Sogenannte Sprachratgeber versprechen Hilfe und Rat bei sprachlichen Fragen und Problemen.“ Zugriff 19.8.13."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
