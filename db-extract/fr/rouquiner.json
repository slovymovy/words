                "senses": [
                    {
                        "sense_id": "051f204a-6f62-36df-acef-c7dbe99aa6f4",
                        "entry_id": "a148e560-424d-3e9e-ac03-517fb9520767",
                        "glosses": [
                            "Rendre roux, rendre rouquin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52c032d2-6f18-48d8-9235-7afbff9b50ce",
                                "sense_id": "051f204a-6f62-36df-acef-c7dbe99aa6f4",
                                "text": "Je trouve que ses cheveux rouges lui donne un air sanguinaire, et seront peut-être à \"rouquiner\" lors de l'éclaircissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ca6a323-a277-3208-baaa-ed6c5121ee4e",
                        "entry_id": "a148e560-424d-3e9e-ac03-517fb9520767",
                        "glosses": [
                            "Devenir roux, devenir rouquin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a49726cb-4db9-49ed-be39-4938dc2766d2",
                                "sense_id": "7ca6a323-a277-3208-baaa-ed6c5121ee4e",
                                "text": "Une dernière invention vient de voir le jour pour rouquiner à la perfection : un kit pour se faire des tâches de rousseur, issu de la marque californienne Freck Yourself"
                            },
                            {
                                "example_id": "264600ef-2c12-4a22-9507-cd2f228eb659",
                                "sense_id": "7ca6a323-a277-3208-baaa-ed6c5121ee4e",
                                "text": "Le chêne de l'autre côté de la rue, commence à rouquiner par grappes."
                            },
                            {
                                "example_id": "e92235b9-7f8e-45f4-8ce9-7386e82e6b68",
                                "sense_id": "7ca6a323-a277-3208-baaa-ed6c5121ee4e",
                                "text": "Les arbres commencent à rouquiner sérieusement, et le soir, quand les voitures cessent d'êtres incessantes, ça sent le feu de bois dans ma rue..."
                            }
                        ]
                    }
