                    },
                    {
                        "translation_id": "c93ace1b-7288-422e-a4dd-25241161ff9b",
                        "source_entry_id": "cd66d207-1aa1-3dc7-9cb9-67e7328f643c",
                        "source_sense_description": "spiritual energy nexuses",
                        "target_lang_word": "chakra",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chakra",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7e4f7262-9472-3fe8-9964-a215c4d13799",
                                        "entry_id": "78dc3338-6b9d-3fd5-a6c2-667d8ef6008d",
                                        "glosses": [
                                            "een energiecentrum in oosterse culturen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba9e926-a869-4b18-b9b0-a7efb288c594",
                                                "sense_id": "7e4f7262-9472-3fe8-9964-a215c4d13799",
                                                "text": "Gelukkig zitten de chakra’s bij andere deelnemers in het studiootje vlak achter het Centraal Station, ogenschijnlijk ook potdicht. Waar ben ik aan begonnen?"
                                            },
                                            {
                                                "example_id": "b5f22da1-0037-4f96-8915-e4e88a4edc0e",
                                                "sense_id": "7e4f7262-9472-3fe8-9964-a215c4d13799",
                                                "text": "Ook craniosacraaltherapie (focust op verstoringen in het bindweefsel) en ayurveda (een Indiase geneeswijze waarbij gebruik wordt gemaakt van reinigingskuren en massages), kwamen niet door de test. Buiten de therapieën waar de verzekerden negatief over waren, is ook de verzekeraar kritisch door het aanbod gegaan. Het resultaat: onder andere klankschaaltherapie, ademhalingstherapie en muziekwaterbedtherapie, chakra cursus, lever- en nierreiniging zijn geschrapt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44c3f3b0-11f6-44cd-819e-2d0e68c263eb",
                        "source_entry_id": "cd66d207-1aa1-3dc7-9cb9-67e7328f643c",
                        "source_sense_description": "spiritual energy nexuses",
                        "target_lang_word": "chakra",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chakra",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2890f33d-457e-37c0-9ce7-b9892631a80d",
                                        "entry_id": "97b2ef63-d4f3-3fa0-a47e-421ee48fd342",
                                        "glosses": [
                                            "Région du corps dans le yoga tantrique."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8fdf6a5-e94a-4114-b168-2583cd60c4ff",
                                                "sense_id": "2890f33d-457e-37c0-9ce7-b9892631a80d",
                                                "text": "Une mandale, chérie, je lui ai collé une petite mandale pour qu’il nous raconte ce qui s’était passé. […] Ça lui a réaligné les chakras, c’est comme ça que ça marche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "596c6626-f47c-499a-aff5-8dc494d0cf70",
                        "source_entry_id": "cd66d207-1aa1-3dc7-9cb9-67e7328f643c",
