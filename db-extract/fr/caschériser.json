                        "entry_id": "dbb292c9-1d2f-3136-bd30-93adf11a4237",
                        "glosses": [
                            "Rendre propre à une utilisation casher (quelque chose de non casher ou qui a servi de façon non casher)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4066a4a-f328-45f2-ab61-2f3a2f317324",
                                "sense_id": "c7826dc2-aca1-33e5-85f0-1123b514430c",
                                "text": "On incite les familles à \" caschériser \" leur vaisselle, on leur recommande même de manger Glatt Cascher, c'est-à-dire encore plus cascher que le commun des croyants."
                            },
                            {
                                "example_id": "98090071-a03e-4218-ba38-73cc287f87dd",
                                "sense_id": "c7826dc2-aca1-33e5-85f0-1123b514430c",
                                "text": "Temps nécessaire pour caschériser la viande, la vider de son sang, avant de la hacher."
                            }
                        ]
                    }
