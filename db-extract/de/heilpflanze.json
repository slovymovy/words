                ],
                "senses": [
                    {
                        "sense_id": "b1d908f2-a0b8-3b34-9ea1-3fc7693373ac",
                        "entry_id": "f927325b-77df-3b5c-a3ba-1a2ec672c87e",
                        "glosses": [
                            "eine Pflanze, die zu Heilzwecken verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9276252-919a-495d-89fc-b123d7187677",
                                "sense_id": "b1d908f2-a0b8-3b34-9ea1-3fc7693373ac",
                                "text": "In Apotheken werden Heilpflanzen als Naturheilmittel angeboten."
                            },
                            {
                                "example_id": "216a7678-2363-4c20-a968-c21797f78de5",
                                "sense_id": "b1d908f2-a0b8-3b34-9ea1-3fc7693373ac",
                                "text": "„Heilpflanzen mit ätherischen Ölen sind gut geeignet, um Völlegefühle nach einem Festessen zu mildern.“"
                            },
                            {
                                "example_id": "0c290820-886a-434c-b9fb-32fd4790d357",
                                "sense_id": "b1d908f2-a0b8-3b34-9ea1-3fc7693373ac",
                                "text": "„Darin wurde vor allem Sauerampfer angebaut, der früher als Salat, Gemüse und Heilpflanze von großer Bedeutung war.“"
                            },
                            {
                                "example_id": "48203d3c-6441-45f9-9614-ba9e1b14c078",
                                "sense_id": "b1d908f2-a0b8-3b34-9ea1-3fc7693373ac",
                                "text": "„Am Flussufer wucherte Wegerich, die Heilpflanze seiner Kinderzeit, deren Blätter auf Wunden und Geschwüre gelegt worden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18e23761-45d6-489e-ae29-feb58267e252",
                        "source_entry_id": "f927325b-77df-3b5c-a3ba-1a2ec672c87e",
                        "source_sense_id": "b1d908f2-a0b8-3b34-9ea1-3fc7693373ac",
