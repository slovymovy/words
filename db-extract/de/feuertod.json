                            {
                                "example_id": "a9c9166c-6f80-4333-9c2c-ee4dcdb0da52",
                                "sense_id": "a6a82239-69b0-3526-acf7-155d8106d4df",
                                "text": "„Canondah jedoch war gefangengenommen worden, wurde in das Wigwam der Wilden gebracht und verurteilt, den Feuertod zu sterben.“"
                            },
                            {
                                "example_id": "cb1481f0-254e-485d-96c3-906f517738cf",
                                "sense_id": "a6a82239-69b0-3526-acf7-155d8106d4df",
                                "text": "„Justine sieht sich zum Feuertod verurteilt.“"
                            },
                            {
                                "example_id": "383696c0-2613-480c-989d-49ff49bfcdb5",
                                "sense_id": "a6a82239-69b0-3526-acf7-155d8106d4df",
                                "text": "„Die vier Angeklagten wurden zum Feuertod an Pfählen verurteilt.“"
                            }
                        ],
