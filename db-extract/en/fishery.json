                "senses": [
                    {
                        "sense_id": "71dd18d6-d3e2-321c-b534-d653c7cc09f6",
                        "entry_id": "ae3f6f82-3b01-3a52-aaad-9b5a1a866c6c",
                        "glosses": [
                            "Fishing: the catching, processing and marketing of fish or other seafood."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "72d6bdc9-9d03-3032-905e-4a66f0215760",
                        "entry_id": "ae3f6f82-3b01-3a52-aaad-9b5a1a866c6c",
                        "glosses": [
                            "A place related to fishing",
                            "A place where fish or other seafood are caught: a fishing ground (for example, a territorial one)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ef6f6e4f-50e9-47f7-b471-bd2c1f2be502",
                                "sense_id": "72d6bdc9-9d03-3032-905e-4a66f0215760",
                                "text": "the collapse of the fisheries"
                            },
                            {
                                "example_id": "f8625951-eaa0-4722-a412-707d6336753f",
                                "sense_id": "72d6bdc9-9d03-3032-905e-4a66f0215760",
                                "text": "While the present conservation of Maryland fisheries is largely concerned with the oyster, which promises such great future returns, the foodfishes should not be neglected."
                            },
                            {
                                "example_id": "4387c20a-53d8-425a-98e0-f4fcd1615fa0",
                                "sense_id": "72d6bdc9-9d03-3032-905e-4a66f0215760",
                                "text": "This fishery, which at its peak produced more than 80,000 tons a year, is now in decline."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a3f1d6f-2ef8-360b-b459-33ca1715ea5f",
                        "entry_id": "ae3f6f82-3b01-3a52-aaad-9b5a1a866c6c",
                        "glosses": [
                            "A place related to fishing",
                            "A place where fish or other seafood are raised: a fish farm."
                        ],
