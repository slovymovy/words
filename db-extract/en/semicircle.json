                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd3bce16-c0b4-4d8e-a09f-88581e4971bb",
                        "source_entry_id": "bd952315-0c9e-3937-afe0-1bec13e2f491",
                        "source_sense_id": "c1d2d94e-d7a4-3e9f-851c-a46c496bfb3f",
                        "source_sense_description": "Halbkreis, Halbbogen",
                        "target_lang_word": "Halbkreis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbkreis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                        "entry_id": "2b0dcb0a-01e9-3b6f-ba32-77bff9b47dc7",
                                        "glosses": [
                                            "durch den Durchmesser begrenzte Hälfte eines Kreises"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e3259b-c6f2-4b91-97ae-0d6c569ad604",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "Bei praktischen Demonstrationen im Chemiekabinett stellen sich die Schüler alle im Halbkreis um den Lehrer auf, so dass jeder den gleichen Abstand zu diesem hat und gut sehen kann."
                                            },
                                            {
                                                "example_id": "1b55aab8-8d06-43c4-9597-26e40976ccf0",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Unten am Strand schützte Alf die Seinen vor der Flut durch hohe Wälle aus Sand, die in einem Halbkreis an die rote alte Ufermauer stießen.“"
                                            },
                                            {
                                                "example_id": "5c72278c-79f7-49cd-870f-53d9a08c63ce",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Vor dem Hotel Abdulla – auf dem Trottoir – saßen Männer im Halbkreis, rauchten Wasserpfeifen und tranken Türkischen aus kleinen, runden Tassen.“"
                                            },
                                            {
                                                "example_id": "00d7c675-d8ec-4d70-9fa1-eb986f9a33f7",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Er gab es auf, das Auf und Nieder seiner Promenade noch weiterfortzusetzen, und beschrieb lieber einen Halbkreis um den Fuß des Schloßhügels herum, bis er in Front des Schlosses selber war.“"
                                            },
                                            {
                                                "example_id": "5ed78533-48b4-42c5-9897-d71f788c734a",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Die Gruppe stand nun im Halbkreis um Roberts Tisch versammelt, der den Aufzug nicht ohne Verlegenheit betrachtet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "051fca42-523f-426e-b1ca-078f6d12aa40",
                        "source_entry_id": "bd952315-0c9e-3937-afe0-1bec13e2f491",
