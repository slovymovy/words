                "senses": [
                    {
                        "sense_id": "0b57ecbb-5c9d-31ac-9638-ca735047eb5d",
                        "entry_id": "1fa46180-52c5-3ec6-967f-297d0fb00036",
                        "glosses": [
                            "Action de facetter une pierre précieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086cb446-34d2-496f-bfe3-a333275a2e3f",
                                "sense_id": "0b57ecbb-5c9d-31ac-9638-ca735047eb5d",
                                "text": "Le travail de la taille passe par plusieurs techniques : le façonnage, le clivage, le sciage, le débitages, le facettage, le polissage pour donner au diamant brut la forme, l’éclat, la brillance qui convient aux goûts des utilisateurs."
                            },
                            {
                                "example_id": "c2925c77-eeee-4b9c-951a-428197edec2d",
                                "sense_id": "0b57ecbb-5c9d-31ac-9638-ca735047eb5d",
                                "text": "D’où l’importance du facettage : en multipliant le nombre de facettes, on magnifie les propriétés optiques du diamant."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b9ffa94-10e4-3f39-94d0-b361e032d4ed",
                        "entry_id": "1fa46180-52c5-3ec6-967f-297d0fb00036",
                        "glosses": [
                            "Procédé d'enlèvement de parties d'un polygone, d'un polyèdre ou d'un polytope, sans créer de nouveaux sommets."
                        ],
                        "tags": [],
                        "examples": []
                    }
