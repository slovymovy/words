                    {
                        "sense_id": "ab696d17-e2d7-33b8-b33d-8cd67b2d2cea",
                        "entry_id": "582238b9-33df-3360-8852-5002dbf48ac1",
                        "glosses": [
                            "Action d’aiguilleter ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccc8950a-d841-4259-ba6c-ac35668ecc3a",
                                "sense_id": "ab696d17-e2d7-33b8-b33d-8cd67b2d2cea",
                                "text": "Faire un aiguilletage."
                            },
                            {
                                "example_id": "9953139a-4ab2-4ec7-9426-cf2452aea684",
                                "sense_id": "ab696d17-e2d7-33b8-b33d-8cd67b2d2cea",
                                "text": "En ce qui concerne les non-tissés, les industriels recherchent des fibres longues (optimum à 20 cm) et très propres pour éviter l’encrassement des aiguilles qui procèdent à l’aiguilletage en fin de ligne."
                            }
                        ]
                    },
                    {
                        "sense_id": "79b4e216-fb80-3070-83ae-0de4cb820d23",
                        "entry_id": "582238b9-33df-3360-8852-5002dbf48ac1",
                        "glosses": [
                            "Procédé industriel qui consiste à faire passer des touffes de fils à travers une trame au moyen d'un crochet de manière à former un feutre, ce procédé est utilisé pour la fabrication des moquettes nommées aiguilleté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f7ac77-62d0-4f9b-95c9-c16c6f7a151b",
                                "sense_id": "79b4e216-fb80-3070-83ae-0de4cb820d23",
                                "text": "Établissements dont l'activité principale est le tissage, le tuftage et l'aiguilletage de tapis, de moquettes et de carpettes de laine, de coton, de fibres chimiques ou d'un mélange de ces matières, ou du jute, de fibres de coco et autres fibres."
                            }
                        ]
                    }
