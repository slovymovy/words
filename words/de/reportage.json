            "senses": [
                {
                    "sense_id": "dcab2216-9957-3da0-baee-d8aecdebb333",
                    "sense_definition": "Journalistische Darstellungsform, bei der ein Reporter vor Ort ist und ein Geschehen lebendig und anschaulich schildert.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "journalismus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Journalistin schrieb eine preisgekrönte <w>Reportage</w> über die Lebensbedingungen in der Krisenregion."
                        },
                        {
                            "text": "Für ihre neue <w>Reportage</w> recherchierte die Autorin mehrere Wochen lang direkt vor Ort."
                        }
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "eine Reportage schreiben",
                        "eine spannende Reportage"
                    ]
                },
                {
                    "sense_id": "e8bb718f-50cd-3410-a254-30986cfd5823",
                    "sense_definition": "Dokumentarischer Beitrag im Fernsehen oder Hörfunk über ein aktuelles gesellschaftliches oder politisches Thema.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "journalismus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gestern Abend lief im Fernsehen eine interessante <w>Reportage</w> über den Klimawandel."
                        },
                        {
                            "text": "Der Sender plant eine ausführliche <w>Reportage</w> über das Bildungssystem."
                        }
                    ],
                    "common_phrases": [
                        "eine Reportage senden",
                        "eine Reportage im Fernsehen"
                    ]
                },
                {
                    "sense_id": "418d8b9a-2ce5-37b3-aa7e-7d982c828a1f",
                    "sense_definition": "Laufende Berichterstattung und Live-Kommentierung eines aktuellen Ereignisses, besonders im Sport.",
