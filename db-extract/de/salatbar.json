                ],
                "senses": [
                    {
                        "sense_id": "5f23723b-0e2b-39d4-872b-cd760d151f26",
                        "entry_id": "9ec7feab-0efe-37a6-9957-3aa5a2513f05",
                        "glosses": [
                            "eine Art Tischplatte in Lokalen, Cafés oder Ähnlichem, auf der sich verschiedene Salate befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c3e9b61-1b30-4ab1-b248-5b69364e3867",
                                "sense_id": "5f23723b-0e2b-39d4-872b-cd760d151f26",
                                "text": "„Während ich sonst gern Spareribs mit Röstkartoffelecken esse oder gebratene Schweinshaxe mit Jus, lade ich mir nun an der Salatbar geriebene Möhren und Feta auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cc1353bc-dd24-3f7e-82d2-788eae07d60f",
                        "entry_id": "9ec7feab-0efe-37a6-9957-3aa5a2513f05",
                        "glosses": [
                            "Lokalität, in der vorwiegend Salate zum Essen angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46cac361-b347-4e47-a330-cd061271de9d",
                                "sense_id": "cc1353bc-dd24-3f7e-82d2-788eae07d60f",
                                "text": "„Über die Jahre baute sie ihr Geschäft zu einer Kette aus sieben Eisdielen und einer Salatbar aus; […].“"
                            },
                            {
                                "example_id": "7dd51fa0-31cc-406b-8154-0b4692e6d7d6",
                                "sense_id": "cc1353bc-dd24-3f7e-82d2-788eae07d60f",
                                "text": "„Kaum habe ich mich mittags so weit erholt, dass ich in einer Salatbar einen kleinen Imbiss zu mir nehmen kann, bricht mir ein Teil eines Backenzahns heraus.“"
                            },
                            {
                                "example_id": "a3083e4c-8cfa-48b0-9a98-7f91ca251f0e",
                                "sense_id": "cc1353bc-dd24-3f7e-82d2-788eae07d60f",
                                "text": "„Sie hörte, dass einige Stimmen lauter wurden, als man diskutierte, ob man chinesisch essen oder in eine Salatbar gehen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
