                                        "glosses": [
                                            "der Hauptwirkstoff von Hanf (Cannabis)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb8e42a0-9165-4cef-b649-785e2022da86",
                                                "sense_id": "d141f015-9e4f-35ff-9458-3eef681a9f8c",
                                                "text": "„Tetrahydrocannabinol liegt in der Cannabis-Pflanze überwiegend als THC-Säure vor.“"
                                            },
                                            {
                                                "example_id": "809bda82-200d-494f-8411-bfe6194ebcd0",
                                                "sense_id": "d141f015-9e4f-35ff-9458-3eef681a9f8c",
                                                "text": "„Vielleicht hätte ihm die beruhignde Wirkung von Tetrahydrocannabinol auch gut getan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
