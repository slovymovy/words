{
    "word_family": [
        "mobster"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15ea386f-49d3-3a0c-b80c-629a3c9341a6",
                    "sense_definition": "A large, disorderly, and often violent group of people.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry <w>mob</w> gathered outside the government building to protest the new law."
                        },
                        {
                            "text": "Police struggled to control the <w>mob</w> as it moved through the city streets."
                        }
                    ],
                    "common_phrases": [
                        "angry mob"
                    ]
                },
                {
                    "sense_id": "d9067a9a-80a4-36e5-b3ee-8aa850ac4a07",
                    "sense_definition": "A criminal organization involved in illegal activities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>mob</w> controlled all the illegal gambling in the neighborhood."
                        },
                        {
                            "text": "He was afraid to testify against the <w>mob</w> because of their reputation for violence."
                        }
                    ],
                    "synonyms": [
                        "mafia",
                        "Mafia"
                    ]
                },
                {
                    "sense_id": "8866f537-104d-351e-80e1-3ecf289ad75f",
                    "sense_definition": "A computer-controlled character in a video game that players fight.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player had to defeat every <w>mob</w> in the dungeon to reach the final boss."
                        },
                        {
                            "text": "We need to clear out the <w>mob</w> before we can safely cross the bridge."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in gaming context."
                        }
                    ]
                },
                {
                    "sense_id": "1aec4406-84d6-313f-ba19-49d8c2f31de4",
                    "sense_definition": "A large group of animals, such as kangaroos or cattle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>mob</w> of kangaroos was grazing in the field near the road."
                        },
                        {
                            "text": "The farmer moved his <w>mob</w> of cattle to the higher pasture for the winter."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Australian English."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25956671-acb7-31f2-8c8d-2e34d5201a21",
                    "sense_definition": "To crowd around someone in a large group, often in an excited or aggressive way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crowding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous actor was <w>mobbed</w> by fans as soon as he stepped out of the car."
                        },
                        {
                            "text": "Reporters <w>mobbed</w> the politician to get a comment on the recent scandal."
                        }
                    ],
                    "common_phrases": [
                        "mobbed by fans"
                    ]
                },
                {
                    "sense_id": "24607462-2cca-3f88-9f89-457703c89468",
                    "sense_definition": "To fill a place by crowding into it in large numbers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crowding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Shoppers <w>mobbed</w> the store during the annual holiday sale."
                        },
                        {
                            "text": "Thousands of people <w>mobbed</w> the stadium for the championship game."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0c32fd6d-8741-3430-8cdb-d8f59c72e717",
                    "sense_definition": "A specific criminal organization, especially the Italian-American Mafia.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police have been investigating the activities of the <w>Mob</w> for years."
                        },
                        {
                            "text": "He was warned not to get involved with the <w>Mob</w> if he wanted to stay safe."
                        }
                    ],
                    "synonyms": [
                        "mafia",
                        "Mafia"
                    ],
                    "common_phrases": [
                        "the Mob"
                    ]
                }
            ]
        }
    ]
}