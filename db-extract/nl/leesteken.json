                        "entry_id": "626deec2-14b4-3176-b0f4-7df30608f52a",
                        "glosses": [
                            "een onuitgesproken teken dat aan schrijftaal wordt toegevoegd om de zinsstructuur te verhelderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "741d482b-c620-4a28-9e26-d177489ba525",
                                "sense_id": "b5c7ccca-1317-387b-9f05-440a363ca46b",
