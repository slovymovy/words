        "fr-extract.jsonl": [
            {
                "entry_id": "84a23155-5dc8-3725-aceb-23c187b70b4a",
                "word": "sourdement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f473aa22-60ff-356a-8a69-b046a539ae10",
                        "entry_id": "84a23155-5dc8-3725-aceb-23c187b70b4a",
                        "glosses": [
                            "D’une manière sourde, peu retentissante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b29c99f3-6449-4beb-b016-f251cfa94773",
                                "sense_id": "f473aa22-60ff-356a-8a69-b046a539ae10",
                                "text": "Elle [la mer] grondait sourdement, et ses flots n’étaient presque plus que comme les sillons qu’on trouve dans un champ labouré."
                            },
                            {
                                "example_id": "1e73ebcd-a46f-4ea4-928d-c5e241805c61",
                                "sense_id": "f473aa22-60ff-356a-8a69-b046a539ae10",
                                "text": "Quelque temps après, les malades croient entendre la voix d’Esculape, soit qu’elle leur parvienne par quelque artifice ingénieux, soit que le ministre, revenu sur ses pas, prononce sourdement quelques paroles autour de leur lit […]"
                            },
                            {
                                "example_id": "874199c9-568e-4961-976c-150b7fc27075",
                                "sense_id": "f473aa22-60ff-356a-8a69-b046a539ae10",
                                "text": "Tantôt court sur la plage un long mugissement,\nEt les noires forêts murmurent sourdement."
                            }
                        ]
                    },
                    {
                        "sense_id": "88abb282-3dc4-3e44-b889-7b4a6a034096",
                        "entry_id": "84a23155-5dc8-3725-aceb-23c187b70b4a",
                        "glosses": [
                            "D’une manière secrète et cachée."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b8eb4b07-adb8-4d16-ad94-18b62588fbcc",
                                "sense_id": "88abb282-3dc4-3e44-b889-7b4a6a034096",
                                "text": "La reine prit ce conseil en bonne part, et Frédégonde se mit à préparer sourdement, à force d’intrigues, le piège qu’elle voulait lui dresser."
                            },
                            {
                                "example_id": "506f9833-2925-4f0d-b7b6-8eb33b60ec61",
                                "sense_id": "88abb282-3dc4-3e44-b889-7b4a6a034096",
                                "text": "La femme de l’ami [la reine] a fort pleuré ; on a dit sourdement qu’elle irait au voyage, si son mari y allait."
                            },
                            {
                                "example_id": "689a1cef-df16-486d-9f79-87036fde9ea4",
                                "sense_id": "88abb282-3dc4-3e44-b889-7b4a6a034096",
                                "text": "Ainsi tout ce qu’on fait contre M. de Cambrai est un attentat ; tout ce qu’il fait sourdement est bon."
                            },
                            {
                                "example_id": "efdf8acd-b775-45e2-b77c-93e14ffa3cc5",
                                "sense_id": "88abb282-3dc4-3e44-b889-7b4a6a034096",
                                "text": "Cette fatalité [les lois contre les protestants], destructive de la population, de la paix et du bien de l’État, réputée autrefois nécessaire, désole sourdement la France depuis près de cent années."
                            },
                            {
                                "example_id": "e0cac63e-6b0f-4a62-989f-1e099888c945",
                                "sense_id": "88abb282-3dc4-3e44-b889-7b4a6a034096",
                                "text": "[…] il [Maupertuis] a fait son métier de perfide, en intéressant sourdement l’amour-propre du roi [Frédéric II] contre moi."
                            },
                            {
                                "example_id": "9777a387-90d3-4cc3-98bf-d18e694cf1f6",
                                "sense_id": "88abb282-3dc4-3e44-b889-7b4a6a034096",
                                "text": "Votre discours est si beau, que le cardinal de Fleuri vous aurait persécuté, mais sourdement et poliment, à son ordinaire."
                            },
                            {
                                "example_id": "e899f922-210f-4b06-bcb7-55e8499ff557",
                                "sense_id": "88abb282-3dc4-3e44-b889-7b4a6a034096",
                                "text": "Les financiers les plus riches jouissaient sourdement de leur opulence."
                            }
                        ]
                    },
                    {
                        "sense_id": "41c9ba9d-1bd8-31fc-80ad-41db4bb1acb3",
                        "entry_id": "84a23155-5dc8-3725-aceb-23c187b70b4a",
                        "glosses": [
                            "D’une manière peu éclatante, peu marquée."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2f849c0c-20c4-4bbb-84fe-66bd6871eda3",
                                "sense_id": "41c9ba9d-1bd8-31fc-80ad-41db4bb1acb3",
                                "text": "Il [un oiseau] a tout le dessus du corps olivâtre foncé, varié sourdement par des ondes d’un brun plus sombre."
                            },
                            {
                                "example_id": "e0d41805-e635-4991-b071-2fe7959d583e",
                                "sense_id": "41c9ba9d-1bd8-31fc-80ad-41db4bb1acb3",
                                "text": "Des chemins de fer caducs, pierres concassées où s'affolent les herbes qu'on doit retirer, des barres d'acier sourdement entretenues, des traverses."
                            }
                        ]
                    }
                ],
