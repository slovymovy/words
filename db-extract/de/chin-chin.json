                                        "entry_id": "5f58e88b-b979-3a0c-a0ea-3267b8d8098b",
                                        "glosses": [
                                            "To say 'chin-chin'."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "842df8a8-8170-45fc-b182-23b213a038ac",
                                                "sense_id": "6ba4144f-334f-353d-91b8-3f8703d91505",
                                                "text": "We ‘chin-chinned’ over foaming beakers."
                                            },
                                            {
                                                "example_id": "590dc69c-11d4-4150-84f4-ee77ef951364",
                                                "sense_id": "6ba4144f-334f-353d-91b8-3f8703d91505",
                                                "text": "For the sake of appearances we chin-chinned and tried to look gay."
                                            }
                                        ]
                                    }
