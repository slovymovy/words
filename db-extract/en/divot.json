                                        "sense_id": "a679ea28-885e-3a56-af39-5d0037839b2e",
                                        "entry_id": "c74058ac-c6b4-3d41-bd16-124b14387b70",
                                        "glosses": [
                                            "Motte de terre ou de gazon enlevée par la tête de la canne au moment de l’impact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb172f99-aabf-4368-83fa-9ddc18007834",
                                                "sense_id": "a679ea28-885e-3a56-af39-5d0037839b2e",
                                                "text": "Il avait ramassé son divot et il le brandissait comme un trophée. Puis il revint sur ses pas pour le replacer à l'endroit où il l'avait arraché."
                                            },
                                            {
                                                "example_id": "0315a263-0923-490d-9e99-3680bdba6866",
                                                "sense_id": "a679ea28-885e-3a56-af39-5d0037839b2e",
                                                "text": "[…], ce qui l'emportait chez Sebby, c'était toujours ce sentiment de faire corps avec son élément, au point de ressentir personnellement la blessure d'un terrain maltraité par des vandales, écorché de divots, morceaux de gazon arrachés comme des lambeaux de chair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03d2d32c-46e5-438e-9cea-bae28af54624",
