                ],
                "senses": [
                    {
                        "sense_id": "bbad4319-25b1-355f-9c95-2442804268ed",
                        "entry_id": "8d728620-1591-328e-bf01-58a189db6b30",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b43fed0-7e1c-45dd-b79c-bbc444fef096",
                                "sense_id": "bbad4319-25b1-355f-9c95-2442804268ed",
                                "text": "Frau Stanley ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3a1a1d94-2212-4916-9b93-698929869a23",
                                "sense_id": "bbad4319-25b1-355f-9c95-2442804268ed",
                                "text": "Herr Stanley wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "02a4756b-509d-4720-ad9f-ad5c546a9fa4",
                                "sense_id": "bbad4319-25b1-355f-9c95-2442804268ed",
                                "text": "Die Stanleys fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e11fc0da-1cfb-4e28-9937-06b81ad73fa4",
                                "sense_id": "bbad4319-25b1-355f-9c95-2442804268ed",
                                "text": "Der Stanley trägt nie die Schals, die die Stanley ihm strickt."
                            },
                            {
                                "example_id": "9e191f22-25bc-4411-97c0-0608d30c51f4",
                                "sense_id": "bbad4319-25b1-355f-9c95-2442804268ed",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stanley kommt, geht der Herr Stanley.“"
                            },
                            {
                                "example_id": "0ce8f292-709e-4f64-bb60-3c217d360e37",
                                "sense_id": "bbad4319-25b1-355f-9c95-2442804268ed",
                                "text": "Stanley kommt und geht."
                            },
                            {
                                "example_id": "c6028095-569f-4a12-a41e-cabb482046d9",
                                "sense_id": "bbad4319-25b1-355f-9c95-2442804268ed",
                                "text": "Stanleys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
