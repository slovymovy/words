                    {
                        "sense_id": "937c41b7-0611-3ccb-b47e-41339db3b3a5",
                        "entry_id": "8ac2791a-48d5-318c-99a0-31fc19eceb94",
                        "glosses": [
                            "Zustand der Umwelt, des ökologischen Systems hinsichtlich verschiedener Gesichtspunkte, die Einfluss auf die Lebensqualität haben"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "5df0b17c-b61c-45f9-a014-e32ab6af08ff",
                                "sense_id": "937c41b7-0611-3ccb-b47e-41339db3b3a5",
                                "text": "„Da Bärtierchen sehr empfindlich auf Umweltgifte, insbesondere Schwefeltrioxid, reagieren, gibt es Ideen, die Tiere als Indikatoren für die Umweltqualität eines Standorts einzusetzen.“"
                            },
                            {
                                "example_id": "fc0ab13e-8bb7-4815-a20a-ae1ab3904b91",
                                "sense_id": "937c41b7-0611-3ccb-b47e-41339db3b3a5",
                                "text": "„Bioindikatoren sind Organismen, die bestimmte Umweltqualitäten anzeigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
