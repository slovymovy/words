                "senses": [
                    {
                        "sense_id": "a67505e5-b660-374d-b219-94f0339b6dd3",
                        "entry_id": "76ccc06d-613b-3bcf-8ba2-e29b4561ee49",
                        "glosses": [
                            "Muster für eine Arbeitsweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee196f0-c992-4a8f-bc64-8932ce1a099f",
                                "sense_id": "a67505e5-b660-374d-b219-94f0339b6dd3",
                                "text": "„Leon bearbeitete auf meiner Arbeitsvorlage seine Matheaufgaben in einer Vertretungsstunde zwar selbstständig und auf einem höheren Niveau, jedoch ohne dabei das geforderte Geodreieck zu benutzen.“"
                            },
                            {
                                "example_id": "8bc2289f-a7d9-407c-9597-1858ec9ca819",
                                "sense_id": "a67505e5-b660-374d-b219-94f0339b6dd3",
                                "text": "„Im vierten Teil finden Sie Arbeitsvorlagen und Übungen für Ihre Seminare und Einzelsettings.“"
                            },
                            {
                                "example_id": "d3811e97-11ef-4dc4-a7d0-1c720bb1df00",
                                "sense_id": "a67505e5-b660-374d-b219-94f0339b6dd3",
                                "text": "„Im Gegensatz dazu werden am Bildschirmarbeitsplatz drei Arbeitsmittel, nämlich Bildschirm, Tastatur und Arbeitsvorlage gleichzeitig in schnellem Wechsel genutzt.“"
                            },
                            {
                                "example_id": "65559af4-16d5-47f8-8a7f-0f07e8b19e49",
                                "sense_id": "a67505e5-b660-374d-b219-94f0339b6dd3",
                                "text": "„Der Entwurf solle mehr als Gedankenspiel verstanden werden, nicht als Arbeitsvorlage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
