                "senses": [
                    {
                        "sense_id": "bb85eda5-941f-342b-94b7-14cc665c2069",
                        "entry_id": "4bd74931-9e9f-358c-a629-cd080fe924f5",
                        "glosses": [
                            "Mettre en œuvre la technique qui consiste à enlever sur les terrains où s’accumule la matière organique la couche superficielle du sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd0e4b61-ec74-4570-9b8d-51dd6d30ef69",
                                "sense_id": "bb85eda5-941f-342b-94b7-14cc665c2069",
                                "text": "Les véritables « terres de bruyère » s’extraient en étrépant des landes de bruyère ou de callune.\nPropositions de restauration :\n- arracher les peupliers…, avec les problèmes d’incompréhension des propriétaires,\n- étreper pour enlever la couverture de graminées et se rapprocher de la nappe phréatique,\n- permettre la recolonisation par les végétaux, sous suivi scientifique."
                            }
                        ]
                    }
