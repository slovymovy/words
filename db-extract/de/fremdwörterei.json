                "senses": [
                    {
                        "sense_id": "907990d5-8ee1-32b6-be16-425ae0e5f8fc",
                        "entry_id": "0f56bc50-ea8c-38f1-b156-3c777e91b055",
                        "glosses": [
                            "starker/zu starker Gebrauch von Fremdwörtern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3229e0b2-f79b-4e3b-b48f-dacf035f6c35",
                                "sense_id": "907990d5-8ee1-32b6-be16-425ae0e5f8fc",
                                "text": "„So zieht die Fremdwörterei eine Bildungsmauer mitten durch unser Volk.“"
                            },
                            {
                                "example_id": "3208197b-6174-4fe0-bf57-08bd0c8eb910",
                                "sense_id": "907990d5-8ee1-32b6-be16-425ae0e5f8fc",
                                "text": "„Stellt die treffsichere Kürze also das entscheidende Gestaltungskriterium dar, muß die erste Kontrafaktur als besonders gelungen angesehen werden - nicht als Beispiel für Fremdwörterei, sondern für Weitschweifigkeit, Umstandskrämerei und dem Gegenstand nicht angemessene Überspanntheit.“"
                            }
                        ],
