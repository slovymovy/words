                    {
                        "sense_id": "a72a35ea-7612-32ce-bb45-aed9949615a9",
                        "entry_id": "a2189d37-9fbe-309c-a93d-d97b18df3164",
                        "glosses": [
                            "Krieg zwischen Chile einerseits und Bolivien und Peru andererseits wegen der vertragswidrigen Besteuerung chilenischer Salpeterunternehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10245ee1-1c10-478a-8260-3d128ab1d2b4",
                                "sense_id": "a72a35ea-7612-32ce-bb45-aed9949615a9",
                                "text": "„Chile ließ sich die einem alten Vertrag widersprechende Steuererhöhung nicht gefallen und marschierte im Februar 1879 in Antofagasta ein, um seine Ansprüche zu wahren, woraufhin Bolivien seinem Nachbarland am I. März den Krieg erklärte, der später als Salpeterkrieg in die Geschichtsbücher eingehen sollte.“"
                            }
                        ],
