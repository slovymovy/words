                                                "sense_id": "eff0241f-885b-3a83-8417-5f5af87533ce",
                                                "text": "the legal brotherhood"
                                            },
                                            {
                                                "example_id": "932955f5-7e17-4255-a6e0-79282d72bb1c",
                                                "sense_id": "eff0241f-885b-3a83-8417-5f5af87533ce",
