                        "entry_id": "ded4f177-1fba-3d46-b482-4716f72d50ce",
                        "glosses": [
                            "gedrag dat niet netjes is; gedrag dat onbehoorlijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efb97019-df77-4d71-a915-d9a8e620f157",
                                "sense_id": "0c90dc8a-c08b-31d9-88f5-f3a149aa70bf",
                                "text": "Ze legde haar hand op zijn lippen en al voelde ze de ongepastheid van haar gebaar, het kon haar niks schelen."
                            },
                            {
                                "example_id": "96ee08a3-a951-4193-821f-3c8916485f85",
                                "sense_id": "0c90dc8a-c08b-31d9-88f5-f3a149aa70bf",
                                "text": "Buckingham Palace heeft alle aantijgingen \"van ongepastheid met minderjarigen\" aan het adres van de prins altijd afgedaan als \"vals en zonder enige basis\"."
                            }
                        ]
                    }
                ],
                "translations": [
