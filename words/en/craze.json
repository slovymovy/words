                            {
                                "target_lang_word": "помешательство",
                                "target_lang_sense_clarification": "психическое расстройство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c51f692c-2647-3c3d-8e84-1cf87c64680c",
                    "sense_definition": "A fine crack in the glaze or enamel of pottery caused by heat",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_crack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collector noticed a small <w>craze</w> in the enamel of the antique vase.",
                            "target_lang_translations": {
                                "ru": "Коллекционер заметил небольшую <w>трещинку</w> на эмали антикварной вазы."
                            }
                        },
                        {
                            "text": "Irregular heating during the firing process can cause a <w>craze</w> to form on the ceramic surface.",
                            "target_lang_translations": {
                                "ru": "Неравномерный нагрев во время обжига может привести к появлению <w>цека</w> на керамической поверхности."
                            }
                        }
                    ],
                    "synonyms": [
                        "crack",
                        "fissure"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical term used in ceramics and pottery"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкая трещина на глазури или эмали керамики"
                    },
                    "translations": {
                        "ru": [
