                "senses": [
                    {
                        "sense_id": "fd71d5b9-c42f-3411-8fa2-9695e1e55fd1",
                        "entry_id": "18c62272-54f4-3752-bbd7-6c583b13974f",
                        "glosses": [
                            "neue Auflage eines bereits vorher erschienenen Druckwerks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "941074ba-d7c6-4c74-b74a-9f447e492049",
                                "sense_id": "fd71d5b9-c42f-3411-8fa2-9695e1e55fd1",
                                "text": "Wegen der großen Nachfrage wurde schon nach kurzer Zeit ein Neudruck nötig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0b27ba8-dc5e-38d1-a574-ed2e8ca09099",
                        "entry_id": "18c62272-54f4-3752-bbd7-6c583b13974f",
                        "glosses": [
                            "alle neuen Drucke eines Postwertzeichens, welche von einer staatlichen Postverwaltung mit unveränderten Original– Druckstöcken oder Druckplatten hergestellt wurden"
                        ],
                        "tags": [
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "2fc9e607-97bf-4266-aa97-e0097d80f693",
                                "sense_id": "d0b27ba8-dc5e-38d1-a574-ed2e8ca09099",
                                "text": "Von staatlichen Postverwaltungen werden Neudrucke in Auftrag gegeben."
                            },
                            {
                                "example_id": "2954471a-90d2-4089-951a-4bbeba59ae2b",
                                "sense_id": "d0b27ba8-dc5e-38d1-a574-ed2e8ca09099",
                                "text": "Sammler verwenden häufig Neudrucke für Studienzwecke."
                            },
                            {
                                "example_id": "592264fe-3821-4109-90f8-e8dc3fa9b730",
                                "sense_id": "d0b27ba8-dc5e-38d1-a574-ed2e8ca09099",
                                "text": "„Der Druckauftrag für den Neudruck der 3-Pfennigmarke erfolgte am 15. April 1880.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
