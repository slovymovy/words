                    {
                        "sense_id": "e5367031-9269-3683-b108-8c232a1108c0",
                        "entry_id": "5a44dd9e-5559-31e3-8bcc-6ea804e7e07e",
                        "glosses": [
                            "alleen met de grootste voorzichtigheid en tact bespreekbaar"
