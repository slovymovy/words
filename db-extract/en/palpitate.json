                "senses": [
                    {
                        "sense_id": "27df74d1-d2d8-3d13-92ed-038cb4b002f9",
                        "entry_id": "c34e20f4-3692-3acd-ba21-c518c6d18be6",
                        "glosses": [
                            "To beat strongly or rapidly; said especially of the heart."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1d2945c5-a29a-49c5-8673-084b4f635aae",
                                "sense_id": "27df74d1-d2d8-3d13-92ed-038cb4b002f9",
                                "text": "When he just looks at me, my heart begins to palpitate with excitement."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c9e624f-f16c-3827-ba5b-256e655ac0ea",
                        "entry_id": "c34e20f4-3692-3acd-ba21-c518c6d18be6",
                        "glosses": [
                            "To cause to beat strongly or rapidly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "94e202aa-9ee1-4a89-9988-401192351178",
                                "sense_id": "9c9e624f-f16c-3827-ba5b-256e655ac0ea",
                                "text": "The allergy medicine palpitates my heart."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6376e91-aade-365e-9e66-76239dc5958c",
                        "entry_id": "c34e20f4-3692-3acd-ba21-c518c6d18be6",
                        "glosses": [
                            "To shake tremulously"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4fabde4b-2bdc-43ac-9c1d-6517e23b64cb",
                                "sense_id": "d6376e91-aade-365e-9e66-76239dc5958c",
                                "text": "I was now so bruised, so batter'd, so spent with this over-match, that I could hardly stir, or raise myself, but lay palpitating",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            },
                            {
                                "example_id": "d5b9559d-c057-4067-975a-602dd5147806",
                                "sense_id": "d6376e91-aade-365e-9e66-76239dc5958c",
                                "text": "“Two or three months more went by ; the public were eagerly awaiting the arrival of this semi-exotic claimant to an English peerage, and sensations, surpassing those of the Tichbourne case, were looked forward to with palpitating interest.[…]”"
                            }
                        ]
                    }
