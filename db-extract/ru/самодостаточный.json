                                        "sense_id": "f83c98e5-88cd-3f0b-9c75-4a91c631370d",
                                        "entry_id": "9f0c6b92-f7f0-303a-8d4e-95e3bb06dd78",
                                        "glosses": [
                                            "Existing independent of any extrinsic sustaining force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b220951-6128-4510-9685-d1f4955031d3",
                                                "sense_id": "f83c98e5-88cd-3f0b-9c75-4a91c631370d",
                                                "text": "Campbell exquisitely says, \"'Tis distance lends enchantment to the view:\" and let the heart be thankful from its inmost depths for that imaginative and self-existent faculty which first lends enchantment to the distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f232dce0-0d97-4ca3-a3b3-8ff0baed5bfa",
                        "source_entry_id": "d0fba680-a829-3915-8703-6c8af03e4efc",
                        "source_sense_id": "0de8e3c2-ed03-3748-8dea-43fdacc3c17b",
