                    {
                        "sense_id": "95b9d40e-f746-3ff0-bdc8-b50f91ebfa48",
                        "entry_id": "6fe4bc44-e290-3f97-871b-ad0e80fa2843",
                        "glosses": [
                            "pniak (część nadziemna), który pozostaje po ścięciu drzewa, wraz z korzeniami (częścią podziemną)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "104b9182-4db8-49b7-a2a3-5f1c68e290a5",
                                "sense_id": "95b9d40e-f746-3ff0-bdc8-b50f91ebfa48",
                                "text": "Po ścięciu drzewa w ogrodzie pozostał brzydki karcz."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cbd5b649-b3d7-3baa-bc91-b748c841603b",
