                    {
                        "sense_id": "f15d0091-139f-3003-81ee-5f70cc26ec14",
                        "entry_id": "d6698335-3ef7-30bd-9bad-dc41ca2022a0",
                        "glosses": [
                            "государство в Центральной Америке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a308a63-b8d6-42da-b219-7667b97edcbf",
                                "sense_id": "f15d0091-139f-3003-81ee-5f70cc26ec14",
                                "text": "В Гватемалу я въехал буквально с чёрного хода, через бывшую английскую колонию Белиз и наиболее глухой и отдаленный гватемальский департамент Петен."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab796d6a-1cad-4d64-997a-672bb0f5cead",
                        "source_entry_id": "d6698335-3ef7-30bd-9bad-dc41ca2022a0",
                        "source_sense_id": "f15d0091-139f-3003-81ee-5f70cc26ec14",
                        "target_lang_word": "Guatemala",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guatemala",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f40df8e2-10df-30bb-9f97-95ef6141cec1",
                                        "entry_id": "e6890da1-72ff-339d-9ec8-9686de0a0dc3",
                                        "glosses": [
                                            "A country in Central America. Official name: Republic of Guatemala, a Central American country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45c40c64-ff02-4432-a976-2c199e2eb8c6",
                                                "sense_id": "f40df8e2-10df-30bb-9f97-95ef6141cec1",
                                                "text": "Foreign nationals who arrive in Guatemala through deportation flights will be repatriated to their home countries, Arévalo said, adding that the US and Guatemala would continue to have talks on how the process would work and how the US would cooperate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26db9245-c0d1-38ad-8c2a-268ada04b6e7",
                                        "entry_id": "e6890da1-72ff-339d-9ec8-9686de0a0dc3",
                                        "glosses": [
                                            "A department of Guatemala."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "806fe92c-fae3-4efb-9e0f-ee8c1ae96e70",
                        "source_entry_id": "d6698335-3ef7-30bd-9bad-dc41ca2022a0",
                        "source_sense_id": "f15d0091-139f-3003-81ee-5f70cc26ec14",
                        "target_lang_word": "Guatemala",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
