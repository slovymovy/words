                "senses": [
                    {
                        "sense_id": "d3b61682-aa6f-3c03-a313-bdb8ab64615b",
                        "entry_id": "2a5bfc25-9746-3c6f-8603-0e06fd1f8cef",
                        "glosses": [
                            "Vertreter der Haie, Art der Makrelenhaie (Lamnidae)"
                        ],
                        "tags": [
                            "Ichthyologie"
                        ],
                        "examples": [
                            {
                                "example_id": "68568133-393a-4e1a-b387-42314ddfc079",
                                "sense_id": "d3b61682-aa6f-3c03-a313-bdb8ab64615b",
                                "text": "So zeigen sowohl der Weiße Hai als auch der Heringshai Zeichen eines Populationsaufbaus seit Anfang der 2000er Jahre."
                            },
                            {
                                "example_id": "cc624a39-3197-488e-8dca-96f27a89fb5c",
                                "sense_id": "d3b61682-aa6f-3c03-a313-bdb8ab64615b",
                                "text": "„Der Heringshai streift auch durch das Mittelmeer. Er sieht dem Weißen Hai sehr ähnlich, da er mit ihm eng verwandt ist — nur ist er erheblich kleiner und ein flinker Fischräuber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
