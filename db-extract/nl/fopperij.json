                "senses": [
                    {
                        "sense_id": "e1c722c7-5bbb-3226-bd18-0c54fa229243",
                        "entry_id": "210114b1-a6f3-3ead-aad9-e5902a1c46c4",
                        "glosses": [
                            "iets waarmee je iemand probeert te foppen, te bedriegen of beet te nemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eb435d2-c49c-477d-8962-a15920a07d4e",
                                "sense_id": "e1c722c7-5bbb-3226-bd18-0c54fa229243",
                                "text": "Tegenstanders zeggen dat de Grondwet nu via de achterdeur toch is ingevoerd, omdat in het opvolgingsverdrag van Lissabon eigenlijk hetzelfde staat. Is het fopperij?"
                            },
                            {
                                "example_id": "1541eb42-859d-42f2-be40-c5926264dc1a",
                                "sense_id": "e1c722c7-5bbb-3226-bd18-0c54fa229243",
                                "text": "Dit soort fopperij is onverdedigbaar, gezien de maatschappelijke kosten van de overmatige consumptie van suiker, zout en vet. Het Europees Hof van Justitie verbood in 2015 misleidende suggesties op verpakkingen: 'De etikettering van een levensmiddel mag de consument niet misleiden door de indruk te wekken dat het een ingrediënt heeft dat het in werkelijkheid niet bevat.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b165459d-8b45-46b1-bb2f-c1045c4caf7c",
                        "source_entry_id": "210114b1-a6f3-3ead-aad9-e5902a1c46c4",
                        "source_sense_id": "e1c722c7-5bbb-3226-bd18-0c54fa229243",
                        "target_lang_word": "trickery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trickery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                        "entry_id": "b1b463da-bb13-3283-8f90-fb0185249771",
                                        "glosses": [
                                            "Deception, deceit or underhanded behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871907d6-e92c-4c39-8de2-45e79bdc6b6d",
                                                "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                                "text": "[H]e did not wrap his rugged subject in silks and ermines, and other sickly trickeries of phrase."
                                            },
                                            {
                                                "example_id": "e9436b22-cc9b-4f75-9b0e-c58ed05a1925",
                                                "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                                "text": "In trickery, evasion, procrastination, spoliation, botheration, under false pretences of all sorts, there are influences that can never come to good."
                                            },
                                            {
                                                "example_id": "0615eac1-3a39-4bec-b197-27e7e4e05478",
                                                "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                                "text": "The miners found diversions even in his alleged frauds and trickeries . . . and were fond of relating with great gusto his evasion of the Foreign Miners' Tax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66879016-362f-3471-a02f-535f32de41aa",
                                        "entry_id": "b1b463da-bb13-3283-8f90-fb0185249771",
                                        "glosses": [
                                            "The art of dressing up; imposture, pretense."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcd77d8c-a31a-3e6b-9db1-225598845646",
                                        "entry_id": "b1b463da-bb13-3283-8f90-fb0185249771",
                                        "glosses": [
                                            "Artifice; the use of one or more stratagems."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1336742-b3e2-4753-b71c-f427588189a1",
                                                "sense_id": "dcd77d8c-a31a-3e6b-9db1-225598845646",
                                                "text": "French winger Hatem Ben Arfa has also taken plenty of plaudits recently and he was the architect of the opening goal with some superb trickery on the left touchline."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
