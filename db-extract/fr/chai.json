                        ],
                        "examples": [
                            {
                                "example_id": "f036e90d-16cd-4d1c-a428-d49762168f0b",
                                "sense_id": "6bec5e73-cab7-3a10-ba8e-9013c27346bb",
                                "text": "Mis en bouteille dans nos chais.",
                                "translation": "Bottled in our wine cellars.",
                                "english": "Bottled in our wine cellars."
                            },
                            {
                                "example_id": "9928be02-2946-476d-ad3c-7631cc5d5e41",
                                "sense_id": "6bec5e73-cab7-3a10-ba8e-9013c27346bb",
                                "text": "—Maudit grognard! Mais enfin, que voulez-vous faire de ce pauvre tonneau, la fleur de mon chai? Tenez, goûtez ce vin. Comme il est moelleux, corsé, étoffé, velouté, rubané!…"
                            }
                        ]
                    }
