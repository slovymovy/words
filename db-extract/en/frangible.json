                            "comparative"
                        ],
                        "form": "more frangible"
                    },
                    {
                        "form_id": "166c620f-1c63-4c27-a5b5-d3d414fb39d8",
                        "entry_id": "3aba2590-383a-37fa-a885-46f1f88ae3e3",
