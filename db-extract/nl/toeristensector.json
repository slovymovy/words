                        "glosses": [
                            "alle bedrijven en organisaties die betrokken zijn bij het toerisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d5d9085-a0ab-4efd-be77-73a2a7bd88ac",
                                "sense_id": "5a408d13-1815-3655-9f04-b00da5857035",
                                "text": "De schade aan de Italiaanse toeristensector wordt voor dit jaar geschat op 120 miljard euro. 95 procent van de hotels in het land is al sinds februari dicht. In de periode van maart tot en met mei komt dat neer op 30 miljoen minder overnachtingen."
                            },
                            {
                                "example_id": "711b3f58-ff8e-4b7e-a8fc-5c6dea26047d",
                                "sense_id": "5a408d13-1815-3655-9f04-b00da5857035",
                                "text": "De aanhoudende stakingen in Frankrijk hebben de toeristensector in het land hard getroffen. Vandaag werd er voor de veertiende dag op rij gedemonstreerd en dat leidde wederom tot flinke verstoringen op de weg en in het openbaar vervoer. Vooral de hotels en restaurants lijken klappen te krijgen."
                            }
                        ]
                    }
