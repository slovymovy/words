                ],
                "senses": [
                    {
                        "sense_id": "8681f115-9348-33b7-ae0d-6ae0f9f88865",
                        "entry_id": "57f13dc6-483d-3314-b424-c3d745a5d182",
                        "glosses": [
                            "Raum in einem Kino, Theater oder dergleichen, der für die Zuschauer bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc80f15-5ad8-4001-abc8-5390b7b9279b",
                                "sense_id": "8681f115-9348-33b7-ae0d-6ae0f9f88865",
                                "text": "„Denn in dem schmalen, langen Zuschauerraum standen zwei Säulen, die einigen Plätzen die Sicht nahmen, und darauf wollte keiner landen.“"
                            },
                            {
                                "example_id": "42992a45-ec76-45c3-8db2-cc11c4e1b0b4",
                                "sense_id": "8681f115-9348-33b7-ae0d-6ae0f9f88865",
                                "text": "„Im Zuschauerraum lachte er herzlich, und nach der Aufführung gratulierte er hinter den Kulissen - sichtlich bewegt - der ganzen Crew des Theaters Korez.“"
                            },
                            {
                                "example_id": "73c96f9c-e69d-4941-b439-5d9da92d19e5",
                                "sense_id": "8681f115-9348-33b7-ae0d-6ae0f9f88865",
                                "text": "„Ein Röhrenempfänger steht auf der Probebühne des Theaters in der Josefstadt, Melodien und Nachrichtenfetzen dringen in den Zuschauerraum.“"
                            },
                            {
                                "example_id": "c52bad9e-fb91-4262-b824-7ca224f6944c",
                                "sense_id": "8681f115-9348-33b7-ae0d-6ae0f9f88865",
                                "text": "„Langsam breitet sich Ruhe in dem Zuschauerraum aus, es entwickelt sich eine elektrisierende Stille voller Erwartungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
