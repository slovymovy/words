                                "nl": "Mijn resultaten in het laboratorium <w>komen</w> consequent <w>niet overeen</w> met die van jou.",
                                "pl": "Moje wyniki laboratoryjne konsekwentnie <w>różnią się</w> od twoich.",
                                "de": "Meine Ergebnisse im Labor <w>stimmen</w> konsequent nicht mit deinen <w>überein</w>.",
                                "fr": "Mes résultats en laboratoire <w>divergent</w> systématiquement des vôtres.",
                                "it": "I miei risultati in laboratorio <w>non combaciano</w> costantemente con i tuoi.",
                                "cs": "Moje laboratorní výsledky se trvale <w>neshodují</w> s tvými.",
                                "tr": "Laboratuvardaki sonuçlarım seninkilerle sürekli olarak <w>uyuşmuyor</w>.",
                                "es": "Mis resultados en el laboratorio <w>no coinciden</w> constantemente con los tuyos."
                            }
                        },
                        {
                            "text": "The two reports <w>disagree</w> on the final numbers.",
