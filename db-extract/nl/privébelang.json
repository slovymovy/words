                        "examples": [
                            {
                                "example_id": "c37fd2f9-69d1-4bcb-9a2a-8c5c0d91d53a",
                                "sense_id": "5e318290-98ab-36b1-b2d8-6c0286fae3e8",
                                "text": "Milanese zou daarvoor geld hebben aangenomen van een verzekeringsbedrijf. Het Openbaar Ministerie wil hem daarom aanhouden. Het zou dus kunnen dat smeergeld dat is betaald om belastingontduiking ongestraft te laten passeren, ten goede is gekomen aan de privébelangen van de minister van Financiën."
                            },
                            {
                                "example_id": "21e0b6c5-cc4f-4049-b32e-13366dd721a3",
                                "sense_id": "5e318290-98ab-36b1-b2d8-6c0286fae3e8",
                                "text": "De Rijksrecherche stuitte niet op aanwijzingen dat de verdachte ook andere bloedmonsters heeft gemanipuleerd. Justitie vermoedt dat zij uit privébelang heeft gehandeld. De vrouw moet zich ook verantwoorden voor het dronken rijden."
                            }
                        ]
