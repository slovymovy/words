                "senses": [
                    {
                        "sense_id": "2f6d989d-ab15-3c7c-9db7-7d557eed2f6a",
                        "entry_id": "c2dbbf1f-8a57-3a9e-8e67-b8009a920cfd",
                        "glosses": [
                            "Without joy; unhappy, sad."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab4eb34-4d55-4f1c-8211-18af4b339bcd",
                                "sense_id": "2f6d989d-ab15-3c7c-9db7-7d557eed2f6a",
                                "text": "Without Joy, my life is joyless!"
                            },
                            {
                                "example_id": "bfebf136-6867-400b-8fd9-e02e41f14047",
                                "sense_id": "2f6d989d-ab15-3c7c-9db7-7d557eed2f6a",
                                "text": "The Besht preached that the simple man, imbued with native faith and able to pray fervently and wholeheartedly with a sense of joy in his heart, was nearer and dearer to God than the learned but joyless formalist spending his whole life in the study of Talmud."
                            },
                            {
                                "example_id": "9f0cd275-7d18-46fc-a1be-4bb96f303124",
                                "sense_id": "2f6d989d-ab15-3c7c-9db7-7d557eed2f6a",
                                "text": "“It comes from chasing the fun,” says Regan. “A lot of the working-class cinema I grew up watching was so joyless. Endless trauma.”"
                            }
                        ]
                    }
                ],
                "translations": [
