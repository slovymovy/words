                        "sense_id": "85ed64db-75fc-3026-8f89-acb17de170c6",
                        "entry_id": "ef79f0ca-035b-3a5a-af98-7a2bbfc7dade",
                        "glosses": [
                            "een globale, beeldende beschrijving van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad2a5c63-3527-44fc-a7fe-9c3a6dbc2899",
                                "sense_id": "85ed64db-75fc-3026-8f89-acb17de170c6",
                                "text": "Volgens mij hoort het allemaal tot de grote verandering van onze beschaving. Zoveel mogelijk de aandacht op jezelf vestigen door zo hard, zo opzienbarend, zo leuk mogelijk met de deur in huis te vallen. Neem die uitdrukking letterlijk en je hebt een kenschets van onze omgangsvormen."
                            }
                        ]
                    }
