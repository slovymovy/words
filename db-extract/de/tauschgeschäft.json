                        "glosses": [
                            "Handel, bei dem etwas gegen etwas Anderes getauscht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c74eed50-dbe9-44a8-81bb-9c10773b387e",
                                "sense_id": "e0f5f03f-6d94-32ff-a029-9a2234190995",
                                "text": "„Ein Teil der Umstehenden nahm johlend für den Mann mit der Joppe, ein anderer für den mit den Stiefeln Partei, wodurch das Tauschgeschäft, um das es den beiden zweifellos ging, nur noch verwirrter wurde.“"
                            }
                        ],
