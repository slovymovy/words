                    {
                        "translation_id": "aafef87b-94a0-4c9d-9c23-f83934d91a1a",
                        "source_entry_id": "d776d11b-04a0-3446-ae70-9a9a3e6bd154",
                        "source_sense_description": "the lower chamber of the federal parliament of Germany until 1945",
                        "target_lang_word": "Reichstag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reichstag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa3e48a7-0290-30fa-a3b4-a34a929fe389",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fdfe160-9f60-4d6e-a8e3-e4b80c50d129",
                                                "sense_id": "fa3e48a7-0290-30fa-a3b4-a34a929fe389",
                                                "text": "Der schwedische Reichstag bestand 2010 aus 349 Abgeordneten."
                                            },
                                            {
                                                "example_id": "a724535b-6f33-4b84-9bcd-0a6c726ac2d0",
                                                "sense_id": "fa3e48a7-0290-30fa-a3b4-a34a929fe389",
                                                "text": "Im dritten Reich hatte der Reichstag keine gesetzgeberische Kompetenz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "360ae953-2621-3882-9fc5-1c182730f7d8",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen",
                                            "wechselnde Tagungsorte in dem von 754 bis 1806 bestehenden Heiligen Römischen Reich Deutscher Nation"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "873f526a-a1a0-4f38-aabc-73269c9c5970",
                                                "sense_id": "360ae953-2621-3882-9fc5-1c182730f7d8",
                                                "text": "Die Reichstage waren ursprünglich eine Art Heerschau, bei der der König seine Adligen und deren Gefolgsleute musterte."
                                            },
                                            {
                                                "example_id": "600123cc-3f24-48b6-85f2-9d278d1a462c",
                                                "sense_id": "360ae953-2621-3882-9fc5-1c182730f7d8",
                                                "text": "„In Versammlungen wie dem Reichstag nutzten die katholischen Fürsten zudem das Mehrheitswahlrecht, um die Protestanten kaltzustellen.“"
                                            },
                                            {
                                                "example_id": "39dbb0a8-fb0b-467d-91df-916375a7ccee",
                                                "sense_id": "360ae953-2621-3882-9fc5-1c182730f7d8",
                                                "text": "„Das »Hailig Reych und Teutsch Nation« selbst war erst auf dem Reichstag in Frankfurt 1486 in der Landfriedensordnung offiziell auf diese Formel gebracht worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "027c3559-69e5-3733-a557-7ee74455a5aa",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen",
                                            "Übergangskonstrukt von 1848/49 in Österreich"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "958a1b39-29cf-4ca9-8d56-13db72712916",
                                                "sense_id": "027c3559-69e5-3733-a557-7ee74455a5aa",
                                                "text": "Der Reichstag bestand aus 383 Abgeordneten aus den deutschsprachigen und slawischen Kronländern des Kaisertums Österreich, das heißt ohne Vertreter des Königreichs Ungarn."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "8c8e417c-b347-318d-8a59-767a0f1ada10",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen",
                                            "1848/49 geplante Institution der allerdings nie umgesetzten Paulskirchenverfassung"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76936eb3-07ca-485f-bcbc-948c63ce1501",
                                                "sense_id": "8c8e417c-b347-318d-8a59-767a0f1ada10",
                                                "text": "Zu den langwierigen Debatten im Reichstage während der Erarbeitung der Paulskirchenverfassung gehörte diejenige über die endgültige Gestalt des neu zu schaffenden deutschen Nationalstaates."
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "8ab62d5b-db85-388e-8319-428a05806a42",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen",
                                            "Reichstag des Norddeutschen Bundes (1867-1871)"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afdc60eb-9299-4470-a58b-83e336eafc77",
                                                "sense_id": "8ab62d5b-db85-388e-8319-428a05806a42",
                                                "text": "Der Reichstag war das Parlament des Norddeutschen Bundes, das nach dem Deutschen Krieg von 1866 gegründet wurde und bis zur Reichsgründung im Jahre 1871 Bestand hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"1d\""
                                    },
                                    {
                                        "sense_id": "9a5a216f-a786-33b5-9832-06e788c0f949",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen",
                                            "Reichstag des Deutschen Kaiserreiches (1871-1918)"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4d89f1a-b6c8-4ccb-84ec-94192b037037",
                                                "sense_id": "9a5a216f-a786-33b5-9832-06e788c0f949",
                                                "text": "Im Deutschen Kaiserreich verkörperte der Reichstag neben dem Kaiser die Einheit des Reiches."
                                            },
                                            {
                                                "example_id": "99200b5d-2ad8-44ca-a757-c1aafbd105bc",
                                                "sense_id": "9a5a216f-a786-33b5-9832-06e788c0f949",
                                                "text": "„Ebenso wichtig war, für die anstehenden Entscheidungen eine Mehrheit im Reichstag zu organisieren, vor allem für die Bewilligung von Kriegskrediten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1e\""
                                    },
                                    {
                                        "sense_id": "55e382a0-cdad-3508-8ee3-292a187897d5",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen",
                                            "Reichstag der Weimarer Republik (1919-1933)"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e200df46-2e77-45b7-beec-7530f8843998",
                                                "sense_id": "55e382a0-cdad-3508-8ee3-292a187897d5",
                                                "text": "In der Weimarer Republik übernahm der Reichstag diese Tätigkeit von der Weimarer Nationalversammlung, die bis 1920 als Parlament gedient hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"1f\""
                                    },
                                    {
                                        "sense_id": "0758f629-71df-372d-bd2b-84ceb5073c9c",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "Versammlung von Fürsten, Gesandten oder gewählten Abgeordneten auf Reichsebene, zum Beispiel im Deutschen Reich sowie in verschiedenen Königreichen",
                                            "Reichstag zur Zeit des Nationalsozialismus (1933–1945)"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf1fc125-48c4-4881-a8f0-7f2298371fee",
                                                "sense_id": "0758f629-71df-372d-bd2b-84ceb5073c9c",
                                                "text": "Noch während der Zeit des Nationalsozialismus fanden Wahlen zum deutschen Reichstag statt."
                                            },
                                            {
                                                "example_id": "4857f2e5-de23-4c37-a7eb-b082f8a9b110",
                                                "sense_id": "0758f629-71df-372d-bd2b-84ceb5073c9c",
                                                "text": "„In der Nacht des 23. Februar brennt der Reichstag.“"
                                            },
                                            {
                                                "example_id": "c12f61d0-1b32-46f9-9838-ebe9dfb057b8",
                                                "sense_id": "0758f629-71df-372d-bd2b-84ceb5073c9c",
                                                "text": "„Die Entmachtung des Reichstages durch das ‚Ermächtigungsgesetz‘ vom 23. März 1933 und seine Denaturierung zum durch Diäten finanzierten ‚teuersten Gesangverein der Welt‘ zur Ehrung der Staatsspitze löste ebenso wenig Widerstand aus wie das Ende der Parteien im Sommer 1933.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1g\""
                                    },
                                    {
                                        "sense_id": "8c08f182-c5eb-30bc-bba7-3b737141cd29",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "das Gebäude oder der Ort, in dem sich ein Reichstag versammelt"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adf4368a-18e7-4366-a8f8-66be4f587862",
                                                "sense_id": "8c08f182-c5eb-30bc-bba7-3b737141cd29",
                                                "text": "Seit der Wiedervereinigung tritt der deutsche Bundestag im Reichstag in Berlin zusammen."
                                            },
                                            {
                                                "example_id": "c68db2fd-d5b4-4f3c-a881-5088c93856d0",
                                                "sense_id": "8c08f182-c5eb-30bc-bba7-3b737141cd29",
                                                "text": "Der schwedische Reichstag befindet sich in Stockholm."
                                            },
                                            {
                                                "example_id": "1f75852d-6e63-46f4-971c-77fee7d3ba51",
                                                "sense_id": "8c08f182-c5eb-30bc-bba7-3b737141cd29",
                                                "text": "„Am nächsten Tag war der Besuch im Reichstag angesetzt.“"
                                            },
                                            {
                                                "example_id": "eab42d5e-d291-4b82-9fee-5b806eb8bd7d",
                                                "sense_id": "8c08f182-c5eb-30bc-bba7-3b737141cd29",
                                                "text": "„Der Platz am Reichstag war schon schwarz von Menschen.“"
                                            },
                                            {
                                                "example_id": "44a09046-3d1f-4fb2-82bf-77f912cdf982",
                                                "sense_id": "8c08f182-c5eb-30bc-bba7-3b737141cd29",
                                                "text": "„Mein zweiter Berlinbesuch war, als Christo den Reichstag verhüllte.“"
                                            },
                                            {
                                                "example_id": "1beff471-ab97-4c03-959a-fcddfd9e14ba",
                                                "sense_id": "8c08f182-c5eb-30bc-bba7-3b737141cd29",
                                                "text": "„Die Kuppel des Reichstags direkt gegenüber ist zehn Meter höher als ihr Büro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b81fc9ab-2e43-3149-8e88-715332ab7180",
                                        "entry_id": "893a1ec9-0a89-3bef-a69c-cbfe8c99fb4c",
                                        "glosses": [
                                            "das Gebäude oder der Ort, in dem sich ein Reichstag versammelt",
                                            "Gebäude in Berlin, in dem (seit 1999) die Plenarsitzungen des Deutschen Bundestags stattfinden"
                                        ],
