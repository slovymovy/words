                    {
                        "sense_id": "413672a9-764f-3529-82bc-9e0308ca3200",
                        "entry_id": "913cf51a-c2d9-354e-aa27-b65a44ded066",
                        "glosses": [
                            "Composé organique de la famille des amino-esters utilisé comme anesthésique local."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac1d0586-dc5c-4707-b039-18a7ff4c9cdf",
                                "sense_id": "413672a9-764f-3529-82bc-9e0308ca3200",
                                "text": "Les sels de procaïne et de benzathine de la pénicilline fournissent des formes de réceptacles pour injection intramusculaire."
                            },
                            {
                                "example_id": "b6dec2ac-d21a-4f62-850d-387f1a555934",
                                "sense_id": "413672a9-764f-3529-82bc-9e0308ca3200",
                                "text": "L’injection d’anesthésiques locaux est autorisée aux conditions suivantes : utiliser la procaïne, la xylocaïne, la carbocaïne, etc., mais pas la cocaïne."
                            }
                        ]
                    }
                ],
