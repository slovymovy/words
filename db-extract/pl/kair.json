                                            },
                                            {
                                                "example_id": "84bfe835-3209-4135-a8c6-774de34a16d4",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "Das Kairo der heutigen Zeit ist durch viele Stadtviertel geprägt, in denen Landflüchtlinge illegal leben."
                                            },
                                            {
                                                "example_id": "03ccb8a6-46a4-4f8d-88a6-df9f893afe99",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "„Viel Whisky-Cola und ein Tablett mit Ecstasy-Pillen: Wild sind die Partynächte in Teheran, Kairo und Damaskus - aber auch gefährlich.“"
                                            },
                                            {
                                                "example_id": "5af34b9a-1c80-4d67-bf5c-898013c9d38a",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "„Gestützt auf seine doppelte Rolle als erster Unterzeichner eines Friedensvertrags mit Israel (1979) und als Vorreiter des arabischen Nationalismus - und als solcher über jeden Verdacht erhaben, die Interessen der Palästinenser zu verschachern -, konnte Kairo im israelisch-arabischen Friedensprozess eine wichtige Funktion übernehmen.“"
                                            },
                                            {
                                                "example_id": "fbf2281f-85a5-4141-9008-6a20b4d790da",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "„Im Streit um einen Kirchenbau in Kairo ist bei Zusammenstößen zwischen Christen und der Polizei am Mittwoch ein Mensch ums Leben gekommen.“"
                                            },
                                            {
                                                "example_id": "4c12c255-4bb2-45af-862c-798de1273d48",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "„Im Januar war in Marseille ein Gemälde von Edgar Degas im Wert von 800 000 Euro verschwunden, im August schnappten sich Diebe in Kairo van Goghs Gemälde ‚Mohnblumen‘ - 40 Millionen Euro wert.“"
                                            },
                                            {
                                                "example_id": "6edfc67a-91b1-4e2b-bd63-192ce167d2e1",
                                                "sense_id": "4ccc7659-42da-320b-837d-d4f0f822b99e",
                                                "text": "„Demonstranten in Kairo und Alexandria riefen ‚Gestern Tunis, heute Kairo‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d92e3e8-7878-41fa-9dbf-786044a93e27",
                        "source_entry_id": "484f2271-8b6e-39c2-bb07-72abfd216ef5",
                        "source_sense_id": "65a660a5-c9ea-355d-b09e-9abf1943d73f",
                        "target_lang_word": "Каир",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Каир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "af1a333f-d8f9-3538-a773-19b6a30293bc",
                                        "entry_id": "a48bf38f-f6ea-3db4-9fac-a7dea9638ad3",
                                        "glosses": [
                                            "город, столица Египта и административный центр мухафазы Каир [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7678e135-a873-446a-9538-810351c95f10",
                                                "sense_id": "af1a333f-d8f9-3538-a773-19b6a30293bc",
                                                "text": "Рахман Абдуль Рауф Арафат аль-Кудва аль-Хуссейни по прозвищу Ясир, шестой ребенок в семье, родился в августе 1929 года в Каире."
                                            },
                                            {
                                                "example_id": "44ddd115-c003-4d55-bd66-83831cf208c1",
                                                "sense_id": "af1a333f-d8f9-3538-a773-19b6a30293bc",
                                                "text": "Жена президента Египта Хосни Мубарака заложила первый камень музея, посвященного становлению египетской цивилизации. Он появится на юге Каира. Экспозиция нового культурного учреждения будет посвящена истории Древнего Египта и достижениям египтян в различных областях жизни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f696a2c-8833-37e7-ae61-7842d1a436db",
                                        "entry_id": "a48bf38f-f6ea-3db4-9fac-a7dea9638ad3",
                                        "glosses": [
                                            "мухафаза на севере Египта"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8f84dd8-bfe8-3a0b-9893-bf1988fcd824",
                                        "entry_id": "a48bf38f-f6ea-3db4-9fac-a7dea9638ad3",
                                        "glosses": [
                                            "перен., полит. правительство Египта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea7de97b-bb82-4cff-9dd2-441689f6739a",
                                                "sense_id": "f8f84dd8-bfe8-3a0b-9893-bf1988fcd824",
                                                "text": "Ситуация в мире приобрела такую динамику, когда тактика «разумной пассивности», приносившая России успех (чего стоит только зигзаг египетской революции, закончившийся восстановлением системы военно-технического сотрудничества Каира и Москвы), может перестать быть эффективной."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Каир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "91ae0bfd-e6d9-3496-a313-3be7c93a1221",
                                        "entry_id": "2b4e14be-69ff-3dac-aa92-54c8dc397f39",
                                        "glosses": [
                                            "мужское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb7c3d9b-3068-4826-9605-f2277ed1d43f",
                                                "sense_id": "91ae0bfd-e6d9-3496-a313-3be7c93a1221",
                                                "text": "Моего друга зовут Каир."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
