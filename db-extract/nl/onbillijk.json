                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22178fcc-faef-48c2-80be-fce74f71e1e9",
                                                "sense_id": "1ac45b04-dd96-3c8f-b1d3-13480ad59d01",
                                                "text": "Those hours that with gentle work did frame / The lovely gaze where every eye doth dwell / Will play the tyrants to the very same / And that unfair which fairly doth excel."
                                            }
                                        ]
