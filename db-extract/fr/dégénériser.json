                "senses": [
                    {
                        "sense_id": "ba285f85-f8a0-3632-b6fc-2bbbc3cf1533",
                        "entry_id": "e9e45a74-b430-3407-9cec-5e5a153b373e",
                        "glosses": [
                            "Faire perdre son caractère générique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c342613a-cf9f-4e76-a303-56a2a26e8ab1",
                                "sense_id": "ba285f85-f8a0-3632-b6fc-2bbbc3cf1533",
                                "text": "Enfin, Gustino fonctionne comme un label qui vient valoriser la marque Ticket Restaurant et la « dégénériser » en lui donnant un supplément d'âme."
                            },
                            {
                                "example_id": "47cf8f11-27e1-46b7-9690-84cde6e9c54a",
                                "sense_id": "ba285f85-f8a0-3632-b6fc-2bbbc3cf1533",
                                "text": "le risque est alors de diluer la spécificité des demandes de genre, de « dégénériser » les agendas, comme l'ont déjà remarqué plusieurs auteures."
                            },
                            {
                                "example_id": "8e0f7ba3-3a65-4542-b88b-046afe882929",
                                "sense_id": "ba285f85-f8a0-3632-b6fc-2bbbc3cf1533",
                                "text": "Tout à fait d'accord, les artifices sont donc idéaux pour : - \"dégénériser\" (oups) un nom de domaine - faire du terme artificiel de second choix - faire des économies"
                            }
                        ]
                    }
