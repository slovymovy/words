                "senses": [
                    {
                        "sense_id": "4fe703d5-19db-3f94-bc99-d1782edd928f",
                        "entry_id": "14d89472-91b5-3cac-85e5-e2f6e0584730",
                        "glosses": [
                            "Brotaufstrich aus eingekochten Früchten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4093c0eb-2ff5-40ee-8f0c-4b7ae291d0e9",
                                "sense_id": "4fe703d5-19db-3f94-bc99-d1782edd928f",
                                "text": "„Frau Pagel starrt wütend ihr Brot mit Jam an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "513ddb13-9ee8-4968-a3a4-4cb590b9b61c",
                        "source_entry_id": "14d89472-91b5-3cac-85e5-e2f6e0584730",
                        "source_sense_id": "4fe703d5-19db-3f94-bc99-d1782edd928f",
                        "source_sense_description": "Brotaufstrich aus eingekochten Früchten",
                        "target_lang_word": "джем",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "джем",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "83a9c2c3-5c57-3319-bb23-c5bbb623abb5",
                                        "entry_id": "e88ba663-2499-3a27-b384-1b944d960af8",
                                        "glosses": [
                                            "кулин. варенье из фруктов или ягод в виде густой однородной массы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ffa3bbb-2b9b-4743-8205-6262d7e8c1d0",
                                                "sense_id": "83a9c2c3-5c57-3319-bb23-c5bbb623abb5",
                                                "text": "Для подливки 4 столовые ложки малинового джема разводят в двух столовых ложках воды, смесь кипятят 2 минуты и добавляют столовую ложку лимонного сока."
                                            },
                                            {
                                                "example_id": "47595a2f-236f-431d-820d-22f471586422",
                                                "sense_id": "83a9c2c3-5c57-3319-bb23-c5bbb623abb5",
                                                "text": "Каждое утро нам подавали чай с тёплыми булочками и джемом."
                                            },
                                            {
                                                "example_id": "97138dbe-2b40-4beb-8aeb-3f2c516a9d1b",
                                                "sense_id": "83a9c2c3-5c57-3319-bb23-c5bbb623abb5",
                                                "text": "Джем приготовляется с добавлением сахара, причём часть фруктов может быть разваренной или протёртой, а часть цельной."
                                            },
                                            {
                                                "example_id": "3399ed7c-c476-431a-a2bf-004e0371e9f6",
                                                "sense_id": "83a9c2c3-5c57-3319-bb23-c5bbb623abb5",
                                                "text": "Из сладостей предпочтительнее горький натуральный шоколад, цукаты, варенья и джемы с небольшим содержанием сахара."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
