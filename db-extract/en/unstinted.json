                            {
                                "example_id": "ea0833a1-2341-4a8c-b83e-c8c4db28e628",
                                "sense_id": "98e8f351-ec24-3859-a4e3-7a59a2d24b14",
                                "text": "unstinted praise"
                            },
                            {
                                "example_id": "6537a24e-37c5-4b25-b03a-ee2948ff8fac",
                                "sense_id": "98e8f351-ec24-3859-a4e3-7a59a2d24b14",
                                "text": "unstinted support"
                            },
                            {
                                "example_id": "29011dfd-26c6-4108-968b-8920be259c55",
                                "sense_id": "98e8f351-ec24-3859-a4e3-7a59a2d24b14",
                                "text": "Mr. Coggan poured the liquor with unstinted liberality at the suffering Cain's circular mouth."
                            },
                            {
                                "example_id": "abb4a441-7a28-459b-b67e-0037709b48e2",
                                "sense_id": "98e8f351-ec24-3859-a4e3-7a59a2d24b14",
                                "text": "Wherever we went there was the sun, lavish and unstinted."
                            },
                            {
                                "example_id": "00f5a63f-0f03-4688-a68d-690b3f930bce",
                                "sense_id": "98e8f351-ec24-3859-a4e3-7a59a2d24b14",
                                "text": "You must have support and belief—unstinted support and belief."
                            },
                            {
                                "example_id": "1d650d2b-95d5-4113-bc66-d153dafc920c",
                                "sense_id": "98e8f351-ec24-3859-a4e3-7a59a2d24b14",
                                "text": "The music-publisher had been unstinted in his praise."
                            },
                            {
                                "example_id": "9a462cf2-7870-4218-9702-0ee2f3312190",
                                "sense_id": "98e8f351-ec24-3859-a4e3-7a59a2d24b14",
                                "text": "Augustus Saint-Gaudens . . .gave the crude, grabbing Republic its lessons in symbolic deportment and visual elocution, and won its unstinted gratitude."
                            }
                        ]
                    }
                ],
