                                    {
                                        "sense_id": "41c8e8ef-c52f-32dd-ae32-f8b4038e715d",
                                        "entry_id": "ae4b313a-06dd-3546-b7da-08695ca47f08",
                                        "glosses": [
                                            "To put something away in a compact and tidy manner, in its proper place, or in a suitable place."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29cf0a4d-1c16-31ae-b31f-d0120a675312",
                                        "entry_id": "ae4b313a-06dd-3546-b7da-08695ca47f08",
                                        "glosses": [
                                            "To store or pack something in a space-saving manner and over a long time."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7491ff28-ca37-480f-a972-da563c4c1f9b",
                                                "sense_id": "29cf0a4d-1c16-31ae-b31f-d0120a675312",
                                                "text": "Yet everybody knows that a cargo properly stowed in a seaworthy craft reaches market in much the better condition than by rail, though perhaps it is some hours longer on the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4209142f-9ca7-3fac-82e0-862dad3b0c47",
                                        "entry_id": "ae4b313a-06dd-3546-b7da-08695ca47f08",
                                        "glosses": [
                                            "To arrange, pack, or fill something tightly or closely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35b9851d-d06a-3b2f-bd2b-3ea59ce8c825",
                                        "entry_id": "ae4b313a-06dd-3546-b7da-08695ca47f08",
                                        "glosses": [
                                            "To dispose of, lodge, or hide somebody somewhere."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "249b136a-e099-4cf4-bd1c-0385b7311275",
                                                "sense_id": "35b9851d-d06a-3b2f-bd2b-3ea59ce8c825",
                                                "text": "Ar.[…]The Marriners all vnder hatches ſtowed, / Who, with a Charme ioynd to their ſuffred labour / I haue left aſleep :[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec466260-ad7c-3205-aed5-e10e491938ee",
                                        "entry_id": "ae4b313a-06dd-3546-b7da-08695ca47f08",
                                        "glosses": [
                                            "To cease; to stop doing something."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e5c2311-536c-4a4b-a346-3a2417cc1750",
                                                "sense_id": "ec466260-ad7c-3205-aed5-e10e491938ee",
                                                "text": "But when I strove my flame to tell, / Says she, 'Come, stow that patter, / If you're a cove wot likes a gal, / Vy don't you stand some gatter?' / In course I instantly complied— / Two brimming quarts of porter, / With sev'ral goes of gin beside, / Drain'd Bet the Coaley's daughter."
                                            },
                                            {
                                                "example_id": "8346c0a5-5ac9-4a23-a4ff-7e24ac9a16a9",
                                                "sense_id": "ec466260-ad7c-3205-aed5-e10e491938ee",
                                                "text": "“Come, come,” said Silver; “stow this talk. He’s dead, and he don’t walk, that I know; leastways, he won’t walk by day, and you may lay to that. Care killed a cat. Fetch ahead for the doubloons.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5f847e7-c142-341d-947d-50fc3c7e602a",
                                        "entry_id": "6a26b52b-cdab-3b21-b4cc-7b09ac5982f1",
                                        "glosses": [
                                            "A cry used by falconers to call their birds back down to hand."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895bb90b-e40c-4524-b086-728b36ccd9af",
                                                "sense_id": "d5f847e7-c142-341d-947d-50fc3c7e602a",
                                                "text": "His seconde hawke wexyd gery […]\non the rode loft\nShe perkyd her to rest.\nThe fauconer then was prest,\nCame runnynge with a dow,\nAnd cryed, ‘Stow, stow, stow!’\nBut she wold not bow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
