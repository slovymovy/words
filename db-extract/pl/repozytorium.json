                                        "sense_id": "90f262b4-1119-3e1e-a759-2b325e1b2f11",
                                        "entry_id": "9b3829c0-a44f-39df-8970-81d3afc8ccd0",
                                        "glosses": [
                                            "A location for storage, often for safety or preservation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5739bf6-1ce8-4141-ab54-92c95f8a7ddb",
                                                "sense_id": "90f262b4-1119-3e1e-a759-2b325e1b2f11",
                                                "text": "Harvard has declined to become the repository of George Segal's controversial sculpture, \"Gay Liberation.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b906dbd-acb1-3915-8d26-3adbabf42754",
                                        "entry_id": "9b3829c0-a44f-39df-8970-81d3afc8ccd0",
                                        "glosses": [
                                            "A location for storage, often for safety or preservation.",
                                            "A storage location for files, such as downloadable software packages, or files in a source control system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a3303d9-439a-40d0-939d-acd2e53c6fa3",
                                                "sense_id": "4b906dbd-acb1-3915-8d26-3adbabf42754",
                                                "text": "OpenSNP, a fourteen-year-old open source repository for genetic records, will shut down and delete all its data at the end of April."
                                            },
                                            {
                                                "example_id": "7fe4b12e-999c-48a0-8397-8a12096f2f9a",
                                                "sense_id": "4b906dbd-acb1-3915-8d26-3adbabf42754",
                                                "text": "Over the years, openSNP became one of the largest repositories of its kind, used in research, education, and even community-led investigations like debunking flawed CFS genetic studies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6de80cbb-eaa8-3dbd-8cb7-d0137e70f6be",
                                        "entry_id": "9b3829c0-a44f-39df-8970-81d3afc8ccd0",
                                        "glosses": [
                                            "A location for storage, often for safety or preservation.",
                                            "A burial vault."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eef491d2-117e-311a-97df-46d943813a17",
                                        "entry_id": "9b3829c0-a44f-39df-8970-81d3afc8ccd0",
                                        "glosses": [
                                            "A location for storage, often for safety or preservation.",
                                            "A person to whom a secret is entrusted."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a708caa8-db10-34ff-a36c-2320bd714892",
                                        "entry_id": "9b3829c0-a44f-39df-8970-81d3afc8ccd0",
                                        "glosses": [
