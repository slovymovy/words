                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a892b9ad-e951-48eb-9245-95c22dfa5ce4",
                                "sense_id": "95a7b2c6-9bbb-352a-a5c1-a673f4f5d986",
                                "text": "Den I gives him a five-plunk piece, and he gins me the shange."
                            },
                            {
                                "example_id": "cf6d2c8c-4183-44b1-81b9-b6e013cca94e",
                                "sense_id": "95a7b2c6-9bbb-352a-a5c1-a673f4f5d986",
