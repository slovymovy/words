                        ],
                        "examples": [
                            {
                                "example_id": "356c7639-61e1-4efb-98c4-635259bfb62f",
                                "sense_id": "c476bae8-f789-3b12-9224-7f7ed9590a72",
                                "text": "Elke keer dat er een nieuwe veedrijver op de boerderij kwam of er een veehandelaar langskwam, vroegen ze haar hoe ze hier verzeild was geraakt, zo ver van huis."
                            },
                            {
                                "example_id": "c9b4e96e-a234-4422-87c5-2af0635579a1",
                                "sense_id": "c476bae8-f789-3b12-9224-7f7ed9590a72",
                                "text": "In oktober werden al 110 verwaarloosde pony's en paarden bij de man weggehaald. Hij kreeg een werkstraf en een voorwaardelijk gevangenisstraf van 2 maanden met een proeftijd van 3 jaar. Daarnaast mocht hij geen dieren meer houden en mocht hij het beroep van veehandelaar nooit meer uitoefenen."
                            }
                        ]
                    }
