                    "sense_id": "74b3c0a7-1133-36ae-b38b-b4b0919fede0",
                    "sense_definition": "Het eigen wezen, de persoonlijkheid of het bewustzijn van zichzelf.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft een zeer groot <w>ik</w> en denkt alleen aan zichzelf.",
                            "target_lang_translations": {
                                "ru": "У него очень большое <w>я</w>, и он думает только о себе.",
                                "en": "He has a very big <w>ego</w> and only thinks of himself.",
                                "tr": "Onun çok büyük bir <w>egosu</w> var ve sadece kendisini düşünüyor.",
                                "pl": "On ma bardzo duże <w>ego</w> i myśli tylko o sobie.",
                                "de": "Er hat ein sehr großes <w>Ego</w> und denkt nur an sich selbst.",
                                "fr": "Il a un très grand <w>ego</w> et ne pense qu'à lui-même.",
                                "it": "Ha un <w>ego</w> enorme e pensa solo a se stesso.",
                                "cs": "Má velmi velké <w>ego</w> a myslí jen na sebe.",
                                "es": "Tiene un <w>ego</w> muy grande y solo piensa en sí mismo."
                            }
                        },
                        {
                            "text": "Het filosofische concept van het <w>ik</w> is erg complex.",
                            "target_lang_translations": {
                                "ru": "Философская концепция <w>я</w> очень сложна.",
                                "en": "The philosophical concept of the <w>self</w> is very complex.",
                                "tr": "Felsefi <w>benlik</w> kavramı oldukça karmaşıktır.",
                                "pl": "Filozoficzna koncepcja <w>ja</w> jest bardzo skomplikowana.",
                                "de": "Das philosophische Konzept des <w>Ichs</w> ist sehr komplex.",
                                "fr": "Le concept philosophique du <w>moi</w> est très complexe.",
                                "it": "Il concetto filosofico dell'<w>io</w> è molto complesso.",
                                "cs": "Filosofický koncept <w>já</w> je velmi složitý.",
                                "es": "El concepto filosófico del <w>yo</w> es muy complejo."
                            }
                        }
                    ],
                    "synonyms": [
                        "ego",
                        "zelf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Личность, самосознание, собственное «я».",
                        "en": "One's own being, personality, or self-consciousness.",
                        "tr": "Kişinin kendi varlığı, kişiliği veya öz bilinci.",
                        "pl": "Własna istota, osobowość lub świadomość samego siebie.",
                        "de": "Das eigene Wesen, die Persönlichkeit oder das Selbstbewusstsein.",
                        "fr": "Le propre être, la personnalité ou la conscience de soi.",
                        "it": "Il proprio essere, la personalità o la coscienza di se stessi.",
                        "cs": "Vlastní bytost, osobnost nebo vědomí sebe sama.",
                        "es": "El propio ser, la personalidad o la conciencia de uno mismo."
                    },
