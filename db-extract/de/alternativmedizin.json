                ],
                "senses": [
                    {
                        "sense_id": "a15b9b15-6552-3c52-9ae7-48be18c00beb",
                        "entry_id": "d2bd821a-897e-34c7-856d-9722a69459ed",
                        "glosses": [
                            "Sammelbegriff für verschiedene Diagnoseverfahren und Behandlungsmethoden, deren Wirksamkeit wissenschaftlich nicht belegt ist und die als Ergänzung oder Ersatz für Verfahren der Universitätsmedizin verstanden werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99fd28ae-1db7-4c59-a7d8-d41a46d6e989",
                                "sense_id": "a15b9b15-6552-3c52-9ae7-48be18c00beb",
                                "text": "Immer mehr Verfahren der Alternativmedizin werden von Krankenkassen getragen."
                            },
                            {
                                "example_id": "309d2c44-73ae-4cc0-a253-eabde8532954",
                                "sense_id": "a15b9b15-6552-3c52-9ae7-48be18c00beb",
                                "text": "„[…] wie heißt der Spruch so schön: »Es gibt keine Alternativmedizin, wenn es wirken würde, wäre es Medizin.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba7f686d-81c3-4177-9887-c42df6f42392",
                        "source_entry_id": "d2bd821a-897e-34c7-856d-9722a69459ed",
                        "source_sense_id": "a15b9b15-6552-3c52-9ae7-48be18c00beb",
                        "source_sense_description": "Sammelbegriff für verschiedene Diagnoseverfahren und Behandlungsmethoden, deren Wirksamkeit wissenschaftlich nicht belegt ist und die als Ergänzung oder Ersatz für Verfahren der Universitätsmedizin verstanden werden",
                        "target_lang_word": "替代医学",
