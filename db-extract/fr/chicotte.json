                ],
                "senses": [
                    {
                        "sense_id": "dc29bf93-c296-3fe0-849c-9c4ac75384f7",
                        "entry_id": "320229be-169a-3dc1-a8bc-af9ce73e8fbf",
                        "glosses": [
                            "Fouet dont les lanières sont nouées."
                        ],
                        "tags": [
                            "Afrique"
                        ],
                        "examples": [
                            {
                                "example_id": "e9bcc58d-d0a8-4c84-b8a9-abfad665b0fd",
                                "sense_id": "dc29bf93-c296-3fe0-849c-9c4ac75384f7",
                                "text": "Tout prisonnier condamné à la chaîne reçoit régulièrement la chicotte à l’expiration de chaque mois."
                            },
                            {
                                "example_id": "f6e97151-ec80-4e3d-9bf3-2d34201683de",
                                "sense_id": "dc29bf93-c296-3fe0-849c-9c4ac75384f7",
                                "text": "Essaie voire, vieil ami Yabada, de risquer, sous les yeux du « commandant », rien que deux francs au « patara » ! La chicotte est le moins que puisse te valoir ce crime abominable."
                            },
                            {
                                "example_id": "bc0305df-30bd-447e-80ec-49ddef7ca923",
                                "sense_id": "dc29bf93-c296-3fe0-849c-9c4ac75384f7",
                                "text": "La chicotte est-elle un châtiment corporel ou une banale correction utile dans l'éducation de ses enfants ?"
                            },
                            {
                                "example_id": "252d3c66-4c86-49fd-bdb3-a55d38c70e7f",
                                "sense_id": "dc29bf93-c296-3fe0-849c-9c4ac75384f7",
                                "text": "Mais ça restait quand même un travail d’esclave, de Noir de pioche. Avec les feuilles de canne, coupantes comme la lame d’un coupe-chou, qui vous mettaient la peau en pièces comme au temps de la chicotte."
                            }
                        ]
                    }
                ],
