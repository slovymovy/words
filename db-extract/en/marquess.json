                                    },
                                    {
                                        "sense_id": "69ffef79-4bc6-358a-9b43-5c242b95ee97",
                                        "entry_id": "e4f88b17-f0c1-360e-839c-dd15483b422a",
                                        "glosses": [
                                            "Träger des Adelstitels Marquis^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "717091e4-9318-4cab-8939-88a73869e17f",
                                                "sense_id": "69ffef79-4bc6-358a-9b43-5c242b95ee97",
                                                "text": "„Die Tür flog auf, und der Marquis im reichsten goldbordierten Galakleide stand im Zimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95609036-92c2-49e2-bbca-737ea23e3e66",
                        "source_entry_id": "dbd68ede-e4b8-3b68-8bca-11635f95aedb",
