                        "entry_id": "682f2f13-e49c-31c0-961e-7356f5ac06ae",
                        "glosses": [
                            "Celle qui envoie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4607ffca-4ec7-4425-8f6a-b50dd33a4086",
                                "sense_id": "c3049af3-967e-3158-977a-ab2d495e9ed4",
                                "text": "Quand Agnès Madame reçoit de Clémentine son cadeau de noces, un rouleau de soie, Héliodore exige qu’elle le retourne aussitôt par courrier à l’envoyeuse."
                            },
                            {
                                "example_id": "4d5cb4b8-1deb-4dda-9e38-671fea31134b",
                                "sense_id": "c3049af3-967e-3158-977a-ab2d495e9ed4",
                                "text": "Sans vouloir vous inquiéter, je dirai que l’envoyeur est une femme, une envoyeuse, et qu’elle vous en veut à mort d’un tort que vous prétendez ignorer."
                            }
                        ]
                    }
