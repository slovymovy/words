                    {
                        "translation_id": "3d3a623e-26ed-45c9-8a79-30fb4727ddd7",
                        "source_entry_id": "a95abbdf-0c66-3475-8866-5684f7f94d50",
                        "source_sense_id": "06807847-a711-3ca0-bd0f-85ef0a766989",
                        "source_sense_description": "written in upper case",
                        "target_lang_word": "groß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b3db4fe-a628-3a5f-873d-c26b1a6e4e68",
                                        "entry_id": "9e728217-3d47-3385-bae0-c0679e3e224b",
                                        "glosses": [
                                            "von beträchtlichem Ausmaß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb2cc428-eb6d-4d84-bf4b-0a86e2dbb4ae",
                                                "sense_id": "7b3db4fe-a628-3a5f-873d-c26b1a6e4e68",
                                                "text": "Der Baum ist aber nicht sehr groß für sein Alter."
                                            },
                                            {
                                                "example_id": "85360d0a-9dda-4535-8b10-3caff4a9cbe1",
                                                "sense_id": "7b3db4fe-a628-3a5f-873d-c26b1a6e4e68",
                                                "text": "„Das Misstrauen gegenüber gentechnisch veränderten Lebensmitteln ist zwar groß, allerdings sind »Gene« natürlich in jedem Lebewesen und damit auch in allen Nahrungsmitteln enthalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8031f17d-dea0-3732-9855-cf27035e28b8",
                                        "entry_id": "9e728217-3d47-3385-bae0-c0679e3e224b",
                                        "glosses": [
                                            "mehr als der Durchschnitt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0590e1de-7b29-474e-b60b-661a70282de7",
                                                "sense_id": "8031f17d-dea0-3732-9855-cf27035e28b8",
                                                "text": "Die Werte sind einfach zu groß."
                                            },
                                            {
                                                "example_id": "a9108191-d3fa-4180-81b8-1d968dd01f78",
                                                "sense_id": "8031f17d-dea0-3732-9855-cf27035e28b8",
                                                "text": "Lass uns zu Meier gehen, die haben ein großes Angebot."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2b4e5fd7-201b-374e-88c6-5213da9c540e",
                                        "entry_id": "9e728217-3d47-3385-bae0-c0679e3e224b",
                                        "glosses": [
                                            "erwachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6b0202a-9064-4444-87c2-82a1ba4c3e4d",
                                                "sense_id": "2b4e5fd7-201b-374e-88c6-5213da9c540e",
                                                "text": "Wenn ich einmal groß bin, möchte ich Pilot werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "955db6b3-1241-3454-9498-c8ce069c8696",
                                        "entry_id": "9e728217-3d47-3385-bae0-c0679e3e224b",
                                        "glosses": [
                                            "von Bedeutung, bemerkenswert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41a0e792-3e56-434c-9b57-2621713b4d3d",
                                                "sense_id": "955db6b3-1241-3454-9498-c8ce069c8696",
                                                "text": "Er war ein großer Politiker."
                                            },
                                            {
                                                "example_id": "73cddc0b-4505-4361-bbfc-f2eecfc1431d",
                                                "sense_id": "955db6b3-1241-3454-9498-c8ce069c8696",
                                                "text": "„1957, vier Jahre nach dem Tod des großen sowjetischen Führers Josef Wissarionowitsch Stalin, bekam das junge Ehepaar Ben Zion Piatov und Sonja Piatova, geborene Suchmann, ihr erstes Kind, meinen Vater Michael.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7479c9c5-ed08-3ba1-af34-79dabcd47e79",
                                        "entry_id": "9e728217-3d47-3385-bae0-c0679e3e224b",
                                        "glosses": [
                                            "in dieser (bestimmten) Größe, diese Größe aufweisend"
                                        ],
                                        "tags": [
                                            "in Verbindung mit Maßangaben und Maßeinheiten diesen häufig nachgestellt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7baa3f7c-da0f-4cfc-8a04-b08cae594a62",
                                                "sense_id": "7479c9c5-ed08-3ba1-af34-79dabcd47e79",
                                                "text": "Die Samen waren nur 3 bis 5 Millimeter groß."
                                            },
                                            {
                                                "example_id": "93bb498f-a6c8-4c9b-9a3b-a06d9971b00e",
                                                "sense_id": "7479c9c5-ed08-3ba1-af34-79dabcd47e79",
                                                "text": "Österreich ist etwa 83.879 km² groß."
                                            },
                                            {
                                                "example_id": "703051cf-6fd9-4b9d-90b4-c30d51e0a9d0",
                                                "sense_id": "7479c9c5-ed08-3ba1-af34-79dabcd47e79",
                                                "text": "Es gibt 4050 m² große und 10800 m² große Fußballplätze."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
