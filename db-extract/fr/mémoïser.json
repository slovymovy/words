                ],
                "senses": [
                    {
                        "sense_id": "f103d9f5-e85c-3c6d-8d97-8f1d6e25356b",
                        "entry_id": "d2aadc58-b3bf-3261-be09-3f62576bacca",
                        "glosses": [
                            "Conserver à la fin de l’exécution d’une fonction les arguments d’appel et le résultat associé, pour gagner du temps lors des futurs appels de cette fonction avec les mêmes arguments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28274f9c-c622-4a4f-a035-b399da063e8e",
                                "sense_id": "f103d9f5-e85c-3c6d-8d97-8f1d6e25356b",
                                "text": "Cette technique consiste à mémoïser dynamiquement les structures de données manipulées."
                            },
                            {
                                "example_id": "e83519d0-ea8e-4bf4-b470-3874da9e2b4b",
                                "sense_id": "f103d9f5-e85c-3c6d-8d97-8f1d6e25356b",
                                "text": "Je ne sais même pas comment écrire une fonction (ou méthode) Java qui prend une fonction (ou méthode) arbitraire et la modifie pour qu’elle soit désormais mémoïsée."
                            },
                            {
                                "example_id": "207495ad-e188-46e5-aa4d-0007a40e83d7",
                                "sense_id": "f103d9f5-e85c-3c6d-8d97-8f1d6e25356b",
                                "text": "Fonction pour forcer l’évaluation, et mémoïser la matrice dans une structure concrète : ∀ n m (M : MX n m), mx_force M = M."
                            }
                        ]
                    }
                ],
