                "senses": [
                    {
                        "sense_id": "656db136-8dea-3dd8-ae44-2058ad54f0f9",
                        "entry_id": "19f46ca9-94fb-323f-a1b0-52e9ab3e48d3",
                        "glosses": [
                            "Gesamtheit der als unangenehm laut empfundenen Geräusche, die von einem oder mehreren Motorrädern verursacht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e87ba343-ead4-4226-9f73-174cb5e47ec8",
                                "sense_id": "656db136-8dea-3dd8-ae44-2058ad54f0f9",
                                "text": "„Da Motorradlärm aber vor allem in den Sommermonaten und an Wochenenden auftritt, sollten künftig die Spitzenpegel berücksichtigt werden, wie es beispielsweise bei Fluglärm während der Nacht vorgeschrieben ist.“"
                            },
                            {
                                "example_id": "21d19d2c-7dcd-4fd4-a656-6e7c801726c4",
                                "sense_id": "656db136-8dea-3dd8-ae44-2058ad54f0f9",
                                "text": "„Mitte Mai hatte der Bundesrat die Bundesregierung aufgefordert, gegen Motorradlärm vorzugehen - unter anderem mit Fahrverboten an Wochenenden und drastischen Vorschriften für den Geräuschpegel von Motorrädern.“"
                            },
                            {
                                "example_id": "a3807ae3-a68c-4385-bc38-d768337816c9",
                                "sense_id": "656db136-8dea-3dd8-ae44-2058ad54f0f9",
                                "text": "„Im Mittelpunkt der Belästigung der Bevölkerung durch Verkehrslärm stand weiterhin der Motorradlärm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
