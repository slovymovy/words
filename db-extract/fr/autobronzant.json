                "senses": [
                    {
                        "sense_id": "6e12de76-7816-3a8f-b820-8192363738fd",
                        "entry_id": "a02e2af9-1835-3a77-b1a5-8e3395f78646",
                        "glosses": [
                            "Qui permet une apparence de bronzage sans exposition au soleil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17a1c1a9-bd98-4b9e-a0ae-45417ae38074",
                                "sense_id": "6e12de76-7816-3a8f-b820-8192363738fd",
                                "text": "La haine de cette femme. De sa petite vie nourrie de crèmes de beauté et de fonds de teint. De parfums, de houppettes, d’épilations « maillot », de laits autobronzants."
                            },
                            {
                                "example_id": "0bbdc32f-c42b-46bd-8567-fa788a0406b8",
                                "sense_id": "6e12de76-7816-3a8f-b820-8192363738fd",
                                "text": "Et si vous êtes à la recherche de crèmes autobronzantes saines et respectueuses de l’environnement, vous pouvez jeter un œil à la base de données Skin Deep du Environmental Working Goup’s (EWG)."
                            }
                        ]
                    }
                ],
