                ],
                "senses": [
                    {
                        "sense_id": "95cc032c-5313-311f-b038-a5a702be48c5",
                        "entry_id": "5686e5a3-2527-3c4a-8d1f-f321850da8ca",
                        "glosses": [
                            "een deel van een legpuzzel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95d46816-2a3e-4b7d-aea1-fc4c1011ea5f",
                                "sense_id": "95cc032c-5313-311f-b038-a5a702be48c5",
                                "text": "Wij legde een puzzel van 1000 puzzelstukjes."
                            }
                        ]
                    },
                    {
                        "sense_id": "593ae9a1-865b-37e0-af5b-a1a0af2eca1b",
                        "entry_id": "5686e5a3-2527-3c4a-8d1f-f321850da8ca",
                        "glosses": [
                            "het materiaal waarmee door passen en meten een groter geheel gemaakt moet worden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4bb72e2b-3b86-47c1-a8b8-879a1d5aff60",
                                "sense_id": "593ae9a1-865b-37e0-af5b-a1a0af2eca1b",
                                "text": "Toch wordt er nóg een fusie op het personeel losgelaten. Eentje die een bedrijf creëert met drie bloedgroepen: Ziggo, UPC en Vodafone. Van die puzzelstukken moet de nieuwe topman, Jeroen Hoencamp van de Britse Vodafone-tak, een telecombedrijf bouwen dat het kan opnemen tegen marktleider KPN."
                            }
                        ]
                    },
                    {
                        "sense_id": "a05462c4-1752-3806-ab55-13648e9bd7a9",
                        "entry_id": "5686e5a3-2527-3c4a-8d1f-f321850da8ca",
                        "glosses": [
                            "aanwijzingen waarmee samen een oplossing voor een groter probleem moet worden gevonden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "410b75ac-25ce-43a9-b1e5-57b7156cf92e",
                                "sense_id": "a05462c4-1752-3806-ab55-13648e9bd7a9",
                                "text": "De rechercheur probeerde alle aanwijzingen als puzzelstukjes aan elkaar te knopen om de moord op te lossen."
                            },
                            {
                                "example_id": "e3ec95e0-8ef1-4ba0-a2a0-086bd298cb66",
                                "sense_id": "a05462c4-1752-3806-ab55-13648e9bd7a9",
                                "text": "Zijn grootste succes kende de LHC in 2012, toen fysici in de versneller het langgezochte higgsdeeltje ontdekten. Dat deeltje wordt breed beschouwd als het laatste ontbrekende puzzelstukje van het zogeheten standaardmodel, de natuurkundetheorie die alle deeltjes en hun gedrag in een enkele wiskundige formule giet."
                            },
                            {
                                "example_id": "a353cb91-d6bb-4673-8c20-af74fadb9a49",
                                "sense_id": "a05462c4-1752-3806-ab55-13648e9bd7a9",
                                "text": "De volgende ochtend inspecteerde mijn vriend mijn nek. Hij zag een prikgaatje en alle puzzelstukjes vielen op z'n plek."
                            }
                        ]
                    }
                ],
