                    },
                    {
                        "translation_id": "3caec3f8-6f0e-4aad-af5f-9f5392cabe4a",
                        "source_entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
                        "source_sense_id": "73253f0c-24b9-38be-9846-d4b840617a3a",
                        "source_sense_description": "Distance entre les essieux avant et arrière d’un véhicule",
                        "target_lang_word": "wheelbase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wheelbase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13893966-7ab3-3b15-9240-077375f729ea",
                                        "entry_id": "b06f4906-f171-31f6-ac1e-1dcf48b77c64",
                                        "glosses": [
                                            "The horizontal distance between the front and rear axles of a road or rail vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef36b6a-250f-4e69-989c-2efa09438f0e",
                                                "sense_id": "13893966-7ab3-3b15-9240-077375f729ea",
                                                "text": "Beneath the snow, and after we had left it behind, the road was as greasy as vaseline, as steep as a scenic railway, and often not a yard wider than the lorry’s wheelbase."
                                            },
                                            {
                                                "example_id": "61bed3fc-9d92-4046-b2ff-01ceabc67709",
                                                "sense_id": "13893966-7ab3-3b15-9240-077375f729ea",
                                                "text": "The Southern acquired them because the little Class \"B4\" 0-4-0 tanks were finding heavy modern rolling stock more and more of a handful, and at war's end the railway had nothing of suitable power but short wheelbase on its books to take their place on the more tortuous of the dock lines."
                                            },
                                            {
                                                "example_id": "feece8dc-13fe-4ba9-a372-b26ce32d7c54",
                                                "sense_id": "13893966-7ab3-3b15-9240-077375f729ea",
                                                "text": "He thought the types of wagons planned (short-wheelbase types) needed reassessment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
