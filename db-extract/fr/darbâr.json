                "entry_id": "76bf0013-e701-3245-837f-4321efb61abe",
                "word": "darbâr",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "60a461fc-e060-40e6-920c-694894e58a3f",
                        "entry_id": "76bf0013-e701-3245-837f-4321efb61abe",
                        "tags": [
