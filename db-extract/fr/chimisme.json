                        "entry_id": "87b09287-a0fe-3012-9978-0737b00d8ad6",
                        "glosses": [
                            "L’ensemble des opérations chimiques qui se font dans une plante, dans un animal, dans un sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf786f3a-b4be-4ad4-a7b4-9c0736a47eae",
                                "sense_id": "863ce159-5c91-3a87-8649-88d513aaf7fe",
                                "text": "L'obstacle peut être dû à […] une modification du chimisme ou du milieu microbiologique du sol provoqué par les plantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c191724e-78c6-331a-a49d-30bfdfe50f42",
                        "entry_id": "87b09287-a0fe-3012-9978-0737b00d8ad6",
                        "glosses": [
                            "Abus de la chimie dans ses applications à la physiologie ou à la pathologie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c165e77b-0528-310a-b949-489cd8509794",
                        "entry_id": "87b09287-a0fe-3012-9978-0737b00d8ad6",
                        "glosses": [
                            "Modification de l'humeur d’une personne, assimilée à une réaction chimique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1941c717-38a0-4f05-a105-23db365c950f",
                                "sense_id": "c165e77b-0528-310a-b949-489cd8509794",
                                "text": "Ainsi, par le chimisme même de son mal, après qu’il avait fait de la jalousie avec son amour, il recommençait à fabriquer de la tendresse, de la pitié pour Odette. Elle était redevenue l’Odette charmante et bonne."
                            }
                        ]
                    }
