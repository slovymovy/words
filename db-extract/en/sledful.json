                        "glosses": [
                            "Enough to fill a sled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da9fc30b-05c4-4526-88ea-ff0ccd5021a0",
                                "sense_id": "302d5daf-72ad-3bf7-97b9-ae22bef3a6e1",
                                "text": "At another time a sledful of several young ladies had just passed one of the most dangerous parts of the road when a shower of rocks fell behind and between them and the next komatik which was but a short distance behind, yet nobody was injured."
                            },
                            {
                                "example_id": "dcfc7f7d-aadd-45bb-81c9-380007a5352c",
                                "sense_id": "302d5daf-72ad-3bf7-97b9-ae22bef3a6e1",
                                "text": "Having dispatched (in an innocent way) all the Pets of a general character last week, I intended next to attack the “stack of black cats,” and otherwise colored members of the feline race, about whom their fond owners have from time to time written us. But to my dismay when I went up into the composing-room on the proper day to see if the proof was all right I found it was not all right, for D. F.’s blue pencil had made a long mark to show how much must come out if those two sledfuls of pets went in."
                            },
                            {
                                "example_id": "26e6fb44-86c0-4c73-b199-d7a7f646525b",
                                "sense_id": "302d5daf-72ad-3bf7-97b9-ae22bef3a6e1",
                                "text": "He didn’t say a word about those two sledsful we were hauling by hand."
                            }
                        ]
                    }
