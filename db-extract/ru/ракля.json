                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2be3ce4-4ff3-4cc5-b95e-d1f4a47e7e4c",
                                                "sense_id": "b341602a-f89d-3dab-ac92-25925a26aa2d",
                                                "text": "On dégrille avec un râteau à manche souple en jeune frêne, on le passe contre la grille vers le haut, on racle le long des barres, ou l’on soulève la grille avec une ficelle et on la secoue pour faire passer ce qui bouche, feuilles et petit poisson qui ne résiste pas au courant."
                                            }
                                        ]
                                    },
