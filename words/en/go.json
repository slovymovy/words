{
    "word_family": [
        "goer",
        "ongoing",
        "outgoing",
        "undergo",
        "forego",
        "outgo"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "62b23989-eda9-3356-9df8-877a9118c2b7",
                    "sense_definition": "To move through space or travel to a specific place.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have to <w>go</w> now because my bus is arriving in five minutes.",
                            "target_lang_translations": {
                                "ru": "Мне пора <w>идти</w>, потому что мой автобус придет через пять минут."
                            }
                        },
                        {
                            "text": "Why don’t you <w>go</w> with us to the park this afternoon?",
                            "target_lang_translations": {
                                "ru": "Почему бы тебе не <w>пойти</w> с нами в парк сегодня днем?"
                            }
                        }
                    ],
                    "synonyms": [
                        "move",
                        "travel",
                        "proceed"
                    ],
                    "antonyms": [
                        "stay",
                        "stop",
                        "remain"
                    ],
                    "common_phrases": [
                        "go home",
                        "go there",
                        "go with us"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаться в пространстве или направляться в определенное место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "пешком"
                            },
                            {
                                "target_lang_word": "ехать",
                                "target_lang_sense_clarification": "на транспорте"
                            },
                            {
                                "target_lang_word": "отправляться",
                                "target_lang_sense_clarification": "начинать движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b299e02-8068-32e6-b84c-0ce3303ed6ce",
                    "sense_definition": "To travel in order to perform a specific activity.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's <w>go</w> shopping for some new clothes this weekend.",
                            "target_lang_translations": {
                                "ru": "Давай <w>пойдем</w> за покупками новой одежды в эти выходные."
                            }
                        },
                        {
                            "text": "They <w>went</w> swimming in the lake despite the cold water.",
                            "target_lang_translations": {
                                "ru": "Они <w>пошли</w> плавать в озере, несмотря на холодную воду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go shopping",
                        "go swimming",
                        "go fishing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправляться куда-либо для совершения определенного действия или занятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "заниматься чем-либо"
                            },
                            {
                                "target_lang_word": "пойти",
                                "target_lang_sense_clarification": "совершить действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88c3ed23-4255-3667-998a-3efc6e078ab0",
                    "sense_definition": "To attend or visit a place regularly, such as a school or church.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "attendance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>go</w> to school every morning at eight o'clock.",
                            "target_lang_translations": {
                                "ru": "Я <w>хожу</w> в школу каждое утро в восемь часов."
                            }
                        },
                        {
                            "text": "She <w>went</w> to university to study medicine and become a doctor.",
                            "target_lang_translations": {
                                "ru": "Она <w>поступила</w> в университет, чтобы изучать медицину и стать врачом."
                            }
                        }
                    ],
                    "synonyms": [
                        "attend"
                    ],
                    "common_phrases": [
                        "go to school",
                        "go to church",
                        "go to work"
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулярно посещать какое-либо место или заведение (школу, работу и т.д.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить",
                                "target_lang_sense_clarification": "регулярно посещать"
                            },
                            {
                                "target_lang_word": "посещать",
                                "target_lang_sense_clarification": "бывать где-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7e19a2d-e179-3da3-8dad-b10467d007b5",
                    "sense_definition": "To change into a different state or condition, often a negative one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "change_of_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The milk <w>went</w> bad because it was left out on the counter.",
                            "target_lang_translations": {
                                "ru": "Молоко <w>испортилось</w>, потому что его оставили на столе."
                            }
                        },
                        {
                            "text": "If you don't wear your glasses, you might <w>go</w> blind.",
                            "target_lang_translations": {
                                "ru": "Если ты не будешь носить очки, ты можешь <w>ослепнуть</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "become",
                        "turn",
                        "get"
                    ],
                    "common_phrases": [
                        "go bad",
                        "go crazy",
                        "go viral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переходить в другое состояние или качество, часто негативное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "становиться",
                                "target_lang_sense_clarification": "приобретать свойство"
                            },
                            {
                                "target_lang_word": "портиться",
                                "target_lang_sense_clarification": "о продуктах"
                            },
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "например, с ума"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcdb0450-49d1-3d3e-8d00-1b65bd2663e9",
                    "sense_definition": "To function or operate correctly, especially of a machine or engine.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "operation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old engine just won't <w>go</w> anymore after the accident.",
                            "target_lang_translations": {
                                "ru": "Старый двигатель просто больше не <w>работает</w> после аварии."
                            }
                        },
                        {
                            "text": "Don't put your hand inside the machine while the motor is <w>going</w>.",
                            "target_lang_translations": {
                                "ru": "Не суй руку внутрь машины, пока мотор <w>работает</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "function",
                        "work",
                        "operate",
                        "run"
                    ],
                    "antonyms": [
                        "stop",
                        "halt"
                    ],
                    "common_phrases": [
                        "keep going",
                        "going strong"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать или функционировать правильно (о механизмах, моторах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работать",
                                "target_lang_sense_clarification": "о механизме"
                            },
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "о часах или моторе"
                            },
                            {
                                "target_lang_word": "заводиться",
                                "target_lang_sense_clarification": "начинать работу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9357f36f-0085-31b8-b110-043e424141b7",
                    "sense_definition": "To proceed or happen in a particular way.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hope your job interview <w>goes</w> well tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, твое собеседование завтра утром <w>пройдет</w> хорошо."
                            }
                        },
                        {
                            "text": "How are things <w>going</w> with your new apartment search?",
                            "target_lang_translations": {
                                "ru": "Как <w>идут</w> дела с поиском твоей новой квартиры?"
                            }
                        }
                    ],
                    "synonyms": [
                        "fare",
                        "proceed"
                    ],
                    "common_phrases": [
                        "go well",
                        "go smoothly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Протекать или происходить определенным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "о делах или процессе"
                            },
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "о событии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67c32417-1a85-3600-bbb3-a57db87dd525",
                    "sense_definition": "To leave a place or move away from it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please don't <w>go</w> yet; I haven't finished telling you the story.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>уходи</w> пока; я еще не закончил рассказывать тебе историю."
                            }
                        },
                        {
                            "text": "I really must be <w>going</w> now as it is getting very late.",
                            "target_lang_translations": {
                                "ru": "Мне правда пора <w>идти</w>, так как уже очень поздно."
                            }
                        }
                    ],
                    "synonyms": [
                        "depart",
                        "leave",
                        "exit"
                    ],
                    "antonyms": [
                        "stay",
                        "remain",
                        "arrive"
                    ],
                    "common_phrases": [
                        "must be going",
                        "go away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покидать место или уходить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уходить",
                                "target_lang_sense_clarification": "покидать место"
                            },
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "собираться уйти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51ab76f9-7bbe-3607-9c40-33f83ecc9288",
                    "sense_definition": "To start or begin an action, often used as a command.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You have thirty seconds to solve the puzzle, starting now. <w>Go</w>!",
                            "target_lang_translations": {
                                "ru": "У вас есть тридцать секунд, чтобы решить головоломку, начиная с этого момента. <w>Марш</w>!"
                            }
                        },
                        {
                            "text": "Wait for the green light and then <w>go</w> as fast as you can.",
                            "target_lang_translations": {
                                "ru": "Дождись зеленого света и затем <w>езжай</w> так быстро, как только сможешь."
                            }
                        }
                    ],
                    "antonyms": [
                        "stop"
                    ],
                    "common_phrases": [
                        "ready set go"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать действие (часто используется как команда к старту)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "марш",
                                "target_lang_sense_clarification": "команда к старту"
                            },
                            {
                                "target_lang_word": "вперед",
                                "target_lang_sense_clarification": "призыв к действию"
                            },
                            {
                                "target_lang_word": "поехали",
                                "target_lang_sense_clarification": "начало движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7feb1034-1802-3418-a9b4-20275512d33c",
                    "sense_definition": "To lead to a specific place or provide access to it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Does this narrow road <w>go</w> all the way to the city center?",
                            "target_lang_translations": {
                                "ru": "Эта узкая дорога <w>ведет</w> до самого центра города?"
                            }
                        },
                        {
                            "text": "That green door <w>goes</w> to the back yard and the garden.",
                            "target_lang_translations": {
                                "ru": "Та зеленая дверь <w>ведет</w> на задний двор и в сад."
                            }
                        }
                    ],
                    "synonyms": [
                        "lead"
                    ],
                    "common_phrases": [
                        "go to the back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести куда-либо или обеспечивать доступ к месту (о дороге, двери)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "о дороге или двери"
                            },
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "пролегать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da23f4bd-3dec-33c4-a1f5-33713e845b56",
                    "sense_definition": "To be compatible or look good together, especially regarding colors or food.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "compatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This shade of red doesn't <w>go</w> with the blue drapes at all.",
                            "target_lang_translations": {
                                "ru": "Этот оттенок красного совсем не <w>сочетается</w> с синими шторами."
                            }
                        },
                        {
                            "text": "White wine usually <w>goes</w> better with fish than red wine does.",
                            "target_lang_translations": {
                                "ru": "Белое вино обычно <w>подходит</w> к рыбе лучше, чем красное."
                            }
                        }
                    ],
                    "synonyms": [
                        "harmonize",
                        "match",
                        "fit"
                    ],
                    "antonyms": [
                        "clash"
                    ],
                    "common_phrases": [
                        "go with",
                        "go together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сочетаться или хорошо смотреться вместе (о цветах, одежде, еде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подходить",
                                "target_lang_sense_clarification": "сочетаться"
                            },
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "быть к лицу"
                            },
                            {
                                "target_lang_word": "сочетаться",
                                "target_lang_sense_clarification": "гармонировать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbeb123b-ae60-389f-91e4-65109117c793",
                    "sense_definition": "To say something or make a specific sound.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Then I <w>go</w>, \"That's not fair!\" and she just walked away.",
                            "target_lang_translations": {
                                "ru": "И тут я <w>говорю</w>: «Это несправедливо!», а она просто ушла."
                            }
                        },
                        {
                            "text": "As soon as I made the mistake, I <w>went</w>, \"That was so stupid.\"",
                            "target_lang_translations": {
                                "ru": "Как только я совершил ошибку, я <w>сказал</w>: «Это было так глупо»."
                            }
                        }
                    ],
                    "synonyms": [
                        "say"
                    ],
                    "common_phrases": [
                        "go like this"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in informal spoken English to report speech."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сказать что-либо или издать звук (в разговорной речи)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "в значении 'сказать'"
                            },
                            {
                                "target_lang_word": "сказать",
                                "target_lang_sense_clarification": "произнести"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6193bd0c-aaf9-3e76-a9e5-bf2342ca9fba",
                    "sense_definition": "To die; to pass away.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wanted to <w>go</w> in his sleep, peacefully and without any pain.",
                            "target_lang_translations": {
                                "ru": "Он хотел <w>уйти</w> во сне, мирно и без боли."
                            }
                        },
                        {
                            "text": "After a long illness, the old man finally <w>went</w> last night.",
                            "target_lang_translations": {
                                "ru": "После долгой болезни старик наконец <w>скончался</w> прошлой ночью."
                            }
                        }
                    ],
                    "synonyms": [
                        "pass away",
                        "expire",
                        "perish"
                    ],
                    "common_phrases": [
                        "go in one's sleep"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used as a euphemism for dying."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умереть, скончаться (эвфемизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уйти",
                                "target_lang_sense_clarification": "из жизни"
                            },
                            {
                                "target_lang_word": "преставиться",
                                "target_lang_sense_clarification": "скончаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdd2ba18-526c-3b1a-80e2-400825d38bb2",
                    "sense_definition": "To use the toilet; to urinate or defecate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bodily_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really need to <w>go</w> before we get on the long bus ride.",
                            "target_lang_translations": {
                                "ru": "Мне правда нужно <w>сходить</w> в туалет перед долгой поездкой на автобусе."
                            }
                        },
                        {
                            "text": "The puppy <w>went</w> right there in the middle of the kitchen floor.",
                            "target_lang_translations": {
                                "ru": "Щенок <w>сходил</w> прямо там, посреди кухонного пола."
                            }
                        }
                    ],
                    "synonyms": [
                        "urinate",
                        "defecate"
                    ],
                    "common_phrases": [
                        "need to go",
                        "have to go"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "A common polite or indirect way to refer to using the bathroom."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сходить в туалет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "в туалет"
                            },
                            {
                                "target_lang_word": "пойти",
                                "target_lang_sense_clarification": "отлучиться в уборную"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad87826f-0572-3b46-876a-b2029b237e19",
                    "sense_definition": "A turn or opportunity to do something, especially in a game.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "turn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You’ve been playing for a long time; now let your brother have a <w>go</w>.",
                            "target_lang_translations": {
                                "ru": "Ты уже долго играешь; теперь дай брату его <w>очередь</w>."
                            }
                        },
                        {
                            "text": "It’s your <w>go</w> now, so please roll the dice and move your piece.",
                            "target_lang_translations": {
                                "ru": "Сейчас твой <w>ход</w>, так что, пожалуйста, бросай кубик и двигай фигуру."
                            }
                        }
                    ],
                    "synonyms": [
                        "turn",
                        "stint"
                    ],
                    "common_phrases": [
                        "have a go",
                        "your go"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очередь или возможность совершить действие, особенно в игре."
                    },
                    "translations": {
                        "ru": [
