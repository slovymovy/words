                "senses": [
                    {
                        "sense_id": "840c7fb2-3b14-3b4a-8afa-88d6ac8a39e7",
                        "entry_id": "1363cb1e-e9cb-3246-a457-b45edf56a3dd",
                        "glosses": [
                            "совокупность процессов и явлений, связанных с деятельностью воды и выражающихся в растворении горных пород и образовании в них пустот, а также своеобразные формы рельефа, возникающие на местностях, сложенных сравнительно легко растворимыми в воде горными породами (гипсами, известняками, мраморами, доломитами и каменной солью)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7716b0a-df6f-441b-934d-502da6c87c65",
                        "source_entry_id": "1363cb1e-e9cb-3246-a457-b45edf56a3dd",
                        "source_sense_id": "840c7fb2-3b14-3b4a-8afa-88d6ac8a39e7",
                        "target_lang_word": "karst",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
