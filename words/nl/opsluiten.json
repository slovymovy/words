            "senses": [
                {
                    "sense_id": "35053d48-f55c-3a03-969a-783a194b6ab8",
                    "sense_definition": "iemand of iets in een afgesloten ruimte plaatsen zodat ze er niet uit kunnen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gevangen zetten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>sloot</w> de hond even <w>op</w> in de achterkamer omdat er bezoek kwam.",
                            "target_lang_translations": {
                                "en": "He <w>locked</w> the dog <w>up</w> in the back room for a moment because visitors were coming.",
                                "ru": "Он ненадолго <w>запер</w> собаку в задней комнате, потому что пришли гости."
                            }
                        },
                        {
                            "text": "Je moet de kat niet de hele dag in een kleine kamer <w>opsluiten</w>.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>shut</w> the cat <w>in</w> a small room all day.",
                                "ru": "Не стоит <w>запирать</w> кошку в маленькой комнате на весь день."
                            }
                        }
                    ],
                    "synonyms": [
                        "insluiten"
                    ],
                    "antonyms": [
                        "vrijlaten"
                    ],
                    "common_phrases": [
                        "iemand opsluiten",
                        "in een kamer opsluiten"
                    ],
                    "target_lang_definitions": {
                        "en": "to place someone or something in a closed space so they cannot get out",
                        "ru": "поместить кого-либо или что-либо в закрытое пространство, чтобы они не могли выйти"
                    },
                    "translations": {
                        "en": [
                            {
