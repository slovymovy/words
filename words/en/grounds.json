    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "840db894-18e3-345c-9012-8a75244a27e3",
                    "sense_definition": "The enclosed land around a large building or institution.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "land_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked through the castle <w>grounds</w> and admired the gardens.",
                            "target_lang_translations": {
                                "ru": "Мы гуляли по <w>территории</w> замка и любовались садами.",
                                "pl": "Spacerowaliśmy po <w>terenach</w> zamkowych i podziwialiśmy ogrody."
                            }
                        },
                        {
                            "text": "Students are not allowed to leave the school <w>grounds</w> during the day.",
                            "target_lang_translations": {
                                "ru": "Ученикам не разрешается покидать школьную <w>территорию</w> в течение дня.",
                                "pl": "Uczniom nie wolno opuszczać <w>terenu</w> szkoły w ciągu dnia."
                            }
                        }
                    ],
                    "synonyms": [
                        "estate",
                        "campus",
                        "property",
                        "gardens",
                        "premises",
                        "land"
                    ],
                    "common_phrases": [
                        "school grounds",
                        "castle grounds",
                        "hospital grounds",
                        "private grounds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Огороженная территория вокруг большого здания или учреждения.",
                        "pl": "Ogrodzony teren wokół dużego budynku lub instytucji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "территория",
                                "target_lang_sense_clarification": "земельный участок вокруг здания"
                            },
                            {
                                "target_lang_word": "парк",
                                "target_lang_sense_clarification": "вокруг замка или поместья"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "tereny",
                                "target_lang_sense_clarification": "wokół budynku lub posiadłości"
                            },
                            {
                                "target_lang_word": "teren",
                                "target_lang_sense_clarification": "obszar wokół instytucji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4ec7d73-5c24-3607-ba81-032ff06bfcce",
                    "sense_definition": "A good reason or justification for doing something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company dismissed him on the <w>grounds</w> of misconduct.",
                            "target_lang_translations": {
                                "ru": "Компания уволила его на <w>основании</w> проступка.",
                                "pl": "Firma zwolniła go na <w>podstawie</w> niewłaściwego zachowania."
                            }
                        },
                        {
                            "text": "Do you have any reasonable <w>grounds</w> for suspecting him?",
                            "target_lang_translations": {
                                "ru": "У вас есть какие-либо разумные <w>основания</w> подозревать его?",
                                "pl": "Czy masz jakieś uzasadnione <w>podstawy</w>, by go podejrzewać?"
                            }
                        }
                    ],
                    "synonyms": [
                        "reason",
                        "basis",
                        "justification",
                        "cause"
                    ],
                    "common_phrases": [
                        "grounds for divorce",
                        "on the grounds that",
                        "reasonable grounds",
                        "moral grounds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Веская причина или оправдание для совершения чего-либо.",
                        "pl": "Dobry powód lub uzasadnienie dla zrobienia czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основание",
                                "target_lang_sense_clarification": "причина, повод"
                            },
                            {
                                "target_lang_word": "почва",
                                "target_lang_sense_clarification": "перен. основа для чего-либо"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podstawy",
                                "target_lang_sense_clarification": "powody, uzasadnienie"
                            },
                            {
                                "target_lang_word": "uzasadnienie",
                                "target_lang_sense_clarification": "argumenty wyjaśniające działanie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5334838b-fe5c-312d-b9d3-90e65a2f6681",
                    "sense_definition": "Plural of <w>ground</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two football <w>grounds</w> are located on opposite sides of the city.",
                            "target_lang_translations": {
                                "ru": "Две футбольные <w>площадки</w> расположены в противоположных частях города.",
                                "pl": "Dwa <w>boiska</w> piłkarskie znajdują się po przeciwnych stronach miasta."
                            }
                        },
                        {
                            "text": "All electrical <w>grounds</w> must be checked for safety compliance.",
                            "target_lang_translations": {
                                "ru": "Все электрические <w>заземления</w> должны быть проверены на соответствие требованиям безопасности.",
                                "pl": "Wszystkie <w>uziemienia</w> elektryczne muszą być sprawdzone pod kątem zgodności z przepisami bezpieczeństwa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова ground (земля, площадка, заземление).",
                        "pl": "Liczba mnoga od słowa ground (ziemia, boisko, uziemienie)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "площадки",
                                "target_lang_sense_clarification": "спортивные поля"
                            },
                            {
                                "target_lang_word": "заземления",
                                "target_lang_sense_clarification": "в электрике"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "boiska",
                                "target_lang_sense_clarification": "sportowe"
                            },
                            {
                                "target_lang_word": "uziemienia",
                                "target_lang_sense_clarification": "w elektryce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9561cd9d-11f3-3c8c-b591-fa13a7cfc23c",
                    "sense_definition": "Solid particles that settle at the bottom of a liquid, especially coffee.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sediment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She emptied the coffee <w>grounds</w> into the compost bin.",
                            "target_lang_translations": {
                                "ru": "Она вытряхнула кофейную <w>гущу</w> в компостный ящик.",
                                "pl": "Wysypała <w>fusy</w> po kawie do pojemnika na kompost."
                            }
                        },
                        {
                            "text": "There were bitter <w>grounds</w> left at the bottom of the cup.",
                            "target_lang_translations": {
                                "ru": "На дне чашки осталась горькая <w>гуща</w>.",
                                "pl": "Na dnie filiżanki pozostał gorzki <w>osad</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dregs",
                        "sediment"
                    ],
                    "common_phrases": [
                        "coffee grounds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердые частицы, оседающие на дне жидкости, особенно кофе.",
                        "pl": "Ciała stałe osadzające się na dnie płynu, zwłaszcza kawy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гуща",
                                "target_lang_sense_clarification": "кофейная"
                            },
                            {
                                "target_lang_word": "осадок",
                                "target_lang_sense_clarification": "на дне жидкости"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "fusy",
                                "target_lang_sense_clarification": "z kawy lub herbaty"
                            },
                            {
                                "target_lang_word": "osad",
                                "target_lang_sense_clarification": "na dnie naczynia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3cc7b58-40a8-3e63-a787-74a045ec87b2",
                    "sense_definition": "Third-person singular simple present indicative of <w>ground</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airline <w>grounds</w> its fleet whenever there is a severe storm.",
                            "target_lang_translations": {
                                "ru": "Авиакомпания <w>запрещает вылет</w> своему флоту, когда начинается сильный шторм.",
                                "pl": "Linia lotnicza <w>uziemia</w> swoją flotę za każdym razem, gdy szaleje silna burza."
                            }
                        },
                        {
                            "text": "Her mother <w>grounds</w> her for a week if she comes home late.",
                            "target_lang_translations": {
                                "ru": "Мать <w>не пускает</w> её <w>гулять</w> неделю, если она приходит домой поздно.",
                                "pl": "Matka <w>daje</w> jej <w>szlaban</w> na tydzień, jeśli wraca późno do domu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular simple present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Третье лицо единственного числа настоящего времени глагола ground.",
                        "pl": "Trzecia osoba liczby pojedynczej czasu teraźniejszego od czasownika ground."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрещает вылет",
                                "target_lang_sense_clarification": "об авиации"
                            },
                            {
                                "target_lang_word": "не пускает гулять",
                                "target_lang_sense_clarification": "наказание ребенка"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uziemia",
                                "target_lang_sense_clarification": "zatrzymuje samoloty na ziemi lub daje karę dziecku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
