                                        "entry_id": "27fc5262-1fce-314b-ad5d-29e768a6ee0e",
                                        "glosses": [
                                            "To create or use a sock puppet (alternative user account)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
