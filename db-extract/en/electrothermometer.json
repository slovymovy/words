                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c59de9c3-6d26-43c5-b584-59b6aefe7fd5",
                                "sense_id": "779f9bb1-586a-37bf-97f8-b310e0383983",
                                "text": "Recordings of temperature were made with electrothermometers at two fixed points at either end of the lake."
                            },
                            {
                                "example_id": "68fe18b9-7319-4745-9791-33d59d6099c4",
                                "sense_id": "779f9bb1-586a-37bf-97f8-b310e0383983",
                                "text": "The whole apparatus consists of three parts: an electrothermometer in a plastic case, a set of 8 detectors, and a switch for alternately connecting the detectors and taking their temperature readings."
                            },
                            {
                                "example_id": "51f59612-d09a-4dc6-a2bf-727394415d43",
                                "sense_id": "779f9bb1-586a-37bf-97f8-b310e0383983",
                                "text": "It should be noted that while working with electrothermometers in the surface layer of glacial cover in the Antarctic, E. N. Tsikin and V. N. Bogosloyskii made use of observations made at four times, which gave sufficient information on the temperature conditions of ice."
