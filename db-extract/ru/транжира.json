                        "glosses": [
                            "squanderer (one who wastes e.g. money)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e82e22c-c0a3-475e-ad6c-581557d75ad4",
                                "sense_id": "67d4d862-3ef4-3290-951c-46ede4952c58",
                                "text": "Назовём коке́тливую шлю́хой, // Ска́жем про весёлую - под му́хой.\nПу́хленькая - ско́ро ло́пнет с жи́ру, // Ще́друю перекрести́м в транжи́ру.",
                                "translation": "Let us call a flirtatious one a slut, // Let us say a cheerful one is mellow.\nA chubby one will soon burst from her fat, // A generous one we will rename as a squanderer.",
                                "english": "Let us call a flirtatious one a slut, // Let us say a cheerful one is mellow.\nA chubby one will soon burst from her fat, // A generous one we will rename as a squanderer."
                            }
                        ]
                    }
