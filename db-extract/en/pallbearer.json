                        "sense_id": "c9cab8be-e852-32c5-b583-9e1f1704f978",
                        "entry_id": "0f0d39ba-eb2c-39a6-972d-ca9ea4e4fae3",
                        "glosses": [
                            "One called upon to carry or bear the coffin or the casket at a funeral."
