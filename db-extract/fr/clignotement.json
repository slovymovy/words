                "senses": [
                    {
                        "sense_id": "55f15c7e-02e0-3fdc-8aa3-894f028ea8a1",
                        "entry_id": "2394b19e-a249-3260-afba-a8904cd8f4ef",
                        "glosses": [
                            "Action de clignoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb5fd2f-5cdd-4cac-b5ea-5061d2219a47",
                                "sense_id": "55f15c7e-02e0-3fdc-8aa3-894f028ea8a1",
                                "text": "Il est sujet à un clignotement d’yeux continuel."
                            },
                            {
                                "example_id": "cbcebc4b-2012-4710-8f8a-bfc9274e28c2",
                                "sense_id": "55f15c7e-02e0-3fdc-8aa3-894f028ea8a1",
                                "text": "Les mots qu’il allait prononcer étaient effrayants et il la dévisageait pour ne pas perdre un seul tressaillement de ses muscles ni un seul clignotement de ses yeux."
                            },
                            {
                                "example_id": "413c56d2-bf9e-4e4e-a72b-c380a6342b54",
                                "sense_id": "55f15c7e-02e0-3fdc-8aa3-894f028ea8a1",
                                "text": "La pièce était plongée dans l’obscurité, éclairée par le seul clignotement de l’enseigne au néon, mais Jamie était trop occupée à verrouiller la porte pour prendre le temps d’allumer la petite lampe près du lit."
                            }
                        ]
                    }
                ],
