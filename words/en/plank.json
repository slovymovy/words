{
    "word_family": [
        "planking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e09a7570-9750-3586-a6d5-0c74b4de262a",
                    "sense_definition": "A long, thick, flat piece of wood used in building.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a heavy <w>plank</w> to build the bridge.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал тяжелую <w>доску</w> для строительства моста."
                            }
                        },
                        {
                            "text": "He walked across the wooden <w>plank</w> to reach the boat.",
                            "target_lang_translations": {
                                "ru": "Он прошел по деревянной <w>доске</w>, чтобы добраться до лодки."
                            }
                        }
                    ],
                    "synonyms": [
                        "board",
                        "timber"
                    ],
                    "common_phrases": [
                        "wooden plank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный, толстый, плоский кусок дерева, используемый в строительстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доска",
                                "target_lang_sense_clarification": "пиломатериал, полученный распиловкой бревна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40c8e616-175a-3d89-8a49-4641287c8356",
                    "sense_definition": "A specific policy or principle supported by a political party.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Environmental protection is a key <w>plank</w> of their party platform.",
                            "target_lang_translations": {
                                "ru": "Защита окружающей среды — это ключевой <w>пункт программы</w> их партии."
                            }
                        },
                        {
                            "text": "The candidate discussed every major <w>plank</w> during the debate.",
                            "target_lang_translations": {
                                "ru": "Кандидат обсудил каждый важный <w>пункт программы</w> во время дебатов."
                            }
                        }
                    ],
                    "synonyms": [
                        "policy",
                        "principle"
                    ],
                    "common_phrases": [
                        "party plank",
                        "central plank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный политический курс или принцип, поддерживаемый политической партией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пункт программы",
                                "target_lang_sense_clarification": "отдельное положение в политической платформе"
                            },
                            {
                                "target_lang_word": "принцип",
                                "target_lang_sense_clarification": "основополагающая идея или убеждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b551bc0c-8f8c-38da-86fe-9b5a3c374c20",
                    "sense_definition": "An exercise where one holds a rigid, push-up-like position for a set time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She held a <w>plank</w> for two minutes to strengthen her core.",
                            "target_lang_translations": {
                                "ru": "Она простояла в <w>планке</w> две минуты, чтобы укрепить мышцы кора."
                            }
                        },
                        {
                            "text": "Doing a <w>plank</w> every morning helps improve posture.",
                            "target_lang_translations": {
                                "ru": "Выполнение <w>планки</w> каждое утро помогает улучшить осанку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold a plank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упражнение, при котором человек удерживает тело в жестком, прямом положении, опираясь на предплечья или ладони."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "планка",
                                "target_lang_sense_clarification": "статическое упражнение для укрепления мышц кора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "476201bc-59d9-3bb6-b3e7-6fe0b047a666",
                    "sense_definition": "A foolish or stupid person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>plank</w> and listen to the instructions.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>болваном</w> и послушай инструкции."
                            }
                        },
                        {
                            "text": "He acted like a total <w>plank</w> during the meeting.",
                            "target_lang_translations": {
                                "ru": "Он вел себя как полный <w>дурак</w> во время собрания."
                            }
                        }
                    ],
                    "synonyms": [
                        "idiot",
                        "fool",
                        "dolt"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый или недалекий человек (разговорное, пренебрежительное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "глупый человек"
                            },
                            {
                                "target_lang_word": "болван",
                                "target_lang_sense_clarification": "недалекий, несообразительный человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c50a49fa-8365-35b6-bdf8-703311ac6d87",
                    "sense_definition": "To pay money or place something down firmly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>plank</w> down a lot of cash for the repairs.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>выложить</w> кучу денег за ремонт."
                            }
                        },
                        {
                            "text": "She <w>planked</w> her bag on the table and sat down.",
                            "target_lang_translations": {
                                "ru": "Она <w>плюхнула</w> свою сумку на стол и села."
                            }
                        }
                    ],
                    "synonyms": [
                        "pay",
                        "deposit"
                    ],
                    "common_phrases": [
                        "plank down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выложить деньги или твердо положить какой-либо предмет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выложить",
                                "target_lang_sense_clarification": "отдать деньги или положить предмет на поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbb2f106-bfe5-37e5-8ee4-939720f563cc",
                    "sense_definition": "To lie face down and rigid in an unusual place for a photograph.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "internet_trend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenagers decided to <w>plank</w> on top of the statue.",
                            "target_lang_translations": {
                                "ru": "Подростки решили заняться <w>планкингом</w> на вершине статуи."
                            }
                        },
                        {
                            "text": "He was <w>planking</w> on the roof for his social media post.",
                            "target_lang_translations": {
                                "ru": "Он <w>занимался планкингом</w> на крыше для поста в социальных сетях."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лежать лицом вниз в жестком, вытянутом положении в необычном месте для фотографии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "планкинг",
                                "target_lang_sense_clarification": "интернет-флешмоб, заключающийся в лежании в необычных местах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fdb0183-23a7-3154-a460-df56950984ab",
                    "sense_definition": "To cover a surface with wooden boards.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers began to <w>plank</w> the floor of the new cabin.",
                            "target_lang_translations": {
                                "ru": "Рабочие начали <w>застилать досками</w> пол в новой хижине."
                            }
                        },
                        {
                            "text": "They had to <w>plank</w> the deck before painting it.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>застелить досками</w> палубу перед тем, как красить её."
                            }
                        }
                    ],
                    "synonyms": [
                        "board"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность деревянными досками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застилать досками",
                                "target_lang_sense_clarification": "покрывать пол или поверхность деревом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
