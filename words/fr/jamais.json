                    "common_phrases": [
                        "ne jamais",
                        "jamais plus",
                        "presque jamais"
                    ],
                    "target_lang_definitions": {
                        "en": "At no time or on no occasion, usually used with 'ne' in negative sentences.",
                        "ru": "Ни в какой момент времени; употребляется вместе с частицей «не» в отрицательных предложениях.",
                        "nl": "Op geen enkel moment of bij geen enkele gelegenheid, meestal in ontkennende zinnen.",
                        "de": "Zu keinem Zeitpunkt und bei keiner Gelegenheit, meist in verneinten Sätzen.",
                        "pl": "W żadnym momencie ani przy żadnej okazji; zwykle używane w zdaniach przeczących.",
                        "it": "In nessun momento e in nessuna occasione, di solito con la negazione «non».",
                        "cs": "Vyjadřuje, že se něco v žádnou dobu a při žádné příležitosti nestalo nebo nestane.",
                        "tr": "Hiçbir zaman ya da hiçbir durumda bir şeyin gerçekleşmediğini belirtir; olumsuz fiille birlikte kullanılır.",
                        "es": "En ningún momento ni en ninguna ocasión; suele usarse con «no» en frases negativas.",
                        "zh": "在任何时候都未曾发生，多用于否定句中。"
                    },
