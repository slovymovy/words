                    ],
                    "common_phrases": [
                        "passager défaillant",
                        "client défaillant"
                    ]
                },
                {
                    "sense_id": "89541f99-7cf0-396a-b1a6-1d8c6a280b5f",
                    "sense_definition": "Se dit d'une lignée ou d'une famille qui s'éteint faute d'héritiers directs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le domaine royal a récupéré le château après l'extinction de cette lignée <w>défaillante</w>."
                        },
                        {
                            "text": "Les titres ancestraux de la branche <w>défaillante</w> sont passés à des cousins éloignés."
                        }
                    ],
                    "common_phrases": [
                        "lignée défaillante",
                        "branche défaillante"
                    ]
                }
            ]
        },
