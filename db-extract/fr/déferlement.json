                "senses": [
                    {
                        "sense_id": "a19548f8-0300-3e42-8be1-d886e80a707b",
                        "entry_id": "1be02b37-0bd4-3530-a8cb-917a5afc72b8",
                        "glosses": [
                            "Action de déferler, ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd51efe9-df79-4c90-a7ab-cc5855577658",
                                "sense_id": "a19548f8-0300-3e42-8be1-d886e80a707b",
                                "text": "La surface de déferlement est conçue pour permettre à un aquaplanchiste de surfer sur le flux d'eau dans une direction généralement transversale à la direction de l'écoulement d'eau."
                            },
                            {
                                "example_id": "2fae6ec3-b036-434a-b3ca-0483ed2cd610",
                                "sense_id": "a19548f8-0300-3e42-8be1-d886e80a707b",
                                "text": "Il y a de quoi s’inquiéter pour les valeurs démocratiques d’un parti qui s’accroche ainsi à un leader déchu, malgré le déferlement de mensonges et le paroxysme d’autoritarisme qui ont marqué la transition."
                            },
                            {
                                "example_id": "ed777f69-0b47-4175-a730-2e26992990e8",
                                "sense_id": "a19548f8-0300-3e42-8be1-d886e80a707b",
                                "text": "Bien qu’il soit possible d’aller dans le menu et de tenter d’ajuster graduellement la cadence en fonction de vos déplacements, sachez qu’idéalement, plus le rythme de déferlement est rapide, plus l’image correspond à ce qui se passe vraiment sous le bateau."
                            }
                        ]
                    }
                ],
