                                        "entry_id": "70419682-23e8-36cb-aaf8-33e65e60c544",
                                        "glosses": [
                                            "Characterized by suspense; suspenseful"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d67f24d4-4390-4972-9fdc-7afc5a4e18ed",
                        "source_entry_id": "9ade2acc-336d-3234-9847-df0f57855910",
