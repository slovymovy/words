                "senses": [
                    {
                        "sense_id": "c7f7ff31-3d2f-3556-a518-308dc8c4efe9",
                        "entry_id": "1c718da9-890d-31c8-aa79-07c25931e9cd",
                        "glosses": [
                            "Komponente des Personal Computers zur Steuerung der Bildschirmanzeige"
                        ],
                        "tags": [
                            "Informationstechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "c8bb108f-a730-4fc3-9b13-d635b6342b7f",
                                "sense_id": "c7f7ff31-3d2f-3556-a518-308dc8c4efe9",
                                "text": "Viele der aktuellen Spiele setzen moderne 3D-fähige Grafikkarten voraus."
                            },
                            {
                                "example_id": "f81c3ec1-97dd-448c-b95f-1ed1d7ee34c7",
                                "sense_id": "c7f7ff31-3d2f-3556-a518-308dc8c4efe9",
                                "text": "Wenn der Monitor schwarz bleibt, kann das unter anderem an der Grafikkarte liegen."
                            },
                            {
                                "example_id": "2072542d-ef01-4e65-bf53-abeb4536c212",
                                "sense_id": "c7f7ff31-3d2f-3556-a518-308dc8c4efe9",
                                "text": "„Um sicherzugehen, dass es sich nicht nur um ein Problem mit einer einzelnen GPU handelt, haben sich die Forscher im weiteren Verlauf vier Exemplare der 3.500 Euro teuren Grafikkarte besorgt.“"
                            },
                            {
                                "example_id": "aae0a876-70f7-446e-b994-e74a2d4461b1",
                                "sense_id": "c7f7ff31-3d2f-3556-a518-308dc8c4efe9",
                                "text": "„Der Chiphersteller hat eine Grafikkarte vorgestellt, die den Betrieb von Virtual-Reality-Brillen deutlich günstiger machen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdbb5c16-49dc-4ff8-8609-e8c0a4f690c7",
                        "source_entry_id": "1c718da9-890d-31c8-aa79-07c25931e9cd",
                        "source_sense_id": "c7f7ff31-3d2f-3556-a518-308dc8c4efe9",
