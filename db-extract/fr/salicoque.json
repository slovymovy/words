                "senses": [
                    {
                        "sense_id": "74f1f221-3acf-3c83-85fe-c1ba76ac087a",
                        "entry_id": "25bc28c7-6f84-3b98-a854-2eef7cc739ba",
                        "glosses": [
                            "Nom vulgaire des crevettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ded213-af0e-4c2d-8658-0f8c17667d99",
                                "sense_id": "74f1f221-3acf-3c83-85fe-c1ba76ac087a",
                                "text": "La salicoque est un crustacé de mer, de l’ordre des décapodes, de la famille des macroures, que les Grecs nommaient cavis et cranyous, et que nous appelons crevettes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "182f5355-0a82-41bf-89c3-634a5d41cda7",
                        "source_entry_id": "25bc28c7-6f84-3b98-a854-2eef7cc739ba",
                        "source_sense_id": "74f1f221-3acf-3c83-85fe-c1ba76ac087a",
                        "target_lang_word": "shrimp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrimp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d064911a-9c33-3230-9567-c28719e7a867",
                                        "entry_id": "13e18b8b-8305-30f8-a0d0-02ad0c6f8cc7",
                                        "glosses": [
                                            "Any of many swimming, often edible, crustaceans, chiefly of the infraorder Caridea or the suborder Dendrobranchiata, with slender legs, long whiskers and a long abdomen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ea13bc0-aabb-4e0a-b047-e5151f0fa45f",
                                                "sense_id": "d064911a-9c33-3230-9567-c28719e7a867",
                                                "text": "1851, \"A Lady of Charleston\" (Sarah Rutledge), The Carolina Housewife, 2013, unnumbered page,\nButter well a deep dish, upon which place a thick layer of pounded biscuit; having picked and boiled your shrimps, put them upon the biscuit; a layer of shrimps, with small pieces of butter, a little pepper, mace or nutmeg."
                                            },
                                            {
                                                "example_id": "c0e5b4aa-2978-41aa-a94a-9ec2c780d3d9",
                                                "sense_id": "d064911a-9c33-3230-9567-c28719e7a867",
                                                "text": "Shrimp farming is in its infancy in Africa. but Asia has most of the world's shrimp farms."
                                            },
                                            {
                                                "example_id": "86a921cb-086c-46e6-99fe-3c755082a745",
                                                "sense_id": "d064911a-9c33-3230-9567-c28719e7a867",
                                                "text": "Most shrimps belong to one of several families of the Infraorder Caridea (Chapter 4). However, coral shrimps and Venus shrimps are so different from the rest that a separate infraorder is warranted."
                                            },
                                            {
                                                "example_id": "c3cfc83f-f53b-487a-b222-db4077318a40",
                                                "sense_id": "d064911a-9c33-3230-9567-c28719e7a867",
                                                "text": "America's favorite seafood, shrimp has always been a big seller at the Home Port. On any given day, we usually served around 40 to 50 pounds of shrimp."
                                            },
                                            {
                                                "example_id": "b9d5679a-1516-4f14-964a-f9d2701d3e92",
                                                "sense_id": "d064911a-9c33-3230-9567-c28719e7a867",
                                                "text": "How many shrimps do you have to eat / Before you make your skin turn pink? / Eat too much and you'll get sick / Shrimps are pretty rich"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c3c548d-8a1f-30e6-a392-d7535cbf619d",
                                        "entry_id": "13e18b8b-8305-30f8-a0d0-02ad0c6f8cc7",
                                        "glosses": [
                                            "The flesh of such crustaceans."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4abc4511-83db-3916-826a-763f61f9a7f9",
                                        "entry_id": "13e18b8b-8305-30f8-a0d0-02ad0c6f8cc7",
                                        "glosses": [
                                            "A small, puny or unimportant person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68d86e01-31a5-3b40-9653-80ca1c53b529",
                                        "entry_id": "13e18b8b-8305-30f8-a0d0-02ad0c6f8cc7",
