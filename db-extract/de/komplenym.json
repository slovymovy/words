                "senses": [
                    {
                        "sense_id": "9b75c792-dbf9-340b-bbf2-43289158ed08",
                        "entry_id": "dcfbf9bf-7dc2-3507-9988-3c90bda30504",
                        "glosses": [
                            "Wort, das semantisch im Gegensatz zu einem anderen steht, wobei sich beide gegenseitig ergänzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d340f0-a550-4c16-a965-4de17b393ad1",
                                "sense_id": "9b75c792-dbf9-340b-bbf2-43289158ed08",
                                "text": "„…; Komplenyme sind Wörter, die sich eher ergänzen als einen Gegensatz bilden, zum Beispiel essen und trinken.“"
                            },
                            {
                                "example_id": "7bf9b03d-03a4-40c0-b93d-10aa330e9a13",
                                "sense_id": "9b75c792-dbf9-340b-bbf2-43289158ed08",
                                "text": "Als Beispiel für Komplenyme nennt Duden die Wörter „ledig“ und „verheiratet“, wobei „ledig“ als „nicht verheiratet“ umschrieben werden kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
