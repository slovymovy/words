        "fr-extract.jsonl": [
            {
                "entry_id": "dae61948-b827-3a4a-9ae6-05b78b69f784",
                "word": "Laura",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "93f95dc5-f2cb-39d5-9d97-88a73beff25e",
                        "entry_id": "dae61948-b827-3a4a-9ae6-05b78b69f784",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e745062-1a2e-400b-9e7e-82e2db601e4d",
                                "sense_id": "93f95dc5-f2cb-39d5-9d97-88a73beff25e",
                                "text": "Laura, y a tant d’hommes que je ne suis pas.\nY a tant de phrases qu’on dit, que je ne dirais pas."
                            },
                            {
                                "example_id": "0fba7306-1046-4f39-82d0-de15e276ba09",
                                "sense_id": "93f95dc5-f2cb-39d5-9d97-88a73beff25e",
                                "text": "Pau, Camille, Juliette, Tiphaine, Laura et Samuel, tous proches de la trentaine, ont choisi de fonder une éco-location, dans le 12ᵉ arrondissement."
                            },
                            {
                                "example_id": "07782745-0bef-4ec5-bcad-67b0609a9161",
                                "sense_id": "93f95dc5-f2cb-39d5-9d97-88a73beff25e",
                                "text": "Adaptée du roman de l’Américaine Laura Kasischke, Esprit d’hiver, minisérie en trois épisodes, sera diffusée jeudi, à 20 h 55, sur Arte."
                            },
                            {
                                "example_id": "2771c505-ac55-48e7-9647-a21fa0139599",
                                "sense_id": "93f95dc5-f2cb-39d5-9d97-88a73beff25e",
                                "text": "Il le croyait perdu, et il ne se doutait pas que Laura l’avait conservé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d528dfc-737e-4089-8be5-78fbac70614f",
                        "source_entry_id": "dae61948-b827-3a4a-9ae6-05b78b69f784",
                        "source_sense_id": "93f95dc5-f2cb-39d5-9d97-88a73beff25e",
                        "target_lang_word": "Laura",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laura",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "441f71a2-755a-3217-b8be-fb1d9f23b687",
                                        "entry_id": "e0d30491-2032-3c3a-89cf-c18b44a349f8",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7348e9-d628-43c8-b195-2cdc6e52d833",
                                                "sense_id": "441f71a2-755a-3217-b8be-fb1d9f23b687",
                                                "text": "Now is he for the numbers that Petrarch flowed in; Laura to his lady was but a kitchen-wench; marry, she had a better love to be-rime her;"
                                            },
                                            {
                                                "example_id": "54ad4527-9d45-463b-9711-a0b2647adbde",
                                                "sense_id": "441f71a2-755a-3217-b8be-fb1d9f23b687",
                                                "text": "Laura was saying something. A mellifluous name, he thought. I wish she were far away, so I could call her."
                                            },
                                            {
                                                "example_id": "0ed466a1-d9b4-47e2-8c49-11d3e9c582d0",
                                                "sense_id": "441f71a2-755a-3217-b8be-fb1d9f23b687",
                                                "text": "'Mine's Laura'./ 'A beautiful name.'/ Laura has never liked her name. It's too old-fashioned and has, to her mind, a slightly whiny sound, like the twang of a country and western guitar. In fact she was given the name because Michelle liked the song 'Tell Laura I Love Her'."
                                            },
                                            {
                                                "example_id": "0d535dea-2bfe-40a3-963e-7f56b027d540",
                                                "sense_id": "441f71a2-755a-3217-b8be-fb1d9f23b687",
                                                "text": "The request for a retraction centers around an October 28 segment on Laura Ingraham’s prime time show, “The Ingraham Angle.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
