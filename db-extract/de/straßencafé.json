                ],
                "senses": [
                    {
                        "sense_id": "8cf66814-fc93-3de7-8e63-d35e175d02f4",
                        "entry_id": "7ced7412-5755-34d7-9444-ece818cda3bf",
                        "glosses": [
                            "Café mit einem Gastbereich außen an einem öffentlichen Weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be740f43-aaed-4059-a268-3955242be3b2",
                                "sense_id": "8cf66814-fc93-3de7-8e63-d35e175d02f4",
                                "text": "„In einem der Straßencafés kommen wir mit dem Paar am Nebentisch ins Gespräch.“"
                            },
                            {
                                "example_id": "605407dd-9ecc-4bee-a7ce-36cee1e247fb",
                                "sense_id": "8cf66814-fc93-3de7-8e63-d35e175d02f4",
                                "text": "„Als wir einmal zusammen in einem Straßencafé saßen, sagte er einem Schuhputzer, dass seine feinen Lederschuhe leider wirklich nicht geputzt werden müssten.“"
                            },
                            {
                                "example_id": "75f2cac1-24e6-4261-8b35-6749065f45f8",
                                "sense_id": "8cf66814-fc93-3de7-8e63-d35e175d02f4",
                                "text": "„In Teguise fand ich einen Parkplatz ganz in der Nähe des Marktes und setzte mich gleich ins erste Straßencafé; Rudi ließ ich allein zwischen den Marktständen schlendern.“"
                            },
                            {
                                "example_id": "48dcdef2-8c57-42a0-8cb3-20db35241ddb",
                                "sense_id": "8cf66814-fc93-3de7-8e63-d35e175d02f4",
                                "text": "„Gegen Abend wurde es noch lebhafter in den kleinen Städtchen entlang meiner Route, die Straßencafés waren voller Menschen, die aus kleinen Tässchen Tee oder Kaffee tranken, Wasserpfeifen rauchten und plauderten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
