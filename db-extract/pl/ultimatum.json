                "translations": [
                    {
                        "translation_id": "cd36a39e-4a95-420b-b2cd-eff90670d34e",
                        "source_entry_id": "5f39c134-75c2-3b61-b233-7b33a7c09c31",
                        "source_sense_id": "006849a3-5b86-3bf8-a472-7c962c3c53af",
