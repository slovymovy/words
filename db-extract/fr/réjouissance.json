                                "target_senses": [
                                    {
                                        "sense_id": "33465f51-4df5-3f0e-8127-6e232dc25057",
                                        "entry_id": "f2ab48d8-15f3-3862-b69c-957b2863bd08",
                                        "glosses": [
                                            "festliche Veranstaltung aus einem bestimmten Anlass"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56813453-f623-4220-910e-2f19704a8a86",
                                                "sense_id": "33465f51-4df5-3f0e-8127-6e232dc25057",
                                                "text": "Im Dorf findet auf Grund des 100-jährigen Bestehens des Rathauses eine Feier statt."
                                            },
                                            {
                                                "example_id": "02113d7c-9cad-4e5d-a6cd-2408a3e874e1",
                                                "sense_id": "33465f51-4df5-3f0e-8127-6e232dc25057",
                                                "text": "In der Stadt, in der die Eltern unseres Direktors wohnen, gab es eine äußerst große Feier, bei der mehrere kleine Kinder sangen und tanzten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a41fd2ba-0ff6-4c7a-a4b4-40389e111990",
                        "source_entry_id": "07abb681-a540-3d0d-bc67-f546058acb8a",
                        "source_sense_id": "cbf303e6-c5c8-34ca-82dc-a659312fd1d4",
