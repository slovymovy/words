                    {
                        "sense_id": "fdcacfca-b2b5-3cbf-85dc-1155e97506be",
                        "entry_id": "a8c6ae9f-aa64-3227-a7ad-22bfe474096d",
                        "glosses": [
                            "Cordage employé à lever les ancres, lorsque la grosseur et le peu de flexibilité de leurs câbles ne permettent pas de garnir ces derniers au cabestan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f557837-ae00-485f-a1d0-4cdd6ffe065a",
                                "sense_id": "fdcacfca-b2b5-3cbf-85dc-1155e97506be",
                                "text": "'La tournevire est un cordage employé à lever les ancres, lorsque la grosseur et le peu de flexibilité de leurs câbles ne permettent pas de garnir ces derniers au cabestan. — (François-Auguste Costé, Manuel de gréement, 1829, page 229)"
                            }
                        ]
                    },
                    {
                        "sense_id": "f5a74767-70d2-3798-ba7c-2e3025d3cadd",
                        "entry_id": "a8c6ae9f-aa64-3227-a7ad-22bfe474096d",
                        "glosses": [
                            "Jeu forain où l'on fait tourner un plateau chargé de lots pour savoir quel lot on a gagné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799e97ac-dc6d-4d64-a24e-b4b1ef4eaa37",
                                "sense_id": "f5a74767-70d2-3798-ba7c-2e3025d3cadd",
                                "text": "Un bal forain, couvert de toile, s’installait d’ordinaire dans les prés de l’Aigre ; et il y avait, sur la route, en face de la mairie, trois baraques, un tir, un camelot, vendant de tout, jusqu’à des rubans, et un jeu de tournevire, où l’on gagnait des sucres d’orge."
                            },
                            {
                                "example_id": "b43a837b-746a-4f14-923e-75bb9de64220",
                                "sense_id": "f5a74767-70d2-3798-ba7c-2e3025d3cadd",
                                "text": "J’ai résolu de mettre fin à cet état de choses en interdisant désormais le jeu de tournevire, qui rentre d’ailleurs dans la catégorie des jeux de hasard formellement prohibés par le Code pénal, article 475 , $ 5."
                            },
                            {
                                "example_id": "9a0cdcfb-87e1-4148-8ae6-6385ebf185f8",
                                "sense_id": "f5a74767-70d2-3798-ba7c-2e3025d3cadd",
                                "text": "Plus ils cherchaient à reprendre l’équilibre, plus ils tournaient ensemble sur eux-mêmes, à la façon des tournevires de la foire, dans cet entonnoir vaseux tout grouillant de serpents et de crapauds : leurs bras et leurs jambes s'agitaient dans le vide, désespérément, avec des mouvements de pantins en détresse."
                            }
                        ]
                    }
