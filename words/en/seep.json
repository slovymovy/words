                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His remaining confidence slowly <w>seeped</w> away during the interview. ",
                            "target_lang_translations": {
                                "tr": "Mülakat sırasında kalan özgüveni de yavaşça <w>yok oldu</w>.",
                                "ru": "Остатки его уверенности медленно <w>улетучивались</w> во время интервью.",
                                "cs": "Jeho zbývající sebevědomí se během pohovoru pomalu <w>vytrácelo</w>."
