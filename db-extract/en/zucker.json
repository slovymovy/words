                                    {
                                        "sense_id": "4b586dbb-32ac-32ed-b71a-a8c06023e472",
                                        "entry_id": "626b971a-a541-3698-9993-99c2b400ca6b",
                                        "glosses": [
                                            "ein aus Pflanzen gewonnenes, süß schmeckendes Nahrungsmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b511d5-d57a-4b7b-9109-a2387a85ab87",
                                                "sense_id": "4b586dbb-32ac-32ed-b71a-a8c06023e472",
                                                "text": "Ich trinke meinen Kaffee immer mit Zucker."
                                            },
                                            {
                                                "example_id": "0cca7756-2489-4d01-b0e3-1df07f5a90dc",
                                                "sense_id": "4b586dbb-32ac-32ed-b71a-a8c06023e472",
                                                "text": "„Maschmann begann 1947 mit der Bienenzucht, weil die britischen Soldaten für jeden Imker zum Füttern zwei Pfund Zucker extra freigaben.“"
                                            },
                                            {
                                                "example_id": "d1e7f0d7-026e-4e8b-888e-9dd0d0e353c6",
                                                "sense_id": "4b586dbb-32ac-32ed-b71a-a8c06023e472",
                                                "text": "„Eine weiße Oberschicht profitierte vom Handel mit Kaffee, Zucker, Baumwolle und Diamanten.“"
                                            },
                                            {
                                                "example_id": "6ed09905-bf16-485e-bde7-fb496e254cd0",
                                                "sense_id": "4b586dbb-32ac-32ed-b71a-a8c06023e472",
                                                "text": "„Mein Kellner hat den Zucker vergessen.“"
                                            },
                                            {
                                                "example_id": "38e0b77e-321d-4c4d-a7fa-220adcc2e634",
                                                "sense_id": "4b586dbb-32ac-32ed-b71a-a8c06023e472",
                                                "text": "„Der Kaffee war in einer Kanne und der Zucker daneben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bccac869-8e1b-31bb-89dc-3fe064515945",
                                        "entry_id": "626b971a-a541-3698-9993-99c2b400ca6b",
                                        "glosses": [
                                            "kristalliner, in Wasser gut löslicher chemischer Stoff, der aus Sacchariden besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b7783ae-9f4d-43f0-829d-a1f769827908",
                                                "sense_id": "bccac869-8e1b-31bb-89dc-3fe064515945",
                                                "text": "Die verschiedenen Zucker haben alle ihre speziellen Eigenschaften."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "24725762-9f0b-3b7b-9263-c2aa2ca248d7",
                                        "entry_id": "626b971a-a541-3698-9993-99c2b400ca6b",
                                        "glosses": [
                                            "ohne Plural, Medizinerjargon, Kurzwort für Blutzuckerspiegel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42ab1579-8d40-4979-b60c-278e3aab542c",
                                                "sense_id": "24725762-9f0b-3b7b-9263-c2aa2ca248d7",
                                                "text": "Wie ist denn ihr Zucker?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fd96c1b1-0b9c-382e-9624-90dd92e0b1b5",
                                        "entry_id": "626b971a-a541-3698-9993-99c2b400ca6b",
                                        "glosses": [
                                            "ohne Plural, umgangssprachlich, Kurzwort für Zuckerkrankheit (Diabetes mellitus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "650d40e3-67e8-49bc-823d-d32b3045bd42",
                                                "sense_id": "fd96c1b1-0b9c-382e-9624-90dd92e0b1b5",
                                                "text": "Ich habe Zucker."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zucker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0ee441-1ad6-3de7-a994-5eb78e81fbce",
                                        "entry_id": "e5e35437-924a-38ee-9370-b2881d144e09",
                                        "glosses": [
