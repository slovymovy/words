                    {
                        "sense_id": "526ff4c6-fdce-3733-8228-e66377c2e980",
                        "entry_id": "4ac17f21-2eeb-3e6f-969e-f1e869cadbf9",
                        "glosses": [
                            "voordat iets anders gebeurt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "102d525c-56a3-4e73-b384-faff868a16ce",
                                "sense_id": "526ff4c6-fdce-3733-8228-e66377c2e980",
                                "text": "We gaan eerst bij mijn ouders langs en daarna pas naar de stad."
                            },
                            {
                                "example_id": "47c2f121-7348-4d94-9a07-44aefcd3a4c5",
                                "sense_id": "526ff4c6-fdce-3733-8228-e66377c2e980",
                                "text": "Het KNGMG hoopt dat er nog gesprekken volgen met de vele instituten en bedrijven in binnen- en buitenland die gebruikmaken van de kennis en faciliteiten van de VU. \"We begrijpen dat de kosten hoog zijn voor de VU, en dat er financiële problemen zijn, maar dit is rücksichtslos. Dit moet je niet zelfstandig als instituut doen. Verschillende organisaties willen het gesprek aangaan. Verken nu eerst goed samen wat de mogelijkheden zijn voordat je iets afbreekt dat je niet snel weer opbouwt.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "19ab819b-7ee7-3d1c-940d-e299806de3fe",
                        "entry_id": "4ac17f21-2eeb-3e6f-969e-f1e869cadbf9",
                        "glosses": [
                            "in het begin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc243060-6d30-4bcf-a8a5-2d4514499838",
                                "sense_id": "19ab819b-7ee7-3d1c-940d-e299806de3fe",
                                "text": "Eerst gingen we naar school, later moesten we werken."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ce6f614-3b95-338c-9460-5eb08a43b92a",
                        "entry_id": "4ac17f21-2eeb-3e6f-969e-f1e869cadbf9",
                        "glosses": [
                            "pas [3], niet eerder dan, op een laat moment"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5637ecce-6058-43d6-b71f-40eaf0169d17",
                                "sense_id": "1ce6f614-3b95-338c-9460-5eb08a43b92a",
                                "text": "Hij kwam eerst om twee uur thuis."
                            }
                        ]
                    }
