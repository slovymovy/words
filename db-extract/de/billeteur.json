                    {
                        "sense_id": "576e2692-105f-3424-983a-aa4ab68d9f13",
                        "entry_id": "1552d8a0-4758-3c1d-8146-fbd62953f0ad",
                        "glosses": [
                            "Person, die vorwiegend Waren mit Zetteln versieht, welche Informationen über jene enthalten"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2ee16178-6e45-3de7-a4a3-97fd96046475",
                        "entry_id": "1552d8a0-4758-3c1d-8146-fbd62953f0ad",
                        "glosses": [
                            "Schreiber der Quartierbillets für Soldaten"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "bd9d37cd-a7f4-30fd-8115-c75638e51382",
                        "entry_id": "1552d8a0-4758-3c1d-8146-fbd62953f0ad",
                        "glosses": [
                            "– in Deutschland (männliche) beauftragte Person, die bei öffentlichen Veranstaltungen die Eintrittskarten hinsichtlich der Zutrittsberechtigung ansieht und – selten: – sie gegebenenfalls auch verkauft"
                        ],
                        "tags": [
                            "Austrian German",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "0d1bcaeb-4712-4261-b3f6-6fe5ea675336",
                                "sense_id": "bd9d37cd-a7f4-30fd-8115-c75638e51382",
                                "text": "„Damit auch die Operngäste in der Pause leicht und schnell ins Café kommen, wird es einen direkten Zugang zum Parkett geben - samt eigenem Billeteur.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "b17eec7a-4ca2-342b-b2d0-7cba5b727952",
                        "entry_id": "1552d8a0-4758-3c1d-8146-fbd62953f0ad",
                        "glosses": [
                            "(männliche) beauftragte Person, die im öffentlichen Personennahverkehr Fahrausweise (Billets) kontrolliert und verkauft"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "bb14f745-2822-41d6-93f8-7ead519ae191",
                                "sense_id": "b17eec7a-4ca2-342b-b2d0-7cba5b727952",
                                "text": "„Als er mit 18 Jahren vom Gymnasium kam, begann Urs Weber […] als Billeteur bei den BVB zu arbeiten. Sein erster Arbeitstag […] ist ihm noch gut in Erinnerung: ›Ich verkaufte die Billette […]‹“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
