                        ]
                    },
                    {
                        "translation_id": "546d34bf-3208-422d-9762-595e2a29da0d",
                        "source_entry_id": "9cfeee36-95ae-3b6c-8bd7-f0945668ffd5",
                        "source_sense_id": "ca07d9f2-3187-3f46-9f7a-3654d360d411",
                        "target_lang_word": "performance",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "performance",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "047ff1b2-f36a-3010-81b7-d6d04b42ed3e",
                                        "entry_id": "9d277811-bd89-38ae-abb9-9dda4eaaf05f",
                                        "glosses": [
                                            "uitvoering van een taak of functie"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e19ac8fc-37c8-355e-a9cb-a794a79a4354",
                                        "entry_id": "9d277811-bd89-38ae-abb9-9dda4eaaf05f",
                                        "glosses": [
                                            "uitvoering voor een publiek, voorstelling in een theater, optreden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be42e930-272a-4d18-be70-0f0acae57b4d",
                                                "sense_id": "e19ac8fc-37c8-355e-a9cb-a794a79a4354",
                                                "text": "Zijn cursus over Byzantijnse kunst was een wekelijkse pakkende performance, waar ik me zelfs met zware griep naartoe sleepte."
                                            },
                                            {
                                                "example_id": "cc21da45-8143-41a6-8940-0212905b174b",
                                                "sense_id": "e19ac8fc-37c8-355e-a9cb-a794a79a4354",
                                                "text": "De hele zaal stond op de banken tijdens zijn performance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0a7268b-59af-3d79-b737-94edcfff6b9a",
                                        "entry_id": "9d277811-bd89-38ae-abb9-9dda4eaaf05f",
                                        "glosses": [
                                            "moderne kunstvorm waarbij verschillende soorten kunst deels improviserend bij elkaar worden gebracht om een eenmalige belevenis tot stand te brengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cead6cf-ea7c-4ee5-9bde-cc1390f7d411",
                                                "sense_id": "e0a7268b-59af-3d79-b737-94edcfff6b9a",
                                                "text": "De performance ‘I'm leaving this room’, waarbij Oenema, gezeten naast een overheadprojector, zingend haar knipsels liet zien, stond onder meer op het Crossing Border Festival en Noorderslag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a6875e2-027f-3fe7-b114-8f12a496dc57",
                                        "entry_id": "9d277811-bd89-38ae-abb9-9dda4eaaf05f",
                                        "glosses": [
                                            "wijze van presenteren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "588bf5e5-e1fc-4d42-84ce-48e3b0ffb894",
                                                "sense_id": "3a6875e2-027f-3fe7-b114-8f12a496dc57",
                                                "text": "Gun het publiek - uw erfgoedgemeenschap - die diepgaandere blik achter en doorheen de eeuwige maskerade van manieren van voorstellen (performance) en van steeds weer voorlopige en voorwaardelijke duidingen (interpretatie)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4d80999-e993-3171-8e53-a9cd33e21c40",
                                        "entry_id": "9d277811-bd89-38ae-abb9-9dda4eaaf05f",
                                        "glosses": [
                                            "gedrag waarmee een eigen opvatting wordt getoond"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e55ec3f1-2e65-4858-9e6b-7986978cf29a",
                                                "sense_id": "e4d80999-e993-3171-8e53-a9cd33e21c40",
                                                "text": "Hun getuigenissen en reacties maken duidelijk dat kledingkeuze een vorm van bewuste, identiteitsconstruerende performance is, waardoor de meisjes zich identificeren met verschillende discursieve subjectposities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7958067-15df-31f3-8e42-f4ed07efa923",
                                        "entry_id": "9d277811-bd89-38ae-abb9-9dda4eaaf05f",
                                        "glosses": [
                                            "bereikte resultaat bij de uitvoering van een taak, functie of deelname aan een wedstrijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d390225-2a8c-4ba2-8e97-1576a44af728",
                                                "sense_id": "e7958067-15df-31f3-8e42-f4ed07efa923",
                                                "text": "Om maar eens een understatement te gebruiken: het is niet mijn beste performance geweest in de afgelopen jaren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae445173-0127-34b4-acba-d9d226925722",
                                        "entry_id": "9d277811-bd89-38ae-abb9-9dda4eaaf05f",
                                        "glosses": [
                                            "koersstijging van effecten [2] op de beurs [5]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec76d1d-07c9-461e-9d4d-7fb8fd79629f",
                                                "sense_id": "ae445173-0127-34b4-acba-d9d226925722",
                                                "text": "In 2005 had het aandeel Brill een performance van 33,9%, nog beter dan de overigens eveneens opmerkelijke performance in hetzelfde jaar van de Amsterdamse index van 30,6%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b9b7947-5690-3b7b-90d6-749cc75ded36",
                                        "entry_id": "9d277811-bd89-38ae-abb9-9dda4eaaf05f",
                                        "glosses": [
                                            "vermogen om prestaties te kunnen leveren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9587bdb-3437-45f5-93a4-0ae48f4720ad",
                                                "sense_id": "8b9b7947-5690-3b7b-90d6-749cc75ded36",
                                                "text": "Het veroorzaakt een kalmerende uitstoot van adrenaline, een gevoel van welzijn en een verhoogde performance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
