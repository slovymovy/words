                "senses": [
                    {
                        "sense_id": "bca4002d-decb-3b2d-b53b-b2cc33790f67",
                        "entry_id": "bee12f78-9369-3f5f-b375-16101710d848",
                        "glosses": [
                            "Vokal, der phonologische (bedeutungsunterscheidende) Eigenschaften hat"
                        ],
                        "tags": [
                            "Phonologie"
                        ],
                        "examples": [
                            {
                                "example_id": "89419291-6f46-4d28-9eb8-139792af5fa8",
                                "sense_id": "bca4002d-decb-3b2d-b53b-b2cc33790f67",
                                "text": "„Das System der mittelhochdeutschen Vokalphoneme haben wir konstituiert.“"
                            },
                            {
                                "example_id": "35a8f7dd-2ecf-4d80-b47e-4e71fc5ddc8f",
                                "sense_id": "bca4002d-decb-3b2d-b53b-b2cc33790f67",
                                "text": "„Zunächst werden in Abbildung 14 Vokalphoneme mit Oppositionspaaren aufgeführt; …“"
                            },
                            {
                                "example_id": "1abc5c28-dcc5-41a6-b448-3aa95cb4ef46",
                                "sense_id": "bca4002d-decb-3b2d-b53b-b2cc33790f67",
                                "text": "„Die relativen Häufigkeiten für die Vokalphoneme ergänzen sich also durch die für die Konsonantenphoneme angegebenen relativen Häufigkeiten beziehungsweise Wahrscheinlichkeiten zu 100%.“"
                            },
                            {
                                "example_id": "5343e52a-f98c-461b-816e-01e855be0f86",
                                "sense_id": "bca4002d-decb-3b2d-b53b-b2cc33790f67",
                                "text": "„Ob es unter jenen nordkaukasischen Sprachen, die das minimale Vokalsystem in der sprachlichen Welt enthalten, einzigartige Sprachen wie Kabardinisch und Abasa gibt, die angeblich keine Vokalgegensätze haben und sich auf ein einziges Vokalphonem beschränken, bleibt eine umstrittene Frage […].“"
                            },
                            {
                                "example_id": "f0b13510-f495-4b8d-b709-8e7ed1706012",
                                "sense_id": "bca4002d-decb-3b2d-b53b-b2cc33790f67",
                                "text": "„Die ungarischen Vokalphoneme lassen sich miteinander in folgende binäre Oppositionen stellen: …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
