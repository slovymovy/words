                        "examples": [
                            {
                                "example_id": "9571ed3c-2da0-49da-b807-d6d2657ff46c",
                                "sense_id": "1b7c59fe-b442-3614-9d1e-6146d55e6c5c",
                                "text": "Marleen Barth, PvdA-fractieleider in de Eerste Kamer, wordt op haar wenken bediend. Ze riep zaterdagochtend PvdA-vrouwen op om zich te mengen in de race om het fractieleiderschap in de Tweede Kamer. En nog geen twee uur later staat Nebahat Albayrak aan de PvdA-start."
                            },
                            {
                                "example_id": "1733c091-4d17-455e-a837-7cb797cb2930",
                                "sense_id": "1b7c59fe-b442-3614-9d1e-6146d55e6c5c",
                                "text": "Nebahat Albayrak heeft zich als eerste vrouw kandidaat gesteld voor het fractieleiderschap van de PvdA. Albayrak wilde haar besluit gisteren nog niet wereldkundig maken in verband met het nieuws over prins Friso."
                            },
                            {
                                "example_id": "334dde43-4152-4d3e-9fbf-148ba1fb4cbb",
                                "sense_id": "1b7c59fe-b442-3614-9d1e-6146d55e6c5c",
                                "text": "Tweede Kamerlid Diederik Samsom zegt voor de fractievergadering over het vertrek van partijleider Cohen dat hij nog niet weet of hij zich kandidaat stelt voor het fractieleiderschap."
                            }
