                "senses": [
                    {
                        "sense_id": "73f913dc-cfba-3177-8d52-22e27d8bccc6",
                        "entry_id": "5964ecef-85d9-3ef9-a02f-6623fd7a8626",
                        "glosses": [
                            "с.-х., биохим. физиологическая реакция растений на охлаждение, вызванная адаптацией к сезонным изменениям умеренного климата"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86a98251-8ecd-4b89-8b11-6787a1b2474e",
                                "sense_id": "73f913dc-cfba-3177-8d52-22e27d8bccc6",
                                "text": "Таким образом, яровизация семян сокращает срок и развития и созревания растения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "738738e1-b6d2-4b7f-ab4c-9afbf1cb3a03",
                        "source_entry_id": "5964ecef-85d9-3ef9-a02f-6623fd7a8626",
                        "source_sense_id": "73f913dc-cfba-3177-8d52-22e27d8bccc6",
                        "target_lang_word": "vernalization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vernalization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "addfa2b2-bb73-3ba0-be3c-336410e5abd7",
                                        "entry_id": "c8a7e599-399a-320b-bb15-6e4d93dcd08b",
                                        "glosses": [
                                            "The treatment of seeds or bulbs by exposure to low temperatures so as to decrease the vegetative period or to cause the plant to flower or bear fruit more quickly."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "457c6b90-aadb-4763-bd32-e28ec273f7d2",
                                                "sense_id": "addfa2b2-bb73-3ba0-be3c-336410e5abd7",
                                                "text": "This low temperature requirement for flowering, called vernalization, begins at germination. Vernalization is assumed to occur at temperatures between 0 and 18°C (Ahrens and Loomis, 1963; Tirone and Metzer, 1970)."
                                            },
                                            {
                                                "example_id": "00d593fc-56db-4b11-bba9-b659fc049ca8",
                                                "sense_id": "addfa2b2-bb73-3ba0-be3c-336410e5abd7",
                                                "text": "Species needing vernalization do not flower when grown in a warm climate."
                                            },
                                            {
                                                "example_id": "6e3896c4-1387-450d-ad4e-111a5ce76229",
                                                "sense_id": "addfa2b2-bb73-3ba0-be3c-336410e5abd7",
                                                "text": "For some plants, however, exposure to low temperatures during winter is an essential step in their development. Two of these processes, vernalisation and the breaking of winter dormancy, have important implications for gardeners."
                                            },
                                            {
                                                "example_id": "60d66ed0-ff75-479e-88ea-029e282cd104",
                                                "sense_id": "addfa2b2-bb73-3ba0-be3c-336410e5abd7",
                                                "text": "Furthermore, vernalization has been shown to override the late-flowering phenotype. […] Both VRN1 and VRN2 genes have been identified to be associated with vernalization."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb283fc0-d81b-48c6-a310-bd1e51b69b93",
                        "source_entry_id": "5964ecef-85d9-3ef9-a02f-6623fd7a8626",
                        "source_sense_id": "73f913dc-cfba-3177-8d52-22e27d8bccc6",
                        "target_lang_word": "Jarowisation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jarowisation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cffb04fa-2beb-3f4a-a272-f0a2ca03300d",
                                        "entry_id": "c5ab9c20-2423-31d8-a8be-8a3c98d622bb",
                                        "glosses": [
                                            "künstliche Anwendung von Licht- und Temperaturreizen auf gequollene Pflanzensamen, die Keimung, Blüte und Fruchtansatz unter schwierigeren klimatischen Bedingungen begünstigen oder beschleunigen (sollen)"
                                        ],
                                        "tags": [
                                            "Agrarbiologie",
                                            "Pflanzenphysiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c471b5d8-cf16-483d-a57e-8eaab9f80f9f",
                                                "sense_id": "cffb04fa-2beb-3f4a-a272-f0a2ca03300d",
                                                "text": "Das Verfahren der Jarowisation hat es in Rußland angeblich erlaubt, den Getreideanbau um mehrere Grad weiter nach Norden in Gebiete mit kürzeren Vegetationsperioden vorzuschieben."
                                            },
                                            {
                                                "example_id": "e729f766-85ed-4b99-80bb-1abd252d0842",
                                                "sense_id": "cffb04fa-2beb-3f4a-a272-f0a2ca03300d",
                                                "text": "Ernst zu nehmende Pflanzenzüchter und Experimentatoren vertreten die Auffassung, dass die Jarowisation in den meisten Fällen den Ernteertrag nicht erhöht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
