                    },
                    {
                        "translation_id": "a5f704e7-01d6-4080-bfb4-84b1ba579b08",
                        "source_entry_id": "b5be241c-1712-3004-b2d2-fb0a69b00552",
                        "source_sense_description": "one who violates",
                        "target_lang_word": "Zuwiderhandelnder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5cc2e47e-1e9f-4496-8dc4-7425d75718f1",
                        "source_entry_id": "b5be241c-1712-3004-b2d2-fb0a69b00552",
                        "source_sense_description": "one who violates",
                        "target_lang_word": "Täter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Täter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                        "entry_id": "a96ec9ae-2bc6-32df-b83e-94bed09890aa",
                                        "glosses": [
                                            "jemand, der etwas getan hat, womit fast immer eine verwerfliche Tat gemeint ist; häufig im juristischen Zusammenhang gebraucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8388af51-fdb5-43ce-8678-0487467e0cf4",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Lehrerin: „Hier hat jemand ein sehr hässliches Bild von Carola an die Tafel gemalt. Wer war der Täter?“"
                                            },
                                            {
                                                "example_id": "68ade528-29da-4ac5-ae35-48458733dce4",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "„Mancher Kriminalfall hat nur deshalb Berühmtheit erlangt, weil der Täter durch eine neuartige medizinische oder naturwissenschaftliche Methode überführt werden konnte.“"
                                            },
                                            {
                                                "example_id": "8c9ec2a6-5de8-470f-b1c5-4aff92ed3cfb",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "„So führen sie die Tradition der Blutrache fort und legen fest, dass die Familie eines Ermordeten den Täter töten darf.“"
                                            },
                                            {
                                                "example_id": "6d3c9e80-b349-4501-a04c-df9d5cfb4ef1",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Zu den bizarren Pointen der furchtbaren Terrorserie in Frankreich zählt aber auch die Tatsache, dass Muslime nicht nur Täter und Opfer, sondern auch Helden geworden sind. Am Mittwoch war es der Polizist Ahmed Merabet, ein 42-jähriger muslimischer Familienvater, den die terroristischen Kouachi-Brüder brutal ermordeten."
                                            },
                                            {
                                                "example_id": "92bd71e6-232a-4894-aa0e-81fc5f4bc2bf",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Nach über 30 Jahren tauchten nun neue Beweise gegen den Täter auf, doch weil sein Freispruch rechtskräftig ist, ist es fast unmöglich, wieder gegen ihn zu ermitteln."
                                            },
                                            {
                                                "example_id": "950ce7c7-3964-482c-a638-d30a35c980fc",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Dieses Jubliäum könne nur deshalb gefeiert werden, weil das Land der Opfer [Israel] dem der Täter [Deutschland] die Hand gereicht habe. \"Für uns Deutsche wie ein Wunder\", betonte der Außenminister."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40da0e0c-ba01-4885-a022-e4a53bc63be4",
                        "source_entry_id": "b5be241c-1712-3004-b2d2-fb0a69b00552",
                        "source_sense_description": "one who violates",
                        "target_lang_word": "Übertreter (des Gesetzes)",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a2adfcad-0a32-4378-8051-4ee6b85e34f5",
                        "source_entry_id": "b5be241c-1712-3004-b2d2-fb0a69b00552",
                        "source_sense_description": "one who violates",
                        "target_lang_word": "Vergewaltiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vergewaltiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9da5fb0b-8ee9-3ec4-90d1-ffe9224bd1b0",
                                        "entry_id": "5fa996a3-db30-3a61-a9d5-a824b7ae4df5",
                                        "glosses": [
                                            "Person, die eine andere Person vergewaltigt (hat), die eine Vergewaltigung begeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2740a141-8e51-4e9c-adfb-2abc92a80b4e",
                                                "sense_id": "9da5fb0b-8ee9-3ec4-90d1-ffe9224bd1b0",
                                                "text": "„Mit 23 Messerstichen soll ein Teenager in Baden-Württemberg Selbstjustiz geübt und den mutmaßlichen Vergewaltiger seiner Schwester ermordet haben.“"
                                            },
                                            {
                                                "example_id": "18a50752-a24b-4c2c-b360-777954f16ce8",
                                                "sense_id": "9da5fb0b-8ee9-3ec4-90d1-ffe9224bd1b0",
                                                "text": "„Ein Vergewaltiger und Frauenmörder, dem sie gerade erst eine positive Prognose gestellt hat, nimmt Hanna als Geisel, in ihrem Büro.“"
                                            },
                                            {
                                                "example_id": "e40128d0-738a-4075-ac9f-fa57e841b370",
                                                "sense_id": "9da5fb0b-8ee9-3ec4-90d1-ffe9224bd1b0",
                                                "text": "„Als der Vergewaltiger die Gedemütigte an ihre Leute zurückverkaufen wollte, ließ sie ihn enthaupten und brachte ihrem Mann den Kopf des Übeltäters.“"
                                            },
                                            {
                                                "example_id": "d2daf56a-6e9c-4f89-ba24-f92d2ae3e9fa",
                                                "sense_id": "9da5fb0b-8ee9-3ec4-90d1-ffe9224bd1b0",
                                                "text": "„Ihre Familie klagte die Vergewaltiger an, woraufhin sechs von ihnen verurteilt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
