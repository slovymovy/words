                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e7883b-f77a-4a49-9e27-a8b9e39bfb9d",
                                                "sense_id": "4c8e5910-f57a-3993-8684-1bbc2d62137f",
                                                "text": "Die meistverwendete Lagerung bewusstloser Menschen ist die Stabile Seitenlage"
