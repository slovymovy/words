                        "examples": [
                            {
                                "example_id": "849c94e7-4b5f-4b7e-b078-2141cc3d85fd",
                                "sense_id": "a304c573-5ce8-3e7a-8433-b06435319339",
                                "text": "Whereas nearly all of about 20 pre-1860 locomotives existing in this country have been reframed, reboilered, or in other respects lost their identity through reconstruction […]"
                            },
                            {
                                "example_id": "1bbb8d5b-327d-4e08-a36e-f25490c21822",
                                "sense_id": "a304c573-5ce8-3e7a-8433-b06435319339",
                                "text": "She lasted until 1949 and was never reboilered to class J3."
                            },
                            {
                                "example_id": "8c186192-4e97-4794-8d09-b3f7fc7aef3c",
                                "sense_id": "a304c573-5ce8-3e7a-8433-b06435319339",
                                "text": "Her engines gave constant trouble and she was reboilered with higher-pressure units in 1878."
                            }
                        ]
