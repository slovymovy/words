                "senses": [
                    {
                        "sense_id": "e3806ca7-bbde-38a0-b71a-eaca7fb76c0b",
                        "entry_id": "67c4386a-e958-3266-83c5-6f09bb13f243",
                        "glosses": [
                            "An ideology based on the belief that people, goods and information ought to be able to cross national borders unfettered."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "10c96d75-ca94-348a-9566-b9ec6d83204e",
                        "entry_id": "67c4386a-e958-3266-83c5-6f09bb13f243",
                        "glosses": [
                            "A socio-economic system dedicated to free trade and free access to markets."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
