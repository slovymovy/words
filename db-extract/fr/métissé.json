                        "glosses": [
                            "Qui a subi le métissage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a980d6a4-7e08-4f1f-b6eb-a996a8f63786",
                                "sense_id": "63617ab5-2b77-3b09-92a8-63f2e891c327",
                                "text": "Le croisement se continuera en alliant les métisses de premier sang à des mâles de race pure, puis.... en excluant toujours les mâles métis pour ne marier jamais les femelles métissées qu'à des étalons [reproducteurs] de pur sang."
                            }
                        ]
