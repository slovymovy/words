                "senses": [
                    {
                        "sense_id": "74f6348c-febb-3527-9685-df115ead7b09",
                        "entry_id": "faabdf38-b714-37e4-9b47-bff81fd0739a",
                        "glosses": [
                            "Krimineller, der nur kleinere Delikte (Kleinkriminalität) begeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce3e742d-0bf3-4b10-b37e-e75c1f45c4f8",
                                "sense_id": "74f6348c-febb-3527-9685-df115ead7b09",
                                "text": "Der Kleinkriminelle wurde nach Zahlung einer Geldstrafe aus der Haft entlassen."
                            },
                            {
                                "example_id": "5d0392de-ca8e-4bbc-9ab3-c5a72830e256",
                                "sense_id": "74f6348c-febb-3527-9685-df115ead7b09",
                                "text": "„Und er ärgerte sich, dass er seinen gefälschten Ausweis zu Hause gelassen hatte. Den, auf dem stand, dass er 1945 geboren war, und für dessen Anfertigung er diesem Kleinkriminellen in Malmö hundertfünfzig Kronen hatte zahlen müssen.“"
                            },
                            {
                                "example_id": "02f24a8a-0211-4556-960a-598d9b7217fd",
                                "sense_id": "74f6348c-febb-3527-9685-df115ead7b09",
                                "text": "„Ab und an tun sie sich mit ausländischen Kleinkriminellen zusammen, die ihnen dann geheime Daten über Aussteiger, die sogenannten Steuersünder – wie es in der Szenesprache heißt – übergeben.“"
                            },
                            {
                                "example_id": "8feff79f-42fe-494f-ac03-48ba76f4afa4",
                                "sense_id": "74f6348c-febb-3527-9685-df115ead7b09",
                                "text": "„Er sieht aus wie eine Kreuzung aus einem Hippie und einem mexikanischen Kleinkriminellen.“"
                            },
                            {
                                "example_id": "95224f74-7c67-4362-bffc-65f21e84d98d",
                                "sense_id": "74f6348c-febb-3527-9685-df115ead7b09",
                                "text": "„Tochter Eva befreit sich aus den Fängen ihres Zuhälters, aber ist nach siebzehn Jahren Prostitution nur noch ein Wrack, Sohn Erich wird Kleinkrimineller auf niederstem Niveau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
