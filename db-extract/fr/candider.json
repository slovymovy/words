                "senses": [
                    {
                        "sense_id": "8c03e19a-9913-35ba-a3e0-77ee00850eb7",
                        "entry_id": "20762495-dcaa-37cf-a53b-23081a927237",
                        "glosses": [
                            "Se comporter en candidat (à un poste politique), notamment en multipliant les contacts pour créer des sympathies."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c6927753-b5ef-40be-b82c-467908e876a9",
                                "sense_id": "8c03e19a-9913-35ba-a3e0-77ee00850eb7",
                                "text": "Lancement d'un livre …. Quelques centaines de personnes. … Jean-François Lisée et Alexandre Cloutier ratissent la salle. Les candidats « candident » disions-nous au début de mes années politiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "acefbc30-50b4-3f21-94d5-d224aef3555d",
                        "entry_id": "20762495-dcaa-37cf-a53b-23081a927237",
                        "glosses": [
                            "Être candidat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb92cce7-9490-4d55-a7d8-e1ea71525165",
                                "sense_id": "acefbc30-50b4-3f21-94d5-d224aef3555d",
                                "text": "S’il veut m’empêcher de candider, qu’il y vienne!"
                            },
                            {
                                "example_id": "bdb210c6-349e-43d4-b6d4-592a24074c63",
                                "sense_id": "acefbc30-50b4-3f21-94d5-d224aef3555d",
                                "text": "Pour candider, vous allez répondre à quelques questions avec le plus de précision possible, qu’on arrive à bien vous cerner (enfin que J’arrive à bien vous cerner)."
                            },
                            {
                                "example_id": "a1ff5e88-5d90-4174-ba4b-981a2a2c9c31",
                                "sense_id": "acefbc30-50b4-3f21-94d5-d224aef3555d",
                                "text": "J’ai candidé chez StarDucks."
                            }
                        ]
                    }
