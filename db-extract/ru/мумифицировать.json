                    {
                        "translation_id": "61468f0e-00ea-4e5f-9f14-e661f9334b47",
                        "source_entry_id": "6b2f58ed-87cb-3a16-a640-57833f294117",
                        "source_sense_id": "bc6df3e5-f384-358b-9e77-82b8f85ed665",
                        "target_lang_word": "embalm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embalm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e94a8c4-f4a4-39f3-b964-22f7d63dc3b0",
                                        "entry_id": "934a16fa-9796-3802-8b8d-59a5d198c181",
                                        "glosses": [
                                            "To treat a corpse with preservatives in order to prevent decomposition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efe1aecd-5175-40ed-9843-cf86dd44bf1d",
                                                "sense_id": "5e94a8c4-f4a4-39f3-b964-22f7d63dc3b0",
                                                "text": "And Joseph commanded his servants the physicians to embalm his father."
                                            },
                                            {
                                                "example_id": "8785d8e4-a1c9-45f8-a97f-9d6ac0efe6fd",
                                                "sense_id": "5e94a8c4-f4a4-39f3-b964-22f7d63dc3b0",
                                                "text": "`Yea. The people of Kôr ever embalmed their dead, as did the Egyptians, but their art was greater than the art of the Egyptians, for, whereas the Egyptians disembowelled and drew the brain, the people of Kôr injected fluid into the veins, and thus reached every part.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f40bb61-fc9f-32c8-96a5-4dd61d97786a",
                                        "entry_id": "934a16fa-9796-3802-8b8d-59a5d198c181",
                                        "glosses": [
                                            "To preserve."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d46901-2060-4dbb-a04a-7dc465c8c134",
                                                "sense_id": "5f40bb61-fc9f-32c8-96a5-4dd61d97786a",
                                                "text": "It is very curious to observe how the idea of revenge, inspired by an Egyptian who lived before the time of Christ, is thus, as it were, embalmed in an English family name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde6e37d-fc9d-3b5e-8de9-f0aa68f28b58",
                                        "entry_id": "934a16fa-9796-3802-8b8d-59a5d198c181",
                                        "glosses": [
                                            "To perfume or add fragrance to something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
