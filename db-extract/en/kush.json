            {
                "entry_id": "56ab86d9-93bb-3248-b46b-88ba2b46b70c",
                "word": "kush",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "498fd979-b2d6-3bcb-8361-18d2d8a9f773",
                        "entry_id": "56ab86d9-93bb-3248-b46b-88ba2b46b70c",
                        "glosses": [
                            "Marijuana, especially Cannabis indica (a variety of marijuana originating in Afghanistan and northern Pakistan, strains of which often have high THC content)."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0283331d-e9e9-4a18-9ec7-6d3143530c86",
                                "sense_id": "498fd979-b2d6-3bcb-8361-18d2d8a9f773",
                                "text": "Baby, who you callin' soft / Don't make me smoke up all your kush / Don't make me pop your cheap ass pills"
                            },
                            {
                                "example_id": "5435503d-d36f-4259-a748-b1ea0f635405",
                                "sense_id": "498fd979-b2d6-3bcb-8361-18d2d8a9f773",
                                "text": "Smoking on that kush all in our section / Like it's legalized"
                            },
                            {
                                "example_id": "a127cd23-a480-4cd8-92e1-52ddcb596200",
                                "sense_id": "498fd979-b2d6-3bcb-8361-18d2d8a9f773",
                                "text": "Later in the day, Siyad is heard on a wiretap telling another man that he received “1.5 of kush” (slang for marijuana) from “Rob Ford’s driver.” Later Siyad tells another person, a woman, that what he received was actually “Rob Ford’s kush.”"
                            }
                        ]
                    }
                ],
