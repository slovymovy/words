                    {
                        "sense_id": "0e64e7d2-639e-3849-aa5a-82b93e2eedde",
                        "entry_id": "d05c2168-b75a-3992-b016-3b7fd74e8215",
                        "glosses": [
                            "Person, die durch Taten, Schriften oder Äußerungen Gott oder ein heiliges Wesen geringschätzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae7c3081-022f-44ae-8598-7909958050ca",
                                "sense_id": "0e64e7d2-639e-3849-aa5a-82b93e2eedde",
                                "text": "Deren Vorsitzender Sha Turabul Haq erklärte, die Proteste würden so lange fortgesetzt, \"bis die Stifte der Blasphemiker zerbrochen sind und ihre Zungen schweigen\"."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "485ce847-bae0-4cbd-b122-387f19c13a5b",
                        "source_entry_id": "d05c2168-b75a-3992-b016-3b7fd74e8215",
                        "source_sense_id": "0e64e7d2-639e-3849-aa5a-82b93e2eedde",
                        "source_sense_description": "Person, die durch Taten, Schriften oder Äußerungen Gott oder ein heiliges Wesen geringschätzt",
                        "target_lang_word": "blasphemer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blasphemer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afd5a656-7bf2-36b4-80f0-47dd31f79d3b",
                                        "entry_id": "18507b2f-15e0-315c-866c-0f6e79a1f36e",
                                        "glosses": [
                                            "One who commits blasphemy; a person who mocks or derides a deity or religion, or claims to be God."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a5833de-d36a-4c3e-bfc0-b059ad94324b",
                        "source_entry_id": "d05c2168-b75a-3992-b016-3b7fd74e8215",
                        "source_sense_id": "0e64e7d2-639e-3849-aa5a-82b93e2eedde",
                        "source_sense_description": "Person, die durch Taten, Schriften oder Äußerungen Gott oder ein heiliges Wesen geringschätzt",
                        "target_lang_word": "blasphémateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blasphémateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba45bb95-801d-32a6-bf77-bee8f365ec06",
                                        "entry_id": "484dceea-aaad-383a-8011-17a7d5819951",
                                        "glosses": [
                                            "Qui blasphème."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec8c8f9-8071-4e76-ab70-8b452e764ca4",
                                                "sense_id": "ba45bb95-801d-32a6-bf77-bee8f365ec06",
                                                "text": "On sait cela, et bien d’autres choses, mais on redoute ce prêtre violent, ivrogne, blasphémateur et même voleur à l’occasion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blasphémateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c1179e-cc69-3db0-a6e6-95902fb427c2",
                                        "entry_id": "3c9792f5-2c0c-317b-9935-5e523713e09d",
                                        "glosses": [
                                            "Celui qui blasphème."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33801ae8-69d9-4061-b933-20d88f8d63de",
                                                "sense_id": "e9c1179e-cc69-3db0-a6e6-95902fb427c2",
                                                "text": "Nous avons des lois de S. Louis & de plusieurs autres de nos rois, qui condamnent les blasphémateurs à être mis au pilori & à avoir la langue percée avec un fer chaud par la main du bourreau."
                                            },
                                            {
                                                "example_id": "a00be141-5c54-4985-84f8-9e8c16761808",
                                                "sense_id": "e9c1179e-cc69-3db0-a6e6-95902fb427c2",
                                                "text": "Mais ce serait une impiété de nous arrêter plus longtemps auprès du lit de mort du blasphémateur et du parricide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
