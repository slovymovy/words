                        "source_entry_id": "eafbefc0-60c2-3b07-a42e-05a2da62e157",
                        "source_sense_description": "competition in a tournament whose winners go on to play in the two semifinals",
                        "target_lang_word": "quart de finale",
                        "target_lang_code": "fr",
