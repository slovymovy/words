        "fr-extract.jsonl": [
            {
                "entry_id": "47a87318-7900-3114-9185-801bb62f5c19",
                "word": "fisc",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "96dbeca9-b3df-4815-9dd9-adfd6035ed50",
                        "entry_id": "47a87318-7900-3114-9185-801bb62f5c19",
                        "tags": [
                            "plural"
                        ],
                        "form": "fiscs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2143c83-54df-3acc-9f2b-2c1c7527ba34",
                        "entry_id": "47a87318-7900-3114-9185-801bb62f5c19",
                        "glosses": [
                            "Trésor de l’État."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58bd79ba-dd12-4dab-8b4d-765dc83e207e",
                                "sense_id": "a2143c83-54df-3acc-9f2b-2c1c7527ba34",
                                "text": "L’intérêt du fisc. — Les droits du fisc."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b53fa30-0756-3c07-a9ef-5075e78e6859",
                        "entry_id": "47a87318-7900-3114-9185-801bb62f5c19",
                        "glosses": [
                            "Administration chargée de la conservation des droits du fisc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7f979508-f646-4144-92b9-b83a3a76ee05",
                                "sense_id": "3b53fa30-0756-3c07-a9ef-5075e78e6859",
                                "text": "Ce jour-là, par un heureux hasard, il avait dépisté les gabelous de Villers et glissé entre les lignes de ceux du Luhier et de Fuans sans être obligé de prendre le pas de course ni de se colleter, […], homme contre homme, devant le représentant du fisc."
                            },
                            {
                                "example_id": "29644677-8d31-4708-b64b-1ac79c6db175",
                                "sense_id": "3b53fa30-0756-3c07-a9ef-5075e78e6859",
                                "text": "La pauvreté n'est pas abstraite, elle a un visage. Ce matin du 25 aout, c'est celui d'un jeune quêteux cassé comme un clou qui nous demande une petite pièce en se cachant. J'ai lu que le fisc canadien exigeait que les revenus de la mendicité fussent déclarés, « une décision difficile mais qui s'impose »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6dc82be-39d5-4cf6-bd4f-cbeebcee2d3d",
                        "source_entry_id": "47a87318-7900-3114-9185-801bb62f5c19",
                        "target_lang_word": "Staatskasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staatskasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81271998-7d8f-3622-a180-a5bdd659a669",
                                        "entry_id": "40396021-44fa-39a3-916c-fa3aaeb36158",
                                        "glosses": [
                                            "gesamtes Barvermögen eines Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40de2df8-ece2-4df9-ad19-b906bba94bf6",
                                                "sense_id": "81271998-7d8f-3622-a180-a5bdd659a669",
                                                "text": "Steuern und Abgaben fließen direkt in die Staatskasse."
                                            },
                                            {
                                                "example_id": "97ac5889-0a79-4c35-b086-7dd8aacaeac4",
                                                "sense_id": "81271998-7d8f-3622-a180-a5bdd659a669",
                                                "text": "„Statt der avisierten 200 Millionen Dollar an Steuereinnahmen flossen lediglich 27 Millionen in die Staatskasse – kein Wunder, wurden den Konzernen doch Steuerbefreiungen für die Dauer von bis zu dreißig Jahren gewährt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77ef5cd2-f354-350b-b44d-551ded69b7ed",
                                        "entry_id": "40396021-44fa-39a3-916c-fa3aaeb36158",
                                        "glosses": [
                                            "Staat als Wirtschaftssubjekt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8e4518f-bbd4-408e-a34a-4cd4cf54b632",
                                                "sense_id": "77ef5cd2-f354-350b-b44d-551ded69b7ed",
                                                "text": "Das Projekt wurde komplett privat finanziert, die Staatskasse gab dazu keinen Cent."
                                            },
                                            {
                                                "example_id": "3b8a6c80-fdb3-4d7f-8d34-3838124957f7",
                                                "sense_id": "77ef5cd2-f354-350b-b44d-551ded69b7ed",
                                                "text": "„So bleibt Leopold vorerst nichts übrig, als das belgische Parlament anzupumpen, obwohl er ja versprochen hat, niemals mit einer Kolonie die Staatskasse zu belasten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90ee3850-f949-4964-8c72-5450f153e1aa",
                        "source_entry_id": "47a87318-7900-3114-9185-801bb62f5c19",
                        "target_lang_word": "Steuerbehörde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c749ad3d-e059-449e-84ad-7d9d6f948b60",
                        "source_entry_id": "47a87318-7900-3114-9185-801bb62f5c19",
                        "target_lang_word": "Fiskus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fiskus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d83687fe-2d89-397f-9f88-ffd5ad570e47",
                                        "entry_id": "1e8f4299-36f0-325a-aa05-df2d6fa00fa8",
                                        "glosses": [
                                            "gesamtes Barvermögen eines Staates; Staatskasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "370870e3-89be-4446-9fc3-4cbbc236cfe8",
                                                "sense_id": "d83687fe-2d89-397f-9f88-ffd5ad570e47",
                                                "text": "Dieses Jahr mussten wir schon wieder mehr Steuern an den Fiskus zahlen."
                                            },
                                            {
                                                "example_id": "f8ee6bec-74c8-4a7e-afaa-7878d1c4ea5c",
                                                "sense_id": "d83687fe-2d89-397f-9f88-ffd5ad570e47",
                                                "text": "„Schmenger und andere Fahnder befürchteten Millionenverluste für den Fiskus.“"
                                            },
                                            {
                                                "example_id": "47216f75-823d-4c67-bb47-52a59354419c",
                                                "sense_id": "d83687fe-2d89-397f-9f88-ffd5ad570e47",
                                                "text": "„Weil keine Erben dafür da waren, zog der Fiskus ihn ein und forstete ihn auf.“"
                                            },
                                            {
                                                "example_id": "e7b771f7-0bad-4d02-8322-aaa01cd37446",
                                                "sense_id": "d83687fe-2d89-397f-9f88-ffd5ad570e47",
                                                "text": "„Strafbar waren natürlich Geschäfte unter dem Ladentisch und am Fiskus vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee4730f2-5411-49dd-9cbd-7b3af3530d6d",
                        "source_entry_id": "47a87318-7900-3114-9185-801bb62f5c19",
