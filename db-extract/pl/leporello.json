                                            {
                                                "example_id": "7fc6f525-a7e4-4650-a4c4-319a293674fb",
                                                "sense_id": "d644938d-68b0-33f0-9798-127fcc41cb8d",
                                                "text": "Ich habe auf dem Dachboden ein altes Leporello über die Schwarzwaldbahn gefunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db7a73f6-7ec4-3c39-8528-2c9da5294e34",
                                        "entry_id": "a34dc28b-ea91-3823-b5c8-33eedee49be8",
                                        "glosses": [
                                            "Unterlagen, die eine Universität ihren Studenten zum Semesterbeginn zukommen lässt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c4f37da-e87f-4594-8d5d-a2d6f5af5be6",
                                                "sense_id": "db7a73f6-7ec4-3c39-8528-2c9da5294e34",
                                                "text": "Ich habe gestern mein Leporello mit den Studienbescheinigungen erhalten."
                                            },
                                            {
                                                "example_id": "ab972d22-da27-4e63-a4f4-d57a257548bf",
                                                "sense_id": "db7a73f6-7ec4-3c39-8528-2c9da5294e34",
                                                "text": "„[…] die TU Braunschweig [führte] im Jahr 2015 die multifunktionale Chipkarte TUcard als neuen Studierendenausweis ein. Die TUcard löste das alte Leporello mit Semesterticket, die Mensakarte und den Bibliotheksausweis der Universitätsbibliothek ab […].“"
                                            },
                                            {
                                                "example_id": "dcfffef4-cc0e-47b5-ae74-846eec273adc",
                                                "sense_id": "db7a73f6-7ec4-3c39-8528-2c9da5294e34",
                                                "text": "„Die Studienbescheinigung (Leporello) können Sie selbst im ALMA-Portal […] ausdrucken“"
                                            },
                                            {
                                                "example_id": "5da83cae-d980-4d66-9065-7d16a403ed89",
                                                "sense_id": "db7a73f6-7ec4-3c39-8528-2c9da5294e34",
                                                "text": "„Bald ist es wieder soweit: Tausende Erstis und alte Semester finden ihr Leporello in der Post und beginnen mit der Planung ihres Studiums.“"
                                            },
                                            {
                                                "example_id": "c76e4231-0a1b-4441-8b25-9fc94bad4e11",
                                                "sense_id": "db7a73f6-7ec4-3c39-8528-2c9da5294e34",
                                                "text": "„Bereits immatrikulierte Studenten der Universität Rostock melden sich im Studentensekretariat zur Umschreibung. In diesem Fall ist, soweit bereits vorhanden, das aktuelle Leporello vorzulegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Leporello",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7327d0b-3bff-3df4-ad2d-f8b5973aac86",
