                        "glosses": [
                            "een actie die meer door toeval dan door kunde geslaagd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b44b3b73-93ad-4478-a788-5e5ac0692f08",
                                "sense_id": "66c6e02d-faa1-375c-9263-94e8e83f105e",
                                "text": "Hidde van Warmerdam en Michiel Elijzen analyseren de openingstijdrit van de Tour de France. 'Thomas is een verrassende winnaar, maar het is zeker geen gelukstreffer.'"
                            },
                            {
                                "example_id": "af9e503f-6ed2-4eb4-acda-5b127acab284",
                                "sense_id": "66c6e02d-faa1-375c-9263-94e8e83f105e",
                                "text": "Aanvankelijk was AZ net als in het eerste uur van de wedstrijd de bovenliggende partij, maar door de gelukstreffer van Karagkounis kregen de Grieken toch nog hoop op een stuntje. Vlak voor tijd schoot een speler van Atromitos nog loeihard op de paal, maar dichterbij kwam de ploeg niet."
                            }
                        ]
                    }
