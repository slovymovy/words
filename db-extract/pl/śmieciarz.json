                                        "sense_id": "00ee4994-2f7d-39c1-9f26-36247818033a",
                                        "entry_id": "d0360a42-5f4a-34b6-8f59-9a5518d4d331",
                                        "glosses": [
                                            "A person employed to collect refuse from people's homes and take it to be processed."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d78a80ad-ad92-4803-9917-28c1319a1f0d",
                                                "sense_id": "00ee4994-2f7d-39c1-9f26-36247818033a",
                                                "text": "Oh, my old man's a dustman\nHe wears a dustman’s hat\nHe wears cor-blimey trousers\nAnd he lives in a council flat."
                                            }
                                        ]
