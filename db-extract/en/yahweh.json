                    {
                        "translation_id": "80bed234-912f-4209-9225-e2baa0697903",
                        "source_entry_id": "5eb92feb-731a-366e-86b6-0fa58871af73",
                        "source_sense_id": "bea70d9f-a5fd-3903-8161-6db78bc6515a",
