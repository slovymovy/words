                        "glosses": [
                            "Characterised or marked by scariness; frightful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b2bdf1-ebc6-4d5d-abe2-ea3a1699e945",
                                "sense_id": "ccc2bc19-8a2e-328d-b905-8f4e0a17cc35",
                                "text": "But I do remember a scaresome fight at the end of Broagh Road, just a couple of hundred yards from our house in Mossbawn."
                            },
                            {
                                "example_id": "9c954e3e-3480-44f2-bed4-a9f0022cb21d",
                                "sense_id": "ccc2bc19-8a2e-328d-b905-8f4e0a17cc35",
                                "text": "She looked like a raven about to take flight, half bird, half woman, like she'd sprouted wings from her shoulders. I couldn't see where her arms ended and the cape began. It was stunning and scaresome all at the same time."
                            },
                            {
                                "example_id": "d72dd5af-9340-43b7-8844-c6e1b3c66b74",
                                "sense_id": "ccc2bc19-8a2e-328d-b905-8f4e0a17cc35",
                                "text": "A traveler, in journeying through that waste and howling and terrible wilderness, would meet with many a rough road, many a rugged way, many a rocky ascent, many an uncultivated waste, many a harsh sound, many a scaresome sight, many a tangled spot, many a thorny place, many a toil, and many a trial."
                            }
                        ]
                    }
