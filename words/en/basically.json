                {
                    "sense_id": "cc6b6f9e-34ec-3f06-8a58-a97b36776bd8",
                    "sense_definition": "For the most part; almost completely or strictly true.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new house is <w>basically</w> finished, but we still need to paint the walls.",
                            "target_lang_translations": {
                                "ru": "Новый дом <w>практически</w> готов, но нам всё ещё нужно покрасить стены.",
                                "zh": "新房子<w>基本上</w>完工了，但我们还需要粉刷墙壁。",
                                "pl": "Nowy dom jest <w>w zasadzie</w> gotowy, ale wciąż musimy pomalować ściany.",
                                "tr": "Yeni ev <w>temelde</w> bitti, ancak duvarları hâlâ boyamamız gerekiyor.",
                                "nl": "Het nieuwe huis is <w>praktisch</w> af, maar we moeten de muren nog schilderen.",
                                "de": "Das neue Haus ist <w>im Wesentlichen</w> fertig, aber wir müssen die Wände noch streichen.",
                                "fr": "La nouvelle maison est <w>pratiquement</w> terminée, mais nous devons encore peindre les murs.",
                                "it": "La nuova casa è <w>praticamente</w> finita, ma dobbiamo ancora dipingere i muri.",
                                "cs": "Nový dům je <w>prakticky</w> hotový, ale ještě musíme vymalovat stěny.",
                                "es": "La casa nueva está <w>prácticamente</w> terminada, pero todavía tenemos que pintar las paredes."
                            }
                        },
                        {
                            "text": "It is <w>basically</w> the same recipe, just with less sugar.",
                            "target_lang_translations": {
                                "ru": "Это <w>по сути</w> тот же рецепт, просто с меньшим количеством сахара.",
                                "zh": "这<w>基本上</w>是同一个食谱，只是糖放得少一点。",
                                "pl": "To <w>w zasadzie</w> ten sam przepis, tylko z mniejszą ilością cukru.",
                                "tr": "Bu <w>temelde</w> aynı tarif, sadece daha az şekerli.",
                                "nl": "Het is <w>eigenlijk</w> hetzelfde recept, alleen met minder suiker.",
                                "de": "Es ist <w>im Grunde</w> dasselbe Rezept, nur mit weniger Zucker.",
                                "fr": "C'est <w>en gros</w> la même recette, simplement avec moins de sucre.",
                                "it": "È <w>in pratica</w> la stessa ricetta, solo con meno zucchero.",
                                "cs": "Je to <w>v podstatě</w> stejný recept, jen s menším množstvím cukru.",
                                "es": "Es <w>básicamente</w> la misma receta, solo que con menos azúcar."
                            }
                        }
                    ],
