    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "be310345-7481-3915-ba74-c43d32fe8cc9",
                    "sense_definition": "A major Semitic language originating from the Arabian peninsula, spoken across the Middle East and North Africa.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "She is learning to speak <w>Arabic</w> at the university.",
                            "target_lang_translations": {
                                "ru": "Она учится говорить <w>по-арабски</w> в университете.",
                                "zh": "她正在大学里学习说<w>阿拉伯语</w>。"
                            }
                        },
                        {
                            "text": "The document was translated from <w>Arabic</w> into English.",
                            "target_lang_translations": {
                                "ru": "Документ был переведен с <w>арабского</w> на английский.",
                                "zh": "这份文件是从<w>阿拉伯语</w>翻译成英语的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak Arabic",
                        "learn Arabic",
                        "Classical Arabic",
                        "Egyptian Arabic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Семитский язык, возникший на Аравийском полуострове, на котором говорят на Ближнем Востоке и в Северной Африке.",
                        "zh": "一种源于阿拉伯半岛的闪米特语族语言，在中东和北非地区广泛使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арабский язык",
                                "target_lang_sense_clarification": "язык"
                            },
                            {
                                "target_lang_word": "арабский",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿拉伯语",
                                "target_lang_sense_clarification": "语言名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf4ca14c-7f88-3a3a-a582-65590f0bee39",
                    "sense_definition": "The script derived from Aramaic used to write the Arabic language, as well as Persian, Urdu, and others.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "script",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Persian is written using the <w>Arabic</w> alphabet.",
                            "target_lang_translations": {
                                "ru": "Персидский язык использует <w>арабский</w> алфавит.",
                                "zh": "波斯语使用<w>阿拉伯字母</w>书写。"
                            }
                        },
                        {
                            "text": "He practiced writing the letters in <w>Arabic</w>.",
                            "target_lang_translations": {
                                "ru": "Он тренировался писать буквы <w>по-арабски</w>.",
                                "zh": "他练习用<w>阿拉伯字母</w>书写。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Arabic script",
                        "Arabic alphabet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменность на основе арамейского, используемая для записи арабского языка, а также персидского, урду и других.",
                        "zh": "源自阿拉米字母的文字系统，用于书写阿拉伯语，也用于波斯语、乌尔都语等。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арабское письмо",
                                "target_lang_sense_clarification": "система письма"
                            },
                            {
                                "target_lang_word": "арабский алфавит",
                                "target_lang_sense_clarification": "алфавит"
                            },
                            {
                                "target_lang_word": "арабица",
                                "target_lang_sense_clarification": "термин"
                            },
                            {
                                "target_lang_word": "вязь",
                                "target_lang_sense_clarification": "декоративное письмо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿拉伯字母",
                                "target_lang_sense_clarification": "书写系统"
                            }
                        ]
                    }
                }
            ]
        },
        {
