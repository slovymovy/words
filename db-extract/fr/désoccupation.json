                                        "sense_id": "6043518f-2c5d-33ca-b8f4-9178042bdfb2",
                                        "entry_id": "8bb11eef-d213-37be-acd1-e7adbdea353e",
                                        "glosses": [
                                            "deel van de beroepsbevolking dat geen baan heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6156f06d-e378-4404-9a5c-ad36c4507fd1",
                                                "sense_id": "6043518f-2c5d-33ca-b8f4-9178042bdfb2",
                                                "text": "seizoengecorrigeerde werkloosheid"
                                            },
                                            {
                                                "example_id": "d013de7a-761f-4eda-b260-7cf25f3ebb8f",
                                                "sense_id": "6043518f-2c5d-33ca-b8f4-9178042bdfb2",
                                                "text": "Nou, en dan zou Libo in Borâs failliet gaan en dat zou tot werkloosheid leiden en de sossen waren rabiate tegenstanders van werkloosheid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00d6a10c-a8bb-33e0-92d1-77d83228c6fd",
                                        "entry_id": "8bb11eef-d213-37be-acd1-e7adbdea353e",
                                        "glosses": [
                                            "niet actief zijn, niks doen"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c3344f-873a-47c8-b951-102933c6b0ea",
                                                "sense_id": "00d6a10c-a8bb-33e0-92d1-77d83228c6fd",
                                                "text": "Het meest dat my hindert, is een soort van werkloosheid door een duizelige dofheid."
