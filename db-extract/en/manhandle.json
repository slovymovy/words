                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29d2ed76-dfa3-4151-8809-5edb7a1748ad",
                                                "sense_id": "2f02d2f3-3973-39fa-90e0-a0ed26502ee0",
                                                "text": "Der Mistkerl sollte mal ordentlich verprügelt werden."
                                            },
                                            {
                                                "example_id": "1b393873-7ffd-4246-8372-3286bbde09de",
                                                "sense_id": "2f02d2f3-3973-39fa-90e0-a0ed26502ee0",
                                                "text": "Schläge, Tritte, Hitlergruß: Weil sie zwei Bulgaren und einen Rumänen auf einem Volksfest brutal verprügelten, hat ein Gericht in Sachsen drei Männer hart bestraft."
                                            },
                                            {
                                                "example_id": "80b077ff-117a-4d40-9124-0286309770f6",
                                                "sense_id": "2f02d2f3-3973-39fa-90e0-a0ed26502ee0",
                                                "text": "Männer, die von ihren Frauen verprügelt werden, passen schlecht ins gesellschaftliche Rollenklischee."
                                            },
                                            {
                                                "example_id": "d58a2886-5a2e-4298-9562-698476db7712",
                                                "sense_id": "2f02d2f3-3973-39fa-90e0-a0ed26502ee0",
                                                "text": "„Er seinerseits hatte zugesehen, wie Frans verprügelt wurde. Der Vater merkte nie, wenn jemand hinter der Glastür stand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
