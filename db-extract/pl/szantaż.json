                                "sense_id": "6802ac6d-d912-3b18-b99e-90f775374142",
                                "text": "Politycy są częstymi ofiarami szantażu."
                            },
                            {
                                "example_id": "a4f5fd81-58ed-4009-b2ed-e4c21059e49a",
                                "sense_id": "6802ac6d-d912-3b18-b99e-90f775374142",
                                "text": "Zbrodnią jest wymuszanie groźbą i szantażem podpisywania deklaracji o współpracy ze Służbą Bezpieczeństwa – mówił ks. Jerzy Popiełuszko"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
