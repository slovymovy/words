                "senses": [
                    {
                        "sense_id": "fed8365c-ef54-3c5a-872f-d12702b33292",
                        "entry_id": "b03e7c48-746b-3ec5-b6e3-53498acc9ba5",
                        "glosses": [
                            "pädagogische Einflussnahme/Unterricht mit dem Ziel, sinnvolles Spielen zu erlernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2496de43-cffa-401d-a420-ee76db79007f",
                                "sense_id": "fed8365c-ef54-3c5a-872f-d12702b33292",
                                "text": "„Die Spielerziehung in der Schule muß den Schülern darüber hinaus außer- und nachschulische Spielmöglichkeiten erschließen.“"
                            },
                            {
                                "example_id": "f59005cf-1e97-4833-9257-713afde8a5c2",
                                "sense_id": "fed8365c-ef54-3c5a-872f-d12702b33292",
                                "text": "„Für den Schulsport zählt das Bewegungsspiel, und der Sportunterricht ist zu einem wesentlichen Teil Spielerziehung, d.h. Erziehung zum Spiel und Erziehung durch das Bewegungsspiel.“"
                            },
                            {
                                "example_id": "4ad51b8a-1deb-4d06-b973-a793aad2455e",
                                "sense_id": "fed8365c-ef54-3c5a-872f-d12702b33292",
                                "text": "„Ein Ziel in der Spielerziehung ist darin gegeben, daß Kinder ein Stadium des Regelbewußtseins erreichen, in dem sie Regeln nicht mehr ungefragt übernehmen, sondern selbst setzen und sich dadurch ihre Spielwelt eigenverantwortlich ordnen.“"
                            },
                            {
                                "example_id": "e00a85b3-d935-4e06-87e5-ca953d198e22",
                                "sense_id": "fed8365c-ef54-3c5a-872f-d12702b33292",
                                "text": "„Hier zeigt sich deutlich, dass Spielen heute, mehr noch als früher, einer begleitenden Spielerziehung und einer human-ethischen Kontrolle bedarf.“"
                            },
                            {
                                "example_id": "df421dbe-f81d-445c-8b9c-40647c5c38bd",
                                "sense_id": "fed8365c-ef54-3c5a-872f-d12702b33292",
                                "text": "„Cratty bläst nicht zum Rückzug in eine heile Spielwelt; er ruft auf zu einer Spielerziehung, die durch Streit und Gegnerschaft hindurch die individuellen sozialen Fähigkeiten im Spiel offenlegt, sie in Spielvariationen abtestet und im Gespräch bewusst macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
