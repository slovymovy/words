                "senses": [
                    {
                        "sense_id": "1d216a0b-b6b0-3f90-a429-373d12af8368",
                        "entry_id": "87dff340-45b8-336d-9034-26410afe90fe",
                        "glosses": [
                            "предназначенный для компресса, свойственный компрессу, либо имеющий к компрессу иное непосредственное отношение. Покрыть смазанный участок компрессной бумагой или полиэтиленовой плёнкой и, поверх них, марлевой повязкой."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc00cdee-9876-41c9-a8f2-1b925876e98d",
                        "source_entry_id": "87dff340-45b8-336d-9034-26410afe90fe",
                        "source_sense_id": "1d216a0b-b6b0-3f90-a429-373d12af8368",
                        "target_lang_word": "compress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af73746a-a539-36a9-a46f-7dc318d7efa8",
                                        "entry_id": "7d48442d-d564-32a4-843d-c4bdb6b8dbdb",
                                        "glosses": [
                                            "To make smaller; to press or squeeze together, or to make something occupy a smaller space or volume."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73d3dea6-787a-4c93-954c-3f22615708a8",
                                                "sense_id": "af73746a-a539-36a9-a46f-7dc318d7efa8",
                                                "text": "The force required to compress a spring varies linearly with the displacement."
                                            },
                                            {
                                                "example_id": "a3b4d88b-d900-4140-8443-fe494244a055",
                                                "sense_id": "af73746a-a539-36a9-a46f-7dc318d7efa8",
                                                "text": "events of centuries […] compressed within the compass of a single life"
                                            },
                                            {
                                                "example_id": "72ed050d-52c1-411e-ab8b-c536a766f852",
                                                "sense_id": "af73746a-a539-36a9-a46f-7dc318d7efa8",
                                                "text": "The same strength of expression, though more compressed, runs through his historical harangues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80020c31-41d3-3f79-a44a-52a8f855e1da",
                                        "entry_id": "7d48442d-d564-32a4-843d-c4bdb6b8dbdb",
                                        "glosses": [
                                            "To be pressed together or folded by compression into a more economic, easier format."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcdc9210-0ee3-47f2-8eae-673e75fe1a72",
                                                "sense_id": "80020c31-41d3-3f79-a44a-52a8f855e1da",
                                                "text": "Our new model compresses easily, ideal for storage and travel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d451f4d-d59e-3d67-aaf3-caa3c47f6f5b",
                                        "entry_id": "7d48442d-d564-32a4-843d-c4bdb6b8dbdb",
                                        "glosses": [
                                            "To condense into a more economic, easier format."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee14306e-fa94-42c0-b9cf-40d9c3311ae6",
                                                "sense_id": "2d451f4d-d59e-3d67-aaf3-caa3c47f6f5b",
                                                "text": "This chart compresses the entire audit report into a few lines on a single diagram."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "302f5b25-69c5-34ce-94a8-1c91380386a5",
                                        "entry_id": "7d48442d-d564-32a4-843d-c4bdb6b8dbdb",
                                        "glosses": [
                                            "To abridge."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313c5b84-b4b0-4623-8383-ae49eecd8291",
                                                "sense_id": "302f5b25-69c5-34ce-94a8-1c91380386a5",
                                                "text": "If you try to compress the entire book into a three-sentence summary, you will lose a lot of information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56dbdfa-7808-3d67-a8a3-fd0552037181",
                                        "entry_id": "7d48442d-d564-32a4-843d-c4bdb6b8dbdb",
                                        "glosses": [
                                            "To make digital information smaller by encoding it using fewer bits."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "889eb55d-704e-4723-b605-ff256a835d3e",
                                                "sense_id": "d56dbdfa-7808-3d67-a8a3-fd0552037181",
                                                "text": "The command-line tool gzip allows you to compress files in a few different ways. First, gzip can compress results from standard input."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e012cb2b-7d60-3666-81ba-4d0b5cfacbd9",
                                        "entry_id": "7d48442d-d564-32a4-843d-c4bdb6b8dbdb",
                                        "glosses": [
                                            "To embrace sexually."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "425b37b9-b5e1-4133-9acc-796d75c8725a",
                                                "sense_id": "e012cb2b-7d60-3666-81ba-4d0b5cfacbd9",
                                                "text": "This nymph compreſs'd by him vvho rules the day, / VVhom Delphi and the Delian iſle obey, / Andræmon lov'd; and, bleſs'd in all thoſe charms / That pleas'd a God, ſucceeded to her arms."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
