                "translations": [
                    {
                        "translation_id": "7037ae82-8971-46f4-9f2f-5f75e3dbf1f1",
                        "source_entry_id": "f94a1cc5-1258-3be4-9501-29ad4ea88140",
                        "source_sense_id": "ddbcc98a-b82f-3260-ae59-fba463df6d1a",
                        "target_lang_word": "Fata Morgana",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fata Morgana",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc83f856-f9ea-3b12-93b7-9418b029d1bc",
                                        "entry_id": "1d114334-c74d-3718-8020-e2cba213bab6",
                                        "glosses": [
                                            "A form of mirage seen just above the horizon, caused by a temperature inversion in the atmosphere, in which multiple upright and inverted images of a distant object appear to be stacked on top of each other in a highly distorted fashion; especially one seen at sea, and particularly in the Strait of Messina."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "331693ba-9877-4361-a19b-dc152c02e3ca",
                        "source_entry_id": "f94a1cc5-1258-3be4-9501-29ad4ea88140",
                        "source_sense_id": "ddbcc98a-b82f-3260-ae59-fba463df6d1a",
                        "target_lang_word": "fata morgana",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fata morgana",
