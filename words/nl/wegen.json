                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verpleegkundige <w>weegt</w> de baby om de groei te controleren.",
                            "target_lang_translations": {
                                "en": "The nurse <w>weighs</w> the baby to check its growth.",
                                "ru": "Медсестра <w>взвешивает</w> ребенка, чтобы проверить его рост.",
                                "pl": "Pielęgniarka <w>waży</w> dziecko, aby kontrolować jego wzrost.",
                                "de": "Die Krankenschwester <w>wiegt</w> das Baby, um das Wachstum zu kontrollieren.",
                                "fr": "L'infirmière <w>pèse</w> le bébé pour vérifier sa croissance.",
