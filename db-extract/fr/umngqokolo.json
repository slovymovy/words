                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efb5029b-9d52-4495-9d32-9a54f401ecde",
                                "sense_id": "230cf3b4-1bdf-31cc-b7cd-43701b495fbd",
                                "text": "Dans la technique de l’umngqokolo, la chanteuse force la voix pour produire artificiellement des sons graves, des sons qui sont âpres et de ce fait emplis d’harmoniques cachés."
                            },
                            {
                                "example_id": "edc79a14-6ce8-4a95-8f08-1fba789b60f7",
                                "sense_id": "230cf3b4-1bdf-31cc-b7cd-43701b495fbd",
                                "text": "Certaines des femmes Xhosa pratiquent aussi le umngqokolo, une variante extraordinaire de ce fameux « chant diphonique » ou « chant harmonique » mieux connu chez les Tibétains ou les Mongols."
                            }
                        ]
                    }
