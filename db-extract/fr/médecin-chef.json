                "senses": [
                    {
                        "sense_id": "6dd9de8b-28ed-3b13-95ad-5955d89a7102",
                        "entry_id": "cd96f9ac-646e-3e50-b00c-dc59963ab179",
                        "glosses": [
                            "Médecin homme ou femme placé à la tête du service de santé, d'un établissement, ou d'une unité militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e306afb-9e25-4d94-80cd-45c7b8af1cd7",
                                "sense_id": "6dd9de8b-28ed-3b13-95ad-5955d89a7102",
                                "text": "Une médecin-chef a pris la tête du service."
                            },
                            {
                                "example_id": "7749406b-696c-4a50-b293-1f35dce26b25",
                                "sense_id": "6dd9de8b-28ed-3b13-95ad-5955d89a7102",
                                "text": "Un médecin-chef est un médecin occupant un poste de direction dans un établissement de soins de santé, c’est-à-dire une clinique, un hôpital ou, par exemple, également dans un cabinet spécialisé ou un laboratoire. En règle générale, le médecin-chef est le médecin qui assume la responsabilité professionnelle et disciplinaire de toute une clinique. Il peut s’agir, par exemple, de la clinique chirurgicale ou de la clinique ophtalmologique d’un hôpital universitaire."
                            },
                            {
                                "example_id": "132b9e94-ebd2-416e-a0ac-6ceefe4e2735",
                                "sense_id": "6dd9de8b-28ed-3b13-95ad-5955d89a7102",
                                "text": "Selon les médecins-chefs, il y a un lien entre l'augmentation des délais d'admission, des urgences vers les unités de soins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcbc8f25-985f-4ac6-9594-8059078514a0",
                        "source_entry_id": "cd96f9ac-646e-3e50-b00c-dc59963ab179",
                        "source_sense_id": "6dd9de8b-28ed-3b13-95ad-5955d89a7102",
                        "target_lang_word": "Chefarzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chefarzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42cc3a0b-3ebb-383f-aa20-7f32c0ee8e49",
                                        "entry_id": "e04ef270-5f39-3fd5-9f50-1ef0f10e004f",
                                        "glosses": [
                                            "leitender Arzt in einem Krankenhaus oder einer anderen medizinischen Einrichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d4c70fd-8d87-41c5-849a-cfd5061eacdf",
                                                "sense_id": "42cc3a0b-3ebb-383f-aa20-7f32c0ee8e49",
                                                "text": "Ich möchte bitte nur vom Chefarzt behandelt werden."
                                            },
                                            {
                                                "example_id": "769828d4-81be-48a2-96c5-a53cee6b3674",
                                                "sense_id": "42cc3a0b-3ebb-383f-aa20-7f32c0ee8e49",
                                                "text": "„Obwohl als Chefarzt hierarchische Spitze der Klinik, lehnte Meixner jede Art Personenkult ab; weshalb um seinen Geburtstag auch kein Aufstand gemacht werden sollte.“"
                                            },
                                            {
                                                "example_id": "e8092cbd-83cc-46cb-906a-040c3e9ea3c0",
                                                "sense_id": "42cc3a0b-3ebb-383f-aa20-7f32c0ee8e49",
                                                "text": "„Einer von ihnen stellte sich als Chefarzt der Stroke Unit vor und fragte mich, ob es mir recht sei, dass die Medizinstudenten bei der Visite anwesend waren.“"
                                            },
                                            {
                                                "example_id": "a2b47da3-a678-4238-ad37-1254ae456415",
                                                "sense_id": "42cc3a0b-3ebb-383f-aa20-7f32c0ee8e49",
                                                "text": "„Von seiner Suite gefolgt, geht der Chefarzt im Lazarett von Bett zu Bett.“"
                                            },
                                            {
                                                "example_id": "a950c1e3-2fa8-4d10-b1ff-ccf2eafc598b",
                                                "sense_id": "42cc3a0b-3ebb-383f-aa20-7f32c0ee8e49",
                                                "text": "„Dann hatte der Chefarzt arrangiert, daß er gegen Mitglieder eines Schachklubs in Zürich spielen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0bb53e9d-590c-3336-9ed1-429c3eb86d95",
                                        "entry_id": "e04ef270-5f39-3fd5-9f50-1ef0f10e004f",
                                        "glosses": [
                                            "Arzt bei einer Krankenkasse oder Behörde, der gesundheitliche Beeinträchtigungen der Versicherten beziehungsweise Mitarbeiter beurteilt und gegebenenfalls Maßnahmen bewilligt"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73ab34f4-b560-46e4-a140-7e0e6027d8d9",
                                                "sense_id": "0bb53e9d-590c-3336-9ed1-429c3eb86d95",
                                                "text": "„Auf Grund des Ergebnisses dieser Überprüfung richtete der Generaldirektor des Hauptverbandes an den Obmann der Beklagten ein Telegramm, wonach es allen Grundsätzen einer ordnungsgemäßen Verwaltung widersprochen habe, daß der Chefarzt einer Krankenkasse seine Funktion dazu benütze, um für sich selbst und seine Angehörigen Heilmittel auf Rechnung der Krankenkasse zu verordnen.“"
                                            },
                                            {
                                                "example_id": "775d0d8c-9f57-45a6-8383-070a5a23dc90",
                                                "sense_id": "0bb53e9d-590c-3336-9ed1-429c3eb86d95",
                                                "text": "„Dem Chefarzt einer Krankenkasse als berufenen Kontrollorgan kommt daher eine besondere Vertrauensstellung und als oberste medizinische Instanz eine besondere Verantwortlichkeit zu.“"
                                            },
                                            {
                                                "example_id": "e2e12a9b-f0d9-4979-ac47-600b4a44366e",
                                                "sense_id": "0bb53e9d-590c-3336-9ed1-429c3eb86d95",
                                                "text": "„Der Chefarzt vertrete den Versicherungsträger nach § 49 Gesamtvertrag in allen medizinischen Angelegenheiten gegenüber dem Vertragsarzt. […] Die medizinischen Vorfragen bei Prüfung einer Abrechnung seien daher keine medizinischen Angelegenheiten im Sinne des § 49 GV, die zwischen Chefarzt und Vertragsarzt zu klären wären.“"
                                            },
                                            {
                                                "example_id": "ff4b4418-593e-4f80-b0bd-9eeeb56a0e3f",
                                                "sense_id": "0bb53e9d-590c-3336-9ed1-429c3eb86d95",
                                                "text": "„Ab 1. Jänner 2005 sollte nämlich nur mehr das Rezept (und nicht der Patient) zum Chefarzt: […]“"
                                            },
                                            {
                                                "example_id": "12b13707-57c9-4542-89cc-23475b4adefc",
                                                "sense_id": "0bb53e9d-590c-3336-9ed1-429c3eb86d95",
                                                "text": "„Danach befragt, ob er von diesem nicht untersucht wurde, gab der Beamte zu, dass der Chefarzt sich sein Knie angesehen, aber nicht abgetastet hat.“"
                                            },
                                            {
                                                "example_id": "653a19e9-90c8-4939-a1e7-d5c9860ad4f1",
                                                "sense_id": "0bb53e9d-590c-3336-9ed1-429c3eb86d95",
                                                "text": "„Seitens der Vorsitzenden wurde der Beamte im Zuge des Telefonates eindringlich darauf hingewiesen, der Dienstbehörde die erforderliche Krankenbestätigung vorzulegen und die Untersuchung beim polizeilichen Chefarzt durchzuführen, da das Ruhestandsverfahren eingeleitet wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
