                        "examples": [
                            {
                                "example_id": "dbf5283e-f0e2-4a74-b5d6-3c7d2266a142",
                                "sense_id": "595194f1-3955-31b7-9418-8817a556dfa4",
                                "text": "Le petit seau à sirop d’érable de Patrice, jaune et raclé jusqu’au métal, était plein de pâte à pain crue. Parfaitement. Elle l’avait pris au passage en sortant de chez elle, tellement secouée par la diatribe de son père qu’elle était partie précipitamment, oubliant qu’avant le petit-déjeuner elle avait prévu de frire la pâte à pain bannique dans la poêle de sa mère."
                            },
                            {
                                "example_id": "362e2cee-ce4d-4151-959b-c24cc4c5a149",
                                "sense_id": "595194f1-3955-31b7-9418-8817a556dfa4",
                                "text": "La bannique est un aliment important chez les Premières Nations, Inuit et Métis, partout au Canada."
                            }
