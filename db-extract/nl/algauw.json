                        "examples": [
                            {
                                "example_id": "f1889f5c-6489-42a4-a71e-c829de832cc5",
                                "sense_id": "086eb672-7687-3418-aa04-64e2435aee58",
                                "text": "Het werd algauw een algemene titel die door meerdere dames van het hof tegelijk kon worden gedragen"
                            },
                            {
                                "example_id": "4a46519f-05dd-41da-9c33-1a338ae35c58",
                                "sense_id": "086eb672-7687-3418-aa04-64e2435aee58",
                                "text": "Algauw zullen de rimpelingen veroorzaakt door één plons zich zover uitbreiden dat ze overal op het spiegelende wateroppervlak gevoeld kunnen worden."
                            },
                            {
                                "example_id": "4b1323d6-3f97-4c32-aaf2-e97dfa2ca6f1",
                                "sense_id": "086eb672-7687-3418-aa04-64e2435aee58",
                                "text": "Die reis naar Gambia was voor ons een tussendoortje. We wilden de zon opzoeken, en dan kom je in de winter algauw op dat soort plekken terecht."
                            },
                            {
                                "example_id": "08340403-ef6e-4500-bdb4-27a1721a2911",
                                "sense_id": "086eb672-7687-3418-aa04-64e2435aee58",
                                "text": "Algauw waren zijn schietvaardigheden meer dan goed genoeg om lid te kunnen worden van de scherpschietvereniging van de school."
                            }
                        ]
                    }
