                "senses": [
                    {
                        "sense_id": "db9c53cb-ac96-303e-9116-58260fe25f53",
                        "entry_id": "34456656-bab7-3695-9e55-2cdd21696b97",
                        "glosses": [
                            "Usufruit, droit de jouir d’un bien dont la propriété appartient à quelqu'un d'autre."
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
                                "example_id": "dc847cbc-e9e8-4541-b1cf-d8cfde0ac96f",
                                "sense_id": "db9c53cb-ac96-303e-9116-58260fe25f53",
                                "text": "Der Nießbrauch ist das Recht zur Nutzung und Fruchtziehung an einer Sache.",
                                "translation": "L'usufruit est le droit d'utilisation et de jouissance d'une chose."
                            },
                            {
                                "example_id": "e9edf9d2-f757-43e6-8b63-04746bebf089",
                                "sense_id": "db9c53cb-ac96-303e-9116-58260fe25f53",
                                "text": "Als dieses glaubte, befreiten Wir es von der Schande der Erniedrigung in der irdischen Welt und gewährten ihm einen Nießbrauch auf Zeit.",
                                "translation": "Lorsque celui-ci eut cru, nous leur enlevâmes le châtiment d’ignominie dans la vie présente et leur donnâmes jouissance pour un certain temps."
                            }
                        ]
                    }
                ],
