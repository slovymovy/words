                    {
                        "sense_id": "1e88d406-71f1-3559-8e11-40034e708459",
                        "entry_id": "f9146555-cff4-3fde-acc2-91929ba2d436",
                        "glosses": [
                            "Ensemble de pratiques de conduite permettant à l’automobiliste de réduire la consommation d’énergie du véhicule et d’en limiter l’usure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44376842-8bb2-4d60-ace6-76616984e040",
                                "sense_id": "1e88d406-71f1-3559-8e11-40034e708459",
                                "text": "Plus que jamais dans l’air du temps, l’écoconduite est désormais évaluée lors des examens théorique et pratique du permis de conduire."
                            },
                            {
                                "example_id": "975f64a0-435e-4f90-acab-193e2ceb4937",
                                "sense_id": "1e88d406-71f1-3559-8e11-40034e708459",
                                "text": "L’écoconduite est un comportement de conduite citoyen permettant de diminuer le risque d’accident, de réduire sa consommation de carburant et de limiter l’émission de gaz à effet de serre, responsable du réchauffement climatique."
                            }
                        ]
                    }
                ],
