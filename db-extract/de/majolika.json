                "senses": [
                    {
                        "sense_id": "aea55bdc-9782-3285-b9e5-f2c0e2246537",
                        "entry_id": "ac5400b9-7e28-3253-b7fa-37184397de01",
                        "glosses": [
                            "(auf bestimmte Art) farbig glasierte Tonware"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b133886f-c50c-421e-b4ec-c97236af1fe3",
                                "sense_id": "aea55bdc-9782-3285-b9e5-f2c0e2246537",
                                "text": "Für die Majolika wird der Ton nach dem ersten Brennen mit einer weißen Zinnglasur überzogen und farbig bemalt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f5bfc5d-558a-41f3-be71-cb19823b6ce0",
                        "source_entry_id": "ac5400b9-7e28-3253-b7fa-37184397de01",
                        "source_sense_id": "aea55bdc-9782-3285-b9e5-f2c0e2246537",
                        "source_sense_description": "(auf bestimmte Art) farbig glasierte Tonware",
                        "target_lang_word": "maiolica",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maiolica",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a28cc61e-72b6-3a04-940e-59eb04ffd8e1",
                                        "entry_id": "49da0b12-56fb-38e9-98a0-a89b9f795b48",
                                        "glosses": [
                                            "Alternative form of majolica (“earthenware coated with opaque white tin glaze”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18555916-9f5c-4b5f-a1cd-e38f574e6b01",
                                                "sense_id": "a28cc61e-72b6-3a04-940e-59eb04ffd8e1",
                                                "text": "The word Majolica, or Maiolica […] was applied to all Stanniferous faience of Italy and Spain."
                                            },
                                            {
                                                "example_id": "7caf0f06-c08e-4f26-9a72-221152851ec7",
                                                "sense_id": "a28cc61e-72b6-3a04-940e-59eb04ffd8e1",
                                                "text": "Minton did not use the word maiolica themselves, relying instead on the Victorian version, majolica, which they used to mean wares of Renaissance inspiration, featuring hand painting on an opaque white glaze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b47a8a1-6c37-4667-9af2-9b73ab777259",
                        "source_entry_id": "ac5400b9-7e28-3253-b7fa-37184397de01",
                        "source_sense_id": "aea55bdc-9782-3285-b9e5-f2c0e2246537",
                        "source_sense_description": "(auf bestimmte Art) farbig glasierte Tonware",
                        "target_lang_word": "majolica",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majolica",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9198b1a7-f1e1-323c-b325-2fc5ee512083",
                                        "entry_id": "7d63fb2d-0ace-31ec-a7ac-706a0e92e2e0",
                                        "glosses": [
                                            "Earthenware decorated with coloured lead silicate glazes applied directly to an unglazed body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19eeaa4f-1a47-423a-983e-ba90f9f64ac7",
                                                "sense_id": "9198b1a7-f1e1-323c-b325-2fc5ee512083",
                                                "text": "The Italian Vase [top, left, p.8] is Majolica, […] The Ewer [bottom, middle, p.8] is a Palissy vase."
                                            },
                                            {
                                                "example_id": "74f44b51-e7d3-4d77-a12b-76085ab2c59c",
                                                "sense_id": "9198b1a7-f1e1-323c-b325-2fc5ee512083",
                                                "text": "1877, Leon Arnoux, Director, Minton & Co., British Manufacturing Industries POTTERY, page #:42 https://archive.org/stream/britishmanufact08goog#page/n56/mode/2up/search/palissy\nMajolica was produced for the first time by Messrs. Minton, in 1850, and they have been for many years the only producers of this article. The name of majolica is now applied indiscriminately to all fancy articles of coloured pottery. When, however, it is decorated by means of coloured glazes, if these are transparent, it ought to be called Palissy ware […]"
                                            },
                                            {
                                                "example_id": "734f5fab-bc40-47b1-9522-72f6f91943e5",
                                                "sense_id": "9198b1a7-f1e1-323c-b325-2fc5ee512083",
                                                "text": "[Minton] employed no less than 1500. The various branches he developed were earthenware and ordinary soft porcelain, hard porcelain, parian, coloured and enamelled tiles, mosaics, Della Robbia ware, majolica, and Palissy ware."
                                            },
                                            {
                                                "example_id": "ed49b3a4-9d0f-4b3a-a9a7-a2bc84f5161c",
                                                "sense_id": "9198b1a7-f1e1-323c-b325-2fc5ee512083",
                                                "text": "[…] the coloured glaze decorated wares which we now call majolica, but which Minton referred to as Palissy wares."
                                            },
                                            {
                                                "example_id": "f14ac137-142c-4e4e-a9a9-e3ddcc3ccd3c",
                                                "sense_id": "9198b1a7-f1e1-323c-b325-2fc5ee512083",
                                                "text": "Summary: Analysis confirms that Palissy used coloured lead glazes, lead silicates with added metal oxides of copper [for green], cobalt [for blue], manganese [for brown and black] or iron [for yellow ochre] with a small addition of tin [for opacity] to some of the glazes.\" in a sombre earth-toned palette, using naturalistic scenes of plants and animals cast from life."
                                            },
                                            {
                                                "example_id": "43a079bc-0bec-4559-9697-dcbce9ab85ce",
                                                "sense_id": "9198b1a7-f1e1-323c-b325-2fc5ee512083",
                                                "text": "2018, Claire Blakey, Minton Majolica: A Visual Feast of Victorian Opulence Minton Archive https://web.archive.org/web/20190505103014/http://www.themintonarchive.org.uk/in-depth-minton-majolica/\nMajolica is the term used to describe pottery made of an earthenware body coated with semi-translucent coloured lead glazes. It was developed at the Minton factory in the late 1840s by Léon Arnoux, who had come to the Potteries in 1848."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed20ab49-cdcb-359f-836b-7406a140763b",
                                        "entry_id": "7d63fb2d-0ace-31ec-a7ac-706a0e92e2e0",
                                        "glosses": [
                                            "Earthenware coated with opaque white tin-glaze, decorated with coloured metal oxide enamel(s)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11d7d4e7-6574-491c-afe2-7177b5b1a8cd",
                                                "sense_id": "ed20ab49-cdcb-359f-836b-7406a140763b",
                                                "text": "…the use of the word majolica will be restricted to its original meaning of lustred stanniferous glazed pottery."
                                            },
                                            {
                                                "example_id": "50c6565f-4c0e-4a4d-a7b6-3551f1386c22",
                                                "sense_id": "ed20ab49-cdcb-359f-836b-7406a140763b",
                                                "text": "The word Majolica, or Maiolica […] was applied to all Stanniferous faience of Italy and Spain."
                                            },
                                            {
                                                "example_id": "56e82fbd-61f7-45df-87b3-e999d9acde4d",
                                                "sense_id": "ed20ab49-cdcb-359f-836b-7406a140763b",
                                                "text": "The Italian pottery, generally known under the names of Majolica, Raffaelle ware, and sometimes by the term of \"Umbrian ware,\" through the production of the fifteenth century [...]\""
                                            },
                                            {
                                                "example_id": "cb296423-cd47-4e53-95a2-80c220b73e3e",
                                                "sense_id": "ed20ab49-cdcb-359f-836b-7406a140763b",
                                                "text": "Enamel - A vitrifiable substance; opaque, generally Stanniferous majolica [...]"
                                            },
                                            {
                                                "example_id": "12e669e3-5d27-4f6e-84ef-be150649320f",
                                                "sense_id": "ed20ab49-cdcb-359f-836b-7406a140763b",
                                                "text": "Minton did not use the word maiolica themselves, relying instead on the Victorian version, majolica, which they used to mean wares of Renaissance inspiration, featuring hand painting on an opaque white glaze. […]."
                                            },
                                            {
                                                "example_id": "bd5a818d-7640-4395-8aad-debd13aaadae",
                                                "sense_id": "ed20ab49-cdcb-359f-836b-7406a140763b",
                                                "text": "2013, S. De la Vega, A. Castaneda-Gomez del Campo, M. Jimenez-Reyes, A. Tellez-Nieto, D. Tenorio, Majolica ware in the New Spain: an evaluation through NAA. The results of a study about [Tin-glaze] Majolica ceramics recovered from three sites located in Mexico City, Akademiai Kiado´, Budapest, Hungary\nThe [tin-glaze] Majolica manufacture process has remained practically unchanged through time: shaping is done with a potter’s wheel; drying must be slow... two firings... the first one for biscuit-sintering and the second for the glaze used as a surface for decoration... Glaze is prepared with a mixture of glass-sand (silica-rich sand)... lead, and tin, and the painted decoration is done with metallic oxides such as cobalt blue, iron oxide, and antimony oxide."
                                            },
                                            {
                                                "example_id": "adcdb3b1-8f82-411b-b929-9bfb2de9a6f4",
                                                "sense_id": "ed20ab49-cdcb-359f-836b-7406a140763b",
                                                "text": "In the early eighteenth century, earthenwares with tin glazes were the most widely produced ceramics in Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4136ffe1-cb25-4977-ad63-12389ef5c641",
                        "source_entry_id": "ac5400b9-7e28-3253-b7fa-37184397de01",
                        "source_sense_id": "aea55bdc-9782-3285-b9e5-f2c0e2246537",
                        "source_sense_description": "(auf bestimmte Art) farbig glasierte Tonware",
                        "target_lang_word": "majolique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ecb2692-4200-3346-b356-34eea170cdd2",
                                        "entry_id": "3e3b5cf1-6bc5-3d9b-837d-d5bc8c1e5790",
                                        "glosses": [
                                            "Sorte d’ancienne faïence recouverte d’une glaçure stannifère originaire d’Italie ou d’Espagne"
                                        ],
                                        "tags": [
                                            "Céramique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8b37677-f347-4364-b2bd-167e6512965d",
                                                "sense_id": "5ecb2692-4200-3346-b356-34eea170cdd2",
                                                "text": "Acheter de la majolique."
                                            },
                                            {
                                                "example_id": "e35ea8e5-ca6b-426f-8be4-da12cbed63ee",
                                                "sense_id": "5ecb2692-4200-3346-b356-34eea170cdd2",
                                                "text": "Entre les colonnes, devant chacune des baies cintrées qui ouvraient sur les magasins, il y avait de hautes plantes vertes, dans des vases de majolique."
                                            },
                                            {
                                                "example_id": "646b5f5f-59e4-43fc-a934-5856c402b218",
                                                "sense_id": "5ecb2692-4200-3346-b356-34eea170cdd2",
                                                "text": "On avait allumé du feu dans le poêle alsacien en majolique."
                                            },
                                            {
                                                "example_id": "78e2d0b9-9503-44ca-9624-cf0b8abe7d55",
                                                "sense_id": "5ecb2692-4200-3346-b356-34eea170cdd2",
                                                "text": "Le thé fut versé dans des tasses de majolique noire et aussitôt les dames Wunkle firent preuve d’une voracité fantastique, engloutissant d’énormes morceaux de cake beurré, des muffins brûlants et des sprats ruisselant de sauce sinapisée."
                                            },
                                            {
                                                "example_id": "4eccc6ab-2256-4086-825d-a4ef7de19b1a",
                                                "sense_id": "5ecb2692-4200-3346-b356-34eea170cdd2",
                                                "text": "Dans l’allée centrale, certaines dalles du pavement en majolique se descellent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
