                ],
                "senses": [
                    {
                        "sense_id": "2f93b90d-d141-3ce6-a418-4d37586711fc",
                        "entry_id": "5e1e6d1c-6b54-3b33-b82b-f1f7ae41c72a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fe868ea-4eef-469c-a085-04b2f5d906cf",
                                "sense_id": "2f93b90d-d141-3ce6-a418-4d37586711fc",
                                "text": "Frau Pfitzenmeier ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "53750625-fb55-45c8-8f85-328cc81d2adf",
                                "sense_id": "2f93b90d-d141-3ce6-a418-4d37586711fc",
                                "text": "Herr Pfitzenmeier wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f56513fb-205a-4223-b5c4-5281f8c06808",
                                "sense_id": "2f93b90d-d141-3ce6-a418-4d37586711fc",
                                "text": "Die Pfitzenmeiers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "582f79fd-a7f1-428c-8630-313dd2d8d95f",
                                "sense_id": "2f93b90d-d141-3ce6-a418-4d37586711fc",
                                "text": "Der Pfitzenmeier trägt nie die Schals, die die Pfitzenmeier ihm strickt."
                            },
                            {
                                "example_id": "4f131550-8397-482d-a249-553d34e8dddf",
                                "sense_id": "2f93b90d-d141-3ce6-a418-4d37586711fc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pfitzenmeier kommt, geht der Herr Pfitzenmeier.“"
                            },
                            {
                                "example_id": "7cfdc11c-a5ff-41ad-9b20-a84f089ba777",
                                "sense_id": "2f93b90d-d141-3ce6-a418-4d37586711fc",
                                "text": "Pfitzenmeier kommt und geht."
                            },
                            {
                                "example_id": "b1370fb3-ae6e-4c68-9c88-ee74693b5f27",
                                "sense_id": "2f93b90d-d141-3ce6-a418-4d37586711fc",
                                "text": "Pfitzenmeiers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
