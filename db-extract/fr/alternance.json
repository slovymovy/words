        "fr-extract.jsonl": [
            {
                "entry_id": "09969603-3d88-3ff6-890e-74d020788649",
                "word": "alternance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2a7604fa-bed8-43a3-bf41-dc3e85b1d858",
                        "entry_id": "09969603-3d88-3ff6-890e-74d020788649",
                        "tags": [
                            "plural"
                        ],
                        "form": "alternances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "570f39e9-08e0-3714-96a8-bcc766335a74",
                        "entry_id": "09969603-3d88-3ff6-890e-74d020788649",
                        "glosses": [
                            "Action d’alterner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3119e587-7878-4d18-b3f3-1c9ca8f2e945",
                                "sense_id": "570f39e9-08e0-3714-96a8-bcc766335a74",
                                "text": "Vague de victoires pour le club de karaté de Mirambeau le 11 juin dernier. Il a participé au criterium enfants qui s’est déroulé à Sainte-Foy-la-Grance, une compétition annuelle organisée en alternance par trois clubs amis : Mirambeau, Saint-Savin et Sainte-Foy-la-Grande."
                            },
                            {
                                "example_id": "7d41acca-e02e-4801-8e69-1b7c3fb1a6b3",
                                "sense_id": "570f39e9-08e0-3714-96a8-bcc766335a74",
                                "text": "Le légitimisme, d'une manière générale, est plutôt assimilé à une acceptation passive des choses. Mais depuis que l’alternance et la cohabitation se sont banalisées, il a pris une nouvelle signification."
                            },
                            {
                                "example_id": "d9bbfb27-b0ca-488f-b1b0-d734f0d4758c",
                                "sense_id": "570f39e9-08e0-3714-96a8-bcc766335a74",
                                "text": "Nous proposons dʼétudier, dans le cadre du présent ouvrage, lʼalternance politique au Sénégal."
                            }
                        ]
                    },
                    {
                        "sense_id": "e099b716-4e97-36c2-9bdd-29ce703c79e8",
                        "entry_id": "09969603-3d88-3ff6-890e-74d020788649",
                        "glosses": [
                            "Demi-cycle de tension (ou voltage), ou d’intensité du courant."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1ebef77c-be10-39b5-affc-e78e245b0b24",
                        "entry_id": "09969603-3d88-3ff6-890e-74d020788649",
                        "glosses": [
                            "Formation par alternance : entre un établissement d'enseignement et une entreprise."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "5bdfae66-e841-465f-8653-b79a51e0d5d6",
                                "sense_id": "1ebef77c-be10-39b5-affc-e78e245b0b24",
                                "text": "Après une révélation lors d’un stage de 3ᵉ, ce Nantais a fait ses classes à l’école Ferrandi (Paris, 6ᵉ), avant une expérience à Londres, puis une alternance au Taillevent, restaurant parisien (8ᵉ)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29092c24-6b68-4b4b-911e-be02d3ccd09a",
                        "source_entry_id": "09969603-3d88-3ff6-890e-74d020788649",
                        "source_sense_id": "570f39e9-08e0-3714-96a8-bcc766335a74",
