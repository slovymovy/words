                "senses": [
                    {
                        "sense_id": "0cf26246-723a-33d0-9c52-adee63496b6f",
                        "entry_id": "aba71f1d-bcb9-3115-9d0c-c656c626dcac",
                        "glosses": [
                            "Flagrant délit."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3feb26de-db49-4a36-afc3-ef0e923eb2c4",
                                "sense_id": "0cf26246-723a-33d0-9c52-adee63496b6f",
                                "text": "En fin limier, il envisagea la suite à donner à l’événement, les types allaient sortir, il n’aurait plus qu’à les cueillir avec la marchandise, un flag exceptionnel qui lui vaudrait une bonne appréciation de ses supérieurs."
                            },
                            {
                                "example_id": "4b587e9d-6a9b-487d-8c99-1eccc5c216e6",
                                "sense_id": "0cf26246-723a-33d0-9c52-adee63496b6f",
                                "text": "D'ailleurs, ils ne sont pas prêts d'oublier le soir où ils se sont fait « pécho en flag » par les robocops, alors qu'ils taggaient dans le métro."
                            },
                            {
                                "example_id": "3741768a-0580-49ed-bcb1-be5b60edc0af",
                                "sense_id": "0cf26246-723a-33d0-9c52-adee63496b6f",
                                "text": "Il s’est fait taper en flag par les condés pour un braquage chez l’épicemard arabe du quartier. Ce camé est capable de tout pour payer sa dose."
                            }
                        ]
                    }
                ],
