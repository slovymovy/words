                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ed63e1d-c708-489a-a2f5-5df2be4a45dd",
                                "sense_id": "b97b794b-d610-3560-8b3a-1b6490ef3535",
                                "text": "„Ich habe mir oft gesagt, daß Sophie meine erste Weigerung vielleicht mit einer heimlichen Erleichterung aufnahm und daß ihr Vorschlag ein gut Teil Überwindung in sich schloß.“"
                            },
                            {
                                "example_id": "69c8235d-553e-43e7-876e-9c5d2635ac44",
                                "sense_id": "b97b794b-d610-3560-8b3a-1b6490ef3535",
                                "text": "„Nicht in ein Flugzeug zu steigen, ist eine ehrenhafte Weigerung, an der Klimakrise mitzuwirken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
