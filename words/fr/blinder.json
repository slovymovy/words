                            "trait_type": "colloquial",
                            "comment": "souvent employé à la forme pronominale"
                        }
                    ]
                },
                {
                    "sense_id": "8dde0ee9-dee2-3ad8-957b-61f972555a00",
                    "sense_definition": "Pourvoir abondamment d'argent ; au participe passé, disposer d'une très grande fortune.",
