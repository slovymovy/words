                "senses": [
                    {
                        "sense_id": "4a3ad1c8-cf2b-3e23-9a6f-17c551b0231a",
                        "entry_id": "73a756fc-cedd-3ad2-bac6-a8cbf7ab2b14",
                        "glosses": [
                            "Nachricht, die am späten Nachmittag oder Abend übermittelt oder bekanntgegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f3d06ec-87e9-40ce-94b8-a4c7106b847f",
                                "sense_id": "4a3ad1c8-cf2b-3e23-9a6f-17c551b0231a",
                                "text": "„Dann haben die Fernsehanstalten genügend Zeit, um daraus eine Abendnachricht nach unseren Vorgaben zu machen.“"
                            },
                            {
                                "example_id": "2961c53f-5c33-4ba2-963c-51405c20635d",
                                "sense_id": "4a3ad1c8-cf2b-3e23-9a6f-17c551b0231a",
                                "text": "„›Bekomme ich heute keine Abendnachricht? Du hast mich erstaunlich schnell vergessen.‹“"
                            },
                            {
                                "example_id": "8ea371c0-f83b-41ec-9cdb-f5ca045ff12f",
                                "sense_id": "4a3ad1c8-cf2b-3e23-9a6f-17c551b0231a",
                                "text": "„Mit geschlossenen Augen stehe ich da, genieße den Klang ihrer Stimme und formuliere in Gedanken die alltägliche Abendnachricht, welche ich gemäß dieses besonders aufschlussreichen Tag zuschicken sollte.“"
                            },
                            {
                                "example_id": "7d84fa7a-152a-49b6-8993-991bfeab0774",
                                "sense_id": "4a3ad1c8-cf2b-3e23-9a6f-17c551b0231a",
                                "text": "„Christine nickte – in ihrem neuen Radio hatte sie soeben die Abendnachricht gehört.“"
                            },
                            {
                                "example_id": "6cc1f5a0-d4d8-4fa2-aecc-625873307667",
                                "sense_id": "4a3ad1c8-cf2b-3e23-9a6f-17c551b0231a",
                                "text": "„Was könnte diese Abendnachricht zu unserer Sicht der Welt beitragen? Oder weshalb sollte es für uns wichtig sein, dass in Italien – schlimm genug – drei Menschen bei einem Busunfall ums Leben kamen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
