                        "entry_id": "ec997a8c-7342-3708-98df-4a5270b84054",
                        "glosses": [
                            "lijkend op vilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f516472-d8c5-4852-bf53-84501380f201",
                                "sense_id": "f2c28931-d3d2-3928-a945-84c8ac314b45",
                                "text": "De capuchon viltachtig, van suède misschien - was zo ver mogelijk over haar hoofd geslagen, zodat Ernst zijn gezicht onder de rand moest brengen om haar te kunnen kussen."
                            },
                            {
                                "example_id": "2f54abf4-c1da-477e-83a0-c2bd7521e3c9",
                                "sense_id": "f2c28931-d3d2-3928-a945-84c8ac314b45",
                                "text": "Ook werkte ze met chique materialen als viltachtig wol, crêpe en chiffon. Deze voetbalvrouw speelde tevens met kleur en wisselde wit en zwart met oranje af."
                            }
                        ]
                    }
