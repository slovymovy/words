        "de-extract.jsonl": [
            {
                "entry_id": "8b6855d4-b917-323d-862f-03f3c80bbaa9",
                "word": "Sarah",
                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "555ddce8-b6eb-3e63-a48f-3926a9f3e9b1",
                        "entry_id": "8b6855d4-b917-323d-862f-03f3c80bbaa9",
                        "glosses": [
                            "weiblicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9706afac-8670-498c-ba5b-6d9d2f4d35bb",
                                "sense_id": "555ddce8-b6eb-3e63-a48f-3926a9f3e9b1",
                                "text": "Sarah ist eine hervorragende Schülerin."
                            },
                            {
                                "example_id": "331afd6d-584e-490a-82e3-c81c1087c2a6",
                                "sense_id": "555ddce8-b6eb-3e63-a48f-3926a9f3e9b1",
                                "text": "Wusstest du, dass Ivan und Sarah gerade ein Kind bekommen haben?"
                            },
                            {
                                "example_id": "66a6dcaf-ab92-4ba7-ac7a-925991ca986a",
                                "sense_id": "555ddce8-b6eb-3e63-a48f-3926a9f3e9b1",
                                "text": "„Sarah hat mich beauftragt, euch ihr Dankeschön zu übergeben.“"
                            },
                            {
                                "example_id": "2d932cd1-640e-49e6-88a7-fffb949efb2c",
                                "sense_id": "555ddce8-b6eb-3e63-a48f-3926a9f3e9b1",
                                "text": "„Und Sarah starb in Kirjat-Arba, das ist Hebron, im Land Kanaan. Da ging Abraham hin, um zu klagen um Sarah und sie zu beweinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db554d3a-d76b-42a2-ad29-21db54b0ccee",
                        "source_entry_id": "8b6855d4-b917-323d-862f-03f3c80bbaa9",
                        "source_sense_id": "555ddce8-b6eb-3e63-a48f-3926a9f3e9b1",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Sarah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sarah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc6b1274-c410-35ab-b9cd-f5840aee8d21",
                                        "entry_id": "226c8884-1292-30dd-95f1-7aa564fd933e",
                                        "glosses": [
                                            "The wife of Abraham and mother of Isaac in the Bible."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "206494b6-7811-4914-b083-d8509a4ac525",
                                                "sense_id": "bc6b1274-c410-35ab-b9cd-f5840aee8d21",
                                                "text": "And God ſaid vnto Abraham, As for Sarai thy wife, thou ſhalt not call her name Sarai, but Sarah ſhall her name be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60e8d155-e5b8-313e-982a-57f64ecb5dbc",
                                        "entry_id": "226c8884-1292-30dd-95f1-7aa564fd933e",
                                        "glosses": [
                                            "A female given name from Hebrew."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01dc63ef-3dcd-4c43-b89f-5fcd2e3de0d6",
                                                "sense_id": "60e8d155-e5b8-313e-982a-57f64ecb5dbc",
                                                "text": "I also have two daughters, by now grown up. Their names are Sarah and Anne, good sensible names. - - - I am a believer in sensible choices, so different from many of my own. Also in sensible names for children, because look what happened to Cordelia."
                                            },
                                            {
                                                "example_id": "c6bb9bb3-599e-4237-80af-cfd7ff5379b4",
                                                "sense_id": "60e8d155-e5b8-313e-982a-57f64ecb5dbc",
                                                "text": "Speaking on the John Solomon Reports podcast this week, conservative activist and RiftTV contributor Sarah Stock attributed some of the divide to a generational split in how conservatives consume information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bafa8312-1589-3fa8-bef3-b1df82036ff7",
                                        "entry_id": "226c8884-1292-30dd-95f1-7aa564fd933e",
