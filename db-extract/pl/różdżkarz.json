                                "target_senses": [
                                    {
                                        "sense_id": "53e10da6-00c4-3593-8617-16e60d1fbc1c",
                                        "entry_id": "45d672db-3bb4-30b5-8386-c99ceb74c3ce",
                                        "glosses": [
                                            "A divining rod used in searching for water, ore, etc.; a dowsing rod."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89a83f62-e42c-3ed0-9f1a-870b19de53cd",
                                        "entry_id": "45d672db-3bb4-30b5-8386-c99ceb74c3ce",
                                        "glosses": [
                                            "One who uses the dowser or divining rod. A diviner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae02b891-1c35-4eb7-8a51-10c4b3806af5",
                                                "sense_id": "89a83f62-e42c-3ed0-9f1a-870b19de53cd",
                                                "text": "Interestingly enough, John Mullins, the celebrated English dowser, was able to do this experiment using a forked twig, rather than a pendulum. He claimed to be able to locate nothing but water with his dowsing rod."
                                            },
                                            {
                                                "example_id": "ffd1d934-fe7e-440d-bd72-5a453d6b0874",
                                                "sense_id": "89a83f62-e42c-3ed0-9f1a-870b19de53cd",
                                                "text": "The instrument a dowser uses is called a dowsing rod, dowsing stick, doodlebug (when used to locate oil), or divining rod. Almost any item can be used for this purpose: a birch twig, a whalebone, and even a hanger."
                                            },
                                            {
                                                "example_id": "4195d9c2-88ed-4270-b6e6-e2eaf15e7c51",
                                                "sense_id": "89a83f62-e42c-3ed0-9f1a-870b19de53cd",
                                                "text": "Google Cayce and you will find “coolhunter,” and if you look closely you may see it suggested that she is a “sensitive” of some kind, a dowser in the world of global marketing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
