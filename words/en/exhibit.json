{
    "word_family": [
        "exhibition",
        "exhibitor",
        "exhibitionism",
        "exhibitionist"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e99081d1-0f27-3360-9228-e4e991382c38",
                    "sense_definition": "To show something publicly for others to see, especially works of art or products in a museum or at a trade fair.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "public_display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local gallery will <w>exhibit</w> a collection of modern sculptures next month.",
                            "target_lang_translations": {
                                "ru": "В следующем месяце местная галерея <w>выставит</w> коллекцию современных скульптур.",
                                "zh": "当地画廊下个月将<w>展出</w>一批现代雕塑作品。"
                            }
                        },
                        {
                            "text": "Many technology companies <w>exhibit</w> their latest devices at the annual convention.",
                            "target_lang_translations": {
                                "ru": "Многие технологические компании <w>демонстрируют</w> свои новейшие устройства на ежегодном съезде.",
                                "zh": "许多科技公司在年度大会上<w>展示</w>其最新设备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "display",
                        "show"
                    ],
                    "common_phrases": [
                        "exhibit paintings",
                        "exhibit work",
                        "exhibit products"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публично демонстрировать что-либо, особенно произведения искусства или товары в музее или на торговой ярмарке.",
                        "zh": "公开展示某物，尤指在博物馆或贸易博览会上展示艺术品或产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выставлять",
                                "target_lang_sense_clarification": "показывать публике"
                            },
                            {
                                "target_lang_word": "экспонировать",
                                "target_lang_sense_clarification": "выставлять в музее"
                            },
                            {
                                "target_lang_word": "демонстрировать",
                                "target_lang_sense_clarification": "показывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展出",
                                "target_lang_sense_clarification": "公开展示"
                            },
                            {
                                "target_lang_word": "展览",
                                "target_lang_sense_clarification": "陈列供人参观"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ddfa1d3-09f3-3744-ad67-d9302a0332eb",
                    "sense_definition": "To clearly show a particular quality, emotion, or symptom.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "demonstrate_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient began to <w>exhibit</w> signs of recovery after taking the medicine.",
                            "target_lang_translations": {
                                "ru": "После приема лекарства пациент начал <w>проявлять</w> признаки выздоровления.",
                                "zh": "服药后，病人开始<w>表现出</w>康复的迹象。"
                            }
                        },
                        {
                            "text": "He did not <w>exhibit</w> any fear when he faced the dangerous situation.",
                            "target_lang_translations": {
                                "ru": "Он не <w>выказал</w> никакого страха, столкнувшись с опасной ситуацией.",
                                "zh": "面对危险情况时，他没有<w>流露</w>出任何恐惧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "demonstrate",
                        "show"
                    ],
                    "common_phrases": [
                        "exhibit signs",
                        "exhibit behavior",
                        "exhibit symptoms"
                    ],
                    "target_lang_definitions": {
                        "ru": "Явно показывать определенное качество, эмоцию или симптом.",
                        "zh": "清楚地表现出某种特质、情感或症状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявлять",
                                "target_lang_sense_clarification": "обнаруживать качество или чувство"
                            },
                            {
                                "target_lang_word": "демонстрировать",
                                "target_lang_sense_clarification": "показывать поведение"
                            },
                            {
                                "target_lang_word": "выказывать",
                                "target_lang_sense_clarification": "выражать чувство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表现出",
                                "target_lang_sense_clarification": "显露出某种特质"
                            },
                            {
                                "target_lang_word": "流露",
                                "target_lang_sense_clarification": "不经意地显露情感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceb9c4c4-ca08-325b-9fbe-64f1d61809e2",
                    "sense_definition": "To submit a physical object or document to a court as evidence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecution intends to <w>exhibit</w> the weapon found at the crime scene.",
                            "target_lang_translations": {
                                "ru": "Обвинение намерено <w>предъявить</w> оружие, найденное на месте преступления.",
                                "zh": "检方打算<w>出示</w>在犯罪现场发现的凶器。"
                            }
                        },
                        {
                            "text": "The lawyer moved to <w>exhibit</w> the signed contract during the trial.",
                            "target_lang_translations": {
                                "ru": "Адвокат ходатайствовал о том, чтобы <w>предъявить</w> подписанный договор во время судебного разбирательства.",
                                "zh": "律师申请在庭审期间<w>提交</w>已签署的合同。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "exhibit evidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять физический объект или документ суду в качестве доказательства.",
                        "zh": "向法庭提交实物或文件作为证据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предъявлять",
                                "target_lang_sense_clarification": "показывать суду"
                            },
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "подавать как доказательство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提交",
                                "target_lang_sense_clarification": "呈交证据"
                            },
                            {
                                "target_lang_word": "出示",
                                "target_lang_sense_clarification": "在法庭上展示证据"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "969c0566-b890-38ba-9970-ca0a23ea13b5",
                    "sense_definition": "A public showing of art, products, or items of interest, often in a museum or gallery.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "public_display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the museum to see the new <w>exhibit</w> on ancient Egypt.",
                            "target_lang_translations": {
                                "ru": "Мы пошли в музей, чтобы посмотреть новую <w>выставку</w>, посвященную Древнему Египту.",
                                "zh": "我们去博物馆看了关于古埃及的新<w>展览</w>。"
                            }
                        },
                        {
                            "text": "The photography <w>exhibit</w> will be open to the public until next Friday.",
                            "target_lang_translations": {
                                "ru": "<w>Выставка</w> фотографий будет открыта для посещения до следующей пятницы.",
                                "zh": "摄影<w>展览</w>将向公众开放至下周五。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exhibition",
                        "show",
                        "display"
                    ],
                    "common_phrases": [
                        "on exhibit",
                        "art exhibit",
                        "museum exhibit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичный показ искусства, товаров или предметов, представляющих интерес, часто в музее или галерее.",
                        "zh": "对艺术品、产品或感兴趣物品的公开展示，常在博物馆或画廊中进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выставка",
                                "target_lang_sense_clarification": "мероприятие"
                            },
                            {
                                "target_lang_word": "экспозиция",
                                "target_lang_sense_clarification": "размещение экспонатов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展览",
                                "target_lang_sense_clarification": "公开展示活动"
                            },
                            {
                                "target_lang_word": "展览会",
                                "target_lang_sense_clarification": "正式的展示活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f23c5015-00f3-3e10-a392-b7d1280766f0",
                    "sense_definition": "An object or a collection of objects shown publicly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "public_display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not touch the <w>exhibits</w> while walking through the gallery.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не трогайте <w>экспонаты</w> во время прогулки по галерее.",
                                "zh": "参观画廊时，请勿触摸<w>展品</w>。"
                            }
                        },
                        {
                            "text": "This old steam engine is the most popular <w>exhibit</w> in the transport museum.",
                            "target_lang_translations": {
                                "ru": "Этот старый паровой двигатель — самый популярный <w>экспонат</w> в музее транспорта.",
                                "zh": "这台老式蒸汽机是交通博物馆里最受欢迎的<w>展品</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "display",
                        "item",
                        "piece"
                    ],
                    "common_phrases": [
                        "interactive exhibit",
                        "permanent exhibit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или коллекция предметов, выставленных на всеобщее обозрение.",
                        "zh": "公开展示的物品或物品集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспонат",
                                "target_lang_sense_clarification": "предмет на выставке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展品",
                                "target_lang_sense_clarification": "陈列的物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "830354aa-1300-3c74-b836-f35a0ab04d1b",
                    "sense_definition": "An object or document formally introduced as evidence in a court of law.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer presented the photograph as <w>Exhibit</w> A for the jury to examine.",
                            "target_lang_translations": {
                                "ru": "Адвокат представил фотографию как <w>вещественное доказательство</w> \"А\" для изучения присяжными.",
                                "zh": "律师提交了这张照片作为<w>物证</w>A，供陪审团审阅。"
                            }
                        },
                        {
                            "text": "The defense attorney asked to see the <w>exhibit</w> before it was entered into the record.",
                            "target_lang_translations": {
                                "ru": "Адвокат защиты попросил осмотреть <w>вещественное доказательство</w> до того, как оно будет приобщено к делу.",
                                "zh": "辩护律师要求在将该<w>物证</w>记录在案之前先过目。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "exhibit A",
                        "defense exhibit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или документ, официально представленный в суде в качестве доказательства.",
                        "zh": "在法庭上正式作为证据引入的物品或文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вещественное доказательство",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "улика",
                                "target_lang_sense_clarification": "доказательство вины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "物证",
                                "target_lang_sense_clarification": "法律上的实物证据"
                            },
                            {
                                "target_lang_word": "证据",
                                "target_lang_sense_clarification": "呈堂证供"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}