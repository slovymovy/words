                "senses": [
                    {
                        "sense_id": "eb7a8fbc-6c6f-375f-8eb5-0243a4064bd5",
                        "entry_id": "913e2563-caaf-3dca-aa13-22c76565a553",
                        "glosses": [
                            "taki, który nie ma właściwości trujących"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "057b2541-ac11-4f66-9646-2f2de27789be",
                                "sense_id": "eb7a8fbc-6c6f-375f-8eb5-0243a4064bd5",
                                "text": "Ponieważ osłabione rośliny łatwiej padają ofiarą chorób i szkodników, trzeba uważnie je obserwować, a można profilaktycznie opryskać którymś z nietoksycznych preparatów opartych na wyciągach z czosnku lub grejpfruta."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66cdf282-a755-4ee8-907c-cc4553248a72",
                        "source_entry_id": "913e2563-caaf-3dca-aa13-22c76565a553",
                        "source_sense_id": "eb7a8fbc-6c6f-375f-8eb5-0243a4064bd5",
                        "target_lang_word": "nontoxic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nontoxic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9448f44-357b-3c2f-ad5b-bda896ffdf7a",
                                        "entry_id": "d12a7db4-dbf1-398b-8c8e-1bec9e3f6614",
                                        "glosses": [
                                            "Not toxic; not poisonous."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dc7ef95-3f21-4224-bd4d-afb6afd1213f",
                                                "sense_id": "e9448f44-357b-3c2f-ad5b-bda896ffdf7a",
                                                "text": "The Try Guys, like everyone making a living online, were inevitably shaped by their audience’s desires: They and their fans all had their hands on the Ouija board, and together they conjured a nontoxic brand of masculinity — until Fulmer flicked the lights on, exposing the fantasy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nontoxic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e397ed-66c6-3e20-b34a-f83b70834505",
                                        "entry_id": "ee555f16-2207-364d-88d2-b97536e551ce",
                                        "glosses": [
                                            "A substance that is not toxic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50073cc9-a529-4f6e-81af-7c9254724cd4",
                                                "sense_id": "c2e397ed-66c6-3e20-b34a-f83b70834505",
                                                "text": "I've simplified car cleaning to just the basic nontoxics."
                                            },
                                            {
                                                "example_id": "6b315dd1-24af-48fb-8cd8-48fe6dce4fea",
                                                "sense_id": "c2e397ed-66c6-3e20-b34a-f83b70834505",
                                                "text": "The point is that increasingly we'll have two choices: fight lead bans and lose, or learn what nontoxics work for upland birds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6792e573-bc0b-4ef7-99d0-146f6a4c94e9",
                        "source_entry_id": "913e2563-caaf-3dca-aa13-22c76565a553",
                        "source_sense_id": "eb7a8fbc-6c6f-375f-8eb5-0243a4064bd5",
