                        "form": "wordages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "790ef308-59b1-3b98-a3d2-68dcb9cf6a3a",
                        "entry_id": "8f59c504-9be9-3a55-b38f-ea93c9bdf5a4",
                        "glosses": [
                            "Words collectively, considered in a mass sense."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3355a09e-0aea-4019-8d66-9795342fa881",
                                "sense_id": "790ef308-59b1-3b98-a3d2-68dcb9cf6a3a",
                                "text": "Near-synonym: language"
                            }
                        ]
                    },
                    {
                        "sense_id": "fbde543d-ac36-39fb-bd9d-975c44aab314",
                        "entry_id": "8f59c504-9be9-3a55-b38f-ea93c9bdf5a4",
                        "glosses": [
                            "The excessive use of words."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3e8ee930-b3dc-40b4-94d6-f027bccb5f08",
                                "sense_id": "fbde543d-ac36-39fb-bd9d-975c44aab314",
                                "text": "But the plates are good, and, in reality, sufficient without all the wordage."
                            },
                            {
                                "example_id": "4533b410-0f6b-487e-84e5-3bed5afa36e6",
                                "sense_id": "fbde543d-ac36-39fb-bd9d-975c44aab314",
                                "text": "Here, I think, we must class the portmanteau-wordage of James Joyce, in which the use of verbal and syllabic association is carried so far that its power of unconscious persuasion is lost and the reader’s response is diverted by a conscious ecstasy of enigma-hunting, like a pig rooting for truffles."
                            }
                        ]
                    },
                    {
                        "sense_id": "af351df8-5a4a-31fa-8ef3-17d5a11351a3",
                        "entry_id": "8f59c504-9be9-3a55-b38f-ea93c9bdf5a4",
                        "glosses": [
                            "The number of words used in a text: synonym of word count."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fbeb95d4-fed2-4b35-8cf1-ccc9aa993fdd",
                                "sense_id": "af351df8-5a4a-31fa-8ef3-17d5a11351a3",
                                "text": "The official transcript totaled 2,045,000 words—more than twice the wordage of the Bible."
                            },
                            {
                                "example_id": "d7476e1a-f292-4cb2-b4ec-42c630b21fac",
                                "sense_id": "af351df8-5a4a-31fa-8ef3-17d5a11351a3",
                                "text": "A work of elucidation couched in a lazily dense style; a biography seemingly concerned with externals but in fact spun from inside the biographer like a spider’s thread; a critical study which exceeds in wordage all the major works of its subject put together…"
                            }
                        ]
                    },
                    {
                        "sense_id": "1f1d4a83-9f04-37af-98be-6c11b3163a96",
                        "entry_id": "8f59c504-9be9-3a55-b38f-ea93c9bdf5a4",
                        "glosses": [
                            "The choice of words used: word choice."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "09092fb6-036c-410d-a8e7-525bd1ce12c5",
                                "sense_id": "1f1d4a83-9f04-37af-98be-6c11b3163a96",
                                "text": "Near-synonyms: phrasing; terminology; phraseology"
                            },
                            {
                                "example_id": "85346f4f-5c68-4594-b0cc-24477161fd39",
                                "sense_id": "1f1d4a83-9f04-37af-98be-6c11b3163a96",
                                "text": "\"With the wordage in the contract, we think we have a good case.\""
                            }
                        ]
                    }
