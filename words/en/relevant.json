{
    "word_family": [
        "relevance",
        "relevancy",
        "irrelevant",
        "irrelevance",
        "relevantly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0164208e-8fb1-393f-84bb-f1bf8297664d",
                    "sense_definition": "Directly connected with the subject or problem being discussed or considered.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please ensure that all <w>relevant</w> documents are attached to your application form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что все <w>соответствующие</w> документы приложены к вашей анкете.",
                                "zh": "请确保所有<w>相关</w>文件都已附在申请表上。"
                            }
                        },
                        {
                            "text": "The witness provided <w>relevant</w> information that helped the police solve the case.",
                            "target_lang_translations": {
                                "ru": "Свидетель предоставил <w>относящуюся к делу</w> информацию, которая помогла полиции раскрыть дело.",
                                "zh": "证人提供了对破案有帮助的<w>相关</w>信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "applicable",
                        "germane",
                        "pertinent"
                    ],
                    "antonyms": [
                        "irrelevant"
                    ],
                    "common_phrases": [
                        "relevant information",
                        "relevant details",
                        "relevant to",
                        "highly relevant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непосредственно связанный с обсуждаемым предметом или проблемой.",
                        "zh": "与正在讨论或考虑的主题或问题直接相关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "относя́щийся к де́лу",
                                "target_lang_sense_clarification": "связанный с темой обсуждения"
                            },
                            {
                                "target_lang_word": "соотве́тствующий",
                                "target_lang_sense_clarification": "подходящий, нужный в данном контексте"
                            },
                            {
                                "target_lang_word": "релева́нтный",
                                "target_lang_sense_clarification": "существенный, важный (часто в поиске информации)"
                            },
                            {
                                "target_lang_word": "уме́стный",
                                "target_lang_sense_clarification": "подходящий к случаю"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相关的",
                                "target_lang_sense_clarification": "与主题有直接联系的"
                            },
                            {
                                "target_lang_word": "切题的",
                                "target_lang_sense_clarification": "符合讨论主题的"
                            },
                            {
                                "target_lang_word": "有关的",
                                "target_lang_sense_clarification": "与某事有联系的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62a8374b-c235-35ef-9e7a-0733e5d8c530",
                    "sense_definition": "Having significance or importance in the present time; not out of date.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author's books remain <w>relevant</w> to readers even fifty years after they were written.",
                            "target_lang_translations": {
                                "ru": "Книги автора остаются <w>актуальными</w> для читателей даже спустя пятьдесят лет после написания.",
                                "zh": "这位作者的书在写成五十年后，对读者来说依然<w>有现实意义</w>。"
                            }
                        },
                        {
                            "text": "We must constantly innovate to stay <w>relevant</w> in a rapidly changing industry.",
                            "target_lang_translations": {
                                "ru": "Мы должны постоянно внедрять инновации, чтобы оставаться <w>востребованными</w> в быстро меняющейся индустрии.",
                                "zh": "我们必须不断创新，才能在这个瞬息万变的行业中保持<w>现实意义</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "current",
                        "up-to-date"
                    ],
                    "common_phrases": [
                        "remain relevant",
                        "stay relevant",
                        "culturally relevant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий значение или важность в настоящее время; не устаревший.",
                        "zh": "在当前具有意义或重要性；不过时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "актуа́льный",
                                "target_lang_sense_clarification": "важный в данный момент"
                            },
                            {
                                "target_lang_word": "совреме́нный",
                                "target_lang_sense_clarification": "отвечающий требованиям времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有现实意义的",
                                "target_lang_sense_clarification": "在当下依然重要的"
                            },
                            {
                                "target_lang_word": "不过时的",
                                "target_lang_sense_clarification": "依然符合现代需求的"
                            },
                            {
                                "target_lang_word": "有价值的",
                                "target_lang_sense_clarification": "在当前环境下依然有用的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75d39808-14bc-34a4-b1ec-1d6cf622c4b6",
                    "sense_definition": "Famous, popular, or noteworthy in a contemporary context.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The celebrity tried various publicity stunts to keep herself <w>relevant</w> in the media.",
                            "target_lang_translations": {
                                "ru": "Знаменитость пробовала различные пиар-ходы, чтобы оставаться <w>популярной</w> в СМИ.",
                                "zh": "这位名人尝试了各种宣传噱头，以在媒体面前保持<w>热度</w>。"
                            }
                        },
                        {
                            "text": "It is difficult for traditional media outlets to be <w>relevant</w> to the internet generation.",
                            "target_lang_translations": {
                                "ru": "Традиционным СМИ трудно быть <w>значимыми</w> для интернет-поколения.",
                                "zh": "传统媒体很难对互联网一代保持<w>影响力</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Известный, популярный или заслуживающий внимания в современном контексте.",
                        "zh": "在当代背景下著名、受欢迎或值得关注。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "востре́бованный",
                                "target_lang_sense_clarification": "пользующийся спросом, популярный"
                            },
                            {
                                "target_lang_word": "зна́чимый",
                                "target_lang_sense_clarification": "имеющий вес в обществе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受欢迎的",
                                "target_lang_sense_clarification": "在公众中保持热度的"
                            },
                            {
                                "target_lang_word": "有影响力的",
                                "target_lang_sense_clarification": "在当代社会中具有地位的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}