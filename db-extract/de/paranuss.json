                "senses": [
                    {
                        "sense_id": "68e00fa9-d7c0-36c6-8b69-0ecb923a89b4",
                        "entry_id": "ba0aa5ec-27e7-3237-a3c1-8fb88eddab36",
                        "glosses": [
                            "größerer, länglicher, dreikantiger Samen des brasilianischen Paranussbaumes mit dunkelbrauner, sehr harter Schale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a31f2205-af8d-4948-8aaa-ae0a2bd76508",
                                "sense_id": "68e00fa9-d7c0-36c6-8b69-0ecb923a89b4",
                                "text": "„Neben dem hohen Eiweiß- und Fettgehalt – bis zu 70 % – besitzt die Paranuss im Vergleich zu anderen Nussarten auch noch einen sehr hohen Anteil an Mineralstoffen (Calcium, Eisen, Kalium, Magnesium, Phosphor, Selen und Zink).“"
                            },
                            {
                                "example_id": "c3a059db-51b0-4586-9ed7-c9cbe9fb3c4d",
                                "sense_id": "68e00fa9-d7c0-36c6-8b69-0ecb923a89b4",
                                "text": "„Die Paranüsse kriegte nicht mal Papa mit dem Nußknacker auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
