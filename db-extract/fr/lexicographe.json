        "fr-extract.jsonl": [
            {
                "entry_id": "4f69acb5-3fe2-3048-8273-94548031857c",
                "word": "lexicographe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "73baf1aa-5bb0-4665-94a5-454657702a83",
                        "entry_id": "4f69acb5-3fe2-3048-8273-94548031857c",
                        "tags": [
                            "plural"
                        ],
                        "form": "lexicographes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "89e734d4-2e2b-361e-8d45-170caca075d2",
                        "entry_id": "4f69acb5-3fe2-3048-8273-94548031857c",
                        "glosses": [
                            "Personne qui connaît ou exerce l’art de la lexicographie, consistant en la rédaction d’un dictionnaire, d’un glossaire, d’un lexique ou d’un thésaurus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ed70e8-2445-442d-a689-45e341ba53a9",
                                "sense_id": "89e734d4-2e2b-361e-8d45-170caca075d2",
                                "text": "Lorsqu’un mot est supprimé – « Cela nous fait toujours un peu de peine », rapportent nos lexicographes –, il faut vraiment qu’il ne soit plus en usage, la règle étant de ne pas éliminer un terme utile à un lecteur de Balzac ou de Hugo."
                            },
                            {
                                "example_id": "345bc371-e5f2-45c4-9873-e82d4e490bcf",
                                "sense_id": "89e734d4-2e2b-361e-8d45-170caca075d2",
                                "text": "Qu’honneur soit rendu au lexicographe car il sait rendre intelligible le plus ardu des concepts."
                            },
                            {
                                "example_id": "f2bae051-481f-461d-8e45-786ee7043b9c",
                                "sense_id": "89e734d4-2e2b-361e-8d45-170caca075d2",
                                "text": "Un lexicographe, selon Johnson, c’est un homme de peine inoffensif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a0db37d-881c-4684-be22-be2b53ab5709",
                        "source_entry_id": "4f69acb5-3fe2-3048-8273-94548031857c",
                        "source_sense_id": "89e734d4-2e2b-361e-8d45-170caca075d2",
                        "target_lang_word": "Lexikograph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lexikograph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c4abc90-9158-30c9-93bf-f0ecb2502f3f",
                                        "entry_id": "51db5e7b-5332-3cdd-b689-431cc92b7443",
                                        "glosses": [
                                            "Person, die an der Bearbeitung oder Erstellung eines Wörterbuchs/von Wörterbüchern allein oder in Kooperation mit anderen arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6873bb0-051e-4c37-a404-7ee6d5a3a72f",
                                                "sense_id": "7c4abc90-9158-30c9-93bf-f0ecb2502f3f",
                                                "text": "„Um den Status seiner Muttersprache zu heben, betätigte sich Lifschiz als Lexikograph und stellte aus dem Wortschatz seines Heimatdialekts, des Südostjiddischen der Provinz Wolhynien, mehrere Wörterbücher zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f048c5f-a6c5-4d29-ba5a-00271398145a",
                        "source_entry_id": "4f69acb5-3fe2-3048-8273-94548031857c",
                        "source_sense_id": "89e734d4-2e2b-361e-8d45-170caca075d2",
                        "target_lang_word": "Lexikographin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c71429b6-fb05-41b9-9459-dd4bc54f72b2",
                        "source_entry_id": "4f69acb5-3fe2-3048-8273-94548031857c",
                        "source_sense_id": "89e734d4-2e2b-361e-8d45-170caca075d2",
                        "target_lang_word": "lexicographer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lexicographer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd80b182-a3ca-32e5-8c65-a4878da386bc",
                                        "entry_id": "10fc14db-2675-32cb-b410-f78a010b20e1",
                                        "glosses": [
                                            "One who writes or compiles a dictionary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0197e66-dfec-471c-aa28-37ee7734e3ac",
                                                "sense_id": "bd80b182-a3ca-32e5-8c65-a4878da386bc",
                                                "text": "Lexico′grapher. […] A writer of dictionaries; a harmleſs drudge, that buſies himſelf in tracing the original, and detailing the ſignification of words."
                                            },
                                            {
                                                "example_id": "79cd4bc7-7c82-4cb9-b6f9-95f394130897",
                                                "sense_id": "bd80b182-a3ca-32e5-8c65-a4878da386bc",
                                                "text": "Pitt has furnish'd us a word or two / Which lexicographers declined to do."
                                            },
                                            {
                                                "example_id": "8f11f384-6002-49b9-9915-2b20b027c481",
                                                "sense_id": "bd80b182-a3ca-32e5-8c65-a4878da386bc",
                                                "text": "The best lexicographer may well be content if his productions are received by the world with cold esteem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06df8c79-f56f-41c0-bab9-dc40c4f03777",
                        "source_entry_id": "4f69acb5-3fe2-3048-8273-94548031857c",
                        "source_sense_id": "89e734d4-2e2b-361e-8d45-170caca075d2",
                        "target_lang_word": "lexicógrafo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lexicógrafo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "34ec3064-5bd7-3395-bc7d-621378eae552",
                                        "entry_id": "76e159f2-9832-3d6f-be91-f8f5f90c3382",
                                        "glosses": [
                                            "Persona versada en lexicografía, y que se encarga de copilar los vocablos que han de entrar en un léxico."
                                        ],
                                        "tags": [
                                            "Ocupaciones",
                                            "oficios"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d96a7aa1-a9c0-450f-b120-e86554eabd45",
                                                "sense_id": "34ec3064-5bd7-3395-bc7d-621378eae552",
                                                "text": "«El lexicógrafo no ha de ver en la palabra más que la representación sensible del concepto, pero teniendo siempre en cuenta de que, supuesta la mutua y necesaria cooperación que se prestan pensamiento y lenguaje —sin la cual ni este sería otra cosa que un rudimentario sistema de señales ni aquel habría logrado sobrepasar las formas elementales de conocimiento— no es lícito en modo desvincular el signo y el significado cual si fuesen dos realidades con existencia propia e independiente»."
                                            },
                                            {
                                                "example_id": "dcfc91a1-a427-4937-bf26-536d4dd64ca9",
                                                "sense_id": "34ec3064-5bd7-3395-bc7d-621378eae552",
                                                "text": "«El entomólogo de las palabras es el lexicógrafo, al que no es raro ver en las esquinas armado de una red con que atrapa voces que luego ordena, a modo de una colección de insectos, en el interior de un volumen»."
                                            },
                                            {
                                                "example_id": "4badb9e1-7988-41b3-a172-3b219d981703",
                                                "sense_id": "34ec3064-5bd7-3395-bc7d-621378eae552",
                                                "text": "«El lexicógrafo georgiano del siglo xvii, Sulhan Saba Orbeliani, en su Diccionario Enciclopédico, dice con respecto al propóleo, que es una sustancia resinosa y similar a la cera que se utiliza con fines medicinales»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
