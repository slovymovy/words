                                                "example_id": "77c81de8-7c89-4863-bc79-9f71dc0e18da",
                                                "sense_id": "7ee9f483-efa5-3d09-9753-91bcb5c0bd79",
                                                "text": "Un nouveau sport connaîtra ses débuts olympiques à Paris 2024 : le breaking."
                                            },
                                            {
                                                "example_id": "96fc296b-589d-4965-aa22-179f8c0b4ca8",
                                                "sense_id": "7ee9f483-efa5-3d09-9753-91bcb5c0bd79",
                                                "text": "Le breaking est un style de danse qui s’est développé aux Etats-Unis pendant les années 1970."
                                            }
