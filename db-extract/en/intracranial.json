                        "entry_id": "0f729141-53a3-3a61-b60c-15435b014867",
                        "glosses": [
                            "Of or pertaining to the brain or inside of the head; within the cranium."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8890baf0-6e7d-4194-8a54-8f03606c5167",
                                "sense_id": "9c00873c-8ee9-3cb3-9b02-e7ce4421ca31",
                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                            },
                            {
                                "example_id": "9d796b77-5c73-49ab-b6d2-c4bcaf8c0eae",
                                "sense_id": "9c00873c-8ee9-3cb3-9b02-e7ce4421ca31",
                                "text": "The doctors attributed the intracranial haemorrhage to a domestic accident to a fall Lula had in October while taking a shower in the Alvorada Palace, the official presidential residence in Brasília."
                            }
                        ]
                    }
