                        "source_entry_id": "7214fa87-7905-32d3-a35b-f00fe9f438e2",
                        "source_sense_id": "0521d44b-bd4a-33c0-a415-dcbf66b5b9ee",
                        "target_lang_word": "abortionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abortionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0d814e2-6184-3e61-b0ea-dcb7422fbb84",
                                        "entry_id": "f1081f1f-9edf-3fae-924a-7846eb244406",
                                        "glosses": [
                                            "A person who performs abortions, especially illegally or secretly."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8f2af88-2a3c-48f9-b2f4-9336ae5f909f",
                                                "sense_id": "e0d814e2-6184-3e61-b0ea-dcb7422fbb84",
                                                "text": "Mad. Restell, the celebrated Abortionist [is arrested]."
                                            },
                                            {
                                                "example_id": "52157696-7f5e-46d0-938b-aa1b0220d810",
                                                "sense_id": "e0d814e2-6184-3e61-b0ea-dcb7422fbb84",
                                                "text": "The quack abortionist, with “a little knowledge,” impudently, remorselessly, and secretly employs his craft for filthy lucre’s sake, perpetrating one crime to conceal another, at which science and charity blush."
                                            },
                                            {
                                                "example_id": "a509a63f-8bfc-4278-9392-9d3bd43d0502",
                                                "sense_id": "e0d814e2-6184-3e61-b0ea-dcb7422fbb84",
                                                "text": "Such a fetus is perfectly viable save for the act of the abortionist."
                                            },
                                            {
                                                "example_id": "1a773618-b55c-46b2-8459-0f64d53435d3",
                                                "sense_id": "e0d814e2-6184-3e61-b0ea-dcb7422fbb84",
                                                "text": "According to Bray, “there is a difference between taking a retired abortionist and executing him, and killing a practicing abortionist who is regularly killing babies.” The first act is in Bray’s view retributive, the second defensive."
                                            },
                                            {
                                                "example_id": "bedcfa1c-c03b-4e31-bcf6-c48d577eceef",
                                                "sense_id": "e0d814e2-6184-3e61-b0ea-dcb7422fbb84",
                                                "text": "In 1962, when abortion was still illegal, I published an anonymous interview with Dr. Robert Spencer, a humane abortionist who was known as “The Saint.”"
                                            },
                                            {
                                                "example_id": "e6f7d0cd-2fe1-47f3-bddc-dc77b7e37d8a",
                                                "sense_id": "e0d814e2-6184-3e61-b0ea-dcb7422fbb84",
                                                "text": "[…] a gruesome procedure in which the abortionist dismembers a child who could survive outside the womb."
                                            },
                                            {
                                                "example_id": "6f80dca4-4cd3-4212-be83-a152aa045248",
                                                "sense_id": "e0d814e2-6184-3e61-b0ea-dcb7422fbb84",
                                                "text": "Then she asks her to go first to meet the abortionist. Then she neglects to make a reservation at the hotel the abortionist specifies. That almost sinks the arrangement: The abortionist has experience suggesting that hotel will be a safe venue, and suspects he may be set up for a police trap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb8f2515-6701-31dc-96f8-029a08debdfd",
                                        "entry_id": "f1081f1f-9edf-3fae-924a-7846eb244406",
                                        "glosses": [
                                            "A person who advocates for or supports the legality of abortion."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
