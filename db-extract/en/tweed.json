                                    {
                                        "sense_id": "b86fbb13-657f-3b6f-9977-181eac7db862",
                                        "entry_id": "d6b44272-aec1-3e0a-baf3-fe239bdc32a6",
                                        "glosses": [
                                            "obchodní označení sportovně elegantních látek s vlněným povrchem"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbaa94cd-f118-41d0-bcb4-8bb7c9f84e64",
                        "source_entry_id": "9f3edd0c-4066-307a-9412-286e45750865",
                        "source_sense_id": "105d74cb-d9ad-3895-849d-16615be43841",
                        "source_sense_description": "coarse woolen fabric",
                        "target_lang_word": "tweed",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tweed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9dc0e82f-e1d7-31cb-93d4-3285ef446cd3",
                                        "entry_id": "d74a2e46-2c39-3dd0-b50d-696238c4a623",
                                        "glosses": [
                                            "geribbeld wollen weefsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab4817a6-d970-4fc5-98a1-50b0e21a1da4",
                                                "sense_id": "9dc0e82f-e1d7-31cb-93d4-3285ef446cd3",
                                                "text": "Op mijn 15de kocht ik een pak bij Peter Robinson. Een grijs tweed kostuum met visgraatmotief. Ik droeg het toen ik voor het eerst naar Straatsburg en Italië ging. Om de hoek in Regent Street was de bushalte, waar ik de Green Line nam. Aan de overkant van Oxford Circus zat de bioscoop waar ik de films zag van René Clair. Alles is beschadigd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09980830-4470-4cd5-9b08-d34da7e4d84e",
                        "source_entry_id": "9f3edd0c-4066-307a-9412-286e45750865",
                        "source_sense_id": "105d74cb-d9ad-3895-849d-16615be43841",
                        "source_sense_description": "coarse woolen fabric",
                        "target_lang_word": "tweed",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tweed",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4aa41a5e-ea5b-32bc-bd7f-e29d244579e7",
                                        "entry_id": "96fd13ca-d032-322f-aa2f-87efc4a96efd",
                                        "glosses": [
                                            "Tissu de laine, généralement de deux couleurs, originaire d’Écosse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e37fcc-5c36-48ae-8745-e0770a995d81",
                                                "sense_id": "4aa41a5e-ea5b-32bc-bd7f-e29d244579e7",
                                                "text": "Vous feriez sourire M. Gerfaut, qui ne perd pas souvent son temps à rire. Regardez-le, sec, nerveux, bilieux, longs favoris, œil scrutateur, parole brève, soulignant chaque mot d’un chiffre ; chapeau droit, redingote noire, pantalon de tweed, parapluie breveté."
                                            },
                                            {
                                                "example_id": "1b73dd5e-9dda-414c-9820-f3b5c83e3b0b",
                                                "sense_id": "4aa41a5e-ea5b-32bc-bd7f-e29d244579e7",
                                                "text": "Elle portait une jupe de tweed et un cardigan en shetland."
                                            },
                                            {
                                                "example_id": "e8e75058-855f-4ab1-a4ff-aaa2c9938ed0",
                                                "sense_id": "4aa41a5e-ea5b-32bc-bd7f-e29d244579e7",
                                                "text": "Avant la guerre, sans doute, le manoir avait été envahi, durant quelques jours, par des opérateurs pourvus de machines encombrantes, des assistants, des soundmen, un tas d’inconnus en knickerbockers et bas écossais, presque tous en veston de tweed et casquette claire."
                                            },
                                            {
                                                "example_id": "34d8e18f-b099-48db-9eeb-7d5f10e88b1a",
                                                "sense_id": "4aa41a5e-ea5b-32bc-bd7f-e29d244579e7",
                                                "text": "Il avait plus de style, avec son cartable de facteur en cuir élimé et son béret en tweed – comme quoi, la mode vintage ne date pas d’hier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57836259-2206-3a9a-9b86-494dcac43842",
                                        "entry_id": "96fd13ca-d032-322f-aa2f-87efc4a96efd",
                                        "glosses": [
                                            "(Parfois féminin) Costume en tweed (paletot, pardessus…)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19f8bf0-779c-493b-9c58-340741603759",
                                                "sense_id": "57836259-2206-3a9a-9b86-494dcac43842",
                                                "text": "Cependant, mon parti étant pris de ne pas reculer, j’acceptai mon mal en patience, et, après m’être le plus soigneusement possible enveloppé dans ma tweed et m’être bien enfoncé dans mon coin, je me mis à considérer mes compagnons de voyage."
                                            },
                                            {
                                                "example_id": "6388c5dd-ce40-4178-a7d8-5f52762ea56b",
                                                "sense_id": "57836259-2206-3a9a-9b86-494dcac43842",
                                                "text": "C’était un garçon que l’on pouvait montrer avec quelque fierté, vêtu de son tweed de bonne étoffe, toujours propre et dont il prenait grand soin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4b4f90a-edbd-47dc-9130-186fad037bb2",
                        "source_entry_id": "9f3edd0c-4066-307a-9412-286e45750865",
                        "source_sense_id": "105d74cb-d9ad-3895-849d-16615be43841",
                        "source_sense_description": "coarse woolen fabric",
                        "target_lang_word": "Tweed",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tweed",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c708202-3f2c-3220-94ba-10183f68a959",
                                        "entry_id": "87f0c0c8-7f55-385d-bcbe-0e66cc07bdfd",
                                        "glosses": [
                                            "ein dichtes Gewebe aus Wolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0b3065b-fb69-4135-898a-f5c873ed86c7",
                                                "sense_id": "2c708202-3f2c-3220-94ba-10183f68a959",
                                                "text": "„Im kommenden Winter ist Tweed aus der Mode nicht wegzudenken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tweed",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50313d6f-67ea-3f2a-b31b-acfb86da9e7a",
                                        "entry_id": "69a40b7d-0e58-3df6-b7f8-fe890f3a2d39",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "383e3774-343d-4e49-9a6d-e5d9049be6ab",
                                                "sense_id": "50313d6f-67ea-3f2a-b31b-acfb86da9e7a",
                                                "text": "Frau Tweed ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "048ae4f3-fc42-42fd-b2fe-24cfe9d90c96",
                                                "sense_id": "50313d6f-67ea-3f2a-b31b-acfb86da9e7a",
                                                "text": "Herr Tweed wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "b8fcd167-ed1d-4658-a08e-066ad8fb4d7e",
                                                "sense_id": "50313d6f-67ea-3f2a-b31b-acfb86da9e7a",
                                                "text": "Die Tweeds kommen heute aus Karlsruhe."
                                            },
                                            {
                                                "example_id": "91fd2eb0-f573-4f34-b47e-6a99f7e45db9",
                                                "sense_id": "50313d6f-67ea-3f2a-b31b-acfb86da9e7a",
                                                "text": "Der Tweed trägt nie die Schals, die die Tweed ihm strickt."
                                            },
                                            {
                                                "example_id": "8b790cd6-c39e-4e94-a9c8-28e79d1602c2",
                                                "sense_id": "50313d6f-67ea-3f2a-b31b-acfb86da9e7a",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tweed kommt, geht der Herr Tweed.“"
                                            },
                                            {
                                                "example_id": "ba1741a1-b576-4d34-b976-ce038fbdcacf",
                                                "sense_id": "50313d6f-67ea-3f2a-b31b-acfb86da9e7a",
                                                "text": "Tweed kommt und geht."
                                            },
                                            {
                                                "example_id": "b72812ff-60d8-4a5a-8784-7d27e0502e9d",
                                                "sense_id": "50313d6f-67ea-3f2a-b31b-acfb86da9e7a",
                                                "text": "Tweeds kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "17965a7b-811c-435b-9fa5-f071ead861b4",
                                                "sense_id": "50313d6f-67ea-3f2a-b31b-acfb86da9e7a",
                                                "text": "An verregneten Herbsttagen ist Familie Tweeds liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "fda3a488-a4a5-4c9b-b8da-ed71e641b3f9",
                                                "sense_id": "50313d6f-67ea-3f2a-b31b-acfb86da9e7a",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Tweed das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
