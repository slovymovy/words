                    },
                    {
                        "translation_id": "2a8234c7-489c-4f9e-9ea3-a61446fea013",
                        "source_entry_id": "de508aee-ab97-39c9-866f-b100081ca9f4",
                        "target_lang_word": "Anvers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
