                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97047315-1609-49af-b71e-337e3fca7917",
                                "sense_id": "16c2217c-0334-33b0-8c1e-d95174a29c49",
                                "text": "Er steckte sich eine Hühnerfeder an seinen Hut."
                            },
                            {
                                "example_id": "2534f420-c1b7-4646-a7e6-b91c97953a5b",
                                "sense_id": "16c2217c-0334-33b0-8c1e-d95174a29c49",
                                "text": "Als Kinder sammelten wir gern Hühnerfedern."
                            },
                            {
                                "example_id": "c0e92b1a-9244-417d-b429-4191ab8f0e91",
                                "sense_id": "16c2217c-0334-33b0-8c1e-d95174a29c49",
                                "text": "„Er hat sein Haar zu zwei Zöpfen geflochten, zwei große Adlerfedern und viele kleinere Hühnerfedern ragen aus dem Stirnband.“"
                            }
                        ],
