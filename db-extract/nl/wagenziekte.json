                "senses": [
                    {
                        "sense_id": "ec6bd3cd-16d6-34c4-8efb-6af85c6d1929",
                        "entry_id": "96c20542-b9cc-3b15-aa53-514bb92de43a",
                        "glosses": [
                            "misselijkheid die ontstaat doordat de visuele informatie en de informatie uit het evenwichtsorgaan tijdens autorijden met elkaar in tegenspraak kunnen zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb41cba1-cf73-466b-9c53-97f941c72318",
                                "sense_id": "ec6bd3cd-16d6-34c4-8efb-6af85c6d1929",
                                "text": "Ruim 30 miljoen mensen in Europa hebben last van chronische wagenziekte. De 'Seetroën bril' bevat een gekleurde, bewegende vloeistof die de lijn van de horizon opnieuw creëert om zo het conflict tussen de zintuigen te neutraliseren."
                            },
                            {
                                "example_id": "a2c9ebcd-1b54-4c41-8cb6-89e91dbe5b04",
                                "sense_id": "ec6bd3cd-16d6-34c4-8efb-6af85c6d1929",
                                "text": "Wagenziekte. Met de zomervakantie op komst vrezen honderdduizenden ouders weer voor jengelende en misselijke kinderen op de Route du Soleil. Maar er is goed nieuws: autofabrikanten werken hard aan een oplossing."
                            },
                            {
                                "example_id": "9eaebbcc-70b4-43f8-91fe-805cfa2031f2",
                                "sense_id": "ec6bd3cd-16d6-34c4-8efb-6af85c6d1929",
                                "text": "Autofabrikant Jaguar Land Rover ontwikkelt een systeem dat wagenziekte bij passagiers kan detecteren en automatisch de instellingen van de auto aanpast opdat de inzittenden zich beter voelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "344acf60-c869-4336-bc57-f4e673535590",
                        "source_entry_id": "96c20542-b9cc-3b15-aa53-514bb92de43a",
                        "source_sense_id": "ec6bd3cd-16d6-34c4-8efb-6af85c6d1929",
                        "source_sense_description": "reisziekte",
                        "target_lang_word": "Reisekrankheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reisekrankheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d557fdac-328d-3458-b0aa-bbf9bb063cf2",
                                        "entry_id": "48716883-d114-340a-8a72-7b58d1efa98f",
                                        "glosses": [
                                            "Gesamtheit von Beschwerden wie Schwindel oder Übelkeit, die bei der Benutzung bestimmter Verkehrsmittel (Bus, Schiff, Flugzeug oder Ähnliches) auftreten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ff8ae0-5422-4659-b720-119df444be44",
                                                "sense_id": "d557fdac-328d-3458-b0aa-bbf9bb063cf2",
                                                "text": "Bei ersten Symptomen der Reisekrankheit soll man auf einem Stückchen Ingwer kauen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f972332a-b19b-3916-aaf8-a220326dff2f",
                                        "entry_id": "48716883-d114-340a-8a72-7b58d1efa98f",
                                        "glosses": [
                                            "Krankheit, mit der sich jemand im Urlaub ansteckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1fb64d3-6e4f-4b44-a5b5-c180f409cec7",
                                                "sense_id": "f972332a-b19b-3916-aaf8-a220326dff2f",
                                                "text": "„Einige Reisekrankheiten, die nur in der Ferne vermutet werden, treten auch in Europa auf.“"
                                            },
                                            {
                                                "example_id": "13ac55e2-267d-4b9a-93ce-cbe26e175aa8",
                                                "sense_id": "f972332a-b19b-3916-aaf8-a220326dff2f",
                                                "text": "„Für Jahrzehnte galt Hepatitis E als reine, mitunter gefährliche Reisekrankheit.“"
                                            },
                                            {
                                                "example_id": "fe631fda-e3f4-42e3-8932-cf3fc2423e17",
                                                "sense_id": "f972332a-b19b-3916-aaf8-a220326dff2f",
                                                "text": "„Es ist eine Infektion, die wir in Deutschland bisher nur als Reisekrankheit kennen, eingeschleppt aus tropischen, teils auch aus gemäßigten Breiten: das West-Nil-Fieber.“"
                                            },
                                            {
                                                "example_id": "8a3840ec-da88-4fcc-873a-e1560b930770",
                                                "sense_id": "f972332a-b19b-3916-aaf8-a220326dff2f",
                                                "text": "„Ursprünglich kommen die krankmachenden Keime aus dem Darm von Wiederkäuern. Sie können sich über Lebensmittel wie rohe Milch, Fleisch, Wurst oder das Trinkwasser direkt verbreiten – deshalb ist eine EHEC-Infektion eine häufige Reisekrankheit […] – oder auch den Umweg über ungewaschene menschliche Hände nehmen.“"
                                            },
                                            {
                                                "example_id": "5d4aaff8-6992-4bd5-8729-133c8f4cd814",
                                                "sense_id": "f972332a-b19b-3916-aaf8-a220326dff2f",
                                                "text": "„Die HAV-Infektion stellt dagegen eine typische Reisekrankheit dar, die aufgrund von mangelnden Hygienemaßnahmen durch Lebensmittel übertragen werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
