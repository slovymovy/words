{
    "word_family": [
        "rouse",
        "rouser"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "23d63432-2fde-388b-9330-5492f44c940b",
                    "sense_definition": "Exciting, stirring, or lively; able to wake or inspire strong emotions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd erupted in cheers after the politician delivered a <w>rousing</w> speech.",
                            "target_lang_translations": {
                                "ru": "Толпа разразилась аплодисментами после того, как политик произнес <w>воодушевляющую</w> речь."
                            }
                        },
                        {
                            "text": "The orchestra played a <w>rousing</w> chorus that filled the entire concert hall with energy.",
                            "target_lang_translations": {
                                "ru": "Оркестр исполнил <w>зажигательный</w> хор, который наполнил энергией весь концертный зал."
                            }
                        }
                    ],
                    "synonyms": [
                        "stirring",
                        "exciting",
                        "inspiring",
                        "stimulating"
                    ],
                    "antonyms": [
                        "boring",
                        "dull",
                        "uninspiring"
                    ],
                    "common_phrases": [
                        "rousing speech",
                        "rousing chorus",
                        "rousing welcome"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воодушевляющий, волнующий или оживленный; способный пробудить или вдохновить на сильные эмоции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воодушевляющий",
                                "target_lang_sense_clarification": "о речи, музыке, призыве"
                            },
                            {
                                "target_lang_word": "зажигательный",
                                "target_lang_sense_clarification": "о выступлении, танце, музыке"
                            },
                            {
                                "target_lang_word": "пламенный",
                                "target_lang_sense_clarification": "о речи, ораторе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5316f923-3bef-3d2c-a5c4-13c846c07c11",
                    "sense_definition": "The act of waking someone up or stirring them into activity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using disposable diapers can save parents from repeated nighttime <w>rousings</w>.",
                            "target_lang_translations": {
                                "ru": "Использование одноразовых подгузников может избавить родителей от частых ночных <w>пробуждений</w>."
                            }
                        },
                        {
                            "text": "The sudden loud noise caused several abrupt <w>rousings</w> among the sleeping campers.",
                            "target_lang_translations": {
                                "ru": "Внезапный громкий шум вызвал несколько резких <w>пробуждений</w> среди спящих в лагере."
                            }
                        }
                    ],
                    "synonyms": [
                        "awakening",
                        "waking"
                    ],
                    "common_phrases": [
                        "nighttime rousings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по пробуждению кого-либо ото сна или побуждению к активности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробуждение",
                                "target_lang_sense_clarification": "ото сна или к действию"
                            },
                            {
                                "target_lang_word": "расталкивание",
                                "target_lang_sense_clarification": "попытка разбудить"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "02aec123-2ef6-3b6d-837c-9ae30ae075e5",
                    "sense_definition": "Present participle and gerund of <w>rouse</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was gently <w>rousing</w> the sleeping child so they wouldn't miss the bus.",
                            "target_lang_translations": {
                                "ru": "Она осторожно <w>будила</w> спящего ребенка, чтобы они не опоздали на автобус."
                            }
                        },
                        {
                            "text": "By <w>rousing</w> the public's interest, the campaign managed to raise thousands of dollars.",
                            "target_lang_translations": {
                                "ru": "<w>Пробудив</w> интерес общественности, кампания сумела собрать тысячи долларов."
                            }
                        }
                    ],
                    "synonyms": [
                        "waking",
                        "stirring",
                        "provoking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола rouse (будить, будоражить, пробуждать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "будящий",
                                "target_lang_sense_clarification": "пробуждающий ото сна"
                            },
                            {
                                "target_lang_word": "пробуждающий",
                                "target_lang_sense_clarification": "вызывающий интерес или эмоции"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}