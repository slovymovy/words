                                "example_id": "a2e93c60-c4ae-4eef-a5c1-27e73624a053",
                                "sense_id": "5473c003-a68c-3c69-b808-c3e90123ad39",
                                "text": "„Die Eisenbahnlinie von Arica in Chile am Stillen Ozean nach La Paz in Bolivien wird offiziell dem Verkehr übergeben.“"
                            }
