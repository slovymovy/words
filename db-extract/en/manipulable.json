                        "sense_id": "79b04a17-42ff-3c97-ade3-614312b02ab6",
                        "entry_id": "8b2ec64c-b5f9-34dd-9f5a-37a3f1a99d5c",
                        "glosses": [
                            "Suitable for, or able to be subjected to, manipulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70c76f38-b108-49a4-8bc6-65461b59ca4c",
                                "sense_id": "79b04a17-42ff-3c97-ade3-614312b02ab6",
                                "text": "He wondered if this was how men like Jardine and Matheson saw the world – minuscule, manipulable. If people and places moved around the lines they drew. If cities shattered when they stomped."
                            },
                            {
                                "example_id": "3447221b-63ae-4019-a3d0-ee21dd7d5e64",
                                "sense_id": "79b04a17-42ff-3c97-ade3-614312b02ab6",
                                "text": "I think we have a responsibility to emphasize to our students that law is something less: a system, manipulable like any other, for achieving political and policy ends."
                            }
                        ]
                    }
                ],
