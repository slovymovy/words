                "senses": [
                    {
                        "sense_id": "bc7ed439-6cd9-3a06-a867-3ff80e2e627e",
                        "entry_id": "019348e8-9728-3f46-a1bd-affdcb4450be",
                        "glosses": [
                            "Einrichtung, die durch Erforschung, Entwicklung und Bewertung von politischen, sozialen und wirtschaftlichen Konzepten und Strategien Einfluss auf die öffentliche Meinungsbildung nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f185fd0-1c71-4396-881f-e0642e76c04a",
                                "sense_id": "bc7ed439-6cd9-3a06-a867-3ff80e2e627e",
                                "text": "„Hillary Clintons ehemalige Berater haben sich in Thinktanks und Initiativen in Stellung gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fd5c354-0690-4ab1-9de1-71ad80150fba",
                        "source_entry_id": "019348e8-9728-3f46-a1bd-affdcb4450be",
                        "source_sense_id": "bc7ed439-6cd9-3a06-a867-3ff80e2e627e",
                        "target_lang_word": "think tank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "think tank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab3d15e5-f4f2-32b2-aeb4-2ed09c9e3ccc",
                                        "entry_id": "96e2318e-1d49-3e5c-82ce-d38531f3297e",
                                        "glosses": [
                                            "A group of people who collectively perform research and develop reports and recommendations on topics relating to strategic planning or public policy, and which is usually funded by corporate, government, or special interests."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0048d7-3b1b-4556-8311-cabf36fd8668",
                                                "sense_id": "ab3d15e5-f4f2-32b2-aeb4-2ed09c9e3ccc",
                                                "text": "Why don't we take a leaf out of the government's book and have a think tank?"
                                            },
                                            {
                                                "example_id": "9ccbb30f-4487-4ca5-8a8b-eb6ed6ea51c1",
                                                "sense_id": "ab3d15e5-f4f2-32b2-aeb4-2ed09c9e3ccc",
                                                "text": "As 1965 drew to a close a secret research project for the United States Department of Defense was concluded by a ‘think-tank’ of seven psychologists at the American Institute for Research, in the Maryland woods outside Washington, DC."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "600125e9-41fb-3778-8062-517de3242b05",
                                        "entry_id": "96e2318e-1d49-3e5c-82ce-d38531f3297e",
                                        "glosses": [
                                            "The brain."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8b5f91d-c1bf-4ae4-b54d-391cb94f9c6f",
                                                "sense_id": "600125e9-41fb-3778-8062-517de3242b05",
                                                "text": "Slade’s eyes, china blue and menacing, held hers for an instant, then he turned again to her father and completed his sentence, “or else I think I know a stunt that will speed up your work . . . something that will make your think-tank bubble a bit faster. And if it don’t, then you’ll learn something about Hoppy Slade that you didn’t know before. Go to bed and sleep on that!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8bf87d3-f32f-413b-b608-987dfadf8393",
                        "source_entry_id": "019348e8-9728-3f46-a1bd-affdcb4450be",
                        "source_sense_id": "bc7ed439-6cd9-3a06-a867-3ff80e2e627e",
                        "target_lang_word": "think-tank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "think-tank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b608d1c5-00da-3a4c-9077-61790214f602",
                                        "entry_id": "e226e90e-1e74-3f7c-8e39-f5d08e085499",
                                        "glosses": [
                                            "Alternative spelling of think tank."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "think-tank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcaa7482-7afe-3afb-acf8-3c967c995df3",
                                        "entry_id": "c55a5c9e-6a73-3682-a985-4c37d60dd6ab",
                                        "glosses": [
                                            "To perform research and develop recommendations as part of a think tank."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e298b0b5-e0e0-42e5-9cc8-85003700c9f1",
                                                "sense_id": "bcaa7482-7afe-3afb-acf8-3c967c995df3",
                                                "text": "The chairman had some quite remarkable hearings last year — I think you cited in your testimony Dr. Lange and others who came here and sort of think-tanked for us — and it was very interesting."
                                            },
                                            {
                                                "example_id": "c0d4a89d-76e2-4088-8f45-26e25d687733",
                                                "sense_id": "bcaa7482-7afe-3afb-acf8-3c967c995df3",
                                                "text": "In either event, depending on the nature of the business and the help needed, assistance through the entire procedure will be provided. Everything from devising a business plan to business expansion strategies are think-tanked."
                                            },
                                            {
                                                "example_id": "a4f7088f-dd84-4d66-9ec7-07547efc2d4c",
                                                "sense_id": "bcaa7482-7afe-3afb-acf8-3c967c995df3",
                                                "text": "Bill will change jobs to be closer, will move from D.C. to L.A., just after the riots, and will do his think-tanking there."
                                            },
                                            {
                                                "example_id": "a330f899-67ef-4cf5-90a0-5cb5fc5f2e56",
                                                "sense_id": "bcaa7482-7afe-3afb-acf8-3c967c995df3",
                                                "text": "And punishing the ones who were responsible for think-tanking, creating and unleashing this horrible monster, murdering biological warfare on the people, while being faithfully, willingly and ready to die in accomplishing their conquest against these evil-doers."
                                            },
                                            {
                                                "example_id": "c0a12705-02e6-4803-baf5-43920a0faac0",
                                                "sense_id": "bcaa7482-7afe-3afb-acf8-3c967c995df3",
                                                "text": "To Schroeder, the trip to FedEx's 2015 small-business summit, where she and fellow winners “think-tanked it out,” was invaluable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69eac01f-a142-4627-b471-62b3d2dacf74",
                        "source_entry_id": "019348e8-9728-3f46-a1bd-affdcb4450be",
                        "source_sense_id": "bc7ed439-6cd9-3a06-a867-3ff80e2e627e",
                        "target_lang_word": "thinktank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thinktank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ac99151-94ce-377e-9b70-f50879851f4d",
                                        "entry_id": "02249578-a08a-35b6-b24f-745e1bbd8393",
                                        "glosses": [
                                            "Alternative spelling of think tank."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dafb49c3-5014-40f8-b2a7-2283bd6e5702",
                                                "sense_id": "5ac99151-94ce-377e-9b70-f50879851f4d",
                                                "text": "The Resolution Foundation thinktank has suggested the LFS may have “lost” up to 930,000 workers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thinktank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df262067-0978-34f3-b04c-5f02d81078b9",
                                        "entry_id": "c974b0b4-86a9-33d4-b608-a28cc10f4fef",
                                        "glosses": [
                                            "Alternative form of think-tank."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7621d097-bedb-420f-99c4-6fb43a30793b",
                                                "sense_id": "df262067-0978-34f3-b04c-5f02d81078b9",
                                                "text": "Each state should devote some resources and some joint efforts to ' 'thinktanking' ' the implications of change in society as it affects education and the role of the state."
                                            },
                                            {
                                                "example_id": "05c21034-7c53-4178-9f98-e7c109dff95f",
                                                "sense_id": "df262067-0978-34f3-b04c-5f02d81078b9",
                                                "text": "SWELA may turn out to be an Intellectual Association where brainstorming and thinktanking are the rule of the day while mass implementation and task execution become the exception of the night."
                                            },
                                            {
                                                "example_id": "cfa5780c-b82b-4708-bbda-ee55f4c0c7bf",
                                                "sense_id": "df262067-0978-34f3-b04c-5f02d81078b9",
                                                "text": "Today marks the beginning of a wonderful innovationary experiment in education, a whole new instructional dynamic in teaching paleontology. I'll be thinktanking with you dinosaur guys and gals next week, but until then I want you to think about one word.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "002a9a73-4d56-481b-9ac3-68bd0e099e9d",
