{
    "word_family": [
        "bezoeken",
        "bezoeker",
        "bezoekster",
        "bezoekuur",
        "bezoekadres"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "53c3e19b-ca22-39a9-93e5-5ea10e30715f",
                    "sense_definition": "de handeling van het gaan naar een persoon of plaats om daar tijd door te brengen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "visite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga vanavond bij mijn oma op <w>bezoek</w> om haar te helpen.",
                            "target_lang_translations": {
                                "en": "I am going to <w>visit</w> my grandmother tonight to help her.",
                                "ru": "Сегодня вечером я иду к бабушке с <w>визитом</w>, чтобы помочь ей."
                            }
                        },
                        {
                            "text": "Zij gingen even een <w>bezoek</w> afleggen bij de nieuwe buren in de straat.",
                            "target_lang_translations": {
                                "en": "They went to pay a quick <w>visit</w> to the new neighbors in the street.",
                                "ru": "Они зашли нанести короткий <w>визит</w> новым соседям по улице."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op bezoek",
                        "bezoek afleggen",
                        "bezoek aan"
                    ],
                    "target_lang_definitions": {
                        "en": "the act of going to a person or place to spend time there",
                        "ru": "действие по посещению человека или места, чтобы провести там время"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visit",
                                "target_lang_sense_clarification": "the act of visiting"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "визит",
                                "target_lang_sense_clarification": "официальный или дружеский"
                            },
                            {
                                "target_lang_word": "посещение",
                                "target_lang_sense_clarification": "действие по глаголу посещать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd12f902-b32b-3837-bea9-67ab0b65847d",
                    "sense_definition": "de persoon of personen die bij iemand langsgaan of een evenement bijwonen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben <w>bezoek</w> vanavond, dus ik moet nog wat hapjes klaarmaken.",
                            "target_lang_translations": {
                                "en": "We have <w>company</w> tonight, so I still need to prepare some snacks.",
                                "ru": "У нас сегодня вечером <w>гости</w>, так что мне нужно приготовить еще закусок."
                            }
                        },
                        {
                            "text": "Ik kreeg zeer veel <w>bezoek</w> op mijn verjaardag van al mijn vrienden.",
                            "target_lang_translations": {
                                "en": "I had many <w>visitors</w> on my birthday from all my friends.",
                                "ru": "На мой день рождения пришло очень много <w>гостей</w>, все мои друзья."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bezoek krijgen",
                        "veel bezoek"
                    ],
                    "target_lang_definitions": {
                        "en": "the person or persons who visit someone or attend an event",
                        "ru": "человек или группа людей, которые приходят в гости или посещают мероприятие"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visitors",
                                "target_lang_sense_clarification": "people visiting"
                            },
                            {
                                "target_lang_word": "company",
                                "target_lang_sense_clarification": "guests in one's home"
                            },
                            {
                                "target_lang_word": "guests",
                                "target_lang_sense_clarification": "people invited"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "гости",
                                "target_lang_sense_clarification": "люди, пришедшие в дом"
                            },
                            {
                                "target_lang_word": "посетители",
                                "target_lang_sense_clarification": "люди на мероприятии или в заведении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9f4eb88-6e17-339a-afbd-733eb8ee0fcd",
                    "sense_definition": "een grondig <w>onderzoek</w> of inspectie naar een bepaalde zaak",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "onderzoek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een langdurig <w>bezoek</w> van de archieven vonden ze eindelijk de bewijzen.",
                            "target_lang_translations": {
                                "en": "After a lengthy <w>examination</w> of the archives, they finally found the evidence.",
                                "ru": "После длительного <w>изучения</w> архивов они наконец нашли доказательства."
                            }
                        },
                        {
                            "text": "Het wetenschappelijk <w>bezoek</w> aan de bronnen leverde nieuwe inzichten op.",
                            "target_lang_translations": {
                                "en": "The scientific <w>investigation</w> of the sources yielded new insights.",
                                "ru": "Научное <w>исследование</w> источников дало новые результаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderzoek"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "In de betekenis van onderzoek"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a thorough investigation or inspection of a particular matter",
                        "ru": "тщательное исследование или инспекция определенного дела"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "examination",
                                "target_lang_sense_clarification": "thorough study"
                            },
                            {
                                "target_lang_word": "investigation",
                                "target_lang_sense_clarification": "detailed research"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "исследование",
                                "target_lang_sense_clarification": "изучение архивов или источников"
                            },
                            {
                                "target_lang_word": "изучение",
                                "target_lang_sense_clarification": "детальный осмотр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e438f4e-6391-339c-98fe-a3df2b94707b",
                    "sense_definition": "een morele of spirituele <w>verzoeking</w> of beproeving",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verzoeking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten wordt de innerlijke strijd vaak beschreven als een zwaar <w>bezoek</w>.",
                            "target_lang_translations": {
                                "en": "In old texts, the inner struggle is often described as a heavy <w>visitation</w>.",
                                "ru": "В старинных текстах внутренняя борьба часто описывается как тяжелое <w>испытание</w>."
                            }
                        },
                        {
                            "text": "Hij kon de <w>bezoek</w> van het kwaad niet langer weerstaan.",
                            "target_lang_translations": {
                                "en": "He could no longer resist the <w>temptation</w> of evil.",
                                "ru": "Он больше не мог сопротивляться <w>искушению</w> зла."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzoeking"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "In de betekenis van verzoeking"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a moral or spiritual temptation or trial",
                        "ru": "моральное или духовное искушение или испытание"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visitation",
                                "target_lang_sense_clarification": "divine trial or affliction"
                            },
                            {
                                "target_lang_word": "temptation",
                                "target_lang_sense_clarification": "moral trial"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "искушение",
                                "target_lang_sense_clarification": "соблазн или испытание духа"
                            },
                            {
                                "target_lang_word": "испытание",
                                "target_lang_sense_clarification": "духовная проверка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22a69e17-8f35-3653-8990-3466b8807626",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>bezoeken</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bezoek</w> elke zondag mijn grootouders in het dorp.",
                            "target_lang_translations": {
                                "en": "I <w>visit</w> my grandparents in the village every Sunday.",
                                "ru": "Я <w>навещаю</w> своих дедушку и бабушку в деревне каждое воскресенье."
                            }
                        },
                        {
                            "text": "Ik <w>bezoek</w> de website regelmatig om het laatste nieuws te lezen.",
                            "target_lang_translations": {
                                "en": "I <w>visit</w> the website regularly to read the latest news.",
                                "ru": "Я регулярно <w>посещаю</w> этот сайт, чтобы читать последние новости."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "ik-vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'to visit'",
                        "ru": "форма первого лица единственного числа настоящего времени глагола 'посещать'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visit",
                                "target_lang_sense_clarification": "I visit"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "посещаю",
                                "target_lang_sense_clarification": "я посещаю"
                            },
                            {
                                "target_lang_word": "навещаю",
                                "target_lang_sense_clarification": "я навещаю кого-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad1eb6dd-0a37-38bb-be4e-a1471ca49efa",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>bezoeken</w> (in inversie)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bezoek</w> je dit jaar ook weer dat leuke festival in Utrecht?",
                            "target_lang_translations": {
                                "en": "Are you <w>visiting</w> that nice festival in Utrecht again this year?",
                                "ru": "Ты <w>посещаешь</w> в этом году тот классный фестиваль в Утрехте снова?"
                            }
                        },
                        {
                            "text": "Waarom <w>bezoek</w> je die oude vriend niet eens een keertje?",
                            "target_lang_translations": {
                                "en": "Why don't you <w>visit</w> that old friend sometime?",
                                "ru": "Почему бы тебе не <w>навестить</w> того старого друга как-нибудь?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "jij-vorm bij inversie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second person singular present tense of 'to visit' (in inversion)",
                        "ru": "форма второго лица единственного числа настоящего времени глагола 'посещать' (в инверсии)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visit",
                                "target_lang_sense_clarification": "do you visit"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "посещаешь",
                                "target_lang_sense_clarification": "ты посещаешь (в вопросе)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce1f1094-1297-3816-a1cf-a4c97575c5b3",
                    "sense_definition": "gebiedende wijs van <w>bezoeken</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bezoek</w> onze winkel voor de beste aanbiedingen van deze week!",
                            "target_lang_translations": {
                                "en": "<w>Visit</w> our store for this week's best offers!",
                                "ru": "<w>Посетите</w> наш магазин, чтобы увидеть лучшие предложения этой недели!"
                            }
                        },
                        {
                            "text": "<w>Bezoek</w> de website voor meer informatie over dit onderwerp.",
                            "target_lang_translations": {
                                "en": "<w>Visit</w> the website for more information on this topic.",
                                "ru": "<w>Зайдите</w> на сайт для получения дополнительной информации по этой теме."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative mood of 'to visit'",
                        "ru": "повелительное наклонение глагола 'посещать'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visit",
                                "target_lang_sense_clarification": "command to visit"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "посетите",
                                "target_lang_sense_clarification": "призыв к действию"
                            },
                            {
                                "target_lang_word": "зайдите",
                                "target_lang_sense_clarification": "призыв зайти куда-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
