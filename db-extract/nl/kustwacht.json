                        "sense_id": "87eabe19-f24e-3b5e-bd9d-edd218cdf405",
                        "entry_id": "027841bb-8319-3cc3-947d-db0272726fe4",
                        "glosses": [
                            "een staatsorgaan dat de beveiliging van de kustwateren tot taak heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6085fb1-884f-404f-b372-cb4345964520",
                                "sense_id": "87eabe19-f24e-3b5e-bd9d-edd218cdf405",
                                "text": "De kustwachten van een aantal eilanden in het Caraïbische gebied werken nauw samen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e26dcbb-f6c7-43d5-b3fb-97213206fd64",
                        "source_entry_id": "027841bb-8319-3cc3-947d-db0272726fe4",
                        "source_sense_id": "87eabe19-f24e-3b5e-bd9d-edd218cdf405",
                        "target_lang_word": "Küstenwache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Küstenwache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d25827c-a144-32a3-ae6b-e19495ee2cf8",
                                        "entry_id": "459f50de-c07d-3a8b-a07e-1446e409ee69",
                                        "glosses": [
                                            "staatliche Behörde, die die öffentliche Sicherheit und Ordnung auf dem Meer sicherstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7f8256d-5dc7-4790-b54c-131b48c2d0a0",
                                                "sense_id": "6d25827c-a144-32a3-ae6b-e19495ee2cf8",
                                                "text": "Die deutsche Küstenwache ist ein Zusammenschluss mehrerer Behörden."
                                            },
                                            {
                                                "example_id": "61289fa0-ab08-4d3d-9764-331b12f9e6b8",
                                                "sense_id": "6d25827c-a144-32a3-ae6b-e19495ee2cf8",
                                                "text": "„In Schleswig-Holstein bestand von 1995 bis zur Auflösung Ende 2005 eine eigene Küstenwache als Verbund von Wasserschutzpolizei, dem Amt für ländliche Räume (ALR) und dem Landesamt für Natur und Umwelt.“"
                                            },
                                            {
                                                "example_id": "20ab464c-2083-4322-8fde-33791a1f8acf",
                                                "sense_id": "6d25827c-a144-32a3-ae6b-e19495ee2cf8",
                                                "text": "„Bei einem Fährunglück in Japan sind am Samstag mindestens 87 Menschen verletzt worden. Wie die japanische Küstenwache mitteilte, war das Tragflächenboot auf dem Weg von der Hauptinsel Honshu zur Insel Sado.“"
                                            },
                                            {
                                                "example_id": "334f3407-33bf-4cbd-9afa-91f595d151b6",
                                                "sense_id": "6d25827c-a144-32a3-ae6b-e19495ee2cf8",
                                                "text": "„Gerne hätte ich mich von Extrembergsteigern der Küstenwache retten lassen, aber dann musste ich mit ansehen, wie ein greises Pärchen an uns vorüber zu Tal schritt, rüstig und flott, mit Kraxelstöcken und völlig schwindelfrei.“"
                                            },
                                            {
                                                "example_id": "f099570a-05bd-4095-a8f0-65802c7aa93a",
                                                "sense_id": "6d25827c-a144-32a3-ae6b-e19495ee2cf8",
                                                "text": "„Sie fuhren noch in die Rhonemündung hinein, da wurden sie von der Küstenwache beschossen und bei der Landung gestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
