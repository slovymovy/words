                                    {
                                        "sense_id": "8e879834-123c-3d2e-a559-d083e31a7b85",
                                        "entry_id": "2ce0d463-485e-3bb4-9fe2-25620d0523ea",
                                        "glosses": [
                                            "To make a sound from the vocal cords without pronouncing any real words, with one's lips closed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d9f8bd-1d8f-411f-886e-fe9a40c5badb",
                                                "sense_id": "8e879834-123c-3d2e-a559-d083e31a7b85",
                                                "text": "We are humming happily along with the music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6afee487-c4da-374a-aeba-69c2e4e56d0e",
                                        "entry_id": "2ce0d463-485e-3bb4-9fe2-25620d0523ea",
                                        "glosses": [
                                            "To express by humming."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef157e4-5d89-4467-aa16-6ff9df3e90d2",
                                                "sense_id": "6afee487-c4da-374a-aeba-69c2e4e56d0e",
                                                "text": "to hum a tune"
                                            },
                                            {
                                                "example_id": "a8018adc-9b24-4d0a-9e01-e473aba9d7c8",
                                                "sense_id": "6afee487-c4da-374a-aeba-69c2e4e56d0e",
                                                "text": "The team hummed “We Shall Overcome” as they came back onto the field after the break."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c8032be-8eb2-389b-a573-8dde8b0263e9",
                                        "entry_id": "2ce0d463-485e-3bb4-9fe2-25620d0523ea",
                                        "glosses": [
                                            "To drone like certain insects naturally do in motion, or sounding similarly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d43c73fe-3487-46c1-bdaf-c86e4c1a4bd9",
                                                "sense_id": "9c8032be-8eb2-389b-a573-8dde8b0263e9",
                                                "text": "The leaves of the foreſt were loaded with manna, pure amber dropped from every bough, honey diſtilled from the rifted rock, and the humming bee, drunk with joy, ſtrayed from flower to flower, forgetful of his burſting cells."
                                            },
                                            {
                                                "example_id": "dad4e351-1738-420c-b834-c7f3857b6e34",
                                                "sense_id": "9c8032be-8eb2-389b-a573-8dde8b0263e9",
                                                "text": "A slight gloom fell upon the table. Jacob was helping himself to jam; the postman was talking to Rebecca in the kitchen; there was a bee humming at the yellow flower which nodded at the open window."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0929c449-7433-3ffd-ba33-0f571a68f9c6",
                                        "entry_id": "2ce0d463-485e-3bb4-9fe2-25620d0523ea",
                                        "glosses": [
                                            "To buzz, be busily active like a beehive"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "726b1d0e-a815-44f6-83c7-3187de309d1c",
                                                "sense_id": "0929c449-7433-3ffd-ba33-0f571a68f9c6",
                                                "text": "The streets were humming with activity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19223f75-1949-3b8f-96f0-9990c1a8b1e4",
                                        "entry_id": "2ce0d463-485e-3bb4-9fe2-25620d0523ea",
                                        "glosses": [
                                            "To produce low sounds which blend continuously"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2054e362-ebea-3ee1-a6da-c5ec0ba96e33",
                                        "entry_id": "2ce0d463-485e-3bb4-9fe2-25620d0523ea",
                                        "glosses": [
                                            "To reek, smell bad."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "021ea4ba-ba77-4891-ae67-cdfd7cb81046",
                                                "sense_id": "2054e362-ebea-3ee1-a6da-c5ec0ba96e33",
                                                "text": "This room really hums — have you ever tried spring cleaning, mate?"
                                            }
                                        ]
                                    },
