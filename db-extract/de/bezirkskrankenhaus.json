                "senses": [
                    {
                        "sense_id": "dc15d716-7d6b-335d-a073-6360921bfd42",
                        "entry_id": "3b312751-e13b-382c-848a-394e5eadfe0b",
                        "glosses": [
                            "Allgemeinklinik, deren Träger die Gemeinden eines politischen Bezirks sind"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "18e8e103-3c5b-4032-94b3-504d11ec267c",
                                "sense_id": "dc15d716-7d6b-335d-a073-6360921bfd42",
                                "text": "„Den Gemeindeverbänden nach Abs. 1 obliegen ferner die allfällige Errichtung oder Erweiterung, die Erhaltung und der Betrieb von Anlagen und Einrichtungen, die mit dem jeweiligen Bezirkskrankenhaus im Zusammenhang stehen.“"
                            },
                            {
                                "example_id": "2ff89900-8cb9-4c6f-9505-0b11ef940fd1",
                                "sense_id": "dc15d716-7d6b-335d-a073-6360921bfd42",
                                "text": "„Das erste österreichische Spital wurde im April 2011 zum singenden Krankenhaus zertifiziert: Im Bezirkskrankenhaus Lienz wird zweimal im Monat zum heilsamen Singen geladen – mit dabei die Psychotherapeutin und Ärztin Gertraud Glantschnig und ihr Mann Wilfried, noch vor Kurzem Leiter der urologischen Abteilung, heute zertifizierter Singleiter.“"
                            },
                            {
                                "example_id": "db0c4c5f-a6fe-4f28-8024-3d8a3d66374d",
                                "sense_id": "dc15d716-7d6b-335d-a073-6360921bfd42",
                                "text": "„Die Außerferner Eltern haben sich mittlerweile damit abgefunden, dass es im ganzen Bezirk keinen niedergelassenen Kinderarzt gibt und gehen deshalb auch für eine Schutzimpfung oder eine Routineuntersuchung ins Bezirkskrankenhaus Reutte.“"
                            },
                            {
                                "example_id": "a400ed32-56b4-466d-b157-1d06261078b4",
                                "sense_id": "dc15d716-7d6b-335d-a073-6360921bfd42",
                                "text": "„Patienten können jetzt im Bezirkskrankenhaus St. Johann in den Fächern Anästhesie und Intensivmedizin, Innere Medizin, Unfallchirurgie, Gynäkologie und Geburtshilfe sowie Chirurgie rund um die Uhr versorgt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fb8907a9-7be0-358d-a91c-6b8ad457e46f",
                        "entry_id": "3b312751-e13b-382c-848a-394e5eadfe0b",
                        "glosses": [
                            "psychiatrische Klinik"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "26e3f60a-8d12-4842-86b0-e3c4434fb325",
                                "sense_id": "fb8907a9-7be0-358d-a91c-6b8ad457e46f",
                                "text": "„An heißen Tagen wie diesen ist die Luft hinter den Mauern des Bezirkskrankenhauses Straubing schwül und der Blick aus den vergitterten Fenstern der ThUG-Abteilung nicht minder trist als sonst.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e1cb998a-4e55-3108-af5c-4a86c4b68307",
                        "entry_id": "3b312751-e13b-382c-848a-394e5eadfe0b",
                        "glosses": [
                            "zentrales Krankenhaus eines DDR-Bezirkes, meist in der Bezirksstadt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1d6c6171-05cf-4b13-aeee-03ecfdb3ce94",
                                "sense_id": "e1cb998a-4e55-3108-af5c-4a86c4b68307",
                                "text": "Das Bezirkskrankenhaus in Neubrandenburg befand sich in der Oststadt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
