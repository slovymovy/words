{
    "word_family": [
        "evaporation",
        "evaporative",
        "evaporator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae3c0fba-4a47-3019-8874-bf68799c7870",
                    "sense_definition": "To change from a liquid into a gas or vapor.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heat causes the water to <w>evaporate</w> quickly into the air. ",
                            "target_lang_translations": {
                                "tr": "Isı, suyun havaya hızla <w>buharlaşmasına</w> neden olur."
                            }
                        },
                        {
                            "text": "If you leave the bottle open, the water inside will <w>evaporate</w> completely.",
                            "target_lang_translations": {
                                "tr": "Şişeyi açık bırakırsanız, içindeki su tamamen <w>buharlaşacaktır</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaporize"
                    ],
                    "antonyms": [
                        "condense"
                    ],
                    "common_phrases": [
                        "evaporate quickly",
                        "evaporate into thin air"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sıvı halden gaz veya buhar haline geçmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "buharlaşmak",
                                "target_lang_sense_clarification": "sıvının gaz haline dönüşmesi"
                            },
                            {
                                "target_lang_word": "uçmak",
                                "target_lang_sense_clarification": "sıvıların zamanla buharlaşarak yok olması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c7a44d6-74cd-3d2e-b502-83656b71e9f6",
                    "sense_definition": "To fade away, vanish, or disappear entirely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disappear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her hopes began to <w>evaporate</w> after she received the rejection letter. ",
                            "target_lang_translations": {
                                "tr": "Reddedilme mektubunu aldıktan sonra umutları <w>tükenmeye</w> başladı."
                            }
                        },
                        {
                            "text": "All my worries seemed to <w>evaporate</w> into thin air once I landed the job.",
                            "target_lang_translations": {
                                "tr": "İşi kaptığımda tüm endişelerim adeta yok olup <w>uçtu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vanish",
                        "disappear",
                        "dissipate"
                    ],
                    "antonyms": [
                        "appear",
                        "materialize"
                    ],
                    "common_phrases": [
                        "evaporate into thin air",
                        "fears evaporate"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yavaşça yok olmak, ortadan kaybolmak, tükenmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yok olmak",
                                "target_lang_sense_clarification": "tamamen ortadan kaybolmak"
                            },
                            {
                                "target_lang_word": "uçup gitmek",
                                "target_lang_sense_clarification": "duygu veya umutların yok olması"
                            },
                            {
                                "target_lang_word": "erimek",
                                "target_lang_sense_clarification": "soyut şeylerin azalması veya bitmesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a461775-3777-376f-b070-4ddebdff3e2d",
                    "sense_definition": "To remove water or moisture from something, usually through heat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Factories <w>evaporate</w> milk to produce condensed milk for long storage.",
                            "target_lang_translations": {
                                "tr": "Fabrikalar, uzun süreli saklama amacıyla koyulaştırılmış süt üretmek için sütü <w>buharlaştırır</w>."
                            }
                        },
                        {
                            "text": "The chef decided to <w>evaporate</w> the sauce to make it thicker and richer.",
                            "target_lang_translations": {
                                "tr": "Şef, sosu daha koyu ve zengin kılmak için suyunu <w>çektirmeye</w> karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "dehydrate",
                        "dry"
                    ],
                    "antonyms": [
                        "hydrate",
                        "moisten"
                    ],
                    "common_phrases": [
                        "evaporate milk"
                    ],
                    "target_lang_definitions": {
                        "tr": "Isı yoluyla bir şeyin içindeki suyu veya nemi çekmek, buharlaştırmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "buharlaştırmak",
                                "target_lang_sense_clarification": "bir sıvının suyunu uçurmak"
                            },
                            {
                                "target_lang_word": "koyulaştırmak",
                                "target_lang_sense_clarification": "suyunu çektirerek kıvam vermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "402daa2f-41e9-32de-8027-29ac1df92eb5",
                    "sense_definition": "To cause something to fade away, disappear, or be destroyed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disappear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new tax policy could <w>evaporate</w> all the company's annual profits.",
                            "target_lang_translations": {
                                "tr": "Yeni vergi politikası şirketin tüm yıllık kârını <w>yok edebilir</w>."
                            }
                        },
                        {
                            "text": "Mismanagement threatens to <w>evaporate</w> years of hard work by the team.",
                            "target_lang_translations": {
                                "tr": "Kötü yönetim, ekibin yıllar süren emeğini <w>eritmekle</w> tehdit ediyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "destroy",
                        "wipe out"
                    ],
                    "antonyms": [
                        "create",
                        "build"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin yok olmasına, erimesine veya mahvolmasına neden olmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yok etmek",
                                "target_lang_sense_clarification": "ortadan kaldırmak"
                            },
                            {
                                "target_lang_word": "eritmek",
                                "target_lang_sense_clarification": "varlıkları veya kârı silip süpürmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1892b3fc-d9b6-33ca-9cf7-68ff2ded6072",
                    "sense_definition": "To express, vent, or release emotions or thoughts so they dissipate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wrote poems to <w>evaporate</w> his pent-up anger and sorrow.",
                            "target_lang_translations": {
                                "tr": "İçinde biriken öfke ve kederi <w>dağıtmak</w> için şiirler yazdı."
                            }
                        },
                        {
                            "text": "She allowed her sadness to <w>evaporate</w> through long talks with friends.",
                            "target_lang_translations": {
                                "tr": "Arkadaşlarıyla uzun sohbetler ederek üzüntüsünün <w>uçup gitmesine</w> izin verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "vent",
                        "dissipate"
                    ],
                    "antonyms": [
                        "suppress",
                        "repress"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to mean expressing feelings"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Duygu veya düşünceleri dışa vurarak yok olmasını sağlamak, rahatlamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dağıtmak",
                                "target_lang_sense_clarification": "olumsuz duyguları yok etmek"
                            },
                            {
                                "target_lang_word": "dışa vurmak",
                                "target_lang_sense_clarification": "duyguları dışarı aktararak ferahlamak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec779eb5-0949-32bb-b4db-29c0c578c6a6",
                    "sense_definition": "Having been converted into vapor; <w>evaporated</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist measured the <w>evaporate</w> residues left in the tube.",
                            "target_lang_translations": {
                                "tr": "Bilim insanı, tüpte kalan <w>buharlaşmış</w> kalıntıları ölçtü."
                            }
                        },
                        {
                            "text": "The liquid state became <w>evaporate</w> under extreme heating conditions.",
                            "target_lang_translations": {
                                "tr": "Sıvı hal, aşırı ısınma koşulları altında <w>buharlaşmış</w> hale geldi."
                            }
                        }
                    ],
                    "synonyms": [
                        "evaporated"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Adjectival form meaning evaporated"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Buhar haline gelmiş, buharlaşmış."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "buharlaşmış",
                                "target_lang_sense_clarification": "gaz haline geçmiş"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}