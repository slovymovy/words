                                "example_id": "92e3de72-f269-46f0-bce6-adfdc6b81f16",
                                "sense_id": "4256f0bd-00a9-3742-8faa-fdf484e24a2e",
                                "text": "Twee treinen, een goederentrein van railtransportbedrijf DB Cargo en een dubbeldekker van NS kwamen in botsing met een zogeheten krol, een kraan op wielen die wordt gebruikt bij werkzaamheden aan het spoor."
                            },
                            {
                                "example_id": "0efa9f6d-4e8a-44c9-97b1-af955a1868e8",
                                "sense_id": "4256f0bd-00a9-3742-8faa-fdf484e24a2e",
                                "text": "Vlak voor het perron van Voorschoten botst de trein op een groengele ‘krol’, jargon voor ‘kraan op lorries’, van BAM."
                            }
                        ]
                    }
