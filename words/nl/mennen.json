    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c45e8467-cf59-38b4-a9de-1bc89be95923",
                    "sense_definition": "trek- of rijdieren besturen door middel van leidsels of teugels",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rijdieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ervaren koetsier kon de twee onrustige paarden met één hand <w>mennen</w>.",
                            "target_lang_translations": {
                                "en": "The experienced coachman was able to <w>drive</w> the two restless horses with one hand."
                            }
                        },
                        {
                            "text": "Tijdens de optocht <w>mende</w> hij de paarden rustig door de smalle straten.",
                            "target_lang_translations": {
                                "en": "During the parade, he calmly <w>guided</w> the horses through the narrow streets."
                            }
                        }
                    ],
                    "synonyms": [
                        "sturen",
                        "besturen"
                    ],
                    "common_phrases": [
                        "paarden mennen"
                    ],
                    "target_lang_definitions": {
                        "en": "to guide or control draft or riding animals using reins"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drive",
                                "target_lang_sense_clarification": "horses or draft animals"
                            },
                            {
                                "target_lang_word": "to rein",
                                "target_lang_sense_clarification": "control with reins"
                            },
                            {
                                "target_lang_word": "to guide",
                                "target_lang_sense_clarification": "horses"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "408c8664-de9a-3531-9ea8-865e18414b24",
                    "sense_definition": "een door dieren getrokken voertuig besturen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rijdieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij leerde al op jonge leeftijd hoe hij een houten wagen moest <w>mennen</w>.",
                            "target_lang_translations": {
                                "en": "He learned at a young age how to <w>drive</w> a wooden cart."
                            }
                        },
                        {
                            "text": "De boer <w>mende</w> zijn ploeg langzaam over de uitgestrekte akker.",
                            "target_lang_translations": {
                                "en": "The farmer slowly <w>drove</w> his plow across the vast field."
                            }
                        }
                    ],
                    "synonyms": [
                        "rijden"
                    ],
                    "common_phrases": [
                        "een wagen mennen"
                    ],
                    "target_lang_definitions": {
                        "en": "to steer or operate an animal-drawn vehicle"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drive",
                                "target_lang_sense_clarification": "a carriage, cart, or plow"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "904e9bf9-ef83-3bd8-9bd9-6cae7199cf8c",
                    "sense_definition": "mensen, situaties of organisaties sturen en beheersen",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "leiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ervaren politicus wist de verdeelde partijleden vakkundig te <w>mennen</w>.",
                            "target_lang_translations": {
                                "en": "The experienced politician skillfully managed to <w>rein in</w> the divided party members."
                            }
                        },
                        {
                            "text": "Achter de schermen <w>mende</w> de directeur het hele onderhandelingsproces naar zijn hand.",
                            "target_lang_translations": {
                                "en": "Behind the scenes, the director <w>steered</w> the entire negotiation process to his advantage."
                            }
                        }
                    ],
                    "synonyms": [
                        "leiden",
                        "sturen",
                        "beheersen"
                    ],
                    "target_lang_definitions": {
                        "en": "to manage, control, or steer people, situations, or organizations"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to steer",
                                "target_lang_sense_clarification": "direct people or processes"
                            },
                            {
                                "target_lang_word": "to manage",
                                "target_lang_sense_clarification": "control a situation or group"
                            },
                            {
                                "target_lang_word": "to rein in",
                                "target_lang_sense_clarification": "control or guide people firmly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}