                        "entry_id": "c6979b63-f788-3aee-940e-a955c563a08f",
                        "glosses": [
                            "To make a duke."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d0a3ab98-49f5-4e45-b458-4372071799cf",
                                "sense_id": "3150083f-1b9d-3279-870c-a645927a0d6a",
                                "text": "I could name (reverently) a dozen illustrious men abundantly dowered with intellectual poverty, anyone of whom could beduke and enrich the obscurest ignobleman in the fierce democracy of letters by merely blaring abroad the praise of his books."
                            }
                        ]
                    },
                    {
