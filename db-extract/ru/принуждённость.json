                "translations": [
                    {
                        "translation_id": "3ea86816-55fa-4050-a225-2eb706d4a985",
                        "source_entry_id": "e48f0490-9998-3027-8b52-32a8ec26824c",
                        "source_sense_id": "6165ca33-6eab-37d9-88f6-461651351ef1",
                        "target_lang_word": "contrainte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrainte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6f1d617-f70e-3c6d-bb34-5cd7d69cc58f",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Violence qu’on exerce contre quelqu’un, pour l’obliger à faire quelque chose malgré lui ou pour l’empêcher de faire ce qu’il voudrait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "857291cf-2807-44e4-bba5-aa714ddb7619",
                                                "sense_id": "d6f1d617-f70e-3c6d-bb34-5cd7d69cc58f",
                                                "text": "Tant que l’homme est comprimé, tant que la contrainte des iniquités sociales le maintient prostré, l’on est en droit d’espérer beaucoup de l’inéclos qu’il porte en lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e10d7e9-ff73-3624-8460-c7d202a3d486",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "État de celui à qui on fait cette violence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bae28de1-3e07-41c1-b4d1-f9eecbcdbbc2",
                                                "sense_id": "1e10d7e9-ff73-3624-8460-c7d202a3d486",
                                                "text": "La pénible contrainte où il est. Vivre dans la contrainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4648d45-9647-3669-97df-f7443f33097a",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Retenue que le respect, la considération, ou quelque autre cause, obligent d’avoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f92f8bf6-14ea-46c4-bb15-c2a4093ee4e5",
                                                "sense_id": "e4648d45-9647-3669-97df-f7443f33097a",
                                                "text": "La contrainte qu’imposent les bienséances. C’est une grande contrainte que d’être obligé de se taire en de certaines occasions."
                                            },
                                            {
                                                "example_id": "7d8a0f77-c9cb-4b67-ab61-bf3ef305b22e",
                                                "sense_id": "e4648d45-9647-3669-97df-f7443f33097a",
                                                "text": "La contrainte de la mesure, de la rime, La gêne, la discipline qu’imposent quelquefois aux poètes les règles de la mesure et les difficultés de la rime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9758a18e-06f7-3b87-9ae4-083df0f51373",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Tout acte par lequel on force quelqu’un à faire ou à donner une chose."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e2e9239-044f-3b2e-9dde-3dfbd4008762",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Mandement, exécutoire décerné par l’administration du fisc contre son débiteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2797f336-7d45-4e68-b10a-39c894e281ae",
                                                "sense_id": "5e2e9239-044f-3b2e-9dde-3dfbd4008762",
                                                "text": "Porteur de contraintes. Décerner une contrainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08627d2a-35fc-3859-ba98-886898b074de",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Condition à satisfaire."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "176cc161-0b7d-49eb-9897-8ee2c71baaf7",
                                                "sense_id": "08627d2a-35fc-3859-ba98-886898b074de",
                                                "text": "Pourtant, se lancer dans le halal ressemble à un chemin de croix… Les contraintes de production ne sont pas insurmontables, mais l’industriel doit se plonger dans le maquis d’un système de certification bien éloigné de celui des labels classiques […]."
                                            },
                                            {
                                                "example_id": "21e5947f-1876-48d8-a628-8198961b567f",
                                                "sense_id": "08627d2a-35fc-3859-ba98-886898b074de",
                                                "text": "Avec la vogue du récréotourisme, la population locale prend conscience des autres potentialités du lac et des contraintes imposées par le mode d'exploitation industrielle de cette ressource naturelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c352d26-1834-3ac5-bb11-8ba54b97bfb9",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Résultat des efforts internes qui naissent dans un objet lorsqu’on le déforme : contrainte mécanique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "796c966a-a719-4fe8-afe5-9f42788cb1c6",
                                                "sense_id": "7c352d26-1834-3ac5-bb11-8ba54b97bfb9",
                                                "text": "L'étude des contraintes appliquées aux matériaux est aussi très utile dans le domaine des infrastructures, pour étudier la résistance d’un pont ou mettre au point des bâtiments antisismiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f4adcf4-5942-3baa-9e03-37278fcdf019",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Règle de gestion qui réduit la liberté d'action sur une table ou un champ de la base de donnée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "950f769a-2d94-35cd-8971-2f332d663436",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Équation ou inéquation qui restreint le domaine où on cherche à optimiser la fonction objectif."
                                        ],
                                        "tags": [
                                            "Optimisation"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b06fd22e-60d0-3c4a-8a72-0195594c28d2",
                                        "entry_id": "0fc84cee-9cab-3d87-a69e-2312da264c99",
                                        "glosses": [
                                            "Contrainte volontaire pour la créativité. À relever tel un défi ou pour lutter contre la page blanche. l'OuLiPo parle de contrainte libératoire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "contrainte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d4d4e9-8c48-32a5-b82e-6ba676d659f1",
                                        "entry_id": "36fdc906-e06b-3405-96e8-a2b31548d758",
                                        "glosses": [
                                            "Féminin singulier de contraint."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "371c747c-e000-46bd-b7aa-d83e5dc04144",
                                                "sense_id": "d2d4d4e9-8c48-32a5-b82e-6ba676d659f1",
                                                "text": "Une seule usine, employant une vingtaine d’ouvriers, existe à Vatan et la main-d’œuvre masculine, hormis celle du bâtiment, se voit contrainte d’aller travailler dans les villes voisines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contrainte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d80ba97d-9585-31c7-b3d3-07a77c498af9",
                                        "entry_id": "311d4d22-8f41-3d73-9ba0-3c31d1244de6",
                                        "glosses": [
                                            "Participe passé féminin singulier de contraindre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b2f19aa-7d03-4aed-af91-84664f03ca41",
                                                "sense_id": "d80ba97d-9585-31c7-b3d3-07a77c498af9",
                                                "text": "Si on mélange tous les produits, on crée un liquide marabouté qui va permettre de débouffoniser cet objet, que je serai malheureusement ensuite contrainte de jeter dans le Lez."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60d57147-552b-40b2-a023-c517c3ae3fa2",
                        "source_entry_id": "e48f0490-9998-3027-8b52-32a8ec26824c",
                        "source_sense_id": "6165ca33-6eab-37d9-88f6-461651351ef1",
                        "target_lang_word": "gêne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gêne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8042a11e-1d8a-3e5a-b226-6315320745b0",
                                        "entry_id": "43d29938-aeaa-3c0d-be2b-689c053ee0a4",
                                        "glosses": [
                                            "Ce qui met à l’étroit, mal à l’aise, ce qui empêche d’agir librement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5969b7c-c779-4b5e-911b-2ba79cfd0e96",
                                                "sense_id": "8042a11e-1d8a-3e5a-b226-6315320745b0",
                                                "text": "Cette femme est à la gêne dans son corset."
                                            },
                                            {
                                                "example_id": "3412e81d-9a0e-4985-b446-56f0cc3c34aa",
                                                "sense_id": "8042a11e-1d8a-3e5a-b226-6315320745b0",
                                                "text": "Ce malade éprouve une sensation de gêne à l’estomac."
                                            },
                                            {
                                                "example_id": "19745fa8-bf96-4468-af8e-6b1ca0214572",
                                                "sense_id": "8042a11e-1d8a-3e5a-b226-6315320745b0",
                                                "text": "Il a un peu de gêne dans la respiration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8e05072-dd58-3fe8-8ab3-97bcf62e006e",
                                        "entry_id": "43d29938-aeaa-3c0d-be2b-689c053ee0a4",
                                        "glosses": [
                                            "Embarras que cause le séjour d’une personne chez une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cfd609c-4197-49e8-ad94-4004500159cd",
                                                "sense_id": "a8e05072-dd58-3fe8-8ab3-97bcf62e006e",
                                                "text": "Restez chez moi il y aura place pour tout le monde, et vous ne me causerez aucune gêne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a307427a-b866-342d-b68e-29d6274399dd",
                                        "entry_id": "43d29938-aeaa-3c0d-be2b-689c053ee0a4",
                                        "glosses": [
                                            "Contrainte fâcheuse, état pénible où l’on se trouve."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f6dc900-11da-450c-b988-cba6f93506e9",
                                                "sense_id": "a307427a-b866-342d-b68e-29d6274399dd",
                                                "text": "Chacun tenant à rester sur la défensive, le silence se prolongeait quand le Carcan, pour rompre cette gêne, trouva un moyen terme et entama l’éloge du vin qui restait dans son verre."
                                            },
                                            {
                                                "example_id": "d10e2ed5-f968-45dc-8602-f9f09887842d",
                                                "sense_id": "a307427a-b866-342d-b68e-29d6274399dd",
                                                "text": "J’éprouve toujours un peu de gêne en sa présence."
                                            },
                                            {
                                                "example_id": "b13a72e6-33f8-42b5-9c9f-e562d1390b05",
                                                "sense_id": "a307427a-b866-342d-b68e-29d6274399dd",
                                                "text": "Les visites de certaines personnes mettent à la gêne."
                                            },
                                            {
                                                "example_id": "b6c97055-88c0-48ba-bcd1-36781795e06e",
                                                "sense_id": "a307427a-b866-342d-b68e-29d6274399dd",
                                                "text": "C’est une gêne cruelle de ne pouvoir dire ce qu’on pense."
                                            },
                                            {
                                                "example_id": "c18c35e2-6e27-43a2-b3f8-fd1781732b8d",
                                                "sense_id": "a307427a-b866-342d-b68e-29d6274399dd",
                                                "text": "L’obscurité de ce style met l’esprit du lecteur à la gêne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aba4e29-c72e-3a60-b97d-13a744a47c56",
                                        "entry_id": "43d29938-aeaa-3c0d-be2b-689c053ee0a4",
                                        "glosses": [
                                            "Sentiment de pénibilité, d’embarras ou de honte à l’idée d’être une charge ou un obstacle pour autrui."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6469d16-8777-487b-9768-94f8ec8c7299",
                                                "sense_id": "4aba4e29-c72e-3a60-b97d-13a744a47c56",
                                                "text": "Être sans gêne, se dit des personnes qui prennent leurs aises, sans s’inquiéter de l’embarras ou du déplaisir qu’elles peuvent causer."
                                            },
                                            {
                                                "example_id": "7c65db16-5dd4-49d5-95c1-95fcb5d9513c",
                                                "sense_id": "4aba4e29-c72e-3a60-b97d-13a744a47c56",
                                                "text": "Cet homme est tout à fait sans gêne. On dit dans un sens analogue"
                                            },
                                            {
                                                "example_id": "9603402f-bbe7-4e08-b446-28b5a996e808",
                                                "sense_id": "4aba4e29-c72e-3a60-b97d-13a744a47c56",
                                                "text": "C’est un monsieur sans gêne, et, dans le langage populaire,"
                                            },
                                            {
                                                "example_id": "c67d35f2-d08d-4aa9-b4fa-9ba047a9ce87",
                                                "sense_id": "4aba4e29-c72e-3a60-b97d-13a744a47c56",
                                                "text": "C’est un sans gêne."
                                            },
                                            {
                                                "example_id": "6fa7080c-c2c9-4af2-9283-d520b7ce68ca",
                                                "sense_id": "4aba4e29-c72e-3a60-b97d-13a744a47c56",
                                                "text": "Se mettre l’esprit à la gêne pour quelque chose S’inquiéter, se tourmenter, faire de grands efforts d’esprit."
                                            },
                                            {
                                                "example_id": "02af77fb-b543-469c-ac59-03fd451516a1",
                                                "sense_id": "4aba4e29-c72e-3a60-b97d-13a744a47c56",
                                                "text": "Il s’est mis l’esprit à la gêne pour trouver cette démonstration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14a57717-f4d9-35dd-bd28-32571cd68594",
                                        "entry_id": "43d29938-aeaa-3c0d-be2b-689c053ee0a4",
                                        "glosses": [
                                            "Pénurie d’argent, état voisin de la pauvreté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c22580f-18cf-481e-93a2-1ccfea7e8909",
                                                "sense_id": "14a57717-f4d9-35dd-bd28-32571cd68594",
                                                "text": "Il savait parfaitement que Craquot, statuaire de grand talent mais de pauvres relations, incapable de décrocher une commande, mijotait dans la gêne atroce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47d1bad6-00dc-35db-89a2-465593b29d2e",
                                        "entry_id": "43d29938-aeaa-3c0d-be2b-689c053ee0a4",
                                        "glosses": [
                                            "Ancienne peine du droit français, définie dans le Code pénal de 1791, supprimée par le Code pénal napoléonien de 1810. Gêne (droit) sur l’encyclopédie Wikipédia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74a8e03b-4771-4ab8-ada5-34313d83c08f",
                                                "sense_id": "47d1bad6-00dc-35db-89a2-465593b29d2e",
                                                "text": "— Actuellement, d’après l’ordre de monseigneur le Cardinal, on va mettre ces deux messieurs à la gêne, c’est-à-dire à la question ordinaire et extraordinaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gêne",
                                "target_lang_code": "fr",
