                "senses": [
                    {
                        "sense_id": "c777a309-b303-3575-9d70-23d5f1ba8b5b",
                        "entry_id": "853036a8-7d99-3908-ae04-dcbede3712e9",
                        "glosses": [
                            "Haarwäsche am nach hinten über ein Waschbecken gelegten Kopf, um das Verlaufen der Schminke zu vermeiden"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "834b3b3c-12d0-45b9-b84f-1f40029ddc50",
                                "sense_id": "c777a309-b303-3575-9d70-23d5f1ba8b5b",
                                "text": "Die sogenannte Rückwärtswäsche verhindert ein Verlaufen der Schminke."
                            },
                            {
                                "example_id": "fc726ee4-8115-446e-9d4e-63a6842226f5",
                                "sense_id": "c777a309-b303-3575-9d70-23d5f1ba8b5b",
                                "text": "Bei der Rückwärtswäsche lag der Kopf auf einem Blech, von dem das Wasser wild-bachartig in den Spülstein stürzte."
                            },
                            {
                                "example_id": "ac0be618-b6ba-444c-aeaf-22cee869920d",
                                "sense_id": "c777a309-b303-3575-9d70-23d5f1ba8b5b",
                                "text": "Damit einhergehend begann in den Friseursalons der Trend der Rückwärtswäschen, die stetig die Vorwärtswäschen an fest installierten Becken ersetzten."
                            },
                            {
                                "example_id": "e4f5d287-2dd3-476a-ad03-3f2b02c2409c",
                                "sense_id": "c777a309-b303-3575-9d70-23d5f1ba8b5b",
                                "text": "Der Frisör nennt die Kopfwäsche bei dem der Kopf des Kunden nach hinten gelegt wird „Rückwärtswäsche“."
                            },
                            {
                                "example_id": "8ec1f7c9-d0ce-4d23-bb29-33c8ab721fbe",
                                "sense_id": "c777a309-b303-3575-9d70-23d5f1ba8b5b",
                                "text": "Aus der Auflösung eines Friseursalons steht eine Liege für Rückwärtswäsche zur Verfügung."
                            },
                            {
                                "example_id": "e1516c86-a0aa-4ecb-8a58-330cd735346a",
                                "sense_id": "c777a309-b303-3575-9d70-23d5f1ba8b5b",
                                "text": "Das Augen- und Gesichts-Makeup bleiben mit größerer Sicherheit unverwischt erhalten als bei einer Rückwärtswäsche."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
