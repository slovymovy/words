                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infinitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a977b80e-c38a-36ed-9909-46c78e944ae4",
                                        "entry_id": "9edead17-c8b5-30b7-87e1-a61ef44318a9",
                                        "glosses": [
                                            "The infinitive mood or mode (a grammatical mood)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52a20177-bf91-4ea0-bcde-f887bb8b2176",
                                                "sense_id": "a977b80e-c38a-36ed-9909-46c78e944ae4",
                                                "text": "The MANNERS of acting, in grammar called modes or moods, are four; Infinitive, Imperative, Indicative, Subjunctive or Conjunctive."
                                            },
                                            {
                                                "example_id": "80c2a8cf-b129-445e-8708-254dd3f1aec6",
                                                "sense_id": "a977b80e-c38a-36ed-9909-46c78e944ae4",
                                                "text": "There are four moods, the Infinitive, Imperative, Indicative, and Subjunctive. [...] the Infinitive is used to express a thing in a general manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98bee7c7-ea4c-3c3a-ae82-0acc3e49734d",
                                        "entry_id": "9edead17-c8b5-30b7-87e1-a61ef44318a9",
                                        "glosses": [
                                            "A non-finite verb form considered neutral with respect to inflection; depending on language variously found used with auxiliary verbs, in subordinate clauses, or acting as a gerund, and often as the dictionary form."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1aa77c94-fefe-3757-92d5-74ff480562c2",
                                        "entry_id": "9edead17-c8b5-30b7-87e1-a61ef44318a9",
                                        "glosses": [
                                            "A verbal noun formed from the infinitive of a verb."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "infinitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55c550ae-9250-3366-a1fe-493b22e45cf6",
                                        "entry_id": "6ad1ab73-3e13-3119-9dc6-6c958b228bc2",
                                        "glosses": [
                                            "Formed with the infinitive."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb94f991-6467-4c40-9560-1f4e65240208",
                                                "sense_id": "55c550ae-9250-3366-a1fe-493b22e45cf6",
                                                "text": "INFINITIVE MOOD or MANNER.\nTo Have, Avoir."
                                            },
                                            {
                                                "example_id": "deab654d-899a-49ea-b3eb-39e5ba50fcff",
                                                "sense_id": "55c550ae-9250-3366-a1fe-493b22e45cf6",
                                                "text": "In English there are four moods:–1. The Infinitive Mood. 2. The Indicative Mood. 3. the Imperative Mood. 4. The Subjunctive Mood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10d11ace-334f-399e-a548-92863504055e",
                                        "entry_id": "6ad1ab73-3e13-3119-9dc6-6c958b228bc2",
                                        "glosses": [
                                            "Unlimited; not bounded or restricted; undefined."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cbbecdf-0a0e-4f5d-afa1-8a858fd39bce",
                                                "sense_id": "10d11ace-334f-399e-a548-92863504055e",
                                                "text": "[…] to search out in some higher region of infinitive space a spot where it was impossible for defilement to follow them […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d658a50-c730-4dce-b6f2-f9f33ea10b6f",
                        "source_entry_id": "98c1589e-406b-3a06-b2a5-7bf2d9ae5050",
                        "source_sense_id": "9bb7d6e3-e8c2-34ec-9ce5-7ac418f7c0b3",
                        "target_lang_word": "infinitif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infinitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b0dbb1f-b9e6-3ae6-8fb4-12690ef566b9",
                                        "entry_id": "01d8499e-61c9-3642-8d31-c154869d0f0a",
                                        "glosses": [
                                            "Forme (mode) d’un verbe sans marque de nombre ni de personne (telle qu’on la trouve par exemple dans les entrées des dictionnaires imprimés de la langue française)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5c6c59-158f-4bb2-9e62-2ab80f8b616c",
                                                "sense_id": "3b0dbb1f-b9e6-3ae6-8fb4-12690ef566b9",
                                                "text": "L’infinitif peut être considéré comme le nom verbal."
                                            },
                                            {
                                                "example_id": "2ab2443d-f803-46f8-9afe-ea66043ac370",
                                                "sense_id": "3b0dbb1f-b9e6-3ae6-8fb4-12690ef566b9",
                                                "text": "« Aimer » est l’infinitif du verbe dont « j’aime » est le présent de la première personne à l’indicatif."
                                            },
                                            {
                                                "example_id": "230e0068-af7a-415a-87cb-d2d4c76afbca",
                                                "sense_id": "3b0dbb1f-b9e6-3ae6-8fb4-12690ef566b9",
                                                "text": "Un verbe à l’infinitif."
                                            },
                                            {
                                                "example_id": "b95ac63f-0474-483e-ab2a-5d0097702da9",
                                                "sense_id": "3b0dbb1f-b9e6-3ae6-8fb4-12690ef566b9",
                                                "text": "Le présent de l’infinitif."
                                            },
                                            {
                                                "example_id": "cc3b54f7-a6b6-415d-bf44-21f25e90c8fb",
                                                "sense_id": "3b0dbb1f-b9e6-3ae6-8fb4-12690ef566b9",
                                                "text": "[…] ne plus conjuguer les verbes ; je tu ils nous vous ils ; devenir infinitif comme dans un mode d’emploi ou une recette de cuisine ; sombrer ; traverser le miroir ; enfin se reposer ; faire partie des éléments ; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "infinitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc2fa2d0-358b-3b9f-be57-188b9c361453",
                                        "entry_id": "ab09d18b-2d2e-3e94-a0a1-3a6d4ce9b83f",
                                        "glosses": [
                                            "Qui concerne ou utilise l’infinitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a557ca7b-284f-4e5f-8562-e6a5e47dbdb5",
                                                "sense_id": "fc2fa2d0-358b-3b9f-be57-188b9c361453",
                                                "text": "Le mode infinitif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92e196cb-c2e0-325a-bca6-96b95863ad97",
                                        "entry_id": "ab09d18b-2d2e-3e94-a0a1-3a6d4ce9b83f",
                                        "glosses": [
                                            "Dont le verbe principal est à l’infinitif, en parlant d’une proposition."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6007e6d2-2e1a-4314-9ba7-fdac5d0c2374",
                                                "sense_id": "92e196cb-c2e0-325a-bca6-96b95863ad97",
                                                "text": "La proposition infinitive."
                                            },
                                            {
                                                "example_id": "9a1b4c80-76f2-4d95-b4bb-10fa2108295c",
                                                "sense_id": "92e196cb-c2e0-325a-bca6-96b95863ad97",
                                                "text": "Sur le modèle des propositions latines […] dites propositions infinitives, les écrivains humanistes ont parfois construit à l’infinitif le complément des verbes régents qui évoquent une opération de l’intelligence ou un acte de volonté […]. Ce tour est exceptionnel en français moderne : elle jugeait cette récréation lui être profitable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
