                                                "sense_id": "8eb4ea54-5b84-370b-86b9-b1fa14dadec3",
                                                "text": "По ее [закройщицы] плечам рассыпались русые волнистые волосы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c691b36f-4da0-3a43-b965-ae5aa288912d",
                                        "entry_id": "b180af13-42a0-3bf2-86c3-a47bdf03f14c",
                                        "glosses": [
                                            "покрытый пологими возвышенностями, холмистый, бугристый, подобный волнам"
                                        ],
