                    "sense_id": "d7abb5ed-a0cb-3bcd-8da2-f24ba39a96c3",
                    "sense_definition": "Completely contrary to nature, reason, or common sense; utterly absurd or ridiculous.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "absurdity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The idea that the earth is flat is a <w>preposterous</w> claim that ignores centuries of scientific evidence.",
                            "target_lang_translations": {
                                "ru": "Идея о том, что Земля плоская — это <w>нелепое</w> утверждение, которое игнорирует столетия научных доказательств."
                            }
                        },
                        {
                            "text": "It is a <w>preposterous</w> suggestion to ask employees to work through the weekend without any additional pay.",
                            "target_lang_translations": {
                                "ru": "Это <w>абсурдное</w> предложение — просить сотрудников работать все выходные без какой-либо дополнительной оплаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "absurd",
                        "foolish",
                        "irrational",
                        "nonsensical"
                    ],
                    "antonyms": [
                        "reasonable",
                        "sensible",
                        "logical",
                        "plausible"
                    ],
                    "common_phrases": [
                        "preposterous suggestion",
                        "preposterous claim",
                        "preposterous idea",
                        "absolutely preposterous"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью противоречащий природе, разуму или здравому смыслу; совершенно абсурдный или нелепый."
