                "senses": [
                    {
                        "sense_id": "86466ff0-60d1-32e9-8de1-4147e15c38bf",
                        "entry_id": "9bc23d7d-6952-376f-a3a5-459a991ec2e9",
                        "glosses": [
                            "Adepte de l’égalitarisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dca072ba-a9a2-4259-9d30-c0dac1b9ccf1",
                                "sense_id": "86466ff0-60d1-32e9-8de1-4147e15c38bf",
                                "text": "Les égalitaristes libéraux revendiquent des programmes positifs, c'est-à-dire de promotion sociale, qui redistribuent les richesses et créent une plus grande équité. (?PgNm=TCE&Params=F1ARTF0004671 The Canadian Encyclopedia)"
                            },
                            {
                                "example_id": "20b1a43b-441d-40f8-924a-b47b51519203",
                                "sense_id": "86466ff0-60d1-32e9-8de1-4147e15c38bf",
                                "text": "Si vous êtes un égalitariste, mais pourquoi êtes-vous riche ?"
                            }
                        ]
                    }
                ],
