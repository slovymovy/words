{
    "word_family": [
        "vluchtigheid",
        "vluchten"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7a78e90b-db17-33a6-b36b-c2af94a79ab1",
                    "sense_definition": "zonder veel aandacht voor details of diepgang uitgevoerd",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "oppervlakkigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wierp een <w>vluchtige</w> blik op de krant voordat ik naar mijn werk ging.",
                            "target_lang_translations": {
                                "en": "I cast a <w>cursory</w> glance at the newspaper before I went to work."
                            }
                        },
                        {
                            "text": "Na een <w>vluchtig</w> onderzoek bleek dat er gelukkig niets gestolen was.",
                            "target_lang_translations": {
                                "en": "After a <w>brief</w> investigation, it turned out that fortunately nothing had been stolen."
                            }
                        }
                    ],
                    "synonyms": [
                        "oppervlakkig"
                    ],
                    "antonyms": [
                        "grondig",
                        "gedegen",
                        "diepgaand"
                    ],
                    "common_phrases": [
                        "vluchtige blik",
                        "vluchtig onderzoek",
                        "vluchtig contact"
                    ],
                    "target_lang_definitions": {
                        "en": "carried out without much attention to detail or depth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cursory",
                                "target_lang_sense_clarification": "hasty and not thorough"
                            },
                            {
                                "target_lang_word": "superficial",
                                "target_lang_sense_clarification": "lacking depth or substance"
                            },
                            {
                                "target_lang_word": "brief",
                                "target_lang_sense_clarification": "short and quick"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f127170b-0db3-3909-857e-878fd32c88d8",
                    "sense_definition": "slechts van korte duur en snel voorbijgaand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tijdelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geluk duurt soms maar een <w>vluchtig</w> ogenblik in een mensenleven.",
                            "target_lang_translations": {
                                "en": "Happiness sometimes lasts only a <w>fleeting</w> moment in a person's life."
                            }
                        },
                        {
                            "text": "Zij hadden een <w>vluchtige</w> ontmoeting op het drukke treinstation.",
                            "target_lang_translations": {
                                "en": "They had a <w>brief</w> encounter at the busy train station."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vluchtig ogenblik",
                        "vluchtige ontmoeting"
                    ],
                    "target_lang_definitions": {
                        "en": "of short duration and passing quickly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fleeting",
                                "target_lang_sense_clarification": "lasting for a very short time"
                            },
                            {
                                "target_lang_word": "brief",
                                "target_lang_sense_clarification": "short in duration"
                            },
                            {
                                "target_lang_word": "transient",
                                "target_lang_sense_clarification": "staying only a short time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ed812bf-c8e8-3ce2-908e-7b3821b186eb",
                    "sense_definition": "gemakkelijk in damp overgaand bij blootstelling aan de lucht",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemische_eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vluchtige</w> stoffen die aan de lucht worden blootgesteld verdampen zeer snel.",
                            "target_lang_translations": {
                                "en": "<w>Volatile</w> substances exposed to the air evaporate very quickly."
                            }
                        },
                        {
                            "text": "Bij deze hoge temperaturen is zink een vrij <w>vluchtige</w> substantie.",
                            "target_lang_translations": {
                                "en": "At these high temperatures, zinc is a fairly <w>volatile</w> substance."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vluchtige stoffen",
                        "vluchtige olie"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "easily turning into vapor when exposed to air"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "volatile",
                                "target_lang_sense_clarification": "evaporating readily"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}