                                    }
                                ]
                            },
                            {
                                "target_word": "slab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20fc2318-af83-34ab-955e-2a170bbbbb2c",
                                        "entry_id": "a75aadcc-d089-305b-b9ae-f43f62faf9de",
                                        "glosses": [
                                            "A car that has been modified with equipment such as loudspeakers, lights, special paint, hydraulics, and other accessories."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e786000-74ce-428b-ad9b-ac4520bcdf2c",
                                                "sense_id": "20fc2318-af83-34ab-955e-2a170bbbbb2c",
                                                "text": "Pull me over, try to check my slab"
                                            },
                                            {
                                                "example_id": "a2ecd9d7-7153-4e6b-8403-a5c3fdc3595e",
                                                "sense_id": "20fc2318-af83-34ab-955e-2a170bbbbb2c",
                                                "text": "I'mma swang, I'mma swing my slab lean to the left"
                                            },
                                            {
                                                "example_id": "09f45fd7-8de0-45e5-85f9-0bfc37f385e1",
                                                "sense_id": "20fc2318-af83-34ab-955e-2a170bbbbb2c",
                                                "text": "All three of them recognized who the Lexus'^([sic]) belonged to so he parked his slab and they cocked their guns."
                                            }
                                        ]
                                    }
                                ]
                            },
