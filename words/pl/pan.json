                {
                    "sense_id": "4e690e58-a7a4-3a0f-bbce-63e41a2e8126",
                    "sense_definition": "Polska Akademia Nauk – państwowa instytucja naukowa.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Mój brat pracuje w instytucie badawczym <w>PAN</w>.",
                            "target_lang_translations": {
                                "ru": "Мой брат работает в научно-исследовательском институте <w>ПАН</w>.",
                                "en": "My brother works at the <w>PAN</w> research institute."
