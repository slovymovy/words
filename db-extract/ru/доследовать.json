                "senses": [
                    {
                        "sense_id": "746f57ab-48fb-303a-b123-ecdc2ce2b0c6",
                        "entry_id": "eeb943f3-0f0d-3344-9915-afad2b4d1c90",
                        "glosses": [
                            "юр. вести дополнительное предварительное следствие или дознание по уже расследованному делу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "345bfef9-5f41-439e-a54b-1ba5a39a3111",
                                "sense_id": "746f57ab-48fb-303a-b123-ecdc2ce2b0c6",
                                "text": "До сих пор он считал, что собственного признания обвиняемого достаточно для окончания дела, и он это признание получил. Приказали ему доследовать дело, он доследовал."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb3ba0ac-f8be-38ab-82b1-8e0f58234ac1",
                        "entry_id": "eeb943f3-0f0d-3344-9915-afad2b4d1c90",
                        "glosses": [
                            "расследовать до конца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6c5fbc0-19d7-4877-8727-a1347657cd24",
                                "sense_id": "eb3ba0ac-f8be-38ab-82b1-8e0f58234ac1",
                                "text": "Но дело пошло так, что Марья Алексевна забыла доследовать, через кого оно вышло."
                            }
                        ]
                    }
