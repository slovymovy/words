                "senses": [
                    {
                        "sense_id": "22acf5fe-1cd9-33d1-b9a9-f4378daa63e0",
                        "entry_id": "d668b9d3-4499-3279-8646-b992c83f0d01",
                        "glosses": [
                            "Chevalerie, classe et institution militaire et religieuse du Moyen Âge qui imposait à ses membres la bravoure, la loyauté, la protection des faibles et la courtoisie envers les dames."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebee4192-a0b6-4869-b290-c6389f505a19",
                                "sense_id": "22acf5fe-1cd9-33d1-b9a9-f4378daa63e0",
                                "text": "War der Ritter nicht in kriegerische Auseinandersetzungen verwickelt, so war sein Alltag dennoch geprägt von seiner Zugehörigkeit zum Ritterstand.",
                                "translation": "Même lorsque le chevalier n'était pas engagé dans des conflits armés, son quotidien était néanmoins marqué par son appartenance à la chevalerie."
                            }
                        ]
                    }
                ],
