                                    },
                                    {
                                        "sense_id": "960ff6cb-ee7a-3000-b6e3-100c35fdc5fe",
                                        "entry_id": "e6128a49-e57c-3122-8eaf-8b3ebf17956f",
                                        "glosses": [
                                            "weltlich, nicht der Kirche zugehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b920f66-3e31-4ee3-9268-6b25369cab3b",
                                                "sense_id": "960ff6cb-ee7a-3000-b6e3-100c35fdc5fe",
                                                "text": "„Ganz anders sah und sieht dies die (auch nach der Wahl) größte Oppositionspartei CHP, die sich strikt säkular gibt und in der religiös gefärbten AKP eine Bedrohung für die ganze Türkei sieht.“"
                                            },
                                            {
                                                "example_id": "ff601837-d45b-46d2-a076-350561f3c5ef",
                                                "sense_id": "960ff6cb-ee7a-3000-b6e3-100c35fdc5fe",
                                                "text": "„Also erst mit der säkularen Aufwertung des Diesseitigen und Irdischen wurde auch Landschaftsbeschreibung als ein literarischer Gegenstand denkbar und akzeptabel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
