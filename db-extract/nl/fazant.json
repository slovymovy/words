                    {
                        "translation_id": "789fa970-3ca5-4972-bbd8-dbb688c3ad28",
                        "source_entry_id": "d47f199d-7de6-35c5-bd28-056de4f6181b",
                        "source_sense_id": "da89b1da-6d56-3979-bdcf-db4e6358218a",
                        "source_sense_description": "bepaald soort kleurrijke vogel, Phasianus colchicus",
                        "target_lang_word": "фазан",
