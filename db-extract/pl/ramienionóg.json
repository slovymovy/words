                        "glosses": [
                            "Brachiopoda Duméril, żyjący na dnie morza bezkręgowiec o muszli złożonej z dwóch skorupek, grzbietowej i brzusznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
