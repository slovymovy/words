{
    "word_family": [
        "verlossen",
        "verlosser",
        "verloskundige"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3325a78-cbb7-39cc-815b-620f3df12dd4",
                    "sense_definition": "Het bevrijd worden uit een moeilijke, pijnlijke of beklemmende situatie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het behalen van zijn laatste examen voelde als een grote <w>verlossing</w>. ",
                            "target_lang_translations": {
                                "en": "Passing his final exam felt like a great <w>relief</w>."
                            }
                        },
                        {
                            "text": "Zij keken uit naar een snelle <w>verlossing</w> van hun zware taken.",
                            "target_lang_translations": {
                                "en": "They were looking forward to a quick <w>release</w> from their heavy duties."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevrijding"
                    ],
                    "common_phrases": [
                        "snelle verlossing",
                        "als een verlossing"
                    ],
                    "target_lang_definitions": {
                        "en": "Being freed from a difficult, painful, or oppressive situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relief",
                                "target_lang_sense_clarification": "alleviation of pain, anxiety, or hardship"
                            },
                            {
                                "target_lang_word": "deliverance",
                                "target_lang_sense_clarification": "rescue or release from a difficult situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb29c06b-2df6-3cb5-a257-fbf1f1327e38",
                    "sense_definition": "Het proces waarbij een kind ter wereld wordt gebracht; bevalling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verlossing</w> verliep zonder complicaties in het ziekenhuis.",
                            "target_lang_translations": {
                                "en": "The <w>delivery</w> went without complications in the hospital."
                            }
                        },
                        {
                            "text": "De arts sprak over een voorspoedige <w>verlossing</w> van de moeder.",
                            "target_lang_translations": {
                                "en": "The doctor spoke of a successful <w>delivery</w> for the mother."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevalling"
                    ],
                    "common_phrases": [
                        "voorspoedige verlossing"
                    ],
                    "target_lang_definitions": {
                        "en": "The process of bringing a child into the world; childbirth."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "delivery",
                                "target_lang_sense_clarification": "the process of giving birth"
                            },
                            {
                                "target_lang_word": "childbirth",
                                "target_lang_sense_clarification": "the act of giving birth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eee0c936-1e6c-37ab-b9f3-fb304b7db51e",
                    "sense_definition": "De bevrijding van zonden of het kwaad in een religieuze of spirituele context.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kruisdood op Golgotha bracht ons allen de <w>verlossing</w>.",
                            "target_lang_translations": {
                                "en": "The death on the cross at Golgotha brought us all <w>salvation</w>."
                            }
                        },
                        {
                            "text": "Gelovigen hopen op eeuwige <w>verlossing</w> na hun dood.",
                            "target_lang_translations": {
                                "en": "Believers hope for eternal <w>salvation</w> after their death."
                            }
                        }
                    ],
                    "synonyms": [
                        "redding",
                        "heil"
                    ],
                    "common_phrases": [
                        "eeuwige verlossing"
                    ],
                    "target_lang_definitions": {
                        "en": "Deliverance from sin or evil in a religious or spiritual context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "salvation",
                                "target_lang_sense_clarification": "deliverance from sin and its consequences"
                            },
                            {
                                "target_lang_word": "redemption",
                                "target_lang_sense_clarification": "the action of saving or being saved from sin"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}