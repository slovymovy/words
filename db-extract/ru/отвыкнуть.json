                                "target_senses": [
                                    {
                                        "sense_id": "b560e06e-a76d-33fc-a0f9-2910e36a2735",
                                        "entry_id": "feee837b-163a-3275-b378-6ba1dea02aba",
                                        "glosses": [
                                            "Débarrasser d’une tache, de taches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c758e24f-a58d-4df5-a267-a30dcaf70860",
                                                "sense_id": "b560e06e-a76d-33fc-a0f9-2910e36a2735",
                                                "text": "[…], Françoise savait faire une reprise, préparer le potage ou détacher un vêtement ; à sa façon de tenir un fer à repasser elle l'avait reconnue de bonne race."
                                            },
                                            {
                                                "example_id": "eb61e565-ec10-4cab-a52f-92d11cb26e9a",
                                                "sense_id": "b560e06e-a76d-33fc-a0f9-2910e36a2735",
                                                "text": "Détacher un habit. Substance qui sert à détacher. Savon à détacher."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détacher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01c1d443-a514-3a36-9b15-3ec5de4134f1",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Dégager une personne ou une chose de ce qui l’attachait, de ce qui la retenait, de l’objet auquel elle était attachée, fixée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb4adddc-6f8d-46d2-af77-344d4f051cad",
                                                "sense_id": "01c1d443-a514-3a36-9b15-3ec5de4134f1",
                                                "text": "Détacher un chien. Détacher une tapisserie, un tableau. Détacher une barque du rivage."
                                            },
                                            {
                                                "example_id": "86bb6f52-7b25-4f84-a697-a87fb412757c",
                                                "sense_id": "01c1d443-a514-3a36-9b15-3ec5de4134f1",
                                                "text": "Détacher un fruit de l’arbre. Un créneau qui commence à se détacher de la muraille. Un bloc énorme se détache de la montagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e26a0ae-a126-3e1a-b2cf-ded7bed646dc",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Ôter, défaire ce qui sert à attacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12648968-8cd2-4126-89f1-bb53e6a90f17",
                                                "sense_id": "1e26a0ae-a126-3e1a-b2cf-ded7bed646dc",
                                                "text": "Détacher une épingle. Détacher une agrafe. Détacher un ruban, une jarretière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6632c592-53d8-3e4e-a487-cca1f28a6085",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Tenir écarté de."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "851afa23-38c5-42d2-8379-f0d8c910dbc1",
                                                "sense_id": "6632c592-53d8-3e4e-a487-cca1f28a6085",
                                                "text": "L’Église post-grégorienne exploite ce que les Écritures et la Tradition lui offrent-pour \"monachiser\" ses clercs séculiers et les détacher de la femme tentatrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a771cbd-3e8e-3eae-a3a1-40ec83d88e26",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Rendre distinct, isolé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "425e9d20-f019-48c4-be69-594d26eac8ac",
                                                "sense_id": "4a771cbd-3e8e-3eae-a3a1-40ec83d88e26",
                                                "text": "Détacher les notes du texte par un filet. Ce titre ne se détache pas assez du texte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17ae210f-42d8-3bf7-9379-f7242bc98d24",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Faire apercevoir et ressortir les contours d’un objet, lui donner de la saillie par le contraste de sa couleur avec celle du fond, ou par quelque autre moyen."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e6e0bbe-fa58-4124-af6c-61aab7e6771a",
                                                "sense_id": "17ae210f-42d8-3bf7-9379-f7242bc98d24",
                                                "text": "Il n’y a personne à voir ; chez ma grand’tante, où je demeure, je n’ai encore vu que quelques marins se détachant sur un fond de douairières, et quelles douairières ! d’avant la Révolution !"
                                            },
                                            {
                                                "example_id": "dfbd54f4-4c1c-4f63-9a29-0ba08ed7c07c",
                                                "sense_id": "17ae210f-42d8-3bf7-9379-f7242bc98d24",
                                                "text": "La grande forêt des Ardennes est une des plus chargée de mystères. […]. L’hiver, lorsque la neige a cessé de tomber depuis quelques jours, lorsque l’armée des sapins noirs immobiles se détache sur le sol blanc, le voyageur solitaire doit se défendre contre un sentiment de crainte, presque d’angoisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51e88405-d928-355f-8a8f-5cffc1387007",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Séparer d’avec ce qui est joint et fait en quelque sorte un même corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3a4ce8-649f-4cc7-92d3-9555a4b260c0",
                                                "sense_id": "51e88405-d928-355f-8a8f-5cffc1387007",
                                                "text": "Le ressort du diocèse de Tournay s'étend sur quelques parties de territoire réunies à la France et détachées des communes de Lamain, Templeuve et Bailièvre."
                                            },
                                            {
                                                "example_id": "a9b5287e-3fbe-4f81-96a9-08a0d8aae215",
                                                "sense_id": "51e88405-d928-355f-8a8f-5cffc1387007",
                                                "text": "Détacher un pré, une vigne d’une ferme. Cette administration a été réunie au ministère dont on l’avait autrefois détachée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a59fc7e0-a348-3985-a587-b1b00c618c64",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Tirer une troupe d’un corps d’armée, des soldats d’un régiment, d’une compagnie, etc., pour un service particulier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05eb4f79-c0ea-45f5-8ed4-325f79935ba6",
                                                "sense_id": "a59fc7e0-a348-3985-a587-b1b00c618c64",
                                                "text": "Au mois de juillet 1641, raconte Dom Grenier, la garnison de Péronne détacha une douzaine de cavaliers sur Allaines pour y faire des prisonniers et du butin. Ils pénétrèrent à l’improviste dans les basses-cours et s'emparèrent de tous les porcs qu'ils purent y rencontrer."
                                            },
                                            {
                                                "example_id": "612b768d-4bd4-4aa3-8046-690cc65449cd",
                                                "sense_id": "a59fc7e0-a348-3985-a587-b1b00c618c64",
                                                "text": "On détacha de la flotte deux bâtiments légers, qui prirent les devants. Trois vaisseaux se détachèrent de la flotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "753ff59f-acdb-3a8d-b7e1-b6962e261e8a",
                                        "entry_id": "a751e0b3-e551-39e2-b807-46916ba8812d",
                                        "glosses": [
                                            "Déterminer une personne à quitter ses engagements, ses occupations, ses passions, ses affections, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "550753f8-df16-4b39-9f45-55f94fa06e50",
                                                "sense_id": "753ff59f-acdb-3a8d-b7e1-b6962e261e8a",
                                                "text": "Détacher quelqu’un d’un parti, d’une alliance. Il s’est détaché de la passion qu’il avait. Il s’est détaché peu à peu de cette femme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
