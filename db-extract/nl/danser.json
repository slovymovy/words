                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8c86cc8-dae6-32f5-b0a6-db1f98e258a8",
                                        "entry_id": "c637387e-f2c0-3716-9166-89f9e4201485",
                                        "glosses": [
                                            "Synonym of garreter (“a thief who used housetops to enter by garret windows”)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c39547-a8a2-4247-9611-da4837267c73",
                                                "sense_id": "e8c86cc8-dae6-32f5-b0a6-db1f98e258a8",
                                                "text": "[A]bout 40 were burglars, \"dancers,\" \"garreters,\" and other adepts with the skeleton keys."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c50d63ec-8a53-4f42-8149-9ba765a946db",
                        "source_entry_id": "e89645ad-6049-318a-ad12-c565af537351",
                        "source_sense_id": "a8c9faea-04ee-3df3-8df2-381045e19e8f",
                        "source_sense_description": "mannelijk persoon die danst",
                        "target_lang_word": "danseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "danseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59947bc6-5a79-3724-bf64-1aa2fefb9908",
                                        "entry_id": "fbadece0-8066-3337-a5ee-36541c3dd6ed",
                                        "glosses": [
                                            "Celui qui danse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88324b4-4284-403f-bb16-c3e233d5a1d0",
                                                "sense_id": "59947bc6-5a79-3724-bf64-1aa2fefb9908",
                                                "text": "C’est un bon danseur, un grand danseur."
                                            },
                                            {
                                                "example_id": "69432570-194c-4668-a3a0-b6e5f0f825da",
                                                "sense_id": "59947bc6-5a79-3724-bf64-1aa2fefb9908",
                                                "text": "Un danseur, une danseuse de l’Opéra."
                                            },
                                            {
                                                "example_id": "3aa5c76d-fe54-4901-9443-6d283a68de8b",
                                                "sense_id": "59947bc6-5a79-3724-bf64-1aa2fefb9908",
                                                "text": "La musique enivre et règle le danseur, tandis que le curieux voit le mouvement seul et rit de ce pantin qui s’agite sans raison, car le curieux, lui, n’entend pas la musique."
                                            },
                                            {
                                                "example_id": "39e38dc6-7738-4e0c-853d-84bc39cdebeb",
                                                "sense_id": "59947bc6-5a79-3724-bf64-1aa2fefb9908",
                                                "text": "Les deux danseurs à tour de rôle s'agitaient en frappant sur un tambourin de peaux de phoque. Ce n'était pas beaucoup plus étrange que le charleston ou le black-bottom."
                                            },
                                            {
                                                "example_id": "b7c4895f-2aa3-4509-a87e-8a36dcc9a23d",
                                                "sense_id": "59947bc6-5a79-3724-bf64-1aa2fefb9908",
                                                "text": "Tard dans la soirée, les danseurs commencèrent à s'animer. Il y eut alors quelques essais de « upa upa », qui est d'origine tahitienne, suggestive et voluptueuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84511205-89aa-3d13-94ab-cbfb7a426e7d",
                                        "entry_id": "fbadece0-8066-3337-a5ee-36541c3dd6ed",
                                        "glosses": [
                                            "Celui qui aime à danser, qui danse souvent, ou qui fait profession de danser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c92c9c2-b39b-421a-8062-a0625abf1c29",
                                                "sense_id": "84511205-89aa-3d13-94ab-cbfb7a426e7d",
                                                "text": "L’autre, sec, noueux, noiraud, correct à la façon d’un danseur salarié, répondait à l’appellation du « Mondain »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
