                        "cross_references": [
                            {
                                "target_word": "quadrangle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "071389de-5d0e-3865-8d27-d28cff524189",
                                        "entry_id": "3642285e-10b0-3c4a-8ef2-e7175250237d",
                                        "glosses": [
                                            "Figure géométrique formée par quatre points A, B, C, D (les sommets) tels que trois quelconques d'entre eux ne soient pas alignés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19cfb752-29b4-4b3d-ad60-def271a97b72",
                                                "sense_id": "071389de-5d0e-3865-8d27-d28cff524189",
                                                "text": "Les six droites joignant ces points deux à deux sont les côtés du quadrangle."
                                            },
                                            {
                                                "example_id": "8017aef5-69e0-44d9-8f63-d9bbd19a9d7d",
                                                "sense_id": "071389de-5d0e-3865-8d27-d28cff524189",
                                                "text": "Dans mon quadrangle magnifique bout une petite humanité fraîche, intolérante, intolérable, qui depuis la guerre repousse tout frein et tout guide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb9697bc-4769-412c-9be8-28faf582f918",
                        "source_entry_id": "ef8da256-1668-393d-a204-90748c8ce087",
                        "source_sense_id": "05980ee9-79d1-37d9-8aac-c3c411646ad6",
