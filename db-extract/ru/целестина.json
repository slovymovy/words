                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Célestine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90fd66a0-b83d-34a3-914f-390544fa7dd5",
                                        "entry_id": "2f320611-a26b-3a28-9c6b-66cbe6c9f5df",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "081c1d1a-b8d6-4c45-8dc5-6a4ac4b9530c",
                                                "sense_id": "90fd66a0-b83d-34a3-914f-390544fa7dd5",
                                                "text": "Ah ! maudite vie de garçon ! Sans mes déportements, ma Célestine serait aujourd’hui la vicomtesse Popinot !"
                                            },
                                            {
                                                "example_id": "f2291820-d3ad-4b94-8103-898675fa328d",
                                                "sense_id": "90fd66a0-b83d-34a3-914f-390544fa7dd5",
                                                "text": "Souvent, Juliette se rendait à la lingerie où Célestine cousait, et elle restait là, des heures entières, assise sur une pile de draps, à écouter les inépuisables « potins » de la bonne…"
                                            },
                                            {
                                                "example_id": "ba477ea4-8a8f-40ba-b3fd-5bcd18ea3b9d",
                                                "sense_id": "90fd66a0-b83d-34a3-914f-390544fa7dd5",
                                                "text": "Parfois une petite vieille passait devant la fenêtre de Dorothée, menue, trottinante, glissant sans bruit le long des murs, comme une souris épeurée. On l’appelait dans le village la petite Célestine : son teint avait des tons de vieil ivoire, une infinité de petites rides plissaient ses lèvres, ses joues et son front."
                                            },
                                            {
                                                "example_id": "5aa84253-d589-4689-a65c-b70e9ea1b802",
                                                "sense_id": "90fd66a0-b83d-34a3-914f-390544fa7dd5",
                                                "text": "Si l’objectif est encore bien loin d’être atteint, Leia Beuzit et Célestine Simon en rêvent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Célestine",
