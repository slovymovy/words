                        "glosses": [
                            "Opposition à la politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ba8903e-5fc9-4fc8-9c7a-bdf4eebff7fb",
                                "sense_id": "7a9a3823-7c68-3e8d-b186-7178581f76fa",
                                "text": "Cette affirmation, qui conclut l’article « Néo-libéralisme, anti-politisme et individualisme possessif », est largement étayée."
                            },
                            {
                                "example_id": "78f43218-b031-4cd0-b228-43fee44cbecc",
                                "sense_id": "7a9a3823-7c68-3e8d-b186-7178581f76fa",
                                "text": "Anti-psychanalyse et anti-politisme vont de pair : le maître n’apprécie pas plus le pluralisme contradictoriel de la psyché que le régime parlementaire."
                            },
                            {
                                "example_id": "5c5eac74-aa82-4bc8-8799-1af5f47c4cb0",
                                "sense_id": "7a9a3823-7c68-3e8d-b186-7178581f76fa",
                                "text": "Une femme — la seule — au langage simple et direct, à la thématique souvent proche de « l’anti-politisme » populaire, a su rassembler le temps d’un vote des sensibilités éparses et probablement contradictoires."
                            }
                        ]
                    }
