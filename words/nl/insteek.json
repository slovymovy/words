{
    "word_family": [
        "insteken",
        "steek",
        "steken"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9667c4cb-0be9-3ff7-a97a-3ef9c38a5f60",
                    "sense_definition": "De manier waarop men een probleem of situatie benadert; een invalshoek of aanpak.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "benadering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stapsgewijs het probleem oplossen is een goede <w>insteek</w>.",
                            "target_lang_translations": {
                                "en": "Solving the problem step by step is a good <w>approach</w>."
                            }
                        },
                        {
                            "text": "Met een positieve <w>insteek</w> kunnen we deze moeilijke taak sneller afronden.",
                            "target_lang_translations": {
                                "en": "With a positive <w>angle</w>, we can complete this difficult task faster."
                            }
                        }
                    ],
                    "synonyms": [
                        "invalshoek",
                        "benadering",
                        "aanpak",
                        "opvatting",
                        "oogpunt"
                    ],
                    "common_phrases": [
                        "een goede insteek",
                        "positieve insteek"
                    ],
                    "target_lang_definitions": {
                        "en": "The way in which one approaches a problem or situation; an angle or approach."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "approach",
                                "target_lang_sense_clarification": "method of dealing with something"
                            },
                            {
                                "target_lang_word": "angle",
                                "target_lang_sense_clarification": "perspective or point of view"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "particular approach or opinion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a6faf42-e35a-3e60-802b-46fb8d76878e",
                    "sense_definition": "De handeling van het ergens in steken of inbrengen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "handeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>insteek</w> van de naald is wat lastig als de huid verdikt is.",
                            "target_lang_translations": {
                                "en": "The <w>insertion</w> of the needle is somewhat difficult if the skin is thickened."
                            }
                        },
                        {
                            "text": "Bij het naaien is een nauwkeurige <w>insteek</w> van groot belang.",
                            "target_lang_translations": {
                                "en": "When sewing, a precise <w>puncture</w> is of great importance."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The act of inserting or sticking something into something else."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insertion",
                                "target_lang_sense_clarification": "act of putting something inside"
                            },
                            {
                                "target_lang_word": "puncture",
                                "target_lang_sense_clarification": "act of piercing or sticking into"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58d799a2-ac98-3e33-bf09-d6c892af3d23",
                    "sense_definition": "Een gedeeltelijk ingestoken tussenverdieping of entresol in een hoog gebouw.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architectuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is een veertiende-eeuws huis met in wezen nog de oorspronkelijke <w>insteek</w>.",
                            "target_lang_translations": {
                                "en": "This is a fourteenth-century house with essentially still the original <w>mezzanine</w>."
                            }
                        },
                        {
                            "text": "De oude boerderij had een houten <w>insteek</w> die als opslagruimte diende.",
                            "target_lang_translations": {
                                "en": "The old farm had a wooden <w>loft</w> that served as storage space."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A partially inserted mezzanine or loft floor in a high building."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mezzanine",
                                "target_lang_sense_clarification": "intermediate floor in a building"
                            },
                            {
                                "target_lang_word": "loft",
                                "target_lang_sense_clarification": "upper room or space in a building"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec61fad1-6409-37e1-8f48-0a9a8adc3116",
                    "sense_definition": "De totale voorraad linnengoed die een instelling of huishouden bezit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "voorraad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ziekenhuis moest de complete <w>insteek</w> van lakens vernieuwen.",
                            "target_lang_translations": {
                                "en": "The hospital had to renew the complete <w>stock</w> of sheets."
                            }
                        },
                        {
                            "text": "De inventarisatie toonde aan dat de <w>insteek</w> van het hotel niet meer toereikend was.",
                            "target_lang_translations": {
                                "en": "The inventory showed that the hotel's <w>linen supply</w> was no longer sufficient."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The total stock of linen owned by an institution or household."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "linen stock",
                                "target_lang_sense_clarification": "total supply of linen"
                            },
                            {
                                "target_lang_word": "linen supply",
                                "target_lang_sense_clarification": "inventory of sheets and towels"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "259465fb-4593-3552-b148-3803430c461b",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>insteken</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik weet zeker dat ik nu op de juiste manier <w>insteek</w>.",
                            "target_lang_translations": {
                                "en": "I am sure that I am <w>inserting</w> it the right way now."
                            }
                        },
                        {
                            "text": "Als ik de sleutel in het slot <w>insteek</w>, draait hij niet om.",
                            "target_lang_translations": {
                                "en": "When I <w>insert</w> the key into the lock, it does not turn."
                            }
                        }
