                            },
                            {
                                "target_lang_word": "dureń",
                                "target_lang_sense_clarification": "osoba bezmyślna lub nierozsądna"
                            },
                            {
                                "target_lang_word": "błazen",
                                "target_lang_sense_clarification": "osoba zachowująca się niemądrze, ośmieszająca się"
