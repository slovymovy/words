                            },
                            {
                                "target_word": "instant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c2d5da3-659e-3dbd-b7ba-82d5b932ab95",
                                        "entry_id": "2eaa79cc-1b3b-39e6-9e40-2660eb71d09d",
                                        "glosses": [
                                            "Impending; imminent."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7c12ef5-17c0-44da-993e-cdbfea954d04",
                                                "sense_id": "1c2d5da3-659e-3dbd-b7ba-82d5b932ab95",
                                                "text": "Impending death is thine, and instant doom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "460e0f4e-0aa2-376c-9ea7-7a1ed33960c0",
                                        "entry_id": "2eaa79cc-1b3b-39e6-9e40-2660eb71d09d",
                                        "glosses": [
                                            "Urgent; pressing; acute."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b515cba-ed16-3f23-8712-cd2af8f8b3f3",
                                        "entry_id": "2eaa79cc-1b3b-39e6-9e40-2660eb71d09d",
                                        "glosses": [
                                            "Insistent; persistent."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbeb6b91-e7a5-44d9-ae53-cf970df9320f",
                                                "sense_id": "8b515cba-ed16-3f23-8712-cd2af8f8b3f3",
                                                "text": "Rejoicing in hope; patient in tribulation; continuing instant in prayer."
                                            },
                                            {
                                                "example_id": "b55868c9-3762-4b99-9440-059e6539f09a",
                                                "sense_id": "8b515cba-ed16-3f23-8712-cd2af8f8b3f3",
                                                "text": "January 2, 1827, Thomas Carlyle, letter to Mrs. Carlyle, Scotsbrig\nI am beginning to be very instant for some sort of occupation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8b312b3-f9fb-3704-8550-1414d30c0745",
                                        "entry_id": "2eaa79cc-1b3b-39e6-9e40-2660eb71d09d",
                                        "glosses": [
                                            "Present; current; extant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a2c1c99-315c-42bd-adf2-407746018460",
                                                "sense_id": "f8b312b3-f9fb-3704-8550-1414d30c0745",
                                                "text": "He received just two disciplinary reports prior to committing the instant offense, one in March 2019 for activating an alarm during a non-emergency situation, and one in May 2019 for failing to provide a urine specimen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d55e4ec9-faed-3d82-a529-2c3f79982672",
                                        "entry_id": "2eaa79cc-1b3b-39e6-9e40-2660eb71d09d",
                                        "glosses": [
                                            "Occurring immediately; immediate; present."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1503a58-6020-484b-a229-c6fd9f6dfc85",
                                                "sense_id": "d55e4ec9-faed-3d82-a529-2c3f79982672",
                                                "text": "I ſee no day to To day, the inſtant Time is alvvayes the fitteſt time."
                                            },
                                            {
                                                "example_id": "d20c9da1-32b9-46ed-9e9f-b97fc1c609ae",
                                                "sense_id": "d55e4ec9-faed-3d82-a529-2c3f79982672",
                                                "text": "No one, however, would have anything to do with him, as Mr. Keeson's orders in those respects were very strict ; he had often threatened any one of his employés with instant dismissal if he found him in company with one of these touts."
                                            },
                                            {
                                                "example_id": "c1223da4-a5ba-4b21-b7cb-107cea11ab92",
                                                "sense_id": "d55e4ec9-faed-3d82-a529-2c3f79982672",
                                                "text": "As the body count rose, Tarrant quickly became a hero who had achieved a “new high score,” surpassing the former record holder Seung-Hui Cho of Virginia Tech. Tarrant attained instant cult status in the community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "299d2eee-09f6-3bdc-b1ea-25397356e985",
                                        "entry_id": "2eaa79cc-1b3b-39e6-9e40-2660eb71d09d",
                                        "glosses": [
                                            "Lasting for a short moment; momentary; short-lived."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a993077c-b410-3342-982b-a5e71f646347",
                                        "entry_id": "2eaa79cc-1b3b-39e6-9e40-2660eb71d09d",
                                        "glosses": [
                                            "Very quickly and easily prepared."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ddbda15-9cbf-47fa-a38b-17b5289a8134",
                                                "sense_id": "a993077c-b410-3342-982b-a5e71f646347",
                                                "text": "instant coffee; instant noodles; instant mashed potato; instant photo"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3d92af7-da96-34a1-ab47-8d4e10e2e04e",
                                        "entry_id": "2eaa79cc-1b3b-39e6-9e40-2660eb71d09d",
                                        "glosses": [
                                            "Of the current month."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2164a161-8646-4abb-9c44-1749258317e5",
                                                "sense_id": "e3d92af7-da96-34a1-ab47-8d4e10e2e04e",
                                                "text": "I refer to your letter of the 16th instant in regard to traffic disruption."
                                            },
                                            {
                                                "example_id": "e4b2d2ca-505e-4d75-8e50-95824e2ba365",
                                                "sense_id": "e3d92af7-da96-34a1-ab47-8d4e10e2e04e",
                                                "text": "Vice-Admiral Kamimura reports that at dawn of the 14th instant, our squadron found, off Ulsan, the south-eastern coast of Corea, three ships of the Vladivostock squadron steaming southward."
                                            },
                                            {
                                                "example_id": "0f3417bc-9762-4c1b-af75-290f3237e744",
                                                "sense_id": "e3d92af7-da96-34a1-ab47-8d4e10e2e04e",
                                                "text": "I have maturely reflected on the subject of your letter of the 18th instant; and the more I have reflected the more I have become convinced, that I could not, without manifest impropriety, make the avowal or disavowal which you seem to think necessary."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "instant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a889777d-3fcf-374b-a99c-fc2eb96627ff",
                                        "entry_id": "ce97ed7a-144a-3946-94c3-61f0bb5ede97",
                                        "glosses": [
                                            "At once; immediately."
                                        ],
