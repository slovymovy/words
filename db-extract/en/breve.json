                                        "examples": [
                                            {
                                                "example_id": "be9e2537-5549-4aba-90d7-16f13842d369",
                                                "sense_id": "93bc8aae-9137-3714-a361-ca5b594c4501",
                                                "text": "Dans le domaine de la confiserie, la machine 770 à envelopper des bonbons unitaires de forme carrée ou rectangulaire, à les grouper et à les surenvelopper en un stick unitaire de 6, 8 ou 10 bonbons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "990b6fd9-8519-3ea5-9558-282f82183bfb",
                                        "entry_id": "74ea9fa1-7551-3dc1-8280-086d7057ac3f",
                                        "glosses": [
                                            "Se dit d'une tour représentée sans l’effet arrondi contrairement à l’ordinaire. La tour carrée est la représentation normale du donjon."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d03b3da-e74b-4ae3-b0e4-4644bff66491",
                                                "sense_id": "990b6fd9-8519-3ea5-9558-282f82183bfb",
                                                "text": "D'azur à une terrasse d'argent portant une tour carrée du même, ouverte et ajourée de sable, entourée de douze étoiles d'or rangées en orle, au chef cousu de gueules chargé d'un crosse d'or posée en fasce, qui est de Cormicy → voir illustration « tour carrée »"
                                            }
