                                "example_id": "24aec343-b7d0-47b1-8db0-d15adec6ff72",
                                "sense_id": "b1e2e25c-ce3b-3ef7-9ac3-fdc674e3ecd6",
                                "text": "De doktoren hadden hun handen vol aan de labiele patiënt."
                            },
                            {
                                "example_id": "45b551f6-44cf-49c8-95d2-1147fc449bbe",
                                "sense_id": "b1e2e25c-ce3b-3ef7-9ac3-fdc674e3ecd6",
                                "text": "Ik voelde me helemaal niet in staat om in mijn eentje de nacht door te brengen, omdat ik zo labiel was."
                            }
                        ]
