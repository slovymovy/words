                        "examples": [
                            {
                                "example_id": "590ce855-9d7b-442d-937c-d0155ec9a320",
                                "sense_id": "7858bbe5-0851-3d46-8ed1-8e83ee21aa66",
                                "text": "„Das Biikebrennen ist ein gemeinschaftliches Feuerfest in Norddeutschland, mit dem traditionell böse Geister vertrieben und die neue Saat geschützt werden soll. Am 21. Februar werden in Schleswig-Holstein auf den Inseln Sylt, Amrum und Föhr, auf den Halligen und in weiten Teilen des nordfriesischen Festlandes alljährlich mehr als 60 Biiken entzündet.“"
                            },
                            {
                                "example_id": "796ec333-23cd-457b-9dda-62838d89c7c0",
                                "sense_id": "7858bbe5-0851-3d46-8ed1-8e83ee21aa66",
                                "text": "„Am Abend des 21. Februars findet das Biikebrennen statt, ein friesisches Volksfest.“"
                            }
                        ],
