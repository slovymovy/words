                ],
                "senses": [
                    {
                        "sense_id": "53b8100b-2a3d-31fc-a98e-26a869a7d7bd",
                        "entry_id": "868def20-763e-3d7a-b8d4-c72bf710ddc6",
                        "glosses": [
                            "Donner un caractère juridique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "525d550d-bdc1-451a-b6aa-5860d7162e46",
                                "sense_id": "53b8100b-2a3d-31fc-a98e-26a869a7d7bd",
                                "text": "Non pas qu’ils veuillent juridifier la morale entière ou supprimer toute autonomie de celle-ci, comme le laissent entendre leurs adversaires libéraux."
                            },
                            {
                                "example_id": "8e569abf-0bd0-4da6-bd88-18ee844e52e6",
                                "sense_id": "53b8100b-2a3d-31fc-a98e-26a869a7d7bd",
                                "text": "Or, en même temps et par le fait même que la pénitence devient ainsi un sacrement – c’est-à-dire, une opération réelle qui absout effectivement le pécheur du péché qu'il a commis –, du même coup, on la voit paradoxalement se juridifier tout à fait."
                            }
                        ]
                    }
                ],
