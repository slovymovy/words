                    {
                        "translation_id": "87254bc4-3b1c-4a24-85cd-4f04cca8a499",
                        "source_entry_id": "7ef9098e-15d1-3fad-b133-1402b7a74101",
                        "source_sense_id": "0746a866-a068-3c4f-ac2e-2d6f5f3795d6",
                        "target_lang_word": "diagnostisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diagnostisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c10e42c-7fbc-30ff-a7fa-7cac9f5425e1",
                                        "entry_id": "874a2ba2-0163-3f72-8c90-2d618959c697",
                                        "glosses": [
                                            "zur Diagnose gehörig, die Diagnose betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fa81a4a-c67e-4c3a-a1ff-b5651ee4f959",
                                                "sense_id": "0c10e42c-7fbc-30ff-a7fa-7cac9f5425e1",
                                                "text": "Diagnostische, therapeutische oder forschende Eingriffe werden durchgeführt, wenn der Patient nach ausreichender Aufklärung zustimmt, abgesehen naturgemäß von Noteingriffen."
                                            },
                                            {
                                                "example_id": "47b2b890-c7cb-46a2-a0ee-8f555ec5f27b",
                                                "sense_id": "0c10e42c-7fbc-30ff-a7fa-7cac9f5425e1",
                                                "text": "Diagnostische Tests und Biomarker sollen in Zukunft maßgeschneiderte Therapien ermöglichen und so verhindern, dass teure Medikamente nach dem Gießkannenprinzip verordnet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d0388a50-951a-34d9-92c7-9c66600010a4",
                                        "entry_id": "874a2ba2-0163-3f72-8c90-2d618959c697",
                                        "glosses": [
                                            "durch Diagnose bestimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d18b06b9-17bf-4e33-8700-1801f9ef724e",
                                                "sense_id": "d0388a50-951a-34d9-92c7-9c66600010a4",
                                                "text": "So sollen die Aufnahmediagnose und andere diagnostische Befunde, der Operationsbericht, Auszüge aus dem Pflegebericht, der Entlassungsbrief und auch nach der Entlassung aus dem Spital eingelangte Befunde an die Versicherungen übermittelt werden."
                                            },
                                            {
                                                "example_id": "91463ba9-c86a-4acb-9ac3-8bd852cf16b1",
                                                "sense_id": "d0388a50-951a-34d9-92c7-9c66600010a4",
                                                "text": "Als die Männer später Tumoren entwickelten, dämmerte dem Jungforscher, daß die merkwürdigen Gebilde Vorboten von Hodenkrebs sind. Heute gilt jene Entdeckung als diagnostisches Anzeichen einer sich anbahnenden Erkrankung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ba3d2ab-dd6c-4b0f-841d-d0d99d80cb54",
                        "source_entry_id": "7ef9098e-15d1-3fad-b133-1402b7a74101",
                        "source_sense_id": "0746a866-a068-3c4f-ac2e-2d6f5f3795d6",
                        "target_lang_word": "Diagnose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diagnose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                        "entry_id": "cffa958a-a7c3-3b1e-b61b-6c8f30cbeca9",
                                        "glosses": [
                                            "Bestimmung einer körperlichen oder psychischen Krankheit durch einen Arzt oder Psychotherapeuten; in Berufen der Gesundheit (Arzt, Pfleger, Physiotherapeut, Psychologe) die genaue Zuordnung von Befunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c613385-19d1-4da5-bd43-b5a8172a5234",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "Der Befund der Bluttests führte zu einer unheilvollen Diagnose."
                                            },
                                            {
                                                "example_id": "a733e154-a675-4ec5-96bd-9d511031b3e3",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "Den Vorwürfen der Anklagevertreter, der frühere Chefarzt und Klinikleiter habe eine unzureichende Diagnose gestellt und Fehler bei der Operation begangen, folgte das Gericht nicht."
                                            },
                                            {
                                                "example_id": "d142e99d-1669-403e-a4d9-56e8a227be18",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "„Ich würde die Diagnose gerne geheim halten.“"
                                            },
                                            {
                                                "example_id": "50002ee7-9bf9-41c1-b9cf-c864c21c1f46",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "„Diskussionen über die Diagnose helfen weder ihm noch seinem Patienten.“"
                                            },
                                            {
                                                "example_id": "ef141cdf-7632-4952-898c-26a160b482d5",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "„Zwischen ihnen stand die Gräfin Bellin als La Vallière, mit dem Gesicht eines gefallenen Engels und vielen Rubinen; Ravic erinnerte sich, ihr vor einem Jahr die Eierstöcke operiert zu haben – auf eine Diagnose Durants hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                        "entry_id": "cffa958a-a7c3-3b1e-b61b-6c8f30cbeca9",
                                        "glosses": [
                                            "Zuordnung eines Phänomens zu einer Kategorie"
                                        ],
                                        "tags": [
                                            "im weiteren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "866b33dd-7e6b-4779-9387-571a611ee1a3",
                                                "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                                "text": "Führe bitte eine Diagnose des Netzwerkes durch."
                                            },
                                            {
                                                "example_id": "6b013faf-8479-4523-bd6d-c0d7d7e67d6b",
                                                "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                                "text": "„Doch die Diagnose muss in keinem Desaster enden.“"
                                            },
                                            {
                                                "example_id": "4f056e09-a136-4dba-9e20-dfc3ec1a8a98",
                                                "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                                "text": "„Er sah mich scharf an, als wolle er die Diagnose meiner Leidenschaft stellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
