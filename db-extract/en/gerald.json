                        "sense_id": "6f6a19c2-074b-3715-b86e-bc8d540d471d",
                        "entry_id": "af146e9e-13f2-392c-9d96-7e1290888e35",
                        "glosses": [
                            "A male given name from the Germanic languages."
                        ],
                        "tags": [
