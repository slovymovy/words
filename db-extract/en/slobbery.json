                        "glosses": [
                            "Wet and slimy, containing slobber, having the consistency of slobber."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ac2eec-4ff7-46a0-bf2b-74020001b2dc",
                                "sense_id": "b87208a3-7123-38c0-9d43-e83357e7adb9",
                                "text": "He placed one paw on my right thigh and planted a slobbery dog kiss on my cheek.\n\"Well! Make yourself at home, why don't you?\" I joked."
                            },
                            {
                                "example_id": "d6e25566-687a-4c01-a7a0-50c418cab688",
                                "sense_id": "b87208a3-7123-38c0-9d43-e83357e7adb9",
                                "text": "2004, Susan Johnson - The Broken Book page 25.\nMy own lips are slobbery suckers, the bane of my life, the subject of teasing by Peggy Gordon, who has recently taken to calling me Lubra Lips."
                            }
                        ]
                    }
                ],
