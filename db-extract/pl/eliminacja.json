                                                "sense_id": "b8f6a533-69bc-3f98-8d69-dece08e79ed4",
                                                "text": "Die Elimination ist ein Verfahren, das mit Äquivalenzumformungen ein beliebiges System auf die Dreiecksform bringt."
                                            }
