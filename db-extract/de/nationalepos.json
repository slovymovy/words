                "senses": [
                    {
                        "sense_id": "a9f06371-2085-3424-9008-ab7d5e463394",
                        "entry_id": "fb67414e-5262-3abc-b51a-bfe0ae6ff3c7",
                        "glosses": [
                            "ein Epos, mit dem sich eine Nation identifiziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bf150d7-4d3f-487c-a893-f2aef4279e1b",
                                "sense_id": "a9f06371-2085-3424-9008-ab7d5e463394",
                                "text": "„Auf der dringenden Suche nach gemeinschaftsstiftenden Symbolen erlangte nun das Nibelungenlied den Rang eines Nationalepos.“"
                            },
                            {
                                "example_id": "0f10a101-7d24-4691-a803-0f80186c9720",
                                "sense_id": "a9f06371-2085-3424-9008-ab7d5e463394",
                                "text": "„Nationale Kreise hatten im 19. Jahrhundert das »Nibelungenlied«, das freilich mit einem monströsen Gemetzel endet, sogar zum deutschen Nationalepos erhoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
