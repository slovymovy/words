                "senses": [
                    {
                        "sense_id": "a0130c80-7602-35e8-bdfb-dade41fab70a",
                        "entry_id": "5b5e4b7a-ef47-3d15-ac40-5e8a94f578d2",
                        "glosses": [
                            "te werk gaan, bewust handelen"
                        ],
                        "tags": [
                            "absolute",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9f9ede6f-c15f-489f-8cae-46d697ed1a5f",
                                "sense_id": "a0130c80-7602-35e8-bdfb-dade41fab70a",
                                "text": "Hij heeft donderdag gespeeld, een trap gekregen en is daar nog niet helemaal van hersteld. Manchester City hoeft geen schrik te hebben dat we op een onverantwoorde manier met hem zullen omspringen."
                            },
                            {
                                "example_id": "fb29f13e-10e4-4d09-977a-fdf639b7e08d",
                                "sense_id": "a0130c80-7602-35e8-bdfb-dade41fab70a",
                                "text": "Een nieuwe facebookpagina helpt studenten aan de Universiteit Antwerpen (UA) snel aan onenightstands. Woordvoerder Peter De Meyer van de UA zegt dat de universiteit weinig tegen zulke facebookpagina's kan doen: ,,We kunnen alleen maar hopen dat onze studenten er verstandig mee omspringen.\" De oprichter van 'UAntwerpen FWB' heeft door de commotie de pagina tijdelijk offline gehaald."
                            }
                        ]
                    }
