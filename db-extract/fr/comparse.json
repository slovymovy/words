                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3ec22969-2757-3863-bea0-48ea73f1ad7e",
                        "entry_id": "2033fe91-0196-3354-be54-1b00615ad949",
                        "glosses": [
                            "Personne qui prend part dans une affaire (souvent illicite, mais pas forcément), dans une société…"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0eafb77e-1c5c-48fb-b244-837758f5d0a5",
                                "sense_id": "3ec22969-2757-3863-bea0-48ea73f1ad7e",
                                "text": "« Et surtout, on a compris le plaisir coupable que donne la transe, pour certaines musiques connotées ultrakitsch, que tout le monde adore », ajoute son comparse."
                            },
                            {
                                "example_id": "2ae40ba4-6b44-47d9-ad23-65117a6f45eb",
                                "sense_id": "3ec22969-2757-3863-bea0-48ea73f1ad7e",
                                "text": "Il n'était qu'un comparse à appointements fixes."
                            },
                            {
                                "example_id": "50a96d68-27fe-4fd9-a3f8-363fcf8bce2f",
                                "sense_id": "3ec22969-2757-3863-bea0-48ea73f1ad7e",
                                "text": "Le parquet de Basse-Terre vient de le renvoyer devant le tribunal, en compagnie de six comparses, pour détournement de fonds publics, favoritisme et blanchiment."
                            },
                            {
                                "example_id": "4973af0c-f6b1-41e7-b454-0764c1ad4edd",
                                "sense_id": "3ec22969-2757-3863-bea0-48ea73f1ad7e",
                                "text": "Le Balafré a rangé son arme dans sa poche, mais son comparse nous tenait toujours en joue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cbddcf3-7059-407b-b51d-29582a9339ed",
                        "source_entry_id": "2033fe91-0196-3354-be54-1b00615ad949",
                        "target_lang_word": "Komparse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Komparse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9e9a9cc-7caa-31a6-85fc-56ffc5fbab72",
                                        "entry_id": "11251051-fe54-3420-90d9-9adf359aa675",
                                        "glosses": [
                                            "Darsteller, vor allem in einem Film oder einem Theaterstück, welcher keine tragende Rolle spielt und oftmals gänzlich stumm bleibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f41ba87-d651-481f-be48-86a4a63ccfc7",
                                                "sense_id": "f9e9a9cc-7caa-31a6-85fc-56ffc5fbab72",
                                                "text": "In Soaps gibt es viele Komparsen."
                                            },
                                            {
                                                "example_id": "90367eb1-7f69-4665-b839-0a1f53339d82",
                                                "sense_id": "f9e9a9cc-7caa-31a6-85fc-56ffc5fbab72",
                                                "text": "„Noch ist das Herzstück des Hauptstadtflughafens eine Baustelle. Rund 10000 Komparsen testen bis Mai das Konzept der kurzen Wege — vom Check-in über die Sicherheitskontrolle bis zum Boarding.“"
                                            },
                                            {
                                                "example_id": "d6852717-c608-47e0-87b2-ad6327baa097",
                                                "sense_id": "f9e9a9cc-7caa-31a6-85fc-56ffc5fbab72",
                                                "text": "„Ich war auch einmal Komparse gewesen und habe vor langer Zeit auf dem Babelsberger Gelände in einem amerikanischen Film mitgespielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d30626f5-8bcf-4ea8-b4f4-83059498f57f",
                        "source_entry_id": "2033fe91-0196-3354-be54-1b00615ad949",
