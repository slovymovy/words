{
    "word_family": [
        "over"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bc818fd5-0bd4-387b-9142-1bad5f66a6fc",
                    "sense_definition": "To an excessive degree; more than is normal, necessary, or desirable.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "degree_excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parents can be <w>overly</w> protective of their children.",
                            "target_lang_translations": {
                                "ru": "Родители могут быть <w>чрезмерно</w> опекающими по отношению к своим детям.",
                                "de": "Eltern können <w>allzu</w> beschützend gegenüber ihren Kindern sein."
                            }
                        },
                        {
                            "text": "The instructions for the device were <w>overly</w> complex and difficult to follow.",
                            "target_lang_translations": {
                                "ru": "Инструкции к устройству были <w>слишком</w> сложными и трудными для выполнения.",
                                "de": "Die Anweisungen für das Gerät waren <w>übermäßig</w> komplex und schwer zu befolgen."
                            }
                        }
                    ],
                    "synonyms": [
                        "excessively",
                        "too",
                        "superfluously"
                    ],
                    "antonyms": [
                        "insufficiently",
                        "moderately"
                    ],
                    "common_phrases": [
                        "overly protective",
                        "overly sensitive",
                        "overly complex",
                        "overly critical"
                    ],
                    "target_lang_definitions": {
                        "ru": "В чрезмерной степени; больше, чем нормально, необходимо или желательно.",
                        "de": "In einem übermäßigen Grad; mehr als normal, notwendig oder wünschenswert."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чрезмерно",
                                "target_lang_sense_clarification": "формальный вариант, указывающий на превышение меры"
                            },
                            {
                                "target_lang_word": "слишком",
                                "target_lang_sense_clarification": "наиболее употребительный вариант"
                            },
                            {
                                "target_lang_word": "излишне",
                                "target_lang_sense_clarification": "указывает на ненужность такого количества или степени"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "allzu",
                                "target_lang_sense_clarification": "verstärktes 'zu', drückt ein Übermaß aus"
                            },
                            {
                                "target_lang_word": "übermäßig",
                                "target_lang_sense_clarification": "über das übliche Maß hinausgehend"
                            },
                            {
                                "target_lang_word": "zu",
                                "target_lang_sense_clarification": "allgemeiner Ausdruck für ein Übermaß"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a26e4de-589e-3b51-af3e-9418edd33d4b",
                    "sense_definition": "To a high degree; very (typically used in negative statements to express a lack of enthusiasm or intensity).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "degree_excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'm not <w>overly</w> enthusiastic about meeting him after what happened last time.",
                            "target_lang_translations": {
                                "ru": "Я не <w>особо</w> горю желанием встречаться с ним после того, что случилось в прошлый раз.",
                                "de": "Ich bin nicht <w>besonders</w> begeistert davon, ihn nach dem, was letztes Mal passiert ist, zu treffen."
                            }
                        },
                        {
                            "text": "She was not <w>overly</w> keen on the idea of moving to a new city.",
                            "target_lang_translations": {
                                "ru": "Она была не <w>слишком</w> увлечена идеей переезда в новый город.",
                                "de": "Sie war nicht <w>sonderlich</w> angetan von der Idee, in eine neue Stadt zu ziehen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "not overly enthusiastic",
                        "not overly keen",
                        "not overly concerned",
                        "not overly fond"
                    ],
                    "target_lang_definitions": {
                        "ru": "В высокой степени; очень (обычно используется в отрицательных конструкциях для выражения сдержанности).",
                        "de": "In hohem Maße; sehr (wird meist in verneinten Sätzen verwendet, um Zurückhaltung auszudrücken)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "особо",
                                "target_lang_sense_clarification": "используется в сочетании с «не» (не особо)"
                            },
                            {
                                "target_lang_word": "слишком",
                                "target_lang_sense_clarification": "используется в сочетании с «не» (не слишком)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "besonders",
                                "target_lang_sense_clarification": "in Verbindung mit 'nicht' (nicht besonders)"
                            },
                            {
                                "target_lang_word": "sonderlich",
                                "target_lang_sense_clarification": "gehoben, in Verbindung mit 'nicht' (nicht sonderlich)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37df1877-c011-3c79-813b-cbf90ab5214a",
                    "sense_definition": "Superficially; without thoroughness or deep attention.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "superficiality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He prayeth but with an <w>overly</w> desire, lacking true devotion.",
                            "target_lang_translations": {
                                "ru": "Он молится, но с <w>поверхностным</w> желанием, лишенным истинной набожности.",
                                "de": "Er betet, aber mit einem <w>oberflächlichen</w> Verlangen, dem es an wahrer Hingabe fehlt."
                            }
                        },
                        {
                            "text": "The wound was healed <w>overly</w>, leaving the infection deep inside.",
                            "target_lang_translations": {
                                "ru": "Рана зажила <w>поверхностно</w>, оставив инфекцию глубоко внутри.",
                                "de": "Die Wunde war <w>oberflächlich</w> verheilt, wobei die Infektion tief im Inneren blieb."
                            }
                        }
                    ],
                    "antonyms": [
                        "thoroughly"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Found in older texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поверхностно; без тщательности или глубокого внимания (устаревшее значение).",
                        "de": "Oberflächlich; ohne Gründlichkeit oder tiefe Aufmerksamkeit (veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поверхностно",
                                "target_lang_sense_clarification": "без глубины или тщательности"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "oberflächlich",
                                "target_lang_sense_clarification": "ohne Tiefgang oder Sorgfalt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "679ec42b-e340-3c6e-90f4-1008d441d158",
                    "sense_definition": "Excessive; too great.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "degree_excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>overly</w> resentments prevented him from forgiving his old friend.",
                            "target_lang_translations": {
                                "ru": "Его <w>чрезмерные</w> обиды мешали ему простить старого друга.",
                                "de": "Seine <w>übermäßigen</w> Ressentiments hinderten ihn daran, seinem alten Freund zu verzeihen."
                            }
                        },
                        {
                            "text": "The <w>overly</w> burden of the tax caused unrest among the citizens.",
                            "target_lang_translations": {
                                "ru": "<w>Непомерное</w> бремя налога вызвало волнения среди граждан.",
                                "de": "Die <w>übermäßige</w> Steuerlast verursachte Unruhe unter den Bürgern."
                            }
                        }
                    ],
                    "antonyms": [
                        "insufficient"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used as an adjective in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерный; слишком большой (устаревшее использование в качестве прилагательного).",
                        "de": "Übermäßig; zu groß (veraltete Verwendung als Adjektiv)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чрезмерный",
                                "target_lang_sense_clarification": "превышающий меру"
                            },
                            {
                                "target_lang_word": "непомерный",
                                "target_lang_sense_clarification": "очень большой, тяжелый"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "übermäßig",
                                "target_lang_sense_clarification": "das normale Maß überschreitend"
                            },
                            {
                                "target_lang_word": "übertrieben",
                                "target_lang_sense_clarification": "über das angemessene Maß hinausgehend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c466c608-466f-3195-8155-1f6ca1099614",
                    "sense_definition": "Superficial; not thorough; careless or negligent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "superficiality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made an <w>overly</w> request, not expecting a serious answer.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>небрежный</w> запрос, не ожидая серьезного ответа.",
                                "de": "Er stellte eine <w>oberflächliche</w> Anfrage, ohne eine ernsthafte Antwort zu erwarten."
                            }
                        },
                        {
                            "text": "With an <w>overly</w> glance, he dismissed the document without reading it.",
                            "target_lang_translations": {
                                "ru": "Бросив <w>беглый</w> взгляд, он отложил документ, не читая его.",
                                "de": "Mit einem <w>oberflächlichen</w> Blick tat er das Dokument ab, ohne es zu lesen."
                            }
                        }
                    ],
                    "antonyms": [
                        "thorough"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поверхностный; нетщательный; небрежный (устаревшее использование в качестве прилагательного).",
                        "de": "Oberflächlich; nicht gründlich; nachlässig (veraltete Verwendung als Adjektiv)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поверхностный",
                                "target_lang_sense_clarification": "неглубокий"
                            },
                            {
                                "target_lang_word": "беглый",
                                "target_lang_sense_clarification": "быстрый и невнимательный (о взгляде)"
                            },
                            {
                                "target_lang_word": "небрежный",
                                "target_lang_sense_clarification": "сделанный кое-как"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "oberflächlich",
                                "target_lang_sense_clarification": "nicht in die Tiefe gehend"
                            },
                            {
                                "target_lang_word": "nachlässig",
                                "target_lang_sense_clarification": "ohne die nötige Sorgfalt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}