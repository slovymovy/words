                                "target_senses": [
                                    {
                                        "sense_id": "2eadde13-bc63-3331-b433-fecd49e90c5a",
                                        "entry_id": "018e6f7d-0152-3853-bff1-89b0ef9b1f40",
                                        "glosses": [
                                            "eine in einem Krieg Besiegten oder Unterlegenen auferlegte Geld-, Sach- oder Arbeitsleistungen als Wiedergutmachung von Kriegsschäden"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49f23c28-42ec-49ec-bdce-b2607c174516",
                                                "sense_id": "2eadde13-bc63-3331-b433-fecd49e90c5a",
                                                "text": "Auf Grund des Kriegsschuldartikels 231 des Versailler Vertrages musste Deutschland nach dem Ersten Weltkrieg Reparationen zahlen."
                                            },
                                            {
                                                "example_id": "a7421002-db65-4c43-86a7-27b6398abc89",
                                                "sense_id": "2eadde13-bc63-3331-b433-fecd49e90c5a",
                                                "text": "„Repressalien und Reparationen wurden zu Worten des Alltags.“"
                                            },
                                            {
                                                "example_id": "e24f071a-c529-49c6-ae43-ca6262516a36",
                                                "sense_id": "2eadde13-bc63-3331-b433-fecd49e90c5a",
                                                "text": "„Deutschland sollte entwaffnet und entmilitarisiert werden; es würde Gebietsverluste im Osten hinnehmen und Reparationen zahlen müssen; seine Industrie sollte unter Kontrolle gestellt werden.“"
                                            },
                                            {
                                                "example_id": "bca27451-e1ce-4db7-9c51-022a53b525ad",
                                                "sense_id": "2eadde13-bc63-3331-b433-fecd49e90c5a",
                                                "text": "„Seit Jahrzehnten streiten beide Länder um Reparationen für die Zerstörungen der Kriegsjahre und die Gräueltaten der Besatzer.“"
                                            },
                                            {
                                                "example_id": "d74bb22a-69df-4374-b770-36397113cdb4",
                                                "sense_id": "2eadde13-bc63-3331-b433-fecd49e90c5a",
                                                "text": "„Selbst die Reparationen, die Deutschland an Israel gezahlt hat, waren freiwillig und rein symbolisch: Israel wollte das Geld nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4716102f-23b6-45f4-9125-6f63525b7ce9",
                        "source_entry_id": "25282932-331a-33f1-b86a-c66c413eb98a",
                        "target_lang_word": "repair",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4951c89-768f-3ae0-9f56-99e048e8c216",
                                        "entry_id": "f38eb192-55d2-3ca8-a088-936f6ebd8e4f",
                                        "glosses": [
                                            "To restore to good working order, fix, or improve damaged condition; to mend; to remedy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a8c8e6a-8643-4e44-af61-138ef02de42a",
                                                "sense_id": "b4951c89-768f-3ae0-9f56-99e048e8c216",
                                                "text": "to repair a house, a road, a shoe, a ship"
                                            },
                                            {
                                                "example_id": "bb37ecaf-1c22-461e-8bb2-5d2a6e6ead7e",
                                                "sense_id": "b4951c89-768f-3ae0-9f56-99e048e8c216",
                                                "text": "to repair a shattered fortune"
                                            },
                                            {
                                                "example_id": "16a5c765-8e97-441d-9334-43c70bfb4226",
                                                "sense_id": "b4951c89-768f-3ae0-9f56-99e048e8c216",
                                                "text": "Secret refreſhings, that repair his ſtrength,"
                                            },
                                            {
                                                "example_id": "ef395da4-26e5-47ab-b3e6-d73ca9fdde32",
                                                "sense_id": "b4951c89-768f-3ae0-9f56-99e048e8c216",
                                                "text": "Do thou, as thou art wont, repair / My heart with gladness,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4b87ffc-2a0a-334a-9542-ad276516cd47",
                                        "entry_id": "f38eb192-55d2-3ca8-a088-936f6ebd8e4f",
                                        "glosses": [
                                            "To make amends for, as for an injury, by an equivalent; to indemnify for."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09fc380b-070b-4a67-98f6-ad67e9cf8472",
                                                "sense_id": "c4b87ffc-2a0a-334a-9542-ad276516cd47",
                                                "text": "to repair a loss or damage"
                                            },
                                            {
                                                "example_id": "bbd2a1ef-72a9-47d2-a1b0-6a5d28d46372",
                                                "sense_id": "c4b87ffc-2a0a-334a-9542-ad276516cd47",
                                                "text": "I'll repair the misery thou dost bear."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df996c3c-2731-3f15-8c32-112698eba53b",
                                        "entry_id": "d8fa468e-3a19-3f05-9aab-c55fb2b49efd",
                                        "glosses": [
                                            "The act of repairing something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97f52848-ac7b-4d1c-b653-21839a639b21",
                                                "sense_id": "df996c3c-2731-3f15-8c32-112698eba53b",
                                                "text": "I took the car to the workshop for repair."
                                            },
                                            {
                                                "example_id": "577ed84c-3f62-4bb2-b97a-b6bdf43596f1",
                                                "sense_id": "df996c3c-2731-3f15-8c32-112698eba53b",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains.[…]But out of sight is out of mind. And that[…]means that many old sewers have been neglected and are in dire need of repair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69d6a5f8-744d-378b-837f-bcf114fa6518",
                                        "entry_id": "d8fa468e-3a19-3f05-9aab-c55fb2b49efd",
                                        "glosses": [
                                            "The result of repairing something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f60c3fa-f0b3-418a-8ece-64d1c0a85e00",
                                                "sense_id": "69d6a5f8-744d-378b-837f-bcf114fa6518",
                                                "text": "If you look closely you can see the repair in the paintwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa60c0bf-19c8-39d0-9832-e5d11eef068a",
                                        "entry_id": "d8fa468e-3a19-3f05-9aab-c55fb2b49efd",
                                        "glosses": [
                                            "The condition of something, in respect of need for repair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65fb6f98-1f32-4eac-a1f2-8f72bd6fbcde",
                                                "sense_id": "aa60c0bf-19c8-39d0-9832-e5d11eef068a",
                                                "text": "The car was overall in poor repair before the accident. But after the workshop had it for three weeks it was returned in excellent repair. But the other vehicle was beyond repair."
                                            },
                                            {
                                                "example_id": "5860990d-721d-4e74-99ed-1a022244f192",
                                                "sense_id": "aa60c0bf-19c8-39d0-9832-e5d11eef068a",
                                                "text": "The 1300 class (Nos. 1301-16), one of which was damaged beyond repair in an accident, are Co-Cos, weigh 111 tons and have a top speed of 85 m.p.h."
                                            },
                                            {
                                                "example_id": "8f547bda-5b51-43d2-a5e2-d9c06e084887",
                                                "sense_id": "aa60c0bf-19c8-39d0-9832-e5d11eef068a",
                                                "text": "Thirteen houses were damaged beyond repair, and much of the rest of the town suffered broken windows and lost slates."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f268b5a-2260-37eb-aabc-df71f0b00f5f",
                                        "entry_id": "78c2ad75-b8f8-3b7b-b9a2-298a4549b860",
                                        "glosses": [
                                            "The act of repairing or resorting to a place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698ebb84-8861-452c-b01b-c49c825ce9aa",
                                                "sense_id": "6f268b5a-2260-37eb-aabc-df71f0b00f5f",
                                                "text": "our annual repair to the mountains"
                                            },
                                            {
                                                "example_id": "2bb3ac8f-b878-4b8a-bb45-600ec57fd627",
                                                "sense_id": "6f268b5a-2260-37eb-aabc-df71f0b00f5f",
                                                "text": "The king sent a proclamation for their repair to their houses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19215261-e4b1-37cf-bb1a-fd08b7013b1b",
                                        "entry_id": "78c2ad75-b8f8-3b7b-b9a2-298a4549b860",
                                        "glosses": [
                                            "A place to which one goes frequently or habitually; a haunt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e2bfa4-5ebd-417b-8527-c0318473c71e",
                                                "sense_id": "19215261-e4b1-37cf-bb1a-fd08b7013b1b",
                                                "text": "There the fierce winds his tender force assail / And beat him downward to his first repair."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                        "entry_id": "c1c2cb22-7dc8-3f76-bd98-74cc715eaaa9",
                                        "glosses": [
                                            "To transfer oneself to another place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd63b5b5-0284-4eb7-86fd-2019f2b53435",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "to repair to sanctuary for safety"
                                            },
                                            {
                                                "example_id": "634baa8b-6cfd-4450-87bb-6b15f8ac8d10",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "Go, mount the winds, and to the shades repair."
                                            },
                                            {
                                                "example_id": "7ba70db4-d82a-4349-8113-55de37bfd133",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "At the hour of half-past five we repaired to our engagement."
                                            },
                                            {
                                                "example_id": "04f8bacb-1584-430d-93cc-2c0164387cad",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "At a late hour, after I had been in bed some time, I heard the visitors repair to their chambers:"
                                            },
                                            {
                                                "example_id": "bebd7996-5282-42ff-990c-31562f212dd0",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "That finished, I repaired to my room, one flight up, and, after a thorough wash, seated myself, pipe in mouth, at the little window that opened on the Rue Garde."
                                            },
                                            {
                                                "example_id": "bbfb0806-0805-4466-a774-ef49039d5eb2",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "[...] the train engine uncouples and either backs on to the up through line to await its next duty or repairs to the motive power depot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b696eb7-78a5-32a2-97da-8db273dcbe34",
                                        "entry_id": "61ab0ea4-6e91-335f-b151-44430bd2d1df",
                                        "glosses": [
                                            "To pair again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1786c45-30ba-44e1-bd0b-b6755609b7a1",
                                                "sense_id": "5b696eb7-78a5-32a2-97da-8db273dcbe34",
                                                "text": "Please try to repair the two earbuds to each other. Place both earbuds back into the charging case, wait for four seconds, then open it and see if they have been repaired with one another."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "848c6688-c29f-4e8d-85e1-a42545718fa4",
                        "source_entry_id": "25282932-331a-33f1-b86a-c66c413eb98a",
                        "target_lang_word": "réparation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réparation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Action de réparer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbe3c3a2-3b2f-4113-911c-274f26eb0a5e",
                                                "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                                "text": "Les arrêts sont en effet plus fréquents au renvideur par suite des réparations, remplacements de cordes et de câbles et nettoyages plus difficultueux."
                                            },
                                            {
                                                "example_id": "0b8609af-6ff7-4154-87eb-117cc6f10074",
                                                "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                                "text": "Sur l’établi du charpentier, un pied de chaise en réparation gisait à côté du ciseau qui ne l’avait qu’entamé […]"
                                            },
                                            {
                                                "example_id": "29877759-8ec8-4aac-a329-7e8f03bbb26d",
                                                "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                                "text": "Au jour, j’inspecte minutieusement les avaries et consolide les réparations provisoires de la nuit."
                                            },
                                            {
                                                "example_id": "2a5d13b4-5cec-4564-b42c-a21b73ae93ad",
                                                "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                                "text": "La performance du réparateur d’électroménager n'en est une qu’au regard du temps qu'il passe pour effectuer sa réparation."
                                            },
                                            {
                                                "example_id": "061a0b5e-e36c-4296-9d30-de8edad1f7a1",
                                                "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                                "text": "Ici aussi, on vivait de la récup, de la réparation d’appareils usagés, de la vente de métaux. Des coups de marteau s'élevaient derrière des palissades formées de frigos ou de congélateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ae24601-9370-3ed5-a900-0475aa227493",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Travaux d’entretien et de maintenance que l’on fait aux bâtisses."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b871b60-c883-46a0-937a-961b4d300807",
                                                "sense_id": "0ae24601-9370-3ed5-a900-0475aa227493",
                                                "text": "Les habitants de Bessancourt demandent qu'ils ne soient plus chargés de payer la reconstruction et les grosses réparations de l'église, du presbytère, du vicariat et des maisons du maître et de la maîtresse d'école, […]."
                                            },
                                            {
                                                "example_id": "732c16e6-074d-451b-b015-d2589cbc3ede",
                                                "sense_id": "0ae24601-9370-3ed5-a900-0475aa227493",
                                                "text": "La commune d’Épineau-les-Voves, sur le territoire de laquelle sont bâties deux églises, demande que les matériaux de celle que le district de Joigny vient de mettre en vente au profit de la Nation soient employés aux réparations de l’autre […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa3db1ea-4acf-3868-a622-6972082876df",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Correction d’une défectuosité d’un produit, mais sans garantir la conformité avec les spécifications (contrairement à la reprise)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53bb856c-e30c-4644-ada6-d4eb6de2aad6",
                                                "sense_id": "fa3db1ea-4acf-3868-a622-6972082876df",
                                                "text": "Si un circuit ne satisfait pas aux tests à 100%, il devra être écarté du lot et la fiche de suivi des tests mise à jour (numéro de la carte défectueuse, raison du rejet). Aucune réparation de PCB n’est autorisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f9d035b-996b-3768-b176-d4060bda2336",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Exercice collectif d'entretien de la mémoire de ce que l'on a appris."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c982546e-0eb0-44a7-bcff-c664081ae0d0",
                                                "sense_id": "1f9d035b-996b-3768-b176-d4060bda2336",
                                                "text": "Les exercices pour apprendre étaient la réparation et la dispute. Par la réparation les écoliers se recordaient mutuellement l'objet de la leçon exposée , jusqu'à ce qu'ils fussent en état de la répéter tous à peu près dans les mêmes termes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed31048b-8aae-33a2-ab2a-9ddbe44a3d63",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Acte de corriger ce qui a été dit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Compensation ou dédommagement pour un préjudice, une injure ou une offense faite à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a601431-a80e-48fe-8877-23362b793996",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Réparation d’honneur."
                                            },
                                            {
                                                "example_id": "6dbccf48-1975-4434-8699-ba0bfb44297a",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Faire réparation à quelqu’un."
                                            },
                                            {
                                                "example_id": "fe8395ab-92c5-4f72-82f3-51c765bc9093",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Accepter, refuser la réparation."
                                            },
                                            {
                                                "example_id": "a2217edd-3ad4-4746-8ce9-07665d82ae26",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Réparation par les armes."
                                            },
                                            {
                                                "example_id": "d59d9f46-4ffc-451d-8f69-216fb456c9e9",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Elle pleura longtemps. Ces larmes étaient comme une réparation d’honneur qu’elle se faisait à elle-même."
                                            },
                                            {
                                                "example_id": "e528fa9e-af44-4746-aaae-3341798962c3",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Manicamp. – Sais-tu qu’il serait en droit de me demander une réparation ?… nous pourrions croiser le fer."
                                            },
                                            {
                                                "example_id": "63f77810-c3d2-4757-a939-c750d84b050e",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "En cas de cessation de ses relations avec le mandant, l’agent commercial a droit à une indemnité compensatrice en réparation du préjudice subi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec996ad8-a7c3-3aa9-a196-470fc8864086",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Sommes adjugées par un tribunal pour un dédommagement"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d798647-9bae-3590-9088-98b95c2c9ed1",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Remboursement des dommages de guerre, après la Première Guerre mondiale."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57193ea1-aa23-46df-a842-d897cbd6a8bf",
                                                "sense_id": "5d798647-9bae-3590-9088-98b95c2c9ed1",
                                                "text": "La question des réparations."
                                            },
                                            {
                                                "example_id": "9b8423cb-e0fc-4751-be25-1b1c8351e9e8",
                                                "sense_id": "5d798647-9bae-3590-9088-98b95c2c9ed1",
                                                "text": "La Commission des réparations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
