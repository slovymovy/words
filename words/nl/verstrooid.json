                    "sense_definition": "niet met de aandacht bij de huidige situatie zijn",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verstrooide</w> professor kon zijn sleutels nergens meer vinden.",
                            "target_lang_translations": {
