                    {
                        "translation_id": "3fe46446-b150-4a5b-a23b-6abd54acbe1a",
                        "source_entry_id": "d3e3b4b8-a76d-3667-be9d-60e29518b11e",
                        "source_sense_id": "6c28e5b8-e401-3966-a71b-27024b6249be",
                        "target_lang_word": "Wikinger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wikinger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73c19fe3-c224-3a40-993f-5177da154e19",
                                        "entry_id": "99697532-ab97-3377-9e17-1bee6c10d12e",
                                        "glosses": [
                                            "Angehöriger eines germanischen Volksstammes des Nord-Ostseeraums in der Wikingerzeit"
                                        ],
                                        "tags": [
                                            "im weiteren Sinn"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "673d8757-ba3c-3553-b234-a97d67e110e4",
                                        "entry_id": "99697532-ab97-3377-9e17-1bee6c10d12e",
                                        "glosses": [
                                            "skandinavischer Strand- und Seeräuber des frühen Mittelalters"
                                        ],
                                        "tags": [
                                            "im engeren Sinn"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "850324da-ea4a-3499-8a8e-2bddc960a6d1",
                                        "entry_id": "99697532-ab97-3377-9e17-1bee6c10d12e",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "542f2d3e-0df8-4240-a644-8f2030c2edbb",
                                                "sense_id": "850324da-ea4a-3499-8a8e-2bddc960a6d1",
                                                "text": "Im 9. Jahrhundert waren die Wikinger wegen ihrer Plünderungen in ganz Westeuropa gefürchtet."
                                            },
                                            {
                                                "example_id": "22fabaf9-46c4-4d76-97bd-5c8f82f2384b",
                                                "sense_id": "850324da-ea4a-3499-8a8e-2bddc960a6d1",
                                                "text": "„Im Gegenteil, ein Mundart-Wortschatz ist erst dann vollständig, wenn ein Sprecher über Männer beziehungsweise Frauen herziehen kann wie ein Wikinger über ein Nonnenkloster.“"
                                            },
                                            {
                                                "example_id": "05bfb4d0-10a1-4aae-8e4b-40933bf67b11",
                                                "sense_id": "850324da-ea4a-3499-8a8e-2bddc960a6d1",
                                                "text": "„Dorthin zog es den Wikinger Erik den Roten.“"
                                            },
                                            {
                                                "example_id": "9211e39a-803a-45ab-bf5d-f7b2eeb02597",
                                                "sense_id": "850324da-ea4a-3499-8a8e-2bddc960a6d1",
                                                "text": "„Diese Wikinger übernahmen sehr rasch das Französische, sie sprachen es längst, als sie 1066 als Normannen nach England übersetzten und dort eine Jahrhunderte dauernde Zweisprachigkeit schufen, die aus dem Englischen auch etwas wie eine romanische Sprache machte.“"
                                            },
                                            {
                                                "example_id": "0b168842-0895-4a76-a52c-8fd1a58b2bc4",
                                                "sense_id": "850324da-ea4a-3499-8a8e-2bddc960a6d1",
                                                "text": "„Daher wurde das Vordringen der Angelsachsen und der Wikinger erleichtert.“"
                                            },
                                            {
                                                "example_id": "9bf04182-353f-4cf1-8211-3f4f32dddec2",
                                                "sense_id": "850324da-ea4a-3499-8a8e-2bddc960a6d1",
                                                "text": "„Von dort ist es nicht weit bis nach Leirvogir, wo die Wikinger an Land kamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
