        "fr-extract.jsonl": [
            {
                "entry_id": "0ce04bb8-43b4-32c4-a974-0d21294b3de8",
                "word": "retable",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc90415c-f99c-4191-bf3a-937339bca538",
                        "entry_id": "0ce04bb8-43b4-32c4-a974-0d21294b3de8",
                        "tags": [
                            "plural"
                        ],
                        "form": "retables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5acc3572-c818-3a58-9b70-1fc3b6a624de",
                        "entry_id": "0ce04bb8-43b4-32c4-a974-0d21294b3de8",
                        "glosses": [
                            "Pièce d’architecture contre laquelle est appuyé l’autel et dont le fond, placé au-dessus de l’autel, contient un tableau, un bas-relief, une statue, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9b56e8f-a293-476c-b6ef-b13a21609e45",
                                "sense_id": "5acc3572-c818-3a58-9b70-1fc3b6a624de",
                                "text": "Le Regina coeli du musicien flamand Lassus n’a-t-il pas la bonne foi, l’allure candide et baroque de certaines statues de retables ou des tableaux religieux du vieux Brueghel ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b79815b8-ebbb-3e19-9e9f-808d535814eb",
                        "entry_id": "0ce04bb8-43b4-32c4-a974-0d21294b3de8",
                        "glosses": [
                            "Tableau d’autel."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f9a772e4-1bb8-4a76-86fb-4d64a09cec51",
                                "sense_id": "b79815b8-ebbb-3e19-9e9f-808d535814eb",
                                "text": "Il n'était pas du village. C'était un peintre, le fameux Matthias Grunewald. Le peintre du retable."
                            },
                            {
                                "example_id": "2dfdd81d-6891-4a65-9753-68425bb7f933",
                                "sense_id": "b79815b8-ebbb-3e19-9e9f-808d535814eb",
                                "text": "Pour l’instant, le peintre s'installe à Tolède parce qu’à la suite de l’Expolio, il signe un contrat concernant trois retables pour l’église du monastère de Santo Domingo el Antiguo, une très belle commande, il est fou d’espoirs."
                            },
                            {
                                "example_id": "1bf1c506-a7a7-440f-be15-9b5126a30e51",
                                "sense_id": "b79815b8-ebbb-3e19-9e9f-808d535814eb",
                                "text": "Le retable de l’agneau mystique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55a690c7-763a-4048-99da-0ba873f90b24",
                        "source_entry_id": "0ce04bb8-43b4-32c4-a974-0d21294b3de8",
                        "target_lang_word": "Altarretabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altarretabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb5c8b14-8e00-3e0c-a1f9-7d8feeedf0b2",
                                        "entry_id": "53ade344-38fe-3829-b7ef-5e8e893efa62",
                                        "glosses": [
                                            "ein über oder hinter dem Altar aufgestellter oder befestigter Aufsatz, der künstlerisch ausgestaltet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0754f25a-72ee-4348-84a5-e2985c0185b9",
                                                "sense_id": "eb5c8b14-8e00-3e0c-a1f9-7d8feeedf0b2",
                                                "text": "Ein Altarretabel kann entweder direkt auf die Mensa (Tischfläche) des Altars aufgesetzt, auf einem separaten Unterbau hinter dem Altartisch aufgestellt, an der Wand hinter dem Altar befestigt ist oder auch an die Chorwand gemalt sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d87c8e2-b810-4eee-a9ae-74c9831b6f47",
                        "source_entry_id": "0ce04bb8-43b4-32c4-a974-0d21294b3de8",
                        "target_lang_word": "Retabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Retabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae84b375-10d9-3ca4-8436-aaf1dd47d0b1",
                                        "entry_id": "958c7684-261d-32ce-82d3-1cd5adde7e96",
                                        "glosses": [
                                            "ein mit Gemälden oder Skulpturen geschmückter Altaraufsatz, ursprünglich die künstlerisch gestaltete, abschließende Rückwand des Altares"
                                        ],
                                        "tags": [
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cd3050f-e73d-4f00-93cd-5f00ff8c3303",
                                                "sense_id": "ae84b375-10d9-3ca4-8436-aaf1dd47d0b1",
                                                "text": "\"Die Schmuckausstattung des Altars,… beschränkte sich ursprünglich auf die Frontseite (Antependium, Frontale) des Unterbaus. Seit dem 11. Jh. – als eine Änderung der Messliturgie zur Folge hatte, dass der Priester nicht mehr von Angesicht zu Angesicht sondern mit dem Rücken zur Gemeinde zelebrierte – wurde an der hinteren Seite des Altartisches eine künstlerisch gestaltete Rückwand, das Retabel (lateinisch: retrotabularium, retabulum = Rückwand) aufgestellt.\""
                                            },
                                            {
                                                "example_id": "2be3c346-3f4d-44ed-bf4f-7747ae714f97",
                                                "sense_id": "ae84b375-10d9-3ca4-8436-aaf1dd47d0b1",
                                                "text": "\"Besonders gewann der Gebrauch des Retabels im 13. Jahrhundert in Italien an Verbreitung, wo das Aufblühen der Malerei nicht zum wenigsten auch der Herstellung von Altarretabeln zugute kam.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e2e6131-df64-4a6f-93e2-4a781148a320",
                        "source_entry_id": "0ce04bb8-43b4-32c4-a974-0d21294b3de8",
                        "target_lang_word": "retable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
