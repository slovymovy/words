                {
                    "sense_id": "39ae7227-301a-3400-8bdd-a30bf41aefa4",
                    "sense_definition": "Considerable in size, quantity, or degree; fairly large.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "large_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity received a <w>goodly</w> sum of money from an anonymous donor.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация получила <w>изрядную</w> сумму денег от анонимного жертвователя."
                            }
                        },
                        {
                            "text": "A <w>goodly</w> number of supporters gathered in the square despite the rain.",
                            "target_lang_translations": {
                                "ru": "Несмотря на дождь, на площади собралось <w>немалое</w> количество сторонников."
                            }
                        }
                    ],
                    "synonyms": [
                        "considerable",
                        "substantial",
                        "sizable"
                    ],
                    "antonyms": [
                        "meager",
                        "paltry"
                    ],
                    "common_phrases": [
                        "goodly sum",
                        "goodly number",
                        "goodly amount"
                    ],
