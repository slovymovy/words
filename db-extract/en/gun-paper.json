                        "entry_id": "50cfed33-5bbb-3ca8-b6bb-915339687945",
                        "glosses": [
                            "Paper-pulp that has been impregnated with nitrates, used for the explosive charge in firearms."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ec8df1bb-26e2-41ab-a60b-cd328aa8477d",
                                "sense_id": "bddf048a-0eb2-39f5-b338-ecb740758af4",
                                "text": "After rolling, the gun-paper is dried at 212° Fahr., and has the appearance of a compact grayish mass."
                            },
                            {
                                "example_id": "fcb5466b-8c03-4dfd-a19a-2a7b4a6b7673",
                                "sense_id": "bddf048a-0eb2-39f5-b338-ecb740758af4",
                                "text": "In the same lecture he noticed the decomposition of gun-paper by exposure to oxygen."
                            },
                            {
                                "example_id": "7a4d68e3-b0f5-4ae9-b7e6-014b9f4dbc79",
                                "sense_id": "bddf048a-0eb2-39f5-b338-ecb740758af4",
                                "text": "Another very good material is gun-paper. which has been immersed for a few seconds in a mixture of nitric and sulphuric acids, and then washed in an abundance of water."
                            }
                        ]
                    }
