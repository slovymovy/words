                "senses": [
                    {
                        "sense_id": "ab45188c-16b2-3ae8-8958-725c5972e8b4",
                        "entry_id": "e3c920bc-ad37-3b0c-8537-fd364b5542fa",
                        "glosses": [
                            "мед., разг. ветряная оспа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f82ba46-354e-4113-a883-5a1b636aa20c",
                                "sense_id": "ab45188c-16b2-3ae8-8958-725c5972e8b4",
                                "text": "Он болел всю весну и половину лета. У него была ветрянка, прорезывались зубы."
                            },
                            {
                                "example_id": "7d31ea62-5dc4-4a34-b544-fcfb0d9cf05e",
                                "sense_id": "ab45188c-16b2-3ae8-8958-725c5972e8b4",
                                "text": "У Машутки, кроме желтухи, которая проходит, оказалась и ветрянка."
                            }
                        ]
                    }
                ],
