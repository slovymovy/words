                    {
                        "sense_id": "c6d4e711-c0eb-3e9f-b45b-fcb0056d5902",
                        "entry_id": "8f5f6256-042a-3c36-b730-0dfc7f206bca",
                        "glosses": [
                            "Conducteur de taxi-vélo, cycliste transportant une autre personne en échange d’une somme d’argent."
                        ],
                        "tags": [
                            "Congo-Kinshasa"
                        ],
                        "examples": [
                            {
                                "example_id": "9b97face-1b0e-4d0a-b0a6-5efa3a490dd0",
                                "sense_id": "c6d4e711-c0eb-3e9f-b45b-fcb0056d5902",
                                "text": "Seuls les « tolékistes » (du lingala « toleka », ou « passer »), ces cyclistes professionnels, parviennent à se faufiler dans ce dédale de routes impraticables."
                            },
                            {
                                "example_id": "2a9094f3-c036-4509-9ffa-aa225c360dbb",
                                "sense_id": "c6d4e711-c0eb-3e9f-b45b-fcb0056d5902",
                                "text": "Samy sait que maman Sylvie n’aurait jamais fait appel à un autre tolékiste que lui."
                            },
                            {
                                "example_id": "8bfc4952-d8b4-4147-8874-71fcec67ba4c",
                                "sense_id": "c6d4e711-c0eb-3e9f-b45b-fcb0056d5902",
                                "text": "Désormais, tout Tolékiste qui va circuler sur la voie publique devra avoir un macaron."
                            },
                            {
                                "example_id": "afceab7f-3489-4d82-b1be-a3bffb856100",
                                "sense_id": "c6d4e711-c0eb-3e9f-b45b-fcb0056d5902",
                                "text": "Étudiants, professeurs, chômeurs diplômés ou non, les tolékistes donnent à la ville un air de Chine populaire."
                            }
                        ]
                    }
