                "senses": [
                    {
                        "sense_id": "69f69a61-10bc-32a2-bbd7-418b3a5c439a",
                        "entry_id": "5e0f2365-401a-398c-bf5a-1e0bc66f2a6a",
                        "glosses": [
                            "deutsche Insel in der Nordsee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99548644-c11e-4861-b3fb-9c04fb67342a",
                                "sense_id": "69f69a61-10bc-32a2-bbd7-418b3a5c439a",
                                "text": "Das Seegefecht vor Helgoland wurde 1864 zwischen Dänemark und Österreich ausgetragen."
                            },
                            {
                                "example_id": "6817c728-528f-4d6c-bbb8-8a9a639d496e",
                                "sense_id": "69f69a61-10bc-32a2-bbd7-418b3a5c439a",
                                "text": "Grün ist das Land, rot ist die Kant', weiß ist der Sand, das sind die Farben von Helgoland. (Wahl- und Wappenspruch der Insel Helgoland)"
                            },
                            {
                                "example_id": "b6bc271e-3d97-4e18-8083-2b8d9a6f4f14",
                                "sense_id": "69f69a61-10bc-32a2-bbd7-418b3a5c439a",
                                "text": "„Die Nordsee hat unaufhörlich an Helgoland genagt und manchmal auch gierig zugeschlagen, wie im Jahr 1721, als die Insel durch einen Sturm endgültig in zwei Teile zerbrach.“"
                            },
                            {
                                "example_id": "6eafa2ed-bf78-4517-a2f1-24879bef44c1",
                                "sense_id": "69f69a61-10bc-32a2-bbd7-418b3a5c439a",
                                "text": "„Seit 1796 unterhielt Hamburg eine Postagentur auf Helgoland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
