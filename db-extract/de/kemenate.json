                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9773b69-23e0-36f5-a26f-aab927dd25b3",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Petite chambre à coucher, à bord d’un bateau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488fb49f-4470-4cdf-b341-1ebf3b4fbf86",
                                                "sense_id": "f9773b69-23e0-36f5-a26f-aab927dd25b3",
                                                "text": "J’écris ces lignes dans la cabine du Firecrest. Le teck et le bois d’érable brillent."
                                            },
                                            {
                                                "example_id": "fec1bdc9-ea43-4b1c-849f-88cda8eef496",
                                                "sense_id": "f9773b69-23e0-36f5-a26f-aab927dd25b3",
                                                "text": "Elle était demeurée longtemps debout devant ces hautes coques dont les hublots laissaient voir l’intérieur des cabines éclairées."
                                            },
                                            {
                                                "example_id": "c441070b-6016-43e8-908e-d2ba54f6d265",
                                                "sense_id": "f9773b69-23e0-36f5-a26f-aab927dd25b3",
                                                "text": "Le bateau était un brick-goélette de quatre-vingts tonneaux à peu près, confortablement aménagé, avec, sur le pont, trois cabines spacieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95d2319-700d-35bb-9df8-131daa690d61",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Petite chambre, chambrette, petite pièce isolée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b039eff5-9cb7-4269-a836-f17090708b0b",
                                                "sense_id": "a95d2319-700d-35bb-9df8-131daa690d61",
                                                "text": "Enfin, la pendule-réclame Guérin-Boutron, fixée près d’une cabine de téléphone, marquait une fois pour toutes la demie de minuit, en cas de contestation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cd0f8d9-469d-37f7-a3ca-e386a9b4f63a",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Espace clos aménagé dans un camion, un véhicule tracteur de semi-remorque, un train, une locomotive ou autre engin de transport, où le conducteur dispose de tous les instruments nécessaires au maniement de l’engin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b345822-0855-46e2-9eeb-04362c55da81",
                                                "sense_id": "7cd0f8d9-469d-37f7-a3ca-e386a9b4f63a",
                                                "text": "Tzvetan la regardait d’en haut depuis la cabine de son camion comme elle s’éloignait légèrement voûtée, prends soin de toi, et il démarra le moteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c1b532e-e8ae-353c-b2f1-1ef6857dc437",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Sorte de cage close dans laquelle sont transportés les utilisateurs d’un ascenseur ou d’un téléphérique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be5c6796-522a-3943-9d03-33d094bd82a1",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Espace des passagers et des bagages à main dans un avion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "304c644e-359f-4a99-8aae-979ea29a110a",
                                                "sense_id": "be5c6796-522a-3943-9d03-33d094bd82a1",
                                                "text": "L’organisation à bord des avions de moyenne capacité fait que le chef de cabine se trouve aux avant-postes, à l’avant de l’appareil, à proximité de la porte d’embarquement et du cockpit. Pour ces vols, il est le lien privilégié entre la cabine et le commandant ; tous vos petits bobos lui seront répétés (ou presque, selon l’humeur)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf4227aa-ab33-3b51-b9e1-fc6f358806ab",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Petite chambre à coucher à bord d’un aéronat."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e449bf11-059a-441a-850c-bc3becf27a05",
                                                "sense_id": "bf4227aa-ab33-3b51-b9e1-fc6f358806ab",
                                                "text": "La partie habitable mesurait deux cent cinquante pieds de long, et comprenait deux rangées de cabines superposées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a4a33e2-60c9-3ab7-be80-40487b44d99c",
                                        "entry_id": "720bedf1-0c15-3d2a-aa95-1f83533b2f05",
                                        "glosses": [
                                            "Blague reçue négativement par un groupe de plusieurs personnes."
                                        ],
                                        "tags": [
                                            "Jura"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f402b14-7345-4266-9a60-6e4558111073",
                                                "sense_id": "7a4a33e2-60c9-3ab7-be80-40487b44d99c",
                                                "text": "Cette blague n'a eu aucun effet. Ce n’est plus un bide, c’est une cabine!"
                                            }
                                        ]
                                    }
                                ]
                            },
