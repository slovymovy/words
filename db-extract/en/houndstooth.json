                                    {
                                        "sense_id": "3e301bb2-aeba-3e1b-8068-b87a483de855",
                                        "entry_id": "36850a21-c571-3e88-9b11-44d34fe985cc",
                                        "glosses": [
                                            "Motif tissé, fait de quatre fils entrecroisés de couleur sombre et claire (voir illustration)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94ce793c-cb14-4530-a105-0cb93299c370",
                                                "sense_id": "3e301bb2-aeba-3e1b-8068-b87a483de855",
                                                "text": "Un tweed en pied-de-poule."
                                            },
                                            {
                                                "example_id": "a3f6a360-b8c6-410b-96a8-eabda798682a",
                                                "sense_id": "3e301bb2-aeba-3e1b-8068-b87a483de855",
                                                "text": "J'arrivai soudain à une sorte de carrefour : le val se divisait en trois gorges qui remontaient en pied de poule jusqu'au flanc du mystérieux sommet…"
                                            },
                                            {
                                                "example_id": "e93e8d21-c79f-4bad-9717-b59e60358d56",
                                                "sense_id": "3e301bb2-aeba-3e1b-8068-b87a483de855",
                                                "text": "Et puis il y avait le Dr Reswiller, en veste pied-de-poule et polo noir, ses lunettes sur le front, ses éternelles Paraboot aux pieds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fee67c6-1760-4c98-9da5-68733e09da4e",
