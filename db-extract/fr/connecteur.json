                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faba8057-4382-4274-b4f3-9453cbb9c68a",
                                "sense_id": "a431ff94-eaf1-3ff5-bb67-c615628848a8",
                                "text": "La portion de la cellule à laquelle s’est soudé le tube connecteur reste vide ; mais elle est bientôt complètement recouverte par le développement de la masse sporifère."
                            }
