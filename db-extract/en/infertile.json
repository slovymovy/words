                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee23be2a-dbba-3dc3-8594-070c7bc5b082",
                                        "entry_id": "e52f9fb6-9b96-3c56-a46d-a11efa454804",
                                        "glosses": [
                                            "di oggetto o strumentazione che sono stati sottoposti a sterilizzazione ovvero sterilizzati"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cbfd37d-6b99-415d-9d55-e79af58ac8e9",
                                                "sense_id": "ee23be2a-dbba-3dc3-8594-070c7bc5b082",
                                                "text": "Con ancora un po' di pazienza ma comunque cordialmente, il dentista disse al paziente dubbioso riguardo agli strumenti medici per curare: \"Ma guarda che sono sterili!\""
                                            },
                                            {
                                                "example_id": "0ec3d967-5074-4b93-94ed-9095fcbc45cb",
                                                "sense_id": "ee23be2a-dbba-3dc3-8594-070c7bc5b082",
                                                "text": "Chiese l'infermiere all'amico collega di turno: \"Pino, abbiamo aghi nuovi ed ovviamente sterili per le iniezioni sul braccio da fare mensilmente al nostro?\""
                                            }
                                        ]
                                    }
                                ]
