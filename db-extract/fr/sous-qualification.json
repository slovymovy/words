                ],
                "senses": [
                    {
                        "sense_id": "4018a5cf-74c5-3952-8335-ff998099645d",
                        "entry_id": "e6c0e8b6-f74e-3613-9a8f-87515128212c",
                        "glosses": [
                            "Situation d’une personne qui n’a pas a priori la qualification nécessaire pour occuper de façon satisfaisante un emploi donné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea543da3-dc42-4479-8c95-cac73c8b2d02",
                                "sense_id": "4018a5cf-74c5-3952-8335-ff998099645d",
                                "text": "Le chômage des employés en France est surtout, selon nous, un chômage de sous-qualification. Il y a en effet un grand nombre d’employés de bureau mal qualifiés ou peu qualifiés."
                            },
                            {
                                "example_id": "b053e7d4-6edd-42f9-99ed-5534bb6e169f",
                                "sense_id": "4018a5cf-74c5-3952-8335-ff998099645d",
                                "text": "D'un côté, la sous-qualification peut découler d’une pénurie de compétences contraignant les employeurs à embaucher des travailleurs qui ne sont pas des candidats idéaux pour le poste proposé."
                            },
                            {
                                "example_id": "464eeec3-55ad-47b7-b7fe-e7fc55f8fb58",
                                "sense_id": "4018a5cf-74c5-3952-8335-ff998099645d",
                                "text": "À l’instar du taux relativement faible de surqualification parmi les travailleurs exerçant une profession élémentaire, le taux élevé de sous-qualification parmi les immigrés travaillant dans ce type de professions peut être révélateur d’emplois insalubres, dégradants et dangereux."
                            }
                        ]
                    },
                    {
                        "sense_id": "47f69f0d-41d8-3067-8cfa-9a71fb4b8b65",
                        "entry_id": "e6c0e8b6-f74e-3613-9a8f-87515128212c",
                        "glosses": [
                            "Fait de qualifier un crime ou un délit à un niveau moins grave que celui dont il devrait relever."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d15452-66d1-4c5f-8920-3b0bcc8cbe35",
                                "sense_id": "47f69f0d-41d8-3067-8cfa-9a71fb4b8b65",
                                "text": "Mais en pratique, est apparue aux côtés de la correctionnalisation une nouvelle pratique judiciaire de sous-qualification des viols, dite cour-criminalisation, consistant à « oublier » l’existence de ces circonstances aggravantes dans l’espoir de faire juger plus rapidement ces affaires par des cours criminelles départementales."
                            }
                        ]
                    }
