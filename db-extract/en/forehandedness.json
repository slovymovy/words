                "senses": [
                    {
                        "sense_id": "57903e51-d373-30c1-931b-13713d645471",
                        "entry_id": "595b4c06-f48a-3634-809c-895fb1fc7f3b",
                        "glosses": [
                            "Prudence, foresight, and thriftiness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5a336166-3aea-4ce2-bbdc-605efaeac326",
                                "sense_id": "57903e51-d373-30c1-931b-13713d645471",
                                "text": "We can, if we choose to utilise our experience, be forehanded about these matters. But we shall only be forehanded by creating institutions to compel forehandedness."
                            },
                            {
                                "example_id": "dae787d4-c45c-4660-bd5f-d80b9fea4007",
                                "sense_id": "57903e51-d373-30c1-931b-13713d645471",
                                "text": "Any God's quantity of fuss and flubdub to bury a man, and not an ounce of forehandedness in the whole outfit to find out whether he was rightly dead."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b2e814d-a9de-3d5b-8e61-36cfe91dbdf5",
                        "entry_id": "595b4c06-f48a-3634-809c-895fb1fc7f3b",
                        "glosses": [
                            "Action taken in advance."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5301bb5a-2db8-4f62-a90f-38ce5a41d732",
                                "sense_id": "1b2e814d-a9de-3d5b-8e61-36cfe91dbdf5",
                                "text": "In the opinion of the community at large Stephen's forehandedness in the matter of preparations for his marriage was imprudence, and his desire for neatness and beauty flagrant extravagance."
                            }
                        ]
                    },
                    {
                        "sense_id": "34fdb060-860f-3bfb-9a64-3f45e486f652",
                        "entry_id": "595b4c06-f48a-3634-809c-895fb1fc7f3b",
                        "glosses": [
                            "Wealth, the quality of having sufficient possessions to live comfortably."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "58487eeb-b401-42e1-9c10-fa1104da37df",
                                "sense_id": "34fdb060-860f-3bfb-9a64-3f45e486f652",
                                "text": "And with the word, the speaker, in the vehemence of her desire to produce proofs of her gentility, would hop up on the block which served for a sort of stand by the side of the fire, and reach down a huge bag of dried apples, which must be \"hefted\" on the failing knees of the visiter, in proof of the forehandedness of the friends who could afford to give such evidence of their interest in Mrs. Titmouse."
                            }
                        ]
                    }
