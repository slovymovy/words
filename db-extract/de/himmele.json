                ],
                "senses": [
                    {
                        "sense_id": "a0058616-0140-3d0e-bf71-569111c2bbf3",
                        "entry_id": "7303623c-ddf0-329e-890c-353e76b5cda4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90377d3a-3ac8-4106-bedd-e60410daee4e",
                                "sense_id": "a0058616-0140-3d0e-bf71-569111c2bbf3",
                                "text": "Frau Himmele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ccfcb2f0-b953-495f-8bf7-b22d6fa22503",
                                "sense_id": "a0058616-0140-3d0e-bf71-569111c2bbf3",
                                "text": "Herr Himmele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bcaf2d3b-8b40-49b8-98a1-7e758e45a9ec",
                                "sense_id": "a0058616-0140-3d0e-bf71-569111c2bbf3",
                                "text": "Die Himmeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b20a52db-498c-4dcd-94ec-5f8a4853a7ec",
                                "sense_id": "a0058616-0140-3d0e-bf71-569111c2bbf3",
                                "text": "Der Himmele trägt nie die Schals, die die Himmele ihm strickt."
                            },
                            {
                                "example_id": "614f6d41-e09c-4d42-9a95-63871460df28",
                                "sense_id": "a0058616-0140-3d0e-bf71-569111c2bbf3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Himmele kommt, geht der Herr Himmele.“"
                            },
                            {
                                "example_id": "2bf428dc-86e4-4e3c-ab28-a1b5aa9d2b82",
                                "sense_id": "a0058616-0140-3d0e-bf71-569111c2bbf3",
                                "text": "Himmele kommt und geht."
                            },
                            {
                                "example_id": "2fae4586-4fbf-47b4-ab64-205da24f7787",
                                "sense_id": "a0058616-0140-3d0e-bf71-569111c2bbf3",
                                "text": "Himmeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
