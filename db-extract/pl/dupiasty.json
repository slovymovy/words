                "senses": [
                    {
                        "sense_id": "e6eb3e95-078c-30ca-a9a9-c9495e23ee9b",
                        "entry_id": "8ea6b6ca-980b-3b17-8b6a-72f75daabf97",
                        "glosses": [
                            "o wydatnych pośladkach"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "e8a8915c-24db-4dd1-b515-9bca28529e40",
                                "sense_id": "e6eb3e95-078c-30ca-a9a9-c9495e23ee9b",
                                "text": "Jestem dupiasta, jak powinnam się ubierać?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3dfb0ce7-2e69-3694-8d67-60a1039068eb",
                        "entry_id": "8ea6b6ca-980b-3b17-8b6a-72f75daabf97",
                        "glosses": [
                            "do niczego, kiepski, byle jaki"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "e8f05e92-1c14-4bc1-9d0e-cbb3277bae24",
                                "sense_id": "3dfb0ce7-2e69-3694-8d67-60a1039068eb",
                                "text": "Dupiasta pogoda w ten weekend, więc z braku innych zajęć troszkę popracuję…"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c33a5295-816d-42c0-9f83-34f31959afe7",
                        "source_entry_id": "8ea6b6ca-980b-3b17-8b6a-72f75daabf97",
                        "source_sense_id": "e6eb3e95-078c-30ca-a9a9-c9495e23ee9b",
                        "target_lang_word": "fessu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fessu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba167db-27dd-3db0-997a-a1b6e13c1ce4",
                                        "entry_id": "3edfdb4e-b769-3cdc-8216-cbec0c977dd0",
                                        "glosses": [
                                            "Qui a des fesses imposantes."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca6cf513-ca60-48f6-9916-2792cc8f3462",
                                                "sense_id": "1ba167db-27dd-3db0-997a-a1b6e13c1ce4",
                                                "text": "Petits angelots bien fessus,\n Enfants Jésus ronds et mafflus…"
                                            },
                                            {
                                                "example_id": "0c6f5ad2-895d-4d13-8d24-f8a90d2e6059",
                                                "sense_id": "1ba167db-27dd-3db0-997a-a1b6e13c1ce4",
                                                "text": "— Le langage de Lamendin m’est allé au cœur. Son avis a de l’importance. Ce visage fessu ne lâche, comme il est naturel, rien qui n’ait été longuement digéré."
                                            },
                                            {
                                                "example_id": "61cb6ab4-faf0-460f-bde8-7d6edf88e677",
                                                "sense_id": "1ba167db-27dd-3db0-997a-a1b6e13c1ce4",
                                                "text": "J’avoue l’ennui sans fond éprouvé devant ce conclave de mémères fessues, hanchues, cuissues et mamelues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
