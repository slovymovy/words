                        "examples": [
                            {
                                "example_id": "a9b57e3c-cf02-4653-9a2a-d79a4d40fea5",
                                "sense_id": "28a6e486-3604-3b5a-a362-c5fd95ec595a",
                                "text": "In de sombere septembermaand van 2015 zat Blind voor het eerst op de bank. Het werd bepaald geen feest. De thuiswedstrijd tegen IJsland leverde, na opnieuw een vroege rode kaart van Bruno Martins Indi, een desastreuze 0-1 nederlaag op."
                            },
                            {
                                "example_id": "881ab03e-2d68-40a3-a581-b3138becb26a",
                                "sense_id": "28a6e486-3604-3b5a-a362-c5fd95ec595a",
                                "text": "Na een koele septembermaand was het ook in oktober van dit jaar vrij koud. Het gemiddelde over de afgelopen jaren is 10,7 graden Celsius in oktober, maar dit jaar eindigt deze maand met een gemiddelde temperatuur van 10 graden."
                            }
                        ]
                    }
