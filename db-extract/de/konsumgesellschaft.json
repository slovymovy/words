                ],
                "senses": [
                    {
                        "sense_id": "725bfddd-e816-350c-9d55-33450004c602",
                        "entry_id": "a740e6ae-e172-3d2a-b3d4-8b38ab71d8af",
                        "glosses": [
                            "Gesellschaft, in der die Befriedigung möglichst vieler Bedürfnisse nur durch Konsum gegen entsprechende Bezahlung möglich ist"
                        ],
                        "tags": [
                            "häufig abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "05eaa870-35aa-4c48-9bd9-65e7a28fc12e",
                                "sense_id": "725bfddd-e816-350c-9d55-33450004c602",
                                "text": "„Der Arbeiter produziert in der Konsumgesellschaft zunehmend einen immer größeren, ihm fremden Reichtum, in Form von Privateigentum.“"
                            },
                            {
                                "example_id": "8d8702c6-de13-451a-9fcb-9771cac87f4b",
                                "sense_id": "725bfddd-e816-350c-9d55-33450004c602",
                                "text": "„Nicht unbegründet betitelt man die derzeitige Gesellschaft als Konsumgesellschaft.“"
                            },
                            {
                                "example_id": "cee3d4ac-fa51-47ce-9cd4-f80490f706b0",
                                "sense_id": "725bfddd-e816-350c-9d55-33450004c602",
                                "text": "„Mit der Entstehung der Konsumgesellschaft im heutigen Sinne können technische Veränderungen zudem bis in die kleinsten Bereiche des Alltags hineinwirken.“"
                            },
                            {
                                "example_id": "1c4fbc19-128e-445c-8847-0624cdf13a50",
                                "sense_id": "725bfddd-e816-350c-9d55-33450004c602",
                                "text": "„In neuerer Zeit schien infolge einer gewachsenen Sensibilität der Konsumgesellschaft in Fragen der Menschenrechte eine emanzipierte Positionierung von Führungskräften der Wirtschaft zuweilen sogar erwartet zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
