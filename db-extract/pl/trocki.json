                "senses": [
                    {
                        "sense_id": "4e4a28f4-8c85-3bbd-9066-b094f64590dd",
                        "entry_id": "2eb00ed3-5d1f-36e4-be8c-a629f3912cea",
                        "glosses": [
                            "związany z Trokami, dotyczący Trok"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c42bae0c-7ebe-4138-a9c8-502370656ba2",
                                "sense_id": "4e4a28f4-8c85-3bbd-9066-b094f64590dd",
                                "text": "Na mocy postanowienia Jagiellończyka Żmudź miała być traktowana na równi z województwami wileńskim i trockim."
                            },
                            {
                                "example_id": "08cef5eb-ea1d-4d26-a285-a49e6dca115c",
                                "sense_id": "4e4a28f4-8c85-3bbd-9066-b094f64590dd",
                                "text": "Wzorem polskim wprowadzono na Litwie właściwej podział administracyjny, ustanawiając dwa województwa – wileńskie i trockie – oraz dwie takie same kasztelanie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
