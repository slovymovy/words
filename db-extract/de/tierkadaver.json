                ],
                "senses": [
                    {
                        "sense_id": "b0de915c-6425-3b2d-9c0b-9e6e632cde84",
                        "entry_id": "cbc65434-f256-3774-85eb-f35d53be0614",
                        "glosses": [
                            "Kadaver eines Tiers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e38b791-bdd0-4915-8e3c-c8610e11ef2b",
                                "sense_id": "b0de915c-6425-3b2d-9c0b-9e6e632cde84",
                                "text": "„Einige Leute aus dem Stadtteil unterhielten jedoch Kontakte zu Heilerinnen, die auf einem Markt für traditionellen Bedarf, Kräuter, Tierkadaver (für bestimmte Opfergaben) oder traditionelle Devotionalien als Händlerinnen arbeiteten.“"
                            },
                            {
                                "example_id": "774c0181-2cbe-4359-a67d-5b5895d81763",
                                "sense_id": "b0de915c-6425-3b2d-9c0b-9e6e632cde84",
                                "text": "„Der Gestank der Tierkadaver war so entsetzlich, dass die Soldaten beinahe den Verstand verloren.“"
                            },
                            {
                                "example_id": "60046002-9085-49e3-8b26-94b92d0c91a0",
                                "sense_id": "b0de915c-6425-3b2d-9c0b-9e6e632cde84",
                                "text": "„In einem einzigen Brunnenschacht wurden 256 Leichen gefunden, Tierkadaver nicht mitgezählt.“"
                            },
                            {
                                "example_id": "ad532453-ac4c-4bda-95f5-4c76b8f18775",
                                "sense_id": "b0de915c-6425-3b2d-9c0b-9e6e632cde84",
                                "text": "„Die wachsende Anzahl von Tierkadavern verriet in dieser Wüste immer die Nähe von Wasser, und so war es auch jetzt; als wären die Brunnen von einer für Tiere tödlichen Gefahr umgeben.“"
                            },
                            {
                                "example_id": "be58bcf1-ceee-413d-aff5-b7e56a31b6f0",
                                "sense_id": "b0de915c-6425-3b2d-9c0b-9e6e632cde84",
                                "text": "„Um mitzuhelfen, sich unter dem erdrückenden Gewicht des riesigen Tierkadavers herauszustemmen, grub Gentry seine Knie in die Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
