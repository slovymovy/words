                    {
                        "sense_id": "2570f11f-a863-338b-ba03-8f8ba480a829",
                        "entry_id": "d225a1f1-165d-3e6e-8644-ba667cb75b82",
                        "glosses": [
                            "Werkzeugmaschine, bei der ein Werkstück durch Spanen mittels eines rotierenden Werkzeugs bearbeitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4639e3f9-707b-47f7-b6b3-194ef4c48779",
                                "sense_id": "2570f11f-a863-338b-ba03-8f8ba480a829",
                                "text": "„Der Schichtführer hatte Reparaturarbeiten an der Fräsmaschine durchgeführt und auf der Rückseite die Abdeckung geöffnet, was zwei Kollegen nicht mitbekamen.“"
                            },
                            {
                                "example_id": "5196cd31-c25b-4c3a-96d6-4f1e7f8c1d51",
                                "sense_id": "2570f11f-a863-338b-ba03-8f8ba480a829",
                                "text": "„Diese Formen werden mit einer computergesteuerten Bohr- und Fräsmaschine auf den hundertstel Millimeter genau aus einem Metallblock gesägt.“"
                            }
                        ],
