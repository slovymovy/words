                "senses": [
                    {
                        "sense_id": "cd46e325-3f52-30ef-8e7d-ee1940ee4183",
                        "entry_id": "a07c41d3-92d2-3d08-81c0-fc8ea76e8021",
                        "glosses": [
                            "Eigenname von Plätzen, häufiger Straßenname (in Deutschland in 58 Orten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f479a63a-e4a7-4b96-aeb8-9567cc450a37",
                                "sense_id": "cd46e325-3f52-30ef-8e7d-ee1940ee4183",
                                "text": "„Sollten Sie demnächst zufällig einmal am Bremer Goetheplatz vorbeikommen und dabei einen besonders heftigen Windstoß verspüren, könnte es sich um einen Atemzug handeln.“"
                            },
                            {
                                "example_id": "d729d330-3ec8-41eb-a468-58dc59cd0728",
                                "sense_id": "cd46e325-3f52-30ef-8e7d-ee1940ee4183",
                                "text": "„In der U-Bahn-Toilette am Goetheplatz lag eine tote 42 Jahre alte Münchnerin. Neben ihr Utensilien, die sie für ihren Rauschgiftkonsum gebraucht hatte.“"
                            },
                            {
                                "example_id": "ebc835b2-a37e-49bd-831c-ab66808a1ab3",
                                "sense_id": "cd46e325-3f52-30ef-8e7d-ee1940ee4183",
                                "text": "„Der markante Baukörper des alten Schulgebäudes steht leicht verdreht im orthogonalen Parzellengefüge dieses Ortsteils, nimmt aber Bezug auf die Schräge der zum »Goetheplatz« ausgeweiteten, südseitig daran vorbeiführenden Straße.“"
                            },
                            {
                                "example_id": "8d5a9042-961f-48ed-a2d9-5d68f42b573f",
                                "sense_id": "cd46e325-3f52-30ef-8e7d-ee1940ee4183",
                                "text": "„Es entstand eine doppelte Stadtmauer in Form eines Doppelringes im Abstand von acht bis zehn Metern mit zehn Türmen und vier zusätzlich befestigten Toranlagen. Reste dieser Stadtbefestigung sind heute noch vorhanden, so unter anderem der Kasseturm am Goetheplatz.“"
                            },
                            {
                                "example_id": "d8272a33-4172-48c5-bae8-cae614b0f1fd",
                                "sense_id": "cd46e325-3f52-30ef-8e7d-ee1940ee4183",
                                "text": "„Der Goetheplatz in Frankfurt am Main ist voller Menschen, rund 3.000 sind es, mindestens.“"
                            },
                            {
                                "example_id": "084a1c15-8c3a-4dbb-b59d-50072abd8b7f",
                                "sense_id": "cd46e325-3f52-30ef-8e7d-ee1940ee4183",
                                "text": "„Auf Schritt und Tritt begegnen wir in Franzensbad, sowie im Egerland überhaupt den Spuren des Goetheschen Genius. Es gibt Goethestraßen, Goetheplätze und Goethehäuser.“"
                            },
                            {
                                "example_id": "251b492b-9fd2-455e-9450-499b4c2677fe",
                                "sense_id": "cd46e325-3f52-30ef-8e7d-ee1940ee4183",
                                "text": "„Schon in seinen einleitenden Worten hatte der Präsident der Goethe-Gesellschaft […] sich in heftigen Worten gegen die Verunstaltung des Parkes und anderer Goetheplätze ausgesprochen, […]“"
                            },
                            {
                                "example_id": "1921b5ae-4362-4534-a27e-520c7b816b5f",
                                "sense_id": "cd46e325-3f52-30ef-8e7d-ee1940ee4183",
                                "text": "„Es geht zurück in die Innenstadt, dort suchen Sie sich bitte einen der unzähligen Goetheplätze.“"
                            },
                            {
                                "example_id": "830deff1-10f9-48d3-8876-d41c88710dbb",
                                "sense_id": "cd46e325-3f52-30ef-8e7d-ee1940ee4183",
                                "text": "„Sechs Jahre später plante er ein […] Werk ›Örtlichkeiten deutscher Sage und Geschichte‹ mit eigenen Kapiteln über Goetheplätze und Schillerplätze.“ (kursiv im Original)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
