                                    {
                                        "sense_id": "69944f9b-31b8-3726-a42f-c9ea3c5a37de",
                                        "entry_id": "dcfc81cb-88d5-3e8a-899e-6d7116ff485f",
                                        "glosses": [
                                            "profilierte Einkerbung, die fortlaufend wendelartig um eine zylinderförmige Wandung – innen oder außen – in einer gewundenen Schraubenlinie verläuft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4e5559-8b10-4895-8785-7d40516ee9a1",
                                                "sense_id": "69944f9b-31b8-3726-a42f-c9ea3c5a37de",
                                                "text": "Gewinde lassen sich spanend oder spanlos aufbringen."
                                            },
                                            {
                                                "example_id": "09e1f5e8-edb6-4de9-a499-35eeb4d6aee7",
                                                "sense_id": "69944f9b-31b8-3726-a42f-c9ea3c5a37de",
                                                "text": "„Er hielt das Gewinde hoch, damit Dorcus es sehen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17197833-2130-3f24-87e0-105d31420bfa",
                                        "entry_id": "dcfc81cb-88d5-3e8a-899e-6d7116ff485f",
                                        "glosses": [
                                            "Gebinde, Geflecht aus Blumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4846cbe-8a80-4ee5-b25b-9fd8a1e92903",
                                                "sense_id": "17197833-2130-3f24-87e0-105d31420bfa",
                                                "text": "„Zarter Blumen reich Gewinde |Flocht ich Dir zum Angebinde;…“"
                                            }
