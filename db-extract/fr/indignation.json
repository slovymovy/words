                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "543f47e9-d47e-4db9-b29b-7c27ac4650a4",
                                                "sense_id": "511e8445-1f5b-3e53-a017-1fc047ee8460",
                                                "text": "„Als Miss Runcible fertig war, befand sich Lottie im Zustand tiefster Indignation.“"
