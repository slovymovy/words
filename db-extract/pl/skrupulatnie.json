        "pl-extract.jsonl": [
            {
                "entry_id": "6d1c04b8-4723-31a4-81f1-817a23bea5d0",
                "word": "skrupulatnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "27182d07-e9b8-31ab-93b3-867a06bb45bd",
                        "entry_id": "6d1c04b8-4723-31a4-81f1-817a23bea5d0",
                        "glosses": [
                            "w sposób bardzo dokładny i staranny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58359500-b5eb-4d88-90c7-8cdbf5162a71",
                                "sense_id": "27182d07-e9b8-31ab-93b3-867a06bb45bd",
                                "text": "Kiedyś zauważył, że jeden gość, który przyjechał z RFN-u, miał taki notatnik i ciągle coś skrupulatnie w nim zapisywał"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4011a766-d798-4274-a714-c72bd926c2ac",
                        "source_entry_id": "6d1c04b8-4723-31a4-81f1-817a23bea5d0",
                        "source_sense_id": "27182d07-e9b8-31ab-93b3-867a06bb45bd",
                        "target_lang_word": "scrupulously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrupulously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31ac0913-21d0-379a-9696-cf1af1981cf3",
                                        "entry_id": "e44a8c37-b6a8-3002-a9c3-a9439c5c79c3",
                                        "glosses": [
                                            "In a careful manner, with scruple; done with careful attention to detail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c776fa5b-eca8-4cd4-aae3-bcfc5b89f741",
                                                "sense_id": "31ac0913-21d0-379a-9696-cf1af1981cf3",
                                                "text": "They were frightened when he threatened this, and promised to obey him scrupulously if he would but promise not to desert them."
                                            },
                                            {
                                                "example_id": "28dac5a7-1084-49d6-bce8-bb312a369c59",
                                                "sense_id": "31ac0913-21d0-379a-9696-cf1af1981cf3",
                                                "text": "Stock is generally well maintained, and the locomotives and railcars are kept scrupulously clean. The former are painted an unrelieved black, and the latter blue and cream, while the coaches are grey."
                                            },
                                            {
                                                "example_id": "2386ffab-d215-44c0-8010-5edf24db3c0b",
                                                "sense_id": "31ac0913-21d0-379a-9696-cf1af1981cf3",
                                                "text": "Some of them have, in fact, given them a theoretical elaboration which for subtlety, refinement, and elegance need make no apologies to the older economics, and which remains faithful to older theorizing in at least one respect, that the tradition of unintelligibility to the layman is scrupulously observed."
                                            },
                                            {
                                                "example_id": "9163279a-acb7-44d3-9b1a-96106e0b8dee",
                                                "sense_id": "31ac0913-21d0-379a-9696-cf1af1981cf3",
                                                "text": "The citizens of India and Japan have elected nationalist leaders who many say they believe champion a more closed form of identity than their predecessors. While these leaders have observed the principles of liberalism more scrupulously than the Orbáns or Erdogans of the world, their critics suspect that they are quietly fostering intolerance among their supporters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b3acc97-be79-42dd-96ad-b97da64d090f",
                        "source_entry_id": "6d1c04b8-4723-31a4-81f1-817a23bea5d0",
                        "source_sense_id": "27182d07-e9b8-31ab-93b3-867a06bb45bd",
                        "target_lang_word": "conscientiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conscientiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9566393-cc53-32a9-b9b5-bd0f848cdbca",
                                        "entry_id": "c53ebd2c-04a1-3560-96af-82034376735c",
                                        "glosses": [
                                            "In a conscientious manner; attentively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf2bec2-ea31-4cf0-99c6-250e9a589276",
                                                "sense_id": "e9566393-cc53-32a9-b9b5-bd0f848cdbca",
                                                "text": "STORES and tobacco were running out; it was time for a trip to the township. Also for a conscientiously taken holiday."
                                            },
                                            {
                                                "example_id": "5bb68747-9f17-4eb4-b9d6-26f9bc6eb7a3",
                                                "sense_id": "e9566393-cc53-32a9-b9b5-bd0f848cdbca",
                                                "text": "Others who conscientiously attended the Technical College at night often drooped over their desks in a doze, and one does not wonder at it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab6e5dd3-bd59-48c7-8b14-cb7ebad20ac3",
                        "source_entry_id": "6d1c04b8-4723-31a4-81f1-817a23bea5d0",
                        "source_sense_id": "27182d07-e9b8-31ab-93b3-867a06bb45bd",
                        "target_lang_word": "fastidiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fastidiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ccb6fbc-8125-3bd0-802c-0b838d6398c4",
                                        "entry_id": "6e153d97-e7e6-3f78-abfe-f89f36135b3b",
                                        "glosses": [
                                            "In a fastidious manner."
                                        ],
                                        "tags": [],
