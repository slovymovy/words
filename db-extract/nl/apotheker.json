                ],
                "senses": [
                    {
                        "sense_id": "f64787f8-de52-38dd-b4b9-a28fea93b8aa",
                        "entry_id": "358271ff-eada-31a3-a783-d4f5193c150f",
                        "glosses": [
                            "iemand die beroepsmatig geneesmiddelen bereidt en verkoopt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "a4a6db11-f39d-4daa-b47e-570e61fe0801",
                                "sense_id": "f64787f8-de52-38dd-b4b9-a28fea93b8aa",
                                "text": "Apothekers maken zich zorgen om toename medicijntekort"
                            },
                            {
                                "example_id": "753a1f44-2a66-4802-99ea-5baf1142d5cc",
                                "sense_id": "f64787f8-de52-38dd-b4b9-a28fea93b8aa",
                                "text": "Jouw medicijnen halen we bij de apotheker, ik zorg dat jij ze op tijd inneemt en Sander rijdt jou heen en weer naar het ziekenhuis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7b26811-e591-4220-bb9f-542c8fbcc691",
                        "source_entry_id": "358271ff-eada-31a3-a783-d4f5193c150f",
                        "source_sense_id": "f64787f8-de52-38dd-b4b9-a28fea93b8aa",
                        "target_lang_word": "Apotheker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apotheker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe24c901-755c-3789-b31f-cef1b928513f",
                                        "entry_id": "521182b4-102e-3017-8538-67f6fe146380",
                                        "glosses": [
                                            "Fachmann für Arzneimittel; typischerweise Inhaber oder auch Angestellter einer Apotheke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81abb03-c52e-4fe2-841c-c5a6b05a7183",
                                                "sense_id": "fe24c901-755c-3789-b31f-cef1b928513f",
                                                "text": "Ich lasse mich gern auch vom Apotheker beraten."
                                            },
                                            {
                                                "example_id": "09341503-7096-4b4a-aaaf-318723fcca85",
                                                "sense_id": "fe24c901-755c-3789-b31f-cef1b928513f",
                                                "text": "„Das kommt von daher, weil der Apotheker Heilborn jener milden Art von Verrücktheit verfallen ist, die man in plattdeutschen Gegenden Mallheit nennt.“"
                                            },
                                            {
                                                "example_id": "0829b8d0-2546-4633-99a6-9f7b2854636e",
                                                "sense_id": "fe24c901-755c-3789-b31f-cef1b928513f",
                                                "text": "„Da ich wußte, dass ihr Mann Apotheker sein mußte, faßte ich den Entschluß, mich mit allen bekannt zu machen; auf diese Weise entdeckte ich sie am dritten Tag.“"
                                            },
                                            {
                                                "example_id": "40d2a187-bb1b-48d4-b590-fe4d4e32f2a6",
                                                "sense_id": "fe24c901-755c-3789-b31f-cef1b928513f",
                                                "text": "„Wusstest du, dass das Wort »Apotheker« aus dem Altägyptischen kommt und wörtlch »Bereiter magischer Heilmittel« bedeutet?“"
                                            },
                                            {
                                                "example_id": "068fb8fc-6623-4386-b135-0bc2700fb280",
                                                "sense_id": "fe24c901-755c-3789-b31f-cef1b928513f",
                                                "text": "„Apotheker warnen vor Nebenwirkungen bei der Einnahme leistungssteigernder Mittel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bdca1aa-c375-47ff-a4b2-723fad32d34b",
                        "source_entry_id": "358271ff-eada-31a3-a783-d4f5193c150f",
                        "source_sense_id": "f64787f8-de52-38dd-b4b9-a28fea93b8aa",
                        "target_lang_word": "pharmacist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pharmacist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d049902-d62f-3c35-9bd2-b519de5301f1",
                                        "entry_id": "5bc79c19-c47c-3d17-a249-479a35ce81fb",
                                        "glosses": [
                                            "A health professional who controls, formulates, preserves, and dispenses medications and provides medical advice and counseling on how medicines should be used in order to achieve maximum benefit, and minimal side effects in order to avoid drug interactions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14be8282-495f-48c0-a376-eeacadccc211",
                                                "sense_id": "6d049902-d62f-3c35-9bd2-b519de5301f1",
                                                "text": "He has served as a prescriptionist to the leading pharmacists of the old country, and been employed in many of our American cities."
                                            },
                                            {
                                                "example_id": "15387852-6c96-4cef-90e0-3b8a55de5159",
                                                "sense_id": "6d049902-d62f-3c35-9bd2-b519de5301f1",
                                                "text": "By Admir, pharmacist by profession and hobby dronist by passion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c77034-62b7-3d65-b61e-0c954fb3cdd2",
                                        "entry_id": "5bc79c19-c47c-3d17-a249-479a35ce81fb",
                                        "glosses": [
                                            "One who studies pharmacy."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feb4626b-f2fb-4667-861f-68b87efa19b9",
                        "source_entry_id": "358271ff-eada-31a3-a783-d4f5193c150f",
