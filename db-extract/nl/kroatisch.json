                                            {
                                                "example_id": "8f10e5de-8984-4b84-83be-499372be809f",
                                                "sense_id": "abc95bfd-d1c4-362f-ba89-de8e030c768c",
                                                "text": "Sprechen Sie Kroatisch?"
                                            },
                                            {
                                                "example_id": "8ea50e47-0d28-4429-bdad-6546f7544b30",
                                                "sense_id": "abc95bfd-d1c4-362f-ba89-de8e030c768c",
                                                "text": "Wie heißt das auf Kroatisch?"
                                            },
                                            {
                                                "example_id": "988df790-80b1-4f05-a5f6-6a5c8d136845",
                                                "sense_id": "abc95bfd-d1c4-362f-ba89-de8e030c768c",
                                                "text": "„Der Umstand, dass Bosnisch, Kroatisch und Serbisch in den jeweiligen Verfassungen als Amtssprachen festgelegt sind und Kodifizierungsmaßnahmen einen jeweils bosnischen, kroatischen, serbischen oder montenegrinischen Standard festlegen, sagt nichts über den linguistischen Status dieser Sprachen aus.“"
                                            },
                                            {
                                                "example_id": "9b039beb-94fe-4d80-aa15-09dc9e79d08b",
                                                "sense_id": "abc95bfd-d1c4-362f-ba89-de8e030c768c",
                                                "text": "„Die Orthographie des Kroatischen ist grundsätzlich phonematisch, das heißt, jedes Phonem wird durch genau eines der Grapheme des Alphabetes wiedergegeben.“"
                                            }
                                        ],
