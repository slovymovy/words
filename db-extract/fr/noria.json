                    {
                        "translation_id": "b2f8919d-1eca-4f3b-ad52-89a7cbd44508",
                        "source_entry_id": "04e570b1-da1a-3f74-877d-a02e0ff51b4c",
                        "source_sense_id": "30ab818d-751e-3cde-a647-c6262e392c70",
                        "source_sense_description": "Roue hydraulique",
                        "target_lang_word": "paternoster",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paternoster",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5e3d347d-de6a-3e2e-8332-8188a36e8f55",
                                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                                        "glosses": [
                                            "als gebed uitspreken van het Onzevader\\nAls naam van het gebed wordt Paternoster net als Onzevader met een hoofdletter geschreven volgens spellingregel 16."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec87fce-9b4d-4bcc-bc4c-7176112504bc",
                                                "sense_id": "5e3d347d-de6a-3e2e-8332-8188a36e8f55",
                                                "text": "Maar, zoals een bestuurder het verwoordt: ‘Als jij of je vader of moeder ligt te creperen van de pijn, gaat het niet helpen als iemand naast je een paternoster zit te bidden. Overigens: hoeveel mens is een mens nog als die volledig opgaat in het lijden?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f59c0b-ea3e-37be-895f-789caf69d459",
                                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                                        "glosses": [
                                            "christelijk gebedssnoer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0d2c0d-f1b2-4f2d-a1dc-3aae3c73fb9a",
                                                "sense_id": "95f59c0b-ea3e-37be-895f-789caf69d459",
                                                "text": "Het is een constante gedurende de reis, hoe geloof en familieband verweven zijn. Jessica heeft een zak vol plastic wijwaterflessen mee om te vullen in de Jordaan. Jad koopt Palestijnse sjaals op verzoek van de familie. Maryse en Jessica nemen een paar paternosters uit Bethlehem mee naar Brussel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf2cb742-7305-388e-8f34-039579719b84",
                                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                                        "glosses": [
                                            "type lift met cabines die voortdurend rond blijven gaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c82508f2-95c3-400f-bf71-5bb64fe37d8e",
                                                "sense_id": "bf2cb742-7305-388e-8f34-039579719b84",
                                                "text": "De paternoster is niet ongevaarlijk. In 2012 viel een 81-jarige man in de liftschacht in het voormalige Ziggo-gebouw in Den Haag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f80610ac-72c6-3a0e-9794-e3861e01cc80",
                                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                                        "glosses": [
                                            "installatie voor baggerwerk met voortdurend rondgaande bakjes"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbb778d3-25b5-3593-a124-eb5fe56758e6",
                                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                                        "glosses": [
                                            "reeks vertakkingen aan een vislijn met behulp van staafjes die haaks op de vislijn zijn bevestigd, om zo met meer haakjes tegelijk te hengelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bca39c89-967b-40c4-97a9-10b5df3921a0",
                                                "sense_id": "dbb778d3-25b5-3593-a124-eb5fe56758e6",
                                                "text": "Op de golfbrekers was het sowieso oppassen geblazen. Als m’n lijn vastzat, omdat ’t werpklompje of paternoster ergens achter bleef steken, moest ik langs slijmgladde blokken afdalen."
