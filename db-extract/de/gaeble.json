                ],
                "senses": [
                    {
                        "sense_id": "4055b509-aa48-349b-9246-f613b71ec19c",
                        "entry_id": "481af109-58a8-39e6-a202-ef87a894dab7",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f53473d1-5394-43a1-9a29-4d858974e4f5",
                                "sense_id": "4055b509-aa48-349b-9246-f613b71ec19c",
                                "text": "Frau Gaeble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f99e5160-82f7-4eb6-bec2-d88df8b27820",
                                "sense_id": "4055b509-aa48-349b-9246-f613b71ec19c",
                                "text": "Herr Gaeble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "67d890a5-3019-4300-8664-37fa6b133b9d",
                                "sense_id": "4055b509-aa48-349b-9246-f613b71ec19c",
                                "text": "Die Gaebles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a362d71f-1c56-402e-9cc4-dcf033230b1f",
                                "sense_id": "4055b509-aa48-349b-9246-f613b71ec19c",
                                "text": "Der Gaeble trägt nie die Schals, die die Gaeble ihm strickt."
                            },
                            {
                                "example_id": "212bd294-09a1-447e-b2bd-963688d9a2d2",
                                "sense_id": "4055b509-aa48-349b-9246-f613b71ec19c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gaeble kommt, geht der Herr Gaeble.“"
                            },
                            {
                                "example_id": "91ea137e-11b0-42d7-85f2-f6a6ba64a392",
                                "sense_id": "4055b509-aa48-349b-9246-f613b71ec19c",
                                "text": "Gaeble kommt und geht."
                            },
                            {
                                "example_id": "d65431b4-9032-4ac6-b898-fd23e6958aab",
                                "sense_id": "4055b509-aa48-349b-9246-f613b71ec19c",
                                "text": "Gaebles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
