                "senses": [
                    {
                        "sense_id": "5b26b608-7d6e-3fad-bbc5-bcc5ed13154c",
                        "entry_id": "6474a86a-5177-3963-83d0-52d8358e943e",
                        "glosses": [
                            "Mikroskop, das sichtbares Licht zur Vergrößerung nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0fffc1d-0ac6-44a6-98a0-9a40f8262fb0",
                                "sense_id": "5b26b608-7d6e-3fad-bbc5-bcc5ed13154c",
                                "text": "Im Biologieunterricht mikroskopieren die Schüler mit alten Lichtmikroskopen, die als Lichtquelle einen kleinen Spiegel haben, der das Licht der Deckenlampen einfängt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fe20a8c-1d76-4f61-a9f5-d4a5056631de",
                        "source_entry_id": "6474a86a-5177-3963-83d0-52d8358e943e",
                        "source_sense_id": "5b26b608-7d6e-3fad-bbc5-bcc5ed13154c",
                        "source_sense_description": "Mikroskop, das sichtbares Licht zur Vergrößerung nutzt",
                        "target_lang_word": "light microscope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "light microscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "655f96f9-d630-37c3-8202-65b1a4b200e6",
                                        "entry_id": "9c3eed74-aa6a-36e0-b1e7-60420f8610d7",
                                        "glosses": [
                                            "A scientific instrument which provides a magnified view of very small objects that are illuminated with visible light which then passes through optical lenses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "722034f9-b23e-4e9c-8c85-03a75261142d",
                                                "sense_id": "655f96f9-d630-37c3-8202-65b1a4b200e6",
                                                "text": "A big world beyond the limits of the ordinary light microscope now lies open to exploration."
                                            },
                                            {
                                                "example_id": "c18d01df-997a-434e-98f3-45c254c53c1c",
                                                "sense_id": "655f96f9-d630-37c3-8202-65b1a4b200e6",
                                                "text": "[M]acromolecular assemblies. . ., which include viruses, are too large to study by conventional X-ray diffraction methods, but too small to be seen under a light microscope."
                                            },
                                            {
                                                "example_id": "fa7af40e-c7b2-442c-8c77-c90ca27ee5ac",
                                                "sense_id": "655f96f9-d630-37c3-8202-65b1a4b200e6",
                                                "text": "Unlike the most powerful electron microscopes—which can see down to the scale of individual molecules—or fluorescent-based microscopes—which rely on the use of coloured dyes—the new light microscope does not need to interfere in any way with the living material it is used to study."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
