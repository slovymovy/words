                        "cross_references": [
                            {
                                "target_word": "Waran",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2fec164-1214-3dd2-b3a9-4a877bb6396d",
                                        "entry_id": "1eea8e6c-6604-39be-8aaa-78a823fbf21a",
                                        "glosses": [
                                            "(vor allem in den tropischen und subtropischen Gebieten Afrikas, Asiens und Australiens beheimatete) größere, massige, ovipare und karnivore Echse mit langem Schwanz und stark bekrallten, kräftigen Beinen (Varanus)"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "131aac9f-b4a0-4684-8d48-6f65e00bf1b4",
                                                "sense_id": "e2fec164-1214-3dd2-b3a9-4a877bb6396d",
                                                "text": "„Mittags sprang ein großer Waran, der fast zwei Meter lang war, neben mir aus dem Busch, erschreckte mich zu Tode, rannte einfach frei über die Steilkante in die Luft und knallte 25 Meter tiefer auf den Ufersaum.“"
                                            },
                                            {
                                                "example_id": "08e9c7ad-d3fa-4f5c-99f1-5e7ee9064dee",
                                                "sense_id": "e2fec164-1214-3dd2-b3a9-4a877bb6396d",
                                                "text": "„Der Schwanz wirkt muskulös und lang; mit ihm können die Warane einen Gegner in die Flucht peitschen… Entweder graben sich die Warane ihre eigenen Wohnhöhlen oder sie benutzen die verlassenen Erdbauten von Säugetieren, doch können sie sich auch in Felsspalten oder in hohle Baumstämme zurückziehen, um zu schlafen.“"
                                            },
                                            {
                                                "example_id": "70677fd0-5a3e-422b-9aa5-c19d5786167d",
                                                "sense_id": "e2fec164-1214-3dd2-b3a9-4a877bb6396d",
                                                "text": "„Schlangen sind der Untersuchung zufolge am nächsten mit Waranen verwandt, etwa dem heute lebenden Komodo-Waran - einem drachenähnlichen Wesen, das in Indonesien lebt.“"
                                            },
                                            {
                                                "example_id": "4685a4e9-26d3-4690-b5d6-b34acd3136de",
                                                "sense_id": "e2fec164-1214-3dd2-b3a9-4a877bb6396d",
                                                "text": "„Große Reptilien werden zumindest in Ostaustralien nur selten erbeutet, obwohl sie weit verbreitet sind. Möglicherweise sind vor allem große Warane zu wehrhaft und gut bewaffnet oder einfach fähig, schnell genug in Baue oder auf Bäume zu flüchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
