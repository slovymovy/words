                    {
                        "sense_id": "1c798719-6fab-306d-9b14-101049b3b8ea",
                        "entry_id": "c10feb87-7296-3aea-a32e-a8a2dae363bc",
                        "glosses": [
                            "Already occupied."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "80aeaec1-a2c9-433f-a131-8038443b9467",
                                "sense_id": "1c798719-6fab-306d-9b14-101049b3b8ea",
                                "text": "Terrified at this uproar, which disconcerted the magician himself, she ran for shelter into the place which was preoccupied by the other lady […]."
                            },
                            {
                                "example_id": "6b8cd8c1-c70c-407b-b863-c4e19588826e",
                                "sense_id": "1c798719-6fab-306d-9b14-101049b3b8ea",
                                "text": "Scythrop, retiring to his tower, found his study preoccupied."
                            },
                            {
                                "example_id": "fb0af906-9376-4c32-a350-3244d87d903a",
                                "sense_id": "1c798719-6fab-306d-9b14-101049b3b8ea",
                                "text": "Presently the gudeman […] with much bowing and many respectful compliments, managed to tell the guest that the room was preoccupied for that night, as two dykers had come and, according to prearrangement, were to sleep in the bed!"
                            }
                        ]
                    },
                    {
                        "sense_id": "af49323f-d845-3854-8886-1b38ce6e6715",
                        "entry_id": "c10feb87-7296-3aea-a32e-a8a2dae363bc",
                        "glosses": [
                            "Describing a taxonomic name not available for use because it is already used for another."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "57e02b64-1bc8-423d-b04b-fffb5bcb94fc",
                                "sense_id": "af49323f-d845-3854-8886-1b38ce6e6715",
                                "text": "In 1924 J. D. Tothill revised the nearctic species in the genus Fabriciella, a name proposed by Bezzi in 1906 to replace Fabricia Rob. D. which is preoccupied."
                            }
                        ]
                    },
                    {
                        "sense_id": "579596a1-5a14-3c87-92e2-715adfdc6153",
                        "entry_id": "c10feb87-7296-3aea-a32e-a8a2dae363bc",
                        "glosses": [
                            "Concerned with something else; distracted; giving one's attention elsewhere."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ff47f4-f386-4a7e-98c4-444c2f9aa6a7",
                                "sense_id": "579596a1-5a14-3c87-92e2-715adfdc6153",
                                "text": "I was preoccupied with a deadline at work, and I forgot his birthday."
                            }
                        ]
                    }
