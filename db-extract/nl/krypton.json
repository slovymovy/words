                    {
                        "translation_id": "963ed31f-0737-47bf-bc59-90a2ab5297f7",
                        "source_entry_id": "e036472e-099f-33ee-a1bb-e36b4baed0c3",
                        "source_sense_id": "6e0e348a-f486-339f-a5de-d9f86d4dff64",
