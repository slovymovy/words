                ],
                "senses": [
                    {
                        "sense_id": "2ef572bb-e871-3ba6-a5bb-9646931cc2de",
                        "entry_id": "d02ba088-f107-36e5-abd3-61b5355f1b7f",
                        "glosses": [
                            "Pratiquer une mastectomie sur (quelqu’un)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb401ea-4e45-4a0b-95aa-c6dc4e5eb80f",
                                "sense_id": "2ef572bb-e871-3ba6-a5bb-9646931cc2de",
                                "text": "Pourquoi ne pas mastectomiser systématiquement toutes jeunes filles, cela leur offrirait une protection à 100 % contre le cancer du sein !"
                            },
                            {
                                "example_id": "c5ea2bc2-8e0e-4d3d-af4c-d0f9815a2943",
                                "sense_id": "2ef572bb-e871-3ba6-a5bb-9646931cc2de",
                                "text": "Pitin Lara Croft va se faire mastectomiser !"
                            },
                            {
                                "example_id": "ef0b7a8e-8645-4a9a-96dd-8ccc46863ae9",
                                "sense_id": "2ef572bb-e871-3ba6-a5bb-9646931cc2de",
                                "text": "L'actrice Angelina Jolie a choisi de se faire mastectomiser afin d'éviter les risques d'un cancer du sein."
                            },
                            {
                                "example_id": "f61519c7-b144-44ce-8aec-f31234514809",
                                "sense_id": "2ef572bb-e871-3ba6-a5bb-9646931cc2de",
                                "text": "En français, très communément, on entend les verbes « diurétiser » de « diurétique », « mastectomiser » de « mastectomie », « antibio-corticothéraper » de « antibiothérapie » et « corticothérapie », « tachycarder » de « tachycardie » ou encore « épisiotomiser » de « épisiotomie »."
                            }
                        ]
                    }
