                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94e87da1-2e04-4cd6-9f38-faaede8919e7",
                                                "sense_id": "dc9e5532-eba9-32ed-8bf4-72de198f069a",
                                                "text": "Mam na imię Ambroży, z zawodu jestem pszczelarzem, z zamiłowania gołębiarzem i poetą."
                                            },
                                            {
                                                "example_id": "40ed589b-6c07-4161-a2e4-bad9230dfbda",
                                                "sense_id": "dc9e5532-eba9-32ed-8bf4-72de198f069a",
                                                "text": "Ambroży Grabowski, księgarz i antykwariusz oraz historyk Krakowa, uchodził za autora pierwszego przewodnika po Krakowie."
                                            },
                                            {
                                                "example_id": "7a1d04a4-13b5-42a6-b6a6-9fbce0597438",
                                                "sense_id": "dc9e5532-eba9-32ed-8bf4-72de198f069a",
                                                "text": "W Kościele katolickim na 7 grudnia przypada wspomnienie św. Ambrożego z Mediolanu, patrona pszczelarzy."
                                            },
                                            {
                                                "example_id": "ed600eee-11f5-4ae1-a03c-b4df42117257",
                                                "sense_id": "dc9e5532-eba9-32ed-8bf4-72de198f069a",
                                                "text": "Ambrożowie dzień swego patrona, czyli imieniny, obchodzą 7 grudnia, a także 20 marca, 4 kwietnia, 19 lipca, 16 sierpnia oraz 16 i 18 października."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
