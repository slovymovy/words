                "senses": [
                    {
                        "sense_id": "a053a07c-9750-3828-9352-1661256950a6",
                        "entry_id": "494d2085-a29a-3467-9ab2-349ba9592aab",
                        "glosses": [
                            "страд. прич. прош. вр. от отлипнуть;"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "8c73c9e7-be3f-4d0a-9b33-8237f1c8aca4",
                                "sense_id": "a053a07c-9750-3828-9352-1661256950a6",
                                "text": "Самка снимает спонсора и далее искусственно оргазмирует в койке, дабы не стать отлипнутой."
                            },
                            {
                                "example_id": "0a1bba59-b33b-4e71-8f50-0ecb805b8775",
                                "sense_id": "a053a07c-9750-3828-9352-1661256950a6",
                                "text": "Всю жизнь мечтала об этом бесподобно безвкусном наборе стаканов с китайскими прилипнуто - отлипнутыми наклейками покемонов."
                            }
                        ]
                    }
