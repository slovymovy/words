                "senses": [
                    {
                        "sense_id": "f5702250-a04c-3c88-b30e-0b3b5e291c07",
                        "entry_id": "cb4daf94-aea8-32e8-aae4-e0ddef210e99",
                        "glosses": [
                            "Ausgleich von Überhangsmandaten unter bestimmten Bedingungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed105557-cc43-44d0-b629-8abd5fcda2ed",
                                "sense_id": "f5702250-a04c-3c88-b30e-0b3b5e291c07",
                                "text": "„Die aus Kostengründen beschlossene Verkleinerung des Landtages tritt nicht ein, wenn es wieder Ausgleichsmandate geben sollte.“"
                            },
                            {
                                "example_id": "8b869602-d62f-418d-85ec-dd01449258b0",
                                "sense_id": "f5702250-a04c-3c88-b30e-0b3b5e291c07",
                                "text": "„Weil das andere Ausgleichsmandat an Alexandra Duffner (Unabhängige Liste) aus Sulzau gegangen war, kam der kleinste Ort sogar auf 2 Sitze und damit auf ebenso viele wie das mehr als doppelt so große Börstingen gleich nebenan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
