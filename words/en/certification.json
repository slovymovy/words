{
    "word_family": [
        "certify",
        "certificate",
        "certifiable",
        "certifier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79ebb59f-c380-312d-950f-a10155037489",
                    "sense_definition": "A professional qualification that confirms a person's skills or ability to perform a job.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "qualification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You do not possess the professional <w>certification</w> required for this senior engineering post.",
                            "target_lang_translations": {
                                "ru": "У вас нет профессиональной <w>сертификации</w>, необходимой для этой старшей инженерной должности."
                            }
                        },
                        {
                            "text": "She spent three months studying to earn her technical <w>certification</w> in cloud computing.",
                            "target_lang_translations": {
                                "ru": "Она потратила три месяца на учебу, чтобы получить техническую <w>сертификацию</w> в области облачных вычислений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "professional certification",
                        "technical certification",
                        "earn a certification"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональная квалификация, подтверждающая навыки или способность человека выполнять определенную работу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сертификация",
                                "target_lang_sense_clarification": "процедура получения профессионального сертификата"
                            },
                            {
                                "target_lang_word": "аттестация",
                                "target_lang_sense_clarification": "подтверждение квалификации специалиста"
                            },
                            {
                                "target_lang_word": "сертификат",
                                "target_lang_sense_clarification": "документ, подтверждающий квалификацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40ee1817-5c19-3866-a464-2dc975bd101d",
                    "sense_definition": "The formal process of verifying that something or someone meets a certain standard.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>certification</w> process for the new medical device took over a year to complete.",
                            "target_lang_translations": {
                                "ru": "Процесс <w>сертификации</w> нового медицинского устройства занял более года."
                            }
                        },
                        {
                            "text": "The company is seeking official <w>certification</w> to prove their products are environmentally friendly.",
                            "target_lang_translations": {
                                "ru": "Компания стремится получить официальную <w>сертификацию</w>, чтобы доказать экологичность своей продукции."
                            }
                        }
                    ],
                    "synonyms": [
                        "homologation"
                    ],
                    "common_phrases": [
                        "certification process",
                        "official certification",
                        "safety certification"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальный процесс проверки того, что что-либо или кто-либо соответствует определенному стандарту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сертификация",
                                "target_lang_sense_clarification": "подтверждение соответствия стандарту качества"
                            },
                            {
                                "target_lang_word": "освидетельствование",
                                "target_lang_sense_clarification": "официальная проверка на соответствие нормам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d1cb1e9-dfb2-3ef2-9f08-3962a9e12959",
                    "sense_definition": "The act of granting or issuing an official document as proof of a status or achievement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>certification</w> of the election results was delayed by several days due to a recount.",
                            "target_lang_translations": {
                                "ru": "<w>Удостоверение</w> результатов выборов было отложено на несколько дней из-за пересчета голосов."
                            }
                        },
                        {
                            "text": "The agency is responsible for the <w>certification</w> of organic farms across the country.",
                            "target_lang_translations": {
                                "ru": "Агентство несет ответственность за <w>сертификацию</w> органических ферм по всей стране."
                            }
                        }
                    ],
                    "common_phrases": [
                        "final certification",
                        "certification of results"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт выдачи официального документа в качестве доказательства статуса или достижения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удостоверение",
                                "target_lang_sense_clarification": "официальное подтверждение факта или документа"
                            },
                            {
                                "target_lang_word": "заверение",
                                "target_lang_sense_clarification": "официальное подтверждение подлинности"
                            },
                            {
                                "target_lang_word": "сертификация",
                                "target_lang_sense_clarification": "выдача официального свидетельства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}