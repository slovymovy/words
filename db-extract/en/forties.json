                "senses": [
                    {
                        "sense_id": "1ee8dd8d-1245-3e10-94b6-bcdd305a0ede",
                        "entry_id": "9eeea248-0597-34bb-bb26-f33ec69843d1",
                        "glosses": [
                            "The decade of the 1840s, 1940s, etc."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "47dd6ad1-5799-4ce4-b27d-ca2c055354bb",
                                "sense_id": "1ee8dd8d-1245-3e10-94b6-bcdd305a0ede",
                                "text": "My ma was born in the forties and my pa was born in the seventies."
                            }
                        ]
                    },
                    {
                        "sense_id": "439aba37-ba70-3058-ab9d-00f8f0ccf9d6",
                        "entry_id": "9eeea248-0597-34bb-bb26-f33ec69843d1",
                        "glosses": [
                            "The decade of one's life from age 40 through age 49."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "2049359b-cdd4-4292-85c6-9105f6e65601",
                                "sense_id": "439aba37-ba70-3058-ab9d-00f8f0ccf9d6",
                                "text": "They're both in their forties."
                            },
                            {
                                "example_id": "482e85db-4f5e-4a1a-8da6-66b115b7ba90",
                                "sense_id": "439aba37-ba70-3058-ab9d-00f8f0ccf9d6",
                                "text": "Albrecht Lein reports that the core of the Braunschweig Antifa was made up of KPD and SPD members in their forties and fifties who had avoided the front, though Catholic workers’ organizations and other forces were also involved."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f3b3525-6795-33f7-a3d7-f72719539f2e",
                        "entry_id": "9eeea248-0597-34bb-bb26-f33ec69843d1",
                        "glosses": [
                            "The range between 40 and 49."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "b1dc63a8-8412-41b1-b3bb-4dfea12fe857",
                                "sense_id": "4f3b3525-6795-33f7-a3d7-f72719539f2e",
                                "text": "What to wear when the weather is in the forties really depends on whether you're talking fahrenheit or celsius."
                            }
                        ]
                    }
                ],
