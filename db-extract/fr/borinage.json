            {
                "entry_id": "e207d4bf-162a-32a1-9ccf-ddba23ef0c6e",
                "word": "Borinage",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2441f1d5-cfb3-3119-b7c2-982ffe669dca",
                        "entry_id": "e207d4bf-162a-32a1-9ccf-ddba23ef0c6e",
                        "glosses": [
                            "Région de Wallonie située dans le Hainaut en Belgique, à l’ouest et au sud-ouest de la ville de Mons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "354ef1ef-b6de-4c8e-9ecf-419622456854",
                                "sense_id": "2441f1d5-cfb3-3119-b7c2-982ffe669dca",
                                "text": "Toute petite, elle avait entendu parler des scènes de saccage et de violence qui quelquefois avaient bouleversé le Borinage."
                            },
                            {
                                "example_id": "dc3b7cbe-8738-45e3-83fb-c5d6f2db962d",
                                "sense_id": "2441f1d5-cfb3-3119-b7c2-982ffe669dca",
                                "text": "Il y a soixante ans, le Borinage était en quelque sorte une île et pour le voyageur, qu’il vînt de l’un ou de l’autre des points cardinaux, cette insularité était manifeste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d220748-e06e-4f4c-9b22-0cbd07494309",
                        "source_entry_id": "e207d4bf-162a-32a1-9ccf-ddba23ef0c6e",
                        "source_sense_id": "2441f1d5-cfb3-3119-b7c2-982ffe669dca",
                        "target_lang_word": "Borinage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Borinage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7283d6d6-0e02-379d-8d6a-2c9bbc312204",
                                        "entry_id": "c5d2ea0b-c322-3059-8406-66e6d999c383",
                                        "glosses": [
                                            "Industrielandschaft (süd-)westlich von Mons in der belgischen Provinz Hennegau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c290dfdd-b07d-4f39-9816-006e4dad5f30",
                                                "sense_id": "7283d6d6-0e02-379d-8d6a-2c9bbc312204",
                                                "text": "„Vincent reist im Dezember 1878 – nicht gerade die glücklichste Jahreszeit für diese unwirtliche Gegend – in den Borinage, um seine Stelle anzutreten.“"
                                            },
                                            {
                                                "example_id": "e5446e79-a44f-4f8b-b491-4355f9bdfca8",
                                                "sense_id": "7283d6d6-0e02-379d-8d6a-2c9bbc312204",
                                                "text": "„1790 war das Borinage mit insgesamt 39 Dampfmaschinen das technisch am besten ausgestattete Kohlenrevier Walloniens.“"
                                            },
                                            {
                                                "example_id": "11b52350-6985-4d5a-a5f9-ecd5fb325e16",
                                                "sense_id": "7283d6d6-0e02-379d-8d6a-2c9bbc312204",
                                                "text": "„Die Werke Meuniers sollte man den jungen Künstlern als Vorbild geben; es ist ganz gleich, ob der Bergmann in der Borinage, im Ruhrgebiet Deutschlands oder im englischen Rondetal lebt, eines haben sie alle gleich, das ist die Schwere, die Gefährlichkeit und die Eigenart ihres Berufes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
