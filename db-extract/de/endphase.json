                                        "entry_id": "19e243af-4b3f-33e0-a6a6-7a7d1691287c",
                                        "glosses": [
                                            "de laatste periode van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b093e07-b988-4056-97d5-22a0230e6e56",
                                                "sense_id": "40607e9b-91e4-3a08-bf1a-3e36f1d82d20",
                                                "text": "De slotfase van een schaakpartij noemen we het eindspel."
                                            },
                                            {
                                                "example_id": "3f37bf40-e53d-4414-a5af-beb3b56a55e3",
                                                "sense_id": "40607e9b-91e4-3a08-bf1a-3e36f1d82d20",
                                                "text": "Maar er moest ergens iets fout zijn gegaan, aangezien de hele gietvorm van de brugoverspanning in de slotfase was ingestort. Dat was het enige wat met zekerheid kon worden gezegd."
                                            }
                                        ]
