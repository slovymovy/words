{
    "word_family": [
        "femaleness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "86a8dcaa-5ed6-3e26-914a-042aff743207",
                    "sense_definition": "Of or relating to the sex that can produce eggs or bear offspring.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "biological_sex",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>female</w> bird stays in the nest to keep the eggs warm.",
                            "target_lang_translations": {
                                "ru": "<w>Самка</w> птицы остается в гнезде, чтобы согревать яйца.",
                                "zh": "<w>雌鸟</w>待在巢里给蛋保暖。"
                            }
                        },
                        {
                            "text": "There are more <w>female</w> students than male students in this class.",
                            "target_lang_translations": {
                                "ru": "В этом классе больше студентов <w>женского пола</w>, чем мужского.",
                                "zh": "这个班里<w>女</w>学生比男学生多。"
                            }
                        }
                    ],
                    "antonyms": [
                        "male"
                    ],
                    "common_phrases": [
                        "female population",
                        "female employee",
                        "female author"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к полу, который может производить яйцеклетки или вынашивать потомство.",
                        "zh": "指能够产卵或生育后代的性别。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "женский",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "женского пола",
                                "target_lang_sense_clarification": "биологическое определение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雌性",
                                "target_lang_sense_clarification": "用于动物"
                            },
                            {
                                "target_lang_word": "女性",
                                "target_lang_sense_clarification": "用于人类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61ec673c-fdab-37a5-8bf3-c67a0757fefe",
                    "sense_definition": "Relating to or typical of women or girls; characteristic of the female sex.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "characteristic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a soft, high-pitched <w>female</w> voice.",
                            "target_lang_translations": {
                                "ru": "У нее мягкий, высокий <w>женский</w> голос.",
                                "zh": "她的<w>女性</w>嗓音柔和且音调很高。"
                            }
                        },
                        {
                            "text": "Knitting was traditionally considered a <w>female</w> pastime in that culture.",
                            "target_lang_translations": {
                                "ru": "Вязание традиционно считалось <w>женским</w> занятием в этой культуре.",
                                "zh": "在那种文化中，编织传统上被认为是<w>女性</w>的消遣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feminine",
                        "womanly",
                        "women's"
                    ],
                    "antonyms": [
                        "male"
                    ],
                    "common_phrases": [
                        "female voice",
                        "female intuition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к женщинам или типичный для них; характерный для женского пола.",
                        "zh": "与女性有关的，或女性特有的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "женский",
                                "target_lang_sense_clarification": "характерный для женщин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "女性的",
                                "target_lang_sense_clarification": "形容词，表示女性特质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7cc2fd4-225b-3411-89ab-f2fb36b27e21",
                    "sense_definition": "Designed with a hollow part or socket to receive a corresponding inserted part (called male).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_connector",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to screw the pipe into the <w>female</w> end of the connector.",
                            "target_lang_translations": {
                                "ru": "Вам нужно вкрутить трубу в конец соединителя <w>с внутренней резьбой</w>.",
                                "zh": "你需要把管子拧进连接器的<w>母口</w>端。"
                            }
                        },
                        {
                            "text": "The device has a <w>female</w> USB port on the side.",
                            "target_lang_translations": {
                                "ru": "Сбоку у устройства есть <w>гнездовой</w> USB-порт.",
                                "zh": "该设备侧面有一个<w>母口</w>USB接口。"
                            }
                        }
                    ],
                    "antonyms": [
                        "male"
                    ],
                    "common_phrases": [
                        "female connector",
                        "female thread",
                        "female socket"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сконструированный с углублением или гнездом для приема соответствующей вставляемой части (называемой «папа»).",
                        "zh": "指设计有凹槽或插孔，用于接收对应插入部件的连接器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнездовой",
                                "target_lang_sense_clarification": "о разъемах"
                            },
                            {
                                "target_lang_word": "с внутренней резьбой",
                                "target_lang_sense_clarification": "о трубах и фитингах"
                            },
                            {
                                "target_lang_word": "типа «мама»",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "母口",
                                "target_lang_sense_clarification": "技术术语，指连接器的接收端"
                            },
                            {
                                "target_lang_word": "内螺纹",
                                "target_lang_sense_clarification": "指管道连接处"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0a5005a-5a1e-3642-99cd-74fd3538e4c3",
                    "sense_definition": "A person or animal of the sex that can produce eggs or bear offspring.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "biological_sex",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>female</w> of the species is often larger than the male.",
                            "target_lang_translations": {
                                "ru": "<w>Самка</w> этого вида часто крупнее самца.",
                                "zh": "该物种的<w>雌性</w>通常比雄性大。"
                            }
                        },
                        {
                            "text": "Police described the suspect as a white <w>female</w> in her thirties.",
                            "target_lang_translations": {
                                "ru": "Полиция описала подозреваемую как белую <w>женщину</w> лет тридцати.",
                                "zh": "警方描述嫌疑人为一名三十多岁的白人<w>女性</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "male"
                    ],
                    "common_phrases": [
                        "adult female",
                        "young female"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное пола, способного производить яйцеклетки или вынашивать потомство.",
                        "zh": "能够产卵或生育后代的生物个体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самка",
                                "target_lang_sense_clarification": "о животных"
                            },
                            {
                                "target_lang_word": "женщина",
                                "target_lang_sense_clarification": "о людях"
                            },
                            {
                                "target_lang_word": "особь женского пола",
                                "target_lang_sense_clarification": "формально/биологически"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雌性",
                                "target_lang_sense_clarification": "指动物"
                            },
                            {
                                "target_lang_word": "女性",
                                "target_lang_sense_clarification": "指人类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "294c6a92-e13d-3bac-9904-134b2340f4f7",
                    "sense_definition": "A connector or fitting designed to receive a corresponding inserted part.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_connector",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This adapter connects two <w>females</w> together to extend the pipe.",
                            "target_lang_translations": {
                                "ru": "Этот переходник соединяет две <w>«мамы»</w> (муфты), чтобы удлинить трубу.",
                                "zh": "这个转接头把两个<w>母头</w>连在一起以延长管道。"
                            }
                        },
                        {
                            "text": "Make sure the <w>female</w> is clean before inserting the plug.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>гнездо</w> чистое, прежде чем вставлять штекер.",
                                "zh": "插入插头前请确保<w>插孔</w>是干净的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "male"
                    ],
                    "common_phrases": [
                        "female adapter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединитель или фитинг, предназначенный для приема соответствующей вставляемой части.",
                        "zh": "一种用于接收插入部件的连接器或配件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "«мама»",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "插孔",
                                "target_lang_sense_clarification": "指接口"
                            },
                            {
                                "target_lang_word": "母头",
                                "target_lang_sense_clarification": "技术术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}