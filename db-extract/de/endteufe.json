                ],
                "senses": [
                    {
                        "sense_id": "29cd3668-1a92-3077-91cc-6267a4b8a1ae",
                        "entry_id": "71f62bcf-9760-3f43-8daa-e098be3c9fcb",
                        "glosses": [
                            "Endtiefe (einer Bohrung)"
                        ],
                        "tags": [
                            "bergmannssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "1b48e010-80b5-4045-984c-a2848d54ee9f",
                                "sense_id": "29cd3668-1a92-3077-91cc-6267a4b8a1ae",
                                "text": "Die zweite Geothermiebohrung der Süddeutschen Geothermieprojekte GmbH & Co.KG in Kirchstockach hat am Sonntag, den 29.11.2009 die Endteufe bei 4.452 Meter erreicht."
                            },
                            {
                                "example_id": "a9e7f1f9-78fc-450c-9851-38388ead9b5b",
                                "sense_id": "29cd3668-1a92-3077-91cc-6267a4b8a1ae",
                                "text": "Fachlicher „Höhepunkt“ war 2006 die Forschungsbohrung Viernheim mit einer Endteufe von 350 m, die mit 225 m die bisher größte Mächtigkeit quartärer Sedimente in Hessen erbracht hat."
                            },
                            {
                                "example_id": "45f7e32a-b4c3-4c53-b709-69f76657111b",
                                "sense_id": "29cd3668-1a92-3077-91cc-6267a4b8a1ae",
                                "text": "Nach Erreichen der Endteufe wird der Flüssigkeitsstrom von Bohrspülen auf Düseninjektion umgeschaltet und die Suspension tritt unter hohem Druck […] durch die Düsen aus."
                            },
                            {
                                "example_id": "3e6fe409-3a11-4239-9f1e-71565ddd3a04",
                                "sense_id": "29cd3668-1a92-3077-91cc-6267a4b8a1ae",
                                "text": "Aus dem Sperrohr heraus wird die Bohrung auf Endteufe gebohrt."
                            },
                            {
                                "example_id": "6aca4c75-4146-45af-96d1-5f935eeefe2d",
                                "sense_id": "29cd3668-1a92-3077-91cc-6267a4b8a1ae",
                                "text": "Nach dem Erreichen der Endteufe ist das Bohrloch zu entschlammen und zu säubern."
                            },
                            {
                                "example_id": "774da69c-c970-414e-a7c6-a6a5ef386dd3",
                                "sense_id": "29cd3668-1a92-3077-91cc-6267a4b8a1ae",
                                "text": "In 60 - 70 m Teufe wird es etwas steiler (30 - 45°), um sich dann in den Schiefern, Quarzitschiefern, Metakarbonaten und Sapropeliten ab 86,2 m bis zur Endteufe erneut zu verflachen (10 - 20°)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
