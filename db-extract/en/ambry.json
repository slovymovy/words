    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "29dc5edf-b9f6-301c-bd6b-041f1e678a22",
                "word": "ambry",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "659ee4b3-0835-49d9-96ae-81b244e6c8f3",
                        "entry_id": "29dc5edf-b9f6-301c-bd6b-041f1e678a22",
                        "tags": [
                            "plural"
                        ],
                        "form": "ambries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd1615bd-5d49-389a-8e4b-66d1a3de9e97",
                        "entry_id": "29dc5edf-b9f6-301c-bd6b-041f1e678a22",
                        "glosses": [
                            "A bookcase; a library or archive."
                        ],
                        "tags": [
                            "historical",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0778b734-d31e-4d44-9849-72d08bf2445c",
                                "sense_id": "cd1615bd-5d49-389a-8e4b-66d1a3de9e97",
                                "text": "Whanne Bors had told hym of the aduentures of the Sancgreal suche as had befalle hym / and his thre felawes that was launcelot / Percyual / Galahad / & hym self There Launcelot told the aduentures of the Sancgreal / that he had sene / Alle this was made in grete bookes / and put vp in almeryes at Salysbury"
                            },
                            {
                                "example_id": "2272b90c-fb72-404d-985f-8d1077834a8e",
                                "sense_id": "cd1615bd-5d49-389a-8e4b-66d1a3de9e97",
                                "text": "This collection, then, was the college reference library; corresponding with the common aumbry of the monastery, but also indicative of the principle of all library organisation[…]."
                            }
                        ]
                    },
                    {
                        "sense_id": "838acaf3-440a-3666-85a1-495664072c3e",
                        "entry_id": "29dc5edf-b9f6-301c-bd6b-041f1e678a22",
                        "glosses": [
                            "A storehouse, especially a niche or recess in a wall used for storage."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "64eaecbc-f5b8-45e8-9137-8a8684d63025",
                                "sense_id": "838acaf3-440a-3666-85a1-495664072c3e",
                                "text": "In the closets or almeries on each side of the Frater-house door in the Cloisters, Towels were kept white and clean to dry their Hands upon."
                            },
                            {
                                "example_id": "7b85a312-e2e8-4c25-b1a2-4a403277cec6",
                                "sense_id": "838acaf3-440a-3666-85a1-495664072c3e",
                                "text": "Within the Frater-house Door, on the Left Hand at entering, is a strong Almery in the Wall, wherein a great Mazer, called the Grace Cup, stood, which every Day served the Monks after grace, to drink out of round the Table; which cup was finely edged about with Silver, and double gilt."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7f0019f-5826-3025-bc53-2b1fe2b695a9",
                        "entry_id": "29dc5edf-b9f6-301c-bd6b-041f1e678a22",
                        "glosses": [
                            "A pantry, or place to store food."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6a955436-3669-4bb1-8ba3-2fdccdfa87b9",
                                "sense_id": "e7f0019f-5826-3025-bc53-2b1fe2b695a9",
                                "text": "Used by a wholesaler or retailer as a wine cabinet, the ambry cupboard suited the needs of a neighborhood inn or small-scale private kitchen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6680fc3-b52f-31da-89e4-e40e075c16f8",
                        "entry_id": "29dc5edf-b9f6-301c-bd6b-041f1e678a22",
                        "glosses": [
                            "A cupboard or storage area in a church to hold books, communion vessels, vestments, etc.; an armarium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b8c0f04-ffa2-405f-a61d-91075589b8ab",
                                "sense_id": "f6680fc3-b52f-31da-89e4-e40e075c16f8",
                                "text": "At the end of the bench adjoining to the Frater-house door, was a fine almery fixed to the wall, and another on the other side of the door[…]."
                            },
                            {
                                "example_id": "bc4eafd6-c383-4d7e-ade7-c67d0f45d3d0",
                                "sense_id": "f6680fc3-b52f-31da-89e4-e40e075c16f8",
                                "text": "Nothing else should be kept in the tabernacle or aumbry where the Sacrament is reserved, but a small container of water and a cloth may be kept on the shelf for cleansing one's fingers."
                            },
                            {
                                "example_id": "14f7c3df-384b-4d28-9aa7-7eaf052be9a8",
                                "sense_id": "f6680fc3-b52f-31da-89e4-e40e075c16f8",
                                "text": "Portions of the consecrated bread from the Eucharist were stored or reserved in an ambry or tabernacle to be taken to the sick."
                            }
                        ]
                    }
                ],
