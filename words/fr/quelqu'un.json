                        "parler à quelqu'un"
                    ]
                },
                {
                    "sense_id": "f40230af-c814-3826-a58f-f948144da038",
                    "sense_definition": "Au pluriel, un petit nombre de personnes ou de choses parmi un ensemble.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "pluralite_partielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai lu <w>quelques-uns</w> de ces livres pendant mes dernières vacances."
                        },
                        {
                            "text": "Parmi tous ces candidats, <w>quelques-uns</w> semblent particulièrement bien qualifiés pour le poste."
                        }
                    ],
                    "common_phrases": [
