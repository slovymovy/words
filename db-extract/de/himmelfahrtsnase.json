                        "examples": [
                            {
                                "example_id": "3d2abcb5-b527-47e0-b0e9-a536592a8ada",
                                "sense_id": "9203fbdd-4798-3b89-b99f-9b26eb76de95",
                                "text": "„Drinnen war Tochter Christel damit beschäftigt, Girlanden und allerlei anderes Papierzeug von Wand zu Wand zu ziehen - fohlenbeinig, das blühende Antlitz gerötet und die Himmelfahrtsnase in die Höhe gereckt.“"
                            },
                            {
                                "example_id": "d259871a-cbbf-40d4-8554-efb8f98f8d27",
                                "sense_id": "9203fbdd-4798-3b89-b99f-9b26eb76de95",
                                "text": "„In Geschichte seiberte ein Pauker mit Himmelfahrtsnase über Chaldäer, Assyrer und Phönizier, die Gesetzesstele des Hammurabi und die dorischen Wanderungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
