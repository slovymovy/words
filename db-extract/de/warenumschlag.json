                ],
                "senses": [
                    {
                        "sense_id": "40555c83-9dd4-36fc-991d-b26b53552241",
                        "entry_id": "7cf50316-e8e6-3b37-acc5-82d8240c5352",
                        "glosses": [
                            "Umladung von Gütern in einer Transportkette"
                        ],
                        "tags": [
                            "Logistik"
                        ],
                        "examples": [
                            {
                                "example_id": "f21df466-23d5-405e-a777-a69fc6d5dbea",
                                "sense_id": "40555c83-9dd4-36fc-991d-b26b53552241",
                                "text": "Seit einigen Wochen protestieren die Mitarbeiter einer Gesellschaft, die mit dem Warenumschlag im italienischen Ikea-Zentrallager im norditalienischen Piacenza beauftragt ist, für bessere Löhne."
                            },
                            {
                                "example_id": "ce6db3cf-5c42-4107-9f38-73543286c24a",
                                "sense_id": "40555c83-9dd4-36fc-991d-b26b53552241",
                                "text": "Immerhin kommt es im Güterverkehr - im Gegensatz zum Personenverkehr - meist nicht auf einige Stunden mehr oder weniger Transportdauer an, sondern auf pünktliche Lieferzeit, kostengünstigen Warenumschlag und den Einsatz modernster Logistik."
                            },
                            {
                                "example_id": "dea11bec-a5f8-443c-a087-61566074175f",
                                "sense_id": "40555c83-9dd4-36fc-991d-b26b53552241",
                                "text": "Dabei wird das Hafenbecken um etwa 20 Prozent verkleinert werden. Auf den so gewonnenen neuen Flächen können neue Anlagen für den Warenumschlag errichtet werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3484c7b3-c60c-36db-9143-56f8a13ba1bf",
                        "entry_id": "7cf50316-e8e6-3b37-acc5-82d8240c5352",
                        "glosses": [
                            "Einkauf und Weiterverkauf einer Ware"
                        ],
                        "tags": [
                            "Handel"
                        ],
                        "examples": [
                            {
                                "example_id": "8508b1a8-821c-4263-95ee-d493fdf7d668",
                                "sense_id": "3484c7b3-c60c-36db-9143-56f8a13ba1bf",
                                "text": "Die exportlastige chinesische Wirtschaft gilt als guter Stimmungsbarometer für den weltweiten Warenumschlag."
                            },
                            {
                                "example_id": "3575f269-bdb9-4ece-bebc-179249b0efd4",
                                "sense_id": "3484c7b3-c60c-36db-9143-56f8a13ba1bf",
                                "text": "Ein Höhepunkt jeder Syrienreise ist der Besuch der ehemaligen prunkvollen Oasenstadt Palmyra, mit deren Namen sich vor allem der Warenumschlag im Ost-West-Handel verbindet."
                            },
                            {
                                "example_id": "a8dcd0ee-f496-4afc-ad43-c460c716c0da",
                                "sense_id": "3484c7b3-c60c-36db-9143-56f8a13ba1bf",
                                "text": "Dieser Minorität ist der Rezensent verpflichtet - nicht einer schlingernden Branche, die von Leseförderung redet, wo sie Spassanreize für den Warenumschlag meint."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c903e328-ac2d-4e4f-9dbf-8b143e6b209c",
                        "source_entry_id": "7cf50316-e8e6-3b37-acc5-82d8240c5352",
                        "source_sense_id": "40555c83-9dd4-36fc-991d-b26b53552241",
                        "source_sense_description": "Wirtschaft, Logistik: Umladung von Gütern in einer Transportkette",
                        "target_lang_word": "movement of goods",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d4b905cf-90a8-46c3-901e-ad6cc7fcd1c3",
                        "source_entry_id": "7cf50316-e8e6-3b37-acc5-82d8240c5352",
                        "source_sense_id": "40555c83-9dd4-36fc-991d-b26b53552241",
                        "source_sense_description": "Wirtschaft, Logistik: Umladung von Gütern in einer Transportkette",
                        "target_lang_word": "transshipment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transshipment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a14a3574-448a-3df5-ac50-4213b9e085de",
                                        "entry_id": "87b3ef7d-1047-31a6-8d7f-d3c62afe3113",
                                        "glosses": [
                                            "The transfer of goods from one means of transport to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6135a68a-c70f-411d-a019-9a6577c274c7",
                                                "sense_id": "a14a3574-448a-3df5-ac50-4213b9e085de",
                                                "text": "Zero-emission zones and zero-fatality cities have eliminated the last-mile advantages of moving goods by road. The need for transshipment from trucks to vans or cargo bikes at the fringes of the urban core has meant that road has lost the advantage it held over rail for so much of the last 100 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c93c2b0-3913-36b9-99e0-5dff8e0e8a5f",
                                        "entry_id": "87b3ef7d-1047-31a6-8d7f-d3c62afe3113",
                                        "glosses": [
                                            "The shipment of goods via an intermediate destination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8248d26-3dc0-4b02-8be1-200e91d23e1d",
                                                "sense_id": "9c93c2b0-3913-36b9-99e0-5dff8e0e8a5f",
                                                "text": "Its main export crop is cashew nuts, but drug money has flowed to corrupt officials as smugglers pay bribes to use the country’s coastline and remote airstrips for cocaine transshipments."
                                            },
                                            {
                                                "example_id": "ac46e97e-4ce8-4a95-9179-6c64735b2c4c",
                                                "sense_id": "9c93c2b0-3913-36b9-99e0-5dff8e0e8a5f",
                                                "text": "Higher minimum rates might be necessary to limit heterogeneity in rates and reduce transshipment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f466f88-e50e-4aa8-8a7b-120f3a7563b0",
                        "source_entry_id": "7cf50316-e8e6-3b37-acc5-82d8240c5352",
                        "source_sense_id": "40555c83-9dd4-36fc-991d-b26b53552241",
                        "source_sense_description": "Wirtschaft, Logistik: Umladung von Gütern in einer Transportkette",
                        "target_lang_word": "transbordement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transbordement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "269db125-a74a-3129-bdd7-5a863e7e4418",
                                        "entry_id": "8e2723d7-60f4-3a1e-914a-21d623327952",
                                        "glosses": [
                                            "Action de transborder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de124225-4c65-4d4b-a7a9-340ecfba3ed2",
                                                "sense_id": "269db125-a74a-3129-bdd7-5a863e7e4418",
                                                "text": "Et, lorsque ce vaste bassin se sera desséché par suite d’évaporation, pourquoi une voie ferrée, établie sur son lit de sable, ne permettrait-elle pas aux trains d’aller sans transbordement de Bakou à Ouzoun-Ada ?…"
                                            },
                                            {
                                                "example_id": "af57f986-0c62-46b8-b2dc-a0640e6d5681",
                                                "sense_id": "269db125-a74a-3129-bdd7-5a863e7e4418",
                                                "text": "Kazan, Kouibychev, Batraki, Volgograd sont de grands centres de transbordement pour les marchandises passant du chemin de fer à la Volga et inversement."
                                            },
                                            {
                                                "example_id": "8325cc5a-9c52-44aa-8e84-e0bc86151274",
                                                "sense_id": "269db125-a74a-3129-bdd7-5a863e7e4418",
                                                "text": "Le coût du projet d’extension de l’Euroterminal est estimé à un milliard d’euros. L’Euroterminal de Sławków bénéficie d’un positionnement unique : il se trouve à l’intersection de la voie ferrée la plus occidentale à écartement large (1 520 mm) et des lignes ferroviaires européennes à écartement standard (1 435 mm). Cette configuration en fait un point névralgique pour le transbordement de conteneurs transportés entre l’Asie, notamment la Chine, et l’Europe occidentale, y compris via l’Ukraine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f65e3554-ccf3-3598-b9b4-7cb3a0c7e63f",
                                        "entry_id": "8e2723d7-60f4-3a1e-914a-21d623327952",
                                        "glosses": [
                                            "Action de transférer un chargement d'un navire à un autre, éventuellement avec mise à quai intermédiaire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06d9e2bd-452f-4494-a66d-b3a2507d202e",
                                                "sense_id": "f65e3554-ccf3-3598-b9b4-7cb3a0c7e63f",
                                                "text": "Les déchargements et transbordements doivent avoir lieu pendant les heures et sous les conditions fixées par des arrêtés du directeur général des douanes et droits indirects."
                                            },
                                            {
                                                "example_id": "d74f838c-984a-4f93-8321-dfce7ce9da57",
                                                "sense_id": "f65e3554-ccf3-3598-b9b4-7cb3a0c7e63f",
                                                "text": "Notre lot [de tonneaux truqués] à nous va directement à Londres, via Riga. C'est l'itinéraire le plus court et il n'y a qu'un seul transbordement. Ces transbordements causent beaucoup d'ennuis à celui qui voyage dans un tonneau, car alors il est roulé, secoué, contrechoqué et court le risque de faire la fin du voyage la tête en bas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
