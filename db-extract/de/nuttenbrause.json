                "senses": [
                    {
                        "sense_id": "09376839-2b4c-30d0-a0f0-a6de170c2450",
                        "entry_id": "3e562fee-8b16-30e5-bda1-739a2a2dc177",
                        "glosses": [
                            "ein Getränk, das gerne in Bordellen getrunken wird (Synonym für Sekt)"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "15b0621c-fd5e-4e85-ae85-7053f95a3c95",
                                "sense_id": "09376839-2b4c-30d0-a0f0-a6de170c2450",
                                "text": "„Robert mutiert zum Weinspezialisten, wenn er auch den vergorenen Sekt eher als „Nuttenbrause“ empfindet, aber nach der dritten Probe sich zum Fachmann und Weinspezialisten fortentwickelt. War ihm bisher das Gesöff im „Abgang zum Gaumen“ fremd, so findet er Zugang zu den edlen Tropfen als „glasig mit floraler Nuance“.“"
                            },
                            {
                                "example_id": "421560da-69a1-4598-ae65-8387ee74f99c",
                                "sense_id": "09376839-2b4c-30d0-a0f0-a6de170c2450",
                                "text": "„Genießbar ist bei der billigen Nuttenbrause wohl das falsche Wort.“"
                            },
                            {
                                "example_id": "ed1d583b-a123-4f3b-b060-3990e9971a98",
                                "sense_id": "09376839-2b4c-30d0-a0f0-a6de170c2450",
                                "text": "„Auf die Nuttenbrause und den Blumenstrauß bei Fahrzeugübergabe verzichte gern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
