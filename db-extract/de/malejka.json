                "senses": [
                    {
                        "sense_id": "5e6cc49c-54e5-3a6e-845a-c8f88aca2711",
                        "entry_id": "86096a9b-3342-3a77-9ea9-278a1432d766",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ade9ff-2b7c-4459-a91a-5bdec313ad33",
                                "sense_id": "5e6cc49c-54e5-3a6e-845a-c8f88aca2711",
                                "text": "Frau Malejka ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fd718306-24fd-4274-b453-37b6e055968e",
                                "sense_id": "5e6cc49c-54e5-3a6e-845a-c8f88aca2711",
                                "text": "Herr Malejka wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ce507fe3-7c6f-4fe2-bb0e-d3d29cab74af",
                                "sense_id": "5e6cc49c-54e5-3a6e-845a-c8f88aca2711",
                                "text": "Die Malejkas fahren heute ins Rheinland."
                            },
                            {
                                "example_id": "7f94d18e-f0d1-4d78-8211-9e1cb89c9976",
                                "sense_id": "5e6cc49c-54e5-3a6e-845a-c8f88aca2711",
                                "text": "Der Malejka trägt nie die Schals, die die Malejka ihm strickt."
                            },
                            {
                                "example_id": "a51d6840-2a9a-4e75-abc4-ca1b159b4ae4",
                                "sense_id": "5e6cc49c-54e5-3a6e-845a-c8f88aca2711",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Malejka kommt, geht der Herr Malejka.“"
                            },
                            {
                                "example_id": "62792129-af6e-4821-b75e-88c6b645a1f0",
                                "sense_id": "5e6cc49c-54e5-3a6e-845a-c8f88aca2711",
                                "text": "Malejka kommt und geht."
                            },
                            {
                                "example_id": "0e6b8196-656d-4238-8c48-ba4fb8072bb6",
                                "sense_id": "5e6cc49c-54e5-3a6e-845a-c8f88aca2711",
                                "text": "Malejkas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
