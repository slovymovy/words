                                        "entry_id": "4858ffe3-c5ce-36cf-95a2-58cb45d229ad",
                                        "glosses": [
                                            "een fijn soort zacht leer oorspronkelijk vervaardigd van gemzenhuid, later van een bepaald deel van de huid van een schaap of lam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a47735a3-0849-4a24-bd63-1ead59dc46b0",
                                                "sense_id": "4c02d9eb-9d7c-3af1-a888-d90333b0fa03",
