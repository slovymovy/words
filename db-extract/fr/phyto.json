                "senses": [
                    {
                        "sense_id": "f14afc44-0f5f-3d3b-a2c2-ca42296a2dbd",
                        "entry_id": "79fb2ecf-5b5b-3137-8e53-789f45a9f96a",
                        "glosses": [
                            "Phytosanitaire."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f39e3974-efa6-4156-854f-8975a060be26",
                                "sense_id": "f14afc44-0f5f-3d3b-a2c2-ca42296a2dbd",
                                "text": "Les résultats des expériences menées par les différents organismes internationaux d'essais démontrent que le concept de « l'emballage intelligent » et du rinçage permettent d'obtenir un résidu minimal de produit phyto dans le bidon."
                            },
                            {
                                "example_id": "2ecdf21f-7336-4754-9640-188a85681ed2",
                                "sense_id": "f14afc44-0f5f-3d3b-a2c2-ca42296a2dbd",
                                "text": "L'agence d'évaluation des intrants a été créée et s'occupe désormais « de l'évaluation des produits phyto, des adjuvants, des matières fertilisantes et des supports de culture »."
                            }
                        ]
                    }
