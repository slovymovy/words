                        "sense_id": "02be9dd5-c10c-3e5d-b53e-42bc9b5932e3",
                        "entry_id": "646b3bee-763d-3d03-b212-4badd951e42e",
                        "glosses": [
                            "Fahrgeschäft auf Volksfesten oder in Freizeitparks, das aus einer schwingenden, meist oben offenen Plattform besteht, die einem Schiff nachempfunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00924943-e2ce-42b3-9751-2c34cc010952",
                                "sense_id": "02be9dd5-c10c-3e5d-b53e-42bc9b5932e3",
                                "text": "Die Einweihung der neuen Schiffschaukel im lokalen Freizeitpark war ein Fest für Alt und Jung."
                            },
                            {
                                "example_id": "0fe319eb-124f-4c68-8bcf-dc99220d4f75",
                                "sense_id": "02be9dd5-c10c-3e5d-b53e-42bc9b5932e3",
                                "text": "„Der Kleine gab das mit weinerlicher Stimme zu und erzählte dann, etwas aufatmend, daß er bis vor kurzem mit den Besitzern einer Schiffschaukel auf den Jahrmärkten herumgezogen sei.“"
                            }
                        ],
