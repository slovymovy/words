                ],
                "senses": [
                    {
                        "sense_id": "6416f3e4-4c6b-3755-8640-17c9f0a58cd4",
                        "entry_id": "9789393d-358f-3e0a-93a4-411f7b9936c9",
                        "glosses": [
                            "Objects that are connected to or remind their owner of past events."
                        ],
                        "tags": [
                            "plural",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "c1568f8a-1519-450e-9bd7-019a682563c3",
                                "sense_id": "6416f3e4-4c6b-3755-8640-17c9f0a58cd4",
                                "text": "George has a collection of World War II memorabilia."
                            },
                            {
                                "example_id": "444d84e8-037a-490c-8a4a-d664b182d822",
                                "sense_id": "6416f3e4-4c6b-3755-8640-17c9f0a58cd4",
                                "text": "I can't remember / Give me a reminder / I collect, I reject / Memorabilia / Memorabilia"
                            },
                            {
                                "example_id": "e4795cd4-b919-4415-a6c2-75064537b348",
                                "sense_id": "6416f3e4-4c6b-3755-8640-17c9f0a58cd4",
                                "text": "Have you seen the memorabilia / The rusty old memorabilia / The souvenirs of perfect doom / In the back of Louis Dakine's backroom"
                            }
                        ]
                    },
                    {
                        "sense_id": "1ad56daf-626c-39c1-b287-b40e8ed6210d",
                        "entry_id": "9789393d-358f-3e0a-93a4-411f7b9936c9",
                        "glosses": [
                            "Things worth remembering: noteworthy points."
                        ],
                        "tags": [
                            "archaic",
                            "plural",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "2d9baba4-6eed-470e-bf3d-e0093317f2af",
                                "sense_id": "1ad56daf-626c-39c1-b287-b40e8ed6210d",
                                "text": "On the other hand, how uſeful is ſuch a faculty, if well exerciſed! To it we owe all thoſe intereſting apothegms and memorabilia of the ancients, which Plutarch, Xenophon, and Valerius Maximus, have tranſmitted to us."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d430f040-01c7-4f74-83e7-ea0f54d92b9b",
                        "source_entry_id": "9789393d-358f-3e0a-93a4-411f7b9936c9",
                        "source_sense_description": "objects that are connected to past events",
                        "target_lang_word": "objets de collection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "096399cf-09a2-47a1-958d-b89011688a21",
                        "source_entry_id": "9789393d-358f-3e0a-93a4-411f7b9936c9",
                        "source_sense_description": "objects that are connected to past events",
                        "target_lang_word": "souvenirs",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "souvenirs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e1b9f23-3b47-38db-bb24-ead266f28baf",
                                        "entry_id": "3ae98ef5-07c1-3c29-a037-c4eb61fb512b",
                                        "glosses": [
                                            "Pluriel de souvenir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87389c08-aa69-4bf7-a8e0-e0b4814ec273",
                                                "sense_id": "1e1b9f23-3b47-38db-bb24-ead266f28baf",
                                                "text": "Mais tandis qu’à Moscou je ne voyais se lever d’autres souvenirs historiques que de conquête napoléonienne, vain effort suivi tout aussitôt de désastre, à Leningrad maints édifices me rappellent ce qu’ont pu avoir de plus cordial et de plus fécondant les relations intellectuelles entre la Russie et la France."
                                            },
                                            {
                                                "example_id": "b658c83d-e3a0-429a-8674-70d1d742844f",
                                                "sense_id": "1e1b9f23-3b47-38db-bb24-ead266f28baf",
                                                "text": "Toujours servi par son étoile, il entre le premier en Alsace, fait la campagne de Salonique, survit à l’épidémie d’entérite qui nettoie sa formation, rapporte Lectures pour une ombre où il trouve moyen de gongoriser avec une grâce raffinée et parfois profonde (c’est l’un de ses meilleurs livres), sur ses horribles souvenirs de fantassin."
                                            },
                                            {
                                                "example_id": "039c74ed-4029-4f9f-b49a-b4aca4504aed",
                                                "sense_id": "1e1b9f23-3b47-38db-bb24-ead266f28baf",
                                                "text": "Les souvenirs sont de grands espaces vides que l’on parcourt souvent en silence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
