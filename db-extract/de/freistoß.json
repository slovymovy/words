                "senses": [
                    {
                        "sense_id": "0ca2a33a-b1de-37d5-bc15-c221e67a0e8f",
                        "entry_id": "f1816982-8e9e-3c20-9451-ca1b36626956",
                        "glosses": [
                            "vom Schiedsrichter verordnete Maßnahme beim Fußballspiel, bei der der Ball vom Schützen ungehindert gespielt wird, nachdem die gegnerische Mannschaft einen Regelverstoß (Foul) begangen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b6ab6d-427a-492d-9eb3-e1cc8f12fb48",
                                "sense_id": "0ca2a33a-b1de-37d5-bc15-c221e67a0e8f",
                                "text": "Simone hat mal wieder einen Freistoß verwandelt."
                            },
                            {
                                "example_id": "c10788e6-d324-4710-b3e1-ef932bc7d274",
                                "sense_id": "0ca2a33a-b1de-37d5-bc15-c221e67a0e8f",
                                "text": "Nils tritt den Freistoß."
                            },
                            {
                                "example_id": "2046f173-56bf-4341-a29a-32fb5e742d58",
                                "sense_id": "0ca2a33a-b1de-37d5-bc15-c221e67a0e8f",
                                "text": "„Wir haben dann noch eine Weile weiter Fußball gespielt, ich habe die Bälle aufs Tor geschossen, und Michael hat sich geworfen und gewälzt, und dann haben wir Eckbälle und Freistöße geschossen, und am Ende haben wir etwas gedribbelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac8b179a-03da-48a4-b5ab-2acb8f8c0981",
