        "fr-extract.jsonl": [
            {
                "entry_id": "77f2f8b0-a848-3c60-bc26-e01dad18c724",
                "word": "porte-cartes",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8f54ff40-6d61-35f1-84c7-8da5e7893c8e",
                        "entry_id": "77f2f8b0-a848-3c60-bc26-e01dad18c724",
                        "glosses": [
                            "Petit portefeuille servant à mettre des cartes de visite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8455e428-3fa7-4f93-a7c2-dff8548dc61a",
                                "sense_id": "8f54ff40-6d61-35f1-84c7-8da5e7893c8e",
                                "text": "Ma mère me fit quelques petits cadeaux, comme un vieux porte-cartes à elle, du temps de sa jeunesse, retrouvé dans un tiroir, une petite boîte de cachou, le portrait de son fils, un savon."
                            },
                            {
                                "example_id": "5b32653d-777d-4ca5-ab88-a77c97211bc7",
                                "sense_id": "8f54ff40-6d61-35f1-84c7-8da5e7893c8e",
                                "text": "Deux pièces d’un maroquinier parisien devaient avoir été des cadeaux de Michel. L’un, d’aspect très Belle Époque, était un porte-cartes à fond mi-violet, mi-vert d’eau, sur lequel se détachaient avec une élégance japonaise des iris d’émail. La mode des porte-cartes ayant fait son temps, j’y mis, copiés sur de minces bristols, des vers ou des pensées qui m’étaient chers vers 1929 ou m’aidaient à me guider dans la vie."
                            },
                            {
                                "example_id": "c71cbd9c-1339-4597-a60f-974d800bbf58",
                                "sense_id": "8f54ff40-6d61-35f1-84c7-8da5e7893c8e",
                                "text": "Il n’a rien dans les poches, ni porte-cartes, ni portefeuille."
                            },
                            {
                                "example_id": "93f1909f-61e1-42ac-b88e-d2f2d86936c4",
                                "sense_id": "8f54ff40-6d61-35f1-84c7-8da5e7893c8e",
                                "text": "Montrez-lui que vous le portez dans votre cœur avec ce porte-cartes étincelant et ressourcé !"
                            }
                        ]
                    },
                    {
                        "sense_id": "bc5f0870-b107-3dec-98e2-bfd0747b7177",
                        "entry_id": "77f2f8b0-a848-3c60-bc26-e01dad18c724",
                        "glosses": [
                            "Sorte d’étui destiné à contenir des cartes d’état-major ou les cartes routières."
                        ],
