                                        "sense_id": "a9354198-cf5a-3a26-a92b-f1ee7e3d634a",
                                        "entry_id": "dd8bd0d0-aec1-38a4-af30-05dc6f801afe",
                                        "glosses": [
                                            "Vorteil, den man aus dem Gebrauch einer Sache zieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29106129-8eeb-4848-9f42-06d18fb8dd34",
                                                "sense_id": "a9354198-cf5a-3a26-a92b-f1ee7e3d634a",
                                                "text": "Der Nutzen dieses Programms liegt in der Flexibilität und den vielen Erweiterungen."
                                            },
                                            {
                                                "example_id": "066ce2f6-7128-47f0-86a6-261dec5f5bd8",
                                                "sense_id": "a9354198-cf5a-3a26-a92b-f1ee7e3d634a",
