                "senses": [
                    {
                        "sense_id": "48683737-6bea-3330-aecb-08487bda078a",
                        "entry_id": "673d6892-9a08-308e-a303-f69dae85bca6",
                        "glosses": [
                            "To tease someone in a kindly or friendly fashion."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6c012001-5521-43ca-9e03-83b956399016",
                                "sense_id": "48683737-6bea-3330-aecb-08487bda078a",
                                "text": "\"My dear Polly. I welcome criticism, but this is mere——\"\nLady Wetherby stroked his coat sleeve fondly.\n\"Never mind, Algie, I was only joshing you, precious.[…]\""
                            }
                        ]
                    },
                    {
                        "sense_id": "0281edf3-363b-3edc-987f-ca50fafbfbdf",
                        "entry_id": "673d6892-9a08-308e-a303-f69dae85bca6",
                        "glosses": [
                            "To make or exchange good-natured jokes."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e30772a7-af54-4a63-918a-5a9a1f4fc79a",
                                "sense_id": "0281edf3-363b-3edc-987f-ca50fafbfbdf",
                                "text": "We are old friends, did I not tell you? So I may, what you Americans call, josh with him."
                            },
                            {
                                "example_id": "1b07f028-9ed1-4465-95f7-0f22ef04659f",
                                "sense_id": "0281edf3-363b-3edc-987f-ca50fafbfbdf",
                                "text": "“Cut that joshing out,” she said, coolly and briskly. “Who do you think you are talking to? Your check, please. Oh, Lordy!—”"
                            },
                            {
                                "example_id": "7ee23cad-7289-4bb5-8932-f4c4fa573cce",
                                "sense_id": "0281edf3-363b-3edc-987f-ca50fafbfbdf",
                                "text": "Boris, it seems, is taking it in this spirit, joshing beneath his ever-redeeming barnet that Labour's opposition to military action in Syria is a fey stance that he, as GQ politician of the year, would never be guilty of."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60651ec7-8413-4aa1-a4ea-932fbbac9266",
                        "source_entry_id": "673d6892-9a08-308e-a303-f69dae85bca6",
