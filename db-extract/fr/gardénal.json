        "fr-extract.jsonl": [
            {
                "entry_id": "6b108b63-6534-36f4-b6cc-7584961b9719",
                "word": "Gardénal",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9fbf063b-069c-49c5-b563-a293853a710a",
                        "entry_id": "6b108b63-6534-36f4-b6cc-7584961b9719",
                        "tags": [
                            "plural"
                        ],
                        "form": "Gardénals"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "298d0c9a-0f87-38d7-830d-90a72e72df29",
                        "entry_id": "6b108b63-6534-36f4-b6cc-7584961b9719",
                        "glosses": [
                            "Phénobarbital."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec2875a3-4911-4c84-b505-4487b0563ada",
                                "sense_id": "298d0c9a-0f87-38d7-830d-90a72e72df29",
                                "text": "Je me réveillai à cinq heures du matin en entendant Cristofoli entrer dans ma chambre. Son visage rayonnait d’un bonheur surhumain, il était incapable de parler, il ne faisait que déclamer des vers et pleurer. Je lui dis de prendre un gardénal et de me laisser dormir."
                            },
                            {
                                "example_id": "74573690-db83-44b9-8120-413519728402",
                                "sense_id": "298d0c9a-0f87-38d7-830d-90a72e72df29",
                                "text": "Mets-en dix. Dans son tilleul. Dix cachets de gardénal. Mais tu n’oseras pas."
                            },
                            {
                                "example_id": "62e38f55-badf-44b9-a353-dcb29d8d0cac",
                                "sense_id": "298d0c9a-0f87-38d7-830d-90a72e72df29",
                                "text": "Me parle d’un jeune homme qui n’a pas pu continuer la lutte et qui s’est tué en absorbant une grosse quantité de gardénal, trop grosse, semble-t-il, car la mort a été longue à venir."
                            },
                            {
                                "example_id": "71298b75-7a9b-4a49-b1d4-eec2ebbc2b11",
                                "sense_id": "298d0c9a-0f87-38d7-830d-90a72e72df29",
                                "text": "Avant de se retirer, Sylvia prit un comprimé de gardénal, ce qui n’était pas dans ses habitudes ; mais elle savait bien que, avec l’esprit aussi leste et bondissant qu’à présent, elle ne pourrait jamais s’endormir sans cachet."
                            }
                        ]
                    }
                ],
