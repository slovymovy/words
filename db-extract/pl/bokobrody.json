                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koteletten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23bd691a-74c3-3936-95bf-ed5614134147",
                                        "entry_id": "f6e263a9-bd2a-3b0e-ac17-600cfd036e5a",
                                        "glosses": [
                                            "zwischen Wangen und Ohren wachsender Teil des Haupthaars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488aedcc-16d4-4ea8-85a3-a86c095d1a4f",
                                                "sense_id": "23bd691a-74c3-3936-95bf-ed5614134147",
                                                "text": "Ein Markenzeichen von Elvis Presley waren die Koteletten."
                                            },
                                            {
                                                "example_id": "22a30d4b-87ac-47f7-8e10-90f0918bc96e",
                                                "sense_id": "23bd691a-74c3-3936-95bf-ed5614134147",
                                                "text": "„Am vierten Fenster saß ein sehr wohlgekleideter, jugendlich verfetteter Herr mit altmodisch attraktiven Koteletten und einem zugleich weichen und herrischen und jedenfalls hinreißenden Bonvivantgesicht.“"
                                            },
                                            {
                                                "example_id": "256644d1-f884-46ef-8c6b-49111843dc31",
                                                "sense_id": "23bd691a-74c3-3936-95bf-ed5614134147",
                                                "text": "„Er trug einen Anzug aus geköpertem Barchent, seine Haltung war steif, der Backenbart zu Koteletten gestutzt; so wirkte er wie ein Beamter und Dandy zugleich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
