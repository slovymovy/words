                                        "examples": [
                                            {
                                                "example_id": "7ff5b955-37f0-42dc-9f3b-03cd030e9adb",
                                                "sense_id": "d9a19c51-6122-3e37-8232-fd15651097dc",
                                                "text": "Um inquérito será aberto e a perícia técnica da Polícia Civil deverá apontar as causas do acidente."
