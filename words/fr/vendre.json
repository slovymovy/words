                    "sense_id": "0d5f9191-3260-392c-8c1b-5adafc878fbf",
                    "sense_definition": "Céder la propriété d'un bien ou d'une marchandise à quelqu'un contre une somme d'argent.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il veut <w>vendre</w> sa vieille voiture pour acheter un modèle plus récent.",
                            "target_lang_translations": {
                                "en": "He wants to <w>sell</w> his old car to buy a newer model.",
                                "ru": "Он хочет <w>продать</w> свою старую машину, чтобы купить более новую модель.",
                                "nl": "Hij wil zijn oude auto <w>verkopen</w> om een nieuwer model te kopen.",
                                "de": "Er will sein altes Auto <w>verkaufen</w>, um ein neueres Modell zu kaufen.",
                                "pl": "Chce <w>sprzedać</w> swój stary samochód, żeby kupić nowszy model.",
                                "it": "Vuole <w>vendere</w> la sua vecchia auto per comprarne un modello più recente.",
                                "cs": "Chce <w>prodat</w> své staré auto, aby si koupil novější model.",
                                "tr": "Daha yeni bir model almak için eski arabasını <w>satmak</w> istiyor.",
                                "es": "Quiere <w>vender</w> su coche viejo para comprar un modelo más reciente.",
                                "zh": "他想把旧车<w>卖</w>掉，再买一款更新的车型。"
                            }
                        },
                        {
                            "text": "Cette boulangerie du centre-ville <w>vend</w> du pain frais tous les matins.",
                            "target_lang_translations": {
                                "en": "This bakery in the city centre <w>sells</w> fresh bread every morning.",
                                "ru": "Эта булочная в центре города каждое утро <w>продаёт</w> свежий хлеб.",
                                "nl": "Deze bakkerij in het stadscentrum <w>verkoopt</w> elke ochtend vers brood.",
                                "de": "Diese Bäckerei in der Innenstadt <w>verkauft</w> jeden Morgen frisches Brot.",
                                "pl": "Ta piekarnia w centrum miasta <w>sprzedaje</w> świeży chleb każdego ranka.",
                                "it": "Questa panetteria del centro <w>vende</w> pane fresco ogni mattina.",
                                "cs": "Tato pekárna v centru města <w>prodává</w> každé ráno čerstvý chléb.",
                                "tr": "Şehir merkezindeki bu fırın her sabah taze ekmek <w>satıyor</w>.",
                                "es": "Esta panadería del centro de la ciudad <w>vende</w> pan fresco todas las mañanas.",
                                "zh": "市中心的这家面包店每天早上都<w>卖</w>新鲜面包。"
                            }
                        }
                    ],
                    "synonyms": [
                        "céder",
                        "écouler"
                    ],
                    "antonyms": [
                        "acheter",
                        "acquérir"
                    ],
                    "common_phrases": [
                        "vendre à perte",
                        "vendre aux enchères",
                        "vendre au détail"
