    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c134494c-56c9-31c5-9567-76e92810f38b",
                    "sense_definition": "met de tong aanraken of over iets heen strijken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tonggebruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kleine jongetje <w>likte</w> enthousiast aan zijn grote lolly.",
                            "target_lang_translations": {
                                "en": "The little boy enthusiastically <w>licked</w> his large lollipop.",
                                "ru": "Маленький мальчик с энтузиазмом <w>лизал</w> свой большой леденец."
                            }
                        },
                        {
                            "text": "De hond <w>likt</w> de hand van zijn baasje om hem te begroeten.",
                            "target_lang_translations": {
                                "en": "The dog <w>licks</w> its owner's hand to greet him.",
                                "ru": "Собака <w>лижет</w> руку своего хозяина, чтобы поприветствовать его."
                            }
                        },
                        {
                            "text": "Zij <w>likte</w> haar lippen af na het eten van de heerlijke taart.",
                            "target_lang_translations": {
                                "en": "She <w>licked</w> her lips after eating the delicious cake.",
                                "ru": "Она <w>облизала</w> губы после того, как съела вкусный торт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lippen likken",
                        "aan een ijsje likken",
                        "een wond likken"
                    ],
                    "target_lang_definitions": {
                        "en": "to touch or stroke something with the tongue",
                        "ru": "прикасаться языком или проводить им по чему-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lick",
                                "target_lang_sense_clarification": "to stroke with the tongue"
                            },
                            {
                                "target_lang_word": "lap",
                                "target_lang_sense_clarification": "to take in liquid with the tongue"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лизать",
                                "target_lang_sense_clarification": "проводить языком по поверхности"
                            },
                            {
                                "target_lang_word": "облизывать",
                                "target_lang_sense_clarification": "проводить языком вокруг или по всей поверхности"
                            },
                            {
                                "target_lang_word": "лизывать",
                                "target_lang_sense_clarification": "лакать или слизывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cbc0318-d7f5-32c4-81f7-2b5940ed771d",
                    "sense_definition": "iets heel glad maken of glanzend polijsten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "afwerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakman heeft het houtwerk prachtig <w>gelikt</w> tot het glansde.",
                            "target_lang_translations": {
                                "en": "The craftsman <w>polished</w> the woodwork beautifully until it shone.",
                                "ru": "Мастер великолепно <w>отполировал</w> деревянные изделия до блеска."
                            }
                        },
                        {
                            "text": "Alles in de nieuwe showroom ziet er perfect <w>gelikt</w> en gepolijst uit.",
                            "target_lang_translations": {
                                "en": "Everything in the new showroom looks perfectly <w>slick</w> and polished.",
                                "ru": "Все в новом выставочном зале выглядит идеально <w>вылизанным</w> и отполированным."
                            }
                        }
                    ],
                    "synonyms": [
                        "polijsten",
                        "gladmaken"
                    ],
                    "common_phrases": [
                        "glad likken"
                    ],
                    "target_lang_definitions": {
                        "en": "to make something very smooth or to polish it until it shines",
                        "ru": "делать что-либо очень гладким или полировать до блеска"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "polish",
                                "target_lang_sense_clarification": "to make smooth and shiny"
                            },
                            {
                                "target_lang_word": "slick",
                                "target_lang_sense_clarification": "to make smooth or glossy"
                            },
                            {
                                "target_lang_word": "buff",
                                "target_lang_sense_clarification": "to polish with a soft material"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "полировать",
                                "target_lang_sense_clarification": "делать гладким и блестящим"
                            },
                            {
                                "target_lang_word": "вылизывать",
                                "target_lang_sense_clarification": "доводить до идеального состояния (переносное)"
                            },
                            {
                                "target_lang_word": "шлифовать",
                                "target_lang_sense_clarification": "устранять неровности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2941ae40-c215-3a27-89b0-73a38231d7e8",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>lik</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat gaf de kittens een paar stevige <w>likken</w> over hun kopjes.",
                            "target_lang_translations": {
                                "en": "The cat gave the kittens a few firm <w>licks</w> over their heads.",
                                "ru": "Кошка несколько раз крепко <w>лизнула</w> котят по их головкам."
                            }
                        },
                        {
                            "text": "Met een paar <w>likken</w> verf ziet de oude kast er weer als nieuw uit.",
                            "target_lang_translations": {
                                "en": "With a few <w>coats</w> of paint, the old cupboard looks like new again.",
                                "ru": "После пары <w>мазков</w> краски старый шкаф снова выглядит как новый."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een paar likken"
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of the noun 'lick', referring to the act of licking or a small amount of something applied quickly",
                        "ru": "форма множественного числа существительного 'лизок', относящаяся к акту лизания или небольшому количеству нанесенного вещества"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "licks",
