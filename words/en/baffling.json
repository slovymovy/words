    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f08b4710-47a8-349a-b2c3-7a3bc7176f59",
                    "sense_definition": "Extremely confusing, puzzling, or difficult to understand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective found the suspect's sudden disappearance completely <w>baffling</w>.",
                            "target_lang_translations": {
                                "it": "Il detective trovò la scomparsa improvvisa del sospettato del tutto <w>sconcertante</w>."
                            }
                        },
                        {
                            "text": "Scientists are trying to solve this <w>baffling</w> medical mystery.",
                            "target_lang_translations": {
                                "it": "Gli scienziati stanno cercando di risolvere questo <w>enigmatico</w> mistero medico."
                            }
                        }
                    ],
                    "synonyms": [
                        "perplexing",
                        "bewildering",
                        "puzzling",
                        "mystifying"
                    ],
                    "antonyms": [
                        "clear",
                        "obvious",
                        "comprehensible"
                    ],
                    "common_phrases": [
                        "baffling question",
                        "baffling mystery",
                        "completely baffling"
                    ],
                    "target_lang_definitions": {
