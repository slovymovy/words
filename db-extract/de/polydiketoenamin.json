                "senses": [
                    {
                        "sense_id": "5e9f4f86-3b61-36c7-b413-340ece96a396",
                        "entry_id": "d3f384e6-37a5-32d1-bf8c-ca95cb744d72",
                        "glosses": [
                            "Polymer, das durch ein Säurebad in seine Grundbestandteile zerlegt und vollständig recycelt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e32877-5494-4801-b48a-ab6c2f4f5219",
                                "sense_id": "5e9f4f86-3b61-36c7-b413-340ece96a396",
                                "text": "Um diese Probleme zu lösen, haben Wissenschaftler ein Polymer der nächsten Generation („Polydiketoenamine“ oder PDK) entwickelt, das eine spezielle chemische Verknüpfung verwendet, die es einfach macht, die Kunststoffmonomere von anderen Abfallverunreinigungen zu trennen."
                            },
                            {
                                "example_id": "51bfa3d6-56d4-426f-87db-1278db2a5871",
                                "sense_id": "5e9f4f86-3b61-36c7-b413-340ece96a396",
                                "text": "Nicht so aber Polydiketoenamine (PDK): „Unseren Durchbruch verdanken wir einem Zufall beim Saubermachen“, gibt Helms zu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
