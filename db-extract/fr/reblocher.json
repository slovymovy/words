                "senses": [
                    {
                        "sense_id": "8ebba85a-85ee-3bd0-a578-6ff845ffdef2",
                        "entry_id": "3a9f2b66-29f6-3b16-bf76-eb32a8d93070",
                        "glosses": [
                            "Traire à nouveau, après une première traite."
                        ],
                        "tags": [
                            "Savoie"
                        ],
                        "examples": [
                            {
                                "example_id": "b5543077-b51e-4f1a-a065-01078c7c6534",
                                "sense_id": "8ebba85a-85ee-3bd0-a578-6ff845ffdef2",
                                "text": "Jadis le locataire d’un alpage payait le propriétaire en nature d’après la quantité de lait produite. Le jour où le propriétaire montait, le locataire, ou plutôt le métayer, trésait partiellement puis, après son départ, reblochait."
                            },
                            {
                                "example_id": "f1fd7881-bdc4-4cab-88ed-168867ef597c",
                                "sense_id": "8ebba85a-85ee-3bd0-a578-6ff845ffdef2",
                                "text": "A la Grâce de Dieu, dans ma seconde vie, pourriez-vous me reblocher et caresser mon âpre mont ?"
                            }
                        ]
                    }
                ],
