        "fr-extract.jsonl": [
            {
                "entry_id": "f983c053-a999-389d-b2b4-3af1fe26a16d",
                "word": "plaisamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dfda05ff-1c79-3a88-a41a-fe4a5c90d0f6",
                        "entry_id": "f983c053-a999-389d-b2b4-3af1fe26a16d",
                        "glosses": [
                            "D’une manière plaisante, agréable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "989a0bf8-1b91-4038-b87f-0739523eb1e5",
                                "sense_id": "dfda05ff-1c79-3a88-a41a-fe4a5c90d0f6",
                                "text": "Mme de Coulanges conte fort plaisamment cette scène,"
                            },
                            {
                                "example_id": "7a708641-25cb-462c-808a-a6b42e13fde0",
                                "sense_id": "dfda05ff-1c79-3a88-a41a-fe4a5c90d0f6",
                                "text": "Que ne venait-elle après moi ; et je l’aurais dit avant elle, a dit plaisamment un poëte en parlant de l’antiquité,"
                            },
                            {
                                "example_id": "3382308e-54b8-43fb-b41c-9fcebc8ccd2a",
                                "sense_id": "dfda05ff-1c79-3a88-a41a-fe4a5c90d0f6",
                                "text": "1886 : Jules Verne est victime d’un attentat mystérieux sur lequel la presse fait vite le silence. Un de ses neveux, atteint de « dérangement cérébral », lui tire, à bout portant, deux coups de revolver qui l’atteignent au pied et feront de lui, pour le reste de ses jours, un infirme. « Me voilà condamné à une boiterie dont je me console en pensant à Mlle de La Vallière, à Talleyrand, à Lord Byron… », écrit-il plaisamment, mais il est plus atteint encore au moral qu’au physique et se mure dans une solitude dont les prévenances de son entourage ne peuvent le distraire. Il renonce à ses voyages et vend son yacht au prince de Monténégro."
                            }
                        ]
                    },
                    {
                        "sense_id": "657ffb9a-4300-3985-971a-ca0b9524cdec",
                        "entry_id": "f983c053-a999-389d-b2b4-3af1fe26a16d",
                        "glosses": [
                            "D’une manière qui fait rire, ridicule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72451b74-963e-4c04-8150-003991f4d493",
                                "sense_id": "657ffb9a-4300-3985-971a-ca0b9524cdec",
                                "text": "Il y a des cœurs plaisamment bâtis en ce monde,"
                            },
                            {
                                "example_id": "64dc1305-2820-4f0f-9db5-73d99149336e",
                                "sense_id": "657ffb9a-4300-3985-971a-ca0b9524cdec",
                                "text": "Nous avons fait le voyage tout doucement et plaisamment, sans ennui d’aucune sorte, chacun à notre coin, regardant la diversité des feuillages frais à brouter, et nous disant de petites bêtises à risoter tout doux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bf1cb6c-8ab4-424f-a22e-2eeb4cc29934",
                        "source_entry_id": "f983c053-a999-389d-b2b4-3af1fe26a16d",
                        "source_sense_description": "D’une manière plaisante, agréable",
                        "target_lang_word": "pleasantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleasantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                                        "glosses": [
                                            "In a pleasant manner; so as to achieve a pleasant result."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046fc853-fe0c-4053-a0c9-a1bc30964366",
                                                "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                                "text": "He smiled pleasantly at passersby."
                                            },
                                            {
                                                "example_id": "490f1d8d-bd48-46ec-8701-881bbdf95b55",
                                                "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                                "text": "They were pleasantly surprised at the result."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f90d169c-2574-3dc9-90b0-9c86da04dff9",
                                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                                        "glosses": [
                                            "Lightly"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                                        "glosses": [
                                            "Ludicrously; facetiously."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e76f5c-1a0f-407d-b67a-7c5a8538377b",
                                                "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                                "text": "In workhouses, pleasantly so named, because work cannot be done in them."
                                            },
                                            {
                                                "example_id": "389bf3c6-5c3e-417a-86c0-97c7326d6681",
                                                "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                                "text": "Mr Venus, reminded of the duties of hospitality, produced some rum. In answer to the inquiry, 'Will you mix it, Mr Wegg?' that gentleman pleasantly rejoined, 'I think not, sir. On so auspicious an occasion, I prefer to take it in the form of a Gum-Tickler.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aefcacae-865a-4a2b-9f98-fbc2f3770080",
                        "source_entry_id": "f983c053-a999-389d-b2b4-3af1fe26a16d",
                        "source_sense_description": "D’une manière plaisante, agréable",
                        "target_lang_word": "pleasingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleasingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12fee1ac-bb4b-346b-85ac-ac53f2b95cee",
                                        "entry_id": "d73b5dab-8444-33d2-8ff8-80dd8358c944",
                                        "glosses": [
                                            "In a pleasing manner; agreeably; favourably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ff4715-77dd-43b0-a8a3-664bc0c0524d",
                                                "sense_id": "12fee1ac-bb4b-346b-85ac-ac53f2b95cee",
                                                "text": "I not only then tighten'd the pleasure-girth round my restless inmate by a secret spring of friction and compres- sion that obeys the will in those parts, but stole my hand softly to that store bag of nature's prime sweets, which is so pleasingly attach'd to its conduit pipe, from which we receive them;",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "220c5f94-bd7b-4424-9d35-5c1657141020",
                        "source_entry_id": "f983c053-a999-389d-b2b4-3af1fe26a16d",
                        "source_sense_description": "D’une manière qui fait rire, ridicule",
                        "target_lang_word": "żartobliwie",
