                ],
                "senses": [
                    {
                        "sense_id": "ae96e352-1d17-36a5-a0b5-48bb3329d676",
                        "entry_id": "52962e3a-e8d0-376f-b73a-a15cf3405743",
                        "glosses": [
                            "Ville d’Ukraine, capitale administrative de l’oblast de Louhansk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e8098f0-8c06-42ff-a909-d4348c42b407",
                                "sense_id": "ae96e352-1d17-36a5-a0b5-48bb3329d676",
                                "text": "Les drapeaux russes sont installés aux fenêtres d’un immeuble à Louhansk, le 27 septembre 2022."
                            },
                            {
                                "example_id": "20fe92b7-9a96-4d9b-a7f6-08f5f76e8e0d",
                                "sense_id": "ae96e352-1d17-36a5-a0b5-48bb3329d676",
                                "text": "Le gouvernement de Kiev lance, mercredi 14 mai, un « dialogue national » qui paraît bancal, tardif, et auquel n’assistent pas ceux qui ont mis en actes l’éclatement de l’autorité centrale : les séparatistes armés de Donetsk et de Louhansk."
                            },
                            {
                                "example_id": "110c997a-625a-46fe-8066-a469f3d8538f",
                                "sense_id": "ae96e352-1d17-36a5-a0b5-48bb3329d676",
                                "text": "Ainsi, la Crimée, dès son annexion en mars 2014, puis les oblasts de Donetsk et de Louhansk, tenus par les séparatistes du Donbass, sont passés au rouble."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea2bbd05-d5ff-3f80-a5c2-0b19b1bdad96",
                        "entry_id": "52962e3a-e8d0-376f-b73a-a15cf3405743",
                        "glosses": [
                            "Oblast situé en Ukraine."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a15b2a4c-8710-4d49-a843-273c60f4eb91",
                        "source_entry_id": "52962e3a-e8d0-376f-b73a-a15cf3405743",
                        "source_sense_description": "capitale administrative de l’oblast de Louhansk",
                        "target_lang_word": "Luhansk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luhansk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d8d7927-089f-311a-ba7a-8602c121ba9c",
                                        "entry_id": "eeb5f4dd-0e8e-35d0-8c04-870f80ad6506",
                                        "glosses": [
                                            "Stadt im Osten der Ukraine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a89ebbe-8650-4857-a07a-44c38f295a34",
                                                "sense_id": "3d8d7927-089f-311a-ba7a-8602c121ba9c",
                                                "text": "Luhansk hieß früher Woroschilowgrad."
                                            },
                                            {
                                                "example_id": "e160a5df-8588-4295-922b-33c38b24ec36",
                                                "sense_id": "3d8d7927-089f-311a-ba7a-8602c121ba9c",
                                                "text": "„Die Proteste verliefen zunächst friedlich, wurden aber schnell grösser und wichtige Verwaltungsgebäude, vor allem in den beiden südöstlichen Städten Donezk und Luhansk, wurden besetzt.“"
                                            },
                                            {
                                                "example_id": "c4f5764f-d101-42f4-9a7b-48edda7d0e3a",
                                                "sense_id": "3d8d7927-089f-311a-ba7a-8602c121ba9c",
                                                "text": "„Als 2014 der Krieg ausbricht und sich die Situation in Luhansk zuspitzt, möchte ihr Mann seine Stelle kündigen, der Chef des SBU in Luhansk verweigert ihm dies jedoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9014c41c-e047-3908-b6e5-17b20aa1940c",
                                        "entry_id": "eeb5f4dd-0e8e-35d0-8c04-870f80ad6506",
                                        "glosses": [
                                            "gleichnamiger Oblast in der östlichen Ukraine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e8881a-8689-4469-8d20-9bf7da73c843",
                                                "sense_id": "9014c41c-e047-3908-b6e5-17b20aa1940c",
                                                "text": "„Relativ schnell erklärte sich die Krim zuerst unabhängig und trat dann der Russischen Föderation bei, während in den Oblasten Donetzk und Luhansk separatistische Bewegungen tätig wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53f94f20-3b48-4723-99f6-b01cf509c70c",
