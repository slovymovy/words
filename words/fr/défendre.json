{
    "word_family": [
        "défense",
        "défenseur",
        "défensif",
        "défensive",
        "indéfendable",
        "défensivement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d25e10b-a676-3262-acd2-2eda84ab1a9a",
                    "sense_definition": "Protéger quelqu'un ou quelque chose contre une agression, une attaque ou un danger.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats sont prêts à <w>défendre</w> leur pays en cas de conflit armé."
                        },
                        {
                            "text": "Ce chien courageux <w>défend</w> fidèlement la maison de ses maîtres chaque nuit."
                        }
                    ],
                    "synonyms": [
                        "protéger"
                    ],
                    "antonyms": [
                        "attaquer",
                        "assaillir"
                    ],
                    "common_phrases": [
                        "défendre ses droits",
                        "défendre son pays"
                    ]
                },
                {
                    "sense_id": "7c7decb2-6e36-34d0-8201-51757607311c",
                    "sense_definition": "Interdire formellement quelque chose ou ordonner de ne pas commettre une action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interdiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a formellement <w>défendu</w> de boire de l'alcool pendant son traitement."
                        },
                        {
                            "text": "Le règlement intérieur <w>défend</w> aux élèves d'utiliser leur téléphone portable en classe."
                        }
                    ],
                    "common_phrases": [
                        "défendre de fumer",
                        "strictement défendu"
                    ],
                    "synonyms": [
                        "interdire"
                    ],
                    "antonyms": [
                        "permettre",
                        "autoriser"
                    ]
                },
                {
                    "sense_id": "9b9f427a-cf1b-3211-bb8d-c403c25afcd9",
                    "sense_definition": "Plaider pour un accusé en justice, ou soutenir avec vigueur une opinion ou une cause.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soutien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet avocat expérimenté <w>défend</w> son client avec beaucoup d'assurance devant le tribunal."
                        },
                        {
                            "text": "Les manifestants se réunissent aujourd'hui afin de <w>défendre</w> une cause écologique majeure."
                        }
                    ],
                    "common_phrases": [
                        "défendre un client",
                        "défendre une cause"
                    ]
                },
                {
                    "sense_id": "a8c99e48-81ae-37f2-a174-e86293f08a74",
                    "sense_definition": "Riposter ou résister physiquement face à une agression.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a suivi des cours d'arts martiaux pour apprendre à se <w>défendre</w> dans la rue."
                        },
                        {
                            "text": "L'homme agressé a réussi à se <w>défendre</w> et a rapidement mis en fuite son assaillant."
                        }
                    ],
                    "common_phrases": [
                        "apprendre à se défendre"
                    ]
                },
                {
                    "sense_id": "f75617ff-211b-3570-97b0-835ba9018217",
                    "sense_definition": "Empêcher l'équipe adverse de marquer un point ou de pénétrer dans son camp.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les joueurs ont réussi à bien <w>défendre</w> leur but jusqu'au coup de sifflet final."
                        },
                        {
                            "text": "Notre équipe doit <w>défendre</w> avec rigueur pour conserver son avantage au score."
                        }
                    ],
                    "antonyms": [
                        "attaquer"
                    ],
                    "common_phrases": [
                        "défendre le score"
                    ]
                },
                {
                    "sense_id": "f93924d6-0c99-3616-bb51-54b2717f66a4",
                    "sense_definition": "Obtenir de bons résultats ou se débrouiller honorablement dans un domaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "capacite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour un débutant aux échecs, il se <w>défend</w> remarquablement bien contre des joueurs expérimentés."
                        },
                        {
                            "text": "Elle ne parle pas couramment la langue mais elle se <w>défend</w> bien lors des voyages."
                        }
                    ],
                    "common_phrases": [
                        "se défendre bien"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "3f7b86d8-242f-3772-811b-ad746362f296",
                    "sense_definition": "Rejeter un reproche ou nier avoir commis un acte répréhensible.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "disculpation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suspect se <w>défend</w> avec énergie d'avoir participé à ce cambriolage nocturne."
                        },
                        {
                            "text": "Le responsable s'est <w>défendu</w> d'avoir commis la moindre faute professionnelle dans sa gestion."
                        }
                    ],
                    "synonyms": [
                        "nier"
                    ],
                    "common_phrases": [
                        "se défendre d'avoir"
                    ]
                }
            ]
        }
    ]
}