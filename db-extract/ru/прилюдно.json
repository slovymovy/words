                                        "examples": [
                                            {
                                                "example_id": "90fb1063-a563-44fc-9c89-9d8230017491",
                                                "sense_id": "d2a50027-0309-3d4c-b9ec-093a670076eb",
                                                "text": "Le Makua, lui, il a été fouetté comme une vieille natte toute poussiéreuse. Sur la petite place du lazaret. Et en public. Pour faire un exemple, qu’ils ont dit…"
                                            },
                                            {
                                                "example_id": "1f24e3a8-b759-40ab-b957-64fd0c76236a",
                                                "sense_id": "d2a50027-0309-3d4c-b9ec-093a670076eb",
                                                "text": "Paraître en public."
                                            },
                                            {
                                                "example_id": "c0ce69db-f0ff-431b-8545-cd5dd5337ffe",
                                                "sense_id": "d2a50027-0309-3d4c-b9ec-093a670076eb",
                                                "text": "Se montrer en public."
                                            },
                                            {
                                                "example_id": "8fd7d783-f73d-4408-9893-bf0f19972381",
                                                "sense_id": "d2a50027-0309-3d4c-b9ec-093a670076eb",
                                                "text": "Parler en public."
                                            },
                                            {
                                                "example_id": "4177f32b-2161-4233-9196-c2f5d8b49125",
                                                "sense_id": "d2a50027-0309-3d4c-b9ec-093a670076eb",
                                                "text": "Cette formation dure une journée et s’adresse à ceux ayant déjà un niveau confirmé en prise de parole en public."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
