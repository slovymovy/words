                                    },
                                    {
                                        "sense_id": "560da814-0d14-37b9-a71f-f4ab2141acb0",
                                        "entry_id": "2b25e82a-a49e-3f75-a916-8b5c4495674e",
                                        "glosses": [
                                            "A person having the above condition."
