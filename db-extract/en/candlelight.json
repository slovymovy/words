                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d841da8e-d1e2-4372-aad3-194dac2475d9",
                        "entry_id": "76140ec3-4a93-3ce9-a825-7e4186e5d609",
                        "tags": [
                            "plural"
                        ],
                        "form": "candlelights"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                        "entry_id": "76140ec3-4a93-3ce9-a825-7e4186e5d609",
                        "glosses": [
                            "The light emitted by a candle."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "053f2ca6-2d0a-4405-9dd1-4ba95688b847",
                                "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                                "text": "I looked across the table into her shining eyes, which were golden in the candlelight, with my fingers round the stem of my own glass, ready for the toast."
                            },
                            {
                                "example_id": "a94de985-eff4-4ec7-a720-d5ac40c8bf0c",
                                "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                                "text": "Cradled in the arms of Night, the gleam of moon and candlelight bring images alive from days gone by."
                            },
                            {
                                "example_id": "d6e988be-752a-4920-8516-511adfee04bd",
                                "sense_id": "92a9c00b-51a4-3485-9391-55935fa15174",
                                "text": "Using survey data gathered from social media users who participated in the candlelight vigils, he explores the prevalence of social media use during the protests, how it differs in terms of individual-level demographic and socioeconomic characteristics, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                        "entry_id": "76140ec3-4a93-3ce9-a825-7e4186e5d609",
                        "glosses": [
                            "The evening, when darkness falls and it is time to light candles."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "68c5c652-912a-4f2a-8fe6-e85770babd20",
                                "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                "text": "Morning dress is that which is worn during business hours or at any time in any place, where semiformal dress is not required until candlelight or seven o'clock in the evening ."
                            },
                            {
                                "example_id": "f3bd84d7-b95e-444c-af7c-cb0890092af4",
                                "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                "text": "The attack finally ceased Monday morning, but \"soon after candlelight, came on a most terrible bombardment and cannonade, on both sides, as if heaven and earth were engaged.\""
                            },
                            {
                                "example_id": "66e4bd24-8061-4a87-b5e7-7556d948c2c2",
                                "sense_id": "3c877be2-a783-3e5a-848d-ebf70f434dbb",
                                "text": "As Marie glances at the window, she sees that the day has gone; it is almost candlelight."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68c7f4af-a019-4b04-9acb-87581c29ab9c",
                        "source_entry_id": "76140ec3-4a93-3ce9-a825-7e4186e5d609",
                        "source_sense_description": "the light of a candle",
                        "target_lang_word": "kaarslicht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kaarslicht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4b54e8d7-de98-3d31-989f-12d856fcf566",
                                        "entry_id": "0fb496cc-35a7-31a9-bc2c-b15cc224f3c9",
                                        "glosses": [
                                            "het schijnsel van een brandende kaars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5243fde-4aa9-453a-8ef0-46dcf04159c1",
                                                "sense_id": "4b54e8d7-de98-3d31-989f-12d856fcf566",
                                                "text": "Het waren geen juwelen, het waren ogen die naar haar knipoogden in het kaarslicht en naar de meisjes keken die naar zichzelf keken."
                                            },
                                            {
                                                "example_id": "f63605b1-f3b8-412f-8c99-b3fd8112dca5",
                                                "sense_id": "4b54e8d7-de98-3d31-989f-12d856fcf566",
                                                "text": "Emil liep in de ochtend van 5 augustus vanaf dit huisje naar Conques, waar hij 's middags een expositie bezocht en 's avonds in de kerk naar enkele jongeren luisterde die bij kaarslicht religieuze liederen zongen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69d062ef-ddb9-4e04-880d-fb39b87257e4",
                        "source_entry_id": "76140ec3-4a93-3ce9-a825-7e4186e5d609",
                        "source_sense_description": "the light of a candle",
                        "target_lang_word": "Kerzenlicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kerzenlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                        "entry_id": "a2a8dd93-b4b1-34c0-9a44-47e916d93189",
                                        "glosses": [
                                            "von einer Kerze emittiertes Licht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9426c697-2e37-43e3-a368-ba9905db288c",
                                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                                "text": "Ich biete Dir ein romantisches Abendessen im Kerzenlicht an."
                                            },
                                            {
                                                "example_id": "a0fb4a38-cdc2-4fcd-9dd2-e3bb6602f76e",
                                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                                "text": "„Als die Gäste kamen, erklärte Helena, sie würden einen ganz besonderen Abend bei Kerzenlicht verbringen, ohne warmes Essen, nur mit Süßigkeiten.“"
                                            },
                                            {
                                                "example_id": "0c203548-2e96-439f-8f37-3237e8b552f6",
                                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                                "text": "„Wir saßen nun in einem kleinen Kreis um ihn herum, Kerzenlicht machte uns alle gleich jung und schön.“"
                                            },
                                            {
                                                "example_id": "7b6dfc7a-d401-4800-9b84-3b84a33043ed",
                                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                                "text": "„Die Farbe der Wände mochte er nicht, deshalb hatte er beschlossen, daß sie bei Kerzenlicht aßen.“"
                                            },
                                            {
                                                "example_id": "ff50f5c1-7183-445d-92f2-e873f3adf0ae",
                                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                                "text": "„Er drückte ihr noch einmal die Hand und liess sie dann los, und nun kehrte Natascha an ihren Platz im Kerzenlicht zurück und nahm wieder die Haltung von vorhin ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af9ee2b6-6419-4282-833b-d7215d848323",
                        "source_entry_id": "76140ec3-4a93-3ce9-a825-7e4186e5d609",
                        "source_sense_description": "the light of a candle",
                        "target_lang_word": "Kerzenschein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kerzenschein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d3b3318-764c-3759-b278-b14344f47d92",
                                        "entry_id": "86f26fe2-a8e1-35be-9718-8caef7709d35",
                                        "glosses": [
                                            "Licht, das von einer brennenden Kerze ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d667232-2155-4115-9f3d-1b1171c3bc19",
                                                "sense_id": "3d3b3318-764c-3759-b278-b14344f47d92",
                                                "text": "„Tagsüber am Strand, im warmen Gegenlicht, werden sie davon fast aufgesogen, nachts erscheinen sie im spärlichen Kerzenschein wie von alten Meistern ausgeleuchtet.“"
                                            },
                                            {
                                                "example_id": "0b25746d-9624-46be-b740-81a8a672ab89",
                                                "sense_id": "3d3b3318-764c-3759-b278-b14344f47d92",
                                                "text": "„Mit einem Bad bei Kerzenschein hat ein 39-jähriger Bremer eine Wohnung in Schutt und Asche gelegt.“"
                                            },
                                            {
                                                "example_id": "d29f2014-6721-4105-866c-2b45ee2e387f",
                                                "sense_id": "3d3b3318-764c-3759-b278-b14344f47d92",
                                                "text": "„Der Kapitän sah Pierre beim Kerzenschein an, und offenbar machte ihn jetzt das verstörte Gesicht seines Gesprächspartners stutzig.“"
                                            },
                                            {
                                                "example_id": "d6a31ea8-1672-4c63-ac17-faf8bd450d5f",
                                                "sense_id": "3d3b3318-764c-3759-b278-b14344f47d92",
                                                "text": "„Durch das bunte Glas der Fenster fällt das Licht von draußen gedämpft herein und mischt sich mit dem Kerzenschein zu einem sanften, rot und blau überwehten Gold.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6631a1ca-1567-4fa3-a74c-945558e12819",
