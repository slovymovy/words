                                "target_senses": [
                                    {
                                        "sense_id": "2ef1602a-3796-3a96-bbd9-702cdc8b4c92",
                                        "entry_id": "283edb6d-eada-3f20-9d7b-638960b630a1",
                                        "glosses": [
                                            "ein Doppelkontinent (der ehemals von der Namengebung her als ein Kontinent betrachtet wurde, wissenschaftlich wird in die Kontinente Nordamerika und Südamerika unterschieden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ce46b7-314d-493e-80fa-ca1eecf235af",
                                                "sense_id": "2ef1602a-3796-3a96-bbd9-702cdc8b4c92",
                                                "text": "Wir sind durch ganz Amerika gereist, von Alaska bis Feuerland."
                                            },
                                            {
                                                "example_id": "38f35002-1d3d-4c95-9714-aeb305afb4f6",
                                                "sense_id": "2ef1602a-3796-3a96-bbd9-702cdc8b4c92",
                                                "text": "„Für Europa schätzt man um 1600 rund 100 Millionen Einwohner, für Amerika vor den Reisen des Columbus etwa 10 Millionen Einwohner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aea9064b-27b2-38d4-a9ab-9d49602b2166",
                                        "entry_id": "283edb6d-eada-3f20-9d7b-638960b630a1",
                                        "glosses": [
                                            "Vereinigte Staaten von Amerika"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "564b5684-c667-4ba4-83e6-cef695f84f5f",
                                                "sense_id": "aea9064b-27b2-38d4-a9ab-9d49602b2166",
                                                "text": "Amerika steht dem Iran feindselig gegenüber."
                                            },
                                            {
                                                "example_id": "149804a2-3898-43f8-885a-31c174fc68d3",
                                                "sense_id": "aea9064b-27b2-38d4-a9ab-9d49602b2166",
                                                "text": "„Amerika ist nicht die Welt.“"
                                            },
                                            {
                                                "example_id": "a26a2a82-75be-4a0c-8f1c-0dff57ae5fa3",
                                                "sense_id": "aea9064b-27b2-38d4-a9ab-9d49602b2166",
                                                "text": "„Wer auf der internationalen Bühne ein wenig näher hinschaut, kann sogar eine Art Wettrennen der Nationen beobachten, und viele Journalisten, Politologen und Politiker spekulieren darüber, welche der großen Staaten es schaffen werden, neben Amerika die zweite, dritte oder gar vierte Supermacht zu werden.“"
                                            },
