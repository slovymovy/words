                                    },
                                    {
                                        "sense_id": "ee33f264-27df-3eb7-b9e8-6cf2cf1d7eaa",
                                        "entry_id": "fb510699-f4d2-3406-994f-976735f55673",
                                        "glosses": [
                                            "A parish priest."
                                        ],
                                        "tags": [],
