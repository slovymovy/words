                ],
                "senses": [
                    {
                        "sense_id": "1cd34e20-b633-38ff-9496-9c45b0dbf0df",
                        "entry_id": "907fb7c5-df96-3f8c-a196-7831e201ee8b",
                        "glosses": [
                            "A pimp, a man living off the earnings of a harlot."
                        ],
                        "tags": [
                            "Australia",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f97742e7-1f00-4630-83f5-ea8030d03c61",
                                "sense_id": "1cd34e20-b633-38ff-9496-9c45b0dbf0df",
                                "text": "Oscar pondered for a while, then said, \"Oh, but halfcastes don't seem to be any good at all. All the men here are loafers and bludgers, the women practically all whores.\""
                            },
                            {
                                "example_id": "a03317d2-424b-4490-bd92-a767813a58db",
                                "sense_id": "1cd34e20-b633-38ff-9496-9c45b0dbf0df",
                                "text": "This was the bludger or, in American parlance, the pimp, a man who lived on the earnings of prostitution. He was often the husband or boyfriend of a prostitute and could be actively involved in protecting or touting for the prostitute. Parliamentarians described the bludger as ‘the most detestable wretch on the face of the earth’ and as a man ‘worthy of no respect whatsoever’ (NSWPD 31:1675)."
                            }
                        ]
                    },
                    {
                        "sense_id": "94d5447e-efd4-3db3-915a-c65a6e6585ec",
                        "entry_id": "907fb7c5-df96-3f8c-a196-7831e201ee8b",
                        "glosses": [
                            "A person who avoids working, or doing their share of work, a loafer, a hanger-on, one who does not pull their weight."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5b5fe15e-d805-437b-9ba5-796fc46b03a5",
                                "sense_id": "94d5447e-efd4-3db3-915a-c65a6e6585ec",
                                "text": "If she is doing the work of two parents because her husband has died or left her or is violent and has driven her and the kids from home, then suddenly she is a bludger."
                            }
                        ]
                    },
                    {
                        "sense_id": "4559e0e8-d12d-3f82-b519-f3422b56905d",
                        "entry_id": "907fb7c5-df96-3f8c-a196-7831e201ee8b",
                        "glosses": [
                            "A widespread species of large marine fish, Carangoides gymnostethus, in the jack family, Carangidae."
