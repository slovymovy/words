                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f15bb48c-c45d-49e0-9d47-d24b134cb4b4",
                                                "sense_id": "f516fcc9-0e47-30c7-a087-ae6361f30248",
                                                "text": "'Montana?' I said. 'You can't call a kid Montana'―these friends of mine were going to call their new baby girl Montana and I tried to talk them out of it, because I'm sick of Australians naming their kids after American placenames, I'm sick of all these Montanas and Delawares and Indianas and Dallases. […]"
                                            }
                                        ]
