                ],
                "senses": [
                    {
                        "sense_id": "77080158-d691-35a7-a373-a70fb373e611",
                        "entry_id": "052d3f8d-92f1-31fb-afb5-0f195b573e66",
                        "glosses": [
                            "To deprive of a purpose; to remove or derail the purpose of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "50ed3603-c462-4c17-b4e3-5f02109b9f84",
                                "sense_id": "77080158-d691-35a7-a373-a70fb373e611",
                                "text": "O, Goodness ! help me to unplan that plan, and to unpurpose that purpose !"
                            },
                            {
                                "example_id": "0a732b14-80b9-4e91-80ba-3dd628df8c37",
                                "sense_id": "77080158-d691-35a7-a373-a70fb373e611",
                                "text": "Manifestly so; for by what likelihood\nHad I endured against fourteen knights all armed\nAnd purposed, I unpurposed and unarmed,\nSave innocency stood my friend?"
                            }
                        ]
                    }
                ],
