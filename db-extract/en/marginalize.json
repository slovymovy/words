                                        "entry_id": "9bfcad47-b044-3f45-9e84-294894908c92",
                                        "glosses": [
                                            "etwas entfernen, nicht beinhalten; besonders auch sozial ausschließen, marginalisieren"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d29537c-1d88-4514-917d-c6a14d0eacd7",
                                                "sense_id": "654a6bb1-531f-390a-a38f-c5393631070b",
                                                "text": "Die Benutzung der Sauna durch externe Gäste wurde nach dem Umbau exkludiert."
                                            },
                                            {
                                                "example_id": "0b695518-49ad-46ba-8af4-c29051445564",
                                                "sense_id": "654a6bb1-531f-390a-a38f-c5393631070b",
                                                "text": "„Stößt der Parser jetzt auf die Startmarkierung eines Elements, für das eine Exklusionsliste existiert, so werden die exkludierten Elemente aus der aktuellen Liste von Inklusionen gestrichen.“"
                                            },
                                            {
                                                "example_id": "25809270-2cc2-43ae-bdbb-0d0613e859c5",
                                                "sense_id": "654a6bb1-531f-390a-a38f-c5393631070b",
                                                "text": "„Organisationen inkludieren ihre Mitglieder und exkludieren alle anderen Menschen.“"
                                            },
                                            {
                                                "example_id": "4dde0c84-910a-4279-8155-56885099f779",
                                                "sense_id": "654a6bb1-531f-390a-a38f-c5393631070b",
                                                "text": "„Während nun F1 beständig versucht, eine Brücke zu M zu bauen und ihn zu inkludieren, schießen die anderen beiden beständig dazwischen und wollen den Brückenbau verhindern, d. h. den Berichtenden aus ihrem Team exkludieren.“"
                                            },
                                            {
                                                "example_id": "54056954-2b99-4e2e-ab90-bda680692b71",
                                                "sense_id": "654a6bb1-531f-390a-a38f-c5393631070b",
                                                "text": "„Das strenge Selbsturteil während des Zukunftspanels lautet: Wikipedia sei das beste Beispiel für exkludierende Offenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
