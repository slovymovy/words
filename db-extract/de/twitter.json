                                                "sense_id": "cd03c71b-3cc1-348c-abcb-8f52269a2d49",
                                                "text": "Stars can’t stop Twittering at Oscars, parties"
                                            },
                                            {
                                                "example_id": "16d15103-3fff-4656-80c2-4a0427a53f91",
                                                "sense_id": "cd03c71b-3cc1-348c-abcb-8f52269a2d49",
