                            {
                                "example_id": "947e8c33-c6f5-4941-8801-1c60b15864d7",
                                "sense_id": "9a3ee8f0-8186-32ea-bf23-59c31a08de8d",
                                "text": "Ou par du tofu. La protéine la moins chère, et bien mâchable."
                            },
                            {
                                "example_id": "18193556-4c24-4f37-a61b-4f49f6ba2224",
                                "sense_id": "9a3ee8f0-8186-32ea-bf23-59c31a08de8d",
                                "text": "Les tendons de bœuf sont des friandises pour chien très appréciées en raison de leur goût délicieux et de leur texture mâchable."
                            },
                            {
                                "example_id": "5511eaba-cc88-45fb-8437-6c5be3bc5f0d",
                                "sense_id": "9a3ee8f0-8186-32ea-bf23-59c31a08de8d",
                                "text": "Ces friandises ont une texture ferme et mâchable, ce qui en fait une option intéressante pour les chiens qui aiment mâcher."
                            }
                        ]
                    }
