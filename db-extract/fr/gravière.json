            {
                "entry_id": "5d1cf79e-bfbc-3bc6-9d4c-0455ee8f7663",
                "word": "gravière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a38e6842-8c88-4de0-97a4-6a6945808b17",
                        "entry_id": "5d1cf79e-bfbc-3bc6-9d4c-0455ee8f7663",
                        "tags": [
                            "plural"
                        ],
                        "form": "gravières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "657f35a6-ef40-37fc-ad2b-cb9af08d0317",
                        "entry_id": "5d1cf79e-bfbc-3bc6-9d4c-0455ee8f7663",
                        "glosses": [
                            "Carrière, d'où l'on extrait des graviers, et qui évolue souvent en étang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa68bdbe-0423-47db-8483-38faeddc2f03",
                                "sense_id": "657f35a6-ef40-37fc-ad2b-cb9af08d0317",
                                "text": "Marcq. — Il y a quelque temps, des travaux exécutée dans les gravières situées entre Marcq et Saint-Juvin, ont mis à jour les ossements d’un guerrier ainsi que les curieuses armes avec lesquelles il avait été inhumé."
                            },
                            {
                                "example_id": "03999cfd-723a-41e1-af7f-57860a3a9bb7",
                                "sense_id": "657f35a6-ef40-37fc-ad2b-cb9af08d0317",
                                "text": "Le vif tenait encore bon à l’entrée du bras. Puis, après quelques bouillons et retours de remous, un friselis de vaguelettes courait sur la gravière, avant de se lisser en eau morte."
                            },
                            {
                                "example_id": "cabc64f6-0032-4692-a651-740ae968dad2",
                                "sense_id": "657f35a6-ef40-37fc-ad2b-cb9af08d0317",
                                "text": "Pas une de ces carrières creusées par d’énormes engins, rien qu’une petite gravière avec laquelle un paysan devait s’être fait un peu d’argent des années auparavant."
                            },
                            {
                                "example_id": "1254aff1-018a-4f13-afe4-eb1f1f0fd63a",
                                "sense_id": "657f35a6-ef40-37fc-ad2b-cb9af08d0317",
                                "text": "Le paysage est troué d’étangs et de gravières. La rivière est attirée naturellement par les carrières abandonnées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "451ff1ba-8594-48f8-b0c0-03a7fa2372b5",
                        "source_entry_id": "5d1cf79e-bfbc-3bc6-9d4c-0455ee8f7663",
                        "source_sense_id": "657f35a6-ef40-37fc-ad2b-cb9af08d0317",
                        "target_lang_word": "Kiesgrube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kiesgrube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "624fe229-2bfe-3372-82e4-e444d702eb3d",
                                        "entry_id": "7495e5f1-042d-304a-a10b-43205189f5f1",
                                        "glosses": [
                                            "ein großes Erdloch, aus dem im Tagebau Sand, Kies und Schotter abgebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f88785-809c-4983-85a5-8e150e2336f5",
                                                "sense_id": "624fe229-2bfe-3372-82e4-e444d702eb3d",
                                                "text": "[…] lieber ins Baggerloch springen. Das ist kein natürlicher See, sondern eine ehemalige Kiesgrube, die voller Wasser gelaufen ist."
                                            },
                                            {
                                                "example_id": "ca01ee8a-3f2f-41e4-a557-5c5835cb8493",
                                                "sense_id": "624fe229-2bfe-3372-82e4-e444d702eb3d",
                                                "text": "Im Dachauer KZ und seinen 140 Außenlagern waren von 1933 bis 1945 mehr als 200.000 Menschen aus ganz Europa inhaftiert. Arbeitsfähige Häftlinge wurden als Arbeitssklaven im Straßenbau oder in Kiesgruben eingesetzt, nach Kriegsbeginn vor allem in der Rüstungsindustrie."
                                            },
                                            {
                                                "example_id": "cd6bc74a-07be-4e0b-8712-283b5a61d9a2",
                                                "sense_id": "624fe229-2bfe-3372-82e4-e444d702eb3d",
                                                "text": "Als Unternehmer von Kiesgruben initiierte [der heute 78-jährige Naturschützer Hubert] Weinzierl bereits in den 50iger Jahren Renaturierungen […]."
                                            },
                                            {
                                                "example_id": "4ce35e55-c930-4991-bc50-57639360655d",
                                                "sense_id": "624fe229-2bfe-3372-82e4-e444d702eb3d",
                                                "text": "„Nach dem Wald gelangten die Götzlacker auf eine freie Straße, die um eine große Kiesgrube herumführte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
