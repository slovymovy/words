                                "target_senses": [
                                    {
                                        "sense_id": "de2ef651-609e-314c-8a4d-63fe81be2ce5",
                                        "entry_id": "80eb0bff-485b-3d6e-80a1-3d2a72324cbf",
                                        "glosses": [
                                            "Stadt in Usbekistan"
                                        ],
