    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10d1c804-0145-33f2-b281-815ec28b122e",
                    "sense_definition": "iets stevig afsluiten met een grendel of slot",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "afsluiten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij sloot de cel en <w>vergrendelde</w> de deur.",
                            "target_lang_translations": {
                                "en": "He closed the cell and <w>locked</w> the door.",
                                "ru": "Он закрыл камеру и <w>запер</w> дверь на засов."
                            }
                        },
                        {
                            "text": "Vergeet niet om de achterdeur goed te <w>vergrendelen</w> voor je gaat slapen.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>bolt</w> the back door properly before you go to sleep.",
                                "ru": "Не забудь хорошенько <w>запереть</w> заднюю дверь перед тем, как идти спать."
                            }
                        }
                    ],
                    "synonyms": [
                        "grendelen",
                        "vastzetten",
                        "afsluiten"
                    ],
                    "antonyms": [
                        "ontgrendelen",
                        "openen"
                    ],
                    "common_phrases": [
                        "de deur vergrendelen",
                        "automatisch vergrendelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to firmly close something with a bolt or lock",
                        "ru": "плотно закрыть что-либо с помощью засова или замка"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to lock",
                                "target_lang_sense_clarification": "to secure with a key or bolt"
                            },
                            {
                                "target_lang_word": "to bolt",
                                "target_lang_sense_clarification": "to secure specifically with a sliding bar or bolt"
                            },
                            {
                                "target_lang_word": "to latch",
                                "target_lang_sense_clarification": "to fasten with a latch"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "запирать",
                                "target_lang_sense_clarification": "на засов или замок"
                            },
                            {
                                "target_lang_word": "засовывать",
                                "target_lang_sense_clarification": "задвигать засов"
                            },
                            {
                                "target_lang_word": "блокировать",
                                "target_lang_sense_clarification": "фиксировать в закрытом положении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0551db5-4e76-33cc-9841-0188e04a227f",
                    "sense_definition": "het blokkeren van de toegang tot een digitaal apparaat of systeem",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beveiliging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt je telefoon <w>vergrendelen</w> met een pincode of een vingerafdruk.",
                            "target_lang_translations": {
                                "en": "You can <w>lock</w> your phone with a PIN or a fingerprint.",
                                "ru": "Вы можете <w>заблокировать</w> свой телефон с помощью пин-кода или отпечатка пальца."
                            }
                        },
                        {
                            "text": "Het scherm zal automatisch <w>vergrendelen</w> na twee minuten inactiviteit.",
                            "target_lang_translations": {
                                "en": "The screen will <w>lock</w> automatically after two minutes of inactivity.",
                                "ru": "Экран <w>заблокируется</w> автоматически после двух минут бездействия."
                            }
                        }
                    ],
                    "synonyms": [
                        "blokkeren",
                        "beveiligen"
                    ],
                    "antonyms": [
                        "ontgrendelen",
                        "vrijgeven"
                    ],
                    "common_phrases": [
                        "het scherm vergrendelen",
                        "je telefoon vergrendelen"
                    ],
                    "target_lang_definitions": {
                        "en": "blocking access to a digital device or system",
                        "ru": "блокировка доступа к цифровому устройству или системе"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to lock",
                                "target_lang_sense_clarification": "to secure a device or screen from unauthorized use"
                            },
                            {
                                "target_lang_word": "to block",
                                "target_lang_sense_clarification": "to prevent access to a system"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "блокировать",
                                "target_lang_sense_clarification": "экран или устройство"
                            },
                            {
                                "target_lang_word": "заблокировать",
                                "target_lang_sense_clarification": "ограничить доступ к системе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}