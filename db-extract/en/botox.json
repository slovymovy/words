                "senses": [
                    {
                        "sense_id": "953233b0-e9c0-359e-aee1-b1a2a7aefa58",
                        "entry_id": "a7b27882-df53-390a-a1dd-15c794c8487a",
                        "glosses": [
                            "A toxic compound (generic name botulinum toxin type A) produced by the bacterium Clostridium botulinum, that causes the paralysis of muscles, used in cosmetic surgery to conceal wrinkles and for muscle spasm relief and headache prevention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4aedaf7-2fb9-4b3f-adc3-c513a1e04dc6",
                                "sense_id": "953233b0-e9c0-359e-aee1-b1a2a7aefa58",
                                "text": "Eric Andre: You look phenomenal. What's your secret?\nAsa Akira: Botox.\nEric Andre: Really?\nAsa Akira: Yeah. And I'm starving."
                            }
                        ]
                    }
                ],
                "translations": [
