                    "frequency": "High",
                    "semantic_group_id": "outil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il utilise une grande <w>pelle</w> pour dégager l'allée couverte de neige."
                        },
                        {
                            "text": "Mon père a acheté une nouvelle <w>pelle</w> pour jardiner ce printemps."
                        }
                    ],
                    "synonyms": [
