                                "sense_id": "6187b126-bf84-3602-b571-8bc448b2c75f",
                                "text": "Clerical husbands who have been uxorially driven by wives who wielded their father's croziers, so to say, have been known to jib — nay, to kick out..."
                            },
                            {
                                "example_id": "79dd56c7-d660-4195-a311-5dbd04bf0b67",
                                "sense_id": "6187b126-bf84-3602-b571-8bc448b2c75f",
                                "text": "Every contact with the affairs of the world, save uxorially, was changed..."
                            },
                            {
                                "example_id": "c218cfe3-bf0d-49d6-b522-d39786848030",
                                "sense_id": "6187b126-bf84-3602-b571-8bc448b2c75f",
                                "text": "...her husband may in fact have come as an outside intruder into her already established and maternally and uxorially oriented realm."
                            }
                        ]
                    }
