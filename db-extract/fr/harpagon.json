            {
                "entry_id": "b12bcf7a-8a1f-39c6-a2f9-467ef375d5da",
                "word": "Harpagon",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a326cacc-5c9e-3346-abe8-5e84d83525bb",
                        "entry_id": "b12bcf7a-8a1f-39c6-a2f9-467ef375d5da",
                        "glosses": [
                            "Nom d’un personnage créé par Molière pour la pièce « L'Avare » dont la principale marque de caractère est l'avarice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "846ede41-6da3-434a-b401-f4b13e13f234",
                                "sense_id": "a326cacc-5c9e-3346-abe8-5e84d83525bb",
                                "text": "Ces gens-là se feraient prêter de l’argent par Harpagon, et auraient trouvé des truffes sur le radeau de la Méduse."
                            },
                            {
                                "example_id": "2db3b65c-e32d-4697-9d75-9e244cd8fe2c",
                                "sense_id": "a326cacc-5c9e-3346-abe8-5e84d83525bb",
                                "text": "L’imagination d’Harpagon ne bâtit qu’autour de sa cassette, celle de Falstaff autour d’une belle femme ou d'un tonnelet."
                            },
                            {
                                "example_id": "cfae598e-700f-4c6a-ba8d-2e83564e4fe4",
                                "sense_id": "a326cacc-5c9e-3346-abe8-5e84d83525bb",
                                "text": "Un acteur très connu jouait le rôle d’Harpagon qu’il chargeait beaucoup trop, m’a-t-il semblé, dans le fameux monologue."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
