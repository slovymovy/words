                "senses": [
                    {
                        "sense_id": "e1786a46-bbb0-3d8b-9694-099845d912a7",
                        "entry_id": "72a3feac-aebd-3036-83a7-56c219ab132a",
                        "glosses": [
                            "to disperse and be projected in droplets; to spatter, to splash, to scatter (usually in haphazard or random directions with a vertical component)"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6a9a5767-d322-4000-b4ba-36d057e6832e",
                                "sense_id": "e1786a46-bbb0-3d8b-9694-099845d912a7",
                                "text": "Tijdens het braden spatte wat boter op en er landden druppels op haar arm.",
                                "translation": "Some butter spattered around during frying and some droplets landed on her arm.",
                                "english": "Some butter spattered around during frying and some droplets landed on her arm."
                            }
                        ]
