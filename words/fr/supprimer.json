                    "sense_id": "2dbd82be-3ec8-3cfa-a8c2-769ff6d48277",
                    "sense_definition": "Effacer ou retirer des données d'un support informatique ou de la mémoire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux <w>supprimer</w> un message si tu ne veux pas le conserver.",
                            "target_lang_translations": {
                                "en": "You can <w>delete</w> a message if you don't want to keep it.",
                                "ru": "Ты можешь <w>удалить</w> сообщение, если не хочешь его сохранять.",
                                "de": "Du kannst eine Nachricht <w>löschen</w>, wenn du sie nicht behalten willst.",
                                "es": "Puedes <w>borrar</w> un mensaje si no quieres conservarlo.",
                                "zh": "如果你不想保留某条消息，就可以把它<w>删除</w>。"
                            }
                        },
                        {
                            "text": "Elle a <w>supprimé</w> tous les anciens fichiers de son ordinateur portable.",
                            "target_lang_translations": {
                                "en": "She <w>deleted</w> all the old files from her laptop.",
                                "ru": "Она <w>удалила</w> все старые файлы со своего ноутбука.",
                                "de": "Sie hat alle alten Dateien von ihrem Laptop <w>gelöscht</w>.",
                                "es": "Ella ha <w>borrado</w> todos los archivos antiguos de su portátil.",
                                "zh": "她把笔记本电脑里所有的旧文件都<w>删除</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "effacer"
                    ],
                    "antonyms": [
                        "ajouter",
                        "conserver",
                        "enregistrer",
                        "sauvegarder"
                    ],
                    "common_phrases": [
                        "supprimer un fichier",
                        "supprimer un message",
                        "supprimer un compte"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove data from a computer, storage device or memory.",
