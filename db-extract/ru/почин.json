                                        "glosses": [
                                            "to, od czego się coś zaczyna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c339f3f2-8fde-48fa-9bde-1834c0e96098",
                                                "sense_id": "a3fec288-b29d-33f6-a20e-26ab97e49e2f",
                                                "text": "Wielkie znaczenie dla biblijnej opowieści o ludzie wybranym, jakie przypisuje się Jakubowi, wynika z faktu, że dwunastu jego synów (Ruben, Symeon, Lewi, Juda, Issachar, Zabulon, Józef, Beniamin, Dan, Neftali, Gad , Aser) dało początek tzw. dwunastu plemionom Izraela, po tym, jak sam Jakub zyskał to imię - Izrael, a jego potomkowie od tego czasu będą nazywać siebie Bnej Izrael, Izraelici, synowie Izraela."
                                            },
                                            {
                                                "example_id": "57693cf7-2cb6-4f5c-91e6-a47ff9d0b17d",
                                                "sense_id": "a3fec288-b29d-33f6-a20e-26ab97e49e2f",
                                                "text": "Zaczął robić wszystko od początku"
                                            },
                                            {
                                                "example_id": "1e2ab7c0-7e98-4273-ba64-172bb8206b79",
                                                "sense_id": "a3fec288-b29d-33f6-a20e-26ab97e49e2f",
                                                "text": "Na początku Bóg stworzył niebo i ziemię"
                                            }
