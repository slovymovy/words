                "translations": [
                    {
                        "translation_id": "e0bf3cfd-ac73-46a6-a20d-3de7fe1da8d8",
                        "source_entry_id": "e55a7efd-715e-38eb-a383-157d648b17b9",
                        "source_sense_id": "f6e5f993-a2de-3b92-bd11-6002d96b74e7",
                        "target_lang_word": "prehistory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prehistory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce0ff3fd-45f0-3934-a940-6967c4cec83c",
                                        "entry_id": "076dcc1e-af68-379f-a8f3-4d30b260c0fe",
                                        "glosses": [
                                            "The time before written records in any area of the world; the events and conditions of those times."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf5f589a-218f-4fd5-806c-3f602d42c773",
                                                "sense_id": "ce0ff3fd-45f0-3934-a940-6967c4cec83c",
                                                "text": "“We don’t find evidence for that sort of thing anywhere in prehistory.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a90ac18-e696-3977-b126-97a37f953305",
                                        "entry_id": "076dcc1e-af68-379f-a8f3-4d30b260c0fe",
                                        "glosses": [
                                            "The study of those times."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8439821-7cb6-34f6-b030-cb6a8c374805",
                                        "entry_id": "076dcc1e-af68-379f-a8f3-4d30b260c0fe",
                                        "glosses": [
                                            "Any past time (even recent) treated as such a distant, unknowable era."
                                        ],
                                        "tags": [
                                            "countable",
                                            "excessive",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32cac132-75c1-4cfc-9062-a29414ae4868",
                                                "sense_id": "b8439821-7cb6-34f6-b030-cb6a8c374805",
                                                "text": "I was a town boy through and through. The country belonged to a vague pre-history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4fb65c-ade3-3071-8218-07b253656c27",
                                        "entry_id": "076dcc1e-af68-379f-a8f3-4d30b260c0fe",
                                        "glosses": [
                                            "The history leading up to some event, condition, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25b9f0fe-3f89-46ad-a4a4-fb1d00193c8c",
                                                "sense_id": "dc4fb65c-ade3-3071-8218-07b253656c27",
                                                "text": "Psychologists... are mostly bad historians, inventing—as Freud has done—their pre-history to suit their theories."
                                            },
                                            {
                                                "example_id": "da7d6b89-bbe6-4d12-a674-35a77ebd5a96",
                                                "sense_id": "dc4fb65c-ade3-3071-8218-07b253656c27",
                                                "text": "One of the challenges of studying any Jewish custom is that we tend to view it in an anachronistic fashion; we think that what we do today is what was always done. Therefore, in this article we shall describe the pre-history of the Bar Mitzvah ceremony, the four basic components of the Bar Mitzvah ceremony before the year 1800 as suggested by Michael Hilton, and six major changes that occurred in modern times."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
