                        "examples": [
                            {
                                "example_id": "11607c86-cc06-41f1-afcd-29b59750d193",
                                "sense_id": "e66c1995-5c33-37f3-a183-1cf6959763a5",
                                "text": "„Talbott hatte erzählt, er habe einen chirurgisch implantierten Chip in seinem Körper. Wo genau er implantiert war, hatte er nicht sagen wollen, aber dicht unter der Haut. Er sendete ein GPS-Signal aus, mit dem das FBI ihn finden konnte.“"
                            },
                            {
                                "example_id": "3dff94eb-8fc1-49b3-982d-79d281e9467d",
                                "sense_id": "e66c1995-5c33-37f3-a183-1cf6959763a5",
                                "text": "„Mayes fragte sie, ob sie ein iPad oder irgendein anderes Teil mit GPS-Signal hier im Wagen habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
