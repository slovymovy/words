                "translations": [
                    {
                        "translation_id": "724b19e2-fe94-4761-b618-d1910bf8082a",
                        "source_entry_id": "1ff31907-1a78-33ad-b719-ace1e7db8f86",
                        "source_sense_id": "5e75bb8f-274e-316d-8622-80b8b8a265f6",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Waschbecken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waschbecken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                        "entry_id": "089a549d-16ac-3652-b6ab-73a42f433fae",
                                        "glosses": [
                                            "meist an einer Wand befestigte, sanitäre Anlage zum Waschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dff3ea3-d87f-4694-9586-fa0cc63ef60a",
                                                "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                                "text": "Er wusch sich am Waschbecken die dreckigen Hände."
                                            },
                                            {
                                                "example_id": "17621eb5-1d71-4671-b188-a8b7c02e5219",
                                                "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                                "text": "„Nicht weit von Mr. Smile und mir entfernt wusch eine Frau Wäsche, sie schlug auf nasse Kleider in einem kleinen öffentlichen Waschbecken ein, das an einer Wasserstelle neben der unbefestigten Straße stand.“"
                                            },
                                            {
                                                "example_id": "ddbc16e2-67b3-4a83-b7e9-0f0194c62c8f",
                                                "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                                "text": "„Grenfeld stützte sich am Waschbecken ab.“"
                                            },
                                            {
                                                "example_id": "921a1281-5810-4ee7-93bf-b4bdc3f58af6",
                                                "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                                "text": "„Wir wählen ein Zimmer im Untergeschoß, das gleich zweifach Vorteile bietet: ein Waschbecken mit Wasserleitung, die sogar funktioniert, und einen rückwärtigen Ausgang.“"
                                            },
                                            {
                                                "example_id": "451d51d8-c6a2-488d-8679-1eba94e08e6c",
                                                "sense_id": "d14c219e-b46c-3624-82d2-149fec3ace51",
                                                "text": "„Mr. Sipple wollte durch die Küche gehen und war stehengeblieben, um über die Schulter seiner Frau hinweg das winzige Mädchen im Waschbecken auf dem Küchentisch zu betrachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0eacd4e4-7559-4495-9b75-f517648804a7",
                        "source_entry_id": "1ff31907-1a78-33ad-b719-ace1e7db8f86",
                        "source_sense_id": "5e75bb8f-274e-316d-8622-80b8b8a265f6",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Waschschüssel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waschschüssel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e5cc4f-76cb-3e6d-ab67-4129ab2c9777",
                                        "entry_id": "31962d8d-6b6c-3b16-9f0c-d935d8465c5d",
                                        "glosses": [
                                            "relativ flaches Gefäß mit oben weiter Öffnung zum Waschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91627091-784b-437e-90a5-5914c647770a",
                                                "sense_id": "a4e5cc4f-76cb-3e6d-ab67-4129ab2c9777",
                                                "text": "„Tjaden und Müller haben ein paar Waschschüsseln aufgetrieben und sie sich bis zum Rand gestrichen voll geben lassen, als Reserve.“"
                                            },
                                            {
                                                "example_id": "8b9d927a-2fcf-4a7e-b6da-5097be0f881a",
                                                "sense_id": "a4e5cc4f-76cb-3e6d-ab67-4129ab2c9777",
                                                "text": "„Die Mädchen drängen sich vor der Tür des Waschraums, einige sind mit ihren Waschschüsseln und der Wäsche auf den Hof gegangen.“"
                                            },
                                            {
                                                "example_id": "272398bc-7b13-4cd6-a755-75b5dc9615be",
                                                "sense_id": "a4e5cc4f-76cb-3e6d-ab67-4129ab2c9777",
                                                "text": "„In jedem der Zimmer stand eine kleine Waschschüssel, eine Blechschachtel, auf welche die Seife abzulegen war, ein Handtuch, sonst nichts, was die Waschutensilien angeht.“"
                                            },
                                            {
                                                "example_id": "1bb677d2-f69b-4e87-bc3a-01a67cbbdf0c",
                                                "sense_id": "a4e5cc4f-76cb-3e6d-ab67-4129ab2c9777",
                                                "text": "„Diener brachten Waschschüsseln, heißes Wasser zum Rasieren und die gereinigten Kleidungsstücke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
