                    {
                        "translation_id": "968a9e94-3b25-4722-ab7a-d374e70f1c03",
                        "source_entry_id": "c801b878-91a0-361e-9576-2785301c37f0",
                        "source_sense_id": "3edbc89d-958b-3708-b5f7-fec2266e0c66",
