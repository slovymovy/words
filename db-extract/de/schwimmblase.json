                        "entry_id": "a5a520b1-5c79-37f8-9b0b-121a2bf0a344",
                        "glosses": [
                            "inneres Organ einiger Knochenfische, das aus einem dünnwandigen Sack besteht und mehr oder weniger mit Luft gefüllt ist; sorgt dafür, dass der Fisch im Wasser schwebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb354b5-898a-4891-8b40-09fdc9a5fb0b",
                                "sense_id": "6e998a53-b453-3405-92a4-71519ac42b28",
                                "text": "Um an die Wasseroberfläche zu steigen, füllt der Fisch seine Schwimmblase mit Luft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
