                                ]
                            },
                            {
                                "target_word": "transporteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea108d29-ff65-3510-8b4a-8c6bdbcc49c7",
                                        "entry_id": "6036137c-e141-319e-8467-bcee5558cdd4",
