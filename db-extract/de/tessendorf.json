                "senses": [
                    {
                        "sense_id": "162e2dc7-91bf-309c-9fd0-9d8364409400",
                        "entry_id": "89cc3471-ea3a-38ea-a5d7-638b0a2121ad",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "431b1e2e-91b9-4fd6-9aed-a7c6934db24f",
                                "sense_id": "162e2dc7-91bf-309c-9fd0-9d8364409400",
                                "text": "Frau Tessendorf ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9d8be862-1354-43c9-bd76-e9df25110070",
                                "sense_id": "162e2dc7-91bf-309c-9fd0-9d8364409400",
                                "text": "Herr Tessendorf wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3e041334-575e-4f4e-9be1-c36c7a925bf3",
                                "sense_id": "162e2dc7-91bf-309c-9fd0-9d8364409400",
                                "text": "Die Tessendorfs fahren heute nach Rügen."
                            },
                            {
                                "example_id": "f649126b-a4e5-4d19-89bc-4fad81257899",
                                "sense_id": "162e2dc7-91bf-309c-9fd0-9d8364409400",
                                "text": "Der Tessendorf trägt nie die Schals, die die Tessendorf ihm strickt."
                            },
                            {
                                "example_id": "bba2a685-4976-4734-a2db-0aed3bae83e3",
                                "sense_id": "162e2dc7-91bf-309c-9fd0-9d8364409400",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tessendorf kommt, geht der Herr Tessendorf.“"
                            },
                            {
                                "example_id": "f1c53272-e357-4def-b56a-469f1385f70a",
                                "sense_id": "162e2dc7-91bf-309c-9fd0-9d8364409400",
                                "text": "Tessendorf kommt und geht."
                            },
                            {
                                "example_id": "8e6c1c6f-f505-4bb3-912f-e5f1ba9c522d",
                                "sense_id": "162e2dc7-91bf-309c-9fd0-9d8364409400",
                                "text": "Tessendorfs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
