                "senses": [
                    {
                        "sense_id": "39e5ea71-c78d-3dba-8e7e-32ee5e4e5601",
                        "entry_id": "b2dc941f-f837-3cb1-ac12-0f33aa77dc8e",
                        "glosses": [
                            "to profane"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac2d77c-a966-4cc3-8a5c-bbe186780545",
                                "sense_id": "39e5ea71-c78d-3dba-8e7e-32ee5e4e5601",
                                "text": "— Не кощу́нствуй, по кра́йней ме́ре. Всё мо́жешь говори́ть, а кощу́нствовать… не позволя́ю! Куда́ же вы де́ньги посла́ли?",
                                "translation": "‘No blasphemy! Spare me that at least! Say what you like, but blasphemy... I’ll not allow! What place did you send the money to?’",
                                "english": "‘No blasphemy! Spare me that at least! Say what you like, but blasphemy... I’ll not allow! What place did you send the money to?’"
                            }
                        ]
                    }
                ],
