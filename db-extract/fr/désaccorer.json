                "senses": [
                    {
                        "sense_id": "f7deade4-9b4a-3c94-8670-58e4d26465d0",
                        "entry_id": "38217b96-104d-3554-a840-b6036b2bf42a",
                        "glosses": [
                            "Enlever les accores de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "811a4495-1b1e-4e38-bfdd-9ee1b0aa85f1",
                                "sense_id": "f7deade4-9b4a-3c94-8670-58e4d26465d0",
                                "text": "Moyennant les taxes fixées au tarif précédent, l'adjudicataire sera tenu de manœuvrer le bateau-porte, d'accorer et désaccorer le navire, de mettre et d'entretenir constamment la forme à sec, de nettoyer et d'entretenir en parfait état de propreté les escaliers, banquettes, gradins, tins et rigoles de la forme."
                            },
                            {
                                "example_id": "2c2b5ff5-1b5e-41eb-8123-0875c0fb1194",
                                "sense_id": "f7deade4-9b4a-3c94-8670-58e4d26465d0",
                                "text": "L'expérience a prouvé que le coefficient f n'est pas indépendant de la pression que le navire désaccoré exerce sur sa cale : plus cette pression est grande par centimètre carré de la surface de portage, plus f est petit;"
                            }
                        ]
                    }
