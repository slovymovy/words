                        ],
                        "examples": [
                            {
                                "example_id": "37f13bcb-fb01-419f-9599-ed2cd10c77f2",
                                "sense_id": "d03bae54-242c-32d0-bb78-e1b0440099b2",
                                "text": "We need scarcely allude here to works of art: in the sphere of poetry and of fiction, generally, the decay is so universally admitted, now, that the boldest novators would not attempt to contradict it."
                            },
                            {
                                "example_id": "6594134e-ff44-4570-a8e5-9896d8fc3a73",
                                "sense_id": "d03bae54-242c-32d0-bb78-e1b0440099b2",
                                "text": "France has enjoyed the sad privilege of witnessing twice in her history, at an interval of two or three centuries, a coup d'état directed against her institutions which novators have endeavoured to destroy and to blot out."
                            }
                        ]
                    }
