                                    },
                                    {
                                        "sense_id": "f80d224e-4f22-3037-b4ef-0a0e61b81315",
                                        "entry_id": "0435b19a-6104-31fd-b97f-de3597a40d35",
                                        "glosses": [
                                            "перен. искренность, откровенность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dfb1f78-cb45-477e-b6ee-6943f8932d4c",
                                                "sense_id": "f80d224e-4f22-3037-b4ef-0a0e61b81315",
                                                "text": "Гости приписали эту откровенность честности и прямоте его характера, к тому же водка развязала ему язык."
                                            }
                                        ]
