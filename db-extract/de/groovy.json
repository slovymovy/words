                                        "sense_id": "ddb1c242-9c23-3b33-a5ff-d5a92169cdbb",
                                        "entry_id": "1dc84573-9f8c-3db4-9206-962bdea43f27",
                                        "glosses": [
                                            "A trendy and fashionable person."
                                        ],
