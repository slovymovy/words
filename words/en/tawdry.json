{
    "word_family": [
        "tawdriness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1595d92a-8a16-327a-8d30-8fdfdf3b35e4",
                    "sense_definition": "Cheap and gaudy in appearance or quality; tastelessly showy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore <w>tawdry</w> jewelry that looked cheap under the bright lights.    ",
                            "target_lang_translations": {
                                "pl": "Nosiła <w>tandetną</w> biżuterię, która wyglądała tanio w jasnym świetle."
                            }
                        },
                        {
                            "text": "The carnival booth was decorated with <w>tawdry</w> ornaments that faded quickly in the sun.",
                            "target_lang_translations": {
                                "pl": "Stoisko na festynie było udekorowane <w>kiczowatymi</w> ozdobami, które szybko wyblakły na słońcu."
                            }
                        }
                    ],
                    "synonyms": [
                        "gaudy",
                        "flashy",
                        "garish",
                        "tacky",
                        "chintzy"
                    ],
                    "antonyms": [
                        "tasteful",
                        "elegant"
                    ],
                    "common_phrases": [
                        "tawdry decorations",
                        "tawdry jewelry"
                    ],
                    "target_lang_definitions": {
                        "pl": "Tani i jaskrawy pod względem wyglądu lub jakości; krzykliwy i bez gustu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tani i krzykliwy",
                                "target_lang_sense_clarification": "o wyglądzie lub jakości"
                            },
                            {
                                "target_lang_word": "kiczowaty",
                                "target_lang_sense_clarification": "bez gustu, odpustowy"
                            },
                            {
                                "target_lang_word": "tandetny",
                                "target_lang_sense_clarification": "słabej jakości i krzykliwy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "396e3548-3b3e-3d6e-b0db-a7c86467ccfe",
                    "sense_definition": "Morally low, disgraceful, or sordid in character.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper published all the details of the politician's <w>tawdry</w> affair.    ",
                            "target_lang_translations": {
                                "pl": "Gazeta opublikowała wszystkie szczegóły <w>brudnego</w> romansu polityka."
                            }
                        },
                        {
                            "text": "He wanted to distance himself from the <w>tawdry</w> scandal that ruined his partner's reputation.",
                            "target_lang_translations": {
                                "pl": "Chciał zdystansować się od <w>szpetnego</w> skandalu, który zniszczył reputację jego partnera."
                            }
                        }
                    ],
                    "synonyms": [
                        "sordid",
                        "sleazy",
                        "shameful",
                        "unseemly"
                    ],
                    "antonyms": [
                        "honorable",
                        "respectable"
                    ],
                    "common_phrases": [
                        "tawdry affair",
                        "tawdry scandal"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niski moralnie, hańbiący lub brudny w charakterze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "brudny",
                                "target_lang_sense_clarification": "o romansie, skandalu moralnym"
                            },
                            {
                                "target_lang_word": "obrzydliwy",
                                "target_lang_sense_clarification": "niemoralny, gorszący"
                            },
                            {
                                "target_lang_word": "szpetny",
                                "target_lang_sense_clarification": "hańbiący, moralnie niski"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c9cffbf-f086-336c-88bb-56ccaeecc600",
                    "sense_definition": "Cheap, showy, or pretentious finery or decoration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop was filled with useless <w>tawdry</w> that no one wanted to buy.    ",
                            "target_lang_translations": {
                                "pl": "Sklep był pełen bezużytecznej <w>tandety</w>, której nikt nie chciał kupić."
                            }
                        },
                        {
                            "text": "He covered his horse in extra <w>tawdry</w> just to impress the crowd.",
                            "target_lang_translations": {
                                "pl": "Ozdobił swojego konia dodatkowymi <w>kiczowatymi świedełkami</w>, tylko po to, by zrobić wrażenie na tłumie."
                            }
                        }
                    ],
                    "synonyms": [
                        "finery"
                    ],
                    "target_lang_definitions": {
                        "pl": "Tania, krzykliwa lub pretensjonalna ozdoba bądź stroje."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tandeta",
                                "target_lang_sense_clarification": "tanie, krzykliwe ozdoby"
                            },
                            {
                                "target_lang_word": "kicz",
                                "target_lang_sense_clarification": "bezgustne dekoracje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b315b58c-e2d6-3292-ba3f-7fae2cb2a44f",
                    "sense_definition": "Cheap, showy lace originally sold at St. Audrey's fair.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In centuries past, street vendors sold cheap <w>tawdry</w> to fairgoers.    ",
                            "target_lang_translations": {
                                "pl": "W ubiegłych wiekach uliczni sprzedawcy oferowali uczestnikom jarmarku tanią <w>koronkę</w>."
                            }
                        },
                        {
                            "text": "She bound her hair with a simple piece of <w>tawdry</w>.",
                            "target_lang_translations": {
                                "pl": "Związała włosy zwykłym kawałkiem taniej <w>koronki</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical term for cheap lace"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Tania, jaskrawa koronka sprzedawana pierwotnie na jarmarku św. Audreja."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tania koronka",
                                "target_lang_sense_clarification": "historyczne określenie taniej koronki jarmarcznej"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}