                        {
                            "text": "His hard work helped <w>advance</w> him to a management position.",
                            "target_lang_translations": {
                                "ru": "Его усердная работа помогла <w>продвинуть</w> его на руководящую должность.",
                                "pl": "Jego ciężka praca pomogła mu <w>awansować</w> na stanowisko kierownicze."
                            }
                        }
