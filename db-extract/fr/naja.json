                "senses": [
                    {
                        "sense_id": "b3101319-0a5a-3173-8da1-45061438e95c",
                        "entry_id": "2d73e257-75bf-39b8-94d5-519a5fe4a6fe",
                        "glosses": [
                            "Serpent venimeux de l’ordre des vipères."
                        ],
                        "tags": [
                            "Ophiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ae13f72c-8c05-483a-aa06-c835e5c45508",
                                "sense_id": "b3101319-0a5a-3173-8da1-45061438e95c",
                                "text": "Il est énorme. Il doit mesurer à peu près quatre mètres.\nNoir et or.\nUn Naja bungarus.\nD'où l'ont-ils eu ? Pourquoi l'ont-ils amené jusqu'ici ?"
                            },
                            {
                                "example_id": "a22bf583-6552-4e2c-aebe-586f00d71f6b",
                                "sense_id": "b3101319-0a5a-3173-8da1-45061438e95c",
                                "text": "Il y en a un qui doit l'avoir mordu, soit le crotale, soit le naja. Ces bestioles, ça ne pardonne pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3395e9a0-6eaa-42a4-9687-8a430379ce21",
                        "source_entry_id": "2d73e257-75bf-39b8-94d5-519a5fe4a6fe",
                        "source_sense_id": "b3101319-0a5a-3173-8da1-45061438e95c",
