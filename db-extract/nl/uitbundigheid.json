                                        "entry_id": "7fd79607-29cc-3075-9655-de763734739c",
                                        "glosses": [
                                            "The quality of being exuberant; cheerful or vigorous enthusiasm; liveliness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "250deff3-8ff4-48b8-87d0-282e5b809d45",
                                                "sense_id": "4602d7b8-a0ba-3b6e-a59a-d488bd9a7832",
                                                "text": "Tottenham's desire for a win against a Norwich side playing with energy and exuberance made for an enthralling, end-to-end game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f8ed1e2-066e-3739-97aa-1d4d1baff6af",
                                        "entry_id": "7fd79607-29cc-3075-9655-de763734739c",
