                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10ff646e-2f98-40b1-ba3b-7d44a51051be",
                                "sense_id": "106d1f9e-2c57-3e25-8f27-941de0afc4cb",
                                "text": "Etylen jest hormonem roślinnym, stymulującym opadanie liści, dojrzewanie owoców, starzenie się roślin."
