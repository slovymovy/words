                ],
                "translations": [
                    {
                        "translation_id": "24521a79-ecd0-47ae-83c5-4f9f29b098ac",
                        "source_entry_id": "45e3a489-75f1-3dca-bf05-a2a39d80e104",
                        "source_sense_id": "7dd22f39-6caf-32cd-81d4-ec54feaa6ce6",
                        "target_lang_word": "saurian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saurian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39e4ee6d-7118-3f83-a0b8-dd1100d8f8a6",
                                        "entry_id": "664f063e-96e4-3538-83ac-028b0036f0bd",
                                        "glosses": [
                                            "A reptile of the suborder Sauria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "767dee75-6d0a-402c-a6b1-0be5ca3db035",
                                                "sense_id": "39e4ee6d-7118-3f83-a0b8-dd1100d8f8a6",
                                                "text": "I took heart, however, as I recalled a conversation between Challenger and Summerlee upon the habits of the great saurians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a46f3b35-f92e-3724-a03b-cb6c73b8919e",
                                        "entry_id": "664f063e-96e4-3538-83ac-028b0036f0bd",
                                        "glosses": [
                                            "Any large reptilian animal, including crocodiles and reptilian aliens."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5421c107-ffa1-4789-a38a-a4151ed0f463",
                                                "sense_id": "a46f3b35-f92e-3724-a03b-cb6c73b8919e",
                                                "text": "After dinner we all went on deck and watched the unfamiliar scenes of a Capronian night--that is, all but von Schoenvorts. There was less to see than to hear. From the great inland lake behind us came the hissing and the screaming of countless saurians. Above us we heard the flap of giant wings, while from the shore rose the multitudinous voices of a tropical jungle--of a warm, damp atmosphere such as must have enveloped the entire earth during the Palezoic and Mesozoic eras."
                                            },
                                            {
                                                "example_id": "9f71be08-5dcd-440e-9515-85c670ceba4c",
                                                "sense_id": "a46f3b35-f92e-3724-a03b-cb6c73b8919e",
                                                "text": "Good evening, fellow saurians, and welcome once again to the Tri-Sports Arena! I'm your host, Raz Charkov..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "403b7124-b954-30ec-9955-4d724cee2690",
                                        "entry_id": "664f063e-96e4-3538-83ac-028b0036f0bd",
                                        "glosses": [
                                            "A lizardlike person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e03320d8-03f9-4b83-add6-fc19da79111e",
                                                "sense_id": "403b7124-b954-30ec-9955-4d724cee2690",
                                                "text": "He was one of the very few larger saurians in the émigré marshes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "saurian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "970cd746-00bb-3ee9-9b5c-18a298fbd8c3",
                                        "entry_id": "af5c17da-5987-314a-a819-4baa911fd8da",
                                        "glosses": [
                                            "Of or related to the members of the suborder Sauria."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b136615a-7736-34ed-8045-9c5db9fefac5",
                                        "entry_id": "af5c17da-5987-314a-a819-4baa911fd8da",
                                        "glosses": [
                                            "Synonym of lizardlike or reptilian."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a243fade-e3eb-41f7-8a4c-8ceeaed35ef4",
                        "source_entry_id": "45e3a489-75f1-3dca-bf05-a2a39d80e104",
                        "source_sense_id": "edcb8e53-5c34-3422-8222-70f25a37dd9e",
                        "target_lang_word": "shagreen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shagreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e2ec98d-83ae-3d9e-a348-e661f8ac9622",
                                        "entry_id": "2ae9d273-dbe4-35f0-8174-91eb804880b7",
                                        "glosses": [
                                            "An untanned leather, often dyed green; originally made from horse skin, today mostly made from the skin of a shark or ray."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79d5ef2b-1332-4043-b174-149c324200fd",
                                                "sense_id": "3e2ec98d-83ae-3d9e-a348-e661f8ac9622",
                                                "text": "The following day the treasures of the mysterious tower came pouring in: pictures, statues, gems, shells, china, stuffed beasts and birds, tables, vases, petrifactions, arms, mandarins, &c. &c.; and among them the shagreen skin, with the injunction, \"Sell it for any thing—nothing—give it away; only, get rid of it.\""
                                            },
                                            {
                                                "example_id": "4f091c9b-b677-4060-85ac-0d7466ad58b3",
                                                "sense_id": "3e2ec98d-83ae-3d9e-a348-e661f8ac9622",
                                                "text": "On the old lecturn or reading-stand which he used for his heavier tomes, The Testaments of Carnamagos, in its covers of shagreen with hasps of human bone, lay open at the very page which had frightened him so unreasonably with its eldritch intimations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b99a07-3c12-3878-a088-f28109c0be93",
                                        "entry_id": "2ae9d273-dbe4-35f0-8174-91eb804880b7",
                                        "glosses": [
                                            "A rough or spiny surface of an insect's cuticle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7801cd88-2d05-4ca7-b4f9-6938bd556fee",
                                                "sense_id": "56b99a07-3c12-3878-a088-f28109c0be93",
                                                "text": "If the shagreen dots be carefully observed they will be found to possess an annular arrangement."
                                            },
                                            {
                                                "example_id": "58a0e3d1-11c7-42fb-9d12-4caf43e505a6",
                                                "sense_id": "56b99a07-3c12-3878-a088-f28109c0be93",
                                                "text": "The shagreen of the abdominal tergites generally consists of small spinules, singly or in caudally convex arcs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shagreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "223e80a3-415f-33d4-a509-80d4d3f7d2af",
                                        "entry_id": "c671890c-f6ea-3ac3-a2f9-dc2b5eaf98ac",
                                        "glosses": [
                                            "To give a texture resembling shagreen leather."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
