                    "sense_definition": "Devenir habité ou voir sa population augmenter progressivement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "habitat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce aux nouvelles constructions, ce quartier calme commence à se <w>peupler</w>."
