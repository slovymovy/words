                        "examples": [
                            {
                                "example_id": "6b77d7ff-f73d-496c-9b26-aba1d95413f4",
                                "sense_id": "298a2d86-de04-30fa-b53b-bf64344af9a4",
                                "text": "Frau Lynn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b33b338f-03cb-43cc-9659-1b6566998af0",
                                "sense_id": "298a2d86-de04-30fa-b53b-bf64344af9a4",
                                "text": "Herr Lynn wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "98c77d1b-70af-43e4-bfc8-571d3f5c42c2",
                                "sense_id": "298a2d86-de04-30fa-b53b-bf64344af9a4",
                                "text": "Die Lynns fliegen heute nach Dublin."
                            },
                            {
                                "example_id": "75c5cf85-f2ec-470f-8111-d88f79ad6199",
                                "sense_id": "298a2d86-de04-30fa-b53b-bf64344af9a4",
                                "text": "Der Lynn trägt nie die Schals, die die Lynn ihm strickt."
                            },
                            {
                                "example_id": "e649727b-d8fa-4a8b-a0f1-f8113769237d",
                                "sense_id": "298a2d86-de04-30fa-b53b-bf64344af9a4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lynn kommt, geht der Herr Lynn.“"
                            },
                            {
                                "example_id": "a69fc60d-60dc-4c35-8919-c3240e3c3d82",
                                "sense_id": "298a2d86-de04-30fa-b53b-bf64344af9a4",
                                "text": "Lynn kommt und geht."
                            },
                            {
                                "example_id": "9ab3e575-8e11-424b-ae17-eb6fd2f80693",
                                "sense_id": "298a2d86-de04-30fa-b53b-bf64344af9a4",
                                "text": "Lynns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
