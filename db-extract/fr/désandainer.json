                "senses": [
                    {
                        "sense_id": "6c9877cb-140c-3cea-9ad5-f489338088a1",
                        "entry_id": "db12ae8f-1eaa-3a52-b565-9b570450657a",
                        "glosses": [
                            "Enlever le foin qui avait été mis en andains (par exemple pour le mettre en meules)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece54fb9-58a4-472f-884b-eddcad438228",
                                "sense_id": "6c9877cb-140c-3cea-9ad5-f489338088a1",
                                "text": "Dans les intervalles de beau temps, on a soin de désandainer et d'agiter le foin."
                            },
                            {
                                "example_id": "6eeb3057-129f-4401-9cec-3e50af0bd988",
                                "sense_id": "6c9877cb-140c-3cea-9ad5-f489338088a1",
                                "text": "On tâtonne ses opérations ; on consulte à tout moment le baromètre pour savoir si l'on fera faucher; si l'herbe est coupée, on n'ose pas faire désandiner, ou désandainer, parce que le foin exposé à la pluie se détériore moins en andain que lorsqu'il est répandu sur le pré;"
                            }
                        ]
                    }
                ],
