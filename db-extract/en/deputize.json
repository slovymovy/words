                                        "entry_id": "99cf0b99-f134-3830-a412-b2eb1bf10b94",
                                        "glosses": [
                                            "zeitweise an Stelle von jemand anderem handeln, repräsentieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c66bad14-984d-446b-9e56-e77b73518474",
                                                "sense_id": "d1d8b720-d9e7-3ca5-b859-4b9b709990f0",
                                                "text": "Die kranke Frau Klein wurde heute von Herrn Gross vertreten."
                                            },
                                            {
                                                "example_id": "05483d18-bf9a-46ea-996c-f8beb3b83594",
                                                "sense_id": "d1d8b720-d9e7-3ca5-b859-4b9b709990f0",
                                                "text": "„Die Ergebnisse wurden als Empfehlungen an den DAeC weitergeleitet, denn beschließen können die Segelflieger nichts, weil sie bislang – ebenso wie die Motorflieger, Modellflieger, Ballonfahrer und Fallschirmsportler – keine selbständige Sparte innerhalb des DAeC bilden, der den gesamten Luftsport beim Internationalen Luftfahrt-Verband (FAI) vertritt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "93237867-8602-3b2e-b05c-c8b31e115ee0",
                                        "entry_id": "99cf0b99-f134-3830-a412-b2eb1bf10b94",
                                        "glosses": [
                                            "für eine Auffassung einstehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32cf01e6-79c7-4424-87f7-f8c6aeee0ee1",
                                                "sense_id": "93237867-8602-3b2e-b05c-c8b31e115ee0",
                                                "text": "Ich vertrete die Ansicht, dass dieser Antrag abgelehnt werden sollte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2e53652e-3bbe-3fe7-996e-1badcff2058b",
                                        "entry_id": "99cf0b99-f134-3830-a412-b2eb1bf10b94",
                                        "glosses": [
                                            "nur Partizip: dasein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "343bd6c1-7fde-4779-a19d-7fa6bcd394d3",
                                                "sense_id": "2e53652e-3bbe-3fe7-996e-1badcff2058b",
                                                "text": "Wir werden bei dieser Tagung vertreten sein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "04f56ba7-0557-37a3-9508-f6f6b83b83e3",
                                        "entry_id": "99cf0b99-f134-3830-a412-b2eb1bf10b94",
                                        "glosses": [
                                            "den Fuß verletzen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c92a08c7-ae2d-40ce-9e08-6acb680dfdfb",
                                                "sense_id": "04f56ba7-0557-37a3-9508-f6f6b83b83e3",
                                                "text": "Beim Aufstehen habe ich mich vertreten und kann jetzt nur vorsichtig gehen."
                                            },
                                            {
                                                "example_id": "49e58e9e-74be-43da-a475-a9018d0a7e3c",
                                                "sense_id": "04f56ba7-0557-37a3-9508-f6f6b83b83e3",
                                                "text": "„Otto versuchte noch, sie aufzufangen, aber sie hatte sich den Fuß schon vertreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
