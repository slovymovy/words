    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a08113a1-7d0c-3a23-befa-6b999095201a",
                    "sense_definition": "Déformer un matériau ou un objet sous l'effet d'une force mécanique de rotation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "torsion_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a réussi à <w>tordre</w> cette barre de fer avec ses seules mains."
                        },
                        {
                            "text": "Attention à ne pas <w>tordre</w> la clé dans cette serrure très fragile."
                        }
                    ],
                    "synonyms": [
                        "déformer",
                        "plier"
                    ],
                    "antonyms": [
                        "redresser"
                    ],
                    "common_phrases": [
                        "tordre une barre",
                        "tordre un fil de fer"
                    ]
                },
                {
                    "sense_id": "8a02b21a-9960-31c3-9202-d84e3a8b7ac9",
                    "sense_definition": "Blesser une articulation en lui faisant subir une torsion anormale et violente.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "torsion_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur s'est <w>tordu</w> la cheville pendant la seconde mi-temps du match."
                        },
                        {
                            "text": "Fais attention où tu marches pour ne pas te <w>tordre</w> le pied."
                        }
                    ],
                    "synonyms": [
                        "fouler",
                        "luxer"
                    ],
                    "common_phrases": [
                        "se tordre la cheville",
                        "se tordre le poignet"
                    ]
                },
                {
                    "sense_id": "8d3c3cb8-40c2-33bf-bd28-7993618b2576",
                    "sense_definition": "Presser un linge ou un tissu mouillé en le tournant sur lui-même pour en exprimer l'eau.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "torsion_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien <w>tordre</w> le linge mouillé avant de l'étendre au soleil."
                        },
                        {
                            "text": "Elle a <w>tordu</w> la serpillière au-dessus du seau avant de laver la cuisine."
                        }
                    ],
                    "synonyms": [
                        "essorer"
                    ],
                    "common_phrases": [
                        "tordre le linge",
                        "tordre une serpillière"
                    ]
                },
                {
                    "sense_id": "6332b2ee-37eb-35c5-b070-52c1e3282eb2",
                    "sense_definition": "Se plier ou s'agiter convulsivement sous l'effet d'une sensation violente comme le rire ou la souffrance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction_corporelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants se <w>tordent</w> de rire devant ce spectacle de clowns très amusant."
                        },
                        {
                            "text": "Le patient se <w>tordait</w> de douleur en attendant l'arrivée du médecin de garde."
                        }
                    ],
                    "common_phrases": [
                        "se tordre de rire",
                        "se tordre de douleur"
                    ]
                },
                {
                    "sense_id": "a087b0ec-8697-320b-b6a8-f66f375212dd",
                    "sense_definition": "Fausser ou altérer volontairement le sens de propos, de principes ou de faits.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "alteration_abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet avocat essaie de <w>tordre</w> les faits pour influencer la décision des juges."
                        },
                        {
                            "text": "Ce journaliste a <w>tordu</w> mes déclarations pour créer une polémique inutile."
                        }
                    ],
                    "synonyms": [
                        "altérer",
                        "dénaturer",
                        "fausser"
                    ],
                    "antonyms": [
                        "respecter"
                    ],
                    "common_phrases": [
                        "tordre les faits",
                        "tordre les règles"
                    ]
                }
            ]
        }
    ]
}