                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De monteur controleerde de <w>achterstellen</w> van de oude rijtuigen grondig.",
                            "target_lang_translations": {
                                "en": "The mechanic thoroughly checked the <w>rear carriages</w> of the old coaches."
                            }
                        },
                        {
                            "text": "Bij deze voertuigen zijn de <w>achterstellen</w> steviger ontworpen dan de voorstellen.",
                            "target_lang_translations": {
