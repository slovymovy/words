                "senses": [
                    {
                        "sense_id": "85260ed0-09f8-3bd1-80dc-e0186ff8085f",
                        "entry_id": "5be3cdcc-0cec-3def-9fd5-755941587d35",
                        "glosses": [
                            "von den Vereinten Nationen gebildetes, beratendes Gremium, das (mit absoluter Mehrheit) die Entsendung von Beobachtern zur Überwachung der Menschenrechtssituation in einem Mitgliedstaat beschließen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b0f6a0-f62a-4890-8bf5-457e12178d88",
                                "sense_id": "85260ed0-09f8-3bd1-80dc-e0186ff8085f",
                                "text": "„Algeriens Menschenrechtsbilanz wurde im Mai 2012 im Rahmen der Universellen Regelmäßigen Überprüfung des UN-Menschenrechtsrats begutachtet.“"
                            },
                            {
                                "example_id": "f6ae6f21-c8b0-4081-ac95-81aa2a10efbb",
                                "sense_id": "85260ed0-09f8-3bd1-80dc-e0186ff8085f",
                                "text": "„Bei einer Anhörung vor dem UN-Menschenrechtsrat in Genf stellt sich Deutschland einer Überprüfung der Menschenrechtslage.“"
                            },
                            {
                                "example_id": "17748eec-f35e-4293-9661-9a0f1d7b24b9",
                                "sense_id": "85260ed0-09f8-3bd1-80dc-e0186ff8085f",
                                "text": "„Deutschland ist eines von 47 Mitgliedern des neuen UN-Menschenrechtsrats.“"
                            }
                        ],
