                        "examples": [
                            {
                                "example_id": "e3bbaba4-b632-4135-8333-e1d09b91d1f2",
                                "sense_id": "65acfbcf-99f0-3db5-988c-9d91761d2058",
                                "text": "Solange unser Vater lebte, durfte meine verstoßene Schwester Irmgard das Haus nicht wieder betreten."
                            },
                            {
                                "example_id": "0c9d0d14-e1f0-45e9-b44b-6c82eb9457f9",
                                "sense_id": "65acfbcf-99f0-3db5-988c-9d91761d2058",
                                "text": "Dieses Jahr hat Irmgard ihre Ausbildung zur Frisörin abgeschlossen."
                            },
                            {
                                "example_id": "9102627a-53d4-40ef-abb8-223774262992",
                                "sense_id": "65acfbcf-99f0-3db5-988c-9d91761d2058",
                                "text": "Irmgard wurde mit 14 Jahren zum ersten Mal Mutter."
                            }
                        ],
                        "sense_index_json": "\"1\""
