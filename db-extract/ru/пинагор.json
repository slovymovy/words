                                        "sense_id": "e9dc840d-a367-385c-836b-ef1d394b1245",
                                        "entry_id": "33b3c236-831d-3943-8980-abb513a1a883",
                                        "glosses": [
                                            "Any of various seabirds, especially the common guillemot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c58380c1-67f0-4169-8d76-d28633b184b9",
                                                "sense_id": "e9dc840d-a367-385c-836b-ef1d394b1245",
                                                "text": "Besides the penguin many other birds are here to be found, among which may be mentioned sea-hens, blue peterels, teal, ducks, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "136cd181-5116-46de-966f-919fb9f8a5c2",
                        "source_entry_id": "e8c1f9c5-a0b9-32cb-95f0-12e0575606f2",
                        "source_sense_id": "fb668d06-b6b1-3478-9f40-54464c6fbd1d",
                        "target_lang_word": "henfish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "henfish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3d977e7-fc37-3f6c-adb6-8963a78f1309",
                                        "entry_id": "834a6ac2-152c-3f85-8210-817a7afed0d9",
                                        "glosses": [
                                            "A marine fish, the sea bream."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b04de75-068f-3ca8-ab61-20492775fce9",
                                        "entry_id": "834a6ac2-152c-3f85-8210-817a7afed0d9",
                                        "glosses": [
                                            "A female fish, especially a salmon or trout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cf163ba-f029-478b-a2f1-6be145e9b1af",
                                                "sense_id": "1b04de75-068f-3ca8-ab61-20492775fce9",
                                                "text": "It was a fat nineteen-inch female and we released the handsome henfish to spawn again that fall."
                                            },
                                            {
                                                "example_id": "e44fb6d8-9df1-4a6b-b730-dac20351ac8b",
                                                "sense_id": "1b04de75-068f-3ca8-ab61-20492775fce9",
                                                "text": "Spawning fish on the redds. A henfish will often be attended by two or three cockfish – whilst displaying ritual combat between themselves, one cock will mate, others may follow [image caption]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c9dd6d7-1593-3512-a263-c5b7cfb5c84c",
                                        "entry_id": "834a6ac2-152c-3f85-8210-817a7afed0d9",
                                        "glosses": [
                                            "A fish that broods its eggs or fry, especially a lumpsucker or lumpfish (Cyclopteridae)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f39fb4ab-f18b-4fe5-bcd1-0651f4d90443",
                                                "sense_id": "1c9dd6d7-1593-3512-a263-c5b7cfb5c84c",
                                                "text": "the parental responsibility shouldered by the male lumpfish as he guards his unborn spawn and later his newborn fry has earned the master of the house the rather unlikely name of “henfish.”"
                                            },
                                            {
                                                "example_id": "9c5a2a77-947f-4a16-b525-8646cf7545c8",
                                                "sense_id": "1c9dd6d7-1593-3512-a263-c5b7cfb5c84c",
                                                "text": "the lumpsucker gets its name from the sucker on the underside of its body. It is also called the henfish because of the devotion with which the male fish guards the eggs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
