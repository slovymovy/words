                "senses": [
                    {
                        "sense_id": "ac873cc8-2c27-3a43-a7f2-86774ab7b7f7",
                        "entry_id": "fd24e8c1-2df6-3f49-9bb4-33f3d9dda15e",
                        "glosses": [
                            "Einsatz der Polizei, des Militärs oder Ähnliches, an dem viele Personen beteiligt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8be9a8-ceee-4fed-b88e-7b00ff3e4ad6",
                                "sense_id": "ac873cc8-2c27-3a43-a7f2-86774ab7b7f7",
                                "text": "„Nach den Bluttaten in den beiden Anwaltsbüros hatte die Polizei einen Großeinsatz eingeleitet, zahlreiche Spezialeinheiten wurden in der Region zusammengezogen.“"
                            },
                            {
                                "example_id": "f05981b4-f63c-46ba-bfdc-4bb28fd640f9",
                                "sense_id": "ac873cc8-2c27-3a43-a7f2-86774ab7b7f7",
                                "text": "„Schlag gegen Kreditkartenbetrug beim Kauf von Flugtickets: Bei einem internationalen Großeinsatz sind 183 Menschen festgenommen worden.“"
                            },
                            {
                                "example_id": "5960ce44-63af-499b-8408-c94987a49275",
                                "sense_id": "ac873cc8-2c27-3a43-a7f2-86774ab7b7f7",
                                "text": "„Eine Massenschlägerei im nordrhein-westfälischen Heiligenhaus hat einen Großeinsatz der Polizei ausgelöst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
