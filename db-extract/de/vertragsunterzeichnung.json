                "senses": [
                    {
                        "sense_id": "32363d86-fd7b-3ada-a9e4-eef849ef2d90",
                        "entry_id": "ace66e09-aa0d-33ce-800f-d599dc739fd7",
                        "glosses": [
                            "das Unterschreiben einer rechtlich bindenden Vereinbarung zwischen mindestens zwei verschiedenen Partnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db2e4f0-8660-40d9-a0c1-cdd28e67df49",
                                "sense_id": "32363d86-fd7b-3ada-a9e4-eef849ef2d90",
                                "text": "„Er wollte mit seiner Lebensgefährtin in eine neue Wohnung ziehen, doch die Vermieter machten vor der Vertragsunterzeichnung einen Rückzieher.“"
                            },
                            {
                                "example_id": "afc16095-bb56-432f-9842-d28b59f5a235",
                                "sense_id": "32363d86-fd7b-3ada-a9e4-eef849ef2d90",
                                "text": "„Der Krieg, der mit der Vertragsunterzeichnung endete und der auf das Konto von Ian Smith und seiner halsstarrigen, repressiven sowie konzeptionslosen Politik ging, hatte mehr als 30 000, meist afrikanische Menschenleben gekostet und 100 000 Verwundete; mehr als 750 000 waren durch die Zwangsumsiedlungen in Wehrdörfer entwurzelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
