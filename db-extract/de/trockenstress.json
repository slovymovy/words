                ],
                "senses": [
                    {
                        "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                        "entry_id": "d8721124-01a6-339c-b92c-a623387cbb74",
                        "glosses": [
                            "Reaktionen von Pflanzen auf Mangel an Wasser infolge ungenügender Bodenfeuchtigkeit, beispielsweise nach Dürreperioden oder infolge Bodenversiegelung, Grundwasserabsenkung"
                        ],
                        "tags": [
                            "Forstwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "ba002b59-066d-44a1-b492-6ffb19f9a0e5",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "„Die durch den Trockenstress geschwächten Bäume werden anfällig für den sich durch die hohen Temperaturen rasch vermehrenden Borkenkäfer und können Stürmen nicht mehr standhalten.“"
                            },
                            {
                                "example_id": "e880d75a-50ca-4202-acd9-2fef6fff9f6e",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "[Vergleich der Douglasie mit der heimischen Fichte und Tanne:] „Und diese Ergebnisse zeigen, dass die Douglasie deutlich wüchsiger als die beiden anderen Baumarten und deutlich besser mit Trockenstress fertig wird und sich besser erholt als die Fichte.“"
                            },
                            {
                                "example_id": "2da898d3-9565-418c-8206-cd1c9bf56fd7",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "[Schweiz:] „Es herrscht verbreitet Trockenheit, Bäume im nördlichen Alpenraum sowie im Wallis weisen Trockenstress auf. Das zeigt sich zum Beispiel darin, dass sie Früchte abwerfen oder verfärbte Blätter haben.“"
                            },
                            {
                                "example_id": "0512465d-227a-44cf-8fa4-160e389798bd",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "[Schweiz:] „Wegen der Hitze sind die Bäume unter Trockenstress geraten und haben begonnen, ihre Blätter abzustossen.“"
                            },
                            {
                                "example_id": "48ac8a32-5d32-4d4c-aff3-31c36802bdc9",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "[Schweiz:] „Der Bodenwasserspeicher in den tieferen Schichten konnte sich im letzten Winter nicht komplett auffüllen – deshalb gehen die Wasserreserven im Boden jetzt schon wieder zurück. Man muss in den betroffenen Gebieten dieses Jahr mit vermehrtem Trockenstress für den Wald rechnen.“"
                            },
                            {
                                "example_id": "e0df17b3-2464-4e60-a852-3c793c914cc3",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "„»Jetzt wollen die Pflanzen austreiben und blühen und dafür brauchen sie natürlich Wasser«, sagt Verena Graichen von der Umweltorganisation BUND. Bekommen sie das nicht, geraten sie frühzeitig unter Trockenstress, wie schon jetzt flachwurzelnde Bäume wie die Birke.“"
                            },
                            {
                                "example_id": "d019b6c1-cc46-437d-a02c-79910c31d2ae",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "„In weiten Teilen Sachsen-Anhalts und im nördlichen Thüringen ist der Trockenstress für Pflanzen wieder ausgebrochen, die Böden sind trocken.“"
                            },
                            {
                                "example_id": "44f6433e-3af5-46ae-bddc-c4f4f2328a2d",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "[Sachsen-Anhalt:] „In Teilen des Ostens und Nordens des Landes sind die Folgen von Trockenstress demnach bereits deutlich sichtbar.“"
                            },
                            {
                                "example_id": "6dcf3463-2098-4661-ae0d-284287f8ef56",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "„Trockenstress führt zu Ernteeinbußen. Die Dürre 2018 ließ die Getreideerträge durchschnittlich um 18 % sinken; in einigen Regionen um deutlich mehr als 25 %.“"
                            },
                            {
                                "example_id": "0602e418-6bdb-41fc-ac67-400a86530e51",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "„Bei weiter andauernder Trockenheit kann es stellenweise zu Verzögerungen beim Auflaufen der ausgesäten Sommerkulturen und zu Trockenstress bei den jungen Pflänzchen kommen.“"
                            },
                            {
                                "example_id": "9959a70b-09ba-4784-9755-04439f8256c7",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "„Im Pflanzenbau wird zur Vermeidung von ⁠Trockenstress⁠ primär die Strategie der Bewässerung der Felder verfolgt.“"
                            },
                            {
                                "example_id": "093b004d-ea7e-49e4-bae8-cb6eb67c4e1a",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "[Landwirtschaft:] „Auch durch Sorten und Kulturarten, die besser mit ⁠Trockenstress⁠ zurechtkommen, können Ertragsausfälle reduziert werden.“"
                            },
                            {
                                "example_id": "542581cf-f377-49ff-8d3f-8e9d607f84cd",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "„Auch wenn die Böden noch feucht sind, sorgt Landwirt Conrad Hogrefe schon vor. Er möchte seine Heidelbeerbüsche vor Trockenstress bewahren. Deshalb hat Heidelbeer-Landwirt Conrad Hogrefe aus Eickeloh (Heidekreis) in den vergangenen Tagen die Beregnungsanlage vorbereitet.“"
                            },
                            {
                                "example_id": "8d0cace5-ae47-45f3-9f64-da13374a9aea",
                                "sense_id": "fa154474-c451-35d7-b5dc-cdea03edfb1c",
                                "text": "„Wassermangel schwächt den Hopfen und macht ihn anfälliger für Schädlingsbefall. Diesem Trockenstress sind die Pflanzen nicht gewachsen und leiden daher besonders unter dem Klimawandel mit seinen steigenden Temperaturen und vermehrten Sonnenstunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
