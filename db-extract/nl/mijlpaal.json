                "senses": [
                    {
                        "sense_id": "ebe5cb26-bafd-336b-a869-35ec87cd36c3",
                        "entry_id": "50ccebf9-70ea-3088-bb32-18922365e64b",
                        "glosses": [
                            "een paal die op elke mijl staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0efe2d02-8d7b-4b13-ad49-e30386e0301f",
                                "sense_id": "ebe5cb26-bafd-336b-a869-35ec87cd36c3",
                                "text": "Wij zijn vele mijlpalen gepasseerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "830af660-a6d7-3410-9a1b-336a9f161deb",
                        "entry_id": "50ccebf9-70ea-3088-bb32-18922365e64b",
                        "glosses": [
                            "een belangrijke gebeurtenis waarmee iets wordt afgesloten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70f63071-319b-4de9-bb8f-96f11adb680e",
                                "sense_id": "830af660-a6d7-3410-9a1b-336a9f161deb",
                                "text": "Dat is weer een mijlpaal in de geschiedenis van WikiWoordenboek!"
                            },
                            {
                                "example_id": "7b1e7d2a-a6d0-4d5d-80d3-a5e91c616ba7",
                                "sense_id": "830af660-a6d7-3410-9a1b-336a9f161deb",
                                "text": "Meer dan een vage schets is het niet, maar het beeld dat astronomen vanmiddag vrijgaven op zes simultane persconferenties over de hele wereld vormt een grote mijlpaal in de astronomie."
                            },
                            {
                                "example_id": "11dfa4a4-8bec-46f8-8700-dacba63f70ac",
                                "sense_id": "830af660-a6d7-3410-9a1b-336a9f161deb",
                                "text": "'Duurzame mijlpaal': De rechter oordeelt dat de gemeente bevoegd is om zo'n verbod op te leggen en vindt de argumenten van Den Haag voldoende onderbouwd. Dat de bijdrage van het verbod op landelijk en wereldwijd niveau \"gering is\", doet daar niet aan af, aldus de rechter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59984473-e5da-43fe-ae66-e1d73722ef1d",
                        "source_entry_id": "50ccebf9-70ea-3088-bb32-18922365e64b",
                        "source_sense_id": "ebe5cb26-bafd-336b-a869-35ec87cd36c3",
                        "source_sense_description": "een paal die op elke mijl staat",
                        "target_lang_word": "Meilenstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meilenstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5f3ffd2-dc25-3ecc-b690-bf98c9be04dc",
                                        "entry_id": "1fbb2aec-865e-313b-b8ab-0ff19b76276b",
                                        "glosses": [
                                            "ein behauener, säulenförmiger Stein, der Meilenangaben oder andere Entfernungsangaben trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138ec306-859b-48b4-8061-722ae231e783",
                                                "sense_id": "a5f3ffd2-dc25-3ecc-b690-bf98c9be04dc",
                                                "text": "An dieser Kreuzung steht noch ein alter Meilenstein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cb42b23-3def-30f5-a74b-312ea48e321f",
                                        "entry_id": "1fbb2aec-865e-313b-b8ab-0ff19b76276b",
                                        "glosses": [
                                            "eine bestimmte, feststehende oder durch einen runden Wert gekennzeichnete, oft auch symbolisch zu verstehende Marke auf einer Wegstrecke; ein festgelegtes Etappenziel, Teilziel einer Wegstrecke; ein besonders wichtiges Ereignis"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d68e9c5-217c-47c6-9c60-8bd8026bdc6d",
                                                "sense_id": "5cb42b23-3def-30f5-a74b-312ea48e321f",
                                                "text": "Diesen Meilenstein haben wir locker geschafft."
                                            },
                                            {
                                                "example_id": "7bcf9f1d-d16e-4f01-bc8a-12c8a1b4652b",
                                                "sense_id": "5cb42b23-3def-30f5-a74b-312ea48e321f",
                                                "text": "„Die Erklärung der Menschen- und Bürgerrechte wurde im Jahr 2003 zum Weltdokumentenerbe erklärt und gilt als Meilenstein in der Geschichte der Grund- und Menschenrechte.“"
                                            },
                                            {
                                                "example_id": "3c3e00e2-33bb-4166-876f-158d9bde3b3a",
                                                "sense_id": "5cb42b23-3def-30f5-a74b-312ea48e321f",
                                                "text": "„Zum einen ist der wissenschaftliche Werdegang dieses Physikers darzustellen, der Verlauf des Weges mit allen seinen Biegungen, seinen Steigungen, dem Gefälle, den Meilensteinen und den Hindernissen.“"
                                            },
                                            {
                                                "example_id": "d1671466-c34f-4ffb-9d51-8624acddc5a3",
                                                "sense_id": "5cb42b23-3def-30f5-a74b-312ea48e321f",
                                                "text": "„Seine Aufnahme von Schuberts posthumer B-Dur-Sonate ist ein Meilenstein der Interpretationsgeschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "871c4848-a6cf-42ea-bd30-85c2c11959a4",
                        "source_entry_id": "50ccebf9-70ea-3088-bb32-18922365e64b",
                        "source_sense_id": "ebe5cb26-bafd-336b-a869-35ec87cd36c3",
