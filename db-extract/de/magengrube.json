                        "form": "die Magengrube"
                    },
                    {
                        "form_id": "45e356f5-5ba2-4861-a66e-72491b7d77bf",
                        "entry_id": "6e624f7f-337f-30c7-b240-25174ce82c3e",
                        "tags": [
                            "accusative",
