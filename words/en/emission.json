{
    "word_family": [
        "emit",
        "emitter",
        "emissive",
        "emissivity"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "246f9b4f-11d1-3c28-8676-de8d0a1db3ac",
                    "sense_definition": "The process or act of sending out or releasing something such as gas, heat, or light.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>emission</w> of light from the sun provides energy for all life on Earth.",
                            "target_lang_translations": {
                                "ru": "<w>Излучение</w> света от Солнца обеспечивает энергией всю жизнь на Земле."
                            }
                        },
                        {
                            "text": "New laws were passed to control the <w>emission</w> of smoke from local factories.",
                            "target_lang_translations": {
                                "ru": "Были приняты новые законы для контроля <w>выбросов</w> дыма местными заводами."
                            }
                        }
                    ],
                    "synonyms": [
                        "issuance"
                    ],
                    "antonyms": [
                        "absorption"
                    ],
                    "common_phrases": [
                        "emission of light",
                        "emission of heat",
                        "carbon emission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или акт испускания или выделения чего-либо, например газа, тепла или света."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "излучение",
                                "target_lang_sense_clarification": "света, тепла или частиц"
                            },
                            {
                                "target_lang_word": "выброс",
                                "target_lang_sense_clarification": "газов или загрязняющих веществ"
                            },
                            {
                                "target_lang_word": "эмиссия",
                                "target_lang_sense_clarification": "физический процесс испускания"
                            },
                            {
                                "target_lang_word": "испускание",
                                "target_lang_sense_clarification": "лучей или энергии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ccf36f7-c8a9-3cfc-9c47-5915076a3bb3",
                    "sense_definition": "A substance or thing that has been discharged or sent out into the environment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists measured the toxic <w>emission</w> coming from the exhaust pipe.",
                            "target_lang_translations": {
                                "ru": "Ученые измерили токсичные <w>выбросы</w>, выходящие из выхлопной трубы."
                            }
                        },
                        {
                            "text": "Reducing every harmful <w>emission</w> is a primary goal for the environmental agency.",
                            "target_lang_translations": {
                                "ru": "Сокращение любых вредных <w>выбросов</w> является основной целью агентства по охране окружающей среды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "toxic emission",
                        "gas emission",
                        "harmful emission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или объект, который был выброшен или направлен в окружающую среду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выброс",
                                "target_lang_sense_clarification": "загрязняющее вещество в атмосфере"
                            },
                            {
                                "target_lang_word": "эмиссия",
                                "target_lang_sense_clarification": "часто во мн. числе: вредные выделения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7becf20-268d-322c-849e-e4d0d78cad69",
                    "sense_definition": "A television or radio broadcast or program.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio <w>emission</w> was interrupted by a sudden technical failure.",
                            "target_lang_translations": {
                                "ru": "Радио<w>передача</w> была прервана внезапным техническим сбоем."
                            }
                        },
                        {
                            "text": "They were interviewed for a special <w>emission</w> about subcultures in the city.",
                            "target_lang_translations": {
                                "ru": "У них взяли интервью для специального <w>выпуска</w> о субкультурах города."
                            }
                        }
                    ],
                    "synonyms": [
                        "issuance"
                    ],
                    "common_phrases": [
                        "radio emission",
                        "television emission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Телевизионная или радиопередача или программа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпуск",
                                "target_lang_sense_clarification": "отдельная передача или номер программы"
                            },
                            {
                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "радио или телепрограмма"
                            },
                            {
                                "target_lang_word": "трансляция",
                                "target_lang_sense_clarification": "эфирное вещание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}