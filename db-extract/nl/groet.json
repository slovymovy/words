        "fr-extract.jsonl": [
            {
                "entry_id": "c1e51c31-72ba-341f-8f35-9b88474b3997",
                "word": "groet",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "c3a8de6f-dae8-415c-aaec-a15f7063f0a5",
                        "entry_id": "c1e51c31-72ba-341f-8f35-9b88474b3997",
                        "tags": [
                            "plural"
                        ],
                        "form": "groeten"
                    },
                    {
                        "form_id": "4c354e41-4499-4a55-9cfc-89fb905190a7",
                        "entry_id": "c1e51c31-72ba-341f-8f35-9b88474b3997",
                        "tags": [
                            "singular",
                            "diminutive"
                        ],
                        "form": "groetje"
                    },
                    {
                        "form_id": "867b9cc3-7992-4983-b6d8-f53ba0ff8c8a",
                        "entry_id": "c1e51c31-72ba-341f-8f35-9b88474b3997",
                        "tags": [
                            "plural",
                            "diminutive"
                        ],
                        "form": "groetjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                        "entry_id": "c1e51c31-72ba-341f-8f35-9b88474b3997",
                        "glosses": [
                            "Salut, salutation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b24cfd-eaef-46ec-9c98-8f9edbd5db2e",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Doet u de beleefde groeten aan uw vrouw.",
                                "translation": "Transmettez mes hommages à madame."
                            },
                            {
                                "example_id": "cd08df0f-cf81-407d-acb7-af4e2a9dde06",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Doe de groeten aan je vrouw.",
                                "translation": "Bien le bonjour à ta femme."
                            },
                            {
                                "example_id": "3de9b5cb-93e3-4de0-8eba-35fc3aa68ee3",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Doe hem, haar de groeten.",
                                "translation": "Dites-lui bien des choses de ma part, faites-lui mes amitiés."
                            },
                            {
                                "example_id": "8d5319e9-efe9-430e-b655-27e1c0ffc064",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "De groeten doen.",
                                "translation": "Passer le bonjour (à quelqu’un), faire le bonjour de quelqu’un à quelqu’un."
                            },
                            {
                                "example_id": "8d8569ff-bdaa-4422-ab2f-6fd4a4aa2488",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Met beleefde groeten.",
                                "translation": "Recevez mes salutations distinguées."
                            },
                            {
                                "example_id": "369523e9-d091-46e3-b789-94a4081d3b64",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Met de groeten van.",
                                "translation": "Avec les compliments de."
                            },
                            {
                                "example_id": "aad0d005-8493-4f19-9c62-c811a9925eb2",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "U hebt de groeten van X.",
                                "translation": "Vous avez les amitiés de X."
                            },
                            {
                                "example_id": "c0ef9215-6b51-4e7e-959f-ef0fae2eaaf7",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Met vriendelijke groet.",
                                "translation": "Je vous prie de croire, Monsieur, à l’expression de mes sentiments dévoués."
                            },
                            {
                                "example_id": "335aac6a-314c-4f6f-b066-cfb3a47e2808",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Vriendelijke groeten.",
                                "translation": "Sincères salutations, salutations, bien à vous."
                            },
                            {
                                "example_id": "1ece77cc-99fa-400a-80e3-ba184521876e",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Met hartelijke groeten.",
                                "translation": "Croyez à mes sentiments cordiaux, cordialement."
                            },
                            {
                                "example_id": "ba918cbc-4a23-44fd-8e4c-7ebe28d608cd",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Groetjes.",
                                "translation": "Amitiés."
                            },
                            {
                                "example_id": "8167653f-2ad7-428e-800e-2344a17dd146",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Je krijgt de groeten!",
                                "translation": "T’as le bonjour d’Alfred !"
                            },
                            {
                                "example_id": "8f666275-d64a-4465-80d7-172b9fa179cf",
                                "sense_id": "3ea77abf-d799-321e-aabe-30d80c5cc737",
                                "text": "Iemand een laatste groet brengen.",
                                "translation": "Rendre un dernier hommage à quelqu’un."
                            }
                        ]
                    }
                ],
