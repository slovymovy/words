                        "examples": [
                            {
                                "example_id": "935a990a-8c74-4e0d-9849-80ac4848df81",
                                "sense_id": "d94a38b1-1f5d-3598-b0df-21de9773c466",
                                "text": "Het is weer de eenentwintig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "ce0e4f76-d56e-4d6d-a612-ef69ac1e3611",
                                "sense_id": "d94a38b1-1f5d-3598-b0df-21de9773c466",
                                "text": "Haar tweeëntwintigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de eenentwintig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ba1cedb-a94e-324c-b3a7-697b422aca20",
                        "entry_id": "73793c40-ddc3-3b74-8230-f95ea783679b",
                        "glosses": [
                            "groep van 21 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2695d9d-d7c1-4197-b9cd-6258f834bea8",
                                "sense_id": "5ba1cedb-a94e-324c-b3a7-697b422aca20",
                                "text": "De eenentwintig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
