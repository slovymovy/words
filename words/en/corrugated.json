    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4a07dd25-7203-3527-9b9d-b5c7de350adf",
                    "sense_definition": "Shaped into alternating parallel ridges and grooves, typically to increase strength or rigidity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "corrugated_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workshop was built with a roof made of <w>corrugated</w> iron.",
                            "target_lang_translations": {
                                "nl": "De werkplaats was gebouwd met een dak van <w>golfplaat</w>."
                            }
                        },
                        {
                            "text": "Fragile items should always be packed inside strong <w>corrugated</w> cardboard boxes.",
                            "target_lang_translations": {
                                "nl": "Breekbare voorwerpen moeten altijd worden verpakt in stevige dozen van <w>golfkarton</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grooved",
                        "ridged",
                        "fluted"
                    ],
                    "antonyms": [
                        "flat",
                        "smooth"
                    ],
                    "common_phrases": [
                        "corrugated cardboard",
                        "corrugated iron",
                        "corrugated metal",
                        "corrugated roof"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gevormd in afwisselende evenwijdige ribbels en groeven, meestal om de stevigheid of stijfheid te vergroten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gegolfd",
                                "target_lang_sense_clarification": "met golfvormige ribbels, zoals golfplaat of golfkarton"
                            },
                            {
                                "target_lang_word": "geplooid",
                                "target_lang_sense_clarification": "gevouwen in evenwijdige plooien of rimpels"
                            },
                            {
                                "target_lang_word": "geribbeld",
                                "target_lang_sense_clarification": "voorzien van ribbels of groeven"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0fb107a-f20f-3597-a099-b397c213c018",
                    "sense_definition": "simple past and past participle of <w>corrugate</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "corrugated_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat <w>corrugated</w> the thin plastic panels along the fence.",
                            "target_lang_translations": {
                                "nl": "De intense hitte <w>vervormde</w> de dunne plastic panelen langs het hek tot golven."
                            }
                        },
                        {
                            "text": "Deep worries had visibly <w>corrugated</w> his brow over the passing months.",
                            "target_lang_translations": {
                                "nl": "Diepe zorgen hadden in de loop der maanden zijn voorhoofd zichtbaar <w>doen rimpelen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "verleden tijd en voltooid deelwoord van 'corrugate' (golven, plooien of rimpelen)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "golfde",
                                "target_lang_sense_clarification": "deed golven, vormde ribbels (verleden tijd)"
                            },
                            {
                                "target_lang_word": "rimpelde",
                                "target_lang_sense_clarification": "plooide, rimpelde (bijv. van een voorhoofd; verleden tijd)"
                            },
                            {
                                "target_lang_word": "gegolfd",
                                "target_lang_sense_clarification": "in golven gelegd (voltooid deelwoord)"
                            },
                            {
                                "target_lang_word": "gerimpeld",
                                "target_lang_sense_clarification": "van plooien/rimpels voorzien (voltooid deelwoord)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
