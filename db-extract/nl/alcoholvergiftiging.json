                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff85e59c-0e70-4c0c-800d-933445867516",
                                "sense_id": "38da7598-f581-3570-be17-4da9cd5d45f0",
                                "text": "Geholpen had het voor geen pest, want rond sluitingstijd waren de borrels alsnog in hun kelen verdwenen, en het scheelde niet veel of de twee hadden een alcoholvergiftiging opgelopen."
                            },
                            {
                                "example_id": "9550a55a-de47-45bc-b04f-7901204826d9",
                                "sense_id": "38da7598-f581-3570-be17-4da9cd5d45f0",
                                "text": "De lockdowns in de coronacrisis hebben ertoe geleid dat er fors minder kinderen in het ziekenhuis werden opgenomen met een alcoholvergiftiging. Tijdens de eerste lockdown, van 16 maart tot 31 mei 2020, was de daling 70 procent."
                            }
                        ]
