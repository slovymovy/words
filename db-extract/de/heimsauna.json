                            {
                                "example_id": "a134d324-a6f7-42af-93b5-52cabfa22af4",
                                "sense_id": "ead16e91-3a3a-3a7e-a2dc-8d46e8a78829",
                                "text": "„Die Mehrzahl der Norm-Saunakabinen sind private Heimsaunas, aber auch mittlere und größere Saunakabinen werden von einzelnen Herstellerfirmen als Norm-Saunakabinen in unterschiedlicher Größe angeboten.“"
                            },
                            {
                                "example_id": "af865da4-eb53-4d54-8323-d47a2dbc6db3",
                                "sense_id": "ead16e91-3a3a-3a7e-a2dc-8d46e8a78829",
                                "text": "„Genügend Platz vorausgesetzt, ist vielleicht eine eigene Wellness-Oase im Keller die Lösung - inklusive Heimsauna.“"
                            }
                        ],
