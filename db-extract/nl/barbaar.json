                "senses": [
                    {
                        "sense_id": "9ecece69-389e-3b75-954a-2c435cebd5b1",
                        "entry_id": "e31e9bf3-12c0-3be9-8730-6669fd453039",
                        "glosses": [
                            "een persoon zonder besef van waarden, smaak en/of gevoel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11dbe07-0a8b-48f6-be90-9f490eb3e287",
                                "sense_id": "9ecece69-389e-3b75-954a-2c435cebd5b1",
                                "text": "Wat ben je toch een barbaar!"
                            }
                        ]
                    },
                    {
                        "sense_id": "dc2667e0-7135-3417-adbf-d75d324bf3db",
                        "entry_id": "e31e9bf3-12c0-3be9-8730-6669fd453039",
                        "glosses": [
                            "een persoon die wreed van aard is, een wreedaard"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1df30b1c-b123-4ba4-911c-cbe4f032d480",
                                "sense_id": "dc2667e0-7135-3417-adbf-d75d324bf3db",
                                "text": "Pas op voor die barbaar daar!"
                            },
                            {
                                "example_id": "b053acd9-f708-4fcf-8ed4-50a3a8b7ee1f",
                                "sense_id": "dc2667e0-7135-3417-adbf-d75d324bf3db",
                                "text": "Rondom Albert hield iedereen even de adem in. Toen barstte het geschreeuw los. De smeerlappen. Die moffen zijn nog geen steek veranderd, wat een smerig tuig! Barbaren, enz. En dan ook nog een jonge en een oude man!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9772903-69d7-40f7-a33d-da0b939ff1c9",
                        "source_entry_id": "e31e9bf3-12c0-3be9-8730-6669fd453039",
                        "target_lang_word": "barbarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4be9a6fd-8119-3f6c-a0e5-e3a8b964c9bc",
                                        "entry_id": "1e739393-1c5b-3c6d-94a9-9305898cf3cc",
                                        "glosses": [
                                            "Relating to people, countries, or customs perceived as uncivilized or inferior."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "barbarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65d8c6cd-3aa8-3859-966e-5cec4a31d220",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "A non-Greek or a non-Roman citizen."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d374fc71-a7b9-322b-b3f2-6eb7eec0cfb2",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "An uncivilized or uncultured person, originally compared to the hellenistic Greco-Roman civilisation; usually associated with senseless violence and self-harm or other such shows of brute force and lack of mental faculty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed3bdc45-bb40-3e5e-907a-bf5bb1e23a3a",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "A person destitute of culture; a Philistine."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30e89d1c-c73c-4fe2-9ca3-0681495b7e6d",
                                                "sense_id": "ed3bdc45-bb40-3e5e-907a-bf5bb1e23a3a",
                                                "text": "Shall a noble writer, and an inspired noble writer, be called a solecist, and barbarian, for giving a new turn to a word so agreeable to the analogy and genius of the Greek tongue?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a36099-0ffa-3c90-a601-7d41fd223a5d",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "Someone from a developing country or backward culture."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "863ebaba-ed75-3369-a619-d023a259868c",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "A brutish warrior depicted in sword and sorcery and other fantasy works; typically clad in primitive furs or leather and usually favoring physical strength over intelligence while often possessing a bellicose temperament and disdain for laws."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "daf59d54-f6d4-36b7-b1fb-7bc075809da2",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "A cruel, savage, inhumane, brutal, violently aggressive person, particularly one who is unintelligent or dim-witted; one without pity or empathy."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31cd202a-91ab-47c8-80d1-519b15d30eab",
                                                "sense_id": "daf59d54-f6d4-36b7-b1fb-7bc075809da2",
                                                "text": "Thou fell barbarian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa0eb76c-5eb5-3e26-b29d-2e20a93cdc66",
                                        "entry_id": "51e56534-bd12-3ae9-885f-a2b19b6eff2a",
                                        "glosses": [
                                            "A foreigner, especially with barbaric qualities as in the above definitions."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "903f2eaa-d467-42f7-a5cd-aec6df92aa45",
                        "source_entry_id": "e31e9bf3-12c0-3be9-8730-6669fd453039",
                        "target_lang_word": "barbare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "372ca5ab-60d3-3830-87f1-fed8cf81f920",
                                        "entry_id": "235b81e8-5f01-3dad-a968-b825e1be9da9",
                                        "glosses": [
                                            "Qualifie les peuples non gréco-romains."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a46cc9e-4660-458b-98b6-6470bd7d5759",
                                                "sense_id": "372ca5ab-60d3-3830-87f1-fed8cf81f920",
                                                "text": "Au Vᵉ siècle, l’empire romain, miné par les luttes intestines, tombe en déliquescence. Des invasions de peuples barbares désolent et bouleversent aussi bien Rome que les Gaules."
                                            },
                                            {
                                                "example_id": "96878aff-b2c5-441f-bc1d-c7b0e36ac41f",
                                                "sense_id": "372ca5ab-60d3-3830-87f1-fed8cf81f920",
                                                "text": "L’empire romain, centralisé, indiscuté et unique a ébaudi les barbares par une architecture colossale de pierre, donc incorruptible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8e33047-4ffe-3409-adbb-0f75b007d5fc",
                                        "entry_id": "235b81e8-5f01-3dad-a968-b825e1be9da9",
                                        "glosses": [
                                            "Qualifie le peuple berbère, issu de la Côte barbaresque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99f138f6-a8c9-3273-866b-8b5185140df3",
                                        "entry_id": "235b81e8-5f01-3dad-a968-b825e1be9da9",
                                        "glosses": [
                                            "Qui est très violent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf2533b-2af7-45b2-9e88-ff18f914dee5",
                                                "sense_id": "99f138f6-a8c9-3273-866b-8b5185140df3",
                                                "text": "Le gros des troupes était une horde de barbares dans toute la force du terme. C’était de ces figures étranges qui avaient parcouru la Gaule au temps d’Attila et de Chlodowig."
                                            },
                                            {
                                                "example_id": "22494d2c-09c1-48cd-baf7-7c2dc0b3414d",
                                                "sense_id": "99f138f6-a8c9-3273-866b-8b5185140df3",
                                                "text": "Il n’y a point de sentiment plus inséparable de notre être que celui de la liberté ; depuis l’homme le plus policé jusqu’au plus barbare, tous en sont pénétrés."
                                            },
                                            {
                                                "example_id": "93723b8e-151a-41e7-aef0-ed610a7ba856",
                                                "sense_id": "99f138f6-a8c9-3273-866b-8b5185140df3",
                                                "text": "Être prudemment barbare et exercer la tyrannie conséquemment signifie, selon ce politique abominable, exécuter tout d’un coup toutes les violences et tous les crimes que l’on juge utiles à ses intérêts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e085ac7-7ae1-30d2-b179-2a68432484f5",
                                        "entry_id": "235b81e8-5f01-3dad-a968-b825e1be9da9",
                                        "glosses": [
                                            "Se dit des mots et des tours du langage contraires à l’usage ou à l’analogie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "418be86b-baa2-4d31-81d5-16d026a079ce",
                                                "sense_id": "9e085ac7-7ae1-30d2-b179-2a68432484f5",
                                                "text": "En latin si l’on disait, dator pecuniam pour signifier celui qui donne ou qui donnera de l’argent, certainement ce serait une tournure barbare et inintelligible."
                                            },
                                            {
                                                "example_id": "120646c5-b827-489c-acf6-9fa1baaf62ea",
                                                "sense_id": "9e085ac7-7ae1-30d2-b179-2a68432484f5",
                                                "text": "Ajoutons que la prononciation du grec est au moins aussi incertaine que celle du latin : la prononciation érasmienne est barbare et n’a aucune valeur historique ; et la prononciation moderne est insupportable avec son iotacisme et les équivoques sans nombre qu’il produit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4913a429-7e9a-3dc1-80df-cdb737cea9bd",
                                        "entry_id": "235b81e8-5f01-3dad-a968-b825e1be9da9",
                                        "glosses": [
                                            "Qui est cruel, inhumain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f58ac20f-899c-4833-a43f-83b808562c23",
                                                "sense_id": "4913a429-7e9a-3dc1-80df-cdb737cea9bd",
                                                "text": "Un vainqueur qui fait mourir ses ennemis captifs est appelé barbare !"
                                            },
                                            {
                                                "example_id": "41b06d02-7380-4981-a201-128676438dca",
                                                "sense_id": "4913a429-7e9a-3dc1-80df-cdb737cea9bd",
                                                "text": "L’anarchie marocaine, l’application de lois semi-barbares, la corruption du chérif étaient autant d’arguments pouvant justifier une intervention de l’extérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b5d4cab-0653-35e9-b8ba-78e55130a296",
                                        "entry_id": "235b81e8-5f01-3dad-a968-b825e1be9da9",
                                        "glosses": [
                                            "Qui manque d’harmonie, de style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d774f1e-b774-446a-a5ca-6e70c872051b",
                                                "sense_id": "4b5d4cab-0653-35e9-b8ba-78e55130a296",
                                                "text": "Un style barbare."
                                            },
                                            {
                                                "example_id": "6a966bb4-68e5-4330-8a84-62620b8f7f7b",
                                                "sense_id": "4b5d4cab-0653-35e9-b8ba-78e55130a296",
                                                "text": "Une musique barbare."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "barbare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ad87b42-d060-3ce5-9643-81c199d1c941",
                                        "entry_id": "819632d7-8f09-3b14-8be8-18eb08dd8aac",
                                        "glosses": [
                                            "Individu n’appartenant pas à la civilisation grecque, puis, après l’essor de l’empire romain, à la sphère culturelle gréco-romaine."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68ec308b-81f3-4525-a149-72aa49673708",
                                                "sense_id": "7ad87b42-d060-3ce5-9643-81c199d1c941",
                                                "text": "Pour commencer donc à entrer en matière, quant à la signification de ce mot : Barbares anciennement étaient nommés ceux qui ineptement parlaient grec. Car comme les étrangers venant à Athènes s’efforçaient de parler grec, ils tombaient souvent en cette voix absurde. Depuis, les Grecs transportèrent ce nom aux mœurs brutaux et cruels, appelant toutes nations, hors la Grèce, barbares."
                                            },
                                            {
                                                "example_id": "5540e755-f336-4caf-86c5-9c131e9d078d",
                                                "sense_id": "7ad87b42-d060-3ce5-9643-81c199d1c941",
                                                "text": "Le mépris si profond que le Grec avait pour le Barbare, le Yankee l’a pour le travailleur étranger qui ne fait point d’effort pour devenir vraiment américain."
                                            },
                                            {
                                                "example_id": "98e8b999-0c87-49b1-b307-3d798ebc44ea",
                                                "sense_id": "7ad87b42-d060-3ce5-9643-81c199d1c941",
                                                "text": "Pour les Grecs, donc, les gens qui parlaient mal étaient Barbaros, les Barbares, la lie de l’humanité, un « sous-prolétariat » quoi, comme disent les sociologues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53605c01-4dda-3e61-b545-40ca0a656d22",
                                        "entry_id": "819632d7-8f09-3b14-8be8-18eb08dd8aac",
                                        "glosses": [
                                            "Individu appartenant aux peuples germaniques qui envahirent l’Empire romain et tout envahisseur en général, lors des grandes migrations entre les IVᵉ et VIIᵉ siècles."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f3bde9e-91e8-476c-b7ee-2bc5673a7981",
                                                "sense_id": "53605c01-4dda-3e61-b545-40ca0a656d22",
                                                "text": "Les Barbares ne créèrent point de sociétés progressives ; ils étaient peu nom­breux et presque partout ils se substituèrent simplement aux anciens grands seigneurs, […]."
                                            },
                                            {
                                                "example_id": "d4653e6e-7015-4447-bcab-108a1c619ea2",
                                                "sense_id": "53605c01-4dda-3e61-b545-40ca0a656d22",
                                                "text": "A l’orgie latine succédèrent les ébats des Barbares, dignes héritiers de ces Romains gorgés de falerne et de sang, épuisés de stupre, sombrés dans les velléités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2edb812b-f725-3b26-b98a-9c5058f29a1f",
                                        "entry_id": "819632d7-8f09-3b14-8be8-18eb08dd8aac",
                                        "glosses": [
                                            "Individu ou groupe social considéré comme cruel, inhumain, violent."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56636bda-b3a8-43c7-9f82-f45242e747ba",
                                                "sense_id": "2edb812b-f725-3b26-b98a-9c5058f29a1f",
                                                "text": "Seulement les barbares dont nous parlons sont au milieu de nous ; nous pouvons les coudoyer en nous aventurant dans les repaires où ils vivent, où ils se rassemblent pour concerter le meurtre, le vol, pour se partager enfin les dépouilles de leurs victimes."
                                            },
                                            {
                                                "example_id": "2edf6eae-68fd-4fae-aa80-c73ea148f3a5",
                                                "sense_id": "2edb812b-f725-3b26-b98a-9c5058f29a1f",
                                                "text": "Souvent, au milieu de l'infinie variété qui naît du croisement des races, on voit paraître un échantillon pur du type primitif ; un barbare de l'an 500."
                                            },
                                            {
                                                "example_id": "39b8bffc-82f7-406e-b6e0-adb2a0b52f93",
                                                "sense_id": "2edb812b-f725-3b26-b98a-9c5058f29a1f",
                                                "text": "Les barbares ne sont pas nécessairement des gens courageux : ce qui leur donne de l’audace est la passivité tremblante et soumise de ceux qui sont en face d’eux.\nJe dirais même que la passivité tremblante et soumise crée des vocations de barbares et constitue une incitation à la barbarie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5db4aca6-3d65-3499-8432-377151589710",
                                        "entry_id": "819632d7-8f09-3b14-8be8-18eb08dd8aac",
                                        "glosses": [
                                            "Homme non éduqué, trop rustre pour apprécier les beautés de la nature ou de l’art."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
