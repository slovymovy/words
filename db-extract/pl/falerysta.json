                        "glosses": [
                            "historyk badający ordery i odznaczenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18bfad3c-05c6-40f1-8e0b-b448fb999353",
                                "sense_id": "5eaad9d3-36da-364f-be29-5f8e82cf9745",
                                "text": "Na kilku stoiskach rozłożyli się też faleryści, czyli zbieracze medali, odznaczeń i orderów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f426a74a-6d8d-341b-982f-a96d397e2d49",
                        "entry_id": "e2ec78ea-1300-3034-8210-c2a8a71ae8a1",
                        "glosses": [
                            "kolekcjoner orderów i odznaczeń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab95b62-a89c-40d8-a3e6-2e6429c421bd",
                                "sense_id": "f426a74a-6d8d-341b-982f-a96d397e2d49",
                                "text": "Największą popularnością wśród falerystów cieszą się odznaki wojskowe, niemniej mieszkańców naszego regionu powinna zainteresować falerystyka górnicza"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
