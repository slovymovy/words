                        "glosses": [
                            "Nourrir moins que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b37d4b93-c2a2-4968-acbe-2596c6d6b510",
                                "sense_id": "c9bb8ba5-b13c-3b79-af54-5f99ea4ce353",
                                "text": "Il est plus néfaste de sur-nourrir les larves que de les sous-nourrir, car la quantité de matière fécale et de métabolites qui vont s'accumuler dans l'eau de la culture peuvent entraîner une augmentation de la prolifération bactérienne."
                            },
                            {
                                "example_id": "adbbe405-0436-47ee-a930-84d5bf152471",
                                "sense_id": "c9bb8ba5-b13c-3b79-af54-5f99ea4ce353",
                                "text": "Il vaut mieux sous-nourrir que sur-nourrir."
                            }
                        ]
                    }
