                    {
                        "translation_id": "e0137b09-9d66-4908-94a9-aeb9fdff678f",
                        "source_entry_id": "5ddaa387-384b-37d3-a3cf-813656ddd7fb",
                        "source_sense_id": "5660cff8-5fa2-3a3e-9cfb-5f9fc2ec36ca",
                        "source_sense_description": "het geheel van bladeren van een of meer bomen",
                        "target_lang_word": "feuillage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuillage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1af3c6fe-906a-3322-959c-c20f3180aefc",
                                        "entry_id": "56c1cd29-6691-31ee-a7b1-231f0218f2f7",
                                        "glosses": [
                                            "L’ensemble des feuilles d’un ou de plusieurs arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47e74fca-13f8-431d-b096-46ed8bf3c8e2",
                                                "sense_id": "1af3c6fe-906a-3322-959c-c20f3180aefc",
                                                "text": "L’ombre mouvante des mousselines était aussi vaporeuse que leur feuillage."
                                            },
                                            {
                                                "example_id": "0e4d3d84-4841-4bff-a708-e9158b53d32e",
                                                "sense_id": "1af3c6fe-906a-3322-959c-c20f3180aefc",
                                                "text": "On traverse fréquemment des régions incendiées où les fûts carbonisés portent encore, comme de grosses houppes de tabac, leur ancien feuillage."
                                            },
                                            {
                                                "example_id": "73d46e4b-3035-4e9a-99ca-c25f8335e012",
                                                "sense_id": "1af3c6fe-906a-3322-959c-c20f3180aefc",
                                                "text": "La saison fonçait les feuillages, touchait d'or les près, carminait çà et là une branche."
                                            },
                                            {
                                                "example_id": "6a92763f-09ca-4153-a49d-9f82b6a29b15",
                                                "sense_id": "1af3c6fe-906a-3322-959c-c20f3180aefc",
                                                "text": "Les filaos géants, à l’écorce rugueuse et noire, étaient très nombreux et s’élevaient vers la voûte de feuillage comme des piliers de cathédrale."
                                            },
                                            {
                                                "example_id": "309bbbb8-6da0-408b-bd51-582ca1f2c81a",
                                                "sense_id": "1af3c6fe-906a-3322-959c-c20f3180aefc",
                                                "text": "Les feuilles les plus extérieures changent en premier, comme des lèvres teintées de rouge autour d’un centre sombre. Puis le feuillage interne se pigmente, lui aussi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15af012b-4094-3f13-b2e6-eaaa6fc527fd",
                                        "entry_id": "56c1cd29-6691-31ee-a7b1-231f0218f2f7",
                                        "glosses": [
                                            "Branches d’arbres couvertes de feuilles, ou amas de feuilles vertes détachées de l’arbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8eae89c-f5b4-4467-a1de-ca38bcdd315c",
                                                "sense_id": "15af012b-4094-3f13-b2e6-eaaa6fc527fd",
                                                "text": "Pourquoi construire d'inconfortables maisons en planches et en tôle ondulée quand le feuillage des cocotiers peut vous fournir des abris toujours frais?"
                                            },
                                            {
                                                "example_id": "7cf85b79-0012-45a3-8ec5-270a534eea76",
                                                "sense_id": "15af012b-4094-3f13-b2e6-eaaa6fc527fd",
                                                "text": "Béatrix trouva les sables jolis ; elle aperçut alors ces petites plantes dures à fleurs roses qui y croissent, elle en cueillit plusieurs auxquelles elle joignit l’œillet des Chartreux qui se trouve également dans ces sables arides et les partagea d’une façon significative avec Calyste, pour qui ces fleurs et ces feuillages devaient être une éternelle, une sinistre image."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b3b451e-002d-3b58-9d68-b143825d2b13",
                                        "entry_id": "56c1cd29-6691-31ee-a7b1-231f0218f2f7",
                                        "glosses": [
                                            "Représentation plus ou moins fidèles de feuillage, soit en sculpture, soit en ouvrage de tapisserie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a91f8ad4-abbd-4185-9f89-21dd74f91019",
                                                "sense_id": "9b3b451e-002d-3b58-9d68-b143825d2b13",
                                                "text": "Une bordure ornée de feuillage."
                                            },
                                            {
                                                "example_id": "4119a89f-d3a4-4675-8c12-99e3d7221306",
                                                "sense_id": "9b3b451e-002d-3b58-9d68-b143825d2b13",
                                                "text": "Damas à grands feuillages."
                                            },
                                            {
                                                "example_id": "298d5d43-6b0f-4b0d-83bc-8d63d2237144",
                                                "sense_id": "9b3b451e-002d-3b58-9d68-b143825d2b13",
                                                "text": "Un papier de tenture à feuillage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3da0e327-1753-3924-960d-27d2237bebcc",
                                        "entry_id": "56c1cd29-6691-31ee-a7b1-231f0218f2f7",
                                        "glosses": [
                                            "Travail du feuilleur dans la fabrication du charbon de bois."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb2b3510-3abd-4d39-8073-d20f915caf48",
                                                "sense_id": "3da0e327-1753-3924-960d-27d2237bebcc",
                                                "text": "Il convient donc qu’ils forment au feuillage quelques-uns des dresseurs, en qui ils reconnoissent beaucoup d’intelligence, de probité & d’attention ; puisque la plus petite négligence leur donne un travail considérable, & occasionne une consommation de bois qui se brûle infructueusement, sans produire aucun charbon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
