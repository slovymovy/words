                        ],
                        "examples": [
                            {
                                "example_id": "aacb2f3a-32d8-4a45-a885-f5d57ca5f796",
                                "sense_id": "9ad27317-910e-3a72-aa6a-7dc70010bf00",
                                "text": "On propose deux formulations contenant des mono et diglycérides, additionnés pour l'une d’alginate de sodium, de carragénate, de gomme guar et de pyrophosphate de sodium et pour l'autre de carboxyméthyl cellulose, de carragénate et de gomme guar."
                            },
                            {
                                "example_id": "fda1e5a2-dac6-49ac-ae03-07b4cb921c1e",
                                "sense_id": "9ad27317-910e-3a72-aa6a-7dc70010bf00",
                                "text": "Le but de l'étude consistait à optimaliser les propriétés sensorielles et rhéologiques des desserts lactés UHT, en recherchant les types adéquats et les quantités appropriées d’amidon et de carragénate, et en ajustant la technologie du procédé UHT direct."
                            }
                        ]
                    }
