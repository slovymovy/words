                                "target_senses": [
                                    {
                                        "sense_id": "b1911862-2bde-324f-9b31-fe0650942195",
                                        "entry_id": "336e4b84-4c10-3dbf-9e40-57ce8e930ba7",
                                        "glosses": [
                                            "Qui est propre à détruire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4690eceb-396d-44fb-bfe0-9789de139e0d",
                                                "sense_id": "b1911862-2bde-324f-9b31-fe0650942195",
                                                "text": "Cherchons donc à mieux définir à quoi fait référence le terme d’ « agresseur », dont il faut maintenir intact le sens destructif."
                                            },
                                            {
                                                "example_id": "6af1607a-2bde-465a-bae3-14475897934d",
                                                "sense_id": "b1911862-2bde-324f-9b31-fe0650942195",
                                                "text": "Cette présence était comme un serpent qui se lovait autour de moi et m’étouffait dans ses anneaux. Pourquoi avait-il ce magnétisme destructif ?."
                                            },
                                            {
                                                "example_id": "7db2b4b0-76f7-431a-a6dc-3a764aa75626",
                                                "sense_id": "b1911862-2bde-324f-9b31-fe0650942195",
                                                "text": "Germe destructif."
                                            },
                                            {
                                                "example_id": "ad96ebe0-c15f-4a41-96fc-9fdaf019ece7",
                                                "sense_id": "b1911862-2bde-324f-9b31-fe0650942195",
                                                "text": "Doctrine destructive de toute morale."
                                            }
                                        ]
