                    "sense_id": "b8de6521-0c87-36ad-adf8-2849eb39aca1",
                    "sense_definition": "Putting a lot of effort into a job and doing it with care and energy.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "diligent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager said that her team is <w>hardworking</w>, talented, and very supportive of each other.",
                            "target_lang_translations": {
                                "ru": "Менеджер сказала, что её команда <w>трудолюбивая</w>, талантливая и очень поддерживает друг друга.",
                                "zh": "经理说她的团队既<w>勤奋</w>又有才华，而且彼此之间非常支持。"
                            }
                        },
                        {
                            "text": "High rent prices put an enormous strain on the budgets of <w>hardworking</w> people.",
                            "target_lang_translations": {
                                "ru": "Высокие цены на аренду ложатся огромным бременем на бюджеты <w>работящих</w> людей.",
                                "zh": "高昂的房租给<w>勤劳</w>工作的人们的预算带来了巨大的压力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "industrious",
                        "diligent",
                        "hard-working"
                    ],
                    "antonyms": [
                        "lazy",
                        "idle",
                        "indolent"
                    ],
                    "common_phrases": [
                        "hardworking_people",
                        "hardworking_student",
                        "hardworking_employee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикладывающий много усилий к работе, выполняющий её старательно и энергично.",
                        "zh": "在工作中投入大量精力，做事认真且充满干劲。"
