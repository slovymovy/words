                ],
                "senses": [
                    {
                        "sense_id": "bbd0ec61-27c8-3969-b5e6-5f84c6789618",
                        "entry_id": "cd515ec4-e8bc-3745-8b93-c58d3680578e",
                        "glosses": [
                            "heel erg gemakkelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49285730-d325-429f-a64a-bfc9e40b6f5a",
                                "sense_id": "bbd0ec61-27c8-3969-b5e6-5f84c6789618",
                                "text": "Kortlopende opties zijn spotgoedkoop om de doodsimpele reden dat er weinig actie verwacht wordt. Bij langer lopende opties, voor bijvoorbeeld oktober of december van dit jaar, wordt meer beweging ingeprijsd. Wel zijn deze opties nog steeds schappelijk geprijsd."
                            }
                        ]
                    },
                    {
                        "sense_id": "193591a7-c95a-39d6-af82-3b53db77bb7c",
                        "entry_id": "cd515ec4-e8bc-3745-8b93-c58d3680578e",
                        "glosses": [
                            "in een heel bescheiden uitvoering, met weinig kosten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31b3041b-eb14-4a61-8085-54709066d35f",
                                "sense_id": "193591a7-c95a-39d6-af82-3b53db77bb7c",
                                "text": "Meghan krijgt opnieuw veel lof voor haar kledingkeuze. Ze draagt vandaag een grijze jas van Smythe, een Burberry broek en... een doodsimpele trui van Marks and Spencer."
                            },
                            {
                                "example_id": "c99fa861-da38-475b-82ca-8ac8e152dc09",
                                "sense_id": "193591a7-c95a-39d6-af82-3b53db77bb7c",
                                "text": "Een keer iets anders dan die doodsimpele plak cake bij de koffie? Waag je dan aan deze bijzondere variant. Deze worteltjescake is namelijk gemaakt van goud. Durven jullie de tanden er in te zetten?"
                            }
                        ]
                    }
