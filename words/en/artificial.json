{
    "word_family": [
        "artifice",
        "artificially",
        "artificiality"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2e9ae31c-b54f-3a8b-956c-e0b5bea99fa4",
                    "sense_definition": "Made by people, often as a copy of something natural; not occurring naturally.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "man_made",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>artificial</w> flowers on the table looked surprisingly realistic from a distance.",
                            "target_lang_translations": {
                                "ru": "<w>Искусственные</w> цветы на столе выглядели удивительно реалистично издалека.",
                                "zh": "桌上的<w>人造</w>花从远处看竟然显得非常逼真。"
                            }
                        },
                        {
                            "text": "Scientists are working to create <w>artificial</w> intelligence that can solve complex problems.",
                            "target_lang_translations": {
                                "ru": "Ученые работают над созданием <w>искусственного</w> интеллекта, способного решать сложные задачи.",
                                "zh": "科学家们正在致力于创造能够解决复杂问题的<w>人工</w>智能。"
                            }
                        }
                    ],
                    "synonyms": [
                        "man-made",
                        "synthetic"
                    ],
                    "antonyms": [
                        "natural"
                    ],
                    "common_phrases": [
                        "artificial intelligence",
                        "artificial light",
                        "artificial flower",
                        "artificial limb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный человеком, часто как копия чего-то природного; не встречающийся в природе.",
                        "zh": "由人工制造，通常作为自然事物的仿制品；非自然产生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иску́сственный",
                                "target_lang_sense_clarification": "сделанный человеком"
                            },
                            {
                                "target_lang_word": "ненатура́льный",
                                "target_lang_sense_clarification": "не природный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人工",
                                "target_lang_sense_clarification": "由人制造的"
                            },
                            {
                                "target_lang_word": "人造",
                                "target_lang_sense_clarification": "非天然的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28ff560d-3ef6-3e7b-939b-418ec6e3972a",
                    "sense_definition": "Not sincere; fake or forced in behavior or expression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insincere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She greeted him with an <w>artificial</w> smile that did not reach her eyes.",
                            "target_lang_translations": {
                                "ru": "Она встретила его <w>искусственной</w> улыбкой, которая не коснулась её глаз.",
                                "zh": "她用一种<w>做作</w>的微笑迎接他，那笑容根本没到眼底。"
                            }
                        },
                        {
                            "text": "His enthusiasm seemed <w>artificial</w> and calculated to impress the boss.",
                            "target_lang_translations": {
                                "ru": "Его энтузиазм казался <w>неестественным</w> и рассчитанным на то, чтобы впечатлить начальника.",
                                "zh": "他的热情显得很<w>虚假</w>，显然是为了给老板留下好印象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "factitious"
                    ],
                    "antonyms": [
                        "natural"
                    ],
                    "common_phrases": [
                        "artificial smile",
                        "artificial manner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неискренний; фальшивый или натянутый в поведении или выражении чувств.",
                        "zh": "不真诚的；在行为或表达上虚假或做作的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неесте́ственный",
                                "target_lang_sense_clarification": "о поведении"
                            },
                            {
                                "target_lang_word": "притво́рный",
                                "target_lang_sense_clarification": "неискренний"
                            },
                            {
                                "target_lang_word": "иску́сственный",
                                "target_lang_sense_clarification": "фальшивый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "做作",
                                "target_lang_sense_clarification": "行为不自然"
                            },
                            {
                                "target_lang_word": "虚假",
                                "target_lang_sense_clarification": "不真诚的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fadd9dd9-f91d-322f-8d06-f2a2fa141204",
                    "sense_definition": "Created or imposed without a natural or logical basis; arbitrary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "man_made",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company created an <w>artificial</w> shortage to increase the price of the product.",
                            "target_lang_translations": {
                                "ru": "Компания создала <w>искусственный</w> дефицит, чтобы повысить цену на продукт.",
                                "zh": "公司制造了<w>人为</w>的短缺以提高产品价格。"
                            }
                        },
                        {
                            "text": "There is often an <w>artificial</w> distinction between theory and practice in this field.",
                            "target_lang_translations": {
                                "ru": "В этой области часто существует <w>искусственное</w> различие между теорией и практикой.",
                                "zh": "在这一领域，理论与实践之间往往存在着一种<w>人为</w>的界限。"
                            }
                        }
                    ],
                    "synonyms": [
                        "factitious"
                    ],
                    "antonyms": [
                        "natural"
                    ],
                    "common_phrases": [
                        "artificial barrier",
                        "artificial distinction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Созданный или навязанный без естественного или логического основания; произвольный.",
                        "zh": "在没有自然或逻辑基础的情况下创造或强加的；武断的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иску́сственный",
                                "target_lang_sense_clarification": "созданный намеренно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人为",
                                "target_lang_sense_clarification": "非自然形成的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db5a8e3a-0a33-312e-943a-c0aa2493e2f4",
                    "sense_definition": "Based on convenient characteristics rather than natural relationships in classification.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old classification system was <w>artificial</w> and did not reflect the evolutionary history of the species.",
                            "target_lang_translations": {
                                "ru": "Старая система классификации была <w>искусственной</w> и не отражала эволюционную историю видов.",
                                "zh": "旧的分类系统是<w>人为</w>的，并未反映物种的进化史。"
                            }
                        },
                        {
                            "text": "Biologists sometimes use <w>artificial</w> keys to identify plants quickly in the field.",
                            "target_lang_translations": {
                                "ru": "Биологи иногда используют <w>искусственные</w> ключи для быстрой идентификации растений в полевых условиях.",
                                "zh": "生物学家有时会使用<w>人为</w>检索表在野外快速识别植物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conventional"
                    ],
                    "antonyms": [
                        "natural"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на удобных характеристиках, а не на естественных связях (в классификации).",
                        "zh": "在分类中基于便利的特征而非自然关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иску́сственный",
                                "target_lang_sense_clarification": "формальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人为",
                                "target_lang_sense_clarification": "非自然分类的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "816cf6c2-ed0d-3899-ab70-44023d2f1ea8",
                    "sense_definition": "Used in card games to indicate a meaning different from the cards actually held.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made an <w>artificial</w> bid to signal his partner about his strong hand.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>условную</w> заявку, чтобы дать сигнал партнеру о своей сильной руке.",
                                "zh": "他做了一个<w>约定</w>叫牌，向搭档示意他手牌很强。"
                            }
                        },
                        {
                            "text": "The opponents were confused by the <w>artificial</w> call and played the wrong card.",
                            "target_lang_translations": {
                                "ru": "Противники были сбиты с толку <w>условным</w> объявлением и сыграли не той картой.",
                                "zh": "对手被这个<w>约定</w>叫牌搞糊涂了，结果出错了牌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conventional"
                    ],
                    "antonyms": [
                        "natural"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используемый в карточных играх для обозначения значения, отличного от фактических карт на руках.",
                        "zh": "用于纸牌游戏中，表示与实际持牌不同的含义。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усло́вный",
                                "target_lang_sense_clarification": "специальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "约定",
                                "target_lang_sense_clarification": "桥牌术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}