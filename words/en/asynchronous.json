{
    "word_family": [
        "asynchrony",
        "asynchronously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "79a5545c-67de-394b-a731-7919060c371c",
                    "sense_definition": "Not occurring at the same time or rate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These forums are <w>asynchronous</w> because users do not need to be online simultaneously.",
                            "target_lang_translations": {
                                "zh": "这些论坛是<w>异步</w>的，因为用户不需要同时在线。"
                            }
                        },
                        {
                            "text": "The team used <w>asynchronous</w> communication to coordinate across different time zones.",
                            "target_lang_translations": {
                                "zh": "团队使用<w>异步</w>通信来协调不同时区的工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "asynch"
                    ],
                    "antonyms": [
                        "synchronous"
                    ],
                    "common_phrases": [
                        "asynchronous communication",
                        "asynchronous learning"
                    ],
                    "target_lang_definitions": {
                        "zh": "指不同步的，即不发生在同一时间或以相同速率进行。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "异步",
                                "target_lang_sense_clarification": "指非同时进行或非同步的活动。"
                            },
                            {
                                "target_lang_word": "非同步",
                                "target_lang_sense_clarification": "强调时间上的不一致性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b325ae6d-8098-3224-840c-d0c86a5f10ef",
                    "sense_definition": "Permitting a system to continue tasks while waiting for a separate process to finish.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software uses <w>asynchronous</w> requests to keep the user interface responsive during data loading.",
                            "target_lang_translations": {
                                "zh": "该软件使用<w>异步</w>请求，以确保在数据加载过程中用户界面保持响应。"
                            }
                        },
                        {
                            "text": "Implementing <w>asynchronous</w> processing significantly improved the performance of the web application.",
                            "target_lang_translations": {
                                "zh": "实现<w>异步</w>处理显著提高了该网络应用的性能。"
                            }
                        }
                    ],
                    "synonyms": [
                        "async"
                    ],
                    "antonyms": [
                        "synchronous"
                    ],
                    "common_phrases": [
                        "asynchronous processing",
                        "asynchronous request"
                    ],
                    "target_lang_definitions": {
                        "zh": "在计算机科学中，指允许系统在等待某个独立进程完成时继续执行其他任务。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "异步",
                                "target_lang_sense_clarification": "计算机编程中常用的术语，指无需等待响应即可继续执行。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a50cf054-d9b8-3ee2-8d29-8d6e6b7444af",
                    "sense_definition": "Characterized by multiple independent actions occurring without waiting for one another.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system handles <w>asynchronous</w> events by using a complex queue management strategy.",
                            "target_lang_translations": {
                                "zh": "该系统通过复杂的队列管理策略来处理<w>异步</w>事件。"
                            }
                        },
                        {
                            "text": "Modern programming languages often rely on <w>asynchronous</w> execution to manage heavy workloads efficiently.",
                            "target_lang_translations": {
                                "zh": "现代编程语言通常依赖<w>异步</w>执行来高效地管理繁重的工作负载。"
                            }
                        }
                    ],
                    "antonyms": [
                        "synchronous"
                    ],
                    "common_phrases": [
                        "asynchronous execution",
                        "asynchronous events"
                    ],
                    "target_lang_definitions": {
                        "zh": "指多个独立的操作互不等待地执行。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "异步",
                                "target_lang_sense_clarification": "指多个事件或操作独立运行，互不阻塞。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}