                "senses": [
                    {
                        "sense_id": "e3a11b81-4a0b-375e-af48-542f559d4676",
                        "entry_id": "a78ec921-72f3-3cd4-83ec-d2b6d2b8b0be",
                        "glosses": [
                            "ungelöste Schwierigkeit im Hinblick auf die Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb8aaa2-7b05-4a51-b99e-78e6cb2e15b2",
                                "sense_id": "e3a11b81-4a0b-375e-af48-542f559d4676",
                                "text": "„In der Bundesrepublik debattierte der Bundestag dagegen noch im Dezember 1954 über das Sprachproblem, laut Protokoll in »vorweihnachtlicher Stimmung«.“"
                            },
                            {
                                "example_id": "caf997ab-0d48-42ac-8c1c-20d2bc7745bd",
                                "sense_id": "e3a11b81-4a0b-375e-af48-542f559d4676",
                                "text": "„In diesem Jahr versuchte Badeni, den Knoten des Sprachproblems durchzuschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "03e8a05c-5a37-3dae-8ff0-c5c414780c04",
                        "entry_id": "a78ec921-72f3-3cd4-83ec-d2b6d2b8b0be",
                        "glosses": [
                            "mangelnde Sprachkenntnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1202121-8a5c-4f9e-8ec5-65043cabb429",
                                "sense_id": "03e8a05c-5a37-3dae-8ff0-c5c414780c04",
                                "text": "„Das Sprachproblem meiner Eltern führte teilweise zu absurden Situationen.“"
                            },
                            {
                                "example_id": "d224563f-6140-467b-812a-431e1ba2ec94",
                                "sense_id": "03e8a05c-5a37-3dae-8ff0-c5c414780c04",
                                "text": "„Die Frage, wann die Sprachprobleme eines Kindes behandelt werden müssen, ist umstritten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
