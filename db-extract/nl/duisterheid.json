    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "b4ef6fe5-8c12-3c9f-8f79-7fbed59533dc",
                "word": "duisterheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ac773c12-fe58-428e-8f94-a5f2d7102aaa",
                        "entry_id": "b4ef6fe5-8c12-3c9f-8f79-7fbed59533dc",
                        "tags": [
                            "plural"
                        ],
                        "form": "duisterheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f78d1993-712a-32e2-95f0-a4a6d542ddfa",
                        "entry_id": "b4ef6fe5-8c12-3c9f-8f79-7fbed59533dc",
                        "glosses": [
                            "de donkerte; de afwezigheid van licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d31466ca-3911-460c-ae93-074661263c2a",
                                "sense_id": "f78d1993-712a-32e2-95f0-a4a6d542ddfa",
                                "text": "Quispel had de Luxaflex voor de twee ramen aan de grachtkant naar beneden gelaten, maar de lamellen niet helemaal dichtgetrokken, zodat het zonlicht alle gelegenheid kreeg de duisterheid en de zondigheid van hun geheime samenkomst te accentueren."
                            }
                        ]
                    },
                    {
                        "sense_id": "38ad1f7f-6ec1-3986-a3de-7482f504f70a",
                        "entry_id": "b4ef6fe5-8c12-3c9f-8f79-7fbed59533dc",
                        "glosses": [
                            "het eng en geheimzinnig zijn"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "56934531-823d-4e4f-9022-9b47d0afd383",
                                "sense_id": "38ad1f7f-6ec1-3986-a3de-7482f504f70a",
                                "text": "Het zijn gedichten die zich volgens de jury langzaam prijsgeven, irriteren door hun ongrijpbaarheid en fascineren in hun duisterheid."
                            },
                            {
                                "example_id": "94690748-0b35-4e0d-8c10-6861aac25e08",
                                "sense_id": "38ad1f7f-6ec1-3986-a3de-7482f504f70a",
                                "text": "In een live-verbinding met Los Angeles kreeg Lynch de vraag gesteld hoe het zit met al die duisterheid en zijn decennialange meditaties. Met een glimlach zei Lynch: \"Een kunstenaar hoeft niet te lijden om leed te laten zien. Als je mediteert kom je geluk tegen waardoor je die verhalen kunt vertellen. Je hebt een schat in jezelf. Dan komt het goud binnen en gaat al het vuil naar buiten.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c431d21e-c50b-4789-bf6c-0f8fbf7f3639",
                        "source_entry_id": "b4ef6fe5-8c12-3c9f-8f79-7fbed59533dc",
                        "source_sense_id": "f78d1993-712a-32e2-95f0-a4a6d542ddfa",
                        "source_sense_description": "het eng en geheimzinnig zijn",
                        "target_lang_word": "vagueness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vagueness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e12554a5-4071-3ebd-89e1-c320ea67b0f6",
                                        "entry_id": "8f1b7eb5-7957-37da-ae9d-0c6b134be810",
                                        "glosses": [
                                            "The condition of being imprecise or unclear in meaning: vague."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2306596c-c1ff-4cdf-b7bb-2ab489593b35",
                                                "sense_id": "e12554a5-4071-3ebd-89e1-c320ea67b0f6",
                                                "text": "Near-synonyms: ambiguousness, ambiguity"
                                            },
                                            {
                                                "example_id": "f7f309ca-8299-46a4-ad8b-360b4a1fbe80",
                                                "sense_id": "e12554a5-4071-3ebd-89e1-c320ea67b0f6",
                                                "text": "On Wednesday night, a federal judge issued a preliminary injunction against a new California law that makes physicians subject to professional discipline for sharing COVID-19 \"misinformation\" with their patients. U.S. District Judge William B. Shubb concluded that California's definition of misinformation is unconstitutionally vague, failing to give doctors fair notice of which conduct the statute covers, which is a basic requirement of due process. That vagueness is especially problematic in this context, Shubb said, because it is apt to have a chilling effect on speech protected by the First Amendment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077555c1-2c08-386b-a353-e07908c6618a",
                                        "entry_id": "8f1b7eb5-7957-37da-ae9d-0c6b134be810",
                                        "glosses": [
                                            "Something which is vague, or an instance or example of vagueness."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c22c6b4-f5a4-4fd4-b99b-1d0098207232",
                                                "sense_id": "077555c1-2c08-386b-a353-e07908c6618a",
                                                "text": "If a man's deep and conscientious regard for the truth be such that he cannot, consistently with the requisitions of his moral nature, repeat to others mere vaguenesses and uncertainties, he will naturally give such strict and serious attention to the present objects of inquiry and knowledge, that they will remain in his memory afterward with remarkable distinctness and permanency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "844c2219-81a6-4040-9f4e-51b40726c223",
                        "source_entry_id": "b4ef6fe5-8c12-3c9f-8f79-7fbed59533dc",
                        "source_sense_id": "f78d1993-712a-32e2-95f0-a4a6d542ddfa",
                        "source_sense_description": "het eng en geheimzinnig zijn",
                        "target_lang_word": "darkness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "darkness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "The state of being dark; lack of light; the absolute or comparative absence of light."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cc5dd6d-0168-480b-a692-441bc0818d9f",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "The darkness of the room made it difficult to see."
                                            },
                                            {
                                                "example_id": "478bcd1c-8307-4a19-8bbe-6b8e190ba5bd",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "Over everything was darkness and thick silence, and the smell of dust and sunflowers."
                                            },
                                            {
                                                "example_id": "df021b4d-0341-418b-bef7-70fd35b6eedd",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            },
                                            {
                                                "example_id": "b45c5c6d-9691-4d28-94f5-72e95b6861db",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "Darkness imprisoning me\n All that I see\n Absolute horror\n I cannot live\n I cannot die\n Trapped in myself\n Body my holding cell"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "747b7b69-32a7-368c-bb10-9e772f26a83f",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "The state or quality of reflecting little light, of tending to a blackish or brownish color."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1abdc95b-70e7-4e2f-b100-498424147bd7",
                                                "sense_id": "747b7b69-32a7-368c-bb10-9e772f26a83f",
                                                "text": "The darkness of her skin betrayed her Mediterranean heritage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6832ef4-ce1b-3c5f-aeff-d93397add0e4",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Any space that such colour pervades."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18de698d-1764-4bf2-b6d4-4b9f478ed08a",
                                                "sense_id": "c6832ef4-ce1b-3c5f-aeff-d93397add0e4",
                                                "text": "Out of the darkness came some flickers of light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf2789d-7895-3a51-ac46-ff5be5a46ab7",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Gloom; gloominess; depression."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd9f8091-afe3-35e2-bb40-64f86dce0658",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "The product of being dark."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fe64d93-e6ea-3479-b33e-67a96ac5f23b",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Lack of understanding or compassion; spiritual or mental blindness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6f3857d-6d43-47c4-923b-56651316e284",
                                                "sense_id": "3fe64d93-e6ea-3479-b33e-67a96ac5f23b",
                                                "text": "And now, the prophecy. One will come, the voice from the outer world, bringing the holy war, the jihad, which will cleanse the universe and bring us out of darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cedf43a2-b62c-3ffc-9687-e7161d07a83a",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Secrecy; concealment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a25fbc61-fca7-3a86-b312-1c3008a08723",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Lack of knowledge; obscurity or meaning or intelligibility; the unknown."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313628f3-a4a4-401f-babd-169003d81dda",
                                                "sense_id": "a25fbc61-fca7-3a86-b312-1c3008a08723",
                                                "text": "It was just robbery with violence, aggravated murder on a great scale, and men going at it blind - as is very proper for those who tackle a darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e410a3-c7b7-3e4b-9abe-44384fd69c04",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Nothingness, vanity, emptiness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "771b2ff7-163c-4c9b-bef4-55b8a96d5bab",
                                                "sense_id": "f1e410a3-c7b7-3e4b-9abe-44384fd69c04",
                                                "text": "My own dim life should teach me this,\n⁠That life shall live for evermore,\n⁠Else earth is darkness at the core,\nAnd dust and ashes all that is; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d2169a6-41b0-3fbb-9583-f0a40f63c82c",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Hell."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bec5df3-5a1c-448d-90c1-88099f242fef",
                                                "sense_id": "7d2169a6-41b0-3fbb-9583-f0a40f63c82c",
                                                "text": "Shepard: Can you tell me anything about the beacon?\nDr. Warren: It's some type of data module from a galaxy-wide communications network. Remarkably well-preserved. It could be the greatest scientific discovery of our lifetime!\nDr. Warren: Miraculous new technologies. Groundbreaking medical advances. Who knows what secrets are locked inside?\nDr. Manuel: We have unearthed the heart of evil. Awakened the beast. Unleashed the darkness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "431a8446-cb68-4617-a8e8-ec64bdc3fea9",
                        "source_entry_id": "b4ef6fe5-8c12-3c9f-8f79-7fbed59533dc",
                        "source_sense_id": "f78d1993-712a-32e2-95f0-a4a6d542ddfa",
                        "source_sense_description": "het eng en geheimzinnig zijn",
                        "target_lang_word": "obscurity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obscurity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e10f7a33-3184-3d75-88ec-e1bf221c0b04",
                                        "entry_id": "c0629424-e489-3db3-8f15-ee43c1e7e676",
                                        "glosses": [
                                            "Darkness; the absence of light."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "756659b2-3262-42e8-b74d-d68d4994d16d",
                                                "sense_id": "e10f7a33-3184-3d75-88ec-e1bf221c0b04",
                                                "text": "The night was considerably clearer than anybody on board her desired when the schooner Ventura headed for the land. It rose in places, black and sharp against the velvety indigo, over her dipping bow, though most of the low littoral was wrapped in obscurity."
                                            },
                                            {
                                                "example_id": "c4036c52-8d6b-47bc-bd27-18ef8ab2c654",
                                                "sense_id": "e10f7a33-3184-3d75-88ec-e1bf221c0b04",
                                                "text": "I walked in, and Stroeve followed me. The room was in darkness. I could only see that it was an attic, with a sloping roof; and a faint glimmer, no more than a less profound obscurity, came from a skylight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dfa7139-38f2-33bd-bbe7-e3194f58f7b8",
                                        "entry_id": "c0629424-e489-3db3-8f15-ee43c1e7e676",
                                        "glosses": [
                                            "The state of being unknown; a thing that is unknown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efaf3bd-3f27-4e3f-bbf0-972e139b2d07",
                                                "sense_id": "4dfa7139-38f2-33bd-bbe7-e3194f58f7b8",
                                                "text": "The departure was not unduly prolonged.[…]Within the door Mrs. Spoker hastily imparted to Mrs. Love a few final sentiments[…]; a deep, guttural instigation to the horse; and the wheels of the waggonette crunched heavily away into obscurity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69c96b4f-9704-34fc-83c1-8e8e64f248d9",
                                        "entry_id": "c0629424-e489-3db3-8f15-ee43c1e7e676",
                                        "glosses": [
                                            "The quality of being difficult to understand; a thing that is difficult to understand."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
