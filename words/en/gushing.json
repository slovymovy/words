{
    "word_family": [
        "gush"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d09c7369-8028-3e30-b66a-658336070067",
                    "sense_definition": "Flowing out suddenly or in large quantities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gushing</w> water flooded the basement after the pipe burst.",
                            "target_lang_translations": {
                                "cs": "<w>Tryštící</w> voda zaplavila sklep poté, co prasklo potrubí."
                            }
                        },
                        {
                            "text": "We watched the <w>gushing</w> oil spray into the air from the broken valve.",
                            "target_lang_translations": {
                                "cs": "Sledovali jsme, jak <w>tryštící</w> ropa stříká do vzduchu z rozbitého ventilu."
                            }
                        }
                    ],
                    "synonyms": [
                        "pouring",
                        "spouting",
                        "surging"
                    ],
                    "common_phrases": [
                        "gushing water",
                        "gushing oil"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytékající náhle nebo ve velkém množství."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tryštící",
                                "target_lang_sense_clarification": "o kapalině stříkající pod tlakem"
                            },
                            {
                                "target_lang_word": "proudící",
                                "target_lang_sense_clarification": "o silném toku kapaliny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b608886c-9a56-3f9c-97a0-e44e40c7f5d2",
                    "sense_definition": "Expressing a lot of emotion in an unrestrained or overly enthusiastic way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>gushing</w> review of the movie, praising every single scene.",
                            "target_lang_translations": {
                                "cs": "Napsala na film <w>přehnaně nadšenou</w> recenzi, ve které vychválila každou scénu."
                            }
                        },
                        {
                            "text": "The actor felt uncomfortable with the <w>gushing</w> praise from his fans.",
                            "target_lang_translations": {
                                "cs": "Herec se cítil nesvůj z <w>přehnaně nadšené</w> chvály od svých fanoušků."
                            }
                        }
                    ],
                    "synonyms": [
                        "effusive",
                        "enthusiastic",
                        "demonstrative"
                    ],
                    "antonyms": [
                        "reserved",
                        "restrained"
                    ],
                    "common_phrases": [
                        "gushing praise",
                        "gushing review"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyjadřující emoce nekontrolovaným nebo přehnaně nadšeným způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vylíčený s nadšením",
                                "target_lang_sense_clarification": "o projevu emocí"
                            },
                            {
                                "target_lang_word": "přehnaně nadšený",
                                "target_lang_sense_clarification": "o osobě nebo jejím projevu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9228548-a153-3916-866f-a84d4457a250",
                    "sense_definition": "The act or motion of something that flows out suddenly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>gushing</w> of the fountain surprised the children.",
                            "target_lang_translations": {
                                "cs": "Náhlé <w>tryštění</w> fontány děti překvapilo."
                            }
                        },
                        {
                            "text": "He heard the loud <w>gushing</w> of the river after the heavy rain.",
                            "target_lang_translations": {
                                "cs": "Slyšel hlasité <w>proudění</w> řeky po silném dešti."
                            }
                        }
                    ],
                    "synonyms": [
                        "outflow",
                        "spurt",
                        "surge"
                    ],
                    "common_phrases": [
                        "sudden gushing"
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt nebo pohyb něčeho, co náhle vytéká."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tryštění",
                                "target_lang_sense_clarification": "náhlý výron kapaliny"
                            },
                            {
                                "target_lang_word": "proudění",
                                "target_lang_sense_clarification": "silný tok"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f0ee941f-3ba7-3a64-a465-e2e70caf1bd0",
                    "sense_definition": "Present participle and gerund of <w>gush</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water was <w>gushing</w> from the broken pipe all morning.",
                            "target_lang_translations": {
                                "cs": "Voda celé dopoledne <w>tryštila</w> z prasklého potrubí."
                            }
                        },
                        {
                            "text": "She kept <w>gushing</w> about how wonderful her new job is.",
                            "target_lang_translations": {
                                "cs": "Pořád <w>nadšeně vyprávěla</w> o tom, jak úžasná je její nová práce."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb gush."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa gush (tryštit, proudit)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tryštící",
                                "target_lang_sense_clarification": "jako přítomné příčestí"
                            },
                            {
                                "target_lang_word": "tryštění",
                                "target_lang_sense_clarification": "jako gerundium"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}