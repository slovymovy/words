                        "sense_id": "9bc6852b-693b-329a-b6cb-1c35570efb49",
                        "entry_id": "f9534475-97fb-3673-b802-457a7fa81cd2",
                        "glosses": [
                            "Ce que l'on ne peut pas, ou qu'on ne peut plus, espérer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a0afe356-255e-4c23-b79f-0526f477d07e",
                                "sense_id": "9bc6852b-693b-329a-b6cb-1c35570efb49",
                                "text": "Au dernier moment cependant un coup de chance inespérable aurait permis à l'Empire de se tirer d'affaire honorablement et pacifiquement."
                            },
                            {
                                "example_id": "0327a690-f3ed-4ddb-9749-9da08e5f3bd7",
                                "sense_id": "9bc6852b-693b-329a-b6cb-1c35570efb49",
                                "text": "Ainsi, la conscience qui est « âtre de connaissance », doit alimenter sa foi au cœur de l'espérance, qui ne trouve son sens qu'au sein de l’inespérable, qui ne se trouvera pas dans le \"quelque chose\" puisque l’inespérable est inexplorable (…) et sans voie d'accès."
                            }
                        ]
                    }
