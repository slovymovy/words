                        "glosses": [
                            "Processus qui met en évidence le passage fantasmatique du dehors au dedans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00db97f5-71fa-4058-ae41-511c181a0ba1",
                                "sense_id": "cf615efe-7296-30e0-a9b8-acccaebc80b5",
                                "text": "Je me surprends parfois à avoir des pulsions racistes ou mêmes antisémites, fruits amers de cette introjection psychique acceptée contre ma propre volonté."
                            }
                        ]
                    }
                ],
