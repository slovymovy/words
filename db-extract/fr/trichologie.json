                                "example_id": "3b547885-999f-4fcc-83b8-161b1da6e18a",
                                "sense_id": "72825eee-7f38-3041-ad13-ae7db7964829",
                                "text": "La trichologie est une science qui permet d’identifier et de traiter les affections véhiculées par le système pileux."
                            },
                            {
                                "example_id": "f55f192c-4939-434a-a42d-5f709c660ef6",
                                "sense_id": "72825eee-7f38-3041-ad13-ae7db7964829",
                                "text": "La trichologie se pratique autant chez l’homme que sur les animaux."
                            }
                        ]
                    }
                ],
