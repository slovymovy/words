                "senses": [
                    {
                        "sense_id": "c26ceacd-03ff-3f95-b626-99114ec040e3",
                        "entry_id": "f5360e42-89f0-37f2-b344-7c055ad19c45",
                        "glosses": [
                            "spowalnianie procesu, podczas którego wytwarzane są przeciwciała i komórki odpornościowe, najczęściej farmakologicznie, za pomocą leków immunosupresyjnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "628cd026-fab3-4680-bc29-c19956c185ba",
                                "sense_id": "c26ceacd-03ff-3f95-b626-99114ec040e3",
                                "text": "W ostatnich latach zanotowano podwojenie liczby zarażeń grzybami u hospitalizowanych pacjentów, zwłaszcza onkologicznych, po przeszczepach i będących w stanie immunosupresji"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92bfd2cd-74b9-4492-a820-3472da4302e2",
                        "source_entry_id": "f5360e42-89f0-37f2-b344-7c055ad19c45",
                        "source_sense_id": "c26ceacd-03ff-3f95-b626-99114ec040e3",
                        "target_lang_word": "immunosuppression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immunosuppression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b97492fc-5db3-39e2-81de-e6289d029d3a",
                                        "entry_id": "83ece043-96e4-38ba-9cd9-879e03590ad9",
                                        "glosses": [
                                            "The suppression of the immune response, especially its active medical suppression by human agency (via immunosuppressant drugs) to treat autoimmune diseases or to prevent allograft rejection after transplant."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2703634d-77f3-4d54-aa0e-d663c6b26787",
                                                "sense_id": "b97492fc-5db3-39e2-81de-e6289d029d3a",
                                                "text": "It has been reported that periparturient cows undergo a period of immunosuppression of various immunological parameters associated with a high susceptibility to uterine and mammary infections […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04e5cecc-8de5-4ddf-a297-37db384f9775",
                        "source_entry_id": "f5360e42-89f0-37f2-b344-7c055ad19c45",
                        "source_sense_id": "c26ceacd-03ff-3f95-b626-99114ec040e3",
                        "target_lang_word": "immunosuppression",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immunosuppression",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a371d0af-ef54-3c80-95a2-3ce14d41c267",
                                        "entry_id": "6995d069-81f6-31e6-b988-dda0e2f73160",
                                        "glosses": [
                                            "Inhibition, pathologique ou volontaire et thérapeutique, de l’activation du système immunitaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af36e72-1b3e-4b13-ac2e-94125ec2b4f6",
                                                "sense_id": "a371d0af-ef54-3c80-95a2-3ce14d41c267",
                                                "text": "Le suivi de l’immunosuppression et le monitoring du rejet sont donc des éléments centraux du succès d’une greffe cardiaque."
                                            },
                                            {
                                                "example_id": "ca5d5189-a900-4db0-b4ee-59b4483869b5",
                                                "sense_id": "a371d0af-ef54-3c80-95a2-3ce14d41c267",
                                                "text": "En transplantation rénale des progrès considérables ont été réalisés ces dernières années dans la prise en charge de l’immunosuppression, notamment, grâce à l’apparition de nouvelles molécules."
                                            },
                                            {
                                                "example_id": "dbf8a0d1-05b8-4625-857e-5b7c22e69c58",
                                                "sense_id": "a371d0af-ef54-3c80-95a2-3ce14d41c267",
                                                "text": "Pour preuve : les personnes prenant un traitement immunosuppresseur (ralentissant le système immunitaire) ou ayant des maladies avec immunosuppression, comme le Sida, ont plus de risques de développer une tumeur que les autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "045fd569-cfc9-4c8f-a1c0-4e83c070a817",
                        "source_entry_id": "f5360e42-89f0-37f2-b344-7c055ad19c45",
                        "source_sense_id": "c26ceacd-03ff-3f95-b626-99114ec040e3",
                        "target_lang_word": "inmunosupresión",
