                    {
                        "translation_id": "4b024acb-4b3b-4201-90fb-59e4fed0180f",
                        "source_entry_id": "a4b0e1d2-faaa-3aec-a5f1-3d78c63b75dd",
                        "source_sense_id": "c6ea562a-95df-3e65-8bc9-d712c1f530eb",
