                            {
                                "example_id": "477db1b3-03b0-4821-8aa9-3fbaff9e0dd2",
                                "sense_id": "e5642ab5-2ff0-308a-80bf-0370d9e0b5ef",
                                "text": "Martius found most dressed in bits of clothing, their hair wildly tangled and their faces dyed red with urucum."
                            },
                            {
                                "example_id": "d088024c-0b95-4736-84b6-f17a62784bc8",
                                "sense_id": "e5642ab5-2ff0-308a-80bf-0370d9e0b5ef",
                                "text": "They paint them, or at least parts of them, with urucum (reddish) plant dye or even their own blood if there are no urucum plants nearby."
                            },
                            {
                                "example_id": "c7a31e37-6c7f-47db-a45d-22c7d2bc756f",
                                "sense_id": "e5642ab5-2ff0-308a-80bf-0370d9e0b5ef",
                                "text": "Bixin results from lycopene oxidation and it is the main carotenoid found in the seed coat of urucum fruits (Bixa orellana L.), which is cultivated in tropical countries of South and Central America, Africa and Asia."
                            }
                        ]
                    }
