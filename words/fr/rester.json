{
    "word_family": [
        "reste",
        "restant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f16c14f5-baa8-3839-af8d-604f452f67be",
                    "sense_definition": "Ne pas quitter un lieu, y demeurer.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme il pleut beaucoup aujourd'hui, je préfère <w>rester</w> à la maison."
                        },
                        {
                            "text": "Nous sommes <w>restés</w> à l'hôtel pendant toute la durée des vacances."
                        }
                    ],
                    "antonyms": [
                        "partir",
                        "s'en aller"
                    ],
                    "common_phrases": [
                        "rester à la maison",
                        "rester au lit",
                        "rester sur place"
                    ]
                },
                {
                    "sense_id": "f78ba83f-e2d6-3dae-bfd8-eec13098a62f",
                    "sense_definition": "Continuer d'être dans un certain état ou une certaine disposition.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant cette situation d'urgence, il est très important de <w>rester</w> calme."
                        },
                        {
                            "text": "Malgré les années qui passent, ils sont toujours <w>restés</w> de fidèles amis."
                        }
                    ],
                    "synonyms": [
                        "être"
                    ],
                    "common_phrases": [
                        "rester calme",
                        "rester silencieux",
                        "rester en contact"
                    ]
                },
                {
                    "sense_id": "68540e06-4114-3a81-900f-7bcf8214227a",
                    "sense_definition": "Être encore présent, subsister après la disparition ou la consommation du reste.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "subsistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regarde dans la cuisine, il <w>reste</w> un morceau de gâteau pour toi."
                        },
                        {
                            "text": "Après le passage de la tempête, il ne <w>restait</w> que quelques arbres debout."
                        }
                    ],
                    "synonyms": [
                        "exister",
                        "subsister"
                    ],
                    "antonyms": [
                        "disparaître"
                    ],
                    "common_phrases": [
                        "ce qui reste"
                    ]
                },
                {
                    "sense_id": "c76c2d20-6046-3160-a4ea-e8e77f6cdf9d",
                    "sense_definition": "Continuer d'exister dans le temps ; durer, persister.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "subsistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce beau souvenir d'enfance <w>restera</w> toujours gravé dans mon esprit."
                        },
                        {
                            "text": "Malgré les siècles, ces anciennes traditions <w>restent</w> vivantes dans la région."
                        }
                    ],
                    "synonyms": [
                        "perdurer",
                        "persister"
                    ],
                    "antonyms": [
                        "disparaître"
                    ]
                },
                {
                    "sense_id": "c62f01ee-2aee-37f3-9308-32366891360d",
                    "sense_definition": "Être encore à accomplir ou à considérer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le plus gros du travail est terminé, mais il nous <w>reste</w> des détails à régler."
                        },
                        {
                            "text": "Il <w>reste</w> à savoir si le projet sera accepté par le comité demain matin."
                        }
                    ],
                    "common_phrases": [
                        "il reste à faire",
                        "il reste à voir"
                    ]
                },
                {
                    "sense_id": "466c3e93-4214-3632-b99e-ec4270985506",
                    "sense_definition": "Il n'en demeure pas moins que ; le fait indéniable est que.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "locution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les progrès sont réels, mais il <w>reste</w> que la situation financière demeure délicate."
                        },
                        {
                            "text": "Chacun a ses arguments, <w>reste</w> qu'une décision urgente doit être prise rapidement."
                        }
                    ],
                    "common_phrases": [
                        "il reste que",
                        "reste que"
                    ]
                },
                {
                    "sense_id": "ec733e4f-8c74-3636-9efd-a8e501eb0bff",
                    "sense_definition": "Avoir son domicile en un endroit ; habiter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'elle a changé d'emploi, elle <w>reste</w> dans un appartement à Montréal."
                        },
                        {
                            "text": "Mes cousins <w>restent</w> sur cette même avenue depuis une vingtaine d'années."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "principalement utilisé au Québec"
                        }
                    ]
                }
            ]
        }
    ]
}