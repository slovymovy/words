                                        "sense_id": "41204ced-58b0-32f8-9a24-d5b35ced3f15",
                                        "entry_id": "18693e35-b342-32e9-9d97-4cc804708270",
                                        "glosses": [
                                            "Bâtiment regroupant les différents services pour la gestion d’un port maritime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d679ac-7bee-4c31-a9c5-b90c69fd94f6",
                                                "sense_id": "41204ced-58b0-32f8-9a24-d5b35ced3f15",
                                                "text": "Joss avait gueulé dans tous les bars que les gros culs de la capitainerie palpaient des commissions, si bien qu’il avait pu dire adieu à la marine marchande."
                                            },
                                            {
                                                "example_id": "dd0a195c-bae9-47b7-9629-62741f60d09b",
                                                "sense_id": "41204ced-58b0-32f8-9a24-d5b35ced3f15",
                                                "text": "Le trafic des ferrys à Calais a été annulé dans la matinée, en raison d’une grève de la capitainerie, levée à midi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6657d468-72e9-3e92-b73f-6c2176985731",
                                        "entry_id": "18693e35-b342-32e9-9d97-4cc804708270",
                                        "glosses": [
                                            "Charge de capitaine d’une maison royale, d’un château, etc., ou de capitaine des chasses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c807be35-b0da-40a1-aba0-fa30a6b035a6",
                                                "sense_id": "6657d468-72e9-3e92-b73f-6c2176985731",
                                                "text": "Capitainerie de Fontainebleau."
                                            },
                                            {
                                                "example_id": "1123e4f8-e95f-4925-abd3-fd27971bee92",
                                                "sense_id": "6657d468-72e9-3e92-b73f-6c2176985731",
                                                "text": "Capitainerie des chasses, se disait de l’étendue de la juridiction d’un capitaine des chasses."
                                            },
                                            {
                                                "example_id": "059f433e-05d7-4a41-9ab4-0dde54d3f8ef",
                                                "sense_id": "6657d468-72e9-3e92-b73f-6c2176985731",
                                                "text": "Je vous donne la capitainerie générale du Louvre avec rang et prérogative de maréchal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2681e46b-2542-351e-8a9e-908e0019f0f4",
                                        "entry_id": "18693e35-b342-32e9-9d97-4cc804708270",
                                        "glosses": [
                                            "Dans quelques maisons royales, il se disait du lieu affecté au logement du capitaine des chasses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18c10ad1-1b2d-4d1b-a391-bb5568cfb933",
                                                "sense_id": "2681e46b-2542-351e-8a9e-908e0019f0f4",
                                                "text": "Loger à la capitainerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a0d9f2-f786-3329-a60c-aa470ad31dd1",
                                        "entry_id": "18693e35-b342-32e9-9d97-4cc804708270",
