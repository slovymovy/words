                "forms": [
                    {
                        "form_id": "23bef6cb-bace-4e8f-a4c8-58083cadd8a1",
                        "entry_id": "deb2899e-f3f1-3b48-8aa3-ce7bc6fbf01f",
                        "tags": [
                            "plural"
                        ],
                        "form": "vallons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "010ec942-bc46-31f5-a542-2adbd3c2428b",
                        "entry_id": "deb2899e-f3f1-3b48-8aa3-ce7bc6fbf01f",
                        "glosses": [
                            "Petite vallée, espace de terre resserré entre deux coteaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1582d601-c67a-4c13-966b-a0fcf83ca7e9",
                                "sense_id": "010ec942-bc46-31f5-a542-2adbd3c2428b",
                                "text": "Jusqu’après Valpuiseaux, sur plus d'une lieue, les groupes de fermes se suivent. Ensuite le vallon est solitaire, pli étroit et profond dont les côtés sont striés par une infinité de vaux très courts."
                            },
                            {
                                "example_id": "6e4fa9b3-9d2f-430c-8597-f8ed216395f7",
                                "sense_id": "010ec942-bc46-31f5-a542-2adbd3c2428b",
                                "text": "Vallon de Bouafles. — La craie marneuse est très développée dans les vallons qui viennent déboucher à Bouafles ; elle est très nettement visible en particulier, un peu en amont de Basse-Copette sur la route de Campneuseville et elle monte là extrêmement haut."
                            },
                            {
                                "example_id": "90086749-c0b2-469f-8376-85aa01ef2d73",
                                "sense_id": "010ec942-bc46-31f5-a542-2adbd3c2428b",
                                "text": "Dans cette partie de son cours, la Lanterne reçoit les eaux de nombreux ruisseaux ou « rus » provenant des vallons tourbeux voisins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac2f0074-1eac-4933-9fd2-a0137a47ec58",
                        "source_entry_id": "deb2899e-f3f1-3b48-8aa3-ce7bc6fbf01f",
                        "source_sense_id": "010ec942-bc46-31f5-a542-2adbd3c2428b",
                        "target_lang_word": "hollow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hollow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                                        "entry_id": "cc6085a0-a82d-35d5-be60-bd59618c2795",
                                        "glosses": [
                                            "A small valley between mountains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4befdff2-be40-4390-835f-3d3009680693",
                                                "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                                                "text": "He built himself a cabin in a hollow high up in the Rockies."
                                            },
                                            {
                                                "example_id": "472325f1-c04a-4bfc-89eb-4e7449fca11a",
                                                "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                                                "text": "c. 1710–20, Matthew Prior, The First Hymn Of Callimachus: To Jupiter\nForests grew upon the barren hollows."
                                            },
                                            {
                                                "example_id": "451f10c9-5c99-4dd4-99b2-bda1a4b275c3",
                                                "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                                                "text": "This road leads through a sandy hollow shaded by trees for about a quarter of a mile, where it crosses the bridge famous in goblin story, and just beyond swells the green knoll on which stands the whitewashed church."
                                            },
                                            {
                                                "example_id": "b2908f0a-8c26-4aaa-bf66-9156c2e57c2d",
                                                "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                                                "text": "I hate the dreadful hollow behind the little wood, / Its lips in the field above are dabbled with blood-red heath, / The red-ribb'd hedges drip with a silent horror of blood, / And Echo there, whatever is ask'd her, answers 'Death.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc6c29a2-9f4b-3b59-9ec4-ea010687ad75",
                                        "entry_id": "cc6085a0-a82d-35d5-be60-bd59618c2795",
                                        "glosses": [
                                            "A sunken area on a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af71aac-c771-475c-b478-762308bc37e3",
                                                "sense_id": "bc6c29a2-9f4b-3b59-9ec4-ea010687ad75",
                                                "text": "the hollow of the hand"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f67194c3-f691-32bb-9c70-de648bb2ce1d",
                                        "entry_id": "cc6085a0-a82d-35d5-be60-bd59618c2795",
                                        "glosses": [
                                            "An unfilled space in something solid; a cavity, natural or artificial."
                                        ],
