                "senses": [
                    {
                        "sense_id": "9bd159ae-f183-33f7-a560-965ef0d8088e",
                        "entry_id": "fb065ed6-7a28-3147-9e3f-7b94f6276b32",
                        "glosses": [
                            "shroud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af6c6e0-9239-4dea-955f-c9c33f5d9950",
                                "sense_id": "9bd159ae-f183-33f7-a560-965ef0d8088e",
                                "text": "сне́жная пелена́",
                                "translation": "mantle of snow",
                                "english": "mantle of snow"
                            },
                            {
                                "example_id": "1dc91107-6d0c-4c11-8568-5d093581c618",
                                "sense_id": "9bd159ae-f183-33f7-a560-965ef0d8088e",
                                "text": "у него́ сло́вно пелена́ с глаз упа́ла",
                                "translation": "the scales fell from his eyes",
                                "english": "the scales fell from his eyes"
                            },
                            {
                                "example_id": "be6d0cd5-e37f-4d3c-9fbe-af3af9481f11",
                                "sense_id": "9bd159ae-f183-33f7-a560-965ef0d8088e",
                                "text": "Пе́редо мной бы́ло большо́е кру́глое боло́то, занесё́нное сне́гом, и́з-под бе́лой пелены́ кото́рого торча́ли ре́дкие ко́чки.",
                                "translation": "In front of me there was a large round swamp, thinly covered with snow; out of the white shroud a few little mounds emerged.",
                                "english": "In front of me there was a large round swamp, thinly covered with snow; out of the white shroud a few little mounds emerged."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
