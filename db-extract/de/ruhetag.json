                        "sense_id": "3e60d72d-3060-348e-9aec-7910f465bdeb",
                        "entry_id": "37d248cd-7a50-39eb-9aff-663cbf76e7e0",
                        "glosses": [
                            "ein rennfreier Tag während eines Etappenrennens"
                        ],
                        "tags": [
