                ],
                "senses": [
                    {
                        "sense_id": "81d35b32-1d0b-3861-a9a5-616149804330",
                        "entry_id": "48211e67-5031-3dd1-b2ce-9d0217cf7cf8",
                        "glosses": [
                            "человек очень маленького роста; карлик"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e47f66c-bf53-4134-b2f4-6784d9daccae",
                                "sense_id": "81d35b32-1d0b-3861-a9a5-616149804330",
                                "text": "Он был поразительно малого роста, почти пигмей, но сложен крепко."
                            }
                        ]
                    },
                    {
                        "sense_id": "68b82624-9e32-37f4-923e-69028a98e341",
                        "entry_id": "48211e67-5031-3dd1-b2ce-9d0217cf7cf8",
                        "glosses": [
                            "перен., разг. ничтожный человек; ничтожество"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e132cf-51de-4b05-9220-ad65ba7886ee",
                                "sense_id": "68b82624-9e32-37f4-923e-69028a98e341",
                                "text": "Но слушай, знай, безбожный: // Мой крик, мой ярый смех преследует тебя! // Пей нашу кровь, живи, губя: // Ты все пигмей, пигмей ничтожный."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
