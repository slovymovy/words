                    },
                    {
                        "sense_id": "8600a5f7-9a9e-3a19-a9ab-20a0e8159fb0",
                        "entry_id": "02970fe9-d44b-334f-bd02-4b6f621f7422",
                        "glosses": [
                            "ogół utworów pisanych mową niewiązaną"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5cf597-404b-4b30-a5de-4facd11ff30d",
                                "sense_id": "8600a5f7-9a9e-3a19-a9ab-20a0e8159fb0",
                                "text": "Czesia lubuje się w prozie latynoskiej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ba1d8bb4-ae06-3f21-9569-07f8e8ed5a35",
                        "entry_id": "02970fe9-d44b-334f-bd02-4b6f621f7422",
                        "glosses": [
                            "autorzy piszący teksty prozą (1.1)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "e65e43f6-e70f-3616-aa59-ed3b545519d0",
                        "entry_id": "02970fe9-d44b-334f-bd02-4b6f621f7422",
                        "glosses": [
                            "sprawy codzienne, przyziemne"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "2faac2b5-fe40-49e1-84ba-2af502f4b7b0",
                                "sense_id": "e65e43f6-e70f-3616-aa59-ed3b545519d0",
                                "text": "Doświadczyliśmy na własnej skórze brazylijskiej prozy życia."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a15c6e1-246a-45bf-adc9-60a3f17811ba",
                        "source_entry_id": "02970fe9-d44b-334f-bd02-4b6f621f7422",
                        "source_sense_id": "f9dd8ca2-a3a7-3c08-b47f-fbec98b82367",
                        "target_lang_word": "prose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4efc92fe-228e-36b4-a14e-ab2b221ab35f",
                                        "entry_id": "16fa4300-25a6-367a-a8f3-a376aa3f2c06",
                                        "glosses": [
                                            "Language, particularly written language, not intended as poetry."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "209f1ad3-1c2e-47e6-9124-4df301ec8d43",
                                                "sense_id": "4efc92fe-228e-36b4-a14e-ab2b221ab35f",
                                                "text": "Though known mostly for her prose, she also produced a small body of excellent poems."
                                            },
                                            {
                                                "example_id": "6ca0353e-e580-4a51-ba6c-ac9692e5642b",
                                                "sense_id": "4efc92fe-228e-36b4-a14e-ab2b221ab35f",
                                                "text": "...Or if Sion Hill\nDelight thee more, and Siloa's Brook that flow’d\nFaft by the Oracle of God; I thence\nInvoke thy aid to my adventrous Song,\nThat with no middle flight intends to soar\nAbove th’ Ionian Mounts while it pursues\nThings unattempted yet in Prose or Rhime..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c947b1c5-f119-33e4-af0e-3906dd4cfdb9",
                                        "entry_id": "16fa4300-25a6-367a-a8f3-a376aa3f2c06",
                                        "glosses": [
                                            "Language which evinces little imagination or animation; dull and commonplace discourse."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "861d7a40-2a46-4f4d-ac3e-65a5b1e7fcd1",
                                                "sense_id": "c947b1c5-f119-33e4-af0e-3906dd4cfdb9",
                                                "text": "...the vehicle is plodding prose, but the effect is none the less poignant. And in regard to this I may say that in a hundred places in Trollope the extremity of pathos is reached by the homeliest means."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e4d2835-ba29-3b26-861f-03f36a1e9063",
                                        "entry_id": "16fa4300-25a6-367a-a8f3-a376aa3f2c06",
                                        "glosses": [
                                            "A hymn with no regular meter, sometimes introduced into the Mass."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41e97e3a-d693-433f-8694-159083e9d8fc",
                                                "sense_id": "4e4d2835-ba29-3b26-861f-03f36a1e9063",
                                                "text": "Proses are parts of the Office of the Mass which are sung just before the Gospel, upon great Festivals. The French also call those Rhythmical Hymns Proses, which are sung in their Offices in the Church of Rome, in which Rhime only, and not Quantity of Syllables, is observed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0df91e54-5c97-3ab2-b29c-100bfadec9f1",
                                        "entry_id": "6c1a1baa-2d7e-3e62-a511-21eb3b5c60e1",
                                        "glosses": [
                                            "To write or repeat in a dull, tedious, or prosy way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07474058-5390-46f9-bcff-7f278b13255e",
                                                "sense_id": "0df91e54-5c97-3ab2-b29c-100bfadec9f1",
                                                "text": "Pray, do not prose, good Ethelbert, but speak;\nWhat is your purpose?"
                                            },
                                            {
                                                "example_id": "83e315ec-76a2-4651-883f-c1dd55140be2",
                                                "sense_id": "0df91e54-5c97-3ab2-b29c-100bfadec9f1",
                                                "text": "Already he felt himself near to being a celebrity. He had astonished Eton. That was a good beginning. Papa might prose, knowing, of course, nothing of the poetry of caricature, of the wild joys and the laurels that crown the whimsical. So while Mr. Lane hunted adjectives, and ran sad-sounding and damnatory substantives to earth, Eustace hugged himself, and secretly chuckled over his pilgrim's progress towards the pages of Vanity Fair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7de30b6-8b3a-4f14-9c8b-8ae235385bbc",
                        "source_entry_id": "02970fe9-d44b-334f-bd02-4b6f621f7422",
                        "source_sense_id": "f9dd8ca2-a3a7-3c08-b47f-fbec98b82367",
                        "target_lang_word": "prose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d7d93b-ca2f-3cd2-a77d-7d3c36b88bbb",
                                        "entry_id": "012d3596-88df-3c94-87e7-ad3501179041",
                                        "glosses": [
                                            "Langage, manière d’écrire qui n’est pas assujettie à une certaine mesure, à un certain nombre de pieds et de syllabes, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29746e6e-c0b8-43f1-a006-c451b7621ce1",
                                                "sense_id": "a6d7d93b-ca2f-3cd2-a77d-7d3c36b88bbb",
                                                "text": "Prose française."
                                            },
                                            {
                                                "example_id": "d43a8a8f-2895-479a-8cc3-cb6469dfe74a",
                                                "sense_id": "a6d7d93b-ca2f-3cd2-a77d-7d3c36b88bbb",
                                                "text": "Écrire en prose."
                                            },
                                            {
                                                "example_id": "52fa323e-4dda-4538-b12e-3d9042fb91e7",
                                                "sense_id": "a6d7d93b-ca2f-3cd2-a77d-7d3c36b88bbb",
                                                "text": "Il a traité le même sujet en vers et en prose."
                                            },
                                            {
                                                "example_id": "9f570f06-4516-4bd1-b5d4-57952827c0ba",
                                                "sense_id": "a6d7d93b-ca2f-3cd2-a77d-7d3c36b88bbb",
                                                "text": "Mélanges de vers et de prose."
                                            },
                                            {
                                                "example_id": "0cb7fd44-85b3-4471-a4fa-06ee3afedb44",
                                                "sense_id": "a6d7d93b-ca2f-3cd2-a77d-7d3c36b88bbb",
                                                "text": "Épître en prose mêlée de vers."
                                            },
                                            {
                                                "example_id": "02b20a85-bf0e-4dad-a664-83ebf03eff38",
                                                "sense_id": "a6d7d93b-ca2f-3cd2-a77d-7d3c36b88bbb",
                                                "text": "Comédie en cinq actes et en prose."
                                            },
                                            {
                                                "example_id": "1c3c4aa7-2451-4f06-bc80-bf02dcb9d55f",
                                                "sense_id": "a6d7d93b-ca2f-3cd2-a77d-7d3c36b88bbb",
                                                "text": "Ce n’est pas de la poésie, ce n’est que de la prose rimée."
                                            },
                                            {
                                                "example_id": "70e4ac6e-55b7-4d4c-998c-ecb4ea3bb736",
                                                "sense_id": "a6d7d93b-ca2f-3cd2-a77d-7d3c36b88bbb",
                                                "text": "Prose poétique : prose qui affecte le ton et le style figuré de la poésie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac62d72-c749-37ae-96b6-f74ef6eb870b",
                                        "entry_id": "012d3596-88df-3c94-87e7-ad3501179041",
                                        "glosses": [
                                            "Simple écrit."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08497bb8-187b-4fad-9893-4d5e3ad66874",
                                                "sense_id": "aac62d72-c749-37ae-96b6-f74ef6eb870b",
                                                "text": "Ici, voyez-vous, mon cher Nicolas, j'ai besoin de recourir aux formes solennelles d'un premier-pariste bien connu, et dont la prose sublime se tire à 217.830 exemplaires."
                                            },
                                            {
                                                "example_id": "8e08dd09-4f91-43f0-9bf8-068801de7dc2",
                                                "sense_id": "aac62d72-c749-37ae-96b6-f74ef6eb870b",
                                                "text": "C'est ainsi, et c'est un comble, que le discours œnologiquement correct qui s'est imposé au pays de Rabelais, de Molière et de Gentil-Bernard est inspiré par la prose gluante de Robert Paker, le gourou du Maryland amateur d'arômes de ketchup et de senteurs de boite à épices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d40cd56-9420-368e-b019-5f123ecef62e",
                                        "entry_id": "012d3596-88df-3c94-87e7-ad3501179041",
                                        "glosses": [
                                            "Sorte d’hymnes latines, où la rime et le nombre des syllabes remplacent la quantité, et que l’on chante à la messe immédiatement avant l’évangile, dans les grandes solennités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e62ede77-b828-4083-8839-1abc12168af4",
                                                "sense_id": "5d40cd56-9420-368e-b019-5f123ecef62e",
                                                "text": "La prose du Saint Sacrement."
                                            },
                                            {
                                                "example_id": "38796b31-c12f-4347-aefd-03456398cb77",
                                                "sense_id": "5d40cd56-9420-368e-b019-5f123ecef62e",
                                                "text": "La prose des morts."
                                            },
                                            {
                                                "example_id": "402d7948-d41f-4b04-bcb2-bb7224b80503",
                                                "sense_id": "5d40cd56-9420-368e-b019-5f123ecef62e",
                                                "text": "Le Dies irae, le Stabat Mater sont des proses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3478deed-a79d-3fc2-84f6-4c287833a283",
                                        "entry_id": "0fd45544-979f-3a9c-affa-f19c8f300827",
                                        "glosses": [
                                            "Fessier ; postérieur."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d0c65d0-794a-46af-a3f6-ce037d143280",
                                                "sense_id": "3478deed-a79d-3fc2-84f6-4c287833a283",
                                                "text": "Les bourdilles du guet sont médusés. Mon histoire de pigeons les laisse sur le prose."
                                            },
                                            {
                                                "example_id": "09379e83-875c-4811-a565-2da1a5b45c1c",
                                                "sense_id": "3478deed-a79d-3fc2-84f6-4c287833a283",
                                                "text": "T’auras sûrement droit à des coups de pompe dans le prose de la part de tes vieux, mais les autres seront tellement soulagés qu’ils te baiseront les mains !"
                                            },
                                            {
                                                "example_id": "7729c874-54b5-44cf-aa3c-736149c0aed7",
                                                "sense_id": "3478deed-a79d-3fc2-84f6-4c287833a283",
                                                "text": "Elle sucre tellement les fraises qu'elle serait incapable de mettre un suppositoire à un type qui aurait l'aération du prose large comme l'entrée principale de la gare de Lyon."
                                            },
                                            {
                                                "example_id": "2f611aee-b486-415b-96d9-887a104ea103",
                                                "sense_id": "3478deed-a79d-3fc2-84f6-4c287833a283",
                                                "text": "Un de ces jours le joggeur va se faire harponner au coin des rues : « Hep ! Vous là-bas : contrôle d’échappement, mettez-vous la sonde dans le prose... Ha-ha, votre compte est bon : surrégime aux féculents ! »... Et paf : trois bons-points rajoutés au permis de conduire et interdiction de marcher pendant deux ans."
                                            }
                                        ]
                                    }
                                ]
