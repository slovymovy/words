                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b6807d1-4a0f-3a0b-8eed-84a888a4ddc9",
                        "entry_id": "6b3fa2ff-a935-308a-a47f-f144f7a4e43d",
                        "glosses": [
                            "относящийся к апрелю, произошедший (происходящий) в апреле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a4eaf3f-f020-46cb-a1e7-9526c8d785e6",
                                "sense_id": "2b6807d1-4a0f-3a0b-8eed-84a888a4ddc9",
                                "text": "Был светлый апрельский день."
                            },
                            {
                                "example_id": "19622b7e-b0fe-4349-8679-64d6eccde320",
                                "sense_id": "2b6807d1-4a0f-3a0b-8eed-84a888a4ddc9",
                                "text": "Я, вдыхая апрельский дух, приносимый с чёрных полей, слушал вороний грохот с верхушек берёз, щурился от первого солнца, шёл через двор добриваться. Это было около трёх часов дня."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "404de8bd-5603-45e4-981a-5750ebe2efa4",
                        "source_entry_id": "6b3fa2ff-a935-308a-a47f-f144f7a4e43d",
                        "source_sense_id": "2b6807d1-4a0f-3a0b-8eed-84a888a4ddc9",
                        "target_lang_word": "April",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "April",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10e163fd-2dff-3e91-ae79-a8646f866029",
                                        "entry_id": "1a2ed722-66ea-31ea-8bc6-7cfd40f0abeb",
                                        "glosses": [
                                            "The fourth month of the Gregorian calendar, following March and preceding May."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be04749-8519-40bc-a60f-ba21c8643bd9",
                                                "sense_id": "10e163fd-2dff-3e91-ae79-a8646f866029",
                                                "text": "Holonyms: calendar year; year"
                                            },
                                            {
                                                "example_id": "d756980b-a254-499a-a457-2a982184da14",
                                                "sense_id": "10e163fd-2dff-3e91-ae79-a8646f866029",
                                                "text": "Oh, to be in England / Now that April’s there"
                                            },
                                            {
                                                "example_id": "b381c331-78c6-4dd2-b4cb-498373233a93",
                                                "sense_id": "10e163fd-2dff-3e91-ae79-a8646f866029",
                                                "text": "The little green men were clearly professional soldiers by their bearing, carried Russian weapons, and wore Russian combat fatigues, but they had no identifying insignia. Vladimir Putin originally denied they were Russian soldiers; that April, he confirmed they were."
                                            },
                                            {
