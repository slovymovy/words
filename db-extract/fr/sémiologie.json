            {
                "entry_id": "e44806b0-9d3a-30d4-b99e-f715037f1193",
                "word": "sémiologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9c7df3ea-6b4c-43bb-933b-e6c3a6023f2c",
                        "entry_id": "e44806b0-9d3a-30d4-b99e-f715037f1193",
                        "tags": [
                            "plural"
                        ],
                        "form": "sémiologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68526b6a-c674-31d2-93a6-6d6f8dad9e69",
                        "entry_id": "e44806b0-9d3a-30d4-b99e-f715037f1193",
                        "glosses": [
                            "Description spécifique de systèmes de signes particuliers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1a7c4be-767e-45ab-9582-51e9eb2fcca6",
                                "sense_id": "68526b6a-c674-31d2-93a6-6d6f8dad9e69",
                                "text": "La théorie générale des signes a été baptisée sémiologie par Ferdinand de Saussure."
                            },
                            {
                                "example_id": "b38f3dad-6ea4-40e6-8121-fab6a0c2cc98",
                                "sense_id": "68526b6a-c674-31d2-93a6-6d6f8dad9e69",
                                "text": "Pas de sémiologie qui finalement ne s’assume comme une sémioclastie."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cf52637-0299-34c7-a851-4239e55f04b4",
                        "entry_id": "e44806b0-9d3a-30d4-b99e-f715037f1193",
                        "glosses": [
                            "Partie de la médecine qui traite des signes cliniques et des symptômes des maladies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b372a137-0222-44d8-8752-b9a0e14ac31d",
                                "sense_id": "9cf52637-0299-34c7-a851-4239e55f04b4",
                                "text": "Le patient n’aura conservé aucun souvenir conscient de votre visite et il vous saluera comme la première fois. Les externes en médecine qui découvrent ainsi la sémiologie neurologique répètent souvent à souhait ce test clinique abasourdissant. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 389)"
                            },
                            {
                                "example_id": "ea042e8c-b802-4ff5-9a37-2a239e7e827a",
                                "sense_id": "9cf52637-0299-34c7-a851-4239e55f04b4",
                                "text": "La sémiologie générale indique une incidence importante du traumatisme sexuel sur la sphère cognitive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ddf7097-b0a8-402b-a00e-3c8d6cda5c7f",
                        "source_entry_id": "e44806b0-9d3a-30d4-b99e-f715037f1193",
                        "source_sense_id": "68526b6a-c674-31d2-93a6-6d6f8dad9e69",
                        "source_sense_description": "Description spécifique de systèmes de signes particuliers",
                        "target_lang_word": "Semiotik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Semiotik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                        "entry_id": "c8b3ad5e-826c-3212-91d9-0921fb3c0e14",
                                        "glosses": [
                                            "Wissenschaft, die sich mit Zeichensystemen aller Art (zum Beispiel: Bilderschrift, Gestik, Formeln, Sprache, Verkehrszeichen) befasst und versucht, sie zu beschreiben und zu erklären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cf626e8-ef4f-45f3-bf78-17cb4e1c6701",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "Im Verkehrsunterricht lernt man die Semiotik der Straße, das heißt alle Verkehrszeichen. Im Unterschied dazu stehen die Verkehrsregeln, die nicht die Semiotik betreffen."
                                            },
                                            {
                                                "example_id": "9b0998b3-ab81-41db-b696-cd60a951417b",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "„Die Semiotik untersucht alle kulturellen Prozesse als Kommunikationsprozesse.“"
                                            },
                                            {
                                                "example_id": "23ce2dba-9cde-41bb-8b0b-9d1de2e8fa61",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "„Der Gegenstandsbereich der Semiotik - letztlich eine Art und Weise der Erweiterung unserer Wahrnehmung der Welt - ist der Austausch jedweder Nachrichten und der Zeichensysteme, die ihnen zugrunde liegen […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                        "entry_id": "c8b3ad5e-826c-3212-91d9-0921fb3c0e14",
                                        "glosses": [
                                            "Lehre von den Anzeichen für eine Erkrankung oder Verletzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c83a899-bf74-4bc1-8893-7adbed93534b",
                                                "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                                "text": "„Semiotik ist die Lehre von den Zeichen des widernatürlichen Zustandes.“"
                                            },
                                            {
                                                "example_id": "d621bf6f-e018-4937-930d-55ee7a3e82bd",
                                                "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                                "text": "„Die Lehre, welche die einzelnen Zeichen auf ihre Ursachen, oder auf die ihnen entsprechenden Veränderungen des lebenden Körpers zurückführt, und dabei das Verhältnis der einzelnen Zeichen unter einander berücksichtigt, ist die Semiotik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
