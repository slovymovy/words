                    {
                        "translation_id": "a34932e6-d5f4-4c23-b210-e9c25de16078",
                        "source_entry_id": "04ea7668-f2b8-3aeb-a782-d264a833cf04",
                        "source_sense_description": "where humans or other animals can live — see also inhabitable",
                        "target_lang_word": "bewohnbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bewohnbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7759dd7-980a-3a77-9a92-b2deb412a224",
                                        "entry_id": "f5f9ab58-f25d-3f86-aa6e-16658c23276a",
                                        "glosses": [
                                            "zum Bewohnen geeignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3884796f-8469-420e-8150-c7c82aa6c201",
                                                "sense_id": "b7759dd7-980a-3a77-9a92-b2deb412a224",
                                                "text": "„Ein internationales Forscherteam hat eine potenziell bewohnbare \"Super-Erde\" in einem nahen Sternsystem aufgespürt.“"
                                            },
                                            {
                                                "example_id": "761c77fb-6ce6-449d-b9cb-95404f83ca93",
                                                "sense_id": "b7759dd7-980a-3a77-9a92-b2deb412a224",
                                                "text": "„Seit November 2000 ist die ISS bewohnbar und Arbeitsplatz für ein kleines Astronauten-Team.“"
                                            },
                                            {
                                                "example_id": "81f0d535-918c-4610-9963-f2e6f38292f9",
                                                "sense_id": "b7759dd7-980a-3a77-9a92-b2deb412a224",
                                                "text": "Nach dem Brand ist mein Haus nicht mehr bewohnbar."
                                            },
                                            {
                                                "example_id": "781df45a-9aaf-4ace-aec6-fd52806b0f40",
                                                "sense_id": "b7759dd7-980a-3a77-9a92-b2deb412a224",
                                                "text": "„[…] zur guten Zukunft [unserer Kinder] gehören neben Bildung und berufliche Perspektiven vor allem ein bewohnbarer Planet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36dec9d1-0ad2-4346-b43e-1ec917249013",
                        "source_entry_id": "04ea7668-f2b8-3aeb-a782-d264a833cf04",
                        "source_sense_description": "where humans or other animals can live — see also inhabitable",
                        "target_lang_word": "habitabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habitabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7cf4f04-9083-3c83-bc3d-11acc99fc0a5",
                                        "entry_id": "ef6fb2be-ea24-3efb-bf8a-8d6ace27268b",
                                        "glosses": [
                                            "so, dass man es bewohnen kann; sicher und so beschaffen, dass Menschen oder andere Lebewesen dort (gut) leben können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cea0b66-f1f1-49ed-8644-f08885e922ac",
                                                "sense_id": "a7cf4f04-9083-3c83-bc3d-11acc99fc0a5",
                                                "text": "„Damit genügend radioaktive Elemente zur Verfügung stehen, um einen Karbonat-Silikat-Zyklus in Gang zu halten, muss sich der Planet vor Ablauf des kosmischen habitablen Alters bilden (welches allerdings noch 10 bis 20 Milliarden Jahre andauern wird).“"
                                            },
                                            {
                                                "example_id": "45537227-d81d-457b-94b0-819023172927",
                                                "sense_id": "a7cf4f04-9083-3c83-bc3d-11acc99fc0a5",
                                                "text": "Nach Ansicht von Vogt und seinen Kollegen wäre daher die habitabelste Zone auf der Planetenoberfläche der so genannte „Terminator“, der dünne Bereich zwischen Tag und Nacht, in dem ewige Dämmerung herrscht."
                                            },
                                            {
                                                "example_id": "7245dd7d-a506-476a-a5d9-bca67bdf3022",
                                                "sense_id": "a7cf4f04-9083-3c83-bc3d-11acc99fc0a5",
                                                "text": "„Wir wollen diesen Bereich so definieren, dass wir beispielsweise sagen können, er sei genau so bewohnbar oder aber weniger habitabel als eine Wüste in Marokko“, erklärt Hagermann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
