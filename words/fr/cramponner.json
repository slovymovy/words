    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "651bbd5a-5be9-3eae-a02d-65d53600a3be",
                    "sense_definition": "S'attacher ou s'agripper fortement à un appui pour ne pas tomber ou ne pas être entraîné.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la traversée mouvementée, le matelot a dû se <w>cramponner</w> à la rampe pour ne pas basculer."
                        },
                        {
                            "text": "Pris de panique au milieu de la falaise, l'alpiniste débutant se <w>cramponne</w> à une roche instable."
                        }
                    ],
                    "synonyms": [
                        "s'accrocher",
                        "s'agripper"
                    ],
                    "antonyms": [
                        "lâcher",
                        "se détacher"
                    ],
                    "common_phrases": [
                        "se cramponner à la rampe",
                        "se cramponner aux branches"
                    ]
                },
                {
                    "sense_id": "25dd7d8e-d91d-35eb-b145-1093efd864ae",
                    "sense_definition": "Rester attaché avec obstination à une opinion, un espoir ou une habitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux savant se <w>cramponne</w> à un espoir déraisonnable de voir son projet de recherche enfin financé."
                        },
                        {
                            "text": "Face aux critiques incessantes, la directrice se <w>cramponne</w> à ses convictions sans jamais céder à la panique."
                        }
                    ],
                    "synonyms": [
                        "s'accrocher",
                        "persister"
                    ],
                    "antonyms": [
                        "abandonner",
                        "renoncer"
                    ],
                    "common_phrases": [
                        "se cramponner à un espoir",
                        "se cramponner à ses convictions"
                    ]
                },
                {
                    "sense_id": "9433a3a8-8c78-3415-b686-b8bb8a2be63e",
                    "sense_definition": "Suivre ou accaparer une personne de manière insistante, collante et importune.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le début de la soirée, cet invité indiscret se <w>cramponne</w> à mon frère sans jamais le lâcher."
                        },
                        {
                            "text": "Ce démarcheur insistant tente de retenir les clients et les <w>cramponne</w> au seuil de leur propre maison."
                        }
                    ],
                    "synonyms": [
                        "coller",
                        "harceler",
                        "importuner"
                    ],
                    "antonyms": [
                        "lâcher"
                    ],
                    "common_phrases": [
                        "se cramponner à quelqu'un"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Sens figuré familier"
                        }
                    ]
                },
                {
                    "sense_id": "00f37451-80f1-3800-b677-d8ab13c0123d",
                    "sense_definition": "Fixer ou assujettir solidement un élément à l'aide d'un crampon de métal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le charpentier doit solidement <w>cramponner</w> cette lourde poutre pour consolider l'ensemble de la structure du toit."
                        },
                        {
                            "text": "Les maçons ont <w>cramponné</w> une grande pièce de métal contre le mur fissuré du vieux bâtiment."
                        }
                    ],
                    "synonyms": [
                        "assujettir",
                        "fixer"
                    ],
                    "antonyms": [
                        "détacher"
                    ],
                    "common_phrases": [
                        "cramponner une poutre"
                    ]
                },
                {
                    "sense_id": "cd040f07-249c-3c9b-b9d6-7231d61bb3ed",
                    "sense_definition": "Munir ou équiper des chaussures ou des semelles de crampons pour l'alpinisme ou le sport.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant l'ascension du sommet enneigé, chaque randonneur doit <w>cramponner</w> ses grosses bottes de marche avec soin."
                        },
                        {
                            "text": "Ce spécialiste de l'équipement explique comment <w>cramponner</w> correctement une semelle pour marcher sur la glace vive."
                        }
                    ],
                    "common_phrases": [
                        "cramponner des chaussures"
                    ]
                },
                {
                    "sense_id": "d2ced486-2ff9-39de-8b91-02e7a8b88450",
                    "sense_definition": "Garnir de crampons les fers d'un équidé afin de lui éviter de glisser sur la glace ou la neige.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par grand froid, le maréchal-ferrant préfère <w>cramponner</w> les fers du cheval pour lui éviter de glisser sur le verglas."
                        },
                        {
                            "text": "Le cocher a demandé de <w>cramponner</w> les sabots des bêtes avant d'emprunter cette route forestière totalement gelée."
                        }
                    ],
                    "common_phrases": [
                        "cramponner des fers"
                    ]
                }
            ]
        }
    ]
