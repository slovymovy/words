                                                "sense_id": "08d2e4bf-b1ce-36ad-be6b-97098ec38174",
                                                "text": "La scolie de Callistrate sur Harmodius et Aristogiton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
