                    {
                        "sense_id": "153a3aaa-b026-399c-ae1e-0a365d5bd930",
                        "entry_id": "bf580f7f-f1bf-3a19-bab1-8c47db842816",
                        "glosses": [
                            "Person, die ein Handwerk erlernt und darin die Gesellenprüfung bestanden hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b91adc2d-bcb6-4526-9a68-85ff43d807a5",
                                "sense_id": "153a3aaa-b026-399c-ae1e-0a365d5bd930",
                                "text": "„Die beiden Handwerksgesellen, zu denen Herbert kein rechtes Verhältnis findet, vervollständigen das Bild der in allen Schichten anzutreffenden richtungslosen Jugend.“"
                            },
                            {
                                "example_id": "81bac736-f8d9-435d-ac27-8e3f438949f9",
                                "sense_id": "153a3aaa-b026-399c-ae1e-0a365d5bd930",
                                "text": "„An die tausend Handwerksgesellen und Dienstleute liefen vor dem Rathaus zusammen, wurden jedoch von Söldnern auseinandergetrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
