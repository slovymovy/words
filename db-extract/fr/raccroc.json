        "fr-extract.jsonl": [
            {
                "entry_id": "c744de3f-887c-3c26-8534-09cd4383eb01",
                "word": "raccroc",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "54ab4038-7bfc-4db9-b540-9775972191a3",
                        "entry_id": "c744de3f-887c-3c26-8534-09cd4383eb01",
                        "tags": [
                            "plural"
                        ],
                        "form": "raccrocs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "244f9b92-dc62-30af-9c72-ef00b8e56164",
                        "entry_id": "c744de3f-887c-3c26-8534-09cd4383eb01",
                        "glosses": [
                            "Action d’attraper au hasard ; coup heureux où il y a plus de chance que d’adresse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73fdcc28-e5c1-4a43-bdcc-5dc24dd6e29d",
                                "sense_id": "244f9b92-dc62-30af-9c72-ef00b8e56164",
                                "text": "Il n’a obtenu ce succès que par raccroc."
                            },
                            {
                                "example_id": "197f3e12-19ad-4e41-bdaf-13bebf67b216",
                                "sense_id": "244f9b92-dc62-30af-9c72-ef00b8e56164",
                                "text": "Cela me désoriente de penser que je ne suis un artiste que par raccroc. Cette certitude creuse un vide dans mes pensées et c'est ce vide qui est mon moi..."
                            },
                            {
                                "example_id": "1cc6b6de-37c5-4af6-9684-fe6a11bab764",
                                "sense_id": "244f9b92-dc62-30af-9c72-ef00b8e56164",
                                "text": "Ce qui tombe du haut d’une grande ville en bas, les filtrations, les dégagements, les miettes d’idées et de connaissances, ce que roule l’air subtil et le ruisseau chargé d’une capitale, le frottement à l’imprimé, des bouts de feuilletons avalés entre deux chopes, des morceaux de drames entendus au boulevard, avait mis en lui cette intelligence de raccroc qui, sans éducation, s’apprend tout."
                            }
                        ]
                    },
                    {
                        "sense_id": "66722b71-1d3c-3d92-86f5-5f041290ea70",
                        "entry_id": "c744de3f-887c-3c26-8534-09cd4383eb01",
                        "glosses": [
                            "Coup réussi par hasard, au billard."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0b1243ec-6cd2-3f73-ace3-232bea7e96a9",
                        "entry_id": "c744de3f-887c-3c26-8534-09cd4383eb01",
                        "glosses": [
                            "Racolage en parlant des prostituées."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "480fd8ca-bc7e-40f5-907e-80ae09050066",
                                "sense_id": "0b1243ec-6cd2-3f73-ace3-232bea7e96a9",
                                "text": "D’inquiétantes silhouettes, dans l’ombre bleue, les lumières, le grouillement, se perdaient pour réapparaître et se dérober encore, au milieu du raccroc obstiné des femmes."
                            }
                        ]
                    }
                ],
