                                                "sense_id": "63c4fc06-8dad-372d-a865-6a8076ba75c3",
                                                "text": "Best and largest collection of tatting work, not less than seven different articles, five dollars; best tatting collar, two dollars; […] best three tatting doylies, two dollars, Mrs. J. M. Junkin, Fairfield."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76b85708-57f7-3cf1-afaa-44c1e134b5c0",
                                        "entry_id": "c9d980f9-1b3c-3164-886a-2a5d41e3fe77",
                                        "glosses": [
                                            "The art of making such lace."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c89011ff-393a-47b4-b348-fb2ad7d4e5d8",
                                                "sense_id": "76b85708-57f7-3cf1-afaa-44c1e134b5c0",
                                                "text": "While crocheting is the most popular feature in art needle work, tatting has now entered the field with such vigor that crocheting does not monopolize the situation."
                                            }
                                        ]
                                    }
                                ]
