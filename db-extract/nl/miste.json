            {
                "entry_id": "f7769bcb-98a1-38b3-9ddf-e7fca9a54080",
                "word": "miste",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c7d2fd53-15cd-33e0-b773-3a87d4c8ea32",
                        "entry_id": "f7769bcb-98a1-38b3-9ddf-e7fca9a54080",
                        "glosses": [
                            "enkelvoud verleden tijd van missen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "86ba74dc-7f6d-4eb0-a483-f7d731e0d1ae",
                                "sense_id": "c7d2fd53-15cd-33e0-b773-3a87d4c8ea32",
                                "text": "Ik miste."
                            },
                            {
                                "example_id": "31caf3d4-d752-4783-a8d9-68b48a054288",
                                "sense_id": "c7d2fd53-15cd-33e0-b773-3a87d4c8ea32",
                                "text": "Jij miste."
                            },
                            {
                                "example_id": "fcfdf803-c1f6-4904-ba8f-e25d2296aa65",
                                "sense_id": "c7d2fd53-15cd-33e0-b773-3a87d4c8ea32",
                                "text": "Hij, zij, het miste."
                            },
                            {
                                "example_id": "325db023-5d7a-48bd-ac3b-e2abad519d3c",
                                "sense_id": "c7d2fd53-15cd-33e0-b773-3a87d4c8ea32",
                                "text": "Hij had jaren gespaard om de PCT te kunnen lopen en – ook al miste hij zijn dochter – niks kon hem tegenhouden om Canada te bereiken."
                            },
                            {
                                "example_id": "c4b2f134-0f62-4247-8966-7140c96a19e8",
                                "sense_id": "c7d2fd53-15cd-33e0-b773-3a87d4c8ea32",
                                "text": "Hij belde me eens per week vanuit New York, zei dat hij me miste en vroeg me waarom ik niet naar hem toe kwam - maar ik was waar ik wilde zijn, en eerlijk gezegd zou ik mijn werk meer hebben gemist dan ik Lawrie miste."
                            },
                            {
                                "example_id": "cdd1d9ea-72ef-413c-b300-bc45e54e2b45",
                                "sense_id": "c7d2fd53-15cd-33e0-b773-3a87d4c8ea32",
                                "text": "Tijdens onze eerste ontmoeting op de smalle overloop van dat hotel in Le Puy-en-Velay had hij moeten vertellen wie hij was, maar hij zweeg en miste het moment, waarna zijn leugen al was geboren."
                            }
                        ]
                    },
