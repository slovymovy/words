                "senses": [
                    {
                        "sense_id": "5c5ae940-4da9-35ca-8a5f-1eb728018b03",
                        "entry_id": "d00e4cc5-360a-3076-ac8c-6a5fe03220eb",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c246de47-0b7d-4492-8f6d-927304e778be",
                                "sense_id": "5c5ae940-4da9-35ca-8a5f-1eb728018b03",
                                "text": "„Bereitschaftsleiter Stefan Radies hieß 15 Bereitschafts-Mitglieder in der Turnhalle in Püchersreuth willkommen.“"
                            },
                            {
                                "example_id": "fb353c46-5c46-4eee-98dc-e469c1cd6d78",
                                "sense_id": "5c5ae940-4da9-35ca-8a5f-1eb728018b03",
                                "text": "„Mit Stefan Radies übernimmt ein ganz besonderer Macher aus dem Landkreis das Mikro.“"
                            },
                            {
                                "example_id": "ba8bee3b-2240-4728-a4e6-8827cfa392b4",
                                "sense_id": "5c5ae940-4da9-35ca-8a5f-1eb728018b03",
                                "text": "„1946 haben sich Erwin und Ilse Radies in Engter kennengelernt.“"
                            },
                            {
                                "example_id": "4fdf46f5-671c-4548-aef5-7f1451fe1380",
                                "sense_id": "5c5ae940-4da9-35ca-8a5f-1eb728018b03",
                                "text": "„Die Kirche der Seelsorgeeinheit Ellwangen feierte gemeinsam mit zahlreichen Gästen den 90. Geburtstag von Prälat Werner Radies in der Basilika St. Vitus.“"
                            },
                            {
                                "example_id": "7c3a305d-da69-40a7-be9a-2dcc6988747f",
                                "sense_id": "5c5ae940-4da9-35ca-8a5f-1eb728018b03",
                                "text": "„Dabei seien vorerst keine weiteren Neueröffnungen in Deutschland geplant, so PR-Managerin Anne Radies.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
