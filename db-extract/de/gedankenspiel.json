                ],
                "senses": [
                    {
                        "sense_id": "73d5c442-e66b-3d45-a029-fa16af081c3c",
                        "entry_id": "a469193d-ffde-31aa-a0b4-c8f78274849f",
                        "glosses": [
                            "Überlegung dazu, wie etwas sein könnte/sollte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c1b09f4-5fe8-45ad-952c-8ae56022d25c",
                                "sense_id": "73d5c442-e66b-3d45-a029-fa16af081c3c",
                                "text": "„Zum Gedankenspiel, die Quotenmessung abzuschaffen [, …] sagte Friedrich Küppersbusch: ‚Es würde sich gar nichts ändern.‘“"
                            },
                            {
                                "example_id": "3379482a-929d-4c28-b95a-7a063fe79228",
                                "sense_id": "73d5c442-e66b-3d45-a029-fa16af081c3c",
                                "text": "„Die Mimik selbst, das heißt, das Vermögen, durch Bewegungen das Mienen- und Gebärdenspiel, das Gedankenspiel und den Willen abzubilden, beruht auf Ahmung.“"
                            },
                            {
                                "example_id": "61c522a1-3bfe-4440-a0fd-3cfd157d7df5",
                                "sense_id": "73d5c442-e66b-3d45-a029-fa16af081c3c",
                                "text": "„Der Philosoph folgt in Gedankenspielen dem Warum alles Seienden.“"
                            },
                            {
                                "example_id": "525ccdd7-32ba-461e-a3b1-2bbe3f0c6531",
                                "sense_id": "73d5c442-e66b-3d45-a029-fa16af081c3c",
                                "text": "„Von solchen machtpolitischen Gedankenspielen und ihren indirekten Folgen drang nichts über die inneren Zirkel der Macht und ihr direktes Umfeld hinaus; es hätten sich auch wenige dafür interessiert.“"
                            },
                            {
                                "example_id": "d66cb9fd-a820-4dc1-abcd-36afdf091a09",
                                "sense_id": "73d5c442-e66b-3d45-a029-fa16af081c3c",
                                "text": "„Sie schauderte, als sie an Schefold dachte, an die Konsequenzen, die sich für ihn ergaben, und zwar nur, weil sie, Käthe, sich in eine Affäre eingemischt hatte, die ohne sie ein Gedankenspiel geblieben wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
