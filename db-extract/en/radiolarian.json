                "entry_id": "6d02c425-938c-38df-b6ec-1e49a615e710",
                "word": "radiolarian",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7c6c78bb-4506-48a2-9c11-27e65e5fadfc",
                        "entry_id": "6d02c425-938c-38df-b6ec-1e49a615e710",
                        "tags": [
                            "plural"
                        ],
                        "form": "radiolarians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ed00aab0-b552-37f4-aa3c-ae23ae1de472",
                        "entry_id": "6d02c425-938c-38df-b6ec-1e49a615e710",
                        "glosses": [
                            "Any of many marine amoeboid protozoa, of subclass Radiolaria, having filamentous pseudopodia; they have intricate silica skeletons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b21bc9d-bfeb-47e7-8625-381d5f53f6d2",
                                "sense_id": "ed00aab0-b552-37f4-aa3c-ae23ae1de472",
                                "text": "Water wells inkblack in the streets repeating the polelamps in glozy rosettes that dish and slide in the wash like radiolarians pale with phosphorous on a midnight sea."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49a4f3bc-4c35-4d8b-be13-4f8f56328cbd",
                        "source_entry_id": "6d02c425-938c-38df-b6ec-1e49a615e710",
                        "source_sense_id": "ed00aab0-b552-37f4-aa3c-ae23ae1de472",
                        "source_sense_description": "marine protozoa",
                        "target_lang_word": "radiolaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radiolaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "693cd3fe-291c-3463-b741-3d279f2e1a9e",
                                        "entry_id": "124f5498-033a-35c7-bf62-9a243f58cb9f",
                                        "glosses": [
                                            "Zooplancton protiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2409e23-c499-4f3f-87cf-5c2113bf99c3",
                                                "sense_id": "693cd3fe-291c-3463-b741-3d279f2e1a9e",
                                                "text": "Seuls les radiolaires polycystines sont préservés à l’état fossile, donc étudiés par les paléontologues."
                                            },
                                            {
                                                "example_id": "10b4ddde-085e-4ee1-b295-6d48c548549d",
                                                "sense_id": "693cd3fe-291c-3463-b741-3d279f2e1a9e",
                                                "text": "Parmi les diatomées radiolaires, de très nombreuses espèces possèdent une enveloppe adoptant la forme d'un polyèdre platonicien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a21e9bb9-bf66-4f17-83fc-badfe4cfabc1",
                        "source_entry_id": "6d02c425-938c-38df-b6ec-1e49a615e710",
                        "source_sense_id": "ed00aab0-b552-37f4-aa3c-ae23ae1de472",
                        "source_sense_description": "marine protozoa",
                        "target_lang_word": "Strahlentierchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fe61ba5d-5a26-47ab-b0fa-595bdffdedc5",
                        "source_entry_id": "6d02c425-938c-38df-b6ec-1e49a615e710",
                        "source_sense_id": "ed00aab0-b552-37f4-aa3c-ae23ae1de472",
                        "source_sense_description": "marine protozoa",
                        "target_lang_word": "Radiolarie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radiolarie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b32a65b1-92ce-376e-858a-5764d9193c4c",
                                        "entry_id": "429e471a-93c4-3909-becd-f5fb4310d3e8",
                                        "glosses": [
                                            "zu den Wurzelfüßlern zählende Protozoen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca04be27-44c4-436c-82ef-9bfd8e016116",
                                                "sense_id": "b32a65b1-92ce-376e-858a-5764d9193c4c",
                                                "text": "Radiolarien sind Protozoen mit fadenförmigen Scheinfüßchen und einem inneren Skelett aus Kieselsäure."
                                            },
                                            {
                                                "example_id": "7e211caf-927a-4bda-ba93-d3e8ed3f28c1",
                                                "sense_id": "b32a65b1-92ce-376e-858a-5764d9193c4c",
                                                "text": "Ernst Haeckels \"Kunstformen der Natur\" haben die Radiolarien so richtig berühmt gemacht."
                                            },
                                            {
                                                "example_id": "89a7a3d1-1c5d-4677-9d6a-9fdd6e86874f",
                                                "sense_id": "b32a65b1-92ce-376e-858a-5764d9193c4c",
                                                "text": "„Es handelt sich hierbei um Einzeller (Protozoen) wie die Foraminiferen (mit Kalkschale) und die Radiolarien (Skelett aus Kieselsäure), um Coelenteraten wie Medusen und Quallen, um Rädertierchen, Würmer aus der Gruppe der Anneliden und der Chaetognathen sowie zahlreiche Krustentiere, unter den die Copepoden überwiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
