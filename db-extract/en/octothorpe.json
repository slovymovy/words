                ],
                "senses": [
                    {
                        "sense_id": "9e99a934-425f-3999-a440-7c79fc5f1a31",
                        "entry_id": "2921babd-5eda-3b16-b5ab-d98cb7425375",
                        "glosses": [
                            "The hash or square symbol #, used mainly in telephony and computing."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "7e43332a-dcbd-4b48-92eb-9183c18200a1",
                                "sense_id": "9e99a934-425f-3999-a440-7c79fc5f1a31",
                                "text": "The pad 1 provides keys for numerals 0 to 9, while the sextile or asterisk (*) key is decoded to provide a decimal point and the octothorp ( # ) key generates a command to send the contents of the memory unto the telephone line through a send circuit 7, a coupling circuit 8 and the hybrid network 2."
                            },
                            {
                                "example_id": "3ebc4066-5c66-42e0-be77-efb9267cf004",
                                "sense_id": "9e99a934-425f-3999-a440-7c79fc5f1a31",
                                "text": "Octothorp is the # on a push-button telephone. Rumor at the telephone company is that a man named Charles B. Octothorp, wanting to make his name famous, would approach anyone with a Touch-Tone ’phone, stop, and say admiringly, “That’s a mighty handsome octothorp you have there.”"
                            },
                            {
                                "example_id": "ca8e42dc-d5bc-4a47-b871-0e00fc17e446",
                                "sense_id": "9e99a934-425f-3999-a440-7c79fc5f1a31",
                                "text": "Strings are enclosed in double quotation marks, numbers are not enclosed in anything, and dates and Boolean values are enclosed between octothorpe (#) characters."
                            }
                        ]
                    }
                ],
