                "senses": [
                    {
                        "sense_id": "dbc83ce5-128a-322b-95a3-07bff99f09d2",
                        "entry_id": "de19580a-8535-35d6-a0ae-dd76e66c9ffe",
                        "glosses": [
                            "eine Fürsprecherin, Beraterin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef53ef0-1695-4560-8636-9846059cb7b0",
                                "sense_id": "dbc83ce5-128a-322b-95a3-07bff99f09d2",
                                "text": "Eine Mentorin sollte viel Erfahrung besitzen."
                            },
                            {
                                "example_id": "3dfb26d5-247e-4992-a20a-5562471dd910",
                                "sense_id": "dbc83ce5-128a-322b-95a3-07bff99f09d2",
                                "text": "„Die 43-Jährige ist keine Erzieherin, keine Nachhilfelehrerin, kein Babysitter, sondern Mandys Mentorin: jemand, der vor allem Zeit mit ihr verbringt, exklusiv und regelmäßig. „Eine Erweiterung des Beziehungsangebots“, so nennt Oliver Wenninger es.“"
                            },
                            {
                                "example_id": "8e25c194-a3b7-4578-bc39-cec193d0e990",
                                "sense_id": "dbc83ce5-128a-322b-95a3-07bff99f09d2",
                                "text": "„Roth schloss eine tiefe Freundschaft mit seiner Mentorin für politische Literatur, und als Blair Clark sie im Sommer 1978 wegen ihres Alkoholkonsums verließ, lud Roth sie zum Ausnüchtern nach Connecticut ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
