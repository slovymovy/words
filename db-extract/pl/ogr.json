                                        "sense_id": "2995c645-d5ea-3380-b4c8-6a95de2c7df6",
                                        "entry_id": "42093a92-5d23-39bd-878c-51dae493a1c5",
                                        "glosses": [
                                            "troll v knihách J. R. R. Tolkiena; zlý obr, který se na slunci mění v kámen"
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdbf5a55-1fa8-4c06-9297-d4323269cffb",
                                                "sense_id": "2995c645-d5ea-3380-b4c8-6a95de2c7df6",
                                                "text": "Když zlobry zastihl úsvit, proměnili se v kámen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6ce3d2a-3cba-390a-b131-47b4602fd8b0",
                                        "entry_id": "42093a92-5d23-39bd-878c-51dae493a1c5",
                                        "glosses": [
                                            "obr lidožrout"
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36aa468d-07c6-4c1c-9875-12f9ed62a1e9",
                                                "sense_id": "d6ce3d2a-3cba-390a-b131-47b4602fd8b0",
                                                "text": "Shrek je hodný zlobr."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8a8a622-9844-4496-8332-d6111aca519b",
                        "source_entry_id": "251ea0db-639b-3da9-b292-e18ea641fab5",
