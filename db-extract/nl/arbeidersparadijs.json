                        "examples": [
                            {
                                "example_id": "5e541593-03fe-402b-8cc3-55344d6ee42f",
                                "sense_id": "de6f5019-88c8-3063-bd74-dd9225cddd49",
                                "text": "Wel knepen ze hun ogen samen tot spleetjes van afgunst over alles wat Marten en ik invoerden in hun arbeidersparadijs van de grote schaarste."
                            },
                            {
                                "example_id": "2a13e2c9-0f8a-4afb-91a1-a7accfe1f9df",
                                "sense_id": "de6f5019-88c8-3063-bd74-dd9225cddd49",
                                "text": "China geldt als de laatste bondgenoot van het 'arbeidersparadijs' Noord-Korea, maar Peking reageerde erg geïrriteerd op Pyongyangs laatste proef. Rusland heeft volgens diplomaten al aangegeven de tekst te kunnen ondersteunen. Onderminister van Buitenlandse Zaken Gennadi Gatilov zei dat 'de ontwerptekst aanvaardbaar zal zijn wanneer de beperkende maatregelen (sancties) uitsluitend betrekking hebben op het gebied van raketten en nucleaire zaken'."
                            }
