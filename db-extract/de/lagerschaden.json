                        "glosses": [
                            "Beeinträchtigung der Qualität einer Ware durch ungünstige Lagerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08691064-c66f-41e6-a35b-3b4bc19f947c",
                                "sense_id": "b679dc6c-7e89-31e8-8d96-22c4b79b14e7",
                                "text": "Die Ware bleib so lange liegen, dass sie schließlich eine Menge Lagerschäden aufwies."
                            },
                            {
                                "example_id": "b1c80783-3d71-4f04-acc0-a1d2375e572f",
                                "sense_id": "b679dc6c-7e89-31e8-8d96-22c4b79b14e7",
                                "text": "„Dieses Buch präsentiert Lagerschäden an Äpfeln in Wort und Bild.“"
                            },
                            {
                                "example_id": "439a8df8-b2ef-497c-aefb-aabee02c9a07",
                                "sense_id": "b679dc6c-7e89-31e8-8d96-22c4b79b14e7",
                                "text": "„Es dürfen keine Feuchtigkeits- oder sonstige Lagerschäden vorhanden sein. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
