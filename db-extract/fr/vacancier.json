                                        "entry_id": "9601827f-4370-34c7-9761-8a0cc73b4d2e",
                                        "glosses": [
                                            "Someone who is taking a holiday (recreational trip away from home)."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f228fbf5-c3ab-4aa2-ba00-affd9c8dc68a",
                                                "sense_id": "6f6710ec-5532-3a6b-8ff6-8fefab3285ee",
                                                "text": "The Tippers were not natural holidayers."
                                            }
