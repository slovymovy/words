                "senses": [
                    {
                        "sense_id": "abea8d01-652f-3b45-b9ce-e5498e108472",
                        "entry_id": "d6ed4cfb-c6b1-3e79-8583-c3598517107a",
                        "glosses": [
                            "Construire des installations en bois sans clou sans vis, en particulier en assemblant avec des tenons et des mortaises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f93dd2b-6e37-4599-bc7c-b1b5c46d3463",
                                "sense_id": "abea8d01-652f-3b45-b9ce-e5498e108472",
                                "text": "Rendez-vous à 8h. place de Verdun à Pau, il faut aller chercher du matériel au local histoire d'avoir de quoi dormir, cuisiner et… froissarter !"
                            },
                            {
                                "example_id": "c4a8ea58-1b44-4856-8005-765875909f9a",
                                "sense_id": "abea8d01-652f-3b45-b9ce-e5498e108472",
                                "text": "Il doit froissarter chez lui durant l'année, c'est sûr."
                            },
                            {
                                "example_id": "f79da36a-dfbb-465f-b240-68823a17f294",
                                "sense_id": "abea8d01-652f-3b45-b9ce-e5498e108472",
                                "text": "Tout les éclés étaient là ce jour pour \"froissarter\"."
                            }
                        ]
                    }
