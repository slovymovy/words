                "senses": [
                    {
                        "sense_id": "0b1fb7b0-9847-3be0-946c-0c5344656cd4",
                        "entry_id": "65ab6495-d6ed-3d8c-9b54-e6ef4120323e",
                        "glosses": [
                            "Qui concerne l’ordre des Chartreux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b6b9b6-72d0-4d79-8f8e-8aec851528cd",
                                "sense_id": "0b1fb7b0-9847-3be0-946c-0c5344656cd4",
                                "text": "On peut citer encore la fondation d’une autre fraternité, au cours de cette même période des années 1970 : la famille monastique de Bethléem et de l’Assomption de la Vierge, directement inspirée de la tradition chartreuse."
                            }
                        ]
                    }
                ],
