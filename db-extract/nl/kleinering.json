                        "entry_id": "1d7283b0-1a45-347b-819e-b0a4c571148f",
                        "glosses": [
                            "handeling waarmee men iemand niet met de gepaste hoeveelheid eerbied en respect behandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef3ccc7-0cb2-459b-a464-c58a95099239",
                                "sense_id": "0049a015-03ee-3d38-9688-4bf0c677f4dd",
                                "text": "\" Dat was een steek onder water, gericht op zijn overdreven familietrots, die zij als een kleinering van de Tudors beschouwde."
                            },
                            {
                                "example_id": "0c6b8b78-7020-49ce-b476-fc6e34b7a434",
                                "sense_id": "0049a015-03ee-3d38-9688-4bf0c677f4dd",
                                "text": "De parlementaire commissaris voor omgangsvormen, Kathryn Stone, deed onderzoek naar het gedrag van Bercow naar aanleiding van tientallen beschuldigingen van drie huidige en vroegere medewerkers van het Lagerhuis. Die gingen over kleinering, belediging, intimidatie, machtsmisbruik, woede-uitbarstingen en in een geval het gooien met een mobiele telefoon."
                            }
                        ]
                    }
