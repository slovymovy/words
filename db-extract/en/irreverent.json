                                        "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                        "entry_id": "22bcd000-0015-36fd-b5a8-4c4c1483684d",
                                        "glosses": [
                                            "ohne Respekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38dfdd90-de43-4cf1-b861-d0693cca764b",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "Sein respektloses Verhalten gegenüber dem Lehrer hatte Konsequenzen."
                                            },
                                            {
                                                "example_id": "86cdd514-9b04-4a1a-81cb-ba6c796cbc0f",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Ein Kunde einer Pizzeria dürfte einen gehörigen Schock erlebt haben, als sein Blick auf den Kassenzettel fiel: Ein Angestellter des Restaurants hatte darauf respektlose Worte hinterlassen.“"
                                            },
                                            {
                                                "example_id": "d0694205-8972-41a7-978c-71f6e73da939",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Double-Gewinner Niko Kovac vom FC Bayern München hat einen respektlosen Umgang mit den Fußball-Trainern in der Bundesliga beklagt.“"
                                            },
                                            {
                                                "example_id": "3d5dd527-f2f3-40ed-80e6-5802f61e0943",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Über Trumps respektlosen Umgang mit verheirateten Frauen hat auch Trumps ehemalige Geschäftspartnerin Jill Harth berichtet, die über einen längeren Zeitraum von ihm sexuell belästigt worden sein soll.“"
                                            },
                                            {
                                                "example_id": "0b5fdaf6-f058-429a-b0b9-cb023ee2c910",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Diskus-Olympiasieger Christoph Harting hat nach seinen respektlosen Äußerungen und herablassenden Sprüchen über Verband und Konkurrenten offenbar einen Denkzettel erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
