                                        "entry_id": "4faf2bcf-7087-3ee6-8603-575ef525c47f",
                                        "glosses": [
                                            "To completely empty."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "925fe5b2-8487-4ece-8e9b-0c5c6c6856c9",
                                                "sense_id": "7365ae9a-d067-320e-bac5-234d1cc208e8",
                                                "text": "Clear out your e-mail inbox to make more space."
                                            },
                                            {
                                                "example_id": "45013b2a-4173-424a-a4f1-a85f41f3f315",
                                                "sense_id": "7365ae9a-d067-320e-bac5-234d1cc208e8",
                                                "text": "We had to clear out the attic so the guest could sleep there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "943c23f1-ebad-33a5-b603-9c59ed6df44e",
                                        "entry_id": "4faf2bcf-7087-3ee6-8603-575ef525c47f",
                                        "glosses": [
                                            "To rob or steal from (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7519735a-353f-4279-b1ba-84c0f96daa13",
                                                "sense_id": "943c23f1-ebad-33a5-b603-9c59ed6df44e",
                                                "text": "Kelly disappeared last night, and she cleared me out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ba1285e-a6fc-34c6-b7d5-31632a85b989",
                                        "entry_id": "4faf2bcf-7087-3ee6-8603-575ef525c47f",
                                        "glosses": [
                                            "To be victorious in gambling against (someone); to financially ruin (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17f21ec4-b801-495e-a202-173458fb2dad",
                                                "sense_id": "9ba1285e-a6fc-34c6-b7d5-31632a85b989",
                                                "text": "I don't have any money, Betty cleared me out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cafc921d-c106-3f5c-bd2f-a60b85e23fd3",
                                        "entry_id": "4faf2bcf-7087-3ee6-8603-575ef525c47f",
                                        "glosses": [
                                            "to remove or eject (from), especially forcibly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e678e1ed-5e56-4516-a1cb-980e3ced9da8",
                                                "sense_id": "cafc921d-c106-3f5c-bd2f-a60b85e23fd3",
                                                "text": "The police cleared the crowd out of the street to investigate the accident."
                                            },
                                            {
                                                "example_id": "5382999c-df40-4ddc-b845-396e93819835",
                                                "sense_id": "cafc921d-c106-3f5c-bd2f-a60b85e23fd3",
                                                "text": "We need to get the trees cleared out the way before anything can drive down this path."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f50210-8f94-3181-8842-508d5aa877f4",
                                        "entry_id": "4faf2bcf-7087-3ee6-8603-575ef525c47f",
                                        "glosses": [
                                            "To leave quickly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0ad4939-d3b9-4f2a-9353-85c77a87ca63",
                                                "sense_id": "17f50210-8f94-3181-8842-508d5aa877f4",
                                                "text": "They cleared out as soon as the cops arrived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebdc9831-47c3-31d4-be96-db8092c5a565",
                                        "entry_id": "4faf2bcf-7087-3ee6-8603-575ef525c47f",
                                        "glosses": [
                                            "To become empty."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2331a6ab-33fc-4f7e-8187-6da58efd69fa",
                                                "sense_id": "ebdc9831-47c3-31d4-be96-db8092c5a565",
                                                "text": "The town is packed in the summer, but clears out in the winter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
