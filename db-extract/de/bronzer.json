                ],
                "senses": [
                    {
                        "sense_id": "1fe6d47f-7d6e-3bf5-a5e8-ff98dc347f68",
                        "entry_id": "94f79887-c602-3fd4-9926-9bfafb065a5f",
                        "glosses": [
                            "Creme/Fluid/Puder, das auf die Haut aufgetragen einen gebräunten, dunkleren Hautton bewirkt, manchmal auch zusätzlich einen schimmernden Effekt schafft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6297f4f-5f77-4469-bb7e-cee6b040983d",
                                "sense_id": "1fe6d47f-7d6e-3bf5-a5e8-ff98dc347f68",
                                "text": "„Bronzer verleiht der Haut eine schöne Bräune. Mit Bronzer bringt ihr euren Teint zum Strahlen und könnt Farbunterschiede, vor allem am Hals, ausgleichen.“"
                            },
                            {
                                "example_id": "65b00417-aa97-41d5-963b-843cc2693399",
                                "sense_id": "1fe6d47f-7d6e-3bf5-a5e8-ff98dc347f68",
                                "text": "„Zu viel oder an den falschen Stellen aufgetragen kann Bronzer schnell unnatürlich oder wie aufgemalt wirken.“"
                            },
                            {
                                "example_id": "fd059b57-4547-4c35-b34c-22e78b1d978d",
                                "sense_id": "1fe6d47f-7d6e-3bf5-a5e8-ff98dc347f68",
                                "text": "„Bronzer sollte an Wangen, Nase, Stirn und Kinn aufgetragen werden.“"
                            },
                            {
                                "example_id": "e76c239a-36b6-4dfc-bf45-ef46f7959b50",
                                "sense_id": "1fe6d47f-7d6e-3bf5-a5e8-ff98dc347f68",
                                "text": "„Er bringt pudrige Produkte wie Highlighter, Bronzer oder Rouge in einer Bewegung gezielt an die richtigen Stellen im Gesicht.“"
                            },
                            {
                                "example_id": "fbaccef9-060d-49f1-8bbc-86d6c819201f",
                                "sense_id": "1fe6d47f-7d6e-3bf5-a5e8-ff98dc347f68",
                                "text": "„Mit dem Konturen-Pinsel könnt ihr ganz mühelos euer Puder oder Bronzer verblenden und sorgt gleichzeitig für einen perfekten Teint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
