                "senses": [
                    {
                        "sense_id": "1273466b-3160-3018-82ba-4e2bbc1beff0",
                        "entry_id": "97e924ef-01d6-3e30-8c79-b3f6e80aab0a",
                        "glosses": [
                            "Tumeur cutanée, molle, fibreuse, plane ou faisant saillie dont la taille peut aller jusqu’à 5cm de diamètre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddbb4999-07be-4d23-b3e3-8792ce1c36a4",
                                "sense_id": "1273466b-3160-3018-82ba-4e2bbc1beff0",
                                "text": "La coupe de la tumeur nous apprit qu'il s'agissait bien d'un d'un molluscum dans lequel les éléments fibreux étaient prédominants."
                            }
                        ]
                    },
                    {
                        "sense_id": "b115eea9-00db-3bb3-819f-24034ae1ae83",
                        "entry_id": "97e924ef-01d6-3e30-8c79-b3f6e80aab0a",
                        "glosses": [
                            "Molluscum contagiosum : Affection cutanée, contagieuse, due à des poxvirus. Elle se caractérise par de petites élévations molles et blanchâtres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "500d46d5-fef2-4a44-a909-5a31a669b008",
                                "sense_id": "b115eea9-00db-3bb3-819f-24034ae1ae83",
                                "text": "Lésion de la pointe du nez (avec un molluscum contagiosum) invalidante sur le plan esthétique."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d0a8e54-685c-3b05-90ba-998d165b2abd",
                        "entry_id": "97e924ef-01d6-3e30-8c79-b3f6e80aab0a",
                        "glosses": [
                            "Molluscum pendulum : sorte de nævus flasque, parfois pédonculé qui apparaît généralement au niveau du cou ou du dos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ae0453-a8c3-4d7a-884b-70150169949c",
                                "sense_id": "3d0a8e54-685c-3b05-90ba-998d165b2abd",
                                "text": "Les molluscum pendulum s'observent fréquemment dans les aines, en particulier chez les hommes obèses. Ils peuvent s'accrocher dans les vêtements, saigner et s'infecter."
                            }
                        ]
                    }
