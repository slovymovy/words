    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f3ccf71-4294-3069-92bc-93d3ef8d6f2a",
                    "sense_definition": "Tending to be easily frightened; shy or lacking confidence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fearful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>timorous</w> child hid behind his mother when the strangers arrived at the house.",
                            "target_lang_translations": {
                                "ru": "<w>Робкий</w> ребёнок спрятался за мать, когда в дом пришли незнакомцы."
                            }
                        },
                        {
                            "text": "She took a few <w>timorous</w> steps onto the stage before finally beginning her speech.",
                            "target_lang_translations": {
                                "ru": "Она сделала несколько <w>несмелых</w> шагов по сцене, прежде чем наконец начать свою речь."
                            }
                        }
                    ],
                    "synonyms": [
                        "timorsome",
                        "fearful",
                        "frightened"
                    ],
                    "antonyms": [
                        "brave",
                        "dauntless"
                    ],
                    "common_phrases": [
                        "timorous steps",
                        "timorous nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко пугающийся, робкий или нерешительный по характеру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "робкий",
                                "target_lang_sense_clarification": "несмелый, боязливый по натуре"
                            },
                            {
                                "target_lang_word": "боязливый",
                                "target_lang_sense_clarification": "склонный к страху, пугливый"
                            },
                            {
                                "target_lang_word": "нерешительный",
                                "target_lang_sense_clarification": "неуверенный в себе"
                            },
                            {
                                "target_lang_word": "пугливый",
                                "target_lang_sense_clarification": "легко пугающийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3d28792-7cee-3038-894b-ef0eb68123ce",
                    "sense_definition": "Feeling fear or being afraid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fearful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>timorous</w> about walking through the dark forest alone at night.",
                            "target_lang_translations": {
                                "ru": "Ему было <w>боязно</w> идти одному через тёмный лес ночью."
                            }
                        },
                        {
                            "text": "The soldiers were <w>timorous</w> as they approached the enemy camp in the heavy fog.",
                            "target_lang_translations": {
                                "ru": "Солдаты были <w>объяты страхом</w>, приближаясь к вражескому лагерю в густом тумане."
                            }
                        }
                    ],
                    "synonyms": [
                        "apprehensive",
                        "frightened",
                        "scared"
                    ],
                    "antonyms": [
                        "brave",
                        "dauntless"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий страх, испуганный в конкретной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испуганный",
                                "target_lang_sense_clarification": "охваченный страхом в данный момент"
                            },
                            {
                                "target_lang_word": "боязливый",
                                "target_lang_sense_clarification": "испытывающий тревогу или опасение"
                            },
                            {
                                "target_lang_word": "тревожный",
                                "target_lang_sense_clarification": "полный опасений и страха"
                            }
                        ]
                    }
                }
            ]
        }
    ]
