                ],
                "senses": [
                    {
                        "sense_id": "2071143b-81aa-3ca0-a708-d07c031a81b3",
                        "entry_id": "d16fe8a3-2781-3798-bc3c-bd63c7ecb6b0",
                        "glosses": [
                            "Relatif à l’Anatolie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e303d2ec-ae02-40e5-8ea5-a500db859b73",
                                "sense_id": "2071143b-81aa-3ca0-a708-d07c031a81b3",
                                "text": "En voilier jusqu’à Trébizonde, la mer Noire est calme, trop calme, le vent souffle peu, on contemple pendant des heures le même point de côte, le même rocher, le même bosquet anatolien."
                            },
                            {
                                "example_id": "7cf5edd1-0dbd-4637-b15d-c8985af552fa",
                                "sense_id": "2071143b-81aa-3ca0-a708-d07c031a81b3",
                                "text": "La plaine de Konya s’ouvre au pied septentrional de la chaîne du Taurus, dans la partie centrale des plateaux anatoliens, région élevée (1 000-1 500 m) caractérisée par l’endoréisme de plusieurs dépressions jointives."
                            }
                        ]
                    },
                    {
                        "sense_id": "b90c25c6-38ff-3803-946e-ced94be84cf7",
                        "entry_id": "d16fe8a3-2781-3798-bc3c-bd63c7ecb6b0",
                        "glosses": [
                            "Turc, relatif à la Turquie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "95d2e9f1-e93e-42ab-b6b1-3e401c264514",
                                "sense_id": "b90c25c6-38ff-3803-946e-ced94be84cf7",
                                "text": "D’après l’agence de presse anatolienne, certains bâtiments se sont effondrés et une cinquantaine de personnes ont été transportées à l’hôpital de Van."
                            }
                        ]
                    }
                ],
