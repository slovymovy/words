                {
                    "sense_id": "2bb80314-93f3-3659-9d55-6c3854321c02",
                    "sense_definition": "Qui fait preuve d'une sévérité inflexible et ne tolère aucun manquement, en parlant d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "severite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce professeur <w>rigoureux</w> n'accepte aucun retard dans le rendu des devoirs.",
                            "target_lang_translations": {
                                "en": "This <w>strict</w> teacher accepts no delays in handing in homework.",
                                "ru": "Этот <w>строгий</w> преподаватель не допускает никаких опозданий со сдачей домашних работ.",
                                "de": "Dieser <w>strenge</w> Lehrer duldet keine Verspätung bei der Abgabe der Hausaufgaben.",
                                "es": "Este profesor <w>estricto</w> no acepta ningún retraso en la entrega de las tareas.",
                                "zh": "这位<w>严格</w>的老师不允许任何作业迟交。"
                            }
                        },
                        {
                            "text": "Même s'il est exigeant et très <w>rigoureux</w> avec ses employés, le directeur reste juste.",
                            "target_lang_translations": {
                                "en": "Even though he is demanding and very <w>strict</w> with his employees, the director remains fair.",
                                "ru": "Хотя он и требователен, и очень <w>строг</w> с сотрудниками, директор остаётся справедливым.",
                                "de": "Auch wenn er fordernd ist und mit seinen Mitarbeitern sehr <w>streng</w> umgeht, bleibt der Direktor gerecht.",
                                "es": "Aunque es exigente y muy <w>estricto</w> con sus empleados, el director sigue siendo justo.",
                                "zh": "尽管他对员工要求很高，对他们十分<w>严厉</w>，但这位主管依然公正。"
                            }
                        }
                    ],
