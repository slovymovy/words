                "senses": [
                    {
                        "sense_id": "1e17d0dc-2ba5-3bed-9306-6b96c5194527",
                        "entry_id": "87a68d9f-e02a-3c95-85bf-7e3501300f46",
                        "glosses": [
                            "Wert, der sich aus der Multiplikation des aktuellen Börsenkurses eines Unternehmens mit der Anzahl der ausgegebenen Aktien ergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e882bf-923f-4893-8918-dd0e1c18c0dd",
                                "sense_id": "1e17d0dc-2ba5-3bed-9306-6b96c5194527",
                                "text": "„Zu den wichtigen Kennzahlen für eine Anlageentscheidung zählt die Marktkapitalisierung. Sie misst den Marktwert eines börsennotierten Unternehmens, indem die Anzahl seiner Aktien mit dem Aktienkurs multipliziert wird. Weil dieser Kurs schwankt, unterliegt auch die Marktkapitalisierung bzw. der Börsenwert ständigen Änderungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2243ea8b-f6af-4fca-ab20-2e35816daeb9",
                        "source_entry_id": "87a68d9f-e02a-3c95-85bf-7e3501300f46",
                        "source_sense_id": "1e17d0dc-2ba5-3bed-9306-6b96c5194527",
                        "target_lang_word": "market capitalization",
                        "target_lang_code": "en",
