                "senses": [
                    {
                        "sense_id": "9752d078-064e-3f69-9ff2-676fcb5cad4d",
                        "entry_id": "713fae38-3476-354e-8c0d-317015ca31ae",
                        "glosses": [
                            "eine Angehörige des afrikanischen Volkes der Hausa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "981d8bf7-a653-4f13-ab88-4e26e83bc1ae",
                                "sense_id": "9752d078-064e-3f69-9ff2-676fcb5cad4d",
                                "text": "„Muslimische Hausa-Frauen in Nordnigeria arbeiten weder auf dem Feld noch treten sie öffentlich als Händlerinnen in Erscheinung.“"
                            },
                            {
                                "example_id": "97b9b5c5-2b6b-4c3a-a4d3-a3b5a635c13b",
                                "sense_id": "9752d078-064e-3f69-9ff2-676fcb5cad4d",
                                "text": "„Die durchschnittliche Häufigkeit liegt bei drei Scheidungen pro Hausa-Frau.“"
                            },
                            {
                                "example_id": "b1bcefb2-2d04-4655-a3fd-3dea1aeb6811",
                                "sense_id": "9752d078-064e-3f69-9ff2-676fcb5cad4d",
                                "text": "„Die Biographie der ›Baba of Karo‹ ist seit vierzig Jahren die einzige umfassende Lebensgeschichte einer Hausa-Frau.“"
                            },
                            {
                                "example_id": "c4b685de-64ad-46d0-b0e4-72b89111dcb5",
                                "sense_id": "9752d078-064e-3f69-9ff2-676fcb5cad4d",
                                "text": "„Menzel […] bringt jedoch ein Foto mit einer Hausa-Frau an einer Trittnähmaschine“"
                            },
                            {
                                "example_id": "14090a6c-97a1-45ea-bcf4-fb3b99c17112",
                                "sense_id": "9752d078-064e-3f69-9ff2-676fcb5cad4d",
                                "text": "„Le Coeur wurde die Geschichte eines Teda-Briganten erzählt, der gegen Ende des letzten Jahrhunderts lebte und eine Teda-Frau im Tibesti, eine Daza-Frau in Kanem, eine Hausa-Frau in Zinder und eine Kanuri-Frau in Bomo gehabt haben soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
