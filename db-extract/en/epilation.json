                "senses": [
                    {
                        "sense_id": "9b017656-0bd2-3f50-b3f9-c8b4b15bd2ea",
                        "entry_id": "d21b62e8-853d-39fa-a244-02ac15496701",
                        "glosses": [
                            "The removal of hair from the skin in such a way that removes or destroys the root."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "86f903b7-55e6-4ddb-81af-ad5a44464ede",
                                "sense_id": "9b017656-0bd2-3f50-b3f9-c8b4b15bd2ea",
                                "text": "These [boys being groomed as prostitutes] are sold by their parents (sometimes stolen from them), about the age of 4, and educated, while they are also subjected to a special physical training, which includes massage of the gluteal regions to favor development, dilatation of the anus, and epilation (which is not, however, practised by Chinese women)."
                            }
                        ]
                    },
                    {
                        "sense_id": "91ef4734-bd66-36b3-bc90-71f102e10785",
                        "entry_id": "d21b62e8-853d-39fa-a244-02ac15496701",
                        "glosses": [
                            "The removal of hair from the skin via the use of an epilator."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b320580-5e41-4393-a603-82bb0feb59c6",
                        "source_entry_id": "d21b62e8-853d-39fa-a244-02ac15496701",
                        "source_sense_description": "removal of hair",
                        "target_lang_word": "épilation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épilation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb35a8f1-6485-3be6-ab67-553b59b0af3a",
                                        "entry_id": "39c27b01-5ded-3ef3-9e7a-f6fee5670c1a",
                                        "glosses": [
                                            "Suppression des poils ou des cheveux opérée par divers procédés manuels, mécaniques, électriques ou chimiques, généralement par souci d’esthétique, de confort, d’hygiène ou de décence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1734625-ce09-49dc-9759-ecd117c1601b",
                                                "sense_id": "fb35a8f1-6485-3be6-ab67-553b59b0af3a",
                                                "text": "La haine de cette femme. De sa petite vie nourrie de crèmes de beauté et de fonds de teint. De parfums, de houppettes, d’épilations « maillot », de laits autobronzants."
                                            },
                                            {
                                                "example_id": "75f584cd-e13a-4dab-bf85-2a0ad6fa60ff",
                                                "sense_id": "fb35a8f1-6485-3be6-ab67-553b59b0af3a",
                                                "text": "Parmi cinq ou six (exactement six) Anglo-Saxons, qu’à leur épilation excessive je connus Américains, se tenait assise, aussi vivante qu’il lui était loisible, mon amie Nane."
                                            },
                                            {
                                                "example_id": "a3a1b75f-cd53-43d6-bbc2-c819a8de3fe4",
                                                "sense_id": "fb35a8f1-6485-3be6-ab67-553b59b0af3a",
                                                "text": "Après cela ce fut le tour de l’esthéticienne pour une épilation complète : jambes, aisselles, maillot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10d72fed-96d6-4c4e-80e8-6c213e893222",
                        "source_entry_id": "d21b62e8-853d-39fa-a244-02ac15496701",
