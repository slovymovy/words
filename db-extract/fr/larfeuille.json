                        "entry_id": "f61632c9-7efc-33f1-8983-f260d3d49e39",
                        "glosses": [
                            "Portefeuille."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "62c23c31-3ec2-48a8-b700-49d783b540aa",
                                "sense_id": "0ef36219-dd1e-3ea9-8595-aa09609a90d5",
                                "text": "[…], Peter s'était fait brusquement corriger sur le trottoir par des Québécois. Pas à cause des larfeuilles sur lesquels ils ne soupçonnaient rien, mais pour lui apprendre à être viril."
                            },
                            {
                                "example_id": "f489a761-67c8-4f35-b634-7ff612f673f1",
                                "sense_id": "0ef36219-dd1e-3ea9-8595-aa09609a90d5",
                                "text": "— À Saint-Ouen, Badou, y nous en donne trois cents. Plus le larfeuille du gars. Parce qu'y doit avoir un larfeuille, césigue !"
                            },
                            {
                                "example_id": "72101d41-72a6-46eb-8e65-a0269a412fb5",
                                "sense_id": "0ef36219-dd1e-3ea9-8595-aa09609a90d5",
                                "text": "— Ce charmant René, il a pas de tête, il vient jouer au poke, il perd cent cinquante tickets, et il s'aperçoit qu'il a oublié son larefeuille... une négligence..."
                            }
                        ]
                    }
