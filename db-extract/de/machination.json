                ],
                "senses": [
                    {
                        "sense_id": "336a6c3e-9510-3ca0-ac24-fd95547dc38b",
                        "entry_id": "4972c449-500f-3f8e-9051-4068a56df992",
                        "glosses": [
                            "verborgene, unlautere Handlung, um Vorteile zu gewinnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5df83e00-3176-4484-929b-769d292b14a9",
                                "sense_id": "336a6c3e-9510-3ca0-ac24-fd95547dc38b",
                                "text": "„… dardurch seine längst vorgehabte Machinationen […] offentlich gestanden …“"
                            },
                            {
                                "example_id": "cc987e90-40c2-4c7c-adde-d3c679d35280",
                                "sense_id": "336a6c3e-9510-3ca0-ac24-fd95547dc38b",
                                "text": "Hauptakteure der DFG sind die Gutachterinnen und Gutachter, die Fachreferentinnen und -referenten sowie die Fachkollegiatinnen und -kollegiaten; die Veranstalter wissen anscheinend nur von den ersten beiden Gruppen und wittern üble Machinationen: Referenten könnten unkontrolliert den anonymen Gutachtern Projekte zuschustern, die dann in undurchsichtiger Weise beurteilt würden, während dem Antragsteller nichts bleibe, als ohnmächtig des Ergebnisses zu harren, ohne die Möglichkeit eines Widerspruches zu haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc00b982-81f1-4be6-8006-140f6b12f4ad",
                        "source_entry_id": "4972c449-500f-3f8e-9051-4068a56df992",
                        "source_sense_id": "336a6c3e-9510-3ca0-ac24-fd95547dc38b",
                        "source_sense_description": "verborgene, unlautere Handlung, um Vorteile zu gewinnen",
                        "target_lang_word": "machination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2baa52d-380b-3d25-8d63-73287d1340f9",
                                        "entry_id": "39b4b3de-bd08-38ee-893f-01bc265b465c",
                                        "glosses": [
                                            "A clever scheme or artful plot, usually crafted for evil purposes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efdc378-a9c0-4c37-9f97-dcfc98f4e311",
                                                "sense_id": "b2baa52d-380b-3d25-8d63-73287d1340f9",
                                                "text": "Machinations, hollowneſſe, treacherie, and all ruinous diſorders follow vs diſquietly to our Graues."
                                            },
                                            {
                                                "example_id": "405641c8-7d92-4c50-8bc9-401d33ae2f19",
                                                "sense_id": "b2baa52d-380b-3d25-8d63-73287d1340f9",
                                                "text": "He witnessed her palpitating bosom, the lifeless hues and disconsolate expression of her interesting countenance; yet, from the machinations of his evil passions, he would have proceeded further, until, entirely overcome, he had seen her drop motionless in her chair, in order that he might have the luxury of supporting her within his arms, and of recalling her to a sense of life and being."
                                            },
                                            {
                                                "example_id": "5508b841-df7b-46a2-aa9b-043723c59d75",
                                                "sense_id": "b2baa52d-380b-3d25-8d63-73287d1340f9",
                                                "text": "PATRICK: The inner machinations of my mind are an enigma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc0c3267-9b08-3237-b7cf-65e126500392",
                                        "entry_id": "39b4b3de-bd08-38ee-893f-01bc265b465c",
                                        "glosses": [
                                            "The act of machinating or plotting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cfb3209-8d75-4cc9-b806-960e27250b82",
                        "source_entry_id": "4972c449-500f-3f8e-9051-4068a56df992",
                        "source_sense_id": "336a6c3e-9510-3ca0-ac24-fd95547dc38b",
                        "source_sense_description": "verborgene, unlautere Handlung, um Vorteile zu gewinnen",
                        "target_lang_word": "machination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6748242-4b9f-3b83-864a-7602b8e560fa",
                                        "entry_id": "a4153ecb-ef18-3de6-81a4-fd952058b17b",
                                        "glosses": [
                                            "Intrigue, menée secrète pour faire réussir quelque mauvais dessein, quelque complot, pour nuire à quelqu’un, pour le perdre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc447dd6-48ff-4395-9c7d-68eaf17832f8",
                                                "sense_id": "d6748242-4b9f-3b83-864a-7602b8e560fa",
                                                "text": "[…]; ces machinations avaient eu pour principal ouvrier un juge d'instruction, nommé Bertulus, dont le souvenir ne fait guère honneur à la magistrature."
                                            },
                                            {
                                                "example_id": "e1ce6766-1b35-4e09-ac7d-fad275913ff4",
                                                "sense_id": "d6748242-4b9f-3b83-864a-7602b8e560fa",
                                                "text": "Ah ! Elle avait été bien ourdie la machination du docteur de La Pommerais ! Il est bien connu que la civilisation ne tend nullement à faire disparaitre la délinquance mais bien à la faire évoluer."
                                            },
                                            {
                                                "example_id": "9474f1bc-996a-4481-a11d-0476b23fcc6a",
                                                "sense_id": "d6748242-4b9f-3b83-864a-7602b8e560fa",
                                                "text": "Que les instruments qui ont servi à ourdir cette sanglante machination politique doivent disparaître, cela est évident."
                                            },
                                            {
                                                "example_id": "3f112a55-e2cc-4103-a131-6c177849e4ac",
                                                "sense_id": "d6748242-4b9f-3b83-864a-7602b8e560fa",
                                                "text": "Présumons qu’il ne s’agit pas que d’une machination machiavélique et qu’il y croit encore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
