                                        "entry_id": "8f971ca6-89ac-3742-b41c-aed6b6752436",
                                        "glosses": [
                                            "A light white wine, made from Riesling grapes originating in the valley of this river."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c2da9a8-dd95-4da5-b102-cc4edc948da7",
                                                "sense_id": "f639e839-9780-3638-afc4-000bff69354b",
                                                "text": "I drank too much moselle, imagining it a mere diuretic."
                                            }
                                        ]
