                "senses": [
                    {
                        "sense_id": "be72cd7a-e024-35bf-bbe1-cb58b694f431",
                        "entry_id": "2079fff6-d294-3184-b51c-3cf1060bc06f",
                        "glosses": [
                            "Einwohner der Konföderierten Staaten von Amerika während des Amerikanischen Bürgerkriegs, insbesondere Armeeangehörige"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4ef14ccd-328a-4ba7-a7d9-7d2f3047dcaa",
                                "sense_id": "be72cd7a-e024-35bf-bbe1-cb58b694f431",
                                "text": "„Das Porträt zeigte einen backenbärtigen Armeeoffizier in der grauen Uniform der Konföderierten, verziert mit Goldlitzen, einen Degen an seiner Seite gegürtet.“"
                            },
                            {
                                "example_id": "702d70fb-88d0-4924-b364-b792129bd2da",
                                "sense_id": "be72cd7a-e024-35bf-bbe1-cb58b694f431",
                                "text": "„Edgar Rice Burroughs zum Beispiel bot mit seinen Tarzan-Geschichten eine Fülle kritisches Futter (war es überhaupt nötig, alle Probleme aufzulisten, die Montrose mit Tarzan hatte, angefangen allein schon mit seiner Grundidee?), oder seine Barsoom-Serie mit ihrem Protagonisten John Carter, der Hauptmann in der Armee von Nord-Virginia war, bevor er zum Kriegsherrn auf dem Mars wurde. ›Ein Offizier der Konföderierten?‹, hatte sich sein Vater empört.“"
                            },
                            {
                                "example_id": "55b66ad0-b309-41d3-8b72-ab39efcaac8b",
                                "sense_id": "be72cd7a-e024-35bf-bbe1-cb58b694f431",
                                "text": "„Im Amerikanischen Bürgerkrieg war er General bei den Konföderierten.“"
                            },
                            {
                                "example_id": "91c8d580-35fa-4753-b2a3-be7e93426636",
                                "sense_id": "be72cd7a-e024-35bf-bbe1-cb58b694f431",
                                "text": "„Sie zeigte einen Soldaten der Konföderierten, den Kopf gebeugt, die Mütze in der Hand, die Schultern hängend und den Blick nach Süden gerichtet. Die Statue trug den Namen ‹Appomattox›.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
