                    {
                        "translation_id": "a589afe4-f696-4c36-9a11-8633118bbb7c",
                        "source_entry_id": "dad9ab53-9be0-3114-9118-2f33e2afc1e9",
                        "source_sense_id": "2fa4749b-84ad-3212-b8d0-575a882c937b",
