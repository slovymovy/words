    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                    "sense_definition": "In a simple or unadorned manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decorated the room <w>plainly</w> but neatly.",
                            "target_lang_translations": {
                                "pl": "Udekorowała pokój <w>skromnie</w>, ale schludnie.",
                                "ru": "Она украсила комнату <w>скромно</w>, но со вкусом."
                            }
                        },
                        {
                            "text": "The house was furnished <w>plainly</w> with only the basic necessities.",
                            "target_lang_translations": {
                                "pl": "Dom był umeblowany <w>prosto</w>, tylko w podstawowe sprzęty.",
                                "ru": "Дом был обставлен <w>просто</w>, только самым необходимым."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "W sposób prosty, skromny, bez zbędnych ozdób.",
                        "ru": "Просто, скромно, без излишеств и украшений."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skromnie",
                                "target_lang_sense_clarification": "w sposób nieprzesadny, bez ozdób"
                            },
                            {
                                "target_lang_word": "prosto",
                                "target_lang_sense_clarification": "w sposób nieskomplikowany"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "просто",
                                "target_lang_sense_clarification": "без украшений и излишеств"
                            },
                            {
                                "target_lang_word": "скромно",
                                "target_lang_sense_clarification": "неброско, сдержанно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                    "sense_definition": "In a way that is easy to see, hear, or understand.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will see that ours is <w>plainly</w> the better method.",
                            "target_lang_translations": {
                                "pl": "Zobaczysz, że nasza metoda jest <w>ewidentnie</w> lepsza.",
                                "ru": "Вы увидите, что наш метод <w>явно</w> лучше."
                            }
                        },
                        {
                            "text": "<w>Plainly</w> he was prepared to argue his case against the group.",
                            "target_lang_translations": {
                                "pl": "<w>Wyraźnie</w> był przygotowany, by bronić swojego stanowiska przeciwko grupie.",
                                "ru": "<w>Очевидно</w>, он был готов отстаивать свою точку зрения перед группой."
                            }
                        }
                    ],
                    "synonyms": [
                        "expressly",
                        "unambiguously",
                        "explicitly",
                        "obviously"
                    ],
                    "target_lang_definitions": {
                        "pl": "W sposób wyraźny, oczywisty, łatwy do zrozumienia lub zauważenia.",
                        "ru": "Ясно, очевидно, понятно для восприятия или понимания."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyraźnie",
                                "target_lang_sense_clarification": "w sposób jasny i zrozumiały"
                            },
                            {
                                "target_lang_word": "oczywiście",
                                "target_lang_sense_clarification": "w sposób niebudzący wątpliwości"
                            },
                            {
                                "target_lang_word": "ewidentnie",
                                "target_lang_sense_clarification": "w sposób bezsporny"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "явно",
                                "target_lang_sense_clarification": "совершенно очевидно"
                            },
                            {
                                "target_lang_word": "очевидно",
                                "target_lang_sense_clarification": "само собой разумеется, заметно"
                            },
                            {
                                "target_lang_word": "ясно",
                                "target_lang_sense_clarification": "понятно, четко"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}