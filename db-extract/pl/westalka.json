                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vestale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7166d11a-5927-3fdc-8840-75c5cc452694",
                                        "entry_id": "a35aa32d-6c16-3979-89a6-448e96e21780",
                                        "glosses": [
                                            "Vierge consacrée à Vesta."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3259c5-857a-47a0-b5b7-f11c415f9bb3",
                                                "sense_id": "7166d11a-5927-3fdc-8840-75c5cc452694",
                                                "text": "Telles étaient jadis les vestales chez les Romains ; telles furent les vierges du soleil dans les temples de Cusco ; telles sont encore, hélas ! parmi nous, ces pauvres filles qui se consacrent, dans l’ombre des cloîtres, à de puérils devoirs par des vœux éternels."
                                            },
                                            {
                                                "example_id": "2d5ec346-4626-4b3c-8df7-fe299b7dfb2f",
                                                "sense_id": "7166d11a-5927-3fdc-8840-75c5cc452694",
                                                "text": "Svelte et immaculée comme le corps chaste d’une vestale aux cheveux ondulés, l’unique colonne demeurée droite jette au temps le défi de sa persistante jeunesse ; mais, les masques sont en poussière, les voix sont éteintes, la vie disparue, qui vibrait sous l’aile pourpre du velarium."
                                            },
                                            {
                                                "example_id": "b816d083-2f60-485a-aebe-a828a61287fa",
                                                "sense_id": "7166d11a-5927-3fdc-8840-75c5cc452694",
                                                "text": "Une vestale qui manquait à la chasteté était punie de mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0476dd65-00ae-3b65-8faa-7ebfa3323f58",
                                        "entry_id": "a35aa32d-6c16-3979-89a6-448e96e21780",
                                        "glosses": [
                                            "Femme, jeune fille qui est d’une chasteté exemplaire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5cd5aaa-88fc-4879-82aa-d3a0c9bf27bb",
                                                "sense_id": "0476dd65-00ae-3b65-8faa-7ebfa3323f58",
                                                "text": "Elle aura de la peine à passer pour une vestale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20650762-f279-40c5-bc01-0558817ea43f",
                        "source_entry_id": "0cb33be0-8137-3f26-bfcd-8987aa7537cb",
                        "source_sense_id": "d89752c4-098f-366c-9d21-36b0d5cff746",
