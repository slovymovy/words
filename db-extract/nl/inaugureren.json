        "nl-extract.jsonl": [
            {
                "entry_id": "74fb553a-47bc-383b-93f8-991573e11f0d",
                "word": "inaugureren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bb2abacd-fe41-3c47-8f9d-04f376c54cb8",
                        "entry_id": "74fb553a-47bc-383b-93f8-991573e11f0d",
                        "glosses": [
                            "op een plechtige wijze als functionaris aangesteld worden"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f5fee620-6583-4844-a358-e019fc2d47f8",
                                "sense_id": "bb2abacd-fe41-3c47-8f9d-04f376c54cb8",
                                "text": "Veel Indiase parlementariërs worden verdacht van misdrijven. Van de 4835 leden van zowel van het nationale parlement als van de deelstaat-parlementen, hebben 1448 (31 procent) een rechtszaak tegen zich lopen. 641 parlementsleden zijn aangeklaagd voor ernstige vergrijpen, als moord (141). Poging tot moord (345) en ontvoering (90). 369 parlementariërs zijn aangeklaagd wegens misdrijven tegen vrouwen, van wie zes wegens verkrachting. Jaganmohan Reddy, een populaire politicus die gevangen zit wegens corruptie, kreeg verlof zich te laten inaugureren in het nationale parlement."
                            },
                            {
                                "example_id": "72820723-c0fe-4615-a5fc-a9aa37b3d6fa",
                                "sense_id": "bb2abacd-fe41-3c47-8f9d-04f376c54cb8",
                                "text": "Tshisekedi heeft zichzelf tot winnaar en president uitgeroepen. Hij is van plan vrijdag een grote bijeenkomst te houden waar hij zich tot 'echte president' van het land laat inaugureren. De oppositieleider heeft militairen opgeroepen het leger te verlaten en zich bij hem aan te sluiten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7f16014-5ace-4b93-afa8-a2970b34b215",
                        "source_entry_id": "74fb553a-47bc-383b-93f8-991573e11f0d",
                        "source_sense_id": "bb2abacd-fe41-3c47-8f9d-04f376c54cb8",
                        "source_sense_description": "overgankelijk op een plechtige wijze als functionaris aangesteld worden",
                        "target_lang_word": "install",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "install",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "261c9cfe-497f-3bfd-8e32-00957fe5352e",
                                        "entry_id": "748a8d74-74d7-3271-bae5-ec3bd963ab1a",
                                        "glosses": [
                                            "To connect, set up or prepare something for use"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f8da9eb-1d5a-40c1-bd46-5175145bc06e",
                                                "sense_id": "261c9cfe-497f-3bfd-8e32-00957fe5352e",
                                                "text": "Across Japan, technology companies and private investors are racing to install devices that until recently they had little interest in: solar panels. Massive solar parks are popping up as part of a rapid build-up that one developer likened to an \"explosion.\""
                                            },
                                            {
                                                "example_id": "4236f16e-9572-48ac-bcaf-e772e73acd11",
                                                "sense_id": "261c9cfe-497f-3bfd-8e32-00957fe5352e",
                                                "text": "Each TBM installs two-metre-wide rings made up of seven precast concrete segments produced on-site. Each ring takes approximately 45 minutes to one hour to install."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22d88f9b-96fa-3b0e-b122-21b9924ad599",
                                        "entry_id": "748a8d74-74d7-3271-bae5-ec3bd963ab1a",
                                        "glosses": [
                                            "To connect, set up or prepare something for use",
                                            "To transfer software onto a device's permanent storage and put it in a state where it is ready to be run when needed, usually decompressing it if necessary and performing any necessary pre-first-run configuration."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bfc8ad2-2563-40b9-88e8-da75bbc55e21",
                                                "sense_id": "22d88f9b-96fa-3b0e-b122-21b9924ad599",
                                                "text": "I haven't installed the new operating system yet because of all the bugs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3c28b0d-ae12-30b5-8637-55c6fd571e95",
                                        "entry_id": "748a8d74-74d7-3271-bae5-ec3bd963ab1a",
                                        "glosses": [
                                            "To admit formally into an office, rank or position."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86868e4c-15c6-4a2c-aecd-560ea11791db",
                                                "sense_id": "b3c28b0d-ae12-30b5-8637-55c6fd571e95",
                                                "text": "He was installed as Chancellor of the University."
                                            },
                                            {
                                                "example_id": "3bd4181a-e371-428b-bbc1-9a2f48dc4bd4",
                                                "sense_id": "b3c28b0d-ae12-30b5-8637-55c6fd571e95",
                                                "text": "My husband rented a small, comfortable house, and I was installed as its mistress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a1dd996-033e-3557-b689-4e1e67a715a5",
                                        "entry_id": "748a8d74-74d7-3271-bae5-ec3bd963ab1a",
                                        "glosses": [
                                            "To establish or settle in."
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbdeb971-ff72-4e11-9f61-fce605b2f10e",
                                                "sense_id": "4a1dd996-033e-3557-b689-4e1e67a715a5",
                                                "text": "I installed myself in my usual chair by the fire."
                                            },
                                            {
                                                "example_id": "6a7a7bd2-8ecc-4eaa-bfd9-ada9a1e7c4b5",
                                                "sense_id": "4a1dd996-033e-3557-b689-4e1e67a715a5",
                                                "text": "At Kiwi, 40 miles from Nelson [New Zealand], eight women installed themselves in the goods shed, taking with them their knitting, and a supply of food and magazines. The demolition crew was unable to pull the building down without injuring them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "install",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "328c836a-866b-39c8-9cfa-80f1fa3e0181",
                                        "entry_id": "f191dd8a-1659-3599-a8a1-fba3c800aabe",
                                        "glosses": [
                                            "An installation: the process of installing a software application."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdac5ed2-9365-423f-aca6-c86d1df6e86d",
                                                "sense_id": "328c836a-866b-39c8-9cfa-80f1fa3e0181",
                                                "text": "The install takes a long time, but you can run it in the background while working on other things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1114abe7-fdc7-3162-b906-8fca7dd56cc4",
                                        "entry_id": "f191dd8a-1659-3599-a8a1-fba3c800aabe",
                                        "glosses": [
                                            "An installation: a software application that has been installed."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05ecd653-06bc-42d6-8ed4-48cdb9b44f2b",
                                                "sense_id": "1114abe7-fdc7-3162-b906-8fca7dd56cc4",
                                                "text": "I've customized my local install; the out-of-the-box version looks a bit different."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
