                                        "glosses": [
                                            "een blaasinstrument, sopranino-dwarsfluit, wordt zoals de dwarsfluit bespeeld door dwars over het mondstuk te blazen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8cb28e1a-1887-3d68-8df7-09f0b4101174",
                                        "entry_id": "80af9270-b04d-38da-921e-2752ad177cdf",
                                        "glosses": [
                                            "een klein soort mondharmonica met minder aanblaasgaten en tongen dan een normale mondharmonica"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "330fcc2e-9c9c-34d2-9087-d994e5103926",
                                        "entry_id": "80af9270-b04d-38da-921e-2752ad177cdf",
                                        "glosses": [
                                            "lift- en loopjongen in een hotel"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06013ff5-f448-437a-885a-34933e491795",
                                                "sense_id": "330fcc2e-9c9c-34d2-9087-d994e5103926",
                                                "text": "De eerste die ik sinds lange tijd sprak, afgezien van de weinige afgemeten woorden die ik aan het begin en het einde van de rit had gewisseld met mijn norse taxichauffeur, was een magere, donkere jongen in het nostalgische rode uniform van een piccolo."
                                            }
                                        ]
                                    }
                                ]
                            }
