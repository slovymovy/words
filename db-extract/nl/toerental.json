                                        "entry_id": "840470bf-f919-39c5-aba7-89b9b98d57ea",
                                        "glosses": [
                                            "The speed, measured in revolutions per minute, of an internal-combustion engine when it is running, but is at rest and without power being applied, typically with transmission in neutral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcf327c4-d6c2-4b84-997c-df4abe243797",
                                                "sense_id": "4bb64872-229e-31e1-b753-939342dce8ef",
                                                "text": "Heating in the passenger sections is by electricity obtained from the main generator. When heating is dictated by the operation of a thermostat in the roof of the motor coach, engine idling speed is 600 r.p.m. instead of the normal 450 r.p.m. in order to produce a high enough generator voltage output at rest."
                                            }
                                        ]
