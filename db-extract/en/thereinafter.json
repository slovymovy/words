                                "target_senses": [
                                    {
                                        "sense_id": "bb272eea-1e46-3b02-b183-9eab73300bfe",
                                        "entry_id": "aefdfaa1-8072-380b-b0fe-fbca64bfbe67",
                                        "glosses": [
                                            "Qui est après, qui vient après."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec527d80-8b3a-400b-bd0f-eefff9219c20",
                                                "sense_id": "bb272eea-1e46-3b02-b183-9eab73300bfe",
                                                "text": "La vente aura lieu mardi prochain et jours suivants. — Il en a usé de la sorte pour les raisons suivantes : …"
                                            },
                                            {
                                                "example_id": "810f1fc3-50ba-478a-8491-6f795e51d0a5",
                                                "sense_id": "bb272eea-1e46-3b02-b183-9eab73300bfe",
                                                "text": "Je m'assis et écrivis une lettre cordiale: monsieur Saito se réjouissait à l'idée de jouer au golf le dimanche suivant avec monsieur Johnson et lui envoyait ses amitiés."
                                            },
                                            {
                                                "example_id": "4e78d9d5-b456-445e-ae93-a54d767d652a",
                                                "sense_id": "bb272eea-1e46-3b02-b183-9eab73300bfe",
                                                "text": "Ceci explique qu'une pente déjà skiée sans encombre puisse partir en avalanche au passage du skieur suivant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba0b5556-5938-31be-9355-d6230c7ed2fb",
                                        "entry_id": "79f209d1-4221-3238-b6b2-ed680a61e619",
                                        "glosses": [
                                            "Chose ou personne suivante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa53f46c-64e7-44e8-ab77-7195248d3a05",
                                                "sense_id": "ba0b5556-5938-31be-9355-d6230c7ed2fb",
                                                "text": "L’année 1988 et les trois suivantes ont produit d’excellents millésimes dans le nord de la vallée du Rhône."
                                            },
                                            {
                                                "example_id": "627934d2-290c-408a-bdc5-50be4198ef56",
                                                "sense_id": "ba0b5556-5938-31be-9355-d6230c7ed2fb",
                                                "text": "Au suivant !"
                                            },
                                            {
                                                "example_id": "fe80f766-a2fb-4ab9-8537-66a217bc270d",
                                                "sense_id": "ba0b5556-5938-31be-9355-d6230c7ed2fb",
                                                "text": "Note : En ce sens, il s’agit de l’emploi substantivé de l’adjectif homographe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c17f74-1148-3ac4-9063-ce423f879dd2",
                                        "entry_id": "79f209d1-4221-3238-b6b2-ed680a61e619",
                                        "glosses": [
                                            "Celui ou celle qui suit, qui accompagne, qui escorte une personne."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6470e5c6-2dd7-4c28-976f-0168bfcbe0ec",
                                                "sense_id": "c0c17f74-1148-3ac4-9063-ce423f879dd2",
                                                "text": "Elle avait de nombreux suivants."
                                            },
                                            {
                                                "example_id": "efab314e-6309-4c8a-afb4-697653d53a4c",
                                                "sense_id": "c0c17f74-1148-3ac4-9063-ce423f879dd2",
                                                "text": "On l’invita, lui et tous ses suivants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "026c59a5-4a0d-3a33-966c-b4b2cd68d598",
                                        "entry_id": "79f209d1-4221-3238-b6b2-ed680a61e619",
                                        "glosses": [
                                            "→ voir suivante"
                                        ],
                                        "tags": [
                                            "Au féminin"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "suivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd0695a-337c-3ff8-b8bc-ff2a7433ed84",
                                        "entry_id": "bd58bd8a-b478-3c6a-86bd-7322ae88ca81",
                                        "glosses": [
                                            "Selon, conformément à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad15f586-00cd-4885-99b6-b1939c1e78db",
                                                "sense_id": "4dd0695a-337c-3ff8-b8bc-ff2a7433ed84",
                                                "text": "L'enterrement de mon père fut suivi de tout le village suivant la coutume et il y vint des gens des environs, à des lieues à la ronde."
                                            },
                                            {
                                                "example_id": "0b4cb8fe-31bc-42ff-a7ce-baaad604e932",
                                                "sense_id": "4dd0695a-337c-3ff8-b8bc-ff2a7433ed84",
                                                "text": "Suivant nous, César en fut pour ses tentatives. Vercingétorix détestait trop vivement Rome pour se laisser prendre à ce piège grossier."
                                            },
                                            {
                                                "example_id": "63157e2a-b9eb-463a-b5f1-cf16029615e6",
                                                "sense_id": "4dd0695a-337c-3ff8-b8bc-ff2a7433ed84",
                                                "text": "Suivant votre sentiment."
                                            },
                                            {
                                                "example_id": "19487ba2-1b46-4d5f-a5ce-a8106ec73d86",
                                                "sense_id": "4dd0695a-337c-3ff8-b8bc-ff2a7433ed84",
                                                "text": "Suivant l’opinion d’Aristote."
                                            },
                                            {
                                                "example_id": "c4c765ea-abbe-4150-9db1-2110e21f9aa3",
                                                "sense_id": "4dd0695a-337c-3ff8-b8bc-ff2a7433ed84",
                                                "text": "Suivant Descartes."
                                            },
                                            {
                                                "example_id": "ddde50e9-6274-433a-a8d9-23b2ae6f75cd",
                                                "sense_id": "4dd0695a-337c-3ff8-b8bc-ff2a7433ed84",
                                                "text": "Suivant ce qu’il me dira."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da816c5a-ac9d-383d-a274-cd0c1c9bdc92",
                                        "entry_id": "bd58bd8a-b478-3c6a-86bd-7322ae88ca81",
                                        "glosses": [
                                            "À proportion de, en raison de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcbefdfa-60f4-406a-a017-bfc36874dd77",
                                                "sense_id": "da816c5a-ac9d-383d-a274-cd0c1c9bdc92",
                                                "text": "Travailler suivant ses forces."
                                            },
                                            {
                                                "example_id": "59433ff2-1e6c-4de3-abe6-f0cd17ea99cf",
                                                "sense_id": "da816c5a-ac9d-383d-a274-cd0c1c9bdc92",
                                                "text": "Récompenser, punir suivant le mérite."
                                            },
                                            {
                                                "example_id": "11845fce-0b05-444a-9546-a4c94fd1e2cb",
                                                "sense_id": "da816c5a-ac9d-383d-a274-cd0c1c9bdc92",
                                                "text": "Il faut se gouverner suivant le temps et le lieu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd7b726-e47d-31a2-b7fd-d7de3541e711",
                                        "entry_id": "b93fe5bf-bc08-31d7-b26c-fc2203a45e2c",
                                        "glosses": [
                                            "Participe présent du verbe suivre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dc5eb6f-4f66-4579-b762-7078df46f28d",
                                                "sense_id": "0cd7b726-e47d-31a2-b7fd-d7de3541e711",
                                                "text": "Il y a aussi deux groupes d’astéroïdes, appelés Troyens, qui partagent l’orbite de Jupiter, précédant et suivant la planète de 60 degrés."
                                            },
                                            {
                                                "example_id": "d7cf905f-ff26-4c39-8d37-6cd63d12d0b8",
                                                "sense_id": "0cd7b726-e47d-31a2-b7fd-d7de3541e711",
                                                "text": "Si l’homme ressemble un peu à mon père, la femme n’est pas ma mère — ça, c’est sûr, bien qu’elle se comporte comme telle quand elle vient me voir tous les jours : elle me caresse la main, m’embrasse les cheveux, me masse les pieds en suivant les instructions du physiothérapeute, et dispose des campanules et des anémones dans une cruche qu’elle a apportée ici."
                                            }
                                        ]
                                    }
                                ]
                            },
