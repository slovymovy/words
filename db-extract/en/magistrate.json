                                                "sense_id": "1a3b0860-ea1a-31c5-ac20-d8b87d5f040b",
                                                "text": "De magistraat had zijn oordeel geveld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65fbeebb-b452-3442-8358-bd8f7f5381f0",
