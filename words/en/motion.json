{
    "word_family": [
        "motionless",
        "motional",
        "motion-picture",
        "counter-motion",
        "locomotion",
        "slow-motion"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1330dc8e-db51-3072-97db-92697524d822",
                    "sense_definition": "The action or process of moving or being moved; a change in position.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>motion</w> of the waves made some of the passengers feel seasick.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>движение</w> волн вызвало у некоторых пассажиров морскую болезнь.",
                                "zh": "海浪持续的<w>运动</w>让一些乘客感到晕船。"
                            }
                        },
                        {
                            "text": "The laws of physics explain how an object stays in <w>motion</w> unless a force stops it.",
                            "target_lang_translations": {
                                "ru": "Законы физики объясняют, как объект остается в <w>движении</w>, пока его не остановит какая-либо сила.",
                                "zh": "物理定律解释了物体如何保持<w>运动</w>，除非有外力使它停止。"
                            }
                        }
                    ],
                    "synonyms": [
                        "movement",
                        "move"
                    ],
                    "antonyms": [
                        "rest"
                    ],
                    "common_phrases": [
                        "in motion",
                        "set in motion",
                        "circular motion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс перемещения; изменение положения в пространстве.",
                        "zh": "移动或被移动的动作或过程；位置的变化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "движение",
                                "target_lang_sense_clarification": "процесс перемещения или состояние перемещаемого объекта"
                            },
                            {
                                "target_lang_word": "перемещение",
                                "target_lang_sense_clarification": "смена позиции или места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运动",
                                "target_lang_sense_clarification": "物体移动或位置发生变化的过程；常用于一般语境和物理语境"
                            },
                            {
                                "target_lang_word": "移动",
                                "target_lang_sense_clarification": "从一处移到另一处，强调位置变化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7f844d9-3fe2-3874-9b25-2a920ca75924",
                    "sense_definition": "A formal proposal for action or discussion to be voted on during a meeting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "formal_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee member decided to propose a <w>motion</w> to increase the annual budget.",
                            "target_lang_translations": {
                                "ru": "Член комитета решил внести <w>предложение</w> об увеличении годового бюджета.",
                                "zh": "这位委员会成员决定提出一项增加年度预算的<w>动议</w>。"
                            }
                        },
                        {
                            "text": "After a long debate, the <w>motion</w> was carried by a majority of ten votes.",
                            "target_lang_translations": {
                                "ru": "После долгих дебатов <w>предложение</w> было принято большинством в десять голосов.",
                                "zh": "经过长时间辩论后，这项<w>动议</w>以十票多数获得通过。"
                            }
                        }
                    ],
                    "synonyms": [
                        "movement"
                    ],
                    "common_phrases": [
                        "propose a motion",
                        "table a motion",
                        "second the motion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in formal meetings or parliamentary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное предложение о действии или обсуждении, выносимое на голосование во время собрания.",
                        "zh": "在会议中提出、供讨论或表决的正式提议。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предложение",
                                "target_lang_sense_clarification": "вынесенное на обсуждение или голосование"
                            },
                            {
                                "target_lang_word": "ходатайство",
                                "target_lang_sense_clarification": "официальная просьба или предложение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动议",
                                "target_lang_sense_clarification": "会议中提出并交付表决的正式提议"
                            },
                            {
                                "target_lang_word": "提案",
                                "target_lang_sense_clarification": "较通用的正式提议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef3de484-6229-3210-86aa-a5ee6870f001",
                    "sense_definition": "A formal request made to a judge or court to obtain a specific ruling or order.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney filed a <w>motion</w> to dismiss the case due to lack of evidence.",
                            "target_lang_translations": {
                                "ru": "Адвокат защиты подал <w>ходатайство</w> о прекращении дела в связи с отсутствием улик.",
                                "zh": "辩护律师因证据不足而提出驳回此案的<w>申请</w>。"
                            }
                        },
                        {
                            "text": "The judge denied the <w>motion</w> for a new trial after reviewing the legal arguments.",
                            "target_lang_translations": {
                                "ru": "Судья отклонил <w>ходатайство</w> о проведении нового судебного разбирательства после изучения правовых аргументов.",
                                "zh": "法官审查法律论点后，驳回了要求重新审判的<w>申请</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "file a motion",
                        "deny a motion",
                        "grant a motion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное обращение к судье или суду для получения определенного постановления или приказа.",
                        "zh": "向法官或法院提出、以请求作出特定裁定或命令的正式申请。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходатайство",
                                "target_lang_sense_clarification": "официальное прошение в суде"
                            },
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "процессуальное обращение к суду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "申请",
                                "target_lang_sense_clarification": "向法院提出、请求作出某种裁定的正式申请"
                            },
                            {
                                "target_lang_word": "动议",
                                "target_lang_sense_clarification": "普通法语境中的法律术语，对应 motion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "415825a4-43a5-3c0c-8bb9-7ab9294a9844",
                    "sense_definition": "An act of emptying the bowels; the waste matter discharged.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biological_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked the patient if they had experienced a regular bowel <w>motion</w> recently.",
                            "target_lang_translations": {
                                "ru": "Врач спросил пациента, был ли у него в последнее время регулярный <w>стул</w>.",
                                "zh": "医生问病人最近是否有规律的<w>排便</w>。"
                            }
                        },
                        {
                            "text": "A healthy diet rich in fiber helps maintain a consistent <w>motion</w> every morning.",
                            "target_lang_translations": {
                                "ru": "Здоровая диета, богатая клетчаткой, помогает поддерживать регулярное <w>опорожнение</w> каждое утро.",
                                "zh": "富含纤维的健康饮食有助于保持每天早晨规律<w>排便</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowel motion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical or formal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт опорожнения кишечника; выделяемые отходы жизнедеятельности.",
                        "zh": "排空肠道的行为；也可指排出的粪便。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стул",
                                "target_lang_sense_clarification": "медицинский термин для опорожнения кишечника"
                            },
                            {
                                "target_lang_word": "опорожнение",
                                "target_lang_sense_clarification": "процесс дефекации"
                            },
                            {
                                "target_lang_word": "испражнение",
                                "target_lang_sense_clarification": "акт выделения кала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排便",
                                "target_lang_sense_clarification": "医学或正式说法，指排便这一行为"
                            },
                            {
                                "target_lang_word": "大便",
                                "target_lang_sense_clarification": "日常或医学中也可指粪便本身"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c0664f6-1faf-30d6-8d32-3e1e523aeb67",
                    "sense_definition": "An internal impulse, desire, or movement of the mind and passions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "internal_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sudden <w>motion</w> of guilt after realizing the impact of his words.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал внезапное <w>движение</w> вины, осознав последствия своих слов.",
                                "zh": "意识到自己的话造成的影响后，他心中突然涌起一股愧疚的<w>冲动</w>。"
                            }
                        },
                        {
                            "text": "The poet described the <w>motion</w> of the soul as it seeks higher truths.",
                            "target_lang_translations": {
                                "ru": "Поэт описал <w>движение</w> души в ее поисках высших истин.",
                                "zh": "诗人描写了灵魂追寻更高真理时内在的<w>悸动</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in older literature or religious texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренний порыв, желание или движение ума и чувств.",
                        "zh": "内心的冲动、欲望，或思想与情感的活动；多见于较古旧或文学性的用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "движение",
                                "target_lang_sense_clarification": "внутреннее душевное переживание или порыв"
                            },
                            {
                                "target_lang_word": "порыв",
                                "target_lang_sense_clarification": "внезапное внутреннее побуждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲动",
                                "target_lang_sense_clarification": "内心突然生起的强烈念头或情感推动"
                            },
                            {
                                "target_lang_word": "悸动",
                                "target_lang_sense_clarification": "较书面、文学性的内在情感波动"
                            },
                            {
                                "target_lang_word": "心念",
                                "target_lang_sense_clarification": "较文言或文学化，指心中的念头、意动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "458f7de3-dd67-3a56-b693-d2ecd29bfd07",
                    "sense_definition": "To direct someone's attention or movement by making a gesture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gesturing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter <w>motioned</w> to the empty table in the corner of the restaurant.",
                            "target_lang_translations": {
                                "ru": "Официант <w>указал жестом</w> на пустой столик в углу ресторана.",
                                "zh": "服务员朝餐厅角落那张空桌子<w>示意</w>。"
                            }
                        },
                        {
                            "text": "She <w>motioned</w> for me to be quiet as the performance was about to begin.",
                            "target_lang_translations": {
                                "ru": "Она <w>показала жестом</w>, чтобы я замолчал, так как представление вот-вот должно было начаться.",
                                "zh": "演出快开始了，她做手势<w>示意</w>我安静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "move"
                    ],
                    "common_phrases": [
                        "motion to",
                        "motion for",
                        "motion someone over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять чье-либо внимание или указывать направление движения с помощью жеста.",
                        "zh": "用手势引导某人的注意或动作；做出示意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показать жестом",
                                "target_lang_sense_clarification": "указать направление или дать знак рукой"
                            },
                            {
                                "target_lang_word": "махнуть",
                                "target_lang_sense_clarification": "сделать знак рукой, приглашая или указывая"
                            },
                            {
                                "target_lang_word": "кивнуть",
                                "target_lang_sense_clarification": "подать знак головой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "示意",
                                "target_lang_sense_clarification": "用手势或动作向别人发出信号、指示或提醒"
                            },
                            {
                                "target_lang_word": "打手势",
                                "target_lang_sense_clarification": "强调以手势向某人招呼、示意过去或做某事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "af8e79fd-a5ce-3c25-86dd-90805f12f6ca",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the <w>Motion</w> family who donated the land.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Моушн</w>, которая пожертвовала землю.",
                                "zh": "当地图书馆以<w>莫申</w>家族的名字命名，他们捐赠了这块土地。"
                            }
                        },
                        {
                            "text": "Professor <w>Motion</w> is a well-known expert in the field of historical linguistics.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Моушн</w> — известный эксперт в области исторической лингвистики.",
                                "zh": "<w>莫申</w>教授是历史语言学领域的知名专家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Моушн",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莫申",
                                "target_lang_sense_clarification": "英语姓氏的音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}