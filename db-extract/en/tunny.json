                                                "text": "Das ist ein Thunfisch."
                                            },
                                            {
                                                "example_id": "a2151416-7dd0-44a2-8bc3-9f3abcfb11c9",
                                                "sense_id": "fe740076-a368-3069-8b60-b5a7255f96ad",
                                                "text": "Ich nehme eine Pizza mit Thunfisch."
                                            }
