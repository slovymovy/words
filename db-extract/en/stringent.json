                                                "sense_id": "ac010b76-53a4-340d-9ac0-51b2e5e5340b",
                                                "text": "Er formulierte eine stringente Argumentation."
                                            },
                                            {
                                                "example_id": "7e62c01d-16ab-4fb7-8d4b-84901f61f2af",
                                                "sense_id": "ac010b76-53a4-340d-9ac0-51b2e5e5340b",
                                                "text": "„Welcher Sportdirektor der Bundesliga verfolgt stringent eine Idee von zeitgemäßem Fußball?“"
