                    {
                        "sense_id": "864a9b30-9ed1-35c6-87b7-ddcea056481b",
                        "entry_id": "64fc63ce-fd18-3cba-8a9b-013fc6307fbe",
                        "glosses": [
                            "To move (something) back to its original place; undo or reverse the motion of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2ea0ce43-828e-4132-9021-b17ad5577825",
                                "sense_id": "864a9b30-9ed1-35c6-87b7-ddcea056481b",
                                "text": "They are all characterized by the use of an unmove generator to \"unmove\" pieces, or move them backward, possibly in conjunction with more traditional move generators."
                            },
                            {
                                "example_id": "8ee6bc43-f3e2-4d0c-a3c7-9730117b5eba",
                                "sense_id": "864a9b30-9ed1-35c6-87b7-ddcea056481b",
                                "text": "You can use this shortcut to undelete a deleted (but not trashed) file or to unmove something."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a89e63f-d0ee-314b-a745-e4edb602383a",
                        "entry_id": "64fc63ce-fd18-3cba-8a9b-013fc6307fbe",
                        "glosses": [
                            "To move away; remove."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "90e22e3b-1b64-4694-ad9f-09964ef038da",
                                "sense_id": "1a89e63f-d0ee-314b-a745-e4edb602383a",
                                "text": "[…] no dissenting voice arise to beseech them to look upon their work, to assist them to unmove the scales from their eyes […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "6a0f8b5a-474d-3b71-bf94-3d18c50e8238",
                        "entry_id": "64fc63ce-fd18-3cba-8a9b-013fc6307fbe",
                        "glosses": [
                            "To not move; remain still or motionless; remain in place."
                        ],
                        "tags": [
                            "intransitive",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "26f352a7-4089-4716-bc55-9152a18272ba",
                                "sense_id": "6a0f8b5a-474d-3b71-bf94-3d18c50e8238",
                                "text": "Nevertheless, James picked up a hard, cold stone and threw it with all his strength at the unmoving cat. It continued to unmove."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f2a125a-4b3a-3426-9a6e-ab62167f628d",
                        "entry_id": "64fc63ce-fd18-3cba-8a9b-013fc6307fbe",
                        "glosses": [
                            "To fail to move; fail to cause satisfaction, enjoyment, or delight."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "aa8ab57c-12bf-48c8-9f7c-a0ef4af20177",
                                "sense_id": "7f2a125a-4b3a-3426-9a6e-ab62167f628d",
                                "text": "He looked around at the unlit light fixtures and the crown molding that he liked so much when they moved in, but now these trivial details were starting to unmove him."
                            }
                        ]
                    }
