                "senses": [
                    {
                        "sense_id": "670d5685-80e4-3906-a944-d9bb8d5bae4a",
                        "entry_id": "4f1701a6-fc89-328e-ba38-b712f2072b45",
                        "glosses": [
                            "питомник для содержания, разведения и получения фармацевтического сырья от змей (в основном — ядовитых)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66686200-5305-497f-8bb2-6aa050eeec5c",
                                "sense_id": "670d5685-80e4-3906-a944-d9bb8d5bae4a",
                                "text": "За рубежом появились специализированные научные учреждения со змеепитомниками (серпентариями) ― например, институт Бутантана в Бразилии, институт имени Хавкина в Индии, Пастеровские институты во Франции и Алжире."
                            }
                        ]
                    },
                    {
                        "sense_id": "da322cc1-94e8-3c28-9936-f5876c5fe252",
                        "entry_id": "4f1701a6-fc89-328e-ba38-b712f2072b45",
                        "glosses": [
                            "перен. рассадник гадов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "224ac8e3-ff18-4ed2-a596-1d5b83621254",
                                "sense_id": "da322cc1-94e8-3c28-9936-f5876c5fe252",
                                "text": "Там был серпентарий, а не коллектив."
                            }
                        ]
                    }
