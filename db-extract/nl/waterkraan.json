                            {
                                "example_id": "7005fc8e-56fb-497c-9ff6-ab200a7c61c0",
                                "sense_id": "0015e115-c1c8-3c19-a62a-90ef2f76f734",
                                "text": "Met de waterkraan bij de watermeter kan men het water afsluiten."
                            }
