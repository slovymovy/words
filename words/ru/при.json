{
    "word_family": [],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "ba3ccfe6-1491-3404-9bd5-28017f58f0b4",
                    "sense_definition": "Указывает на нахождение в непосредственной близости от чего-либо или кого-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нас есть небольшой сад <w>при</w> доме.",
                            "target_lang_translations": {
                                "en": "We have a small garden <w>by</w> the house.",
                                "zh": "我们房子<w>旁边</w>有一个小花园。"
                            }
                        },
                        {
                            "text": "Она ждала его <w>при</w> входе в парк.",
                            "target_lang_translations": {
                                "en": "She was waiting for him <w>at</w> the entrance to the park.",
                                "zh": "她<w>在</w>公园入口处等他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "у",
                        "возле",
                        "около",
                        "рядом с"
                    ],
                    "common_phrases": [
                        "при дороге",
                        "при входе"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates being in close proximity to something or someone.",
                        "zh": "表示位于某人或某物附近。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at",
                                "target_lang_sense_clarification": "general location or proximity"
                            },
                            {
                                "target_lang_word": "by",
                                "target_lang_sense_clarification": "near or next to"
                            },
                            {
                                "target_lang_word": "near",
                                "target_lang_sense_clarification": "close to"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……旁边",
                                "target_lang_sense_clarification": "表示位置靠近"
                            },
                            {
                                "target_lang_word": "在",
                                "target_lang_sense_clarification": "表示一般位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f34db1a0-eafd-346c-b8e6-0f37b0beeca3",
                    "sense_definition": "Указывает на время совершения действия или период, связанный с каким-либо событием или жизнью определенного лица.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>При</w> встрече мы обсудим все детали.",
                            "target_lang_translations": {
                                "en": "<w>At</w> the meeting, we will discuss all the details.",
                                "zh": "我们见面<w>时</w>会讨论所有细节。"
                            }
                        },
                        {
                            "text": "Этот красивый дом был построен ещё <w>при</w> царе.",
                            "target_lang_translations": {
                                "en": "This beautiful house was built back <w>under</w> the Tsar.",
                                "zh": "这座漂亮的房子是在沙皇<w>统治时期</w>建的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "во время",
                        "во времена"
                    ],
                    "common_phrases": [
                        "при встрече",
                        "при жизни",
                        "при этом"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates the time of an action, or a period associated with an event or a person's life/rule.",
                        "zh": "表示动作发生的时间，或与某事件、某人一生或统治时期相关的阶段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at",
                                "target_lang_sense_clarification": "used with events (e.g., at the meeting)"
                            },
                            {
                                "target_lang_word": "under",
                                "target_lang_sense_clarification": "during the rule or time of someone"
                            },
                            {
                                "target_lang_word": "during",
                                "target_lang_sense_clarification": "throughout the course of"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……时",
                                "target_lang_sense_clarification": "用于特定事件或时刻"
                            },
                            {
                                "target_lang_word": "在……统治下",
                                "target_lang_sense_clarification": "用于历史时期或统治者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "261b5019-58e4-3a14-9104-f56a733efbef",
                    "sense_definition": "Указывает на обстоятельство или условие, при котором происходит действие.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>При</w> желании можно добиться больших успехов в учебе.",
                            "target_lang_translations": {
                                "en": "<w>With</w> desire, one can achieve great success in studies.",
                                "zh": "<w>如果</w>有意愿，学习上是可以取得很大成就的。"
                            }
                        },
                        {
                            "text": "Звоните в скорую помощь <w>при</w> высокой температуре.",
                            "target_lang_translations": {
                                "en": "Call an ambulance <w>in case of</w> high fever.",
                                "zh": "<w>如果</w>出现高烧，请拨打急救电话。"
                            }
                        }
                    ],
                    "antonyms": [
                        "без"
                    ],
                    "common_phrases": [
                        "при условии",
                        "при необходимости",
                        "при помощи",
                        "при желании"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates a circumstance or condition under which an action takes place.",
                        "zh": "表示动作发生的环境或条件。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in case of",
                                "target_lang_sense_clarification": "used with conditions like emergency or illness"
                            },
                            {
                                "target_lang_word": "with",
                                "target_lang_sense_clarification": "having a certain condition (e.g., with desire)"
                            },
                            {
                                "target_lang_word": "given",
                                "target_lang_sense_clarification": "considering a condition"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……情况下",
                                "target_lang_sense_clarification": "用于紧急或特定条件"
                            },
                            {
                                "target_lang_word": "如果",
                                "target_lang_sense_clarification": "表示假设条件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bdbb723-7dd9-30b7-ab86-18ee4779f9d7",
                    "sense_definition": "Указывает на лицо, в присутствии которого происходит действие.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, не ругайтесь и не спорьте <w>при</w> детях.",
                            "target_lang_translations": {
                                "en": "Please do not swear or argue <w>in front of</w> the children.",
                                "zh": "请不要在孩子<w>面前</w>吵架或争论。"
                            }
                        },
                        {
                            "text": "Он стеснялся выступать <w>при</w> большом количестве незнакомых людей.",
                            "target_lang_translations": {
                                "en": "He was shy to perform <w>in front of</w> a large number of strangers.",
                                "zh": "他在很多陌生人<w>面前</w>表演会感到害羞。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "при свидетелях",
                        "при мне",
                        "при всех"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates the person in whose presence the action occurs.",
                        "zh": "表示动作发生时在场的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in front of",
                                "target_lang_sense_clarification": "in the presence of people"
                            },
                            {
                                "target_lang_word": "in the presence of",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……面前",
                                "target_lang_sense_clarification": "表示有他人在场"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a4bdfad-1017-3b42-97f7-f9349223b722",
                    "sense_definition": "Указывает на наличие чего-либо у лица в данный момент (обычно в одежде или в руках).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для входа в здание у вас должен быть <w>при</w> себе паспорт.",
                            "target_lang_translations": {
                                "en": "To enter the building, you must have a passport <w>with</w> you.",
                                "zh": "进入大楼时，你必须<w>随身携带</w>护照。"
                            }
                        },
                        {
                            "text": "К сожалению, <w>при</w> мне сейчас нет наличных денег.",
                            "target_lang_translations": {
                                "en": "Unfortunately, I have no cash <w>on</w> me right now.",
                                "zh": "很遗憾，我现在身上没<w>带</w>现金。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "при себе",
                        "иметь при себе"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates possession of something by a person at the moment (on one's person).",
                        "zh": "表示某人此刻随身携带某物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "on",
                                "target_lang_sense_clarification": "carried on one's person"
                            },
                            {
                                "target_lang_word": "with",
                                "target_lang_sense_clarification": "in one's immediate possession"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随身携带",
                                "target_lang_sense_clarification": "表示物品在身上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "116fecb8-4058-3340-ad7f-8ae1b653e5c3",
                    "sense_definition": "Указывает на учреждение или организацию, в составе которой находится или функционирует данный объект.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "affiliation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач принимает пациентов в поликлинике <w>при</w> университете.",
                            "target_lang_translations": {
                                "en": "The doctor sees patients at the clinic <w>at</w> the university.",
                                "zh": "医生在大学<w>附属</w>诊所为病人看病。"
                            }
                        },
                        {
                            "text": "Столовая <w>при</w> заводе работает круглосуточно для всех сотрудников.",
                            "target_lang_translations": {
                                "en": "The canteen <w>at</w> the factory works around the clock for all employees.",
                                "zh": "工厂<w>附属</w>的食堂为所有员工全天候开放。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an institution or organization to which an object is attached or functions within.",
                        "zh": "表示某物所属或附属于某个机构或组织。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at",
                                "target_lang_sense_clarification": "located within or associated with"
                            },
                            {
                                "target_lang_word": "attached to",
                                "target_lang_sense_clarification": "affiliated with"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附属于",
                                "target_lang_sense_clarification": "表示机构隶属关系"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3555cf58-4f17-3883-acae-4bc1c611f137",
                    "sense_definition": "Форма повелительного наклонения глагола <w>переть</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Давай, <w>при</w> отсюда, пока цел!",
                            "target_lang_translations": {
                                "en": "Come on, <w>scram</w> out of here while you're in one piece!",
                                "zh": "快点，趁你还没受伤赶紧<w>滚</w>！"
                            }
                        },
                        {
                            "text": "Сильнее <w>при</w> на дверь, она, кажется, заела.",
                            "target_lang_translations": {
                                "en": "<w>Push</w> harder on the door, it seems to be stuck.",
                                "zh": "用力<w>推</w>门，它好像卡住了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'переть' (to push, to trudge).",
                        "zh": "动词“переть”（推、走）的命令式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "push",
                                "target_lang_sense_clarification": "apply force"
                            },
                            {
                                "target_lang_word": "scram",
                                "target_lang_sense_clarification": "slang, go away"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推",
                                "target_lang_sense_clarification": "施加力量"
                            },
                            {
                                "target_lang_word": "滚开",
                                "target_lang_sense_clarification": "俚语，离开"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13ef0fa3-0cfc-3061-a398-c00bef9330d4",
                    "sense_definition": "Форма родительного падежа единственного числа существительного <w>пря</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Суть этой давней <w>при</w> была никому не ясна.",
                            "target_lang_translations": {
                                "en": "The essence of this ancient <w>strife</w> was clear to no one.",
                                "zh": "这场古老<w>争执</w>的本质没人清楚。"
                            }
                        },
                        {
                            "text": "Он избегал любой <w>при</w> и старался жить мирно.",
                            "target_lang_translations": {
                                "en": "He avoided any <w>quarrel</w> and tried to live peacefully.",
                                "zh": "他避免任何<w>冲突</w>，努力和平生活。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Genitive singular form of the archaic noun 'пря' (strife, argument).",
                        "zh": "古语名词“пря”（争执、冲突）的单数属格形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strife",
                                "target_lang_sense_clarification": "archaic"
                            },
                            {
                                "target_lang_word": "quarrel",
                                "target_lang_sense_clarification": "archaic"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "争执",
                                "target_lang_sense_clarification": "古语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}