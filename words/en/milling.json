{
    "word_family": [
        "mill",
        "miller",
        "millwork"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee845386-c4eb-34fb-bcc6-3ae088405554",
                    "sense_definition": "present participle and gerund of <w>mill</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The confused tourists were <w>milling</w> around the station lobby looking for their platform.",
                            "target_lang_translations": {
                                "ru": "Растерянные туристы <w>слонялись</w> по вестибюлю вокзала в поисках своей платформы."
                            }
                        },
                        {
                            "text": "They spent hours <w>milling</w> wheat into fine flour for the local bakeries.",
                            "target_lang_translations": {
                                "ru": "Они часами <w>мололи</w> пшеницу в тонкую муку для местных пекарен."
                            }
                        }
                    ],
                    "common_phrases": [
                        "milling around",
                        "milling about"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола mill (толпиться, суетиться; молоть, фрезеровать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толпящийся",
                                "target_lang_sense_clarification": "о людях, движущихся хаотично"
                            },
                            {
                                "target_lang_word": "молоть",
                                "target_lang_sense_clarification": "в значении действия измельчения"
                            },
                            {
                                "target_lang_word": "перемалывающий",
                                "target_lang_sense_clarification": "причастие, измельчающий зерно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe09a14e-e56b-30dc-8c48-c3c4283f2f30",
                    "sense_definition": "The industrial or mechanical process of grinding, cutting, or crushing material, especially grain into flour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traditional grain <w>milling</w> relies heavily on wind or water power to turn the stones.",
                            "target_lang_translations": {
                                "ru": "Традиционный <w>помол</w> зерна во многом зависит от энергии ветра или воды, приводящей в движение жернова."
                            }
                        },
                        {
                            "text": "The company upgraded its grain <w>milling</w> equipment to increase daily flour production.",
                            "target_lang_translations": {
                                "ru": "Компания модернизировала оборудование для <w>помола</w> зерна, чтобы увеличить ежедневное производство муки."
                            }
                        }
                    ],
                    "synonyms": [
                        "grinding"
                    ],
                    "common_phrases": [
                        "flour milling",
                        "grain milling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс помола, измельчения или дробления сырья, особенно зерна в муку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помол",
                                "target_lang_sense_clarification": "зерна или других продуктов"
                            },
                            {
                                "target_lang_word": "измельчение",
                                "target_lang_sense_clarification": "дробление сырья"
                            },
                            {
                                "target_lang_word": "размол",
                                "target_lang_sense_clarification": "механическая обработка зерна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0052d5e-fb9e-303c-9759-5cfe3969c25c",
                    "sense_definition": "A wandering, circular, or aimless movement of a large crowd or herd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restless <w>milling</w> of the crowd intensified right before the stadium gates opened.",
                            "target_lang_translations": {
                                "ru": "Беспокойная <w>толкотня</w> в толпе усилилась прямо перед открытием ворот стадиона."
                            }
                        },
                        {
                            "text": "Guards observed the continuous <w>milling</w> of passengers in the busy airport terminal.",
                            "target_lang_translations": {
                                "ru": "Охрана наблюдала за непрестанной <w>суетой</w> пассажиров в оживлённом терминале аэропорта."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочное, хаотичное или круговое движение толпы людей либо стада животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толкотня",
                                "target_lang_sense_clarification": "суета и хаотичное движение толпы"
                            },
                            {
                                "target_lang_word": "суета",
                                "target_lang_sense_clarification": "беспорядочные перемещения"
                            },
                            {
                                "target_lang_word": "брожение",
                                "target_lang_sense_clarification": "бесцельное движение массы людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "add9e053-abc8-3dbd-a07a-52882fff9c04",
                    "sense_definition": "A machining operation in which material is removed from a workpiece using rotary cutting tools.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Computer-controlled metal <w>milling</w> allows precise parts to be manufactured with ease.",
                            "target_lang_translations": {
                                "ru": "<w>Фрезерование</w> металла с компьютерным управлением позволяет с лёгкостью изготавливать высокоточные детали."
                            }
                        },
                        {
                            "text": "High-precision <w>milling</w> is essential for creating components used in aircraft engines.",
                            "target_lang_translations": {
                                "ru": "Высокоточная <w>фрезеровка</w> необходима для создания компонентов, используемых в авиационных двигателях."
                            }
                        }
                    ],
                    "synonyms": [
                        "machining"
                    ],
                    "common_phrases": [
                        "CNC milling",
                        "milling machine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическая обработка материалов вращающимся режущим инструментом (фрезой)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрезерование",
                                "target_lang_sense_clarification": "механообработка резанием"
                            },
                            {
                                "target_lang_word": "фрезеровка",
                                "target_lang_sense_clarification": "разговорное обозначение процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "432d30d5-17e8-3bae-8991-58b073c4258b",
                    "sense_definition": "The cutting, shaping, and planing of wood into finished building components or trim.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Careful timber <w>milling</w> produces smooth floorboards that fit together seamlessly.",
                            "target_lang_translations": {
                                "ru": "Аккуратная <w>распиловка</w> древесины позволяет получать гладкие половые доски, которые идеально стыкуются друг с другом."
                            }
                        },
                        {
                            "text": "He managed the wood <w>milling</w> facility that supplied materials to local carpenters.",
                            "target_lang_translations": {
                                "ru": "Он руководил предприятием по <w>деревообработке</w>, поставлявшим материалы местным плотникам."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распиловка, строгание и механическая обработка древесины для изготовления пиломатериалов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распиловка",
                                "target_lang_sense_clarification": "первичная обработка древесины"
                            },
                            {
                                "target_lang_word": "деревообработка",
                                "target_lang_sense_clarification": "процесс обработки лесоматериалов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e4d7b1d-d092-303c-918c-680cd9e8568b",
                    "sense_definition": "A series of ridges or grooves around the outer edge of a coin to prevent clipping or wear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coin edge <w>milling</w> had worn smooth after decades in general circulation.",
                            "target_lang_translations": {
                                "ru": "<w>Рифление</w> на гурте монеты стёрлось за десятилетия обращения."
                            }
                        },
                        {
                            "text": "He inspected the sharp <w>milling</w> to verify that the rare silver dollar was authentic.",
                            "target_lang_translations": {
                                "ru": "Он осмотрел чёткую <w>насечку</w>, чтобы убедиться в подлинности редкого серебряного доллара."
                            }
                        }
                    ],
                    "synonyms": [
                        "reeding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рифление или насечки на ребре (гурте) монеты для защиты от стачивания и подделки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рифление",
                                "target_lang_sense_clarification": "насечки на гурте монеты"
                            },
                            {
                                "target_lang_word": "насечка",
                                "target_lang_sense_clarification": "ребристый край монеты"
                            },
                            {
                                "target_lang_word": "гурт",
                                "target_lang_sense_clarification": "ребро монеты с насечкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4efcc0e4-be92-38d8-a22e-9b607cdc37b0",
                    "sense_definition": "The surface texture, pattern, or finished edge produced by a milling process.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fine <w>milling</w> across the steel plate ensured that the two components locked securely.",
                            "target_lang_translations": {
                                "ru": "Тонкая <w>фрезеровка</w> на стальной пластине обеспечивала надёжную фиксацию двух компонентов."
                            }
                        },
                        {
                            "text": "Inspectors rejected the metal piece because the surface <w>milling</w> was uneven.",
                            "target_lang_translations": {
                                "ru": "Инспекторы забраковали металлическую деталь из-за неровной <w>фрезеровки поверхности</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Текстура, рельеф или рисунок поверхности, полученные в результате фрезерования или накатки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрезерованная поверхность",
                                "target_lang_sense_clarification": "обработанная фрезой текстура"
                            },
                            {
                                "target_lang_word": "накатка",
                                "target_lang_sense_clarification": "рельефный узор или насечка"
                            }
                        ]
                    }
                }
            ]
        },
