        "fr-extract.jsonl": [
            {
                "entry_id": "550db5dc-53a1-3da8-82bf-3204180c8df8",
                "word": "gaillardement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "651c9dfa-6ef9-333c-88ca-00507393029d",
                        "entry_id": "550db5dc-53a1-3da8-82bf-3204180c8df8",
                        "glosses": [
                            "D’une façon gaillarde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a566fe7-2fcc-481d-9aab-71334e699341",
                                "sense_id": "651c9dfa-6ef9-333c-88ca-00507393029d",
                                "text": "Destin fut surpris de la voir si gaillardement vêtue."
                            },
                            {
                                "example_id": "adf81ee5-0b35-4e81-9237-06aa938ce248",
                                "sense_id": "651c9dfa-6ef9-333c-88ca-00507393029d",
                                "text": "Si s'avencerent les Pelopônesiens de combattre et affaiblir les premiers, afin d'enclore de leur pointe fenêtre, la droite des Athéniens s'ils pouvaient, en manière qu'ils n'eussent pouvoir d'eux élargir en la mer, et que les autres navires qui tenaient le milieu / fussent contraints eux retirer en la terre qui n’était guère lointaine / donc eux étant les Athéniens apperceur du côté que les ennemis le voulaient venir enclore, les viendraient assaillir vivement, et ayant pris leur charge de la mer nageaient et conduisaient leurs navires plus gaillardement que les autres."
                            }
                        ]
                    },
                    {
                        "sense_id": "95fbb1a0-ddd6-3079-90eb-2e2408b5c542",
                        "entry_id": "550db5dc-53a1-3da8-82bf-3204180c8df8",
                        "glosses": [
                            "Légèrement, sans façon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85303e82-5e73-49cc-a047-83e0c34f6ff8",
                                "sense_id": "95fbb1a0-ddd6-3079-90eb-2e2408b5c542",
                                "text": "Il a fait cela un peu gaillardement."
                            },
                            {
                                "example_id": "8d0eedae-95ec-498d-a52b-f9a73c16b1e3",
                                "sense_id": "95fbb1a0-ddd6-3079-90eb-2e2408b5c542",
                                "text": "Aristippe n’en fit aucune difficulté. Il commença à danser avec la robe et dit gaillardement : On en fait bien d’autres dans les fêtes de Bacchus, et cependant on ne s’y corrompt pas, quand on ne l’est pas d’ailleurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "a752abf7-120e-3378-89a7-297eb1e997b5",
                        "entry_id": "550db5dc-53a1-3da8-82bf-3204180c8df8",
                        "glosses": [
                            "Avec entrain et courage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0e31c5-d45a-4723-b9ce-d82ba05dc190",
                                "sense_id": "a752abf7-120e-3378-89a7-297eb1e997b5",
                                "text": "Attaquer gaillardement."
                            },
                            {
                                "example_id": "7575f9d1-0dd0-4b80-a772-9c15b65bbd56",
                                "sense_id": "a752abf7-120e-3378-89a7-297eb1e997b5",
                                "text": "Je travaille gaillardement à l’Extrême onction, qui est en vérité un sujet digne d’un Apelle, car il se plaisait fort à représenter des mourants."
                            },
                            {
                                "example_id": "27db0dd8-fc26-423b-a8ce-e46ce483c090",
                                "sense_id": "a752abf7-120e-3378-89a7-297eb1e997b5",
                                "text": "Je le traversai [le cimetière] gaillardement."
                            },
                            {
                                "example_id": "8c0a5812-837b-4cad-adc6-35c6a8058d45",
                                "sense_id": "a752abf7-120e-3378-89a7-297eb1e997b5",
                                "text": "Quand Silvère, à la respiration régulière de Miette, eut compris qu’elle sommeillait, il fut heureux de ce repos qui allait leur permettre de continuer gaillardement leur chemin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99bdd742-513d-4787-8584-a593f490c073",
                        "source_entry_id": "550db5dc-53a1-3da8-82bf-3204180c8df8",
                        "target_lang_word": "bravely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bravely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                        "entry_id": "af06285a-389f-31a9-a47e-ded0c213034c",
                                        "glosses": [
                                            "In a brave manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc15363-cf0b-490e-9b66-4929950541cb",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "The soldiers faced the enemy bravely."
                                            },
                                            {
                                                "example_id": "fe6194dc-737b-4d12-a115-6f3f4028bb1c",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "Here, here, here's an excellent place; here we may see most bravely: I'll tell you them all by their names as they pass by; but mark Troilus above the rest."
                                            },
                                            {
                                                "example_id": "ba74d131-0fac-4ca7-845c-9e79c2c2bcc1",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "No, they hold there a large, round wad of tow and cork, enveloped in the thickest and toughest of ox-hide. That bravely and uninjured takes the jam which would have snapped all their oaken handspikes and iron crow-bars."
                                            },
                                            {
                                                "example_id": "f5033be6-a1ea-429a-93d6-1797fcd465a4",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "[H]e stepped forward and said bravely, though his hand trembled, and his face was as pale as snow:—\n“My true friend, from the bottom of my broken heart I thank you. Tell me what I am to do, and I shall not falter!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7588d37-23db-43a1-873c-de513f168892",
                        "source_entry_id": "550db5dc-53a1-3da8-82bf-3204180c8df8",
                        "target_lang_word": "cheerfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheerfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c710f63-92b7-3f95-8bb8-97578e15f304",
                                        "entry_id": "51ad7a16-789d-37c1-9ad1-56da67663115",
                                        "glosses": [
                                            "In a cheerful manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f61161b-ffb3-4299-b371-41e5a18570fc",
                                                "sense_id": "1c710f63-92b7-3f95-8bb8-97578e15f304",
                                                "text": "That principle carried out consistently and logically, makes the individual not a claimant upon society, but a benefiter of it. He contributes whatever talent, natural or acquired, he may have, cheerfully to the promotion of the common good, […]"
                                            },
                                            {
                                                "example_id": "e0b4e27f-2e93-473e-87d4-0d64cd5a195c",
                                                "sense_id": "1c710f63-92b7-3f95-8bb8-97578e15f304",
                                                "text": "'Well, what have you done this time?' asked Sebastian cheerfully."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3acc263-ab90-4fa0-b2a8-28356102d130",
                        "source_entry_id": "550db5dc-53a1-3da8-82bf-3204180c8df8",
