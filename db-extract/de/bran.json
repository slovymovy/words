                "senses": [
                    {
                        "sense_id": "aa04ac35-ea03-35b7-9655-c2cf3b95a9aa",
                        "entry_id": "0fd01058-f0fc-38b2-b456-a4c2b4e344cf",
                        "glosses": [
                            "fundamentales Objekt in der M-Theorie, welches als bis zu 11-dimensional angenommen wird"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "cef050ce-b5e3-4f93-8954-8170b46bbcd1",
                                "sense_id": "aa04ac35-ea03-35b7-9655-c2cf3b95a9aa",
                                "text": "„Offene Strings haften an Branen, hier dargestellt als zweidimensionale Oberfläche (2D-Bran). Sie können sich allerdings auf der Bran frei bewegen.“"
                            },
                            {
                                "example_id": "04cfd2f9-45f0-489f-a470-7b871eca7dad",
                                "sense_id": "aa04ac35-ea03-35b7-9655-c2cf3b95a9aa",
                                "text": "„So könnte in einer fünfdimensionalen Stringtheorie die Gravitation möglicherweise nur auf unserer vierdimensionalen Bran (dem Universum bzw. der Raumzeit, in dem bzw. in der wir leben) so schwach sein, während sie außerhalb – d. h. in der fünften Dimension – stark anwachsen und höhere Werte annehmen könnte […]“"
                            },
                            {
                                "example_id": "40cdfddc-044c-48ad-b738-24d0566ba1f0",
                                "sense_id": "aa04ac35-ea03-35b7-9655-c2cf3b95a9aa",
                                "text": "„Gemäß der Stringtheorie besteht das Universum aus Strings und aus Branen.“"
                            },
                            {
                                "example_id": "662f2744-847c-44d8-b19e-f103ddb7724e",
                                "sense_id": "aa04ac35-ea03-35b7-9655-c2cf3b95a9aa",
                                "text": "„Wenn solche Gedanken mehr als interessante mathematische Überlegungen sind, und wenn wir tatsächlich auf einer Bran zu Hause sind, dann erleben wir gerade jetzt den Schraubstockgriff, den unsere Bran auf die Enden von Strings ausübt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
