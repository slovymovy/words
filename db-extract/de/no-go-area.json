                ],
                "senses": [
                    {
                        "sense_id": "286ca5f6-c2d9-3212-8e37-afe586d4b0ea",
                        "entry_id": "c4162340-8f64-309b-94e0-af094bacdbdb",
                        "glosses": [
                            "Region, dessen Betreten verboten, gefährlich oder nicht möglich ist, Stadtgebiet, in dem der Staat sein Gewaltmonopol verloren hat"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "67f1e16d-98bd-4bdd-a7c3-25337d8a1f9b",
                                "sense_id": "286ca5f6-c2d9-3212-8e37-afe586d4b0ea",
                                "text": "Das Grenzgebiet in Afghanistan ist zur Zeit eine No-go-Area."
                            },
                            {
                                "example_id": "9ba1c6d9-7e4d-4ee5-aee4-18b1b1086228",
                                "sense_id": "286ca5f6-c2d9-3212-8e37-afe586d4b0ea",
                                "text": "„Von ‚No-Go-Area‘ war in diesen zahlreich die Rede und fast jeder siebte Einwohner sollte dort arbeitslos sein. Über 90 verschiedene Nationalitäten würden dort mehr oder weniger friedlich zusammenleben, bei außergewöhnlich hohem Straßenlärm und enormer Feinstaubbelastung.“"
                            },
                            {
                                "example_id": "1236e6d7-b06f-4d1c-99cc-7e0c51717ca8",
                                "sense_id": "286ca5f6-c2d9-3212-8e37-afe586d4b0ea",
                                "text": "„Die No-go-Area kam von der Aryan Brotherhood, welche in den Gefängnissen Grenzlinien zwischen beispielsweise Latinos und Weißen zog und so die Mordrate senkte!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0be024b3-bcbb-30a4-b7e6-f1fd766c4cf8",
                        "entry_id": "c4162340-8f64-309b-94e0-af094bacdbdb",
                        "glosses": [
                            "tabuisiertes Themengebiet oder Handlungsfeld, in das man sich nicht begeben sollte"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e48c7eb5-cd01-480f-bd8a-0cb05d7eda07",
                                "sense_id": "0be024b3-bcbb-30a4-b7e6-f1fd766c4cf8",
                                "text": "„Waren Fernsehserien früher noch eine „No-go-Area“ für Akademikerinnen und Akademiker, sehen diese hier heute „eine neue Avantgarde am Werk“.“"
                            },
                            {
                                "example_id": "cd2d0c26-30a8-4195-873e-5dc1fb30ec0e",
                                "sense_id": "0be024b3-bcbb-30a4-b7e6-f1fd766c4cf8",
                                "text": "„Doch er unterstützt Davis in seiner Sichtweise, dass das Thema Slum im Grunde eine akademische No-Go-Area ist.“"
                            },
                            {
                                "example_id": "955d6683-cdea-4cb0-92d3-ba4e673b9674",
                                "sense_id": "0be024b3-bcbb-30a4-b7e6-f1fd766c4cf8",
                                "text": "„Die ,grande passion', die sich abzeichnet, liegt innerhalb der moralischen Dichotomisierung des Film in der ,No go-area'. Nicht nur das Böse, auch die Erotik und die Sinnlichkeit werden am Ende ausgetrieben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
