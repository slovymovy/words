                        "entry_id": "7b9f5a5f-f218-395e-af13-79df0ff49b8f",
                        "glosses": [
                            "Gras, das angebaut wird, um es nach der Ernte an Tiere zu verfüttern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc105eaa-82f8-493f-b86a-f4b35ffbedd0",
                                "sense_id": "822db240-ca6b-35f7-ac10-6402d83de476",
                                "text": "Heute ernten wir Futtergras für unsere Biokühe."
                            },
                            {
                                "example_id": "487507dd-3142-454a-a817-4cbb9d1a6479",
                                "sense_id": "822db240-ca6b-35f7-ac10-6402d83de476",
                                "text": "In unserer Gegend wachsen viele verschiedene Futtergräser."
                            }
                        ],
