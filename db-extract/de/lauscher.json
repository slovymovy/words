                "senses": [
                    {
                        "sense_id": "459fff3a-2e0b-360c-bc2b-669e841e11e2",
                        "entry_id": "26bf82f5-2a24-32f8-9565-ebee370c30b0",
                        "glosses": [
                            "(männliche^☆) Person, die heimlich andere Personen belauscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc5411e-b677-4430-8636-d3d1fcfecea6",
                                "sense_id": "459fff3a-2e0b-360c-bc2b-669e841e11e2",
                                "text": "„Den Lauscher hatte er nicht bemerkt, wohl gar nicht für möglich gehalten, daß ein solcher in der Nähe sein könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ba48637f-0ea6-302c-9251-8e935934d5ed",
                        "entry_id": "26bf82f5-2a24-32f8-9565-ebee370c30b0",
                        "glosses": [
                            "äußeres Ohr bei wilden Huftieren und beim Haarwild"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "00f8829b-1734-463f-bfc0-cd46dab3b47e",
                                "sense_id": "ba48637f-0ea6-302c-9251-8e935934d5ed",
                                "text": "„Große Lauscher setzen unsere Füchse oder alle Wüstentiere überhaupt in den Stand, auch das geringste Geräusch zu vernehmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f212a88-0423-4f91-b2e7-a77b3e1e7f6d",
