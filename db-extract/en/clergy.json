                    },
                    {
                        "translation_id": "432f382e-ddf0-43d7-8ae3-e9e86a52aa51",
                        "source_entry_id": "cc1e08c5-076a-3234-9ae1-f1bd7030ddee",
                        "source_sense_id": "81e487eb-aaf2-3550-9989-f86cdc3f03ce",
