                            }
                        },
                        {
                            "text": "He succeeded in <w>quitting</w> cold turkey after years of addiction.",
                            "target_lang_translations": {
                                "ru": "Ему удалось резко <w>бросить</w> после многих лет зависимости.",
                                "pl": "Udało mu się <w>rzucić</w> z dnia na dzień po latach uzależnienia."
                            }
                        }
