                "senses": [
                    {
                        "sense_id": "36c836c1-0be7-377d-9e77-4e7fca189611",
                        "entry_id": "0615ca93-fc2f-338a-8b4b-00d66e421acf",
                        "glosses": [
                            "relativ kleiner Spiegel mit Stiel, den man in die Hand nehmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86863f5-5636-460a-b912-e25c67191156",
                                "sense_id": "36c836c1-0be7-377d-9e77-4e7fca189611",
                                "text": "„Ich blickte in den Handspiegel und sah ein Ei, ein poliertes Ei mit Ohren, etwas schrumpelig von der Ruhr, unten flussgebräunt, oben schneeweiß.“"
                            },
                            {
                                "example_id": "3f6bf9d1-9351-4802-88c5-222abb0faf92",
                                "sense_id": "36c836c1-0be7-377d-9e77-4e7fca189611",
                                "text": "„In einer Ecke der Küche hockt ein Weltraumaffe auf dem rissigen Linoleum und betrachtet sich in einem Handspiegel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
