                {
                    "sense_id": "b26b1fa5-f0da-3864-bb14-cf537229cc3b",
                    "sense_definition": "Devenir plus important en volume, en force ou en quantité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "croissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la pluie torrentielle, le ruisseau commence à <w>grossir</w> rapidement.",
                            "target_lang_translations": {
                                "en": "After the torrential rain, the stream is starting to <w>swell</w> rapidly.",
                                "ru": "После проливного дождя ручей начинает быстро <w>прибывать</w>.",
                                "de": "Nach dem Starkregen beginnt der Bach, schnell <w>anzuschwellen</w>.",
                                "es": "Después de la lluvia torrencial, el arroyo empieza a <w>crecer</w> rápidamente.",
                                "zh": "暴雨过后，小溪的水位开始迅速<w>上涨</w>。"
                            }
                        },
                        {
                            "text": "La foule de manifestants <w>grossit</w> à mesure qu'elle approche du centre.",
                            "target_lang_translations": {
                                "en": "The crowd of protesters <w>swells</w> as it nears the centre.",
                                "ru": "Толпа демонстрантов <w>растёт</w> по мере того, как она приближается к центру.",
                                "de": "Die Menge der Demonstranten <w>wächst</w>, je näher sie dem Zentrum kommt.",
                                "es": "La multitud de manifestantes <w>crece</w> a medida que se acerca al centro.",
                                "zh": "游行人群越靠近市中心就越<w>壮大</w>。"
                            }
                        }
