                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otírající se čenichem",
                                "target_lang_sense_clarification": "vyjádření činnosti zvířete"
                            },
                            {
                                "target_lang_word": "šťouchající nosem",
                                "target_lang_sense_clarification": "vyjádření jemného kontaktu"
                            }
                        ]
                    }
                }
            ]
        }
