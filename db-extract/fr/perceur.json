                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bohrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5423f9fc-7b08-3254-afe3-6737ebc98afb",
                                        "entry_id": "70d82d75-50a9-3552-9e05-cc16deacfcea",
                                        "glosses": [
                                            "stangenartiges Werkzeug zum Herstellen von kreisförmigen Löchern durch drehende Bewegungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23f91c0e-d8e1-4848-aecc-33b66e49cabb",
                                                "sense_id": "5423f9fc-7b08-3254-afe3-6737ebc98afb",
                                                "text": "Ich brauche den 6mm Bohrer."
                                            },
                                            {
                                                "example_id": "6567621c-e731-47f3-9a84-0cd1a7a3ebdc",
                                                "sense_id": "5423f9fc-7b08-3254-afe3-6737ebc98afb",
                                                "text": "„Sie zeigt einen Bohrer samt dem Loch, das er garade gebohrt hat; das Werkzeug wird hier also mitten bei der Arbeit abgebildet.“"
                                            },
                                            {
                                                "example_id": "5f162072-0d23-410d-9e81-0e6715f5c85d",
                                                "sense_id": "5423f9fc-7b08-3254-afe3-6737ebc98afb",
                                                "text": "„Auf dem Boden liegen Feilen, Meißel, Bohrer, Taue, Drähte, Drahtkisten, Rohre, Räder, Schrauben, Nieten, Töpfe mit Lacken, Kleistern und Fetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c50ce663-d66c-3989-a319-5ed5816fd403",
                                        "entry_id": "70d82d75-50a9-3552-9e05-cc16deacfcea",
                                        "glosses": [
                                            "Gerät, in das ein Bohrer^([1]) eingesetzt wird (neben handwerklichen Aufgaben auch für das Tunnelbohren und die Zahnbehandlung im Einsatz)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aeb4c1a-19d2-423a-9a53-e5e0de3e79a3",
                                                "sense_id": "c50ce663-d66c-3989-a319-5ed5816fd403",
                                                "text": "Kann ich mal bitte den Bohrer haben?"
                                            },
                                            {
                                                "example_id": "ef252aa4-9fa4-4b41-afe6-085ac5b50684",
                                                "sense_id": "c50ce663-d66c-3989-a319-5ed5816fd403",
                                                "text": "„Sie zeigten ihm den Gebrauch von Bohrer und Säge, Elektrosäge und Keil, Schlagmesser und Hobel, und wie man den Baumstamm in einen Kahn verlud.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8e09ccce-aab4-309c-85ee-0562885300a7",
                                        "entry_id": "70d82d75-50a9-3552-9e05-cc16deacfcea",
                                        "glosses": [
                                            "Person, die beruflich Löcher bohrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4eddc8f-0a7b-4968-b71c-f007f2b4f2be",
                                                "sense_id": "8e09ccce-aab4-309c-85ee-0562885300a7",
                                                "text": "Wir suchen Sie als neuen Bohrer und Fräser an unserer CNC-Maschine."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
