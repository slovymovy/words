                                    {
                                        "sense_id": "d1b080a9-a4a7-3b5b-97f0-1c00e015b93e",
                                        "entry_id": "e48118d6-0b8a-39d6-a225-337753fc09eb",
                                        "glosses": [
                                            "Que profesa el altruismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa515b0b-edad-4f41-9b36-7c36c731c4e2",
                                                "sense_id": "d1b080a9-a4a7-3b5b-97f0-1c00e015b93e",
                                                "text": "«En las grandes capitales, como se vive al día y como las angustias de uno son las angustias de todos, hay cierta humanitaria comunicación, cierto desprendimiento altruista, que en el fondo es un avance para obligar a reciprocidad futura»."
                                            },
                                            {
                                                "example_id": "f1008e45-7823-46c2-824d-f5fd05329031",
                                                "sense_id": "d1b080a9-a4a7-3b5b-97f0-1c00e015b93e",
                                                "text": "«—Un sincero altruista como tú sabes; el bien de nuestros semejantes es nuestro bien»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbe848f5-08cd-484e-b5ce-78942e215d00",
                        "source_entry_id": "a5da87ef-dfbb-3216-a2c8-b386fc302191",
                        "source_sense_id": "af35c7b3-e71b-3d67-830f-6594eebd413c",
                        "target_lang_word": "Altruist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altruist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7e8fc57-6dbd-32a9-ae97-cd22f219efac",
                                        "entry_id": "bf1b7380-12ed-36a1-b223-c4ae5b39e816",
                                        "glosses": [
                                            "selbstloser Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bdb9f3f-5f0d-4ad1-a128-695c7a38d897",
                                                "sense_id": "f7e8fc57-6dbd-32a9-ae97-cd22f219efac",
                                                "text": "Wovon der Altruist sich all die Jahre ernährt, bleibt unklar. Die Fluchthilfe ist für ihn, so betont er, kein Geschäft, sondern humanitäre Berufung und Strafaktion in einem."
                                            },
                                            {
                                                "example_id": "8ef2cbe2-682d-4e0f-ac6f-4a144d870a23",
                                                "sense_id": "f7e8fc57-6dbd-32a9-ae97-cd22f219efac",
                                                "text": "Längst schon ist der Herrscher über das Microsoft-Imperium in die globale Altruisten-Liga aufgestiegen, auf Du und Du mit Bill Clinton, Buffet und Bono."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d059e81a-326c-4048-93cb-3baf067ed794",
                        "source_entry_id": "a5da87ef-dfbb-3216-a2c8-b386fc302191",
                        "source_sense_id": "af35c7b3-e71b-3d67-830f-6594eebd413c",
                        "target_lang_word": "альтруист",
