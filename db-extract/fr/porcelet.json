                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b393c11-e62e-33b5-b006-770589bbb61f",
                        "entry_id": "945467d8-5931-3336-9a47-8b266c79781e",
                        "glosses": [
                            "Petit porc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55c96c15-81cd-4066-9748-844a07cee269",
                                "sense_id": "7b393c11-e62e-33b5-b006-770589bbb61f",
                                "text": "Aujourd’hui, lorsqu’il achète un porcelet, l’agriculteur du Châtillonnais n’a guère le choix de la race."
                            }
                        ]
                    },
                    {
                        "sense_id": "940f6c2f-c0fa-3415-aa77-de79494b9cd8",
                        "entry_id": "945467d8-5931-3336-9a47-8b266c79781e",
                        "glosses": [
                            "Jeune porc pas encore sevré, cochon de lait."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "b8f25e52-3c5d-420b-8a0c-2a69ae4dadb6",
                                "sense_id": "940f6c2f-c0fa-3415-aa77-de79494b9cd8",
                                "text": "Chez les jeunes porcelets, les septicémies peuvent conduire à la mort en moins de 15 heures et les animaux présentent de la fièvre, des difficultés respiratoires, des troubles nerveux, une cyanose et des pétéchies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df7640c4-6f4b-4c80-b6ef-8d80b2ce2336",
                        "source_entry_id": "945467d8-5931-3336-9a47-8b266c79781e",
                        "source_sense_description": "Jeune porc non sevré",
                        "target_lang_word": "Schweinchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweinchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3337387a-707d-34c0-9f58-0f4342392a2a",
                                        "entry_id": "9b701eae-4f9b-3ad4-8b20-3ffa9ae79d19",
                                        "glosses": [
                                            "ein kleines Schwein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b81971c8-f5a2-455c-bdad-635321451995",
                                                "sense_id": "3337387a-707d-34c0-9f58-0f4342392a2a",
                                                "text": "Die Schweinchen in Opas Stall sind so niedlich!"
                                            },
                                            {
                                                "example_id": "77ea9c69-d459-409e-9ea0-0f2d025f5619",
                                                "sense_id": "3337387a-707d-34c0-9f58-0f4342392a2a",
                                                "text": "Die Torte wurde von einem Schweinchen aus Marzipan geziert."
                                            },
                                            {
                                                "example_id": "5a94194b-c26d-41ed-9bcb-91bcfa79dc1d",
                                                "sense_id": "3337387a-707d-34c0-9f58-0f4342392a2a",
                                                "text": "Hast du dich wieder vollgekleckert, du Schweinchen?"
                                            },
                                            {
                                                "example_id": "7972ff23-75d7-486b-90df-845617ec8984",
                                                "sense_id": "3337387a-707d-34c0-9f58-0f4342392a2a",
                                                "text": "„Pencroff selbst tranchierte die Schweinchen und legte jedem seiner Kameraden eine Riesenportion auf den Teller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc62bbce-c785-4186-aebd-72742e892082",
                        "source_entry_id": "945467d8-5931-3336-9a47-8b266c79781e",
                        "source_sense_description": "Jeune porc non sevré",
                        "target_lang_word": "Ferkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ferkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                        "entry_id": "bf7d7359-0852-33ea-ae5b-333660b597be",
                                        "glosses": [
                                            "Junges des Hausschweins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32969e6b-ff10-439c-a45f-360677283ee4",
                                                "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                                "text": "Drei Ferkel des letzten Wurfs waren männlich."
                                            },
                                            {
                                                "example_id": "8db95c6e-dd8a-414d-930d-4bf2604e39f8",
                                                "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                                "text": "„Zwischen Kakteen und Blattpflanzen ohne Blüten, wie man sie in den Schaufenstern von Schlächtern findet, um ein totes Ferkel mit einer Zitrone im Maul zu garnieren, saßen etwa fünfzehn Personen auf unbequemen Stühlen herum.“"
                                            },
                                            {
                                                "example_id": "a6a9bfc9-f91d-46d9-bead-7e8cdbb17ec6",
                                                "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                                "text": "„Die holde Marion stand, mit einem kleinen Korb am Arm, unter einer flatternden und gackelnden Schar von Hühnern, Enten und Gänsen und streute weit hinaus in den reinlichen Hof die goldenen Maiskörner; draußen an der niedern Fenz aber stürmte ein ganzes Rudel grunzender und tobender Ferkel auf und ab und suchte vergebens in wilder Hast einen Eingang, um an dem freigebigen Mahle teilzunehmen.“"
                                            },
                                            {
                                                "example_id": "4f4bf9a4-ec76-4c84-842e-4303e1185651",
                                                "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                                "text": "„Er lag auf einer Pritsche auf einer kleinen Erhöhung des Fußbodens, und die Tiere lagen dicht neben ihm auf der anderen Seite des Lattenzauns, ein Eber, für sich in einem Koben, im zweiten eine Sau mit zwölf Ferkeln, und einige größere junge Schweine im dritten Koben.“"
                                            },
                                            {
                                                "example_id": "3be6faec-3b82-406c-bd1a-7a8a6ae6c485",
                                                "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                                "text": "„Bastian beobachtete das Ferkel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11e59050-d5e0-3640-8cc4-a7227883101f",
                                        "entry_id": "bf7d7359-0852-33ea-ae5b-333660b597be",
                                        "glosses": [
                                            "Schimpfwort für eine Person (oft Kind), die sich oder ihre Umwelt physisch oder verbal beschmutzt hat"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04fff16e-3afe-4d8c-b35e-7d0453186b82",
                                                "sense_id": "11e59050-d5e0-3640-8cc4-a7227883101f",
                                                "text": "Ihr Ferkel, ihr habt den ganzen Tisch vollgekleckert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
