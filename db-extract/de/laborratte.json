                "senses": [
                    {
                        "sense_id": "82282e22-bf4a-3b27-8522-adbe10686b8c",
                        "entry_id": "8ab344b6-349f-3b95-9dc8-0076a73d8243",
                        "glosses": [
                            "zu Forschungszwecken gezüchtete und gehaltene Ratte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d8e7281-6d6f-49fd-b75a-8f93351a312f",
                                "sense_id": "82282e22-bf4a-3b27-8522-adbe10686b8c",
                                "text": "„Chitrali-Haschisch sollte man nicht mal in einem Raum mit Laborratten aufbewahren.“"
                            },
                            {
                                "example_id": "dbb03171-a541-475b-aa66-4cbbc7799275",
                                "sense_id": "82282e22-bf4a-3b27-8522-adbe10686b8c",
                                "text": "„Unter seinem intensiven Blick fühlte Penny sich weniger wie eine Frau, sondern mehr wie ein wissenschaftliches Experiment. Wie ein Versuchskaninchen. Oder eine Laborratte.“"
                            },
                            {
                                "example_id": "d7729569-ecde-4a89-a178-ded6b86cab0f",
                                "sense_id": "82282e22-bf4a-3b27-8522-adbe10686b8c",
                                "text": "„Dahlia hat zwar an der Uni keine volle Stelle (was sie innerhalb der Universität zur Bürgerin zweiter Klasse macht), aber am Massachusetts Institute of Technology in Biochemie promoviert und arbeitet, unterstützt von verschiedenen Firmen, in einem finsteren Winkel der Naturwissenschaftlichen Fakultät, wo sie abwegige Heilmittel für unbekannte Krankheiten testet und voller Leidenschaft Hunderte von Laborratten ums Leben bringt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
