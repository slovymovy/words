                                "target_senses": [
                                    {
                                        "sense_id": "b414c3cf-510e-3aa2-a906-ce4822f0bd85",
                                        "entry_id": "afd184dc-ac42-3977-bdf0-43a7060da34c",
                                        "glosses": [
                                            "A long, thin, flexible length of twisted yarns (strands) of fibre (a rope, for example)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2455d7-a2f9-4624-b9db-08d75564cc3f",
                                                "sense_id": "b414c3cf-510e-3aa2-a906-ce4822f0bd85",
                                                "text": "The burglar tied up the victim with a cord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7f81df7-72e6-38b0-80d9-e8bfc1dcaeac",
                                        "entry_id": "afd184dc-ac42-3977-bdf0-43a7060da34c",
                                        "glosses": [
                                            "Any quantity of such material when viewed as a mass or commodity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6535e68c-dfea-4f2f-b990-f0eb5cd6a9ec",
                                                "sense_id": "f7f81df7-72e6-38b0-80d9-e8bfc1dcaeac",
                                                "text": "He looped some cord around his fingers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d60f61c-ad32-35b5-978f-0948de03830c",
                                        "entry_id": "afd184dc-ac42-3977-bdf0-43a7060da34c",
                                        "glosses": [
                                            "A small flexible electrical conductor composed of wires insulated separately or in bundles and assembled together usually with an outer cover; the electrical cord of a lamp, sweeper ((US) vacuum cleaner), or other appliance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83c9fe44-051a-3347-a064-ae4c188b89eb",
                                        "entry_id": "afd184dc-ac42-3977-bdf0-43a7060da34c",
                                        "glosses": [
                                            "A unit of measurement for firewood, equal to 128 cubic feet (4 × 4 × 8 feet), composed of logs and/or split logs four feet long and none over eight inches diameter. It is usually seen as a stack four feet high by eight feet long."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42368f36-5548-490a-abd1-dcb2c34a0cac",
                                                "sense_id": "83c9fe44-051a-3347-a064-ae4c188b89eb",
                                                "text": "Unerringly impelling this dead, impregnable, uninjurable wall, and this most buoyant thing within; there swims behind it all a mass of tremendous life, only to be adequately estimated as piled wood is—by the cord; and all obedient to one volition, as the smallest insect."
                                            },
                                            {
                                                "example_id": "589f7aab-0069-4215-a3e6-29741c3ae829",
                                                "sense_id": "83c9fe44-051a-3347-a064-ae4c188b89eb",
                                                "text": "'If they buy three cords of birch logs,' said the witch, 'but they must be exact measure—and no bargaining about the price, and if they throw overboard the one cord of logs, piece by piece, when the first sea comes, and the other cord, piece by piece, when the second sea comes, and the third cord, piece by piece, when the third sea comes, then it's all over with us.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20556bc7-3671-32b6-aba8-8a4fc53f5aaa",
                                        "entry_id": "afd184dc-ac42-3977-bdf0-43a7060da34c",
                                        "glosses": [
                                            "Any influence by which persons are caught, held, or drawn, as if by a cord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a66b9c98-8ea9-43ac-bf8c-420756d15742",
                                                "sense_id": "20556bc7-3671-32b6-aba8-8a4fc53f5aaa",
                                                "text": "Clear-headed friend, whose joyful scorn, / Edged with sharp laughter, cuts atwain / The knots that tangle human creeds, / The wounding cords that bind and strain / The heart until it bleeds, […]"
                                            },
                                            {
                                                "example_id": "0968a5b9-8b87-472a-9c3c-4e7c7e1856a7",
                                                "sense_id": "20556bc7-3671-32b6-aba8-8a4fc53f5aaa",
                                                "text": "Every detail of the house and garden was familiar; a thousand cords of memory and affection drew him thither; but a stronger counter-motive prevailed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e66051-513d-3a32-8b93-7b54ef6086b9",
                                        "entry_id": "afd184dc-ac42-3977-bdf0-43a7060da34c",
                                        "glosses": [
                                            "Any structure having the appearance of a cord, especially a tendon or nerve."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f16e06e-6bc3-4f3b-b5b4-d6c7dfee5203",
                                                "sense_id": "62e66051-513d-3a32-8b93-7b54ef6086b9",
                                                "text": "spermatic cord; spinal cord; umbilical cord; vocal cords"
                                            },
                                            {
                                                "example_id": "58b411ef-3d3e-47ba-b84b-8c2ce4cfceb8",
                                                "sense_id": "62e66051-513d-3a32-8b93-7b54ef6086b9",
                                                "text": "Since spinal cord injury is associated with edema and changes in AQP4 expression, Ge and coworkers investigated the potential antiedema effect of epigallocatechin gallate and its underlying mechanism on a rat model of acute spinal cord injury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d86edb5e-8b31-3416-b3fe-f9067ecc885a",
                                        "entry_id": "afd184dc-ac42-3977-bdf0-43a7060da34c",
