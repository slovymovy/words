                "senses": [
                    {
                        "sense_id": "12bb2e99-4536-3e2d-946f-34628e41d057",
                        "entry_id": "33ae366a-ec51-3280-a0a1-8982a0a3a765",
                        "glosses": [
                            "pokryty żwirem, zawierający żwir, podobny do żwiru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "835c2e7c-5a33-4bd4-959b-6cbcd0afee63",
                                "sense_id": "12bb2e99-4536-3e2d-946f-34628e41d057",
                                "text": "Woda bulgotała w skalnych rozpadlinach, pieniąc się i szumiąc, odsłaniając wymyte falami żwirowate wąwozy"
                            },
                            {
                                "example_id": "10c2dac7-bf5a-4a13-94e9-fe66c71dcd74",
                                "sense_id": "12bb2e99-4536-3e2d-946f-34628e41d057",
                                "text": "Ryby te wymagają dużego (minimum 150-litrowego) akwarium ze żwirowatym podłożem i temperatury wody 24-27 stopni Celsjusza"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
