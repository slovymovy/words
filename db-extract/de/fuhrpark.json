                        ],
                        "form": "die Fuhrpärke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5aa97d84-1430-34e0-968e-853ca5cc5279",
                        "entry_id": "9760dcbd-04bf-30f4-9f21-80c7869f6b4a",
                        "glosses": [
                            "alle Fahrzeuge (beispielsweise Autos, LKWs, Busse) einer Organisation (beispielsweise eines Unternehmens, einer Spedition, des Militärs)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59593f70-14ff-4584-93a4-55bc4a13f7e2",
                                "sense_id": "5aa97d84-1430-34e0-968e-853ca5cc5279",
                                "text": "„[…] Die Post hat einen riesigen Fuhrpark […].“"
                            },
                            {
                                "example_id": "02975bcc-34ec-4512-8e6b-0d9c37bc7a83",
                                "sense_id": "5aa97d84-1430-34e0-968e-853ca5cc5279",
                                "text": "„Für mittelständische Unternehmen bedeutet ein eigener Fuhrpark oft einen hohen finanziellen und organisatorischen Aufwand.“"
                            },
                            {
                                "example_id": "c58775cf-53b5-4559-8d86-4da519bc748d",
                                "sense_id": "5aa97d84-1430-34e0-968e-853ca5cc5279",
                                "text": "„[…] der gesamte Fuhrpark der Stadt [soll] bis 2030 auf Elektromobilität umgestellt werden […].“"
                            },
                            {
                                "example_id": "19809345-de43-43a3-b298-8b235da487d8",
                                "sense_id": "5aa97d84-1430-34e0-968e-853ca5cc5279",
                                "text": "„Zwar stellt die Stadtverwaltung [von Bottrop] ihren Fuhrpark zunehmend auf Dienstfahrräder und Elektroautos um, aber das geht doch sehr langsam und hat insgesamt wenig Auswirkungen auf den Klimahaushalt der Stadt.“"
                            },
                            {
                                "example_id": "5d8249bf-34f9-4da8-a624-c80e0e454e60",
                                "sense_id": "5aa97d84-1430-34e0-968e-853ca5cc5279",
                                "text": "„Zehn Prozent der neu angeschafften oder neu angemieteten Dienstfahrzeuge in den Fuhrparks der Bundesministerien sollen künftig weniger als 50 Gramm CO2 pro Kilometer ausstoßen.“"
                            },
                            {
                                "example_id": "36cbe92f-5967-4815-97cd-f046ae8d1702",
                                "sense_id": "5aa97d84-1430-34e0-968e-853ca5cc5279",
                                "text": "„[…] bevor er [Kamel Danijimal] dorthin über das Mittelmeer flüchtete, hatte er sich als Mechaniker um den Fuhrpark eines Bauunternehmers im libyschen Tripolis kümmert.“"
                            },
                            {
                                "example_id": "35eeee2c-3997-4e8f-9012-cce65c8d0582",
                                "sense_id": "5aa97d84-1430-34e0-968e-853ca5cc5279",
                                "text": "„Wann genau [die Abbiegeassistenten für Lastwagen] hier Pflicht für den städtischen Fuhrpark werden, ist aber noch unklar.“"
                            },
                            {
                                "example_id": "2faec4ec-adb9-4d40-aace-6319de95f01c",
                                "sense_id": "5aa97d84-1430-34e0-968e-853ca5cc5279",
                                "text": "„Der Fuhrpark der [Bauers-]Familie Hitz umfasst diverse Modelle für die verschiedensten Einsätze. Einen Traktor brauchen die Bauern für den Mistwagen, einen zum Gras mähen und an einem weiteren ist ein Frontlader montiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c56278d6-76b5-4639-b6c8-fb1ea8442dec",
                        "source_entry_id": "9760dcbd-04bf-30f4-9f21-80c7869f6b4a",
                        "source_sense_id": "5aa97d84-1430-34e0-968e-853ca5cc5279",
                        "target_lang_word": "fleet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fleet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57f8bcbc-0d09-3112-9ad3-7f7e06ef2d59",
                                        "entry_id": "395a0c79-deba-3184-a397-975cb7dda452",
                                        "glosses": [
                                            "A group of vessels or vehicles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4fc516a-737b-4198-8ec4-b7f66d344ac7",
                                                "sense_id": "57f8bcbc-0d09-3112-9ad3-7f7e06ef2d59",
                                                "text": "He did discourse to us of the Dutch fleete being abroad, eighty-five of them still, and are now at the Texell, he believes, in expectation of our Eastland ships coming home with masts and hempe, and our loaden Hambrough ships going to Hambrough."
                                            },
                                            {
                                                "example_id": "880b5e99-1e7d-471c-9aa7-cc79e68d1e50",
                                                "sense_id": "57f8bcbc-0d09-3112-9ad3-7f7e06ef2d59",
                                                "text": "It was planning to use an '807' for one day only as part of a shakedown test, ahead of the fleet's formal entry to service which is currently planned for November."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21fbc515-7aa2-3a59-a700-d3ecdf98a58c",
                                        "entry_id": "395a0c79-deba-3184-a397-975cb7dda452",
                                        "glosses": [
                                            "Any group of associated items."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89062eca-ce7d-43c3-b17f-0dbf5d8c7fcd",
                                                "sense_id": "21fbc515-7aa2-3a59-a700-d3ecdf98a58c",
                                                "text": "This is especially true in distributed printing environments, where a fleet of printers is shared by users on a network."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4c43c32-686b-3d71-abaa-2e35a4318126",
                                        "entry_id": "395a0c79-deba-3184-a397-975cb7dda452",
                                        "glosses": [
                                            "A large, coordinated group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05019de1-b8c1-4a81-ad80-9e2a9ced6603",
                                                "sense_id": "d4c43c32-686b-3d71-abaa-2e35a4318126",
                                                "text": "And after the past few days, in which a fleet of Republicans and the president himself have utilized Jews as human shields for racist rhetoric, the Jews are tired, tired, tired of being used as defenses against naked racism, tired of being used to justify conditions at detention camps. Just plain tired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b359ea-6950-36b9-b838-76a96d66f5d0",
                                        "entry_id": "395a0c79-deba-3184-a397-975cb7dda452",
                                        "glosses": [
                                            "A number of vessels in company, especially war vessels; also, the collective naval force of a country, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e1def58-5f2c-4329-ac4b-14b460c18c02",
                                                "sense_id": "e0b359ea-6950-36b9-b838-76a96d66f5d0",
                                                "text": "Despite the line proving to be a useful strategic route for men and supplies to the British naval fleets stationed at Scapa Flow in both world wars, the Duke's legacy looked to have passed into history when it was listed for closure in the infamous Beeching report."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74b6790c-301c-3bdc-aa64-f1ac98592b1b",
                                        "entry_id": "395a0c79-deba-3184-a397-975cb7dda452",
                                        "glosses": [
                                            "Any command of vessels exceeding a squadron in size, or a rear admiral's command, composed of five sail-of-the-line, with any number of smaller vessels."
                                        ],
                                        "tags": [
                                            "British-Royal-Navy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46123205-6df0-36be-86b6-a9d8d18befbb",
                                        "entry_id": "395a0c79-deba-3184-a397-975cb7dda452",
                                        "glosses": [
                                            "The individual waves in corrugated fiberboard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fleet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1faf19b3-0358-3ddb-9101-37ece696ec14",
                                        "entry_id": "acc36552-eb19-3891-aa2c-3600c9b26bc1",
                                        "glosses": [
                                            "An arm of the sea; a run of water, such as an inlet or a creek."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dd571ca-a2c0-4515-aee0-8e63ad384c05",
                                                "sense_id": "1faf19b3-0358-3ddb-9101-37ece696ec14",
                                                "text": "a certain Flete [...] through which little Boats used to come to the aforesaid Town"
                                            },
                                            {
                                                "example_id": "df050197-6198-46d3-98cb-16314bb90670",
                                                "sense_id": "1faf19b3-0358-3ddb-9101-37ece696ec14",
                                                "text": "Together wove we nets to entrap the fish\nIn floods and sedgy fleets."
                                            }
                                        ]
