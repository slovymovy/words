                                ]
                            },
                            {
                                "target_word": "spur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ef6c62-b59e-37d1-b540-ec159c74bd87",
                                        "entry_id": "bff66306-6c12-39a3-a5b2-a7718df71a3c",
                                        "glosses": [
                                            "Alternative form of speer."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c6d11e-7d38-4e4f-b06c-9afeb759dae2",
                                                "sense_id": "a8ef6c62-b59e-37d1-b540-ec159c74bd87",
                                                "text": "I haue yonder vncouered a faire girle, Ile be ſo bolde as ſpur her, vvhat might a bodie call her name?"
                                            },
                                            {
                                                "example_id": "4a0c20a3-f492-4253-bac9-e1929e294082",
                                                "sense_id": "a8ef6c62-b59e-37d1-b540-ec159c74bd87",
                                                "text": "Are you come, old Maſter? Very good, your Horſe is well ſet up; but ere you part, I'll ride you, and ſpur your Reverend Juſticeſhip ſuch a queſtion, as I ſhall make the ſides of your Reputation bleed, truly I will. Now muſt I play at Bo-peep."
                                            },
                                            {
                                                "example_id": "339402ed-0e37-4adf-891b-26c1da014f42",
                                                "sense_id": "a8ef6c62-b59e-37d1-b540-ec159c74bd87",
                                                "text": "1638, Thomas Heywood, \"The Rape of Lucrece. A true Roman Tragedy\", in The Dramatic Works of Thomas Heywood, Vol. V, John Pearson, 1874, pages 230 & 231.\nClo[wne]. Fie upon't, never was poore Pompey ſo overlabour'd as I have beene, I thinke I have ſpurd my horſe ſuch a queſtion, that he is ſcarce able to wig or wag his tayle for an anſwere, but my Lady bad me ſpare for no horſe fleſh, and I thinke I have made him runne his race."
                                            },
                                            {
                                                "example_id": "1177ef19-ba57-4f86-8491-60b9608785bd",
                                                "sense_id": "a8ef6c62-b59e-37d1-b540-ec159c74bd87",
                                                "text": "The Pall Mall Magazine, Vol. 33, 1904, page 435.\nThey hadde spurred questions all the morning, his Majestie being so grossly overtaken with two whole nights' feasting, (which meant a surfeit of sausage laid upon a stomach not over strong), that between sick and sullen he bore a dull edge to the business."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
