                        "examples": [
                            {
                                "example_id": "8faaafae-feb8-419f-92d2-bd822697739f",
                                "sense_id": "366eda32-5774-3407-99a7-c20b108205f9",
                                "text": "With Deebo Samuel as their top receiver, they need to give quarterback Jimmy Garoppolo another top target. So they chose Brandon Aiyuk, the speedster from Arizona State."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ec54245-30b4-3276-8f21-fb130eb1adf3",
