                "entry_id": "4a4a0463-e6a3-33f1-811b-5e0b753b311b",
                "word": "bickering",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "144f05e5-99fc-416e-8fa6-59161ae2c161",
