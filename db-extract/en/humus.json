                    {
                        "translation_id": "3421b21c-ca6f-49b6-b7a1-133fd68a1921",
                        "source_entry_id": "e708859b-6ccd-34ce-9f7d-1487f4979f22",
                        "source_sense_id": "1a8ab43b-87d0-3b20-8b74-2e56dd2e6a1b",
                        "source_sense_description": "group of compounds in soil",
                        "target_lang_word": "humus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7d1a2818-840d-325c-b82c-486692e24cb1",
                                        "entry_id": "2eebcd33-a82f-3c70-84c5-714cf355f207",
                                        "glosses": [
                                            "Humus is het traag afbreekbare deel van de organische stof in de bodem; organische stof is al het dode organische materiaal dat in de bodem aanwezig is."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f96263f6-a33a-481c-a0a4-1f627896e3cd",
                                                "sense_id": "7d1a2818-840d-325c-b82c-486692e24cb1",
                                                "text": "Humus is meestal het zwarte van de aarde dat bestaat uit vergane plantenresten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70fc8f80-338d-4828-b0ce-1732a5b0eda1",
                        "source_entry_id": "e708859b-6ccd-34ce-9f7d-1487f4979f22",
                        "source_sense_id": "1a8ab43b-87d0-3b20-8b74-2e56dd2e6a1b",
                        "source_sense_description": "group of compounds in soil",
                        "target_lang_word": "humus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f56c0f63-a337-300e-b969-9ef698226f12",
                                        "entry_id": "d6077922-8434-39e0-9e19-2ce4b1a01847",
                                        "glosses": [
                                            "Terre végétale."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aaccbb9-bf7f-4910-8ff8-1078ddc70742",
                                                "sense_id": "f56c0f63-a337-300e-b969-9ef698226f12",
                                                "text": "Les jours filent clairs parmi le friselis des feuilles, le froufroutement des brises, les odeurs âpres des humus, le parfum des sèves, entouré d’oiseaux et d’abeilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1d205a0-155b-3360-9ac4-186593b7c49a",
                                        "entry_id": "d6077922-8434-39e0-9e19-2ce4b1a01847",
                                        "glosses": [
                                            "Couche supérieure du sol issue de la décomposition totale de la partie brute de la fraction organique du sol principalement par l’action combinée des animaux, des bactéries et des champignons du sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138f5a65-4008-4a4f-a5f4-99278712a587",
                                                "sense_id": "e1d205a0-155b-3360-9ac4-186593b7c49a",
                                                "text": "Au fond du val, des champs de blé, des carrés de betteraves, des pâturages d’herbe drue avaient poussé avec cette opulence lourde des végétations nourries par l’humus noir des terrains d’alluvion."
                                            },
                                            {
                                                "example_id": "96103fab-a85c-4885-9223-48cff427ecb2",
                                                "sense_id": "e1d205a0-155b-3360-9ac4-186593b7c49a",
                                                "text": "À la rigueur on peut voir des liens entre une plante herbacée et un arbre de la forêt. Il est possible que l’humus produit par les feuilles de Conifères conviennent à ces plantes, mais l’inverse est insoutenable."
                                            },
                                            {
                                                "example_id": "1759ef41-6288-44dc-b6c0-7166d774fce3",
                                                "sense_id": "e1d205a0-155b-3360-9ac4-186593b7c49a",
                                                "text": "En 1840 enfin, von Liebig publie La chimie dans ses rapports avec l’agronomie, livre dans lequel il montre que les plantes ne se nourrissent pas d’humus, mais de solutions minérales et que l’humus est un produit transitoire entre les matières organiques végétales et les sels minéraux, seuls aliments des plantes."
                                            },
                                            {
                                                "example_id": "ec3f316e-0e3c-4450-b56d-59ed190a2124",
                                                "sense_id": "e1d205a0-155b-3360-9ac4-186593b7c49a",
                                                "text": "La podzolisation est essentiellement un processus d’altération chimique intense des éléments silicatés, se produisant sous l’action de cet humus brut et libérant des sesquioxydes."
                                            },
                                            {
                                                "example_id": "825de720-0931-4b95-b3d4-082518cbac90",
                                                "sense_id": "e1d205a0-155b-3360-9ac4-186593b7c49a",
                                                "text": "Ces gens qui pendant des siècles ont remué la terre et collaboré avec les saisons ont disparu aussi complètement que le bétail qu’ils menaient paître et que les feuilles mortes dont ils faisaient de l’humus."
                                            },
                                            {
                                                "example_id": "22e2af2f-8635-40bd-bdfd-10464bea641b",
                                                "sense_id": "e1d205a0-155b-3360-9ac4-186593b7c49a",
                                                "text": "Dans cette terre riche en humus et en azote et qui n'avait pas vu le soleil depuis six ans, c'était bien le diable si l'orge ne faisait pas merveille."
                                            },
                                            {
                                                "example_id": "3a6647eb-34ee-4305-9486-9947edb92a3a",
                                                "sense_id": "e1d205a0-155b-3360-9ac4-186593b7c49a",
                                                "text": "L’humus qui, lié aux argiles, contribue à la qualité de la structure des sols et à leur fertilité, résulte de la transformation de la matière organique. C’est un produit composite, chimiquement mal défini, et les détails de sa formation sont encore imparfaitement connus."
                                            },
                                            {
                                                "example_id": "5f314734-36de-44c6-897e-e8221d414e15",
                                                "sense_id": "e1d205a0-155b-3360-9ac4-186593b7c49a",
                                                "text": "Le parcours n’avait guère d’intérêt, hormis pour ceux qui s’intéresseraient au processus de transformation des feuilles mortes en humus – ce qui avait été mon cas par le passé, il y a maintenant plus de vingt ans, j’avais même effectué différents calculs sur la quantité d’humus produite en fonction de la densité de la couverture forestière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "018d4ad3-c22b-4d85-b562-ce2988b8481f",
                        "source_entry_id": "e708859b-6ccd-34ce-9f7d-1487f4979f22",
                        "source_sense_id": "1a8ab43b-87d0-3b20-8b74-2e56dd2e6a1b",
                        "source_sense_description": "group of compounds in soil",
                        "target_lang_word": "Humus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Humus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2549bbf-797a-3b81-b95a-5dfc89c6b9e4",
                                        "entry_id": "42ab7143-fcaa-39ca-ac3f-27c825fac4fc",
                                        "glosses": [
                                            "Bodenart mit hohem Anteil an organischer Substanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b61a69d-1424-4816-bc36-5606b3da3bad",
                                                "sense_id": "b2549bbf-797a-3b81-b95a-5dfc89c6b9e4",
                                                "text": "Wir müssen hier noch etwas Humus aufbringen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                        "entry_id": "42ab7143-fcaa-39ca-ac3f-27c825fac4fc",
                                        "glosses": [
                                            "in der Bodenkunde ebendiese organische Substanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47c4a30-d7cc-4e10-a345-054b964be5b6",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "Dieser Boden enthält viel Humus."
                                            },
                                            {
                                                "example_id": "bdb56cc7-7bd1-481b-944c-24fd1196431a",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "„Bakterien, Algen und Pilze zersetzen totes organisches Material, „reinigen“ den Boden und verwandeln das Laub und abgestorbene Pflanzenreste in wertvollen Humus.“"
                                            },
                                            {
                                                "example_id": "d6e80df7-79fe-42f0-b357-9c7501c2679d",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "„Der eigene Komposthaufen liefert dank der unzähligen kleine Bodenorganismen und Regenwürmer wertvollen Humus und kann Abfallgebühren sparen.“"
                                            },
                                            {
                                                "example_id": "8693f9ef-29bf-4ed9-a763-086f754222ad",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "„Humus speichert weltweit vier Mal mehr Kohlenstoff als in Form von CO2 in der Atmosphäre vorhanden ist.“"
                                            },
                                            {
                                                "example_id": "6ca442a9-04cb-412f-9272-6f26a78f28ef",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "„Humus ist wertvoll für das Pflanzenwachstum und durch den hohen Anteil an Kohlenstoff wichtig für den Klimaschutz.“"
                                            },
                                            {
                                                "example_id": "1f2712bb-ee6a-4fbf-8daa-3f39aad62367",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "„Doch durch die landwirtschaftliche Praxis mit viel Monokulturen geht seit Jahren immer mehr Humus in den Böden verloren - und so entweicht zusätzlich CO2.“"
                                            },
                                            {
                                                "example_id": "257d276a-5bfd-4130-b132-bbae28b94ea0",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "[…] „industrielle Anbaumethoden laugen die Böden aus und [verhindern] die Neubildung von Humus.“"
                                            },
                                            {
                                                "example_id": "2f9e62ff-5045-49cd-b6b9-deda6947efd8",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "[Landwirte können] „den Humus mit Fruchtfolgen und Einarbeitung von Pflanzenresten erhalten und die natürliche Bodenfruchtbarkeit steigern.“"
                                            },
                                            {
                                                "example_id": "be4ed7f5-12e4-4591-9510-04ce248486da",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "[Früher vor dem Beginn der Agrararindustrie waren Bauern] „zur Sicherung der Ernten auf Erhalt von Humus angewiesen.“"
                                            },
                                            {
                                                "example_id": "d13bcf0b-6620-4cc4-80e0-982d75c3fb74",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "„Ein anderer Faktor für den weltweiten Verlust von Humus ist die globale Zunahme an Ackerflächen.“"
                                            },
                                            {
                                                "example_id": "86a86bba-c547-4152-842e-a6984ffa452b",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "„Der Verlust von Humus und fruchtbaren Böden ist laut den Vereinten Nationen auch eine große Gefahr für die Welternährung.“"
                                            },
                                            {
                                                "example_id": "19e991e1-1a60-4726-a8cc-dbdfa0f9a564",
                                                "sense_id": "30ea6991-7745-3aee-8d8d-c5fe87cc5cb9",
                                                "text": "„Auch dieser Witz also braucht einen historischen Kontext, eine atmosphärische Umgebung, aus der er nicht beliebig gerissen werden kann, weil er mit den Wurzeln seinen Humus verliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
