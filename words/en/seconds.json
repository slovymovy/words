                {
                    "sense_id": "83540852-9d6d-3c15-a03b-e4b455153441",
                    "sense_definition": "A second serving of food taken after eating the first portion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pasta was so delicious that everyone asked for <w>seconds</w>.",
                            "target_lang_translations": {
                                "ru": "Паста была такой вкусной, что все попросили <w>добавки</w>.",
                                "zh": "意大利面太好吃了，大家都要求再来<w>一份</w>。"
                            }
                        },
                        {
                            "text": "There is plenty of pie left, if you have room for <w>seconds</w>.",
                            "target_lang_translations": {
                                "ru": "Осталось много пирога, если у тебя есть место для <w>добавки</w>.",
                                "zh": "如果你的肚子还能吃下<w>第二份</w>，这里还剩很多馅饼。"
                            }
