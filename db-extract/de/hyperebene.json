                                "example_id": "6ce5c9df-3f82-4d67-a0d4-56bcccf9a8e1",
                                "sense_id": "3fc62f9a-b672-3d8a-a289-1a7b95585317",
                                "text": "„Eine Hyperebene H von V ist ein abgeschlossener affiner Unterraum von Kodimension 1, …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
