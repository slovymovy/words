                ],
                "senses": [
                    {
                        "sense_id": "de6cd612-b2d3-35ee-8608-e381b82a170c",
                        "entry_id": "8cb2fc5b-3207-3614-bf07-92f8525316d1",
                        "glosses": [
                            "Wirtschaftszweig, der sich mit der Herstellung und dem Vertrieb alkoholischer Getränke beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f506c50f-7634-41ab-a9c7-8cd24a19c3ae",
                                "sense_id": "de6cd612-b2d3-35ee-8608-e381b82a170c",
                                "text": "„Bei aller regionalen Differenz der Regelungen läßt sich für den hier interessierenden räumlichen Bereich doch bei der Bierwirtschaft am stärksten von allen Zweigen der Alkoholwirtschaft der Charakter des bürgerlichen Gewerbes bemerken.“"
                            },
                            {
                                "example_id": "2902bd97-8b02-45c0-ab2e-cfc15c257c4d",
                                "sense_id": "de6cd612-b2d3-35ee-8608-e381b82a170c",
                                "text": "„Dass die Konsumgüterindustrie (vor allem die Automobilbranche und die Alkoholwirtschaft) schweren Zeiten entgegensehen müsste, klingt in allen Beiträgen zur produktspezifischen Werbung an.“"
                            },
                            {
                                "example_id": "2d8d421b-7155-49eb-a453-e16ef0fca76f",
                                "sense_id": "de6cd612-b2d3-35ee-8608-e381b82a170c",
                                "text": "„Das verbleibende Beitragsaufkommen ist für Absatz- und Verwertungsmaßnahmen im Bereich der Getreidewirtschaft, für Förderungsmaßnahmen zugunsten von Ersatzkulturen des Getreidebaus (sogenannte Alternativenförderung), für die Förderung von Grünbracheflächen und ab 1. Jänner 1992 auch für die Stärke- und Alkoholwirtschaft (Stärkeförderung) zu verwenden.“"
                            },
                            {
                                "example_id": "548d07ea-a27b-4517-9f88-0ef21afee767",
                                "sense_id": "de6cd612-b2d3-35ee-8608-e381b82a170c",
                                "text": "„Das österreichische Brauwesen ist der unproblematischste, rein industriell-gewerbliche Wirtschaftszweig der österreichischen Alkoholwirtschaft, der im 19. Jahrhundert den höchsten Konzentrationsgrad des Brauwesens in Europa erreichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
