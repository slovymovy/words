                "senses": [
                    {
                        "sense_id": "e3b95e66-69af-35a8-af2e-dedb46902eda",
                        "entry_id": "7f9441e4-54ed-3e05-ba54-8b992b091a8e",
                        "glosses": [
                            "op elke dag, per dag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71fbf625-eaa8-4eba-b47a-7a3a6791a1a3",
                                "sense_id": "e3b95e66-69af-35a8-af2e-dedb46902eda",
                                "text": "U moet tweemaal daags een eetlepel innemen."
                            },
                            {
                                "example_id": "0cf19b2a-7566-47b8-9c25-053faff87678",
                                "sense_id": "e3b95e66-69af-35a8-af2e-dedb46902eda",
                                "text": "Tijdens de vakantie was hij even verlost van zijn daagse beslommeringen."
                            },
                            {
                                "example_id": "78ae5d71-eeb8-4cfa-bea4-2a117279e1bd",
                                "sense_id": "e3b95e66-69af-35a8-af2e-dedb46902eda",
                                "text": "Ze kijkt het daagse leven aan tot het zijn alledaagsheid kwijtraakt en laat zien wat je vaak liever niet zou zien."
                            }
                        ]
                    },
                    {
                        "sense_id": "78b5f0f2-b3b9-317b-8a03-6114de40ef02",
                        "entry_id": "7f9441e4-54ed-3e05-ba54-8b992b091a8e",
                        "glosses": [
                            "op de dag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c17dcad-ce15-460e-ba31-6e5986a062d1",
                                "sense_id": "78b5f0f2-b3b9-317b-8a03-6114de40ef02",
                                "text": "Daags voor de verkiezingen werd de partijleider zenuwachtig voor de uitslag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
