            {
                "entry_id": "64fbc992-7a89-3eea-88ff-f1ad51691f8a",
                "word": "Goths",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ceb5615-ddad-4f91-ba0c-52c101d7b531",
                        "entry_id": "64fbc992-7a89-3eea-88ff-f1ad51691f8a",
                        "tags": [
                            "singular"
                        ],
                        "form": "Goth"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd2c329c-3a89-3a1e-a745-7fb3eb1fbd3e",
                        "entry_id": "64fbc992-7a89-3eea-88ff-f1ad51691f8a",
                        "glosses": [
                            "Peuple germanique qui envahit, vers le Vᵉ siècle, l’Empire romain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ed0a5a0-ce78-4c34-aa40-8f5e57d4ea7c",
                                "sense_id": "fd2c329c-3a89-3a1e-a745-7fb3eb1fbd3e",
                                "text": "Tant qu’il n’était pas appelé au loin par la guerre contre les Saxons, les Bretons, ou les Goths de la Septimanie, Chlother employait son temps à se promener d’un domaine à l’autre."
                            },
                            {
                                "example_id": "43d71e24-f30e-40f0-9989-7b061f475f0c",
                                "sense_id": "fd2c329c-3a89-3a1e-a745-7fb3eb1fbd3e",
                                "text": "En 407, les Goths pénétrèrent dans la Narbonnaise première, ravagèrent cette province, passèrent en Espagne, et, en 436, Théodoric, roi des Visigoths, s’empara de Carcassonne."
                            },
                            {
                                "example_id": "58e58728-09c5-4ba7-8664-13486130172f",
                                "sense_id": "fd2c329c-3a89-3a1e-a745-7fb3eb1fbd3e",
                                "text": "Car si les Goths, les Francs et les Burgondes embrassèrent le christianisme, ils le firent d’une manière superficielle et ils se laissèrent facilement gagner aux hérésies, en particulier à l’arianisme."
                            },
                            {
                                "example_id": "42b41018-2cbd-48a4-bf38-694d65243e1a",
                                "sense_id": "fd2c329c-3a89-3a1e-a745-7fb3eb1fbd3e",
                                "text": "Les Goths n’ont rien à voir avec l’architecture qui s’empara de leur nom."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2300bbb1-5ca1-4c6a-bc77-64fcd3de420f",
                        "source_entry_id": "64fbc992-7a89-3eea-88ff-f1ad51691f8a",
                        "source_sense_id": "fd2c329c-3a89-3a1e-a745-7fb3eb1fbd3e",
                        "target_lang_word": "Gote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4176fee8-c66d-3bee-9391-cbd9a33d7715",
                                        "entry_id": "d573c7ae-f04b-3a36-9488-5ae5397a57dc",
                                        "glosses": [
                                            "Angehöriger des germanischen Volks der Goten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1636b89-ff4f-44b2-8d8b-9e9205971fcd",
                                                "sense_id": "4176fee8-c66d-3bee-9391-cbd9a33d7715",
                                                "text": "Theoderich der Große war ein bekannter Gote."
                                            },
                                            {
                                                "example_id": "6cb334e5-585e-4e7e-92ab-dd32c7303cd9",
                                                "sense_id": "4176fee8-c66d-3bee-9391-cbd9a33d7715",
                                                "text": "„Der Gote lernte nun lieber die Weltsprache Latein.“"
                                            },
                                            {
                                                "example_id": "4f313acb-2fbd-4c8f-b196-3ab300812b97",
                                                "sense_id": "4176fee8-c66d-3bee-9391-cbd9a33d7715",
                                                "text": "„Jedoch war laut dem oströmischen Historiker Prokop die Insel Gegenstand von Verhandlungen, die Justinians Feldherr Belisar mit dem Goten Totila führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
