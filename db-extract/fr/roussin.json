                        "entry_id": "42728b01-6b53-3028-8c35-8ef3aebbfe31",
                        "glosses": [
                            "Policier."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d3991097-1f40-4076-b0b6-4b31307cf534",
                                "sense_id": "8121be11-da37-3ccd-8ad0-072afd08cb69",
                                "text": "Elle eût voulu les trouver devant elle, les narguer, leur dire en face : « Vous n’êtes que de sales roussins », mais cette surexcitation tomba dès qu’elle fut sortie."
                            }
                        ]
