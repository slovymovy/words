                            {
                                "example_id": "a683e9dd-91b9-4bf3-aa78-36706b17a947",
                                "sense_id": "c7e9c9da-6ed1-3ae8-a633-2a73e2b5d1a8",
                                "text": "One sign of despair is the peremptory contempt of the condition which is the ground of hope; the going on not only in terrours and amazement of conscience, but also boldly, hopingly, and confidently in wilful habits of sin."
                            },
                            {
                                "example_id": "288de2c9-4acb-45f6-a73b-70e1bb827464",
                                "sense_id": "c7e9c9da-6ed1-3ae8-a633-2a73e2b5d1a8",
                                "text": "[…] we deplore the existence of the system in our country, and look forward hopingly to the day when it shall cease from the land, as a day of jubilee and thanksgiving to all America."
                            }
                        ]
