                            {
                                "target_lang_word": "в районе",
                                "target_lang_sense_clarification": "приблизительно"
                            },
                            {
                                "target_lang_word": "порядка",
                                "target_lang_sense_clarification": "около"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "w granicach",
