                "senses": [
                    {
                        "sense_id": "b0b91670-effa-30c4-8e29-e484f220ec20",
                        "entry_id": "ccd8b7b0-5d58-3684-987d-77dac2fdd734",
                        "glosses": [
                            "bestimmte (unerwünschte, sich negativ auswirkende) Erscheinung, die in Zusammenhang mit etwas anderem auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b459498-f898-4dfe-a9b3-1409f9ebd0be",
                                "sense_id": "b0b91670-effa-30c4-8e29-e484f220ec20",
                                "text": "„Es ist offen, ob die Duodenitis Ursache, Folge oder Begleitphänomen bei einem Ulcus duodeni ist.“"
                            },
                            {
                                "example_id": "f24de23c-7fed-4d22-8eb8-542dce1cfdc7",
                                "sense_id": "b0b91670-effa-30c4-8e29-e484f220ec20",
                                "text": "„Auch der Antisemitismus, ein prägendes Begleitphänomen der mittelalterlichen Kreuzzüge, wurde im Wallfahrtswesen wieder massiv ausgelebt.“"
                            },
                            {
                                "example_id": "0e68e335-ade9-409e-a10a-86b887ca0697",
                                "sense_id": "b0b91670-effa-30c4-8e29-e484f220ec20",
                                "text": "„Die Alveolitis wird heute nicht mehr als die primäre Entzündung bei allen interstitiellen Erkrankungen, sondernals ein Begleitphänomen gesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
