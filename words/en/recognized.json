        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ece04656-653a-30aa-970c-6112a36db9f3",
                    "sense_definition": "Widely acknowledged, accepted, or respected as having a particular status or authority.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>recognized</w> expert in the field of renewable energy.",
                            "target_lang_translations": {
                                "ru": "Он — <w>признанный</w> эксперт в области возобновляемых источников энергии.",
                                "zh": "他是可再生能源领域一位<w>公认的</w>专家。"
                            }
                        },
                        {
                            "text": "The diploma is a <w>recognized</w> qualification in most European countries.",
                            "target_lang_translations": {
                                "ru": "Этот диплом является <w>признанной</w> квалификацией в большинстве европейских стран.",
                                "zh": "该文凭在大多数欧洲国家都是一种<w>认可的</w>资格。"
                            }
                        }
                    ],
                    "synonyms": [
                        "acknowledged",
                        "accepted",
                        "established",
                        "distinguished"
                    ],
                    "antonyms": [
                        "unrecognized",
                        "unknown"
                    ],
                    "common_phrases": [
                        "recognized authority",
                        "widely recognized",
                        "recognized standard",
                        "officially recognized"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко известный, принятый или уважаемый, обладающий определенным статусом или авторитетом.",
                        "zh": "被广泛认可、接受或尊重，具有特定地位或权威的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признанный",
                                "target_lang_sense_clarification": "пользующийся авторитетом и уважением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公认的",
                                "target_lang_sense_clarification": "被大众或权威机构所承认的"
                            },
                            {
                                "target_lang_word": "认可的",
