                    {
                        "sense_id": "b7e0fd6a-5009-345d-9b11-32f6c4b1d32e",
                        "entry_id": "29bd8fb0-3fd5-3b37-bc4b-267908e4b5ab",
                        "glosses": [
                            "Femme qui prépare, qui vend des plumes, des aigrettes, etc. ou qui réalise des présentations artistiques, des compositions, des décors à base de plumes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ac740b1-e3ed-4438-a2a8-23c32de50d13",
                                "sense_id": "b7e0fd6a-5009-345d-9b11-32f6c4b1d32e",
                                "text": "Si aucun des six corps n’est exclusivement féminin, plusieurs communautés sont exclusivement féminines : telles les couturières et découpeuses, les faiseuses et marchandes de modes, les plumassières et lingères."
                            },
                            {
                                "example_id": "4a59852a-026d-4875-a8f6-368c0c2b2808",
                                "sense_id": "b7e0fd6a-5009-345d-9b11-32f6c4b1d32e",
                                "text": "Ce métier est resté très féminin. Le nombre de plumassières parisiennes est passé de 425 en 1919, à 88 en 1939 et 5 en 1980."
                            },
                            {
                                "example_id": "67ef34bd-e98c-4774-99ba-954c41dbc62d",
                                "sense_id": "b7e0fd6a-5009-345d-9b11-32f6c4b1d32e",
                                "text": "Alors que les défilés Haute Couture débutent ce lundi 21 janvier, la plumassière parisienne Emilie Moutard-Martin, lauréate dans la catégorie Métiers d'Art du Grand Prix de la Création de la Ville de Paris 2012, nous dévoile son parcours et sa passion."
                            }
                        ]
                    }
