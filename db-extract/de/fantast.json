                                "target_senses": [
                                    {
                                        "sense_id": "c0a1f748-12d4-33f6-9430-ef5103a818f6",
                                        "entry_id": "cf53cebd-cd45-3224-9ff3-02e31eb86541",
                                        "glosses": [
                                            "One who dreams."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52baab2a-2010-3ab6-917c-1ecd9124d076",
                                        "entry_id": "cf53cebd-cd45-3224-9ff3-02e31eb86541",
                                        "glosses": [
                                            "Someone whose beliefs are far from realistic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1056ed-c47b-4b51-bb73-85280ee48223",
                                                "sense_id": "52baab2a-2010-3ab6-917c-1ecd9124d076",
                                                "text": "You may say I'm a dreamer/ But I'm not the only one/ I hope someday you'll join us/ And the world will live as one."
                                            },
                                            {
                                                "example_id": "04604152-0ac9-4db0-9913-12dda52c2b16",
                                                "sense_id": "52baab2a-2010-3ab6-917c-1ecd9124d076",
                                                "text": "Eighties witches were not the patchouli-dipped, lovebead-wearing, back-to-the-earth dreamers of the seventies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b53a85e-0d63-3367-b9a8-108ec3c31e22",
                                        "entry_id": "cf53cebd-cd45-3224-9ff3-02e31eb86541",
                                        "glosses": [
                                            "Any anglerfish of the family Oneirodidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "828929e5-a0ab-39c4-b3bc-3b548489e2c4",
                                        "entry_id": "cf53cebd-cd45-3224-9ff3-02e31eb86541",
                                        "glosses": [
                                            "A swallow-winged puffbird (Chelidoptera tenebrosa)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b725bda-1848-4a8c-8fea-5049aae662ca",
                        "source_entry_id": "ae944b87-87e8-38b0-a491-5cfab6f56009",
                        "source_sense_id": "bcea56c7-1d42-3189-a1e8-cef252c0891f",
                        "source_sense_description": "Träumer, Schwärmer, Mensch mit überspannten Ideen",
                        "target_lang_word": "utopiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utopiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fefb38d2-aece-39cd-b6cf-85d46261de5b",
                                        "entry_id": "6397656c-b04d-379d-a418-da5a9039cff0",
                                        "glosses": [
                                            "Qui est relatif à l’utopie et aux utopistes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "409c2b3a-abda-4fd7-a65e-755af17827d8",
                                                "sense_id": "fefb38d2-aece-39cd-b6cf-85d46261de5b",
                                                "text": "Elle a été conduite ainsi à rompre avec les anciennes chapelles officielles, utopistes et politiciennes, qui ont horreur de la grève générale, et à entrer, au contraire, dans le mouvement propre du prolétariat révolutionnaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "utopiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55d35664-99d5-3104-aa16-36d0d6068f60",
                                        "entry_id": "75765da7-c4fc-3220-9a41-38099e9ecf3b",
                                        "glosses": [
                                            "Celui, celle qui a une tendance à l’utopie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6be3d872-c35c-4ff4-89b0-b00a07eb5d2f",
                                                "sense_id": "55d35664-99d5-3104-aa16-36d0d6068f60",
                                                "text": "La plupart des gens en prennent leur parti malgré les imperfections sociales dont ils souffrent, et traitent de rêveurs et d’utopistes ceux qui prévoient les changements et travaillent à en hâter la réalisation."
                                            },
                                            {
                                                "example_id": "72d0b3b1-553e-4d34-b639-1ecc07cffc0b",
                                                "sense_id": "55d35664-99d5-3104-aa16-36d0d6068f60",
                                                "text": "Inventeurs du mouvement perpétuel, explorateurs de bacilles inconnus, hommes-oiseaux ou hommes-poissons, fanatiques d’ido ou d’ortograf fonétik. alchimistes, pacifistes, utopistes, accourez tous! Déjà les demandes pleuvent, […]."
                                            },
                                            {
                                                "example_id": "e3e1a72d-97aa-4ded-9ae7-38a10da0702b",
                                                "sense_id": "55d35664-99d5-3104-aa16-36d0d6068f60",
                                                "text": "Il y a ce fait remarquable : si un utopiste rêvait d'une société dans laquelle chaque femme posséderait une rivière de diamants, eh bien, du moins jusqu'à ce que la physico-chimie ait fait de nouveaux progrès très considérables, il s'agirait vraiment d'un utopiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
