                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76f1b4e8-058f-456b-bc87-9b6038a6864f",
                        "source_entry_id": "3ecb0040-bea0-38fd-aa55-e95380170c69",
                        "source_sense_id": "7872c6d5-b773-3e88-8129-a5adba2476fb",
                        "target_lang_word": "cretonne",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cretonne",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99aafda0-f0d1-3e4f-b039-eedf7713b284",
                                        "entry_id": "7984068f-35e5-35d9-8c37-c8eca1f81a8f",
                                        "glosses": [
                                            "A strong, heavy fabric of cotton, linen or rayon, used to make curtains and upholstery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e1ceb33-02fa-4ec6-bfef-9204578ceebe",
                                                "sense_id": "99aafda0-f0d1-3e4f-b039-eedf7713b284",
                                                "text": "Mrs. Strickland had moved with the times. Gone were the Morris papers and gone the severe cretonnes, gone were the Arundel prints that had adorned the walls of her drawing-room in Ashley Gardens; […]"
                                            },
                                            {
                                                "example_id": "ed14a2e7-d51e-4640-b997-5595d64aa26d",
                                                "sense_id": "99aafda0-f0d1-3e4f-b039-eedf7713b284",
                                                "text": "She noted with tenderness all the makeshifts: the darned chair-arms, the patent rocker covered with sleazy cretonne, the pasted strips of paper mending the birch-bark napkin-rings labeled \"Papa\" and \"Mama.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e12b95d1-5c83-4048-9d00-329b92ab3bf3",
                        "source_entry_id": "3ecb0040-bea0-38fd-aa55-e95380170c69",
                        "source_sense_id": "7872c6d5-b773-3e88-8129-a5adba2476fb",
                        "target_lang_word": "cretonne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cretonne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f65766d0-9359-359a-b3e4-eafa6a96a1b4",
                                        "entry_id": "d45dc5d3-4796-372e-9ce7-0107f18adc35",
                                        "glosses": [
                                            "Sorte de toile très forte, soit en coton, ou à chaîne de chanvre et trame de lin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8506d723-cd57-4567-8ee1-7a2968a934c9",
                                                "sense_id": "f65766d0-9359-359a-b3e4-eafa6a96a1b4",
                                                "text": "Elle était discrète, cette chambre, avec sa peinture blanche et grise, son papier à bouquets bleus, son meuble de noyer, recouvert de cretonne."
                                            },
                                            {
                                                "example_id": "7213833e-427f-4918-b2d3-fe9179d548c0",
                                                "sense_id": "f65766d0-9359-359a-b3e4-eafa6a96a1b4",
                                                "text": "Cette pièce était meublée d’un petit lit de fer, muni de rideaux en calicot blanc, avec embrasses de cretonne rouge […]"
                                            },
                                            {
                                                "example_id": "9bc38ca8-8ac4-42ba-9df8-7c39ef7b216a",
                                                "sense_id": "f65766d0-9359-359a-b3e4-eafa6a96a1b4",
                                                "text": "Les vitres embuées mettaient une doublure de mousseline à la translucidité des rideaux de cretonne blanchissant avec la lumière levante."
                                            },
                                            {
                                                "example_id": "f4c80d68-7f99-49f1-8724-d52904573e6f",
                                                "sense_id": "f65766d0-9359-359a-b3e4-eafa6a96a1b4",
                                                "text": "Il gravissait le perron arrondi, ses pas résonnaient sur les dalles, il reniflait l’odeur que l’humidité de l’hiver dégage des anciennes cretonnes."
                                            },
                                            {
                                                "example_id": "d1547fd5-852e-439b-9e86-b9456a176626",
                                                "sense_id": "f65766d0-9359-359a-b3e4-eafa6a96a1b4",
                                                "text": "Il y faisait nuit en plein jour, mais les cretonnes du lit et des fenêtres, blanches et rouges, n’avaient pas trop souffert."
                                            },
                                            {
                                                "example_id": "94200b15-a056-44ad-8ed3-ae42ed9f54d8",
                                                "sense_id": "f65766d0-9359-359a-b3e4-eafa6a96a1b4",
                                                "text": "Leur maison tendue de cretonne avait le charme prenant d’une vieille demeure de province."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "404bed06-0f4d-400e-98d6-f5cc0591b1df",
                        "source_entry_id": "3ecb0040-bea0-38fd-aa55-e95380170c69",
                        "source_sense_id": "7872c6d5-b773-3e88-8129-a5adba2476fb",
                        "target_lang_word": "cretona",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cretona",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "162e6bb1-6691-3bab-8ca7-2bfaf118786e",
                                        "entry_id": "4f4f9934-4d1b-34d3-baea-a677bfd4f278",
                                        "glosses": [
                                            "Tela fuerte, estampada, que se usa en tapicería y decoración."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff2ec50-aad7-461a-bfee-9d4bb57fc922",
                                                "sense_id": "162e6bb1-6691-3bab-8ca7-2bfaf118786e",
                                                "text": "Doy un paso dentro de una habitación cuyas cretonas descoloridas le comunican no sé qué encanto anticuado."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ac95439-2d88-488b-874f-19334db21204",
                        "source_entry_id": "3ecb0040-bea0-38fd-aa55-e95380170c69",
                        "source_sense_id": "7872c6d5-b773-3e88-8129-a5adba2476fb",
                        "target_lang_word": "Cretonne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cretonne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69985146-ff0a-3c64-bfe1-a20b7c7f9296",
                                        "entry_id": "75fcf773-3094-3b12-8d92-798a1441d062",
                                        "glosses": [
                                            "„Baumwollgewebe in Leinenbindung (eine Webart)“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35f3b340-3897-4774-b533-1410611d0e9b",
                                                "sense_id": "69985146-ff0a-3c64-bfe1-a20b7c7f9296",
                                                "text": "„In dem großen Zimmer unten mit seinen Polstermöbeln, die rötliche Blümlein auf gelbem Cretonne zeigen, erwartet mich meine Sekretärin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
