                    "target_lang_definitions": {
                        "ru": "Одна из десяти равных частей целого; 1/10.",
                        "zh": "整体的十等份之一；1/10。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "десятая",
                                "target_lang_sense_clarification": "доля, часть"
                            },
