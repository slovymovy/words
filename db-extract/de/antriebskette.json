                "senses": [
                    {
                        "sense_id": "682f7d07-0b21-3849-8348-44d90346d55b",
                        "entry_id": "9337c95b-05e0-31c9-bb5d-decc6303d896",
                        "glosses": [
                            "Kette, die der Übertragung von Kraft und Bewegung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63ebbf52-cab5-49ef-97ac-5419daa96811",
                                "sense_id": "682f7d07-0b21-3849-8348-44d90346d55b",
                                "text": "„Wegen einer gebrochenen Antriebskette mussten die Urlauber vier Stunden in Skigondeln ausharren, bevor sie abgeseilt wurden.“"
                            },
                            {
                                "example_id": "1ed030d7-7ebd-41b4-a2c6-56c78675f7c4",
                                "sense_id": "682f7d07-0b21-3849-8348-44d90346d55b",
                                "text": "„Gleich zwei technische Defekte, Probleme mit der Antriebskette und ein gebrochener Auspuff, zwangen das Gespann vier Runden vor dem Ziel zur Aufgabe.“"
                            },
                            {
                                "example_id": "bad955f6-657c-4574-a6e3-999e0603f374",
                                "sense_id": "682f7d07-0b21-3849-8348-44d90346d55b",
                                "text": "„‚Bei Fahrzeugen mit Antriebskette ist es wichtig, Kettenspannung und -verschleiß zu prüfen und die Kette gegebenenfalls zu spannen und anschließend zu fetten‘, erläutert Diana Sprung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
