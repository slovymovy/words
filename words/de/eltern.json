                    "sense_id": "8121c294-1f09-369c-9ab0-9fc964ff73f1",
                    "sense_definition": "Vater und Mutter eines Kindes",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meine <w>Eltern</w> wohnen in einem kleinen Haus auf dem Land.",
                            "target_lang_translations": {
                                "en": "My <w>parents</w> live in a small house in the countryside.",
                                "ru": "Мои <w>родители</w> живут в небольшом доме в деревне.",
                                "nl": "Mijn <w>ouders</w> wonen in een klein huis op het platteland.",
                                "pl": "Moi <w>rodzice</w> mieszkają w małym domu na wsi.",
                                "fr": "Mes <w>parents</w> habitent dans une petite maison à la campagne.",
                                "it": "I miei <w>genitori</w> vivono in una piccola casa in campagna.",
                                "cs": "Moji <w>rodiče</w> bydlí v malém domku na venkově.",
                                "tr": "Benim <w>anne babam</w> kırsalda küçük bir evde yaşıyor.",
                                "es": "Mis <w>padres</w> viven en una casa pequeña en el campo.",
                                "zh": "我的<w>父母</w>住在乡下一座小房子里。"
                            }
                        },
                        {
                            "text": "Für diesen Schulausflug brauchen alle Kinder die Zustimmung der <w>Eltern</w>.",
                            "target_lang_translations": {
                                "en": "For this school trip, all children need the consent of their <w>parents</w>.",
                                "ru": "Для этой школьной экскурсии всем детям требуется согласие <w>родителей</w>.",
                                "nl": "Voor dit schoolreisje hebben alle kinderen toestemming van de <w>ouders</w> nodig.",
                                "pl": "Na tę wycieczkę szkolną wszystkie dzieci potrzebują zgody <w>rodziców</w>.",
                                "fr": "Pour cette sortie scolaire, tous les enfants ont besoin de l'accord des <w>parents</w>.",
                                "it": "Per questa gita scolastica, tutti i bambini hanno bisogno del consenso dei <w>genitori</w>.",
                                "cs": "Pro tento školní výlet potřebují všechny děti souhlas <w>rodičů</w>.",
                                "tr": "Bu okul gezisi için tüm çocukların <w>ebeveynlerinin</w> onayına ihtiyacı var.",
                                "es": "Para esta excursión escolar, todos los niños necesitan la autorización de los <w>padres</w>.",
                                "zh": "参加这次学校郊游，所有孩子都需要得到<w>父母</w>的同意。"
                            }
                        }
                    ],
