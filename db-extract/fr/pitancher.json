                ],
                "senses": [
                    {
                        "sense_id": "bb91d554-98d0-385c-aa3b-1873b1cbd408",
                        "entry_id": "2c83753d-43df-3797-8695-374baa8d6f1e",
                        "glosses": [
                            "Boire de l'alcool ; s’arsouiller."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "3e11de14-c980-4939-8b0b-55506ad44588",
                                "sense_id": "bb91d554-98d0-385c-aa3b-1873b1cbd408",
                                "text": "Viens-t'en plutôt écraser un grain avec moi, voire même pour une dame qui fréquente les poètes, viens pitancher un verre de cogne."
                            },
                            {
                                "example_id": "c682cbc9-4140-439a-88b0-e8df76d4658e",
                                "sense_id": "bb91d554-98d0-385c-aa3b-1873b1cbd408",
                                "text": "Veinards en train de pitancher !"
                            },
                            {
                                "example_id": "5a78cd97-6394-45d9-ad8e-e88168552061",
                                "sense_id": "bb91d554-98d0-385c-aa3b-1873b1cbd408",
                                "text": "Faut dire que le gars pitanchait pas mal. Il lui fallait un bon moment pour rentrer, sans parler des fois où il avait été retrouvé dans le fossé près de son vélo, en train de faire fonctionner son alambic interne, […]."
                            }
                        ]
                    }
