                    },
                    {
                        "translation_id": "0b01ba7d-7592-4361-a8b0-b66f09c58744",
                        "source_entry_id": "f5e3140d-56a4-358e-90df-8be1134fb8c2",
                        "source_sense_id": "59fdf4e0-4d6b-3244-8b55-6239c13e595d",
                        "target_lang_word": "répit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07e6adf6-e099-31ff-a9be-84a7d25e03dc",
                                        "entry_id": "00fba585-2f3a-3519-a858-7b160a84968f",
                                        "glosses": [
                                            "Relâche, délai, action de surseoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "469a1cab-5618-4a5a-a898-b53a332ae933",
                                                "sense_id": "07e6adf6-e099-31ff-a9be-84a7d25e03dc",
                                                "text": "Les marchandes de volailles, accroupies côte à côte, caquetaient sans répit à ses côtés."
                                            },
                                            {
                                                "example_id": "3be2cf2e-4b24-4cc3-b9f0-45da186a5f64",
                                                "sense_id": "07e6adf6-e099-31ff-a9be-84a7d25e03dc",
                                                "text": "Je le poursuivrai incessamment et ne lui donnerai point de répit."
                                            },
                                            {
                                                "example_id": "26181576-9105-4be4-9758-7d0f2a7cf4bd",
                                                "sense_id": "07e6adf6-e099-31ff-a9be-84a7d25e03dc",
                                                "text": "Je lui ai donné un répit d’un mois."
                                            },
                                            {
                                                "example_id": "4ff12203-840d-4ceb-baf7-80152fa80885",
                                                "sense_id": "07e6adf6-e099-31ff-a9be-84a7d25e03dc",
                                                "text": "Ce créancier n’a jamais donné de répit à ses débiteurs."
                                            },
                                            {
                                                "example_id": "1a6130e1-b658-4f8f-bc17-c2e86feafd0a",
                                                "sense_id": "07e6adf6-e099-31ff-a9be-84a7d25e03dc",
                                                "text": "\"Peut-être devrions-nous faire grève pour que notre voix soit entendue. Car les blessures se multiplient et il n’y a pas de répit, surtout avec la Coupe du monde des clubs qui approche, c’est fou !” - (Jules Koundé, Gazzetta Foot, 19/09/2024)"
                                            },
                                            {
                                                "example_id": "481d98fc-31e7-4e75-8d36-6e9ccbaec68b",
                                                "sense_id": "07e6adf6-e099-31ff-a9be-84a7d25e03dc",
                                                "text": "— ' Nous sommes donc joignables et « dérangeables » à tout instant. Il n'y a pas un moment, ni un endroit, où nous puissions avoir du répit : aux États-Unis, 75 % des possesseurs de smartphones l'utilisent aux toilettes !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
