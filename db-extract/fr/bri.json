                "senses": [
                    {
                        "sense_id": "24c98d4a-73bd-3d25-97ef-760f2f8b7287",
                        "entry_id": "328b0317-594b-3c7a-9fe8-1c5d2cd8845f",
                        "glosses": [
                            "Brigade de recherche et d’intervention."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "ef93cc67-ff5c-4980-99fb-b685246f2d8b",
                                "sense_id": "24c98d4a-73bd-3d25-97ef-760f2f8b7287",
                                "text": "Donc, sur ce genre de prise d’otages, on rentre. […]. Pour le Bataclan, l’affaire est trop lente, car la BRI et le RAID se pignolent pendant une heure et demie pour savoir qui va y aller."
                            },
                            {
                                "example_id": "b4d8dc26-6aca-45bf-a349-619af13742db",
                                "sense_id": "24c98d4a-73bd-3d25-97ef-760f2f8b7287",
                                "text": "Le brigadier de la BRI, ancien bacqueux, assis à l’arrière du véhicule de surveillance, songea à l’avertissement qui lui avait été ressassé à chaque étape de son recrutement : « Attention à ne pas vous tromper de job. À la BAC, vous interpellez tous les jours des délinquants, ce ne sera pas le cas chez nous. […]. »"
                            },
                            {
                                "example_id": "d32df520-8a14-418a-9b86-1bd66dfd9d49",
                                "sense_id": "24c98d4a-73bd-3d25-97ef-760f2f8b7287",
                                "text": "Les flics de la BRI, combinaison noire, casque et cagoule, débarquèrent de leurs engins semi-blindés, l’arme au poing."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3f5fdbd-8f2b-3fe6-b6e0-1c82ec7d67e3",
