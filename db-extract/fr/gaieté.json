        "fr-extract.jsonl": [
            {
                "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                "word": "gaieté",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "92945a2d-ee20-4a8e-82bc-9993c64f2648",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "tags": [
                            "plural"
                        ],
                        "form": "gaietés"
                    },
                    {
                        "form_id": "ab32c50a-399e-4a0e-a62e-e5198fd4bdca",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "gaité"
                    },
                    {
                        "form_id": "9c58aa8e-fd91-4f34-9ef7-89dfc33264c4",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "tags": [],
                        "form": "gaîté"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e294092b-ca5e-33e3-b3af-03d659a674dd",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "glosses": [
                            "Disposition à être de bonne humeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40ef4e1-676b-4aa9-9d7e-891fd35b80ab",
                                "sense_id": "e294092b-ca5e-33e3-b3af-03d659a674dd",
                                "text": "Ils retrouvèrent cette gaieté naturelle que les dures épreuves avaient chassée depuis longtemps."
                            },
                            {
                                "example_id": "ba403604-3cb8-4517-aef3-5a487d451a34",
                                "sense_id": "e294092b-ca5e-33e3-b3af-03d659a674dd",
                                "text": "Et il se mit à singer le papotage d’une Parisienne, et jusqu’à la mimique, avec tant de gaieté que Zaheira ne put s’empêcher de rire."
                            },
                            {
                                "example_id": "6a8e0867-f86a-4231-b751-3b266de7778b",
                                "sense_id": "e294092b-ca5e-33e3-b3af-03d659a674dd",
                                "text": "À mon sens la gaieté vaut presque la sagesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b218ad2-9429-3181-a338-2c371b15b189",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "glosses": [
                            "Belle humeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0279dd2c-6b51-45ce-b2d7-d8eee89abea2",
                                "sense_id": "6b218ad2-9429-3181-a338-2c371b15b189",
                                "text": "Ce pauvre diable ainsi parlant\nMettait en gaieté tout l’hospice."
                            }
                        ]
                    },
                    {
                        "sense_id": "420ad7c0-6fde-3a7c-93e8-bd05698c0077",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "glosses": [
                            "Folâtrerie, plaisanteries ou jeux d’enfants."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9d0da97e-51b5-4efb-8bb2-056e98bc4e6b",
                                "sense_id": "420ad7c0-6fde-3a7c-93e8-bd05698c0077",
                                "text": "Ce sont là de petites gaietés qu’on peut passer à la jeunesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7f8f9a3-7d96-39e3-a5a3-aea7450aa188",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "glosses": [
                            "Vivacité de belle humeur franche et communicative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa3182d2-3c37-41f0-b582-f185580b3cd2",
                                "sense_id": "d7f8f9a3-7d96-39e3-a5a3-aea7450aa188",
                                "text": "Les hommes mêmes n’ont pas en Perse la gaieté qu’ont les Français."
                            },
                            {
                                "example_id": "a5eb3eb2-b85c-45d6-b40a-d729ae28f74d",
                                "sense_id": "d7f8f9a3-7d96-39e3-a5a3-aea7450aa188",
                                "text": "Le vrai caractère de la gaieté italienne, ce n’est pas la moquerie, c’est l’imagination."
                            },
                            {
                                "example_id": "a38cbb16-fba1-40b0-9c39-c1ace7d152c6",
                                "sense_id": "d7f8f9a3-7d96-39e3-a5a3-aea7450aa188",
                                "text": "Cette gaieté qui ne tenait en rien à la moquerie, mais seulement à la vivacité de l’esprit, à la fraîcheur de l’imagination."
                            },
                            {
                                "example_id": "5d088c5a-326b-41be-9a82-7e5eb3a53426",
                                "sense_id": "d7f8f9a3-7d96-39e3-a5a3-aea7450aa188",
                                "text": "Je connais Victor : sa gaieté est une gaieté sans esprit, une gaieté de caserne, il est sans talent et dépensier."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6e98a73-1805-303c-a8e7-b371a7ef0756",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "glosses": [
                            "Manière agréable et enjouée d’écrire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fe966e7-4e90-48cb-a6c2-0998fc1f4768",
                                "sense_id": "b6e98a73-1805-303c-a8e7-b371a7ef0756",
                                "text": "Avoir de la gaieté dans le style."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a20eb2b-55c5-362f-8a55-68caef67007f",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "glosses": [
                            "Pointe de vin ; griserie d’alcool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b5b882-e73e-46c9-b75b-b7004ea52702",
                                "sense_id": "3a20eb2b-55c5-362f-8a55-68caef67007f",
                                "text": "On commençait à être en gaieté."
                            }
                        ]
                    },
                    {
                        "sense_id": "692ab3ac-d837-3b68-8f97-826ca5ebe868",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "glosses": [
                            "Vivacité, en parlant d’un cheval."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1d5b03e4-301b-3631-8b81-ad7113b549d5",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "glosses": [
                            "Paroles, actions gaies, folâtres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9822c100-d0bc-4151-891c-61a3c308bedd",
                                "sense_id": "1d5b03e4-301b-3631-8b81-ad7113b549d5",
                                "text": "Ce sont des jeux de mains et des gaietés incroyables."
                            },
                            {
                                "example_id": "badfd226-8a79-42be-9083-2a7f99721383",
                                "sense_id": "1d5b03e4-301b-3631-8b81-ad7113b549d5",
                                "text": "Cent escapades aussi fortes passèrent pour des gaietés et des gentillesses agréables."
                            }
                        ]
                    },
                    {
                        "sense_id": "f25ba4ba-550b-33fb-83f3-5c15696da9ec",
                        "entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "glosses": [
                            "Petite pièce de théâtre ou autre, destinée à faire rire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d0cf4a3-a688-4bea-8d99-2fbd8f4f2c0c",
                                "sense_id": "f25ba4ba-550b-33fb-83f3-5c15696da9ec",
                                "text": "Une petite gaieté qu’il s’était permise au théâtre de Fontainebleau, en y tournant en ridicule, dans un prologue de sa façon, les gentilshommes de la chambre, les lui avait aliénés."
                            },
                            {
                                "example_id": "980f0d6c-1985-4851-9d79-e2882627635c",
                                "sense_id": "f25ba4ba-550b-33fb-83f3-5c15696da9ec",
                                "text": "Verre en main, Jean le vigneron\nChantait les gaietés de Piron."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccf23355-20ce-490f-9e35-05ec1176b38c",
                        "source_entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "target_lang_word": "cheerfulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheerfulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                        "entry_id": "22992355-ca5c-36ce-8567-edbb80c94af2",
                                        "glosses": [
                                            "The state of being cheerful; joy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50aa49d1-e64f-4ddc-8391-7d8377c3d509",
                                                "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                                "text": "Or he that exhorteth, on exhortation: he that giueth, let him doe it with simplicitie: hee that ruleth, with diligence: hee that sheweth mercy, with cheerefulnesse."
                                            },
                                            {
                                                "example_id": "1d546bda-b067-418d-8b73-1f63d0495500",
                                                "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                                "text": "The banded ones were all dressed in white gowns - a gay survival from Old Style days, when cheerfulness and May-time were synonyms - days before the habit of taking long views had reduced emotions to a monotonous average."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35e283c0-1b49-4e4e-8330-e168f870751a",
                        "source_entry_id": "6585c45f-a49b-3517-a0f6-5119652add29",
                        "target_lang_word": "gaiety",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaiety",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4c79d6e-250c-3409-aa21-76f01913e0a1",
                                        "entry_id": "a4c68aa5-3231-3e69-8c0e-ce2157a543d2",
                                        "glosses": [
                                            "The state of being happy or merry."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50b11cfd-de03-4d0c-8d38-7be7b5d21a04",
                                                "sense_id": "d4c79d6e-250c-3409-aa21-76f01913e0a1",
                                                "text": "There was much gaiety at the ball."
                                            },
                                            {
                                                "example_id": "8751749e-8f49-4ae2-b9f4-92c4bd4a55ca",
                                                "sense_id": "d4c79d6e-250c-3409-aa21-76f01913e0a1",
                                                "text": "The decorations added greatly to the gaiety of the room."
                                            },
                                            {
                                                "example_id": "e58f53d2-042d-4226-8975-6e998f48f7dc",
                                                "sense_id": "d4c79d6e-250c-3409-aa21-76f01913e0a1",
                                                "text": "During the present gayety of the house, however, the poor girl has gone about with a face full of trouble, and to use the housekeeper's words, \"has fallen into a sad hystericky way lately.\""
                                            },
                                            {
                                                "example_id": "c5a91f4b-a293-4baf-9f47-cda2146dfa24",
                                                "sense_id": "d4c79d6e-250c-3409-aa21-76f01913e0a1",
                                                "text": "Now that she had rested and had fed from the luncheon tray Mrs. Broome had just removed, she had reverted to her normal gaiety. She looked cool in a grey tailored cotton dress with a terracotta scarf and shoes and her hair a black silk helmet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2c8c042-ea2f-3136-aa90-364ecc41a516",
                                        "entry_id": "a4c68aa5-3231-3e69-8c0e-ce2157a543d2",
                                        "glosses": [
                                            "Merrymaking or festivity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37751d2b-a0cf-4a9c-bc12-f1b269e5e25f",
                                                "sense_id": "d2c8c042-ea2f-3136-aa90-364ecc41a516",
                                                "text": "And he would tell her all sorts of wonders, old-world gaieties, long before she was born; and how finely the great Mr. [George Frideric] Handel played upon the harpischord^([sic]) in the Music Hall, and how his talk was in German, Latin, French, English, Italian, and half-a-dozen languages beside, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
