                        "entry_id": "055e6e96-d74a-39ec-92c6-f8216c1680ba",
                        "glosses": [
                            "Espèce minérale du groupe des silicates, sous-groupe des nésosilicates, de formule Al₂SiO₅."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae552454-860e-40ce-8860-55ad7ffdc5cf",
                                "sense_id": "12743bf4-70f7-3a69-b36f-f1f1c13b8761",
                                "text": "La cordiérite est généralement accompagnée par d’autres minéraux alumineux : muscovite le plus souvent, à laquelle s’ajoute parfois l’andalousite."
                            }
                        ]
                    }
                ],
