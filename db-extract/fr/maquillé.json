                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13980711-089f-327d-8fdd-1c8d457cca3f",
                                        "entry_id": "93d8945c-fb14-327d-bd9c-4179e3d8d0fb",
                                        "glosses": [
                                            "Invented or fabricated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83280041-1c9f-45ac-b952-e2049fe5891c",
                                                "sense_id": "13980711-089f-327d-8fdd-1c8d457cca3f",
                                                "text": "He told me a made-up version of the events, but I demanded the truth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afcb5b7e-7087-3d04-8613-efccc95b6454",
                                        "entry_id": "93d8945c-fb14-327d-bd9c-4179e3d8d0fb",
                                        "glosses": [
                                            "Changed by the application of cosmetics; wearing make-up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8eb3e38-0edb-4db5-8a6b-532cd3f1c442",
                                                "sense_id": "afcb5b7e-7087-3d04-8613-efccc95b6454",
                                                "text": "a freshly made-up clown"
                                            },
                                            {
                                                "example_id": "f4cb9715-94dd-41d3-9ead-478620ad692b",
                                                "sense_id": "afcb5b7e-7087-3d04-8613-efccc95b6454",
                                                "text": "A man at the complex said he had seen the often heavily made-up girls coming and going in luxury vehicles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30c66eb3-0f3c-36cb-b8a4-09bee452995c",
                                        "entry_id": "93d8945c-fb14-327d-bd9c-4179e3d8d0fb",
                                        "glosses": [
                                            "Arranged or put together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea635a39-431d-40c4-af15-21a25087e0a8",
                                                "sense_id": "30c66eb3-0f3c-36cb-b8a4-09bee452995c",
                                                "text": "The newly made-up front page had to be changed as the last-minute news arrived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed5a7d0f-b12e-39ae-9d88-a7199d8efcc5",
                                        "entry_id": "93d8945c-fb14-327d-bd9c-4179e3d8d0fb",
                                        "glosses": [
                                            "Delighted, pleased, thrilled."
                                        ],
                                        "tags": [
                                            "UK",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d0e6f6a-bc99-4e6c-90ee-ef498d8e506e",
                                                "sense_id": "ed5a7d0f-b12e-39ae-9d88-a7199d8efcc5",
                                                "text": "I was made-up when the local team won."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8db09ed-b292-37b2-bbc7-107bda7b7207",
                                        "entry_id": "93d8945c-fb14-327d-bd9c-4179e3d8d0fb",
                                        "glosses": [
                                            "Built up (to a higher level)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaa1edd1-2dbd-40c8-9dad-fe7dbd0f3e3b",
                                                "sense_id": "a8db09ed-b292-37b2-bbc7-107bda7b7207",
                                                "text": "All three structures were sited on made-up ground, to depths up to about 20 ft., which had been deposited to form the railway embankments."
                                            }
                                        ]
                                    }
                                ]
                            }
