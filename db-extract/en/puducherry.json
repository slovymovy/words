                                "target_senses": [
                                    {
                                        "sense_id": "6cbbe74d-45d4-3406-a72a-d8a23270294b",
                                        "entry_id": "5576b0ff-b4b6-3cac-a379-da20c59402ec",
                                        "glosses": [
                                            "Ville de l’Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3cf98f2-2226-44d2-a97e-426b12e384f1",
                                                "sense_id": "6cbbe74d-45d4-3406-a72a-d8a23270294b",
                                                "text": "Depuis notre dernière communication au sujet du Turnera ulmifolia, nous avons rencontré cette même plante sur un autre point de la ville de Pondichéry, nommé Pillaltottam."
                                            },
                                            {
                                                "example_id": "19b5f99b-d132-462d-8c8d-82a208b6b3be",
                                                "sense_id": "6cbbe74d-45d4-3406-a72a-d8a23270294b",
                                                "text": "Elle était née à Pondichéry, d’un père philippin et d’une mère hindoue, l’un et l’autre de sang mêlé."
                                            },
                                            {
                                                "example_id": "1ad8df09-099c-4edf-9dde-f98b299b9a64",
                                                "sense_id": "6cbbe74d-45d4-3406-a72a-d8a23270294b",
                                                "text": "Son chemin l’a pourtant menée loin des sentiers battus, jusqu’à ce village du Tamil Nadu, entre Chennai et Pondichéry, dans cette cahute où elle est allongée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77209693-b357-3cc2-9bb3-66cbd8100656",
                                        "entry_id": "5576b0ff-b4b6-3cac-a379-da20c59402ec",
                                        "glosses": [
                                            "Ancien comptoir colonial français de 1673 à 1954."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6322d17d-f4a3-4e3d-a725-42430fa1939d",
                                                "sense_id": "77209693-b357-3cc2-9bb3-66cbd8100656",
                                                "text": "M. de Bismark demanda d’abord 10 milliards, toute l’Alsace et toute la Lorraine, Belfort, notre colonie de Pondichéry et une partie de notre flotte."
                                            },
                                            {
                                                "example_id": "89e6e3ea-7989-4081-acc2-3262003bd856",
                                                "sense_id": "77209693-b357-3cc2-9bb3-66cbd8100656",
                                                "text": "Grâce à la compagnie, Lorient se développe et entretient des relations privilégiées avec les comptoirs, particulièrement celui de Pondichéry que le sultan du Bijapur vient de céder à la compagnie."
                                            }
                                        ]
                                    }
                                ]
                            }
