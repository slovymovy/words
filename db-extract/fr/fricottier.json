                        "examples": [
                            {
                                "example_id": "9a59e10d-0494-47bb-b497-aea83174b093",
                                "sense_id": "01fd628a-7262-32bc-a646-2ee19ef27f5f",
                                "text": "L'ami, songe à Polichinelle !\nHomme de plume et fricottier,\nPar l'un et par l'autre métier,\nTa caisse devient solennelle."
                            },
                            {
                                "example_id": "9633d62a-e08d-47a3-9ce0-31959f3c85a1",
                                "sense_id": "01fd628a-7262-32bc-a646-2ee19ef27f5f",
                                "text": "Il devait m'arriver malheur, attendu que j'étais trop heureux de voir crever dans sa peau mon voisin, un gros sournois de Marseillais plus jaloux qu'un juif, un mauvais fricottier qui ne fait que de la cuisine à l'huile. C'était pitié que de le regarder se promener dans sa cambuse vide, tandis que la mienne regorgeait de convives de la cave au grenier."
                            }
                        ]
                    }
