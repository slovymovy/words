            {
                "entry_id": "723f5586-d0e9-3cd0-a601-ab948ec8fb5f",
                "word": "lab",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "36a392f3-eb98-4b53-b22d-39c7711c3c53",
                        "entry_id": "723f5586-d0e9-3cd0-a601-ab948ec8fb5f",
                        "tags": [
                            "plural"
                        ],
                        "form": "labs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                        "entry_id": "723f5586-d0e9-3cd0-a601-ab948ec8fb5f",
                        "glosses": [
                            "A laboratory."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fd2a2749-e807-449a-a89d-aa1bb77955c2",
                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                "text": "I was working in the lab late one night\nWhen my eyes beheld an eerie sight\nFor my monster, from his slab, began to rise\nAnd suddenly, to my surprise\nHe did the Mash\nHe did the Monster Mash."
                            },
                            {
                                "example_id": "97edc03d-3d8e-44ac-80b7-93a9972814f9",
                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                "text": "A man dressed as a lab tech, his blue scrubs startlingly pale against the vivid red and black chaos, moved into sight from behind the SUV. He carried an assault rifle."
                            },
                            {
                                "example_id": "fdca92d6-1c6e-4bfb-84ba-8fbc3d321eb8",
                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                "text": "The NIAID supports projects at universities and research organizations around the United States as well as a network of 21 NIAID labs across the country."
                            },
                            {
                                "example_id": "f6fee6f0-c97e-4c4a-8f9e-56adac636e91",
                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                "text": "Since the lab has been \"doged,\" a petition posted to Change.org by Evgeny Stambulchik asked for signatures to oppose the layoff of the NIST Atomic Spectroscopy Group and has garnered 2,500 signatures as of reporting time. There is also a campaign website."
                            }
                        ]
                    },
                    {
                        "sense_id": "6797c318-9ade-3d80-bd08-d544c2607137",
                        "entry_id": "723f5586-d0e9-3cd0-a601-ab948ec8fb5f",
                        "glosses": [
                            "Laboratory experiment, test, investigation or result."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5f5b1611-466c-4552-a8ae-646684958c18",
                                "sense_id": "6797c318-9ade-3d80-bd08-d544c2607137",
                                "text": "I dropped my mixture while doing my lab, so I had to start over."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
