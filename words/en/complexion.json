                    ],
                    "synonyms": [
                        "color",
                        "tint"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dodat něčemu specifickou barvu nebo vzhled.",
                        "ru": "Придавать чему-либо определенный цвет, оттенок или характер."
                    },
                    "translations": {
                        "cs": [
