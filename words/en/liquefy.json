{
    "word_family": [
        "liquid",
        "liquefaction",
        "liquefier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2bf05000-bf6b-3d39-ade9-41f05d3a93ad",
                    "sense_definition": "To cause a solid or gas to change into a liquid state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers use extreme heat to <w>liquefy</w> the metal before pouring it into molds.",
                            "target_lang_translations": {
                                "ru": "Рабочие используют сильный нагрев, чтобы <w>расплавить</w> металл перед заливкой в формы."
                            }
                        },
                        {
                            "text": "Scientists can <w>liquefy</w> natural gas by cooling it to very low temperatures.",
                            "target_lang_translations": {
                                "ru": "Ученые могут <w>сжижать</w> природный газ, охлаждая его до очень низких температур."
                            }
                        }
                    ],
                    "synonyms": [
                        "liquidize",
                        "melt"
                    ],
                    "antonyms": [
                        "solidify",
                        "freeze"
                    ],
                    "common_phrases": [
                        "liquefy gas",
                        "liquefy under heat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переводить твердое вещество или газ в жидкое состояние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжижать",
                                "target_lang_sense_clarification": "о газах"
                            },
                            {
                                "target_lang_word": "разжижать",
                                "target_lang_sense_clarification": "делать жидким"
                            },
                            {
                                "target_lang_word": "плавить",
                                "target_lang_sense_clarification": "переводить твердое вещество в жидкое нагреванием"
                            },
                            {
                                "target_lang_word": "превращать в жидкость",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9801c9d-f6c3-3640-8501-decec72dd18c",
                    "sense_definition": "To become liquid, especially through melting or condensation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick ice began to <w>liquefy</w> as the morning temperature rose.",
                            "target_lang_translations": {
                                "ru": "Толстый лед начал <w>таять</w>, когда утренняя температура поднялась."
                            }
                        },
                        {
                            "text": "Certain types of rock can <w>liquefy</w> during intense volcanic activity.",
                            "target_lang_translations": {
                                "ru": "Некоторые виды горных пород могут <w>плавиться</w> во время сильной вулканической активности."
                            }
                        }
                    ],
                    "synonyms": [
                        "melt"
                    ],
                    "antonyms": [
                        "solidify",
                        "freeze"
                    ],
                    "common_phrases": [
                        "begin to liquefy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переходить в жидкое состояние, плавиться или конденсироваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавиться",
                                "target_lang_sense_clarification": "о твердых телах под действием тепла"
                            },
                            {
                                "target_lang_word": "сжижаться",
                                "target_lang_sense_clarification": "о газах при охлаждении или сжатии"
                            },
                            {
                                "target_lang_word": "разжижаться",
                                "target_lang_sense_clarification": "становиться более жидким"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20ca378f-cf66-3c74-a33f-d8c377c3f7a7",
                    "sense_definition": "To distort or warp a digital image smoothly as though it were fluid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor used software to <w>liquefy</w> the background and create a surreal effect.",
                            "target_lang_translations": {
                                "ru": "Редактор использовал программу, чтобы <w>деформировать</w> фон и создать сюрреалистический эффект."
                            }
                        },
                        {
                            "text": "Be careful when you <w>liquefy</w> facial features, or the portrait will look unnatural.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, когда <w>применяете пластику</w> к чертам лица, иначе портрет будет выглядеть неестественно."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавно деформировать цифровое изображение с помощью графических инструментов («пластика»)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деформировать",
                                "target_lang_sense_clarification": "в графическом редакторе"
                            },
                            {
                                "target_lang_word": "применять пластику",
                                "target_lang_sense_clarification": "инструмент Liquify в фоторедакторах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}