                "senses": [
                    {
                        "sense_id": "16589afa-4c90-3426-a5a5-a3bb1a533a5f",
                        "entry_id": "a5723bbd-4cc3-3fd9-8af5-42cb06cc46cd",
                        "glosses": [
                            "Fenouil des Alpes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e660fe-88d7-46b3-972c-bff5c923536f",
                                "sense_id": "16589afa-4c90-3426-a5a5-a3bb1a533a5f",
                                "text": "Sur un terrain fumé, les baudremoines trop engraissées, reconnaissables à leur couleur vert-foncé, n’hébergent pratiquement jamais de chenilles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac6f2249-7e1f-4ce0-b4c5-a0a1e6037444",
                        "source_entry_id": "a5723bbd-4cc3-3fd9-8af5-42cb06cc46cd",
                        "source_sense_id": "16589afa-4c90-3426-a5a5-a3bb1a533a5f",
                        "target_lang_word": "Bärwurz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bärwurz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31292d13-96df-32db-ae0d-f1c0ae73cb13",
                                        "entry_id": "2859d553-a41e-34eb-8e0d-3751d1e30eba",
                                        "glosses": [
                                            "weiß blühende Pflanze der Gattung Meum aus der Familie der Doldenblüter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3ab727f-c3b0-4ba6-99a2-bfa532530a79",
                                                "sense_id": "31292d13-96df-32db-ae0d-f1c0ae73cb13",
                                                "text": "Die Bärwurz wird auch als Gewürz und zum Schnaps brennen genutzt."
                                            },
                                            {
                                                "example_id": "7ddb4556-4458-4952-8e8d-c096c827ff6a",
                                                "sense_id": "31292d13-96df-32db-ae0d-f1c0ae73cb13",
                                                "text": "„Der Bärwurz (Meum athamanticum) ist eine Pflanze, die auf Bergwiesen des Bayerischen Waldes und in Kulturen wächst.“"
                                            },
                                            {
                                                "example_id": "0c1b906b-6b8d-4e6e-ba2a-418425b59fdc",
                                                "sense_id": "31292d13-96df-32db-ae0d-f1c0ae73cb13",
                                                "text": "„Kühe bei uns in Mitteleuropa in Höhenlagen fraßen bei Erkrankungen häufig Bärwurz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bärwurz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c4dd81f-ba9f-338d-bf1e-3c5a2496e418",
                                        "entry_id": "7af233a3-3e7d-3f40-8356-f62d7c9f60df",
                                        "glosses": [
                                            "klarer, hochprozentiger Schnaps des Bayerischen Waldes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80da575d-a9b4-4aac-9f7c-ae3cd3ac8463",
                                                "sense_id": "5c4dd81f-ba9f-338d-bf1e-3c5a2496e418",
                                                "text": "„Als sie in Richtung Altstadt losmarschieren, ist ihnen sehr warm, auch wegen der Flasche Bärwurz, die Tim aus dem Keller seiner Eltern mitgenommen hat.“"
                                            },
                                            {
                                                "example_id": "54269340-8510-47b3-8839-ea14be879cff",
                                                "sense_id": "5c4dd81f-ba9f-338d-bf1e-3c5a2496e418",
                                                "text": "„Er bestellte sich noch einmal ein Bier und dann eine ganze Runde Bier und Bärwurz, als er die Blicke bemerkte.“"
                                            },
                                            {
                                                "example_id": "806d42d7-00ba-4221-b23e-0bb5dc1b6796",
                                                "sense_id": "5c4dd81f-ba9f-338d-bf1e-3c5a2496e418",
                                                "text": "„Der Bärwurz ist ein klarer Kräuterschnaps, der seinen Namen von der gleichnamigen Pflanze hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ebfaf2c-d347-42ef-9528-3104afe637be",
                        "source_entry_id": "a5723bbd-4cc3-3fd9-8af5-42cb06cc46cd",
