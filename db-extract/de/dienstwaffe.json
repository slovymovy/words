                "senses": [
                    {
                        "sense_id": "c8584f88-1966-309a-8ab9-b1ba440c92ee",
                        "entry_id": "f23967d3-7cc7-379b-b6b4-0d3bdd948680",
                        "glosses": [
                            "Waffe für den dienstlichen Einsatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b9e191-9a79-48c0-998e-c3099df1edc0",
                                "sense_id": "c8584f88-1966-309a-8ab9-b1ba440c92ee",
                                "text": "Seine Dienstwaffe befindet sich im Holster."
                            },
                            {
                                "example_id": "eb56b600-e831-4e34-bd3a-0df3c38269bd",
                                "sense_id": "c8584f88-1966-309a-8ab9-b1ba440c92ee",
                                "text": "„Ihre Dienstwaffen zeichneten sich diskret unter ihren Mänteln ab, doch ihre Blicke schweiften nervös umher und musterten Gesichter.“"
                            },
                            {
                                "example_id": "1812dca7-9558-4ffb-94f1-c1b3a269b802",
                                "sense_id": "c8584f88-1966-309a-8ab9-b1ba440c92ee",
                                "text": "„Während er vor seinem Glas saß, bemitleidete er sich selbst und malte sich aus, wie es wäre, die Dienstwaffe zu ziehen und den Barpianisten zu erschießen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
