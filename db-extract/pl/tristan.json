                                    {
                                        "sense_id": "c15556f0-b704-3fec-912c-9279a4b1c57e",
                                        "entry_id": "bfddf928-ac0e-3dc2-91f2-456e5fc51c83",
                                        "glosses": [
                                            "A male given name from the Celtic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "536edfc7-cf64-4746-a5ee-ebc4599a55d5",
                                                "sense_id": "c15556f0-b704-3fec-912c-9279a4b1c57e",
                                                "text": "After the first son had been properly named after the grandfather, the second caught the brunt of her few impulses, being named \"Tristan\", gleaned from medieval lore from her years at Wellesley."
                                            },
                                            {
                                                "example_id": "96c3d2cf-0ceb-453e-852f-04b54e33716d",
                                                "sense_id": "c15556f0-b704-3fec-912c-9279a4b1c57e",
                                                "text": "'His name is Tristan, by the way.' 'Tristan?' 'Yes. Oh, I should have told you. You must have wondered about my own queer name. It was my father. Great Wagnerian. It nearly ruled his life. It was music all the time – mainly Wagner.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e98401fb-8075-3597-a48d-56816bf44150",
                                        "entry_id": "bfddf928-ac0e-3dc2-91f2-456e5fc51c83",
                                        "glosses": [
                                            "A knight of the Round Table in Arthurian legend"
