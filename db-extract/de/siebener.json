                        ],
                        "form": "die Siebener"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "984c97c2-db34-34f6-b8d4-c3bf712e0701",
                        "entry_id": "bcf76307-9d09-3dbb-9311-e8f2ab614910",
                        "glosses": [
                            "etwas mit der Nummer oder dem Wert 7"
                        ],
                        "tags": [
                            "colloquial",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "1923c856-45ff-4a5a-88b6-8262629ce8f7",
                                "sense_id": "984c97c2-db34-34f6-b8d4-c3bf712e0701",
                                "text": "Er spielt den Kreuz-Siebener aus."
                            },
                            {
                                "example_id": "32ea0999-78fb-4b5a-839f-4bed4574923c",
                                "sense_id": "984c97c2-db34-34f6-b8d4-c3bf712e0701",
                                "text": "Der Siebener fährt nur bis zum Hauptbahnhof, dort musst du umsteigen."
                            },
                            {
                                "example_id": "aa9a380c-1f48-495f-97ce-6b1f487cf7e4",
                                "sense_id": "984c97c2-db34-34f6-b8d4-c3bf712e0701",
                                "text": "„Der Achter sticht den Siebener, der hier die schwächste Karte darstellt.“"
                            },
                            {
                                "example_id": "217abb11-c4f1-4c49-a79a-a36a73eb45cc",
                                "sense_id": "984c97c2-db34-34f6-b8d4-c3bf712e0701",
                                "text": "„Auf seinem gut 70 m langen Weg über das Grün des Westfalenstadions lässt der Siebener Simmes sieben Leverkusener inklusive deren Torwart Rüdiger Vollborn stehen wie Ampeln.“"
                            },
                            {
                                "example_id": "f13aaedf-98a7-4f82-97ad-f74eb70243ce",
                                "sense_id": "984c97c2-db34-34f6-b8d4-c3bf712e0701",
                                "text": "„Zehn Minuten später nahm er den Siebener zum Hanuschplatz. Der Bus war voll besetzt, und Peck stand schwankend in dem fahrenden Bus und sah auf eine hübsche Frau, die vor ihm saß.“"
                            },
                            {
                                "example_id": "e6de6e6b-e563-4304-b051-5b48c61f78d6",
                                "sense_id": "984c97c2-db34-34f6-b8d4-c3bf712e0701",
                                "text": "„Mit der rechten hob er eine der Siebener auf und knickte sie ein, so dass sie beinahe auseinanderbrach.“"
                            },
                            {
                                "example_id": "7b580694-b975-42fe-b930-970e9561c2ba",
                                "sense_id": "984c97c2-db34-34f6-b8d4-c3bf712e0701",
                                "text": "„Ich habe den Siebener zugegeben. Und Rozynski hat mit dem König gestochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "57ce00b2-965b-3485-93f6-3da754420187",
                        "entry_id": "bcf76307-9d09-3dbb-9311-e8f2ab614910",
                        "glosses": [
                            "die Zahl 7 selbst"
                        ],
                        "tags": [
                            "colloquial",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "24a0b109-0e8f-4d04-aee6-71d0f6b9f574",
                                "sense_id": "57ce00b2-965b-3485-93f6-3da754420187",
                                "text": "Hier steht ein Siebener."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "36f8517c-c9da-3469-a778-054f6bce990e",
                        "entry_id": "bcf76307-9d09-3dbb-9311-e8f2ab614910",
                        "glosses": [
                            "mit Grenzziehungen und Grenzzeichen befasster Angehöriger der kommunalen Selbstverwaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49fbdb43-0691-4fbc-b251-0c1b2a9a780c",
                                "sense_id": "36f8517c-c9da-3469-a778-054f6bce990e",
                                "text": "Als alter Landmesser kenne ich leider keinen Siebener persönlich."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
