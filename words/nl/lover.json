                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "versiering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Haar feestelijke jurk was versierd met glinsterende <w>lovers</w>.",
                            "target_lang_translations": {
                                "en": "Her festive dress was decorated with glittering <w>sequins</w>."
                            }
                        },
                        {
                            "text": "De naaister bracht met de hand honderden kleine <w>lovers</w> aan op de stof.",
                            "target_lang_translations": {
                                "en": "The seamstress applied hundreds of small <w>sequins</w> to the fabric by hand."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glinsterende lovers"
                    ],
                    "target_lang_definitions": {
                        "en": "Small, glittering metal discs or imitation leaves sewn onto clothing as decoration."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sequins",
                                "target_lang_sense_clarification": "small shiny discs used as decoration"
                            },
                            {
                                "target_lang_word": "spangles",
                                "target_lang_sense_clarification": "small glittering objects used for ornament"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce2c2fac-7e8b-35f4-ac72-ac890ecff0d5",
