                    {
                        "form_id": "2f715d75-92ec-4dd4-a223-625335c41180",
                        "entry_id": "b891a8d7-8ff9-34d7-8f9e-ecb8f6a266b4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bierdeckel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bcf90ab3-8d72-3f8a-843c-e81c99181061",
                        "entry_id": "b891a8d7-8ff9-34d7-8f9e-ecb8f6a266b4",
                        "glosses": [
                            "ein meist runder oder viereckiger Untersetzer aus Pappe, auf den man sein Bierglas stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f01ba7e4-2c87-484c-9c6e-a82b05a294c7",
                                "sense_id": "bcf90ab3-8d72-3f8a-843c-e81c99181061",
                                "text": "Die Bedienung oder der Wirt schreibt für jedes getrunkene Bier auf dem Bierdeckel einen Strich an."
                            },
                            {
                                "example_id": "04785b04-a485-4ce4-a7a1-6a91c41d32ab",
                                "sense_id": "bcf90ab3-8d72-3f8a-843c-e81c99181061",
                                "text": "Die Bierdeckel wurden Ende des 19. Jahrhunderts in Dresden erfunden und auf das Bierglas gelegt, damit es frischer bleibt und keine Insekten hineinfallen. Erst später legte man sie unter das Glas."
                            },
                            {
                                "example_id": "264e207d-28c2-442c-a487-8958d265d882",
                                "sense_id": "bcf90ab3-8d72-3f8a-843c-e81c99181061",
                                "text": "„Viel später erst dämmerte Falk, dieser alte Mann habe heimlich mitgespielt und nur für ihn die schönsten Bierdeckel unter dem Tischbein vergraben.“"
                            },
                            {
                                "example_id": "d7aeeaf9-f323-4f8c-a799-f8a3357d4190",
                                "sense_id": "bcf90ab3-8d72-3f8a-843c-e81c99181061",
                                "text": "Ich sammle Bierdeckel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f578771-7235-3302-bdff-43ae267af58f",
                        "entry_id": "b891a8d7-8ff9-34d7-8f9e-ecb8f6a266b4",
                        "glosses": [
                            "Verschlusskappe einer Bierflasche, meist aus Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff6dddb7-b33c-42ae-afae-6778a41e3cf5",
                                "sense_id": "4f578771-7235-3302-bdff-43ae267af58f",
                                "text": "Ich sammle Bierdeckel."
                            },
                            {
                                "example_id": "c107a5c2-3d30-475a-8137-113688b1b508",
                                "sense_id": "4f578771-7235-3302-bdff-43ae267af58f",
                                "text": "Früher waren fast alle Bierdeckel als Kronenkorken ausgeführt, heute sind auch häufiger Drehverschlüsse anzutreffen."
                            },
                            {
                                "example_id": "773763c6-6817-4850-8af4-b38882c6fda1",
                                "sense_id": "4f578771-7235-3302-bdff-43ae267af58f",
                                "text": "Während des Polterabends hat ein Scherzkeks einen ganzen Sack voll Bierdeckel ausgeschüttet."
                            },
                            {
                                "example_id": "ba43cec8-17cf-4d00-a3a6-a6a0597640dc",
                                "sense_id": "4f578771-7235-3302-bdff-43ae267af58f",
                                "text": "Die Bierdeckel fallen [..] unter den § 1 des genannten Gesetzes, dürfen also nur höchstens 1 Proz. Blei enthalten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6f2f303-cc98-4443-8924-2e4c577bc272",
                        "source_entry_id": "b891a8d7-8ff9-34d7-8f9e-ecb8f6a266b4",
                        "source_sense_id": "bcf90ab3-8d72-3f8a-843c-e81c99181061",
