                        "glosses": [
                            "Distribuer avant que ce soit utile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e053f15c-418b-4677-ab76-064bd320eba6",
                                "sense_id": "6747391d-e13e-35e9-adc2-3069030fddb0",
                                "text": "D'où la décision de prédistribuer ces pastilles, et d'associer, pour la première fois, les riverains à la gestion du risque."
                            },
                            {
                                "example_id": "f97caf91-c1b5-4f7d-9511-d2e9b9a5f216",
                                "sense_id": "6747391d-e13e-35e9-adc2-3069030fddb0",
                                "text": "Il n'y a aucune restriction, à part le fait vous ne pouvez pas prédistribuer plus de 10 POINTS pour le rond entier."
                            },
                            {
                                "example_id": "9d2f2baa-9095-45be-b747-61184f7a46cb",
                                "sense_id": "6747391d-e13e-35e9-adc2-3069030fddb0",
                                "text": "Au total, les opérations de préalimentation ont permis de prédistribuer 6 milliards de billets et 37,5 milliards de pièces."
                            }
                        ]
                    }
