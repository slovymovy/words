                "senses": [
                    {
                        "sense_id": "9ae3039d-8198-3222-9518-eb79ad6b1e23",
                        "entry_id": "c48d7268-1748-3f25-92ea-6c1e5c70fce5",
                        "glosses": [
                            "die direkte (live) Zuschaltung eines/einer vom Ort des Geschehens berichtenden Reporters/Reporterin ins Sendestudio"
                        ],
                        "tags": [
                            "fachsprachlicher Jargon (Rundfunk",
                            "Fernsehen)"
                        ],
                        "examples": [
                            {
                                "example_id": "2ccbd7c5-669c-4de3-ac46-e690820d1ea8",
                                "sense_id": "9ae3039d-8198-3222-9518-eb79ad6b1e23",
                                "text": "„In der Live-Schalte zu Ulrich Tilgner sah man den Bagdad-Korrespondenten das erste Mal seit Wochen – wenn auch resigniert – lächeln, als ihn die 10-jährige Sophie fragte, ob es in diesem Krieg so etwas wie Wahrheit gibt.“"
                            },
                            {
                                "example_id": "1a100104-2878-4f49-8b48-e5b0c17262c2",
                                "sense_id": "9ae3039d-8198-3222-9518-eb79ad6b1e23",
                                "text": "„Mit wohligem Gruseln konnten die Zuschauer in zahllosen Live-Schalten verfolgen, wie Reporter nach Reporter eindringlich über das gerade neueste Detail berichtete, garniert mit verwackelten Amateurvideos von Karr und seiner Familie.“"
                            },
                            {
                                "example_id": "7421f16f-0cdd-4e02-8cfa-3dae9eb32d29",
                                "sense_id": "9ae3039d-8198-3222-9518-eb79ad6b1e23",
                                "text": "„Seine Dienststatistik gibt genaue Auskunft: Seit 1. Dezember 2009 verbrachte Peter Dalheimer insgesamt 704 Tage in Griechenland und sorgte in dieser Zeit für 485 Beiträge oder Live-Schalten.“"
                            },
                            {
                                "example_id": "b2e3eb9d-a6e1-4b96-9323-178fdd18b7c6",
                                "sense_id": "9ae3039d-8198-3222-9518-eb79ad6b1e23",
                                "text": "„Während hier sozusagen im Studio gearbeitet wurde, stellten sich die Jugendlichen im Nachbarraum der Aufgabe einer Live-Schalte.“"
                            },
                            {
                                "example_id": "f2e1a408-d834-4235-b9d5-5fa937007091",
                                "sense_id": "9ae3039d-8198-3222-9518-eb79ad6b1e23",
                                "text": "„Als ich vom Tschetschenien-Krieg aus Grosny berichtete, gab es während der Live-Schalte zu Wickert Explosionen im Hintergrund.“"
                            },
                            {
                                "example_id": "24eba64f-2352-4f8a-94d7-c8b1484a235f",
                                "sense_id": "9ae3039d-8198-3222-9518-eb79ad6b1e23",
                                "text": "„An manchen Tagen im Krieg habe ich bis zu 30 Live-Schalten,[…].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
