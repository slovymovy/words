                ],
                "senses": [
                    {
                        "sense_id": "735850cc-4db3-38c5-a9c2-c276aa78a23b",
                        "entry_id": "ac3f359c-de8f-3145-abaa-d4e3d93a5ec2",
                        "glosses": [
                            "бытовой фитильный нагревательный прибор, работающий на керосине"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d290614-d95c-4372-91f8-0e380dd51c3c",
                                "sense_id": "735850cc-4db3-38c5-a9c2-c276aa78a23b",
                                "text": "Потому офицерские жёны держали на плите кто примус, кто керогаз."
                            },
                            {
                                "example_id": "f8825a6c-6989-43cd-949e-b478d2ccbe1e",
                                "sense_id": "735850cc-4db3-38c5-a9c2-c276aa78a23b",
                                "text": "Тетя Ксана, которая боялась крыс больше, чем немцев, жарила на керогазе рыбу, стоя на низкой табуретке."
                            },
                            {
                                "example_id": "642b5105-dac6-4308-a0b1-21c194c4efb2",
                                "sense_id": "735850cc-4db3-38c5-a9c2-c276aa78a23b",
                                "text": "На кухне радио не выключалось, но его голос всегда был заглушен примусами, керогазами, бабьим гомоном."
                            }
                        ]
                    }
                ],
