                ],
                "senses": [
                    {
                        "sense_id": "e3fd6d3d-c4df-37b3-90be-9dc85ef28b3c",
                        "entry_id": "369f9632-f9dd-3976-a0cc-3fde5d6796b9",
                        "glosses": [
                            "Vertreter einer Gattung der größten, pflanzenfressenden, vierbeinigen Dinosaurier aus der Oberkreide"
                        ],
                        "tags": [
                            "Nomenklatur"
                        ],
                        "examples": [
                            {
                                "example_id": "5cdcec94-a4a9-4144-a0c9-fcb92d34bf96",
                                "sense_id": "e3fd6d3d-c4df-37b3-90be-9dc85ef28b3c",
                                "text": "„Sein Verwandter Argentinosaurus brachte es auf 30 Meter und ein geschätztes Gewicht von 73 Tonnen.“"
                            },
                            {
                                "example_id": "eb4c3f98-591a-4431-9509-2bd20f35f7ba",
                                "sense_id": "e3fd6d3d-c4df-37b3-90be-9dc85ef28b3c",
                                "text": "„Gewichtsschätzungen sind generell schwieriger und werden seltener durchgeführt. Forscher um Mazzetta (2004) errechneten jedoch, dass das Gewicht zwischen 60 und 88 Tonnen lag, und geben 73 Tonnen als den wahrscheinlichsten Wert an, was Argentinosaurus zum schwersten durch relativ gute Fossilien bekannten Sauropoden macht.“"
                            },
                            {
                                "example_id": "b733adc0-38f4-4de7-ad99-270fa2ec78d5",
                                "sense_id": "e3fd6d3d-c4df-37b3-90be-9dc85ef28b3c",
                                "text": "„Von Argentinosaurus gibt es nur vergleichsweise wenige Fossilien aus Argentinien – das hat ihm seinen Namen eingebracht.“"
                            },
                            {
                                "example_id": "e1bebc74-f6a8-4ff3-bd8b-fba82b26399c",
                                "sense_id": "e3fd6d3d-c4df-37b3-90be-9dc85ef28b3c",
                                "text": "„Die Funde lassen allerdings durchaus Rückschlüsse auf die monströsen Ausmaße zu: Argentinosaurus war offenbar der absolute Titan unter den Titanen.“"
                            },
                            {
                                "example_id": "604892ad-c8be-4cd6-80e1-a4249b9726a3",
                                "sense_id": "e3fd6d3d-c4df-37b3-90be-9dc85ef28b3c",
                                "text": "„Der Forscher, der in Patagonien die echten Argentinosaurus-Knochen entdeckt hat, überwachte im Sommer persönlich die Montage.“"
                            },
                            {
                                "example_id": "537ad92f-e009-4855-a255-23d721e33f10",
                                "sense_id": "e3fd6d3d-c4df-37b3-90be-9dc85ef28b3c",
                                "text": "„Der Argentinosaurus war sehr nahe an der Maximalgröße für eine Kreatur auf der Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
