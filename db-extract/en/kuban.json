{
    "word": "kuban",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6c55c4bc-899a-3e5f-8893-14453e8fb791",
                "word": "Kuban",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b2a824f3-b241-3b7b-9165-1e472919b3ac",
                        "entry_id": "6c55c4bc-899a-3e5f-8893-14453e8fb791",
                        "glosses": [
                            "A river in Russia in the North Caucasus. It flows through the Karachay-Cherkessia, Stavropol Krai Krasnodar Krai, and Adygea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd2c072e-9069-4e4a-855f-f3af75aba102",
                                "sense_id": "b2a824f3-b241-3b7b-9165-1e472919b3ac",
                                "text": "...ex-Imperial officers who came to the Don and the Kuban to take arms against Lenins regime..."
                            },
                            {
                                "example_id": "e348d19c-41e9-486a-b7f0-2ffa1bf825c6",
                                "sense_id": "b2a824f3-b241-3b7b-9165-1e472919b3ac",
                                "text": "\"In the 1860s, the lands beyond the Kuban were settled by Black Sea and Line Cossacks from areas populated earlier...\""
                            }
                        ]
                    },
                    {
                        "sense_id": "91440acc-6fd9-3e8c-91f7-c738c55822f9",
                        "entry_id": "6c55c4bc-899a-3e5f-8893-14453e8fb791",
                        "glosses": [
                            "a geographic region of Southern Russia surrounding the Kuban River, on the Black Sea between the Don Steppe, Volga delta and the Caucasus."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "cb4ce2cf-ad20-4991-bc96-0059634cb5a7",
                                "sense_id": "91440acc-6fd9-3e8c-91f7-c738c55822f9",
                                "text": "1954, United American Ukrainian Organizations Committee of New York\n\"In the south, the Red Army abandoned Krasnodar and all of the Kuban. Nazi forces plunged south into the Caucasian highlands and east to Stalingrad.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "2d2faff2-4741-3745-b7d5-7a0f34816e2a",
                        "entry_id": "6c55c4bc-899a-3e5f-8893-14453e8fb791",
                        "glosses": [
                            "Krasnodar Krai"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d667d88-8265-4d9d-825a-4b73c993b82d",
                                "sense_id": "2d2faff2-4741-3745-b7d5-7a0f34816e2a",
                                "text": "\"In 1995, the administration of the Krasnodar Territory, again popularly called the Kuban, adopted the flag of the Kuban Cossacks, with the addition of the territorial coat of arms.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a78f955-cd1e-4cc6-a2f2-fc135f400956",
                        "source_entry_id": "6c55c4bc-899a-3e5f-8893-14453e8fb791",
                        "source_sense_description": "the Kuban river",
                        "target_lang_word": "Kubáň",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "16904db5-ec64-4289-b466-f4193c3d5ce9",
                        "source_entry_id": "6c55c4bc-899a-3e5f-8893-14453e8fb791",
                        "source_sense_description": "the Kuban river",
                        "target_lang_word": "Kouban",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kouban",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "432b7c53-fe07-3734-bbe4-29973fc34430",
                                        "entry_id": "22f4f8a9-2471-39d9-8b22-661751431f02",
                                        "glosses": [
                                            "Fleuve se jetant dans la mer Noire, situé au nord du Caucase et à l’est de la mer d’Azov."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a768732b-8040-4ff1-807d-3bf6c46c708b",
                                                "sense_id": "432b7c53-fe07-3734-bbe4-29973fc34430",
                                                "text": "De l’Ukraine occidentale au Kazakhstan, en passant par la Volga et le Kouban (Russie), des millions de personnes succombent dans un total huis clos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f85fe1f2-89b6-3f07-896d-f3cf579b526f",
                                        "entry_id": "22f4f8a9-2471-39d9-8b22-661751431f02",
                                        "glosses": [
                                            "Région drainée par ce fleuve."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ed6ca28-42cc-4046-8c8d-0d96dc3715a9",
                                                "sense_id": "f85fe1f2-89b6-3f07-896d-f3cf579b526f",
                                                "text": "La collectivisation stalinienne, prévue dans le premier Plan quinquennal (1928-1932) comprend une campagne de dékoulakisation qui a amené la déportation, l’incarcération, et la mort, par famine, de cinq millions de paysans, particulièrement en Ukraine et dans le Kouban."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9815094-21fa-4058-a492-eeb56f1dba88",
                        "source_entry_id": "6c55c4bc-899a-3e5f-8893-14453e8fb791",
                        "source_sense_description": "the Kuban river",
                        "target_lang_word": "Kuban",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kuban",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f4ce81-7dba-3247-9f32-9fa2655b7200",
                                        "entry_id": "aafab82d-ffb2-3f74-9872-ffba829e0c5b",
                                        "glosses": [
                                            "dem Elbrus entspringender und ins Asowsche Meer mündender, rund 870 Kilometer langer Fluss im nördlichen Kaukasus, Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a8f3e69-b105-41f5-8517-363703e799d9",
                                                "sense_id": "c7f4ce81-7dba-3247-9f32-9fa2655b7200",
                                                "text": "„Mit gut 200.000 deutschen und rumänischen Soldaten erreichte die 17. Armee im März 1943 das Mündungsgebiet des Kubans am Ostufer des Asowschen Meeres, dem das Führerhauptquartier in Erinnerung an das antike Siedlungsgebiet der Goten den hochtrabenden Namen ‚Gotenkopf‘ gegeben hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4659d0a0-4f1f-4a2c-adf6-021b9452c35c",
