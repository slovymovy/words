{
    "word_family": [
        "rose",
        "rosily",
        "rosiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "770dcb3c-56a8-30e0-8f5c-b17a573aa037",
                    "sense_definition": "Having a healthy, warm pink or reddish colour, especially of someone's skin or complexion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold wind left the children with <w>rosy</w> cheeks after playing outside.",
                            "target_lang_translations": {
                                "zh": "孩子们在外面玩耍后，冷风吹得他们的脸颊<w>红润</w>。"
                            }
                        },
                        {
                            "text": "She looked radiant and healthy, with a bright, <w>rosy</w> glow on her face.",
                            "target_lang_translations": {
                                "zh": "她看起来容光焕发且健康，脸上洋溢着明亮的<w>红润</w>光泽。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rubicund"
                    ],
                    "common_phrases": [
                        "rosy cheeks",
                        "rosy glow"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指人的肤色或脸色）红润的，健康的粉红色的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "红润",
                                "target_lang_sense_clarification": "指气色红润、健康"
                            },
                            {
                                "target_lang_word": "红润的",
                                "target_lang_sense_clarification": "修饰面容、脸颊"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c27ea3c-dc5d-3da6-9fed-84be5df2c9b5",
                    "sense_definition": "Having a warm pink or rose-red color.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The early morning sky was painted with streaks of <w>rosy</w> light.",
                            "target_lang_translations": {
                                "zh": "清晨的天空被一缕缕<w>玫瑰红的</w>晨光所染透。"
                            }
                        },
                        {
                            "text": "The sun set behind the mountains, casting a <w>rosy</w> hue over the lake.",
                            "target_lang_translations": {
                                "zh": "太阳落入群山之后，给湖面洒上一层<w>粉红色的</w>色调。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pink"
                    ],
                    "common_phrases": [
                        "rosy hue",
                        "rosy tint"
                    ],
                    "target_lang_definitions": {
                        "zh": "玫瑰红色的，粉红色的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "玫瑰红的",
                                "target_lang_sense_clarification": "指事物或光线的颜色"
                            },
                            {
                                "target_lang_word": "粉红色的",
                                "target_lang_sense_clarification": "指粉红的色调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47fc8f05-232e-3bc5-b9b5-6181d66dff1e",
                    "sense_definition": "Promising, optimistic, or full of hope for the future.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "promising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported strong profits, painting a <w>rosy</w> picture for investors.",
                            "target_lang_translations": {
                                "zh": "该公司报告了强劲的利润，为投资者描绘了一幅<w>美好</w>的前景。"
                            }
                        },
                        {
                            "text": "Despite current difficulties, the economist forecasted a <w>rosy</w> future for the industry.",
                            "target_lang_translations": {
                                "zh": "尽管当前存在困难，经济学家仍预测该行业拥有<w>光明</w>的未来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rosy future",
                        "rosy picture"
                    ],
                    "target_lang_definitions": {
                        "zh": "美好的，乐观的，充满希望的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "美好",
                                "target_lang_sense_clarification": "指前景或前景乐观"
                            },
                            {
                                "target_lang_word": "光明",
                                "target_lang_sense_clarification": "指前途光明、乐观"
                            },
                            {
                                "target_lang_word": "乐观",
                                "target_lang_sense_clarification": "指态度或预期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "885007c0-82ca-3b53-935f-243585755148",
                    "sense_definition": "Resembling a rose in fragrance or other qualities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sweet, <w>rosy</w> scent filled the garden as the evening breeze picked up.",
                            "target_lang_translations": {
                                "zh": "随着晚风拂过，一股甜美的<w>玫瑰香</w>弥漫了整个花园。"
                            }
                        },
                        {
                            "text": "The boutique soap had a delicate, distinctly <w>rosy</w> perfume.",
                            "target_lang_translations": {
                                "zh": "这款精品肥皂散发着一种精致而明显的<w>玫瑰香</w>味。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rosy scent"
                    ],
                    "target_lang_definitions": {
                        "zh": "有玫瑰香味的，像玫瑰的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "玫瑰香的",
                                "target_lang_sense_clarification": "带有玫瑰芬芳的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90c74bd6-64ba-390a-ab04-02acd4e7e251",
                    "sense_definition": "Tea; short for the rhyming slang <w>Rosie</w> Lee.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a hard day of work, she sat down with a hot cup of <w>rosy</w>.",
                            "target_lang_translations": {
                                "zh": "辛苦工作了一天后，她坐下来喝了一杯热<w>茶</w>。"
                            }
                        },
                        {
                            "text": "Put the kettle on because I really fancy a nice mug of <w>rosy</w>.",
                            "target_lang_translations": {
                                "zh": "烧上水吧，我真的很想来一大杯好<w>茶</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cup of rosy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "rhyming slang"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "茶（源自英国押韵俚语 Rosie Lee）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "茶",
                                "target_lang_sense_clarification": "英式押韵俚语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1ca52d8d-b8a2-351f-b1b5-51da20728479",
                    "sense_definition": "A diminutive of the female given name <w>Rose</w> and other related names; variant of Rosie.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Little <w>Rosy</w> ran across the grass to greet her grandparents.",
                            "target_lang_translations": {
                                "zh": "小<w>罗西</w>跑过草地去迎接她的祖父母。"
                            }
                        },
                        {
                            "text": "Everyone in the village knew aunt <w>Rosy</w> for her warm smile.",
                            "target_lang_translations": {
                                "zh": "村里的每个人都知道<w>罗西</w>阿姨那温暖的微笑。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "罗西（女性教名 Rose 的昵称）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "罗西",
                                "target_lang_sense_clarification": "女子名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f77d67b-cf01-30aa-bd93-4df24fa0f8eb",
                    "sense_definition": "To make or become pinkish or reddish in colour.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold wind began <w>rosying</w> their cheeks as they walked across the field.",
                            "target_lang_translations": {
                                "zh": "当他们走过田野时，冷风开始<w>吹红</w>了他们的脸颊。"
                            }
                        },
                        {
                            "text": "A sudden blush quickly <w>rosied</w> her pale face when she stood up to speak.",
                            "target_lang_translations": {
                                "zh": "当她站起来发言时，突如其来的红晕迅速染<w>红</w>了她苍白的脸。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使变成粉红色；变红润"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使变红润",
                                "target_lang_sense_clarification": "使发红、变粉红"
                            },
                            {
                                "target_lang_word": "泛红",
                                "target_lang_sense_clarification": "脸部变红"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7f63116-7268-3d03-98b3-2ffe5f589017",
                    "sense_definition": "To present or perceive something in an overly optimistic or positive light.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passing years had completely <w>rosied</w> his memories of that difficult time.",
                            "target_lang_translations": {
                                "zh": "流逝的岁月完全<w>美化</w>了他对那段艰难时期的记忆。"
                            }
                        },
                        {
                            "text": "She tended to <w>rosy</w> the details of their family history when recounting stories.",
                            "target_lang_translations": {
                                "zh": "她在讲述故事时，往往会<w>粉饰</w>家族史中的细节。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rare extension of the adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "把……美化，使显得过于美好或乐观"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "美化",
                                "target_lang_sense_clarification": "过分美化或粉饰"
                            },
                            {
                                "target_lang_word": "粉饰",
                                "target_lang_sense_clarification": "使看起来更乐观"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}