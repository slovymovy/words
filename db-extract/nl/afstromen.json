                "senses": [
                    {
                        "sense_id": "f1121701-11f1-3e44-bf43-863f36a3213a",
                        "entry_id": "a457134a-db8c-3cd2-a1a4-fcf1220e91fd",
                        "glosses": [
                            "to flow off, to flow away"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd95c92-42f2-4a51-ab9d-8c7b5fbe2b7f",
                                "sense_id": "f1121701-11f1-3e44-bf43-863f36a3213a",
                                "text": "Gaat na hoe veranderingen in de atmosfeer de samenstelling van de sneeuwlaag wijzigen en hoe dat zorgt voor het afstromen van het water naar zee.",
                                "translation": "Examines how changes in the atmosphere change the composition of the snow layer and how this causes water to flow away to the sea.",
                                "english": "Examines how changes in the atmosphere change the composition of the snow layer and how this causes water to flow away to the sea."
                            }
                        ]
                    },
                    {
                        "sense_id": "aade2c50-4b80-365a-a10a-44f69683ed33",
                        "entry_id": "a457134a-db8c-3cd2-a1a4-fcf1220e91fd",
                        "glosses": [
                            "to downgrade, to go to a lower educational level"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c10526b9-ca1f-4494-af2b-443a63038c55",
                                "sense_id": "aade2c50-4b80-365a-a10a-44f69683ed33",
                                "text": "Er zijn dan twee opties, namelijk afstromen naar een lager niveau of doubleren.",
                                "translation": "There are then two options, namely downgrading to a lower level or repeating a year.",
                                "english": "There are then two options, namely downgrading to a lower level or repeating a year."
                            }
                        ]
                    }
                ],
