                    "sense_definition": "Qui provoque la surprise ou l'admiration par son caractère inattendu ou remarquable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce magicien a réalisé un tour tout à fait <w>étonnant</w> devant les enfants.",
                            "target_lang_translations": {
                                "en": "The magician performed a truly <w>astonishing</w> trick in front of the children.",
                                "ru": "Этот фокусник показал перед детьми совершенно <w>удивительный</w> фокус.",
                                "nl": "Deze goochelaar voerde voor de kinderen een echt <w>verbazingwekkende</w> truc uit.",
                                "de": "Der Zauberer hat vor den Kindern einen richtig <w>erstaunlichen</w> Trick vorgeführt.",
                                "pl": "Ten magik wykonał przed dziećmi zupełnie <w>zdumiewającą</w> sztuczkę.",
                                "it": "Questo mago ha eseguito un trucco davvero <w>stupefacente</w> davanti ai bambini.",
                                "cs": "Ten kouzelník předvedl před dětmi naprosto <w>úžasný</w> trik.",
                                "tr": "Sihirbaz çocukların önünde gerçekten <w>şaşırtıcı</w> bir numara gösterdi.",
                                "es": "Este mago realizó un truco realmente <w>asombroso</w> delante de los niños.",
                                "zh": "这位魔术师在孩子们面前表演了一个非常<w>惊人</w>的魔术。"
                            }
                        },
                        {
                            "text": "Elle a obtenu un résultat <w>étonnant</w> sans avoir beaucoup révisé avant l'épreuve.",
                            "target_lang_translations": {
                                "en": "She got a <w>surprising</w> result without doing much revision before the exam.",
                                "ru": "Она получила <w>удивительный</w> результат, почти не повторив материал перед экзаменом.",
                                "nl": "Zij behaalde een <w>verrassend</w> resultaat zonder voor het examen veel te hebben gestudeerd.",
                                "de": "Sie erzielte ein <w>erstaunliches</w> Ergebnis, obwohl sie sich vor der Prüfung kaum vorbereitet hatte.",
                                "pl": "Uzyskała <w>zaskakujący</w> wynik, choć przed egzaminem prawie nie powtarzała materiału.",
                                "it": "Ha ottenuto un risultato <w>sorprendente</w> senza aver ripassato molto prima dell'esame.",
                                "cs": "Dosáhla <w>překvapivého</w> výsledku, aniž by před zkouškou hodně opakovala látku.",
                                "tr": "O, sınavdan önce pek çalışmamasına rağmen <w>şaşırtıcı</w> bir sonuç elde etti.",
                                "es": "Obtuvo un resultado <w>sorprendente</w> sin haber repasado mucho antes del examen.",
                                "zh": "她考前没有怎么复习，却取得了<w>惊人</w>的成绩。"
                            }
                        }
                    ],
