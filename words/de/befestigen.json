                    "sense_id": "6d3902f8-7ef7-3547-bd37-9a5732ccf5f6",
                    "sense_definition": "an einem Gegenstand oder Ort fest anbringen oder festmachen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anbringen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich <w>befestige</w> das Bild mit einem Nagel sicher an der Wand."
                        },
                        {
                            "text": "Vor der langen Autofahrt <w>befestigte</w> er das Gepäck sorgfältig auf dem Träger."
                        }
                    ],
                    "antonyms": [
                        "abmachen",
                        "abmontieren",
                        "abnehmen",
                        "loslösen",
                        "losmachen"
                    ],
                    "common_phrases": [
