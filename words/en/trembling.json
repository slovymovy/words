    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d94e62b7-4956-3939-aae8-52e92c0bf3b5",
                    "sense_definition": "Present participle of <w>tremble</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her hands were <w>trembling</w> with excitement as she opened the letter.",
                            "target_lang_translations": {
                                "nl": "Haar handen <w>trilden</w> van opwinding toen ze de brief opende."
                            }
                        },
                        {
                            "text": "The scared child stood in the corner, <w>trembling</w> with fear.",
                            "target_lang_translations": {
                                "nl": "Het bange kind stond in de hoek, <w>bevend</w> van angst."
                            }
                        }
                    ],
                    "synonyms": [
                        "shivering",
                        "shaking",
                        "quivering"
                    ],
                    "common_phrases": [
                        "trembling with fear",
                        "trembling with cold"
                    ],
                    "target_lang_definitions": {
                        "nl": "Onvoltooid deelwoord van beven of trillen; het maken van korte, snelle, ongecontroleerde bewegingen door angst, kou of opwinding."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "beven",
                                "target_lang_sense_clarification": "als werkwoord"
                            },
                            {
                                "target_lang_word": "trillen",
                                "target_lang_sense_clarification": "als werkwoord"
                            },
                            {
                                "target_lang_word": "bevend",
                                "target_lang_sense_clarification": "tegenwoordig deelwoord"
                            },
                            {
                                "target_lang_word": "trillend",
                                "target_lang_sense_clarification": "tegenwoordig deelwoord"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b42a51d-e277-31d4-b915-67e6bdd71c57",
                    "sense_definition": "An act or state of shaking or quivering involuntarily, typically from fear, cold, or emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She noticed an uncontrollable <w>trembling</w> in his knees before the speech began.",
                            "target_lang_translations": {
                                "nl": "Ze merkte een onbeheersbaar <w>trillen</w> van zijn knieën op voordat de toespraak begon."
                            }
                        },
                        {
                            "text": "The quiet <w>trembling</w> of the ground warned them that the train was coming.",
                            "target_lang_translations": {
                                "nl": "Het lichte <w>trillen</w> van de grond waarschuwde hen dat de trein eraan kwam."
                            }
                        }
                    ],
                    "synonyms": [
                        "tremor",
                        "quiver",
                        "shiver",
                        "shaking"
                    ],
                    "antonyms": [
                        "stillness"
                    ],
                    "common_phrases": [
                        "uncontrollable trembling",
                        "nervous trembling"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het onwillekeurig beven of trillen, meestal veroorzaakt door angst, kou of sterke emotie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het beven",
                                "target_lang_sense_clarification": "zelfstandig gebruikt werkwoord"
                            },
                            {
                                "target_lang_word": "het trillen",
                                "target_lang_sense_clarification": "zelfstandig gebruikt werkwoord"
                            },
                            {
                                "target_lang_word": "trilling",
                                "target_lang_sense_clarification": "fysieke beweging van bijvoorbeeld de grond"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}