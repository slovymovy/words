                        "glosses": [
                            "En taxonomie, caractère nouveau trouvé chez un taxon et permettant de le caractériser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8695f925-bd51-469b-aee4-0e3f5888a397",
                                "sense_id": "5fe1692d-1801-3e79-8816-2d321573bfe8",
                                "text": "La présence d’un espace rétromandibulaire est une autapomorphie de l’homme de Néandertal."
                            },
                            {
                                "example_id": "c2d6fa1c-e414-4a19-a379-43e59509746d",
                                "sense_id": "5fe1692d-1801-3e79-8816-2d321573bfe8",
                                "text": "Le degré de proximité entre espèces ou taxa s’exprime à l’aide de trois concepts de base : la symplésiomorphie, la synapomorphie et l’autapomorphie."
                            }
                        ]
                    }
