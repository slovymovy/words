                    {
                        "translation_id": "8fe98eeb-4c20-451d-8d6f-7592e416e535",
                        "source_entry_id": "64df3ddf-6ce9-3c64-94a4-74064d626e47",
                        "source_sense_description": "a state of the United States of America",
                        "target_lang_word": "Minnesota",
