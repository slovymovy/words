                "senses": [
                    {
                        "sense_id": "6f9bd65a-55f1-35a2-8c29-88e97f7221e2",
                        "entry_id": "6062ab4a-7268-326b-82cb-1f57a652ef0e",
                        "glosses": [
                            "Népotisme."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "91e7a388-d3cc-3d92-adf8-82ffea8ae935",
                        "entry_id": "6062ab4a-7268-326b-82cb-1f57a652ef0e",
                        "glosses": [
                            "Favoritisme, copinage."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1d8c090a-665b-4269-88f2-d4482f30fa0f",
                                "sense_id": "91e7a388-d3cc-3d92-adf8-82ffea8ae935",
                                "text": "Luther gefiel der Nepotimus, den der Staat betrieb, nicht. — Luther n’était pas satisfait par le favoritisme que l’Etat pratiquait."
                            }
                        ]
                    }
                ],
