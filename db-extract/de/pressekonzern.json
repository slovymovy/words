                "senses": [
                    {
                        "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                        "entry_id": "a3e9ef9f-0aa5-340d-ae5d-9dfc31ac246a",
                        "glosses": [
                            "Großunternehmen der Zeitungsbranche, dass viele Zeitungen/Zeitschriften/Magazine vertreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c67070a2-6603-4417-841b-639df1628ab2",
                                "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                                "text": "„Philipp Welte, Vorstand beim Pressekonzern Burda, will juristisch gegen Kachelmann-Anwalt Johann Schwenn vorgehen.“"
                            },
                            {
                                "example_id": "63713ddb-3b26-4f34-9620-840dabd5caa6",
                                "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                                "text": "[Wojciech Korfanty:] „Er gründete einen Pressekonzern, dessen Zeitungen christlich-demokratisch ausgerichtet waren,“ […]."
                            },
                            {
                                "example_id": "f1a0e8b9-bcf7-4996-b392-51c3232dd133",
                                "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                                "text": "„Sein wesentlich älterer Vetter Rudolf Mosse, der eine Annoncen-Agentur zum Pressekonzern ausgebaut hatte, holte den 19-Jährigen zur Zeitung.“"
                            },
                            {
                                "example_id": "5fe5ac88-2ec5-4fa7-82c2-681a9115e4a9",
                                "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                                "text": "[Max Aitken:] „Im folgenden Jahr wurde er geadelt und begann, sich einen Pressekonzern zusammenzukaufen, zu dem der Evening Standard und der Daily Express gehörten.“"
                            },
                            {
                                "example_id": "b19c92d7-7454-48cc-abf0-85024eb86d83",
                                "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                                "text": "„In einem Brief an das Bundeskartellamt erklärte sich der Pressekonzern am Mittwoch bereit, sich von 30 Zeitschriften zu trennen.“"
                            },
                            {
                                "example_id": "a08193db-f0f6-493a-9e6a-50090e894046",
                                "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                                "text": "„Ab 1925 war Sontag für den Pressekonzern Alfred Hugenbergs tätig.“"
                            },
                            {
                                "example_id": "b208f115-80f5-41cc-a24d-1cf0bf31eff1",
                                "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                                "text": "„Der größte Pressekonzern in Polen ist der deutsche Bauer-Verlag mit insgesamt 52 Titeln,“ […]."
                            },
                            {
                                "example_id": "b16c6327-39c0-494c-ac24-9f7cd288f318",
                                "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                                "text": "„Die beiden Zeitungen teilen sich den mächtigen Verlag Mediaprint – mit 430 Millionen Euro Umsatz der größte Pressekonzern Österreichs.“"
                            },
                            {
                                "example_id": "4a90865d-d4cd-45fe-a753-240e02f1353a",
                                "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                                "text": "[Gerd Bucerius:] „1965 gründet er gemeinsam mit John Jahr und Richard Gruner die Gruner & Jahr GmbH & Co, den damals nach dem Axel Springer Verlag zweitgrößten Pressekonzern in Deutschland.“"
                            },
                            {
                                "example_id": "ebd3cc5e-bee7-497a-879a-b6334fe2a8a2",
                                "sense_id": "4e76d8e9-e4b3-3467-8a48-e4cb59f2a269",
                                "text": "„Bislang hatten beide Banken getrennt Interesse an dem Kauf gezeigt. Um einen Bieterwettbewerb für die Beteiligung am größten europäischen Pressekonzern zu verhindern, habe man sich nun zusammen getan, heißt es in Medienberichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
