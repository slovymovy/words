                                    {
                                        "sense_id": "cead91d9-7447-37fb-9a3e-326a57764cf4",
                                        "entry_id": "976ad805-40ab-35f4-803a-af0911e3c891",
                                        "glosses": [
                                            "urzędnik samorządowy stojący na czele gminy wiejskiej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2d6b5ba-5b50-4eff-b743-cac97967ddfc",
                                                "sense_id": "cead91d9-7447-37fb-9a3e-326a57764cf4",
                                                "text": "W wyniku referendum został odwołany - prawo demokracji. Ale paradoksalnie wójt miał przestać pracować dla gminy w czasie, gdy z powodzeniem finalizował kilka najważniejszych inwestycji."
                                            },
                                            {
                                                "example_id": "c31185be-7ae6-4fad-8523-8735f921fbc7",
                                                "sense_id": "cead91d9-7447-37fb-9a3e-326a57764cf4",
                                                "text": "Jan Kowalski jest wójtem gminy Poronin."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
