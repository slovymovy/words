                        "sense_id": "e9137be0-6063-326b-906e-b6b5432d75ee",
                        "entry_id": "8df390b9-8184-3110-abb8-b6dc28d5ae64",
                        "glosses": [
                            "льстивое угодничество, усердно проявляемое раболепие, обычно по отношению к вышестоящим"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48af00bc-d8e1-41a1-8680-8eab4fe93f2c",
                                "sense_id": "e9137be0-6063-326b-906e-b6b5432d75ee",
                                "text": "Этот слой населения смотрит вверх с опаской и подобострастием, вниз с презрением и снисходительностью."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00bf69d3-16a2-46c7-9aea-df0f71ae6423",
