                "senses": [
                    {
                        "sense_id": "6cab04a5-2cd1-336d-ba7b-161fa682801e",
                        "entry_id": "d4069d34-e8bb-3b5a-b66c-f080260dc68f",
                        "glosses": [
                            "Procrastination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c55c2f7a-53ad-46d5-934e-608542555828",
                                "sense_id": "6cab04a5-2cd1-336d-ba7b-161fa682801e",
                                "text": "Prokrastination beeinträchtigt nicht nur das psychische Wohlbefinden, sondern kann zudem zu ernsthaften beruflichen und persönlichen Konsequenzen führen.",
                                "translation": "La procrastination n'affecte pas seulement le bien-être psychologique, elle peut également avoir de graves conséquences professionnelles et personnelles."
                            },
                            {
                                "example_id": "234d5fcc-2276-4a58-acd2-a6d2f4214a07",
                                "sense_id": "6cab04a5-2cd1-336d-ba7b-161fa682801e",
                                "text": "DUH-Anwalt Klinger spricht von »systematischer Prokrastination«. Klimaschutzmaßnahmen sollen aus seiner Sicht weit in die Zukunft geschoben werden."
                            }
                        ]
                    }
                ],
