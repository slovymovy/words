                "senses": [
                    {
                        "sense_id": "45500109-c311-38b3-b51c-5f527c010700",
                        "entry_id": "982a7c0c-2838-3e17-9555-ce4eb2080424",
                        "glosses": [
                            "oburzający, straszny, okropny, skandaliczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f84eee3-1e11-4c68-a954-2d4a372a40c7",
                                "sense_id": "45500109-c311-38b3-b51c-5f527c010700",
                                "text": "W sposób wielce skandaliczny obchodzimy się ze zwierzętami. Czy to eksperymentując na nich, czy to doprowadzając do horrendalnego, patologicznego masowego chowu tucznego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47b8e42f-b426-400d-a833-687e32c7e191",
                        "source_entry_id": "982a7c0c-2838-3e17-9555-ce4eb2080424",
                        "source_sense_id": "45500109-c311-38b3-b51c-5f527c010700",
                        "target_lang_word": "horrendous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horrendous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b972f19-3d26-3628-a06b-ecbea7e24f82",
                                        "entry_id": "42db7e5c-ddde-3fb7-9fa1-6e280868e944",
                                        "glosses": [
                                            "Extremely bad; awful; terrible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a04ae7e-1464-41bb-bb7d-c74b6c002cdd",
                                                "sense_id": "3b972f19-3d26-3628-a06b-ecbea7e24f82",
                                                "text": "There was horrendous carnage at the scene of the plane crash."
                                            },
                                            {
                                                "example_id": "d53666b3-b8ca-439e-a383-9fa6ce8cc081",
                                                "sense_id": "3b972f19-3d26-3628-a06b-ecbea7e24f82",
                                                "text": "My journey to work this morning was horrendous!"
                                            },
                                            {
                                                "example_id": "1f9a416c-6c56-4f12-b1e0-1dbc197bfdc7",
                                                "sense_id": "3b972f19-3d26-3628-a06b-ecbea7e24f82",
                                                "text": "But was it responsible governance to pass the Longitude Act without other efforts to protect British seamen? Or might it have been subterfuge—a disingenuous attempt to shift attention away from the realities of their life at sea. Conditions were horrendous aboard most British naval vessels at the time. Scurvy and other diseases ran rampant, killing more seamen each year than all other causes combined, including combat."
                                            },
                                            {
                                                "example_id": "2c086b0b-5410-4a81-a59c-d27395472893",
                                                "sense_id": "3b972f19-3d26-3628-a06b-ecbea7e24f82",
                                                "text": "Maguire made an horrendous meal of the most basic piece of work to make it a treble helping of dreadful defending by England and for all the flair and fantasy of their attacking play there is no hiding away from the fact this is a serious weakness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07d54412-d067-4f9f-a3db-cbe5d4a91bfa",
                        "source_entry_id": "982a7c0c-2838-3e17-9555-ce4eb2080424",
                        "source_sense_id": "45500109-c311-38b3-b51c-5f527c010700",
                        "target_lang_word": "horrend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horrend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7cb8d80-adc7-301e-99c3-3af58508a8f1",
                                        "entry_id": "486ab0f5-cda1-3466-9f6d-250b2d2bc88e",
                                        "glosses": [
                                            "deutlich mehr als normal (beispielsweise bei Preisen, Mieten, Zinsen)"
                                        ],
                                        "tags": [
                                            "Geld"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ec8aa1-1c51-4f52-80a9-374c5517e3be",
                                                "sense_id": "b7cb8d80-adc7-301e-99c3-3af58508a8f1",
                                                "text": "In manchen Großstädten findet man horrende Preise bei Immobilien."
                                            },
                                            {
                                                "example_id": "0030b58c-bef4-4862-adb7-35946d2d9edc",
                                                "sense_id": "b7cb8d80-adc7-301e-99c3-3af58508a8f1",
                                                "text": "„Die horrenden Mieten für die fünf Häuser liefen aber weiter.“"
                                            },
                                            {
                                                "example_id": "b2899b86-f7b1-4688-a79c-9860a8c7af63",
                                                "sense_id": "b7cb8d80-adc7-301e-99c3-3af58508a8f1",
                                                "text": "So mussten […] die deutschen Häuser des Möbelhändlers Ikea über viele Jahre horrende Lizenzgebühren für die Nutzung des Firmennamens an eine Schwestergesellschaft im Ausland zahlen, die das Geld dann […] günstig versteuerte."
                                            },
                                            {
                                                "example_id": "ad097677-c64e-409c-886b-b8218520e845",
                                                "sense_id": "b7cb8d80-adc7-301e-99c3-3af58508a8f1",
                                                "text": "„Die Rechnung ist horrend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
