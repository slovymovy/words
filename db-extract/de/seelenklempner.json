                                        "sense_id": "fe3ec896-c280-3ce0-9cea-4c3f0b430e93",
                                        "entry_id": "d0ef440e-fcdc-3b4a-a27a-dd6f214051cf",
                                        "glosses": [
                                            "A psychiatrist."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0872ee53-e37a-493e-8c40-6fcc85d7afca",
                                                "sense_id": "fe3ec896-c280-3ce0-9cea-4c3f0b430e93",
                                                "text": "It was a commonplace for the medical officer to refer problem cases to the \"trick cyclist\" so that people got used to the idea that he might be able to help."
                                            },
                                            {
                                                "example_id": "aaf9fcb2-0ada-4b4c-8a96-880e2f0a9087",
                                                "sense_id": "fe3ec896-c280-3ce0-9cea-4c3f0b430e93",
                                                "text": "But what if it had the contrary effect? What if his wife turned wholly sane? What if she announced, not on any trick cyclist's couch..."
                                            },
                                            {
                                                "example_id": "2a74a93a-ac10-4d7c-9d60-d0da698159b1",
                                                "sense_id": "fe3ec896-c280-3ce0-9cea-4c3f0b430e93",
                                                "text": "\"I want to, and my trick-cyclist says it might help. Kill or cure.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
