                        "entry_id": "6e8040ec-4084-3225-958a-a01a87175222",
                        "glosses": [
                            "Like a clod, a person who is foolish, stupid or parochial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7787671-0ffd-427e-aa9d-605c03ff4dcc",
                                "sense_id": "b7a93660-490a-3343-a9d6-a15a2e0acbbc",
                                "text": "He was a cloddish man, like he'd just fallen off the turnip wagon and hadn't quite woken up yet from his long trip from the country."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ec33a5a-388e-3982-b071-93b46cfee471",
                        "entry_id": "6e8040ec-4084-3225-958a-a01a87175222",
                        "glosses": [
                            "Of or pertaining to lumpy soil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bda14f0-a12c-41a9-8783-42de5891b9db",
                                "sense_id": "1ec33a5a-388e-3982-b071-93b46cfee471",
                                "text": "Night-seeding, the tractor's floodlights\nare blood-red & ovarian -\nnurturing the cloddish soil, & always\nthe farmer working the wheel, hands\ngnarled & frostbitten & large."
                            }
                        ]
                    }
                ],
