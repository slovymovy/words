                                                "sense_id": "82ca6bb4-1dc8-37b9-b284-991536230350",
                                                "text": "one there still resident as day and night"
                                            },
                                            {
                                                "example_id": "b996f57a-c6ed-48bc-a1ea-9e12dd05d8dc",
                                                "sense_id": "82ca6bb4-1dc8-37b9-b284-991536230350",
                                                "text": "stable and resident like a rock"
                                            }
