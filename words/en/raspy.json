                    "sense_id": "ee76cb2e-f906-37e4-bd4c-26e363a444f0",
                    "sense_definition": "Unpleasantly harsh, rough, or grating in sound, especially of a voice or breath.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sore throat made his speech sound unusually <w>raspy</w> this morning.",
                            "target_lang_translations": {
                                "ru": "Из-за больного горла его речь сегодня утром звучала необычно <w>хрипло</w>."
                            }
                        },
                        {
                            "text": "She spoke in a quiet, <w>raspy</w> voice after shouting at the concert all night.",
                            "target_lang_translations": {
                                "ru": "Она говорила тихим, <w>сиплым</w> голосом после того, как весь вечер кричала на концерте."
                            }
                        }
