                                "target_senses": [
                                    {
                                        "sense_id": "dc99af36-ce23-369c-b822-b17e625efb57",
                                        "entry_id": "8e8a481d-fea5-366c-a414-fd1a4d6a0672",
                                        "glosses": [
                                            "A disappointment, a pity, a shame."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48b89efc-43f3-480b-b014-cf35c562851e",
                                                "sense_id": "dc99af36-ce23-369c-b822-b17e625efb57",
                                                "text": "That's a total bummer."
                                            },
                                            {
                                                "example_id": "5f243ad5-7920-4c37-bb55-da14a5a481fb",
                                                "sense_id": "dc99af36-ce23-369c-b822-b17e625efb57",
                                                "text": "Looks like I'm gonna be stuck here the whole summer / Well what a bummer / I can think of a lot worse places to be"
                                            },
                                            {
                                                "example_id": "24b8ed78-957b-4f98-8343-781b2262181b",
                                                "sense_id": "dc99af36-ce23-369c-b822-b17e625efb57",
                                                "text": "I came to realise that life on crutches is a bummer. It's just fair dinkum like a whole new lifestyle[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbd43b7a-aac4-33df-97f5-f52222736879",
                                        "entry_id": "8e8a481d-fea5-366c-a414-fd1a4d6a0672",
                                        "glosses": [
                                            "A psychedelic crisis; hallucinogenic drug use producing undesirable dysphoric psychological effects, most often fear, paranoia, and especially horrifying hallucinations; a bad trip."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b849ba1-3403-4be9-bb41-ed88fab7ab00",
                                                "sense_id": "fbd43b7a-aac4-33df-97f5-f52222736879",
                                                "text": "This young man never had a bummer in some 33 LSD trips. Every one of the them was a delight—everything under control. He needed only to snap his fingers, and down he came, anytime. But on Voyage 34, he finally met himself coming down an up staircase, and the encounter was crushing."
                                            }
                                        ]
                                    }
                                ]
                            },
