                "senses": [
                    {
                        "sense_id": "0e7dae83-76c2-34de-9af1-f6ad95c3f16c",
                        "entry_id": "eb98fbc3-af6e-3575-b77e-01f1b04a9888",
                        "glosses": [
                            "Qui dure dix ans ou qui revient tous les dix ans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e1ce06-8e14-4ed4-960a-916c480d37e1",
                                "sense_id": "0e7dae83-76c2-34de-9af1-f6ad95c3f16c",
                                "text": "Magistrature décennale."
                            },
                            {
                                "example_id": "dae4d325-f1f6-4694-92dd-df84bccde919",
                                "sense_id": "0e7dae83-76c2-34de-9af1-f6ad95c3f16c",
                                "text": "Garantie décennale."
                            },
                            {
                                "example_id": "c4e4bc1d-a0d0-487f-9485-19977b84b1d9",
                                "sense_id": "0e7dae83-76c2-34de-9af1-f6ad95c3f16c",
                                "text": "Il salua au passage toutes les initiatives, tous les dévouements, toutes les générosités, qui se partageaient le mérite de cette œuvre presque décennale."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7942a2c-257e-3d12-8f69-11986fbe3b40",
                        "entry_id": "eb98fbc3-af6e-3575-b77e-01f1b04a9888",
                        "glosses": [
                            "Qui se produit en moyenne tous les dix ans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22c6f965-498f-40b3-9d9a-480b0571b43c",
                                "sense_id": "b7942a2c-257e-3d12-8f69-11986fbe3b40",
                                "text": "Pauline est également chargée du « récolement décennal »."
                            },
                            {
                                "example_id": "52ba3a98-86fa-4547-a7e4-d1357d2e78b7",
                                "sense_id": "b7942a2c-257e-3d12-8f69-11986fbe3b40",
                                "text": "Dion Cassius rapporte que les jubilés décennaux et vicennaux des Empereurs avaient leur origine dans le fait qu’en janvier 27 av. J.-C., Auguste avait reçu du Sénat et du peuple son imperium légal pour dix ans ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "368b31e1-8e7b-3aec-9def-3de4589a67ed",
                        "entry_id": "eb98fbc3-af6e-3575-b77e-01f1b04a9888",
                        "glosses": [
                            "Qui a une chance sur dix de se produire chaque année."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58c5dca-ff0d-44da-ae9d-e7c5933b8814",
                                "sense_id": "368b31e1-8e7b-3aec-9def-3de4589a67ed",
                                "text": "En moyenne, les maxima avoisinent 20 à 30 m³/s. Mais les crues biennales atteignent 28 m³/s, les crues quinquennales 37 m³/s, décennales 43 m³/s et vicennales 49 m³/s."
                            }
                        ]
                    },
                    {
                        "sense_id": "120a2ee1-ccf9-33d0-9bf4-97ff428d0f6b",
                        "entry_id": "eb98fbc3-af6e-3575-b77e-01f1b04a9888",
                        "glosses": [
                            "Vieux de dix ans."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "12b6e49b-15cb-4c36-8137-0df20a2bdc89",
                                "sense_id": "120a2ee1-ccf9-33d0-9bf4-97ff428d0f6b",
                                "text": "C’était un tableau vivant au milieu de ces tableaux immobiles que ce petit vieillard, vêtu d’une méchante petite redingote, d’un gilet de soie décennal, d’un pantalon crasseux, […]."
                            }
                        ]
                    }
