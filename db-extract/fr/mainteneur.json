                    {
                        "sense_id": "2a4a8c4d-13c1-30f5-a517-8d2ca1ec1d60",
                        "entry_id": "b115c4af-bd57-3bd5-be89-229b83585173",
                        "glosses": [
                            "Individu qui maintient, qui conserve en l'état."
                        ],
                        "tags": [
                            "Maintenance"
                        ],
                        "examples": [
                            {
                                "example_id": "279d74ab-bc4f-4df7-a20c-444abef3f567",
                                "sense_id": "2a4a8c4d-13c1-30f5-a517-8d2ca1ec1d60",
                                "text": "Elle me fit découvrir la pensée d’Anatole France, orfèvre et mainteneur de la langue."
                            },
                            {
                                "example_id": "57b7faf1-bf9d-465e-88ca-a1c1aba1e480",
                                "sense_id": "2a4a8c4d-13c1-30f5-a517-8d2ca1ec1d60",
                                "text": "[…] il aimait la Camargue, les manades de taureaux, les chevaux à demi sauvages autant que lui. Quoique rivaux, tous deux appartenaient à la même race, celle des mainteneurs, beau mot remis à l’honneur par Mistral et les félibres."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c8fc655-d360-3ffb-ad6d-e5a25ca3bbf0",
                        "entry_id": "b115c4af-bd57-3bd5-be89-229b83585173",
                        "glosses": [
                            "Développeur principal d’un projet logiciel."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "115c2aec-899b-4fa4-b92e-29114b501a6a",
                                "sense_id": "1c8fc655-d360-3ffb-ad6d-e5a25ca3bbf0",
                                "text": "Jeux a connu pas mal d’évolutions importantes, notamment grâce au travail de son nouveau mainteneur Alexander Mikhaylenko."
                            }
                        ]
                    }
                ],
