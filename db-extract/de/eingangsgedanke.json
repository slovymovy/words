                "senses": [
                    {
                        "sense_id": "585e7623-f584-3f2a-b413-9af0ea1ea9a6",
                        "entry_id": "b883be37-d250-33cc-a16f-3f6ef1684e18",
                        "glosses": [
                            "Überlegung/Gedanke, die/den man sich am Anfang gemacht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa4ef308-7ffc-42b6-a0b5-e547951537c3",
                                "sense_id": "585e7623-f584-3f2a-b413-9af0ea1ea9a6",
                                "text": "„Sie fand keine Antwort und kehrte zu ihrem Eingangsgedanken zurück: War es entsetzlich oder ein Geschenk?“"
                            },
                            {
                                "example_id": "6b993005-7ca1-4108-bfed-504c28354138",
                                "sense_id": "585e7623-f584-3f2a-b413-9af0ea1ea9a6",
                                "text": "„Aber wenn wir noch einmal auf den Eingangsgedanken des Buchs eingehen, erinnern wir uns daran, dass die längste Beziehung unseres Leben, die mit uns selbst ist.“"
                            },
                            {
                                "example_id": "a27efede-5be7-4b77-8934-57917a48598a",
                                "sense_id": "585e7623-f584-3f2a-b413-9af0ea1ea9a6",
                                "text": "„Ohne das Christusgeschehen gäbe es weder diesen Glauben, noch eine Zukunft des Glaubens und Lebens bei Gott – so schon der Eingangsgedanke zum Kapitel.“"
                            },
                            {
                                "example_id": "968cb894-22d0-4729-a171-d25d7cc5f44d",
                                "sense_id": "585e7623-f584-3f2a-b413-9af0ea1ea9a6",
                                "text": "„Das Intermezzo spielt mit Gegensätzen im reizvollen Nebeneinander der Kräfte: Nachdenklich und dabei triolisch bewegt umrahmt es ein Fugato, welches in den variierten Eingangsgedanken führt.“"
                            },
                            {
                                "example_id": "34c6eb1a-a1f4-440a-a0f1-3ecde7791f46",
                                "sense_id": "585e7623-f584-3f2a-b413-9af0ea1ea9a6",
                                "text": "„Unsere Eingangsgedanken waren, dass Menschen empfindlich, widersprüchlich und mit erstaunlichen Fähigkeiten ausgestattet sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
