                        "glosses": [
                            "Faire perdre son caractère cabotin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a7a6711-adba-4a33-b194-bef5e451b2cb",
                                "sense_id": "ca0571ca-84e3-3286-8b1c-58e0cfb510aa",
                                "text": "Il s’agit essentiellement de « décabotiniser la scène », c’est-à-dire de réagir contre la vanité et l’éclat du théâtre du Boulevard afin de réhabiliter le texte"
                            },
                            {
                                "example_id": "28a7a0b2-ac31-4366-b56f-e38f64b578a9",
                                "sense_id": "ca0571ca-84e3-3286-8b1c-58e0cfb510aa",
                                "text": "Parmi tant de réformes urgentes qui le sollicitaient, Stanislavski s’efforça d’abord de rééduquer l’acteur, de le décabotiniser."
                            }
                        ]
                    }
