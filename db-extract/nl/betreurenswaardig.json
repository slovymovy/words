                                    {
                                        "sense_id": "5202bc22-a048-3659-8174-afc7368ff6a5",
                                        "entry_id": "cc7d0b17-5324-336e-94f7-2e824cca55b2",
                                        "glosses": [
                                            "zu bedauern; in einer Weise, dass man wünscht, es wäre nicht so"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28aee4ee-c8ad-40c3-a5a6-dcbc5c03b2ad",
                                                "sense_id": "5202bc22-a048-3659-8174-afc7368ff6a5",
                                                "text": "Dass ich den Termin absagen muss, ist wirklich bedauerlich."
                                            },
                                            {
                                                "example_id": "a70a6a10-32eb-4148-9bfc-da0eed25722f",
                                                "sense_id": "5202bc22-a048-3659-8174-afc7368ff6a5",
                                                "text": "Vernachlässigte Kinder, um die sich keiner kümmert, sind bedauerliche Einzelfälle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edbe0500-f306-47b9-b2f4-af029acc4560",
                        "source_entry_id": "e58e9461-aee9-338c-b7a3-0615c34bd959",
                        "source_sense_id": "25a2a137-144f-35a9-90ac-73a935e2616f",
                        "source_sense_description": "waard betreurd te worden",
                        "target_lang_word": "regrettable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regrettable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a019447b-6739-398a-a840-63c8bd399157",
                                        "entry_id": "c56c8049-700c-39d1-a5cd-700e509ccb09",
                                        "glosses": [
                                            "Able to be regretted, especially deserving of regret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bec1e13-3ba2-46d8-addc-e52b8da4c2f7",
                                                "sense_id": "a019447b-6739-398a-a840-63c8bd399157",
                                                "text": "The officers' actions were regrettable, yes, but there's nothing to be done now but to relocate everyone to the mainland in a calm and orderly manner."
                                            },
                                            {
                                                "example_id": "355d35a5-c69f-4283-bb39-3b08efaf8e3a",
                                                "sense_id": "a019447b-6739-398a-a840-63c8bd399157",
                                                "text": "Jeeves: Foreign travel often liberates emotions best kept in check, sir. The air of North America is notoriously stimulating in this regard, as witness the regrettable behavior of its inhabitants in 1776.\nB. Wooster: Hm? What happened in 1776, Jeeves?\nJeeves: I prefer not to dwell on it, if it's convenient to you, sir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fae7bb18-9303-40f1-96f7-4afaaa267a62",
                        "source_entry_id": "e58e9461-aee9-338c-b7a3-0615c34bd959",
                        "source_sense_id": "25a2a137-144f-35a9-90ac-73a935e2616f",
                        "source_sense_description": "waard betreurd te worden",
                        "target_lang_word": "lamentable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamentable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d11d9cc-1b6a-34eb-ad0d-12c8ec3ebcac",
                                        "entry_id": "911dc8fa-e0bb-3f3b-b44e-54746f980dcb",
                                        "glosses": [
                                            "Causing sorrow, distress or regret; deplorable, pitiful or distressing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54df02c3-bc85-4e8d-bd4d-2a07e2da49a3",
                                                "sense_id": "6d11d9cc-1b6a-34eb-ad0d-12c8ec3ebcac",
                                                "text": "In what a lamentable caſe were I,\nIf Nature had not giuen me wiſedomes lore?"
                                            },
                                            {
                                                "example_id": "4a48addc-52f3-4fc8-b025-16819ea3ca3b",
                                                "sense_id": "6d11d9cc-1b6a-34eb-ad0d-12c8ec3ebcac",
                                                "text": "Moreover, in view of the lamentable present indecision of the Government in regard to electrification, the large-scale building of diesel power may prove to have been a farseeing move after all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
