                "senses": [
                    {
                        "sense_id": "b6e74dd9-150b-3c30-8499-1253526e93d9",
                        "entry_id": "b85636f2-d17f-3241-b9b9-ccaba97ba85b",
                        "glosses": [
                            "Qui se rapporte aux voiles d'un navire, à sa voilure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95feb00c-1e0d-41e6-95d6-48b432ba602a",
                                "sense_id": "b6e74dd9-150b-3c30-8499-1253526e93d9",
                                "text": "Les voiliers se déplacent grâce à leur propulsion vélique"
                            },
                            {
                                "example_id": "081b624e-3e00-4cdf-87fa-56b55cab86d1",
                                "sense_id": "b6e74dd9-150b-3c30-8499-1253526e93d9",
                                "text": "Compétition vélique, course de bateaux à voile"
                            },
                            {
                                "example_id": "65bd4c1b-7859-42a1-af83-06d6432d7cdb",
                                "sense_id": "b6e74dd9-150b-3c30-8499-1253526e93d9",
                                "text": "Robinson avait opté pour un seul mât qui porterait une voile triangulaire latine permettant d'établir une grande surface vélique, facilement manœuvrable toutefois pour un unique homme d'équipage"
                            },
                            {
                                "example_id": "8d8a54b9-f6ad-4afa-828e-cfb9043da787",
                                "sense_id": "b6e74dd9-150b-3c30-8499-1253526e93d9",
                                "text": "De son côté, International Maritime Organization (OMI) s’attend, avec la propulsion vélique, à des économies de l’ordre de 2 à 3 %."
                            }
                        ]
                    },
                    {
                        "sense_id": "11e77b4f-7c2b-35cc-8009-fff50d01a8f8",
                        "entry_id": "b85636f2-d17f-3241-b9b9-ccaba97ba85b",
                        "glosses": [
                            "Poussée vélique, force; effort du vent sur la voile."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "708f6f47-50f3-39c7-8f58-81b1cd251bfb",
                        "entry_id": "b85636f2-d17f-3241-b9b9-ccaba97ba85b",
                        "glosses": [
                            "Point vélique, lieu d'application de l'effort du vent sur la voile."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d7371f49-f827-4b27-a79c-27f5c5285e93",
                                "sense_id": "708f6f47-50f3-39c7-8f58-81b1cd251bfb",
                                "text": "Pour avancer, il fallait fixer un point en soi-même. Le reste s’annulait. Ce point était un mot, l’évocation d’un visage, d’un lieu ou d’une forme. L’esprit s’appuyait contre ce souvenir pour y faire levier et entraîner le corps vers l’avant, comme un voilier dont les forces de poussée convergent en un endroit du mât appelé « point vélique »."
                            },
                            {
                                "example_id": "c9b21444-d74c-4929-ad11-774152fc9f98",
                                "sense_id": "708f6f47-50f3-39c7-8f58-81b1cd251bfb",
                                "text": "\" On appelle POINT VÉLIQUE cette croisée des poussées.Seul le point est animé.Il meut la masse . Est féerique le moment où la perfection des choses autorise à ne plus faire un geste. À quand la vie vélique ?"
                            }
                        ]
                    }
