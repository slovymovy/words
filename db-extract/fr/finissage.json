                    {
                        "sense_id": "844d5dbb-d1a4-3380-8651-cee663d4b529",
                        "entry_id": "34c0654f-1788-3ef4-9649-825be9f19889",
                        "glosses": [
                            "Action de finir, résultat de cette action, achèvement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7bf7f50-6034-40d3-99d9-65dc5b32936b",
                                "sense_id": "844d5dbb-d1a4-3380-8651-cee663d4b529",
                                "text": "La parure n’attendait même pas le finissage du gros oeuvre."
                            },
                            {
                                "example_id": "4f4b6036-2f30-417b-ae34-801f12fc93ba",
                                "sense_id": "844d5dbb-d1a4-3380-8651-cee663d4b529",
                                "text": "À Kintambo magasin, dans le triangle entre les avenues Mondjiba, Nguma et du tourisme, deux fontaines à jet d’eau sont déjà à l’étape de finissage."
                            }
                        ]
                    },
                    {
                        "sense_id": "34b5a580-2b74-36b9-9f07-e85ecedbc03c",
                        "entry_id": "34c0654f-1788-3ef4-9649-825be9f19889",
                        "glosses": [
                            "Dernières opérations subies par le cuir : le ponçage destiné à masquer les défauts de certaines peaux (on obtient alors de la fleur corrigée), le palissonnage, le glaçage, etc."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "95a48ce5-2aeb-430d-b507-5743f38b7994",
                                "sense_id": "34b5a580-2b74-36b9-9f07-e85ecedbc03c",
                                "text": "C'est maintenant un lieu commun d'affirmer qu'un banc de finissage quelle que soit sa couleur doit posséder avant tout une très bonne aspiration au fraisage, au verrage, au ponçage, voire même dans certains cas à la déforme."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a3ccbe8-c67b-38ce-a7de-1b124b28470b",
                        "entry_id": "34c0654f-1788-3ef4-9649-825be9f19889",
                        "glosses": [
                            "Dans le domaine culturel, cérémonie de clôture d’une exposition."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "0e2542cc-d233-4732-8be7-98b487c16185",
                                "sense_id": "2a3ccbe8-c67b-38ce-a7de-1b124b28470b",
                                "text": "Action Culture vous propose de venir assister au finissage de la résidence de l’artiste tchèque Veronika Richterova. Ce sera l’occasion de profiter une dernière fois de cette exposition et d’apprécier « Reflux », la performance musicale d’Alexandre M."
                            }
                        ]
                    }
                ],
