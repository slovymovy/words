                                "target_senses": [
                                    {
                                        "sense_id": "24e15482-e6df-332e-be05-3686a8e5b689",
                                        "entry_id": "82aca731-83ee-39ed-b132-47923cea80e3",
                                        "glosses": [
                                            "A boy or younger man in a homoerotic relationship with an older man."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e6fdb7a-57f7-445c-8b57-cd51d1476576",
                                                "sense_id": "24e15482-e6df-332e-be05-3686a8e5b689",
                                                "text": "It was the afternoon of my eighty-first birthday, and I was in bed with my catamite when Ali announced that the archbishop had come to see me."
                                            },
                                            {
                                                "example_id": "b4c75a2c-b6ed-495a-8506-505e54a6cdfc",
                                                "sense_id": "24e15482-e6df-332e-be05-3686a8e5b689",
                                                "text": "And what about your brother? – Is he to be a catamite?"
                                            }
                                        ]
                                    }
                                ]
                            },
