    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                    "sense_definition": "Qui persévère de manière inébranlable dans une opinion, une résolution ou une attitude, souvent en dépit des conseils ou des difficultés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré toutes les explications rationnelles, il garde un silence <w>obstiné</w> et refuse de coopérer."
                        },
                        {
                            "text": "Son caractère <w>obstiné</w> lui a permis de surmonter tous les obstacles rencontrés durant ses études."
                        }
                    ],
                    "synonyms": [
                        "entêté",
                        "opiniâtre",
                        "acharné",
                        "têtu"
                    ],
                    "antonyms": [
                        "docile",
                        "malléable",
                        "souple",
                        "complaisant"
                    ],
                    "common_phrases": [
                        "silence obstiné",
                        "refus obstiné",
                        "lutte obstinée"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8dc4b2f-a22a-34dc-854a-5344b28c9915",
                    "sense_definition": "Participe passé masculin singulier du verbe <w>obstiner</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est <w>obstiné</w> à vouloir réparer cette vieille voiture au lieu d'en acheter une neuve."
                        },
                        {
                            "text": "Bien que tout le monde lui conseille de renoncer, le candidat s'est <w>obstiné</w> dans sa démarche."
                        }
                    ],
                    "common_phrases": [
                        "s'être obstiné"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d3005dd-b216-3297-a276-22e57533755c",
                    "sense_definition": "Personne qui s'obstine, qui s'entête dans ses idées ou ses décisions sans vouloir céder.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>obstiné</w> refuse d'admettre son erreur malgré les preuves évidentes qu'on lui présente."
                        },
                        {
                            "text": "Il ne sert à rien de discuter avec cet <w>obstiné</w>, car il ne changera jamais d'avis."
                        }
                    ],
                    "synonyms": [
                        "entêté"
                    ]
                }
            ]
        }
    ]
