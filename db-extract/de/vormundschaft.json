                ],
                "senses": [
                    {
                        "sense_id": "bd0ef5b0-2355-3f4d-a1e6-d57ca6509225",
                        "entry_id": "c67eeccc-9823-3039-8d9e-f1a4271a3f6e",
                        "glosses": [
                            "durch ein Gericht angeordnete Fürsorge für eine Person, die nicht geschäftsfähig ist, und deren Vermögen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "198f7f02-0a33-455e-8b61-06aab8fdbdab",
                                "sense_id": "bd0ef5b0-2355-3f4d-a1e6-d57ca6509225",
                                "text": "Volljährige können in Deutschland seit 1992 nicht mehr entmündigt und unter Vormundschaft gestellt werden."
                            },
                            {
                                "example_id": "1ac5295b-737e-417d-b3a4-fc79bf2af028",
                                "sense_id": "bd0ef5b0-2355-3f4d-a1e6-d57ca6509225",
                                "text": "„Er müsste allein in ein Heim, es sei denn, einer der anwesenden Syrer würde die Vormundschaft für ihn übernehmen, schlug der Beamte als Lösung vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59eb1a21-f1ad-4281-9c75-7040d28b352a",
                        "source_entry_id": "c67eeccc-9823-3039-8d9e-f1a4271a3f6e",
                        "source_sense_id": "bd0ef5b0-2355-3f4d-a1e6-d57ca6509225",
                        "target_lang_word": "guardianship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guardianship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe89472c-b3e2-3e47-9b40-46cad4c5ad7a",
                                        "entry_id": "8cc67746-a6af-3d4e-ac4c-dd80c92a09d3",
                                        "glosses": [
                                            "The office or position of one acting as a guardian or conservator, especially in a legal capacity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b03c81-b6ad-4937-9f23-a346a4fefe72",
                                                "sense_id": "fe89472c-b3e2-3e47-9b40-46cad4c5ad7a",
                                                "text": "Forbidden to you are your mothers and your daughters and your sisters and your paternal aunts and your maternal aunts and brothers' daughters and sisters' daughters and your mothers that have suckled you and your foster-sisters and mothers of your wives and your step-daughters who are in your guardianship, (born) of your wives to whom you have gone in, but if you have not gone in to them, there is no blame on you (in marrying them), and the wives of your sons who are of your own loins and that you should have two sisters together, except what has already passed; surely Allah is Forgiving, Merciful."
                                            },
                                            {
                                                "example_id": "84f10915-a734-406c-a3be-908a3789d9dc",
                                                "sense_id": "fe89472c-b3e2-3e47-9b40-46cad4c5ad7a",
                                                "text": "An application for guardianship must be founded on two medical recommendations, the procedure being similar to an application for admission for treatment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78692277-4f35-45c0-afee-e356dd426f89",
                        "source_entry_id": "c67eeccc-9823-3039-8d9e-f1a4271a3f6e",
                        "source_sense_id": "bd0ef5b0-2355-3f4d-a1e6-d57ca6509225",
                        "target_lang_word": "wardship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wardship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31bd3c64-107f-3c7d-96d5-410e54a4916a",
                                        "entry_id": "b68c5f3d-384b-37aa-bb3c-94d32899f8dc",
                                        "glosses": [
                                            "The state of being a ward of someone."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ee045f-d85a-4757-85bc-930a1d3c4c41",
                                                "sense_id": "31bd3c64-107f-3c7d-96d5-410e54a4916a",
                                                "text": "The majority said temporary wardship, which allowed the girl to receive a transfusion, was justified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "577b5655-ae91-3bf5-beef-c49db017126f",
                                        "entry_id": "b68c5f3d-384b-37aa-bb3c-94d32899f8dc",
                                        "glosses": [
                                            "In English feudal law, the guardianship which the lord had of the land of his vassal while the latter was an infant or minor."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35f3c00c-4fe0-4d9e-a03f-740d92a8233a",
                                                "sense_id": "577b5655-ae91-3bf5-beef-c49db017126f",
                                                "text": "And they may sell the wardship of the lands, and the maritages of the heirs, if they are not married, but they cannot alienate any part of the inheritance or they may offend as regards a remaindership."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f0d7c68-4dfd-4688-87d0-70cde72d4212",
                        "source_entry_id": "c67eeccc-9823-3039-8d9e-f1a4271a3f6e",
                        "source_sense_id": "bd0ef5b0-2355-3f4d-a1e6-d57ca6509225",
                        "target_lang_word": "tutelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tutelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c86a79a-e05c-3203-b2cf-b93742f3e9d6",
                                        "entry_id": "72ef88b4-6e20-351a-bc00-f89f0f153b82",
                                        "glosses": [
                                            "Autorité donnée conformément à la loi, pour avoir soin de la personne et des biens d’un mineur ou d’un majeur protégé (autrefois, d’un interdit)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "345dfbba-61e1-4851-85ad-24c0193de9d2",
                                                "sense_id": "3c86a79a-e05c-3203-b2cf-b93742f3e9d6",
                                                "text": "Le Capitaine, […], s’était fâché rouge lorsque son fils avait réclamé ses comptes de tutelle, et même lui avait coupé les vivres, tout net."
                                            },
                                            {
                                                "example_id": "e911a61c-5265-4b5f-8326-fedc6d130ba4",
                                                "sense_id": "3c86a79a-e05c-3203-b2cf-b93742f3e9d6",
                                                "text": "Lorsqu’il ouvre ou renouvelle une mesure de tutelle, le juge statue sur le maintien ou la suppression du droit de vote de la personne protégée."
                                            },
                                            {
                                                "example_id": "d02353b3-4e59-437f-a4c1-cdefafa60df5",
                                                "sense_id": "3c86a79a-e05c-3203-b2cf-b93742f3e9d6",
                                                "text": "Son histoire a inspiré trois documentaires et suscité une réflexion sur le régime américain de mise en tutelle, qui a son équivalent au Canada."
                                            },
                                            {
                                                "example_id": "74cb6ade-b3f6-4dd5-90b4-48476e8bae81",
                                                "sense_id": "3c86a79a-e05c-3203-b2cf-b93742f3e9d6",
                                                "text": "Être en tutelle ou Être tenu en tutelle, être gêné et contraint par quelque personne qui a pris une grande autorité sur soi, en sorte de ne pouvoir faire librement ce que l'on veut."
                                            },
                                            {
                                                "example_id": "91e2f38e-354b-40d4-a77b-87bca52aa586",
                                                "sense_id": "3c86a79a-e05c-3203-b2cf-b93742f3e9d6",
                                                "text": "La province est une autre France en tutelle de Paris, qui la civilise et l’émancipe de loin par ses commis voyageurs, ses garnisons mobiles, sa colonie de fonctionnaires, ses journaux, et un peu par ses livres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c48ed9f-a149-3ee2-8c5a-da7c54df4a74",
                                        "entry_id": "72ef88b4-6e20-351a-bc00-f89f0f153b82",
                                        "glosses": [
                                            "Tutelle administrative : forme de contrôle exercé par une personne morale de droit public sur une autre personne morale publique ou sur certains organismes privés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04ce0ca5-7d02-4968-860e-2f3932fda765",
                                                "sense_id": "1c48ed9f-a149-3ee2-8c5a-da7c54df4a74",
                                                "text": "L’Agence de l’environnement et de la maîtrise de l’énergie, ci-après dénommée « l’agence », est placée sous la tutelle des ministres chargés de l’environnement, de l’énergie et de la recherche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdcd8617-6570-3be1-bfbc-270c86002d69",
                                        "entry_id": "72ef88b4-6e20-351a-bc00-f89f0f153b82",
                                        "glosses": [
                                            "Lien de dépendance entre un ministère et des secrétariats d’État, les moyens du second provenant du premier, qui a autorité sur le second."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c8c1108-54a8-4b21-837d-c6a47a8dfec3",
                                                "sense_id": "bdcd8617-6570-3be1-bfbc-270c86002d69",
                                                "text": "Votre secrétariat d’État était attaché au premier ministre, il revient sous la tutelle de Bercy, qu’est-ce que cela signifie ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7d4686a-58c8-34d2-8954-db829c55e2af",
                                        "entry_id": "72ef88b4-6e20-351a-bc00-f89f0f153b82",
                                        "glosses": [
                                            "Relation entre un domaine d’activité et l’administration qui la régule ou la soutient."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc115fde-10d5-48e6-9d40-d2e470b5477c",
                                                "sense_id": "f7d4686a-58c8-34d2-8954-db829c55e2af",
                                                "text": "Les syndicats agricoles ont rencontré leur ministre de tutelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9e09982-d26f-3622-8cd6-81e23ca4bb13",
                                        "entry_id": "72ef88b4-6e20-351a-bc00-f89f0f153b82",
                                        "glosses": [
                                            "Protection."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95a30a33-ed5f-44cc-9679-dfa312bc9fd5",
                                                "sense_id": "a9e09982-d26f-3622-8cd6-81e23ca4bb13",
                                                "text": "Les citoyens sont sous la tutelle des lois."
                                            },
                                            {
                                                "example_id": "dd45e782-5548-442b-87ab-07be06fd9c36",
                                                "sense_id": "a9e09982-d26f-3622-8cd6-81e23ca4bb13",
                                                "text": "Je me mets sous votre tutelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d9135f4-0902-37e5-b262-7d76c88a17fd",
                                        "entry_id": "72ef88b4-6e20-351a-bc00-f89f0f153b82",
                                        "glosses": [
                                            "Administration d'un territoire ou d'un peuple ; protectorat ; colonisation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95559d4f-f692-40a2-b57d-74c28848e610",
                                                "sense_id": "8d9135f4-0902-37e5-b262-7d76c88a17fd",
                                                "text": "L’Islande a son parti de Home Rulers qui veulent affranchir leur pays de la tutelle du Danemark et rétablir l’ancienne république islandaise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "495f94da-044b-443f-854e-cfad4d3fe0d1",
                        "source_entry_id": "c67eeccc-9823-3039-8d9e-f1a4271a3f6e",
                        "source_sense_id": "bd0ef5b0-2355-3f4d-a1e6-d57ca6509225",
