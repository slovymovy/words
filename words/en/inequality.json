    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a7a0a29-c82f-3351-92d4-0db192bd4b23",
                    "sense_definition": "The state of being unfair or not equal, especially in status, rights, and opportunities.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "social_disparity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is trying to reduce social <w>inequality</w> by improving access to education.",
                            "target_lang_translations": {
                                "ru": "Правительство пытается сократить социальное <w>неравенство</w>, улучшая доступ к образованию."
                            }
                        },
                        {
                            "text": "Economic <w>inequality</w> has grown significantly over the last decade in many developed countries.",
                            "target_lang_translations": {
                                "ru": "Экономическое <w>неравенство</w> значительно выросло за последнее десятилетие во многих развитых странах."
                            }
                        }
                    ],
                    "synonyms": [
                        "disparity",
                        "imparity"
                    ],
                    "antonyms": [
                        "equality"
                    ],
                    "common_phrases": [
                        "social inequality",
                        "economic inequality",
                        "income inequality",
                        "gender inequality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние несправедливости или отсутствия равенства, особенно в статусе, правах и возможностях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неравенство",
                                "target_lang_sense_clarification": "социальное или экономическое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4a44590-1945-30ec-9132-97c7758ba9f0",
                    "sense_definition": "A mathematical statement that one quantity is less than or greater than another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked the students to solve the linear <w>inequality</w> on the blackboard.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил учеников решить линейное <w>неравенство</w> на доске."
                            }
                        },
                        {
                            "text": "In this math problem, the <w>inequality</w> symbol shows that x is greater than y.",
                            "target_lang_translations": {
                                "ru": "В этой математической задаче символ <w>неравенства</w> показывает, что x больше y."
                            }
                        }
                    ],
                    "synonyms": [
                        "inequation"
                    ],
                    "common_phrases": [
                        "linear inequality",
                        "solve the inequality",
                        "inequality symbol"
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическое утверждение о том, что одна величина меньше или больше другой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неравенство",
                                "target_lang_sense_clarification": "математическое выражение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3e12a55-fbd0-350b-8715-06266c10e123",
                    "sense_definition": "The quality of being uneven or irregular in surface or form.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_irregularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener worked hard to smooth out every <w>inequality</w> in the lawn.",
                            "target_lang_translations": {
                                "ru": "Садовник усердно работал, чтобы разгладить каждую <w>неровность</w> на газоне."
                            }
                        },
                        {
                            "text": "The physical <w>inequality</w> of the terrain made it difficult for the hikers to maintain a steady pace.",
                            "target_lang_translations": {
                                "ru": "Физическая <w>неровность</w> рельефа мешала туристам поддерживать постоянный темп."
                            }
                        }
                    ],
                    "synonyms": [
                        "unevenness",
                        "difference"
                    ],
                    "common_phrases": [
                        "physical inequality",
                        "surface inequality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество неровности или неправильности поверхности или формы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неровность",
                                "target_lang_sense_clarification": "поверхности или ландшафта"
                            },
                            {
                                "target_lang_word": "шероховатость",
                                "target_lang_sense_clarification": "текстуры"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}