                "senses": [
                    {
                        "sense_id": "a402d931-0279-3d17-bdbb-a8863a3d84ae",
                        "entry_id": "ae6da110-a643-37b8-882b-c7a70de8c97e",
                        "glosses": [
                            "eine Frau, die öffentliche Toiletten nach ihrem Gebrauch sofort wieder reinigt und in Ordnung bringt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "638f9ca4-963e-474b-9b02-8ab4f70d0a74",
                                "sense_id": "a402d931-0279-3d17-bdbb-a8863a3d84ae",
                                "text": "Einer guten Klofrau sollten wir alle dankbar sein! Und unsere 30 Cent entrichten, anstatt sich so rauszuschleichen."
                            },
                            {
                                "example_id": "a97b4153-9351-4518-b122-194e667e7d54",
                                "sense_id": "a402d931-0279-3d17-bdbb-a8863a3d84ae",
                                "text": "„Außer der Klofrau befand sich dort definitiv keiner auch nur in der Nähe meines Alters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
