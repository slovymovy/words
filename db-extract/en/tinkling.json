                        "entry_id": "5d4a4c18-5aec-3631-95b1-f04cd2262b23",
                        "glosses": [
                            "A tinkle; a tinkling sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e15daed-69df-454d-8e28-a2f0dcd5624e",
                                "sense_id": "7d46a38d-ee2e-374b-aecc-51eff6af5379",
                                "text": "The merry piano tinklings were gone."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7659820-5bf3-3b2a-9bbe-93c630f29bae",
                        "entry_id": "5d4a4c18-5aec-3631-95b1-f04cd2262b23",
                        "glosses": [
                            "The Greater Antillean Grackle, Quiscalus niger."
                        ],
