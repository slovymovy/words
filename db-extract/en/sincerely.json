                                    {
                                        "sense_id": "b9c711a2-24e0-3802-8dd4-50142d4231b7",
                                        "entry_id": "8a352663-c9b2-3540-88f4-4a9d115eb9eb",
                                        "glosses": [
                                            "de waarheid sprekend"
