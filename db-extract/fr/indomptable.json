                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "de5a3bc7-0906-365a-af40-888cfbe14957",
                                        "entry_id": "95a66ffa-64af-30ca-a426-c016465aea44",
                                        "glosses": [
                                            "que não pode ser domado"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b0947b-74fd-4974-b2da-296a6a2c36bf",
                                                "sense_id": "de5a3bc7-0906-365a-af40-888cfbe14957",
                                                "text": "Ao ver esse homem sorrindo à tempestade e afrontando com o olhar a luz do relâmpago, conhecia-se que sua alma tinha a força de resolução e a vontade indomável capaz de querer o impossível, e de lutar contra o céu e a terra para obtê-lo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
