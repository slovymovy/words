                "senses": [
                    {
                        "sense_id": "c6c4fae2-2a83-3e77-b4f0-78088ef36b4f",
                        "entry_id": "f039b843-00c4-3a11-94d4-da00c7a2111d",
                        "glosses": [
                            "mechanische oder elektromechanische Maschine zum Ver- und Entschlüsseln von Text"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db5a096-86f7-4910-9507-9fe81e7b6b40",
                                "sense_id": "c6c4fae2-2a83-3e77-b4f0-78088ef36b4f",
                                "text": "„Eine 1941 gebaute Enigma-Chiffriermaschine der deutschen Wehrmacht ist im Bukarester Auktionshaus Artmark für 45.000 Euro an einen nicht genannten Online-Kunden verkauft worden.“"
                            },
                            {
                                "example_id": "a206402c-d6a9-4d26-baac-19659cdb9097",
                                "sense_id": "c6c4fae2-2a83-3e77-b4f0-78088ef36b4f",
                                "text": "„Dabei gelang es, die als sicher geltende deutsche Chiffriermaschine Enigma und zahlreiche weitere Codes zu brechen.“"
                            },
                            {
                                "example_id": "e40ac626-39c6-443a-b20e-2d018ae99898",
                                "sense_id": "c6c4fae2-2a83-3e77-b4f0-78088ef36b4f",
                                "text": "„Sie stahlen die Codebücher der Chiffriermaschine Enigma und öffneten die Briefpost der eidgenössischen Diplomaten: Lange bevor die NSA zu ihrem Angriff auf die Telefon- und Datennetze der Welt ansetzte, hatten die Agenten des FBI die diplomatischen Depeschen der Schweiz systematisch abgefangen und entschlüsselt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
