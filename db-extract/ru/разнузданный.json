                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1d26d81-12a8-4bac-88c5-c51ef899d49c",
                                "sense_id": "fca6ff82-eb62-3bec-a960-a96c6cf2de16",
                                "text": "Их разну́зданное поведе́ние раздража́ло нас.",
                                "translation": "Their licentious behavior annoyed us.",
                                "english": "Their licentious behavior annoyed us."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b4dce94-68f5-38e0-b236-05d6c6ec861e",
                        "entry_id": "849b06d6-e854-3ef3-b7b3-137e4144981f",
                        "glosses": [
                            "orgiastic (relating to an orgy)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be5722d5-3303-44c0-9bd2-6a6e89a551da",
                                "sense_id": "3b4dce94-68f5-38e0-b236-05d6c6ec861e",
                                "text": "Сексуа́льная разну́зданность ча́сто приво́дит к нежела́тельным после́дствиям.",
                                "translation": "Sexually unrestrained behavior often causes undesired consequences.",
                                "english": "Sexually unrestrained behavior often causes undesired consequences."
                            }
                        ]
                    }
