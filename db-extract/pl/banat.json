                        "cross_references": [
                            {
                                "target_word": "Banát",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0545f5a2-031a-3fa1-b937-5a9badd3db0f",
                                        "entry_id": "e95275e2-4397-3c6c-9a2f-a5e468ce423b",
                                        "glosses": [
                                            "oblast v jihovýchodní Evropě na území dnešního Rumunska, Srbska a Maďarska"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5e02d2e-73e0-4a6a-a8f9-9da1bfda0c14",
                                                "sense_id": "0545f5a2-031a-3fa1-b937-5a9badd3db0f",
                                                "text": "Banát měl v rámci habsburského státu zvláštní postavení s vojenskou správou a byl součástí tzv. Vojenské hranice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a85aeb5-4828-4f45-8d1a-6c2af2041993",
                        "source_entry_id": "8b6391eb-9b0a-3128-ac7a-f10b2c3c0413",
                        "source_sense_id": "8bf20b79-824d-3d97-b7f7-7d36cdd8749d",
                        "target_lang_word": "Banat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Banat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5b15626-1c81-3478-bb12-4c76eb2e30d5",
                                        "entry_id": "db606166-4f97-3cc9-8924-1c810520994e",
                                        "glosses": [
                                            "historische Landschaft im südlichen Teil der großen Pannonischen Tiefebene, die Rumänien und Serbien gehört."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffb4edf4-e164-4d03-aaa7-224ffc25f84d",
                                                "sense_id": "b5b15626-1c81-3478-bb12-4c76eb2e30d5",
                                                "text": "„Die deutsche Bevölkerung dieser Landstriche wurde ausgetrieben. Das gleiche geschah mit der Bevölkerung des Sudetenlandes, Siebenbürgens, des Banat und wo immer Deutsche im Laufe der Jahrhunderte gesiedelt hatten.“"
                                            },
                                            {
                                                "example_id": "21352484-a77f-43c2-ad4a-287b23c45cc1",
                                                "sense_id": "b5b15626-1c81-3478-bb12-4c76eb2e30d5",
                                                "text": "„Die geographische Gestaltung des Landes, die Produktions- und Verkehrsverhältnisse seiner Bevölkerung haben eine solche Wechselseitigkeit und Verschmelzung der Interessen aller einzelnen Theile des Banates unter einander herbeigeführt, daß ihre tiefgreifende Trennung als eine naturwidrige Hemmung des ganzen Kreislaufes ihres öffentlichen Lebens betrachtet werden müßte.“"
                                            },
                                            {
                                                "example_id": "d008fe37-d00a-481f-bf29-3016117a6a3a",
                                                "sense_id": "b5b15626-1c81-3478-bb12-4c76eb2e30d5",
                                                "text": "„Der Übergang des östlichen Banats an Rumänien verlief nicht reibungslos. Bald nach dem Krieg hatten serbische Truppen große Teile des Banats besetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
