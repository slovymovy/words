                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85cbb83b-80c8-4708-8bb4-03f2bba45bf3",
                                "sense_id": "4b45cceb-9f58-3e7d-9c96-4a178c545a29",
                                "text": "⧖ Thans plaatsen zij zich ieder op gelijken afstand ter weerszijden van den boom; elk houdt een eind van het net ter hoogte van den schouder vast en het tiras achter zich slepend gaat het nu recht op den grenssteen aan dwars door de weide."
                            }
                        ]
                    },
