                ],
                "senses": [
                    {
                        "sense_id": "9bf56151-15d7-302f-985d-24ac67ea8274",
                        "entry_id": "4a55f100-4849-3bd0-9d43-8952f9e21c44",
                        "glosses": [
                            "weibliche Person, die Ziehharmonika spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c769655c-52ef-4717-af74-10bfc7678e79",
                                "sense_id": "9bf56151-15d7-302f-985d-24ac67ea8274",
                                "text": "„Außerdem ist sie eine gute Ziehharmonikaspielerin und kann singen, dass die Wände beben.“"
                            },
                            {
                                "example_id": "24004f2c-0dd2-4ec7-b88b-3512e2abbbb3",
                                "sense_id": "9bf56151-15d7-302f-985d-24ac67ea8274",
                                "text": "„Plötzlich surrte die Türklingel und eine Pianistin und eine Ziehharmonikaspielerin schneiten zu unserer kulturellen Unterhaltung herein.“"
                            },
                            {
                                "example_id": "efbcb3ae-c3ae-40fb-b39f-04c6fe48541a",
                                "sense_id": "9bf56151-15d7-302f-985d-24ac67ea8274",
                                "text": "„Ich schrieb einen kurzen Sketch für drei Personen, hielt richtige Proben ab, organisierte als musikalischen Auftakt eine kleine Volkstanzgruppe und engagierte sogar eine Ziehharmonikaspielerin.“"
                            },
                            {
                                "example_id": "920b29e4-8a19-4621-afcc-30c38e773fbf",
                                "sense_id": "9bf56151-15d7-302f-985d-24ac67ea8274",
                                "text": "„Die Ziehharmonikaspielerinnen hatten aufgehört zu spielen. Die Leute redeten nicht mehr.“"
                            },
                            {
                                "example_id": "3d1e2b40-f5af-4f9c-b4d3-15eebe7d464e",
                                "sense_id": "9bf56151-15d7-302f-985d-24ac67ea8274",
                                "text": "„Elisabeth war seit ihrer Kindheit eine leidenschaftliche Ziehharmonikaspielerin, womit sie vielen Menschen und vor allem den Kindern Stunden der Freude und des Frohsinns bescherte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
