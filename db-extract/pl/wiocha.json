                        ],
                        "examples": [
                            {
                                "example_id": "9b9b8d61-7acb-4560-b98b-28b238174e07",
                                "sense_id": "e99506c4-237a-3ef5-bad4-38518ece803e",
                                "text": "Przejeżdżaliśmy przez jakąś wiochę, gdy zabrakło nam paliwa."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e44441b9-b242-451a-8787-69249c52fdf3",
                        "source_entry_id": "608c09e8-c13a-3399-8dbc-ae84fc44ea16",
                        "source_sense_id": "64e2004c-490b-362e-8dea-8d5bd64b768d",
                        "target_lang_word": "dědina",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dědina",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "004e7942-84c0-3207-9cdc-d490b4f431d8",
                                        "entry_id": "a31729fb-3f03-3e99-981a-1662c9ce8199",
                                        "glosses": [
                                            "vesnice, obec, osada"
                                        ],
                                        "tags": [
                                            "Moravia",
                                            "literary",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "990135ab-dfbf-430c-a9e3-3f13a0193c3e",
                                                "sense_id": "004e7942-84c0-3207-9cdc-d490b4f431d8",
                                                "text": "Hordubal stojí na silnici a polyká prach; pak se pomalu obrací k dědině a jde s hlavou schýlenou domů. Ech, Juraji, takto chodí staří."
                                            },
                                            {
                                                "example_id": "f49597f4-84e8-42a8-a3c0-d81244d11443",
                                                "sense_id": "004e7942-84c0-3207-9cdc-d490b4f431d8",
                                                "text": "Přes plot Hordubal a obchází dědinu zadem, podívat se po nebi co a jak. Dědina odzadu – jako když se odspodu díváš na stůl, samé hrubé dřevo a roubení; a jako by tě nikdo neviděl, jako by sis hrál s celým světem na schovávanou"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "742db4aa-fe50-35cd-9b66-e27849f853c5",
                                        "entry_id": "a31729fb-3f03-3e99-981a-1662c9ce8199",
                                        "glosses": [
                                            "náves"
                                        ],
                                        "tags": [
                                            "literary",
                                            "regional"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dd3af5a-8539-3076-9c2e-03478671bcb4",
                                        "entry_id": "a31729fb-3f03-3e99-981a-1662c9ce8199",
                                        "glosses": [
                                            "rodové pozemky"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d07e175-f9a2-40e1-af76-5f9638f78e70",
                                                "sense_id": "9dd3af5a-8539-3076-9c2e-03478671bcb4",
                                                "text": "Dědina, původně veškeren majetek, který se určité osobě dostal dědictvím od předků jejích, tedy statek zděděný, bonum paternum, b. aviaticum (u starých Čechů hereditas)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1753dde1-1625-4c81-9598-73abff64fe52",
                        "source_entry_id": "608c09e8-c13a-3399-8dbc-ae84fc44ea16",
                        "source_sense_id": "64e2004c-490b-362e-8dea-8d5bd64b768d",
