                "senses": [
                    {
                        "sense_id": "8ffc93de-82a2-3934-8bb9-17111c8cdbca",
                        "entry_id": "ee0cf597-a1ed-3636-a751-13d69ea61451",
                        "glosses": [
                            "Einzelfall, der als besonders schlecht (gelungen) gilt und nicht als Vorbild dienen sollte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b10106dd-1994-44f3-a832-4c4446c2e885",
                                "sense_id": "8ffc93de-82a2-3934-8bb9-17111c8cdbca",
                                "text": "„In einer einwanderungskritischen Grundsatzrede hat US-Präsidentschaftskandidat Donald Trump Deutschland als Negativbeispiel genannt.“"
                            },
                            {
                                "example_id": "312bbbb0-fa60-48c6-a542-503bd6ee5145",
                                "sense_id": "8ffc93de-82a2-3934-8bb9-17111c8cdbca",
                                "text": "„Am allerschlimmsten aber ist, wenn ein System-Update eigentlich eingespielt werden müsste, man aber keines bekommt. Dafür ist Googles System Android derzeit das Negativbeispiel.“"
                            },
                            {
                                "example_id": "19439145-56c1-4902-b7c8-4c9cf3779330",
                                "sense_id": "8ffc93de-82a2-3934-8bb9-17111c8cdbca",
                                "text": "„Dass die Sorge der Kritiker nicht unberechtigt gewesen war, zeigten die Negativbeispiele aus der jüngeren Vergangenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
