{
    "word_family": [
        "создание",
        "создатель",
        "созидание",
        "созидатель",
        "воссоздать",
        "пересоздать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "697c72f6-aa75-3935-bbfb-efc3e0390f1c",
                    "sense_definition": "Сделать существующим, произвести на свет, придумать или сотворить.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы хотим <создать> для детей лучшие условия жизни.",
                            "target_lang_translations": {
                                "en": "We want to <create> better living conditions for the children.",
                                "zh": "我们想为孩子们<创造>更好的生活条件。"
                            }
                        },
                        {
                            "text": "Ему удалось <создать> в коллективе дружескую атмосферу.",
                            "target_lang_translations": {
                                "en": "He managed to <create> a friendly atmosphere in the team.",
                                "zh": "他成功地在团队中<创造>了一种友好的氛围。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сотворить",
                        "организовать",
                        "основать"
                    ],
                    "antonyms": [
                        "уничтожить"
                    ],
                    "common_phrases": [
                        "создать семью",
                        "создать условия",
                        "создать проблему",
                        "создать впечатление"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring something into existence, produce, invent, or make something happen.",
                        "zh": "使某物存在、产生、发明或促成某事发生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "create",
                                "target_lang_sense_clarification": "To bring into existence or cause to happen"
                            },
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "To produce or cause (e.g., trouble, conditions)"
                            },
                            {
                                "target_lang_word": "generate",
                                "target_lang_sense_clarification": "To produce or cause to arise (e.g., an impression)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创造",
                                "target_lang_sense_clarification": "指从无到有地制造或产生"
                            },
                            {
                                "target_lang_word": "制造",
                                "target_lang_sense_clarification": "指生产或促成某种情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff798616-3d25-3125-a445-4a255a0674bb",
                    "sense_definition": "Организовать, основать какое-либо учреждение, общество или группу.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Друзья решили <создать> свою собственную фирму.",
                            "target_lang_translations": {
                                "en": "The friends decided to <set up> their own firm.",
                                "zh": "朋友们决定<创办>属于他们自己的公司。"
                            }
                        },
                        {
                            "text": "Правительство планирует <создать> специальную комиссию по этому вопросу.",
                            "target_lang_translations": {
                                "en": "The government plans to <establish> a special commission on this issue.",
                                "zh": "政府计划针对此问题<建立>一个特别委员会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "построить"
                    ],
                    "antonyms": [
                        "разрушить",
                        "уничтожить"
                    ],
                    "common_phrases": [
                        "создать комитет",
                        "создать партию",
                        "создать компанию",
                        "создать группу"
                    ],
                    "target_lang_definitions": {
                        "en": "To organize, establish, or start an institution, society, or group.",
                        "zh": "组织、建立或创办某个机构、社会团体或组织。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "establish",
                                "target_lang_sense_clarification": "To set up an organization or system on a firm basis"
                            },
                            {
                                "target_lang_word": "set up",
                                "target_lang_sense_clarification": "To start a business, institution, or other structure"
                            },
                            {
                                "target_lang_word": "found",
                                "target_lang_sense_clarification": "To start an institution or company, often with the idea of longevity"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建立",
                                "target_lang_sense_clarification": "指使机构或制度稳固地成立"
                            },
                            {
                                "target_lang_word": "创办",
                                "target_lang_sense_clarification": "指开办企业或机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35febf98-ee20-3ac2-b4e2-0fe8c4b3c754",
                    "sense_definition": "Построить или воздвигнуть что-либо (обычно о крупных сооружениях или в высоком стиле).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зодчий мечтал <создать> храм невероятной красоты.",
                            "target_lang_translations": {
                                "en": "The architect dreamed of <creating> a temple of incredible beauty.",
                                "zh": "建筑师梦想着<建造>一座美轮美奂的寺庙。"
                            }
                        },
                        {
                            "text": "На этом месте предки хотели <создать> новый город.",
                            "target_lang_translations": {
                                "en": "On this spot, the ancestors wanted to <build> a new city.",
                                "zh": "祖先们曾想在这个地方<兴建>一座新城。"
                            }
                        }
                    ],
                    "synonyms": [
                        "построить",
                        "воздвигнуть",
                        "возвести"
                    ],
                    "antonyms": [
                        "разрушить"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage in the sense of physical building is often poetic or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To build or erect something (usually large structures or in a high style).",
                        "zh": "建造或竖立某物（通常指大型建筑或文学艺术语境）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "create",
                                "target_lang_sense_clarification": "To produce a work of art or a masterpiece"
                            },
                            {
                                "target_lang_word": "construct",
                                "target_lang_sense_clarification": "To build or form by putting together parts"
                            },
                            {
                                "target_lang_word": "build",
                                "target_lang_sense_clarification": "To construct a building or structure"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建造",
                                "target_lang_sense_clarification": "指通过组合部件来构建建筑物"
                            },
                            {
                                "target_lang_word": "兴建",
                                "target_lang_sense_clarification": "指大规模地建设"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}