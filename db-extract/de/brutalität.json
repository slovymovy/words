                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3f81aed-04c4-4ff2-b8f9-5f9d9df39ed7",
                                "sense_id": "ffd3ca42-c828-34b2-bd34-1766e2972674",
                                "text": "Stalin hat heute trotz seiner unnachgiebigen Brutalität das Image eines „effektiven Managers“, eines hartgesottenen Führers, der dem Land den Sieg über die Nationalsozialisten einbrachte.",
                                "translation": "Malgré sa brutalité implacable, Staline a aujourd'hui l'image d’un \"manager efficace\", d’un dirigeant endurci qui a permis au pays de vaincre les nazis."
                            }
                        ]
                    }
                ],
