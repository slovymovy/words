                "forms": [],
                "senses": [
                    {
                        "sense_id": "f1a9729c-557f-36a1-aea6-c1985649902a",
                        "entry_id": "50c6ee6a-5fbd-3fbb-9c17-0048fa10e207",
                        "glosses": [
                            "bez potrąceń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a87e2d8-c6d6-4a9a-8982-447f4258533a",
                                "sense_id": "f1a9729c-557f-36a1-aea6-c1985649902a",
                                "text": "Cena liczona brutto."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d4361c5-7aae-4e5e-8d51-a06944415446",
                        "source_entry_id": "50c6ee6a-5fbd-3fbb-9c17-0048fa10e207",
                        "source_sense_id": "f1a9729c-557f-36a1-aea6-c1985649902a",
                        "target_lang_word": "gross",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gross",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d72c7910-ce1c-3f4f-9ba4-5e450a0508e9",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Highly or conspicuously offensive."
                                        ],
                                        "tags": [
                                            "of behaviour considered to be wrong"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff256c2f-59e9-4520-83e1-16a60691f7b6",
                                                "sense_id": "d72c7910-ce1c-3f4f-9ba4-5e450a0508e9",
                                                "text": "a gross mistake; gross injustice; gross negligence; a gross insult"
                                            },
                                            {
                                                "example_id": "8401cda3-f9e0-4ba2-8b80-e3dc945bf6d3",
                                                "sense_id": "d72c7910-ce1c-3f4f-9ba4-5e450a0508e9",
                                                "text": "Henry IV. My gracious uncle, let me know my fault:\nOn what condition stands it and wherein?\nEdmund of Langley. Even in condition of the worst degree,\nIn gross rebellion and detested treason:"
                                            },
                                            {
                                                "example_id": "6f53d5c9-7543-4331-adbe-7c9b1105581b",
                                                "sense_id": "d72c7910-ce1c-3f4f-9ba4-5e450a0508e9",
                                                "text": "Your very faults, how gross soere, to me\nHave something pleasing in ’em."
                                            },
                                            {
                                                "example_id": "a8d137c7-fbc5-43be-8178-9800e1eb2dde",
                                                "sense_id": "d72c7910-ce1c-3f4f-9ba4-5e450a0508e9",
                                                "text": "[…] I thank Heaven I have had Time to reflect on my past Life, where though I cannot charge myself with any gross Villainy, yet I can discern Follies and Vices too sufficient to repent and to be ashamed of;"
                                            },
                                            {
                                                "example_id": "ad41d56a-e73f-4d46-afc4-9d6ef13c720f",
                                                "sense_id": "d72c7910-ce1c-3f4f-9ba4-5e450a0508e9",
                                                "text": "[…] had his actions been what Wickham represented them, so gross a violation of every thing right could hardly have been concealed from the world;"
                                            },
                                            {
                                                "example_id": "8265470c-8afc-425d-adc9-f7dde3e45aea",
                                                "sense_id": "d72c7910-ce1c-3f4f-9ba4-5e450a0508e9",
                                                "text": "[…] he has been found guilty, on the clearest evidence, first, of stealing a valuable motor-car; secondly, of driving to the public danger; and, thirdly, of gross impertinence to the rural police."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c495367d-30d7-3ad9-9a5b-b97b6e57f210",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Excluding any deductions; including all associated amounts."
                                        ],
                                        "tags": [
                                            "of an amount"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c7f60b5-739a-4d1c-88d1-e554785cf532",
                                                "sense_id": "c495367d-30d7-3ad9-9a5b-b97b6e57f210",
                                                "text": "gross domestic product; gross income; gross weight"
                                            },
                                            {
                                                "example_id": "504db0ca-a60a-474a-ab4a-67279fa2b76d",
                                                "sense_id": "c495367d-30d7-3ad9-9a5b-b97b6e57f210",
                                                "text": "What is the gross sum that I owe thee?"
                                            },
                                            {
                                                "example_id": "68c82931-06d8-496b-8757-6b2ee3981242",
                                                "sense_id": "c495367d-30d7-3ad9-9a5b-b97b6e57f210",
                                                "text": "For a man of his habits the house and the hundred and twenty pounds a year which he had inherited from his mother were enough to supply all worldly needs. Resources do not depend upon gross amounts, but upon the proportion of spendings to takings."
                                            },
                                            {
                                                "example_id": "f16ad800-e1ab-4ed8-b4f2-4d00da6a0bc2",
                                                "sense_id": "c495367d-30d7-3ad9-9a5b-b97b6e57f210",
                                                "text": "[…] please notice that even these wretched earnings are gross earnings. On top of this there are all kinds of stoppages which are deducted from the miner’s wages every week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e942fd57-a957-316e-a0ef-8d3f2be12c9c",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Seen without a microscope (usually for a tissue or an organ); at a large scale; not detailed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4227c875-cc8a-4af6-a0b7-50c369a08281",
                                                "sense_id": "e942fd57-a957-316e-a0ef-8d3f2be12c9c",
                                                "text": "gross anatomy"
                                            },
                                            {
                                                "example_id": "6012fc4f-dac7-4beb-b9f9-088ba460f268",
                                                "sense_id": "e942fd57-a957-316e-a0ef-8d3f2be12c9c",
                                                "text": "We are accustomed to look for the gross and immediate effect and to ignore all else. Unless this appears promptly and in such obvious form that it cannot be ignored, we deny the existence of hazard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f06e965c-62a7-344e-8222-b5a8a63e3a08",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Causing disgust."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "771637de-962a-49b9-a85a-b14edbccd437",
                                                "sense_id": "f06e965c-62a7-344e-8222-b5a8a63e3a08",
                                                "text": "I threw up all over the bed. It was totally gross."
                                            },
                                            {
                                                "example_id": "16a6494c-fca3-4380-93e1-357a6100ef61",
                                                "sense_id": "f06e965c-62a7-344e-8222-b5a8a63e3a08",
                                                "text": "Mary Ann spent her lunch hour at Hastings, picking out just the right tie for Norman. The hint might not be terribly subtle, she decided, but somebody had to do something about that gross, gravy-stained clip-on number."
                                            },
                                            {
                                                "example_id": "92f5407c-30d8-4c62-9f61-bdff18f7105a",
                                                "sense_id": "f06e965c-62a7-344e-8222-b5a8a63e3a08",
                                                "text": "The next-door neighbor’s cat coughed up a hairball one day and the hair was not the cat’s. “That’s so gross!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b0f1d15-fb29-30f0-96df-a9e0fa4f8727",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Lacking refinement in behaviour or manner; offending a standard of morality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d2b6642-8eb3-41f5-870c-11c465ecdeee",
                                                "sense_id": "1b0f1d15-fb29-30f0-96df-a9e0fa4f8727",
                                                "text": "Pog. Forsooth my Maister said that hee loved her almost as well as hee loved parmasent, and swore [...] that shee wanted such a Nose as his was, to be as pretty a young woeman, as was any in Parma. Do. Oh grose!"
                                            },
                                            {
                                                "example_id": "3d93b429-d4b8-4384-9940-e3596c9e2110",
                                                "sense_id": "1b0f1d15-fb29-30f0-96df-a9e0fa4f8727",
                                                "text": "Verjuice. She certainly has Talents.\nLady Sneerwell. But her manner is gross."
                                            },
                                            {
                                                "example_id": "a472b30d-05f4-48c0-af7c-13dd1df42670",
                                                "sense_id": "1b0f1d15-fb29-30f0-96df-a9e0fa4f8727",
                                                "text": "But man to know God is a difficulty, except by a mean he himself inure, which is to know God’s creatures that be: at first them that be of the grossest nature, and then [...] them that be more pure."
                                            },
                                            {
                                                "example_id": "117d6c26-df92-4d8a-a5b8-5c384a2d0e72",
                                                "sense_id": "1b0f1d15-fb29-30f0-96df-a9e0fa4f8727",
                                                "text": "All this was extraordinarily distasteful to Churchill. It was ugly, gross. Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connexion—or rather as a transition from the subject that started their conversation—such talk had been distressingly out of place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24a8f1f-c3c7-3980-b7a5-b2e7774515df",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Lacking refinement; not of high quality."
                                        ],
                                        "tags": [
                                            "of a product"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "493e465e-6321-4b46-8ee2-9ffd0ec7914f",
                                                "sense_id": "b24a8f1f-c3c7-3980-b7a5-b2e7774515df",
                                                "text": "The flowers of Rubens are gross and rude […]"
                                            },
                                            {
                                                "example_id": "886c70b8-b8fe-4726-aae1-be3cd1c79c1e",
                                                "sense_id": "b24a8f1f-c3c7-3980-b7a5-b2e7774515df",
                                                "text": "He scorned my wholesome kennel fare, toothing out dainties and leaving the grosser portions to be finished by the other dogs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24a8a330-8ecf-3cba-9fbe-f5b2208fd146",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Dense, heavy."
                                        ],
                                        "tags": [
                                            "of a substance"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68224bf1-d42a-49e3-8763-057ebfa95960",
                                                "sense_id": "24a8a330-8ecf-3cba-9fbe-f5b2208fd146",
                                                "text": "⁠Thy spirit ere our fatal loss\n⁠Did ever rise from high to higher;\n⁠As mounts the heavenward altar-fire,\nAs flies the lighter thro’ the gross."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5852c16-0dcf-3f1d-8bde-313cc9d61cff",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Heavy in proportion to one's height; having a lot of excess flesh."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "712c96aa-80d4-4b12-b516-a0acf651deee",
                                                "sense_id": "e5852c16-0dcf-3f1d-8bde-313cc9d61cff",
                                                "text": "Kitty noticed that her sister’s pregnancy had blunted her features and in her black dress she looked gross and blousy."
                                            },
                                            {
                                                "example_id": "8249d85a-366a-44af-a6b4-9bb6ec7e1516",
                                                "sense_id": "e5852c16-0dcf-3f1d-8bde-313cc9d61cff",
                                                "text": "He collected a number of injuries that stopped him jousting, and then in middle age became stout, eventually gross."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f7258e2-aa69-3b5d-b71c-546cccf0c0fe",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Difficult or impossible to see through."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b5a183d-c5df-40f4-9cdc-e6e606dd82eb",
                                                "sense_id": "7f7258e2-aa69-3b5d-b71c-546cccf0c0fe",
                                                "text": "Couragious Lancaster, imbrace thy king,\nAnd as grosse vapours perish by the sunne,\nEuen so let hatred with thy soueraigne smile,"
                                            },
                                            {
                                                "example_id": "c79ac1c2-253f-46ac-8199-398dfe826b8e",
                                                "sense_id": "7f7258e2-aa69-3b5d-b71c-546cccf0c0fe",
                                                "text": "For, behold, the darkness shall cover the earth, and gross darkness the people: but the Lord shall arise upon thee, and his glory shall be seen upon thee."
                                            },
                                            {
                                                "example_id": "51f97082-0138-4fef-9e94-3f9e7853b08a",
                                                "sense_id": "7f7258e2-aa69-3b5d-b71c-546cccf0c0fe",
                                                "text": "A pestilent and most corrosive steam,\nLike a gross fog Boeotian, rising fast,\nAnd fast condensed upon the dewy sash,\nAsks egress;"
                                            },
                                            {
                                                "example_id": "18e6fc1d-5339-44e9-a149-2b2bd593831c",
                                                "sense_id": "7f7258e2-aa69-3b5d-b71c-546cccf0c0fe",
                                                "text": "[…] a larger life\nUpon his own impinging, with swift glimpse\nOf spacious circles luminous with mind,\nTo which the ethereal substance of his own\nSeems but gross cloud to make that visible,\nTouched to a sudden glory round the edge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a6ccaa-018e-3f82-809d-559182abc62b",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Not sensitive in perception or feeling."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e000e863-d87f-4218-97dc-a0af3897ad59",
                                                "sense_id": "f7a6ccaa-018e-3f82-809d-559182abc62b",
                                                "text": "For he is groſſe and like the maſſie earth,\nThat mooues not vpwards, nor by princely deeds\nDoth meane to ſoare aboue the highest ſort."
                                            },
                                            {
                                                "example_id": "33152994-dacf-44c5-ba96-9324aec72f27",
                                                "sense_id": "f7a6ccaa-018e-3f82-809d-559182abc62b",
                                                "text": "For this people’s heart is waxed gross, and their ears are dull of hearing, and their eyes they have closed; lest at any time they should see with their eyes and hear with their ears, and should understand with their heart, and should be converted, and I should heal them."
                                            },
                                            {
                                                "example_id": "4267ad00-69c3-4c10-b891-989343036273",
                                                "sense_id": "f7a6ccaa-018e-3f82-809d-559182abc62b",
                                                "text": "A thousand liveried Angels lacky her [the chaste soul],\nDriving far off each thing of sin and guilt,\nAnd in cleer dream, and solemn vision\nTell her of things that no gross ear can hear.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "716be23f-7b99-39a4-a3a9-6a354a0f8336",
                                        "entry_id": "85e6ce7d-5788-3a48-bfe2-c0fb82aa3aa3",
                                        "glosses": [
                                            "Easy to perceive."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed55931c-6591-4ae3-90e1-8ed9a3883c86",
                                                "sense_id": "716be23f-7b99-39a4-a3a9-6a354a0f8336",
                                                "text": "[…] though the truth of it stands off as gross\nAs black and white, my eye will scarcely see it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gross",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebe12758-f1cf-3cfe-aaf9-f0f1eefa2500",
                                        "entry_id": "74542543-8ff8-39ba-8bca-f404c86cdd96",
                                        "glosses": [
                                            "Twelve dozen = 144."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7229a118-b561-4eac-a8e1-181d5a9a3e34",
                                                "sense_id": "ebe12758-f1cf-3cfe-aaf9-f0f1eefa2500",
                                                "text": "We need to order three gross of torx screws for next week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "578253c4-ff91-3fe4-ac1d-572157318970",
