                    "frequency": "Low",
                    "semantic_group_id": "titel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der erste <w>Inhaber</w> des Bundesverdienstkreuzes war der Bergmann Franz Brandl."
                        },
                        {
                            "text": "Als neuer <w>Inhaber</w> des Lehrstuhls hielt er eine beachtenswerte Antrittsvorlesung."
                        }
                    ],
                    "synonyms": [
