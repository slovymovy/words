                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abundant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1431f333-ab0a-3b22-8ac7-dba7ec0aff12",
                                        "entry_id": "e7d57648-d7f6-350d-9972-c4c43bc85cc9",
                                        "glosses": [
                                            "Fully sufficient; found in copious supply; in great quantity; overflowing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ceef78b-6649-4d61-ad8d-83166e02a42e",
                                                "sense_id": "1431f333-ab0a-3b22-8ac7-dba7ec0aff12",
                                                "text": "Blackberries are abundant in this part of the country in October, so we always make lots of jam."
                                            },
                                            {
                                                "example_id": "75a8bda6-fa6b-42b8-9f70-fbf2b91fdf5c",
                                                "sense_id": "1431f333-ab0a-3b22-8ac7-dba7ec0aff12",
                                                "text": "an abundant selection of carpets to choose from"
                                            },
                                            {
                                                "example_id": "70ecb407-efad-4ba4-b710-108c2b6b2f41",
                                                "sense_id": "1431f333-ab0a-3b22-8ac7-dba7ec0aff12",
                                                "text": "[W]ith their magical words they [poets] bring forth to our eyesight the abundant images and beauties of creation."
                                            },
                                            {
                                                "example_id": "092329d0-27a7-40c6-9372-54a691a41ddf",
                                                "sense_id": "1431f333-ab0a-3b22-8ac7-dba7ec0aff12",
                                                "text": "Kadara was of great interest to the Andromeda Initiative after it appeared on long-range surveys. Seemingly abundant liquid water and an oxygen-mix atmosphere made it a strong candidate for settlement, earning it the designation Habitat 4. Closer range surveys now reveal that Kadara's water sources are tainted and unpotable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6795d912-f064-3e6c-a630-1b2c2db9cc08",
                                        "entry_id": "e7d57648-d7f6-350d-9972-c4c43bc85cc9",
                                        "glosses": [
                                            "Richly supplied; wealthy; possessing in great quantity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efca7d7b-544e-4f13-9d45-c6d73c25ade1",
                                                "sense_id": "6795d912-f064-3e6c-a630-1b2c2db9cc08",
                                                "text": "Abundant in goodness and truth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f562c00a-9e6e-3050-9ad1-a34e6326b211",
                                        "entry_id": "e7d57648-d7f6-350d-9972-c4c43bc85cc9",
                                        "glosses": [
                                            "Being an abundant number, i.e. less than the sum of all of its divisors except itself."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f3b4ff9-cd44-43e5-b2b5-64a1f6b0965f",
                        "source_entry_id": "7a7c760f-bed7-3d34-a19c-563f0eddccd2",
                        "source_sense_id": "5857f1d0-0fec-3366-8058-e1f6e54f1cf2",
