                                "target_senses": [
                                    {
                                        "sense_id": "9e949e72-0518-3f9b-9cd9-d2a8bf2af9d5",
                                        "entry_id": "7fbfd918-9e1d-3cda-88d9-7bc552a89d69",
                                        "glosses": [
                                            "comparative degree of old: older, greater than another in age or seniority."
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16084b22-698a-4b55-b6ac-32e1ede9b75c",
                                                "sense_id": "9e949e72-0518-3f9b-9cd9-d2a8bf2af9d5",
                                                "text": "It's typical for elder married couples to live in retirement homes."
                                            },
                                            {
                                                "example_id": "7e548c5d-9cdd-49e1-90c3-e41150cb909b",
                                                "sense_id": "9e949e72-0518-3f9b-9cd9-d2a8bf2af9d5",
                                                "text": "The elder of the two was also an elder statesman."
                                            },
                                            {
                                                "example_id": "1fae8db6-4b03-4dc3-a3cc-7db0ec45090d",
                                                "sense_id": "9e949e72-0518-3f9b-9cd9-d2a8bf2af9d5",
                                                "text": "She removed Stranleigh’s coat with a dexterity that aroused his imagination. The elder woman returned with dressings and a sponge, which she placed on a chair."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "A leader or senior member of a tribe or community, often of considerable age, respected as an authority figure, especially in a counselling, consultative, or ceremonial role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "553d0a81-e357-4d0e-9f2e-2e9136ce82bb",
                                                "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                                                "text": "We were presented to the village elder."
                                            },
                                            {
                                                "example_id": "36e1756b-432d-49c2-8ff9-6745563b5d3c",
                                                "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                                                "text": "At the friendship centre, you can arrange to meet with a social worker or an elder."
                                            },
                                            {
                                                "example_id": "5160e34f-2939-4fc0-a63e-6d7929e5f4e2",
                                                "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                                                "text": "People saw in the elders, who were closer to death, the manifestation of the divine force that was thought to achieve its full liberation at death."
                                            },
                                            {
                                                "example_id": "93a22593-ba19-4101-85ec-5a311637db9e",
                                                "sense_id": "34bcb024-859e-3579-83d0-cb201667a217",
                                                "text": "I probably wouldn't be here talking about this very topic if it weren't for the few but mighty elders in the tech and gender rights spaces. Folks like South Africa-based Jan Moolman from the Association for Progressive Communications[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb595a9c-4baf-3f8f-8562-d75737a7cba7",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "An old person."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b6c9f45-449d-4b4f-a638-336d8b9fb43f",
                                                "sense_id": "eb595a9c-4baf-3f8f-8562-d75737a7cba7",
                                                "text": "Treating illness among society’s elders is challenging since board-certified geriatricians (physicians trained, knowledgeable and certified in treating older patients) are in short supply, here in El Paso and throughout the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "447ca576-1919-37d0-8c41-80f1687d04c2",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "One who is older than another."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "relational"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7037e843-2e9f-4486-ab3d-779df900c0ee",
                                                "sense_id": "447ca576-1919-37d0-8c41-80f1687d04c2",
                                                "text": "Respect your elders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab590bf9-a204-37cb-be90-f56164ff1b3e",
                                        "entry_id": "d818ce63-cffe-3276-889f-252c619a9072",
                                        "glosses": [
                                            "One who lived at an earlier period; a predecessor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e16c4af-f9a9-41f3-b205-07c180d77109",
                                                "sense_id": "ab590bf9-a204-37cb-be90-f56164ff1b3e",
                                                "text": "Carry your Head[…] as your Elders have done."
                                            }
                                        ]
                                    },
                                    {
