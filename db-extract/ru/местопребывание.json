                "translations": [
                    {
                        "translation_id": "504d98b5-d6c2-4165-9f57-459dbb903bc2",
                        "source_entry_id": "5f29a80a-fae9-3594-b20d-3301cd43dcf9",
                        "source_sense_id": "71d7402c-d3ed-3696-ac6f-199be91f20dc",
                        "target_lang_word": "Aufenthaltsort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufenthaltsort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f72aee70-0a59-37e3-a3f1-922de3cde3be",
                                        "entry_id": "0cf44c5a-8c5f-3014-a16e-caca92432be4",
                                        "glosses": [
                                            "der Ort, wo jemand sich ständig oder vorübergehend befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11737ac5-5907-448f-8fe4-2bba2da687f0",
                                                "sense_id": "f72aee70-0a59-37e3-a3f1-922de3cde3be",
                                                "text": "Sein Aufenthaltsort konnte noch nicht festgestellt werden."
                                            },
                                            {
                                                "example_id": "f0b00288-c875-41d1-87c1-33d53bc3e39e",
                                                "sense_id": "f72aee70-0a59-37e3-a3f1-922de3cde3be",
                                                "text": "„Friedhöfe sind nicht meine bevorzugten Aufenthaltsorte.“"
                                            },
                                            {
                                                "example_id": "0276b204-28f0-49d9-9836-c9d1b6c30d77",
                                                "sense_id": "f72aee70-0a59-37e3-a3f1-922de3cde3be",
                                                "text": "„Als er nun durch die Hochzeit mit meiner Großmutter zu einem reichen Ehemann geworden war, spielte er den Playboy und fand im Spielcasino seinen liebsten Aufenthaltsort.“"
                                            },
                                            {
                                                "example_id": "d2fa9e38-6b2e-42c2-b147-52c16f388e10",
                                                "sense_id": "f72aee70-0a59-37e3-a3f1-922de3cde3be",
                                                "text": "„Ich erzählte ihr alles, was ich von ihrer Schwester wußte, und versprach ihr, nach Turin zu schreiben, um ihren jetzigen Aufenthaltsort zu erfahren und ihn ihr dann mitzuteilen.“"
                                            },
                                            {
                                                "example_id": "f766b0ef-b968-416c-8fee-b87b1b0985fd",
                                                "sense_id": "f72aee70-0a59-37e3-a3f1-922de3cde3be",
                                                "text": "„Denn das Gesetz ist immer noch gütlig, daß man Genehmigung braucht, um seinen Aufenthaltsort zu wechseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
