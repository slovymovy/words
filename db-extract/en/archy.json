                "word": "Archy",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e9642410-d8cd-3951-9b14-9494d6fb2216",
                        "entry_id": "6cf2b717-73d1-32b5-b336-eba5e11b7ac1",
