                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e6caad9-1176-4ac2-af3d-05cf04a8860d",
                                                "sense_id": "60dc83c5-44c4-3bdf-959e-21bf9a78e3a9",
                                                "text": "„Ein Enterich erwachte im Röhricht und schalt laut und böse in die Nacht hinein.“"
                                            },
                                            {
                                                "example_id": "4e32b3b4-bb73-4ea0-92fd-e89206fc5986",
                                                "sense_id": "60dc83c5-44c4-3bdf-959e-21bf9a78e3a9",
                                                "text": "„Nur dann und wann, wenn eine hochaufspritzende Welle in seine Ohrmuschel schlug, oder wenn ein vorüberschwimmender Enterich nach seinem Fingerlein schnappte, wimmerte er wieder auf.“"
                                            },
                                            {
                                                "example_id": "aefbb2a3-e02e-425e-9246-32f1f9794647",
                                                "sense_id": "60dc83c5-44c4-3bdf-959e-21bf9a78e3a9",
                                                "text": "„Der zischende Enterich vor ihr schwingt ihn und trifft eine seiner Töchter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
