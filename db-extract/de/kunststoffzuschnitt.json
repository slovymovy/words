                ],
                "senses": [
                    {
                        "sense_id": "6bacc8a7-4a86-371d-b244-e55b3559084d",
                        "entry_id": "27dc6737-0d99-397e-a5d1-b36490942d85",
                        "glosses": [
                            "das spanende Zuschneiden von Kunststoffmaterial laut Schablone oder Maßvorgabe"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "fb5b8ac2-da7d-4e0c-bf59-8778faa3b62f",
                                "sense_id": "6bacc8a7-4a86-371d-b244-e55b3559084d",
                                "text": "„Wie die Holzma Plattenaufteiltechnik GmbH mitteilt, sind im Kunststoffzuschnitt bei ThyssenKrupp Plastics an den 15 Lagerstandorten in Deutschland rund 30 Holzma Sägen im Einsatz.“"
                            },
                            {
                                "example_id": "c16e70fe-d0b0-45cc-a4d8-ef25379fe335",
                                "sense_id": "6bacc8a7-4a86-371d-b244-e55b3559084d",
                                "text": "„Bei Zuschnitt mit einer elektrischen Kappsäge muss das Sägeblatt für Kunststoffzuschnitt geeignet sein (grobe Sägezähne) und darf nur mit einer geringeren Umdrehungszahl genutzt werden.“"
                            },
                            {
                                "example_id": "3d6dda6a-71af-4db3-8e4f-ae4e36abb803",
                                "sense_id": "6bacc8a7-4a86-371d-b244-e55b3559084d",
                                "text": "„Der Sägenhersteller Holzma, Holzbronn bei Calw, hat daher eine spezielle Baureihe mit Plattenaufteilsägen für den Kunststoffzuschnitt im Portfolio.“"
                            },
                            {
                                "example_id": "33d5c7d3-7063-418c-899e-e37fb6c4eb40",
                                "sense_id": "6bacc8a7-4a86-371d-b244-e55b3559084d",
                                "text": "„Insgesamt kommen hier für den Kunststoffzuschnitt rund 30 HOLZMA Sägen zum Einsatz.“"
                            },
                            {
                                "example_id": "e6db0302-3352-405e-819e-bedec871fd29",
                                "sense_id": "6bacc8a7-4a86-371d-b244-e55b3559084d",
                                "text": "„Der Aufgabenbereich der 15 Mitarbeiter umfasst verschiedenste Tätigkeiten. Sei es die Herstellung von Fertigteilen nach Kundenzeichnung oder der einzelne Kunststoffzuschnitt.“"
                            },
                            {
                                "example_id": "e4f54835-37e3-4b9e-b983-e0d2581d3456",
                                "sense_id": "6bacc8a7-4a86-371d-b244-e55b3559084d",
                                "text": "„Mit unserer Plattenaufteilanlage bieten wir maßgenaue Kunststoffzuschnitte für nahezu alle Kunststoffe unseres Lieferprogramms.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b26d9a19-5862-310e-8a85-5bdf8e019167",
                        "entry_id": "27dc6737-0d99-397e-a5d1-b36490942d85",
                        "glosses": [
                            "das zugeschnittene Kunststoffobjekt selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17bc40a2-fb7f-4d75-bd0b-0cedede21996",
                                "sense_id": "b26d9a19-5862-310e-8a85-5bdf8e019167",
                                "text": "„Der Aufgabenbereich der 15 Mitarbeiter umfasst verschiedenste Tätigkeiten. Sei es die Herstellung von Fertigteilen nach Kundenzeichnung oder der einzelne Kunststoffzuschnitt.“"
                            },
                            {
                                "example_id": "358d1334-6c4b-431f-96ed-dbfbf572c2d3",
                                "sense_id": "b26d9a19-5862-310e-8a85-5bdf8e019167",
                                "text": "„Mit unserer Plattenaufteilanlage bieten wir maßgenaue Kunststoffzuschnitte für nahezu alle Kunststoffe unseres Lieferprogramms.“"
                            },
                            {
                                "example_id": "9908c4e6-e784-4202-991a-b2246a137b01",
                                "sense_id": "b26d9a19-5862-310e-8a85-5bdf8e019167",
                                "text": "„Unter den Produktbereich Stanzteile fallen unterschiedliche Produkte wie Isolierteile, Filzringe, Unterlegscheiben, Verschraubungsringe, Gummistreifen, Kunststoffzuschnitte und sonstige gestanzten Zulieferteile.“"
                            },
                            {
                                "example_id": "c7c2d502-f3ab-426c-9c53-04e10332523e",
                                "sense_id": "b26d9a19-5862-310e-8a85-5bdf8e019167",
                                "text": "„Kunststoffzuschnitte erhalten Sie von uns in der Regel innert wenigen Tagen.“"
                            },
                            {
                                "example_id": "1e42b24a-dda5-41d9-be04-1c1d95ea2078",
                                "sense_id": "b26d9a19-5862-310e-8a85-5bdf8e019167",
                                "text": "„Ein Blickschutz ist ein ca. 0,5mm dünner, schwarzer Kunststoffzuschnitt mit Mikrolamellen.“"
                            },
                            {
                                "example_id": "ff9044cf-2ac3-4a64-9a93-7d6a642d6997",
                                "sense_id": "b26d9a19-5862-310e-8a85-5bdf8e019167",
                                "text": "„Ebenso erhalten Sie bei uns Kunststoffzuschnitte aller Art.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
