        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ae34f91-6ba9-3de3-8ad5-82ccdac7fa1d",
                    "sense_definition": "To make something easy or suitable for someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We adjusted the schedule to <w>convenience</w> the staff.",
                            "target_lang_translations": {
                                "ru": "Мы скорректировали график, чтобы <w>обеспечить удобство</w> персоналу.",
                                "de": "Wir haben den Zeitplan angepasst, um dem Personal <w>entgegenzukommen</w>.",
                                "zh": "我们调整了时间表以<w>方便</w>员工。"
                            }
                        },
                        {
                            "text": "The new route was designed to <w>convenience</w> commuters.",
                            "target_lang_translations": {
                                "ru": "Новый маршрут был разработан, чтобы <w>обеспечить удобство</w> пассажирам.",
                                "de": "Die neue Route wurde entworfen, um Pendlern das Leben zu <w>erleichtern</w>.",
                                "zh": "新路线的设计旨在为通勤者<w>提供便利</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "inconvenience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-то легким или подходящим для кого-то.",
                        "de": "Etwas für jemanden einfach oder passend machen.",
                        "zh": "指使某事对某人来说变得容易或合适。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обеспечивать удобство",
                                "target_lang_sense_clarification": "создавать комфортные условия"
                            },
                            {
                                "target_lang_word": "подстраиваться",
                                "target_lang_sense_clarification": "делать удобным для кого-то"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "entgegenkommen",
