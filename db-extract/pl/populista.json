                        "glosses": [
                            "osoba wyznająca populizm, głosząca poglądy i tezy populistyczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5daac20e-020f-481d-8330-ec96ae2a9c3e",
                                "sense_id": "97535204-d938-3ea9-9837-07a20b1dd90e",
                                "text": "Wielu, spośród polityków tej partii, to populiści."
