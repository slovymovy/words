    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "91e4c517-07fd-36d1-b320-8989cc89baee",
                    "sense_definition": "A surname derived from the male given name <w>Daniel</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Daniels</w> has been teaching history at our school for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Дэниелс</w> преподает историю в нашей школе уже более двадцати лет.",
                                "zh": "<w>丹尼尔斯</w>先生在我们学校教历史已经二十多年了。"
                            }
                        },
                        {
                            "text": "Please send the signed documents to Ms. <w>Daniels</w> in the accounting department.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, отправьте подписанные документы мисс <w>Дэниелс</w> в бухгалтерию.",
                                "zh": "请把签好的文件寄给会计部的<w>丹尼尔斯</w>女士。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Mr. Daniels",
                        "Mrs. Daniels",
                        "Dr. Daniels"
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "derived from Daniel"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, образованная от мужского имени Дэниел.",
                        "zh": "源自男性名字“丹尼尔”的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дэниелс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丹尼尔斯",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "975bf836-7431-357f-a271-6b9915b1aa1a",
                    "sense_definition": "The plural form of the proper noun <w>Daniel</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are three <w>Daniels</w> in my class, so we use their last names to tell them apart.",
                            "target_lang_translations": {
                                "ru": "В моем классе три <w>Дэниела</w>, поэтому мы называем их по фамилиям, чтобы различать.",
                                "zh": "我们班上有三个叫<w>丹尼尔</w>的同学，所以我们用姓氏来区分他们。"
                            }
                        },
                        {
                            "text": "Both <w>Daniels</w> agreed to meet us at the library after school.",
                            "target_lang_translations": {
                                "ru": "Оба <w>Дэниела</w> согласились встретиться с нами в библиотеке после школы.",
                                "zh": "两位<w>丹尼尔</w>都同意放学后在图书馆和我们见面。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число имени собственного Дэниел.",
                        "zh": "专有名词“丹尼尔”的复数形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дэниелы",
                                "target_lang_sense_clarification": "имя (множественное число)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丹尼尔们",
                                "target_lang_sense_clarification": "名字的复数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92ed880e-e7e3-32ad-a972-fdbfb1230d1b",
                    "sense_definition": "A place name used for various towns and communities in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped for gas in <w>Daniels</w> before continuing their journey north.",
                            "target_lang_translations": {
                                "ru": "Они остановились заправиться в <w>Дэниелсе</w>, прежде чем продолжить путь на север.",
                                "zh": "他们在继续向北行驶前，在<w>丹尼尔斯</w>停下来加油。"
                            }
                        },
                        {
                            "text": "The small community of <w>Daniels</w> was originally built around the local mill.",
                            "target_lang_translations": {
                                "ru": "Небольшое поселение <w>Дэниелс</w> изначально было построено вокруг местной мельницы.",
                                "zh": "<w>丹尼尔斯</w>这个小社区最初是围绕当地的磨坊建立的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных городов и населенных пунктов в США.",
                        "zh": "美国多个城镇和社区的地名。"
                    },
                    "translations": {
