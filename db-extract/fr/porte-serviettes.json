                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f9b4db4-324e-44e5-9f69-cee1492c3a53",
                                "sense_id": "1ce25d1f-96e2-3fb4-9b86-679b54ce391c",
                                "text": "Dans de grands silences où on n'entendait qu'une « demie » qui sonnait, ou une serviette qui glissait toute seule et tombait du porte-serviettes dans le lavabo."
                            },
                            {
                                "example_id": "f8b3657b-73f9-49ed-9c26-abb3cb6a0c5d",
                                "sense_id": "1ce25d1f-96e2-3fb4-9b86-679b54ce391c",
                                "text": "Il saisit, lève du porte-serviettes, un gant violet pour la propreté du derrière, qu’il a mouillé, frotté d’un micro-savon de Marseille en forme de cube, vert."
                            }
                        ]
