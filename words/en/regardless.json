{
    "word_family": [
        "regard",
        "regarding",
        "regardful"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "32c4b262-fc3b-36fc-b5b7-faf73a98955c",
                    "sense_definition": "Paying no attention to something or someone; treating something as not important.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ignoring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law requires equal treatment for all citizens, <w>regardless</w> of their background.",
                            "target_lang_translations": {
                                "ru": "Закон требует равного отношения ко всем гражданам <w>независимо</w> от их происхождения.",
                                "de": "Das Gesetz verlangt eine Gleichbehandlung aller Bürger, <w>ungeachtet</w> ihrer Herkunft.",
                                "zh": "法律要求对所有公民一视同仁，<w>不管</w>他们的背景如何。"
                            }
                        },
                        {
                            "text": "She decided to buy the dress <w>regardless</w> of the high cost.",
                            "target_lang_translations": {
                                "ru": "Она решила купить платье, <w>невзирая</w> на высокую цену.",
                                "de": "Sie entschied sich, das Kleid <w>ungeachtet</w> des hohen Preises zu kaufen.",
                                "zh": "她决定买下那件裙子，<w>不顾</w>价格昂贵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heedless",
                        "negligent",
                        "careless",
                        "irrespective"
                    ],
                    "common_phrases": [
                        "regardless of",
                        "regardless of consequences",
                        "regardless of cost",
                        "regardless of age"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обращая внимания на что-либо или кого-либо; считая что-либо неважным.",
                        "de": "Ohne Rücksicht auf etwas oder jemanden; etwas als unwichtig betrachtend.",
                        "zh": "不顾及某事或某人；认为某事不重要。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "независимо",
                                "target_lang_sense_clarification": "обычно используется с предлогом 'от'"
                            },
                            {
                                "target_lang_word": "невзирая",
                                "target_lang_sense_clarification": "обычно используется с предлогом 'на'"
                            },
                            {
                                "target_lang_word": "несмотря",
                                "target_lang_sense_clarification": "обычно используется с предлогом 'на'"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ungeachtet",
                                "target_lang_sense_clarification": "wird meist mit dem Genitiv verwendet"
                            },
                            {
                                "target_lang_word": "unabhängig von",
                                "target_lang_sense_clarification": "drückt aus, dass etwas keinen Einfluss hat"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不管",
                                "target_lang_sense_clarification": "表示不考虑某种情况"
                            },
                            {
                                "target_lang_word": "不顾",
                                "target_lang_sense_clarification": "表示不顾及某种因素"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2a902e11-38f9-3a6a-8a49-70c0b0bef5c9",
                    "sense_definition": "Despite the prevailing circumstances, warnings, or difficulties; anyway.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "despite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was raining heavily, but we went out for a walk <w>regardless</w>.",
                            "target_lang_translations": {
                                "ru": "Шел сильный дождь, но мы <w>всё равно</w> пошли гулять.",
                                "de": "Es regnete stark, aber wir gingen <w>trotzdem</w> spazieren.",
                                "zh": "外面下着大雨，但我们<w>还是</w>出去散步了。"
                            }
                        },
                        {
                            "text": "He knew the plan was risky, but he chose to carry on <w>regardless</w>.",
                            "target_lang_translations": {
                                "ru": "Он знал, что план рискованный, но решил продолжать <w>несмотря ни на что</w>.",
                                "de": "Er wusste, dass der Plan riskant war, aber er entschied sich, <w>dennoch</w> weiterzumachen.",
                                "zh": "他知道计划有风险，但他选择<w>无论如何</w>都要继续下去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anyway",
                        "anyhow",
                        "in any case"
                    ],
                    "antonyms": [
                        "carefully"
                    ],
                    "common_phrases": [
                        "carry on regardless",
                        "press on regardless"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несмотря на сложившиеся обстоятельства, предупреждения или трудности; в любом случае.",
                        "de": "Trotz der vorherrschenden Umstände, Warnungen oder Schwierigkeiten; auf jeden Fall.",
                        "zh": "尽管有现有的情况、警告或困难；无论如何。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всё равно",
                                "target_lang_sense_clarification": "в любом случае"
                            },
                            {
                                "target_lang_word": "несмотря ни на что",
                                "target_lang_sense_clarification": "вопреки всему"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "trotzdem",
                                "target_lang_sense_clarification": "drückt einen Gegensatz zu den Umständen aus"
                            },
                            {
                                "target_lang_word": "dennoch",
                                "target_lang_sense_clarification": "formellere Variante für 'trotzdem'"
                            },
                            {
                                "target_lang_word": "auf jeden Fall",
                                "target_lang_sense_clarification": "betont die Entschlossenheit trotz Hindernissen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "还是",
                                "target_lang_sense_clarification": "表示在某种情况下依然做某事"
                            },
                            {
                                "target_lang_word": "无论如何",
                                "target_lang_sense_clarification": "表示不管怎样都要做"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "13908f6d-fd59-36e8-9fad-3f03db2ddffd",
                    "sense_definition": "Paying no attention to; used exactly like 'regardless of' but without the word 'of'.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ignoring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They continued to play the match <w>regardless</w> the bad weather.",
                            "target_lang_translations": {
                                "ru": "Они продолжили матч, <w>невзирая</w> на плохую погоду.",
                                "de": "Sie spielten das Spiel <w>ungeachtet</w> des schlechten Wetters weiter.",
                                "zh": "他们<w>不顾</w>恶劣天气，继续进行比赛。"
                            }
                        },
                        {
                            "text": "He ate the food <w>regardless</w> the expiration date.",
                            "target_lang_translations": {
                                "ru": "Он съел еду, <w>несмотря</w> на истекший срок годности.",
                                "de": "Er aß das Essen <w>ungeachtet</w> des Ablaufdatums.",
                                "zh": "他<w>不顾</w>保质期，把食物吃了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Standard English requires 'of' after regardless."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обращая внимания на; используется так же, как 'regardless of', но без предлога 'of'.",
                        "de": "Ohne Rücksicht auf; wird ähnlich wie 'regardless of' verwendet, jedoch ohne das Wort 'of'.",
                        "zh": "不注意；用法与 regardless of 相同，但省略了 of。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невзирая",
                                "target_lang_sense_clarification": "на что-либо"
                            },
                            {
                                "target_lang_word": "несмотря",
                                "target_lang_sense_clarification": "на что-либо"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ungeachtet",
                                "target_lang_sense_clarification": "drückt aus, dass etwas ignoriert wird"
                            },
                            {
                                "target_lang_word": "unbeschadet",
                                "target_lang_sense_clarification": "formeller Ausdruck für 'ohne Rücksicht auf'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不顾",
                                "target_lang_sense_clarification": "表示无视某种情况"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}