                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8db2d3b1-a3b0-4e66-ab8e-c3d3b523718c",
                        "entry_id": "092de636-b0d6-373f-be61-3ce3bf72139a",
                        "tags": [
                            "plural"
                        ],
                        "form": "paléographies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68535004-7aab-3b18-a231-29e09bd07797",
                        "entry_id": "092de636-b0d6-373f-be61-3ce3bf72139a",
                        "glosses": [
                            "Science des écritures anciennes, art de les déchiffrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69bb753d-4f35-4b71-b99d-f8a0cefb5e5c",
                                "sense_id": "68535004-7aab-3b18-a231-29e09bd07797",
                                "text": "Traité de paléographie."
                            },
                            {
                                "example_id": "cd2656d4-2f43-4ea7-ad81-8ed8d2412dc5",
                                "sense_id": "68535004-7aab-3b18-a231-29e09bd07797",
                                "text": "La paléographie a un domaine illimité, qui s'étend à toutes les parties du monde où, depuis quelque six millénaires, on a fixé le langage humain par des signes conventionnels destinés à le transmettre et à le conserver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf764385-3fa6-445e-bfb7-eec275552f91",
                        "source_entry_id": "092de636-b0d6-373f-be61-3ce3bf72139a",
                        "source_sense_id": "68535004-7aab-3b18-a231-29e09bd07797",
                        "target_lang_word": "Paläografie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paläografie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7575c43f-4817-3730-a121-94aa404a0b71",
                                        "entry_id": "df1ba4d5-8fdf-39e0-9dd0-e0d25a25473a",
                                        "glosses": [
                                            "Lehre von alten Schriften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f94f467-8675-4217-8937-b91310fc54bf",
                                                "sense_id": "7575c43f-4817-3730-a121-94aa404a0b71",
                                                "text": "„Die Schrift ist makelloses klassisches Griechisch und mehrere Studenten der Paläografie haben bestätigt, dass die Buchstaben in einer Kursivschrift zu Papier gebracht wurden, wie sie im 2. Jahrhundert vor Christus gebräuchlich war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7133c6c6-7fd3-4d86-9608-f35fd1d0d385",
                        "source_entry_id": "092de636-b0d6-373f-be61-3ce3bf72139a",
                        "source_sense_id": "68535004-7aab-3b18-a231-29e09bd07797",
                        "target_lang_word": "Paläographie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paläographie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e87eda7-6342-3327-be89-aaf98a47fa76",
                                        "entry_id": "ea13ae4c-903e-34b6-976f-c88b99408ed8",
                                        "glosses": [
                                            "Lehre von alten Schriften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f82b378-e39c-4d25-8fe1-4b96a4e1316d",
                                                "sense_id": "6e87eda7-6342-3327-be89-aaf98a47fa76",
                                                "text": "Die Paläographie ist eine historische Hilfswissenschaft."
                                            },
                                            {
                                                "example_id": "7636cf63-aa35-4155-9aa5-d4f82e7ccaa7",
                                                "sense_id": "6e87eda7-6342-3327-be89-aaf98a47fa76",
                                                "text": "„Einmal hat man die Möglichkeit, nach diesem Modell innerhalb der Paläographie (der historischen Handschriftenkunde) systematischer – bewußter systematisch – zu arbeiten als bisher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b60b7373-dda9-44eb-976b-0db5d39d97d0",
                        "source_entry_id": "092de636-b0d6-373f-be61-3ce3bf72139a",
                        "source_sense_id": "68535004-7aab-3b18-a231-29e09bd07797",
                        "target_lang_word": "paleography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paleography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d4b4c12-6c07-3cd8-8b54-a1e96061675d",
                                        "entry_id": "30a2e342-2ac1-3927-a4ca-616ccc03f712",
                                        "glosses": [
                                            "The study of old or ancient forms of writing."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd370e27-4e9e-41ee-aa6d-85ad9f8636aa",
                                                "sense_id": "4d4b4c12-6c07-3cd8-8b54-a1e96061675d",
                                                "text": "Paleography might teach men to read documents, diplomatics to date them and to test their authenticity; but the full significance of an ancient deed might easily escape the most exact paleographer and the most accomplished diplomatist, for the want of that finished sense for legal technicality which is the natural fruit of a conveyancing practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbf43a31-8f5e-31d9-9280-dbd9326d3f7d",
                                        "entry_id": "30a2e342-2ac1-3927-a4ca-616ccc03f712",
                                        "glosses": [
                                            "Ancient scripts or forms of writing themselves, as uncial, scriptio continua, or methods of using papyrus scrolls."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90094219-1025-3165-8a7c-5efa68a9f8af",
                                        "entry_id": "30a2e342-2ac1-3927-a4ca-616ccc03f712",
                                        "glosses": [
                                            "Paleogeography."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a174631-9155-40fe-b150-66833de38cdc",
                        "source_entry_id": "092de636-b0d6-373f-be61-3ce3bf72139a",
