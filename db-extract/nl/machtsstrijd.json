                            {
                                "example_id": "1fbfd819-ea3a-4f53-b0d5-580b16e4dc47",
                                "sense_id": "79313a36-585c-3deb-86ae-e1c2d49bde6a",
                                "text": "De twee prinsen voerden een machtsstrijd op leven en dood wie koning mocht worden."
                            }
                        ]
