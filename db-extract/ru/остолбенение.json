                "senses": [
                    {
                        "sense_id": "65a6ef0b-068c-3c65-85ff-c95b6998f38b",
                        "entry_id": "cf9097a7-037d-3ad0-a527-41ccb14f4136",
                        "glosses": [
                            "stupefaction"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e7220e2-7133-4c97-a269-63edb871c52c",
                                "sense_id": "65a6ef0b-068c-3c65-85ff-c95b6998f38b",
                                "text": "— Жа́лкие лю́ди! — сказа́л я штабс-капита́ну, ука́зывая на на́ших гря́зных хозя́ев, кото́рые мо́лча на нас смотре́ли в како́м-то остолбене́нии.",
                                "translation": "\"Pitiable creatures!\" I observed to the captain, nodding toward our grimy hosts who stared at us silently with something like stupefaction.",
                                "english": "\"Pitiable creatures!\" I observed to the captain, nodding toward our grimy hosts who stared at us silently with something like stupefaction."
                            }
                        ]
                    }
