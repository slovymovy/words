                "senses": [
                    {
                        "sense_id": "99da5836-59c4-388d-a9e6-a998a2fa2abf",
                        "entry_id": "5590b301-b90c-3bf7-b30e-f889dc638f41",
                        "glosses": [
                            "zwölfter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6af0917-51f3-4b87-867c-08676e7fee69",
                                "sense_id": "99da5836-59c4-388d-a9e6-a998a2fa2abf",
                                "text": "Mit 1. Jänner 1892 wurden alle diese Gemeinden zum 12. Wiener Gemeindebezirk Meidling vereinigt, der einen typischen Arbeiterbezirk darstellte."
                            },
                            {
                                "example_id": "6b6142e4-506b-451f-b946-298ef88a60d7",
                                "sense_id": "99da5836-59c4-388d-a9e6-a998a2fa2abf",
                                "text": "Kunden der Südbahn steigen jetzt am Bahnhof Meidling aus, von dort aus benützen Konzertbesucher am besten die U6 bis Längenfeldgasse und danach die U4 nach Schönbrunn."
                            },
                            {
                                "example_id": "f27f375f-0913-4ced-8764-82926c436a3d",
                                "sense_id": "99da5836-59c4-388d-a9e6-a998a2fa2abf",
                                "text": "In Wien ist am Freitagnachmittag ein Bub in einem Auto zur Welt gekommen. Die werdenden Eltern waren gerade am Weg ins Krankenhaus und hielten in Meidling Polizisten auf."
                            },
                            {
                                "example_id": "6b20fbcf-ccbe-4dcd-85ae-f77a31da897d",
                                "sense_id": "99da5836-59c4-388d-a9e6-a998a2fa2abf",
                                "text": "Kurz wuchs in Wien-Meidling auf, leistete den Grundwehrdienst und studiert Rechtswissenschaften – am Wiener Juridicum."
                            },
                            {
                                "example_id": "7b10bcbf-fd27-470e-8534-a6c6b9dcfa9b",
                                "sense_id": "99da5836-59c4-388d-a9e6-a998a2fa2abf",
                                "text": "Ursprünglich hätte hier – wie auf ganz Meidling – am 1. Oktober die Parkraumbewirtschaftung ausgeweitet werden sollen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
