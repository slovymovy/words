                "senses": [
                    {
                        "sense_id": "eef0b4dd-2dbe-3930-ab71-cbd0bd426c89",
                        "entry_id": "7bef1011-8394-3e56-80fd-cefc8bdb0bef",
                        "glosses": [
                            "world trip, round-the-world trip (prolonged voyage or vacation in various parts of the world)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "5263fc40-17e8-49f2-a497-471df68b0d89",
                                "sense_id": "eef0b4dd-2dbe-3930-ab71-cbd0bd426c89",
                                "text": "Wir haben das Haus vermietet und sind auf zweijährige Weltreise gegangen.",
                                "translation": "We rented out the house and went on a two-year world trip.",
                                "english": "We rented out the house and went on a two-year world trip."
                            }
                        ]
                    },
                    {
                        "sense_id": "31820927-3348-3d67-8858-5e689c3c7d45",
                        "entry_id": "7bef1011-8394-3e56-80fd-cefc8bdb0bef",
                        "glosses": [
                            "a long distance, a lengthy way"
                        ],
                        "tags": [
                            "feminine",
                            "figuratively",
                            "informal",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "67658a4a-0ca3-4aaa-96fc-913aa5b5fb89",
                                "sense_id": "31820927-3348-3d67-8858-5e689c3c7d45",
                                "text": "Ich will jetzt keine halbe Weltreise machen, nur um da zwei Bier zu trinken, was wir hier genauso gut können."
                            }
                        ]
                    }
                ],
