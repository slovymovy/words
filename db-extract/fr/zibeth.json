                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05a1ef10-07d2-4f02-b4ed-16493fa20eba",
                                                "sense_id": "f34251c0-2308-3de6-af37-51d42bb8342c",
                                                "text": "Two allied species of carnivora, civets and zibeths, furnish most of the musk used in pharmacy and perfumery."
                                            }
                                        ]
                                    }
                                ]
                            }
