        "pl-extract.jsonl": [
            {
                "entry_id": "797dd6af-2e8c-3793-a81e-7d31cd0be0b4",
                "word": "sowas",
                "pos": "pron",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5775666-58a4-3a87-b756-085843e63c86",
                        "entry_id": "797dd6af-2e8c-3793-a81e-7d31cd0be0b4",
                        "glosses": [
                            "coś takiego, coś podobnego, takie coś"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "66adcb4a-f2fb-40d2-9368-5118464405cb",
                                "sense_id": "b5775666-58a4-3a87-b756-085843e63c86",
                                "text": "Sowas(/So was) passiert nicht alle Tage.",
                                "translation": "Coś takiego nie zdarza się codziennie."
                            },
                            {
                                "example_id": "0ec25307-9ff3-43c6-a90e-d702d316e571",
                                "sense_id": "b5775666-58a4-3a87-b756-085843e63c86",
                                "text": "Ich würde wegen sowas(/so was) nicht zum Arzt gehen.",
                                "translation": "Ja z powodu czegoś takiego nie szłabym/szedłbym do lekarza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9491b4ad-7d71-3b04-af56-df3a1a0200a8",
                        "entry_id": "797dd6af-2e8c-3793-a81e-7d31cd0be0b4",
                        "glosses": [
                            "coś takiego, ktoś taki, taki ktoś"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "708dc62c-0cdf-4792-a08b-aaa521819bd1",
                                "sense_id": "9491b4ad-7d71-3b04-af56-df3a1a0200a8",
                                "text": "Und sowas(/so was) nennt sich Pädagoge!",
                                "translation": "I ktoś taki nazywa się pedagogiem!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "f452efa4-7ba7-3fab-9e54-2c42b24dd1f5",
                        "entry_id": "797dd6af-2e8c-3793-a81e-7d31cd0be0b4",
                        "glosses": [
                            "(w połączeniu z von) już taki, już tak"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c7aa0930-c285-40e5-90f8-02bf01854045",
                                "sense_id": "f452efa4-7ba7-3fab-9e54-2c42b24dd1f5",
                                "text": "Sowas(/So was) von dumm hat die Welt noch nicht gesehen!",
                                "translation": "Czegoś już tak głupiego świat jeszcze nie widział!"
                            },
                            {
                                "example_id": "4c6df6ff-7394-493a-86cd-6e41611bfe95",
                                "sense_id": "f452efa4-7ba7-3fab-9e54-2c42b24dd1f5",
                                "text": "Sowas(/So was) von Frechheit!",
                                "translation": "To już taka bezczelność!"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [],
