                        "glosses": [
                            "Donner un caractère fractionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d45929f4-1ccc-4787-9c61-3b571efb1ac1",
                                "sense_id": "f093ab57-9a1c-3a76-8300-1ec2da9e3516",
                                "text": "Sous l’action d’un champ magnétique, on sait également fractionnaliser ces paires monopôle-antimonopôle arrivant même dans certains cas à n’en laisser qu’un dans le réseau."
                            },
                            {
                                "example_id": "db4fcd4f-90d3-4246-a0f2-82f581911abb",
                                "sense_id": "f093ab57-9a1c-3a76-8300-1ec2da9e3516",
                                "text": "Un électron émis par le condensateur mésoscopique subit d’abord une relaxation en énergie rapide, due à des effets de décohérence extrinsèque avec son environnement, avant de se fractionnaliser sous l’effet des interactions."
                            }
                        ]
                    }
