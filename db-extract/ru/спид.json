                            }
                        ]
                    },
                    {
                        "translation_id": "6ee2b0f0-3e6c-4c1a-87aa-22104bfd5890",
                        "source_entry_id": "90f634e9-369d-37a8-a937-deebb96b6bb7",
                        "target_lang_word": "Aids",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aids",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                        "entry_id": "02f1501b-d5ad-387a-a0f9-0905e13b39da",
                                        "glosses": [
                                            "Immunschwächekrankheit AIDS durch Infektion mit dem HI-Virus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39fe3dc-96f1-4e58-b92e-adc3d68496a0",
                                                "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                                "text": "Aids ist eine weltweit verbreitete, unheilbare Krankheit, die jährlich viele Todesopfer fordert."
                                            },
                                            {
                                                "example_id": "6b388dc5-e85a-4b0f-8416-47d98db3020d",
                                                "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                                "text": "„Aids, da ist der Gottesmann sich sicher, ist die Pestilenz, mit der der allmächtige Herr all jene straft, die sich von ihm abgewandt haben.“"
                                            },
                                            {
                                                "example_id": "3cbdb69a-28d7-45f5-b2c6-7d8752639a11",
                                                "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                                "text": "„Allerdings hat es wahrscheinlich was mit Aids zu tun.“"
                                            },
                                            {
                                                "example_id": "b80b71ed-4e0e-43c9-be38-e4a5926dbcfd",
                                                "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                                "text": "„Dieser furchtbare Zustand wiederholte sich, als Aids als Krankheit bekannt wurde.“"
                                            },
                                            {
                                                "example_id": "bd8492ca-507f-4517-bb27-4652a91ee867",
                                                "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                                "text": "„Allerdings ist HIV medial nicht deswegen so ein großes Thema, weil so viele Menschen daran sterben, sondern weil viele Prominente an Aids erkranken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cca25ada-63c9-45cf-9971-1b18e11d6f5b",
                        "source_entry_id": "90f634e9-369d-37a8-a937-deebb96b6bb7",
                        "target_lang_word": "AIDS",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "AIDS",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bd0f17e-d265-30bd-8010-4062a106dfda",
                                        "entry_id": "1030db30-8baf-3011-a8a7-3087a845a5ef",
                                        "glosses": [
                                            "aus einer Infektion mit dem HI-Virus resultierende Summe von Erkrankungen (sogenannte \\\"AIDS definierende Erkrankungen\\\"), die als \\\"AIDS Vollbild\\\" (umgangssprachlich kurz: AIDS) zusammengefasst werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7973785-71d1-451e-8cf9-b7012245de67",
                                                "sense_id": "2bd0f17e-d265-30bd-8010-4062a106dfda",
                                                "text": "Die unheilbare Krankheit AIDS hat schon unzählige Menschenleben gefordert, vor allem in Südafrika."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c2c4902-c956-49d2-8bc4-5c9f061b0694",
                        "source_entry_id": "90f634e9-369d-37a8-a937-deebb96b6bb7",
                        "target_lang_word": "sida",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sida",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4dc3911-fdce-3d8a-b8eb-a98d71385d0b",
                                        "entry_id": "328f94b2-f792-3a8d-986d-7764561a5ba2",
                                        "glosses": [
                                            "Syndrome humain caractéristique d’une ou plusieurs maladies relevant d’un déficit immunitaire de l’organisme."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0e6f451-6fe3-42a9-b8e5-7ea6e37cd2ee",
                                                "sense_id": "e4dc3911-fdce-3d8a-b8eb-a98d71385d0b",
                                                "text": "— C'est ça ! Ramène-nous le sida, tiens ! Ce sera le pompon ! En tout cas, je te préviens pour la dernière fois : si tu continues ainsi, je te coupe les vivres ! Tu es prévenu."
                                            },
                                            {
                                                "example_id": "262f8018-39c4-4f32-bf42-c58e653daf7f",
                                                "sense_id": "e4dc3911-fdce-3d8a-b8eb-a98d71385d0b",
                                                "text": "Les personnes atteintes du sida (syndrome immunodéficitaire acquis) sont plus sensibles aux maladies transmises par les animaux. Le virus responsable du sida affaiblit leurs défenses immunitaires, ce qui les rend incapables de réagir aux infections."
                                            },
                                            {
                                                "example_id": "ea42c3a7-bf2b-4385-a186-be31faee9d29",
                                                "sense_id": "e4dc3911-fdce-3d8a-b8eb-a98d71385d0b",
                                                "text": "Ce refus d’une sélection des donneurs, qui est la principale cause du nombre élevé de sidas post-transfusionnels en France, a donc été inspiré par des arrière-pensées idéologiques respectables mais hors de propos."
                                            },
                                            {
                                                "example_id": "2a0a5c00-cbdd-40a3-98e1-2d89f389b571",
                                                "sense_id": "e4dc3911-fdce-3d8a-b8eb-a98d71385d0b",
                                                "text": "Soit les assauts du conquistador s'arrêtaient au seuil de la couche, soit, si la consommation avait lieu, se déchaînaient ensuite une succession interminable d'examens médicaux : sida, syphilis, gonocoque, staphylocoque et j'en passe..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sida",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db5702c2-4743-303e-bb9e-5cfb573f9d55",
                                        "entry_id": "68bd996f-f0dd-379f-8e82-f876c726ff97",
                                        "glosses": [
                                            "Dicotylédone de la famille des malvacées comme par exemple la guimauve. Plusieurs espèces sont utilisées soit comme astringent soit comme aphrodisiaque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a62c74e9-1e04-40f9-8a58-7d3c592200d0",
                                                "sense_id": "db5702c2-4743-303e-bb9e-5cfb573f9d55",
                                                "text": "En Inde, on cultive le sida rhombifolia pour ses fibres textiles."
                                            },
                                            {
                                                "example_id": "13336191-64c0-4685-9d39-f4f677c2fe0b",
                                                "sense_id": "db5702c2-4743-303e-bb9e-5cfb573f9d55",
                                                "text": "Excepté la seconde espèce qui est d’orangerie, tous les autres sidas sont de serre chaude."
                                            }
                                        ]
