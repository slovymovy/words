                        "entry_id": "e4cb943e-8617-38f1-90ca-ce367e96a980",
                        "glosses": [
                            "Polymère cyclique d’acétaldéhyde, de formule brute (CH₃CHO)₂, phytosanitaire molluscicide (employé pour tuer des limaces et autres gastéropodes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214231e9-7899-4aa3-a7b3-cacfce295313",
                                "sense_id": "54c52ff0-c532-3bf0-bd8f-a656cee7f208",
                                "text": "Pour venir à bout de ce mollusque destructeur, les autorités utilisent aussi du métaldéhyde, sorte d'anti-limace inoffensif pour l'homme et les animaux, promet l'État."
                            },
                            {
                                "example_id": "0bbf0504-b7d7-4eaa-ada5-b3c1a7a5cee9",
                                "sense_id": "54c52ff0-c532-3bf0-bd8f-a656cee7f208",
                                "text": "Le métaldéhyde est un composé organique qui entre dans la composition des anti-limaces."
                            }
                        ]
                    }
