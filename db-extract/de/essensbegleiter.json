                "senses": [
                    {
                        "sense_id": "cf45a48f-ee20-34a7-baca-39f456fee663",
                        "entry_id": "eae3d55e-6892-30a1-8854-fa2a285733fb",
                        "glosses": [
                            "etwas (zum Beispiel ein Getränk), das man begleitend zum Essen zu sich nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e89016-53d0-4ea4-b462-184c9be0a588",
                                "sense_id": "cf45a48f-ee20-34a7-baca-39f456fee663",
                                "text": "„Als Essensbegleiter bieten sich die vorwiegend aus Friaul stammenden Weine von anerkannten Winzern an.“"
                            },
                            {
                                "example_id": "d89f7049-f298-4797-a4a0-c64118ff0bfb",
                                "sense_id": "cf45a48f-ee20-34a7-baca-39f456fee663",
                                "text": "„Die Rotweine sind voll und lebhaft mit schönen Tanninen, die Weißen geben feine Essensbegleiter ab.“"
                            },
                            {
                                "example_id": "aa5e414a-b49e-486b-94b6-ef97b11bcbf6",
                                "sense_id": "cf45a48f-ee20-34a7-baca-39f456fee663",
                                "text": "„Sie müssen sich einfach vorstellen: Auf einer Party will man nicht andächtig genießen, sondern einen Wein zum Erfrischen und als Essensbegleiter.“"
                            },
                            {
                                "example_id": "3a4e5495-79b9-4a72-960f-62bfef268b88",
                                "sense_id": "cf45a48f-ee20-34a7-baca-39f456fee663",
                                "text": "„Weißburgunder ist ein wunderbarer Essensbegleiter zu hellem Geflügel, Spargel oder Fisch, macht aber auch als Solist eine gute Figur.“"
                            },
                            {
                                "example_id": "5f823393-5bbc-4034-b258-5071f8fec9df",
                                "sense_id": "cf45a48f-ee20-34a7-baca-39f456fee663",
                                "text": "„Gute Grauburgunder sind im Allgemeinen sehr unkomplizierte, flexible Essensbegleiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
