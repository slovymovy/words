                ],
                "senses": [
                    {
                        "sense_id": "2be27c6c-388a-35f2-a6f6-b3a0ed56b161",
                        "entry_id": "496bc8ab-a5f3-3923-b55c-7c1f9200d048",
                        "glosses": [
                            "Donner un caractère choral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5fd0ee5-12cc-42c3-9da5-a39af0b89a66",
                                "sense_id": "2be27c6c-388a-35f2-a6f6-b3a0ed56b161",
                                "text": "Il fallait créer la matière première, le matériau de base; alors j’ai entendu cette harmonie d’où tout est sorti... le matériau était trouvé; il restait à l’organiser, à le choraliser, à l’orchestrifier!…"
                            },
                            {
                                "example_id": "6754a9e3-7416-4a9c-8065-a05d0a5b290b",
                                "sense_id": "2be27c6c-388a-35f2-a6f6-b3a0ed56b161",
                                "text": "Avec Frédéric Cherboeuf, comédien, ils ont inventé un dispositif qui a permis de choraliser la parole monologique de La Conférence."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ce7b204-a3ee-3981-b810-b22e2bb8f6de",
                        "entry_id": "496bc8ab-a5f3-3923-b55c-7c1f9200d048",
                        "glosses": [
                            "Chanter dans un chœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77778e6d-ea7e-4eb5-a44c-79eab2405cc0",
                                "sense_id": "5ce7b204-a3ee-3981-b810-b22e2bb8f6de",
                                "text": "Car s’il fait danser des rustres aux soirs des dimanches, il les fait, le matin, choraliser pieusement."
                            }
                        ]
                    }
                ],
