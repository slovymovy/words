                ],
                "senses": [
                    {
                        "sense_id": "6b75228d-b44b-36ed-beb2-33cbe2017291",
                        "entry_id": "087b09d6-c6d5-3e0f-9f49-e7a90b113716",
                        "glosses": [
                            "Additionner de lactose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a27999c9-b6d9-4423-8c0e-d9fab1f909d0",
                                "sense_id": "6b75228d-b44b-36ed-beb2-33cbe2017291",
                                "text": "Quand l'enfant est parvenu à l'âge de prendre du lait de vache pur, c'est-à-dire à 6 mois, on se contente de lactoser ce lait en y ajoutant 2 pc de lactose."
                            },
                            {
                                "example_id": "ad5510f5-37a5-4432-80cd-da563ef48a01",
                                "sense_id": "6b75228d-b44b-36ed-beb2-33cbe2017291",
                                "text": "A la tète de cette coopérative se trouveraient des personnes de bonne volonté, ayant l'expérience des affaires, qui constitueraient le conseil d'administration, un personnel spécialement choisi centraliserait ainsi tout le lait recueilli à la campagne pour le pasteuriser ou le stériliser, le lactoser, le mettre en flacons et le céder ensuite aux différentes Gouttes de Lait."
                            }
                        ]
                    }
