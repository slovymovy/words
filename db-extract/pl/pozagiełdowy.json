                        "source_sense_id": "f94acfc6-1c10-3d77-978c-de4532534e0b",
                        "target_lang_word": "over-the-counter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "over-the-counter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4af23275-1503-34ac-b91f-5b37818bd071",
                                        "entry_id": "5af78f93-e9fd-3de3-b0e2-437a4e1f2851",
                                        "glosses": [
                                            "Legal for sale or distribution without the requirement of a prescription."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "237cba3f-6183-4081-abe3-82769d62f96b",
                                                "sense_id": "4af23275-1503-34ac-b91f-5b37818bd071",
                                                "text": "The US Food and Drug Administration has approved the oral contraceptive Opill for over-the-counter use, making it the first nonprescription birth control pill in the United States, but it will be months before it’s available."
                                            },
                                            {
                                                "example_id": "b56017f0-ee09-479e-95b8-0e4e0c4d19f3",
                                                "sense_id": "4af23275-1503-34ac-b91f-5b37818bd071",
                                                "text": "over-the-counter drug, over-the-counter medicine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46aff8d4-420a-3abe-8f7c-65b0d3eeb210",
                                        "entry_id": "5af78f93-e9fd-3de3-b0e2-437a4e1f2851",
                                        "glosses": [
                                            "Involving direct interaction between two parties without an intermediary, and denoting any market where items such as stocks or currency are bought and sold by direct arrangement between counterparties, or through a private broker, rather than on a public stock exchange or other exchange."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc16684b-5279-41ea-9b79-5c9c78b338b4",
                                                "sense_id": "46aff8d4-420a-3abe-8f7c-65b0d3eeb210",
                                                "text": "over-the-counter trade, over-the-counter market"
                                            },
                                            {
                                                "example_id": "d31a6609-d0f7-48d3-bcdb-7bef46f45b0a",
                                                "sense_id": "46aff8d4-420a-3abe-8f7c-65b0d3eeb210",
                                                "text": "This is \"commencement week\" in \"over-the-counter insurance\" circles, the Whitman, Mass., savings bank having opened the ball with four applications made for $300 each by three prominent business men […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
