                "senses": [
                    {
                        "sense_id": "fd705bf9-59cc-307c-891e-43c3a3b16b30",
                        "entry_id": "2a1c1d8c-ab8f-3764-85fb-a782a1c19fe3",
                        "glosses": [
                            "Nom d’un tonneau usité en Bourgogne, dans le Beaujolais, en Isère, etc. variant de capacité, 66 litres, 57 litres, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0844f7f2-b7de-4bd5-8243-85aca35fd24f",
                                "sense_id": "fd705bf9-59cc-307c-891e-43c3a3b16b30",
                                "text": "BARAL, Barral. Ancienne mesure de capacité pour liquides, usitée dans le midi de la France."
                            },
                            {
                                "example_id": "8bc155a0-837e-42b5-a44a-88aabe2854f5",
                                "sense_id": "fd705bf9-59cc-307c-891e-43c3a3b16b30",
                                "text": "Au retour, on y chargera le barral (tonneau sans cannelle contenant environ 45 litres et fait en bois de sapin pour être plus léger) au lieu de se le coltiner jusqu’au sommet, comme autrefois."
                            },
                            {
                                "example_id": "5fed7424-7d8d-46be-ad55-9d314b48eb57",
                                "sense_id": "fd705bf9-59cc-307c-891e-43c3a3b16b30",
                                "text": "Heureusement que l’année suivante, le baron de Monclar récolte 60 charges de raisin qui produisent 131 barraux de vin clair et 16 barraux d’eau de vie."
                            }
                        ]
                    }
                ],
