                "entry_id": "32718ab2-06b3-32eb-af56-4783f17c7538",
                "word": "biogenesis",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6535aa49-05b7-445c-ad55-f3dbded07436",
