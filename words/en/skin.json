{
    "word_family": [
        "skinny",
        "skinner",
        "skinless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "904a3974-84c1-3ae5-bb3d-eba52290bee6",
                    "sense_definition": "The outer protective layer of the body of any animal, including of a human.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "outer_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has very pale <w>skin</w> that burns easily in the sun.",
                            "target_lang_translations": {
                                "ru": "У нее очень бледная <w>кожа</w>, которая легко обгорает на солнце.",
                                "zh": "她的<w>皮肤</w>很白，在太阳下很容易晒伤。"
                            }
                        },
                        {
                            "text": "The snake sheds its <w>skin</w> once a year as it grows.",
                            "target_lang_translations": {
                                "ru": "Змея сбрасывает <w>кожу</w> раз в год, когда растет.",
                                "zh": "蛇在生长过程中每年会蜕一次<w>皮</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hide",
                        "pelt"
                    ],
                    "common_phrases": [
                        "dry skin",
                        "sensitive skin",
                        "fair skin",
                        "skin care",
                        "skin color"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наружный защитный слой тела любого животного, включая человека.",
                        "zh": "人和动物身体表面的保护层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кожа",
                                "target_lang_sense_clarification": "человека или животного"
                            },
                            {
                                "target_lang_word": "шкура",
                                "target_lang_sense_clarification": "животного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皮肤",
                                "target_lang_sense_clarification": "人体或动物的表皮"
                            },
                            {
                                "target_lang_word": "皮",
                                "target_lang_sense_clarification": "泛指皮肤或外层"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c501a44c-9334-39a0-b42f-59a2ef7d9a3d",
                    "sense_definition": "The outer protective layer of the fruit of a plant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "outer_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can eat the apple with the <w>skin</w> on if you wash it first.",
                            "target_lang_translations": {
                                "ru": "Яблоко можно есть с <w>кожурой</w>, если предварительно его помыть.",
                                "zh": "如果洗干净了，苹果可以连<w>皮</w>一起吃。"
                            }
                        },
                        {
                            "text": "Be careful not to slip on the banana <w>skin</w> left on the floor.",
                            "target_lang_translations": {
                                "ru": "Осторожно, не поскользнитесь на банановой <w>кожуре</w>, оставленной на полу.",
                                "zh": "小心别踩到地板上留下的香蕉<w>皮</w>滑倒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peel"
                    ],
                    "common_phrases": [
                        "banana skin",
                        "potato skin",
                        "apple skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наружный защитный слой плода растения.",
                        "zh": "植物果实表面的保护层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кожура",
                                "target_lang_sense_clarification": "толстая (банана, апельсина)"
                            },
                            {
                                "target_lang_word": "кожица",
                                "target_lang_sense_clarification": "тонкая (яблока, винограда)"
                            },
                            {
                                "target_lang_word": "шкурка",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皮",
                                "target_lang_sense_clarification": "果皮"
                            },
                            {
                                "target_lang_word": "果皮",
                                "target_lang_sense_clarification": "水果的表皮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3af08893-d22f-3fd3-a3fb-55c33fa7a583",
                    "sense_definition": "The skin and fur of an individual animal used by humans for clothing, upholstery, etc.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter traded beaver <w>skins</w> for supplies at the market.",
                            "target_lang_translations": {
                                "ru": "Охотник обменял бобровые <w>шкуры</w> на припасы на рынке.",
                                "zh": "猎人在市场上用海狸<w>皮</w>换取了补给品。"
                            }
                        },
                        {
                            "text": "They sat on a warm rug made of sheep <w>skin</w>.",
                            "target_lang_translations": {
                                "ru": "Они сидели на теплом коврике из овечьей <w>шкуры</w>.",
                                "zh": "他们坐在用羊<w>皮</w>做的暖和地毯上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hide",
                        "pelt"
                    ],
                    "common_phrases": [
                        "animal skin",
                        "leopard skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шкура и мех животного, используемые людьми для изготовления одежды, обивки и т. д.",
                        "zh": "动物的皮毛，常用于制作衣物或装饰品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкура",
                                "target_lang_sense_clarification": "мех, сырой материал"
                            },
                            {
                                "target_lang_word": "кожа",
                                "target_lang_sense_clarification": "выделанный материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皮毛",
                                "target_lang_sense_clarification": "带毛的动物皮"
                            },
                            {
                                "target_lang_word": "皮革",
                                "target_lang_sense_clarification": "加工后的动物皮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e1c85a9-8d45-34ce-8750-e5e416bacac5",
                    "sense_definition": "A set of resources that modifies the appearance and/or layout of the graphical user interface of a computer program or video game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digital",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a new <w>skin</w> for his character in the game.",
                            "target_lang_translations": {
                                "ru": "Он купил новый <w>скин</w> для своего персонажа в игре.",
                                "zh": "他为游戏里的角色买了一款新<w>皮肤</w>。"
                            }
                        },
                        {
                            "text": "You can download a dark <w>skin</w> to change how the browser looks.",
                            "target_lang_translations": {
                                "ru": "Вы можете скачать темную <w>тему</w>, чтобы изменить внешний вид браузера.",
                                "zh": "你可以下载深色<w>皮肤</w>来改变浏览器的外观。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "default skin",
                        "custom skin",
                        "character skin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор ресурсов, изменяющий внешний вид графического интерфейса компьютерной программы или игры.",
                        "zh": "改变计算机程序或游戏图形界面外观的资源包。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скин",
                                "target_lang_sense_clarification": "комп. жарг."
                            },
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "оформление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皮肤",
                                "target_lang_sense_clarification": "游戏或软件的视觉外观"
                            },
                            {
                                "target_lang_word": "主题",
                                "target_lang_sense_clarification": "界面风格设置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71e87a14-2843-33f4-9099-3aaeb07d8c98",
                    "sense_definition": "A congealed layer on the surface of a liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surface_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thin <w>skin</w> formed on top of the hot milk as it cooled.",
                            "target_lang_translations": {
                                "ru": "На горячем молоке при остывании образовалась тонкая <w>пенка</w>.",
                                "zh": "热牛奶冷却时，表面形成了一层薄<w>皮</w>。"
                            }
                        },
                        {
                            "text": "You need to stir the paint to break the <w>skin</w> before using it.",
                            "target_lang_translations": {
                                "ru": "Нужно размешать краску, чтобы разрушить <w>плёнку</w> перед использованием.",
                                "zh": "使用前你需要搅拌油漆，把表面的<w>皮</w>搅散。"
                            }
                        }
                    ],
                    "synonyms": [
                        "film"
                    ],
                    "common_phrases": [
                        "milk skin",
                        "form a skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Застывший слой на поверхности жидкости.",
                        "zh": "液体表面形成的凝固层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плёнка",
                                "target_lang_sense_clarification": "на краске, жидкости"
                            },
                            {
                                "target_lang_word": "пенка",
                                "target_lang_sense_clarification": "на молоке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皮",
                                "target_lang_sense_clarification": "液体表面形成的薄膜"
                            },
                            {
                                "target_lang_word": "膜",
                                "target_lang_sense_clarification": "表面形成的薄层"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c366348-31e9-3912-a61d-029ec3a8db16",
                    "sense_definition": "To injure the skin of by scraping or rubbing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "injure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fell off his bike and <w>skinned</w> his knee on the concrete.",
                            "target_lang_translations": {
                                "ru": "Он упал с велосипеда и <w>ободрал</w> колено о бетон.",
                                "zh": "他从自行车上摔下来，膝盖在水泥地上<w>擦破</w>了。"
                            }
                        },
                        {
                            "text": "I accidentally <w>skinned</w> my knuckles while fixing the car engine.",
                            "target_lang_translations": {
                                "ru": "Я случайно <w>ободрал</w> костяшки пальцев, когда чинил двигатель машины.",
                                "zh": "修车引擎时，我不小心把指关节<w>擦破</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scrape",
                        "graze",
                        "bark",
                        "chafe"
                    ],
                    "common_phrases": [
                        "skin one's knee",
                        "skin one's elbow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повредить кожу, содрав или натерев её.",
                        "zh": "因擦伤或摩擦而损伤皮肤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ободрать",
                                "target_lang_sense_clarification": "повредить кожу"
                            },
                            {
                                "target_lang_word": "счесать",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦破",
                                "target_lang_sense_clarification": "损伤皮肤表面"
                            },
                            {
                                "target_lang_word": "蹭破",
                                "target_lang_sense_clarification": "因摩擦受损"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4173562b-9607-3780-ad67-9d95ffd2ed30",
                    "sense_definition": "To remove the skin and/or fur of an animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "remove_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter <w>skinned</w> the deer before preparing the meat.",
                            "target_lang_translations": {
                                "ru": "Охотник <w>освежевал</w> оленя перед разделкой мяса.",
                                "zh": "猎人在处理肉之前先给鹿<w>剥皮</w>。"
                            }
                        },
                        {
                            "text": "It takes a lot of skill to <w>skin</w> a rabbit quickly and cleanly.",
                            "target_lang_translations": {
                                "ru": "Требуется большое мастерство, чтобы быстро и чисто <w>освежевать</w> кролика.",
                                "zh": "快速且干净地给兔子<w>剥皮</w>需要很高的技巧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flay"
                    ],
                    "common_phrases": [
                        "skin a cat",
                        "skin a rabbit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снимать кожу и/или мех с животного.",
                        "zh": "剥去动物的皮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свежевать",
                                "target_lang_sense_clarification": "снимать шкуру"
                            },
                            {
                                "target_lang_word": "снимать шкуру",
                                "target_lang_sense_clarification": "фраза"
                            },
                            {
                                "target_lang_word": "обдирать",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剥皮",
                                "target_lang_sense_clarification": "去除动物皮毛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e72a78c-713f-3a8d-bea5-c1bcf6d0f2d9",
                    "sense_definition": "To become covered with new skin during the healing process.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "heal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deep wound will eventually <w>skin</w> over if you keep it clean.",
                            "target_lang_translations": {
                                "ru": "Глубокая рана со временем <w>затянется</w>, если держать её в чистоте.",
                                "zh": "只要保持清洁，深伤口最终会<w>结痂</w>。"
                            }
                        },
                        {
                            "text": "After a few days, the cut <w>skinned</w> over and stopped hurting.",
                            "target_lang_translations": {
                                "ru": "Через несколько дней порез <w>затянулся</w> и перестал болеть.",
                                "zh": "几天后，伤口<w>结痂</w>了，也不再疼了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "skin over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрываться новой кожей в процессе заживления.",
                        "zh": "伤口愈合过程中长出新皮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затягиваться",
                                "target_lang_sense_clarification": "о ране"
                            },
                            {
                                "target_lang_word": "заживать",
                                "target_lang_sense_clarification": "о ране"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结痂",
                                "target_lang_sense_clarification": "伤口表面愈合"
                            },
                            {
                                "target_lang_word": "长好",
                                "target_lang_sense_clarification": "伤口愈合"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}