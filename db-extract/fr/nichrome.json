                        "entry_id": "46f93342-6db0-3fcd-a9f2-26a14203d9a5",
                        "glosses": [
                            "Alliage non magnétique de nickel et de chrome largement utilisé dans des éléments chauffants et aussi dans l’industrie des explosifs et des feux d’artifices ou encore en tant que système d’allumage fiable dans les allumettes électriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c34bba5-7d97-479a-891c-d0c21ca5f6ae",
                                "sense_id": "ac85b1cb-7546-30bb-860f-fd071b0cb1cc",
                                "text": "Le nichrome est apprécié des vapoteurs pour sa tendance à bien accrocher."
                            },
                            {
                                "example_id": "71d8539b-5542-40ec-bb23-aa3da1afd8b3",
                                "sense_id": "ac85b1cb-7546-30bb-860f-fd071b0cb1cc",
                                "text": "Les métaux servant à la confection des résistances de chauffage sont de la classe des aciers spéciaux au nickel à forte teneur et au chrome ; ils sont appelés nichromes."
                            }
                        ]
                    }
