                                        "examples": [
                                            {
                                                "example_id": "40dde80a-c727-4cc6-8fd1-10bae6738597",
                                                "sense_id": "80a07b67-e4e4-38c3-a5f5-31bc2977b9e1",
                                                "text": "He was standing on a chair Velcroing red balloons to himself."
