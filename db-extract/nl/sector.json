                ],
                "senses": [
                    {
                        "sense_id": "b9d806bc-5d64-3120-96cc-1f7550595fb3",
                        "entry_id": "2ebb4a8e-d812-3a76-a444-69702e5f4793",
                        "glosses": [
                            "een deel van een cirkel in de vorm van een taartpunt, omsloten door een cirkelboog en twee stralen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aa426e5-2b5b-42c8-b7c4-958cd99a3126",
                                "sense_id": "b9d806bc-5d64-3120-96cc-1f7550595fb3",
                                "text": "Berlijn was in de Koude Oorlog ingedeeld in sectoren."
                            }
                        ]
                    },
                    {
                        "sense_id": "b60a2fcc-6dc7-3d04-b7fb-5b757febb648",
                        "entry_id": "2ebb4a8e-d812-3a76-a444-69702e5f4793",
                        "glosses": [
                            "een vakgebied of bedrijfstak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3d52a14-df11-464e-ada2-39ed8bb5f1df",
                                "sense_id": "b60a2fcc-6dc7-3d04-b7fb-5b757febb648",
                                "text": "In deze sector zit aardig de klad."
                            },
                            {
                                "example_id": "aff24009-03a6-4908-b01a-3f06c9365461",
                                "sense_id": "b60a2fcc-6dc7-3d04-b7fb-5b757febb648",
                                "text": "De verwachting was dat ze het hele Nederlandse bedrijfsleven zouden bestrijken en dat elke sector van het bedrijfsleven een eigen bedrijf- of productschap zou krijgen."
                            },
                            {
                                "example_id": "89a3ac13-db1e-4b96-8a05-0f215efeee34",
                                "sense_id": "b60a2fcc-6dc7-3d04-b7fb-5b757febb648",
                                "text": "Wat betreft de universiteiten stellen de onderzoekers voor om een groter deel van het geld naar technische opleidingen te verschuiven, als investering in die sector."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dddc723-cc89-3af6-8de7-cd68177897e1",
                        "entry_id": "2ebb4a8e-d812-3a76-a444-69702e5f4793",
                        "glosses": [
                            "de kleinste eenheid van een harddisk die in één bewerking door een lees/schrijfkop kan verwerkt worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932865b9-075f-474e-82e8-1a0248717880",
                                "sense_id": "2dddc723-cc89-3af6-8de7-cd68177897e1",
                                "text": "Wat is de grootte van de sectors van die harddisk?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c5e88b95-04d4-351a-b65d-e2297225183f",
                        "entry_id": "2ebb4a8e-d812-3a76-a444-69702e5f4793",
                        "glosses": [
                            "iemand die secties verricht"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "504592a5-bada-466d-84d0-6f2708c39fc3",
                        "source_entry_id": "2ebb4a8e-d812-3a76-a444-69702e5f4793",
                        "source_sense_id": "b9d806bc-5d64-3120-96cc-1f7550595fb3",
                        "source_sense_description": "een deel van een cirkel in de vorm van een taartpunt",
                        "target_lang_word": "sector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64b6e223-16ee-3051-8732-62a6971224b9",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "A section."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "badb52a0-8b44-3090-a751-d993255f179d",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "A zone; a designated area.",
                                            "An area designated by boundaries within which a unit operates, and for which it is responsible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb2d2ec3-07af-3d40-b89b-5b73535d2c7e",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "A zone; a designated area.",
                                            "One of the subdivisions of a coastal frontier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21cfdb15-ea00-376a-96d6-6d8b1e1d4336",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "A zone; a designated area.",
                                            "a fictional region of space designated for navigational or governance purposes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a79bccc-3b93-36dd-93c3-de56b9d3f75f",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "A zone; a designated area.",
                                            "A community or subculture within the wider intermicronational community."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4703e8-e2ea-4140-a2f7-de070cb4fd0f",
                                                "sense_id": "3a79bccc-3b93-36dd-93c3-de56b9d3f75f",
                                                "text": "Shireroth shall not recognize the use of Sectors^([sic]) as a micronational geographic or cultural subdivision. Nor shall it reside in any sector. Nor shall any duchy or territory be considered a part of ANY sector unless the Duchy or Territory expressly grants permision^([sic]) to be considered in such sector."
                                            },
                                            {
                                                "example_id": "9d3270c4-9414-4234-9525-5fd8d9e53944",
                                                "sense_id": "3a79bccc-3b93-36dd-93c3-de56b9d3f75f",
                                                "text": "I'll also provide a list of all active citizens, I understand that in the past this has been hard due to lack of updates of the necessary links but as someone said not so long ago the CIS sector is in more of a flux than other sectors - bar Lovely 😉"
                                            },
                                            {
                                                "example_id": "e64cbdf2-2e48-4ef2-9a38-f564823b0e25",
                                                "sense_id": "3a79bccc-3b93-36dd-93c3-de56b9d3f75f",
                                                "text": "What are your opinions about this practice? Does it have a parallel outside the lusophone sector? Do you know of other stories other than YUGA? Does this mean micronationalism is changing? Is it good, bad, or irrelevant?"
                                            },
                                            {
                                                "example_id": "14417ce7-c8bd-4696-839b-82ece66fe79a",
                                                "sense_id": "3a79bccc-3b93-36dd-93c3-de56b9d3f75f",
                                                "text": "Very interesting read. Love it, and very inspiring. I hope this will be good for nations. I am planning in a thing like this for the MicroWiki sector, and MicroWikia sector, so this is a good model."
                                            },
                                            {
                                                "example_id": "e43188dc-f834-43e2-b065-31e15c30472c",
                                                "sense_id": "3a79bccc-3b93-36dd-93c3-de56b9d3f75f",
                                                "text": "This is not a sector where micronations come together, it is a cesspool where the most toxic elements of micronationalism gather to engage in drama. I plan on having much stricter rules than this sector and several people to report abuse or immature activity to, rather than just the shoddy rules and rule enforcement and one semi-active admin here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db7756ea-a164-397e-a151-f21863a2d4a7",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "Part of a circle, extending to the center; circular sector."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc44ba56-21ec-3806-b649-ad6cc14d9a4d",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "A portion of a sphere or ball defined by a conical boundary with apex at the center of the sphere."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d75b85cc-d97a-35f4-9d86-f9a1ce6970e6",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "A fixed-sized unit (traditionally 512 bytes) of sequential data stored on a track of a digital medium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39c24557-2b26-3570-8fef-af6e2c157bf8",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "An instrument consisting of two rulers of equal length joined by a hinge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb08071c-b815-3e42-9ecf-285dc2f43324",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "A field of economic activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ef7b12-06b8-4175-a59e-3cc38e838c72",
                                                "sense_id": "eb08071c-b815-3e42-9ecf-285dc2f43324",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic who still resists the idea that something drastic needs to happen for him to turn his life around. Until 2008 there was denial over what finance had become. When a series of bank failures made this impossible, there was widespread anger, leading to the public humiliation of symbolic figures."
                                            },
                                            {
                                                "example_id": "baa1565b-932e-4824-ae14-0b3f72eddae3",
                                                "sense_id": "eb08071c-b815-3e42-9ecf-285dc2f43324",
                                                "text": "public sector; private sector"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b9a6163-9b10-37fe-b2ba-0e67877da251",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "A toothed gear whose face is the arc of a circle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87752d79-97e4-3e12-be0d-b3b4f16f15a0",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "A fixed, continuous section of the track, such that sectors do not overlap but all sectors make up the whole track."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55810e44-8266-375b-bcd6-45196012103b",
                                        "entry_id": "56d80706-7d88-3024-a617-66da25997182",
                                        "glosses": [
                                            "An area of a crag, consisting of various routes"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
