                        "source_entry_id": "a5c10d4e-c291-3385-9e2d-32627ab269c5",
                        "source_sense_description": "будучи связанным с заработком, с деньгами, финансово",
                        "target_lang_word": "financially",
                        "target_lang_code": "en",
