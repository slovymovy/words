                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fecbc07-db35-4935-93c0-c5409af699fb",
                                "sense_id": "205e389e-0993-3b50-b496-3e19165e2fe5",
                                "text": "« La méthode historique » promue par W. von Humboldt est appliquée et développée par le sanskriste et chantre de l’arianité, Friedrich Max Müller (1823-1900), à partir d’Oxford où il occupera la première chaire de philologie comparée en 1868; […]."
                            },
                            {
                                "example_id": "4bce12db-b276-4efd-b568-316195030e81",
                                "sense_id": "205e389e-0993-3b50-b496-3e19165e2fe5",
                                "text": "Il se spécialise en linguistique à l'université de Leipzig (1895-1896) et, de retour à Groningue, rédige un travail universitaire sous la direction du sanskriste Speiger, Le Vidûsaka dans le théâtre indien."
                            },
                            {
                                "example_id": "45ace3a7-24fa-49a9-a356-6369ccdeabd9",
                                "sense_id": "205e389e-0993-3b50-b496-3e19165e2fe5",
                                "text": "Cette vision indophilique bien comprise vient sans doute de la présence de nombreux sanskristes spécialistes de l'Inde aux affaires coloniales des Pays-Bas."
                            }
                        ]
                    }
