                ],
                "senses": [
                    {
                        "sense_id": "7cd64ce6-c1ff-3ea0-853d-68b3e75dfe1e",
                        "entry_id": "2b562c7f-dad4-3544-be0d-5319011b74d6",
                        "glosses": [
                            "brennbare Schnur, die dazu dient eine Sprengladung nach Ablauf einer bestimmten Zeitspanne auszulösen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f7537cc-1851-4662-afa3-cca424d88090",
                                "sense_id": "7cd64ce6-c1ff-3ea0-853d-68b3e75dfe1e",
                                "text": "„Ein 76-Jähriger hat ein Sprengpaket in der Bezirkshauptmannschaft gezückt. Die Zündschnur brannte aber nicht vollständig ab.“"
                            },
                            {
                                "example_id": "1e98f052-d268-4e37-8577-9909e279f033",
                                "sense_id": "7cd64ce6-c1ff-3ea0-853d-68b3e75dfe1e",
                                "text": "„Auch Silvesterraketen haben eine \"Seele\". So nennen Experten den Faden in der Mitte der Zündschnur.“"
                            },
                            {
                                "example_id": "be75603e-a65b-4e28-bed4-2fc56560bedc",
                                "sense_id": "7cd64ce6-c1ff-3ea0-853d-68b3e75dfe1e",
                                "text": "„Patrick klettert an der Fassade hoch, bringt mit Klebeband zwei Sprengsätze am Küchenfenster an und hält das Feuerzeug an die Zündschnur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
