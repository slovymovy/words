                ],
                "senses": [
                    {
                        "sense_id": "5ae1771d-6242-34be-aadb-727e9ec2dae6",
                        "entry_id": "5b345244-6e86-3f4c-8b0d-91eb52da2a13",
                        "glosses": [
                            "Eigenschaft, mit drei anderen Atomen eine chemische Bindung eingehen zu können"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "329e2621-e5e6-4b0c-bd18-ad6e92142268",
                                "sense_id": "5ae1771d-6242-34be-aadb-727e9ec2dae6",
                                "text": "„Eine solche Substitution würde bei der anerkannten Trivalenz des Jods nichts Befremdendes darbieten.“"
                            },
                            {
                                "example_id": "d29e3c4f-84ab-419a-82b4-cca671786ad9",
                                "sense_id": "5ae1771d-6242-34be-aadb-727e9ec2dae6",
                                "text": "„Antimon verbindet sich mit Chlor und mit Fluor in zwei der Trivalenz und Pentavalenz des Antimons entsprechenden Verhältnissen, mit den übrigen Halogenen nur in einem Verhältniss, der Trivalenz des Antimons entsprechend.“"
                            },
                            {
                                "example_id": "6d5435ff-5faa-4e0b-ae88-73b402fc2587",
                                "sense_id": "5ae1771d-6242-34be-aadb-727e9ec2dae6",
                                "text": "„Neben diesen Untersuchungen über Stickstoff in seinen der Trivalenz entsprechenden Derivaten liegen noch einige Beobachtungen Le Bels über Ammoniumverbindungen vor.“"
                            },
                            {
                                "example_id": "1178a6c5-6a84-440b-bd0f-a2009dc7cb1e",
                                "sense_id": "5ae1771d-6242-34be-aadb-727e9ec2dae6",
                                "text": "„Denn weder ist jemals eine Verbindung bekannt geworden, in welcher dreiwerthiger Sauerstoff zu vermuthen wäre, noch zeigt im periodischen System irgend ein anderes Element der Sauerstoffgruppe Andeutungen von Trivalenz.“"
                            },
                            {
                                "example_id": "5809e628-318d-4efa-a64b-8d789f9c8a11",
                                "sense_id": "5ae1771d-6242-34be-aadb-727e9ec2dae6",
                                "text": "„Der nachgewiesene vorteilhafte Strukturfaktor der als Beispiel dienenden Böden ist auf die durch Trivalenz der Sesquioxyde bedingte Klammerwirkung zurückzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
