                        "glosses": [
                            "свойство по значению прилагательного романтичный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edce2d45-c928-44dd-9591-add36be7d78a",
                                "sense_id": "63af6b03-e9d9-3a9c-bf96-1166f2b11ab9",
                                "text": "Истоком этого ощущения были новизна и романтичность обстановки, и то сознание девичьей свободы и лёгкости, которое охватило её, как только поезд унёс её от Москвы — от мужа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff351958-d222-4744-b1cd-cddd62e5cedb",
                        "source_entry_id": "987c5d0f-4a36-384c-a99a-2121a2825dba",
                        "source_sense_id": "63af6b03-e9d9-3a9c-bf96-1166f2b11ab9",
