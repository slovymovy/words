                                "target_senses": [
                                    {
                                        "sense_id": "0db02745-d952-3c3d-acd5-3b1365c1d520",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "Each of the five regions of the earth's surface into which it was divided by climatic differences, namely the torrid zone (between the tropics), two temperate zones (between the tropics and the polar circles), and two frigid zones (within the polar circles)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a19ab707-6ba8-4a7d-b6f4-edffcd4767d9",
                                                "sense_id": "0db02745-d952-3c3d-acd5-3b1365c1d520",
                                                "text": "And as two Zones doe cut the Heaven upon the righter side, / And other twaine upon the left likewise the same devide, / The middle in outragious heat exceeding all the rest: / Even so likewise through great foresight to God it seemed best, / The earth encluded in the same should so devided bee […]."
                                            },
                                            {
                                                "example_id": "87c2bafe-a938-47ba-a197-8184a8fa6338",
                                                "sense_id": "0db02745-d952-3c3d-acd5-3b1365c1d520",
                                                "text": "To avoid which, we will take any pains […]; we will dive to the bottom of the sea, to the bowels of the earth, five, six, seven, eight, nine hundred fathom deep, through all five zones, and both extremes of heat and cold […]."
                                            },
                                            {
                                                "example_id": "6ff4e2bf-6d6e-4f5e-bdfe-c785dd28e87b",
                                                "sense_id": "0db02745-d952-3c3d-acd5-3b1365c1d520",
                                                "text": "And while idle curiosity may take its walk in shady avenues by the ocean side, commerce[…]defies every wind, outrides every tempest, and invades every zone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccbe57ea-8601-35b7-b12d-51f585517cb7",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "Any given region or area of the world."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5b68feb-4670-3f66-89af-b3d647e7bec0",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A given area distinguished on the basis of a particular characteristic, use, restriction, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4494a4b-c19e-496e-ace8-f7f2984ee9ac",
                                                "sense_id": "a5b68feb-4670-3f66-89af-b3d647e7bec0",
                                                "text": "There is a no-smoking zone that extends 25 feet outside of each entrance."
                                            },
                                            {
                                                "example_id": "76519313-63a2-4957-8d7b-03cfdf834714",
                                                "sense_id": "a5b68feb-4670-3f66-89af-b3d647e7bec0",
                                                "text": "The white zone is for loading and unloading only."
                                            },
                                            {
                                                "example_id": "5a508b4a-55e7-4516-a7b7-bcb0fbd37449",
                                                "sense_id": "a5b68feb-4670-3f66-89af-b3d647e7bec0",
                                                "text": "Files in the Internet zone are blocked by default, as a security measure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe82d70f-7132-3f95-a8ff-1c38a198ab86",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A restricted category or virtual place."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f74f1ef5-4d1f-45e7-adcf-1af85fe06941",
                                                "sense_id": "fe82d70f-7132-3f95-a8ff-1c38a198ab86",
                                                "text": "The discussion was veering off into a danger zone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68d93724-70d9-360a-8f50-d10400ad800a",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A band or area of growth encircling anything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aeeb3c3-abb9-4c8b-8b82-4e44472f4d06",
                                                "sense_id": "68d93724-70d9-360a-8f50-d10400ad800a",
                                                "text": "a zone of evergreens on a mountain"
                                            },
                                            {
                                                "example_id": "f5c55546-1eb3-445e-b4ef-04f3ff9991dc",
                                                "sense_id": "68d93724-70d9-360a-8f50-d10400ad800a",
                                                "text": "the zone of animal or vegetable life in the ocean around an island or a continent"
                                            },
                                            {
                                                "example_id": "8734a739-8b06-4fd4-8fe0-6fd3bbe09394",
                                                "sense_id": "68d93724-70d9-360a-8f50-d10400ad800a",
                                                "text": "Some of the lagoons, said to have subterranean outlets, have no visible ones; the inclosing island, in such cases, being a complete zone of emerald."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ced26640-1a91-39bc-b4af-d05fd3f2d71d",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A band or stripe extending around a body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b4eeb27-c205-3d2f-b9b4-7484e8c1abf7",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A series of planes having mutually parallel intersections."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa4b5a61-2f79-3d7b-9f51-beadf8c9e1f2",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "The strike zone."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56a236eb-4a82-4307-9734-af30a222fd9f",
                                                "sense_id": "fa4b5a61-2f79-3d7b-9f51-beadf8c9e1f2",
                                                "text": "That pitch was low and away, just outside the zone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d424da7-b292-3586-a451-117cc4c14062",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "Every of the three parts of an ice rink, divided by two blue lines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b97f090-e6ee-421d-9723-e794ecef1cf1",
                                                "sense_id": "4d424da7-b292-3586-a451-117cc4c14062",
                                                "text": "Players are off side, if they enter the attacking zone before the puck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5344eeb2-e24c-360e-a53f-0bac1f439eb6",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A semicircular area in front of each goal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "404b9917-4155-4120-b688-ce2c6d7b275b",
                                                "sense_id": "5344eeb2-e24c-360e-a53f-0bac1f439eb6",
                                                "text": "The defender playing at the top of the zone is nine to fourteen metres out from the goal line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77599175-ea4c-34fc-9eb0-b92363d63f9d",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A high-performance phase or period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d02c665-37d0-40d9-b197-571b14900b92",
                                                "sense_id": "77599175-ea4c-34fc-9eb0-b92363d63f9d",
                                                "text": "I just got in the zone late in the game: everything was going in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b864dc83-c678-3b74-96e6-796cfe729752",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A defensive scheme where defenders guard a particular area of the court or field, as opposed to a particular opposing player."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec40b13e-b7ee-3e3e-9fe9-30f8eb03516c",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "That collection of a domain's DNS resource records, the domain and its subdomains, that are not delegated to another authority."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40a7f337-4b34-3134-a197-498330310018",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A logical group of network devices on AppleTalk (an obsolete networking protocol)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b5c3a8a-98df-333b-91db-6718a2d0180c",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A belt or girdle."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3099c43-555f-4486-a39c-20142fd6669f",
                                                "sense_id": "5b5c3a8a-98df-333b-91db-6718a2d0180c",
                                                "text": "17th c, John Dryden, 2005, Pygmalion and the Statue, Paul Hammond, David Hopkins (editors), The Poems of John Dryden: Volume Five: 1697-1700, page 263,\nHer tapered fingers too with rings are graced, / And an embroidered zone surrounds her slender waist."
                                            },
                                            {
                                                "example_id": "26ab5bf1-f3bf-4b6b-81bd-840f724d2d5d",
                                                "sense_id": "5b5c3a8a-98df-333b-91db-6718a2d0180c",
                                                "text": "[…] Or should she, confident, / As sitting queen adored on beauty's throne, / Descend with all her winning charms begirt / To enamour, as the zone of Venus once / Wrought that effect on Jove, so fables tell : / How would one look from his majestic brow, / Seated as on the top of virtue's hill, / Discountenance her despised, and put to rout / All her array; her female pride deject, / Or turn to reverent awe ? […]"
                                            },
                                            {
                                                "example_id": "20282ed8-f465-4b05-99a5-04ee52e7b0db",
                                                "sense_id": "5b5c3a8a-98df-333b-91db-6718a2d0180c",
                                                "text": "From the waiſt downwards, they wore a looſe robe, girt with an embroidered zone or belt about the middle, with a large claſp of gold, and a precious ſtone."
                                            },
                                            {
                                                "example_id": "de2796b1-0fc2-431d-901d-ce3569556760",
                                                "sense_id": "5b5c3a8a-98df-333b-91db-6718a2d0180c",
                                                "text": "18th c, William Collins, The Passions: An Ode for Music, 1810, Alexander Chalmers, Samuel Johnson (editors), The Works of the English Poets, from Chaucer to Cowper, Volume 13, page 204,\nLove fram'd with Mirth a gay fantastic round, / Loose were her tresses seen, her zone unbound,"
                                            },
                                            {
                                                "example_id": "32b614c8-fd6e-4119-aabc-677a4aad8a8f",
                                                "sense_id": "5b5c3a8a-98df-333b-91db-6718a2d0180c",
                                                "text": "1819, Lord Byron, Don Juan, Canto I, LV, 1827, The Works of Lord Byron, including The Suppressed Poems, page 565,\nThere was the Donna Julia, whom to call / Pretty were but to give a feeble notion / Of many charms in her as natural / As sweetness to the flower, or salt to ocean, / Her zone to Venus, or his bow to Cupid / (But this last simile is trite and stupid)."
                                            },
                                            {
                                                "example_id": "f3dbac98-ad6b-4a40-b882-0fe427bbed99",
                                                "sense_id": "5b5c3a8a-98df-333b-91db-6718a2d0180c",
                                                "text": "1844, Charles Dickens, The life and Adventures of Martin Chuzzlewit, 1865, Works of Charles Dickens, Volume VI: Martin Chuzzlewit—Volume II, page 421,\n[…] it was the prettiest thing to see her girding on the precious little zone, and yet obliged to have assistance because her fingers were in such terrible perplexity; […]."
                                            },
                                            {
                                                "example_id": "46919280-b79d-40d0-92d8-0eb65f8b0bfc",
                                                "sense_id": "5b5c3a8a-98df-333b-91db-6718a2d0180c",
                                                "text": "`Look now on me, Kallikrates!' and with a sudden motion she shook her gauzy covering from her, and stood forth in her low kirtle and her snaky zone, in her glorious radiant beauty and her imperial grace, rising from her wrappings, as it were, like Venus from the wave, or Galatea from her marble, or a beatified spirit from the tomb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05da9e9-f12d-3636-9335-0002a67dc6a0",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "The curved surface of a frustum of a sphere, the portion of surface of a sphere delimited by parallel planes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c51922fe-6628-4354-b257-36e56df355f7",
                                                "sense_id": "d05da9e9-f12d-3636-9335-0002a67dc6a0",
                                                "text": "1835, Charles Davies, David Brewster (editors and translators), Adrien-Marie Legendre, Elements of Geometry and Trigonometry, [1794, Eléments de géométrie], page 293,\nTo find the surface of a spherical zone.\nRule.—Multiply the altitude of the zone by the circumference of a great circle of the sphere, and the product will be the surface (Book VIII. Prop. X. Sch. 1)."
                                            },
                                            {
                                                "example_id": "c6f319cd-9955-4c3b-a613-a7224203bd37",
                                                "sense_id": "d05da9e9-f12d-3636-9335-0002a67dc6a0",
                                                "text": "A zone of a sphere is the curved surface of a frustum.[…]Determine, correct to 3 significant figures (a) the volume of the frustum of the sphere, (b) the radius of the sphere and (c) the area of the zone formed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8540c29-a36f-32f8-ad90-5e9d21911403",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A frustum of a sphere."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57b0bf04-1fa9-3ba9-821f-b1fddaf77cf8",
                                        "entry_id": "d2ac4d06-a073-37fe-af39-7bc79247304f",
                                        "glosses": [
                                            "A circuit; a circumference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dbc0209-31ff-45c7-9df1-d7d1143e53fb",
                                                "sense_id": "57b0bf04-1fa9-3ba9-821f-b1fddaf77cf8",
                                                "text": "And we have yet large day; for scarce the sun / Hath finish'd half his journey, and scarce begins / His other half in the great zone of heaven."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19d525c9-5122-36fd-813c-587d9710c753",
                                        "entry_id": "c15a450b-982f-3f37-8f0a-09bc51ba6a7b",
                                        "glosses": [
                                            "To divide into or assign to sections or areas."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb029b44-01b8-4140-bc25-7d9434bbbb8f",
                                                "sense_id": "19d525c9-5122-36fd-813c-587d9710c753",
                                                "text": "Please zone off our staging area, a section for each group."
                                            },
                                            {
                                                "example_id": "45dff7ea-39ad-4679-b604-4badf39da528",
                                                "sense_id": "19d525c9-5122-36fd-813c-587d9710c753",
                                                "text": "The high-level process is to shut down the server, unzone the server from Generation 2, zone the server to Gen3, and then define and activate the data-migration (DM) volumes between the Generation 2 and Gen3."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b9cb22d-26e6-3c82-a40d-e4446db4686b",
                                        "entry_id": "c15a450b-982f-3f37-8f0a-09bc51ba6a7b",
                                        "glosses": [
                                            "To define the property use classification of (an area)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81a50144-ea34-4958-8a8a-268a4b820a9c",
                                                "sense_id": "1b9cb22d-26e6-3c82-a40d-e4446db4686b",
                                                "text": "This area was zoned for industrial use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14dd516c-0022-38e6-b145-3dfb6ae2c255",
                                        "entry_id": "c15a450b-982f-3f37-8f0a-09bc51ba6a7b",
                                        "glosses": [
                                            "To enter a daydream state temporarily, for instance as a result of boredom, fatigue, or intoxication; to doze off."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "276e9481-31ff-44ba-ab4c-e0e608af5caf",
                                                "sense_id": "14dd516c-0022-38e6-b145-3dfb6ae2c255",
                                                "text": "I must have zoned while he was giving us the directions."
                                            },
                                            {
                                                "example_id": "62a0bba0-ca31-4133-83a3-d0d54d975ae2",
                                                "sense_id": "14dd516c-0022-38e6-b145-3dfb6ae2c255",
                                                "text": "Everyone just put their goddamn heads together and zoned. # (transitive, archaic, poetic) To girdle or encircle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57d99484-5cc4-3023-8337-43034d823fcc",
                                        "entry_id": "c15a450b-982f-3f37-8f0a-09bc51ba6a7b",
                                        "glosses": [
                                            "To assign to a restricted category."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16888bf1-23f6-415e-82ab-cc1afb9c076b",
                                                "sense_id": "57d99484-5cc4-3023-8337-43034d823fcc",
                                                "text": "We've zoned each other as friends; we'll never be anything more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
