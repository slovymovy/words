                ],
                "senses": [
                    {
                        "sense_id": "1ac4b032-4615-3df3-8fab-6af9ddfdd640",
                        "entry_id": "9389a07c-6fc6-32d6-9ee4-289a6304421d",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54ba3723-c136-4f6e-9824-d76a0c7147ab",
                                "sense_id": "1ac4b032-4615-3df3-8fab-6af9ddfdd640",
                                "text": "Frau Gebele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "26048303-e6ac-49dd-820d-37e08e2d2ae0",
                                "sense_id": "1ac4b032-4615-3df3-8fab-6af9ddfdd640",
                                "text": "Herr Gebele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b871089b-e7ff-404e-8621-45fbef4a554c",
                                "sense_id": "1ac4b032-4615-3df3-8fab-6af9ddfdd640",
                                "text": "Die Gebeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "03c26c97-f815-402a-a53e-12b7edf11ba4",
                                "sense_id": "1ac4b032-4615-3df3-8fab-6af9ddfdd640",
                                "text": "Der Gebele trägt nie die Schals, die die Gebele ihm strickt."
                            },
                            {
                                "example_id": "d90378b9-52aa-4afc-b0a3-3b864da3423f",
                                "sense_id": "1ac4b032-4615-3df3-8fab-6af9ddfdd640",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gebele kommt, geht der Herr Gebele.“"
                            },
                            {
                                "example_id": "e880d5df-7356-4ad2-917c-5af110646b85",
                                "sense_id": "1ac4b032-4615-3df3-8fab-6af9ddfdd640",
                                "text": "Gebele kommt und geht."
                            },
                            {
                                "example_id": "1f414295-f0b6-4b95-bec6-32d6767c35cb",
                                "sense_id": "1ac4b032-4615-3df3-8fab-6af9ddfdd640",
                                "text": "Gebeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
