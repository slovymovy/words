                ],
                "senses": [
                    {
                        "sense_id": "cce497e2-04f8-3bb2-a246-5dba29844f62",
                        "entry_id": "6bdcc1a9-52c6-3efc-bd09-c74f4b4c54bf",
                        "glosses": [
                            "großes Wasserfahrzeug, das Müll transportiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afdea937-cb7b-493f-919b-c1f52442daba",
                                "sense_id": "cce497e2-04f8-3bb2-a246-5dba29844f62",
                                "text": "„Viele Last- und Müllschiffe auf der schönsten Seite der Insel tagelang.“"
                            },
                            {
                                "example_id": "f476330d-8a46-403e-8285-42144b996fd3",
                                "sense_id": "cce497e2-04f8-3bb2-a246-5dba29844f62",
                                "text": "„Ein Mafia-Aussteiger hatte den Ermittlern den entscheidenden Hinweis zum Fund des ersten Müllschiffs gegeben; später bestätigten Unterwasser-Aufnahmen, was Umweltschützer der Region schon seit Jahren sagen: seit Beginn der 90er-Jahren lässt sich die örtliche Mafia teuer für die Entsorgung von Giftmüll bezahlen – den sie dann im Meer versenkt.“"
                            },
                            {
                                "example_id": "38521e55-8fdd-45cd-8dce-718acb51db5f",
                                "sense_id": "cce497e2-04f8-3bb2-a246-5dba29844f62",
                                "text": "„Es gibt mobile Sammelstellen (Müllboote, im Rotterdamer Hafen ist es ein großes Müllschiff) und es gibt spezialisierte Betriebe, die die Abfälle einsammeln und verarbeiten (wie Tank Cleaning Rotterdam).“"
                            },
                            {
                                "example_id": "09abc374-499d-499d-9cd3-ce6a14f4e4cf",
                                "sense_id": "cce497e2-04f8-3bb2-a246-5dba29844f62",
                                "text": "„Fast vierzig offizielle Müllschiffe reinigen die Küstenregionen der balearischen Inseln, um so Strände und Badewasser sauber zu halten.“"
                            },
                            {
                                "example_id": "2994016d-0396-4a7a-9a8d-9b94a323ea18",
                                "sense_id": "cce497e2-04f8-3bb2-a246-5dba29844f62",
                                "text": "„Und damit auf der Wasserstraße auch Ordnung herrscht, gibt es hier Deutschlands wohl einzige hauptamtliche Müllschiffer, die mit ihrem Müllschiff an den Ufern des Flusses den Müll einsammeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
