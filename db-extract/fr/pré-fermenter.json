                ],
                "senses": [
                    {
                        "sense_id": "0a675182-f4d5-3f7f-bf80-6b48a6b87d63",
                        "entry_id": "c930ea1a-d80f-3bd1-894b-f3e05d77de6f",
                        "glosses": [
                            "Subir une fermentation préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ee57928-9a13-4c1e-b0e1-74f86b80b9a3",
                                "sense_id": "0a675182-f4d5-3f7f-bf80-6b48a6b87d63",
                                "text": "Mais un rafraîchi n'est pas autre chose qu'une partie de la pâte à pain qu'on fait pré-fermenter..."
                            }
                        ]
                    },
                    {
                        "sense_id": "624c1fc0-98d2-3f09-a36a-f9a8f80def2b",
                        "entry_id": "c930ea1a-d80f-3bd1-894b-f3e05d77de6f",
                        "glosses": [
                            "Faire subir une fermentation préalable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7565454c-5a2d-46fc-904d-b0ff27aa41e6",
                                "sense_id": "624c1fc0-98d2-3f09-a36a-f9a8f80def2b",
                                "text": "Pour y remédier, il est nécessaire soit de pré-fermenter, soit de pré-gélatiniser une partie de la farine (Belclerok, non daté)."
                            },
                            {
                                "example_id": "0b035c21-e580-4647-a3b6-d44ff24db26a",
                                "sense_id": "624c1fc0-98d2-3f09-a36a-f9a8f80def2b",
                                "text": "Dans le cadre d’une vérible collecte des biodéchets,les BRS qui ne servent qu’à ouvrir les sacs, déshydrater et pré-fermenter les éléments humides compostables tout en continuant un mélange polluant,commencé dans les bennes sont coûteux et inutiles."
                            }
                        ]
                    }
