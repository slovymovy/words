                        "sense_id": "66316597-fe4b-35ee-9b93-65ce6132c61e",
                        "entry_id": "e932fc15-b57c-30a7-b630-33cc6bcc37cc",
                        "glosses": [
                            "Celui qui sait jouer du bâton, qui sait s’en servir comme d’une arme offensive et défensive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da7e98e7-8933-4fea-b334-9411a75fe030",
                                "sense_id": "66316597-fe4b-35ee-9b93-65ce6132c61e",
                                "text": "Un habile bâtonniste."
                            },
                            {
                                "example_id": "5c960a86-b5de-4be2-90c9-178fbafc7fb8",
                                "sense_id": "66316597-fe4b-35ee-9b93-65ce6132c61e",
                                "text": "Nouvelles injures, mêlée générale, pendant laquelle un des officiers aurait reçu des coups de canne, assénés par un bâtonniste redouté, nommé Durand."
                            }
                        ]
                    },
                    {
                        "sense_id": "72490daf-7907-359c-a731-7c6b9de30353",
                        "entry_id": "e932fc15-b57c-30a7-b630-33cc6bcc37cc",
                        "glosses": [
                            "Celui qui exécute des tours d’adresse avec un bâton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ec05ae-5eef-41b1-bd3e-c3e6292634f0",
                                "sense_id": "72490daf-7907-359c-a731-7c6b9de30353",
                                "text": "Et le Tyran leva un gourdin attaché à son poignet par un cordon de cuir, arme peu noble, mais qu’il maniait avec une dextérité admirable, ayant longtemps, en ses tournées, pratiqué les bâtonnistes de Rouen."
                            },
                            {
                                "example_id": "cd8b1fc6-ebbd-4d2d-aa52-8c327273901a",
                                "sense_id": "72490daf-7907-359c-a731-7c6b9de30353",
                                "text": "Bien qu'apte à d'autres multiples jongleries avec des assiettes, des saladiers, des gobelets, des cartes, le bâtonniste était, avant tout, manipulateur de bâton."
                            },
                            {
                                "example_id": "74008ce9-7ec9-4477-9e1c-aac03982f75e",
                                "sense_id": "72490daf-7907-359c-a731-7c6b9de30353",
                                "text": "Nanette estime que le bâtonniste pourrait trouver, un jour, un client qui, lui aussi, a un bâton."
                            }
                        ]
                    }
