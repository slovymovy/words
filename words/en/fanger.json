            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90d2d0b4-8e8e-3c18-9e58-1053d3f15aab",
                    "sense_definition": "A helper or protector.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "helper_protector",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient folklore, the loyal <w>fanger</w> stood guard at the gates to shield the village from harm.",
                            "target_lang_translations": {
                                "es": "En el antiguo folclore, el leal <w>guardián</w> montaba guardia en las puertas para proteger a la aldea de cualquier daño."
                            }
                        },
                        {
                            "text": "He acted as a reliable <w>fanger</w> for the travelers, guiding them safely through the treacherous mountain pass.",
                            "target_lang_translations": {
                                "es": "Actuó como un <w>protector</w> confiable para los viajeros, guiándolos de manera segura a través del traicionero paso de montaña."
                            }
                        }
                    ],
                    "synonyms": [
                        "helper",
                        "protector",
                        "guardian",
                        "defender"
                    ],
                    "antonyms": [
                        "attacker",
                        "adversary"
                    ],
                    "common_phrases": [
                        "loyal fanger",
                        "fanger of the weak"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Un ayudante o protector."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "protector",
                                "target_lang_sense_clarification": "persona que protege"
                            },
                            {
                                "target_lang_word": "guardián",
                                "target_lang_sense_clarification": "persona que guarda o defiende"
                            },
                            {
                                "target_lang_word": "defensor",
                                "target_lang_sense_clarification": "persona que defiende a otros"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edec78a1-52fb-3f16-bb6a-1b512a61b2bc",
                    "sense_definition": "A receiver or one who catches or takes hold of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "receiver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designated <w>fanger</w> caught the heavy sacks as they were lowered from the ship's deck.",
                            "target_lang_translations": {
                                "es": "El <w>receptor</w> designado atrapó los sacos pesados mientras los bajaban de la cubierta del barco."
                            }
                        },
                        {
                            "text": "As a skilled <w>fanger</w> of fast-moving objects, he never dropped a single tool passed to him.",
                            "target_lang_translations": {
                                "es": "Como hábil <w>atrapador</w> de objetos que se mueven rápidamente, nunca dejó caer una sola herramienta que le pasaran."
                            }
                        }
                    ],
                    "synonyms": [
                        "receiver",
                        "catcher",
                        "taker"
                    ],
                    "antonyms": [
                        "giver",
                        "sender"
                    ],
                    "common_phrases": [
                        "designated fanger"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Un receptor o alguien que atrapa o toma posesión de algo."
                    },
                    "translations": {
