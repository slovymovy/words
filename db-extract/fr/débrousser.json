                ],
                "senses": [
                    {
                        "sense_id": "6f026ea3-7b52-30f1-bc8f-13f69484480d",
                        "entry_id": "e97ce7a8-3d45-3158-b199-4e3ed7ffe425",
                        "glosses": [
                            "Débarrasser (un terrain) de la végétation gênante."
                        ],
                        "tags": [
                            "Afrique",
                            "Nouvelle-Calédonie",
                            "Polynésie française"
                        ],
                        "examples": [
                            {
                                "example_id": "0fb2d0f2-1b43-4742-8492-fec4c08699ce",
                                "sense_id": "6f026ea3-7b52-30f1-bc8f-13f69484480d",
                                "text": "On ne pouvait admettre que Tonio n’eût pas prévu tel inconvénient, songé à faire un pont, à débrousser cet emplacement !"
                            },
                            {
                                "example_id": "6f0a770e-a0ad-4951-8d61-41a1804c6bdc",
                                "sense_id": "6f026ea3-7b52-30f1-bc8f-13f69484480d",
                                "text": "Foin de souci ! Pas de portage. Pas de caoutchouc à faire ni de routes à débrousser."
                            },
                            {
                                "example_id": "f58606f2-fb2c-4f6f-af96-690c5970558c",
                                "sense_id": "6f026ea3-7b52-30f1-bc8f-13f69484480d",
                                "text": "A Lifou, à la tribu de Kejëny, les enfants entre 10 et 17 ans, se rendent chez Waïa Hmazun. Ils vont débrousser son champ... et bénéficient juste avant, d’une petite formation, pour savoir comment fabriquer un piège à oiseaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5805f85-d41d-317f-b42c-2ee915dcdd64",
                        "entry_id": "e97ce7a8-3d45-3158-b199-4e3ed7ffe425",
                        "glosses": [
                            "Couper ou arracher la végétation gênante."
                        ],
                        "tags": [
                            "Absolument"
                        ],
                        "examples": [
                            {
                                "example_id": "d78f7de9-cca9-4d32-8770-b3d0e77e4645",
                                "sense_id": "d5805f85-d41d-317f-b42c-2ee915dcdd64",
                                "text": "La 1ʳᵉ compagnie de légion étrangère … est presque aussitôt renforcée des deux autres compagnies du groupe ( capitaines Robard et Rilla ) et de trois cents porteurs du convoi chargés de débrousser."
                            },
                            {
                                "example_id": "ca53b5a4-81e4-4419-8511-a763368034fc",
                                "sense_id": "d5805f85-d41d-317f-b42c-2ee915dcdd64",
                                "text": "Comme nos confrères de TNTV l’ont révélé, le corps d'une femme a été retrouvé ce samedi matin près de l’église catholique de Papeari. … C’est un travailleur de l’Église catholique qui a découvert son corps alors qu’il était en train de débrousser."
                            }
                        ]
                    }
                ],
