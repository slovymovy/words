    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "adfd844d-60cb-351b-b71e-5ec2991b0498",
                "word": "omnipresence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "edae23b8-2ba8-4a9e-948c-966e733f3808",
                        "entry_id": "adfd844d-60cb-351b-b71e-5ec2991b0498",
                        "tags": [
                            "plural"
                        ],
                        "form": "omnipresences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e97e5ff9-94d0-3180-84fa-0cf3c4606f37",
                        "entry_id": "adfd844d-60cb-351b-b71e-5ec2991b0498",
                        "glosses": [
                            "The ability to be, or the characteristic of being, at all places at the same time (usually only attributed to God)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1dfdb717-0487-46d4-8ee2-9c8222bb8cd6",
                                "sense_id": "e97e5ff9-94d0-3180-84fa-0cf3c4606f37",
                                "text": "Notwithstanding these precise statements concerning the omnipresence of the flesh of Christ, there still was no uniform and, in all its features, settled doctrinal statement concerning it […]"
                            },
                            {
                                "example_id": "3dd564ae-be91-47de-9f82-c2f1b0c939a7",
                                "sense_id": "e97e5ff9-94d0-3180-84fa-0cf3c4606f37",
                                "text": "So the Lord's omnipresence as well as the omnipresence of the Self of the soul is rather an internal omnipresence, a subjective omnipresence, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72740c91-e3ab-4687-9947-5aed7d10522a",
                        "source_entry_id": "adfd844d-60cb-351b-b71e-5ec2991b0498",
                        "source_sense_id": "e97e5ff9-94d0-3180-84fa-0cf3c4606f37",
                        "source_sense_description": "the ability to be at all places at the same time",
                        "target_lang_word": "alomtegenwoordigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alomtegenwoordigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "edff733c-9e0d-330a-904a-42140b11105f",
                                        "entry_id": "9f4b6787-8aca-3c3d-88aa-0418c06c42f1",
                                        "glosses": [
                                            "de eigenschap om overal tegelijkertijd aanwezig te zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47edaaf-c686-450c-bf22-6fd56295feb6",
                                                "sense_id": "edff733c-9e0d-330a-904a-42140b11105f",
                                                "text": "Er kan je een claustrofobisch gevoel overvallen bij de gedachte datje nooit zult kunnen ontkomen aan de alomtegenwoordigheid van priklimonade of de reclameclaims van verzachtende shampoo; dat er altijd wel ergens in de omgeving een boodschap hangt, zelfs in de palmbomen langs de Nijl tussen Aswan en Luxor, of in de paden die naar Angkor Wat leiden, of boven de Niagarawatervallen."
                                            },
                                            {
                                                "example_id": "2ac21829-4810-4dbe-b577-b60ddb0660aa",
                                                "sense_id": "edff733c-9e0d-330a-904a-42140b11105f",
                                                "text": "Het was de alomtegenwoordigheid van de oudheid die tot mijn verbeelding sprak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1d22b95-1e90-4674-bf90-be69e9ed6971",
                        "source_entry_id": "adfd844d-60cb-351b-b71e-5ec2991b0498",
                        "source_sense_id": "e97e5ff9-94d0-3180-84fa-0cf3c4606f37",
                        "source_sense_description": "the ability to be at all places at the same time",
                        "target_lang_word": "omniprésence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omniprésence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d852101-e7f6-30cb-bcaf-961ee3e13c2a",
                                        "entry_id": "0bfc8b04-f7ef-3155-baf1-16fa9835a3ca",
                                        "glosses": [
                                            "Fait de la systématique présence de quelqu'un, fait que quelqu'un soit automatiquement présent"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6339c08e-35e8-399a-a9af-37b95a9a4605",
                                        "entry_id": "0bfc8b04-f7ef-3155-baf1-16fa9835a3ca",
                                        "glosses": [
                                            "Faculté d'être partout en même temps, proche de l'ubiquité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "390db9e9-6653-4aad-820c-84b6ab138e6e",
                                                "sense_id": "6339c08e-35e8-399a-a9af-37b95a9a4605",
                                                "text": "L'exploitation des registres paroissiaux de Jerez de la Frontera, ville espagnole située en Andalousie près du port de Cadix, démontre notamment l'exubérance de la vie sous l'Ancien Régime, mais aussi l’omniprésence de la mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42dc1961-312c-41a3-b565-1614380727d5",
                        "source_entry_id": "adfd844d-60cb-351b-b71e-5ec2991b0498",
                        "source_sense_id": "e97e5ff9-94d0-3180-84fa-0cf3c4606f37",
                        "source_sense_description": "the ability to be at all places at the same time",
                        "target_lang_word": "ubiquité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ubiquité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38241823-5010-3100-aab4-f601649f3db0",
                                        "entry_id": "e0261011-89ec-3ab4-a535-72e00542e13a",
                                        "glosses": [
                                            ", (Dogmatique) Attribut de Dieu, être présent dans le même temps partout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891c6a40-53a3-4e4d-9465-8b34bc57ae9d",
                                                "sense_id": "38241823-5010-3100-aab4-f601649f3db0",
                                                "text": "Brenz, au contraire, avait développé jusqu’à son maximum la doctrine de l’ubiquité, dont le but était d’expliquer la présence du corps du Christ dans le pain de la Cène — ce qu’on nomme la consubstantiation — d’une manière qui tend à rapprocher la cène luthérienne de l’eucharistie catholique, laquelle se définit par la transsubstantiation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615ad8dc-2a51-330d-a2e0-3890136e7de7",
                                        "entry_id": "e0261011-89ec-3ab4-a535-72e00542e13a",
                                        "glosses": [
                                            "Aptitude à être présent physiquement à plusieurs endroits en même temps."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7909fd72-2a09-4782-9232-77ba992182ca",
                                                "sense_id": "615ad8dc-2a51-330d-a2e0-3890136e7de7",
                                                "text": "Grâce à mon don d’ubiquité, je peux aller au four et au moulin en même temps."
                                            },
                                            {
                                                "example_id": "f10d3432-392d-4145-a2eb-49daa8986cd9",
                                                "sense_id": "615ad8dc-2a51-330d-a2e0-3890136e7de7",
                                                "text": "Pour Antoine, […], la sensation d’ubiquité provoquée par toutes les technologies modernes constituait une espèce de baume : les époques révolues, le présent, les lieux les plus éloignés du monde se télescopaient sur l’écran dans une espèce de lévitation abstraite qu’il était rassurant d’appeler la vie, une apesanteur affective à la fois magique et monocorde."
                                            },
                                            {
                                                "example_id": "11dc185d-6c4e-4fb6-b8d9-dd3e9b9c733a",
                                                "sense_id": "615ad8dc-2a51-330d-a2e0-3890136e7de7",
                                                "text": "— Alors que le romancier, riche de son don d’ubiquité, peut se dédoubler en autant de personnages que son humeur daigne susciter au fil des pages, le poète reste fixé à la finitude de son expérience, à la racine de son cri."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "608ebce2-c011-3763-bbfc-a88afc38f1e7",
                                        "entry_id": "e0261011-89ec-3ab4-a535-72e00542e13a",
                                        "glosses": [
                                            "Omniprésence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50e7ff9a-9561-4887-8be3-c89042aee97a",
                                                "sense_id": "608ebce2-c011-3763-bbfc-a88afc38f1e7",
                                                "text": "Je n'insisterai jamais assez sur l'ubiquité de la violence au Mexique qui imprègne tant de dimensions au quotidien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ubiquité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e50d532a-3757-35bd-a552-8abd81cfb65d",
                                        "entry_id": "3fa03e9e-c1aa-325d-a402-8887f1135a10",
                                        "glosses": [
                                            "Participe passé masculin singulier de ubiquiter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
