                        "sense_id": "d2e28299-f5ea-3547-a905-a7c249031200",
                        "entry_id": "07a5203d-fe7e-3409-8ee8-5d8d73da8b25",
                        "glosses": [
                            "Participant à une affiliation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472e5b0c-280c-4ebc-9628-f86739daf83c",
                                "sense_id": "d2e28299-f5ea-3547-a905-a7c249031200",
                                "text": "Cette corporation a des affiliés."
                            },
                            {
                                "example_id": "e573de12-45a2-446d-8b9e-dc5fbc28935b",
                                "sense_id": "d2e28299-f5ea-3547-a905-a7c249031200",
                                "text": "Il lui fallait un centre d’opérations. Son parent, M. de Valqueyras, lui ayant défendu d’introduire des affiliés dans son hôtel, il avait choisi le salon jaune de Félicité."
                            },
                            {
                                "example_id": "b0e4f33c-9f5b-4df3-8b72-4af212ca8e92",
                                "sense_id": "d2e28299-f5ea-3547-a905-a7c249031200",
                                "text": "Chaque compte d'affilié est ainsi tenu à jour, aussi bien pour la Caisse centrale que pour l'affilié lui-même."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
