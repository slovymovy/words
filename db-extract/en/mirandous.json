                "senses": [
                    {
                        "sense_id": "c9bdd74c-dac0-3fb1-a9c5-ac64e75c4d29",
                        "entry_id": "b17b04a8-b332-33bf-8a9b-ddb80d5b670b",
                        "glosses": [
                            "Amazing; miraculous."
                        ],
                        "tags": [
                            "formal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "839bab08-b69e-4caa-a781-e1ede00e0f63",
                                "sense_id": "c9bdd74c-dac0-3fb1-a9c5-ac64e75c4d29",
                                "text": "Trace the Stories of old Scripture-times, and the Defeats given in Battels by the heavenly Hosts for Israel; and see if our Defence be not both · mirandous and miraculous, tho Man gave not a Blow: […]"
                            },
                            {
                                "example_id": "2ae0c1b8-6b90-43a1-a9ae-45b4e2e9fa60",
                                "sense_id": "c9bdd74c-dac0-3fb1-a9c5-ac64e75c4d29",
                                "text": "There is no cause, from an antecedent sanctity, to ascribe 'this mirandous production to miraculous causes."
                            },
                            {
                                "example_id": "cf50d867-a9ae-4156-b6af-1a02bc1b42f4",
                                "sense_id": "c9bdd74c-dac0-3fb1-a9c5-ac64e75c4d29",
                                "text": "It suggests nobility—Miranda in Latin means “worthy of admiration” and is similar to mirandous, or miraculous; Priestly suggests the possession of consecrated knowledge."
                            }
                        ]
                    }
                ],
