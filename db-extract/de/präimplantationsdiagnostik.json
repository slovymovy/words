                "senses": [
                    {
                        "sense_id": "3310af13-212a-39d7-baea-125610bd095e",
                        "entry_id": "9c1bd275-bf3e-358d-bad5-aa114ec7dc77",
                        "glosses": [
                            "Untersuchung von Zygoten auf Erbkrankheiten oder genetische Besonderheiten im Vorfeld einer künstlichen Befruchtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c4a5a21-e68e-4103-ad57-68542293e2cb",
                                "sense_id": "3310af13-212a-39d7-baea-125610bd095e",
                                "text": "Die Eltern hatten sich für eine künstliche Befruchtung und eine Präimplantationsdiagnostik (PID) entschieden, nachdem in der Familie des Vaters in den vorherigen drei Generationen Brustkrebs aufgetreten war."
                            },
                            {
                                "example_id": "202175c6-b413-4f64-afd2-4fab33afa61b",
                                "sense_id": "3310af13-212a-39d7-baea-125610bd095e",
                                "text": "Im Universitätsklinikum in Lübeck ist das nach Klinikangaben erste Baby Deutschlands geboren, bei dem eine Präimplantationsdiagnostik (PID) zum Ausschluss eines einzelnen Genfehlers gemacht wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5da0179d-b5ae-4f59-8d9d-d09ab9f453f4",
                        "source_entry_id": "9c1bd275-bf3e-358d-bad5-aa114ec7dc77",
                        "source_sense_id": "3310af13-212a-39d7-baea-125610bd095e",
