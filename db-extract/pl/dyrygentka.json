                "senses": [
                    {
                        "sense_id": "cdc1cecb-238c-3e13-b97b-36be7ce38afd",
                        "entry_id": "f99a2abc-cb70-30a7-9b97-e96f53c34215",
                        "glosses": [
                            "kobieta, która dyryguje orkiestrą lub chórem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488184ca-9ab4-41ef-85f2-8b3702ba50db",
                                "sense_id": "cdc1cecb-238c-3e13-b97b-36be7ce38afd",
                                "text": "Kiedy w orkiestronie pojawiła się dyrygentka, widzowie powitali ją gromkimi brawami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "26b73704-ad55-350f-ae38-a5908f2f1012",
                        "entry_id": "f99a2abc-cb70-30a7-9b97-e96f53c34215",
                        "glosses": [
                            "kobieta, lubiąca kierować wszystkim, rozkazywać innym, mówić co mają robić, czasem wysługująca się innymi"
                        ],
                        "tags": [
                            "metaphoric",
                            "pejorative"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c895577f-c058-4705-9fb5-5fa90e060efc",
                        "source_entry_id": "f99a2abc-cb70-30a7-9b97-e96f53c34215",
                        "source_sense_id": "cdc1cecb-238c-3e13-b97b-36be7ce38afd",
                        "target_lang_word": "дирижёр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дирижёр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b43ba343-e6ab-38e0-bc64-5103a8e2544c",
                                        "entry_id": "25b64e00-02a6-34fe-ab6e-9b80fd8f4821",
                                        "glosses": [
                                            "музыкант, управляющий оркестром, хором, оперным или балетным спектаклем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3699bb-a2cf-487b-a763-f32fc5a07e25",
                                                "sense_id": "b43ba343-e6ab-38e0-bc64-5103a8e2544c",
                                                "text": "Узнав меня, дирижёр вдруг взмахнул палочкой и заиграл марш «Прощание славянки»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e9edea-6e69-3cca-9e5c-7ddd9495339b",
                                        "entry_id": "25b64e00-02a6-34fe-ab6e-9b80fd8f4821",
                                        "glosses": [
                                            "перен. тот, кто организует какой-либо сложный процесс, управляет действиями других людей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4db390e5-750b-41da-8f27-d4a6097572a6",
                                                "sense_id": "d5e9edea-6e69-3cca-9e5c-7ddd9495339b",
                                                "text": "Бюрократическому строю не нужен самодержец, ему нужен опытный дирижёр."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "799947bc-53c0-3c14-97c1-21209e8212e2",
                                        "entry_id": "25b64e00-02a6-34fe-ab6e-9b80fd8f4821",
                                        "glosses": [
                                            "устар. лицо, руководящее танцами на балу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5895ff12-9da9-4e3d-af2b-fd3c78a99664",
                                                "sense_id": "799947bc-53c0-3c14-97c1-21209e8212e2",
                                                "text": "Только что оставив графиню Банину, с которою он протанцевал первый тур вальса, он, оглядывая своё хозяйство, то есть пустившихся танцевать несколько пар, увидел входившую Кити и подбежал к ней тою особенною, свойственною только дирижёрам балов развязною иноходью и, поклонившись, даже не спрашивая, желает ли она, занёс руку, чтоб обнять её тонкую талию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b76ad99-b976-3cfe-9a26-6e53afa5a064",
                                        "entry_id": "25b64e00-02a6-34fe-ab6e-9b80fd8f4821",
                                        "glosses": [
                                            "устар. служащий, следящий за движением канцелярских бумаг, за ходом канцелярской работы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
