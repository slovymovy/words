                                "sense_id": "9b6f9d26-0d29-3640-81e8-44b9bdc7ad6b",
                                "text": "minor indiscretion"
                            },
                            {
                                "example_id": "6079546e-0951-4311-94d9-14cbc6895e6d",
                                "sense_id": "9b6f9d26-0d29-3640-81e8-44b9bdc7ad6b",
                                "text": "He apologized for his youthful indiscretion."
                            },
                            {
                                "example_id": "bb13dbac-febd-41c4-bd1f-e00cb9e540aa",
                                "sense_id": "9b6f9d26-0d29-3640-81e8-44b9bdc7ad6b",
                                "text": "The scandal was caused by a single indiscretion."
                            }
                        ]
                    },
