                                    {
                                        "sense_id": "6a52f20e-6e2b-3958-82be-ea4d27b06916",
                                        "entry_id": "c6925973-19d8-3be6-820b-f4bfff5af710",
                                        "glosses": [
                                            "Feeding on insects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebd044c9-4719-44a0-9ea5-39eefaf67d81",
                                                "sense_id": "6a52f20e-6e2b-3958-82be-ea4d27b06916",
                                                "text": "Researchers in the Netherlands have linked neonicotinoids found in surface water to declines in insectivorous birds and there is widespread scientific evidence that neonicotinoids harm bees – reducing their ability to pollinate plants, for instance."
                                            }
                                        ]
                                    },
