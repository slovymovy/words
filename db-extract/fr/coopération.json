                                                "sense_id": "1e0d8c18-e109-3dfb-820b-c9bab8e9005c",
                                                "text": "Een coöperatie is een onafhankelijke onderneming in eigendom van en bestuurd door degenen die er gebruik van maken."
                                            },
                                            {
                                                "example_id": "f99d6e14-be15-4305-b9d5-149670e3a6e5",
                                                "sense_id": "1e0d8c18-e109-3dfb-820b-c9bab8e9005c",
                                                "text": "De boeren werkten samen in een coöperatie."
                                            }
