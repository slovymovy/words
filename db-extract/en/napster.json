                "senses": [
                    {
                        "sense_id": "66899099-29ea-31db-843a-0cb612d10bd9",
                        "entry_id": "c1663eb7-1a46-3f77-b55f-bf62e1215f6a",
                        "glosses": [
                            "Any website that facilitates free distribution of data."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "4f6b0ced-54ea-4c83-a1e7-14434253ed18",
                                "sense_id": "66899099-29ea-31db-843a-0cb612d10bd9",
                                "text": "Some in the used-book industry are questioning whether Amazon.com is becoming the Napster of the book business."
                            },
                            {
                                "example_id": "4fe9303d-e789-4bfd-b60d-7e2c073eeab9",
                                "sense_id": "66899099-29ea-31db-843a-0cb612d10bd9",
                                "text": "It would be easy to call the venture-backed, San Mateo-based YouTube the Napster of video, an outlaw startup rocketing onto dotcom radar screens on the backs of rights-holders. But that's a designation that the year-old company desperately wants to avoid."
                            },
                            {
                                "example_id": "d585bc8b-96da-4a13-bebe-d3d8270e7769",
                                "sense_id": "66899099-29ea-31db-843a-0cb612d10bd9",
                                "text": "In many fields, we now have the equivalent of Spotify for research: vast databases that help scholars search millions of articles and connect them—often through highly restrictive and increasingly unsustainable subscriptions, but that is another story—instantly to digital copies. (There is also a Napster for research articles, of which we shall not speak.)"
                            }
                        ]
                    }
                ],
