                "senses": [
                    {
                        "sense_id": "ca9ae749-ec62-3fc1-b7b4-d21cc0d9c3cf",
                        "entry_id": "559063dd-7632-3ee7-bba3-cdeda260df4e",
                        "glosses": [
                            "в феодальном обществе — землевладелец-феодал, зависящий по своим земельным владениям от сюзерена, приносящий ему присягу и имеющий перед ним ряд обязательств и повинностей, включая воинскую и денежную"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ebbac9a6-53f6-3f96-962d-675b1c125982",
                        "entry_id": "559063dd-7632-3ee7-bba3-cdeda260df4e",
                        "glosses": [
                            "перен. зависимый субъект"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d7b74b0-46f4-475e-b32a-4188ee809f2e",
                        "source_entry_id": "559063dd-7632-3ee7-bba3-cdeda260df4e",
                        "target_lang_word": "vassal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vassal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f3222de-57d0-3346-a120-615884c5edae",
                                        "entry_id": "476e4507-2ce2-3bd3-8139-49600dc71310",
                                        "glosses": [
                                            "The grantee of a fief, a subordinate granted use of a superior's land and its income in exchange for vows of fidelity and homage and (typically) military service."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a965f84-2c43-4e99-82d9-0803ca37d772",
                                                "sense_id": "5f3222de-57d0-3346-a120-615884c5edae",
                                                "text": "The manor's vassals owed first fruits and a tithe to the parish church, another 10% to the lord (including at least 50 eels), a week or two each year of service in the manor's upkeep, and service in the local fyrd."
                                            },
                                            {
                                                "example_id": "b4b799b3-b741-4e22-ab2c-89cfc1e74be3",
                                                "sense_id": "5f3222de-57d0-3346-a120-615884c5edae",
                                                "text": "It was superimposed on rules of conduct evolved at an earlier date as the spontaneous expression of class consciousness; rules that pertained to the fealty of vassals (the transition appears clearly, towards the end of the eleventh century, in the Book of the Christian Life by Bishop Bonizo of Sutri, for whom the knight is, first and foremost, an enfeoffed vassal ) and constituted above all a class code of noble and 'courteous' people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e9627d-c5b2-37ab-9964-c0811cf65e98",
                                        "entry_id": "476e4507-2ce2-3bd3-8139-49600dc71310",
                                        "glosses": [
                                            "Any direct subordinate bound by such vows to a superior."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987d95d0-2643-4277-a848-5049827766ff",
                                                "sense_id": "43e9627d-c5b2-37ab-9964-c0811cf65e98",
                                                "text": "The king ordered his vassals to join him on the crusade unless they had a written note signed by the archbishop or pope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8cbdcf-b007-31cc-b5f9-0ad851c0a846",
                                        "entry_id": "476e4507-2ce2-3bd3-8139-49600dc71310",
                                        "glosses": [
                                            "Any subordinate bound by similar close ties."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9bd31b-b214-4e7f-9a35-2079ca74482f",
                                                "sense_id": "df8cbdcf-b007-31cc-b5f9-0ad851c0a846",
                                                "text": "The vassals of his anger."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vassal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef0cbb18-91ef-3599-af3e-329eba5d61ef",
                                        "entry_id": "9b8a8a31-c627-390d-bf12-3de04a253adb",
                                        "glosses": [
                                            "Resembling a vassal; slavish; servile."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b896ca3f-6443-48a1-b504-57c03e438497",
                                                "sense_id": "ef0cbb18-91ef-3599-af3e-329eba5d61ef",
                                                "text": "Did they, quoth you? / Who sees the heavenly Rosaline / That, like a rude and savage man of Inde / At the first opening of the gorgeous east / Bows not his vassal head and strucken blind / Kisses the base ground with obedient breast?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vassal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bc7bc11-dd6d-3cff-b506-003f13825228",
                                        "entry_id": "22fcb951-a5a4-322e-9f35-5bf78ae9ccea",
                                        "glosses": [
                                            "To treat as a vassal or to reduce to the position of a vassal; to subject to control; to enslave."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5d5eb00-d17e-306c-a467-8fc8dfa63dd8",
                                        "entry_id": "22fcb951-a5a4-322e-9f35-5bf78ae9ccea",
                                        "glosses": [
                                            "To subordinate to someone or something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ee48366-12fa-4192-a860-8b4328777c31",
                        "source_entry_id": "559063dd-7632-3ee7-bba3-cdeda260df4e",
