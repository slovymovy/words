                ],
                "senses": [
                    {
                        "sense_id": "b75a06c7-f27c-37f5-a580-862eb38ced2d",
                        "entry_id": "57497c59-b48f-36f7-9222-33d6090182ea",
                        "glosses": [
                            "technische Einrichtung, die signalisiert, dass ein Zug abfahren kann, beziehungsweise verantwortliche Person, die Erlaubnis zur Abfahrt eines Zuges erteilt"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "e465eabd-362a-4624-b64f-6c027c83279d",
                                "sense_id": "b75a06c7-f27c-37f5-a580-862eb38ced2d",
                                "text": "„Dazu wurden auf Bahnhöfen mit Abfahrsignalen die am Bahnsteig installierten Abfahrauftraggeber um eine Funktion ergänzt, mit der der Zugführer nach der Feststellung der Abfahrbereitschaft das Abfahrsignal über eine Schlüsseltaste […]“"
                            },
                            {
                                "example_id": "23e778b2-a64d-4cc8-a5df-9220c5dd0e6e",
                                "sense_id": "b75a06c7-f27c-37f5-a580-862eb38ced2d",
                                "text": "„Dann endlich wagt sich der Aufsichtsbeamte aus seinem Pavillon, trottet zum Abfahrauftraggeber und drückt den Ansageknopf: „An Gleis 8 … bitte einsteigen … Türen schließen selbsttätig … Vorsicht bei der Abfahrt!“"
                            },
                            {
                                "example_id": "4ac8b99d-edd7-4180-93dc-3a7eee4810d6",
                                "sense_id": "b75a06c7-f27c-37f5-a580-862eb38ced2d",
                                "text": "„Ohne Einwilligung der beiden ausgekochten Abfahrauftraggeber, das sah Paddy nun vollends ein, konnte er hier keinen Fuß vor die Tür setzen.“"
                            },
                            {
                                "example_id": "89356d60-a992-4f17-b27b-e4eb52900543",
                                "sense_id": "b75a06c7-f27c-37f5-a580-862eb38ced2d",
                                "text": "„Bild 11 : Abfahrauftraggeber unter einem Ausfahrsignal“"
                            },
                            {
                                "example_id": "d3340d1a-408f-40e8-94f3-6f96de0804eb",
                                "sense_id": "b75a06c7-f27c-37f5-a580-862eb38ced2d",
                                "text": "„Bahnfahren ohne Abfahrtauftraggeber ist nicht möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
