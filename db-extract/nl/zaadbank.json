                        "examples": [
                            {
                                "example_id": "0d394764-5ba7-44c9-8a9f-5d5a0b0d2181",
                                "sense_id": "15a2835b-f6ed-3641-8ad6-7fca16793a63",
                                "text": "Het kinderloze stel ging naar de zaadbank, omdat ze graag kinderen wilden krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "28f2d7a6-ab9c-3037-8b0f-c021b2b40cf6",
                        "entry_id": "bb58e4ce-287a-3bc2-a44a-6b0225065885",
                        "glosses": [
                            "een type genenbank dat dient voor de opslag van zaden van planten"
