                        "form_id": "728e2a51-44df-43eb-968c-19f9806eae9c",
                        "entry_id": "ffb41743-f93e-30eb-8c60-3c1baca1a79f",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "contemplative"
                    },
                    {
                        "form_id": "3f787fc0-ef40-4d41-8b0b-f994ba7d806c",
                        "entry_id": "ffb41743-f93e-30eb-8c60-3c1baca1a79f",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "contemplatives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "048fbe5d-8644-3763-bc3d-71bf9e7e081f",
                        "entry_id": "ffb41743-f93e-30eb-8c60-3c1baca1a79f",
                        "glosses": [
                            "Relatif à la contemplation, à la méditation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96f016cb-4901-4a0f-9703-c083b76bbf1b",
                                "sense_id": "048fbe5d-8644-3763-bc3d-71bf9e7e081f",
                                "text": "Je vivais à l’écart de la place publique,\nSerein, contemplatif, ténébreux, bucolique..."
                            },
                            {
                                "example_id": "6d28c998-4fb4-49e9-9944-5ccf16650c67",
                                "sense_id": "048fbe5d-8644-3763-bc3d-71bf9e7e081f",
                                "text": "Esprit contemplatif."
                            },
                            {
                                "example_id": "39defe7b-fd61-4a78-a743-49e71c15c03b",
                                "sense_id": "048fbe5d-8644-3763-bc3d-71bf9e7e081f",
                                "text": "Une patience divine développée par les mauvais traitements, une concentration continuelle exigée par sa vie contemplative, avaient dépouillé son regard de cette audacieuse fierté qui plaît dans certaines figures, et par laquelle il savait accabler nos Régents."
                            }
                        ]
                    },
                    {
                        "sense_id": "d513eeee-240e-38a3-adab-f4a3a429c8b9",
                        "entry_id": "ffb41743-f93e-30eb-8c60-3c1baca1a79f",
                        "glosses": [
                            "Qualifie une organisation de religieux qui pratiquent la méditation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ed6b699f-ae0d-42c9-9da0-0bf86376eb07",
                                "sense_id": "d513eeee-240e-38a3-adab-f4a3a429c8b9",
                                "text": "Et quand on pense que le monde se demande à quoi servent les ordres contemplatifs ! s’était écrié Durtal."
                            },
                            {
                                "example_id": "eb08c432-ceff-44d1-bc95-7ad984eedcf3",
                                "sense_id": "d513eeee-240e-38a3-adab-f4a3a429c8b9",
                                "text": "Ainsi, Messieurs, les établissements congréganistes de tout genre s’élevaient au chiffre formidable de 20 823. Ce chiffre se décomposait en 16 904 établissements enseignants et 3 919 établissements mixtes, c'est-à-dire enseignants et hospitaliers ou contemplatifs, ou bien purement hospitaliers ou purement contemplatifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "590c2682-622c-4671-bfab-21f262cdfb72",
                        "source_entry_id": "ffb41743-f93e-30eb-8c60-3c1baca1a79f",
                        "target_lang_word": "kontemplativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kontemplativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a293c467-d48a-326d-a579-a7b76acda855",
                                        "entry_id": "1d08b154-e14d-37eb-b5ec-2d632f5fadba",
                                        "glosses": [
                                            "besinnlich, beschaulich, Kontemplation betreibend, untätig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c648b02-ad6e-4ca4-9693-c0822a831af4",
                                                "sense_id": "a293c467-d48a-326d-a579-a7b76acda855",
                                                "text": "Das deutsche Ideal war einst kontemplativ, nicht angriffslustig, transzendental, nicht fridrizianisch, …"
                                            },
                                            {
                                                "example_id": "fea6a9b0-d322-4e38-9797-157c65761265",
                                                "sense_id": "a293c467-d48a-326d-a579-a7b76acda855",
                                                "text": "Ich habe auch schon beim Kochen die Philosophie-CDs von Konrad Paul Liessmann gehört, was ihn jetzt vielleicht nicht freut, weil er sich das sicher in kontemplativerem Rahmen konsumiert gewünscht hat …"
                                            },
                                            {
                                                "example_id": "0b16096b-7cca-4878-9649-c92da8d5075a",
                                                "sense_id": "a293c467-d48a-326d-a579-a7b76acda855",
                                                "text": "Dies betrifft hauptsächlich die im Ausland wirkenden Missionare sowie die kontemplativen Klausurschwestern, die keine Einkünfte erzielen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0f34c42-e790-4012-a21d-59bbde79f7cc",
                        "source_entry_id": "ffb41743-f93e-30eb-8c60-3c1baca1a79f",
                        "target_lang_word": "contemplative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contemplative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fcf16f9-ab09-3131-80c7-f97bc0359696",
                                        "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                                        "glosses": [
                                            "Inclined to contemplate; introspective and thoughtful; meditative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ef76512-fdcb-4e48-9011-4682e6ade952",
                                                "sense_id": "3fcf16f9-ab09-3131-80c7-f97bc0359696",
                                                "text": "Compared with the greatest poets, he may be said to be the poet of unpoetical natures, possessed of quiet and contemplative tastes. But unpoetical natures are precisely those which require poetic cultivation. This cultivation Wordsworth is much more fitted to give, than poets who are intrinsically far more poets than he."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09578aac-0697-3b4b-a0d6-eaac73c9d337",
                                        "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                                        "glosses": [
                                            "Pertaining to a religious contemplative, or a contemplative religious orders, especially the Roman Catholic varieties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeaebed8-cb6e-4b1c-80ee-6e20ae8e86f2",
                                                "sense_id": "09578aac-0697-3b4b-a0d6-eaac73c9d337",
                                                "text": "Whether the nuns of yore, being of a submissive rather than a stiff-necked generation, habitually bent their contemplative heads to avoid collision with the beams in the low ceilings of the many chambers of their House [...] may be matters of interest to its haunting ghosts (if any), but constitute no item in Miss Twinkleton's half-yearly accounts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b64826fe-8035-3980-97fe-94ecf5be1111",
                                        "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                                        "glosses": [
                                            "Relating to, or having the power of, contemplation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3dca54-a16a-4c5f-b878-c854cdd4da4d",
                                                "sense_id": "b64826fe-8035-3980-97fe-94ecf5be1111",
                                                "text": "contemplative faculties"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "010ffd1e-a773-3a46-adca-d74e9d33c684",
                                        "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                                        "glosses": [
                                            "In a phase of mental activity in which one begins to recognize and acknowledge the maladaptiveness of someone's behavior (such as one's own, or that of a family member or friend); usually with reference to substance use."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "contemplative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abaed92b-13e2-3f0e-a261-d12a3d6b38eb",
                                        "entry_id": "47253c96-5e1f-3065-b300-d9edd204b8c6",
                                        "glosses": [
                                            "Someone who has dedicated themselves to religious or philosophical contemplation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b989be5d-72de-4265-9477-57aaf6714fd7",
                                                "sense_id": "abaed92b-13e2-3f0e-a261-d12a3d6b38eb",
                                                "text": "Like the white page that surrounds the darkness of each letter you are reading here, eternity surrounds each heartbeat, and as the contemplative watches his breath, he can move out of time through the doorway which opens in the interval between each heartbeat."
                                            },
                                            {
                                                "example_id": "3a8c6a26-2ad1-4140-bf47-e3bc645683b9",
                                                "sense_id": "abaed92b-13e2-3f0e-a261-d12a3d6b38eb",
                                                "text": "The contemplative must not expect exotic feelings, visions or heavenly voices; these did not come from God but from his own fevered imagination and would merely distract him from his true objective [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
