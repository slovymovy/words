{
    "word_family": [
        "isolation",
        "isolator",
        "isolationism",
        "isolationist",
        "isolable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "55d7baf0-2113-3d34-af3d-220fed9d224f",
                    "sense_definition": "To set apart or cut off from others, either physically or socially.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government tried to <w>isolate</w> the country from foreign influence by closing the borders.",
                            "target_lang_translations": {
                                "ru": "Правительство пыталось <w>изолировать</w> страну от иностранного влияния, закрыв границы.",
                                "es": "El gobierno intentó <w>aislar</w> al país de la influencia extranjera cerrando las fronteras."
                            }
                        },
                        {
                            "text": "It is important not to <w>isolate</w> yourself when you are going through a difficult time.",
                            "target_lang_translations": {
                                "ru": "Важно не <w>замыкаться</w> в себе, когда вы переживаете трудные времена.",
                                "es": "Es importante no <w>aislarse</w> cuando estás pasando por un momento difícil."
                            }
                        }
                    ],
                    "synonyms": [
                        "enisle"
                    ],
                    "antonyms": [
                        "integrate",
                        "unite",
                        "connect"
                    ],
                    "common_phrases": [
                        "isolate yourself",
                        "isolate the problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обособлять или отделять от других физически или социально.",
                        "es": "Separar o apartar a alguien o algo de otros, ya sea física o socialmente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изолировать",
                                "target_lang_sense_clarification": "отделять от общества или среды"
                            },
                            {
                                "target_lang_word": "обособлять",
                                "target_lang_sense_clarification": "выделять из общего"
                            },
                            {
                                "target_lang_word": "отделять",
                                "target_lang_sense_clarification": "прекращать связь с кем-либо"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aislar",
                                "target_lang_sense_clarification": "separar de otros o del entorno"
                            },
                            {
                                "target_lang_word": "apartar",
                                "target_lang_sense_clarification": "poner a alguien o algo lejos de otros"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b7e355f-d01f-3db6-ae29-bc928f79475e",
                    "sense_definition": "To separate a specific substance, gene, or strain in pure form from a mixture or culture.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "scientific_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists were finally able to <w>isolate</w> the gene responsible for the rare disease.",
                            "target_lang_translations": {
                                "ru": "Ученым наконец удалось <w>выделить</w> ген, ответственный за редкое заболевание.",
                                "es": "Los científicos finalmente pudieron <w>aislar</w> el gen responsable de la enfermedad rara."
                            }
                        },
                        {
                            "text": "The lab technician managed to <w>isolate</w> the compound from the herbal extract.",
                            "target_lang_translations": {
                                "ru": "Лаборанту удалось <w>выделить</w> соединение из растительного экстракта.",
                                "es": "El técnico de laboratorio logró <w>aislar</w> el compuesto del extracto de hierbas."
                            }
                        }
                    ],
                    "synonyms": [
                        "self-quarantine"
                    ],
                    "antonyms": [
                        "combine",
                        "mix"
                    ],
                    "common_phrases": [
                        "isolate the virus",
                        "isolate the compound"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять конкретное вещество, ген или штамм в чистом виде из смеси или культуры.",
                        "es": "Separar una sustancia, gen o microorganismo específico en forma pura a partir de una mezcla o cultivo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "получать в чистом виде"
                            },
                            {
                                "target_lang_word": "изолировать",
                                "target_lang_sense_clarification": "в научном контексте"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aislar",
                                "target_lang_sense_clarification": "obtener un elemento puro de un compuesto"
                            },
                            {
                                "target_lang_word": "separar",
                                "target_lang_sense_clarification": "extraer un componente de una mezcla"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "937856de-da4f-3f8f-a69e-b5194b23490e",
                    "sense_definition": "To place a person or animal in quarantine to prevent the spread of disease.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "quarantine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital had to <w>isolate</w> the patient to prevent the virus from spreading to others.",
                            "target_lang_translations": {
                                "ru": "Больнице пришлось <w>изолировать</w> пациента, чтобы предотвратить распространение вируса.",
                                "es": "El hospital tuvo que <w>aislar</w> al paciente para evitar que el virus se propagara a otros."
                            }
                        },
                        {
                            "text": "Authorities decided to <w>isolate</w> the infected livestock immediately.",
                            "target_lang_translations": {
                                "ru": "Власти решили немедленно <w>изолировать</w> зараженный скот.",
                                "es": "Las autoridades decidieron <w>aislar</w> al ganado infectado inmediatamente."
                            }
                        }
                    ],
                    "synonyms": [
                        "quarantine"
                    ],
                    "common_phrases": [
                        "isolate the patient"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать человека или животное в карантин для предотвращения распространения болезни.",
                        "es": "Poner a una persona o animal en cuarentena para evitar la propagación de una enfermedad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изолировать",
                                "target_lang_sense_clarification": "помещать в карантин"
                            },
                            {
                                "target_lang_word": "помещать в изолятор",
                                "target_lang_sense_clarification": "медицинская мера"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aislar",
                                "target_lang_sense_clarification": "poner en cuarentena o separar por salud"
                            },
                            {
                                "target_lang_word": "poner en cuarentena",
                                "target_lang_sense_clarification": "medida médica de aislamiento"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56e263c7-2cae-3ad1-8725-df460975bc22",
                    "sense_definition": "To disconnect an electrical component or system from its source of power.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_disconnection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Always <w>isolate</w> the power supply before attempting to repair any electrical wiring.",
                            "target_lang_translations": {
                                "ru": "Всегда <w>отключайте</w> электропитание перед началом ремонта любой электропроводки.",
                                "es": "Siempre <w>desconecte</w> el suministro eléctrico antes de intentar reparar cualquier cableado eléctrico."
                            }
                        },
                        {
                            "text": "The technician had to <w>isolate</w> the faulty circuit to prevent a fire.",
                            "target_lang_translations": {
                                "ru": "Технику пришлось <w>изолировать</w> неисправную цепь, чтобы предотвратить пожар.",
                                "es": "El técnico tuvo que <w>aislar</w> el circuito defectuoso para evitar un incendio."
                            }
                        }
                    ],
                    "antonyms": [
                        "connect"
                    ],
                    "common_phrases": [
                        "isolate the power"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отключать электрический компонент или систему от источника питания.",
                        "es": "Desconectar un componente o sistema eléctrico de su fuente de energía."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изолировать",
                                "target_lang_sense_clarification": "обесточивать для безопасности"
                            },
                            {
                                "target_lang_word": "отключать",
                                "target_lang_sense_clarification": "прерывать подачу питания"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desconectar",
                                "target_lang_sense_clarification": "interrumpir el suministro eléctrico"
                            },
                            {
                                "target_lang_word": "aislar",
                                "target_lang_sense_clarification": "término técnico para cortar el suministro"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6cbfb0e-8cf0-3f7a-8bc7-73d566953c5c",
                    "sense_definition": "Being <w>isolated</w>; occurring alone or once.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "solitary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet wrote about his <w>isolate</w> manhood and the loneliness of the soul.",
                            "target_lang_translations": {
                                "ru": "Поэт писал о своей <w>обособленной</w> зрелости и одиночестве души.",
                                "es": "El poeta escribió sobre su <w>aislada</w> madurez y la soledad del alma."
                            }
                        },
                        {
                            "text": "They walked through the <w>isolate</w> mystery of the quiet temple gardens.",
                            "target_lang_translations": {
                                "ru": "Они шли сквозь <w>уединенную</w> тайну тихих храмовых садов.",
                                "es": "Caminaron a través del <w>aislado</w> misterio de los tranquilos jardines del templo."
                            }
                        }
                    ],
                    "synonyms": [
                        "self-quarantine"
                    ],
                    "antonyms": [
                        "connected",
                        "social"
                    ],
                    "common_phrases": [
                        "isolate mystery"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обособленный, одиночный или встречающийся один раз.",
                        "es": "Que está separado, solo o que ocurre una sola vez."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обособленный",
                                "target_lang_sense_clarification": "литературный стиль"
                            },
                            {
                                "target_lang_word": "одинокий",
                                "target_lang_sense_clarification": "о человеке или месте"
                            },
                            {
                                "target_lang_word": "изолированный",
                                "target_lang_sense_clarification": "отделенный от других"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aislado",
                                "target_lang_sense_clarification": "que está solo o separado"
                            },
                            {
                                "target_lang_word": "solitario",
                                "target_lang_sense_clarification": "que se encuentra sin compañía"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b767010-016d-357a-be48-bac6c36d0cb1",
                    "sense_definition": "An individual, population, or substance that has been separated from others for study.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers compared the new bacterial <w>isolate</w> with the original parental strains.",
                            "target_lang_translations": {
                                "ru": "Исследователи сравнили новый бактериальный <w>изолят</w> с исходными родительскими штаммами.",
                                "es": "Los investigadores compararon el nuevo <w>aislado</w> bacteriano con las cepas parentales originales."
                            }
                        },
                        {
                            "text": "Each <w>isolate</w> was tested for resistance to various antibiotics.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>изолят</w> был протестирован на устойчивость к различным антибиотикам.",
                                "es": "Cada <w>aislado</w> fue probado para determinar su resistencia a varios antibióticos."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bacterial isolate",
                        "clinical isolate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особь, популяция или вещество, выделенные для изучения.",
                        "es": "Individuo, población o sustancia que ha sido separado de otros para su estudio."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изолят",
                                "target_lang_sense_clarification": "биологический образец"
                            },
                            {
                                "target_lang_word": "выделенная культура",
                                "target_lang_sense_clarification": "в микробиологии"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aislado",
                                "target_lang_sense_clarification": "muestra biológica separada"
                            },
                            {
                                "target_lang_word": "cultivo aislado",
                                "target_lang_sense_clarification": "término científico en microbiología"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}