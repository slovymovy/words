{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "1c4b74bb-ab20-34a5-872d-6c7058f3208b",
                    "sense_definition": "Used to express agreement, acceptance, or confirmation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"We are meeting at five o'clock.\" \"<w>Okay</w>, see you then!\"",
                            "target_lang_translations": {
                                "zh": "“我们五点见面。”“<w>好的</w>，到时候见！”"
                            }
                        },
                        {
                            "text": "<w>Okay</w>, I understand what we need to do next.",
                            "target_lang_translations": {
                                "zh": "<w>行</w>，我明白接下来该做什么了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "all right",
                        "sure"
                    ],
                    "common_phrases": [
                        "okay sure",
                        "okay fine"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于表示同意、接受或确认。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "好的",
                                "target_lang_sense_clarification": "表示同意或接受建议。"
                            },
                            {
                                "target_lang_word": "行",
                                "target_lang_sense_clarification": "口语中表示同意。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8211acf6-1a6d-310c-b572-0e524a39cb83",
                    "sense_definition": "Satisfactory; acceptable; fine or in good condition.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't worry, everything is going to be <w>okay</w>.",
                            "target_lang_translations": {
                                "zh": "别担心，一切都会<w>没问题</w>的。"
                            }
                        },
                        {
                            "text": "The food wasn't great, but it was <w>okay</w>.",
                            "target_lang_translations": {
                                "zh": "食物算不上好，但还<w>可以</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "acceptable",
                        "fine",
                        "all right"
                    ],
                    "antonyms": [
                        "bad",
                        "unacceptable"
                    ],
                    "common_phrases": [
                        "be okay",
                        "feel okay"
                    ],
                    "target_lang_definitions": {
                        "zh": "令人满意的；可以接受的；状况良好的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "还可以",
                                "target_lang_sense_clarification": "表示质量或状况尚可。"
                            },
                            {
                                "target_lang_word": "没问题",
                                "target_lang_sense_clarification": "表示一切正常或状况良好。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8f755320-4eca-3c48-9013-44cef629c9b1",
                    "sense_definition": "In an acceptable or satisfactory manner; adequately.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She did <w>okay</w> on her driving test despite being nervous.",
                            "target_lang_translations": {
                                "zh": "尽管很紧张，她驾照考试考得还<w>行</w>。"
                            }
                        },
                        {
                            "text": "He speaks English fairly <w>okay</w> for a beginner.",
                            "target_lang_translations": {
                                "zh": "作为一个初学者，他的英语说得还<w>可以</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fine",
                        "adequately"
                    ],
                    "antonyms": [
                        "poorly"
                    ],
                    "common_phrases": [
                        "do okay"
                    ],
                    "target_lang_definitions": {
                        "zh": "以可以接受或令人满意的方式；适当地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "还行",
                                "target_lang_sense_clarification": "表示表现达到及格或满意水平。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2606c2b-0013-3b5f-ab3d-ad742369659f",
                    "sense_definition": "To approve, authorize, or give permission for something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager will <w>okay</w> the project budget tomorrow.",
                            "target_lang_translations": {
                                "zh": "经理明天会<w>批准</w>项目预算。"
                            }
                        },
                        {
                            "text": "She <w>okayed</w> the final draft before it went to print.",
                            "target_lang_translations": {
                                "zh": "她在定稿送印前予以了<w>批准</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "approve",
                        "authorize",
                        "sanction"
                    ],
                    "antonyms": [
                        "reject",
                        "deny"
                    ],
                    "common_phrases": [
                        "okay the plan"
                    ],
                    "target_lang_definitions": {
                        "zh": "批准、授权或准许某事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "批准",
                                "target_lang_sense_clarification": "正式同意某项计划或预算。"
                            },
                            {
                                "target_lang_word": "同意",
                                "target_lang_sense_clarification": "准许某事进行。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c943a18-a9eb-3c30-91b1-fd58bbeb4c87",
                    "sense_definition": "An endorsement, approval, or sign of agreement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We just need the boss's <w>okay</w> before we start.",
                            "target_lang_translations": {
                                "zh": "我们开始前只需要老板的<w>批准</w>。"
                            }
                        },
                        {
                            "text": "She gave her final <w>okay</w> to the new design.",
                            "target_lang_translations": {
                                "zh": "她对新设计给出了最终的<w>许可</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "approval",
                        "green light",
                        "endorsement"
                    ],
                    "antonyms": [
                        "denial",
                        "rejection"
                    ],
                    "common_phrases": [
                        "give the okay",
                        "get the okay"
                    ],
                    "target_lang_definitions": {
                        "zh": "背书、批准或同意的标志。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "批准",
                                "target_lang_sense_clarification": "指获得的正式许可。"
                            },
                            {
                                "target_lang_word": "许可",
                                "target_lang_sense_clarification": "指准许行动的信号。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}