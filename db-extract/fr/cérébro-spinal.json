                "senses": [
                    {
                        "sense_id": "e7161a00-0128-3210-98b3-32cb1f3c57ef",
                        "entry_id": "605a57d0-fcf0-3a76-a239-e450761ca47b",
                        "glosses": [
                            "Qui a trait au cerveau et à la moelle épinière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0837da9-b9dd-4886-a4fb-de44f84d4e40",
                                "sense_id": "e7161a00-0128-3210-98b3-32cb1f3c57ef",
                                "text": "Système, axe cérébro-spinal, Ensemble du cerveau et de la moelle épinière."
                            },
                            {
                                "example_id": "3a734db2-797e-45a1-93d0-56163d6ba31b",
                                "sense_id": "e7161a00-0128-3210-98b3-32cb1f3c57ef",
                                "text": "« Rentré chez moi, je fais un repas plantureux, arrosé de whisky, et je me suis guéri. »\n– Mais quelle maladie aviez-vous donc, Basie ?\n– Une méningite cérébro-spinale."
                            },
                            {
                                "example_id": "9f6d2e5c-4d25-409e-b478-a8ee94b93f14",
                                "sense_id": "e7161a00-0128-3210-98b3-32cb1f3c57ef",
                                "text": "Elle avait eu un grand chagrin dans la vie, la mort d’une fillette de cinq ans, enlevée par une méningite cérébro-spinale, vingt jours avant la naissance d’un nouvel enfant."
                            }
                        ]
                    }
                ],
