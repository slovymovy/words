                ],
                "senses": [
                    {
                        "sense_id": "56fa7454-376e-3137-ac7e-332242c1293c",
                        "entry_id": "b3a44ece-888d-34b6-948e-976bd9ebcdb7",
                        "glosses": [
                            "Secousse musculaire brève et involontaire, entrainant un déplacement brusque de la partie intéressée du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c308c444-c761-490d-8714-341416618afd",
                                "sense_id": "56fa7454-376e-3137-ac7e-332242c1293c",
                                "text": "Son museau terreux, ses oreilles crasses, les clonies de ses flancs lui racontent les mystères, la peur, la mort, les ronds de sorcière."
                            },
                            {
                                "example_id": "c4eea9d4-e5d9-48e5-932f-867fd8c011d2",
                                "sense_id": "56fa7454-376e-3137-ac7e-332242c1293c",
                                "text": "La clonie prédomine au niveau du ventre et s’étend parfois au thorax sans la moindre gène respiratoire, avec persistance entière de la connaissance."
                            },
                            {
                                "example_id": "f51acaec-acb6-43d5-8061-ee191a7eeab1",
                                "sense_id": "56fa7454-376e-3137-ac7e-332242c1293c",
                                "text": "La clonie est précédée d’une phase tonique."
                            }
                        ]
                    },
                    {
                        "sense_id": "d11781fc-0fc6-3d12-801f-3e7e9a0dce90",
                        "entry_id": "b3a44ece-888d-34b6-948e-976bd9ebcdb7",
                        "glosses": [
                            "Syllabe répétée par un bègue."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
