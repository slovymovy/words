                                        "entry_id": "52665b5e-ab2c-3828-ab0e-c34504a028c6",
                                        "glosses": [
                                            "In Christian belief, the three persons of the Godhead: the Father, Son, and Holy Spirit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b4b0f90-2a5d-4583-81d3-c5e81caee71d",
                                                "sense_id": "e1e6d7f8-7cb1-32f0-8df7-e88c9fae01c4",
                                                "text": "He speaks distinctly of the Trinity of the godhead in the Father, the Son, and the Holy Ghost."
                                            },
                                            {
                                                "example_id": "c5068132-33de-4414-8100-28a5d1d8bb91",
                                                "sense_id": "e1e6d7f8-7cb1-32f0-8df7-e88c9fae01c4",
                                                "text": "From all eternity Jesus Christ existed, and Jesus Christ was with God the Father, the first person of the Trinity; and Jesus Christ was God the Son, the second person of the Trinity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab350760-e8e1-3d97-9470-578713c160dd",
