{
    "word_family": [
        "przypadek",
        "przypadkowy",
        "przypadkowo",
        "przypadkowość"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "751dbb42-1051-31e8-afb6-8c3bad9562ae",
                    "sense_definition": "przywrzeć do czegoś, przylgnąć do powierzchni, osoby lub rzeczy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Przypadł</w> do muru i krzyknął: „Jestem ranny!”",
                            "target_lang_translations": {
                                "ru": "Он <w>прижался</w> к стене и крикнул: «Я ранен!»"
                            }
                        },
                        {
                            "text": "Przerażone dziecko <w>przypadło</w> do matki, szukając u niej schronienia.",
                            "target_lang_translations": {
                                "ru": "Испуганный ребенок <w>прильнул</w> к матери, ища у нее защиты."
                            }
                        }
                    ],
                    "synonyms": [
                        "przylgnąć",
                        "przywrzeć"
                    ],
                    "common_phrases": [
                        "przypaść do ziemi",
                        "przypaść do muru"
                    ],
                    "target_lang_definitions": {
                        "ru": "плотно прижаться к кому-либо или чему-либо, прильнуть"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прижаться",
                                "target_lang_sense_clarification": "плотно прильнуть к поверхности или человеку"
                            },
                            {
                                "target_lang_word": "прильнуть",
                                "target_lang_sense_clarification": "тесно прижаться, обычно в поисках защиты или ласки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4f5fdb5-a1a7-3542-9f29-8b930917d565",
                    "sense_definition": "zdarzyć się, wypaść w danym momencie lub okresie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym roku święta <w>przypadły</w> w środku tygodnia.",
                            "target_lang_translations": {
                                "ru": "В этом году праздники <w>пришлись</w> на середину недели."
                            }
                        },
                        {
                            "text": "Jego urodziny <w>przypadają</w> na sobotę, więc zrobimy wielką imprezę.",
                            "target_lang_translations": {
                                "ru": "Его день рождения <w>выпадает</w> на субботу, так что мы устроим большую вечеринку."
                            }
                        }
                    ],
                    "synonyms": [
                        "wypaść"
                    ],
                    "common_phrases": [
                        "przypadać na dzień",
                        "przypadać w terminie"
                    ],
                    "target_lang_definitions": {
                        "ru": "приходиться на определенное время или дату"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приходиться",
                                "target_lang_sense_clarification": "о дате или событии, выпадающем на определенный день"
                            },
                            {
                                "target_lang_word": "выпадать",
                                "target_lang_sense_clarification": "о дате, приходящейся на определенный день недели или число"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f264ca0a-168d-3e3f-979c-cc5b8aad2ce0",
                    "sense_definition": "stać się czyimś udziałem, zostać komuś przydzielonym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "udział",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zaszczyt zdania relacji z naszej podróży <w>przypadł</w> właśnie mnie.",
                            "target_lang_translations": {
                                "ru": "Честь отчитаться о нашей поездке <w>досталась</w> именно мне."
                            }
                        },
                        {
                            "text": "W spadku <w>przypadł</w> mu stary dom po dziadkach.",
                            "target_lang_translations": {
                                "ru": "В наследство ему <w>достался</w> старый дом от дедушки с бабушкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "dostać się",
                        "przypaść w udziale"
                    ],
                    "common_phrases": [
                        "przypaść w udziale"
                    ],
                    "target_lang_definitions": {
                        "ru": "достаться кому-либо, стать чьей-то долей или обязанностью"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достаться",
                                "target_lang_sense_clarification": "получить что-то в наследство или в результате распределения"
                            },
                            {
                                "target_lang_word": "выпасть на долю",
                                "target_lang_sense_clarification": "стать чьей-то участью или обязанностью"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}