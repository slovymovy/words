                        "sense_id": "c2c35d70-9945-319b-9d49-e1d1bc585334",
                        "entry_id": "d0727665-5b4a-3d6c-9cb7-321669e6aefa",
                        "glosses": [
                            "iemand die ergens een explosief heeft geplaatst met als doel omdat explosief tot ontploffing te brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8a7da0-86c4-4df6-8f06-e27a51916022",
                                "sense_id": "c2c35d70-9945-319b-9d49-e1d1bc585334",
                                "text": "Bij een afzonderlijk incident in Austin, Texas liet iemand recentelijk bompakketjes achter bij woonhuizen. Die ontploften wel, waardoor twee mensen om het leven kwamen en anderen gewond raakten. De verdachte bommenlegger blies zichzelf op toen de politie hem op de hielen zat."
                            },
                            {
                                "example_id": "a3cc411a-0bfd-47e6-8e0f-f0c09bb9ef54",
                                "sense_id": "c2c35d70-9945-319b-9d49-e1d1bc585334",
                                "text": ",,Ik ben niet gewelddadig\", zegt G. vrijdag aan het begin van de rechtszaak. De bommenlegger hoort door het OM tien jaar cel en tbs met dwangverpleging tegen zich eisen voor zijn zogenaamde 'vergismoord'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92e67f72-b620-4a74-8383-2ca36dff26f8",
                        "source_entry_id": "d0727665-5b4a-3d6c-9cb7-321669e6aefa",
