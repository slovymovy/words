                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03342184-e971-4cb2-9764-c52f4957d143",
                                "sense_id": "019254f7-5c12-33ca-9b26-299447b4bf26",
                                "text": "Waarom zouden we het veranderen? Het is al eeuwenlang zo!"
                            },
                            {
                                "example_id": "739a5e15-dc0c-48aa-bf6e-dc622691a734",
                                "sense_id": "019254f7-5c12-33ca-9b26-299447b4bf26",
                                "text": "Maar Kreta, het eiland dat eeuwenlang werd overheerst door Italianen, Arabieren en Ottomanen, maakt pas sinds 1913 deel uit van Griekenland, waardoor de plaatselijke Kritikí kouzina een smeltkroes is van vele invloeden."
                            }
                        ]
                    },
