                        "sense_id": "1e0485e9-8416-3ef2-985e-cde820805a18",
                        "entry_id": "c70d9327-802f-3591-84cb-1d6eb2770e4c",
                        "glosses": [
                            "Donner un caractère nocturne à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cdbc4eb-f742-4c33-9969-61b5471f34a8",
                                "sense_id": "1e0485e9-8416-3ef2-985e-cde820805a18",
                                "text": "Alors que le jour envahit peu à peu la nuit, on peut imaginer que des savoirs de la nuit, des approches plus sensibles et humaines de la société peuvent contribuer en sens inverse à « nocturniser » le jour."
                            },
                            {
                                "example_id": "5fd2f388-0613-46ba-8b2f-178aa9d84415",
                                "sense_id": "1e0485e9-8416-3ef2-985e-cde820805a18",
                                "text": "Et oui, le black sur le ciel est très efficace pour \"nocturniser\" une image."
                            },
                            {
                                "example_id": "d438d291-ac4d-45a7-ae97-34fd5556737b",
                                "sense_id": "1e0485e9-8416-3ef2-985e-cde820805a18",
                                "text": "Et moi une grosse envie de nocturniser cette photo :)"
                            }
                        ]
                    }
