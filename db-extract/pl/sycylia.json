                                        "sense_id": "3cad24bb-9c96-3268-86fd-b7d7379ec0fc",
                                        "entry_id": "8ea6660c-8ac0-31e6-8847-6688993bf49d",
                                        "glosses": [
                                            "Italiaans eiland ten zuiden van het Italiaanse schiereiland"
                                        ],
                                        "tags": [
                                            "toponiem: eiland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff25833-4dd4-4de4-9a04-36a6e16f7a08",
                                                "sense_id": "3cad24bb-9c96-3268-86fd-b7d7379ec0fc",
                                                "text": "Sicilië heeft van bovenaf gezien een driehoekige vorm."
                                            },
                                            {
                                                "example_id": "3b6fa78e-2537-450e-867e-fff0b148f968",
                                                "sense_id": "3cad24bb-9c96-3268-86fd-b7d7379ec0fc",
                                                "text": "Dag 1 Pal ermo Palermo is de onbetwiste economische, politieke en culturele hoofdstad van Sicilië en tevens een van de belangrijkste kunststeden van Italië."
                                            },
                                            {
                                                "example_id": "41ef9b2e-bec5-47be-9b51-8a25a30f9be1",
                                                "sense_id": "3cad24bb-9c96-3268-86fd-b7d7379ec0fc",
                                                "text": "Of we weleens eerder op Sicilië zijn geweest, wat we normaal gesproken eten, hoe laat, met wie en wat we verwachten van de rondleiding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2b400ce-ba81-4697-9993-0aed4f5638d9",
                        "source_entry_id": "50a38ebf-9a8e-34d6-96b1-eb5ec94e0c6c",
                        "source_sense_id": "de23d50a-47da-32d1-bddf-10eaa95e129b",
                        "target_lang_word": "Sizilien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sizilien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25de4e7c-a85b-3821-ad9e-99000b653d27",
                                        "entry_id": "441a1f7d-8ae6-337d-bacf-f61ceb85bf23",
                                        "glosses": [
                                            "Insel im Mittelmeer und autonome Region Italiens"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49463593-3a67-4346-a8b2-f37bfdc0c708",
                                                "sense_id": "25de4e7c-a85b-3821-ad9e-99000b653d27",
                                                "text": "Sizilien liegt wie ein Fußball vor dem italienischen Stiefel."
                                            },
                                            {
                                                "example_id": "115438bb-4d9c-4081-ba14-7162fbe7f284",
                                                "sense_id": "25de4e7c-a85b-3821-ad9e-99000b653d27",
                                                "text": "„Die beharrliche Strategie des Quintus Fabius Maximus, die Siege des Marcus Claudius Marcellus in Sizilien, die Erfolge des Publius Cornelius Scipio in Hispanien und das militärische Geschick des Marcus Livius Salinator und Gaius Claudius Nero in Italien brachten den immer noch unbesiegten Hannibal in Bedrängnis und zwangen ihn, aus Italien abzuziehen.“"
                                            },
                                            {
                                                "example_id": "49dcec38-0824-44c4-b2a5-01caf6e9a3fb",
                                                "sense_id": "25de4e7c-a85b-3821-ad9e-99000b653d27",
                                                "text": "„Und schließlich versucht er, Sizilien aus den Händen der muslimischen Sarazenen zurückzugewinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb5c507d-3d08-3d32-a3b4-af2f417dda21",
                                        "entry_id": "441a1f7d-8ae6-337d-bacf-f61ceb85bf23",
                                        "glosses": [
                                            "Königreich, das durch Zusammenfassung der Königreiche auf Sizilien und auf dem süditalienischen Festland bei Neapel entstand"
                                        ],
                                        "tags": [
                                            "historical",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
