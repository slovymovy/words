        "nl-extract.jsonl": [
            {
                "entry_id": "4da9423f-fe1d-3d7f-be56-478a558b2d9d",
                "word": "tijgeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f2043b5-a11c-33f4-8607-fce0f6c087c1",
                        "entry_id": "4da9423f-fe1d-3d7f-be56-478a558b2d9d",
                        "glosses": [
                            "sluipen als een tijger met de buik op de grond als een oefening voor militairen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfcd14eb-c001-4479-bf09-e0af3546fbb3",
                                "sense_id": "4f2043b5-a11c-33f4-8607-fce0f6c087c1",
                                "text": "Met hun wapens op de lange latten, tijgeren door een dik pak sneeuw en ’s nachts slapen in een ijskoud hol. Het Korps Mariniers traint deze dagen in het hoge noorden van Noorwegen."
                            },
                            {
                                "example_id": "addb94c4-1ee5-44f3-bf1e-badb23b2efa2",
                                "sense_id": "4f2043b5-a11c-33f4-8607-fce0f6c087c1",
                                "text": "Een 'obstakel-estafette met ruige hindernissen', niet geschikt voor mensen met smetvrees of een modderallergie, luidde de waarschuwing vooraf. Enige tientallen teams met twee heren en twee dames durfden het aan en tijgerden zondagmiddag door de blubber, sjouwden met zware gewichten, renden over een stapel autobanden en plonsden van een hoge glijbaan in een waterbak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "daf36945-7099-40eb-822d-e93e07aec760",
                        "source_entry_id": "4da9423f-fe1d-3d7f-be56-478a558b2d9d",
                        "source_sense_id": "4f2043b5-a11c-33f4-8607-fce0f6c087c1",
                        "target_lang_word": "ambush",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23fcac50-a84b-39c4-b44c-3b4956bf076f",
                                        "entry_id": "1943d2c7-6ec7-35b6-aa8e-ba363f8e891c",
                                        "glosses": [
                                            "The act of concealing oneself and lying in wait to attack or kill by surprise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa2f1697-ba64-36e4-af59-635cdc26d485",
                                        "entry_id": "1943d2c7-6ec7-35b6-aa8e-ba363f8e891c",
                                        "glosses": [
                                            "An attack launched from a concealed position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ecf2060-e195-41cf-bba7-45168495474f",
                                                "sense_id": "fa2f1697-ba64-36e4-af59-635cdc26d485",
                                                "text": "Heaven, whose high walls fear no assault or siege / Or ambush from the deep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fb55b9f-e82c-3df7-84c5-65fbd377ef53",
                                        "entry_id": "1943d2c7-6ec7-35b6-aa8e-ba363f8e891c",
                                        "glosses": [
                                            "The concealed position or state from which a surprise attack is launched."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b162d9-9a75-48dc-ae5b-f5dd7672fe81",
                                                "sense_id": "0fb55b9f-e82c-3df7-84c5-65fbd377ef53",
                                                "text": "the Georgean hills,\nWhoſe tops are couered with Tartarian theeues,\nThat lie in ambuſh, waiting for a pray:"
                                            },
                                            {
                                                "example_id": "72910dfd-ce68-4845-9abe-072cdabb1ce9",
                                                "sense_id": "0fb55b9f-e82c-3df7-84c5-65fbd377ef53",
                                                "text": "Therefore, why not wait in ambush for Conrad behind the door, and when he entered bring down a chair, or one of the decrepit pictures, smartly on to his head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c4a97ae-7fde-3719-a94e-775584709078",
                                        "entry_id": "1943d2c7-6ec7-35b6-aa8e-ba363f8e891c",
                                        "glosses": [
                                            "The troops posted in a concealed place, for attacking by surprise; those who lie in wait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba9728e-75b3-4472-a67d-b58ced2031e0",
                                                "sense_id": "4c4a97ae-7fde-3719-a94e-775584709078",
                                                "text": "And the ambush arose quickly out of their place, and they ranne as soone as he had stretched out his hand: and they entred into the city, and tooke it, and hasted, and set the citie on fire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ambush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fcba1ab-ac88-3cc0-a315-3bd84cd25e75",
                                        "entry_id": "b5ddef08-5bb6-3384-abf9-468a26ab66ac",
                                        "glosses": [
                                            "To station in ambush with a view to surprise an enemy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feacaade-a8fe-4e5c-a64f-a364619ef402",
                                                "sense_id": "5fcba1ab-ac88-3cc0-a315-3bd84cd25e75",
                                                "text": "By ambuſh’d men, behind their Temple laid, / VVe have the King of Mexico betray’d."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4442bf86-d17f-3607-972e-ca2f9413ca09",
                                        "entry_id": "b5ddef08-5bb6-3384-abf9-468a26ab66ac",
                                        "glosses": [
                                            "To attack by ambush; to waylay."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45c08c01-ab81-4e24-8494-f069ea246818",
                                                "sense_id": "4442bf86-d17f-3607-972e-ca2f9413ca09",
                                                "text": "The contrast with the start was profound. In the opening 40 minutes Löw’s team had been ambushed here, the world champions run into a state of breathless trauma by a thrillingly vibrant Mexico attack."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
