                "senses": [
                    {
                        "sense_id": "11604c2b-1b40-38ee-ac8e-df70d2fb99be",
                        "entry_id": "20e7da57-8505-3666-9655-e8fde3f7e9c3",
                        "glosses": [
                            "Person, die bei der Polizei als Chef fungiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b234458-ec3b-4d98-bb84-99ce9d7fbffb",
                                "sense_id": "11604c2b-1b40-38ee-ac8e-df70d2fb99be",
                                "text": "„Omar hatte alle möglichen Freunde, auch seriöse, und einer seiner besten seriösen Freunde war der Polizeichef von Marrakesch.“"
                            },
                            {
                                "example_id": "1a5e9f45-1d7b-4d23-963b-b1c75f2c18eb",
                                "sense_id": "11604c2b-1b40-38ee-ac8e-df70d2fb99be",
                                "text": "„Der Wirt bedient den Polizeichef mit der größten Höflichkeit und nennt ihn Exzellenz, er begreift wohl, daß er es mit einem allmächtigen Mann zu tun hat.“"
                            },
                            {
                                "example_id": "b15753a9-5b4c-4e38-b8dd-23df78170574",
                                "sense_id": "11604c2b-1b40-38ee-ac8e-df70d2fb99be",
                                "text": "„Das einzige Problem war, dass der Polizeichef sich gerade in einer sehr ausgedehnten Mittagspause befand.“"
                            },
                            {
                                "example_id": "951840d9-6617-4b2c-b2a3-d342c351a583",
                                "sense_id": "11604c2b-1b40-38ee-ac8e-df70d2fb99be",
                                "text": "„Das Verhör an diesem Vormittag hatte sich ganz anders entwickelt, als der Polizeichef es gewöhnt war.“"
                            },
                            {
                                "example_id": "c96c44d6-1d05-4558-8f1c-a5b10507bc6b",
                                "sense_id": "11604c2b-1b40-38ee-ac8e-df70d2fb99be",
                                "text": "„Sie hatte sich mit dem Polizeichef und mit einem der Kasinodirektoren angefreundet, und diese beiden Männer führten sie abends aus und liehen ihr tagsüber ihre Wagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
