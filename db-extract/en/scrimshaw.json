                        "entry_id": "c1e9c650-3f39-3995-a5fe-255e4e808327",
                        "glosses": [
                            "A small ornamental handicraft created by carving or engraving bone (originally whalebone or whales' teeth), ivory, or other materials, formerly produced by sailors on whaling ships to pass the time on long voyages."
                        ],
                        "tags": [
                            "also",
                            "attributive",
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "56cecff9-815c-4ca0-bbbd-c05a061d67b5",
                                "sense_id": "7e49f6ae-4974-346e-995f-dbc65cb1f93a",
                                "text": "Rooney got his skull exposed, doggone it\nSoon he's gonna get scrimshaw carved on it"
                            }
                        ]
                    },
