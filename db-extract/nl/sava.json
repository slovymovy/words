                                "example_id": "5e1b0be3-d2bc-4982-baea-9a147f4cefd8",
                                "sense_id": "c5e16a3e-f91b-393c-8d65-655ace5c1bc4",
                                "text": "De Sava is de grootste rechterzijrivier van de Donau."
