                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théoricienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b786fe99-b6e3-3ea1-8f44-89d1598764bc",
                                        "entry_id": "dcb2eb54-d91b-38b9-8aa8-1370c0120f82",
                                        "glosses": [
                                            "Celle qui connaît les principes d’un art, d’une science, d’une technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4daf6fe2-ec16-44be-a910-843c7060748c",
                                                "sense_id": "b786fe99-b6e3-3ea1-8f44-89d1598764bc",
                                                "text": "Car Dworkin possède à la fois le tempérament de la polémiste et la rigueur de la théoricienne."
                                            },
                                            {
                                                "example_id": "3be22a4d-814d-4e75-9768-68f31435a2db",
                                                "sense_id": "b786fe99-b6e3-3ea1-8f44-89d1598764bc",
                                                "text": "Le premier concerne la théorie du « regard masculin » issue des réflexions de la théoricienne du cinéma Laura Mulvey, très fréquemment citée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8d95001-1664-3eb7-bb60-444904068516",
                                        "entry_id": "dcb2eb54-d91b-38b9-8aa8-1370c0120f82",
                                        "glosses": [
                                            "Celle qui est plus intéressée par l’élaboration de théories, par les connaissances abstraites que par les applications concrètes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9b0abee-92b6-4ad0-ab7a-70d5f999c0c0",
                        "source_entry_id": "969940fc-10fd-3308-8056-2e9a67cc915e",
                        "source_sense_id": "f597e99b-1015-377a-8e61-1e414cdfd3d2",
                        "source_sense_description": "someone who constructs theories",
                        "target_lang_word": "Theoretiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theoretiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                        "entry_id": "81a5ce36-c445-34b0-8c1b-39219b0da191",
                                        "glosses": [
                                            "Person mit wenig oder keiner praktischen Erfahrung, jedoch mit einer hohen theoretischen Kenntnis über eine bestimmte Tätigkeit oder in einem bestimmten Fachgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e12a567-2fac-4499-b905-2e9c475fd9c4",
                                                "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                                "text": "Ich kann Dir bei Deinen Problemen mit dem Computer nicht helfen. Ich bin eher ein Theoretiker."
                                            },
                                            {
                                                "example_id": "115e6905-f51f-416d-a0bb-9b95cb76c210",
                                                "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                                "text": "In der Firma können wir keine Theoretiker brauchen."
                                            },
                                            {
                                                "example_id": "e04b9447-8506-4aa1-83f3-c9b403d0f332",
                                                "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                                "text": "„Sozialdarwinistische Theoretiker können zwar Schlagworte und einzelne Zitate Darwins anführen, aber sie ignorieren grundlegende Einsichten der Evolutionstheorie.“"
                                            },
                                            {
                                                "example_id": "da50bdb0-ab4b-4884-b1bb-947595049e88",
                                                "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                                "text": "[Dietrich Bonhoeffer:] „Der Theoretiker, den so mancher Kommilitone als überheblich erlebte, wurde zum Praktiker, der für Frieden und Gerechtigkeit kämpfen wollte.“"
                                            },
                                            {
                                                "example_id": "0a12f296-59bd-43cc-aa51-c22941b125bc",
                                                "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                                "text": "„Die Erfahrung, das heißt: allein die Bestätigung des durch Denken Gewonnenen bringt dem Theoretiker Ruhe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
