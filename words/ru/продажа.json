            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4dcad8d2-069a-35dd-8925-23ee5d0fe666",
                    "sense_definition": "Передача товара или услуги покупателю в обмен на деньги.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы выставили старую мебель на <w>продажу</w> через интернет.",
                            "target_lang_translations": {
                                "en": "We put the old furniture up for <w>sale</w> online.",
                                "pl": "Wystawiliśmy stare meble na <w>sprzedaż</w> przez internet."
                            }
                        },
                        {
                            "text": "Отец занимается <w>продажей</w> подержанных автомобилей уже много лет.",
                            "target_lang_translations": {
                                "en": "Father has been involved in the <w>sale</w> of used cars for many years.",
                                "pl": "Ojciec zajmuje się <w>sprzedażą</w> używanych samochodów już od wielu lat."
                            }
                        }
                    ],
                    "synonyms": [
                        "сбыт",
                        "торговля",
                        "реализация"
                    ],
                    "antonyms": [
                        "покупка",
                        "приобретение",
                        "купля"
                    ],
                    "common_phrases": [
                        "выставить на продажу",
                        "договор купли-продажи",
                        "розничная продажа",
                        "оптовая продажа"
                    ],
                    "target_lang_definitions": {
                        "en": "The transfer of goods or services to a buyer in exchange for money.",
                        "pl": "Przekazanie towaru lub usługi kupującemu w zamian za pieniądze."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sale",
                                "target_lang_sense_clarification": "transaction"
                            },
                            {
                                "target_lang_word": "selling",
                                "target_lang_sense_clarification": "activity or process"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sprzedaż",
                                "target_lang_sense_clarification": "transakcja lub działalność handlowa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ce1d8de-f82f-3362-8ac3-83c46ceabb91",
                    "sense_definition": "Наличие товаров в магазине или на рынке, доступных для покупки.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этого популярного журнала сейчас нет в <w>продаже</w>.",
                            "target_lang_translations": {
                                "en": "This popular magazine is currently not for <w>sale</w>.",
                                "pl": "Tego popularnego czasopisma nie ma obecnie w <w>sprzedaży</w>."
                            }
                        },
                        {
                            "text": "Новые билеты поступят в <w>продажу</w> на следующей неделе.",
                            "target_lang_translations": {
                                "en": "New tickets will go on <w>sale</w> next week.",
                                "pl": "Nowe bilety trafią do <w>sprzedaży</w> w przyszłym tygodniu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "быть в продаже",
                        "поступить в продажу",
                        "нет в продаже"
                    ],
                    "target_lang_definitions": {
                        "en": "The availability of goods in a store or market for purchase.",
                        "pl": "Dostępność towarów w sklepie lub na rynku, przeznaczonych do kupienia."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sale",
                                "target_lang_sense_clarification": "availability for purchase"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sprzedaż",
                                "target_lang_sense_clarification": "dostępność na rynku (np. w sprzedaży)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
