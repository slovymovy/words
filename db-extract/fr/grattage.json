        "fr-extract.jsonl": [
            {
                "entry_id": "03a83bf7-164a-3578-98b0-121f03696901",
                "word": "grattage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a9c4103b-0b7f-4c0b-b215-7ffac127114a",
                        "entry_id": "03a83bf7-164a-3578-98b0-121f03696901",
                        "tags": [
                            "plural"
                        ],
                        "form": "grattages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbc7ec06-9334-3a0a-bd37-91014eaa02dc",
                        "entry_id": "03a83bf7-164a-3578-98b0-121f03696901",
                        "glosses": [
                            "Action de gratter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5953abaf-44f7-4229-83b0-0e30ae178dde",
                                "sense_id": "fbc7ec06-9334-3a0a-bd37-91014eaa02dc",
                                "text": "Une chance au grattage, une chance au tirage."
                            },
                            {
                                "example_id": "04966691-5876-4855-bc66-aed549def6e7",
                                "sense_id": "fbc7ec06-9334-3a0a-bd37-91014eaa02dc",
                                "text": "J’ai des mycoses, des infections bactériennes, un eczéma atopique généralisé, c’est une véritable infection, je suis en train de pourrir sur place et tout le monde s’en fout, personne ne peut rien pour moi, j’ai été honteusement abandonné par la médecine, qu’est-ce qu’il me reste à faire ? Me gratter, me gratter sans relâche, c’est ça qu’est devenue ma vie maintenant : une interminable séance de grattage… »"
                            },
                            {
                                "example_id": "b6a019ba-f9e0-4a02-a084-f0129a5e081a",
                                "sense_id": "fbc7ec06-9334-3a0a-bd37-91014eaa02dc",
                                "text": "Le grattage des os."
                            }
                        ]
                    },
                    {
                        "sense_id": "19e2b402-8857-32bd-a2b4-fe00a945c1e8",
                        "entry_id": "03a83bf7-164a-3578-98b0-121f03696901",
                        "glosses": [
                            "Vol, chourave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be293b1-09fa-426f-abb8-7df6c001fcaa",
                                "sense_id": "19e2b402-8857-32bd-a2b4-fe00a945c1e8",
                                "text": "J’suis à deux grattages de clopes d’faire les points d’pégase."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e46f615-4cf9-3a4e-a871-310719fec440",
                        "entry_id": "03a83bf7-164a-3578-98b0-121f03696901",
                        "glosses": [
                            "Action commise par un faussaire pour retirer une mention (comme le nom) d’un papier officiel pour la remplacer par une autre et fabriquer ainsi un faux document à partir d’un vrai."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eff7e4ae-6457-4c59-86c4-da5a0e4810a1",
                        "source_entry_id": "03a83bf7-164a-3578-98b0-121f03696901",
                        "target_lang_word": "Kratzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kratzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee138600-0419-3994-8a68-079e5aeca7a7",
                                        "entry_id": "c5db59ef-2d21-31b7-9490-318cee000772",
                                        "glosses": [
                                            "das Schaben, wiederholtes Reiben mit etwas Scharfem, Spitzem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c98dad-3ec9-4961-be67-feb863eab07b",
                                                "sense_id": "ee138600-0419-3994-8a68-079e5aeca7a7",
                                                "text": "„Wieder erklang das leise Kratzen, als die Feder über das noch unbeschriebene Pergament glitt.“"
                                            },
                                            {
                                                "example_id": "09b8cb1b-e6d0-41c9-802f-fcb5bd051403",
                                                "sense_id": "ee138600-0419-3994-8a68-079e5aeca7a7",
                                                "text": "„Ein Reiz in oder auf der Haut löst reflexartiges Kratzen aus.“"
                                            },
                                            {
                                                "example_id": "14480500-6c97-41be-887a-93db812ff61b",
                                                "sense_id": "ee138600-0419-3994-8a68-079e5aeca7a7",
                                                "text": "„Ein leichtes ‚Kitzeln‘ oder ‚Kratzen‘ im Hals führt nicht sofort, wohl aber nach einer Weile, zum Husten.“"
                                            },
                                            {
                                                "example_id": "3f2607e7-dbdb-45ea-a78b-b5f221b2559b",
                                                "sense_id": "ee138600-0419-3994-8a68-079e5aeca7a7",
                                                "text": "„Das Kratzen bei Neurodermitis klingt so schlimm, dass es für andere schwer zu ertragen ist; andererseits fügen sich die Kinder durch Kratzen nie Verletzungen zu, die zu Narben führen!“"
                                            },
                                            {
                                                "example_id": "d3618cab-d982-4ad2-835a-d62faa9d5e4d",
                                                "sense_id": "ee138600-0419-3994-8a68-079e5aeca7a7",
                                                "text": "[übertragen:] „Typische Symptome bei einer Pollenallergie sind Nasen- und Augenjucken, ein Kratzen im Hals, eine laufende Nase.“"
                                            },
                                            {
                                                "example_id": "ec3b3574-0331-411f-93c6-8fdfd591db2f",
                                                "sense_id": "ee138600-0419-3994-8a68-079e5aeca7a7",
                                                "text": "„Buffy versteht nicht, dass an manchen Türen das Kratzen erlaubt ist, an anderen nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
