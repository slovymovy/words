                    {
                        "translation_id": "7a615be4-a188-47fb-bc5b-f1d63898fc27",
                        "source_entry_id": "079596ad-6ef9-36b3-bbc6-f79dac6f1319",
                        "source_sense_id": "bb004651-cd8f-3e53-92c1-2e9f3cb60364",
                        "target_lang_word": "dissection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8ecd264-0157-33e2-87fe-4d5c9a20aed1",
                                        "entry_id": "57846310-237e-3052-9363-b8bc5b594a4b",
                                        "glosses": [
                                            "Action de disséquer ou état d’un corps disséqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "179cad53-949e-4b6b-b211-4a6f0df70304",
                                                "sense_id": "f8ecd264-0157-33e2-87fe-4d5c9a20aed1",
                                                "text": "Le Chirurgien de l’hospice était revêtu de son tablier de dissection. Un de ses aides avait défait sa trousse, et lui présentait un couteau à disséquer."
                                            },
                                            {
                                                "example_id": "3e70a415-a54d-4fde-9b66-1f6bfcd2c308",
                                                "sense_id": "f8ecd264-0157-33e2-87fe-4d5c9a20aed1",
                                                "text": "Et il y avait enfin, à l’hôpital de Plassans, une salle de dissection, qu’il était presque le seul à fréquenter, une grande salle claire et tranquille, dans laquelle, depuis plus de vingt ans, tous les corps non réclamés étaient passés sous son scalpel."
                                            },
                                            {
                                                "example_id": "bfcc781d-7bcc-4b59-887a-37202e8eabf2",
                                                "sense_id": "f8ecd264-0157-33e2-87fe-4d5c9a20aed1",
                                                "text": "Pendant la dissection du sac, la hernie se désétrangle spontanément : on entend un gargouillement et le sac s’affaisse."
                                            },
                                            {
                                                "example_id": "e5f8f423-b791-45d8-90fa-b60029516384",
                                                "sense_id": "f8ecd264-0157-33e2-87fe-4d5c9a20aed1",
                                                "text": "En ce temps-là, la Faculté avait le droit d’organiser deux fois par an une dissection de cadavre."
                                            },
                                            {
                                                "example_id": "3083521a-3e03-4060-ad84-5d1e16d371ec",
                                                "sense_id": "f8ecd264-0157-33e2-87fe-4d5c9a20aed1",
                                                "text": "Assez ironiquement, Jasselin avait interrompu ses années de médecine entre la première et la deuxième année parce qu’il ne supportait plus les dissections, ni même la vue des cadavres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da95d7e6-0497-3714-8a83-1c9346bc8e8b",
                                        "entry_id": "57846310-237e-3052-9363-b8bc5b594a4b",
                                        "glosses": [
                                            "Épanchement de sang entre deux feuillets d’une artère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "819f7770-f2fd-476c-a62d-28338c8804b6",
                                                "sense_id": "da95d7e6-0497-3714-8a83-1c9346bc8e8b",
                                                "text": "Pour Nicolas Pinsault, kinésithérapeute et chercheur à l’université de Grenoble, même si les cas sont « rarissimes », les manipulations des vertèbres et cervicales peuvent bien occasionner des « dissections artérielles »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
