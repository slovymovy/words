                ],
                "senses": [
                    {
                        "sense_id": "ecc56329-8e58-32a1-82f9-8e8a23286e48",
                        "entry_id": "ec9b69d9-583f-354c-a69f-20e9d1bfd5ef",
                        "glosses": [
                            "als Teil des öffentlichen Personennahverkehrs betriebenes Taxi, das Fahrgäste nach vorheriger telefonischer Anmeldung an bestimmten Haltepunkten aufnimmt und zu ihrem gewünschten Ziel befördert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eabf1553-b015-4496-b4e0-6472ca3b7537",
                                "sense_id": "ecc56329-8e58-32a1-82f9-8e8a23286e48",
                                "text": "„Die Haltestellen im südlichen Teil von Köln-Blumenberg werden ausschließlich als Anrufersammeltaxi im Nachtverkehr bedient.“"
                            },
                            {
                                "example_id": "f3413ece-1b37-4355-90c2-afb85b005674",
                                "sense_id": "ecc56329-8e58-32a1-82f9-8e8a23286e48",
                                "text": "„Fortführung und Ausweitung von alternativen Bedienungsformen, wie z. B. Anrufersammeltaxis in bedarfsschwachen Zeiten/Gebieten; Anpassung der Fahrzeuggröße an Bedarf, Bewerbung neuer Angebote um die notwendige Auslastung zu erzielen“"
                            },
                            {
                                "example_id": "085a045a-144a-4293-99fd-ec424f2128f8",
                                "sense_id": "ecc56329-8e58-32a1-82f9-8e8a23286e48",
                                "text": "„Außerhalb der Fahrzeiten von den o.g. Buslinien ist es möglich, im Landkreis Forchheim gegen einen geringen Aufpreis pro Person zur regulären Fahrkarte ein Anrufersammeltaxi zu nutzen.“"
                            },
                            {
                                "example_id": "3985c561-ecde-478e-b32a-35b2a4db6838",
                                "sense_id": "ecc56329-8e58-32a1-82f9-8e8a23286e48",
                                "text": "„Das Angebot für die Beförderung mittels Anrufersammeltaxi (ASM) ist zwar vom Grundsatz her flexibel, gilt jedoch zumeist nur für den Spätverkehr und teilweise am Sonntagvormittag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
