                        "glosses": [
                            "Désagrégation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf528c6-7103-4394-bd44-f2ec3a8339f3",
                                "sense_id": "bf6372dd-3125-3aac-b422-eb8cc09e6e18",
                                "text": "La disgrégation des particules d’un corps."
                            },
                            {
                                "example_id": "700c9c3c-1281-4179-827d-fad9d762d9a6",
                                "sense_id": "bf6372dd-3125-3aac-b422-eb8cc09e6e18",
                                "text": "Dans la vie d’une géomorphe nous pouvons donc distinguer deux périodes: période de formation et période de disgrégation, comprises dans un seul cycle d’érosion fluviale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f50686f-9efd-4282-afaa-f10c9bae897c",
                        "source_entry_id": "8ac771f9-cacb-3672-9da0-07b0e1e024c2",
                        "source_sense_id": "bf6372dd-3125-3aac-b422-eb8cc09e6e18",
                        "target_lang_word": "disgregation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disgregation",
