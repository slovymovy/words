                ],
                "senses": [
                    {
                        "sense_id": "f84f7efe-1617-3edb-b675-68ac477bbfb8",
                        "entry_id": "4698a003-ffd5-3eab-bcd7-1928173cbbf2",
                        "glosses": [
                            "Zustand der Missachtung, Ignoranz oder Geringschätzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11a69f1-83a4-4ee8-8c40-a0541098d913",
                                "sense_id": "f84f7efe-1617-3edb-b675-68ac477bbfb8",
                                "text": "„Vieles, was dieser Mann tat, war voller Unwürde und Unwahrheit, voller jämmerlicher Protzerei.“"
                            },
                            {
                                "example_id": "978667d7-241a-44a6-8dbf-239fd20c82a8",
                                "sense_id": "f84f7efe-1617-3edb-b675-68ac477bbfb8",
                                "text": "„Für den Patienten machen Offenheit und Verständnis einerseits und Heimlichkeit und Unverständnis andererseits den Unterschied zwischen Würde und Unwürde aus.“"
                            },
                            {
                                "example_id": "cc5e98af-9f14-4da2-aabc-f1094508c120",
                                "sense_id": "f84f7efe-1617-3edb-b675-68ac477bbfb8",
                                "text": "„In dieser Passage zeigt sich wohl die Furcht vor dem Totalverlust der Würde als Qualität, deren Platz die Unwürde einzunehmen droht.“"
                            },
                            {
                                "example_id": "d99f72e9-0130-4846-8a68-7903c1dfe97a",
                                "sense_id": "f84f7efe-1617-3edb-b675-68ac477bbfb8",
                                "text": "„‚Ich bin traurig, dass das Gesetz mich zu einem Leben in wachsender Unwürde und in Leiden verurteilen will‘, hatte Nicklinson mitgeteilt, der mit Hilfe eines Computers über Augenzwinkern kommunizierte.“"
                            },
                            {
                                "example_id": "9d5e8a7a-4203-4950-8e84-c274929cd8a6",
                                "sense_id": "f84f7efe-1617-3edb-b675-68ac477bbfb8",
                                "text": "„Wir werden seine Karriere, sein Leben nicht in Unwürde enden lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
