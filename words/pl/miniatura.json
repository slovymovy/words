                },
                {
                    "sense_id": "b18d47af-9f94-3a96-a887-6ee8a92f55c1",
                    "sense_definition": "krótki utwór literacki, muzyczny, teatralny lub filmowy o zwartej formie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art_miniature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pianista zagrał na zakończenie koncertu nastrojową <w>miniaturę</w> fortepianową.",
                            "target_lang_translations": {
                                "ru": "В завершение концерта пианист сыграл проникновенную фортепианную <w>миниатюру</w>."
                            }
                        },
                        {
                            "text": "Teatr wystawił serię zabawnych <w>miniatur</w> dramatycznych.",
                            "target_lang_translations": {
