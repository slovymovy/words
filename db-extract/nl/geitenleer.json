                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfe529db-18e0-4e47-8612-61c8f9b06d18",
                                "sense_id": "eb372bc0-fa46-36ed-90ee-7e33fb2eed0b",
                                "text": "De verkoopster uit Torzjok bood hem met schelle stem haar waren aan en in het bijzonder een paar pantoffels van geitenleer."
                            },
                            {
                                "example_id": "bfd1861e-5c36-4774-9fbf-28f511332f8e",
                                "sense_id": "eb372bc0-fa46-36ed-90ee-7e33fb2eed0b",
                                "text": "Het nieuwe onderzoek toont aan dat Ötzi een mantel droeg van geiten- en schapenleer. Het leer was afkomstig van minstens vier verschillende dieren. Hij droeg een ondervest van schapenleer en een broek van geitenleer. De veters in zijn met gras gevulde schoenen waren gemaakt van runderleer."
                            }
                        ]
