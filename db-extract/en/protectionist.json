                ],
                "senses": [
                    {
                        "sense_id": "aae135a5-3122-3e5d-817b-204a55c40ad0",
                        "entry_id": "dbf75145-0b75-35c5-af8a-c3470c1a4371",
                        "glosses": [
                            "Someone who believes in protecting domestic producers by impeding or limiting the importation of foreign goods and services via actions taken by government."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b068efbd-8679-4cf7-8de9-7049da232e37",
                                "sense_id": "aae135a5-3122-3e5d-817b-204a55c40ad0",
                                "text": "It also would cut deeply into the trans-Atlantic alliance at the worst possible time by giving anti-American, anti-capitalist nationalists and protectionists in Europe a platform to thrive. Anti-American sentiment will grow, and Europe risks a retreat to protectionism. Those of us who make the case for the trans-Atlantic alliance will have a much harder job."
                            },
                            {
                                "example_id": "86d2e62b-e225-42a9-b76d-331b524acfe9",
                                "sense_id": "aae135a5-3122-3e5d-817b-204a55c40ad0",
                                "text": "Vance is now a key messenger for Trump’s economic agenda as the administration pursues sweeping new protectionists policies announced on what they deemed “Liberation Day.”"
                            }
                        ]
                    },
