                        "sense_id": "7e063837-1610-3e94-be40-a1867120df2d",
                        "entry_id": "588866c1-1091-3a2b-91d1-680da078604a",
                        "glosses": [
                            "Sortie du globe oculaire hors de l’orbite."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "94c2b1a2-c652-491e-a56e-f7e817e577a2",
                                "sense_id": "7e063837-1610-3e94-be40-a1867120df2d",
                                "text": "L’exophtalmie a un aspect surprenant pour l’entourage, presque inquiétant."
                            },
                            {
                                "example_id": "1a0ab263-7783-4387-90a3-32cf0d92c8f1",
                                "sense_id": "7e063837-1610-3e94-be40-a1867120df2d",
                                "text": "Ecchymoses des muscles antérolatéraux et de leurs gaines aponévrotiques, ruptures du chef antérieur du sterno-cléido-mastoïdien, manchon ecchymotique péricarotidien, spume, exophtalmie et lividités : il ne fait aucun doute que la victime est morte par pendaison !"
                            }
                        ]
                    }
                ],
