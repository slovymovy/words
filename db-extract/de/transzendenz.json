                ],
                "senses": [
                    {
                        "sense_id": "8279a5c9-f697-39bd-8033-9d13de6f6825",
                        "entry_id": "cf21ae1f-3f65-366f-b9c7-a15295fd410f",
                        "glosses": [
                            "das, was jenseits der Erfahrung, des Gegenständlichen liegt"
                        ],
                        "tags": [
                            "formal",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "f2c467be-7a1d-4dff-8112-b62bceb6286e",
                                "sense_id": "8279a5c9-f697-39bd-8033-9d13de6f6825",
                                "text": "„Als methodologisch ist Transzendenz dort zu bestimmen, wo sie – wie besonders bei Heidegger und Jaspers – ein Überschreiten aller Gegenständlichkeit als Charakteristikum wirklichen Philosophierens meint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6489393b-5954-3d5a-9fff-924ac4ea7090",
                        "entry_id": "cf21ae1f-3f65-366f-b9c7-a15295fd410f",
                        "glosses": [
                            "das, was die Grenze der Erfahrung und des Bewusstseins beziehungsweise der Erkenntnis überschreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d58b8f10-f9ff-427b-9123-e9db03224aad",
                                "sense_id": "6489393b-5954-3d5a-9fff-924ac4ea7090",
                                "text": "Man kann den Begriff des ‹Göttlichen in der Welt› immanent auffassen: das Göttliche ist enthalten, es ist das, was man sieht, dort, wo zum Beispiel der Berg ein Gott ist. Die Sichtweise der Transzendenz trennt die sichtbare Welt so weit von der göttlichen Welt, dass man sich zum Beispiel den Gott noch nicht einmal bildhaft vorstellen darf oder etwa beim Namen nennen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "20f5593d-2188-3d40-9a64-e740f0a52c48",
                        "entry_id": "cf21ae1f-3f65-366f-b9c7-a15295fd410f",
                        "glosses": [
                            "die Eigenschaft einer Zahl, dass sie nicht als Nullstelle eines Polynoms mit ganzzahligen Koeffizienten ungleich dem Nullpolynom auftreten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a37d41a-d1f8-4240-a0ee-cdb2dabc9215",
                                "sense_id": "20f5593d-2188-3d40-9a64-e740f0a52c48",
                                "text": "„Die ursprünglichen Beweise der Transzendenz von e und π stammen von Charles Hermite bzw. von Ferdinand von Lindemann.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
