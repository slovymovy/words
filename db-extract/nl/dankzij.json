                                "target_senses": [
                                    {
                                        "sense_id": "94288e9d-3155-3084-8633-28581a3b7358",
                                        "entry_id": "68c6e592-712d-3051-bad8-e4183bdccf32",
                                        "glosses": [
                                            "…służący do powiedzenia, że dana czynność odbywa się z niezbędną pomocą osoby, rzeczy itp., opisanych przez wyrażenie za przyimkiem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66ecf7fa-13fc-43f5-929f-92cd12fed2d1",
                                                "sense_id": "94288e9d-3155-3084-8633-28581a3b7358",
                                                "text": "Świat istnieje tylko dzięki temu, że zawsze za późno się cofać"
                                            },
                                            {
                                                "example_id": "01f86483-19c5-411d-8277-c99e6c71bdbf",
                                                "sense_id": "94288e9d-3155-3084-8633-28581a3b7358",
