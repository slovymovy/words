                    {
                        "translation_id": "02bbfbc7-c4a9-4291-addd-c75a68050c3b",
                        "source_entry_id": "c7a17f8c-cf29-3dd5-8e3c-39815d12ce26",
                        "source_sense_id": "6fa8a45c-5b68-361f-b59d-2c5cd6bb5c0d",
                        "source_sense_description": "rusé, matois",
                        "target_lang_word": "crafty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crafty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05b89f28-f43e-30f1-b3d6-db64ea1c4d68",
                                        "entry_id": "0559f635-cc41-3234-b915-3d37ad95f0f8",
                                        "glosses": [
                                            "Skillful at deceiving others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c2a7b7-6005-4482-9411-e2b6abe2be82",
                                                "sense_id": "05b89f28-f43e-30f1-b3d6-db64ea1c4d68",
                                                "text": "For thy mouth uttereth thine iniquity, and thou choosest the tongue of the crafty."
                                            },
                                            {
                                                "example_id": "4fb71bc8-86b9-4d4e-a194-5a8619cba023",
                                                "sense_id": "05b89f28-f43e-30f1-b3d6-db64ea1c4d68",
                                                "text": "Glaucon will play devil's advocate (358c-d, thereby showing himself craftier than Thrasymachus, who is so unsly as to declare himself a wolf, openly, before the sheep; […])"
                                            },
                                            {
                                                "example_id": "a7d719d6-181e-44d5-9650-9f97abe1b667",
                                                "sense_id": "05b89f28-f43e-30f1-b3d6-db64ea1c4d68",
                                                "text": "Together, with the help of the drunkard Haymitch (Woody Harrelson), the only District 12 citizen ever to win the Games, they challenge tributes that range from sadistic volunteers to crafty kids like the pint-sized Rue (Amandla Stenberg) to the truly helpless and soon-to-be-dead."
                                            },
                                            {
                                                "example_id": "b94c0ad5-1bc0-44e9-87fa-99565a4a6e47",
                                                "sense_id": "05b89f28-f43e-30f1-b3d6-db64ea1c4d68",
                                                "text": "Los Angeles would still be a piddling little town in a desert if it weren’t for Sierra snowmelt and city officials crafty enough to snooker eastern California farmers out of their water rights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04f39dce-eec9-317a-8810-1bd2e932bc87",
                                        "entry_id": "0559f635-cc41-3234-b915-3d37ad95f0f8",
                                        "glosses": [
                                            "Sneaky; surreptitious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2852ba-e2f2-4fdf-b3c6-09a0cdb94603",
                                                "sense_id": "04f39dce-eec9-317a-8810-1bd2e932bc87",
                                                "text": "I took a crafty look at his hand of cards while he was out of the room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80da23b5-0967-3543-b7df-565eab241e3a",
                                        "entry_id": "0559f635-cc41-3234-b915-3d37ad95f0f8",
                                        "glosses": [
                                            "Relating to, or characterized by, craft or skill; dexterous."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "915412af-3509-3968-9ea5-34eb5cee6121",
                                        "entry_id": "0559f635-cc41-3234-b915-3d37ad95f0f8",
                                        "glosses": [
                                            "Possessing dexterity; skilled; skillful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d0d194-2947-4187-a593-eea8eaa6821c",
                                                "sense_id": "915412af-3509-3968-9ea5-34eb5cee6121",
                                                "text": "Make magazine, which celebrates “your right to tweak, hack and bend any technology to your own will,” has joined with the New York Hall of Science to gather more than 500 of the craftiest inventors, artists, technology enthusiasts, tinkerers and hobbyists to share their expertise."
                                            },
                                            {
                                                "example_id": "dc4f63af-f89a-40f1-9a90-bcab6843884c",
                                                "sense_id": "915412af-3509-3968-9ea5-34eb5cee6121",
                                                "text": "Can you envision a future Christmas where you print all your gifts instead of shop for them? It could soon be reality in even the most tech-averse household, and it might just end up saving the craftier among us lots of time and money. Why buy a $50 vase when you can print one for $2?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab884bf5-ee76-3be0-83d8-7157cee58756",
                                        "entry_id": "0559f635-cc41-3234-b915-3d37ad95f0f8",
                                        "glosses": [
                                            "Magical or occult, or allegedly so."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e92b52b-856b-437b-96b0-133f796d4165",
                                                "sense_id": "ab884bf5-ee76-3be0-83d8-7157cee58756",
                                                "text": "a crafty science"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
