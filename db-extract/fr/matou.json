                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1591c9b3-0ab1-4461-9fb7-db591be85358",
                        "entry_id": "a8175e0b-67ea-364f-8cf7-3e842520e58d",
                        "tags": [
                            "plural"
                        ],
                        "form": "matous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e22fa71-85ce-3575-af85-818f189a39f9",
                        "entry_id": "a8175e0b-67ea-364f-8cf7-3e842520e58d",
                        "glosses": [
                            "Chat mâle qui n’est pas châtré, éventuellement employé par l’homme pour la reproduction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7831b83d-8375-4c53-ac04-d59af0143148",
                                "sense_id": "7e22fa71-85ce-3575-af85-818f189a39f9",
                                "text": "En proie à un sortilège\nJ’aperçois un gros matou"
                            },
                            {
                                "example_id": "7693fcc9-66d1-4aa1-9151-9c3eeab72009",
                                "sense_id": "7e22fa71-85ce-3575-af85-818f189a39f9",
                                "text": "Chaque Rat rentre dans son trou ;\nEt si quelqu’un en sort, gare encor le Matou !"
                            },
                            {
                                "example_id": "dd08d081-02c0-4091-9969-5943535cc6de",
                                "sense_id": "7e22fa71-85ce-3575-af85-818f189a39f9",
                                "text": "Péronnelle est en folie tous les mois, et le matou n’abonde pas dans la contrée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f420e02e-e7ac-4b33-bd4a-65564d22a01c",
                        "source_entry_id": "a8175e0b-67ea-364f-8cf7-3e842520e58d",
                        "source_sense_id": "7e22fa71-85ce-3575-af85-818f189a39f9",
                        "target_lang_word": "Kater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dca342e-ec61-3e4b-b7b7-4abd39da106b",
                                        "entry_id": "ce710336-1e81-33e4-bf27-6d1e53bd8a48",
                                        "glosses": [
                                            "männliche Katze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751a5607-43a9-4499-adc9-bb3d0245d0b8",
                                                "sense_id": "0dca342e-ec61-3e4b-b7b7-4abd39da106b",
                                                "text": "Der Kater springt vom Dach."
                                            },
                                            {
                                                "example_id": "53293447-40d9-48fd-a4cb-f9c580a00e56",
                                                "sense_id": "0dca342e-ec61-3e4b-b7b7-4abd39da106b",
                                                "text": "„Auch Kater Murr bleibt vom Dualismus nicht verschont; er besitzt alle Eigenschaften seiner Tiergattung, aber er kann auch lesen, schreiben und Gedichte machen und versteht die Menschensprache in ihren feinsten Nuancen.“"
                                            },
                                            {
                                                "example_id": "c3ee0414-48f2-403d-b38d-36751cf81bd6",
                                                "sense_id": "0dca342e-ec61-3e4b-b7b7-4abd39da106b",
                                                "text": "„Der Kater Moritz der Frau Bieger, die die Gerichtsbücherei führt, ist eingegangen an nach außen wachsenden Eiterbeulen.“"
                                            },
                                            {
                                                "example_id": "7665a19b-7659-4a00-849e-01f97e8239df",
                                                "sense_id": "0dca342e-ec61-3e4b-b7b7-4abd39da106b",
                                                "text": "„Kater Lucky sprang aus seinem Karton und tapste zu Sylvia, die ihn lachend hochhob und mit ihrer Nase an seine stupste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf0258f-665f-3d43-b251-7a161c58e368",
                                        "entry_id": "917e5b5c-d03f-3a36-8073-f9dcf68f43b8",
                                        "glosses": [
                                            "schlechte körperliche Verfassung nach Alkoholkonsum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c39f1447-1c95-4fef-928a-507309986f2c",
                                                "sense_id": "4bf0258f-665f-3d43-b251-7a161c58e368",
                                                "text": "Ich habe vom Feiern einen mächtigen Kater."
                                            },
                                            {
                                                "example_id": "58d29142-1c9f-4ff8-ac4a-39ae39905b0f",
                                                "sense_id": "4bf0258f-665f-3d43-b251-7a161c58e368",
                                                "text": "„Högni war tatsächlich einer von diesen Menschen, die keinen Brummschädel bekamen, nur einen Kater, zeigte es aber nie oder ließ sich davon nie die Nerven rauben.“"
                                            },
                                            {
                                                "example_id": "f5c1b5f4-21b7-4438-9ef9-381ece4b2533",
                                                "sense_id": "4bf0258f-665f-3d43-b251-7a161c58e368",
                                                "text": "„Aus irgendeinem Grund gelang es ihm, sich zu konzentrieren, wenn der Kater am schlimmsten war.“"
                                            },
                                            {
                                                "example_id": "722b93e6-4498-445f-938e-7e99a9606c0d",
                                                "sense_id": "4bf0258f-665f-3d43-b251-7a161c58e368",
                                                "text": "„Ich musste innerlich schlucken und schwor mir, mich heute bei dem deutschen Bier etwas zurückzuhalten; ein Kater würde mir morgen gerade noch fehlen.“"
                                            },
                                            {
                                                "example_id": "4ced05b7-ff5b-47f5-8d8f-226c4aa47547",
                                                "sense_id": "4bf0258f-665f-3d43-b251-7a161c58e368",
                                                "text": "„Du sollst dich nicht über einen Kollegen lustig machen, der morgens mit einem massiven Kater an den Arbeitsplatz kommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9aca50c8-6bfb-4173-a889-72c736c3399d",
                        "source_entry_id": "a8175e0b-67ea-364f-8cf7-3e842520e58d",
