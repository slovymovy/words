                ],
                "senses": [
                    {
                        "sense_id": "1c5d5361-cdf6-3ee0-ba2e-3a3ca0f8cf81",
                        "entry_id": "55d21c4e-1d6b-3c0f-843c-a98f5a997c17",
                        "glosses": [
                            "übermäßiger Genuss von alkoholischen Getränken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b6ec3c0-4869-4c84-98e6-af32ead9d8f2",
                                "sense_id": "1c5d5361-cdf6-3ee0-ba2e-3a3ca0f8cf81",
                                "text": "„Er ist eben aus dem Bett gekrochen, hat eine Kanne schwarzen Kaffee getrunken und versucht jetzt, mit viel Priem den Geschmack von der gestrigen Sauferei aus dem Mund zu kriegen.“"
                            },
                            {
                                "example_id": "dd190e62-cbcf-4cad-813e-0d33e39bbdbb",
                                "sense_id": "1c5d5361-cdf6-3ee0-ba2e-3a3ca0f8cf81",
                                "text": "„Die Nachbarn wechselten sich mit dem Kochen und der Versorgung der Kinder ab, sie halfen bei der Wäsche und beim Einkaufen, bis der Vater durch seine Sauferei immer unangenehmer und schwieriger wurde.“"
                            },
                            {
                                "example_id": "b1b4c9bb-419f-4ec9-88f6-8bf80aff3456",
                                "sense_id": "1c5d5361-cdf6-3ee0-ba2e-3a3ca0f8cf81",
                                "text": "„Auch die ewige Sauferei und Singerei halbe und ganze Nächte hindurch war den Behörden in Dorn – im Ohr, muss man wohl sagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
