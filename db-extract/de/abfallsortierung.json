                "senses": [
                    {
                        "sense_id": "05883ee6-6d9c-32e2-894b-23e2962079aa",
                        "entry_id": "8dc76d31-ddaf-3704-8967-bf1681a1cfdf",
                        "glosses": [
                            "gezielte Abgabe und Unterscheidung von Abfall in verschiedene Verwertungssysteme bei Abgabe des Abfalls"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82356bac-a201-4750-bc6c-8a64891faf18",
                                "sense_id": "05883ee6-6d9c-32e2-894b-23e2962079aa",
                                "text": "\"Wir sind überzeugt, dass der AppDesk ein großes Gesprächsthema auf der Messe sein wird und freuen uns, allen, die mehr zum Thema Abfallsortierung erfahren möchte, das neue Tool vorzustellen.“"
                            },
                            {
                                "example_id": "afcb0b80-80ad-41c2-b447-baa09deacfda",
                                "sense_id": "05883ee6-6d9c-32e2-894b-23e2962079aa",
                                "text": "„Eine auf Abfallsortierung ‘vor Ort’ spezialisierte Firma darf im Auftrag des Vermieters bis zur Überlassung der Abfälle an den öffentlich-rechtlichen Entsorgungsträger Wertstoffe aus den fehlerhaft befüllten Restabfallbehältern entnehmen und einer Verwertung zuführen.“"
                            },
                            {
                                "example_id": "e6c6fc56-f9d0-4414-9c4f-7b06c58d086f",
                                "sense_id": "05883ee6-6d9c-32e2-894b-23e2962079aa",
                                "text": "„In unserer Kommune setzen wir auf detaillierte Abfallsortierung.“"
                            },
                            {
                                "example_id": "9ffc477f-db5f-46e8-96a7-8993e2ae0142",
                                "sense_id": "05883ee6-6d9c-32e2-894b-23e2962079aa",
                                "text": "„Am Freitag, den 22.2.13 nahmen wir Füchse am Umweltprojekt Abfallsortierung der TBV teil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fc2dccd3-67be-3c51-a7cd-99df1c2e419e",
                        "entry_id": "8dc76d31-ddaf-3704-8967-bf1681a1cfdf",
                        "glosses": [
                            "manuelle oder automatische Sortierung von Abfall nach Einsammlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d51f45-9791-4582-875c-378f74304170",
                                "sense_id": "fc2dccd3-67be-3c51-a7cd-99df1c2e419e",
                                "text": "Kunststoffe aus der eingesammelten „Gelben Tonne“ werden automatisch oder von Hand, in Abfallsortieranlage, nochmals sortiert um diese der weiteten Verwendung, als Wertstoff, zuführen zu können."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
