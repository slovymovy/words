                    },
                    {
                        "translation_id": "d88deb60-8592-4360-9db8-b79d49cfc862",
                        "source_entry_id": "5b0a15ed-7bc9-3a93-ac53-f465552d1a56",
                        "source_sense_id": "68ac353d-974c-32f7-8388-1ba58afef11d",
                        "target_lang_word": "egozentrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "egozentrisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75cf94ad-b636-3e02-93df-69f9f7a09ef6",
                                        "entry_id": "524b2bd7-57f3-3e19-974e-e23675f4af0a",
                                        "glosses": [
                                            "(nur) an sich denkend; sich selbst im Mittelpunkt sehend; egozentrisch ist eine Person, die alle Ereignisse nur von ihrem Standpunkt aus bewertet"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff0aafab-9a47-4f5f-a0e5-0840f1ab6145",
                                                "sense_id": "75cf94ad-b636-3e02-93df-69f9f7a09ef6",
                                                "text": "Du bist schon immer ein wenig egozentrisch gewesen."
                                            },
                                            {
                                                "example_id": "bdadf3e7-3b9c-4b13-ac5f-8feb39ce9ea6",
                                                "sense_id": "75cf94ad-b636-3e02-93df-69f9f7a09ef6",
                                                "text": "„Wygotski vertritt die These, daß die egozentrische Sprache ein Selbstgespräch ist, das nicht nur eine Handlungen begleitende, sondern auch eine selbstorientierende Funktion hat.“"
                                            },
                                            {
                                                "example_id": "ccc80b29-42ed-4a88-a2bc-d587f0c20556",
                                                "sense_id": "75cf94ad-b636-3e02-93df-69f9f7a09ef6",
                                                "text": "„Anders als Piaget versteht Wygotski (1969) die Sprache des Kindes von vornherein als sozial; die egozentrische Sprache entsteht nach ihm erst später und führt zur inneren Sprache, dem sprachlichen Denken.“"
                                            },
                                            {
                                                "example_id": "ea68fac3-e25d-4680-a5a9-1a36543bb79e",
                                                "sense_id": "75cf94ad-b636-3e02-93df-69f9f7a09ef6",
                                                "text": "„Als Pastorensohn 1853 geboren, war Vincent ein schwieriger Mensch, leidenschaftlich, rechthaberisch, egozentrisch und unangepasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6f0a942-9ab9-463d-b11a-e759364512d9",
                        "source_entry_id": "5b0a15ed-7bc9-3a93-ac53-f465552d1a56",
                        "source_sense_id": "68ac353d-974c-32f7-8388-1ba58afef11d",
                        "target_lang_word": "égocentrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "égocentrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46f715b4-4392-379a-820d-8d9a01dd0000",
                                        "entry_id": "8908b993-8a42-386e-93b3-4b86efbd451d",
                                        "glosses": [
                                            "Centré sur soi-même, qui se croit le centre de l'attention. → voir nombriliste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e26d789-c437-4108-9e5d-8f5e0cf177a6",
                                                "sense_id": "46f715b4-4392-379a-820d-8d9a01dd0000",
                                                "text": "Car Montpellier, hors la session universitaire où la nuée virevoltante des étudiants envahissait et rendait vie et bruyance, rompant avec la somnolence habituelle de ma douce et égocentrique ville, restait figée dans un train-train « pépère »."
                                            },
                                            {
                                                "example_id": "351b44e2-a2c6-42e7-8ea1-80881e8d9371",
                                                "sense_id": "46f715b4-4392-379a-820d-8d9a01dd0000",
                                                "text": "Je suis pas narcissique, encore moins égocentrique ou vantarde, je parle juste un petit peu trop de moi…"
                                            },
                                            {
                                                "example_id": "9472bcdd-8be5-4dff-990a-6345e7278f26",
                                                "sense_id": "46f715b4-4392-379a-820d-8d9a01dd0000",
                                                "text": "— Je te l'avais décrit comme égocentrique, répondit-il. Eh bien, c'est aussi un pudibond de la pire espèce.\n— Je vois... Pudibond et égocentrique. Elle remua ces deux mots dans sa tête. L'association ne faisait pas rêver !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93b012fe-592d-3280-b8af-b776ba2d882b",
                                        "entry_id": "8908b993-8a42-386e-93b3-4b86efbd451d",
                                        "glosses": [
                                            "Qui provient de soi et non de l’extérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6af03671-778d-45a4-af8e-7f949ebb841d",
                                                "sense_id": "93b012fe-592d-3280-b8af-b776ba2d882b",
                                                "text": "La méthode de pointage est presque exclusivement mesurée à partir d’un point de vue égocentrique tandis que la tâche d’estimation des distances euclidiennes peut à la fois se faire de manière égocentrique ou exocentrique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "égocentrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a857273-ea12-3103-a801-a87b4a935659",
                                        "entry_id": "196e04b9-91c4-3541-b58a-641507bc42a6",
                                        "glosses": [
                                            "Personne centrée sur elle-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d9d4101-73dd-4a61-97fe-f105f7723941",
                                                "sense_id": "6a857273-ea12-3103-a801-a87b4a935659",
                                                "text": "Richard Blakely n'est qu'un petit branleur arrogant et misogyne, et qui utilise le sexe (pas énorme, d'ailleurs) pour asseoir son pouvoir.\nRichard Blakely est une machine, un égocentrique au dernier degré, et c'est mon patron. Putain de vie !"
                                            }
                                        ]
