                ],
                "senses": [
                    {
                        "sense_id": "4aa46ba8-ad9d-3d54-8ead-ee5380312dce",
                        "entry_id": "f9461c3b-c507-39f5-a67d-8bf6183eaf48",
                        "glosses": [
                            "Qui provoque ou facilite les règles."
                        ],
                        "tags": [
                            "Gynécologie"
                        ],
                        "examples": [
                            {
                                "example_id": "fe433e20-3a09-4234-af8c-6da405b1de14",
                                "sense_id": "4aa46ba8-ad9d-3d54-8ead-ee5380312dce",
                                "text": "L'armoise est emménagogue."
                            },
                            {
                                "example_id": "c6b93f93-9026-4343-bb10-395cd1ba4446",
                                "sense_id": "4aa46ba8-ad9d-3d54-8ead-ee5380312dce",
                                "text": "Cette Épiaire a une nette action antispasmodique (de nature à calmer les spasmes viscéraux) et se révèle emménagogue, hypotensive et manifestement vulnéraire."
                            },
                            {
                                "example_id": "6816d0dd-c2b4-4856-90cb-04c1d9ca0eab",
                                "sense_id": "4aa46ba8-ad9d-3d54-8ead-ee5380312dce",
                                "text": "À titre d’exemple, les racines de khamaré sont réputées pour leur efficacité dans le soulagement des douleurs menstruelles, notamment grâce à leurs propriétés emménagogue."
                            }
                        ]
                    }
                ],
