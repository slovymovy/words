                        "form": "den Pulverschnee"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67863e36-6479-38ab-9506-536c95767423",
                        "entry_id": "f947a689-ee6b-3643-b34d-073036401648",
                        "glosses": [
                            "trockener Schnee, der unter Druck nicht zusammenklebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b9eb26c-5984-4d2f-bb87-1459d0e177b8",
                                "sense_id": "67863e36-6479-38ab-9506-536c95767423",
                                "text": "Lass es, Pulverschnee lässt sich nicht zu einem Schneeball formen!"
                            },
                            {
                                "example_id": "ff231bed-b9d9-483f-ba7c-5b860824f1c4",
                                "sense_id": "67863e36-6479-38ab-9506-536c95767423",
                                "text": "„Während wir an sonnigen Septembertagen mit der Gedankenlosigkeit des Massenmenschen im Freien Kaffee trinken, stehen seine Schaufensterpuppen bereits bis an die Knie im Pulverschnee und kämpfen mit Ohrenschützern, schafwollenen Fäustlingen und gewinnendem Lächeln gegen polare Frosteinbrüche.“"
                            },
                            {
                                "example_id": "10c20068-c9c7-4e32-8471-50789227fe0f",
                                "sense_id": "67863e36-6479-38ab-9506-536c95767423",
                                "text": "„Freerider und Tourengeher suchen auf unberührten Pisten die große Freiheit in den Bergen, das Glücksgefühl im Pulverschnee abseits des Rummels der Skigebiete.“"
                            },
                            {
                                "example_id": "60a6ad4c-e576-4f17-b049-64dc1d94faa7",
                                "sense_id": "67863e36-6479-38ab-9506-536c95767423",
                                "text": "„Wolken von Pulverschnee flogen auf, als die Skier abwärtsglitten und die Körper sich in den Kurven wiegten.“"
                            },
                            {
                                "example_id": "9369a5d3-c7de-4d39-9d5f-3abd11e4d825",
                                "sense_id": "67863e36-6479-38ab-9506-536c95767423",
                                "text": "„Wir alle kannten die unterschiedlichen Schneebedingungen, und alle wussten, wie man in tiefem Pulverschnee laufen musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "668c6b34-c928-4d93-b982-2711aa7679f1",
                        "source_entry_id": "f947a689-ee6b-3643-b34d-073036401648",
                        "source_sense_id": "67863e36-6479-38ab-9506-536c95767423",
                        "source_sense_description": "trockener Schnee, der unter Druck nicht zusammenklebt",
                        "target_lang_word": "powder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "powder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97456c4a-1d65-329f-a70f-15020c28d199",
                                        "entry_id": "09b07003-6dfc-3c32-bfaf-a9a5cc9baed5",
                                        "glosses": [
                                            "The fine particles which are the result of reducing a dry substance by pounding, grinding, or triturating, or the result of decay; dust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d4255cf-96ad-4cc8-9e97-dea2b6acd464",
                                                "sense_id": "97456c4a-1d65-329f-a70f-15020c28d199",
                                                "text": "Let me goe grin'd their Bones to powder ſmall, […]"
                                            },
                                            {
                                                "example_id": "b88e9eeb-aeae-491a-80dc-d1579d379ba9",
                                                "sense_id": "97456c4a-1d65-329f-a70f-15020c28d199",
                                                "text": "Let them stop fretting about vegetables denied by the weather and eat chilli powder. Just explain to them that they really shouldn’t think about spiralising it, because that doesn’t work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd0d672f-d8b0-3b1f-918c-afc912ce6550",
                                        "entry_id": "09b07003-6dfc-3c32-bfaf-a9a5cc9baed5",
                                        "glosses": [
                                            "A mixture of fine dry, sweet-smelling particles applied to the face or other body parts, to reduce shine or to alleviate chaffing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aa522aa-fa0b-4d0b-81b1-f5ae522bbc01",
                                                "sense_id": "cd0d672f-d8b0-3b1f-918c-afc912ce6550",
                                                "text": "She was redolent of violet sachet powder, and had warm, soft, white hands, but she danced divinely, moving as smoothly as the tide coming in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f808a1-6e25-3729-acc7-34935de06851",
                                        "entry_id": "09b07003-6dfc-3c32-bfaf-a9a5cc9baed5",
                                        "glosses": [
                                            "An explosive mixture used in gunnery, blasting, etc.; gunpowder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd4b503-6462-4dd5-bd61-c1c016983600",
                                                "sense_id": "71f808a1-6e25-3729-acc7-34935de06851",
                                                "text": "Tut, tut, good enough to toſſe: foode for Powder, foode for Powder: they'll fill a Pit, as well as better: tuſh man, mortall men, mortall men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ceddd34-cec3-350e-9c1d-fa6547c117a1",
                                        "entry_id": "09b07003-6dfc-3c32-bfaf-a9a5cc9baed5",
                                        "glosses": [
                                            "Ellipsis of powder snow; light, dry, fluffy snow."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbeaa17e-3280-31a6-a409-e94b6fc77cba",
                                        "entry_id": "09b07003-6dfc-3c32-bfaf-a9a5cc9baed5",
                                        "glosses": [
                                            "Ellipsis of powder blue, a color."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "powder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c23e168-2eac-33ac-b5fd-660581139cef",
                                        "entry_id": "e3809b24-d42c-39b2-bf39-dc6f7db1f6c9",
                                        "glosses": [
                                            "To reduce to fine particles; to pound, grind, or rub into a powder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e9e7a5d-2d70-4364-8219-d6e0c75fdd9d",
                                                "sense_id": "3c23e168-2eac-33ac-b5fd-660581139cef",
                                                "text": "25 October 2016, Bettina Elias Siegel writing in New York Times, Should the Food Industry Sneak Vegetables Into Food?\nIn desperation, they dried fruits and vegetables in an old food dehydrator they had, then used their coffee grinder to powder the produce..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68708df4-4089-3cd5-baef-4910b284d8b2",
                                        "entry_id": "e3809b24-d42c-39b2-bf39-dc6f7db1f6c9",
                                        "glosses": [
                                            "To sprinkle with powder, or as if with powder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "212de4a2-0e05-4410-9aba-ed8fc6c66223",
                                                "sense_id": "68708df4-4089-3cd5-baef-4910b284d8b2",
                                                "text": "to powder one's hair"
                                            },
                                            {
                                                "example_id": "8f0277c5-297f-4fae-9959-64b07fd6da13",
                                                "sense_id": "68708df4-4089-3cd5-baef-4910b284d8b2",
                                                "text": "23 March 2016, Seth Augenstein in Laboratory Equipment, FDA Proposes Ban on Powdered Surgical Gloves, Decades after Documenting Health Dangers\nGloves were powdered for more than a century to allow doctors and surgeons to slip them on more easily."
                                            },
                                            {
                                                "example_id": "51434c02-f960-41fd-94a6-7701addf2d2a",
                                                "sense_id": "68708df4-4089-3cd5-baef-4910b284d8b2",
                                                "text": "A circling zone thou seest / Powdered with stars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30b9a364-c151-3adf-a9ce-5375a6fdf603",
                                        "entry_id": "e3809b24-d42c-39b2-bf39-dc6f7db1f6c9",
                                        "glosses": [
                                            "To use powder on the hair or skin."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3138efcd-40db-4b33-a0bc-008fc9318015",
                                                "sense_id": "30b9a364-c151-3adf-a9ce-5375a6fdf603",
                                                "text": "1778-1787, Frances Burney, The Diary and Letters of Madame D'Arblay\nIf she is grave, and reads steadily on, she dismisses me, whether I am dressed or not; but at all times she never forgets to send me away while she is powdering, with a consideration not to spoil my clothes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9be95051-f065-3491-b292-201251849860",
                                        "entry_id": "e3809b24-d42c-39b2-bf39-dc6f7db1f6c9",
                                        "glosses": [
                                            "To turn into powder; to become powdery."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfd9ca3f-c7b8-42a9-ab96-664198213e63",
                                                "sense_id": "9be95051-f065-3491-b292-201251849860",
                                                "text": "Ample evidence is brought forward to show that the higher incidence of chronic interstitial nephritis in Queensland is due to lead paint on the verandahs and railings of the houses, which powders easily during the long Australian summer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d686e189-2a45-3171-834f-9223f0a238ad",
                                        "entry_id": "e3809b24-d42c-39b2-bf39-dc6f7db1f6c9",
                                        "glosses": [
                                            "To sprinkle with salt; to corn, as meat."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c48c629-b0e1-3a88-98b8-293c464699aa",
                                        "entry_id": "e3809b24-d42c-39b2-bf39-dc6f7db1f6c9",
                                        "glosses": [
                                            "To depart suddenly; to \\\"take a powder\\\"."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e91aa09-2732-46fb-8a09-8f12d479ba5e",
                                                "sense_id": "8c48c629-b0e1-3a88-98b8-293c464699aa",
                                                "text": "Miss Gibson appeared in the empty hall, her eyes wide and shocked. The little man who had started all the trouble with his singing telegram had powdered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
