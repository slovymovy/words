                "senses": [
                    {
                        "sense_id": "4c77d497-50c8-39f9-9aa6-c98f3e7c3796",
                        "entry_id": "2439f9c0-82ab-3440-885f-73710cfbd628",
                        "glosses": [
                            "eine Schlange aus der Familie der Nattern mit zwei halbmondförmigen Flecken hinter dem Kopf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13cd9e17-22c5-4251-aa5c-3c984e3aac36",
                                "sense_id": "4c77d497-50c8-39f9-9aa6-c98f3e7c3796",
                                "text": "Hast du die Ringelnatter gesehen?"
                            },
                            {
                                "example_id": "dd6e2e98-0233-4ab7-bbda-3140386c213d",
                                "sense_id": "4c77d497-50c8-39f9-9aa6-c98f3e7c3796",
                                "text": "Ringelnattern können gut schwimmen."
                            },
                            {
                                "example_id": "d72ec626-cbca-412f-baf0-43042cc839a4",
                                "sense_id": "4c77d497-50c8-39f9-9aa6-c98f3e7c3796",
                                "text": "„Für den Menschen und dessen Haustiere wie Hunde und Katzen stellt die Ringelnatter keine Gefahr dar.“"
                            },
                            {
                                "example_id": "b8c6cce7-75f0-46a8-99fb-98aca836d9d2",
                                "sense_id": "4c77d497-50c8-39f9-9aa6-c98f3e7c3796",
                                "text": "„In kalten Regionen hält die Ringelnatter in einem leeren Bau, einem hohlen Baumstamm oder in einer Höhle an einem Ufer oder Damm eine lange Winterruhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
