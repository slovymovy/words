                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bfec871-627f-44a2-8cde-b745c8d53a21",
                                "sense_id": "933b81a4-2265-3c3f-beea-b43072b9a5d5",
                                "text": "Dans la discipline dite « Springboard », l’objectif est de sectionner un bloc de bois posé sur la pointe d’un mat, à environ 2,80 m de hauteur."
                            },
                            {
                                "example_id": "5b8f6456-f5f1-4624-9921-37d2f0065d8c",
                                "sense_id": "933b81a4-2265-3c3f-beea-b43072b9a5d5",
                                "text": "Le springboard consiste à couper un arbre en se tenant sur une cale enfoncée dans le tronc."
                            },
                            {
