                "translations": [
                    {
                        "translation_id": "1f85a55d-09ef-4e2a-ad21-f42d2256b3df",
                        "source_entry_id": "675c97e9-6353-37e6-9281-7f0baab157bc",
                        "source_sense_id": "dde0b3c9-9113-31d0-92c5-82b3a90c2e96",
                        "target_lang_word": "ataman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ataman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7e99dbc-8626-3c31-b83e-e52553dea87f",
                                        "entry_id": "ecbd3858-90e9-3903-b927-8867ddfc8037",
                                        "glosses": [
                                            "A title of Cossack and haidamak leaders of various kinds. The term was also used for the leader of a fisherman artel and of a band of robbers or thieves."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ab0eded-c88f-4919-a8c1-8c5b202e6b1c",
                        "source_entry_id": "675c97e9-6353-37e6-9281-7f0baab157bc",
                        "source_sense_id": "dde0b3c9-9113-31d0-92c5-82b3a90c2e96",
                        "target_lang_word": "atamán",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "88ac565c-8b28-42d4-bd14-95caf298233f",
                        "source_entry_id": "675c97e9-6353-37e6-9281-7f0baab157bc",
                        "source_sense_id": "dde0b3c9-9113-31d0-92c5-82b3a90c2e96",
                        "target_lang_word": "Ataman",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ataman",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffe4e389-aaa4-337b-9355-2825626b5d2b",
                                        "entry_id": "ace8f689-8a03-3174-96e6-01d8ac6a4947",
                                        "glosses": [
                                            "ein gewählter militärischer Führer und Vorstehender einer oder mehrerer Siedlungen bei den Kosaken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c2f98e-311f-4794-b41e-599398a3aae9",
                                                "sense_id": "ffe4e389-aaa4-337b-9355-2825626b5d2b",
                                                "text": "„Den höchsten Ataman der Kubanj-Kosaken hat Kondratenko zu seinem Vizegouverneur ernannt.“"
                                            },
                                            {
                                                "example_id": "b153c798-0db3-47b2-8f61-76eedbd5968f",
                                                "sense_id": "ffe4e389-aaa4-337b-9355-2825626b5d2b",
                                                "text": "„Wenn Rußland in tödlicher Gefahr schwebt, dann tagt der Rat der Atamane.“"
                                            },
                                            {
                                                "example_id": "44099282-9e23-49ef-9664-d99bab1323b5",
                                                "sense_id": "ffe4e389-aaa4-337b-9355-2825626b5d2b",
                                                "text": "„Die Räuber taten mir im Übrigen nicht das geringste Leid an und verhielten sich überhaupt sehr herzlich zu mir, beinahe wie zu ihresgleichen. Noch in derselben Nacht wählten sie mich zu ihrem Ataman.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d8681cf-3650-4bdf-bb72-7bf702e044d5",
                        "source_entry_id": "675c97e9-6353-37e6-9281-7f0baab157bc",
                        "source_sense_id": "dde0b3c9-9113-31d0-92c5-82b3a90c2e96",
                        "target_lang_word": "атама́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "атама́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bc481594-4a19-3efb-931c-e666c1e412e0",
                                        "entry_id": "83955bb9-afa6-30fe-a459-d2e10dc0f6c7",
                                        "glosses": [
                                            "истор. в старину — выборный предводитель казацкого войска"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1652f383-40fb-42d2-90b9-bd4682adb27a",
                                                "sense_id": "bc481594-4a19-3efb-931c-e666c1e412e0",
                                                "text": "Несколько казаков по знаку атамана отправились на двор за поисками и через 1/4 часа возвратились, объявив, что ничего не нашли! .."
                                            },
                                            {
                                                "example_id": "abb77c7a-c185-47a1-ab7b-bbd433b03f49",
                                                "sense_id": "bc481594-4a19-3efb-931c-e666c1e412e0",
                                                "text": "Народ по достоинству оценил Ермака и поет о нем в своих былинах как о казацком атамане, составлявшем только голову живого казацкого тела."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acc6b73a-ca3c-3ef2-84a8-b137b7255840",
                                        "entry_id": "83955bb9-afa6-30fe-a459-d2e10dc0f6c7",
                                        "glosses": [
                                            "истор. в дореволюционной России — назначаемый или выборный начальник казачьих войск и поселений, выполнявший военные, полицейские и административные функции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24406924-0aeb-449b-8951-37ccb0a7221e",
                                                "sense_id": "acc6b73a-ca3c-3ef2-84a8-b137b7255840",
                                                "text": "Станичный атаман."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aec7715-8760-37b2-8d08-53221dcdd3be",
                                        "entry_id": "83955bb9-afa6-30fe-a459-d2e10dc0f6c7",
                                        "glosses": [
                                            "устар., перен. предводитель, главарь шайки разбойников или воров || вообще предводитель (шутл.), коновод (устар.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbe3474b-77e7-4c67-9321-61a86bf918d5",
                                                "sense_id": "8aec7715-8760-37b2-8d08-53221dcdd3be",
                                                "text": "Да чего и ждать от шайки разбойников, у которой атаманом убийца родного своего брата."
                                            },
                                            {
                                                "example_id": "289c47e2-2b81-4357-b70f-eb4b88194903",
                                                "sense_id": "8aec7715-8760-37b2-8d08-53221dcdd3be",
                                                "text": "Может, кто из разбойников был не согласен с атаманом, да с ним не поспоришь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b92d4ffe-2710-44dc-ac54-00fa8e09bd33",
