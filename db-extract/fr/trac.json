                "forms": [
                    {
                        "form_id": "9b82422f-8d92-4c70-aa79-e79c21c484f5",
                        "entry_id": "9c5100ee-df55-37a2-8fb7-fa3986292753",
                        "tags": [
                            "plural"
                        ],
                        "form": "tracs"
                    },
                    {
                        "form_id": "628bbd18-d414-4aee-aed7-8f1469e9e615",
                        "entry_id": "9c5100ee-df55-37a2-8fb7-fa3986292753",
                        "tags": [],
                        "form": "traque"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1baccf1-d515-324a-8277-2564b614270f",
                        "entry_id": "9c5100ee-df55-37a2-8fb7-fa3986292753",
                        "glosses": [
                            "Sentiment d'appréhension irraisonnée avant d'affronter le public, d'entrer en scène. Peur qu’éprouvent les acteurs, chanteurs, orateurs, etc., au moment de paraître en public."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1b9394de-2cbc-4f9f-a6b3-4535b1356204",
                                "sense_id": "a1baccf1-d515-324a-8277-2564b614270f",
                                "text": "Une fois le pied sur les planches, je sentis ce courage factice fondre à la menace du danger. Il me passait devant les yeux des éblouissements convulsifs. J'éprouvais dans les jambes, le tremblement nerveux du conscrit à son premier coup de feu, et j'entendais distinctement le tic-tac de mon cœur qui battait comme un balancier de pendule. Tranchons le mot : j'avais le trac."
                            },
                            {
                                "example_id": "62f4b670-d380-4f21-8312-550e2703d15c",
                                "sense_id": "a1baccf1-d515-324a-8277-2564b614270f",
                                "text": "Elle attendait le trac qui ne venait pas. Pourtant tous les bons comédiens l’ont."
                            },
                            {
                                "example_id": "b2463dab-8c34-4f77-b73e-903abbbc7290",
                                "sense_id": "a1baccf1-d515-324a-8277-2564b614270f",
                                "text": "C’était bel et bien l’espion qui a le trac d’être pris et qui ne veut plus continuer son redoutable métier."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b794c22-805a-3e41-ae2f-b4ff4827be53",
                        "entry_id": "9c5100ee-df55-37a2-8fb7-fa3986292753",
                        "glosses": [
                            "Sentiment d’appréhension éprouvé dans une situation délicate ou cruciale."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a4dc7928-cec0-48aa-a487-2e0fefbc0df8",
                                "sense_id": "2b794c22-805a-3e41-ae2f-b4ff4827be53",
                                "text": "– On veut se dépêcher, disait-il, il faudrait avoir le temps de fouiller dans toutes ces affaires ; on ne peut pas, parce que, il n’y a pas à dire, on a tout de même un peu le trac."
                            },
                            {
                                "example_id": "d793be4d-d23e-44ce-90af-d5ac66b0b7c3",
                                "sense_id": "2b794c22-805a-3e41-ae2f-b4ff4827be53",
                                "text": "On était pareil à un chat qui s’est glissé dans le buffet pour manger une sauce. Il a vaguement le trac, et quand il s’agit d’attaquer la sauce, voilà qu’il n’a plus d’appétit."
                            },
                            {
                                "example_id": "d9cb3450-701b-4b34-8d1d-debce6028f9a",
                                "sense_id": "2b794c22-805a-3e41-ae2f-b4ff4827be53",
                                "text": "– Je crains que nous n’ayons des ennuis !\n– On croirait qu’il t’a filé le trac !\n– Exactement !…"
                            }
                        ]
                    },
                    {
                        "sense_id": "8d05b2ae-125a-3323-9ce1-58e50bdcb0e5",
                        "entry_id": "9c5100ee-df55-37a2-8fb7-fa3986292753",
                        "glosses": [
                            "Sentiment de tension, de peur et de désarroi dont la cause est diffuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1ec8634-a38b-44e8-a24a-175cd0a21ae0",
                                "sense_id": "8d05b2ae-125a-3323-9ce1-58e50bdcb0e5",
                                "text": "C’était une ville qui collait le trac."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4c19236-b1d0-4b17-9abc-97611eab8d4b",
                        "source_entry_id": "9c5100ee-df55-37a2-8fb7-fa3986292753",
                        "target_lang_word": "Lampenfieber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lampenfieber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "693e5145-f5b9-3c01-b494-c61812927aab",
                                        "entry_id": "0443eb25-e6ff-36e4-8c61-928df03beceb",
                                        "glosses": [
                                            "die Anspannung eines darstellenden Künstlers kurz vor einem Bühnenauftritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6951d8f2-7d91-4e42-8e1a-e6660a550403",
                                                "sense_id": "693e5145-f5b9-3c01-b494-c61812927aab",
                                                "text": "Selbst erfahrene Entertainer können vor einem Fernsehauftritt noch Lampenfieber bekommen."
                                            },
                                            {
                                                "example_id": "672000e0-120d-46f1-974a-1e893094f8ab",
                                                "sense_id": "693e5145-f5b9-3c01-b494-c61812927aab",
                                                "text": "„Ein leichtes Zittern in Hamanns Stimme verrät das Lampenfieber vor dem ersten Auftritt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3976e0f9-e016-318b-aeaa-ddfdb0df4f4e",
                                        "entry_id": "0443eb25-e6ff-36e4-8c61-928df03beceb",
                                        "glosses": [
                                            "die Anspannung oder gar Panik eines Menschen kurz vor einem Auftritt vor (meist vielen) Personen"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b053b884-7982-4a70-99b8-7633425b8f55",
                                                "sense_id": "3976e0f9-e016-318b-aeaa-ddfdb0df4f4e",
                                                "text": "Die Braut hatte Lampenfieber und zögerte einige Minuten lang, die Kirche zu betreten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff88e54a-b46c-470b-ae5b-a99b72c497d6",
