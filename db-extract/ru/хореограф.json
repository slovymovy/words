                        "target_lang_word": "choreographer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choreographer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aad1a3af-a4bc-31d7-8a02-9fd6dbac45eb",
                                        "entry_id": "60ef6ad3-2abf-30e1-8ea2-19ce2e5bc70d",
                                        "glosses": [
                                            "A person who choreographs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6aad138-3361-47da-983c-2a8d2361ad95",
                                                "sense_id": "aad1a3af-a4bc-31d7-8a02-9fd6dbac45eb",
                                                "text": "\"More and more, the shrewdest thinkers and artists are precocious archeologists of ... ruins-in-the-making, indignant or stoical diagnosticians of defeat, enigmatic choreographers of the complex spiritual movements useful for individual survival in an era or permanent apocalypse.\""
                                            },
                                            {
                                                "example_id": "fd52c3fa-94c0-4338-a6a4-e873a2165376",
                                                "sense_id": "aad1a3af-a4bc-31d7-8a02-9fd6dbac45eb",
                                                "text": "Chandralekha, a choreographer from Madras, India, has been described as a counterculturalist who draws on elements of classical Indian dance like Bharata Natyam and on Western modern dance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54e729d0-cd5f-4856-816c-c2d30d71529a",
                        "source_entry_id": "4d69a0da-ced3-311d-b1d6-08de728321ef",
                        "target_lang_word": "choreographist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choreographist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbe61da6-9afa-3aba-b7f0-1e07e542c249",
                                        "entry_id": "818473d7-f0fc-31ff-98aa-a76ccc672058",
                                        "glosses": [
                                            "A choreographer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcf62440-6bc2-4633-92df-6118925a5727",
                                                "sense_id": "bbe61da6-9afa-3aba-b7f0-1e07e542c249",
                                                "text": "A dancer turned choreographist, she has founded, fostered, directed and held together the Sadler's Wells Company."
                                            }
                                        ]
