                        "entry_id": "0bef334d-173e-3714-a185-edd8647eb30c",
                        "glosses": [
                            "A genre, especially of anime and manga, featuring playful, tongue-in-cheek usage of sexualized scenes and situations such as double entendre or flirtation, while remaining non-pornographic. Often used to differentiate from hentai which features overt sexual themes."
                        ],
                        "tags": [
                            "Japanese",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "78f10de0-de1f-4a7e-afa6-bfc5ad06231e",
                                "sense_id": "25a0b6e5-0dbd-312d-9d3c-0461a9a2643c",
                                "text": "The manga fan was disturbingly proud of his extensive ecchi collection."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd67a6d9-837f-3f20-b214-f2ead268c866",
                        "entry_id": "0bef334d-173e-3714-a185-edd8647eb30c",
                        "glosses": [
                            "A situation within a story, especially anime and manga, which ventures into the ecchi genre."
                        ],
                        "tags": [
                            "Japanese",
                            "countable",
                            "rare"
                        ],
                        "examples": [
