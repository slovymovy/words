                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3da741f6-5610-4882-b4e6-ee79d76e0d59",
                        "source_entry_id": "13dc8094-dbae-35d8-af1c-f5ee92f06899",
                        "source_sense_description": "всеобщность",
                        "target_lang_word": "universalidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "universalidad",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ad54b6fa-a2d6-346a-b991-3e948d74100b",
                                        "entry_id": "184d5b9d-4fcb-368a-b855-9d8423197f05",
                                        "glosses": [
                                            "Cualidad de lo universal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37638ba-edd6-4e94-8719-de8d58b034f3",
                                                "sense_id": "ad54b6fa-a2d6-346a-b991-3e948d74100b",
                                                "text": "El ángel exterminador, como veremos, está llena de guiños cuya base real sólo un residente podía entender, pero ello no impide su universalidad: las bromas de colegio mayor y mocerío alborotado han cuajado en hondas reflexiones sobre la condición humana"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e0f478e-f4b8-4d0a-b628-0c1b065f4696",
                        "source_entry_id": "13dc8094-dbae-35d8-af1c-f5ee92f06899",
                        "source_sense_description": "всеобщность",
                        "target_lang_word": "Universalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Universalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d2f41cf-c38b-3c4d-bf02-bffc4d2f0dda",
                                        "entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                                        "glosses": [
                                            "Eigenschaft, (so gut wie) immer und überall (universal) zu gelten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d882f4af-d3aa-4621-a08f-82c038a90882",
                                                "sense_id": "7d2f41cf-c38b-3c4d-bf02-bffc4d2f0dda",
                                                "text": "„Universalität gerät immer in Konfrontation mit lokalen, kulturellen und rechtsphilosophischen Spezifitäten. Strittig ist dabei auch, ob Menschenrechte schon positive Grundrechte oder nur vorstaatliche Naturrechte sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea719316-a89d-3058-b9a9-ddd91c7f8d7b",
                                        "entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                                        "glosses": [
                                            "Eigenschaft einer Person, Bildung, Kenntnisse, Wissen oder Kreativität zu besitzen, die sich auf alle/viele Gebiete ausdehnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "806a9ebe-c3c4-4d79-b280-f7003e313d78",
                                                "sense_id": "ea719316-a89d-3058-b9a9-ddd91c7f8d7b",
                                                "text": "„Daß die Universalität Göthes mit dem Gesagten nicht erschöpft ist, weiß Jeder, der mit deutscher Literatur bekannt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5e80d6fd-c124-388f-89ff-cdc8c6241ca3",
                                        "entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                                        "glosses": [
                                            "Eigenschaft einer Sache oder eines Verfahrens, für viele Zwecke eingesetzt werden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0618d703-c0ec-4605-a059-d4cfae7abfbe",
                                                "sense_id": "5e80d6fd-c124-388f-89ff-cdc8c6241ca3",
                                                "text": "„Beide Methoden zeichnen sich durch Einfachheit und Universalität der Anwendung aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56bd0dda-e3d9-4f0b-acd1-ecb64996e743",
                        "source_entry_id": "13dc8094-dbae-35d8-af1c-f5ee92f06899",
                        "source_sense_description": "разносторонность",
                        "target_lang_word": "versatility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versatility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                                        "entry_id": "4c05361d-cf79-3d4f-bd39-ae3b8baae7f6",
                                        "glosses": [
                                            "The property of being versatile or having many different abilities."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b601a28-5efa-4745-bed5-ff711a90764a",
                                                "sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                                                "text": "Those are the sort of women who polish a young man the most, and who give him that habit of complaisance, and that flexibility and versatility of manners which prove of great use to him with men, and in the course of business."
                                            },
                                            {
                                                "example_id": "9d7bff12-d9ae-46fc-960a-760c216872b2",
                                                "sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                                                "text": "We broke up our tests into three categories — performance, durability and versatility — so we could compare the different features of each jacket against the others directly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
