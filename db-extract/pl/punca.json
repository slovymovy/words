                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b841d70-a6b2-3093-acbb-820d8fe69b68",
                                        "entry_id": "7f063d57-077a-3b52-9beb-ced3b6f5bfb5",
                                        "glosses": [
                                            "A hit or strike with one's fist."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e23dae-bad9-4dee-b5cd-0f67c9a201ae",
                                                "sense_id": "4b841d70-a6b2-3093-acbb-820d8fe69b68",
                                                "text": "Another Karadeniz cross led to Cudicini's first save of the night, with the Spurs keeper making up for a weak punch by brilliantly pushing away Christian Noboa's snap-shot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3841d88-30c8-3fbf-bd73-f0f0241547db",
                                        "entry_id": "7f063d57-077a-3b52-9beb-ced3b6f5bfb5",
                                        "glosses": [
                                            "A blow from something other than the fist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac9264e9-beda-473c-ac80-2a372073f33e",
                                                "sense_id": "c3841d88-30c8-3fbf-bd73-f0f0241547db",
                                                "text": "For in Tashbaan there is only one traffic regulation, which is that everyone who is less important has to get out of the way for everyone who is more important; unless you want a cut from a whip or a punch from the butt end of a spear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f082e753-14a2-3086-96a1-a15f58050e10",
                                        "entry_id": "7f063d57-077a-3b52-9beb-ced3b6f5bfb5",
                                        "glosses": [
                                            "Power, strength, energy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89ff3bca-22f0-420e-9d5c-427539d555bf",
                                                "sense_id": "f082e753-14a2-3086-96a1-a15f58050e10",
                                                "text": "The tornado is finally losing its punch."
                                            },
                                            {
                                                "example_id": "03424c35-eae6-43cb-b0cc-f46f4df76263",
                                                "sense_id": "f082e753-14a2-3086-96a1-a15f58050e10",
                                                "text": "Nixon inadvertently took most of the punch out of the Red Scare by trekking to Peking and Moscow."
                                            },
                                            {
                                                "example_id": "30da79c5-58da-4af9-9e8b-580f7f11d9d2",
                                                "sense_id": "f082e753-14a2-3086-96a1-a15f58050e10",
                                                "text": "The theorizing often lacks punch and tightness, and that is because Kleinberg is unresolved about how to think about the facts, unsure which are the relevant facts, unsure that thinking itself will be liberating for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68a7f842-7293-38e5-af7e-600e5b280d62",
                                        "entry_id": "7f063d57-077a-3b52-9beb-ced3b6f5bfb5",
                                        "glosses": [
                                            "Impact."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "punch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6d0ed05-8974-3587-837a-58784716d7bc",
                                        "entry_id": "fb5a1c9b-4cdf-3af8-9b0d-0bf18183977f",
                                        "glosses": [
                                            "To strike with one's fist."
