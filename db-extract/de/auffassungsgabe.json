                        ],
                        "form": "der Auffassungsgabe"
                    },
                    {
                        "form_id": "98021cf8-f8ab-4776-9ea1-ac2f4a93b449",
                        "entry_id": "4f61767a-e46e-3c66-a6b2-2e1bd71f54f8",
                        "tags": [
                            "accusative",
