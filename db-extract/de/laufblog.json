                "senses": [
                    {
                        "sense_id": "d432e03f-d01f-34d4-b213-293ef433738e",
                        "entry_id": "ed4f7e4f-5b19-33af-92b0-5413cbad5c1d",
                        "glosses": [
                            "Blog, dessen Hauptthema das Laufen ist; Blog mit laufbezogenen Inhalten"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "67a404e5-15d3-42e6-9424-0058bea85045",
                                "sense_id": "d432e03f-d01f-34d4-b213-293ef433738e",
                                "text": "„In meiner Freizeit gehe ich gerne laufen und betreibe auch einen Laufblog.“"
                            },
                            {
                                "example_id": "ab91992b-35d2-4d17-9bda-879df694dc04",
                                "sense_id": "d432e03f-d01f-34d4-b213-293ef433738e",
                                "text": "„Es kommen natürlich noch ein paar weitere tolle Veranstaltungen hinzu, die ich euch in gewohnter Manier dann auch noch im Detail hier im Laufblog vorstellen werde.“"
                            },
                            {
                                "example_id": "8b1c6e5f-3222-46f4-b422-86050047fa9f",
                                "sense_id": "d432e03f-d01f-34d4-b213-293ef433738e",
                                "text": "„Aber da dies hier in der Hauptsache immer noch ein Laufblog ist, möchte ich natürlich auch darüber berichten, dass ich gestern ein zweites Mal in diesem Monat gelaufen bin.“"
                            },
                            {
                                "example_id": "7c57d74d-770a-41a8-b3ab-7e7bf054c306",
                                "sense_id": "d432e03f-d01f-34d4-b213-293ef433738e",
                                "text": "„Jepp, neben meinen Rätselseiten betreibe ich jetzt auch noch einen Laufblog🙂“"
                            },
                            {
                                "example_id": "dc28ae64-6e62-41e4-b373-6650170a2603",
                                "sense_id": "d432e03f-d01f-34d4-b213-293ef433738e",
                                "text": "„In meinem Laufblog Deuser rennt (ehemals Knacki rennt) berichte ich über das Abenteuer Laufen, über die besten Orte, die größten Herausforderungen und alles was einen so im Leben motivieren könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
