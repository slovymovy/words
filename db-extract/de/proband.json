                                "target_senses": [
                                    {
                                        "sense_id": "4e4c7e54-1952-3f34-ac50-160a65014c07",
                                        "entry_id": "5ea81eac-aba7-363b-aaf5-c88b49e65498",
                                        "glosses": [
                                            "Someone who is subjected to an experiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eee33cf-7c1c-474c-adcc-d935c35502cc",
                                                "sense_id": "4e4c7e54-1952-3f34-ac50-160a65014c07",
                                                "text": "Thus, in the first 100 experiments made with the second movement greater, it was judged greater seventy-six times, less twenty-one times, and the experimentee was unable to come to a decision three times."
                                            },
                                            {
                                                "example_id": "800b2155-5388-41d3-bc3b-93667c83a3f4",
                                                "sense_id": "4e4c7e54-1952-3f34-ac50-160a65014c07",
                                                "text": "The experimentees learn their results at the end of the two-hour show, and while the discovery of a white man or an Ashkenazi Jew in the family tree might seem unsurprising to the viewer, it knocks some of the test subjects for a loop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
