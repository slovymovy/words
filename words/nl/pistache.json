                                "target_lang_word": "pistachio tree",
                                "target_lang_sense_clarification": "the tree"
                            },
                            {
                                "target_lang_word": "pistachio",
                                "target_lang_sense_clarification": "the tree"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52612c4a-198d-3f6a-9237-096a4db9aee5",
                    "sense_definition": "het toeval waarbij twee personen op exact hetzelfde moment hetzelfde woord uitspreken",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "toevallige_gelijktijdigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zeiden allebei op hetzelfde moment \"bingo\", dat was een <w>pistache</w>.",
                            "target_lang_translations": {
                                "en": "We both said \"bingo\" at the same time, that was a <w>jinx</w>."
                            }
                        },
                        {
                            "text": "Wat grappig dat we tegelijkertijd hetzelfde riepen, echt een <w>pistache</w>!",
                            "target_lang_translations": {
                                "en": "How funny that we shouted the same thing at the same time, a real <w>jinx</w>!"
                            }
                        }
                    ],
                    "synonyms": [
                        "twix"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "jeugdtaal of informele spelcontext"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the coincidence where two people say the exact same word at the same time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jinx",
                                "target_lang_sense_clarification": "saying the same word at the same time"
                            },
                            {
                                "target_lang_word": "snap",
                                "target_lang_sense_clarification": "British English, saying the same thing"
                            }
                        ]
                    }
                }
