                    {
                        "translation_id": "d6f3e988-f170-421b-8423-391488961565",
                        "source_entry_id": "f7d742bf-4201-3ff0-98d0-5f86ad9b5f5e",
                        "source_sense_description": "exclamation or filled pause in grammar",
                        "target_lang_word": "interjection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
