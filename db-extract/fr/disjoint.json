        "fr-extract.jsonl": [
            {
                "entry_id": "d8b50792-cf07-3b2c-9dbc-bb6c8ff3dafb",
                "word": "disjoint",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8b8cc5ac-2932-49b2-b6a0-9782ea43d19b",
                        "entry_id": "d8b50792-cf07-3b2c-9dbc-bb6c8ff3dafb",
                        "tags": [
