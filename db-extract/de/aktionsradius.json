                ],
                "senses": [
                    {
                        "sense_id": "74744f7d-3790-3548-8487-63da98e0609a",
                        "entry_id": "eeef10d5-b4b1-34fd-8482-ce0e122c0373",
                        "glosses": [
                            "Bereich, auf den eine Person Einfluss ausüben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d29b5a63-a2b1-4f57-8d09-38cdd1b22387",
                                "sense_id": "74744f7d-3790-3548-8487-63da98e0609a",
                                "text": "„Im Gegensatz zum Fußgänger hat der Radler aber einen ganz anderen Aktionsradius.“"
                            },
                            {
                                "example_id": "aa89e98e-ed7d-4156-a6f3-7dfb2335dfc1",
                                "sense_id": "74744f7d-3790-3548-8487-63da98e0609a",
                                "text": "„Heutige Protagonistinne wie die bekannte Anwältin Asma Jahangir sehen sich noch immer mit konservativen Kräften konfrontiert, die den Aktionsradius der Frau auf Heim und Herd beschränkt sehen möchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a9e15ac7-e5fc-3267-b5f3-c97eeaf5a2e8",
                        "entry_id": "eeef10d5-b4b1-34fd-8482-ce0e122c0373",
                        "glosses": [
                            "Strecke, die ein Schiff, Flugzeug oder Fahrzeug mit seinem Treibstoffvorrat zurücklegen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1941432b-7a17-4e21-bf2c-6a267d4e6063",
                                "sense_id": "a9e15ac7-e5fc-3267-b5f3-c97eeaf5a2e8",
                                "text": "„Zwei typische Einwände gegen Elektroautos sind der begrenzte Aktionsradius und die lange Ladedauer.“"
                            },
                            {
                                "example_id": "9148d7d8-55bd-4f6f-97a5-c63d6e5d9951",
                                "sense_id": "a9e15ac7-e5fc-3267-b5f3-c97eeaf5a2e8",
                                "text": "„Mit der höheren Geschwindigkeit sei auch ein größerer Aktionsradius möglich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "39450e5d-31f8-3b0f-9765-0b7c53dc3abe",
                        "entry_id": "eeef10d5-b4b1-34fd-8482-ce0e122c0373",
                        "glosses": [
                            "begrenztes Gebiet, in dem ein Tier lebt; Lebensraum eines Tieres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a1a69bb-b04a-4ef9-a4b9-6db20c1736cb",
                                "sense_id": "39450e5d-31f8-3b0f-9765-0b7c53dc3abe",
                                "text": "„Schwebfliegen haben keine feste Heimat und daher einen wesentlich weiteren Aktionsradius.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
