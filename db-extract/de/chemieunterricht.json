                ],
                "senses": [
                    {
                        "sense_id": "12d9eaec-4969-3c63-8572-a2e942c9efa6",
                        "entry_id": "be5bdc0f-963a-3a9d-b062-9967b0312ab0",
                        "glosses": [
                            "Unterricht, der in der Schule im Fach Chemie abgehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a7784f-6f95-40d9-a4d5-75c86d4b17e8",
                                "sense_id": "12d9eaec-4969-3c63-8572-a2e942c9efa6",
                                "text": "„In unserer Kindheit war der Chemieunterricht immer ein Erlebnis, wir bastelten an Substanzen, kippten das eine oder andere zusammen, rührten und sahen es aufwallen und blubbern.“"
                            },
                            {
                                "example_id": "e637246b-29a9-4b11-a926-fdb50a309595",
                                "sense_id": "12d9eaec-4969-3c63-8572-a2e942c9efa6",
                                "text": "„Nicht selten berichtete der Bruder von merkwürdigen Geräuschen und Gerüchen, die an Chemieunterricht erinnerten.“"
                            },
                            {
                                "example_id": "7bffa568-1dde-4930-80cb-adeb70e2f166",
                                "sense_id": "12d9eaec-4969-3c63-8572-a2e942c9efa6",
                                "text": "„Andererseits war die Idee der Verwandlung der Substanzen, auch metallischer Substanzen, eine ganz ›natürliche‹ Vorstellung, die nur heutige Menschen für verrückt halten können, die vergessen haben, dass das periodische System der Elemente, das sie im Chemieunterricht gequält hat, aus der zweiten Hälfte des 19. Jahrhunderts stammt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
