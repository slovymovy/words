                            {
                                "example_id": "e048f751-04f9-4e05-8c8f-ce7321de201e",
                                "sense_id": "e4bd3d6c-df44-3734-865f-d651eb4ca6e2",
                                "text": "„Das RKI ist die zentrale Einrichtung der Bundesregierung auf dem Gebiet der Krankheitsüberwachung und -prävention […].“"
                            },
                            {
                                "example_id": "b441cccd-78b0-422c-ac97-996a1a496b8b",
                                "sense_id": "e4bd3d6c-df44-3734-865f-d651eb4ca6e2",
                                "text": "„Dutzende [Länder] gelten laut RKI aber nach wie vor als Risikogebiete.“"
                            },
                            {
                                "example_id": "a2af43fa-dbdc-45b8-ad86-07fb795fc8e5",
                                "sense_id": "e4bd3d6c-df44-3734-865f-d651eb4ca6e2",
                                "text": "„Die Zahl der Todesfälle im Zusammenhang mit einer Coronavirus-Infektion liegt nach Angaben des RKI bei 9.196.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
