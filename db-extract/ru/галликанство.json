                                        "sense_id": "9512c29b-bc02-3105-97a5-735090e2f48c",
                                        "entry_id": "7cd2a83f-f53e-33d4-896f-3dd758d8a2bd",
                                        "glosses": [
                                            "Doctrine gallicane relative à la constitution et à l’étendue du pouvoir spirituel et opposée en des mesures diverses à certaines prérogatives du pape à l’égard de l’Église et de l’Église vis-à-vis de l’État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3ab830-e5a4-4d30-992c-5faacbc9954f",
                                                "sense_id": "9512c29b-bc02-3105-97a5-735090e2f48c",
                                                "text": "Le gallicanisme des juristes différait profondément de celui du clergé français : si l’Église nationale défendait son autonomie contre la curie romaine, elle n’entendait pas la sacrifier à l’État et Rome offrait un recours contre les empiètements de celui-ci."
                                            }
                                        ]
                                    },
