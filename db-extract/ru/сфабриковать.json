                                    {
                                        "sense_id": "3dbf5e08-4a2a-3ed9-8ac1-de0f0f38772c",
                                        "entry_id": "cc862469-09bf-31f6-bcb6-be3b8f5f13c2",
                                        "glosses": [
                                            "ein Produkt unternehmerisch herstellen"
                                        ],
                                        "tags": [
                                            "outdated",
