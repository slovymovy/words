                "senses": [
                    {
                        "sense_id": "624f09dd-0c05-3c7f-a1c5-fd7b6d9b90f8",
                        "entry_id": "40dc1517-95ea-379b-a685-d52b669eea84",
                        "glosses": [
                            "книжн. теория, анализирующая методы и свойства другой теории"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d184f4f3-ffc8-43eb-8d1b-4ffcd5e7e393",
                                "sense_id": "624f09dd-0c05-3c7f-a1c5-fd7b6d9b90f8",
                                "text": "Очевидно, что для социологической метатеории наиболее приемлем интегративный подход, объединяющий макро- и микрологику определения её объекта."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbc5f080-5c08-47e6-9921-c2d814dcfb0d",
                        "source_entry_id": "40dc1517-95ea-379b-a685-d52b669eea84",
                        "source_sense_id": "624f09dd-0c05-3c7f-a1c5-fd7b6d9b90f8",
                        "target_lang_word": "metatheory",
