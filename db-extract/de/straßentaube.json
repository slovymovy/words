                    {
                        "translation_id": "6d3dfa4f-61e9-44cb-a7c5-3ae0b7063707",
                        "source_entry_id": "d6dc582f-2715-3c30-af7c-8dcd83d327ee",
                        "source_sense_id": "320aa217-3eb4-3a89-946c-dcf042bfc38c",
                        "source_sense_description": "sekundär verwilderte Haustaube",
