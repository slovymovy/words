                "translations": [
                    {
                        "translation_id": "177f069f-afd0-4708-b642-fb2318f59b4c",
                        "source_entry_id": "c0e5425a-a498-3b6c-8e34-2878fa180312",
                        "source_sense_id": "db26fde6-8195-30b1-bc66-00c122114cbf",
