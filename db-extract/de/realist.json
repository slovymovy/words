                "senses": [
                    {
                        "sense_id": "7fc359ea-7b54-3197-89bb-58c28db775c4",
                        "entry_id": "dcddbe47-eceb-3ebd-97a4-8124f96b0a1e",
                        "glosses": [
                            "an der Wirklichkeit/Realität (und nicht an Vorstellungen, Träumen oder gar Utopien) orientierter Mensch; nüchtern-sachlich denkender und handelnder Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73c5b1a7-0cc5-468f-8583-4db1cbb9ab6f",
                                "sense_id": "7fc359ea-7b54-3197-89bb-58c28db775c4",
                                "text": "Seien wir Realisten, dieser Traum wird sich wohl nie verwirklichen lassen."
                            },
                            {
                                "example_id": "cc2ba106-285d-472e-b902-dc5747976b4d",
                                "sense_id": "7fc359ea-7b54-3197-89bb-58c28db775c4",
                                "text": "„Nach solcher Lektion darf Phanias die ihm dann doch angeborene Wirklichkeit genießen und wird auf solche angenehme Weise Realist und in derartigem Überfluss genügsam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c1cfd280-7eb7-384d-9c20-87ada66fd045",
                        "entry_id": "dcddbe47-eceb-3ebd-97a4-8124f96b0a1e",
                        "glosses": [
                            "Anhänger der (künstlerischen/literarischen/philosophischen) Strömung des Realismus (ab 18. Jahrhundert)"
                        ],
