                "senses": [
                    {
                        "sense_id": "a405ef69-afe3-39e6-84f8-a074150b8277",
                        "entry_id": "079dd661-59af-3bd0-9adf-19c4305585c7",
                        "glosses": [
                            "S’affranchir soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d43c796a-6a84-4a78-9911-56a88cca3af3",
                                "sense_id": "a405ef69-afe3-39e6-84f8-a074150b8277",
                                "text": "L’affranchissement ne relève ni d'un déterminisme (l’affranchi ne peut l'être malgré lui), ni d’une démarche volontaire (il ne peut s’auto-affranchir)."
                            },
                            {
                                "example_id": "131804f3-a160-469a-8827-8cae93b898a8",
                                "sense_id": "a405ef69-afe3-39e6-84f8-a074150b8277",
                                "text": "Certains considéreront malgré tout la possibilité offerte aux aînés de s’auto-affranchir de leur droit de vote comme indésirable."
                            }
                        ]
                    }
