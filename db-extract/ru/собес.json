                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b77153-276b-4b08-91aa-2cd69bc38e32",
                                                "sense_id": "3978f643-8bfb-3e75-946a-9db88fa61812",
                                                "text": "Vom Bruttolohn wird Steuer und Sozialversicherung abgezogen, das Ergebnis ist der Nettolohn."
