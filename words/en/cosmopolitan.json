{
    "word_family": [
        "cosmopolis",
        "cosmopolitanism",
        "cosmopolite"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dec2d52e-bfcb-338e-a1d0-e486e308d353",
                    "sense_definition": "At ease in any part of the world; having a wide experience with many cultures.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "worldly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>cosmopolitan</w> traveler who feels comfortable in any city she visits.",
                            "target_lang_translations": {
                                "zh": "她是一位<w>四海为家</w>的旅行者，在访问的任何城市都感到自在。",
                                "ru": "Она — <w>космополитичная</w> путешественница, которая чувствует себя комфортно в любом городе, куда бы ни приехала."
                            }
                        },
                        {
                            "text": "Living in many countries made him a truly <w>cosmopolitan</w> person.",
                            "target_lang_translations": {
                                "zh": "在许多国家生活过，使他成为一个真正<w>见多识广</w>的人。",
                                "ru": "Жизнь во множестве стран сделала его по-настоящему <w>космополитичным</w> человеком."
                            }
                        }
                    ],
                    "synonyms": [
                        "cosmopolite"
                    ],
                    "common_phrases": [
                        "cosmopolitan lifestyle"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人见多识广，在世界各地都能适应，对不同文化有深入了解。",
                        "ru": "Чувствующий себя свободно в любой точке мира; имеющий широкий кругозор и опыт знакомства с разными культурами."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "四海为家",
                                "target_lang_sense_clarification": "形容人适应力强，在任何地方都能像在家里一样。"
                            },
                            {
                                "target_lang_word": "见多识广",
                                "target_lang_sense_clarification": "形容人阅历丰富，了解多种文化。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "космополитичный",
                                "target_lang_sense_clarification": "свободно чувствующий себя в разных культурах"
                            },
                            {
                                "target_lang_word": "космополитический",
                                "target_lang_sense_clarification": "обладающий широкими мировыми взглядами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "725d8180-1982-33b7-b6e8-b19891b375ed",
                    "sense_definition": "Composed of people from many different parts of the world.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "worldly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "London is a very <w>cosmopolitan</w> city with residents from every continent.",
                            "target_lang_translations": {
                                "zh": "伦敦是一座非常<w>国际化</w>的城市，居民来自各大洲。",
                                "ru": "Лондон — очень <w>космополитичный</w> город с жителями со всех континентов."
                            }
                        },
                        {
                            "text": "The university attracts a <w>cosmopolitan</w> student body from all over the globe.",
                            "target_lang_translations": {
                                "zh": "这所大学吸引了来自全球各地的<w>多元文化</w>学生群体。",
                                "ru": "Университет привлекает <w>многонациональное</w> студенческое сообщество со всего земного шара."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cosmopolitan city"
                    ],
                    "target_lang_definitions": {
                        "zh": "指由来自世界各地的人组成，具有多元文化特征的。",
                        "ru": "Включающий представителей многих стран и культур; многонациональный."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "国际化",
                                "target_lang_sense_clarification": "形容城市或环境具有多元文化背景。"
                            },
                            {
                                "target_lang_word": "多元文化",
                                "target_lang_sense_clarification": "形容社会或群体包含多种文化背景。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "космополитичный",
                                "target_lang_sense_clarification": "многонациональный, вобравший культуры разных стран"
                            },
                            {
                                "target_lang_word": "космополитический",
                                "target_lang_sense_clarification": "населённый выходцами со всего мира"
                            },
                            {
                                "target_lang_word": "многонациональный",
                                "target_lang_sense_clarification": "состоящий из представителей разных народов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8438be8-834a-36c8-b013-dd12a1cacb0e",
                    "sense_definition": "Inclusive; affecting or involving the whole world.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "worldly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization promotes a <w>cosmopolitan</w> vision of human rights for everyone.",
                            "target_lang_translations": {
                                "zh": "该组织提倡一种面向全人类的<w>世界性</w>人权愿景。",
                                "ru": "Организация продвигает <w>общечеловеческое</w> видение прав каждого жителя планеты."
                            }
                        },
                        {
                            "text": "They advocate for a <w>cosmopolitan</w> approach to solving global climate issues.",
                            "target_lang_translations": {
                                "zh": "他们主张采取<w>全球化</w>的方法来解决全球气候问题。",
                                "ru": "Они выступают за <w>глобальный</w> подход к решению мировых климатических проблем."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "具有世界性的，包含全球范围的。",
                        "ru": "Охватывающий весь мир; общечеловеческий, глобальный."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "世界性",
                                "target_lang_sense_clarification": "指涉及全球范围的。"
                            },
                            {
                                "target_lang_word": "全球化",
                                "target_lang_sense_clarification": "指具有全球视野或影响力的。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "общечеловеческий",
                                "target_lang_sense_clarification": "затрагивающий всех людей в мире"
                            },
                            {
                                "target_lang_word": "космополитический",
                                "target_lang_sense_clarification": "всемирный, глобальный"
                            },
                            {
                                "target_lang_word": "глобальный",
                                "target_lang_sense_clarification": "охватывающий весь земной шар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c6cad35-7ca1-3555-9148-469967ab6d26",
                    "sense_definition": "Widely distributed or occurring in many parts of the world.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This bird species has a <w>cosmopolitan</w> distribution across both hemispheres.",
                            "target_lang_translations": {
                                "zh": "这种鸟类在两个半球都有<w>广布的</w>分布。",
                                "ru": "Этот вид птиц имеет <w>космополитное</w> распространение в обоих полушариях."
                            }
                        },
                        {
                            "text": "Many weeds are <w>cosmopolitan</w> plants found on almost every continent.",
                            "target_lang_translations": {
                                "zh": "许多杂草都是<w>广布的</w>植物，几乎在每个大洲都能找到。",
                                "ru": "Многие сорняки являются <w>повсеместно распространёнными</w> растениями, встречающимися практически на каждом континенте."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指物种分布广泛，几乎遍布世界各地。",
                        "ru": "Широко распространённый по всему миру (о биологических видах)."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "广布的",
                                "target_lang_sense_clarification": "生物学用语，指分布范围极广。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "космополитный",
                                "target_lang_sense_clarification": "биологический термин: повсеместно распространённый"
                            },
                            {
                                "target_lang_word": "космополитический",
                                "target_lang_sense_clarification": "встречающийся в большинстве регионов планеты"
                            },
                            {
                                "target_lang_word": "повсеместно распространённый",
                                "target_lang_sense_clarification": "обитающий почти повсюду"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ef1bb52-8c9e-32e4-9ca5-67ca88372cc3",
                    "sense_definition": "A person who is at ease in any part of the world.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a true <w>cosmopolitan</w>, she speaks four languages fluently.",
                            "target_lang_translations": {
                                "zh": "作为一个真正的<w>世界公民</w>，她能流利地说四种语言。",
                                "ru": "Как настоящий <w>гражданин мира</w>, она свободно говорит на четырёх языках."
                            }
                        },
                        {
                            "text": "He is a <w>cosmopolitan</w> who enjoys exploring new cultures.",
                            "target_lang_translations": {
                                "zh": "他是一个<w>世界公民</w>，喜欢探索新的文化。",
                                "ru": "Он — <w>космополит</w>, которому нравится открывать для себя новые культуры."
                            }
                        }
                    ],
                    "synonyms": [
                        "cosmopolite"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在世界各地都能适应、具有国际视野的人。",
                        "ru": "Человек, считающий себя гражданином мира и свободно чувствующий себя в любой стране."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "世界公民",
                                "target_lang_sense_clarification": "指具有全球视野、不局限于单一文化的人。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "космополит",
                                "target_lang_sense_clarification": "человек мира, не ограниченный одной культурой"
                            },
                            {
                                "target_lang_word": "гражданин мира",
                                "target_lang_sense_clarification": "человек с глобальным мировоззрением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c04e1b1-4133-30e9-95f1-55b2d5742d62",
                    "sense_definition": "A cocktail containing vodka, triple sec, lime juice, and cranberry juice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ordered a <w>cosmopolitan</w> at the bar before dinner.",
                            "target_lang_translations": {
                                "zh": "晚饭前，她在酒吧点了一杯<w>大都会鸡尾酒</w>。",
                                "ru": "Перед ужином она заказала в баре <w>«Космополитен»</w>."
                            }
                        },
                        {
                            "text": "The bartender mixed a fresh <w>cosmopolitan</w> for the guest.",
                            "target_lang_translations": {
                                "zh": "调酒师为客人调制了一杯新鲜的<w>大都会鸡尾酒</w>。",
                                "ru": "Бармен приготовил для гостя свежий коктейль <w>«Космополитен»</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cosmo"
                    ],
                    "common_phrases": [
                        "order a cosmopolitan"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种由伏特加、橙皮甜酒、青柠汁和蔓越莓汁调制的鸡尾酒。",
                        "ru": "Коктейль на основе водки, трипл-сек, лаймового сока и клюквенного сока."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大都会鸡尾酒",
                                "target_lang_sense_clarification": "指代这种特定的鸡尾酒。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Космополитен",
                                "target_lang_sense_clarification": "популярный алкогольный коктейль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cbad5a7-fd35-3c94-8a56-3d68dc52acc3",
                    "sense_definition": "A butterfly of the species Vanessa cardui.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cosmopolitan</w> is a common butterfly found in many gardens.",
                            "target_lang_translations": {
                                "zh": "<w>大红蛱蝶</w>是一种在许多花园中常见的蝴蝶。",
                                "ru": "<w>Репейница</w> — распространённая бабочка, встречающаяся во многих садах."
                            }
                        },
                        {
                            "text": "Researchers studied the migration patterns of the <w>cosmopolitan</w> butterfly.",
                            "target_lang_translations": {
                                "zh": "研究人员研究了<w>大红蛱蝶</w>的迁徙模式。",
                                "ru": "Исследователи изучили пути миграции бабочки <w>репейницы</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "painted lady"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种分布广泛的蝴蝶，即大红蛱蝶。",
                        "ru": "Бабочка вида Vanessa cardui (репейница)."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大红蛱蝶",
                                "target_lang_sense_clarification": "Vanessa cardui 的中文学名。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "репейница",
                                "target_lang_sense_clarification": "вид дневных бабочек (Vanessa cardui)"
                            },
                            {
                                "target_lang_word": "чертополоховка",
                                "target_lang_sense_clarification": "народное название бабочки Vanessa cardui"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a052fe0e-c816-3142-a09f-959dee15580b",
                    "sense_definition": "A moth of the species Leucania loreyi.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cosmopolitan</w> moth is often attracted to bright lights at night.",
                            "target_lang_translations": {
                                "zh": "<w>劳氏粘夜蛾</w>在夜间常被明亮的灯光吸引。",
                                "ru": "Ночная бабочка <w>совка Лорея</w> часто летит на яркий свет в темноте."
                            }
                        },
                        {
                            "text": "Farmers monitor the <w>cosmopolitan</w> to protect their crops from damage.",
                            "target_lang_translations": {
                                "zh": "农民监测<w>劳氏粘夜蛾</w>以保护农作物免受损害。",
                                "ru": "Фермеры следят за популяцией <w>совки Лорея</w>, чтобы защитить урожай от повреждений."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种分布广泛的蛾类，即劳氏粘夜蛾。",
                        "ru": "Бабочка-совка вида Leucania loreyi."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "劳氏粘夜蛾",
                                "target_lang_sense_clarification": "Leucania loreyi 的中文学名。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "совка Лорея",
                                "target_lang_sense_clarification": "вид ночных бабочек-совок (Leucania loreyi)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}