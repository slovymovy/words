                                            {
                                                "example_id": "51560b16-dab2-4a00-9e1f-3c6ceeb2ae94",
                                                "sense_id": "f86563d4-f147-316c-bb85-3531ba009813",
                                                "text": "Un examen médical prénuptial."
                                            },
                                            {
                                                "example_id": "7e91e8d7-f37d-4961-95d0-f6f2f41184ef",
                                                "sense_id": "f86563d4-f147-316c-bb85-3531ba009813",
                                                "text": "Ce voyage de noces précédé d’une longue promenade prénuptiale dura, peu s’en faut, mille jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0da706cf-ce42-3065-85e2-c676d8a646c0",
                                        "entry_id": "a5215f56-f4e4-3051-a8d4-57a974509658",
                                        "glosses": [
                                            "Avant l’accouplement ou la période de reproduction."
                                        ],
                                        "tags": [
                                            "Éthologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86101238-2c64-4810-a61a-9696c5894a45",
                                                "sense_id": "0da706cf-ce42-3065-85e2-c676d8a646c0",
                                                "text": "Les travaux expérimentaux menés par les chercheuses canadiennes au printemps 2017, lors de la période de migration prénuptiale, ont porté sur un petit oiseau chanteur, le bruant à couronne blanche, représentatif des migrateurs granivores."
                                            }
                                        ]
                                    }
                                ]
