                            {
                                "example_id": "1b858fc3-d987-46a7-a466-05e5ef3939b3",
                                "sense_id": "20dd7b09-6cb2-3035-b035-26518cbe5a2d",
                                "text": "Freya's lippen trilden een beetje en ik was diep getroffen, zoals altijd, door deze tekenen van haar onzelfzuchtigheid."
                            },
                            {
                                "example_id": "c5603e35-b838-4ff2-aff9-a853c981a000",
                                "sense_id": "20dd7b09-6cb2-3035-b035-26518cbe5a2d",
                                "text": "Door een snelle counter creëerden Karim Benzema, Luka Modric en Vinícius Júnior een overtalsituatie en speelden het drietal de verdediging van Granada eenvoudig uit. Dankzij de onzelfzuchtigheid van Modric kon Vinícius zo binnentikken (1-3)."
                            }
                        ]
                    },
