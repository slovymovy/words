                ],
                "senses": [
                    {
                        "sense_id": "2eb13e78-627d-38fd-b0da-2b7e453611b6",
                        "entry_id": "cf53e973-2ea9-3486-b82d-3d765111f024",
                        "glosses": [
                            "Monument bouddhiste ou jaïn en forme de dôme qui peut contenir des reliques de Bouddha ou de saints jaïns."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "172146dd-b403-4829-bc01-6b8f0016bbce",
                                "sense_id": "2eb13e78-627d-38fd-b0da-2b7e453611b6",
                                "text": "À l'origine, le stupa est un tumulus, un empilement de pierres au cœur duquel est enfermée une relique du Bouddha. D'après la tradition, après sa crémation, les restes de Bouddha sont partagés en huit parties qui sont distribuées aux huit rois venus lui rendre hommage à cette occasion. Ces reliques vont être enchâssées dans les premiers stupas."
                            },
                            {
                                "example_id": "0f25858b-088c-4196-9aeb-e74f0a621399",
                                "sense_id": "2eb13e78-627d-38fd-b0da-2b7e453611b6",
                                "text": "Ce temple [de Jaulian] est un stupa — ou tertre de reliques — qui, lorsqu’il était intact, devait, avec son dôme et son clocher à parapluies superposés, ressembler quelque peu à la pagode birmane moderne"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a92da6a-b67a-4102-9beb-a7ba671c2eab",
                        "source_entry_id": "cf53e973-2ea9-3486-b82d-3d765111f024",
                        "source_sense_id": "2eb13e78-627d-38fd-b0da-2b7e453611b6",
                        "target_lang_word": "Stupa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stupa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82b33e57-05fe-30b1-a277-bd86bff731c0",
                                        "entry_id": "7eb7db3b-a0cf-3835-9e77-586d16751576",
                                        "glosses": [
                                            "ein runder, massiver, ursprünglich hügelartiger, buddhistischer oder jainistischer Sakralbau, der als Symbol für den heiligen Weltenberg Meru, dem Sitz der Götter, dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31ed5d7a-1e46-4ee7-b62f-31358b7001e8",
                                                "sense_id": "82b33e57-05fe-30b1-a277-bd86bff731c0",
                                                "text": "„Der im 3. Jh. v. Ch. In Indien entwickelte Stupa, urspr. ein Grabhügel, wurde als Symbol für den Heiligen Weltenberg Meru […] übernommen.“"
                                            },
                                            {
                                                "example_id": "37356116-d00c-4f27-89ed-b553021ef92f",
                                                "sense_id": "82b33e57-05fe-30b1-a277-bd86bff731c0",
                                                "text": "„Ein Stupa ist ursprünglich ein Grabhügel für die Bestattung von Königen in Indien und reicht bis in die prähistorisch-megalithische Zeit zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b921f0a-2532-4a5a-acf3-71845b222e9e",
                        "source_entry_id": "cf53e973-2ea9-3486-b82d-3d765111f024",
