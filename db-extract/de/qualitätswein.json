                "senses": [
                    {
                        "sense_id": "06d76296-beec-3ee0-8c3a-1aead2d6de36",
                        "entry_id": "a6b024eb-7ead-3223-94e0-b3cceb8b6e44",
                        "glosses": [
                            "Überbegriff für die Wein-Qualitätskategorien Qualitätswein bestimmter Anbaugebiete (abgek.: QbA) und Qualitätswein mit Prädikat (abgek.: QmP) inklusive ihrer Unterkategorien in Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66ec752-ad45-4d04-98dc-2a3094bff263",
                                "sense_id": "06d76296-beec-3ee0-8c3a-1aead2d6de36",
                                "text": "\"Alle Qualitätsweine werden im Gegensatz zu Tafel- und Landweinen einer amtlichen Prüfung unterzogen, …\""
                            },
                            {
                                "example_id": "bd361327-6063-4a42-af02-b59ca4604308",
                                "sense_id": "06d76296-beec-3ee0-8c3a-1aead2d6de36",
                                "text": "Qualitätswein ist eine internationale Bezeichnung für Weine einer höheren Güteklasse, die bestimmte gesetzliche Mindestanforderungen erfüllen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
