                            {
                                "example_id": "bfa6768f-5d23-40bd-91f3-b06124332316",
                                "sense_id": "65399799-e9ce-30a7-aa21-cf3c7281ca19",
                                "text": "Ze is zeer godsdienstig en gaat elke zondag naar de kerk.",
                                "translation": "She is very religious and goes to church every Sunday.",
                                "english": "She is very religious and goes to church every Sunday."
                            },
                            {
                                "example_id": "4ff0469a-3508-41ca-8fce-39e204ec2243",
                                "sense_id": "65399799-e9ce-30a7-aa21-cf3c7281ca19",
                                "text": "De stad is bekend om zijn godsdienstige gemeenschap.",
                                "translation": "The town is known for its religious community.",
                                "english": "The town is known for its religious community."
                            },
                            {
                                "example_id": "fa45e8b1-6271-4d05-918a-218e5d707f3a",
                                "sense_id": "65399799-e9ce-30a7-aa21-cf3c7281ca19",
                                "text": "Van alle boeken die hij heeft, is dit het godsdienstigst.",
                                "translation": "Of all the books he has, this is the most religious.",
                                "english": "Of all the books he has, this is the most religious."
                            }
                        ]
                    }
