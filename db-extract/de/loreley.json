                    },
                    {
                        "translation_id": "f79d0084-988c-43b7-8ffa-1e899da932d1",
                        "source_entry_id": "3f088544-b53e-3b25-9d70-638e8d8069cf",
                        "source_sense_id": "ca684449-0ba2-3c51-b40a-ae86936765a3",
                        "source_sense_description": "weit bekanntes deutsches Volkslied (Text: Heinrich Heine, Satz: Friedrich Silcher)",
                        "target_lang_word": "lorelei",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lorelei",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8efd63de-40ba-3a86-9c7d-2f7500f3d830",
                                        "entry_id": "a8bc2ec4-4166-3290-a30d-d1fa5781113e",
                                        "glosses": [
                                            "A siren; a temptress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "997b31e2-6dc6-4128-8c80-2fa4d4716ca9",
                                                "sense_id": "8efd63de-40ba-3a86-9c7d-2f7500f3d830",
                                                "text": "We grew silly, tongue-tied, said foolish things we did not mean to say, shoved one another about in the boat, and finally overturned it. The loreleis laughed musical little laughs."
                                            },
                                            {
                                                "example_id": "1bb8a4e0-3f46-4304-a380-3b352488ecab",
                                                "sense_id": "8efd63de-40ba-3a86-9c7d-2f7500f3d830",
                                                "text": "She was like a mermaid, an isolated creature that lives in fulfillment of its own senses; she lured me on, she was the lorelei of the gleaming river of traffic with its million, brilliant eyes that intermittently flowed between us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0af9705-f34d-4a06-bb2b-a9fba87d1ddb",
                        "source_entry_id": "3f088544-b53e-3b25-9d70-638e8d8069cf",
                        "source_sense_id": "ca684449-0ba2-3c51-b40a-ae86936765a3",
                        "source_sense_description": "weit bekanntes deutsches Volkslied (Text: Heinrich Heine, Satz: Friedrich Silcher)",
                        "target_lang_word": "Lorelei",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lorelei",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cafdcfd-f0d3-3291-849a-498390bd3670",
                                        "entry_id": "f2f40f4d-f6e5-303c-b269-e91c112f8b73",
                                        "glosses": [
                                            "Rocher de la banque du Rhin, où on racontait la légende d’une nixe qui chantait pour attirer les pêcheurs et les faisait noyer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e98a1b1-4c3c-3a2d-9b31-7d8b426ca60d",
                                        "entry_id": "f2f40f4d-f6e5-303c-b269-e91c112f8b73",
                                        "glosses": [
                                            "Nixe qui habitait sur le rocher qui porte son nom ; ou équivalent, poétiquement parlant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a6009a5-9dd4-4369-87dd-df66f8873901",
                                                "sense_id": "0e98a1b1-4c3c-3a2d-9b31-7d8b426ca60d",
                                                "text": "Lorelei, Lorelei\nNe me lâche pas j’ai mon train qui déraille\nLorelei, Lorelei\nEt je suis comme un cobaye qu’a sniffé toute sa paille"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Lorelei",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8e68505-4f01-3527-a7e0-17e06dcecb19",
                                        "entry_id": "66993ace-b973-341d-876b-5b6daff5bde8",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30d009d3-7a43-48c3-9f55-56d461dd51f8",
                                                "sense_id": "d8e68505-4f01-3527-a7e0-17e06dcecb19",
                                                "text": "« Ma cousine a été élue en 2006, pour moi c'est un rêve d'enfant. » C'est sans doute pour cette raison que Lorelei a versé sa petite larme lorsqu'elle s'est présentée devant les 400 personnes venues assister à l'élection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
