    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24a2b0dc-eae6-31e1-bde0-a4e33c6d40f2",
                    "sense_definition": "Trouver la réponse à une énigme, une question ou une information cachée par intuition ou raisonnement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conjecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu ne vas jamais <w>deviner</w> qui j'ai rencontré au supermarché ce matin."
                        },
                        {
                            "text": "Les enfants ont essayé de <w>deviner</w> le contenu du paquet cadeau."
                        }
                    ],
                    "synonyms": [
                        "trouver"
                    ],
                    "common_phrases": [
                        "deviner juste",
                        "donner à deviner",
                        "facile à deviner"
                    ]
                },
                {
                    "sense_id": "44a6c081-c087-33b7-abd6-cf482f0f36b8",
                    "sense_definition": "Comprendre intuitivement les sentiments, les pensées ou les intentions réelles de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intuition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a tout de suite <w>deviné</w> ma déception malgré mon grand sourire."
                        },
                        {
                            "text": "Il me connaît si bien qu'il <w>devine</w> mes pensées sans un mot."
                        }
                    ],
                    "synonyms": [
                        "pressentir",
                        "percevoir",
                        "comprendre"
                    ],
                    "common_phrases": [
                        "deviner les pensées",
                        "deviner les intentions"
                    ]
                },
                {
                    "sense_id": "16b1f488-1f39-3b21-af33-dfcd2c3a8bc8",
                    "sense_definition": "Distinguer ou apercevoir confusément quelque chose malgré l'obscurité ou l'éloignement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À travers le brouillard épais, on <w>devinait</w> la silhouette de l'arbre."
                        },
                        {
                            "text": "Dans l'obscurité de la nuit, je <w>devine</w> à peine le chemin."
                        }
                    ],
                    "synonyms": [
                        "apercevoir",
                        "distinguer",
                        "entrevoir"
                    ],
                    "common_phrases": [
                        "laisser deviner"
                    ]
                },
                {
                    "sense_id": "802c04e2-1e15-3d3d-b11c-053270f2848b",
                    "sense_definition": "Prédire l'avenir ou révéler des mystères cachés par des voies occultes ou magiques.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "occulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille voyante prétendait <w>deviner</w> l'avenir dans les cartes."
                        },
                        {
                            "text": "Cet astrologue affirmait qu'il pouvait <w>deviner</w> le destin de chacun."
                        }
                    ],
                    "synonyms": [
                        "prédire",
                        "prophétiser"
                    ],
                    "common_phrases": [
                        "deviner l'avenir"
                    ]
                }
            ]
        }
    ]
