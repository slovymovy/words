                        ],
                        "form": "den Mahlströmen"
                    },
                    {
                        "form_id": "f32e5e2b-3542-4e17-98ca-400cc424b648",
                        "entry_id": "0080cf8d-8a72-383f-a50f-505426684e20",
                        "tags": [
                            "accusative",
