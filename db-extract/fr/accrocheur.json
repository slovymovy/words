                                                "sense_id": "31295afa-1968-3d47-aabd-4053063932b7",
                                                "text": "a catchy question"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23a7416e-7f90-3bef-9185-cf4b3306ebdd",
                                        "entry_id": "2dc1b6d9-a992-3287-aad1-3990872c092d",
                                        "glosses": [
                                            "Consisting of, or occurring in, disconnected parts or snatches; changeable."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dd7ef6c-51ce-46fa-b108-188b65f472b7",
                                                "sense_id": "23a7416e-7f90-3bef-9185-cf4b3306ebdd",
                                                "text": "a catchy wind"
                                            },
                                            {
                                                "example_id": "2a0e7a12-9838-4e5d-ba72-6871d36af811",
                                                "sense_id": "23a7416e-7f90-3bef-9185-cf4b3306ebdd",
                                                "text": "Encyc. of Sport\nIt [the fox's scent] is […] flighty or catchy, if variable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a7d95d-4257-321c-9d4f-bc8d9a75c5dd",
                                        "entry_id": "2dc1b6d9-a992-3287-aad1-3990872c092d",
                                        "glosses": [
                                            "Contagious; catching."
