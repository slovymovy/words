        "ru-extract.jsonl": [
            {
                "entry_id": "546bf612-a9f1-3f29-8213-15f6266ce64d",
                "word": "буквально",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9dca3c9b-596f-3819-a80d-358c7ac89f13",
                        "entry_id": "546bf612-a9f1-3f29-8213-15f6266ce64d",
                        "glosses": [
                            "наречие к буквальный; точно соответствуя чему-либо, дословно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "bc19ec8a-1e57-46fd-8e63-b1d7c5522034",
                                "sense_id": "9dca3c9b-596f-3819-a80d-358c7ac89f13",
                                "text": "Когда священник начал мне давать уроки, он был удивлен не только общим знанием евангелия, но тем, что я приводил тексты буквально."
                            },
                            {
                                "example_id": "36da120c-43fb-4773-b72d-a7327d2d2b07",
                                "sense_id": "9dca3c9b-596f-3819-a80d-358c7ac89f13",
                                "text": "Представьте, что чиновники не берут больше взяток и исполняют буквально законы, представьте, что народ верит, что это в самом деле законы, — из России надо было бы бежать без оглядки."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bb444c6-bbd1-380a-acb9-0b3ae8b12218",
                        "entry_id": "546bf612-a9f1-3f29-8213-15f6266ce64d",
                        "glosses": [
                            "перен., разг. действительно, на самом деле, прямо-таки"
                        ],
                        "tags": [
                            "в знач. частицы"
                        ],
                        "examples": [
                            {
                                "example_id": "98aebb18-be81-4834-b1ef-7b1705405001",
                                "sense_id": "7bb444c6-bbd1-380a-acb9-0b3ae8b12218",
                                "text": "День был базарный, и та часть реки Большой Глуповицы, где была устроена паромная пристань, была буквально усыпана народом."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1e81a89-bf1c-35da-8100-235a2beb71fa",
                        "entry_id": "546bf612-a9f1-3f29-8213-15f6266ce64d",
                        "glosses": [
                            "перен. в прямом смысле слова"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e570c889-3147-4721-9f18-c418725553b1",
                                "sense_id": "f1e81a89-bf1c-35da-8100-235a2beb71fa",
                                "text": "Буквально сидим у моря и ждём погоды, а с нами ещё до полусотни кораблей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "686259fa-a2d2-4c70-9770-ab51b91b632b",
                        "source_entry_id": "546bf612-a9f1-3f29-8213-15f6266ce64d",
                        "source_sense_description": "в прямом смысле, дословно",
                        "target_lang_word": "verbally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71141c5c-0cc1-3b59-9dd4-16a8c3794565",
                                        "entry_id": "dc7573a5-2a8a-3142-ba3b-7adbfdee2b1b",
                                        "glosses": [
                                            "In a verbal manner; with words; by speaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f41a85-8883-46dc-8c08-a1acf8095d78",
                                                "sense_id": "71141c5c-0cc1-3b59-9dd4-16a8c3794565",
                                                "text": "Dumbstruck with joy, she was unable to express herself verbally, but the gratitude in her face was evident to all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c8cdd10-a0f7-465d-b50a-2b4ac17e842b",
                        "source_entry_id": "546bf612-a9f1-3f29-8213-15f6266ce64d",
                        "source_sense_description": "в прямом смысле, дословно",
                        "target_lang_word": "verbatim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbatim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "270fed1c-3982-395e-9824-a49b5d817daf",
                                        "entry_id": "b4a87c4b-0213-367e-99bd-c75bc0acc1a2",
                                        "glosses": [
                                            "Word for word; in exactly the same words as were used originally."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d21037c-7b7c-4f4c-b226-92878cfc26a1",
                                                "sense_id": "270fed1c-3982-395e-9824-a49b5d817daf",
                                                "text": "I have copied his speech verbatim, so this is exactly what he said, word for word."
                                            },
                                            {
                                                "example_id": "3aab4c95-1457-4c97-beab-7c75539a821b",
                                                "sense_id": "270fed1c-3982-395e-9824-a49b5d817daf",
                                                "text": "[…] in several instances Mancini’s text is virtually reproduced verbatim by Bellori.¹²⁰"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8a606b5-b7b7-3dec-b6a9-4cff8f5b763f",
                                        "entry_id": "b4a87c4b-0213-367e-99bd-c75bc0acc1a2",
                                        "glosses": [
                                            "Orally; verbally."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0182322-bb44-453f-8b54-fae1fe162db8",
                                                "sense_id": "d8a606b5-b7b7-3dec-b6a9-4cff8f5b763f",
                                                "text": "I […]am not able\nVerbatim to rehearse the method of my pen"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verbatim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7029a1b3-9576-313f-8593-b0815a699cb8",
                                        "entry_id": "440c91a6-2c4a-3db7-afd8-86806c6c48f1",
                                        "glosses": [
                                            "Corresponding with the original word for word."
                                        ],
                                        "tags": [
                                            "of a document"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69f7879-dc12-4b4f-905c-3c3b3b2f4c96",
                                                "sense_id": "7029a1b3-9576-313f-8593-b0815a699cb8",
                                                "text": "Date unknown: Joint Committee on Printing Congress of the United States, General Statement of Procedure for Verbatim Reporting of Proceedings in Senate Chamber, page five:"
                                            },
                                            {
                                                "example_id": "1228885e-82e7-4f82-804e-015b76054135",
                                                "sense_id": "7029a1b3-9576-313f-8593-b0815a699cb8",
                                                "text": "Ironically, verbatim note taking can interfere with listening attentively."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9be2aea8-2f0b-3a2a-bdc9-39f1449923be",
                                        "entry_id": "440c91a6-2c4a-3db7-afd8-86806c6c48f1",
                                        "glosses": [
                                            "Able to take down a speech word for word, especially in shorthand."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1169b31-4853-4395-89bf-38bfa77529b4",
                                                "sense_id": "9be2aea8-2f0b-3a2a-bdc9-39f1449923be",
                                                "text": "Some States require voice writers to pass a test and to earn State licensure. As a substitute for State licensure, the National Verbatim Reporters Association offers three national certifications to voice writers: Certified Verbatim Reporter (CVR), the Certificate of Merit (CM), and Real-Time Verbatim Reporter (RVR). Earning these certifications is sufficient to be licensed in States where the voice method of court reporting is permitted."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verbatim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d1522b2-38b3-39b3-b485-7af456ab3dfa",
                                        "entry_id": "a6a5ef5c-391d-3695-a722-b90b835cdd03",
                                        "glosses": [
                                            "A word-for-word report of a speech."
                                        ],
