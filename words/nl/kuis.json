                    "sense_definition": "gebiedende wijs van <w>kuisen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordvorm_kuisen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kuis</w> die vieze tafel af voor we gaan eten!",
                            "target_lang_translations": {
                                "fr": "<w>Nettoie</w> cette table sale avant qu'on ne passe à table !"
                            }
                        },
                        {
                            "text": "<w>Kuis</w> alsjeblieft eerst je laarzen voordat je naar binnen stapt.",
                            "target_lang_translations": {
                                "fr": "<w>Nettoie</w> tes bottes d'abord, s'il te plaît, avant d'entrer."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral gangbaar in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "impératif singulier du verbe « kuisen » (nettoyer)"
