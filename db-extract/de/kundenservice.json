                ],
                "senses": [
                    {
                        "sense_id": "4c0990b7-13ad-3e82-92a0-7b45fba39d87",
                        "entry_id": "bed823f3-e812-37a9-8f84-372f1e8db5a7",
                        "glosses": [
                            "reguläre oder auch zusätzliche Lieferungen und Leistung für einen Kunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f87f7f2-872c-49f6-abfc-dc96447f42d9",
                                "sense_id": "4c0990b7-13ad-3e82-92a0-7b45fba39d87",
                                "text": "„Der Kundenservice hilft Ihnen gerne weiter!“"
                            },
                            {
                                "example_id": "a01b19c1-954f-44d7-9757-36e5406c496b",
                                "sense_id": "4c0990b7-13ad-3e82-92a0-7b45fba39d87",
                                "text": "„Volle Unterstützung bieten unsere Mitarbeiter des Kundenservices, dessen Hauptaufgabe es ist eine umfassende Beratung zu geben und sicherzustellen, dass wir Ihnen bei sämtlichen Fragen bezüglich unserer Produkte, Reparaturen oder Bestellungen behilflich sind.“"
                            },
                            {
                                "example_id": "264d8efd-f986-46f3-bd4b-2708064cb3da",
                                "sense_id": "4c0990b7-13ad-3e82-92a0-7b45fba39d87",
                                "text": "„Mit den Formularen aus der folgenden Liste können Sie sich ebenfalls direkt an unseren Kundenservice wenden.“"
                            },
                            {
                                "example_id": "f1568a84-eb14-4963-a920-d7e856690192",
                                "sense_id": "4c0990b7-13ad-3e82-92a0-7b45fba39d87",
                                "text": "„Nutzer klagen über fehlgeschlagene Anmeldeversuche und einen schwer erreichbaren oder uninformierten Kundenservice.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
