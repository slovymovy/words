                    }
                ],
                "senses": [
                    {
                        "sense_id": "26924870-3a05-3c69-857e-c03777a3ed12",
                        "entry_id": "4bb57236-de7b-3f6e-b8fd-172d40095a88",
                        "glosses": [
                            "Ensemble de savoirs servant de base à de futurs enseignements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a10d1f8a-cc04-4cbe-ba5c-3a77008de1b1",
                                "sense_id": "26924870-3a05-3c69-857e-c03777a3ed12",
                                "text": "Les mathématiques constituent une propédeutique indispensable au futur dialecticien."
                            },
                            {
                                "example_id": "cd5b6398-b334-4c54-a855-60a3dbc5d1bf",
                                "sense_id": "26924870-3a05-3c69-857e-c03777a3ed12",
                                "text": "C’est ainsi que commence l’apprentissage des ségrégations, et cette propédeutique infernale de l’inégalité est sans fin, n’épargnant dès lors aucune minorité, aucune différence, aucune dissemblance. — (Edwy Plenel, L’idéologie meurtrière promue par Eric Zemmour, Médiapart, 4 janvier 2015 → lire en ligne)"
                            }
                        ]
                    },
                    {
                        "sense_id": "60abdea8-1c0a-3d2a-9df6-78ba233e6c32",
                        "entry_id": "4bb57236-de7b-3f6e-b8fd-172d40095a88",
                        "glosses": [
                            "Année de réflexion et de discernement préalable à l’entrée au séminaire de l’Église catholique pour se former à la prêtrise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0efca5d1-e5bb-442c-b8d9-d0ceb265485a",
                                "sense_id": "60abdea8-1c0a-3d2a-9df6-78ba233e6c32",
                                "text": "Au cours de leurs réflexions sur la formation des futurs prêtres, les évêques de France, réunis à Lourdes en Assemblée plénière, ont évoqué la « propédeutique », cette année de réflexion préalable à l’entrée au séminaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3da253b-d2bf-34f8-9219-ee3b2bf8e1de",
                        "entry_id": "4bb57236-de7b-3f6e-b8fd-172d40095a88",
                        "glosses": [
                            "Cours préparatoire obligatoire, pour entrer dans l’enseignement supérieur après le baccalauréat, entre 1950 et 1966."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0f4b74c1-0448-48fc-b133-dd361cb98ab5",
                                "sense_id": "d3da253b-d2bf-34f8-9219-ee3b2bf8e1de",
                                "text": "Faire sa propédeutique."
                            },
                            {
                                "example_id": "0d8b23d3-124a-4d75-8dc6-1bd2e571644a",
                                "sense_id": "d3da253b-d2bf-34f8-9219-ee3b2bf8e1de",
                                "text": "Être en propédeutique."
                            },
                            {
                                "example_id": "ffa523cf-bd07-4693-8d71-80ae1f282382",
                                "sense_id": "d3da253b-d2bf-34f8-9219-ee3b2bf8e1de",
                                "text": "Faire propédeutique."
                            },
                            {
                                "example_id": "27e1237f-8874-4c55-9517-569e61b4e648",
                                "sense_id": "d3da253b-d2bf-34f8-9219-ee3b2bf8e1de",
                                "text": "– Et quels examens allez-vous passer cette année ? demanda Odile.\n– Le certificat d'études littéraires générales… Comment l'appelle-t-on exactement, Jacqueline ?\n– Propédeutique, dit Jacqueline d'une voix étouffée."
                            }
                        ]
                    }
                ],
