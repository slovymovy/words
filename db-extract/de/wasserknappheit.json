                ],
                "senses": [
                    {
                        "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                        "entry_id": "6097b347-d1dc-3a70-8fbc-713a34747e7b",
                        "glosses": [
                            "das fast vollständige Fehlen von Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91c16b25-e836-418e-8164-10be11750965",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Vier Milliarden Menschen sind mindestens einen Monat pro Jahr von akuter Wasserknappheit betroffen – vor allem in afrikanischen Staaten.“"
                            },
                            {
                                "example_id": "164cb122-26de-4b22-bb94-9e573fc4832a",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "[Schlagzeile:] „Bericht der Unesco - Weltweite Wasserknappheit verschärft sich immer mehr“"
                            },
                            {
                                "example_id": "2421d2d3-0d78-4006-a546-30980c254f4f",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Bereits jetzt ist zehn Prozent der Weltbevölkerung von Problemen durch Wasserknappheit betroffen.“"
                            },
                            {
                                "example_id": "83d5b463-8838-4c03-a11b-c6b31d9aa057",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Wasserknappheit wird sich weltweit weiter ausbreiten und künftig auch dort auftreten, wo die Ressource derzeit noch reichlich vorhanden ist, wie in Zentralafrika, Ostasien und Teilen Südamerikas, wie die Vereinten Nationen (UN) in ihrem neuen Weltwasserbericht deutlich machen.“"
                            },
                            {
                                "example_id": "7f3b10f6-9545-488f-b3c9-3a75897cd6e5",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Ohne kontinuierlichen Abfluss von Schmelzwasser droht zunehmende Wasserknappheit für Milliarden von Menschen.“"
                            },
                            {
                                "example_id": "9cfb023f-2543-44e4-9c8c-c839dd2b31c3",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "[Dürre in Südeuropa im Sommer 2022:] „Die Wasserknappheit könnte noch monatelang dauern.“"
                            },
                            {
                                "example_id": "bd752084-e09c-4fcc-b0a4-70ca6d6686bb",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Mit dem trockenen und heißen Sommer verschärft sich die Wasserknappheit in Brandenburg.“"
                            },
                            {
                                "example_id": "594bcd0a-a45d-4493-b3c0-01f69b50bc70",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Problematisch ist auch der Import wasserintensiver Produkte wie zum Beispiel Obst- und Gemüsesorten aus Ländern wie Spanien, in denen heute schon Wasserknappheit herrscht.“"
                            },
                            {
                                "example_id": "1290a714-5386-4738-83f8-a4bbfcd986b9",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Avocado gelten als gesundes Superfood. Der industrielle Anbau steht aber in der Kritik, da er zu Umweltverschmutzung und Wasserknappheit in den Anbauländern führt.“"
                            },
                            {
                                "example_id": "ac62421c-dbe6-4efd-8255-30abc811e6b2",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Wir beziehen unsere Avocados aus Griechenland“ […] „Im Gegensatz zu Chile oder anderen Anbaugebieten herrscht dort keine Wasserknappheit.“"
                            },
                            {
                                "example_id": "4ad6c405-c208-48b8-aa6d-6501a42851f0",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Nicht nur Wasserknappheit, sondern auch die Zunahme von Extremwetter-Ereignissen wie Hochwasser ist eine Folge des Klimawandels.“"
                            },
                            {
                                "example_id": "dc31c2c5-d21e-4801-90e8-c665ebcbd837",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Vor allem die Landwirtschaft bekommt die Folgen von Wasserknappheit bereits zu spüren - schlechte Ernten sind nur ein Beispiel.“"
                            },
                            {
                                "example_id": "0380ba7b-0538-482b-9a8b-24102317d3b5",
                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                "text": "„Die Regierung López Obrador hatte bereits dem Getränkehersteller Constellation Brands die von früheren Regierungen erteilte Genehmigung für eine neue Brauerei im nordmexikanischen Mexicali wegen Wasserknappheit annulliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
