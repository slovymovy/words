                {
                    "sense_id": "36f8962b-c80f-371f-a05c-334c1896b18e",
                    "sense_definition": "Используется для побуждения к совместному действию, соответствует английскому «let's».",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "auxiliary_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Давайте</w> пойдём в кино сегодня вечером.",
                            "target_lang_translations": {
                                "en": "<w>Let's</w> go to the cinema tonight.",
                                "zh": "<w>我们</w>今晚去看电影吧。",
                                "nl": "<w>Laten we</w> vanavond naar de bioscoop gaan.",
                                "pl": "<w>Chodźmy</w> dziś wieczorem do kina.",
                                "de": "<w>Lasst uns</w> heute Abend ins Kino gehen.",
                                "fr": "<w>Allons</w> au cinéma ce soir.",
                                "it": "<w>Facciamo</w> che andiamo al cinema stasera.",
                                "cs": "<w>Poďme</w> dnes večer do kina.",
                                "tr": "Bu akşam sinemaya <w>gidelim</w>.",
                                "es": "<w>Vamos a</w> ir al cine esta noche."
                            }
                        },
                        {
                            "text": "<w>Давайте</w> говорить только по-русски.",
                            "target_lang_translations": {
                                "en": "<w>Let's</w> speak only Russian.",
                                "zh": "<w>我们</w>只说俄语吧。",
                                "nl": "<w>Laten we</w> alleen Russisch spreken.",
                                "pl": "<w>Mówmy</w> tylko po rosyjsku.",
                                "de": "<w>Lasst uns</w> nur Russisch sprechen.",
                                "fr": "<w>Parlons</w> seulement en russe.",
                                "it": "<w>Parliamo</w> solo in russo.",
                                "cs": "<w>Mluvme</w> jen rusky.",
                                "tr": "Sadece Rusça <w>konuşalım</w>.",
                                "es": "<w>Vamos a</w> hablar solo en ruso."
                            }
                        }
                    ],
                    "common_phrases": [
                        "давайте познакомимся",
                        "давайте жить дружно",
                        "давайте начнём"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to encourage joint action, corresponds to English \"let's\".",
                        "zh": "用于提议共同行动，相当于英语的“let's”。",
                        "nl": "Word gebruikt om een gezamenlijke actie voor te stellen, vergelijkbaar met 'laten we'.",
                        "pl": "Używane do zachęcenia do wspólnego działania, odpowiednik polskiego „chodźmy” lub konstrukcji z końcówką „-my”.",
                        "de": "Wird verwendet, um zu einer gemeinsamen Handlung aufzufordern, entspricht dem deutschen „lass uns“ oder „lasst uns“.",
                        "fr": "Utilisé pour encourager une action commune, équivalent à « allons » ou à la structure « on + verbe ».",
                        "it": "Usato per incoraggiare un'azione comune, corrisponde all'italiano \"facciamo\" o all'uso dell'imperativo alla prima persona plurale.",
                        "cs": "Používá se k vyjádření návrhu na společnou akci, odpovídá českému „poďme“ nebo opisnému tvaru s „-me“.",
                        "tr": "Ortak bir eylemi teşvik etmek için kullanılır, Türkçedeki '-alım/-elim' ekine karşılık gelir.",
                        "es": "Se utiliza para incitar a una acción conjunta, equivalente al \"let's\" en inglés."
                    },
