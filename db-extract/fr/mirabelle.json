                                                "sense_id": "f6d7281e-2cb6-3279-af5a-c35873b90a46",
                                                "text": "Wir haben zwei Zwetschgenbäume und eine Mirabelle im Garten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "31455ef6-3d71-3675-9838-9d05c892ba89",
                                        "entry_id": "a091b0bf-ff7e-397d-9378-b61b6862b4df",
                                        "glosses": [
                                            "süße Frucht von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cba7998-770e-4904-8b67-33331e666bc0",
                                                "sense_id": "31455ef6-3d71-3675-9838-9d05c892ba89",
                                                "text": "Mirabellen kann man roh essen oder zu Marmelade oder Schnaps weiterverarbeiten."
                                            },
                                            {
                                                "example_id": "920504d0-cc02-4d37-9b82-ac96d803a3ba",
                                                "sense_id": "31455ef6-3d71-3675-9838-9d05c892ba89",
                                                "text": "„Die Schoten und Möhren, die Mirabellen und Äpfel ziehen uns unwiderstehlich an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
