    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba34a62d-cfe2-3199-9b6b-2bac675419f4",
                    "sense_definition": "Een gedroogde, pitloze druif van een klein druivenras.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er moesten eigenlijk <w>krenten</w> door de cake, maar ik heb er rozijnen in gedaan.",
                            "target_lang_translations": {
                                "en": "There were supposed to be <w>currants</w> in the cake, but I used raisins instead."
                            }
                        },
                        {
                            "text": "De bakker verkoopt heerlijk krentenbrood met veel <w>krenten</w> erin.",
                            "target_lang_translations": {
                                "en": "The bakery sells delicious currant bread with lots of <w>currants</w> in it."
                            }
                        }
                    ],
                    "common_phrases": [
                        "krenten in de pap"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, dried, seedless grape."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "currant",
                                "target_lang_sense_clarification": "A small dried grape, often used in baking."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9077cc46-933c-3e2a-8715-d660f67254ba",
                    "sense_definition": "Een persoon die erg zuinig is en liever geen geld uitgeeft.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>krent</w> wilde niet eens fooi geven aan de ober.",
                            "target_lang_translations": {
                                "en": "That <w>skinflint</w> wouldn't even tip the waiter."
                            }
                        },
                        {
                            "text": "Wees geen <w>krent</w> en koop gewoon een fatsoenlijk cadeau voor haar verjaardag.",
                            "target_lang_translations": {
                                "en": "Don't be a <w>miser</w> and just buy a decent gift for her birthday."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is very stingy and prefers not to spend money."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "skinflint",
                                "target_lang_sense_clarification": "A person who is excessively stingy with money."
                            },
                            {
                                "target_lang_word": "miser",
                                "target_lang_sense_clarification": "A person who hoards money and avoids spending it."
                            },
                            {
                                "target_lang_word": "tightwad",
                                "target_lang_sense_clarification": "Informal term for someone who is unwilling to spend money."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac0a575e-2b85-3df0-a266-537b5251fa24",
                    "sense_definition": "Het achterwerk van een mens.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lichaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bleef de hele dag op zijn <w>krent</w> zitten in plaats van te werken.",
                            "target_lang_translations": {
                                "en": "He sat on his <w>butt</w> all day instead of working."
                            }
                        },
                        {
                            "text": "Kom van je <w>krent</w> af en help ons even in de tuin.",
                            "target_lang_translations": {
                                "en": "Get off your <w>bum</w> and help us in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "kont"
                    ],
                    "common_phrases": [
                        "op je krent zitten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en enigszins plat"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person's buttocks."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "butt",
                                "target_lang_sense_clarification": "Informal term for buttocks."
                            },
                            {
                                "target_lang_word": "bum",
                                "target_lang_sense_clarification": "Informal, often Commonwealth English term for buttocks."
                            },
                            {
                                "target_lang_word": "backside",
                                "target_lang_sense_clarification": "A polite or euphemistic term for buttocks."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "08cb8c6d-e619-3a24-9cd1-0bd227b2d274",
                    "sense_definition": "Enkelvoud tegenwoordige tijd van <w>krenten</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tuinman <w>krent</w> de druiven om grotere vruchten te krijgen.",
                            "target_lang_translations": {
                                "en": "The gardener <w>thins out</w> the grapes to get larger fruit."
                            }
                        },
                        {
                            "text": "Hij <w>krent</w> de trossen zorgvuldig in de kas.",
                            "target_lang_translations": {
                                "en": "He carefully <w>thins out</w> the bunches in the greenhouse."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Third-person singular present tense of the verb 'to thin out' or 'to remove small/excess grapes from a bunch'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thins out",
                                "target_lang_sense_clarification": "To remove excess fruit to allow the remaining ones to grow larger."
                            }
                        ]
                    }
                }
            ]
        }
    ]
