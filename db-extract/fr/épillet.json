                "entry_id": "b87ad519-6833-3719-97ac-c6cee8cf5eea",
                "word": "épillet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6f8f54ab-45ef-417e-ac22-ce4890b60382",
                        "entry_id": "b87ad519-6833-3719-97ac-c6cee8cf5eea",
                        "tags": [
                            "plural"
                        ],
