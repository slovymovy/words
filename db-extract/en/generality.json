                                "sense_id": "d0292dc8-9260-33a7-9e98-1b9a4f500438",
                                "text": "Enough of the generalities. Give me the specifics."
                            },
                            {
                                "example_id": "0aa7e24d-e428-4c4d-aa7b-700964fc3e03",
                                "sense_id": "d0292dc8-9260-33a7-9e98-1b9a4f500438",
                                "text": "She spoke only in generalities. There's no definite commitment."
                            }
