                "senses": [
                    {
                        "sense_id": "6551fcff-5837-325b-b2c0-735dbe439faa",
                        "entry_id": "af6bafe6-8e03-3c21-b058-4447a4430f78",
                        "glosses": [
                            "Kolonie im Süden Afrikas, die zuerst den Niederlanden und später Großbritannien gehörte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e767d048-839d-4dc9-9161-634cf87ad9d5",
                                "sense_id": "6551fcff-5837-325b-b2c0-735dbe439faa",
                                "text": "„1687/88 wurde die Siedlerschaft der Kapkolonie um etwa 225 Hugenotten ergänzt, die Frankreich nach der Aufhebung des Edikts von Nantes 1685 verlassen hatten.“"
                            },
                            {
                                "example_id": "46c26155-da5d-4e4e-beae-273881eb7e41",
                                "sense_id": "6551fcff-5837-325b-b2c0-735dbe439faa",
                                "text": "„Zudem gehen sie davon aus, dass die Buren-Republiken von der wesentlich größeren Kapkolonie wirtschaftlich abhängig sind.“"
                            },
                            {
                                "example_id": "58acc9c5-753e-47c0-a55c-dcb536007b5b",
                                "sense_id": "6551fcff-5837-325b-b2c0-735dbe439faa",
                                "text": "„1867 wurden in einer abgelegenen Region nördlich der Kapkolonie reichhaltige Diamantenvorkommen entdeckt, die rasch Diamantenschürfer, Glücksritter und Spekulanten aus der ganzen westlichen Welt anlockten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
