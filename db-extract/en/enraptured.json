                        "target_lang_word": "wonnetrunken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wonnetrunken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7e12ba9-79bd-3c83-ae89-658a99ab4106",
                                        "entry_id": "41a42e9e-cfb1-3080-ac3a-6e2b4e20dd88",
                                        "glosses": [
                                            "voller Wonne, Glück; von Glückseligkeit und Wonne erfüllt"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b27c897-02db-46ca-a752-f1b1ee9ddd19",
                                                "sense_id": "c7e12ba9-79bd-3c83-ae89-658a99ab4106",
                                                "text": "Wonnetrunken kehrte ich von meiner Reise zurück."
                                            },
                                            {
                                                "example_id": "88f00a66-2ad8-4f77-a570-7f7b5399c350",
                                                "sense_id": "c7e12ba9-79bd-3c83-ae89-658a99ab4106",
                                                "text": "Wenn ich als Mann es nicht wegen nachlassender Standfestigkeit scheuen würde, wäre auch ich öfters bei unseren Liebesstunden ‚wonnetrunkener‘ dabei!"
                                            },
                                            {
                                                "example_id": "d4f69aa3-229f-489b-84be-ec3b79c44503",
                                                "sense_id": "c7e12ba9-79bd-3c83-ae89-658a99ab4106",
                                                "text": "Weit hinaus strömten ihm die Stuttgardter entgegen; bei seinem Anblick brach das wonnetrunkenste Jubelgeschrei los, Lorbeerkränze wurden ihm in den Wagen geworfen, und tausend Segnungen und Wünsche folgten demselben nach."
                                            },
                                            {
                                                "example_id": "1a457809-1714-4689-9344-5939acada7de",
                                                "sense_id": "c7e12ba9-79bd-3c83-ae89-658a99ab4106",
                                                "text": "Das Geheimniß des Abendmahls ist das Geheimniß des Glaubens - daher der Genuß desselben der höchste, entzückendste, wonnentrunkenste Moment des gläubigen Gemüths."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
