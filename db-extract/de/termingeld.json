                "senses": [
                    {
                        "sense_id": "a2fc9ca9-042c-3bfd-8e51-d00209e2205d",
                        "entry_id": "2699b936-0b2e-3018-9f12-0daf40f8e867",
                        "glosses": [
                            "für eine befristete Zeit angelegte Geldanlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2782568d-4704-43d8-873b-1a2770110463",
                                "sense_id": "a2fc9ca9-042c-3bfd-8e51-d00209e2205d",
                                "text": "„Während bei klassischen Anlageformen, wie Tagesgeld oder Termingeld derzeit kaum Renditen von mehr als 0,5 Prozent je Jahr erzielt werden können, bietet eine ausgewogene Anlage in den Kapitalmarkt zumindest auf eine Sicht von mehr als mindestens fünf Jahren jährliche Renditechancen von mindestens fünf Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c123400-aa79-4f17-84b9-d61e9512e781",
                        "source_entry_id": "2699b936-0b2e-3018-9f12-0daf40f8e867",
                        "source_sense_id": "a2fc9ca9-042c-3bfd-8e51-d00209e2205d",
                        "source_sense_description": "für eine befristete Zeit angelegte Geldanlage",
                        "target_lang_word": "deposit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deposit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d4202a-1b88-359c-b1b6-ebc6ac857218",
                                        "entry_id": "fec05f32-1546-34c8-b8ae-726d5e4893b4",
                                        "glosses": [
                                            "Sediment or rock that is not native to its present location or is different from the surrounding material. Sometimes refers to ore or gems."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79de5b0c-f006-460c-8f0c-1b834db200ee",
                                                "sense_id": "a6d4202a-1b88-359c-b1b6-ebc6ac857218",
                                                "text": "Newly discovered oil and gas deposits at Nan-ch'ung in Szechwan also promise to be of increasing importance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebb7061e-417b-36d0-80c2-fdda92189f20",
                                        "entry_id": "fec05f32-1546-34c8-b8ae-726d5e4893b4",
                                        "glosses": [
                                            "Bailment of personal property to be kept gratuitously for the bailor (depositor) and without any benefit to the bailee (depositary), e.g. for storage, carriage, repair, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0f7e27b-e78e-3f7b-82f4-5856bc1a77cc",
                                        "entry_id": "fec05f32-1546-34c8-b8ae-726d5e4893b4",
                                        "glosses": [
                                            "Money placed in a bank account, as for safekeeping or to earn interest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35a3d46a-1cfb-3a54-aa46-acc02d8a674c",
                                        "entry_id": "fec05f32-1546-34c8-b8ae-726d5e4893b4",
                                        "glosses": [
                                            "Anything left behind on a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97bab305-0cc5-464d-986c-1595452339cc",
                                                "sense_id": "35a3d46a-1cfb-3a54-aa46-acc02d8a674c",
                                                "text": "a mineral deposit"
                                            },
                                            {
                                                "example_id": "97ff2b9d-89d4-4eaa-ae24-30459f26d43f",
                                                "sense_id": "35a3d46a-1cfb-3a54-aa46-acc02d8a674c",
                                                "text": "a deposit of seaweed on the shore"
                                            },
                                            {
                                                "example_id": "218d42a1-cee9-4ed0-8db1-dbe57ed1aa0a",
                                                "sense_id": "35a3d46a-1cfb-3a54-aa46-acc02d8a674c",
                                                "text": "a deposit of jam on my countertop"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af47f212-3dc7-3b5c-a2e1-dc66c0b8ea15",
                                        "entry_id": "fec05f32-1546-34c8-b8ae-726d5e4893b4",
                                        "glosses": [
                                            "A sum of money or other asset given as an initial payment, to show good faith, or to reserve something for purchase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "200b930c-7e77-45ed-8d8f-b796a4bcafa6",
                                                "sense_id": "af47f212-3dc7-3b5c-a2e1-dc66c0b8ea15",
                                                "text": "They put down a deposit on the apartment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0898682-0f3a-3bf4-a4e2-0f3eb52fa835",
                                        "entry_id": "fec05f32-1546-34c8-b8ae-726d5e4893b4",
                                        "glosses": [
                                            "A sum of money given as a security for a borrowed item, which will be given back when the item is returned, e.g. a bottle deposit or can deposit"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dfb1097-e33b-37d1-ad67-b5eaa2949332",
                                        "entry_id": "fec05f32-1546-34c8-b8ae-726d5e4893b4",
                                        "glosses": [
                                            "A place of deposit; a depository."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "deposit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c2c7c9e-240e-3736-8695-eb1c3f14b4a2",
                                        "entry_id": "588047e9-78a5-3fe6-bf32-4ea80cc07ae7",
                                        "glosses": [
                                            "To lay down; to place; to put."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b61ba96-45d8-40b9-940d-18cf80e88c5a",
                                                "sense_id": "4c2c7c9e-240e-3736-8695-eb1c3f14b4a2",
                                                "text": "A crocodile deposits her eggs in the sand."
                                            },
                                            {
                                                "example_id": "be6e8faf-cb17-469c-9c6d-220a05242edf",
                                                "sense_id": "4c2c7c9e-240e-3736-8695-eb1c3f14b4a2",
                                                "text": "The waters deposited a rich alluvium."
                                            },
                                            {
                                                "example_id": "a7f0f355-5ba2-4631-9f95-59f86e72a473",
                                                "sense_id": "4c2c7c9e-240e-3736-8695-eb1c3f14b4a2",
                                                "text": "This fear is deposited in conscience."
                                            },
                                            {
                                                "example_id": "b0fcac50-3ecf-4150-b739-c5df637db3d6",
                                                "sense_id": "4c2c7c9e-240e-3736-8695-eb1c3f14b4a2",
                                                "text": "The lights of Luluabourg disappeared, and we were in the blackness of the African night, which was continuously pierced by the showers of red sparks ejected skywards and red hot ashes deposited on the track as the fireman rocked his fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f94cdbb-64ae-3abc-a821-1aebb3c3a908",
                                        "entry_id": "588047e9-78a5-3fe6-bf32-4ea80cc07ae7",
                                        "glosses": [
                                            "To lay up or away for safekeeping; to put up; to store."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97548636-08fd-4c30-aa20-a4520e56cb77",
                                                "sense_id": "1f94cdbb-64ae-3abc-a821-1aebb3c3a908",
                                                "text": "to deposit goods in a warehouse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d14e0346-95ea-3eb4-a006-59ce4703384e",
                                        "entry_id": "588047e9-78a5-3fe6-bf32-4ea80cc07ae7",
                                        "glosses": [
                                            "To entrust one's assets to the care of another. Sometimes done as collateral."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2696d276-071b-335e-8b98-7e72d686bb32",
                                        "entry_id": "588047e9-78a5-3fe6-bf32-4ea80cc07ae7",
                                        "glosses": [
                                            "To put money or funds into an account."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3192222a-f412-453c-a024-7d49368ce40f",
                                                "sense_id": "2696d276-071b-335e-8b98-7e72d686bb32",
                                                "text": "I had to deposit two months' rent into my landlord's account before he gave me the keys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b701d749-9629-3bb7-a944-5e87b5716dd2",
