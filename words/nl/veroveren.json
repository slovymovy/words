    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9e24620-8a28-358a-aabe-30a02e96517e",
                    "sense_definition": "Een gebied, stad of vesting met geweld of strijd in bezit nemen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "military_conquest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten wisten de vijandelijke stad na een lange strijd te <w>veroveren</w>.",
                            "target_lang_translations": {
                                "ru": "Солдатам удалось <w>завоевать</w> вражеский город после долгой битвы.",
                                "en": "The soldiers managed to <w>capture</w> the enemy city after a long battle.",
                                "fr": "Les soldats ont réussi à <w>conquérir</w> la ville ennemie après un long combat."
                            }
                        },
                        {
                            "text": "In de geschiedenisles leerden we hoe de Romeinen grote gebieden <w>veroverden</w>.",
                            "target_lang_translations": {
                                "ru": "На уроке истории мы узнали, как римляне <w>завоёвывали</w> обширные территории.",
                                "en": "In history class we learned how the Romans <w>conquered</w> large territories.",
                                "fr": "Pendant le cours d'histoire, nous avons appris comment les Romains <w>conquéraient</w> de vastes territoires."
                            }
                        }
                    ],
                    "synonyms": [
                        "innemen",
                        "bezetten"
                    ],
                    "antonyms": [
                        "verliezen",
                        "prijsgeven"
                    ],
                    "common_phrases": [
                        "een stad veroveren",
                        "land veroveren",
                        "het gebied veroveren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Захватить территорию, город или крепость с применением силы или в ходе борьбы.",
                        "en": "To take possession of an area, city, or fortress by force or battle.",
                        "fr": "Prendre possession d'une région, d'une ville ou d'une forteresse par la force ou par le combat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завоевать",
                                "target_lang_sense_clarification": "территорию, страну"
                            },
                            {
                                "target_lang_word": "захватить",
                                "target_lang_sense_clarification": "взять под контроль силой"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "conquer",
                                "target_lang_sense_clarification": "territory, land"
                            },
                            {
                                "target_lang_word": "capture",
                                "target_lang_sense_clarification": "city, fortress"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "control by force"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "conquérir",
                                "target_lang_sense_clarification": "un territoire, un pays"
                            },
                            {
                                "target_lang_word": "capturer",
                                "target_lang_sense_clarification": "une ville, une forteresse"
                            },
                            {
                                "target_lang_word": "prendre",
                                "target_lang_sense_clarification": "par la force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ba55fe9-a168-37c9-a607-9ba10871d88b",
                    "sense_definition": "Iets verkrijgen, winnen of voor zich winnen door er moeite voor te doen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met zijn charme en humor wist hij haar hart snel te <w>veroveren</w>.",
                            "target_lang_translations": {
                                "ru": "Своим обаянием и юмором он сумел быстро <w>завоевать</w> её сердце.",
                                "en": "With his charm and humor, he managed to quickly <w>win</w> her heart.",
                                "fr": "Grâce à son charme et son humour, il a su rapidement <w>conquérir</w> son cœur."
                            }
                        },
                        {
                            "text": "Het nieuwe product heeft in korte tijd de hele markt <w>veroverd</w>.",
                            "target_lang_translations": {
                                "ru": "Новый продукт за короткое время <w>завоевал</w> весь рынок.",
                                "en": "The new product has <w>conquered</w> the entire market in a short time.",
                                "fr": "Le nouveau produit a <w>conquis</w> l'ensemble du marché en peu de temps."
                            }
                        }
                    ],
                    "synonyms": [
                        "winnen",
                        "bemachtigen",
                        "binnenslepen"
                    ],
                    "antonyms": [
                        "verliezen"
                    ],
                    "common_phrases": [
                        "een hart veroveren",
                        "een plaats veroveren",
                        "de markt veroveren",
                        "goud veroveren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить что-либо, выиграть или добиться чьего-либо расположения благодаря усилиям.",
                        "en": "To obtain something, win, or gain someone's favor through effort.",
                        "fr": "Obtenir quelque chose, gagner ou séduire à force d'efforts."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завоевать",
