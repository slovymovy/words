                ],
                "translations": [
                    {
                        "translation_id": "f4da8855-ae46-493b-9b46-42af5a86a34c",
                        "source_entry_id": "be004e4f-f2a7-3d9c-8b5c-f6e6d7946eb7",
                        "source_sense_id": "10c65a33-ecc5-35b2-8667-e223d23d3bb4",
                        "source_sense_description": "gehoben: Zustand, von der Wirklichkeit losgelöst zu sein; Abstraktheit",
                        "target_lang_word": "Abstraktheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ef40ebee-bcd5-4681-b3cc-96ddab033a10",
                        "source_entry_id": "be004e4f-f2a7-3d9c-8b5c-f6e6d7946eb7",
                        "source_sense_id": "c27684bb-0385-3088-badd-96299e001bea",
                        "source_sense_description": "gehoben: Realitätsferne",
                        "target_lang_word": "Realitätsferne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Realitätsferne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f58ed5a3-c118-3471-a9a5-2afc8cdb0301",
                                        "entry_id": "a42e3273-fcd4-3c40-bd05-46f4d7e963d3",
                                        "glosses": [
                                            "Eigenschaft, die Wirklichkeit, die wahren Gegebenheiten nicht zu berücksichtigen oder wahrzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24f2af9e-22e1-44c3-9796-5e1749fd64c3",
                                                "sense_id": "f58ed5a3-c118-3471-a9a5-2afc8cdb0301",
                                                "text": "„Der größte Kritikpunkt, dem sich die Normativität zu stellen hat, ist jener der möglichen Realitätsferne.“"
                                            },
                                            {
                                                "example_id": "429591f3-b127-4054-b3c5-f5a3bd9b8eb5",
                                                "sense_id": "f58ed5a3-c118-3471-a9a5-2afc8cdb0301",
                                                "text": "„Gemeinsames Merkmal der Ästhetik der Gewalt ist ihre undurchschaute Triebabhängigkeit – die Regressionstendenz, der Archaismus – und ihre der Projektionsneigung verdankte Realitätsferne.“"
                                            },
                                            {
                                                "example_id": "a86c8eda-10d2-44c6-9629-996d355766da",
                                                "sense_id": "f58ed5a3-c118-3471-a9a5-2afc8cdb0301",
                                                "text": "„In der Praxis der Parlamente spiegeln sich jedoch Realitätsferne und wachsende Distanz der Repräsentanten zu den Repräsentierten.“"
                                            },
                                            {
                                                "example_id": "7aa7886a-08d2-4d4e-a201-3eeb533da286",
                                                "sense_id": "f58ed5a3-c118-3471-a9a5-2afc8cdb0301",
                                                "text": "„Die Realitätsferne sollen diese Zeichen auch weit weniger andeuten als vielmehr, daß die Aussage vor der Realisierung steht, teilweise auch, daß die Realisierung gewollt oder gewünscht ist.“"
                                            },
                                            {
                                                "example_id": "679de794-b941-45ab-be7e-a268dbf7f774",
                                                "sense_id": "f58ed5a3-c118-3471-a9a5-2afc8cdb0301",
                                                "text": "„Durch die Tatsache, daß ein real stattfindender Handel mit reinen Wertpapieren keine Modellvoraussetzung ist, wird der Einwand der Realitätsferne abgemildert.“"
                                            },
                                            {
                                                "example_id": "97ec997c-4c4f-4d05-a4c3-c2d4ae0fe390",
                                                "sense_id": "f58ed5a3-c118-3471-a9a5-2afc8cdb0301",
                                                "text": "„Die häufig geäußerte Kritik an der Realitätsferne der Gleichgewichtstheorie trifft dabei allenfalls teilweise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
