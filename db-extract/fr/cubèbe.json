                ],
                "senses": [
                    {
                        "sense_id": "a703a332-0d87-3307-8672-6e7b786c984c",
                        "entry_id": "3597d2c7-40f6-3435-9920-3106202f235f",
                        "glosses": [
                            "Nom vulgaire de Piper cubeba, arbre des Indes, ses fruits séchés sont utilisées en cuisine comme épice et on en extrait une huile essentielle contenant de la cubébine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9f8f6d2-91cc-4cdd-bdad-36901bf5e513",
                                "sense_id": "a703a332-0d87-3307-8672-6e7b786c984c",
                                "text": "Le cubèbe est cultivé à grande échelle en Indonésie, au Sri Lanka, souvent dans des plantations de café."
                            }
                        ]
                    },
                    {
                        "sense_id": "f34c2917-adcc-3ca6-9ca3-5623f89dde65",
                        "entry_id": "3597d2c7-40f6-3435-9920-3106202f235f",
                        "glosses": [
                            "Fruit de cet arbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd98baea-0722-4009-bf60-73de15b8e346",
                                "sense_id": "f34c2917-adcc-3ca6-9ca3-5623f89dde65",
                                "text": "Maudit soit de moi (...) ! Ma poitrine est plus brûlante que si j'avais avalé du cubèbe et du piment."
                            },
                            {
                                "example_id": "d2dabd72-5258-4275-824d-7ae3c66bd446",
                                "sense_id": "f34c2917-adcc-3ca6-9ca3-5623f89dde65",
                                "text": "Même à travers la cloison je sentais légèrement l'odeur de marijuana, un peu comme du cubèbe."
                            },
                            {
                                "example_id": "da6ca1f7-0aa6-492e-97ab-b57e2e3deed2",
                                "sense_id": "f34c2917-adcc-3ca6-9ca3-5623f89dde65",
                                "text": "Autrefois nos ancêtres employaient […] le carvi qui remplace l’anis…, et combien d’autres épices encore, comme le cubèbe, ou le sumac."
                            }
                        ]
                    }
                ],
                "translations": [
