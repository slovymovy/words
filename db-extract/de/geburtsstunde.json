                "senses": [
                    {
                        "sense_id": "49ef6430-f87d-3033-b6e3-a7a75ef2ce96",
                        "entry_id": "179a9903-1af2-3f04-b225-35727f317696",
                        "glosses": [
                            "Zeitpunkt, zu dem ein Kind geboren wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824509e4-cc23-4ae6-9383-523dd8542f33",
                                "sense_id": "49ef6430-f87d-3033-b6e3-a7a75ef2ce96",
                                "text": "Wenn du deine Geburtsstunde weißt, kann ich dir ein Horoskop erstellen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b7cf67d2-8f39-3cd3-9f57-3deb66d1f7ac",
                        "entry_id": "179a9903-1af2-3f04-b225-35727f317696",
                        "glosses": [
                            "Zeitpunkt, zu dem etwas begonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc1d8383-8805-4d32-99aa-4137b3d1be11",
                                "sense_id": "b7cf67d2-8f39-3cd3-9f57-3deb66d1f7ac",
                                "text": "„Dies ist die Geburtsstunde des Sprachkritikers, die oft einen besorgten Sprachliebhaber zum eifernden Sprachkritikaster macht.“"
                            },
                            {
                                "example_id": "ad8ba7ca-2ef7-43b5-ba95-e5c7d21e292a",
                                "sense_id": "b7cf67d2-8f39-3cd3-9f57-3deb66d1f7ac",
                                "text": "„Der hatte 1884 mit anderen politischen Anführern die Souveränität Kameruns dem Kaiserreich übertragen – es war die Geburtsstunde der deutschen Kolonie Kamerun gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
