                "senses": [
                    {
                        "sense_id": "c0bc8f86-3d15-3cad-bac5-224d499ef27f",
                        "entry_id": "6f813783-9bf5-3103-9dcc-dfe3de83c34a",
                        "glosses": [
                            "Messgerät zum Nachweisen freier, bewegter Moleküle, Atome oder Elementarteilchen sowie zur Bestimmung ihrer Eigenschaften"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "12d5ba97-5973-4c40-bce0-a3250646d016",
                                "sense_id": "c0bc8f86-3d15-3cad-bac5-224d499ef27f",
                                "text": "„Die Blasenkammer ist ein Teilchendetektor, der die Spuren von geladenen Elementarteilchen und Hadronen sichtbar macht.“"
                            },
                            {
                                "example_id": "168be816-ef5b-42ef-bcb0-250409f99e64",
                                "sense_id": "c0bc8f86-3d15-3cad-bac5-224d499ef27f",
                                "text": "„Die insgesamt 28 Neutrinos mit Energien oberhalb von 30 Tera-Elektronenvolt (TeV) wurden vom IceCube-Detektor am Südpol eingefangen, dem größten Teilchendetektor der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
