                                        "examples": [
                                            {
                                                "example_id": "1b860186-59f4-4c1f-9b4e-ddd367500f4c",
                                                "sense_id": "745375cc-6b7f-3019-b8ee-40050032ceea",
                                                "text": "The pioneering Austrian composer Arnold Schönberg was the leading dodecaphonist."
                                            },
                                            {
                                                "example_id": "4681ef84-8d2e-466e-932c-1ac0244958e0",
                                                "sense_id": "745375cc-6b7f-3019-b8ee-40050032ceea",
