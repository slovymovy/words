                "senses": [
                    {
                        "sense_id": "32adecc5-acd0-324b-a010-28153e1626b2",
                        "entry_id": "bcb4c57d-dbc2-3fdc-b4db-07bca0801dee",
                        "glosses": [
                            "temple, sanctuary, hall."
                        ],
                        "tags": [
                            "Germanic"
                        ],
                        "examples": [
                            {
                                "example_id": "df02a7c8-9e21-4e22-b416-a9fc998be63e",
                                "sense_id": "32adecc5-acd0-324b-a010-28153e1626b2",
                                "text": "For each ten churches burned to ashes, one heathen hof is avenged."
                            },
                            {
                                "example_id": "76ad521a-535c-49a9-b689-f621edc9183f",
                                "sense_id": "32adecc5-acd0-324b-a010-28153e1626b2",
                                "text": "Asatruarfelagid lacks a central religious temple, or hof in Icelandic. Constructing a hof has been high on the members' wish list for many years."
                            },
                            {
                                "example_id": "b3ebacb1-d4e5-42c9-8c67-c6aeef83097e",
                                "sense_id": "32adecc5-acd0-324b-a010-28153e1626b2",
                                "text": "The Candidate for membership of Hof, Garth or Hearth shall hold an Armill, or he may touch an unsheathed Sword throughout the ceremony."
                            }
                        ]
                    }
                ],
