                                    {
                                        "sense_id": "f303d527-eb25-327e-944c-78efe697fac8",
                                        "entry_id": "2718c405-d6ec-3e26-88eb-b1c3970f7f09",
                                        "glosses": [
                                            "An annoying person or someone who is difficult to get along with."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
