                        "examples": [
                            {
                                "example_id": "3f1dbb96-95ca-412e-a377-92782f452da8",
                                "sense_id": "5b340e45-048e-30d4-bd26-20735b359f1f",
                                "text": "стоя́ть на ата́нде",
                                "translation": "to be the lookout man",
                                "english": "to be the lookout man"
                            },
                            {
                                "example_id": "f0538d01-4301-4895-bad5-b3d2f5994cda",
                                "sense_id": "5b340e45-048e-30d4-bd26-20735b359f1f",
                                "text": "На ата́нде стоя́л надёжный ма́лый из социа́льно опа́сных, мо́жно бы́ло не беспоко́иться и хорошо́ отдохну́ть душо́й у тако́го «итээ́ровского костерка́».",
                                "translation": "The lookout man was a reliable fellow belonging to the socially dangerous elements, so one could properly and fully relax without worry by this “correction labor camp bonfire”.",
                                "english": "The lookout man was a reliable fellow belonging to the socially dangerous elements, so one could properly and fully relax without worry by this “correction labor camp bonfire”."
                            }
                        ]
                    }
                ],
