                "senses": [
                    {
                        "sense_id": "728882d9-0a24-3a9a-b90b-2ac5aad7a998",
                        "entry_id": "79e51aea-11e0-3ec5-82b2-685b1c31a1be",
                        "glosses": [
                            "Donner un caractère hétérodoxe à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1501e76-212f-44fd-b465-e26dd52eabac",
                                "sense_id": "728882d9-0a24-3a9a-b90b-2ac5aad7a998",
                                "text": "Même si ses prises de positions l’ont quelque peu « hétérodoxisé » et donc marginalisé (plus d’obs), il sait encore se faire entendre."
                            },
                            {
                                "example_id": "46d115e9-f9c9-4a7e-8f4a-061a57025767",
                                "sense_id": "728882d9-0a24-3a9a-b90b-2ac5aad7a998",
                                "text": "Le surréalisme des années 1980 n’est pas celui de 1938 ; il s’est adapté, organisé, hétérodoxisé, et là a été sa grande force."
                            },
                            {
                                "example_id": "6ead9498-26d4-4c8d-9325-cb96b71e569b",
                                "sense_id": "728882d9-0a24-3a9a-b90b-2ac5aad7a998",
                                "text": "Mais finalement pour savoir si la Banque s’hétérodoxise, attendons un peu."
                            }
                        ]
                    }
