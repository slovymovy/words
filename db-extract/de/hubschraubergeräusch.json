                "senses": [
                    {
                        "sense_id": "239d1cb8-cfc7-3a70-a83e-9cf66ecb57ce",
                        "entry_id": "8552e43b-3233-306e-83ed-0ee69b7d5f65",
                        "glosses": [
                            "Geräusch, das von einem Hubschrauber ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f059c9-0a3e-4961-b36b-13d909a19fd8",
                                "sense_id": "239d1cb8-cfc7-3a70-a83e-9cf66ecb57ce",
                                "text": "„Wenn ein Film über die Zahnräder gelaufen ist, scheint das Licht der Lampe durch die Tonspur, und statt Dialogen dröhnt dir ein Hubschraubergeräusch entgegen, Whop, Whop, Whop, jedesmal wenn das Licht durch ein Zahnradloch bricht.“"
                            },
                            {
                                "example_id": "e66bb824-86ff-4693-abba-bba29dd120af",
                                "sense_id": "239d1cb8-cfc7-3a70-a83e-9cf66ecb57ce",
                                "text": "„Sie erreichten die Baumreihe am Nordrand und setzten in deren Schutz ihren Weg nach Westen fort, wobei Court immer wieder nach den Hubschraubergeräuschen lauschte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
