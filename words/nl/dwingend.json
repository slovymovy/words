                        "dwingend advies",
                        "dwingende toon"
                    ],
                    "target_lang_definitions": {
                        "en": "Imposed with emphasis or force, leaving no room for refusal or contradiction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "compelling",
                                "target_lang_sense_clarification": "demanding attention or obedience"
                            },
                            {
                                "target_lang_word": "authoritative",
                                "target_lang_sense_clarification": "commanding and self-confident"
                            },
                            {
                                "target_lang_word": "imperious",
                                "target_lang_sense_clarification": "assuming power or authority without justification; arrogant and domineering"
