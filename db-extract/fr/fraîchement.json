                                            {
                                                "example_id": "6ed8844d-b858-4afe-bb96-01d2ce0feb14",
                                                "sense_id": "c03361f7-ef85-3b74-bc65-e02bdcaf2f45",
                                                "text": "The wind blew coolly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1594e351-bfb9-3d33-81b7-a792e4538a99",
                                        "entry_id": "249b66a7-7ff0-3e99-afeb-696d58cd4dea",
                                        "glosses": [
                                            "In a cool, unpanicked or collected manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b464a8-0787-4e11-854a-6d52375c1229",
                                                "sense_id": "1594e351-bfb9-3d33-81b7-a792e4538a99",
                                                "text": "\"He was here,\" observed Drina composedly, \"and father was angry with him.\" ¶ \"What?\" exclaimed Eileen. \"When?\" ¶ \"This morning, before father went downtown.\" ¶ Both Selwyn and Lansing cut in coolly, dismissing the matter with a careless word or two; and coffee was served—cambric tea in Drina's case."
                                            },
                                            {
                                                "example_id": "c7bb2c15-9bdf-43f2-875b-8689cae2fff9",
                                                "sense_id": "1594e351-bfb9-3d33-81b7-a792e4538a99",
                                                "text": "Graham secured victory with five minutes left, coolly lifting the ball over Asmir Begovic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b7de3f3-0193-38f5-8979-280819832dc2",
                                        "entry_id": "249b66a7-7ff0-3e99-afeb-696d58cd4dea",
                                        "glosses": [
                                            "With calm impudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "740b8796-8a29-496a-85dd-5195958015e3",
                                                "sense_id": "4b7de3f3-0193-38f5-8979-280819832dc2",
                                                "text": "They walked in, not even wearing masks, and coolly robbed the bank of twelve thousand pounds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coolly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2f0e9d3-0680-3476-832b-2ad608ed3714",
                                        "entry_id": "4c136f8b-ccae-31c2-82f8-5ccaef96638d",
                                        "glosses": [
                                            "coolish; somewhat cool in temperature"
