                    {
                        "translation_id": "c7af47b7-3793-4178-b425-dea65e0fe087",
                        "source_entry_id": "5881320e-efe6-38b6-b97a-9e7bd08e1242",
                        "source_sense_id": "5a493958-4276-3353-b335-8f7356e0e8ac",
