                                        "entry_id": "f15e4085-23de-34a1-b460-4493e9c99b6d",
                                        "glosses": [
                                            "Jus extrait de la pomme utilisé comme boisson (soit directement, soit après avoir été concentré puis reconstitué par addition d’eau)."
                                        ],
                                        "tags": [
