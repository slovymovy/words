                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His persistent <w>pragmatism</w> in neighborhood disputes alienated many of his longtime friends."
                        },
                        {
                            "text": "She resented the continuous <w>pragmatism</w> of relatives who constantly offered unwanted advice."
