    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bbf7a25b-4503-3bea-9e65-254e31e68920",
                    "sense_definition": "Quitter un lieu précipitamment pour échapper à un danger, à une menace ou à une contrainte.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fuir_echapper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cambrioleur a aperçu la police et s'est <w>enfui</w> immédiatement par la fenêtre."
                        },
                        {
                            "text": "Dès qu'on a ouvert la cage, l'oiseau apeuré s'est <w>enfui</w> vers les arbres."
                        }
                    ],
                    "synonyms": [
                        "fuir",
                        "s'échapper",
                        "déguerpir"
                    ],
                    "antonyms": [
                        "rester",
                        "demeurer"
                    ],
                    "common_phrases": [
                        "s'enfuir à toutes jambes",
                        "s'enfuir en courant"
                    ]
                },
                {
                    "sense_id": "11337837-2d89-3754-a7d4-c55c47251955",
                    "sense_definition": "Passer rapidement, disparaître ou s'évanouir, en parlant du temps ou d'un sentiment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fuir_disparaitre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les douces années d'enfance s'<w>enfuient</w> toujours beaucoup trop vite à notre goût."
                        },
                        {
                            "text": "Toutes mes craintes et mes doutes d'hier s'<w>enfuient</w> enfin avec ce nouveau jour."
                        }
                    ],
                    "synonyms": [
                        "s'évanouir",
                        "disparaître",
                        "s'écouler"
                    ],
                    "common_phrases": [
                        "le temps s'enfuit"
                    ]
                },
                {
                    "sense_id": "dd1d7bac-aa60-38a2-ab9e-9cfb330f2fcc",
                    "sense_definition": "S'écouler hors d'un récipient ou d'un vase défectueux, en parlant d'un liquide.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fuir_liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais bien attention à la jarre fissurée, tout le vinaigre s'<w>enfuit</w> sur le sol."
                        },
                        {
                            "text": "Le tonneau était mal scellé et le vin s'est <w>enfui</w> goutte à goutte durant la nuit."
                        }
                    ],
                    "synonyms": [
                        "fuir",
                        "s'échapper",
                        "couler"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "au sens de fuir pour un liquide"
                        }
                    ]
                }
            ]
        }
    ]
}