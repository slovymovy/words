                                        "sense_id": "a03d319e-b40c-368d-acea-a48607be0e56",
                                        "entry_id": "4762cf4b-fbcd-3032-8f62-24c04bb33468",
                                        "glosses": [
                                            "в некоторых странах Азии — человек, который, впрягшись в лёгкую двухколёсную коляску, перевозит людей и грузы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b0ec753-0242-3f11-a67c-5fb34883efbe",
                                        "entry_id": "4762cf4b-fbcd-3032-8f62-24c04bb33468",
                                        "glosses": [
