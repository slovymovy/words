                "senses": [
                    {
                        "sense_id": "85ba9513-31e3-3aea-8dcb-e1a813ef3c5d",
                        "entry_id": "52cc2adf-cfff-3dfc-8ec9-ccb78958dbdd",
                        "glosses": [
                            "weitgehend unbekannter Aufenthaltsort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a40f589b-3054-4390-adc5-7531900f59f4",
                                "sense_id": "85ba9513-31e3-3aea-8dcb-e1a813ef3c5d",
                                "text": "„Weil er Angaben zum Verbleib der erlangten Bitcoins machte, kam er nach einem Monat Untersuchungshaft unter Auflagen wieder frei.“"
                            },
                            {
                                "example_id": "821ba0c1-b225-4e55-966d-9904b2fcc4ad",
                                "sense_id": "85ba9513-31e3-3aea-8dcb-e1a813ef3c5d",
                                "text": "„Murat ritt auf den Dolmetscher zu und befahl ihm, nach dem Verbleib der russischen Truppen zu fragen.“"
                            },
                            {
                                "example_id": "81b4e733-9a33-47db-9c4c-a7e873b14d15",
                                "sense_id": "85ba9513-31e3-3aea-8dcb-e1a813ef3c5d",
                                "text": "„Gerade wenn es um den Verbleib von U-Booten geht, werden sie im Pentagon schnell schmallippig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d25efa68-8a1a-39b6-8fa8-ad86c5b29532",
                        "entry_id": "52cc2adf-cfff-3dfc-8ec9-ccb78958dbdd",
                        "glosses": [
                            "das Sich-nicht-Entfernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "992d209a-9b3a-4e74-a726-a9685a516f1a",
                                "sense_id": "d25efa68-8a1a-39b6-8fa8-ad86c5b29532",
                                "text": "„Maßvolle, flexible und verständliche Tarifverträge, die einer sich ändernden Arbeitswelt gerecht werden, sind nötig, um Arbeitnehmer und Arbeitgeber zum Verbleib oder Eintritt in Gewerkschaften und Arbeitgeberverbände mit Tarifbindung zu animieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
