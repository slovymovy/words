                        ],
                        "examples": [
                            {
                                "example_id": "961f919c-4e89-4cb9-80a8-5b8bb0afbb3e",
                                "sense_id": "cd9cd941-2901-32c9-9965-3a0e8867b3be",
                                "text": "\"She'll be a match for poor little Cupid, with his tiny bow and arrow, I dare say,\" said Grace Fitzgerald, with a roguish eye."
                            },
                            {
                                "example_id": "5f0357c2-345b-4d07-88ce-47d89b0efb80",
                                "sense_id": "cd9cd941-2901-32c9-9965-3a0e8867b3be",
                                "text": "Back at the sauna, Mr. Pylhhänen gives a roguish grin and says he has found the answer to the “happiest country” debate – in a very Finnish way, of course."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c55d5f1-1b92-4d43-917d-f3054219ad01",
                        "source_entry_id": "603f836a-0dd1-35b8-a1cb-d32eab1ec115",
                        "source_sense_description": "unprincipled or unscrupulous",
