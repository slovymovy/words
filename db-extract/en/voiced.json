                    },
                    {
                        "translation_id": "9bdbf904-aa08-4c2f-a95e-6df44c93044b",
                        "source_entry_id": "9f8b8bf9-0819-3772-a256-3af3159f6e18",
                        "source_sense_description": "sounded with vibration of the vocal cords",
                        "target_lang_word": "stemhebbend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stemhebbend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "26d18ee9-e04e-3b36-9463-7a50e38e94dd",
                                        "entry_id": "137d8a14-2f95-39de-bc57-03b8ec2a66cc",
                                        "glosses": [
                                            "mogen stemmen bij een verkiezing of beslissing; invloed hebbend op beslissingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc3f52ca-7477-4862-ab09-c8080e924ca2",
                                                "sense_id": "26d18ee9-e04e-3b36-9463-7a50e38e94dd",
                                                "text": "Maar ondanks deze publicitaire hoogtepunten duurde het toch nog dertig jaar voordat het walvissenmoratorium er was. Stemhebbende landen in het IWC, en dan vooral Nederland, weigerden de geopperde vangstquotum te accepteren. Ook voor Nederland, dat begin jaren zestig met de Willem Barendsz II een gloednieuwe walvisfabrieksschip had gebouwd, waren de commerciële belangen te groot."
                                            },
                                            {
                                                "example_id": "c85effa6-5835-47e2-937d-ba705c65791a",
                                                "sense_id": "26d18ee9-e04e-3b36-9463-7a50e38e94dd",
                                                "text": "Goed toezicht en stabiele eigendomsverhoudingen zijn zeker belangrijk. De regels van de Bundesliga eisen dat ruim 50 procent van de stemhebbende aandelen in de betaaldvoetbalorganisatie in handen is van de club en haar leden."
                                            },
                                            {
                                                "example_id": "867f4deb-636f-4d65-893e-343a80ebee7f",
                                                "sense_id": "26d18ee9-e04e-3b36-9463-7a50e38e94dd",
                                                "text": "De cajas mogen stemhebbende aandelen uitgeven tot 50 procent van hun kapitaal, naast andere wijzigingen. De hervorming lijkt halfbakken en zal op de korte termijn wellicht geen baat brengen, maar het is een goede eerste stap."
                                            },
                                            {
                                                "example_id": "a1ca8538-421d-4c78-82fb-6932cefd2550",
                                                "sense_id": "26d18ee9-e04e-3b36-9463-7a50e38e94dd",
                                                "text": "Sinds de Verenigde Naties vorig jaar de staat Palestina toelieten als niet-stemhebbend lid, duidt een groeiend aantal Europese media het gebied niet meer aan als „Palestijnse gebieden”, maar kortweg als „Palestina”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58886903-5452-3378-be35-9446af88ecb0",
                                        "entry_id": "137d8a14-2f95-39de-bc57-03b8ec2a66cc",
                                        "glosses": [
                                            "klanken waarbij de stembanden meetrillen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eef2b72-05cb-45d6-9c49-01f77bace867",
                                                "sense_id": "58886903-5452-3378-be35-9446af88ecb0",
                                                "text": "Medeklinkers worden onder andere onderscheiden in stemloze en stemhebbende medeklinkers. Bij de vorming van stemhebbende medeklinkers trillen de stembanden mee; bij de vorming van stemloze medeklinkers niet. Het Nederlands kent de volgende stemloze medeklinkers: p, t, k, f, s, ch en h, en de volgende stemhebbende medeklinkers: b, d, v, z, g, m, n, ng, l, r, j en w."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b171b7f-cf7a-422a-831e-8028384fb06d",
                        "source_entry_id": "9f8b8bf9-0819-3772-a256-3af3159f6e18",
                        "source_sense_description": "sounded with vibration of the vocal cords",
                        "target_lang_word": "sonore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sonore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c786d30a-eb96-3062-bc17-6a767c2b181c",
                                        "entry_id": "9d5fd836-2b27-375e-a3cb-e3aa238521fc",
                                        "glosses": [
                                            "Qui rend un son."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd51ca8-105e-458d-94f3-c1e712a30f53",
                                                "sense_id": "c786d30a-eb96-3062-bc17-6a767c2b181c",
                                                "text": "A ces sources de richesses souterraines du département, on doit ajouter des mines de l’ardoise la plus serrée, la plus sonore et la plus pure qu'il y ait en France, à Fumay, à Folemprise, à Charnois et à Monthermé."
                                            },
                                            {
                                                "example_id": "51fbd1de-6f0a-4207-9278-85b2b92bb44a",
                                                "sense_id": "c786d30a-eb96-3062-bc17-6a767c2b181c",
                                                "text": "Tous les hommes, […], écoutaient nonchalamment, sans y prêter grande attention, un mauvais phonographe, aux accents métalliques. Du pavillon sonore sortaient des paroles qui serrèrent le cœur de Bert d’une angoisse nostalgique […]."
                                            },
                                            {
                                                "example_id": "db7aabd1-5745-4f58-b3d6-9f9489b8181b",
                                                "sense_id": "c786d30a-eb96-3062-bc17-6a767c2b181c",
                                                "text": "Les cris des coqs, les sabots des ânes poussés par l'encouragement sonore et monotone des paysans, réveillèrent Elhamy le lendemain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b91f7c63-5c3c-3f08-a647-6deb38ba4b74",
                                        "entry_id": "9d5fd836-2b27-375e-a3cb-e3aa238521fc",
                                        "glosses": [
                                            "Qui donne beaucoup de son, qui a un beau son."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15cbb3a9-8335-439b-bb77-d6c6d7cc67f1",
                                                "sense_id": "b91f7c63-5c3c-3f08-a647-6deb38ba4b74",
                                                "text": "Ma chair attentive sent ton approche, et ton pas sonore dans la nuit, vient battre dans tout mon être comme un autre cœur."
                                            },
                                            {
                                                "example_id": "6af6a79a-7377-4521-813f-bd6ee4169d39",
                                                "sense_id": "b91f7c63-5c3c-3f08-a647-6deb38ba4b74",
                                                "text": "Deux escaliers, sous un maigre lumignon, plongent aussitôt vers un sous-sol d'où la musique sonore et nasillarde de l'accordéon monte avec des accords de banjo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d5554c2-cc87-38fd-b405-e9481d432fd3",
                                        "entry_id": "9d5fd836-2b27-375e-a3cb-e3aa238521fc",
                                        "glosses": [
                                            "Qui renvoie bien le son, où le son résonne bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47cc0352-3204-4ae5-a971-baeba0be76f3",
                                                "sense_id": "2d5554c2-cc87-38fd-b405-e9481d432fd3",
                                                "text": "Le vieillard et sa fille […] distinguèrent alors un bruit d'éperons et un cliquetis d'épées qui retentirent sous le sonore péristyle du château."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "606c980a-3804-3938-bb34-a77fdcd20a7c",
                                        "entry_id": "9d5fd836-2b27-375e-a3cb-e3aa238521fc",
                                        "glosses": [
                                            "Qui est mal isolé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d2d135d-a265-4b55-84f5-2fdfe5433f94",
                                                "sense_id": "606c980a-3804-3938-bb34-a77fdcd20a7c",
                                                "text": "Le palier était sombre, sonore. On entendait les bruits sourds de la maison comme les borborygmes d'un corps au repos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "179ba465-07e0-3d67-9b09-4f6b44baa491",
                                        "entry_id": "9d5fd836-2b27-375e-a3cb-e3aa238521fc",
                                        "glosses": [
                                            "Qui est relatif au son."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8b2589-e499-44a2-af30-fa06f31ddbac",
                                                "sense_id": "179ba465-07e0-3d67-9b09-4f6b44baa491",
                                                "text": "Le yé-yé désigne un genre, l'ensemble des exhibitions de mineurs ignares, exhibitions vocales ou instrumentales, individuelles ou collectives, caractérisées par leur outrance sonore et leur indigence d’expression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3e0f298-f8da-34ed-bd2d-a0984610279e",
                                        "entry_id": "9d5fd836-2b27-375e-a3cb-e3aa238521fc",
                                        "glosses": [
                                            "Se dit d’une consonne dont la prononciation s’accompagne d'une vibration des cordes vocales."
                                        ],
                                        "tags": [
                                            "Phonétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "567fec81-10fe-4048-abf2-76e84a489615",
                                                "sense_id": "b3e0f298-f8da-34ed-bd2d-a0984610279e",
                                                "text": "En français, les consonnes orales sonores sont \\b\\, \\d\\, \\ɡ\\, \\v\\ \\z\\, et \\ʒ\\ ; les autres sont dites sourdes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
