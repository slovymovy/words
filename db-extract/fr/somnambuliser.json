                "senses": [
                    {
                        "sense_id": "de55072d-e952-34cf-974e-835eb588ba75",
                        "entry_id": "d15c94fe-004b-35f4-b251-25df27d584b3",
                        "glosses": [
                            "Faire entrer dans un état de somnambulisme, hypnotiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d0887e2-6129-4d73-865a-c03e01263783",
                                "sense_id": "de55072d-e952-34cf-974e-835eb588ba75",
                                "text": "Mᵐᵉ Gouget, âgée d’une quarantaine d’années, ayant entendu parler du magnétisme, se fit somnambuliser par plusieurs personnes, dont la dernière, selon ce qu’elle me dit dans ses sommeils, l’avait totalement dérangée; je connaissais cette femme pour une très-bonne personne, et je fus désolé, un jour qu’elle vint me rendre visite, de l’entendre débiter une masse de faits qui me prouvèrent qu’elle était sous une très-mauvaise influence, et que sa raison, qui déjà en souffrait, y succomberait tôt ou tard."
                            },
                            {
                                "example_id": "a551002c-9341-4379-921d-06234436f538",
                                "sense_id": "de55072d-e952-34cf-974e-835eb588ba75",
                                "text": "Est-il possible de somnambuliser une personne épileptique dans la première opération ?"
                            }
                        ]
                    }
