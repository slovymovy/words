                                "target_senses": [
                                    {
                                        "sense_id": "581e3095-f604-3c57-a846-12e412719d38",
                                        "entry_id": "2ba9a44f-42e1-36f7-b177-60c2eba69997",
                                        "glosses": [
                                            "Lautäußerung eines Schafs oder einer Kuh"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "752902f6-39e3-4965-b8f4-50750a11c000",
                                                "sense_id": "581e3095-f604-3c57-a846-12e412719d38",
                                                "text": "„Ich höre sie nie bellen, aber das Blöken der Schafe dringt schwach durch die stille Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0dccd44-65ee-38f6-99ff-bfb04c261a3d",
