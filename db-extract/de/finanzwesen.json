                    {
                        "sense_id": "ae247757-d6bc-3c24-89cb-ccd78d018f65",
                        "entry_id": "f1f4630f-54f5-395d-ad52-7e471584c9d6",
                        "glosses": [
                            "Gesamtheit von allem, was Geld im weitesten Sinne betrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb6f2f1e-54fd-493f-819b-6802b23ec263",
                                "sense_id": "ae247757-d6bc-3c24-89cb-ccd78d018f65",
                                "text": "„Das französische Finanzwesen war zusammengebrochen.“"
                            },
                            {
                                "example_id": "8f3d5eeb-f82b-41a0-a383-957f8209d64b",
                                "sense_id": "ae247757-d6bc-3c24-89cb-ccd78d018f65",
                                "text": "„Ein Verwaltungsfachangestellter ist im Bereich Personalwesen, Organisation, Beschaffung, Finanzwesen und in der technischen Verwaltung tätig.“"
                            },
                            {
                                "example_id": "edc4f800-c96d-411a-b7ea-2e3edfc96830",
                                "sense_id": "ae247757-d6bc-3c24-89cb-ccd78d018f65",
                                "text": "„Tuchhandel, Bank- und Finanzwesen verhalfen der Stadt zu großem Wohlstand, und mit ihrer eigenen Goldmünze hatten die Florentiner faktisch das Verwaltungsmonopol der an die Kurie gezahlten Gelder inne.“"
                            }
                        ],
