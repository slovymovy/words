                                    {
                                        "sense_id": "b7aa762c-dd52-328a-b033-20f44bb93a82",
                                        "entry_id": "2103440c-1905-3cc7-bd3b-8a0bff1c6846",
                                        "glosses": [
                                            "A slightly yellowish gray colour, as that of unbleached wool."
