                                        "glosses": [
                                            "Espèce minérale du groupe des silicates sous groupe des sorosilicates, de formule Ca₂(Fe,Al)Al₂(SiO₄)(Si₂O₇)O(OH)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
