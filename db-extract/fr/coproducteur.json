                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3744d22a-3723-4d6b-8e57-abc9f81fe54a",
                                "sense_id": "d9867ab3-bdf1-3c41-9a40-a782792abcc2",
                                "text": "Déjà scénariste et réalisateur, il s’est promu coproducteur et a pu injecter des fonds supplémentaires dans le financement de son projet."
                            },
                            {
                                "example_id": "bb9de488-fb4d-4bd7-984f-8ada55d00e82",
                                "sense_id": "d9867ab3-bdf1-3c41-9a40-a782792abcc2",
                                "text": "Soigner avec les rétablis est bien plus que le recueil de témoignages lors d’un groupe de parole puisque les patients se rendent bien compte que les rétablis sont dans le soin et qu’eux-mêmes sont invités à devenir coproducteurs de leurs propres soins."
                            }
                        ]
                    }
