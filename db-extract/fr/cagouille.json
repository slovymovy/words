                "senses": [
                    {
                        "sense_id": "9ef1ed14-503b-3fbd-ac21-72c63f7e378e",
                        "entry_id": "1c2bd19c-c7dc-3a52-b071-d750e34a0168",
                        "glosses": [
                            "Escargot, dans les Charentes, le Périgord et le Bordelais, plus précisément le petit-gris (Helix aspersa aspersa)."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "58d279e5-9e48-46a2-9b8d-ee26c3e3b099",
                                "sense_id": "9ef1ed14-503b-3fbd-ac21-72c63f7e378e",
                                "text": "Mon père était originaire des Charentes, du pays des « cagouillards » comme il disait volontiers (la cagouille, c’est l’escargot qui rentre facilement dans sa coquille)"
                            },
                            {
                                "example_id": "635c3c8b-8162-4272-a6f4-20f97f380b06",
                                "sense_id": "9ef1ed14-503b-3fbd-ac21-72c63f7e378e",
                                "text": "Cagouille pour les Charentais ou escargot pour les autres (disons « petit gris » pour être précis), elle fait partie de la très nombreuse famille des mollusques."
                            },
                            {
                                "example_id": "2237a348-1b11-4d36-9743-ee002893fa42",
                                "sense_id": "9ef1ed14-503b-3fbd-ac21-72c63f7e378e",
                                "text": "Elle invite à partager cagouilles, moules, frites et autres gourmandises."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f34e0f6-b4a6-383d-be9d-c1ac1cb97601",
                        "entry_id": "1c2bd19c-c7dc-3a52-b071-d750e34a0168",
                        "glosses": [
                            "Volute qui servait d’ornement au haut de l’éperon d’un navire ^([1])."
