                ],
                "senses": [
                    {
                        "sense_id": "4abfb20a-e1fe-381e-b28d-597900a99535",
                        "entry_id": "60483291-c1dc-30c4-a896-33754bb0d414",
                        "glosses": [
                            "Utiliser la partie pré-frontale du cerveau pour réagir à une situation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1976e2bc-1a58-4135-9298-5fc040195ede",
                                "sense_id": "4abfb20a-e1fe-381e-b28d-597900a99535",
                                "text": "Qu´en pensons-nous vraiment lorsque nous réussissons à \"pré-frontaliser\" (pour reprendre les termes de l´Institut de Neuro-Management), c´est-à-dire à penser libérés de nos peurs inconscientes, de nos préjugés ?"
                            },
                            {
                                "example_id": "444680c3-d3cc-402c-b64c-b08f64de1424",
                                "sense_id": "4abfb20a-e1fe-381e-b28d-597900a99535",
                                "text": "C’est ce que nous aborderons dans le « Passeport pour le changement » (p.219), pour vous aider à « pré-frontaliser » la situation dans le cadre d’une intolérance aux kilos en trop."
                            },
                            {
                                "example_id": "a0a32716-996c-41fd-9140-8a7a030c2f65",
                                "sense_id": "4abfb20a-e1fe-381e-b28d-597900a99535",
                                "text": "Vous apprendrez aussi à reconnaître chez l’autre ce qui provoque un comportement inapproprié – déprime, colère, paralysie, dominance... - et à gérer votre communication dans l’instant pour l’amener en sérénité à pré-frontaliser lui aussi..."
                            }
                        ]
                    }
