                "senses": [
                    {
                        "sense_id": "8663c5ed-586f-3629-b83a-5fe5442bc296",
                        "entry_id": "8063091f-8245-35ff-a039-8bdff716f9ea",
                        "glosses": [
                            "устар. искусный, способный, ловкий, знающий, опытный на какое-либо дело, мастер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e23bcda2-bc15-4f40-a5d6-23eb37e42efa",
                                "sense_id": "8663c5ed-586f-3629-b83a-5fe5442bc296",
                                "text": "А один из нас, гораздый на выдумки Миша Марин, забрасывал редакцию предложениями, как повернуть лозунг кампании, чтобы он выглядел реалистичней."
                            },
                            {
                                "example_id": "0b3a41eb-aaf3-421b-8040-1fd16d496fb8",
                                "sense_id": "8663c5ed-586f-3629-b83a-5fe5442bc296",
                                "text": "Вижу, что ты парень гораздый да удалый."
                            },
                            {
                                "example_id": "ccda9e8a-fabf-4183-9cf5-48dd4c110a07",
                                "sense_id": "8663c5ed-586f-3629-b83a-5fe5442bc296",
                                "text": "В кого это ты, батюшка, уродился такой живчик, да на все гораздый?"
                            }
                        ]
                    }
                ],
