                        "examples": [
                            {
                                "example_id": "7aa38bef-531e-480f-8a1f-ccaa24eb606f",
                                "sense_id": "004d9922-97d4-3333-8cef-bbdfb19bddc6",
                                "text": "Georgina Verbaan en Patrick Martens zullen binnenkort samen te horen zijn in de nieuwe tekenfilm Rikkie de Ooievaar. Zij spreken de stemmen in van een dwerguiltje (Verbaan) en een vrolijke parkiet met hoogtevrees (Martens)."
                            },
                            {
                                "example_id": "ac844ace-9628-4e68-acdf-bbc73dbd9de0",
                                "sense_id": "004d9922-97d4-3333-8cef-bbdfb19bddc6",
                                "text": "Ongeveer tien jaar geleden werd de uil voor het eerst opgemerkt. Toen werd nog verondersteld dat het dier een Molukse dwerguil was. Na verder onderzoek hebben wetenschappers nu vastgesteld dat het wel degelijk om een nieuwe soort gaat. De nieuwe so ort heet Rinjani dwerguil, vernoemd na de grote vulkaan op het eiland."
                            }
                        ]
                    }
