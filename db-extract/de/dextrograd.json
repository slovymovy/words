                "senses": [
                    {
                        "sense_id": "5c228da3-a53b-3f30-b461-94fd4b7eed24",
                        "entry_id": "6173538c-1082-3ec6-905c-25b5819afbc1",
                        "glosses": [
                            "von links nach rechts geschrieben"
                        ],
                        "tags": [
                            "Typographie"
                        ],
                        "examples": [
                            {
                                "example_id": "15b8c86c-55b3-452d-84c4-87b7df50cd90",
                                "sense_id": "5c228da3-a53b-3f30-b461-94fd4b7eed24",
                                "text": "„Man kann Schriften anhand der Richtung, die ihnen beim Schreiben zugrunde liegt, unterscheiden, und zwar waagerechte in linksläufige (sinistrograd, zum Beispiel das Arabische und Hebräische), rechtsläufige (dextrograd, das Lateinische) und bustrophedone (zeilenweise wechselnd) Schriften, sowie senkrechte in abwärts (Schriften des chinesischen Kulturkreises, Mongolisch) und aufwärts (einige philippinische Schriften, historische Notation für Militärtrommel) geschriebene.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
