                        ],
                        "form": "den Körperteil"
                    },
                    {
                        "form_id": "1e3af0d5-ac00-4403-87be-7bd21ec6234e",
                        "entry_id": "dd1fbcd8-b248-3b42-9c46-41cd0ad43b7c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Körperteile"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d6ab2ba-c82a-3117-bde6-2db4bb5e8518",
                        "entry_id": "dd1fbcd8-b248-3b42-9c46-41cd0ad43b7c",
                        "glosses": [
                            "(morphologisch und funktionell abgegrenzter) Teil eines (tierlichen oder menschlichen) Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab23f4e-6329-4e62-8c12-364ba8956239",
                                "sense_id": "5d6ab2ba-c82a-3117-bde6-2db4bb5e8518",
                                "text": "„Der geübte Deltaflieger verwächst funktionstechnisch und erlebnismäßg so eng mit seinem Fluggerät, dass ihm der angelegte Flügel zu einer Art neuem Körperteil wird, dessen er sich wie eines verlängerten Arms oder einer gut sitzenden Prothese bedient.“"
                            },
                            {
                                "example_id": "b5b4375d-28b4-40db-b94b-858c9d5b6ff4",
                                "sense_id": "5d6ab2ba-c82a-3117-bde6-2db4bb5e8518",
                                "text": "Ein Bein ist ein Körperteil."
                            },
                            {
                                "example_id": "fdcc80e6-c0ce-4082-bb63-8076a0d645ec",
                                "sense_id": "5d6ab2ba-c82a-3117-bde6-2db4bb5e8518",
                                "text": "„Am auffälligsten sind endlose Tabellen mit Zahlen, die Auskunft über die Durchschnittswerte von kindlichen Körperteilen geben.“"
                            },
                            {
                                "example_id": "7dd3bfe9-090b-4277-a786-b7445319bd2a",
                                "sense_id": "5d6ab2ba-c82a-3117-bde6-2db4bb5e8518",
                                "text": "„Die Nachbildung glich einem abscheulichen Priapus, besonders in den Körperteilen, die diesen Gott kennzeichnen.“"
                            },
                            {
                                "example_id": "8d78bf45-4855-4cc6-be46-7ffa7d43a9fd",
                                "sense_id": "5d6ab2ba-c82a-3117-bde6-2db4bb5e8518",
                                "text": "„Jeden alten Körperteil hatte er bedeckt, und so erschien er als Mensch ohne Alter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
