    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "88056894-7ade-304a-87ca-7a849b8c0d39",
                "word": "vitrine",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0276f616-bf59-47ec-b33e-051a25d02899",
                        "entry_id": "88056894-7ade-304a-87ca-7a849b8c0d39",
                        "tags": [
                            "plural"
                        ],
                        "form": "vitrines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d73a067d-1125-30d3-800a-4258c8bc7c0f",
                        "entry_id": "88056894-7ade-304a-87ca-7a849b8c0d39",
                        "glosses": [
                            "A glass-paneled cabinet or case, especially for displaying articles such as china, objets d'art, or fine merchandise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d55cf78-47a6-417b-a5f1-806bcc639b10",
                                "sense_id": "d73a067d-1125-30d3-800a-4258c8bc7c0f",
                                "text": "Lastly, when great numbers of the plates are treated with the hot or boiling water, it should be done in a vitrine or cabinet ventilated directly into the open air."
                            },
                            {
                                "example_id": "f1bfba83-4a76-42ce-b7ef-4be279548538",
                                "sense_id": "d73a067d-1125-30d3-800a-4258c8bc7c0f",
                                "text": "The Princess offered us tea and wine, and we talked for a long time, and then she must show us her house, filled with tapestries, paintings and bibelots and, in a vitrine in a room upstairs, a wonderful collection of fans painted by Carlo van Loo[…]"
                            },
                            {
                                "example_id": "e9fdb664-aec8-464f-a672-8917df804b93",
                                "sense_id": "d73a067d-1125-30d3-800a-4258c8bc7c0f",
                                "text": "Checking behind him nervously, the dealer was trying to concentrate on showing Bouck some small art-glass pieces in a vitrine in the middle of the booth."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e0899d7-216f-49d5-ad44-b61311380ff7",
                        "source_entry_id": "88056894-7ade-304a-87ca-7a849b8c0d39",
                        "source_sense_id": "d73a067d-1125-30d3-800a-4258c8bc7c0f",
