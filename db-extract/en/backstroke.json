                        "entry_id": "07721057-a2b8-3582-9e1d-9cbb52ff6d85",
                        "glosses": [
                            "A backhanded stroke or blow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27e4ca80-fc5d-453b-831d-6fb67444eae4",
                                "sense_id": "5578bb8c-fe8f-3944-a488-d5e2484c8707",
                                "text": "He observed that Cid Ruy-dias was an excellent knight; but not equal to the Lord of the Flaming-sword, who with one back-stroke [translating revés] had cut two fierce and monstrous giants through the middle."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc375bbe-a655-35a7-9f11-a6465344878f",
                        "entry_id": "07721057-a2b8-3582-9e1d-9cbb52ff6d85",
                        "glosses": [
                            "A stroke swum lying on one's back, while rotating both arms through the water as to propel the swimmer backwards."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dbea1704-8c68-3811-b628-feaf9dbbb19a",
                        "entry_id": "07721057-a2b8-3582-9e1d-9cbb52ff6d85",
                        "glosses": [
                            "The pull on the tail of the rope that swings the bell through a full circle (compare handstroke)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
