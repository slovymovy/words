                "senses": [
                    {
                        "sense_id": "6d6d0d27-7f93-3b2e-b09b-62a1722abc0b",
                        "entry_id": "022a5a22-f62a-3825-b570-1eb0c52496d9",
                        "glosses": [
                            "Wortschatz einer Sprache oder einer Varietät einer Sprache; Menge aller Lexeme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "894fa502-f8dd-4a83-a255-39797d57dbf3",
                                "sense_id": "6d6d0d27-7f93-3b2e-b09b-62a1722abc0b",
                                "text": "Zur Lexik einer Sprache gehören alle ihre Wörter (Lexeme)."
                            },
                            {
                                "example_id": "bbc2aeeb-a0f1-44eb-9764-6d05b180b72e",
                                "sense_id": "6d6d0d27-7f93-3b2e-b09b-62a1722abc0b",
                                "text": "„Die größten Veränderungen finden sich zweifellos in der Lexik.“"
                            },
                            {
                                "example_id": "c56f643c-38ea-4949-9a2a-d693f02d8af2",
                                "sense_id": "6d6d0d27-7f93-3b2e-b09b-62a1722abc0b",
                                "text": "„Die Regeln des sprachlichen Handelns werden in der Pragmatik, die Regeln des Wortgebrauchs in der Lexik untersucht und beschrieben…“"
                            },
                            {
                                "example_id": "90b61dbf-f7a0-491e-adda-eacc1219653d",
                                "sense_id": "6d6d0d27-7f93-3b2e-b09b-62a1722abc0b",
                                "text": "„Da der Sprachwandel in den relativ geschlossenen Teilsystemen der Sprache langsamer vor sich geht als im offenen Teilsystem der Lexik, können die verschiedenen Dimensionen sprachlicher Bewegungen - besonders die zeitliche und räumliche, weniger die soziale - in der Grammatik und Phonematik mitunter genauer verfolgt werden als im Wortschatz.“"
                            },
                            {
                                "example_id": "108f96a5-5978-490b-b79a-16d21d9cfbb9",
                                "sense_id": "6d6d0d27-7f93-3b2e-b09b-62a1722abc0b",
                                "text": "„Mit Lexik ist der Bestand an elementaren Ausdrücken - an Wörtern - gemeint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16385f85-2a64-4e0f-9896-cf77007d7864",
                        "source_entry_id": "022a5a22-f62a-3825-b570-1eb0c52496d9",
                        "source_sense_id": "6d6d0d27-7f93-3b2e-b09b-62a1722abc0b",
                        "source_sense_description": "Linguistik: Wortschatz einer Sprache oder einer Varietät einer Sprache; Menge aller Lexeme",
                        "target_lang_word": "lexis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lexis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee380ba5-2c29-3dd8-8970-890f94b77100",
                                        "entry_id": "407f12cf-2b94-3334-b459-9c6b170e5cf5",
                                        "glosses": [
                                            "The set of all words and phrases in a language; any unified subset of words from a particular language."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ceb858a-2ef2-4c36-af0a-89e951fbd96c",
                                                "sense_id": "ee380ba5-2c29-3dd8-8970-890f94b77100",
                                                "text": "Thus, alongside current lexis, words and senses now obsolete find a place in a dictionary on historical principles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ddccb04-9dcd-3862-b094-164f82fabeb3",
                                        "entry_id": "407f12cf-2b94-3334-b459-9c6b170e5cf5",
                                        "glosses": [
                                            "Words, collocations, and common phrases in a language; vocabulary and word combinations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8962f1c0-6eff-4301-adad-2ae90ea178a2",
                                                "sense_id": "2ddccb04-9dcd-3862-b094-164f82fabeb3",
                                                "text": "By the 1980s, English language teachers generally had begun to realize that there had been a neglect of lexis in teaching methods and coursebooks. […] The basic truth that without vocabulary or lexis we can't express anything had to be restated and a new approach to teaching lexis was needed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6490ea7e-35de-329c-a59c-bab36f0dfb83",
                                        "entry_id": "407f12cf-2b94-3334-b459-9c6b170e5cf5",
                                        "glosses": [
                                            "The vocabulary used by a writer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fffb15c-931a-42a7-902a-f7f97916c698",
                                                "sense_id": "6490ea7e-35de-329c-a59c-bab36f0dfb83",
                                                "text": "In this broadsheet newspaper, the reporter uses a complicated and formal lexis which I find hard to understand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04c01e1f-ce05-4221-8621-3b41c2429364",
                        "source_entry_id": "022a5a22-f62a-3825-b570-1eb0c52496d9",
