                                                "sense_id": "ac7eae08-10c3-3ec9-affa-bf55cfa446e0",
                                                "text": "Matt trägt im Winter gern eine Schapka aus neongrünem Webpelz."
                                            },
                                            {
                                                "example_id": "bf39b398-1c7a-4cfa-b19a-cf4cc233be6e",
                                                "sense_id": "ac7eae08-10c3-3ec9-affa-bf55cfa446e0",
                                                "text": "Frau Krause brachte aus Moskau bunte Schapkas für ihre Kinder mit."
                                            }
