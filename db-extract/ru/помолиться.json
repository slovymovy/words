                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ba058f5-7436-3258-bb05-094d5ec07b33",
                        "entry_id": "e1ba4c8b-81b8-37ba-a710-8f7ff350d329",
                        "glosses": [
                            "совершить действие, выраженное гл. молиться; провести некоторое время, совершая такое действие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387118b9-52ff-4e09-8897-76d4417f55b0",
                                "sense_id": "1ba058f5-7436-3258-bb05-094d5ec07b33",
                                "text": "В те дни взошел Он на гору помолиться и пробыл всю ночь в молитве к Богу."
                            }
                        ]
                    },
                    {
                        "sense_id": "20ef0233-afb0-33b5-af6a-b88fdf9cd835",
                        "entry_id": "e1ba4c8b-81b8-37ba-a710-8f7ff350d329",
                        "glosses": [
                            "обратиться к Богу, к святым с молитвой"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bca2b9fa-dd92-4618-9cdc-5dfe53a43f7b",
                        "source_entry_id": "e1ba4c8b-81b8-37ba-a710-8f7ff350d329",
                        "target_lang_word": "pray",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "814f3d88-84ff-3306-a8b7-7ddeaa5327c0",
                                        "entry_id": "65d986c0-b6f4-394e-9399-ed56523d3eef",
                                        "glosses": [
                                            "To direct words, thoughts, or one's attention to a deity or any higher being, for the sake of adoration, thanks, petition for help, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad461ab-f64d-400d-96e9-4608282e6b32",
                                                "sense_id": "814f3d88-84ff-3306-a8b7-7ddeaa5327c0",
                                                "text": "Muslims pray in the direction of Mecca."
                                            },
                                            {
                                                "example_id": "80d16a52-b11b-45a3-8f46-2fb930ab6480",
                                                "sense_id": "814f3d88-84ff-3306-a8b7-7ddeaa5327c0",
                                                "text": "Pray to the small gods and hope that they may hear thee. Yet what mercy should the small gods have, who themselves made Death and Pain; or shall they restrain their old hound Time for thee?"
                                            },
                                            {
                                                "example_id": "7f811274-5d34-4bb5-8b45-6d83f078c1b6",
                                                "sense_id": "814f3d88-84ff-3306-a8b7-7ddeaa5327c0",
                                                "text": "This can't happen. You can't die! You're the Emissary! [...] Captain, I know my beliefs make you uncomfortable around me sometimes, and that maybe that's why you keep me at arm's length. But I don't care about that right now, and I am going to pray, because I don't know what else to do."
                                            },
                                            {
                                                "example_id": "4258e390-c1f5-46c4-b022-fc6ceb7f3575",
                                                "sense_id": "814f3d88-84ff-3306-a8b7-7ddeaa5327c0",
                                                "text": "The critically low level of rainfall in the second half of 2020 – approaching 50% year on year for November – led the religious affairs directorate to instruct imams and their congregations to pray for rain last month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8e438a8-99c4-3ca9-a9af-d0b794cdad1f",
                                        "entry_id": "65d986c0-b6f4-394e-9399-ed56523d3eef",
                                        "glosses": [
                                            "To humbly beg a person for aid or their time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9350e17-fad6-301a-a7fd-31c91c219d78",
                                        "entry_id": "65d986c0-b6f4-394e-9399-ed56523d3eef",
                                        "glosses": [
                                            "To ask earnestly for; to seek to obtain by supplication; to entreat for."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e84e4c08-e824-40d8-a476-7849a36b7193",
                                                "sense_id": "e9350e17-fad6-301a-a7fd-31c91c219d78",
                                                "text": "I know not how to pray your patience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e9d6ab3-97f7-30a4-aff1-8a84aa52b76c",
                                        "entry_id": "65d986c0-b6f4-394e-9399-ed56523d3eef",
                                        "glosses": [
                                            "To wish or hope strongly for a particular outcome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b5e76a-26b7-437f-8981-f5dcec4c2981",
                                                "sense_id": "9e9d6ab3-97f7-30a4-aff1-8a84aa52b76c",
                                                "text": "She is praying that the Red Sox will win tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31250b27-06b5-3612-9c1f-bf4a42a66da2",
                                        "entry_id": "65d986c0-b6f4-394e-9399-ed56523d3eef",
                                        "glosses": [
                                            "To implore, to entreat, to request."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa48b9dc-db87-4933-950d-66eb8aa27a1d",
                                                "sense_id": "31250b27-06b5-3612-9c1f-bf4a42a66da2",
                                                "text": "They prayd him sit, and gave him for to feed\n Such homely what as serves the simple clowne,\n That doth despise the dainties of the towne[…]"
                                            },
                                            {
                                                "example_id": "5c853b31-2a1e-44f4-95b4-eb05a9819431",
                                                "sense_id": "31250b27-06b5-3612-9c1f-bf4a42a66da2",
                                                "text": "In time of drought the Abchases of the Caucasus sacrifice an ox to Ap-hi, the god of thunder and lightning, and an old man prays him to send rain, thunder, and lightning, telling him that the crops are parched."
                                            },
                                            {
                                                "example_id": "bc2b6e45-e827-46a9-8ff3-6ceb1413ab91",
                                                "sense_id": "31250b27-06b5-3612-9c1f-bf4a42a66da2",
                                                "text": "I humbly pray to the Honorable Court for the order for the removal of the publication which contains fake news to be granted."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96549e49-ae31-3d0e-9c28-ba0a51a22004",
                                        "entry_id": "f7fee352-853e-322a-ba62-36d758ca456a",
                                        "glosses": [
                                            "Please; used to make a polite request"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c5f3f29-607d-4cdb-8cb6-c670fa53c030",
                                                "sense_id": "96549e49-ae31-3d0e-9c28-ba0a51a22004",
                                                "text": "pray silence for…"
                                            },
                                            {
                                                "example_id": "52abc3b8-1dff-40a0-8551-ba393f730811",
                                                "sense_id": "96549e49-ae31-3d0e-9c28-ba0a51a22004",
                                                "text": "\"Pray, Mr. Knightley,\" said Emma, who had been smiling to herself through a great part of this speech, \"how do you know that Mr. Martin did not speak yesterday?\""
                                            },
                                            {
                                                "example_id": "a5c1fffe-8e69-4d65-b09d-faaad8d92fb1",
                                                "sense_id": "96549e49-ae31-3d0e-9c28-ba0a51a22004",
                                                "text": "Pray don’t ask me why, pray don’t be sorry, pray don’t be vexed with me, I have nothing to do with it indeed!"
                                            },
                                            {
                                                "example_id": "1ebd680d-fd9a-4362-a2d5-3bfb3d3db3e0",
                                                "sense_id": "96549e49-ae31-3d0e-9c28-ba0a51a22004",
                                                "text": "Well, Major, pray tell us your adventures, for you have frightened us dreadfully."
                                            },
                                            {
                                                "example_id": "91974350-8403-4952-9aaf-ad0292abeece",
                                                "sense_id": "96549e49-ae31-3d0e-9c28-ba0a51a22004",
                                                "text": "Thank you. I am sorry to have interrupted you. Pray continue your most interesting statement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08579070-f8a3-33ec-9a37-63cc6b13f0d3",
                                        "entry_id": "f7fee352-853e-322a-ba62-36d758ca456a",
                                        "glosses": [
                                            "Alternative form of pray tell (“I ask you”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7fd48bc-3216-44b4-b175-ba47e41d371d",
                                                "sense_id": "08579070-f8a3-33ec-9a37-63cc6b13f0d3",
                                                "text": "Shall I be moved to love you, pray, / By hints that I must soon decay? / No woman's won by being told / How quickly she is growing old[...]"
                                            },
                                            {
                                                "example_id": "dc2209e1-2e1f-42cc-bd6d-48a24dfd7513",
                                                "sense_id": "08579070-f8a3-33ec-9a37-63cc6b13f0d3",
                                                "text": "He is a South American, so perhaps revolutionary spirit courses through Francis's veins. But what, pray, does the Catholic church want with doubt?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f42ea733-0409-4070-b567-4e2cdb09bdef",
                        "source_entry_id": "e1ba4c8b-81b8-37ba-a710-8f7ff350d329",
                        "target_lang_word": "prier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c20cffb-ecc7-38a0-af16-1c5399f5b32e",
                                        "entry_id": "142d74ca-b2f4-38d8-8625-42a0f6c21182",
                                        "glosses": [
                                            "Adorer la divinité en lui demandant une grâce, en la remerciant d’une grâce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c96ff8c-d6f4-48db-8357-155540519715",
                                                "sense_id": "4c20cffb-ecc7-38a0-af16-1c5399f5b32e",
                                                "text": "La caravane ne s’ébranla qu’après d’interminables adieux: ceux qui restaient priaient Allah d’accorder sa bénédiction aux voyageurs […]"
                                            },
                                            {
                                                "example_id": "4238afb4-23cd-44ea-bc1f-3802671557ca",
                                                "sense_id": "4c20cffb-ecc7-38a0-af16-1c5399f5b32e",
                                                "text": "Les personnes vraiment pieuses doivent se faire un devoir de prier pour l’Église et d’honorer leur évêque; elles doivent aussi prier pour l’avantage spirituel et temporel de l’État, et honorer leur Souverain."
                                            },
                                            {
                                                "example_id": "81d1e71b-ec65-4954-8424-c4d4069b97d1",
                                                "sense_id": "4c20cffb-ecc7-38a0-af16-1c5399f5b32e",
                                                "text": "Ah ! les gens qui ne pratiquent pas s’imaginent que rien n’est plus facile que de prier. Je voudrais bien les y voir !"
                                            },
                                            {
                                                "example_id": "aade70aa-5391-4c48-8dc2-2ca096c13385",
                                                "sense_id": "4c20cffb-ecc7-38a0-af16-1c5399f5b32e",
                                                "text": "Prier la Vierge, prier les saints, s’adresser à la Vierge, aux saints, afin qu’ils interviennent pour nous auprès de Dieu."
                                            },
                                            {
                                                "example_id": "76a2361c-830b-496b-968e-95f90893101d",
                                                "sense_id": "4c20cffb-ecc7-38a0-af16-1c5399f5b32e",
                                                "text": "Je prie Dieu que…. se dit en forme de souhait."
                                            },
                                            {
                                                "example_id": "40a5f69c-60b7-44da-86fe-a5b643c02756",
                                                "sense_id": "4c20cffb-ecc7-38a0-af16-1c5399f5b32e",
                                                "text": "Je prie Dieu qu’il vous rende la santé."
                                            },
                                            {
                                                "example_id": "068fdadf-c90c-4438-af28-ea890005bc19",
                                                "sense_id": "4c20cffb-ecc7-38a0-af16-1c5399f5b32e",
                                                "text": "Je prie Dieu qu’il vous ait en sa sainte garde, Formule par laquelle le roi terminait ses lettres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53073b7-b842-3da7-9d32-c47b755839d6",
                                        "entry_id": "142d74ca-b2f4-38d8-8625-42a0f6c21182",
                                        "glosses": [
                                            "Demander par grâce, avec une sorte d’humilité ou au moins de déférence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ac5dada-8209-4c7d-af0f-3adeccd0d36f",
                                                "sense_id": "e53073b7-b842-3da7-9d32-c47b755839d6",
                                                "text": "Aujourd’hui tout est devenu si confus que les curés prétendent être les meilleurs de tous les démocrates ; ils ont adopté la Marseillaise pour leur hymne de parti ; et si on les en priait un peu fort, ils illumineraient pour l'anniversaire du 10 août 1792."
                                            },
                                            {
                                                "example_id": "210edaf2-efc8-4064-bb83-9dfa6118fff5",
                                                "sense_id": "e53073b7-b842-3da7-9d32-c47b755839d6",
                                                "text": "Prier quelqu’un de quelque chose, de faire quelque chose."
                                            },
                                            {
                                                "example_id": "b7ae4f98-03af-4561-bc28-9b2c0198a265",
                                                "sense_id": "e53073b7-b842-3da7-9d32-c47b755839d6",
                                                "text": "C’est un homme que je vous prie de protéger."
                                            },
                                            {
                                                "example_id": "efe4e252-5c9e-4daf-ace5-9d9671cbcd47",
                                                "sense_id": "e53073b7-b842-3da7-9d32-c47b755839d6",
                                                "text": "Priez-le de ma part de venir me parler."
                                            },
                                            {
                                                "example_id": "4418cf1b-da03-4b6c-a8c7-6be1949b03cc",
                                                "sense_id": "e53073b7-b842-3da7-9d32-c47b755839d6",
                                                "text": "Il veut être prié."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16dd5311-a09e-3e66-affa-e5b7268c058e",
                                        "entry_id": "142d74ca-b2f4-38d8-8625-42a0f6c21182",
                                        "glosses": [
                                            "S’emploie souvent par simple formule de civilité, de façon phatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9cad483-43ff-42a6-97c0-b28bfa554109",
                                                "sense_id": "16dd5311-a09e-3e66-affa-e5b7268c058e",
                                                "text": "Dites-moi, je vous prie, ce que vous entendez par là."
                                            },
                                            {
                                                "example_id": "75e8d147-9fab-476f-8597-21dcab8797e1",
                                                "sense_id": "16dd5311-a09e-3e66-affa-e5b7268c058e",
                                                "text": "Excusez-moi, je vous prie, si je ne me rends pas à votre invitation."
                                            },
                                            {
                                                "example_id": "003ff082-6db3-453a-bf6d-9c160b72e0d2",
                                                "sense_id": "16dd5311-a09e-3e66-affa-e5b7268c058e",
                                                "text": "Faites porter cela chez moi, je vous prie."
                                            },
                                            {
                                                "example_id": "f32caab7-dd65-4bbe-adca-4b9a3fda676b",
                                                "sense_id": "16dd5311-a09e-3e66-affa-e5b7268c058e",
                                                "text": "Remarquez, je vous prie, que…."
                                            },
                                            {
                                                "example_id": "692c65a2-600e-44e0-90d1-da9a2c5843ca",
                                                "sense_id": "16dd5311-a09e-3e66-affa-e5b7268c058e",
                                                "text": "Quelle sera, je vous prie, votre situation ?"
                                            },
                                            {
                                                "example_id": "c4bbfe00-dd0a-424b-abea-438e5f5ddbf6",
                                                "sense_id": "16dd5311-a09e-3e66-affa-e5b7268c058e",
                                                "text": "Ah ! Je t’en prie, je ne veux plus entendre parler de cela."
                                            },
                                            {
                                                "example_id": "b80c10f6-899b-4eae-b0a5-6e4d623cf748",
                                                "sense_id": "16dd5311-a09e-3e66-affa-e5b7268c058e",
                                                "text": "Je vous prie, que cela n’arrive plus."
                                            },
                                            {
                                                "example_id": "d5006459-f2b4-464f-9ec8-a789f69a3529",
                                                "sense_id": "16dd5311-a09e-3e66-affa-e5b7268c058e",
                                                "text": "Ne recommencez pas, je vous en prie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5837be64-bfd1-3a64-b296-10a7e3d55852",
                                        "entry_id": "142d74ca-b2f4-38d8-8625-42a0f6c21182",
                                        "glosses": [
                                            "Inviter ; convier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "716562ed-3171-4e66-a78a-828ed55b901b",
                                                "sense_id": "5837be64-bfd1-3a64-b296-10a7e3d55852",
                                                "text": "La marquise était restée debout et Solange, qui ne se lassait pas d’admirer sa rayonnante beauté, ne songeait pas à la prier de s’asseoir ; […]."
                                            },
                                            {
                                                "example_id": "2a0cfa29-21eb-42cf-9496-a358f672504e",
                                                "sense_id": "5837be64-bfd1-3a64-b296-10a7e3d55852",
                                                "text": "Un jour, causant avec lui dans le palais, ils abordèrent un ministre qui pria Zadig à souper, et ne pria point Arimaze."
                                            },
                                            {
                                                "example_id": "e03dec73-e3f0-4412-a30b-0a17af794c80",
                                                "sense_id": "5837be64-bfd1-3a64-b296-10a7e3d55852",
                                                "text": "– Devez-vous le revoir ?\n– Il m'a prié en qualité de secrétaire."
                                            },
                                            {
                                                "example_id": "bc480daf-1b73-4d41-85e2-cbb494670e94",
                                                "sense_id": "5837be64-bfd1-3a64-b296-10a7e3d55852",
                                                "text": "— La princesse Aldobrandi te prie à une soirée qu’elle donne chez elle demain."
                                            },
                                            {
                                                "example_id": "fcdc5d09-3588-4aad-a82a-06b892bc1a73",
                                                "sense_id": "5837be64-bfd1-3a64-b296-10a7e3d55852",
                                                "text": "Repas, dîner prié, Repas, dîner auquel on est invité avec quelque cérémonie."
                                            },
                                            {
                                                "example_id": "35065fec-3eb6-4e98-ab0b-65af1d7e7458",
                                                "sense_id": "5837be64-bfd1-3a64-b296-10a7e3d55852",
                                                "text": "Les jours de dîners priés, Monsieur de C., se substituant à elle, se plongeait dans de longs conciliabules avec Aldegonde, soucieux d’éviter que parussent sur la table certaines combinaisons chères aux cuisinières belges, telles que la poule au riz flanquée de pommes de terre, ou que l’entremets consistât en tarte aux pruneaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
