            "senses": [
                {
                    "sense_id": "311a4c4b-7e2c-39c1-9373-8147119e3956",
                    "sense_definition": "Принять окончательное намерение сделать что-либо или прийти к определённому выводу.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы долго обсуждали планы и наконец <w>решили</w> поехать на море.",
                            "target_lang_translations": {
                                "en": "We discussed plans for a long time and finally <w>decided</w> to go to the sea.",
                                "de": "Wir haben lange über Pläne diskutiert und uns schließlich <w>entschieden</w>, ans Meer zu fahren."
                            }
                        },
                        {
                            "text": "Он почувствовал сильную усталость и <w>решил</w>, что пора идти домой.",
                            "target_lang_translations": {
                                "en": "He felt very tired and <w>decided</w> that it was time to go home.",
                                "de": "Er fühlte sich sehr müde und <w>beschloss</w>, dass es Zeit war, nach Hause zu gehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "заключить",
                        "принять решение"
                    ],
                    "common_phrases": [
