                                    {
                                        "sense_id": "20dd8f37-7ab5-32eb-a3be-45d3246cb60f",
                                        "entry_id": "9e721066-8f26-3590-9031-83ed36a7bc51",
                                        "glosses": [
                                            "ausgestorbene Gattung von hornlosen Nashornverwandten, die zu den größten jemals lebenden Landsäugetieren gehörten"
                                        ],
                                        "tags": [
                                            "Paläobiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70686c17-84f3-400b-b6cc-681f0c35a880",
                                                "sense_id": "20dd8f37-7ab5-32eb-a3be-45d3246cb60f",
                                                "text": "Das Paraceratherium erreichte eine Widerristhöhe von bis zu sechs Metern."
                                            },
                                            {
                                                "example_id": "4e85c725-2c82-4c6d-ad1d-abd34e2a9f51",
                                                "sense_id": "20dd8f37-7ab5-32eb-a3be-45d3246cb60f",
                                                "text": "Das in Osteuropa und Asien lebende Paraceratherium fraß Laub von den Baumkronen."
                                            },
                                            {
                                                "example_id": "518739e4-1cc8-4df0-8216-f604a5273760",
                                                "sense_id": "20dd8f37-7ab5-32eb-a3be-45d3246cb60f",
                                                "text": "Zu jener Zeit lebte das Landsäugetier Paraceratherium, eine Mischung aus Pony, Giraffe und Elch, erzählte Ziemek bei dem imposanten Exponat im Theaterpark."
                                            },
                                            {
                                                "example_id": "7e25e9f5-3162-4bfc-8935-3039f3d24a43",
                                                "sense_id": "20dd8f37-7ab5-32eb-a3be-45d3246cb60f",
                                                "text": "Darüber hinaus versucht ein älteres Kalb des Weibchens, das nach drei Jahren mütterlicher Obhut weggejagt wurde, was für Paraceratherien natürlich ist, zu diesem zurückzukehren, wird aber wieder und wieder weggejagt."
                                            },
                                            {
                                                "example_id": "0c28756e-a4a5-487f-812f-92e7acf38b24",
                                                "sense_id": "20dd8f37-7ab5-32eb-a3be-45d3246cb60f",
                                                "text": "Zu den Endemismen des asiatischen Alttertiärs gehören, abgesehen von zahlreichen endemischen Gattungen und Arten, die Riesennashörner mit Indricotherium und Paraceratherium, die im Jungtertiär wieder ausstarben."
                                            }
                                        ],
