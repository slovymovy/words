                ],
                "senses": [
                    {
                        "sense_id": "eb9a436c-1f52-360e-9393-a3abcc5698f8",
                        "entry_id": "39c0ebba-ed21-3fa5-8dd7-b7614706ac1c",
                        "glosses": [
                            "fünfter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfe9d9a9-fea2-42f0-a90a-863d226733d1",
                                "sense_id": "eb9a436c-1f52-360e-9393-a3abcc5698f8",
                                "text": "Der heutige 5. Bezirk gehörte damals zu dem im Süden und Südwesten weit über den Linienwall, die heutige Gürtelstraße, hinaus über noch unverbautes Gebiet reichenden 4. Bezirk Wieden. Zwölf Jahre später, nämlich 1862, wurde Margareten ein eigenständiger Bezirk."
                            },
                            {
                                "example_id": "59d49b1b-dd7c-4c25-8d0a-d99c9fdec6c0",
                                "sense_id": "eb9a436c-1f52-360e-9393-a3abcc5698f8",
                                "text": "Laut der Beantwortung einer Neos-Anfrage durch Bürgermeister Michael Häupl (SPÖ), die der „Presse“ exklusiv vorliegt, machen die Flüchtlinge mit sechs Prozent in Margareten den höchsten Schüleranteil aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ff00da2c-5d58-3f42-afaf-388b0e05ad83",
                        "entry_id": "39c0ebba-ed21-3fa5-8dd7-b7614706ac1c",
                        "glosses": [
                            "ehemaliges Dorf, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a78d8b63-ad74-494b-a4c4-696c0c5211a9",
                                "sense_id": "ff00da2c-5d58-3f42-afaf-388b0e05ad83",
                                "text": "1373 wird Margareten erstmals als Margaretner Gutshof (am heutigen Margaretenplatz) erwähnt."
                            },
                            {
                                "example_id": "f09a0a0d-ca27-440c-a439-8d3764119e7e",
                                "sense_id": "ff00da2c-5d58-3f42-afaf-388b0e05ad83",
                                "text": "Im 17. Jahrhundert begann eine Welle von »Bettlersäuberungen« in den Vorstädten, insbesondere in St. Ulrich, Neustift, Nikolsdorf, Margareten, Gumpendorf, Hundsturm, Penzing, Hietzing, Hernals und Währing, wie 1641 den Grundherren und Richtern der entsprechenden Vorstädte und Vororte befohlen wurde."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
