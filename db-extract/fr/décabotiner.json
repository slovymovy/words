                "senses": [
                    {
                        "sense_id": "71bbb43c-e0a8-3ee1-8ac2-5cf58b465fe4",
                        "entry_id": "e1c3e0bf-56bc-3da7-9bd5-223787a8e784",
                        "glosses": [
                            "Faire perdre son caractère cabotin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fa82414-20cd-417a-a326-b051684388c5",
                                "sense_id": "71bbb43c-e0a8-3ee1-8ac2-5cf58b465fe4",
                                "text": "Ghéon lui-même, qui a voué sa vie à débourgeoiser et à décabotiner le théâtre, voyait un signe des temps dans ce retour du théâtre à ses origines, né et grandi dans les cadres officiels de la Sorbonne."
                            },
                            {
                                "example_id": "77f6ba57-421c-4ba3-ad25-93b6f6286c35",
                                "sense_id": "71bbb43c-e0a8-3ee1-8ac2-5cf58b465fe4",
                                "text": "Elle reçoit un jour une lettre de Charles Dullin, la convoquant chez lui, à Montmartre, pour un projet dont le programme comporte entre autres de purifier le théâtre et de décabotiner l’acteur."
                            }
                        ]
                    }
