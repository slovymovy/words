                    {
                        "translation_id": "05100243-0541-41d1-a8bf-6b90d5b3ddbd",
                        "source_entry_id": "7648da90-0f68-331f-a598-dbd0dba67c94",
                        "source_sense_id": "194efb5e-ff62-3251-83b7-6c303bcf2f10",
