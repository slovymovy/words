                "senses": [
                    {
                        "sense_id": "942f271a-7f8f-385d-ba28-104674dcb95c",
                        "entry_id": "326d2f32-fec5-33e4-9a00-727a37adf8dd",
                        "glosses": [
                            "Se contredire soi-même (verbe utilisé pour renforcer l’idée de se contredire)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5d8a04a-ab62-4815-ac01-38630077c0f4",
                                "sense_id": "942f271a-7f8f-385d-ba28-104674dcb95c",
                                "text": "On peut dire, à la rigueur, que Nietzsche et Wittgenstein ont tous deux l'art de s'autocontredire pour mieux dire."
                            },
                            {
                                "example_id": "71fc4123-9146-44e3-9640-847cc56ac6e8",
                                "sense_id": "942f271a-7f8f-385d-ba28-104674dcb95c",
                                "text": "L'oreille a ses limites, que la musique doit respecter, sauf à s'autocontredire."
                            },
                            {
                                "example_id": "d993b1f6-0c62-4def-b02e-e6fb7292692e",
                                "sense_id": "942f271a-7f8f-385d-ba28-104674dcb95c",
                                "text": "C'est plus marrant si je cherche à m'autocontredire !"
                            }
                        ]
                    }
