                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "cd8d1ffd-9eb1-4df6-83d7-5550318c5a6e",
                                "sense_id": "28bf3924-c403-3771-87eb-ae3a83a6eeaf",
                                "text": "Halfe furious vnto his foe he came, / Resolv'd in minde all suddenly to win, / Or soone to lose, before he once would lin [...]."
                            },
                            {
                                "example_id": "262a0fbf-2414-47c3-9165-502a12b5a543",
                                "sense_id": "28bf3924-c403-3771-87eb-ae3a83a6eeaf",
                                "text": "Till all war deaun I knaw thou wad not lin."
                            },
                            {
                                "example_id": "e2a7dcec-a6f1-4253-9f91-e8e29e3dec6e",
                                "sense_id": "28bf3924-c403-3771-87eb-ae3a83a6eeaf",
                                "text": "He never linned till he had taen away every chicken that the wife had."
                            }
                        ]
