                        "examples": [
                            {
                                "example_id": "f0216c2d-378b-4d25-8245-204af156c178",
                                "sense_id": "0788c1cb-5f04-3714-8a35-440e552eb62e",
                                "text": "Cette espèce est admirable pour ses grandes fleurs jaunes. Elle est de serre froide et reproduisible par boutures."
                            },
                            {
                                "example_id": "cfa2b3a5-6cef-451d-bae2-5505aa052316",
                                "sense_id": "0788c1cb-5f04-3714-8a35-440e552eb62e",
                                "text": "Il n’y a point d’épopée nationale de choses que le peuple ne peut se représenter comme reproduisibles dans un avenir prochain ; la poésie populaire implique bien plutôt du futur que du passé ; […]."
                            },
                            {
                                "example_id": "279a9c34-d170-4f74-b360-6fb113bdd1d2",
                                "sense_id": "0788c1cb-5f04-3714-8a35-440e552eb62e",
                                "text": "La photo, répétable, reproduisible, inarrêtable, va reproduire mécaniquement et impitoyablement ce qu’on ne faisait que semblant d’avoir vu, très souvent, pour ne pas le répéter ni le mémoriser."
                            }
                        ]
                    }
