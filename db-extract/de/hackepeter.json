                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cd5a7e2-d664-3e93-83db-7ddc4ea47fa5",
                                        "entry_id": "579bdba4-4d7d-367d-b06c-4865593fe01d",
                                        "glosses": [
                                            "To effect mincingly."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b713b52d-040e-3069-8cab-9fb0c7d46d7f",
                                        "entry_id": "579bdba4-4d7d-367d-b06c-4865593fe01d",
                                        "glosses": [
                                            "To cut into very small pieces; to chop finely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36548abc-d3c5-4cc1-81da-72c11d97e516",
                                                "sense_id": "b713b52d-040e-3069-8cab-9fb0c7d46d7f",
                                                "text": "Butchers often use machines to mince meat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163fb1d2-2e78-3e23-824a-8b5e4f01c152",
                                        "entry_id": "579bdba4-4d7d-367d-b06c-4865593fe01d",
                                        "glosses": [
                                            "To suppress or weaken the force of."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1371fdad-c5b4-4319-bd63-7902ee711d24",
                                                "sense_id": "163fb1d2-2e78-3e23-824a-8b5e4f01c152",
                                                "text": "Siren, now mince the sin, / And mollify damnation with a phrase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a7c94e-f1d6-3403-88dd-8c29a584ee95",
                                        "entry_id": "579bdba4-4d7d-367d-b06c-4865593fe01d",
                                        "glosses": [
                                            "To say or utter vaguely (not directly or frankly)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05a35031-ad57-4add-831e-2cda2a68c880",
                                                "sense_id": "d5a7c94e-f1d6-3403-88dd-8c29a584ee95",
                                                "text": "to mince one's words"
                                            },
                                            {
                                                "example_id": "347f039c-e177-4cb0-83a5-9b74664c37ea",
                                                "sense_id": "d5a7c94e-f1d6-3403-88dd-8c29a584ee95",
                                                "text": "a minced oath"
                                            },
                                            {
                                                "example_id": "35a853a8-b095-44a3-b0e5-7d73e24c9f59",
                                                "sense_id": "d5a7c94e-f1d6-3403-88dd-8c29a584ee95",
                                                "text": "I know no ways to mince it in love, but directly to say — \"I love you.\""
                                            },
                                            {
                                                "example_id": "fc7348fa-9b26-4c18-8479-36727a2299d2",
                                                "sense_id": "d5a7c94e-f1d6-3403-88dd-8c29a584ee95",
                                                "text": "Despite prolonged exposure to harsh conditions, medics say Nora Tallis returned to the Nexus in stable condition. In a statement to HNS, Tallis did not mince words. \"Never send me to that hellhole again.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5781dc1-2220-3287-b621-6ec3b0b447be",
                                        "entry_id": "579bdba4-4d7d-367d-b06c-4865593fe01d",
                                        "glosses": [
                                            "To affect; to pronounce affectedly or with an accent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bad02ba6-4551-4d91-83e0-113cc547c0ef",
                                                "sense_id": "c5781dc1-2220-3287-b621-6ec3b0b447be",
                                                "text": "In some districts of England ll is sounded like w, thus bowd (booud) for BOLD, bw (buu) for BULL, caw (kau) for CALL. But this pronunciation is merely a provincialism, and not to be imitated unless you wish to mince like these blunderers."
                                            },
                                            {
                                                "example_id": "8db4b5b2-a9ec-4316-8da7-758414dea625",
                                                "sense_id": "c5781dc1-2220-3287-b621-6ec3b0b447be",
                                                "text": "One may hear some speakers in Oxford mince brother into brover (brëvë); Bath into Baf; both into bof."
                                            },
                                            {
                                                "example_id": "657e09c9-9b03-4e5f-8cdd-38a83a948c4e",
                                                "sense_id": "c5781dc1-2220-3287-b621-6ec3b0b447be",
                                                "text": "\"[…]The preacher said it was sympathetic,\" she minced the word, remembering Mr. Larsen's manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abaf8143-c181-3143-b214-9086ab756b4c",
                                        "entry_id": "579bdba4-4d7d-367d-b06c-4865593fe01d",
                                        "glosses": [
                                            "To walk with short steps; to walk in a prim, affected manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "735929a8-3039-4c93-a468-89693b7b8429",
                                                "sense_id": "abaf8143-c181-3143-b214-9086ab756b4c",
                                                "text": "At the last moment Mollie, the foolish, pretty white mare who drew Mr. Jones's trap, came mincing daintily in, chewing at a lump of sugar."
                                            },
                                            {
                                                "example_id": "40dc43e2-2890-4fc4-93da-ed0f73c4dab6",
                                                "sense_id": "abaf8143-c181-3143-b214-9086ab756b4c",
                                                "text": "The daughters of Zion are haughty, and walk with stretched forth necks and wanton eyes, mincing as they go."
                                            },
                                            {
                                                "example_id": "5f309462-b55a-413c-82c9-b839c8b3a7eb",
                                                "sense_id": "abaf8143-c181-3143-b214-9086ab756b4c",
                                                "text": "I'll […] turn two mincing steps into a manly stride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ebe5e13-c936-32b5-aeac-b65746d83679",
                                        "entry_id": "579bdba4-4d7d-367d-b06c-4865593fe01d",
                                        "glosses": [
                                            "To act or talk with affected nicety; to affect delicacy in manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06133923-6ab9-4061-93d2-02b7b89402c6",
                                                "sense_id": "5ebe5e13-c936-32b5-aeac-b65746d83679",
                                                "text": "I love going to gay bars and seeing drag queens mince around on stage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e7fe713-4b84-4b89-aeb8-4c6bbadc592a",
                        "source_entry_id": "18d5ad26-ca04-3f06-81c0-a33c8e2cddc9",
                        "source_sense_id": "bfda983f-c634-31a3-8baf-680d9205f7ae",
