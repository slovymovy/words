                        "glosses": [
                            "sich auf die Stadt Lyon beziehend, in der Art und Weise dieses Ortes, aus Lyon kommend, stammend, Lyon betreffend, zu Lyon gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f92ae62-1a1d-4836-936f-ca327e5f00df",
                                "sense_id": "92958a21-9ba1-3541-a117-b01781a46b14",
                                "text": "Die Lyoner Stadtgeschichte reicht bis in die Römerzeit zurück."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ace73cbf-7d77-4629-bb87-b5280e5967be",
