                        ],
                        "form": "sie sind schaffbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c02d7b94-b83f-3850-a99a-8d98651f1182",
                        "entry_id": "5b765fef-1f82-3cc1-a0fa-783b60d5ecf2",
                        "glosses": [
                            "sich erreichen, bewältigen, vollbringen lassend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6152fb9-c60a-440d-8ba2-b8cc2e6c45ac",
                                "sense_id": "c02d7b94-b83f-3850-a99a-8d98651f1182",
                                "text": "„Hier hilft mir Struktur, ich versuche, meine Erledigungen und Aufgaben so zu verteilen, dass es für einen guten Tag schaffbar ist.“"
                            },
                            {
                                "example_id": "4c45d4b9-b17d-47ea-ab16-4408c4a0a354",
                                "sense_id": "c02d7b94-b83f-3850-a99a-8d98651f1182",
                                "text": "„Die Strecke an sich war schaffbar, erst der letzte Aufstieg ging an die Reserven!“"
                            },
                            {
                                "example_id": "9d6e697e-7924-49bd-bad0-30de97937675",
                                "sense_id": "c02d7b94-b83f-3850-a99a-8d98651f1182",
                                "text": "„Denn 80% der Optimierung sind mit maximal 20% des Aufwandes und oftmals sogar deutlich weniger schaffbar.“"
                            },
                            {
                                "example_id": "4e175e4b-7e91-4dd3-b6d5-ba34570efdb4",
                                "sense_id": "c02d7b94-b83f-3850-a99a-8d98651f1182",
                                "text": "„So bleibt auf jeden Fall für die Zukunft noch viel zu tun um die Treibhausgase zu senken, jedoch kann jeder dazu seinen Beitrag leisten und gemeinsam ist es schaffbar.“"
                            }
                        ],
