                        "sense_id": "59da40d6-df5f-3e65-b76c-472d3f3d9b6e",
                        "entry_id": "38623836-fa34-3407-8666-17ef29261ff4",
                        "glosses": [
                            "die beiden Fäden eines Chromosoms, die bei der Zellteilung (sowohl in der Mitose als auch in der Meiose) als distinkte Strukturen sichtbar werden. Die beiden Chromatiden eines Chromosoms sind durch das Zentromer verbunden."
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "bc56b963-1df3-452c-87e7-7625ecb4a1f9",
                                "sense_id": "59da40d6-df5f-3e65-b76c-472d3f3d9b6e",
                                "text": "Chromosomen sind aus einem oder mehreren Chromatiden aufgebaut."
                            },
                            {
                                "example_id": "e7911cdf-8f28-46ea-a17b-55697280ae9f",
                                "sense_id": "59da40d6-df5f-3e65-b76c-472d3f3d9b6e",
                                "text": "\"Prophase: Es werden fädige Strukturen sichtbar, … Während nun die Kernmembran zerfällt …, verdicken und verkürzen sich die Doppelfäden zu kompakten Gebilden. Man nennt sie \"Chromosomen\", die beiden Einzelfäden \"Chromatiden\"."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
