                                "target_senses": [
                                    {
                                        "sense_id": "e5cca3e7-1a1f-3c2a-a51c-7e7062d6de11",
                                        "entry_id": "16d469a7-67f1-3cc4-8a0a-2f6594577314",
                                        "glosses": [
                                            "사람이나 동물의 혈관을 돌며 산소와 영양분을 공급하고, 노폐물을 운반하는 붉은색의 액체."
                                        ],
