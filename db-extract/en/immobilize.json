                                        "entry_id": "a3ae54c8-36da-3035-9c2c-20b3a82b2bf8",
                                        "glosses": [
                                            "Faire un placement de capitaux qui rend ces capitaux indisponibles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80c5b71a-2df8-4256-b34f-04dd6d1ea278",
                                                "sense_id": "7e5d89b5-4bf7-3eb5-a55b-7e13b7a95a47",
                                                "text": "Immobiliser des capitaux dans l’industrie, dans une affaire, dans des entreprises industrielles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57448159-7e6c-3dc7-a899-cc07b8d30815",
                                        "entry_id": "a3ae54c8-36da-3035-9c2c-20b3a82b2bf8",
                                        "glosses": [
                                            "Devenir immobile."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7142a40-23e4-4f5a-b681-a701c89e881b",
                                                "sense_id": "57448159-7e6c-3dc7-a899-cc07b8d30815",
                                                "text": "Le prince chassait souvent le gibier de mer sur une yole, avec deux ou trois de la bande, les autres s’immobilisaient en d'interminables farnientes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
