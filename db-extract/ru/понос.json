                "senses": [
                    {
                        "sense_id": "934d8215-5c4a-38da-95b4-38bf112cc9d9",
                        "entry_id": "59bd909e-81bc-3e9f-9821-b30489d5734a",
                        "glosses": [
                            "мед. расстройство функции кишечника, выражающееся в появлении жидких и обычно учащённых испражнений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95fe40e4-f585-4940-93cf-1a04e343f5e5",
                                "sense_id": "934d8215-5c4a-38da-95b4-38bf112cc9d9",
                                "text": "Кроме того, сухость и обложенность языка наблюдается при кишечных инфекциях и пищевых отравлениях, особенно при многократных поносах и рвотах в результате обезвоживания."
                            }
                        ]
                    },
                    {
                        "sense_id": "99639f47-d5dd-39d1-85ea-fd16d97ed5a4",
                        "entry_id": "59bd909e-81bc-3e9f-9821-b30489d5734a",
                        "glosses": [
                            "разг. перен. очень много, неспособность остановиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f94b2579-0e63-4f4e-a724-7b6faab2d9a5",
                                "sense_id": "99639f47-d5dd-39d1-85ea-fd16d97ed5a4",
                                "text": "Словесный понос."
                            }
                        ]
                    }
