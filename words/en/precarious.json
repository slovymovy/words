                            },
                            {
                                "target_lang_word": "güvensiz",
                                "target_lang_sense_clarification": "durum veya finansal şartlar için"
                            },
                            {
                                "target_lang_word": "istikrarsız",
                                "target_lang_sense_clarification": "sabit olmayan durumlar için"
