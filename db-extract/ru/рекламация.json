                    {
                        "translation_id": "b5742dab-808a-4e77-9b36-173d06e63287",
                        "source_entry_id": "8492f186-2f06-3ce8-a7ec-4c68ce0476f7",
                        "source_sense_id": "94ec63a4-d9e3-3796-899f-73e83c9c7212",
                        "target_lang_word": "réclamation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réclamation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                        "entry_id": "edf49e9c-da7a-335b-b0a0-a54f7d6eee67",
                                        "glosses": [
                                            "Action de protester, de s’opposer, de revendiquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f84501c-867a-47f6-8b4a-ab5eb318f208",
                                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                                "text": "La réclamation préalable est également indispensable d’un point de vue juridique, l’absence de réclamation préalable empêchant la saisine du juge fiscal."
                                            },
                                            {
                                                "example_id": "4894851b-0a39-46d8-9ad2-0554e8ee95f9",
                                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                                "text": "Car, c’est en usant de la liberté, qu'on peut s'entendre, se consulter, se faire éclairer par les gens instruits, puis après se syndiquer pour faire valoir ses réclamations."
                                            },
                                            {
                                                "example_id": "8bcc4639-57dd-41c0-9f45-aeb65763c59e",
                                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                                "text": "[…] la mendicité est soumise, en Belgique, à un arbitraire adminis­tratif que l’on peut comparer à celui de la police des mœurs ; on sait que cette police, malgré d’innombrables réclamations, continue à être presque souveraine en France."
                                            },
                                            {
                                                "example_id": "78d9eb1b-5ce8-4f67-9b87-9d25d6e43888",
                                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                                "text": "Cette loi excita beaucoup de réclamations."
                                            },
                                            {
                                                "example_id": "d0a444c8-511c-4d4f-89f0-3c62dc29968e",
                                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                                "text": "Cet avis a passé sans réclamation, malgré toutes les réclamations."
                                            },
                                            {
                                                "example_id": "5923297b-03b6-4ba3-96b4-bb33693aee5e",
                                                "sense_id": "1621f43b-f841-3a2f-8431-cb3ddc43f7c9",
                                                "text": "Réclamation d’état : Action judiciaire ayant pour objet de faire statuer sur l’état civil d’une personne à laquelle il est contesté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db3610bb-6668-306b-b3fa-abf281ed0cf0",
                                        "entry_id": "edf49e9c-da7a-335b-b0a0-a54f7d6eee67",
                                        "glosses": [
                                            "Expression d’une insatisfaction qu’un client attribue à son fournisseur et qu'il demande de traiter."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "936d7d6c-b2f9-4c14-8ad6-cb0b1bbcc1ee",
                                                "sense_id": "db3610bb-6668-306b-b3fa-abf281ed0cf0",
                                                "text": "Le directeur a dû traiter les réclamations quotidiennes des clients de sa société."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6660431b-6bfd-4d61-b5c9-c29c84d21290",
