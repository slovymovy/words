            "senses": [
                {
                    "sense_id": "85d1d3d3-2946-3bb2-a394-36e95f817244",
                    "sense_definition": "Arme à feu portative à canon long que l'on épaule pour tirer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "arme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chasseur nettoie soigneusement son <w>fusil</w> avant de partir dans la forêt."
                        },
                        {
                            "text": "Les soldats s'entraînent régulièrement au tir avec leur nouveau <w>fusil</w> d'assaut."
                        }
                    ],
                    "synonyms": [
                        "carabine"
                    ],
                    "common_phrases": [
                        "fusil de chasse",
                        "fusil d'assaut",
                        "coup de fusil"
                    ]
                },
                {
                    "sense_id": "09c9c914-2bf8-37bf-81ed-56976fa281a4",
                    "sense_definition": "Tige d'acier striée munie d'un manche, servant à aiguiser le tranchant des couteaux.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "outil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boucher utilise un <w>fusil</w> pour affûter la lame de son couteau."
                        },
                        {
                            "text": "Avant de découper la viande, le cuisinier passe la lame sur le <w>fusil</w>."
                        }
                    ],
                    "common_phrases": [
