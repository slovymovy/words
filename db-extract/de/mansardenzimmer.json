                ],
                "senses": [
                    {
                        "sense_id": "e7287b1b-4f76-3eb7-8e13-88dc676213d3",
                        "entry_id": "89553821-38f8-33d9-b767-9752bbdeca74",
                        "glosses": [
                            "Zimmer in der Mansarde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81ae2caa-4b49-4e7d-aa70-6de07148832e",
                                "sense_id": "e7287b1b-4f76-3eb7-8e13-88dc676213d3",
                                "text": "„Widerwärtig war ihr der Gestank, der aus den Ställen des Gutes gelegentlich bis in das Mansardenzimmer des Schlosses drang.“"
                            },
                            {
                                "example_id": "4fae6b9c-680d-40d7-b610-71d19a8b9887",
                                "sense_id": "e7287b1b-4f76-3eb7-8e13-88dc676213d3",
                                "text": "„Sie saßen in einem Mansardenzimmer des Hotels »Lutetia«, dem Quartier der militärischen Abwehr in Paris.“"
                            },
                            {
                                "example_id": "47316c2f-2d78-4439-b8f3-2aedaee96b7d",
                                "sense_id": "e7287b1b-4f76-3eb7-8e13-88dc676213d3",
                                "text": "„Bis zu dem Tag, an dem er sie verließ, zeigten sich Mr. und Mrs. Smith überrascht, wann immer er durch die Haustür kam oder aus dem winzigen Mansardenzimmer, in dem er wie ein Zaunkönig lebte.“"
                            },
                            {
                                "example_id": "77a5211d-1fea-4a75-8291-da6461152373",
                                "sense_id": "e7287b1b-4f76-3eb7-8e13-88dc676213d3",
                                "text": "„Schließlich erwachte er in seinem Bett in dem sonderbar verwinkelten Mansardenzimmer des unheimlich alten Hauses.“"
                            },
                            {
                                "example_id": "bfe90d16-f0ca-4992-915e-00bf2920a4af",
                                "sense_id": "e7287b1b-4f76-3eb7-8e13-88dc676213d3",
                                "text": "„Einen kurzen Moment lang, während der Schnee die Straße entlangtrieb, ihm ins Gesicht wehte, ihm mit eisigen Klingen in die Wangen schnitt und die Landschaft in Weiß hüllte, sehnte Strutt sich danach, mit jemandem zu reden, ihm von den Nächten zu erzählen, in denen er wach in seinem Zimmer lag und hörte, wie die Tochter seiner Zimmerwirtin in dem Mansardenzimmer über ihm von ihrem Vater Schläge bezog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "830303e8-579e-46f0-af5b-92eef312cc2a",
                        "source_entry_id": "89553821-38f8-33d9-b767-9752bbdeca74",
                        "source_sense_id": "e7287b1b-4f76-3eb7-8e13-88dc676213d3",
                        "source_sense_description": "Zimmer in der Mansarde",
                        "target_lang_word": "mansarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mansarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eee03e7a-c37a-3550-be45-b920e85bb01e",
                                        "entry_id": "009c306d-4218-39cc-a6f8-f653a785eba5",
                                        "glosses": [
                                            "Utilisé dans la locution à la mansarde, qui qualifie un comble brisé, c’est-à-dire formé de deux pans, le terrasson et le brisis qui est presque vertical. De ce fait ce comble permet de faire un étage habitable de plus sous la toiture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mansarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e89e77c-34ba-3a02-94eb-8f427c207d02",
                                        "entry_id": "7e21be2f-c3ab-3337-a71c-db1d9a256629",
                                        "glosses": [
                                            "Comble à la Mansart, ou comble brisé, c’est-à-dire formé de deux pans, le terrasson et le brisis qui est presque vertical. De ce fait ce comble permet de faire un étage habitable de plus sous la toiture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4c00d05-679d-3216-b2c8-895e64e3f337",
                                        "entry_id": "7e21be2f-c3ab-3337-a71c-db1d9a256629",
                                        "glosses": [
                                            "Chambre, logement pratiquée sous un comble brisé. Souvent synonyme autrefois de chambre de mauvaise qualité, réservée aux pauvres ou aux domestiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a104990c-b145-4091-96f4-0694a12a9789",
                                                "sense_id": "b4c00d05-679d-3216-b2c8-895e64e3f337",
                                                "text": "Le plancher de cette vaste mansarde n'avait jamais été balayé, l'air y était glacial, […]."
                                            },
                                            {
                                                "example_id": "1b354f4f-52b8-49f1-b1e5-8a56d490594c",
                                                "sense_id": "b4c00d05-679d-3216-b2c8-895e64e3f337",
                                                "text": "Oh ! mansarde, chère mansarde, quelles belles heures j’ai passées entre tes quatre murs ! Comme j’y travaillais bien ! Comme je m’y sentais brave !…"
                                            },
                                            {
                                                "example_id": "719ac2eb-5494-48a8-9ce4-5803a1f90a4b",
                                                "sense_id": "b4c00d05-679d-3216-b2c8-895e64e3f337",
                                                "text": "Au début de notre liaison, cette femme avait cru mettre la main sur un petit prodige, un grand poète de mansarde : — m’a-t-elle assommé avec sa mansarde !"
                                            },
                                            {
                                                "example_id": "6457d1a4-3496-4179-b534-515ebb829b50",
                                                "sense_id": "b4c00d05-679d-3216-b2c8-895e64e3f337",
                                                "text": "- je fumais ma pipe-marteau, en crachant sur les tuiles, car c'était une mansarde, ma chambre."
                                            },
                                            {
                                                "example_id": "5a5abaf7-9452-47a0-a4d6-57913447c3e3",
                                                "sense_id": "b4c00d05-679d-3216-b2c8-895e64e3f337",
                                                "text": "Une presse complaisante jusqu’à la servilité répandait dans le public, depuis les salons jusqu'aux mansardes, les idées les plus fausses et les plus dangereuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc0e516f-283d-3d0e-a75c-edf8d329d65d",
                                        "entry_id": "7e21be2f-c3ab-3337-a71c-db1d9a256629",
                                        "glosses": [
                                            "Par simplification, fenêtre, lucarne pratiquée dans la partie presque verticale (le brisis) d’un comble à la Mansart. On dit aussi « fenêtre en mansarde ou fenêtre mansardée »."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbac49f9-37e3-4280-9836-679a035b19b8",
                                                "sense_id": "dc0e516f-283d-3d0e-a75c-edf8d329d65d",
                                                "text": "Des lunettes communes vitraient ses yeux ternes et donnaient à sa personne un regard pensif de vieille mansarde."
                                            }
                                        ]
                                    }
                                ]
                            },
