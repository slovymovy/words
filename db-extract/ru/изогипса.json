                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isohypse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fec6cbc7-86e6-37f8-9026-59ea44880af6",
                                        "entry_id": "260be85a-6a5d-36e7-8eba-110cc5068639",
                                        "glosses": [
                                            "Ligne qui joint les points d’égale altitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c774aa6a-a3aa-4ab5-b13d-158a5c3603a9",
                                                "sense_id": "fec6cbc7-86e6-37f8-9026-59ea44880af6",
                                                "text": "De nombreux cordons morainiques recensés entre les isohypses 1050 m et 520 m, attestent de plusieurs niveaux de stationnement et, peut-être, de faibles récurrences du glacier."
                                            },
                                            {
                                                "example_id": "e7bea368-c759-41ba-9352-190f4cd19781",
                                                "sense_id": "fec6cbc7-86e6-37f8-9026-59ea44880af6",
                                                "text": "Tous les points de même altitude du niveau de pression retenu sont réunis sur une isohypse cotée en mètres (m) ou en décamètres (dam)."
                                            },
                                            {
                                                "example_id": "41e873b5-d77a-4053-b012-37e839054d59",
                                                "sense_id": "fec6cbc7-86e6-37f8-9026-59ea44880af6",
                                                "text": "Durant mon expédition en Terre d’Inglefield, j’ai aussi « rencontré », comme « par hasard », le pôle géomagnétique nord ; ce pôle défini en 1835-1840 par mon illustre prédécesseur, le géophysicien allemand Carl Friedrich Gauss. Il se situe sur la bordure glacière de l’inlandsis au nord-ouest du Groenland, selon les isohypses de 800 à 1 000 mètres, au 78° 29’ N, 68° 54’ 0, et se déplace de 2 kilomètres par an."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "isohypse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68d941fb-2f06-3dc2-9266-3c0a2f03a367",
                                        "entry_id": "1ae874d0-aa70-3989-8ad2-73a43cfe1388",
                                        "glosses": [
                                            "D’égale altitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0196d14-10a0-4fec-a432-ab45322f6bc3",
                                                "sense_id": "68d941fb-2f06-3dc2-9266-3c0a2f03a367",
                                                "text": "La surface isohypse qui a une altitude géopotentielle égale à zéro représente la surface de la hauteur moyenne océanique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
