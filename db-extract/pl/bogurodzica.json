                        ],
                        "examples": [
                            {
                                "example_id": "b75c39bb-d10f-480a-9622-29fe4e1acd84",
                                "sense_id": "eed82847-08c0-3974-be34-769c413f265b",
                                "text": "Chcąc oddać cześć Bogurodzicy, cenobici zaśpiewali wspaniały akatyst."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "eae54474-da60-3532-94b8-00a34e068b97",
                        "entry_id": "341ec41b-b853-3846-a656-9d7cda72703b",
                        "glosses": [
