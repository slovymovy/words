                    {
                        "translation_id": "2cc7e015-a5db-46b3-b707-f393cd5f5e00",
                        "source_entry_id": "b316c21e-9ef0-3b11-b5e3-2cc7fdd449fa",
                        "source_sense_description": "reduction or curtailment",
                        "target_lang_word": "сокраще́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сокраще́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a32ddfc3-f0cf-34be-93eb-1a095f18b4f3",
                                        "entry_id": "0926e84e-441d-3f38-8489-aa464bf46216",
                                        "glosses": [
                                            "действие по значению гл. сокращать; уменьшение, усечение чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a67e4c26-46e9-4132-bd06-c763220dd526",
                                                "sense_id": "a32ddfc3-f0cf-34be-93eb-1a095f18b4f3",
                                                "text": "Народ узнал, что идёт дело о сокраще́нии каза́чества и о сужении границ казацкой земли."
                                            },
                                            {
                                                "example_id": "5db108dc-10ed-4693-aa65-a4204c2e7d70",
                                                "sense_id": "a32ddfc3-f0cf-34be-93eb-1a095f18b4f3",
                                                "text": "Если на момент получения повестки работник находился под сокращением, но уволен ещё не был, такой трудовой договор также подлежит приостановлению, и сокращение, соответственно, приостанавливается."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "003c8639-eb62-30a6-ac15-01e8c9328a7f",
                                        "entry_id": "0926e84e-441d-3f38-8489-aa464bf46216",
                                        "glosses": [
                                            "результат уменьшения, усечения чего-либо ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eb61326-68f3-42f5-b3bb-ecacc242b829",
                                                "sense_id": "003c8639-eb62-30a6-ac15-01e8c9328a7f",
                                                "text": "У меня есть только сокраще́ние этой книги."
                                            },
                                            {
                                                "example_id": "259019e1-a929-4ee3-bd2d-4299cd086dfa",
                                                "sense_id": "003c8639-eb62-30a6-ac15-01e8c9328a7f",
                                                "text": "Слово «рация» — сокраще́ние слова «радиоста́нция»."
                                            },
                                            {
                                                "example_id": "ae229301-385d-42b6-8215-cb9612b0f038",
                                                "sense_id": "003c8639-eb62-30a6-ac15-01e8c9328a7f",
                                                "text": "Представить изложение своих мыслей в сокраще́нии"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff3ea7f6-135f-3320-aece-e2e996a54eee",
                                        "entry_id": "0926e84e-441d-3f38-8489-aa464bf46216",
                                        "glosses": [
                                            "сокращённое, краткое обозначение чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d49570-4dc9-4177-85fe-7a33f5c8fb1d",
                                                "sense_id": "ff3ea7f6-135f-3320-aece-e2e996a54eee",
                                                "text": "Принятые сокращения общеупотребительных выражений (напр. «см.» — смотри)."
                                            },
                                            {
                                                "example_id": "bd847f26-41f7-4eb1-a3a9-f034213ec72d",
                                                "sense_id": "ff3ea7f6-135f-3320-aece-e2e996a54eee",
                                                "text": "Список условных сокращений (в начале какого-н. научного труда, книги, на географической карте и т. д.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab82e186-7db8-3468-9713-88074033043e",
                                        "entry_id": "0926e84e-441d-3f38-8489-aa464bf46216",
                                        "glosses": [
                                            "пропуск, купюра в каком-либо тексте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59ab50d7-79c6-4841-a631-cb0829043d24",
                                                "sense_id": "ab82e186-7db8-3468-9713-88074033043e",
                                                "text": "Поставить «Бориса Годунова» с сокраще́ниями, выпустив некоторые сцены."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0da891a-3c6a-3473-b3ca-d64a29bff529",
                                        "entry_id": "0926e84e-441d-3f38-8489-aa464bf46216",
                                        "glosses": [
                                            "сокращённая, неполная запись чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5671c8d3-f8f3-49e9-be49-6c72e7fbb8a0",
                                                "sense_id": "e0da891a-3c6a-3473-b3ca-d64a29bff529",
                                                "text": "На полях записной книжки тогда и появилось кабалистическое сокраще́ние беседы…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8b6b90e-9ab3-3c3e-a0f4-17d192e81ba1",
                                        "entry_id": "0926e84e-441d-3f38-8489-aa464bf46216",
                                        "glosses": [
                                            "физиол. сжимание, напряжение (мускулов)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688a53c8-d2dc-46b8-bc1d-56c093f9d47c",
                                                "sense_id": "a8b6b90e-9ab3-3c3e-a0f4-17d192e81ba1",
                                                "text": "Это удлиняет мышцы, помогает вам расширить диапазон движения и достигнуть более мощного сокраще́ния."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
