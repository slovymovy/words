                                                "text": "Onze buurman is gespecialiseerd in xylografie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98703357-03cd-3f7f-b988-da7338c66c3e",
                                        "entry_id": "c45ddef0-7500-3998-95e1-908102dd966d",
                                        "glosses": [
                                            "houtsnede of houtgravure"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d85c3d8-62cd-44c4-ba7d-9c343caecf21",
                                                "sense_id": "98703357-03cd-3f7f-b988-da7338c66c3e",
                                                "text": "Zij maakte speciaal voor ons een paar xylografieën."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d8e98d7-8ff6-43a6-8913-7243be02804e",
