                ],
                "senses": [
                    {
                        "sense_id": "269aad9b-0ab3-3ba6-a742-53ccc7541621",
                        "entry_id": "47005d7a-aac1-3984-9bb4-5b62a279667e",
                        "glosses": [
                            "Kolonie Großbritanniens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebfd6cde-3747-4d49-be36-acf736a435b5",
                                "sense_id": "269aad9b-0ab3-3ba6-a742-53ccc7541621",
                                "text": "„In fünf Tagen hoffte man in der britischen Kronkolonie festmachen zu können.“"
                            },
                            {
                                "example_id": "13e8e193-c7fd-4a90-ae38-15bcd31d1aec",
                                "sense_id": "269aad9b-0ab3-3ba6-a742-53ccc7541621",
                                "text": "„Das brutal gezähmte Land wurde offiziell zur Kronkolonie: Im August 1858 billigte Königign Victoria ein Gesetz, das die Verwaltung des Subkontinents von der East India Company auf den britischen Staat übertrug.“"
                            },
                            {
                                "example_id": "5a8e7376-0bd2-40a6-8022-99d4bbd86d38",
                                "sense_id": "269aad9b-0ab3-3ba6-a742-53ccc7541621",
                                "text": "„1884, einige Jahrzehnte nach Gründung der Kronkolonie, begannen die Briten damit, in einem trockengelegten Sumpfgebiet Pferderennen zu veranstalten.“"
                            },
                            {
                                "example_id": "fc7096e3-97d5-4fa0-a3a9-b3c016867fae",
                                "sense_id": "269aad9b-0ab3-3ba6-a742-53ccc7541621",
                                "text": "„Man lud Kolonisten ein oder holte sich weniger freiwillige Siedler aus den Straflagern der Kronkolonien Hongkong und Singapur.“"
                            },
                            {
                                "example_id": "3cfac8d5-a2de-4deb-96b3-85f75555b797",
                                "sense_id": "269aad9b-0ab3-3ba6-a742-53ccc7541621",
                                "text": "„Das Land wurde für die Zeit bis zur Unabhängigkeit eine Kronkolonie, die der britische Gouverneur Lord Christopher Soames verwaltete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
