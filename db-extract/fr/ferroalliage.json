                ],
                "senses": [
                    {
                        "sense_id": "7a67f075-530c-3eb7-aa18-c0d71c715614",
                        "entry_id": "60055c48-ca29-380f-a07e-d59ba544fbc7",
                        "glosses": [
                            "Alliage métallique composé de fer et d’un autre métal, surtout utilisé pour la production d’aciers spéciaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d02b9de3-ddc1-4863-9fcd-ae3027ffc16b",
                                "sense_id": "7a67f075-530c-3eb7-aa18-c0d71c715614",
                                "text": "Kazchrome, qui produit du chrome, du silicium et des alliages de manganèse et représente actuellement plus de 60% de la production totale de ferroalliages au Kazakhstan, célébrera le 50e anniversaire de sa création cette année."
                            },
                            {
                                "example_id": "c38a50e5-5cd8-4480-9d69-96503aab3713",
                                "sense_id": "7a67f075-530c-3eb7-aa18-c0d71c715614",
                                "text": "Cette décision ne peut qu’alarmer les sidérurgistes russes qui importent 70% de leurs ferroalliages bulks d’Ukraine, en particulier le ferromanganèse, le silico-manganèse et le ferrosilicium."
                            },
                            {
                                "example_id": "c79a6f24-9881-4a5f-810f-12493247a84a",
                                "sense_id": "7a67f075-530c-3eb7-aa18-c0d71c715614",
                                "text": "Le terme ferrotitane désigne — comme il l’indique assez clairement — un ferroalliage, un alliage composé de fer et de titane."
                            }
                        ]
                    }
                ],
