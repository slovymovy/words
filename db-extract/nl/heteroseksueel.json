                        "cross_references": [
                            {
                                "target_word": "heterosexuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34d59303-0848-3d01-887f-9384f63d94f4",
                                        "entry_id": "f24a7ce7-da92-3b31-9baf-bfdf35aa9006",
                                        "glosses": [
                                            "ausschließlich sexuelle Neigung zum anderen Geschlecht habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36ea2602-1f9f-45b5-b213-9f4deb9c3d16",
                                                "sense_id": "34d59303-0848-3d01-887f-9384f63d94f4",
                                                "text": "Die heterosexuellen Neigungen werden im Gegensatz zu den homosexuellen nur äußert selten hinterfragt, sondern viel mehr als Norm betrachtet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2d34c87-c017-4e31-a851-0a559a2e2c04",
                        "source_entry_id": "3cc0aad4-629e-3689-8d12-a6469f222cea",
                        "source_sense_id": "d3aa609c-a53a-3e46-adec-34a8bc52757d",
                        "source_sense_description": "gericht op het andere geslacht of betrekking hebbend op liefde voor mensen met een ander geslacht",
                        "target_lang_word": "heterosexual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heterosexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a6a39de-9c5a-3e6c-92b1-4a31cab9b6c8",
                                        "entry_id": "d9f8fd65-8a02-3892-a9a3-4311b7afaa7d",
                                        "glosses": [
                                            "Sexually attracted to members of the opposite sex."
                                        ],
                                        "tags": [
                                            "of a person or other animal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70974229-f054-422d-adb2-0966fca6125d",
                                                "sense_id": "3a6a39de-9c5a-3e6c-92b1-4a31cab9b6c8",
                                                "text": "Thai charter court rules that only heterosexual marriages are constitutional: Same-sex marriage in Thailand will have to wait, as the Constitutional Court ruled unanimously today (Wednesday) that Section 1448 of the Civil and Commercial Code, defining marriage as being a union between a man and a woman, is constitutional."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3a5b262-c50b-301d-b5ea-80c9e383b411",
                                        "entry_id": "d9f8fd65-8a02-3892-a9a3-4311b7afaa7d",
                                        "glosses": [
                                            "Between two people of different sex."
                                        ],
                                        "tags": [
                                            "of a romantic or sexual act or relationship"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c65ec5-55b5-48e5-a04b-f14bcae3b95e",
                                                "sense_id": "a3a5b262-c50b-301d-b5ea-80c9e383b411",
                                                "text": "Early Adolescence. This is the high school period between 14 and 17 years of age. This is a confusing and stressful period for the teenager, because sexual impulses are now quite strong in spite of societal sanctions against heterosexual activity."
                                            },
                                            {
                                                "example_id": "05929f7d-5f9d-4811-b759-5ebd4f8753ff",
                                                "sense_id": "a3a5b262-c50b-301d-b5ea-80c9e383b411",
                                                "text": "On the average, the [bisexual] women’s first heterosexual attraction and experience (at 11.6 and 14.7 years) occurred before their first homosexual attraction and experience (at 16.9 and 21.4 years)."
                                            },
                                            {
                                                "example_id": "d726a846-03e0-4a83-a18c-86bfdb8ac777",
                                                "sense_id": "a3a5b262-c50b-301d-b5ea-80c9e383b411",
                                                "text": "Attempts at eliminating bias against LGBTQ people through education, academically and clinically, often lead to inclusion practices that are “added-on”, i.e., a family therapy course discusses same-sex couples as an addendum lecture at the end of the course, instead of infusing the material throughout the course. Green and Mitchell (2008) ask their readers to imagine authoring an article entitled “Therapy with Heterosexual Couples.”"
                                            },
                                            {
                                                "example_id": "ebbcf042-90ce-4eb4-a36c-22c6f1d00a03",
                                                "sense_id": "a3a5b262-c50b-301d-b5ea-80c9e383b411",
                                                "text": "Mankeeping describes the emotional labor women end up doing in heterosexual relationships. It goes beyond remembering birthdays or coordinating social plans. It means being your partner’s one-man support system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0568a468-5c65-33ae-856c-578fcc23b820",
                                        "entry_id": "d9f8fd65-8a02-3892-a9a3-4311b7afaa7d",
                                        "glosses": [
                                            "Having a sexual desire for the opposite sex seen as unhealthy, including a proclivity for nonreproductive sex."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "heterosexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c43e2a16-6e8e-30bf-b2d6-e272642becd2",
                                        "entry_id": "75d7669c-c273-3f01-a36c-7690f0d00d05",
                                        "glosses": [
                                            "A heterosexual person, or other heterosexual organism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed0661ab-2463-46b3-915d-1c48876e7dbd",
                                                "sense_id": "c43e2a16-6e8e-30bf-b2d6-e272642becd2",
                                                "text": "The laws banning discrimination based on sexual orientation apply to all people, gay and straight alike. If an antistraight boss starts firing heterosexuals, they're protected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b643538-e13b-4ca2-82a6-b4bb758b4d5f",
                        "source_entry_id": "3cc0aad4-629e-3689-8d12-a6469f222cea",
                        "source_sense_id": "d3aa609c-a53a-3e46-adec-34a8bc52757d",
                        "source_sense_description": "gericht op het andere geslacht of betrekking hebbend op liefde voor mensen met een ander geslacht",
                        "target_lang_word": "hétérosexuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hétérosexuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91d0469c-569b-3934-b38d-aaf570a27f05",
                                        "entry_id": "f71c0f70-a47a-31dc-8cbf-08857988436c",
                                        "glosses": [
                                            "Relatif à l’hétérosexualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d29a9774-0a5a-4bb5-96b1-05ead7ab0f2f",
                                                "sense_id": "91d0469c-569b-3934-b38d-aaf570a27f05",
                                                "text": "Pour ma part, je suis hétérosexuel. Mais il faut le reconnaître, le bisexuel a deux fois plus de chances le samedi soir."
                                            },
                                            {
                                                "example_id": "4c71a880-2096-4624-adfc-f2dc3a9fa03e",
                                                "sense_id": "91d0469c-569b-3934-b38d-aaf570a27f05",
                                                "text": "Les rapports hétérosexuels normalisés commandent un type non consensuel de relation, sinon d’affirmation virile, qui est celui de l’empiètement sur autrui."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hétérosexuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca0da3e0-f41e-3af6-bf62-d003a6ab0425",
                                        "entry_id": "6e36c4c9-7d61-3777-8aa7-c2269a631d0c",
                                        "glosses": [
                                            "Personne qui est sexuellement attirée par les personnes d’un genre différent du sien."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75dc4104-eb03-3741-b0e4-0d43f3b52b6e",
                                        "entry_id": "6e36c4c9-7d61-3777-8aa7-c2269a631d0c",
                                        "glosses": [
                                            "Personne qui est sexuellement attirée par les personnes du sexe opposé."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "382e4c57-8ae4-4c38-9e0c-12d50dd3a8ef",
                                                "sense_id": "75dc4104-eb03-3741-b0e4-0d43f3b52b6e",
                                                "text": "Lorsqu’un homosexuel joue le rôle d’un hétérosexuel pour se faire accepter dans un groupe, les autres peuvent plus ou moins le croire, faire semblant de le croire ou jouer à le croire par déférence ou pour l’épargner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
