                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police managed to <w>disarm</w> the suspect before he could cause any harm."
                        },
                        {
                            "text": "The soldiers were ordered to <w>disarm</w> the enemy forces immediately."
                        }
                    ],
                    "synonyms": [
