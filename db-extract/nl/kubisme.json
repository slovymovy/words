                        "entry_id": "1c166387-227b-35bb-b217-d2c73f609c56",
                        "glosses": [
                            "20-eeuwse stroming binnen de beeldende kunst waarin de werkelijkheid op een sterk vereenvoudigde manier wordt weergegeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66bba992-e1e1-41b8-ae46-75916e8013e9",
                                "sense_id": "b3835753-4bbf-3c11-9454-45a15674a61c",
                                "text": "In de beeldhouwkunst van het kubisme is de mensfiguur een geliefd thema."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4dc8385b-1b54-488f-b151-bcd44334d352",
