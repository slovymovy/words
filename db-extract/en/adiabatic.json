                        ]
                    },
                    {
                        "translation_id": "13aef7b6-5035-4b3f-b3bc-a76eb1162573",
                        "source_entry_id": "91e6038d-54b4-3f94-b73c-0226dcad0f6e",
                        "source_sense_description": "occurring without gain or loss of heat",
                        "target_lang_word": "adiabatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adiabatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dd22f29-f343-3b32-9bc7-ac568c8db5fa",
                                        "entry_id": "33a95e0f-4f8b-3a44-a6f6-819c51ef76eb",
                                        "glosses": [
                                            "Se dit d’une transformation d’un système thermodynamique qui se déroule sans aucun échange de chaleur avec l’extérieur, de sorte que l’énergie interne du système ne varie que par le travail échangé avec l’extérieur."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a67cfbf-6075-4d93-8f01-07c203c79287",
                                                "sense_id": "7dd22f29-f343-3b32-9bc7-ac568c8db5fa",
                                                "text": "La compression adiabatique d’un gaz sollicite plus d’énergie que la compression plus lente du gaz. La lenteur permettant l’échange de chaleur avec les parois contenant le gaz et ainsi on tend vers la compression isotherme."
                                            },
                                            {
                                                "example_id": "a7d3076b-916c-460d-9fda-8ffe69797c82",
                                                "sense_id": "7dd22f29-f343-3b32-9bc7-ac568c8db5fa",
                                                "text": "Nous allons préciser dans quels cas on peut s’attendre à ce qu’une réaction soit ou non adiabatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb7eecf-090d-3aac-ba77-d1122d8f928f",
                                        "entry_id": "33a95e0f-4f8b-3a44-a6f6-819c51ef76eb",
                                        "glosses": [
                                            "Se dit d’un matériau ou de la frontière d’un système empêchant tout transfert de chaleur avec l’extérieur, que ce soit par conduction, convection ou rayonnement."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2e9ee87-f22d-4b66-ba8f-03e035040c3d",
                                                "sense_id": "8fb7eecf-090d-3aac-ba77-d1122d8f928f",
                                                "text": "Des exemples classiques concernent l’isolation thermique (paroi adiabatique dans le cas idéal) ou les transferts de chaleur (parois diathermanes dans le cas idéal)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adiabatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f95d337c-d6a1-36bc-92a9-f03fdfebe9e0",
                                        "entry_id": "a18ab425-1c0b-381d-8a64-9433892800fa",
                                        "glosses": [
                                            "Courbe représentant une transformation adiabatique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6eea5af-c28b-4369-9e8b-3b19450c488b",
                                                "sense_id": "f95d337c-d6a1-36bc-92a9-f03fdfebe9e0",
                                                "text": "Le tracé de quelques isothermes superposées à la courbe précédente montre que les adiabatiques décroissent plus rapidement que les isothermes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "812cdc03-8f75-417b-a3f7-e946e066732e",
                        "source_entry_id": "91e6038d-54b4-3f94-b73c-0226dcad0f6e",
                        "source_sense_description": "occurring without gain or loss of heat",
                        "target_lang_word": "adiabatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adiabatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2314215-3f86-3b79-9225-806fc4771447",
                                        "entry_id": "9c72ddb6-4c2d-3aff-87cd-5e23647eb019",
                                        "glosses": [
                                            "ohne Wärmeaustausch ablaufend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "063db8ae-6a10-4f84-9023-16e77192d8c2",
                                                "sense_id": "b2314215-3f86-3b79-9225-806fc4771447",
                                                "text": "Ein adiabatischer Vorgang findet bei rascher vertikaler Bewegung von Luftmassen statt, da wegen der äußerst geringen Wärmeleitung der Luft kein Wärmeaustausch mit der Umgebung erfolgt."
                                            },
                                            {
                                                "example_id": "6c10b11a-fec0-4030-8625-40fdf1e684b4",
                                                "sense_id": "b2314215-3f86-3b79-9225-806fc4771447",
                                                "text": "„Erst LAPLACE erkannte, dass wegen der Schnelligkeit der Druckschwankungen im Medium kein Temperaturausgleich stattfinden kann und der Vorgang nicht als isotherm, sondern als adiabatisch angesehen werden muss.“"
                                            },
                                            {
                                                "example_id": "a3a7765c-f94e-4c7d-8c09-7fc335a334eb",
                                                "sense_id": "b2314215-3f86-3b79-9225-806fc4771447",
                                                "text": "„Die Entropie wird über das Prinzip der adiabatischen Erreichbarkeit definiert.“"
                                            },
                                            {
                                                "example_id": "29212a7e-eaf1-4413-8d50-f6f42989830d",
                                                "sense_id": "b2314215-3f86-3b79-9225-806fc4771447",
                                                "text": "„Je höher das Gemisch durch die Raumverkleinerung komprimiert wird, desto höher der Druck und die Temperatur aufgrund des adiabatischen Prozesses und desto höher der Wirkungsgrad.“"
                                            },
                                            {
                                                "example_id": "463f2ff0-0e75-475e-88d5-abc80ad069ea",
                                                "sense_id": "b2314215-3f86-3b79-9225-806fc4771447",
                                                "text": "„Zum Beispiel sind die Zustandsänderungen (Druck- und Volumenänderungen) eines Mediums beim Durchgang einer Schallwelle adiabatisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
