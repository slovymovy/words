                ],
                "senses": [
                    {
                        "sense_id": "e1f50b00-f5ec-3ed0-b73b-27c2ad804102",
                        "entry_id": "98e811b5-1f7e-3b29-9e66-902cb13ff325",
                        "glosses": [
                            "te zuinig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e221d9d8-b05e-4962-959c-5df68c6a2af7",
                                "sense_id": "e1f50b00-f5ec-3ed0-b73b-27c2ad804102",
                                "text": "De krenterige man doet ook bij strenge vorst de verwarming niet aan."
                            },
                            {
                                "example_id": "4250b5d8-19ab-4c0d-9fb4-84cf7ad7c10f",
                                "sense_id": "e1f50b00-f5ec-3ed0-b73b-27c2ad804102",
                                "text": "De 'krenterige man geeft zijn kinderen nooit eens een mooi cadeau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "042e2712-11a4-4b5d-825d-db7e42b1efe6",
                        "source_entry_id": "98e811b5-1f7e-3b29-9e66-902cb13ff325",
                        "source_sense_id": "e1f50b00-f5ec-3ed0-b73b-27c2ad804102",
                        "target_lang_word": "geizig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geizig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bb13f66-7eb5-3163-9bf9-2d9bc1d9b349",
                                        "entry_id": "662689e0-def8-3769-8cb5-a29695aaa3e7",
                                        "glosses": [
                                            "sehr sparsam; nicht bereit, Geld auszugeben; sehr auf den Preis achtend; seine materiellen Werte zurückhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e7e605c-19ca-49b6-9b59-e1c34212d9eb",
                                                "sense_id": "3bb13f66-7eb5-3163-9bf9-2d9bc1d9b349",
                                                "text": "Er ist nicht geizig."
                                            },
                                            {
                                                "example_id": "13e77ba8-8d9d-4227-9a2b-a2f11445587f",
                                                "sense_id": "3bb13f66-7eb5-3163-9bf9-2d9bc1d9b349",
                                                "text": "Preußens Könige waren bei der Ausstattung ihrer Berliner Uni nicht geizig, aber auch nicht großzügig."
                                            },
                                            {
                                                "example_id": "4d7c56e0-a582-4678-9cd4-953d9feeb237",
                                                "sense_id": "3bb13f66-7eb5-3163-9bf9-2d9bc1d9b349",
                                                "text": "Zu geizig mit ihren Spielergehältern dürfen die Vereine [der amerikanischen National Football League] allerdings auch nicht sein. Von den 167 Millionen Dollar [pro Verein] müssen fast 90 Prozent an die Spieler ausgezahlt werden."
                                            },
                                            {
                                                "example_id": "70c6f697-d6ba-480e-8e1b-35346e1e56a6",
                                                "sense_id": "3bb13f66-7eb5-3163-9bf9-2d9bc1d9b349",
                                                "text": "Zur Duck-Familie gehören auch Donalds geiziger Onkel, der Multi-Milliardär Dagobert Duck, seine Neffen Tick, Trick und Track und Cousin Gustav, der ewige Glückspilz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbd074b5-87fc-4cfd-bbe9-df6e2dc7da50",
                        "source_entry_id": "98e811b5-1f7e-3b29-9e66-902cb13ff325",
                        "source_sense_id": "e1f50b00-f5ec-3ed0-b73b-27c2ad804102",
                        "target_lang_word": "knauserig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knauserig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0697821-44f6-34f7-b678-5d0fbaf3b993",
                                        "entry_id": "824a58af-ec2c-3f4d-8538-eb7ab7bda1af",
                                        "glosses": [
                                            "äußerst sparsam, geizig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7b0efd0-f35c-42fd-b594-3e8f3c71ff5c",
                                                "sense_id": "c0697821-44f6-34f7-b678-5d0fbaf3b993",
                                                "text": "„Doch angesichts der rund 23.000 Todesopfer und bis zu zwei Millionen hilfsbedürftigen Menschen in ihrem Land nach dem verheerenden Wirbelsturm ‚Nargis‘ blieben die Militärmachthaber knauserig.“"
                                            },
                                            {
                                                "example_id": "80a0d8fd-8783-4c0d-99f5-83c719f6f3b2",
                                                "sense_id": "c0697821-44f6-34f7-b678-5d0fbaf3b993",
                                                "text": "„Die Autohersteller haben bereits Stellen gestrichen, und die privaten Banken sind mit Krediten knauserig geworden, nachdem die Ausfallrate im Mai einen Höchststand erreicht hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfbea308-8c94-4b71-994f-41f24e5b8b53",
                        "source_entry_id": "98e811b5-1f7e-3b29-9e66-902cb13ff325",
                        "source_sense_id": "e1f50b00-f5ec-3ed0-b73b-27c2ad804102",
                        "target_lang_word": "stingy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stingy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95bd91d8-3472-3993-840e-233eff8ec12f",
                                        "entry_id": "29b0fb9c-648e-333d-ba04-0fe57197774a",
                                        "glosses": [
                                            "Stinging; able or inclined to sting."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b44ea69-23a0-4bc5-a62e-1a696778492b",
                                                "sense_id": "95bd91d8-3472-3993-840e-233eff8ec12f",
                                                "text": "Bumble bee – Bumble bee / I send to you this sonnet, / But please don't be – Bumble bee / The stingy bee in my bonnet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stingy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c4482f-cb8d-3088-aa45-ce4d0750f846",
                                        "entry_id": "41ef67e6-1f16-33fa-8d4f-48c9cf2a32e1",
                                        "glosses": [
                                            "Unwilling to spend, give, or share; ungenerous; mean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2922a777-259a-42cf-872b-2ed9c6285007",
                                                "sense_id": "b9c4482f-cb8d-3088-aa45-ce4d0750f846",
                                                "text": "\"Well, I'm doing my best to grow,\" said Davy, \"but it's a thing you can't hurry much. If Marilla wasn't so stingy with her jam I believe I'd grow a lot faster.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e4b0658-f8a5-32db-be97-6f7183924bf7",
                                        "entry_id": "41ef67e6-1f16-33fa-8d4f-48c9cf2a32e1",
                                        "glosses": [
                                            "Small, scant, meager, insufficient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "460e8246-7840-45f4-9e72-c3f8609b0cf0",
                                                "sense_id": "6e4b0658-f8a5-32db-be97-6f7183924bf7",
                                                "text": "The realization of this joint oppression is like discovering that the stingy crusts of bread being held out by society have mold on them."
                                            },
                                            {
                                                "example_id": "a14b458a-4d17-4e05-ae44-87491eba484c",
                                                "sense_id": "6e4b0658-f8a5-32db-be97-6f7183924bf7",
                                                "text": "As the moon wheels around Earth every 28 days and shows us a progressively greater and then stingier slice of its sun-lightened face, the distance between the moon and Earth changes, too. At the nearest point along its egg-shaped orbit, its perigee, the moon may be 26,000 miles closer to us than it is at its far point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13736b29-b4c8-44d2-877d-6bb754e093cb",
                        "source_entry_id": "98e811b5-1f7e-3b29-9e66-902cb13ff325",
                        "source_sense_id": "e1f50b00-f5ec-3ed0-b73b-27c2ad804102",
                        "target_lang_word": "miserly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miserly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1231507d-acf7-37cc-aaca-1309ae7e939a",
                                        "entry_id": "5b32250b-0425-35f0-a3bc-ae329005f30b",
                                        "glosses": [
                                            "Like a miser, very or objectionably cautious with money."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "885e4d83-d434-4b77-88ba-7d67bb72b96f",
                                                "sense_id": "1231507d-acf7-37cc-aaca-1309ae7e939a",
                                                "text": "It's something that worries me about the book I'm doing about him... In some ways he's just like the racist caricature of the miserly old Jew."
                                            },
                                            {
                                                "example_id": "4838c1c3-2e2e-46bf-884f-19d0a151f36e",
                                                "sense_id": "1231507d-acf7-37cc-aaca-1309ae7e939a",
                                                "text": "What could be more selfish, more miserly—this in specific is what gnaws at him—than dying childless, terminating the line, subtracting oneself from the great work of generation? Worse than miserly, in fact: unnatural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b35fd6bf-20c8-4d97-b027-04ab5438b045",
                        "source_entry_id": "98e811b5-1f7e-3b29-9e66-902cb13ff325",
