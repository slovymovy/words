                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd70747-ac2b-4b90-ab33-6a33f93d88ad",
                                "sense_id": "17b3138b-54d0-39ea-915c-b9e20589fa2a",
                                "text": "„Der Konsul seufzte und stützte seine Hand auf die Rundung seines Bäuchleins.“"
                            },
                            {
                                "example_id": "2b885288-c78e-41ad-92d0-d59969133317",
                                "sense_id": "17b3138b-54d0-39ea-915c-b9e20589fa2a",
                                "text": "„In Deutschland fallen die paar Pfunde über dem Gürtel nicht auf, in Äthiopien, wo ein Bäuchlein Statussymbol und das untrügliche Zeichen eines gewissen Wohlstands ist, schon.“"
                            },
                            {
                                "example_id": "98ab9d12-7f35-46e5-a0e4-b1aa33ab5538",
                                "sense_id": "17b3138b-54d0-39ea-915c-b9e20589fa2a",
                                "text": "„Ein Franzmann sollte ein Bäuchlein haben wie der Baron de Charlus.“"
                            }
                        ],
