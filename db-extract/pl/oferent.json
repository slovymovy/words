                "senses": [
                    {
                        "sense_id": "980f0c80-6797-3e8f-bb01-70f1adddc2be",
                        "entry_id": "032972c6-f886-3e46-b71d-17e8068f2548",
                        "glosses": [
                            "osoba lub instytucja składająca ofertę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b18389-c2d1-4d7c-8a0d-c653597c5e5a",
                                "sense_id": "980f0c80-6797-3e8f-bb01-70f1adddc2be",
                                "text": "Zgodnie z warunkami przetargu to właśnie oferenci mieli złożyć propozycję stawki czynszu, która była głównym kryterium oceny oferty w ogłoszonym przetargu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fef7a9ab-91ea-4ea1-b084-0fe72c8d6542",
                        "source_entry_id": "032972c6-f886-3e46-b71d-17e8068f2548",
                        "source_sense_id": "980f0c80-6797-3e8f-bb01-70f1adddc2be",
                        "target_lang_word": "bidder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bidder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "Someone who bids (all senses), but most commonly, one offers to pay a specified price at an auction"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4396afa5-567e-48db-bf07-1885b0edeb5f",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "The highest bidder shall get the house."
                                            },
                                            {
                                                "example_id": "17e0f737-7436-461c-817f-ed51122de8a1",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "But that is changing; in the coming months, Mr. Gollinger said, his company will hold an auction in a suburban New York community where lenders will help preapprove bidders for mortgages."
                                            },
                                            {
                                                "example_id": "6f6de968-8d7f-45d4-b040-918515176819",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "In 2004, the authority declared Abec a nonresponsible bidder after the company failed to submit accurate information."
                                            },
                                            {
                                                "example_id": "fdee07e7-72a5-4fb0-9aba-a0879976de09",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "In other words, the transaction is preferred because it is the best of bad choices. And at least one study has found that when management preannounces a deal it results in lower premiums presumably because it scares off other bidders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b9db15d-fa47-3b9e-b9db-a95909097368",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "One who commands or orders"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34b50926-e018-31fc-92ad-6f1eda7aaf58",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "One who asks or invites"
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5aab5a96-515d-327b-98f7-82db39505e6a",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "One who begs"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c31237f-530b-412e-82fc-62984ce1253b",
                        "source_entry_id": "032972c6-f886-3e46-b71d-17e8068f2548",
                        "source_sense_id": "980f0c80-6797-3e8f-bb01-70f1adddc2be",
                        "target_lang_word": "offeror",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offeror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c3cc9dc-a889-36a7-ab35-03ac593b670c",
                                        "entry_id": "e1dd76a0-fd52-3b75-857b-370289b41365",
                                        "glosses": [
                                            "One who makes an offer to another; someone who presents something to another for acceptance or rejection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca95ad2-8467-4020-868e-d7a4a7d4a42d",
                                                "sense_id": "8c3cc9dc-a889-36a7-ab35-03ac593b670c",
                                                "text": "A unilateral contract consists of a promise on the part of the offeror and performance of the requisite terms by the offeree."
                                            },
                                            {
                                                "example_id": "cee41787-d6c5-4e10-ad0c-882fe12321b9",
                                                "sense_id": "8c3cc9dc-a889-36a7-ab35-03ac593b670c",
                                                "text": "Acceptance of the offer terminates the power of revocation that the offeror ordinarily has."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c86a005-0d23-452e-ace3-eb25dd346be2",
