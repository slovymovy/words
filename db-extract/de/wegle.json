                "senses": [
                    {
                        "sense_id": "d114e547-a1a3-302f-b32f-dd9a4e9a757a",
                        "entry_id": "c847006a-0d95-359f-8e2e-189c5338b348",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a93ff74-3b7b-44a7-a239-68690c1f34d2",
                                "sense_id": "d114e547-a1a3-302f-b32f-dd9a4e9a757a",
                                "text": "Frau Wegle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "588b5949-5d8a-490c-bce1-06138f4a227b",
                                "sense_id": "d114e547-a1a3-302f-b32f-dd9a4e9a757a",
                                "text": "Herr Wegle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a249683b-a85d-42ee-87ec-601da1f30ef3",
                                "sense_id": "d114e547-a1a3-302f-b32f-dd9a4e9a757a",
                                "text": "Die Wegles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "d5c716ae-69d4-4084-bd29-e00c09893334",
                                "sense_id": "d114e547-a1a3-302f-b32f-dd9a4e9a757a",
                                "text": "Der Wegle trägt nie die Pullover, die die Wegle ihm strickt."
                            },
                            {
                                "example_id": "618aaf29-30a2-4cbb-8245-f34e1e1bf2dc",
                                "sense_id": "d114e547-a1a3-302f-b32f-dd9a4e9a757a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wegle kommt, geht der Herr Wegle.“"
                            },
                            {
                                "example_id": "98d83bf8-6cd9-44f7-9a2a-62d52b8b2f5a",
                                "sense_id": "d114e547-a1a3-302f-b32f-dd9a4e9a757a",
                                "text": "Wegle kommt und geht."
                            },
                            {
                                "example_id": "8eee0f12-bbf0-4376-b333-31686cf7e234",
                                "sense_id": "d114e547-a1a3-302f-b32f-dd9a4e9a757a",
                                "text": "Wegles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
