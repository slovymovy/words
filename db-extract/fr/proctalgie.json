                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14cca76d-ee55-447d-a7e8-7c082ad166f7",
                                "sense_id": "3017fc06-e5ac-382d-922d-91e6c6a84329",
                                "text": "Ce geste peut révéler une proctalgie sous forme d’une douleur élective qui amène, comme dans les trois autres circonstances, une réaction nette, plainte, cri, agitation ou réaction de fuite."
                            },
                            {
                                "example_id": "bee5c6a4-98fa-4476-8afb-7c10ce755f41",
                                "sense_id": "3017fc06-e5ac-382d-922d-91e6c6a84329",
                                "text": "Une migraine insidieuse le cloua d’emblée sur une banquette en galuchat bien trop incommode à ses fesses harcelées de proctalgies en banderilles."
                            }
                        ]
