                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fa5b5ca-4a15-3f37-af62-00fe8030b271",
                                        "entry_id": "cc49c776-bc05-3c05-a3cd-3304f8819599",
                                        "glosses": [
                                            "Steuerung, Führung eines Fahr- oder Flugzeugs über eine bestimmte Route"
                                        ],
                                        "tags": [
                                            "Transport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "727c7f9e-cfec-4944-8a8b-5464e85e138b",
                                                "sense_id": "1fa5b5ca-4a15-3f37-af62-00fe8030b271",
                                                "text": "Die Navigation ist in manchen Gebieten so kompliziert, dass dafür Lotsen eingesetzt werden müssen."
                                            },
                                            {
                                                "example_id": "10eac11c-2747-4e34-8a00-2239d37b599b",
                                                "sense_id": "1fa5b5ca-4a15-3f37-af62-00fe8030b271",
                                                "text": "„Auch eine Reihe praktischer Fragestellungen profitiert von besseren Frequenzstandards, wie die interkontinentale Datenübertragung und die Navigation.“"
                                            },
                                            {
                                                "example_id": "51bc83f4-a8e8-4437-86ff-b7cc6d501b6a",
                                                "sense_id": "1fa5b5ca-4a15-3f37-af62-00fe8030b271",
                                                "text": "„Die tatsächliche Anzahl der Menschen, die ihr Nokia Gerät für die Navigation nutzen und damit einhergehend an ortsbezogener Software interessiert sind, wächst allerdings noch schneller als wir selbst es angenommen haben.“"
                                            },
                                            {
                                                "example_id": "83dc24d7-a618-4249-b4f4-6994502d2f7c",
                                                "sense_id": "1fa5b5ca-4a15-3f37-af62-00fe8030b271",
                                                "text": "„Mit den Jahren entwickelte sich eine große Leidenschaft für die Schifffahrt und die Navigation.“"
                                            },
                                            {
                                                "example_id": "b300e2da-de02-48aa-9d7e-47d32a0e1dbe",
                                                "sense_id": "1fa5b5ca-4a15-3f37-af62-00fe8030b271",
                                                "text": "„Eigentlich war Hamid für die Navigation zuständig, aber ich bemerkte, dass der Kartograf in Jacques seine offensichtliche Inkompetenz nicht länger mitansehen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cfcfca6f-6d20-3ef5-a8b7-3f5c975571c3",
                                        "entry_id": "cc49c776-bc05-3c05-a3cd-3304f8819599",
                                        "glosses": [
                                            "das Navigieren in Informationen"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f8ebaf5-ba48-43eb-8104-64aa69f71222",
                                                "sense_id": "cfcfca6f-6d20-3ef5-a8b7-3f5c975571c3",
                                                "text": "Die Navigation der Seite ist so unübersichtlich, dass deshalb das Produkt am Markt nicht gut angekommen ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
