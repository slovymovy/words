                ],
                "senses": [
                    {
                        "sense_id": "40467bc3-683f-3642-ae7f-1fd5e819c130",
                        "entry_id": "8bf01979-5369-33cd-a35e-87d3eaf6d6a9",
                        "glosses": [
                            "Humaniser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c157e9-45e9-427f-a1b7-a42851430dee",
                                "sense_id": "40467bc3-683f-3642-ae7f-1fd5e819c130",
                                "text": "Blakémi Gamba réussit à ré-humaniser le reggae et en même temps à le remodeler, le \"hip-hopiser\"."
                            },
                            {
                                "example_id": "c7ef2f5a-da08-48c3-8602-8558b6151e90",
                                "sense_id": "40467bc3-683f-3642-ae7f-1fd5e819c130",
                                "text": "Je pense que la justice est déshumanisée et qu’il faut la ré-humaniser dans le sens de l’humain; mais, par exemple, aussi la rendre accessible par toute une série de vocabulaire"
                            },
                            {
                                "example_id": "b06f7496-4576-42f4-be42-4715e2c2498c",
                                "sense_id": "40467bc3-683f-3642-ae7f-1fd5e819c130",
                                "text": "Le nié ou le dénié ne peuvent se ré-humaniser, se ré-individualiser, se ré-identifier qu’en opposant aux négateurs leurs ressources mobilisables à cette fin."
                            }
                        ]
                    }
                ],
