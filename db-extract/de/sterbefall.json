                                "example_id": "0465b957-1cad-44fa-a638-ba884e3c992b",
                                "sense_id": "ece5d2e8-91f2-3e3f-b888-6709f5886d8d",
                                "text": "„Ich hatte zuviel vertrackte Sterbefälle mitangesehen.“"
                            },
                            {
                                "example_id": "0577b745-21ab-4632-b3b3-b716188e606a",
                                "sense_id": "ece5d2e8-91f2-3e3f-b888-6709f5886d8d",
                                "text": "„Für die Beurkundung der Sterbefälle von Häftlingen der ehemaligen deutschen Konzentrationslager ist im Inland das Sonderstandesamt in Bad Arolsen ausschließlich zuständig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
