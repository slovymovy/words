    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4985e54e-e75f-38f1-b79f-a4c05bfe1da5",
                    "sense_definition": "dźwięk uderzenia o siebie metalowych lub szklanych przedmiotów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dźwięk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z oddali słychać było wyraźny <w>szczęk</w> metalowych mieczy.",
                            "target_lang_translations": {
                                "ru": "Издалека был слышен отчетливый <w>лязг</w> металлических мечей."
                            }
                        },
                        {
                            "text": "Głośny <w>szczęk</w> broni przerwał ciszę na polu bitwy.",
                            "target_lang_translations": {
                                "ru": "Громкий <w>лязг</w> оружия нарушил тишину на поле битвы."
                            }
                        }
                    ],
                    "synonyms": [
                        "szczękot"
                    ],
                    "common_phrases": [
                        "szczęk broni",
                        "szczęk metalu"
                    ],
                    "target_lang_definitions": {
                        "ru": "звук удара металлических или стеклянных предметов друг о друга"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лязг",
                                "target_lang_sense_clarification": "резкий, неприятный звук металла о металл"
                            },
                            {
                                "target_lang_word": "бряцание",
                                "target_lang_sense_clarification": "звук ударяющегося оружия или доспехов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7a540130-6cf8-3bc1-a31c-c51c3c9cc23b",
