                    "frequency": "Middle",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Bergsteiger folgten dem schmalen <w>Grat</w> vorsichtig bis zum Gipfel."
                        },
                        {
                            "text": "Auf dem steilen <w>Grat</w> wehte ein eisiger und starker Wind."
                        }
                    ],
                    "synonyms": [
                        "Berggrat",
                        "Gebirgsgrat"
                    ],
                    "antonyms": [
