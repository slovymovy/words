                        "examples": [
                            {
                                "example_id": "495af712-386c-41e8-a13b-d26f97f8e4b0",
                                "sense_id": "4091653a-1699-370d-aa92-6318e38f0adf",
                                "text": "historyczna bimba",
                                "translation": "a historic tram",
                                "english": "a historic tram"
                            },
                            {
                                "example_id": "fecc194e-b6fe-4efa-88b6-a793a30f2514",
                                "sense_id": "4091653a-1699-370d-aa92-6318e38f0adf",
                                "text": "stara bimba",
                                "translation": "an old streetcar",
                                "english": "an old streetcar"
                            },
                            {
                                "example_id": "9de03a56-77a6-42e7-920b-b969179b6c3e",
                                "sense_id": "4091653a-1699-370d-aa92-6318e38f0adf",
                                "text": "zabytkowa bimba",
                                "translation": "an antique tram",
                                "english": "an antique tram"
                            },
                            {
                                "example_id": "1901ea9d-3dab-4fcb-b663-c17cf4e78af5",
                                "sense_id": "4091653a-1699-370d-aa92-6318e38f0adf",
                                "text": "poznańska bimba",
                                "translation": "a Poznań streetcar",
                                "english": "a Poznań streetcar"
                            },
                            {
                                "example_id": "ba7ffa64-fbe6-4e7c-ad7f-de2711e27c0b",
                                "sense_id": "4091653a-1699-370d-aa92-6318e38f0adf",
                                "text": "jeździć/pojeździć bimbą",
                                "translation": "to ride a tram",
                                "english": "to ride a tram"
                            },
                            {
                                "example_id": "c1ac3fb6-8b39-4feb-87e4-b3a1a5b89171",
                                "sense_id": "4091653a-1699-370d-aa92-6318e38f0adf",
                                "text": "przejechać się bimbą",
                                "translation": "to take a ride around on a tram",
                                "english": "to take a ride around on a tram"
                            },
                            {
                                "example_id": "a6bc17c5-9f46-4546-ab9d-e6b5d3e85fca",
                                "sense_id": "4091653a-1699-370d-aa92-6318e38f0adf",
                                "text": "MPK twierdzi, że bimby jeżdżą punktualnie. Tymczasem w środę ok. 13.00 czekałem na Zwierzynieckiej na ,,dwójkę’’, która spóźniła się 10 minut. Tego samego dnia wieczorem na os. Tysiąclecia inna bimba spóźniła się 6 minut. Tamże, w sobotę rano tramwaj nie przyjechał w ogóle lub przyjechał przed czasem. To może zlikwidujmy rozkłady jazdy?",
                                "translation": "The Urban Transportation Company claims that the trams are punctual. Meanwhile on Wednesday around 1 pm I was waiting at Zwierzyniecka number two, which was late by 10 minutes. Later that day in the evening at Millennium estate another tram was late by 6 minutes. At the same place Saturday morning the tram didn't come at all, or came ahead of time. Maybe we should get rid of the timetables?",
                                "english": "The Urban Transportation Company claims that the trams are punctual. Meanwhile on Wednesday around 1 pm I was waiting at Zwierzyniecka number two, which was late by 10 minutes. Later that day in the evening at Millennium estate another tram was late by 6 minutes. At the same place Saturday morning the tram didn't come at all, or came ahead of time. Maybe we should get rid of the timetables?"
                            }
                        ]
