                        "examples": [
                            {
                                "example_id": "4d4d640a-b64e-47e2-b718-a38e372b1714",
                                "sense_id": "bc8d7c22-fe67-3d3b-9664-13694ce5a194",
                                "text": "Laurence Shakya, basée dans la capitale népalaise depuis trente ans et diplômée de l'Institut national des langues et civilisations orientales de Paris (Inalco), traduit les propos qu’il exprime en népali."
                            },
                            {
                                "example_id": "b9fa7121-1c05-4b24-8287-da18797aa864",
                                "sense_id": "bc8d7c22-fe67-3d3b-9664-13694ce5a194",
                                "text": "Les Shaas réussirent à unifier le pay, d’une part en procédant à l’hindouisation de ses diverses ethnies, d’autre part en remplaçant la langue néwari (d’origine tibéto-birmane) par le népali (aussi appelé gorkhali, langue indo-aryenne)."
                            },
                            {
                                "example_id": "ea1104e2-530d-4eb8-b41d-6cc6739eca52",
                                "sense_id": "bc8d7c22-fe67-3d3b-9664-13694ce5a194",
                                "text": "L’hindi rencontre à l’ouest le pendjabi, le sindhi, le goudjerati ; au sud le marathi et l’ouriya ; à l’est le bengali ; au nord le népali."
                            }
                        ]
                    }
