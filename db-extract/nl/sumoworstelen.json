                "senses": [
                    {
                        "sense_id": "09dcdd76-527c-3293-8bff-d7110ffbdd41",
                        "entry_id": "37bf0588-bde7-330f-b3f3-def9e43dc7a4",
                        "glosses": [
                            "traditioneel Japanse worstelen, meestal beoefend door zeer zwaarlijvige mannen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "159f7479-25f1-47c2-ab54-97332bb49850",
                                "sense_id": "09dcdd76-527c-3293-8bff-d7110ffbdd41",
                                "text": "De Amerikaan Emanuel Yarbrough, die bijna vijfhonderd pond weegt, neemt het in de halve finale van het eerste wereldkampioenschap sumoworstelen voor landenteams op tegen de Fransman Patrice Rognon."
                            },
                            {
                                "example_id": "b155cafe-9b8f-4a07-b450-1e0748be1204",
                                "sense_id": "09dcdd76-527c-3293-8bff-d7110ffbdd41",
                                "text": "Voorts zijn er wedstrijden in het Japansche sumo-worstelen dat zich op Java snel verbreidt."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3bc087e-8b1d-30eb-97b2-3fc224453177",
                        "entry_id": "37bf0588-bde7-330f-b3f3-def9e43dc7a4",
                        "glosses": [
                            "vermaak waarbij mensen gekleed in verzwaarde opblaaspakken de Japanse worstelsport nabootsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a9d40a-b8db-43cb-93ec-1f37187eecb5",
                                "sense_id": "d3bc087e-8b1d-30eb-97b2-3fc224453177",
                                "text": "Veel bekijks trok ook een partijtje sumoworstelen in opblaaspakken."
                            }
                        ]
                    }
