        "fr-extract.jsonl": [
            {
                "entry_id": "cbdb1155-b452-3a3f-bd74-d63f972efbe3",
                "word": "glorieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ce5179fa-4813-38ca-82b4-cd1c8b71607e",
                        "entry_id": "cbdb1155-b452-3a3f-bd74-d63f972efbe3",
                        "glosses": [
                            "D’une manière glorieuse, digne de louanges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "636e60f0-71e9-4935-b0d2-d49402e6e39a",
                                "sense_id": "ce5179fa-4813-38ca-82b4-cd1c8b71607e",
                                "text": "Des fautes si sincèrement reconnues et dans la suite si glorieusement réparées par de fidèles services."
                            },
                            {
                                "example_id": "460da52a-2d2f-4a75-ac5f-44820c032c13",
                                "sense_id": "ce5179fa-4813-38ca-82b4-cd1c8b71607e",
                                "text": "Le vainqueur de Bouvines ne finit pas glorieusement sa carrière illustre."
                            },
                            {
                                "example_id": "b3485568-ed09-4b8e-8055-2621d3591556",
                                "sense_id": "ce5179fa-4813-38ca-82b4-cd1c8b71607e",
                                "text": "Glorieusement est toujours pris en bonne part : il règne glorieusement ; il se tira glorieusement d’un grand danger, d’une mauvaise affaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae94b4f0-f369-4260-b885-f597e488c645",
                        "source_entry_id": "cbdb1155-b452-3a3f-bd74-d63f972efbe3",
                        "source_sense_id": "ce5179fa-4813-38ca-82b4-cd1c8b71607e",
                        "target_lang_word": "gloriously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gloriously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b11acda-2ac1-3251-81cb-59d75690d93c",
                                        "entry_id": "29b4c206-38e7-35cb-853f-c94135001d43",
                                        "glosses": [
                                            "In a glorious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "625709db-19c3-429d-b122-253c1c600019",
                                                "sense_id": "4b11acda-2ac1-3251-81cb-59d75690d93c",
                                                "text": "[…] Tanee was accosted by certain good fellows, friends and boon companions, who condoled with him on his misfortunes—railed against the queen, and finally dragged him away to an illicit vender of spirits, in whose house the party got gloriously mellow."
                                            },
                                            {
                                                "example_id": "c773f540-4510-44d5-9181-06dccf1d8475",
                                                "sense_id": "4b11acda-2ac1-3251-81cb-59d75690d93c",
                                                "text": "'With love shall life roll gloriously on from year to year, like the voice of some great music that hath power to hold the hearer's heart poised on eagles' wings above the sordid shame and folly of the earth.'"
                                            },
                                            {
                                                "example_id": "a4917b54-3040-47f3-93d4-f21d8700b37a",
                                                "sense_id": "4b11acda-2ac1-3251-81cb-59d75690d93c",
                                                "text": "That year when he came to Korea, he was already thirty-one years old. Once while carrying out an emergency repair of a bridge, he volunteered to climb barehanded up a seventeen meter high isolated steel beam. He did so and brought down some materials. In addition, he paid no heed to danger during the flooding and set up floating bridges three times, victoriously completing his mission. To everyone's sorrow, on May 15th, 1952, our hero, while repairing the Qingchuan River Bridge, was gloriously martyred. His company was named the \"Yang Liandi Company\".",
                                                "translation": "Weile Heping",
                                                "english": "Weile Heping"
                                            },
                                            {
                                                "example_id": "db3ef919-7efd-453d-a5a9-65b4f73bc50f",
                                                "sense_id": "4b11acda-2ac1-3251-81cb-59d75690d93c",
                                                "text": "The elimination of [Roger] Federer after [Rafael] Nadal's loss to Lukas Rosol would have created mild panic among the fans of these gloriously gifted but now clearly vulnerable geniuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
