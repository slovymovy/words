                        "entry_id": "b9ec098a-5bb9-3f71-83e5-d0b269adee58",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more coloratura"
                    },
                    {
                        "form_id": "5b072847-8020-4172-9a56-9b12233da903",
                        "entry_id": "b9ec098a-5bb9-3f71-83e5-d0b269adee58",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most coloratura"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa808234-dc2f-3826-ab86-fe986ef4ec9d",
                        "entry_id": "b9ec098a-5bb9-3f71-83e5-d0b269adee58",
                        "glosses": [
                            "Pertaining to coloratura."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8be76ed-ce18-40b6-a3cb-297251165ad9",
                                "sense_id": "aa808234-dc2f-3826-ab86-fe986ef4ec9d",
                                "text": "She has a lighter and more coloratura voice."
                            },
                            {
                                "example_id": "f352395c-16d2-43b6-a0c8-b3eda48fc4a7",
                                "sense_id": "aa808234-dc2f-3826-ab86-fe986ef4ec9d",
                                "text": "I drew a deep breath, this time fortunately unmixed with gin and tonic. I was profoundly stirred. “You mean,” I said, my voice quavering like that of a coloratura soprano, “that I went through that soul-shattering experience all for nothing?”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c630b8d8-a6c9-3eb6-95ed-b37ee383199e",
                "word": "coloratura",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c8755e4e-6731-46bb-925c-71f95a331f4b",
                        "entry_id": "c630b8d8-a6c9-3eb6-95ed-b37ee383199e",
                        "tags": [
                            "plural"
                        ],
                        "form": "coloraturas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66c7d474-6ed8-30de-8ee3-15acf45127a7",
                        "entry_id": "c630b8d8-a6c9-3eb6-95ed-b37ee383199e",
                        "glosses": [
                            "Florid or fancy passages in vocal music."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff266c13-2bb1-4887-9ca7-ccf22880b598",
                                "sense_id": "66c7d474-6ed8-30de-8ee3-15acf45127a7",
                                "text": "The singing is generally excellent, with Simon Keenlyside standing out for his richly vocalized (and amusingly dour) Papageno and Diana Damrau for her spot-on coloratura and genuine venom as the Queen of the Night."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9bbab5d-52e2-3118-90e6-d9fb62196a9d",
                        "entry_id": "c630b8d8-a6c9-3eb6-95ed-b37ee383199e",
                        "glosses": [
                            "A singer of such passages, especially a soprano."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "0ff2113a-72c5-4b50-bdfc-9c61f73dc926",
                                "sense_id": "a9bbab5d-52e2-3118-90e6-d9fb62196a9d",
                                "text": "The middle one, of course, was the coloratura Julia Kristeva, known as the most voluptuous Salome in the business."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3de8250b-bae1-47e2-9843-a3fc22a376eb",
                        "source_entry_id": "c630b8d8-a6c9-3eb6-95ed-b37ee383199e",
                        "source_sense_description": "fancy passage in vocal music",
                        "target_lang_word": "colorature",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
