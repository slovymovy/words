                    "frequency": "Low",
                    "semantic_group_id": "richten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>wendde</w> zich vriendelijk <w>toe</w> naar de nieuwe studenten in de zaal.",
                            "target_lang_translations": {
                                "fr": "Il <w>s'est tourné</w> aimablement <w>vers</w> les nouveaux étudiants dans la salle."
                            }
                        },
                        {
                            "text": "Zij <w>wendde</w> haar blik <w>toe</w> naar het prachtige schilderij aan de muur.",
                            "target_lang_translations": {
