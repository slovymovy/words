                "senses": [
                    {
                        "sense_id": "de34c38d-72ff-339e-8cf2-4c835cfd163f",
                        "entry_id": "e2613351-697f-3956-81f7-19affa3d144d",
                        "glosses": [
                            "dwingend voorschrijven hoe iets moet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b32c400-5934-49ac-b1a7-4055ae075719",
                                "sense_id": "de34c38d-72ff-339e-8cf2-4c835cfd163f",
                                "text": "Ze beweren dat alles op termijn zichzelf zal regulariseren en dat de vertrekkers later toch geen toekomst hadden als profvoetballer."
                            },
                            {
                                "example_id": "c19b8592-af0b-4cd5-bc7a-0f3ddbbf059c",
                                "sense_id": "de34c38d-72ff-339e-8cf2-4c835cfd163f",
                                "text": "Tahri kwam in 2006 aan in België en werkte hier tussen 2008 en 2012 voor een onderaannemer in de schoonmaaksector. Nadat hij in 2009 een positief antwoord kreeg op zijn regularisatiedossier, verloor Tahri de mogelijkheid om zijn verblijf te regulariseren."
                            },
                            {
                                "example_id": "736e46a4-c03e-4461-96a1-006b4b0adddd",
                                "sense_id": "de34c38d-72ff-339e-8cf2-4c835cfd163f",
                                "text": "Dat er zo’n rush was in december, is een gevolg van de stijging van de boetetarieven. Het tarief om fiscaal verjaard kapitaal te regulariseren is sinds 1 januari gestegen van 37 naar 38 procent. Op niet-verjaarde inkomsten is de boete van 22 naar 23 procent gestegen."
                            }
                        ]
                    }
                ],
