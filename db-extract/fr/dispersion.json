        "fr-extract.jsonl": [
            {
                "entry_id": "a1dd2acc-65f0-3237-8d6e-6fb97a9fd867",
                "word": "dispersion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "38e25f4a-e6c9-40b9-a36a-246cc462a798",
                        "entry_id": "a1dd2acc-65f0-3237-8d6e-6fb97a9fd867",
                        "tags": [
