                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef176d8-98e0-43c9-8fc5-34056e8ccb07",
                                                "sense_id": "23a6d794-2c20-3ad5-be25-fa3e5194bbef",
                                                "text": "Faire le mutin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bd4a2d6-3f05-31f3-a84c-8fde03b0b0ec",
                                        "entry_id": "53bfcee5-e66c-3964-8ce0-661fb2d0f3e3",
                                        "glosses": [
                                            "Celui qui participe à une mutinerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb415d0-f252-4f82-89df-59ee388c6d2f",
                                                "sense_id": "6bd4a2d6-3f05-31f3-a84c-8fde03b0b0ec",
                                                "text": "Les mutins durent se soumettre."
                                            },
                                            {
                                                "example_id": "0e579541-97cd-4f34-acab-ade38f38f141",
                                                "sense_id": "6bd4a2d6-3f05-31f3-a84c-8fde03b0b0ec",
                                                "text": "Comme un mutin mis aux fers, je restais immobile, et même l’arrivée d’un boulet rouge n'aurait pu parvenir à me faire avancer ou reculer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
