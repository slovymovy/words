                        "glosses": [
                            "aus Beton bestehendes Fundament eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "265bf6c2-af44-4ebb-9ccf-264dbc7b2e52",
                                "sense_id": "46de5b82-fe5f-3d6d-84a8-710d6cdb9ea0",
                                "text": "„Er sah sich um und bemerkte, dass der Holzhütte ein Teil vom Dach fehlte, dass ihr Betonfundament jedoch trocken war.“"
                            },
                            {
                                "example_id": "4e98f134-dbc8-4047-9f3a-8ac9142e0fdd",
                                "sense_id": "46de5b82-fe5f-3d6d-84a8-710d6cdb9ea0",
                                "text": "„Das Betonfundament und die Treppe, die zur Haustür hinaufführt, sind mit grünen Schimmelflecken überzogen, und zum ersten Mal wird mir klar, dass selbst Beton vermodern kann.“"
                            }
                        ],
