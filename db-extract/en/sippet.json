                        "sense_id": "2b207843-4f8f-3868-bc49-6dfdd519774e",
                        "entry_id": "7ec43cda-e85c-3ec5-bf3a-5a4fd4874b05",
                        "glosses": [
                            "A small piece of something, especially a piece of toast or fried bean eaten with soup or gravy."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "430845f5-d787-409c-bc4b-e279ccf23327",
                                "sense_id": "2b207843-4f8f-3868-bc49-6dfdd519774e",
                                "text": "The best sauce for green geese is the juice of sorrel and sugar, mixed together with a few scladed feaberries and served upon sippets"
                            },
                            {
                                "example_id": "516a9669-f01e-4331-a6c3-6e154ee5d81d",
                                "sense_id": "2b207843-4f8f-3868-bc49-6dfdd519774e",
                                "text": "Then have sippets finely carved, and some slices of French bread in the bottom of the dish, […]."
                            },
                            {
                                "example_id": "f334f9f5-8a07-412a-adf9-46a5765adfcb",
                                "sense_id": "2b207843-4f8f-3868-bc49-6dfdd519774e",
                                "text": "Garnish your dish with sippets, lemon, and a few pickled mushrooms."
                            },
                            {
                                "example_id": "ce89b8a4-46a4-4ef7-ba50-155472af42e7",
                                "sense_id": "2b207843-4f8f-3868-bc49-6dfdd519774e",
                                "text": "Serve with small sippets of bread fried in butter."
                            },
                            {
                                "example_id": "42bb4f64-f141-4e86-ae0a-0209a613a596",
                                "sense_id": "2b207843-4f8f-3868-bc49-6dfdd519774e",
                                "text": "The ghost of Mr. Woodhouse himself may stare and gasp at being told that this awful preparation, this culinary corpse-reviver, apparently suited only to chalcenterous persons or those at the point of death, is a very simple mutton broth with sippets in it."
                            }
                        ]
                    }
