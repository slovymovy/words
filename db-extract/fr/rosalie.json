            {
                "entry_id": "1f6d3e05-8023-3b43-a487-376f20805e08",
                "word": "Rosalie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f3705ae-bb91-3a43-aa34-9e3de3732b50",
                        "entry_id": "1f6d3e05-8023-3b43-a487-376f20805e08",
                        "glosses": [
                            "Nom donné par la marque automobile Citroën à plusieurs modèles entre 1932 et 1938."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "0bc15ad5-6367-4833-b365-ab2fb8bb0e4a",
                                "sense_id": "6f3705ae-bb91-3a43-aa34-9e3de3732b50",
                                "text": "La 8 CV devait passer dans l’histoire de l’automobile sous le nom de Rosalie."
                            },
                            {
                                "example_id": "55b6027c-0b44-4165-a9f2-8871bcd7e3f6",
                                "sense_id": "6f3705ae-bb91-3a43-aa34-9e3de3732b50",
                                "text": "Ce n’est qu’en 1947 qu’il remit en route la Rosalie Citroën qu’il avait achetée d’occasion à Romorantin, en 1936."
                            },
                            {
                                "example_id": "2ea780e8-0f18-4f34-887c-350a72aae0aa",
                                "sense_id": "6f3705ae-bb91-3a43-aa34-9e3de3732b50",
                                "text": "- C'est la voiture que vous nous réservez ? demanda-t-il.\n- Non pas ! Il vous faudra prendre la vôtre ! dit quelqu’un.\n- La Rosalie, elle est pour transporter l’autre monsieur […]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "111e5cde-8a0a-30cc-941c-d250a7abf98f",
                "word": "rosalie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1fdd02f4-1803-4928-b0c4-4c2ba89e4f63",
                        "entry_id": "111e5cde-8a0a-30cc-941c-d250a7abf98f",
                        "tags": [
                            "plural"
