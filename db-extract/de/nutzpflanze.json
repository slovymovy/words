                                            "An entire oxhide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6efbc688-2f85-32c7-a3f4-8e7e0b12c305",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "Marijuana."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c5c45e-0242-4997-b072-24549289cb1f",
                                                "sense_id": "6efbc688-2f85-32c7-a3f4-8e7e0b12c305",
                                                "text": "Cops, come and try to snatch my crops / These pigs wanna blow my house down"
                                            }
