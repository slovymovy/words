    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1fefdb8b-02ab-3115-b800-33d8007700c6",
                    "sense_definition": "Simple past and past participle of <w>pouch</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He quietly <w>pouched</w> the coins and walked out of the store.",
                            "target_lang_translations": {
                                "es": "Él <w>se embolsilló</w> discretamente las monedas y salió de la tienda."
                            }
                        },
                        {
                            "text": "The squirrel quickly <w>pouched</w> the extra seeds before scampering up the tree.",
                            "target_lang_translations": {
                                "es": "La ardilla rápidamente <w>se guardó en los abazones</w> las semillas adicionales antes de subir corriendo por el árbol."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pasado simple y participio del verbo pouch (embolsillar, guardar en un bolsillo o bolsa)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "embolsilló",
                                "target_lang_sense_clarification": "forma de pasado para guardar algo en el bolsillo"
                            },
                            {
                                "target_lang_word": "se guardó",
                                "target_lang_sense_clarification": "guardar en un bolsillo o lugar pequeño"
                            },
                            {
                                "target_lang_word": "metió en la bolsa",
                                "target_lang_sense_clarification": "almacenar en mejillas o bolsas anatómicas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4b0b5f70-46b2-38ed-b681-89d1386e417d",
                    "sense_definition": "Having a pouch or pocket-like structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kangaroos and koalas are well-known examples of <w>pouched</w> mammals.",
                            "target_lang_translations": {
                                "es": "Los canguros y los koalas son ejemplos bien conocidos de mamíferos <w>marsupiales</w>."
                            }
                        },
                        {
                            "text": "The tailor designed a specialized <w>pouched</w> belt for carrying small hand tools.",
                            "target_lang_translations": {
                                "es": "El sastre diseñó un cinturón especializado <w>con bolsillos</w> para llevar herramientas de mano pequeñas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pouched mammal",
                        "pouched mouse"
                    ],
                    "target_lang_definitions": {
                        "es": "Que tiene una bolsa, marsupio o estructura semejante a un bolsillo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "con bolsa",
                                "target_lang_sense_clarification": "que posee una bolsa o marsupio"
                            },
                            {
                                "target_lang_word": "marsupial",
                                "target_lang_sense_clarification": "referido a mamíferos con marsupio"
                            },
                            {
                                "target_lang_word": "con bolsillos",
                                "target_lang_sense_clarification": "referido a prendas o accesorios provistos de bolsas pequeñas"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}