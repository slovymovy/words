                            "feminine"
                        ],
                        "form": "commandeure"
                    },
                    {
                        "form_id": "60186ba5-5011-4c7a-aca1-36ab12ec3e5b",
                        "entry_id": "c628e138-253a-3fd4-81eb-48b19986aa26",
                        "tags": [
                            "feminine"
                        ],
                        "form": "commanderesse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a404a87-9eba-3726-9ae6-a751d8533472",
                        "entry_id": "c628e138-253a-3fd4-81eb-48b19986aa26",
                        "glosses": [
                            "Personne qui commande, commandant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d452c78-a62d-4cd6-a4d0-5e6c61ff28a3",
                                "sense_id": "6a404a87-9eba-3726-9ae6-a751d8533472",
                                "text": "Arma, ordonna Macaire en grand commandeur, glace pour Madame sur le genou, et glace dans des verres pour tout le monde car nous allons nous servir un petit ouisky."
                            },
                            {
                                "example_id": "3e67eb06-cf20-407c-94d1-5a3932582699",
                                "sense_id": "6a404a87-9eba-3726-9ae6-a751d8533472",
                                "text": "Grand commandeur, titre correspondant à l'un des grades les plus élevés de la hiérarchie maçonnique."
                            }
                        ]
                    },
                    {
                        "sense_id": "01927bd9-f3d6-3b3f-8028-e22a4bad15d6",
                        "entry_id": "c628e138-253a-3fd4-81eb-48b19986aa26",
                        "glosses": [
                            "Grade honorifique dans certains ordres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e90b41b1-b699-4d01-bec4-b2c4d28396d3",
                                "sense_id": "01927bd9-f3d6-3b3f-8028-e22a4bad15d6",
                                "text": "Dans l’ordre de la Légion d’honneur, le grade de commandeur est le troisième."
                            },
                            {
                                "example_id": "39164341-b547-4139-bb22-544b2daa2fba",
                                "sense_id": "01927bd9-f3d6-3b3f-8028-e22a4bad15d6",
                                "text": "— Maintenant, comme il est difficile, j’en conviens, de décider une aussi grosse affaire d’un mot, faites-moi nommer commandeur de la Légion d’honneur ! On verra que vous savez servir vos amis, et c’est une bonne manière pour en acquérir de nouveaux."
                            },
                            {
                                "example_id": "de560eb3-870f-4dd5-86e0-054ccf952d45",
                                "sense_id": "01927bd9-f3d6-3b3f-8028-e22a4bad15d6",
                                "text": "Commandeur de l’ordre du Bain (Angleterre)."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9a5f5cc-8087-3054-b7d4-6e156248aa8d",
                        "entry_id": "c628e138-253a-3fd4-81eb-48b19986aa26",
                        "glosses": [
                            "Chevalier d’un ordre militaire ou hospitalier, pourvu d’une commanderie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d088ef-11a0-42c9-a600-470e87e84d79",
                                "sense_id": "a9a5f5cc-8087-3054-b7d4-6e156248aa8d",
                                "text": "Commandeur de Malte."
                            },
                            {
                                "example_id": "7a5daa5c-a8e9-4765-87ad-9f893de6f8c1",
                                "sense_id": "a9a5f5cc-8087-3054-b7d4-6e156248aa8d",
                                "text": "Commandeur de Saint-Lazare."
                            },
                            {
                                "example_id": "d0d502df-63b8-43f9-bd2a-239fb8e5dcd8",
                                "sense_id": "a9a5f5cc-8087-3054-b7d4-6e156248aa8d",
                                "text": "Commandeur de l’ordre Teutonique."
                            }
                        ]
                    },
                    {
                        "sense_id": "310d6ef4-904a-33b1-9ad6-7cf6e9127e89",
                        "entry_id": "c628e138-253a-3fd4-81eb-48b19986aa26",
                        "glosses": [
                            "Personnage du Don Juan de Molière ou de Mozart."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cefa9c40-02cc-4935-926f-779b35547f99",
                                "sense_id": "310d6ef4-904a-33b1-9ad6-7cf6e9127e89",
                                "text": "La statue du commandeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3888cd0-5c13-3e14-b067-f64757bdfc4f",
                        "entry_id": "c628e138-253a-3fd4-81eb-48b19986aa26",
                        "glosses": [
                            "Genre monospécifique de passereau de la famille des thraupidés (e.g. callistes, tangaras, etc.) et menacé de disparition, arborant une huppe érectile semblable à celle des paroares de couleur noire, une tache gulaire noire, des sourcils jaunes, dont les parties supérieures et inférieures sont vert olive et jaune verdâtre, respectivement, et que l'on rencontre isolément en Argentine, en Uruguay et au Paraguay (genre Gubernatrix)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "616420e9-b3b3-47aa-af2f-54d6da98320b",
                                "sense_id": "a3888cd0-5c13-3e14-b067-f64757bdfc4f",
                                "text": "Le Bruant commandeur. — Gubernatrix cristatella. … — La reproduction du commandeur huppé en volière n'est plus aujourd'hui un fait rare. En isolant le couple, on parvient même à le faire nicher dans des cages un peu spacieuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "a663ffd5-545c-340c-9bb0-1363772acf98",
                        "entry_id": "c628e138-253a-3fd4-81eb-48b19986aa26",
                        "glosses": [
                            "Ancien nom vernaculaire générique du carouge à épaulettes, en usage du xviiiᵉ siècle jusqu’au milieu du xxᵉ siècle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "17e2b2a0-8c15-4b28-a99c-3a9acd239221",
                                "sense_id": "a663ffd5-545c-340c-9bb0-1363772acf98",
                                "text": "C’est ici le véritable acolchi de Fernandès ; il doit son nom de commandeur à la belle marque rouge qu’il a sur la partie antérieure de l’aile, et qui semble avoir quelque rapport avec la marque d’un ordre de chevalerie : elle fait ici d’autant plus d’effet, qu’elle se trouve comme jetée sur un fond d’un noir brillant et lustré ; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "f1f965a0-3706-313f-810b-49c60a33d9c0",
                        "entry_id": "c628e138-253a-3fd4-81eb-48b19986aa26",
                        "glosses": [
                            "Durant l’esclavage le commandeur était chargé de diriger un groupe d’esclaves sur les plantations coloniales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0027fc76-3003-4840-922f-c4f0d15edc6a",
                                "sense_id": "f1f965a0-3706-313f-810b-49c60a33d9c0",
                                "text": "J’avais été coupeur, et jamais je n’avais vu un seul commandeur travailler plus que moi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aa39089-7ca1-4127-9448-3bc581e5c5d3",
                        "source_entry_id": "c628e138-253a-3fd4-81eb-48b19986aa26",
                        "source_sense_description": "personne qui commande",
                        "target_lang_word": "Kommandeur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommandeur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1409bf-97f8-3396-a2b6-452e363af7bd",
                                        "entry_id": "826f7a5c-492d-3599-9f3b-d36e461b552d",
                                        "glosses": [
                                            "Befehlshaber eines Verbandes vom Bataillon bis zur Division"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f5287f-bf63-4f5f-b95b-40491405df89",
                                                "sense_id": "1b1409bf-97f8-3396-a2b6-452e363af7bd",
                                                "text": "Er ist Kommandeur der Division."
                                            },
                                            {
                                                "example_id": "a955430e-492b-4afc-bd00-82fa6206f582",
                                                "sense_id": "1b1409bf-97f8-3396-a2b6-452e363af7bd",
                                                "text": "„Mit der Flucht ihres Kommandeurs ist die Kampfmoral seiner Truppen am Boden.“"
                                            },
                                            {
                                                "example_id": "2cf13031-d9a1-4813-afba-0e0972db3ab9",
                                                "sense_id": "1b1409bf-97f8-3396-a2b6-452e363af7bd",
                                                "text": "„Dank der Strenge und Sorgfalt seines Kommandeurs war das Regiment im Vergleich mit den anderen damals bei Braunau angelangten Regimentern in einem ausgezeichneten Zustande.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba0ffaff-c3cb-4da8-811c-a9f9ad0f7b93",
                        "source_entry_id": "c628e138-253a-3fd4-81eb-48b19986aa26",
