                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c58709-704a-454f-8171-5fa418822a99",
                                "sense_id": "0e865be4-9909-31d5-be89-e8ab8cd2ae72",
                                "text": "Il devait d'abord disposer les volards de noisetiers (« perches » ou « gaulettes ») dont la pose ne revient pas au charpentier. En effet, les gaulettes ne font pas partie de la charpente mais de la toiture."
                            }
