            {
                "entry_id": "b5dfe414-205b-3927-ae13-535cba41b703",
                "word": "rocaille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a596a68-9055-4727-bc2e-15ad7634b42a",
                        "entry_id": "b5dfe414-205b-3927-ae13-535cba41b703",
                        "tags": [
                            "plural"
                        ],
                        "form": "rocailles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a38e6cba-201e-33dd-8a01-4f14c9b08ae3",
                        "entry_id": "b5dfe414-205b-3927-ae13-535cba41b703",
                        "glosses": [
                            "Désigne un terrain couvert de cailloux, un amas de pierres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d724d1-64b4-4022-b828-025d8d072315",
                                "sense_id": "a38e6cba-201e-33dd-8a01-4f14c9b08ae3",
                                "text": "Rien ne peut être cultivé dans cette rocaille."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9d2310f-b5b5-3d9a-b4a2-74103c7fc8a5",
                        "entry_id": "b5dfe414-205b-3927-ae13-535cba41b703",
                        "glosses": [
                            "Décor de pierres érigé dans les jardins pour simuler un style alpestre et dans lesquels sont plantés des végétaux de petites tailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d425495-ed7a-4e31-83df-8957ab0b5e83",
                                "sense_id": "d9d2310f-b5b5-3d9a-b4a2-74103c7fc8a5",
                                "text": "J’ai mis mes succulentes dans une rocaille."
                            },
                            {
                                "example_id": "07cf898a-3df3-49bd-90d0-e84c290dee65",
                                "sense_id": "d9d2310f-b5b5-3d9a-b4a2-74103c7fc8a5",
                                "text": "Les rocailles sont souvent accompagnés de petites cascades, de bassins et de ruisseaux artificiels."
                            }
                        ]
                    },
                    {
                        "sense_id": "4971575e-8e8a-30b0-a07d-9d1833f84e42",
                        "entry_id": "b5dfe414-205b-3927-ae13-535cba41b703",
                        "glosses": [
                            "Morceaux de minéraux, pierres, cailloux que l’on utilisait, associés avec des coquillages, pour construire et décorer des grottes artificielles et des décorations dans les jardins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8ee0665-062f-4f81-9f6a-70d8939260bf",
                                "sense_id": "4971575e-8e8a-30b0-a07d-9d1833f84e42",
                                "text": "C’est, dans un département lointain, une petite propriété que ne décore aucune boule en verre, et où l’œil le mieux exercé ne saurait rencontrer le moindre kiosque japonais, ni le prétentieux bassin de rocailles avec son amour nu en plâtre et son impudique jet d’eau qui retombe."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a78e6e5-5b71-3646-86c4-01e97a40d5de",
                        "entry_id": "b5dfe414-205b-3927-ae13-535cba41b703",
                        "glosses": [
                            "Genre de décoration en usage au XVIIIᵉ siècle, à l’époque de la Régence, dans l’architecture et le mobilier, et interprétant des motifs inspirés de formes de la nature."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "11577f1c-1c26-4996-8be7-3eb1b6d8c914",
                                "sense_id": "5a78e6e5-5b71-3646-86c4-01e97a40d5de",
                                "text": "« On traverse trois grands goûts au XVIIIᵉ siècle : il y a la fin du Louis XIV, la rocaille sous Louis XV, très échevelée, puis un Louis XVI beaucoup plus mesuré, très classicisant. On ne fait pas du tout le ruban ou la feuille d’acanthe de la même manière en 1720 et en 1760 ! », relève le jeune sculpteur."
                            },
                            {
                                "example_id": "67081513-7a00-4401-8c6c-ff47f030823f",
                                "sense_id": "5a78e6e5-5b71-3646-86c4-01e97a40d5de",
                                "text": "Une pendule, des vases de rocaille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "592b0b14-90de-4b29-bbb2-6d1ffdf2c025",
                        "source_entry_id": "b5dfe414-205b-3927-ae13-535cba41b703",
                        "source_sense_id": "d9d2310f-b5b5-3d9a-b4a2-74103c7fc8a5",
                        "source_sense_description": "Décor de pierres dans les jardins.",
                        "target_lang_word": "Steingarten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steingarten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1bd62f31-5828-38ba-9a41-7a148c2f79c4",
                                        "entry_id": "a4bc9537-1be0-3a28-8daf-c65a81254902",
                                        "glosses": [
                                            "Garten mit Alpenpflanzen und Steinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b829a607-0e94-49dd-af33-0abe03e6ca4f",
                                                "sense_id": "1bd62f31-5828-38ba-9a41-7a148c2f79c4",
                                                "text": "„Der nördliche Uferteil im Ausgehenden des mittleren Höhenrückens des Steingartens ist felsig gestaltet und größtenteils durch flach bleibende Koniferen bepflanzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
