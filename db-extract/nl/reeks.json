                "senses": [
                    {
                        "sense_id": "5c572152-8946-30b4-9bd4-e7d0fd67013c",
                        "entry_id": "31e09e17-d814-3ed7-8d4d-38118aa18f00",
                        "glosses": [
                            "een opeenvolgende rij van gebeurtenissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bd1d665-468b-4901-9008-461c0c7d813f",
                                "sense_id": "5c572152-8946-30b4-9bd4-e7d0fd67013c",
                                "text": "De reeks moorden maakte de mensen erg bang."
                            }
                        ]
                    },
                    {
                        "sense_id": "7628e3b8-643a-303b-bd62-969bc1f7e883",
                        "entry_id": "31e09e17-d814-3ed7-8d4d-38118aa18f00",
