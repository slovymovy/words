                                    {
                                        "sense_id": "43325280-371c-3379-9bb7-498b53d9b4f2",
                                        "entry_id": "6534502d-6a91-3232-a30f-d21d8c80cb5b",
                                        "glosses": [
                                            "een meubel dat men kan gebruiken in de tuin en goed bestand is tegen de weersinvloeden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff106f9c-e968-471d-ba52-6999ef6d7096",
                                                "sense_id": "43325280-371c-3379-9bb7-498b53d9b4f2",
                                                "text": "Nou, daarna was het nog net zo hard werken. Ze hadden een winkel in huishoudspullen en speelgoed en tuinmeubelen, dus het was altijd slepen en sjouwen."
                                            },
                                            {
                                                "example_id": "9be6202f-4c61-4f9e-abbb-58c8974f51de",
                                                "sense_id": "43325280-371c-3379-9bb7-498b53d9b4f2",
                                                "text": "De wachttijd voor bellers liep volgens Interpolis op tot ongeveer 35 minuten. Mensen belden vooral over schade aan hun huis. Zo zijn er veel dakpannen afgewaaid. Ook is veel melding gemaakt van bomen op de weg en weggewaaide tuinmeubelen."
                                            }
                                        ]
