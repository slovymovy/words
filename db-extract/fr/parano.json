                        "examples": [
                            {
                                "example_id": "c77c9910-1d00-4ae8-a68e-04144eb05f97",
                                "sense_id": "21c6f0bd-b25b-31af-a5fb-2d0f1f5c439f",
                                "text": "Ce type est complètement parano, on ne peut rien lui dire sans qu'il le prenne mal.",
                                "translation": "That guy is completely paranoid, you can't say anything to him without him taking it the wrong way.",
                                "english": "That guy is completely paranoid, you can't say anything to him without him taking it the wrong way."
                            },
                            {
                                "example_id": "700870f8-754e-4341-a151-f79bb34c1d31",
                                "sense_id": "21c6f0bd-b25b-31af-a5fb-2d0f1f5c439f",
                                "text": "J’sais que l’passé, c’est l’passé\nMais y a qu’à toi qu’j’peux me confier\nTu sais, j’deviens parano des fois\nQuand j’reste seul, direct, je pense à toi\nEt ça fait, \"clic, clic-clic, pan-pan-pan\"\nJ’braque ton petit cœur, ma chérie, t’es trop séduisante (trop séduisante)"
                            }
                        ]
                    }
