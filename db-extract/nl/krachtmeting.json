                "senses": [
                    {
                        "sense_id": "693d1491-24d5-3321-86fd-d26c1253050d",
                        "entry_id": "ec50be06-a5d7-36c5-9860-be9461d4d18e",
                        "glosses": [
                            "de wedstrijd, de strijd, in de natuurkunde kan het ook heel letterlijk het meten van een kracht betekenen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6cff049-e2b7-4ab0-afc3-27c2026a6553",
                                "sense_id": "693d1491-24d5-3321-86fd-d26c1253050d",
                                "text": "Schermutselingen, belegeringen, korte krachtmetingen her en der in Lombardije culmineerden tenslotte in de slag bij Pavia."
                            },
                            {
                                "example_id": "5ca8d14d-63ff-4a21-8237-844133600c39",
                                "sense_id": "693d1491-24d5-3321-86fd-d26c1253050d",
                                "text": "Ik vraag me af of ook de Anasazi hier sportieve wedstrijden hebben gehouden. En op welk moment treden zulke spontane krachtmetingen in de evolutie van de hominiden voor het eerst op?"
                            },
                            {
                                "example_id": "eebbb55c-f96e-4dd8-9f16-5b0823ea9e0e",
                                "sense_id": "693d1491-24d5-3321-86fd-d26c1253050d",
                                "text": "De krachtmetingen toonden aan dat de vliegende vis horizontaal zwevend meer dan vier meter vooruit komt voor elke meter die hij daalt."
                            }
                        ]
                    }
                ],
