                                    {
                                        "sense_id": "939d4c73-5c15-3aff-84c0-00995511bf95",
                                        "entry_id": "ff14a5b9-391e-372c-b5ed-8ee9f30a9e79",
                                        "glosses": [
                                            "von Tau bedeckt, durch Tau feucht geworden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4df1202-527a-484a-8e03-18a76f8563fb",
                                                "sense_id": "939d4c73-5c15-3aff-84c0-00995511bf95",
                                                "text": "„Ich befand mich allein auf der Lichtung und lag im taufeuchten Gras vor dem Konus.“"
                                            },
                                            {
                                                "example_id": "8f09e85b-934d-4a24-bf13-d14584015421",
                                                "sense_id": "939d4c73-5c15-3aff-84c0-00995511bf95",
                                                "text": "„Der Baum trägt Blüten, und die ganze Nacht sind rosa Blütenblätter auf das Auto gerieselt und an der taufeuchten Oberfläche kleben geblieben.“"
                                            },
                                            {
                                                "example_id": "15e8e38b-b0c3-46de-97a0-a96eaba72f2d",
                                                "sense_id": "939d4c73-5c15-3aff-84c0-00995511bf95",
                                                "text": "„Das Diaphragma glänzte, frisch und taufeucht, benetzt mit gesundem Vaginalsekret.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
