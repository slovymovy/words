                    {
                        "sense_id": "3cbf5b92-ad62-3119-a446-1754f2a1bf77",
                        "entry_id": "ba4df257-ce01-31d4-b2a9-399acbe60f40",
                        "glosses": [
                            "teczka z metalowym mechanizmem służącym do spinania luźnych kartek papieru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb9aa831-1435-43f4-a734-3df8d2b170e8",
                                "sense_id": "3cbf5b92-ad62-3119-a446-1754f2a1bf77",
                                "text": "Mock schował kopertę do teczki obok materiałów dowodowych obu zbrodni i kartonowego skoroszytu z raportami swoich podwładnych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8556d1c4-7263-3091-9033-c760f40ba812",
                        "entry_id": "ba4df257-ce01-31d4-b2a9-399acbe60f40",
                        "glosses": [
                            "plik komputerowy zawierający jeden lub więcej arkuszy kalkulacyjnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0146159-9d98-4763-9cc6-edead96b3683",
                                "sense_id": "8556d1c4-7263-3091-9033-c760f40ba812",
                                "text": "Jeśli ilość arkuszy w skoroszycie znacząco wzrośnie, wówczas możemy powiększyć obszar przeznaczony na wyświetlanie kart arkuszy kosztem obszaru poziomego paska przewijania."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
