                ],
                "senses": [
                    {
                        "sense_id": "06b42e27-a007-3e06-bb06-e5fcab10f5e1",
                        "entry_id": "a7c687fe-6705-30c6-aa21-79c0bad7673f",
                        "glosses": [
                            "związany ze chrztem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fb40063-574b-43f2-aa14-c029bc6682ac",
                                "sense_id": "06b42e27-a007-3e06-bb06-e5fcab10f5e1",
                                "text": "W nowej formie rytuału chrzcielnego egzorcyzmy są zredukowane do trudno zauważalnej postaci."
                            },
                            {
                                "example_id": "a2d2144c-d802-45cf-8d71-42ba5fb92c40",
                                "sense_id": "06b42e27-a007-3e06-bb06-e5fcab10f5e1",
                                "text": "Chrzestny będzie trzymał świecę chrzcielną."
                            },
                            {
                                "example_id": "6150700f-b28e-45fd-b752-0f72910144a9",
                                "sense_id": "06b42e27-a007-3e06-bb06-e5fcab10f5e1",
                                "text": "Ksiądz zaintonował litanię chrzcielną."
                            },
                            {
                                "example_id": "65f70b01-82a1-42ba-b3ab-54c88648e676",
                                "sense_id": "06b42e27-a007-3e06-bb06-e5fcab10f5e1",
                                "text": "Ale się nachodzili za ubrankiem chrzcielnym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1307ba8a-06f4-47ee-9d08-220f2793fee4",
                        "source_entry_id": "a7c687fe-6705-30c6-aa21-79c0bad7673f",
                        "source_sense_id": "06b42e27-a007-3e06-bb06-e5fcab10f5e1",
                        "target_lang_word": "baptismal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baptismal",
