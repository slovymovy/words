                ],
                "senses": [
                    {
                        "sense_id": "4c2b40e7-bc65-320d-aafc-605c4827efe2",
                        "entry_id": "4215bf8f-8c41-342e-8d16-7d0b2ccceb8f",
                        "glosses": [
                            "A cocktail made with gin (or vodka) and vermouth, garnished with cocktail onions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "888328a3-925c-4976-9317-6d3cc38c7c6b",
                                "sense_id": "4c2b40e7-bc65-320d-aafc-605c4827efe2",
                                "text": "\"I doubt it, Tommy,\" the Majority Leader said, coming up behind him so unexpectedly that the little Justice jumped and almost spilled his Gibson."
                            },
                            {
                                "example_id": "6ea0e80f-54e1-4d80-ad6c-279659c59b2d",
                                "sense_id": "4c2b40e7-bc65-320d-aafc-605c4827efe2",
                                "text": "I found Willie in the airport bar drinking a Gibson."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f695c26-e1be-36ab-a392-1bf02d6f5296",
                        "entry_id": "4215bf8f-8c41-342e-8d16-7d0b2ccceb8f",
                        "glosses": [
                            "An acoustic or electric guitar made by the Gibson company."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "850f6094-27db-4f95-958f-57cdf4f1b713",
                                "sense_id": "0f695c26-e1be-36ab-a392-1bf02d6f5296",
                                "text": "Many older Gibsons have become collector's items: […] But older Gibsons are also good player's guitars."
                            },
                            {
                                "example_id": "6d34c448-ff30-453e-9905-ace0b6cc74c0",
                                "sense_id": "0f695c26-e1be-36ab-a392-1bf02d6f5296",
                                "text": "We'd like to think that his spirit lives on under the western sky he so loved, strumming his Gibson somewhere and belting out a Woody Guthrie ballad to an audience of coyotes and rabbitbrush."
                            }
                        ]
                    }
