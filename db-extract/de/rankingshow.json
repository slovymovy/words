                                "example_id": "3b3e05f0-15c4-4547-a406-ae04caf3d373",
                                "sense_id": "32830a2d-1ce6-3b96-86e4-719a53775843",
                                "text": "„Moderatorin Nazan Eckes (39) bekommt bei RTL eine Rankingshow.“"
                            },
                            {
                                "example_id": "f2fded99-1034-48ab-9635-04aa6b37c22d",
                                "sense_id": "32830a2d-1ce6-3b96-86e4-719a53775843",
                                "text": "„Sat.1 hat für das kommende Jahr vier neue Folgen der Rankingshow \"Unsere Lieblinge\" angekündigt.“"
                            },
                            {
                                "example_id": "92373b36-36e2-42dd-9a0a-916cf9a97685",
                                "sense_id": "32830a2d-1ce6-3b96-86e4-719a53775843",
                                "text": "„ProSieben unternimmt mit einer über achtstündigen Rankingshow einen weiteren Versuch, zu punkten.“"
                            },
                            {
                                "example_id": "061b53d5-f354-4634-b572-b7e37f74879a",
                                "sense_id": "32830a2d-1ce6-3b96-86e4-719a53775843",
                                "text": "„Vor 20 Jahren strahlte ProSieben die beliebte Rankingshow „Die Nervigsten“ zum ersten Mal aus.“"
                            },
                            {
                                "example_id": "7e105974-e687-4245-ba2a-477416e8371b",
                                "sense_id": "32830a2d-1ce6-3b96-86e4-719a53775843",
                                "text": "„Ab August moderiert sie die neue Rankingshow „Die Unglaublichsten...“, wie eine Sat.1-Sprecherin bestätigte.“"
                            }
                        ],
