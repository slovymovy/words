                                        "entry_id": "669e5275-2f4c-3197-857d-ac346e31781a",
                                        "glosses": [
                                            "Personne qui fait profession de jouer du luth, ou qui, n’étant qu’amateur, en joue avec plus ou moins de talent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3a821ed-7519-495f-bfec-b3e64e49b2c4",
                                                "sense_id": "ff3c3397-6b4c-35ef-836d-f692db87848e",
                                                "text": "Il œuvre en particulier en compagnie de la luthiste Francesca Torelli pour faire revivre la musique ancienne."
                                            },
                                            {
                                                "example_id": "47f54517-c953-481a-afa1-ae276d0cab79",
                                                "sense_id": "ff3c3397-6b4c-35ef-836d-f692db87848e",
                                                "text": "Ce vendredi, la mezzo-soprano Léa Desandre et le luthiste Thomas Dunford joueront et chanteront un mélange hétéroclite, allant d’Erik Satie à Barbara, en passant par le morceau baroque d’Honoré d’Ambruis, Le Doux Silence de nos bois, Françoise Hardy ou encore Debussy."
                                            }
                                        ]
