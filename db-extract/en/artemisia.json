                    {
                        "translation_id": "1eb63575-9f0e-4ecb-b133-cb1ef2dfa3bb",
                        "source_entry_id": "0520e3e6-2830-3f15-87fc-ac73365b22e3",
                        "source_sense_id": "206029ee-ec18-3c76-89ad-9fec430b073f",
