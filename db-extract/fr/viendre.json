                ],
                "senses": [
                    {
                        "sense_id": "e046eafe-d942-3a41-86df-db78f368d940",
                        "entry_id": "2551b692-ae1e-3c94-8535-8da1d872f657",
                        "glosses": [
                            "Venir."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1cd8a33c-76cc-42c5-b17a-201a362f039e",
                                "sense_id": "e046eafe-d942-3a41-86df-db78f368d940",
                                "text": "Je viens, je vins, je viendrai, que je vienne, que je vinsse… Quelle scie ce verbe viendre"
                            },
                            {
                                "example_id": "be3a3958-e0ba-4005-9c97-e11810253dbd",
                                "sense_id": "e046eafe-d942-3a41-86df-db78f368d940",
                                "text": "Deux superbes hétaïres giflent l’espace, look hyper branché, minijupe cuir, collants fluo. Rêve Jeff, rêve, patience ça va venir, tout va viendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "f40aa04e-c4f0-3524-bd6e-022ae077f7f7",
                        "entry_id": "2551b692-ae1e-3c94-8535-8da1d872f657",
                        "glosses": [
                            "Venir."
                        ],
                        "tags": [
                            "childish"
                        ],
                        "examples": [
                            {
                                "example_id": "ec371a1e-7e95-481e-9ae3-a4fb3cf38ecc",
                                "sense_id": "f40aa04e-c4f0-3524-bd6e-022ae077f7f7",
                                "text": "C’est ce qui explique par exemple le fait que les enfants francophones disent volontiers tiendre ou viendre pour tenir ou venir, par une généralisation erronée de verbes comme peindre ou craindre."
                            }
                        ]
                    },
                    {
                        "sense_id": "75ea37f7-aacb-358a-b4fc-2ba9f6c1ff1a",
                        "entry_id": "2551b692-ae1e-3c94-8535-8da1d872f657",
                        "glosses": [
                            "Venir."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "13fae014-b8d5-4578-b0be-961f5b71f454",
                                "sense_id": "75ea37f7-aacb-358a-b4fc-2ba9f6c1ff1a",
                                "text": "Venir se prononce souvent viendre à l’infinitif. De même: convenir. Ex. Tâche de viendre de bonne heure. Ça va me conviendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d4e17be-92bb-394d-b963-1aeb768c97d0",
                        "entry_id": "2551b692-ae1e-3c94-8535-8da1d872f657",
                        "glosses": [
                            "Venir."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "b711c4fa-080c-45a5-b028-e050fd86c904",
                                "sense_id": "5d4e17be-92bb-394d-b963-1aeb768c97d0",
                                "text": "VIENDRE, v. int. Venir. Usage : […] Bon, vas-tu viendre à c’t’heure ?"
                            },
                            {
                                "example_id": "ecfcea73-46f7-4667-bf82-99a425cbba70",
                                "sense_id": "5d4e17be-92bb-394d-b963-1aeb768c97d0",
                                "text": "[…] veindre pour le Loiret central et viendre en bas-manceau et en haut-manceau."
                            }
                        ]
                    }
                ],
