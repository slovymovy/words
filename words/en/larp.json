                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "roleplay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the entire weekend in the woods participating in a <w>LARP</w> based on fantasy novels."
                        },
                        {
                            "text": "Many people find that a <w>LARP</w> is a great way to improve their social and improvisational skills."
                        }
                    ],
                    "common_phrases": [
                        "fantasy larp",
                        "attend a larp"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9464add-6440-318e-bbe8-df3dd42b5df7",
                    "sense_definition": "To pretend to be someone or something else, often in a way that seems insincere or performative.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "roleplay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics often accuse politicians of <w>larping</w> as working-class citizens to gain more votes."
                        },
                        {
                            "text": "He is just <w>larping</w> as a tough guy, but everyone knows he is actually quite gentle."
                        }
                    ],
                    "synonyms": [
                        "pretend",
                        "pose",
                        "impersonate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in a derogatory or critical sense."
                        }
                    ]
                },
                {
                    "sense_id": "3ad63e56-8eaf-3de9-a962-42a647d81806",
                    "sense_definition": "To participate in a live-action roleplaying game.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "roleplay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They enjoy <w>larping</w> on weekends to escape the stress of their daily office jobs."
                        },
                        {
                            "text": "The group decided to <w>larp</w> in the park to celebrate the release of the new game."
                        }
                    ]
                }
            ]
        }
    ]
