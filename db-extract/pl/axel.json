        "pl-extract.jsonl": [
            {
                "entry_id": "c1da36b9-3701-33ea-ae27-ec3dd4688b8f",
                "word": "axel",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b76e6c3-7711-3d33-8099-171be97a2bed",
                        "entry_id": "c1da36b9-3701-33ea-ae27-ec3dd4688b8f",
                        "glosses": [
                            "skok łyżwiarski, w którym łyżwiarz wybija się do przodu z pozycji jednonóż, wykonuje pełny obrót w powietrzu i ląduje na przeciwnej nodze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a13e1112-25f3-4b84-9fdc-66280f57217f",
                                "sense_id": "0b76e6c3-7711-3d33-8099-171be97a2bed",
                                "text": "Zawodniczka wykonała perfekcyjnego podwójnego axla w programie krótkim."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7914762-2ccf-4349-9eb0-d2b6cffa6c3f",
                        "source_entry_id": "c1da36b9-3701-33ea-ae27-ec3dd4688b8f",
                        "source_sense_id": "0b76e6c3-7711-3d33-8099-171be97a2bed",
                        "target_lang_word": "axel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4618ff9-92e2-354f-baf5-d61156640644",
                                        "entry_id": "780be340-20c7-328d-b619-510384bd8ed0",
                                        "glosses": [
                                            "A jump that includes one (or more than one) complete turn and a half turn while in the air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5fa91b4-4305-45e8-95e1-4d36cd3ccd81",
                                                "sense_id": "c4618ff9-92e2-354f-baf5-d61156640644",
                                                "text": "Wylie, however, landed his Olympic axels beautifully and electrified the crowd as he capped a skating career that began at age three in Aspen, Colorado, when he followed two older sisters onto the ice."
                                            },
                                            {
                                                "example_id": "eabcfb71-6181-4f51-ad4c-09579d1c9e2c",
                                                "sense_id": "c4618ff9-92e2-354f-baf5-d61156640644",
                                                "text": "Men had to do triple Axels or at least attempt them with tenacity."
                                            },
                                            {
                                                "example_id": "39d8e7ad-470b-44b0-a4bd-815f8e40ecb2",
                                                "sense_id": "c4618ff9-92e2-354f-baf5-d61156640644",
                                                "text": "[…]King et al. (1994) and King (1997) compared single, double, and triple axels of junior and senior level skaters; Albert and Miller (1996) compared single and double axels of “good” figure skaters;[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "axel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a532b603-4210-3f0f-bdb2-22c5de277348",
                                        "entry_id": "52573ba0-5882-367c-a42e-1b92239273eb",
                                        "glosses": [
                                            "Misspelling of axle."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "084c11d2-af01-4408-b828-6a784e2ea4bb",
                                                "sense_id": "a532b603-4210-3f0f-bdb2-22c5de277348",
                                                "text": "This end of the Axel is to be faſten'd into a Wheel, exactly like thoſe, which are us'd in many Places, for the roaſting Meat."
                                            },
                                            {
                                                "example_id": "735414c2-e59b-4d17-9b87-e9a78a2b0835",
                                                "sense_id": "a532b603-4210-3f0f-bdb2-22c5de277348",
                                                "text": "Ten 4-wheel hose wagons, three with ballbearing axels and one with roller-bearing axels, all manufactured in the city."
                                            },
                                            {
                                                "example_id": "4bd3e321-fb97-4173-ac34-0b9efc676dc5",
                                                "sense_id": "a532b603-4210-3f0f-bdb2-22c5de277348",
                                                "text": "1944, Private and Local Acts Passed by the Legislature of Wisconsin, Publisher not identified, page 627,\nThe gross weight on any 2 or more axels shall not exceed 26,000 pounds plus 1,000 pounds for each foot of distance measured longitudinally to the nearest foot between the foremost and rearmost of the axels under consideration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
