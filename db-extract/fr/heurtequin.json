                        "examples": [
                            {
                                "example_id": "99c165e4-02ae-4a45-80ec-7bf6e369c9a0",
                                "sense_id": "95e0b5d7-8a32-3296-91f1-1d675a57f2fa",
                                "text": "Le train de devant disparaissait presque en entier, et celui de derrière jusqu’au heurtequin de l’essieu."
                            },
