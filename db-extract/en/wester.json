                "senses": [
                    {
                        "sense_id": "4cdad7d7-1e90-3cf4-bd01-84edc4240f4e",
                        "entry_id": "9b2c08a3-dcff-3cf5-a72f-a44453e3a1bd",
                        "glosses": [
                            "To move towards the west"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3920ae48-4101-4893-b432-8b827e0b7489",
                                "sense_id": "4cdad7d7-1e90-3cf4-bd01-84edc4240f4e",
                                "text": "My sun is westering, and the lengthening shadows remind me to work while it is day."
                            },
                            {
                                "example_id": "4e439752-4b6b-4d03-aea4-19a399d780f5",
                                "sense_id": "4cdad7d7-1e90-3cf4-bd01-84edc4240f4e",
                                "text": "The hills rose scarlet and gold to the north of the little town, and the westering sun shone ruddily and mystically on the crude new stone and plaster buildings of the dusty forum and the wooden walls of the circus some distance to the east."
                            },
                            {
                                "example_id": "d7929dbd-b9b4-4b0d-8748-3032197cf451",
                                "sense_id": "4cdad7d7-1e90-3cf4-bd01-84edc4240f4e",
                                "text": "The rainy Pleiads wester,\nOrion plunges prone,"
                            }
                        ]
                    }
