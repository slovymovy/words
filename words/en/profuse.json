            "senses": [
                {
                    "sense_id": "784bec8d-33b3-37d7-b6aa-983038eb24be",
                    "sense_definition": "Existing, given, or produced in large, often excessive, amounts; copious.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter offered his <w>profuse</w> apologies after spilling wine on the customer's jacket.",
                            "target_lang_translations": {
                                "ru": "Официант принёс <w>глубочайшие</w> извинения после того, как пролил вино на пиджак посетителя."
                            }
                        },
                        {
                            "text": "Intense exercise in the summer heat often causes <w>profuse</w> sweating.",
                            "target_lang_translations": {
                                "ru": "Интенсивные упражнения на летней жаре часто вызывают <w>обильное</w> потоотделение."
                            }
                        }
                    ],
                    "synonyms": [
                        "copious",
                        "lavish",
                        "abundant",
                        "plentiful"
                    ],
                    "antonyms": [
                        "meager",
                        "scant",
                        "scarce"
                    ],
                    "common_phrases": [
                        "profuse apologies",
                        "profuse bleeding",
                        "profuse sweating"
                    ],
                    "target_lang_definitions": {
