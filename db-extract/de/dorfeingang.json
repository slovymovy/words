                "senses": [
                    {
                        "sense_id": "a318bdad-7e2a-3e66-a10f-a59c416e10f5",
                        "entry_id": "183c349a-dee6-3436-b353-152ed1a61fd6",
                        "glosses": [
                            "Stelle, an der man eine kleine Siedlung betreten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d73d73cc-291f-4538-81ed-cedbc9148f32",
                                "sense_id": "a318bdad-7e2a-3e66-a10f-a59c416e10f5",
                                "text": "Am Dorfeingang wurden letztes Jahr ein paar Bäumchen gepflanzt."
                            },
                            {
                                "example_id": "aff8528b-bb46-40cc-b59d-c84e14ff574c",
                                "sense_id": "a318bdad-7e2a-3e66-a10f-a59c416e10f5",
                                "text": "In der Nähe des Dorfeingangs befindet sich ein Tante-Emma-Laden."
                            },
                            {
                                "example_id": "b7489b7e-105e-4094-bd83-c16aaa0b7567",
                                "sense_id": "a318bdad-7e2a-3e66-a10f-a59c416e10f5",
                                "text": "„Und er deutete auf das dritte Haus vom Dorfeingang an.“"
                            },
                            {
                                "example_id": "001d151a-26ed-4b24-9fc7-360c8de790d2",
                                "sense_id": "a318bdad-7e2a-3e66-a10f-a59c416e10f5",
                                "text": "„Aber es war doch anders bestimmt, denn unmittelbar vor dem Dorfeingange wurde Cécile, die dem Flusse zunächst ritt, einer im Grase sitzenden Dame, der Malerin, gewahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
