                "senses": [
                    {
                        "sense_id": "cd4eb078-b59f-3a94-90be-68fd0e646935",
                        "entry_id": "00ffc206-6dd0-387d-aee7-05256f271679",
                        "glosses": [
                            "aaneengesloten oppervlakte bedekt met bevroren water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ead11c4-dd72-43d8-89fd-3b4991823f9e",
                                "sense_id": "cd4eb078-b59f-3a94-90be-68fd0e646935",
                                "text": "De hoogste berg van Afrika heeft een hoogte van bijna zes kilometer en heeft drie verschillende ijsvelden: een op de westelijke helling en twee op de top. Sinds 1970 ontstond een gat in het noordelijke ijsveld, dat zich sindsdien steeds verder ontwikkelde."
                            },
                            {
                                "example_id": "15c58469-5741-49eb-95bd-19b362d62347",
                                "sense_id": "cd4eb078-b59f-3a94-90be-68fd0e646935",
                                "text": "De Aisén-regio in het zuiden van Chili is nog bijna onaangeraakt door de mens. Het landschap barst van de prachtige marmergrotten, fjorden, ijsvelden en meren, waaronder het Lago General Carrera, het op een na grootste meer van Zuid-Amerika."
                            },
                            {
                                "example_id": "b769029b-69e4-4d46-a150-84414108b51e",
                                "sense_id": "cd4eb078-b59f-3a94-90be-68fd0e646935",
                                "text": "De klimmers werden op 3 april afgezet op de Knik Glacier, een ijsveld zo'n tachtig kilometer ten oosten van Anchorage. Twee dagen later zou het drietal weer opgehaald worden, maar door de weersomstandigheden kon deze de afgesproken plek niet bereiken."
                            }
                        ]
                    }
