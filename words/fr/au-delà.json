            "senses": [
                {
                    "sense_id": "0a6f86fb-bd35-3f2e-b6a7-c28562406bf2",
                    "sense_definition": "Monde invisible où séjournent les âmes après la mort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certaines personnes affirment pouvoir communiquer avec des esprits venus de l'<w>au-delà</w>."
                        },
                        {
                            "text": "Il espérait retrouver un jour les siens dans un <w>au-delà</w> paisible."
