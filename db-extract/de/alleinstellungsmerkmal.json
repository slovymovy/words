                        "glosses": [
                            "Argument publicitaire unique, argument clé de vente, argument clef de vente, acp, argument clé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e75a113c-0563-40ec-85e9-9a7320716107",
                                "sense_id": "93aec8ba-dc09-3ef4-b845-bf415994ff24",
                                "text": "Das Alleinstellungsmerkmal dieses Produkts, dieser Stadt, dieser Einrichtung etc.",
                                "translation": "L’argument publicitaire unique de ce produit, cette ville, cet établissement, etc."
                            },
                            {
                                "example_id": "53f80b1c-4456-4f9b-8065-e9211b407af0",
                                "sense_id": "93aec8ba-dc09-3ef4-b845-bf415994ff24",
                                "text": "Das Alleinstellungsmerkmal Karlsruhes in der Bundesrepublik Deutschland ist es, dass dort Bundesverfassungsgericht und Bundesgerichtshof ihren Sitz haben.",
                                "translation": "L’argument promotionnel unique de Karlsruhe en République fédérale d’Allemagne est que la Cour constitutionnelle fédérale et la Cour fédérale de justice y ont leurs sièges."
                            }
                        ]
