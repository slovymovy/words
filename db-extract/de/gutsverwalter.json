                "senses": [
                    {
                        "sense_id": "1ab3306a-1ef1-3878-ae6b-9ca894889bf1",
                        "entry_id": "ef928353-55fb-3424-baa6-3d32ba2cec01",
                        "glosses": [
                            "Person, die einen landwirtschaftlichen Grundbesitz (ein Gut) für jemanden verwaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0874b13-93db-48c0-93fa-944c29e23b01",
                                "sense_id": "1ab3306a-1ef1-3878-ae6b-9ca894889bf1",
                                "text": "„Der ehemalige Gutsverwalter Heinz Boxan war nicht zur Berufungsverhandlung erschienen.“"
                            },
                            {
                                "example_id": "e75cd494-c09d-4174-916b-cfc82a3f3798",
                                "sense_id": "1ab3306a-1ef1-3878-ae6b-9ca894889bf1",
                                "text": "„Und vor allem haben sie einen der insgesamt vier Beschuldigten verhaftet, den Gutsverwalter.“"
                            },
                            {
                                "example_id": "a5970fe2-cdf1-4adf-97ab-eaa360cb91cf",
                                "sense_id": "1ab3306a-1ef1-3878-ae6b-9ca894889bf1",
                                "text": "„Helle kochte für alle in der Küche des Gutsverwalters, die Frau Rühlmann freigiebig zur Verfügung stellte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
