                    {
                        "sense_id": "1fac0fb6-961d-39f1-845d-0010fdaaaa9d",
                        "entry_id": "3cdfca3e-d407-304e-b837-be9194a4a9d3",
                        "glosses": [
                            "Maladie des chevaux."
                        ],
                        "tags": [
