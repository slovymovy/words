                "forms": [
                    {
                        "form_id": "fee71cd3-f065-48a6-888d-8993c52e48d6",
                        "entry_id": "c890d8d4-9dd5-359f-971b-5968ccdb2f7b",
                        "tags": [
                            "plural"
                        ],
                        "form": "makeovers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "224a3885-075d-3b6e-ad84-e9edb80fb391",
                        "entry_id": "c890d8d4-9dd5-359f-971b-5968ccdb2f7b",
                        "glosses": [
                            "A major change in the use of something, or in the appearance of something or someone; a radical transformation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c2bef5b-1d03-4083-a55b-348a402dd971",
                                "sense_id": "224a3885-075d-3b6e-ad84-e9edb80fb391",
                                "text": "This room is a mess; it needs a makeover."
                            },
                            {
                                "example_id": "ab349a2b-db1b-47d3-89e0-88ec4a502624",
                                "sense_id": "224a3885-075d-3b6e-ad84-e9edb80fb391",
                                "text": "There was no furniture or carpet to speak of. The wallpaper was peeling off the walls and there was a smell of damp everywhere. It was as if they were living like squatters in their own flat. However, this was no time for a makeover, even a fifteen-minute one like on TV[…]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "191b80ce-bc67-48a5-af59-ca9ea0688f7c",
                        "source_entry_id": "c890d8d4-9dd5-359f-971b-5968ccdb2f7b",
                        "source_sense_id": "224a3885-075d-3b6e-ad84-e9edb80fb391",
                        "source_sense_description": "a major change in use or appearance",
                        "target_lang_word": "relooking",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relooking",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92248b18-d7d4-3358-92c9-d1672a123070",
                                        "entry_id": "b7684a18-d775-3182-b543-d4bb9010612c",
                                        "glosses": [
                                            "Action de relooker."
                                        ],
                                        "tags": [
                                            "Faux anglicisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20dddc52-0cf2-4cfb-a0a0-c726543cb8e4",
                                                "sense_id": "92248b18-d7d4-3358-92c9-d1672a123070",
                                                "text": "Les mouvements anti-IVG, qui ont été créés dans les années 1970-1980 dans tous les pays occidentaux, se sont fait un « relooking » il y a une quinzaine d'années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2379482f-cd06-36dd-a15e-f26d039bc073",
                                        "entry_id": "b7684a18-d775-3182-b543-d4bb9010612c",
                                        "glosses": [
                                            "Résultat de cette action."
                                        ],
                                        "tags": [
                                            "Faux anglicisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d04fc31-b8c8-44e2-b953-1a64d4a133fb",
                                                "sense_id": "2379482f-cd06-36dd-a15e-f26d039bc073",
                                                "text": "Bravo pour ce relooking, design beaucoup plus fresh et aéré, une réussite !"
                                            },
                                            {
                                                "example_id": "e3c87fa1-a1ee-47d8-8803-fc2ee075e0f3",
                                                "sense_id": "2379482f-cd06-36dd-a15e-f26d039bc073",
                                                "text": "En quatre ans, il a grimpé les échelons, et a pu assouvir sa passion. Qui lui coûte cher : ce relooking représente un travail de quatre mois dans un garage spécialisé […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f735e3a7-12e0-3e08-bacc-6514e1903686",
                                        "entry_id": "b7684a18-d775-3182-b543-d4bb9010612c",
                                        "glosses": [
                                            "Fait de regarder avec provocation. référence nécessaire (résoudre le problème) Déformation de reluquer ?"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5774e1d-9310-4980-b941-50dc4f8de67f",
                        "source_entry_id": "c890d8d4-9dd5-359f-971b-5968ccdb2f7b",
                        "source_sense_id": "224a3885-075d-3b6e-ad84-e9edb80fb391",
                        "source_sense_description": "a major change in use or appearance",
                        "target_lang_word": "Umgestaltung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umgestaltung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e68166f7-21cf-3d0d-9fa6-a6675c701f73",
                                        "entry_id": "22c0a5d5-000e-3948-b5c8-ea4e321ecc8e",
                                        "glosses": [
                                            "Handlung, Vorgang, das Erscheinungsbild von etwas zu verändern oder etwas zu reformieren, neu zu konzipieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c7b01f-ef23-458b-abcb-2b3b021c1fde",
                                                "sense_id": "e68166f7-21cf-3d0d-9fa6-a6675c701f73",
                                                "text": "„Milas-Quirin erinnerte an das Planungskonzept, das Stadtentwickler Albert Speer und Partner 2016 im Auftrag des Investors für die Umgestaltung des Gebäudebestands vorgelegt hatte.“"
                                            },
                                            {
                                                "example_id": "c88c0715-035b-42f6-af2e-5711f567cba4",
                                                "sense_id": "e68166f7-21cf-3d0d-9fa6-a6675c701f73",
                                                "text": "„Darüber hinaus wurden schon mehrere Straßennamen für das vor einer grundlegenden Umgestaltung stehende, zwölf Hektar große Gelände gefunden, die allesamt an Frauen erinnern: Vier von ihnen waren wie die Hebamme Margareta Müller, die zwischen 1913 und 1958 in Neu-Isenburg mehr als 2800 Babys auf die Welt gebracht haben soll, eher lokale Größen.“"
                                            },
                                            {
                                                "example_id": "4cd71049-cf28-47bc-9572-4cb61998aad6",
                                                "sense_id": "e68166f7-21cf-3d0d-9fa6-a6675c701f73",
                                                "text": "„Estland, Lettland, Finnland und Bessarabien würden bei ‚einer territorial-politischen Umgestaltung‘ der Sowjetunion zufallen.“"
                                            },
                                            {
                                                "example_id": "668689d6-40c5-4e45-86b4-fa9ecf851f20",
                                                "sense_id": "e68166f7-21cf-3d0d-9fa6-a6675c701f73",
                                                "text": "„Für die Umgestaltung muss der Autoverkehr verringert werden, sagte Straßenplaner Holger Müller.“"
                                            },
                                            {
                                                "example_id": "81761887-7863-4c4d-b466-d9c282fa0c00",
                                                "sense_id": "e68166f7-21cf-3d0d-9fa6-a6675c701f73",
                                                "text": "„Weil daran und an der beabsichtigten Bebauung der durch die Umgestaltung freiwerdenden Gewerbeflächen innerhalb des bisherigen Kreisels auch die Frankfurter interessiert sind, beteiligt sich die Nachbarstadt mit fast neun Millionen Euro an dem Vorhaben, das ursprünglich einmal mit 37 und später dann mit 41 Millionen Euro veranschlagt wurde, aus vielerlei Gründen aber teurer geworden ist.“"
                                            },
                                            {
                                                "example_id": "50b4dfd8-d48f-47af-8572-b40ea58ab5f8",
                                                "sense_id": "e68166f7-21cf-3d0d-9fa6-a6675c701f73",
                                                "text": "„Eine ‚gemeinwirtschaftliche Umgestaltung der Wirtschaft‘ ist so also nicht möglich, wie die Initiative in einem Kurzgutachten selbst einräumt.“"
                                            },
                                            {
                                                "example_id": "68bae8fd-353f-4eaa-ac66-3393f1ec5ee8",
                                                "sense_id": "e68166f7-21cf-3d0d-9fa6-a6675c701f73",
                                                "text": "„Dass es allmählich zu einem Gesinnungswandel, jedenfalls in der Medizin, kommt, ist vornehmlich das Verdienst der Übergewichtschirurgie, einer Umgestaltung des Magen-Darm-Trakts mit dem Ziel, die Aufnahme von Nahrung und teilweise auch deren Verwertung zu begrenzen.“"
                                            },
                                            {
                                                "example_id": "2c0eea7c-1bf0-461f-bba5-a169203c60eb",
                                                "sense_id": "e68166f7-21cf-3d0d-9fa6-a6675c701f73",
                                                "text": "„Bei der Boulevard Lu GmbH, die als Eigentümer ohnehin schätzungsweise 100 Millionen Euro in die Umgestaltung des Komplexes stecken will, rechnet man täglich mit einem Kündigungsschreiben der Signa-Holding.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbd46c58-acff-4ec5-bd4f-1bc1de7c2560",
                        "source_entry_id": "c890d8d4-9dd5-359f-971b-5968ccdb2f7b",
                        "source_sense_id": "224a3885-075d-3b6e-ad84-e9edb80fb391",
                        "source_sense_description": "a major change in use or appearance",
                        "target_lang_word": "Überarbeitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überarbeitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
                                        "entry_id": "c68a3679-d4b2-3c1c-8a80-b80d1cc80e7e",
                                        "glosses": [
                                            "Vorgang oder Ergebnis von Kontrolle und gegebenenfalls Verbesserung bereits erarbeiteter Gegenstände oder Werke (Komposition, Plastik, Text und dergleichen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41af221-994e-47f1-bca6-c1e0ce82dd6c",
                                                "sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
                                                "text": "„Ich fürchte, eine solche Überarbeitung könnte die Authentizität und Aussagekraft beeinträchtigen.“"
                                            },
                                            {
                                                "example_id": "7bc90608-eec9-478c-a54c-faeae4a0b087",
                                                "sense_id": "8f004ea2-95e0-3837-a372-34807dc1566c",
                                                "text": "„Aber auch Wieland ließ in seiner Überarbeitung die Zeile nicht stehen – wie Manches nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a80fb017-286e-36f0-bebc-28f76d539b2b",
                                        "entry_id": "c68a3679-d4b2-3c1c-8a80-b80d1cc80e7e",
                                        "glosses": [
                                            "physische und/oder psychische Überanstrengung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e9d308-ce14-4200-97da-2c7b3c59ee60",
                                                "sense_id": "a80fb017-286e-36f0-bebc-28f76d539b2b",
                                                "text": "Infolge der andauernden Überarbeitung musste sie eine längere Pause einlegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a73502a5-1bb4-4f6e-a1d7-4a99586b2096",
                        "source_entry_id": "c890d8d4-9dd5-359f-971b-5968ccdb2f7b",
                        "source_sense_id": "224a3885-075d-3b6e-ad84-e9edb80fb391",
