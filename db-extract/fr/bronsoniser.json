                ],
                "senses": [
                    {
                        "sense_id": "903a830f-4309-3a8a-8199-ad67c9f2a2b8",
                        "entry_id": "bc862391-107a-35f0-a9a7-ae0e4a320af8",
                        "glosses": [
                            "Jouer de la façon caractéristique de Charles Bronson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69da109e-748d-4718-ab57-da1423372a93",
                                "sense_id": "903a830f-4309-3a8a-8199-ad67c9f2a2b8",
                                "text": "Quant à Charles Bronson, borné, têtu et silencieux, il « bronsonise » à merveille."
                            }
                        ]
                    },
                    {
                        "sense_id": "10fd56ed-399c-3b15-b111-ec4095b5d913",
                        "entry_id": "bc862391-107a-35f0-a9a7-ae0e4a320af8",
                        "glosses": [
                            "Se muer en vengeur implacable."
                        ],
                        "tags": [
                            "broadly",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "8c286a40-afca-418d-9a10-3b9c667ed6ea",
                                "sense_id": "10fd56ed-399c-3b15-b111-ec4095b5d913",
                                "text": "J’ai failli arrêter ma lecture car comme le narrateur l’avoue lui même, à trop se \"bronsoniser\", à se muer en vengeur implacable et non politiquement correct, la saturation pointait le bout du nez."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4bfac03-464d-3191-bb54-38a279ed0f6c",
                        "entry_id": "bc862391-107a-35f0-a9a7-ae0e4a320af8",
                        "glosses": [
                            "Faire mourir, mourir ou disparaitre, en parlant d’une personne ayant connu la célébrité."
                        ],
                        "tags": [
                            "Par plaisanterie",
                            "Jargon internet"
                        ],
                        "examples": [
                            {
                                "example_id": "405ede7c-df63-4bd7-8612-6dbb3922b074",
                                "sense_id": "b4bfac03-464d-3191-bb54-38a279ed0f6c",
                                "text": "Il faut bronsoniser la maitresse."
                            },
                            {
                                "example_id": "2e8ada64-fdf3-4ccb-ba33-95b15204a9c6",
                                "sense_id": "b4bfac03-464d-3191-bb54-38a279ed0f6c",
                                "text": "résolution pour 2005:bronsoniser tous les forumiens!!!!"
                            },
                            {
                                "example_id": "c6e8d68d-e130-41e2-9e91-cbe0f61d1e0e",
                                "sense_id": "b4bfac03-464d-3191-bb54-38a279ed0f6c",
                                "text": "Je croyais qu'il avait été bronsonisé celui-là."
                            }
                        ]
                    }
