                                    {
                                        "sense_id": "dc04ced5-3581-384c-86ea-732634f0c313",
                                        "entry_id": "4c5ab384-6903-3edb-8db7-21a834436aa8",
                                        "glosses": [
                                            "Synonym of transmissible."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f209ef8-0f18-4416-bfe4-ddbe858b03f5",
                                                "sense_id": "dc04ced5-3581-384c-86ea-732634f0c313",
                                                "text": "Had it mutated? Was it contagious? Transmittable to humans?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fab7a1d-a16e-4448-8c7d-c6d058100c04",
                        "source_entry_id": "92a39600-0942-3e13-9cb0-943212fb65db",
                        "source_sense_id": "a4949820-fda2-31d0-8623-093fc1f1745f",
                        "target_lang_word": "contagious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contagious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2312da3f-6748-3d09-a0f7-17fa2c92c66f",
                                        "entry_id": "c6fb1634-243f-3cd8-a769-84d515a5a49e",
                                        "glosses": [
                                            "Easily transmitted to others."
                                        ],
                                        "tags": [
                                            "of a disease"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e1f3d6-2a8c-45e7-bcf1-7fe058fd22cb",
                                                "sense_id": "2312da3f-6748-3d09-a0f7-17fa2c92c66f",
                                                "text": "Last year's flu strain was so contagious that everybody in town got sick!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2051195c-b37c-3511-953a-2e3b0b888f82",
                                        "entry_id": "c6fb1634-243f-3cd8-a769-84d515a5a49e",
                                        "glosses": [
                                            "Easily passed on to others."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e214bf3-bb2c-4226-8117-3f1ece395d35",
                                                "sense_id": "2051195c-b37c-3511-953a-2e3b0b888f82",
                                                "text": "contagious enthusiasm; infectious laughter"
                                            },
                                            {
                                                "example_id": "81216454-65f6-419f-ab07-816c11524af3",
                                                "sense_id": "2051195c-b37c-3511-953a-2e3b0b888f82",
                                                "text": "Wearing jeans was a contagious fad at that time."
                                            },
                                            {
                                                "example_id": "39cb7a0e-b409-4bfe-95b0-148bf83667c1",
                                                "sense_id": "2051195c-b37c-3511-953a-2e3b0b888f82",
                                                "text": "The taverns of our ancestors would ill bear contrasting with the clubs of to-day; but many a gay midnight was past in the former:—midnights, whose mirth has descended even to us; half the jests, whose gaiety is still contagious; half the epigrams, whose point is yet felt, were born of those brief and brilliant hours."
                                            },
                                            {
                                                "example_id": "47d23944-beb4-436f-aff3-fb20b56d7946",
                                                "sense_id": "2051195c-b37c-3511-953a-2e3b0b888f82",
                                                "text": "Cause love is contagious, when it's alright / Love is contagious, when it's alright / Love is alright"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "624af13a-5cf1-3756-a06c-43ba71fe8cb5",
                                        "entry_id": "c6fb1634-243f-3cd8-a769-84d515a5a49e",
                                        "glosses": [
                                            "Having a disease that can be transmitted to another person."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18a1d2f9-bf42-4843-b4c6-396f1250213e",
                                                "sense_id": "624af13a-5cf1-3756-a06c-43ba71fe8cb5",
                                                "text": "They were highly contagious, spreading bacteria to other people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c269f788-4372-3f46-b7ae-f5004f71da82",
                                        "entry_id": "c6fb1634-243f-3cd8-a769-84d515a5a49e",
                                        "glosses": [
                                            "Contiguous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68b79f73-1ede-49f5-9b10-e130af410513",
                                                "sense_id": "c269f788-4372-3f46-b7ae-f5004f71da82",
                                                "text": "In Agypt's land contaygious to the Nile / Old Pharao's daughter went to bathe in style,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e207313a-303d-4c34-b05b-f5660906c31f",
                        "source_entry_id": "92a39600-0942-3e13-9cb0-943212fb65db",
                        "source_sense_id": "a4949820-fda2-31d0-8623-093fc1f1745f",
                        "target_lang_word": "infectious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infectious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31caba06-79b8-3abd-8924-a386b738076f",
                                        "entry_id": "59660f78-b5e6-3245-9331-20060dfe65b9",
                                        "glosses": [
                                            "Caused by an agent that enters the host's body (such as a bacterium, virus, parasite, or prion); often, also, transmitted among hosts via any of various routes (for example, contact, droplet-borne, airborne, waterborne, foodborne, fomite-borne, or bloodborne)."
                                        ],
                                        "tags": [
                                            "of an illness"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d829a39b-0694-42a7-83e9-d95d9d0937d0",
                                                "sense_id": "31caba06-79b8-3abd-8924-a386b738076f",
                                                "text": "Cancer is usually not infectious."
                                            },
                                            {
                                                "example_id": "3ee1bc65-4afb-45b6-bdbd-fc5338e514ec",
                                                "sense_id": "31caba06-79b8-3abd-8924-a386b738076f",
                                                "text": "More infectious diseases like the flu are usually less potent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a4bf046-640e-3237-ba5c-8d08fa2066de",
                                        "entry_id": "59660f78-b5e6-3245-9331-20060dfe65b9",
                                        "glosses": [
                                            "Able to infect others; capable of transmitting pathogens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "541c6cf8-aa14-4dce-b38e-a7dac77574af",
                                                "sense_id": "8a4bf046-640e-3237-ba5c-8d08fa2066de",
                                                "text": "Despite feeling better, the patient is still infectious."
                                            },
                                            {
                                                "example_id": "7fe6ad15-989d-4dde-8a69-e79c112594c2",
                                                "sense_id": "8a4bf046-640e-3237-ba5c-8d08fa2066de",
                                                "text": "I doubt that [saliva] is very infectious ... I don't think this is a normal route of transmission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f576a3a1-7ec2-3526-a901-093a8f238200",
                                        "entry_id": "59660f78-b5e6-3245-9331-20060dfe65b9",
                                        "glosses": [
                                            "Spreading quickly from one person to another."
                                        ],
                                        "tags": [
                                            "of feelings and behaviour"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1a5d6d3-1e63-4b2c-97a9-141e07d4a714",
                                                "sense_id": "f576a3a1-7ec2-3526-a901-093a8f238200",
                                                "text": "Her enthusiasm for work can be really infectious."
                                            },
                                            {
                                                "example_id": "0a9eab8c-0c15-43b3-a220-22650ce3d4b4",
                                                "sense_id": "f576a3a1-7ec2-3526-a901-093a8f238200",
                                                "text": "When Maisie first met Danny, she remembers that he had an infectious laugh and a love for music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371dc47e-48e9-3a38-b2b5-ee0a689853db",
                                        "entry_id": "59660f78-b5e6-3245-9331-20060dfe65b9",
                                        "glosses": [
                                            "Memorable and invoking excitement or interest."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6487307b-c1d6-44e9-b5b1-b7dab18455a3",
                                                "sense_id": "371dc47e-48e9-3a38-b2b5-ee0a689853db",
                                                "text": "Pop music is more infectious than elevator music."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
