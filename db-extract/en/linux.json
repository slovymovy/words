                        "entry_id": "d28f487d-c523-3bd5-a8de-0f2d0b43d615",
                        "glosses": [
                            "The Unix-like open-source computer operating system kernel created by Linus Torvalds in 1991."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
