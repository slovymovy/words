                "senses": [
                    {
                        "sense_id": "2a9b0b27-38c6-39f7-8f7f-31543b9d4fc7",
                        "entry_id": "48a402f7-ea75-37ba-98a7-3028daf27bd8",
                        "glosses": [
                            "To hold in the wrong esteem; to disrespect."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ad0979b6-5f07-4e90-8eef-eba25463aa8c",
                                "sense_id": "2a9b0b27-38c6-39f7-8f7f-31543b9d4fc7",
                                "text": "Whatever man he be that dares to deem True poet's skill to spring of earthly race, I must him tell, that he doth misesteem Their strange estate, and eke himself disgrace By his rude ignorance."
                            },
                            {
                                "example_id": "6353de46-f31e-4141-9ae7-d198dd0aaadb",
                                "sense_id": "2a9b0b27-38c6-39f7-8f7f-31543b9d4fc7",
                                "text": "\"My good friend Sexwolf,\" quoth the Norman, in very tolerable Saxon, “I pray you not so to misesteem us.\""
                            },
                            {
                                "example_id": "985ec1c5-a735-4a98-a73e-0eb13dae51d0",
                                "sense_id": "2a9b0b27-38c6-39f7-8f7f-31543b9d4fc7",
                                "text": "And yet, what does it matter though the low-trailing lights of a decadent literature and a fainéant criticism belittle and misesteem?"
                            }
                        ]
                    }
                ],
