                                        "sense_id": "57e8baaf-ca05-373c-8239-33420d07e9c7",
                                        "entry_id": "83a7e723-8605-3a32-af37-5296bbc2abc8",
                                        "glosses": [
                                            "A close-range shot in which the shooter banks the ball off the backboard from a few feet away."
                                        ],
