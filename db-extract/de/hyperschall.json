                    },
                    {
                        "translation_id": "acc67ab3-792c-4d3d-8450-e45fae921dab",
                        "source_entry_id": "eddaac8b-e16c-3922-8919-05fa34f54041",
                        "source_sense_id": "59a7ef10-9feb-3307-b2b4-2cd6bc64d300",
                        "source_sense_description": "Geschwindigkeit schneller als fünffache Schallgeschwindigkeit",
                        "target_lang_word": "hypersonique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypersonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bea68af-9fc6-3d79-8059-8c3cb5aa08c6",
                                        "entry_id": "1073f4a8-9d77-38f4-be6c-8b5c31b89a85",
                                        "glosses": [
                                            "Hautement supersonique (vitesse supérieure à Mach 5)."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d91f3205-061f-411a-a86e-55361ec0c26e",
                                                "sense_id": "7bea68af-9fc6-3d79-8059-8c3cb5aa08c6",
                                                "text": "L’effort industriel se concentre sur l’achèvement de la configuration d’étape 2 qui implique la mise au point définitive de l’architecture des sous-systèmes spationiques, propulsion et réservoirs de stockage, l’optimisation de la disposition des volumes pressurisés et non pressurisés, l’amélioration de la forme aérodynamique pour remédier aux défauts d’équilibre hypersonique, de stabilité latérale subsonique et à certains problèmes locaux."
                                            },
                                            {
                                                "example_id": "8de399cd-6e5a-4950-89df-9fdccfb64beb",
                                                "sense_id": "7bea68af-9fc6-3d79-8059-8c3cb5aa08c6",
                                                "text": "Le vol de ce jeudi devait permettre de mieux comprendre techniquement le vol hypersonique."
                                            },
                                            {
                                                "example_id": "875e88da-4a68-472e-b249-1cb8c0bc18d2",
                                                "sense_id": "7bea68af-9fc6-3d79-8059-8c3cb5aa08c6",
                                                "text": "On considère qu’un missile ou un planeur est hypersonique si sa trajectoire peut être modifiée en plein vol tout en maintenant une vitesse supérieure à Mach 5, soit 5 fois la vitesse du son, précise Héloïse Fayet, chercheuse à l’Ifri."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hypersonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b96b2dd2-e1f1-3d41-af59-5cc3f7143496",
                                        "entry_id": "0ff191ef-b2a8-3805-aa0b-015d54ce3484",
                                        "glosses": [
                                            "Véhicule hautement supersonique (vitesse supérieure à Mach 5)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6515a2b8-e3a3-4f47-9ffd-18c2bd84eb91",
                                                "sense_id": "b96b2dd2-e1f1-3d41-af59-5cc3f7143496",
                                                "text": "Il paraît que l’hypersonique qui s’est abattu dans le Pacifique a été saboté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b6ddac5-1d44-4240-ab25-358d6c5ffb3c",
                        "source_entry_id": "eddaac8b-e16c-3922-8919-05fa34f54041",
                        "source_sense_id": "59a7ef10-9feb-3307-b2b4-2cd6bc64d300",
                        "source_sense_description": "Geschwindigkeit schneller als fünffache Schallgeschwindigkeit",
                        "target_lang_word": "supersonique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supersonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7401270f-90e9-3f12-81ec-f721b4b3e8f6",
                                        "entry_id": "f91013b1-d583-3ca5-91fb-9e725fac9e75",
                                        "glosses": [
                                            "Supérieur à la vitesse du son."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ee914c-0511-4ac3-acf1-7f8e3d28b422",
                                                "sense_id": "7401270f-90e9-3f12-81ec-f721b4b3e8f6",
                                                "text": "Un véhicule supersonique est un véhicule capable de se déplacer à une vitesse supérieure à la vitesse du son qui est de l'ordre de 343 mètres par seconde (environ 1235 kilomètres par heure ou Mach 1) dans de l'air à 20°C au niveau de la mer."
                                            },
                                            {
                                                "example_id": "9b809055-956d-4f21-9c70-e7876e0c6ee4",
                                                "sense_id": "7401270f-90e9-3f12-81ec-f721b4b3e8f6",
                                                "text": "À côté de ces deux champions du luxe qui caracolent autour de l’héritière de L’Oréal, Serge Dassault, classé 4ᵉ, la joue moins supersonique, en passant néanmoins de 16,1 à 22 milliards, grâce aux ventes d’armes, de Rafale, etc., dans le monde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "supersonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1a23885-27d2-301e-83ec-ca9f6a1c0603",
                                        "entry_id": "7b726f52-cc2d-3139-91c2-be801591aaec",
                                        "glosses": [
                                            "Avion supersonique."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef7aad9-5b1c-4a7a-aa31-8a4ec5b05b47",
                                                "sense_id": "a1a23885-27d2-301e-83ec-ca9f6a1c0603",
                                                "text": "Cinquante ans après le premier vol d’essai du Concorde, le 2 mars 1969, le supersonique fait toujours rêver: plusieurs projets sont en cours aux Etats-Unis mais à l’heure d’exigences environnementales croissantes, le futur avion à très grande vitesse devra se montrer plus silencieux."
                                            },
                                            {
                                                "example_id": "9fe5ee17-ce0c-4ec6-8442-aee234c185c8",
                                                "sense_id": "a1a23885-27d2-301e-83ec-ca9f6a1c0603",
                                                "text": "Alors que le supersonique d’affaires a disparu du paysage avec la faillite d’Aerion en mai 2021, le supersonique de transport de passagers commence à se concrétiser, avec Boom Supersonic qui finalise la conception de son Overture et continue d’engranger des commandes."
                                            },
                                            {
                                                "example_id": "45596840-168e-4417-b69b-f105c3429daa",
                                                "sense_id": "a1a23885-27d2-301e-83ec-ca9f6a1c0603",
                                                "text": "Le 16 août 1995, le Concorde faisait sauter le record du tour du monde le plus rapide à bord d’un avion de ligne. A bord du supersonique se trouvait un mécanicien de Seine-et-Marne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
