                "senses": [
                    {
                        "sense_id": "be91fb6c-9435-3cd7-a4a0-31e92db7787a",
                        "entry_id": "c629a2ed-e76a-346d-933a-8a6d0461cc63",
                        "glosses": [
                            "Angehörige eines germanischen Sammelvolkes, das sich vor allem aus Sachsen und Angeln zusammensetzte und auf den britischen Inseln siedelte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fab757b4-d8c9-4f6c-b839-369a7bc1edbe",
                                "sense_id": "be91fb6c-9435-3cd7-a4a0-31e92db7787a",
                                "text": "„Otto I. war mit der Angelsächsin Edgitha in erster, mit Adelheid von Burgund in zweiter Ehe vermählt gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6f835e3e-f0ce-387c-b177-bf4c7a30c210",
                        "entry_id": "c629a2ed-e76a-346d-933a-8a6d0461cc63",
                        "glosses": [
                            "weibliche Person, die aus England stammt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "949916f4-b5aa-4a7f-9802-66bf76b83106",
                                "sense_id": "6f835e3e-f0ce-387c-b177-bf4c7a30c210",
                                "text": "„Zu dem Zeitpunkt, den ich im Sinne habe, und der ziemlich weit nach Mitternacht gelegen gewesen sein muß, tanzten auf der kleinen Bühne acht oder zehn Personen, aber auch im Saale selbst gab es allerlei Beweglichkeit, und eine Angelsächsin mit Zwicker und langen Zähnen war, ohne daß der Meister sich auch nur um sie gekümmert hätte, aus ihrer Reihe hervorgekommen, um im Mittelgang eine Tarantella aufzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
