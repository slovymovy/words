                        "examples": [
                            {
                                "example_id": "23244932-c70a-4e42-afc8-9743a29189f5",
                                "sense_id": "30bf2a75-b73c-31d9-a774-fd51216049c4",
                                "text": "„Eine Riesenportion Pfirsicheis, eine Einkaufstüte, randvoll mit Mini-Schokoriegeln, sechs Donuts mit Zuckerguss, zwei doppelte Cheeseburger. Das Übliche und bisweilen auch Sperma.“"
                            },
                            {
                                "example_id": "b005ceea-d1b3-4b8c-909b-41a5817d6488",
                                "sense_id": "30bf2a75-b73c-31d9-a774-fd51216049c4",
                                "text": "„Also, soviel ich weiß, essen die Leute schon seit dem ersten Schöpfungstag Bohnen. Adam hat welche gegessen. Er und Eva. Die haben jedes Mal eine Riesenportion verdrückt, und dann haben sie rumgesessen und sich gegenseitig angepupst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
