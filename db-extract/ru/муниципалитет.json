                "translations": [
                    {
                        "translation_id": "83d3c3af-5862-42ac-8fb7-055794cfad19",
                        "source_entry_id": "e72618b5-3500-38c3-98bf-32564d12b591",
                        "target_lang_word": "Munizipalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Munizipalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40f6ae31-26da-38bf-a597-d816c8f138d4",
                                        "entry_id": "6445e8ee-0ba9-3c41-ae47-22cca37bffb7",
                                        "glosses": [
                                            "Obrigkeit einer Stadt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f188e74-f1ea-48ec-84d9-9fed3ee133c5",
                                                "sense_id": "40f6ae31-26da-38bf-a597-d816c8f138d4",
                                                "text": "„Diese Weibel werden von der Munizipalität erwählt und entsetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e2c61b7-5054-4186-8bf7-cefaa1932f72",
                        "source_entry_id": "e72618b5-3500-38c3-98bf-32564d12b591",
                        "target_lang_word": "Gemeinde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemeinde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32c55194-f93a-3447-92a4-17b33dfa20db",
                                        "entry_id": "fabdf922-8cd9-3ded-9e09-2b45aec2d197",
                                        "glosses": [
                                            "gesellschaftliches Gebilde: Gemeinschaft mit höherem Organisationsgrad"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5da604de-b8e5-4f13-a581-dcab0cbac63b",
                                                "sense_id": "32c55194-f93a-3447-92a4-17b33dfa20db",
                                                "text": "Jene Auswanderer bildeten eine brüderliche Gemeinde, trafen sich regelmäßig an ihren Treffpunkten und halfen sich gegenseitig."
                                            },
                                            {
                                                "example_id": "47cb4454-b11c-44d6-a1ce-38a2242ec764",
                                                "sense_id": "32c55194-f93a-3447-92a4-17b33dfa20db",
                                                "text": "„Wenn einer der Dorfbewohner stirbt, verscharren zwei Mitglieder der Gemeinde den Leichnam schnell, dann gehen sie wieder ihrer Arbeit nach.“"
                                            },
                                            {
                                                "example_id": "e8ec752c-e9b5-4b08-a327-7b717858a57f",
                                                "sense_id": "32c55194-f93a-3447-92a4-17b33dfa20db",
                                                "text": "„Am Unterlaufe des Shenandoah hatten sich schon andere Gemeinden angesiedelt, presbyterische Iren zumeist, herbe, düstere Leute, hart und starr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a48c4128-96eb-3053-a3b7-970b775f8b15",
                                        "entry_id": "fabdf922-8cd9-3ded-9e09-2b45aec2d197",
                                        "glosses": [
                                            "allgemeine Bezeichnung für Ortschaft, Stadt, Großgemeinde oder Dorf"
                                        ],
                                        "tags": [
                                            "Verwaltung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478a7f62-95d4-4aaa-84c3-5458a13b93b3",
                                                "sense_id": "a48c4128-96eb-3053-a3b7-970b775f8b15",
                                                "text": "„Die Vereine erfüllen also wichtige Funktionen in der Gemeinde.“"
                                            },
                                            {
                                                "example_id": "578ff494-886b-40e4-818e-09789626ee37",
                                                "sense_id": "a48c4128-96eb-3053-a3b7-970b775f8b15",
                                                "text": "„Im Sommer hatte sie in der Ferienarbeit bei der Gemeinde gearbeitet und den gesamten Lohn auf ein Sparkonto gelegt, um irgendwann genug für die Kamera ihrer Träume zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "52f81f45-36fb-33f6-92d5-89bcdc00d070",
                                        "entry_id": "fabdf922-8cd9-3ded-9e09-2b45aec2d197",
                                        "glosses": [
                                            "unterste Verwaltungseinheit eines Staates"
                                        ],
                                        "tags": [
                                            "Verwaltung"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e3446e94-9a59-34b8-8cf6-44dae50d939f",
                                        "entry_id": "fabdf922-8cd9-3ded-9e09-2b45aec2d197",
                                        "glosses": [
                                            "Gruppe von Personen, die sich mit einer Person, Ideologie oder Organisation identifizieren oder zu einem bestimmten Anlass vereinen"
                                        ],
                                        "tags": [
                                            "Ideologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a755cf80-fe69-447f-8cf4-1d14c4c4b7dd",
                                                "sense_id": "e3446e94-9a59-34b8-8cf6-44dae50d939f",
                                                "text": "Nach dem Gottesdienst trat die Gemeinde ins Freie."
                                            },
                                            {
                                                "example_id": "48a49005-ce5d-46c3-9e95-0f61e1cef7ef",
                                                "sense_id": "e3446e94-9a59-34b8-8cf6-44dae50d939f",
                                                "text": "„Die in der Septuaginta enthaltenen, aber von der jüdischen Gemeinde in den Kanon nicht aufgenommenen Schriften bezeichnet man als Apokryphen, d. h. als verborgene, von der öffentlichen Verbreitung ausgeschlossene Schriften.“"
                                            },
                                            {
                                                "example_id": "50bd38b6-9123-4171-b9ab-e64f2876a0c9",
                                                "sense_id": "e3446e94-9a59-34b8-8cf6-44dae50d939f",
                                                "text": "„Seine liebe Gemeinde erscheint vollzählig zur Beerdigung und weint ehrlich ergriffen, als der Sarg in die Erde gelassen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "033c340c-8f00-3174-a787-6a63fe6c8110",
                                        "entry_id": "fabdf922-8cd9-3ded-9e09-2b45aec2d197",
                                        "glosses": [
                                            "Gemeindeverwaltung, Gemeindeamt; Gebäude, in dem die Verwaltung einer Ortschaft untergebracht ist"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de364e74-0e82-4663-bba3-f95489bbb6f0",
                                                "sense_id": "033c340c-8f00-3174-a787-6a63fe6c8110",
                                                "text": "In der Gemeinde sind auch Kindergarten und Polizei untergebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
