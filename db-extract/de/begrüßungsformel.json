                "senses": [
                    {
                        "sense_id": "b9c7313a-bc0b-3268-9911-f0af387fe7a8",
                        "entry_id": "85a00098-f31a-3aad-8140-0d10e51a99ab",
                        "glosses": [
                            "formelhafter/üblicher Ausdruck, mit dem man sich bei Ankunft grüßt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2947650-d67c-4c09-a5e1-7b7b83b0d29d",
                                "sense_id": "b9c7313a-bc0b-3268-9911-f0af387fe7a8",
                                "text": "„Die Anwesenden tauschten lautstark ihre Begrüßungsformeln aus.“"
                            },
                            {
                                "example_id": "55c507e7-e964-4888-81d1-a1508f2c92d1",
                                "sense_id": "b9c7313a-bc0b-3268-9911-f0af387fe7a8",
                                "text": "„Begrüßungsformeln wurden nun von allen Seiten gewechselt, und die Frauen hatten, in übergroßem Eifer, den neuen Putz der immer wieder neu Hinzukommenden zu mustern, ganz übersehen, daß Mr. Rowson indessen wirklich angekommen war und jetzt plötzlich mit einem freundlichen Gruß mitten unter ihnen stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
