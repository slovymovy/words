{
    "word_family": [
        "exagération",
        "exagérateur",
        "exagérément",
        "exagératif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                    "sense_definition": "Donner à quelque chose plus d'importance, d'ampleur ou d'intensité qu'il n'en a en réalité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes ont tendance à <w>exagérer</w> les faits pour attirer plus de lecteurs."
                        },
                        {
                            "text": "Il <w>exagère</w> toujours la gravité de ses blessures quand il fait du sport."
                        }
                    ],
                    "synonyms": [
                        "accentuer",
                        "grossir",
                        "outrer"
                    ],
                    "antonyms": [
                        "minimiser",
                        "atténuer"
                    ],
                    "common_phrases": [
                        "exagérer les faits",
                        "exagérer les risques"
                    ]
                },
                {
                    "sense_id": "f50328e9-c9c6-308b-a095-e0b3d0e32972",
                    "sense_definition": "Dépasser la mesure acceptable dans ses paroles, ses demandes ou son comportement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu <w>exagères</w> vraiment quand tu me demandes de faire tout ton travail à ta place."
                        },
                        {
                            "text": "Sans <w>exagérer</w>, cette réunion a duré plus de quatre heures sans aucune pause."
                        }
                    ],
                    "synonyms": [
                        "abuser",
                        "charrier",
                        "pousser"
                    ],
                    "common_phrases": [
                        "sans exagérer",
                        "ne pas exagérer"
                    ]
                },
                {
                    "sense_id": "61632b63-ea0e-3310-a83b-d938d3b268bc",
                    "sense_definition": "Se représenter mentalement une situation de manière disproportionnée ou dramatisée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de passer l'examen, elle s'était <w>exagéré</w> la difficulté des questions posées."
                        },
                        {
                            "text": "Il ne faut pas s'<w>exagérer</w> les conséquences d'une simple erreur administrative."
                        }
                    ]
                },
                {
                    "sense_id": "815b02a3-7efd-3ff4-9556-6c8bf05f30d8",
                    "sense_definition": "Mettre fortement en valeur ou faire ressortir avec insistance.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat cherchait à <w>exagérer</w> le préjudice moral subi par sa cliente devant la cour."
                        },
                        {
                            "text": "Le dramaturge choisit d'<w>exagérer</w> ce trait de caractère pour amuser les spectateurs."
                        }
                    ],
                    "synonyms": [
                        "souligner"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Dans le sens de faire ressortir avec insistance"
                        }
                    ]
                }
            ]
        }
    ]
}