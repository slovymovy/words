                            {
                                "target_lang_word": "свистнуть",
                                "target_lang_sense_clarification": "разг., украсть, стянуть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7afee300-4a21-3322-9a0a-2e5340a800b0",
                    "sense_definition": "złożyć komuś życzenia",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na pożegnanie gospodarz <w>pożyczył</w> gościom szczęśliwej drogi.",
                            "target_lang_translations": {
                                "ru": "На прощание хозяин <w>пожелал</w> гостям счастливого пути."
                            }
                        },
                        {
                            "text": "Przybyliśmy, aby <w>pożyczyć</w> wam pomyślności w nowym roku.",
                            "target_lang_translations": {
                                "ru": "Мы пришли, чтобы <w>пожелать</w> вам благополучия в новом году."
                            }
