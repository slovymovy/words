                                        "entry_id": "8dd6f3c6-412e-324f-9677-db4d5e0d9070",
                                        "glosses": [
                                            "A learning disability characterized by significantly below average mathematical ability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb82d9d-5629-44ce-84c7-386d18d49d22",
                                                "sense_id": "6a0ff47f-72e2-3a07-84f7-43e0e983288d",
                                                "text": "Some educators think requiring students with dyscalculia to study math in high school is a mistake because the dyscalculic students are unlikely to be capable of learning math."
                                            }
                                        ]
                                    }
                                ]
