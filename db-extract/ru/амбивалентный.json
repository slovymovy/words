                        "entry_id": "fa44a879-1103-328c-a4a2-30a7faf99e28",
                        "glosses": [
                            "книжн. неоднозначный, двойственный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b911325-b67c-46ea-b34b-8d9f133e390f",
                                "sense_id": "24a46cc1-bdb3-3662-be38-4372cda1d2b9",
                                "text": "Однако позиция правительства в сфере местных финансов носит весьма амбивалентный характер."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "319ee315-a16c-4fac-813f-e4cd29a40803",
                        "source_entry_id": "fa44a879-1103-328c-a4a2-30a7faf99e28",
