                                "example_id": "07064fe0-ab88-4815-924b-7eb5b32f58bc",
                                "sense_id": "37f709b7-39f7-306c-92be-ef9aebcc2f48",
                                "text": "Ex-directrice de l’école de danse de l’Opéra de Paris, Claude Bessy parlera à son sujet d’un « fort caractère »."
                            },
                            {
                                "example_id": "d3ba9126-0e0e-4a22-9448-058a5a54fdf7",
                                "sense_id": "37f709b7-39f7-306c-92be-ef9aebcc2f48",
                                "text": "Les ex-directeurs ou ex-directrices observent alors leurs nouveaux supérieurs du second degré avec des intentions malveillantes."
                            },
                            {
                                "example_id": "0ef0bef4-980d-4ebb-be8f-37e315f07d3c",
                                "sense_id": "37f709b7-39f7-306c-92be-ef9aebcc2f48",
                                "text": "La transaction de 1614, au contraire, obligeait l’hôpital à verser 25 septiers de seigle aux cordelières, ex-directrices de la maison."
                            }
                        ]
                    }
