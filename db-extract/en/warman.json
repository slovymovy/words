                    {
                        "sense_id": "961fee62-45e7-3e0a-8627-7209b755c1ea",
                        "entry_id": "d3a6a577-ce80-37a1-b0f5-ef2cf1751c24",
                        "glosses": [
                            "A warrior."
                        ],
                        "tags": [
                            "archaic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c06ca9a5-57f2-42ac-a41c-9199bb89b87c",
                                "sense_id": "961fee62-45e7-3e0a-8627-7209b755c1ea",
                                "text": "The warmen went to the other side of the brook Kubi; they stopped there to deliberate."
                            },
                            {
                                "example_id": "f9824aa2-1fef-4724-ab56-7b3e974f872f",
                                "sense_id": "961fee62-45e7-3e0a-8627-7209b755c1ea",
                                "text": "Our entrance was attended with the usual ceremony, now familiar to the reader: the warmen danced, shot, and shouted, a rabble of adults, youths and boys crowded upon us, the fair sex lulliloo'd with vigor[.]"
                            },
                            {
                                "example_id": "ff6c69e4-e168-4482-8274-a630e3e07636",
                                "sense_id": "961fee62-45e7-3e0a-8627-7209b755c1ea",
                                "text": "The Yusun Clan either fled or surrendered in the face of these huge-boned, bronzed, godlike Warmen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
