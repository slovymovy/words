                                    {
                                        "sense_id": "f32111df-a56a-3994-9dd1-c3657f4b5712",
                                        "entry_id": "ee9ea7c1-45b0-3926-9729-34bf453494f7",
                                        "glosses": [
                                            "onrust veroorzakend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f27bf7f2-15fa-4d5f-9d02-80f23e3dc355",
                                                "sense_id": "f32111df-a56a-3994-9dd1-c3657f4b5712",
                                                "text": "Ik vind dat toch wel een verontrustende ontwikkeling."
                                            },
                                            {
                                                "example_id": "31f57828-b525-4537-86bd-4151263643db",
                                                "sense_id": "f32111df-a56a-3994-9dd1-c3657f4b5712",
                                                "text": "Ik slaap al een hele poos niet goed, niet meer dan een paar rusteloze uren per nacht. Ik lig wakker in het donker, omgeven door een knisperende stilte, nee geen stilte, maar een verontrustende rust."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verontrustend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5394e7e1-4be3-3bf5-9ae4-bf87e421d9cd",
                                        "entry_id": "30e6fe93-d4e3-3cfa-9176-0b1157ef60f5",
                                        "glosses": [
                                            "onvoltooid deelwoord van verontrusten"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12f59ac7-a398-45a1-ba5f-db4037298902",
                                                "sense_id": "5394e7e1-4be3-3bf5-9ae4-bf87e421d9cd",
                                                "text": "Zijn buien van ongeduld waren verontrustend. Het gebrek aan ondernemingslust van de troepen werkte hem op de zenuwen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
