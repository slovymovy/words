                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "6acacb1f-4431-4489-a46c-7d630d0607b2",
                        "entry_id": "2969d00d-9528-3ee9-8a8f-fc97787059ac",
                        "tags": [],
                        "form": "[1] 20e"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d815e40-844b-3f67-904e-f5c0d2d339e5",
                        "entry_id": "2969d00d-9528-3ee9-8a8f-fc97787059ac",
                        "glosses": [
                            "nummer twintig in een rij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a94b2f4-a150-4da2-8701-da875c9fe09a",
                                "sense_id": "2d815e40-844b-3f67-904e-f5c0d2d339e5",
                                "text": "De twintigste eeuw was een tijd van grote conflicten."
                            },
                            {
                                "example_id": "ad3bd75c-bf9b-49f9-8bcc-688e13561b83",
                                "sense_id": "2d815e40-844b-3f67-904e-f5c0d2d339e5",
                                "text": "In de jaren dertig van de twintigste eeuw werden vervolgens de contouren zichtbaar van de sportbeleving en -beoefening zoals we die vandaag de dag kennen."
                            },
                            {
                                "example_id": "df4c09cc-57df-47ad-be70-4a5bf2534f9b",
                                "sense_id": "2d815e40-844b-3f67-904e-f5c0d2d339e5",
                                "text": "Vaker dan een competitie tussen landen, zoals bij de moderne Olympische Spelen vanaf 1896 (hierover meer in het volgende hoofdstuk), was sport in de negentiende en vroege twintigste eeuw een middel tot natievorming binnen landen."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc3e6d70-43b2-352f-a251-43ebefb32fc8",
                        "entry_id": "2969d00d-9528-3ee9-8a8f-fc97787059ac",
                        "glosses": [
                            "gedeeld door twintig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0bb987e-ecd8-4565-8584-d9488b4db2be",
                                "sense_id": "cc3e6d70-43b2-352f-a251-43ebefb32fc8",
                                "text": "Een twintigste van de opbrengst gaat naar het Rode Kruis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6f13ed1-b630-44fc-8f6b-5e04d75e7767",
                        "source_entry_id": "2969d00d-9528-3ee9-8a8f-fc97787059ac",
                        "target_lang_word": "zwanzigste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwanzigste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "372a229b-cf34-3f96-aa21-7e0acb35ebaf",
                                        "entry_id": "1ea3c6ce-c28c-3e0a-9e68-2ae6090f2d1f",
                                        "glosses": [
                                            "nach dem beziehungsweise der neunzehnten kommend; dem einundzwanzigsten vorausgehend"
                                        ],
                                        "tags": [
                                            "Ordnungszahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76cda721-2ef7-4a02-90ce-3d92485dd815",
                                                "sense_id": "372a229b-cf34-3f96-aa21-7e0acb35ebaf",
                                                "text": "„Mit dem zwanzigsten Jahrestag der Wiedervereinigung am Sonntag werden letzte Zinszahlungen in Höhe von fast 200 Millionen Euro für Staatsanleihen fällig, die in den zwanziger Jahren aufgelegt wurden, um die Entschädigungszahlungen Deutschlands nach dem Krieg zu finanzieren.“"
                                            },
                                            {
                                                "example_id": "bfef7bce-b641-4d88-abeb-22ec04e7f1ed",
                                                "sense_id": "372a229b-cf34-3f96-aa21-7e0acb35ebaf",
                                                "text": "„Der Endpunkt der Wanderung, die zwanzigste Quelle, ist der Schelmenborn, der den Burggraben der Schelmenburg in Bergen füllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5b52606-0d05-433d-975f-f8d56a61915c",
                        "source_entry_id": "2969d00d-9528-3ee9-8a8f-fc97787059ac",
                        "target_lang_word": "twentieth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twentieth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b91c6a0-4fef-3dde-bca0-1ac8b68d4195",
                                        "entry_id": "96442f16-08b1-367f-83e7-4fb4d8f46d02",
                                        "glosses": [
                                            "The ordinal form of the number twenty."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75954e3f-d2fd-4786-a8bd-4b9799f5c34b",
                                                "sense_id": "4b91c6a0-4fef-3dde-bca0-1ac8b68d4195",
                                                "text": "As with most twentieth-century Chinese writers, little is known of Ts’ao Yü’s life. Though his ancestral home was Ch’ien-chiang 潛江, Hupei province, he himself was probably born in Tientsin in either 1909 or 1910."
                                            },
                                            {
                                                "example_id": "5ab4c6b8-d15f-465e-8fb3-fc468512296d",
                                                "sense_id": "4b91c6a0-4fef-3dde-bca0-1ac8b68d4195",
                                                "text": "The novel he lends his name to is an account of that life, taking more or less the form of a memoir set down in the years immediately after World War II by an old man mentally preparing for death, not quite at home in the twentieth century (and a little proud of it, stubbornly clinging to his eartrumpet), whose significant memories reach back to the early 1890s and beyond."
                                            },
                                            {
                                                "example_id": "d671071c-31e9-4b17-be14-5d28e9f6aace",
                                                "sense_id": "4b91c6a0-4fef-3dde-bca0-1ac8b68d4195",
                                                "text": "“A shift from jus soli to jus sanguinis has been witnessed in Asia in the course of the twentieth century,” wrote Olivier Vonk at the Maastricht Centre in a 2017 paper."
                                            },
                                            {
                                                "example_id": "3a7db16a-1909-4c20-8344-72cba9b25b49",
                                                "sense_id": "4b91c6a0-4fef-3dde-bca0-1ac8b68d4195",
                                                "text": "But in fact the antinomy of exceptionalism and assimilationism has been there all along, and otherwise puzzling decisions from the nineteenth and twentieth centuries become readily understandable when seen as moments when assimilationism was ascendant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twentieth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "251a4ab6-8768-3a8b-80f3-9705aac4606c",
                                        "entry_id": "7f74fedc-4019-3f34-b6cb-10971063fd70",
                                        "glosses": [
                                            "A person or thing in the twentieth position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ceb14806-d0fe-376a-96d0-9f01dfa34513",
                                        "entry_id": "7f74fedc-4019-3f34-b6cb-10971063fd70",
                                        "glosses": [
                                            "One of twenty equal parts of a whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d9e1b92-9407-43f6-9375-52c90b677fca",
                                                "sense_id": "ceb14806-d0fe-376a-96d0-9f01dfa34513",
                                                "text": "There are some glittering stats out there regarding Brassey: namely that he'd built around one-third of Britain's railways by the time he was in his early 40s, and that by the time of his death (aged 65) he was responsible for around one-twentieth of the world's railways."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82f59b23-e85e-46d8-95d4-8d6e02c1b158",
                        "source_entry_id": "2969d00d-9528-3ee9-8a8f-fc97787059ac",
                        "target_lang_word": "vingtième",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vingtième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c9af22f-8846-327b-887b-d3568e932866",
                                        "entry_id": "7c768c24-575b-39c7-8520-b366ef6bd51e",
                                        "glosses": [
                                            "Qui concerne l’ordinal de 20."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b6f033-3f3b-4864-9772-94c40980a5ea",
                                                "sense_id": "9c9af22f-8846-327b-887b-d3568e932866",
                                                "text": "Vingtième sur la première édition de ce « Rendez-vous en trail inconnu », qui s’était déroulé sur le « magnifique » mont Guillaume, le Haut-Savoyard Karl Sipos conclut : « C’est un vent de fraîcheur dans un monde devenu normé. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vingtième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fc26fca-18a1-33c4-9f58-8c3b259f0938",
                                        "entry_id": "ee02221b-c2fc-3c02-8323-82e16fc6043f",
                                        "glosses": [
                                            "Nombre ordinal qui répond à l’adjectif numéral vingt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "228b8e91-e502-4ecf-8b44-cf3dc3a13e9e",
                                                "sense_id": "2fc26fca-18a1-33c4-9f58-8c3b259f0938",
                                                "text": "Le vingtième précède le vingt-et-unième et suit le dix-neuvième."
                                            },
                                            {
                                                "example_id": "e4cdf80e-c249-4633-b4f9-4df33a8a5521",
                                                "sense_id": "2fc26fca-18a1-33c4-9f58-8c3b259f0938",
                                                "text": "Elle n’est que la vingtième."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8332a071-53da-3c92-952c-1a2ac890ba16",
                                        "entry_id": "ee02221b-c2fc-3c02-8323-82e16fc6043f",
                                        "glosses": [
                                            "Fraction obtenue en divisant vingt fois."
                                        ],
                                        "tags": [
                                            "Au masculin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d761d083-1478-43da-8033-4a033f6b87ac",
                                                "sense_id": "8332a071-53da-3c92-952c-1a2ac890ba16",
                                                "text": "Il est intéressé pour un vingtième dans cette affaire."
                                            },
                                            {
                                                "example_id": "a1796b98-ac9f-41ce-b5a8-305e04a34d10",
                                                "sense_id": "8332a071-53da-3c92-952c-1a2ac890ba16",
                                                "text": "Donnez-moi le vingtième de ces gâteaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "396d8b95-e084-3612-bc23-c4d6b3f11784",
                                        "entry_id": "ee02221b-c2fc-3c02-8323-82e16fc6043f",
                                        "glosses": [
                                            "Impôt établi sur les biens-fonds, et qui était la vingtième partie de leur revenu."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4fc6607-0f99-40dd-8d1f-136cf2f7b8c0",
                                                "sense_id": "396d8b95-e084-3612-bc23-c4d6b3f11784",
                                                "text": "Bourgeois et manants acquittaient la taille, la capitation, les vingtièmes, les aides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
