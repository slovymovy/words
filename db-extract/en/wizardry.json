                        "entry_id": "8da3ac2b-abc3-3c18-93bf-540d36fcdd3d",
                        "glosses": [
                            "The art of a wizard; sorcery."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7f672ff6-9afa-3841-9fa4-6964cc7e49d8",
                        "entry_id": "8da3ac2b-abc3-3c18-93bf-540d36fcdd3d",
                        "glosses": [
                            "Something, such as an advanced technology, that gives the appearance of magic."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8fb0eca1-f537-4678-a4c3-cfdc9848609b",
                                "sense_id": "7f672ff6-9afa-3841-9fa4-6964cc7e49d8",
                                "text": "Filled up the Ashton with Capstan and had a totally British drive home. Thanks to the wizardry of Ashton and Imperial Tobacco, that first smoke in a new pipe was sweet as a nut."
                            }
                        ]
                    },
                    {
                        "sense_id": "3deef9a8-008f-3bdd-a6aa-ebbefc8bd727",
                        "entry_id": "8da3ac2b-abc3-3c18-93bf-540d36fcdd3d",
                        "glosses": [
                            "Great ability in some specified field."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b51244dd-e9be-45f0-aa55-f0eb8dc3d54c",
                                "sense_id": "3deef9a8-008f-3bdd-a6aa-ebbefc8bd727",
                                "text": "He used his computing wizardry to automate the search-and-replace process."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c1c3386-6c34-49e3-91f0-08d6086099ec",
