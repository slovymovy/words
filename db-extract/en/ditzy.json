                ],
                "senses": [
                    {
                        "sense_id": "00c094b2-7e6e-3940-8265-509871b96637",
                        "entry_id": "7495c506-d394-30eb-ae04-e00d308fe4af",
                        "glosses": [
                            "Silly or scatterbrained, usually of a young woman."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "8bd2d8a1-01ac-453a-80ce-73289452869a",
                                "sense_id": "00c094b2-7e6e-3940-8265-509871b96637",
                                "text": "The guy tossed some cash on the counter, then left with the ditzy girl and Abigail's fan."
                            },
                            {
                                "example_id": "f77f802c-f0ad-4411-b93d-7937cc693a0a",
                                "sense_id": "00c094b2-7e6e-3940-8265-509871b96637",
                                "text": "[…] —and she'd smile like a primly mischievous Japanese girl, or like some slyly ditzy ingenue on a talk show, all the while watching her interrogator try to fathom (though sometimes they were pretty dim and just said, “Oh”) the surprising cleverness of her answer."
                            },
                            {
                                "example_id": "0859355a-aeeb-4ce6-98f0-59ae23def78b",
                                "sense_id": "00c094b2-7e6e-3940-8265-509871b96637",
                                "text": "After hiring a crew of young guys and gals including loyal Jo, unlucky-in-love Frankie, strapping Bob, wisecracking Dee Dee, ditzy blonde Jonesy and titian-haired Penny, the gang drives up to the lodge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "564be21b-ea0d-4121-8db3-bb5c0ee294dc",
                        "source_entry_id": "7495c506-d394-30eb-ae04-e00d308fe4af",
                        "source_sense_id": "00c094b2-7e6e-3940-8265-509871b96637",
                        "source_sense_description": "silly or scatterbrained",
                        "target_lang_word": "pitomý",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pitomý",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d305f477-acd8-3d50-b9e2-f2023a7ac913",
                                        "entry_id": "9a8db7ec-67da-3f46-ad02-789eca261855",
                                        "glosses": [
                                            "hloupý, špatný"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b96666f3-72f2-499d-958f-61f781c1e781",
                                                "sense_id": "d305f477-acd8-3d50-b9e2-f2023a7ac913",
                                                "text": "Ten tvůj nápad je fakt pitomý."
                                            },
                                            {
                                                "example_id": "d1992548-ecf0-438a-a217-5ec1589f44b2",
                                                "sense_id": "d305f477-acd8-3d50-b9e2-f2023a7ac913",
                                                "text": "On je pitomý."
                                            },
                                            {
                                                "example_id": "ec7f1f72-960f-46e0-a750-15b9f54845fa",
                                                "sense_id": "d305f477-acd8-3d50-b9e2-f2023a7ac913",
                                                "text": "Ó lháři pitomí, že se toho o vás žádný domysliti nemuož!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73f70df5-7fcf-37fc-8e6a-742d1ba2ec2e",
                                        "entry_id": "9a8db7ec-67da-3f46-ad02-789eca261855",
                                        "glosses": [
                                            "zdomácnělý, domácí"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb302cf-1fa5-4ea2-b9f6-ed0938541575",
                                                "sense_id": "73f70df5-7fcf-37fc-8e6a-742d1ba2ec2e",
                                                "text": "Ale že hus, pták pitomý, poznal jest toho ostříše neživého, protož nedal se jemu přikvačiti, ale vzdvih se, dal jest příklad jiným božím ptákóm, by též činili."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8a1a485-c501-49f2-b508-e6d56f32d0b5",
                        "source_entry_id": "7495c506-d394-30eb-ae04-e00d308fe4af",
                        "source_sense_id": "00c094b2-7e6e-3940-8265-509871b96637",
                        "source_sense_description": "silly or scatterbrained",
                        "target_lang_word": "potrhlý",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d37523f9-8052-4d57-ae81-d3ceec33e126",
                        "source_entry_id": "7495c506-d394-30eb-ae04-e00d308fe4af",
                        "source_sense_id": "00c094b2-7e6e-3940-8265-509871b96637",
                        "source_sense_description": "silly or scatterbrained",
                        "target_lang_word": "sot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4ebdfbf-185c-39b9-91cf-baa6a4a99715",
                                        "entry_id": "cdc0dbf6-c691-39ba-8cc7-c5aecbdcd693",
                                        "glosses": [
                                            "Qui est sans esprit, sans jugement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "961caf82-fe9d-48f1-8a15-a2ccb4785a46",
                                                "sense_id": "d4ebdfbf-185c-39b9-91cf-baa6a4a99715",
                                                "text": "Je ne suis pas si sot que de le croire."
                                            },
                                            {
                                                "example_id": "b17b2809-7183-4b1b-8843-57a34c1c7626",
                                                "sense_id": "d4ebdfbf-185c-39b9-91cf-baa6a4a99715",
                                                "text": "Un sot animal, une sotte bête."
                                            },
                                            {
                                                "example_id": "4bf4d579-d9f7-4a0e-8cc7-9e218b7296d8",
                                                "sense_id": "d4ebdfbf-185c-39b9-91cf-baa6a4a99715",
                                                "text": "Il n’est point sot, ainsi que l’ont pu croire certains dont le point de vue était différent ; au contraire, le moindre de ses jugements fait preuve d'une netteté d’esprit singulière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f611e70-f63d-35e3-9a8c-512b4c127e5c",
                                        "entry_id": "cdc0dbf6-c691-39ba-8cc7-c5aecbdcd693",
                                        "glosses": [
                                            "Qui est embarrassé, déconcerté, confus."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81f14a43-f9e1-44d2-8660-4fd48bf3b48f",
                                                "sense_id": "7f611e70-f63d-35e3-9a8c-512b4c127e5c",
                                                "text": "Il est resté sot, tout sot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cda3af8-4b21-398d-92b3-4ce171598b2a",
                                        "entry_id": "cdc0dbf6-c691-39ba-8cc7-c5aecbdcd693",
                                        "glosses": [
                                            "Qui est fait sans esprit et sans jugement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da327681-833e-43b7-a78c-b196b356bb5f",
                                                "sense_id": "3cda3af8-4b21-398d-92b3-4ce171598b2a",
                                                "text": "Une sotte entreprise."
                                            },
                                            {
                                                "example_id": "9565b7d4-d02d-4488-8f38-9878e5f13935",
                                                "sense_id": "3cda3af8-4b21-398d-92b3-4ce171598b2a",
                                                "text": "Un sot projet."
                                            },
                                            {
                                                "example_id": "05a48d14-a0e9-4f4f-8e6d-5c9064d76e00",
                                                "sense_id": "3cda3af8-4b21-398d-92b3-4ce171598b2a",
                                                "text": "Un sot discours."
                                            },
                                            {
                                                "example_id": "e2722953-91dc-45b5-befc-49d81d137ec2",
                                                "sense_id": "3cda3af8-4b21-398d-92b3-4ce171598b2a",
                                                "text": "Un sot livre."
                                            },
                                            {
                                                "example_id": "7188d6d7-6814-43ab-80be-ca18b16651b8",
                                                "sense_id": "3cda3af8-4b21-398d-92b3-4ce171598b2a",
                                                "text": "Une politique sotte et cruelle"
                                            },
                                            {
                                                "example_id": "6a9bd78b-8833-41a4-89f3-bca4e707630a",
                                                "sense_id": "3cda3af8-4b21-398d-92b3-4ce171598b2a",
                                                "text": "La nostalgie est un sentiment assez sot, et qui ne mène nulle part… — (Le Figaro, 15 octobre 2007)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59ad0a56-0c64-3894-9691-9c06d3389135",
                                        "entry_id": "cdc0dbf6-c691-39ba-8cc7-c5aecbdcd693",
                                        "glosses": [
                                            "Qui est fâcheux ou ridicule."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c68681b-afc6-4493-99e5-4cdd3e509b71",
                                                "sense_id": "59ad0a56-0c64-3894-9691-9c06d3389135",
                                                "text": "La chose mérite d'être soulignée, car cette mauvaise langue de Mme de Genlis reprendra à son compte un ragot particulièrement sot, faisant de l'anglais de Voltaire un baragouin insupportable. Voilà qui est absolument faux."
                                            },
                                            {
                                                "example_id": "f09927de-c10e-4000-b79c-a20c85a24928",
                                                "sense_id": "59ad0a56-0c64-3894-9691-9c06d3389135",
                                                "text": "Il a fait un sot mariage."
                                            },
                                            {
                                                "example_id": "23c1a877-0886-49f3-a6d4-66b652eb47d3",
                                                "sense_id": "59ad0a56-0c64-3894-9691-9c06d3389135",
                                                "text": "Voilà une sotte aventure."
                                            },
                                            {
                                                "example_id": "6305f670-99b5-4415-b19b-d5afb28e6514",
                                                "sense_id": "59ad0a56-0c64-3894-9691-9c06d3389135",
                                                "text": "Faire une sotte figure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94eb5346-8fa7-30c9-8dfe-211603e5f4e5",
                                        "entry_id": "728d9d14-f728-30c9-abad-ea5bf311cd25",
                                        "glosses": [
                                            "Personne sans esprit, sans jugement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08226435-b571-4e71-a40d-0877fea5fcf8",
                                                "sense_id": "94eb5346-8fa7-30c9-8dfe-211603e5f4e5",
                                                "text": "Il y a deux espèces de sots : ceux qui ne doutent de rien , et ceux qui doutent de tout. Les premiers sont dangereux, car ils se chargent de tout ; les autres ne le sont pas, car ils n'encouragent personne à les charger de quelque chose."
                                            },
                                            {
                                                "example_id": "7dcdb71b-ba75-4455-812c-59e3ed62870e",
                                                "sense_id": "94eb5346-8fa7-30c9-8dfe-211603e5f4e5",
                                                "text": "— Et ce serait pour la seconde fois de la journée, cria M. de Sanréal, de l’air triomphant d’un sot peu accoutumé à être écouté et qui a un fait curieux à dire."
                                            },
                                            {
                                                "example_id": "c6fc3a16-d0ae-4c94-a016-9b87fd2f6e40",
                                                "sense_id": "94eb5346-8fa7-30c9-8dfe-211603e5f4e5",
                                                "text": "Faut-il que ce soit ce sot, ce pauvre esprit incompétent, qui doive me succéder sur le trône, pensait Philippe le Bel. Enfin, espérons que d’ici là il aura mûri."
                                            },
                                            {
                                                "example_id": "2ef3f676-a820-40b6-bc14-c19f579251dd",
                                                "sense_id": "94eb5346-8fa7-30c9-8dfe-211603e5f4e5",
                                                "text": "Vous avez cru fort mal, et je vous suis garant,\nQu’un sot savant est sot plus qu’un sot ignorant."
                                            },
                                            {
                                                "example_id": "98d26638-2be1-4866-89ee-f0edf49417e5",
                                                "sense_id": "94eb5346-8fa7-30c9-8dfe-211603e5f4e5",
                                                "text": "Un sot fait un saut en portant un sceau dans un seau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
