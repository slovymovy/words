                    },
                    {
                        "form_id": "9b21149c-c8fa-44da-a129-eb7b5c7cee62",
                        "entry_id": "d047ebf1-f4ea-3df3-8359-f229d20e41b0",
                        "tags": [
                            "singular",
                            "instrumental"
                        ],
                        "form": "бе́рестом"
                    },
                    {
                        "form_id": "ade2159e-fc61-41f2-8cdd-2afbcb59504c",
                        "entry_id": "d047ebf1-f4ea-3df3-8359-f229d20e41b0",
                        "tags": [
                            "plural",
                            "instrumental"
                        ],
                        "form": "бе́рестами"
                    },
                    {
                        "form_id": "29322b29-d63c-4000-a806-871ad41814d8",
                        "entry_id": "d047ebf1-f4ea-3df3-8359-f229d20e41b0",
                        "tags": [
                            "singular",
                            "prepositional"
                        ],
                        "form": "бе́ресте"
                    },
                    {
                        "form_id": "bc7c3363-b2b5-4361-86eb-cf0882157645",
                        "entry_id": "d047ebf1-f4ea-3df3-8359-f229d20e41b0",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "бе́рестах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dec8a2a-e065-3476-b4be-4f991f564d6d",
                        "entry_id": "d047ebf1-f4ea-3df3-8359-f229d20e41b0",
                        "glosses": [
                            "ботан. дерево семейства вязовых (Ulmus minor), разновидность вяза"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc05e31-5a72-4006-bafe-984986f9a639",
                                "sense_id": "1dec8a2a-e065-3476-b4be-4f991f564d6d",
                                "text": "По берегам её стоят, распустя свои зелёные косы, старые вербы и бересты."
                            },
                            {
                                "example_id": "1bbdb030-111d-4789-9195-e804767ed705",
                                "sense_id": "1dec8a2a-e065-3476-b4be-4f991f564d6d",
                                "text": "На другой день я сделал небольшой этюд с суховерхой старой ивы; хотел было сделать такой этюд и с полуусохшего старого «береста», но на живой его половине не развернулась еще зелень, так я ограничился только одним остовом."
                            },
                            {
                                "example_id": "83dd870c-c65b-4472-9c01-abb50420679c",
                                "sense_id": "1dec8a2a-e065-3476-b4be-4f991f564d6d",
                                "text": "В это время по другую сторону реки, выдвинувшись из-под береста, стал одеваться Кирилло, спиною к мельнице."
                            },
                            {
                                "example_id": "ab13f28a-eafb-4bae-b1f3-1a563bc809f3",
                                "sense_id": "1dec8a2a-e065-3476-b4be-4f991f564d6d",
                                "text": "Куприян стоял, расставив ноги, глубоко засунув руки в карманы, и все глядел на тёмный силуэт избы, забора и качающегося по ветру береста."
                            },
                            {
                                "example_id": "b89f0a33-6448-4cb8-b2d6-6ba14b5fe608",
                                "sense_id": "1dec8a2a-e065-3476-b4be-4f991f564d6d",
                                "text": "В одном месте на коре береста краснела свежая коричневая царапина."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0fe7614-743a-38f5-9b2c-c668da7a7297",
                        "entry_id": "d047ebf1-f4ea-3df3-8359-f229d20e41b0",
                        "glosses": [
                            "древесина такого дерева"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5ec6525-60f9-4b7f-8389-f92084d1d4d8",
                        "source_entry_id": "d047ebf1-f4ea-3df3-8359-f229d20e41b0",
                        "target_lang_word": "elm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c92fe955-63f2-323d-9e20-537e54690343",
                                        "entry_id": "f2a41c35-6c00-3870-a979-6cfef1796f46",
                                        "glosses": [
                                            "A tree of the genus Ulmus of the family Ulmaceae, large deciduous trees with alternate stipulate leaves and small apetalous flowers."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08e83c5-bb63-4dba-8256-322447ee2a84",
                                                "sense_id": "c92fe955-63f2-323d-9e20-537e54690343",
                                                "text": "It was not far from the house; but the ground sank into a depression there, and the ridge of it behind shut out everything except just the roof of the tallest hayrick. As one sat on the sward behind the elm, with the back turned on the rick and nothing in front but the tall elms and the oaks in the other hedge, it was quite easy to fancy it the verge of the prairie with the backwoods close by."
                                            },
                                            {
                                                "example_id": "96b41080-a69f-4f9a-bb5c-5443a92a840f",
                                                "sense_id": "c92fe955-63f2-323d-9e20-537e54690343",
                                                "text": "The village is a dignified place of thatch, half-timbering, box hedges and neat farms, set among elms (though not as many as formerly, since Dutch elm disease took its toll) on the level plain of the Pewsey Vale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b660adc1-489f-3de9-9465-c279ab907ec6",
                                        "entry_id": "f2a41c35-6c00-3870-a979-6cfef1796f46",
                                        "glosses": [
                                            "Wood from an elm tree."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
