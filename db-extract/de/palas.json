                                    {
                                        "sense_id": "d1ca31a6-7cb3-3389-a3e2-ef75f5a181a4",
                                        "entry_id": "e4552d37-6d93-36bd-aaed-a14d85311c91",
                                        "glosses": [
                                            "A tree of eastern India and Burma, Butea monosperma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ed4702f-9c56-40ec-8f6b-38917b7df2b4",
                                                "sense_id": "d1ca31a6-7cb3-3389-a3e2-ef75f5a181a4",
                                                "text": "The Dhak or Palas is a familiar wild tree and is common throughout the greater part of India except in drier parts."
                                            },
                                            {
                                                "example_id": "01177250-a0f1-4047-9317-311966788678",
                                                "sense_id": "d1ca31a6-7cb3-3389-a3e2-ef75f5a181a4",
                                                "text": "The tea garden lay in the foothills of Bhutan and got its name from the many palash trees that stood tall among the undulating green sea of tea bushes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
