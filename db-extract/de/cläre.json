                        "examples": [
                            {
                                "example_id": "fbe28620-0002-4140-ab1a-e0b093f24959",
                                "sense_id": "d0e94b53-57ab-3c11-ac42-91bf457061b6",
                                "text": "„Hierdurch bestätigt sich die, von Cläre von Glümer in ihrer geistvollen Lebensbeschreibung der Schröder-Devrient gegebene Nachricht über dieß Benefiz, das von andrer Seite her in Abrede gestellt wurde.“"
                            },
                            {
                                "example_id": "03d180c0-70cc-4201-a69a-7ef497f44226",
                                "sense_id": "d0e94b53-57ab-3c11-ac42-91bf457061b6",
                                "text": "„Und riechst du es auch, Cläre?“"
                            },
                            {
                                "example_id": "fa14232c-e5ae-4616-bc25-56b75d9e4c0f",
                                "sense_id": "d0e94b53-57ab-3c11-ac42-91bf457061b6",
                                "text": "„Ellen genoß die Septembertage im Gefühl eines großen Triumphs, denn Cläre Huhn war krank geworden, und das empfand sie als ihr Werk.“"
                            },
                            {
                                "example_id": "9b730978-6832-49d7-9b74-be5bc541216e",
                                "sense_id": "d0e94b53-57ab-3c11-ac42-91bf457061b6",
                                "text": "„Cläre Heliot nannte sie sich als Artistin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
