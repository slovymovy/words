                    {
                        "translation_id": "0d6db4c7-854f-4345-a2ea-c493c608f997",
                        "source_entry_id": "20986166-5ab8-31ec-8afb-3f2ac1165244",
                        "source_sense_id": "516e3276-8767-31ea-9df5-f78f397b624a",
                        "source_sense_description": "the quality of being genuine; authenticity",
                        "target_lang_word": "Aufrichtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufrichtigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "183c5833-c7ac-3d0c-8b68-a039efbb039d",
                                        "entry_id": "26783f15-4502-3536-b611-41d432fee4a8",
                                        "glosses": [
                                            "Haltung von jemand, die eigene Meinung/ das eigene Wissen korrekt zu vertreten"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc4cebf-8ba8-441d-b67a-5157b972db6d",
                                                "sense_id": "183c5833-c7ac-3d0c-8b68-a039efbb039d",
                                                "text": "Seine Aufrichtigkeit ist bemerkenswert."
                                            },
                                            {
                                                "example_id": "269b99f1-269d-44bd-a2d5-65181b5a683e",
                                                "sense_id": "183c5833-c7ac-3d0c-8b68-a039efbb039d",
                                                "text": "„Natascha überliess sich diesem neuen Gefühl mit solcher Rückhaltlosigkeit und Aufrichtigkeit, dass sie nicht einmal den Versuch machte, die Freude und Fröhlichkeit zu verbergen, die an die Stelle ihres Kummers getreten war.“"
                                            },
                                            {
                                                "example_id": "35049c4f-30be-4a95-9204-fdf50c51c064",
                                                "sense_id": "183c5833-c7ac-3d0c-8b68-a039efbb039d",
                                                "text": "„Ich konnte weder an der Verschwiegenheit C. C.s zweifeln noch an der Aufrichtigkeit, mit der sie mir davon erzählt hätte, wenn sie ihrer Nonne auch nur die geringste Andeutung gemacht hätte.“"
                                            },
                                            {
                                                "example_id": "a5c32568-db77-47ef-a7c8-8e06c39e42d3",
                                                "sense_id": "183c5833-c7ac-3d0c-8b68-a039efbb039d",
                                                "text": "„Seine Antwort klang unaufrichtig, was mich erstaunte bei dem geringen Anlaß in Anbetracht der nutzlosen Aufrichtigkeit seiner häufigsten Geständnisse.“"
                                            },
                                            {
                                                "example_id": "4cec3f47-49ce-40b3-b5a9-908a46049469",
                                                "sense_id": "183c5833-c7ac-3d0c-8b68-a039efbb039d",
                                                "text": "„Ich interessierte mich lebhaft für seine Familiengeschichte, die er mir mit der ganzen Aufrichtigkeit erzählte, in der der Franzose sich gefällt, wenn er von seinem eigenen Ich spricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ec4a3a1-6278-45e2-ab82-7b38b0fbc6e4",
                        "source_entry_id": "20986166-5ab8-31ec-8afb-3f2ac1165244",
                        "source_sense_id": "516e3276-8767-31ea-9df5-f78f397b624a",
                        "source_sense_description": "the quality of being genuine; authenticity",
                        "target_lang_word": "Wahrhaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahrhaftigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3c11c06-b27c-30e6-a658-e544ee8788ea",
                                        "entry_id": "6679a43e-b746-369e-b18b-6f4720378b3b",
                                        "glosses": [
                                            "die Neigung oder Gewohnheit, die Wahrheit zu sagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a58a71-2583-4c95-8b00-a0d7e883b0c8",
                                                "sense_id": "b3c11c06-b27c-30e6-a658-e544ee8788ea",
                                                "text": "Die Wahrhaftigkeit war ihm anerzogen."
                                            },
                                            {
                                                "example_id": "380ffa47-fc49-4aad-8bf7-213806a4ce51",
                                                "sense_id": "b3c11c06-b27c-30e6-a658-e544ee8788ea",
                                                "text": "„Maßstäbe für eine Rechtfertigung sind die Wahrhaftigkeit, Relevanz und Verständlichkeit des Gesagten.“"
                                            },
                                            {
                                                "example_id": "3ee0b875-7b71-41a9-a83d-281bad289e3b",
                                                "sense_id": "b3c11c06-b27c-30e6-a658-e544ee8788ea",
                                                "text": "„Der Priester berief sich auf die Wahrhaftigkeit der Heiligen Schrift, auf die Überlieferung der Menschheit und auf die Tiere, die man im sibirischen Eis entdeckt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fa579c2-9424-4807-ba44-346f6c42e6bc",
                        "source_entry_id": "20986166-5ab8-31ec-8afb-3f2ac1165244",
                        "source_sense_id": "516e3276-8767-31ea-9df5-f78f397b624a",
                        "source_sense_description": "the quality of being genuine; authenticity",
                        "target_lang_word": "Echtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Echtheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "694d5bb9-8538-3552-93bc-04b483ce5d7f",
                                        "entry_id": "a28ce607-e9bf-3b2e-bd9a-760892ebae44",
                                        "glosses": [
                                            "Eigenschaft einer Sache, echt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be782766-f895-4c7a-9d7a-beeba376cfee",
                                                "sense_id": "694d5bb9-8538-3552-93bc-04b483ce5d7f",
                                                "text": "Die Echtheit dieses Gemäldes wurde noch nicht von einem Experten überprüft."
                                            },
                                            {
                                                "example_id": "3823f90b-af44-4b78-9aa8-6a7ca804728b",
                                                "sense_id": "694d5bb9-8538-3552-93bc-04b483ce5d7f",
                                                "text": "Die Echtheit der Hitler-Tagebücher, die der Stern veröffentlichte, wurde schnell in Frage gestellt."
                                            },
                                            {
                                                "example_id": "31124e84-f157-4354-ab88-2504363bedfe",
                                                "sense_id": "694d5bb9-8538-3552-93bc-04b483ce5d7f",
                                                "text": "„Um ein Gemälde auf Echtheit zu prüfen, werden häufig die verwendeten Weißpigmente untersucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a67c1706-e701-3cbe-a353-71c38807c8ca",
                                        "entry_id": "a28ce607-e9bf-3b2e-bd9a-760892ebae44",
                                        "glosses": [
                                            "Eigenschaft eines Gefühls oder Gefühlsausdrucks, aufrichtig und nicht nur vorgetäuscht zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc2e22e-2f58-47cf-baed-3ce50e59cd0e",
                                                "sense_id": "a67c1706-e701-3cbe-a353-71c38807c8ca",
                                                "text": "Nach dem Tod seiner Frau war Theo die Echtheit seiner Trauer anzumerken."
                                            },
                                            {
                                                "example_id": "e593b3bb-15b0-4271-b762-1ee918ac2ffc",
                                                "sense_id": "a67c1706-e701-3cbe-a353-71c38807c8ca",
                                                "text": "„Etwas ging mir freilich sehr zu Herzen, ihre Tränen, an deren Echtheit zu zweifeln ich keinen Grund hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e8beac4d-af8d-3d71-b82d-fee0f7102b3d",
                                        "entry_id": "a28ce607-e9bf-3b2e-bd9a-760892ebae44",
                                        "glosses": [
                                            "Beständigkeit gegenüber äußeren Einflüssen wie Licht, Feuchtigkeit oder Temperatur, insbesondere bei Farben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d8d44e-44fb-466b-b4af-5850a8b82f23",
                                                "sense_id": "e8beac4d-af8d-3d71-b82d-fee0f7102b3d",
                                                "text": "Nach dem Waschen war das neue T-Shirt total ausgebleicht - so viel zu der Echtheit der verwendeten Farben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3ea6752-5e53-4c6b-ab39-21d53f43e776",
                        "source_entry_id": "20986166-5ab8-31ec-8afb-3f2ac1165244",
                        "source_sense_id": "516e3276-8767-31ea-9df5-f78f397b624a",
                        "source_sense_description": "the quality of being genuine; authenticity",
                        "target_lang_word": "Authentizität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Authentizität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                        "entry_id": "e248566f-6147-3347-afa4-7c91016901e9",
                                        "glosses": [
                                            "Eigenschaft einer Sache, Person oder Organisation, authentisch (auf Echtheit geprüft, zuverlässig) zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a68b8b3f-1432-472c-8cf5-eb114ce516d0",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "Authentizität, so definiert es das Lexikon, bedeutet, dass das Handeln einer Person nicht durch äußere Einflüsse bestimmt wird, sondern in der Person selbst begründet liegt."
                                            },
                                            {
                                                "example_id": "ea00c160-9198-422f-9f88-9a78eb06a312",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "Die Authentizität des Dokuments ist überprüft worden und nicht zu bestreiten."
                                            },
                                            {
                                                "example_id": "cef3e311-eb3c-4b1d-ac38-ce5d11cebc0a",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "„Mitunter stoßen die Fahnder bei dem Procedere auch auf Steuersünder, die sich selbst angezeigt haben - ein Beleg für die Authentizität des Materials.“"
                                            },
                                            {
                                                "example_id": "cbfa7a27-31a2-40c5-a345-6b6edc8a1286",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "In fast allen Lehrplänen und Richtlinien für den Fremdsprachenunterricht können wir den Begriff der Authentizität finden."
                                            },
                                            {
                                                "example_id": "4a5ef6f0-d854-4158-a194-f4f8117d59ca",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "„Die Authentizität der fremden Gäste wird noch durch die Bauart ihrer Wohnung bekräftigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "370f974a-67cd-41c9-9eaf-69f6d0b73e13",
                        "source_entry_id": "20986166-5ab8-31ec-8afb-3f2ac1165244",
                        "source_sense_id": "516e3276-8767-31ea-9df5-f78f397b624a",
                        "source_sense_description": "the quality of being genuine; authenticity",
                        "target_lang_word": "Glaubwürdigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glaubwürdigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                        "entry_id": "b92440bd-6716-39ce-8527-ba16aeb087a9",
                                        "glosses": [
                                            "Glaubwürdigsein; glaubwürdige Eigenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e0da5a0-bc7d-47a7-b997-f0979149de62",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Glaubwürdigkeit und Vertrauen sind ein überaus hohes Gut und bilden die Grundlage für einen ernsthaften und lebendigen Glauben an Gott, aber ebenso für Demokratie und erfolgreiches, nachhaltiges Wirtschaften.“"
                                            },
                                            {
                                                "example_id": "1c7f6204-0987-4510-ac11-0dd977ad406e",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Ich zeige ihr grinsend meine Bücher, berühmte Namen und wahre Zitate, die ich mit Blaustift unterstrichen habe und deren Glaubwürdigkeit unantastbar ist.“"
                                            },
                                            {
                                                "example_id": "9808055d-0947-4bfe-baea-e2fb94e9615e",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Er wusste nicht, ob das stimmte, aber kaum dass er es ausgesprochen hatte, wusste er, dass er jetzt seine letzte Glaubwürdigkeit verspielt hatte.“"
                                            },
                                            {
                                                "example_id": "df52e2db-afe1-4662-b101-c02ad8c3ae89",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Diese Einschätzungen haben dadurch an Glaubwürdigkeit gewonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
