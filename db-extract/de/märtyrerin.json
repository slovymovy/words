                        "form": "die Märtyrerin"
                    },
                    {
                        "form_id": "06e6388e-fbad-4ad1-9008-24eeabdf6c87",
                        "entry_id": "7f2269df-7bec-318b-986a-804201dad661",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Märtyrerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46f55b3b-838d-3e5e-ab61-69efd477dd0b",
                        "entry_id": "7f2269df-7bec-318b-986a-804201dad661",
                        "glosses": [
                            "eine weibliche Person, die für ihren religiösen Glauben freiwillig den Tod, verursacht durch Außenstehende, erduldet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7006d44b-9550-449b-b28e-fa0a1c8a5eec",
                                "sense_id": "46f55b3b-838d-3e5e-ab61-69efd477dd0b",
                                "text": "„Wiborada […] war eine Einsiedlerin in der Schweiz und ist eine Märtyrerin der katholischen Kirche.“"
                            },
                            {
                                "example_id": "50ea6911-ced6-432f-8ca1-28fda4298c60",
                                "sense_id": "46f55b3b-838d-3e5e-ab61-69efd477dd0b",
                                "text": "„Es war der Tag der heiligen Ursula, einer jener tausend jungfräulichen Prinzessinnen und Märtyrerinnen.“"
                            },
                            {
                                "example_id": "c75f1240-209b-43dc-87a7-b7576607d55e",
                                "sense_id": "46f55b3b-838d-3e5e-ab61-69efd477dd0b",
                                "text": "„Wenn sie schon eine Märtyrerin ist, dann ist sie wenigstens eine mit Vorsicht und wenig Skrupeln.“"
                            },
                            {
                                "example_id": "941347b7-c345-4440-a926-a76ada8e2a00",
                                "sense_id": "46f55b3b-838d-3e5e-ab61-69efd477dd0b",
                                "text": "„Am 27. Dezember fiel Benazir Bhutto in Rawalpindi einem bis heute ungeklärten Attentat zum Opfer. Damit stieg sie zur Märtyrerin der demokratischen Bewegung auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "444ac276-3e22-477a-b9bc-e6c6c56f67c1",
                        "source_entry_id": "7f2269df-7bec-318b-986a-804201dad661",
                        "source_sense_id": "46f55b3b-838d-3e5e-ab61-69efd477dd0b",
                        "target_lang_word": "martyr",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "martyr",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4aeac593-0071-3323-82f2-33ba2cc34984",
                                        "entry_id": "e093a7ab-7ce8-32bc-a21d-90c2492d6ac5",
                                        "glosses": [
                                            "One who willingly accepts being put to death or willingly accepts challenging and exposing iniquity done to oneself for adhering openly to one's religious beliefs; notably, saints canonized after red martyrdom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0530d455-dd44-4583-825e-6a31156451b8",
                                                "sense_id": "4aeac593-0071-3323-82f2-33ba2cc34984",
                                                "text": "Saint Stephen was the first Christian martyr."
                                            },
                                            {
                                                "example_id": "43be515a-18fe-45c1-a833-460870358ce6",
                                                "sense_id": "4aeac593-0071-3323-82f2-33ba2cc34984",
                                                "text": "Fr. Felipe Císcar Puig was a Valencian priest who is also also considered a martyr of the sacramental seal because he was martyred after keeping confessions secret during the religious persecution of the Spanish Civil War."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69eb03c9-7ead-37dd-85b8-26e7369ff034",
                                        "entry_id": "e093a7ab-7ce8-32bc-a21d-90c2492d6ac5",
                                        "glosses": [
                                            "One who sacrifices their life, station, or something of great personal value, for the sake of principle or to sustain a cause."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b21d7a2-449e-3910-8d29-18c01f07fe11",
                                        "entry_id": "e093a7ab-7ce8-32bc-a21d-90c2492d6ac5",
                                        "glosses": [
                                            "One who suffers greatly and/or constantly, even involuntarily."
                                        ],
                                        "tags": [
                                            "with a prepositional phrase of cause"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987a7197-5d1f-4eb6-9283-9d6674c37f09",
                                                "sense_id": "3b21d7a2-449e-3910-8d29-18c01f07fe11",
                                                "text": "Stan is a martyr to arthritis, Chris a martyr to Stan's endless moaning about it."
                                            },
                                            {
                                                "example_id": "984d9b65-f717-4296-9fc0-3dab2f8b7fc6",
                                                "sense_id": "3b21d7a2-449e-3910-8d29-18c01f07fe11",
                                                "text": "He'd been a martyr to asthma all his life."
                                            },
                                            {
                                                "example_id": "0d41bd71-02a1-4f6e-b19e-a342fcda0232",
                                                "sense_id": "3b21d7a2-449e-3910-8d29-18c01f07fe11",
                                                "text": "J.Q. Murder wears sandpaper suits\nBroken glass in pocket, barbed wire boots\nNot because he's mean, but because he's a martyr\nHe makes Jackie Collins look like Jean-Paul Sartre"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2c4a10e-f090-3886-bf0d-ea2cd5ca4454",
                                        "entry_id": "e093a7ab-7ce8-32bc-a21d-90c2492d6ac5",
                                        "glosses": [
                                            "Someone who exaggerate their pain and suffering in order to gain sympathy."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dbc8e80-d63c-43eb-b924-32e475e08b4c",
                                                "sense_id": "f2c4a10e-f090-3886-bf0d-ea2cd5ca4454",
                                                "text": "You have a great life! Stop trying to play the martyr!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "martyr",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fbf299e-768b-320a-93b5-73210fd31785",
                                        "entry_id": "369f21c4-3b29-3a97-b03f-59b5a77a7b2d",
                                        "glosses": [
                                            "To make someone into a martyr by putting them to death for adhering to, or acting in accordance with, some belief, especially religious; to sacrifice on account of faith or profession."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f63062c-1ed2-4cb0-9479-519cec85a9ff",
                                                "sense_id": "6fbf299e-768b-320a-93b5-73210fd31785",
                                                "text": "Fr. Felipe Císcar Puig was a Valencian priest who is also also considered a martyr of the sacramental seal because he was martyred after keeping confessions secret during the religious persecution of the Spanish Civil War."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13e32090-79e1-3cc6-aa60-d02f640cfa86",
                                        "entry_id": "369f21c4-3b29-3a97-b03f-59b5a77a7b2d",
                                        "glosses": [
                                            "To persecute."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de788642-0a53-4334-9ba5-f24e95ce96ce",
                                                "sense_id": "13e32090-79e1-3cc6-aa60-d02f640cfa86",
                                                "text": "Some religious and other minorities were martyred until extinction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5717d38e-7aa2-354e-856f-791ec838452f",
                                        "entry_id": "369f21c4-3b29-3a97-b03f-59b5a77a7b2d",
                                        "glosses": [
                                            "To torment; to torture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d50be658-2a74-4922-81f8-a362ebbf94c9",
                                                "sense_id": "5717d38e-7aa2-354e-856f-791ec838452f",
                                                "text": "Hark, wretches, how I mean to martyr you.\nThis one hand yet is left to cut your throats,\nWhiles that Lavinia ’tween her stumps doth hold\nThe basin that receives your guilty blood."
                                            },
                                            {
                                                "example_id": "1e685b67-a703-4eaa-8968-726afd84c46c",
                                                "sense_id": "5717d38e-7aa2-354e-856f-791ec838452f",
                                                "text": "[…]The louely Amoret, whoſe gentle hart\nThou martyreſt with ſorow and with ſmart,[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b5807be-9ad4-4e1a-be52-6f781765ab3f",
                        "source_entry_id": "7f2269df-7bec-318b-986a-804201dad661",
                        "source_sense_id": "46f55b3b-838d-3e5e-ab61-69efd477dd0b",
                        "target_lang_word": "martyre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "martyre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                        "entry_id": "6dee1d9b-0a25-3284-9093-ad96653a2359",
                                        "glosses": [
                                            "Mort ou tourments endurés pour sa religion, sa foi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b29f1e-d9bb-4285-a282-f5edb7741496",
                                                "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                                "text": "L’ambition de gagner le martyre avait engagé le prêtre à se mettre de notre voyage."
                                            },
                                            {
                                                "example_id": "d8920a3b-5701-4e49-80d3-1bbc42eeb1da",
                                                "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                                "text": "Il faut songer qu’à cette époque il y avait en Afrique un assez grand nombre de montanistes qui exaltaient beaucoup la gloire du martyre et n’admettaient point que l’on eût le droit de fuir la persécution."
                                            },
                                            {
                                                "example_id": "ad28fb27-a5bc-4db3-87d8-565b0fc9d9bf",
                                                "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                                "text": "Si les misérables croient en la patrie, c’est parce qu’ils sont la dupe des mots, comme l’étaient les premiers chrétiens qui subissaient le martyre pour un Dieu qui n’existe pas."
                                            },
                                            {
                                                "example_id": "c2d01dba-2445-4422-b147-fd4ef1900066",
                                                "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                                "text": "Quand Rabénou Tam fut informé du martyre des juifs de Blois, il ordonna un jeûne, qui fut longtemps observé au jour anniversaire (le 20 Siwan)."
                                            },
                                            {
                                                "example_id": "1aff0ba1-1b3e-4cec-92c1-e36610e4c70e",
                                                "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                                "text": "Dans la logique du martyre, la douleur apporte le salut : elle est souhaitée, désirée, voulue, aimée, chérie, car elle conduit directement à la rédemption."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c10fae80-99c0-37a7-900e-48168f4be6d5",
                                        "entry_id": "6dee1d9b-0a25-3284-9093-ad96653a2359",
                                        "glosses": [
                                            "Tortures endurées par les victimes de tortionnaires."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50d64203-4946-40fc-83d0-6e1012bbc68d",
                                                "sense_id": "c10fae80-99c0-37a7-900e-48168f4be6d5",
                                                "text": "Chacun ici connaît le martyre d’Annick Castel, violée par un parachutiste et qui, croyant être enceinte, ne songeait plus qu’à mourir."
                                            },
                                            {
                                                "example_id": "e3205318-e279-44a6-826b-dd4fcdfaa584",
                                                "sense_id": "c10fae80-99c0-37a7-900e-48168f4be6d5",
                                                "text": "Le procès de la belle-mère accusée du meurtre de la fillette martyre de Granby n'aura pas lieu avant septembre 2021, au palais de justice de Trois-Rivières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63130984-82be-3a6c-a329-cfb2e3db69f5",
                                        "entry_id": "6dee1d9b-0a25-3284-9093-ad96653a2359",
                                        "glosses": [
                                            "Toute sorte de peines ou de douleurs de corps et d’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da612cd8-7896-41e7-b98a-576f3d576d1e",
                                                "sense_id": "63130984-82be-3a6c-a329-cfb2e3db69f5",
                                                "text": "C’est honteux à dire, cependant nous ne faisons pas ici de l’immoralité à plaisir, nous racontons un fait vrai, que nous ferions peut-être mieux de taire, si nous ne croyions qu’il faut de temps en temps révéler les martyres de ces êtres, que l’on condamne sans les entendre, que l’on méprise sans les juger; […]."
                                            },
                                            {
                                                "example_id": "c428d26d-f5ab-4c41-9a1f-016bb869ee1d",
                                                "sense_id": "63130984-82be-3a6c-a329-cfb2e3db69f5",
                                                "text": "Oscar Wilde n’inspire plus de colère, même aux sectaires de la vertu. Tous n’ont plus, pour lui et pour son martyre, que de la pitié douloureuse."
                                            },
                                            {
                                                "example_id": "1cba1499-1a2a-4744-aee3-fe4f9660a94e",
                                                "sense_id": "63130984-82be-3a6c-a329-cfb2e3db69f5",
                                                "text": "Oscar Wilde, le grand écrivain anglais échoué à Paris après le martyre que la dureté puritaine lui eût fait subir, désira rencontrer Esterhazy."
                                            },
                                            {
                                                "example_id": "3327c6b2-5809-4451-b692-8122bb3259f1",
                                                "sense_id": "63130984-82be-3a6c-a329-cfb2e3db69f5",
                                                "text": "Mon Dieu, en quel martyre vous m’avez condamnée à vivre, enveloppée de duplicités, environnée d’embûches, cernée de chausses-trapes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6027c555-72c3-306e-a62a-84cd4ef235bd",
                                        "entry_id": "6dee1d9b-0a25-3284-9093-ad96653a2359",
                                        "glosses": [
                                            "Peine d’amour."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745aeaba-a19e-418f-b08a-348a09bb18f6",
                                                "sense_id": "6027c555-72c3-306e-a62a-84cd4ef235bd",
                                                "text": "La beauté qui cause mon martyre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "martyre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a40e6e99-e3e8-315c-bee0-6ab20ba2ef27",
                                        "entry_id": "831ebcc0-013a-339e-acf6-bcf8f79d0593",
                                        "glosses": [
                                            "Femme martyr."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d41b7111-025e-4e0b-a0b8-8652d7e1f2c6",
                                                "sense_id": "a40e6e99-e3e8-315c-bee0-6ab20ba2ef27",
                                                "text": "Et si jamais tu oses,\nC’est avec joie que je serai une martyre de la cause. (Oh oh oh oh oh oh)\nAvec plaisir je serai une martyre de la cause. (Oh oh oh oh oh oh)\nAvec honneur je serai une martyre de la cause. (Oh oh oh oh oh oh)\nAvec fierté je serai une martyre de la cause."
                                            }
                                        ]
                                    }
