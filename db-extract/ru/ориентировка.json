                    },
                    {
                        "form_id": "14e9895b-7b01-4f2b-bf34-f80f897bfa14",
                        "entry_id": "5688be55-71c4-3e96-9933-70580d1af690",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ориентиро́вках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f025539a-b937-3290-a6a8-460584997a99",
                        "entry_id": "5688be55-71c4-3e96-9933-70580d1af690",
                        "glosses": [
                            "способность ориентироваться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8356714-c8d1-4d22-bd8f-2046c54857af",
                                "sense_id": "f025539a-b937-3290-a6a8-460584997a99",
                                "text": "Мало того что ты его не видишь — тебя и шум двигателя обманет: кажется, что идешь на него, а на самом деле — в противоположную сторону. Ориентировка в пространстве теряется полностью."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1ade34b-e290-3ac1-890b-9b47f25461c1",
                        "entry_id": "5688be55-71c4-3e96-9933-70580d1af690",
                        "glosses": [
                            "офиц. документ, содержащий указания о цели розыска, разведки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "776db5de-381d-407c-8f79-1ad5b318deba",
                                "sense_id": "d1ade34b-e290-3ac1-890b-9b47f25461c1",
                                "text": "В милицию ориентировка на Шефлера еще не поступила, но предприниматель, ранее опровергавший информацию о розыске, вчера предпочел «лечь на дно»."
                            },
                            {
                                "example_id": "223bf1a5-79a1-4c85-9a51-eb46851d9eb4",
                                "sense_id": "d1ade34b-e290-3ac1-890b-9b47f25461c1",
                                "text": "Подготавливаемая нами ориентировка с указанием установочных данных, кличек и словесных портретов значительной части лиц, прошедших подготовку на белорусском отделении Дальвитцской разведшколы абвера, будет вам сообщена в течение суток."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7160fabd-4fbd-4194-8615-e5909595d4d7",
                        "source_entry_id": "5688be55-71c4-3e96-9933-70580d1af690",
                        "source_sense_description": "способность ориентироваться",
                        "target_lang_word": "orientation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orientation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4befd477-cbcb-3d17-a9ae-aa9a866cedc5",
                                        "entry_id": "3dc66611-229f-3a23-9d0b-b6760b22c4b4",
                                        "glosses": [
                                            "Détermination des points cardinaux du lieu où l’on se trouve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ca22bed-3699-4e73-af2f-aa5db051556e",
                                                "sense_id": "4befd477-cbcb-3d17-a9ae-aa9a866cedc5",
                                                "text": "Tables d’orientation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ee8b122-c47c-3d0a-afc3-01013f8206fe",
                                        "entry_id": "3dc66611-229f-3a23-9d0b-b6760b22c4b4",
                                        "glosses": [
                                            "Position d’un objet relativement à l’orient, aux points cardinaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "160caaf3-43eb-47be-9ee6-3ae1a0fde594",
                                                "sense_id": "2ee8b122-c47c-3d0a-afc3-01013f8206fe",
                                                "text": "Ainsi que l’ont fait remarquer en particulier MM. Allorge et De Litardière, des pelouses « édaphiquement comparables » et de même déclivité présentent des différences assez accusées pour une orientation différente, N. ou S."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b299ad3f-7025-34e9-9b6d-c595b8b5f9aa",
                                        "entry_id": "3dc66611-229f-3a23-9d0b-b6760b22c4b4",
                                        "glosses": [
                                            "Exposition, en parlant d’une maison."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "173513c1-2b32-4bbd-9b1b-433c87008302",
                                                "sense_id": "b299ad3f-7025-34e9-9b6d-c595b8b5f9aa",
                                                "text": "L’orientation de cette maison n’est pas bonne."
                                            },
                                            {
                                                "example_id": "ab505d57-d612-4bc8-804c-ca17453215ef",
                                                "sense_id": "b299ad3f-7025-34e9-9b6d-c595b8b5f9aa",
                                                "text": "Orientation au midi, au nord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feb9c681-bcb3-3207-81b5-acc06a3c2925",
                                        "entry_id": "3dc66611-229f-3a23-9d0b-b6760b22c4b4",
                                        "glosses": [
                                            "Disposition convenable des voiles et des vergues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3331c2cd-1e00-4961-ae94-4caef9c7d970",
                                                "sense_id": "feb9c681-bcb3-3207-81b5-acc06a3c2925",
                                                "text": "Orientation des voiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff3237e-98f0-3649-854d-c981c8c3d3f7",
                                        "entry_id": "3dc66611-229f-3a23-9d0b-b6760b22c4b4",
                                        "glosses": [
                                            "Direction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41a02665-2980-45cb-b115-cb6c911855ec",
                                                "sense_id": "bff3237e-98f0-3649-854d-c981c8c3d3f7",
                                                "text": "Marchand avait coutume de ne jamais donner d’instructions détaillées à ses collaborateurs, se bornant à leur préciser l’orientation qu'il souhaitait les voir adopter."
                                            },
                                            {
                                                "example_id": "31c7789c-244e-4b58-bb99-0b0e6f862fe1",
                                                "sense_id": "bff3237e-98f0-3649-854d-c981c8c3d3f7",
                                                "text": "D'un côté, les continentaux collés aux maritimes occidentaux : l'Autriche, la Suisse et dans une moindre mesure, la Tchéquie et la Hongrie. Et, de l'autre, la Pologne, avec son ouverture baltique à orientation septentrionale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a86be7e9-8c2e-34b2-8d39-52005b4ab3bd",
                                        "entry_id": "3dc66611-229f-3a23-9d0b-b6760b22c4b4",
                                        "glosses": [
                                            "Direction des axes d’un engin spatial par rapport à un trièdre de référence."
                                        ],
                                        "tags": [
                                            "Pilotage"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0802dc75-e08a-356d-b95c-f49ee2ea5bc9",
                                        "entry_id": "3dc66611-229f-3a23-9d0b-b6760b22c4b4",
                                        "glosses": [
                                            "Tendance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "864f98c3-3d4e-4840-8d1d-255f61191c9b",
                                                "sense_id": "0802dc75-e08a-356d-b95c-f49ee2ea5bc9",
                                                "text": "Le 21 juin dernier, les délégués à l’assemblée générale de France Mutuelle se sont réunis à Paris, sous la présidence de Michel Dumoux, pour approuver les résultats de l’exercice 2021 et statuer sur diverses orientations proposées par le conseil d’administration."
                                            },
                                            {
                                                "example_id": "fd0c723d-1f48-4788-b57c-4c71ab2f817f",
                                                "sense_id": "0802dc75-e08a-356d-b95c-f49ee2ea5bc9",
                                                "text": "On pense à l’utilisation, par le gouvernement Trudeau, de la « libéraliste » – banque de données du PLC – afin de scruter les orientations partisanes de candidats à la magistrature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5bf8d12-6785-3870-a54d-e638829e08b6",
                                        "entry_id": "3dc66611-229f-3a23-9d0b-b6760b22c4b4",
                                        "glosses": [
                                            "Direction donnée à un élément graphique, un symbole ou une structure géométrique, par rapport aux côtés de la carte."
                                        ],
                                        "tags": [
                                            "Variable visuelle"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b4f3cfe-c883-32ab-9405-d73be9c5f872",
                                        "entry_id": "3dc66611-229f-3a23-9d0b-b6760b22c4b4",
                                        "glosses": [
                                            "Orientation de renseignement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fc281c5-e7ae-41b8-a9c7-b8da14cd3a28",
                        "source_entry_id": "5688be55-71c4-3e96-9933-70580d1af690",
                        "source_sense_description": "способность ориентироваться",
                        "target_lang_word": "repérage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repérage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9dce993-a460-36b9-af6c-d6a51295e52b",
                                        "entry_id": "052c7d70-53bc-38bd-85e5-d62b97e9c0cc",
                                        "glosses": [
                                            "Action de repérer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b57dcd24-94d3-4a65-9c54-2b5d92e9b5f8",
                                                "sense_id": "b9dce993-a460-36b9-af6c-d6a51295e52b",
                                                "text": "Je repris le travail. Il y a eu six voitures boches pour le repérage de postes émetteurs qui ont sauté par nos soins."
                                            },
                                            {
                                                "example_id": "6d8e098b-f9ce-43c8-881d-f753bdbb74d7",
                                                "sense_id": "b9dce993-a460-36b9-af6c-d6a51295e52b",
                                                "text": "Enfin, pour le repérage des noms de lieu et des réseaux de communication terrestres, les deux atlas routiers, Southeast Asia et Indonesia, publiés chez Nelles Verlag, demeurent irremplaçables."
                                            },
                                            {
