                        "target_lang_word": "Abram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ce05316-e793-34bb-803d-ceb6db05e9a6",
                                        "entry_id": "e53e866e-8d0c-3eff-b911-fb7681a421ee",
                                        "glosses": [
                                            "Abraham (prophet in the Old Testament)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f4da70-f375-48c3-a0be-37a60dd031e3",
                                                "sense_id": "9ce05316-e793-34bb-803d-ceb6db05e9a6",
                                                "text": "And Abram took Sarai his wife, and Lot his brother's son, and all their substance that they had gathered, and the souls that they had gotten in Haran; and they went forth to go into the land of Canaan; and into the land of Canaan they came."
                                            },
                                            {
                                                "example_id": "398b2639-9f12-4512-bd98-450414271681",
                                                "sense_id": "9ce05316-e793-34bb-803d-ceb6db05e9a6",
                                                "text": "O father Abram, what these Christians are,\nWhose own hard dealings teaches them suspect\nThe thoughts of others! […]"
                                            },
                                            {
                                                "example_id": "4ca869a1-79be-4230-a251-39cb75609c75",
                                                "sense_id": "9ce05316-e793-34bb-803d-ceb6db05e9a6",
                                                "text": "Abram took Sarai his wife, Lot his brother’s son, and all their possessions that they had accumulated, and the people that they had acquired in Harran, and they set out for the land of Canaan. They came to the land of Canaan."
                                            },
                                            {
                                                "example_id": "0b7025e9-484e-4b7e-aaf7-4c596ec0df0d",
                                                "sense_id": "9ce05316-e793-34bb-803d-ceb6db05e9a6",
                                                "text": "No longer will your name be called Abram, but your name will be Abraham, for I have made you the father of a multitude of nations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78c92cb-3119-3034-8895-00a78b2c2cf5",
                                        "entry_id": "e53e866e-8d0c-3eff-b911-fb7681a421ee",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b615f8ef-6342-3056-a5a1-15f98ceb63ca",
                                        "entry_id": "e53e866e-8d0c-3eff-b911-fb7681a421ee",
                                        "glosses": [
                                            "A surname from Hebrew [in turn originating as a patronymic]."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
