                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ca066ad-cb64-45ce-a59c-06740f28ca87",
                                "sense_id": "8744221c-8532-3a4e-9c66-df818d9aa456",
                                "text": "„Entwickeln Mitarbeiter in virtuellen Teams ein hohes Ausmaß an Commitment gegenüber der Organisation, dem Team oder ihrer Tätigkeit?“"
