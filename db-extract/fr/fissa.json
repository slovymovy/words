                                            },
                                            {
                                                "example_id": "63823abd-cc9e-40ba-a8cc-29473a8f457d",
                                                "sense_id": "b592bdc1-d84c-3ee2-843e-07889642fdd8",
                                                "text": "Make it snappy!",
