                                "target_senses": [
                                    {
                                        "sense_id": "b007744b-19a2-3ef6-be5b-b846b41d5940",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "The act or process of qualifying for a position, achievement etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c303af27-40ee-424f-89b1-daa94579040d",
                                                "sense_id": "b007744b-19a2-3ef6-be5b-b846b41d5940",
                                                "text": "Qualification for this organization is extraordinarily difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdda4da4-91f4-3f4c-ac53-343b868c1b2a",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "An ability or attribute that aids someone's chances of qualifying for something; specifically, completed professional training."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b43f924b-4eca-4be8-85e3-3e64061f856d",
                                                "sense_id": "bdda4da4-91f4-3f4c-ac53-343b868c1b2a",
                                                "text": "What are your qualifications for this job?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfcbcd5c-72ce-3ee2-a1a1-235e67e56d5c",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "A certificate, diploma, or degree awarded after successful completion of a course, training, or exam."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e2797a8-1b91-37cc-bb64-c4651de991fc",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "A clause or condition which qualifies something; a modification, a limitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "034b37ee-d831-40d1-a455-0f4e2a797da3",
                                                "sense_id": "4e2797a8-1b91-37cc-bb64-c4651de991fc",
                                                "text": "I accept your offer, but with the following qualification."
                                            },
                                            {
                                                "example_id": "a94504b6-8682-4929-9fbd-9fb3f7f1b9bd",
                                                "sense_id": "4e2797a8-1b91-37cc-bb64-c4651de991fc",
                                                "text": "Before a vowel (as in rib, brake) r is usually pronounced as a fricative consonant by all groups of speakers. But the qualification 'usually' is necessary, for the Negroes tend to weaken r after a consonant; and they omit it, as do illiterate white speakers, in throat, throw, through."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74d50006-2d59-3626-947c-3ec19a463c86",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "A quality or attribute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e68ae6-611e-44bd-886f-5cabb834ca7e",
                                                "sense_id": "74d50006-2d59-3626-947c-3ec19a463c86",
                                                "text": "To shew, that these Qualfications, which we all pretend to be asham'd of, are the great support of a flourishing Society has been the subject of the foregoing Poem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de19c2c4-31ff-4a8a-b240-0e2ace2680e4",
                        "source_entry_id": "0e9a8f37-fa95-373b-b3aa-f8d5641cc4fd",
                        "target_lang_word": "ability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "412b39d1-6160-3da9-82bf-6585296f58d0",
                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "Suitableness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24e82e24-e3a7-3b5e-bd35-97012fdf804b",
                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "The quality or state of being able; capacity to do or of doing something; having the necessary power."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96d87197-55cb-4d6a-94b9-63098eb06a89",
                                                "sense_id": "24e82e24-e3a7-3b5e-bd35-97012fdf804b",
                                                "text": "This phone has the ability to have its software upgraded wirelessly."
                                            },
                                            {
                                                "example_id": "21929b69-5d1b-47c0-a5ba-81afa954078c",
                                                "sense_id": "24e82e24-e3a7-3b5e-bd35-97012fdf804b",
                                                "text": "This wood has the ability to fight off insects, fungus, and mold for a considerable time."
                                            },
                                            {
                                                "example_id": "8e2e4aee-ec4c-402f-bce4-5cd4576218ff",
                                                "sense_id": "24e82e24-e3a7-3b5e-bd35-97012fdf804b",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff0e75d3-bbd7-3c5f-9115-d78cd41b1efc",
                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "The legal wherewithal to act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cac8025e-50bd-4815-b9b4-48c901b28379",
                                                "sense_id": "ff0e75d3-bbd7-3c5f-9115-d78cd41b1efc",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them, which is then licensed to related businesses in high-tax countries, is often assumed to be the preserve of high-tech companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d242e59d-7324-3369-819f-1e55468343e3",
                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "Physical power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8aa09ab-dfbb-3aa9-bb75-23368137aa6a",
                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "Financial ability."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71f55301-0ab7-335e-bdfa-ab5474c1dcd6",
                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "A unique power of the mind; a faculty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "969bcffc-ae76-3de8-acc4-179c8f481056",
                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "A skill or competence in doing; mental power; talent; aptitude."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e011940-2e13-4bd3-b501-2a7f30cd0465",
                                                "sense_id": "969bcffc-ae76-3de8-acc4-179c8f481056",
                                                "text": "a mixed-ability class"
                                            },
                                            {
                                                "example_id": "37316dd0-29bb-49d4-b7b8-807b05609da7",
                                                "sense_id": "969bcffc-ae76-3de8-acc4-179c8f481056",
                                                "text": "They are persons of ability, who will go far in life."
                                            },
                                            {
                                                "example_id": "767f96e6-1613-47fd-a955-1f5efcbf388a",
                                                "sense_id": "969bcffc-ae76-3de8-acc4-179c8f481056",
                                                "text": "She has an uncanny ability to defuse conflict."
                                            },
                                            {
                                                "example_id": "ec804289-4bf2-450e-aa5e-ffef304b1719",
                                                "sense_id": "969bcffc-ae76-3de8-acc4-179c8f481056",
                                                "text": "Then the disciples, euery man according to his abilitie, determined to send reliefe vnto the brethren which dwelt in Iudea."
                                            },
                                            {
                                                "example_id": "a8a175a4-f98f-4215-8197-eb7a706b7d1e",
                                                "sense_id": "969bcffc-ae76-3de8-acc4-179c8f481056",
                                                "text": "The public men of England, with much of a peculiar kind of ability"
                                            },
                                            {
                                                "example_id": "d682dbda-1e63-4141-868a-2fae2faff5cf",
                                                "sense_id": "969bcffc-ae76-3de8-acc4-179c8f481056",
                                                "text": "Natural abilities are like natural plants, that need pruning by study -"
                                            },
                                            {
                                                "example_id": "d80b6e0f-1821-441b-afc8-594e8738fcf9",
                                                "sense_id": "969bcffc-ae76-3de8-acc4-179c8f481056",
                                                "text": "The most persistent tormentor was Alex Oxlade-Chamberlain, who scored a hat-trick in last month’s corresponding fixture in Iceland. His ability to run at defences is instantly striking, but it is his clever use of possession that has persuaded some shrewd judges that he is an even better prospect than Theo Walcott."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1a3b90a-6995-4a2d-865b-508467f39293",
                        "source_entry_id": "0e9a8f37-fa95-373b-b3aa-f8d5641cc4fd",
                        "target_lang_word": "qualification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
