{
    "word_family": [
        "housekeep",
        "housekeeping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8aa04d6d-69df-38e6-bda1-a7bc1b4a1d1a",
                    "sense_definition": "A person employed to manage household affairs, supervise domestic chores, or oversee cleaning operations in a private home, hotel, or institution.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "household_management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel <w>housekeeper</w> inspected each room before allowing the new guests to check in.",
                            "target_lang_translations": {
                                "ru": "Гостиничная <w>горничная</w> проверила каждый номер, прежде чем разрешить заселение новым гостям."
                            }
                        },
                        {
                            "text": "They decided to hire a <w>housekeeper</w> to cook, clean, and manage the daily chores.",
                            "target_lang_translations": {
                                "ru": "Они решили нанять <w>домработницу</w>, чтобы она готовила, убирала и вела повседневные домашние дела."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hotel housekeeper",
                        "hire a housekeeper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, нанятый для ведения домашнего хозяйства, руководства прислугой или контроля за уборкой в частном доме, гостинице или учреждении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экономка",
                                "target_lang_sense_clarification": "управляющая хозяйством в доме"
                            },
                            {
                                "target_lang_word": "домработница",
                                "target_lang_sense_clarification": "наёмная помощница по дому"
                            },
                            {
                                "target_lang_word": "домоправительница",
                                "target_lang_sense_clarification": "женщина, руководящая домашним хозяйством"
                            },
                            {
                                "target_lang_word": "горничная",
                                "target_lang_sense_clarification": "в гостинице или отеле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd9e989a-2dbd-3cc0-ba97-c25c924b9b1d",
                    "sense_definition": "A person, traditionally the female head of a household, who manages the domestic routines and running of a home.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "household_management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took immense pride in being an organized <w>housekeeper</w> who kept everything in order.",
                            "target_lang_translations": {
                                "ru": "Она очень гордилась тем, что была организованной <w>хозяйкой</w>, у которой всё содержалось в полном порядке."
                            }
                        },
                        {
                            "text": "My grandmother was a thrifty <w>housekeeper</w> who always managed to save money on groceries.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка была экономной <w>хозяйкой</w>, которой всегда удавалось сберечь деньги на продуктах."
                            }
                        }
                    ],
                    "synonyms": [
                        "homemaker"
                    ],
                    "common_phrases": [
                        "good housekeeper"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in traditional or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек (традиционно хозяйка дома), который ведёт домашний быт и следит за порядком в семье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хозяйка",
                                "target_lang_sense_clarification": "хранительница домашнего очага, ведущая хозяйство"
                            },
                            {
                                "target_lang_word": "домохозяйка",
                                "target_lang_sense_clarification": "женщина, занимающаяся домашним хозяйством"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e159c92d-13fb-3709-b753-1e9cf532d57a",
                    "sense_definition": "A person who rarely leaves their home; a homebody.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ever since he retired, he has turned into a quiet <w>housekeeper</w> who avoids going out.",
                            "target_lang_translations": {
                                "ru": "С тех пор как он вышел на пенсию, он превратился в тихого <w>домоседа</w>, который избегает выходить на улицу."
                            }
                        },
                        {
                            "text": "She was never much of a <w>housekeeper</w>, preferring outdoor travel to staying inside.",
                            "target_lang_translations": {
                                "ru": "Она никогда не была особой <w>домоседкой</w>, предпочитая путешествия на свежем воздухе сидению дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "homebody",
                        "stay-at-home"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used to describe a stay-at-home person or homebody"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который редко выходит из дома; домосед."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "домосед",
                                "target_lang_sense_clarification": "человек, любящий сидеть дома"
                            },
                            {
                                "target_lang_word": "домоседка",
                                "target_lang_sense_clarification": "женщина, редко выходящая из дома"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56d6c736-be06-3dec-92ac-f6381b2f59bf",
                    "sense_definition": "A person who owns or occupies a house; a householder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In former times, only a registered <w>housekeeper</w> had the right to vote in local matters.",
                            "target_lang_translations": {
                                "ru": "В прежние времена только зарегистрированный <w>домовладелец</w> имел право голоса по местным вопросам."
                            }
                        },
                        {
                            "text": "As an established <w>housekeeper</w> of the parish, he was entitled to certain community privileges.",
                            "target_lang_translations": {
                                "ru": "Как признанный <w>домохозяин</w> прихода, он имел право на определённые общественные привилегии."
                            }
                        }
                    ],
                    "synonyms": [
                        "householder"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historically referring to a householder or homeowner"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Владелец или наниматель дома; глава домохозяйства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "домовладелец",
                                "target_lang_sense_clarification": "владелец дома"
                            },
                            {
                                "target_lang_word": "домохозяин",
                                "target_lang_sense_clarification": "глава домохозяйства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}