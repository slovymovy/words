                "senses": [
                    {
                        "sense_id": "d2be8fab-57b2-3ea4-9d18-ac24bb98f0a0",
                        "entry_id": "a9f91bf5-f282-31d3-938f-3f8cb245f052",
                        "glosses": [
                            "Anpassung an eine bestimmte Verhaltensweise, Brauch oder Umgebung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d1d0bd0-dfb1-4dee-9eeb-4a61bbd243b5",
                                "sense_id": "d2be8fab-57b2-3ea4-9d18-ac24bb98f0a0",
                                "text": "Ihm fällt die Gewöhnung an neue Umgebungen sehr leicht."
                            },
                            {
                                "example_id": "b35b196d-a1e8-433d-8f7b-4a64a00ef48c",
                                "sense_id": "d2be8fab-57b2-3ea4-9d18-ac24bb98f0a0",
                                "text": "Die Gewöhnung der Augen an die Helligkeit des Tages dauerte ein paar Minuten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b0730c86-4cf9-3304-bb4d-174fc7ea0fce",
                        "entry_id": "a9f91bf5-f282-31d3-938f-3f8cb245f052",
                        "glosses": [
                            "Handlung, die zur Routine wurde und immer wieder, oft unbewusst, wiederholt wird; Gewohnheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cc71967-0f51-472e-b61a-8b0415ec12b6",
                                "sense_id": "b0730c86-4cf9-3304-bb4d-174fc7ea0fce",
                                "text": "„Schlechte häusliche Erziehung reißt in einem Tage durch böses Beispiel und durch schlechte Gewöhnung das nieder, was die Schule in Wochen und Monaten mühsam aufgebaut hat[.]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
