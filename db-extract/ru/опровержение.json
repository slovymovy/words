                "senses": [
                    {
                        "sense_id": "16c48199-c21a-3be1-bc23-aef89a643630",
                        "entry_id": "486dc8a0-dd46-3e79-916c-d030e2dbbd7e",
                        "glosses": [
                            "действие по значению гл. опровергнуть, опровергать; рассуждение, направленное против выдвинутого утверждения, предположения или доказательства и имеющее своей целью установление его ложности или недоказанности"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a15539f1-e0fe-374f-ad3d-dcdca9d830c0",
                        "entry_id": "486dc8a0-dd46-3e79-916c-d030e2dbbd7e",
                        "glosses": [
                            "речь или статья, в которой что-либо опровергается"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45dfcbb2-d8c6-42d3-b553-5d4939455d00",
                        "source_entry_id": "486dc8a0-dd46-3e79-916c-d030e2dbbd7e",
                        "target_lang_word": "refutation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refutation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c7078bf-c158-3ba7-8551-a3371e020ef8",
                                        "entry_id": "81c96b2e-2b01-354b-9160-d2374fef2406",
                                        "glosses": [
                                            "An act of refuting or disproving; the disproving of an argument, opinion, testimony, doctrine or theory by argument or countervailing proof; evidence of falseness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeee3e67-4d53-49ba-be24-a4945d863fcf",
                                                "sense_id": "4c7078bf-c158-3ba7-8551-a3371e020ef8",
                                                "text": "Near-synonym: rebuttal (see note)"
                                            },
                                            {
                                                "example_id": "e1845842-8d75-4a3e-9342-fa5f44c108e1",
                                                "sense_id": "4c7078bf-c158-3ba7-8551-a3371e020ef8",
                                                "text": "Apply these tests to his arguments and you will render your task of refutation easier. But in your refutation, be sure you refute. Don’t think for a minute that either heat or violence or sarcasm is a good answer."
                                            },
                                            {
                                                "example_id": "16cb5d01-7ebc-4394-9532-cc667da345d5",
                                                "sense_id": "4c7078bf-c158-3ba7-8551-a3371e020ef8",
                                                "text": "The conclusion to which we shall be led by a full consideration of these facts will be that the effective refutation of such errors will frequently require further intellectual advance, and often advance on points which are very abstract and may seem very remote from the practical issues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9dcf448-be6f-31e8-a390-295189dc7397",
                                        "entry_id": "81c96b2e-2b01-354b-9160-d2374fef2406",
                                        "glosses": [
                                            "A vocal answer to an attack on one's assertions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
