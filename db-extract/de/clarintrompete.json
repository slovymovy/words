                "senses": [
                    {
                        "sense_id": "f38836d6-fe32-3d17-9fdf-9cd800352f03",
                        "entry_id": "09e6ed78-ab41-365a-aa4f-d76af8cb0d1d",
                        "glosses": [
                            "die hohe Barocktrompete, die etwa viermal so lang ist wie geläufige Bachtrompete"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "2ab41de8-6ac4-4778-a8d1-8e9b78b64974",
                                "sense_id": "f38836d6-fe32-3d17-9fdf-9cd800352f03",
                                "text": "„Bachs Magnificat „historisch“, mit niedrigem Kammerton, Darmsaiten, Clarintrompeten und Knabenstimmen – das klingt – auch dank der vorzüglichen Aufnahme in der oberbayrischen Pfarrkirche Lenggries – nicht schmächtig oder steril, sondern glanzvoll farbig und mächtig wie selten sonst.“"
                            },
                            {
                                "example_id": "c3742933-c3e1-4b63-adda-de478bf10d54",
                                "sense_id": "f38836d6-fe32-3d17-9fdf-9cd800352f03",
                                "text": "„Obwohl die tiefe Stimmung der Clarintrompete (Don Smithers) den Streichern intonatorische Schwierigkeiten bereitete, hinterließ die Darbietung dieses Ensembles einen fabelhaften, in sich geschlossenen Eindruck.“"
                            },
                            {
                                "example_id": "16464f38-54fb-47f0-a446-e2b5ba2fc2cc",
                                "sense_id": "f38836d6-fe32-3d17-9fdf-9cd800352f03",
                                "text": "„An dieser Stelle sind schon viele neue und richtige Gedanken zu dem Problem der Clarintrompete von anerkannten Interpreten und Musikwissenschaftlern geäußert worden.“"
                            },
                            {
                                "example_id": "f4f2ee54-d40d-4328-90ac-0f41066243a8",
                                "sense_id": "f38836d6-fe32-3d17-9fdf-9cd800352f03",
                                "text": "„Zwei wesentliche Unterschiede gibt es zwischen einer modernen sogenannten Bach-Trompete und einer barocken Clarintrompete."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
