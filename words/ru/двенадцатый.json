                {
                    "sense_id": "9965dff2-7f53-3852-aa2b-fefd7abf55ca",
                    "sense_definition": "Имеющий порядковый номер двенадцать в ряду однородных объектов.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "порядковые числительные",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был <w>двенадцатый</w> дом на нашей улице.",
                            "target_lang_translations": {
                                "en": "This was the <w>twelfth</w> house on our street."
                            }
                        },
                        {
                            "text": "Сегодня <w>двенадцатое</w> число месяца.",
                            "target_lang_translations": {
                                "en": "Today is the <w>twelfth</w> of the month."
                            }
                        }
                    ],
                    "common_phrases": [
                        "двенадцатый номер",
                        "двенадцатый класс"
                    ],
                    "target_lang_definitions": {
                        "en": "The ordinal number corresponding to twelve, indicating the position of an object in a sequence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "twelfth",
                                "target_lang_sense_clarification": "Ordinal number representing the position number 12 in a series."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2358ca9e-3086-322d-ad3d-5bfa7644ea66",
                    "sense_definition": "Относящийся к году, оканчивающемуся на двенадцать (например, 2012, 1912).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "время",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <w>двенадцатом</w> году я закончил университет.",
                            "target_lang_translations": {
                                "en": "I graduated from university in '12 (the <w>twelfth</w> year)."
                            }
                        },
                        {
                            "text": "События происходили в <w>двенадцатом</w> году.",
                            "target_lang_translations": {
                                "en": "The events took place in the <w>twelfth</w> year."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to a year ending in twelve (e.g., 2012, 1912)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "twelfth",
                                "target_lang_sense_clarification": "Used in English to refer to a year ending in 12, often abbreviated as '12."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a15b666-9c6c-364f-9fd4-654a74710c15",
                    "sense_definition": "Одна из двенадцати равных частей целого.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "дроби",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он съел <w>двенадцатую</w> часть пирога.",
                            "target_lang_translations": {
                                "en": "He ate a <w>twelfth</w> of the pie."
                            }
                        },
                        {
                            "text": "Это составляет лишь <w>двенадцатую</w> долю от общего объема.",
                            "target_lang_translations": {
                                "en": "This accounts for only a <w>twelfth</w> of the total volume."
                            }
