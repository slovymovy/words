                                                "text": "„Die Papierfabriken am Flüsschen Wipper verpachtete Bismarck an Geschäftsleute aus einer nahe gelegenen Stadt.“"
                                            },
                                            {
                                                "example_id": "11d928f5-ff1d-4612-b666-40401891c531",
                                                "sense_id": "802dd96b-a7a8-3c06-ac44-6cde2b73cc8f",
                                                "text": "„Erst am 11. April 1957 startete er seinen neuen Coup durch die Einladung des fetten, mit Schmissen behafteten Herrn Direktor Schallenberg, der eine Papierfabrik besaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
