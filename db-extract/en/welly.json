                    {
                        "sense_id": "8aa606d8-b835-32d3-8d76-f8ed492fa7ec",
                        "entry_id": "f57060be-8917-32e1-859b-c2230aa1097a",
                        "glosses": [
                            "Force or effort."
                        ],
                        "tags": [
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "48fc330b-92b4-4738-abf9-a3164fbaf181",
                                "sense_id": "8aa606d8-b835-32d3-8d76-f8ed492fa7ec",
                                "text": "Come on! Put some welly into it!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c489ca5f-f762-4d95-bfe4-268f8fcab501",
                        "source_entry_id": "f57060be-8917-32e1-859b-c2230aa1097a",
                        "source_sense_description": "force on a pedal or increase to any fuel or power for an engine or motor",
                        "target_lang_word": "Gas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f516fa8-c6d0-3a87-8b78-d23823b30aaa",
                                        "entry_id": "61beec1c-448e-3147-a805-c463165aae0a",
                                        "glosses": [
                                            "Materie im gasförmigen Aggregatzustand; nicht Festkörper oder Flüssigkeit"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec9e6ba5-adb3-4a6a-b1a1-7b6cb3bc4972",
                                                "sense_id": "2f516fa8-c6d0-3a87-8b78-d23823b30aaa",
                                                "text": "Methan ist ein leicht entflammbares Gas."
                                            },
                                            {
                                                "example_id": "28e7d0d1-699f-4e35-b768-74064a81f0f7",
                                                "sense_id": "2f516fa8-c6d0-3a87-8b78-d23823b30aaa",
                                                "text": "Das Gas selbst ist zwar unsichtbar, aber die hellblaue Farbe der Galaxien zeugt von Sternenentstehungen, die ohne Gas nicht möglich wären."
                                            },
                                            {
                                                "example_id": "8cdd09a9-8db5-4171-a4c6-ea473a6cbb92",
                                                "sense_id": "2f516fa8-c6d0-3a87-8b78-d23823b30aaa",
                                                "text": "Helium ist im normalen Zustand ein Gas."
                                            },
                                            {
                                                "example_id": "5321317a-bf30-4900-89f4-99554b2f94ef",
                                                "sense_id": "2f516fa8-c6d0-3a87-8b78-d23823b30aaa",
                                                "text": "„Ich kroch in die Küche, drehte das Gas unter den Bohnen ab, unter dem Wasser, ging wieder ins Wohnzimmer, setzte die Kognakflasche an den Mund: Es half nichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7c323cd-ba92-3852-bc4c-759263703263",
                                        "entry_id": "61beec1c-448e-3147-a805-c463165aae0a",
                                        "glosses": [
                                            "das Gaspedal in Kraftfahrzeugen (und damit verbunden der Vorgang, dass ein Luft-Gas-Gemisch in den Zylinder gelangt und so in Antrieb/Tempo umgesetzt wird)"
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5823cf4a-f1fd-4f8f-92ad-2e0b81379c1f",
                                                "sense_id": "a7c323cd-ba92-3852-bc4c-759263703263",
                                                "text": "„Der Taxifahrer tritt aufs Gas.“"
                                            },
                                            {
                                                "example_id": "b33a9182-9af0-4cfe-a7cf-d241028ff595",
                                                "sense_id": "a7c323cd-ba92-3852-bc4c-759263703263",
                                                "text": "Beim Autofahren sollte man niemals Gas und Bremse gleichzeitig treten."
                                            },
                                            {
                                                "example_id": "51cdecba-344e-432b-b3e8-6fbde6655bd6",
                                                "sense_id": "a7c323cd-ba92-3852-bc4c-759263703263",
                                                "text": "„Der Wagen glitt fast ohne Gas die Serpentinen hinunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
