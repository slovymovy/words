                                        "entry_id": "1d1c553f-4cf4-3ec4-b30c-8cad7c0ab39f",
                                        "glosses": [
                                            "A form of popular and dance music featuring strong percussion and a powerful rhythm, usually accompanied by rapping."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbb1ecda-4caf-4b8a-a62b-ee5242e6adc4",
                                                "sense_id": "d49458d3-e5ac-35d9-81f3-67a0dad7f35b",
                                                "text": "Even though Houston’s moment was already fading by the late 2000s, the city’s hip-hop culture proved to be endlessly portable and disseminatable."
                                            }
