                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "347a9449-f93f-38fe-ae98-01f74102243d",
                                        "entry_id": "2798a311-d0a9-3ac3-b716-15e4826451a4",
                                        "glosses": [
                                            "Someone who originates, creates or founds something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0564336-e2f7-40f9-80ed-447e6817a0e4",
                                                "sense_id": "347a9449-f93f-38fe-ae98-01f74102243d",
                                                "text": "Another perfume was known as nicerotiana, named after its originator Nicerotas."
                                            },
                                            {
                                                "example_id": "02692362-a3e5-49bf-b694-7b4b8d9ded57",
                                                "sense_id": "347a9449-f93f-38fe-ae98-01f74102243d",
                                                "text": "These relay stations are actually special-purpose email servers. They are used to relay spam from the spam's originator so that the originator cannot be traced."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
