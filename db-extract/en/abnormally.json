                "senses": [
                    {
                        "sense_id": "c9695630-3f20-3e22-8c06-c390c9f3eefd",
                        "entry_id": "afc75a21-4d9f-37f4-a301-139ee9d18913",
                        "glosses": [
                            "In an abnormal manner; in a way that deviates from a standard, norm, or average."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d68058-6b36-40f3-90b0-0b8457ffd248",
                                "sense_id": "c9695630-3f20-3e22-8c06-c390c9f3eefd",
                                "text": "Living, as they did, in what appeared to me impenetrable darkness, their eyes were abnormally large and sensitive."
                            },
                            {
                                "example_id": "642cfd7a-0cf3-4f9f-9a0b-84343c6d1ae1",
                                "sense_id": "c9695630-3f20-3e22-8c06-c390c9f3eefd",
                                "text": "In mild cases of hypergonadism prior to puberty, the onset of physical and mood changes may not be abnormally early or significant enough to cause any psychological or long-term physical complications."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33a458d4-9ae9-4eee-bbf0-8bdeb3a0865f",
                        "source_entry_id": "afc75a21-4d9f-37f4-a301-139ee9d18913",
                        "source_sense_id": "c9695630-3f20-3e22-8c06-c390c9f3eefd",
                        "source_sense_description": "In an abnormal manner",
                        "target_lang_word": "abnormaal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnormaal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                                        "entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                                        "glosses": [
                                            "ongewoon, bijzonder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52263b4c-b399-4455-8740-5c476a516e3a",
                                                "sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                                                "text": "Hij heeft een abnormaal grote interesse in alles wat met Napoleon te maken heeft."
                                            },
                                            {
                                                "example_id": "8b6a9d89-f9e6-4995-b71f-8d675995f0aa",
                                                "sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                                                "text": "Elk geluid klonk abnormaal luid: het rammelen van haar sleutels, het zoemen van de koelkast, het blazen van Brontë."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6b18452-2ce0-3f4c-9b15-88b7799e86d5",
                                        "entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                                        "glosses": [
                                            "licht gek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e6cba79-d6b2-40b6-8658-e18556c90f20",
                                                "sense_id": "f6b18452-2ce0-3f4c-9b15-88b7799e86d5",
                                                "text": "Het meisje had altijd heel abnormale kleren aan, maar ze vond zichzelf heel bijzonder."
                                            },
                                            {
                                                "example_id": "66e5ffcb-aa26-4c0c-bb8c-123a9c30a82a",
                                                "sense_id": "f6b18452-2ce0-3f4c-9b15-88b7799e86d5",
                                                "text": "Ze verzachtte dat meteen: 'Ik bedoel niet dat er iets abnormaals aan was, alleen dat Adeline van mening leek te zijn dat de jongen exclusief van haar was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45bd89b2-c2c4-4c56-ad74-b1a3e1762c05",
                        "source_entry_id": "afc75a21-4d9f-37f4-a301-139ee9d18913",
