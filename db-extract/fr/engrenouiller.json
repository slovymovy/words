                                "sense_id": "8ab1836c-a1d9-3f88-84c6-ad1bf0d6ad80",
                                "text": "On a qu'à les engrenouiller par gènes interposés."
                            },
                            {
                                "example_id": "39978698-f8a5-479e-9f90-4cad2b661a21",
                                "sense_id": "8ab1836c-a1d9-3f88-84c6-ad1bf0d6ad80",
                                "text": "C’est moi, répondit le petit garçon engrenouillé."
                            }
                        ]
