                                                "example_id": "49752420-074c-4a47-88f2-d35e3b22a051",
                                                "sense_id": "de4b09fe-9736-3907-bd52-e6eb886c2dd9",
                                                "text": "(…) l’immense pouvoir que la cartomancie exerce sur les gens du peuple."
                                            },
