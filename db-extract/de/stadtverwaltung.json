                ],
                "senses": [
                    {
                        "sense_id": "0143c545-b709-326b-b36d-1ac106485802",
                        "entry_id": "d7b0c482-db87-3a0e-b1c9-94b744e77620",
                        "glosses": [
                            "die gesamten Behörden, die die öffentlichen Dienste einer Stadt organisieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e554d8b0-d75e-4265-bb4a-cdb37bf870dc",
                                "sense_id": "0143c545-b709-326b-b36d-1ac106485802",
                                "text": "„Die Stadtverwaltung rief die Bewohner der betroffenen Viertel auf, sich auf eine Evakuierung vorzubereiten.“"
                            },
                            {
                                "example_id": "fad4f70f-5c84-44bc-8d17-bf49ed6ca696",
                                "sense_id": "0143c545-b709-326b-b36d-1ac106485802",
                                "text": "„Insgesamt sollen Bestechungsgelder von bis zu 15 Millionen Dollar (elf Millionen Euro) auch an Entscheidungsträger in der Jerusalemer Stadtverwaltung geflossen sein.“"
                            },
                            {
                                "example_id": "23d1a058-e5cc-432d-85bd-e6124dfa7233",
                                "sense_id": "0143c545-b709-326b-b36d-1ac106485802",
                                "text": "„Ob es letztlich die Rücksichtnahme der Stadtverwaltung gegenüber einem ihrer besten Steuerzahler war, die das für mitteleuropäische Maßstäbe recht exotische Gebäude nicht als Hirngespinst eines Großverdieners enden ließ, ist heute nicht mehr nachweisbar.“"
                            },
                            {
                                "example_id": "8978bc70-946e-43b6-85e7-37b16d79f660",
                                "sense_id": "0143c545-b709-326b-b36d-1ac106485802",
                                "text": "„Sie meldete sich bei der Stadtverwaltung und sagte, sie habe ein Zimmer frei und wünsche sich einen jungen Syrer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
