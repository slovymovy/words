                        "glosses": [
                            "In an invidious manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f904b651-9eec-42c5-96c9-21f8e205aa94",
                                "sense_id": "fda134de-8c58-3a24-a173-3e52d16a2d35",
                                "text": "You ask too much, for a man who himself has no occasion to play the hero. I don't say that invidiously; it's your disposition, and you can’t help it."
                            },
                            {
                                "example_id": "f2859f87-d6c9-4130-b005-0918ab9c8b18",
                                "sense_id": "fda134de-8c58-3a24-a173-3e52d16a2d35",
                                "text": "Tess gazed desperately at the pile of furniture. The cold sunlight of this spring evening peered invidiously upon the crocks and kettles, upon the bunches of dried herbs shivering in the breeze, upon the brass handles of the dresser, upon the wicker-cradle they had all been rocked in, […]"
                            },
                            {
                                "example_id": "849702c8-a4d7-416d-9d53-cbaac5ccd81a",
                                "sense_id": "fda134de-8c58-3a24-a173-3e52d16a2d35",
                                "text": "Which country are we to toast in an impassioned and half-informed way? Which country are we to compare invidiously with our own?"
                            }
                        ]
                    }
                ],
