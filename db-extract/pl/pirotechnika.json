                                    {
                                        "sense_id": "e522973b-0585-3143-8df5-c1c32a0e5f6d",
                                        "entry_id": "5fe8cd3d-e5a1-3375-9868-f4a66affdf77",
                                        "glosses": [
                                            "The art and technology of fireworks and related military applications."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82cdcfb8-5dca-3cb8-a097-a14f675e5a19",
                                        "entry_id": "5fe8cd3d-e5a1-3375-9868-f4a66affdf77",
                                        "glosses": [
                                            "A display of fireworks."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b22e2ac7-4380-3cca-bed3-eb77ca139782",
                                        "entry_id": "5fe8cd3d-e5a1-3375-9868-f4a66affdf77",
                                        "glosses": [
                                            "An impressive display."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "441fdf9d-f377-44b4-8e40-e107e1914351",
                                                "sense_id": "b22e2ac7-4380-3cca-bed3-eb77ca139782",
                                                "text": "Dazzling verbal pyrotechnics and incredibly vivid characterization."
                                            },
                                            {
                                                "example_id": "85b8af8a-25a3-472a-a3b2-fd8e63457f92",
                                                "sense_id": "b22e2ac7-4380-3cca-bed3-eb77ca139782",
                                                "text": "Mainstream Records, wowed by Nugent's Hendrix-like guitar pyrotechnics, signed the guys and issued their self-titled debut album in 1968."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f57540e-0f2b-470e-88e3-0a8c4738777f",
                        "source_entry_id": "7dee88aa-d1dc-32b0-83af-b001b236fd6e",
                        "source_sense_id": "8308c3a7-b387-3b73-b9cf-7dca4f499411",
                        "target_lang_word": "pyrotechny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrotechny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd18f58c-f832-3c25-b625-264a32d4edbe",
                                        "entry_id": "7dafb1af-d952-3916-9904-9f45eac341e0",
                                        "glosses": [
                                            "The manufacture and use of fireworks."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06a01f4f-ddcf-4b40-81e6-c16720996dbe",
                                                "sense_id": "cd18f58c-f832-3c25-b625-264a32d4edbe",
                                                "text": "[Shakespeare] was master of the revels to mankind. Is it not as if one should have, through majestic powers of science, the comets given into his hand, or the planets and their moons, and should draw them from their orbits to glare with the municipal fireworks on a holiday night, and advertise in all towns, “very superior pyrotechny this evening!”"
                                            },
                                            {
                                                "example_id": "2bd5672e-08be-4f2d-83a2-6b199a51e943",
                                                "sense_id": "cd18f58c-f832-3c25-b625-264a32d4edbe",
                                                "text": "‘[…] I came to the conclusion that this demonstration of our skill in the art of pyrotechny was valuable, if only because it impressed upon them ... the superiority of the British.... […]’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b765b1a8-4ffa-343b-b6b2-c8259bc49bfa",
                                        "entry_id": "7dafb1af-d952-3916-9904-9f45eac341e0",
                                        "glosses": [
                                            "Impressive, dazzling or virtuosic display."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16331f9e-09f0-422d-9fa1-a3e1f12e9fab",
                                                "sense_id": "b765b1a8-4ffa-343b-b6b2-c8259bc49bfa",
                                                "text": "But if all rhetoric is a mode of pyrotechny, and all pyrotechnics are by necessity fugacious, yet even in these frail pomps there are many degrees of frailty."
                                            },
                                            {
                                                "example_id": "c98dfa1b-e640-47a5-b498-f5a412c057e2",
                                                "sense_id": "b765b1a8-4ffa-343b-b6b2-c8259bc49bfa",
                                                "text": "It was Le Gascon who, not finding room enough for his exquisite pyrotechny on the outside of the volumes that he had to bind, conceived the idea of lining the side-covers with morocco and continuing his brilliant fiorituri on the inside too."
                                            },
                                            {
                                                "example_id": "01602f59-dd85-4f39-bcd1-247b2086cd61",
                                                "sense_id": "b765b1a8-4ffa-343b-b6b2-c8259bc49bfa",
                                                "text": "A score of years ago those who cared at all for the dramatic element in opera, and the measure of whose delight was not filled up by the vocal pyrotechny which was the mainstay of the operas of the older répertoire, found in these music-dramas their chief solace and satisfaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f48ead67-310b-3e26-aacd-f65bf5815a07",
                                        "entry_id": "7dafb1af-d952-3916-9904-9f45eac341e0",
                                        "glosses": [
                                            "The use of fire in chemistry and metallurgy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79d665fb-5f96-470d-99af-63806852cee2",
                                                "sense_id": "f48ead67-310b-3e26-aacd-f65bf5815a07",
                                                "text": "1670, Uncredited translator, The Golden Calf by John Frederick Helvetius (1667), London: John Starkey, Chapter 4,\nIndeed all men well skilled in the Chymical Science, have a necessity of assenting to me in this, viz. that Pyrotechny is the Mother, and Nurse of various noble Sciences and Arts."
                                            },
                                            {
                                                "example_id": "96d4a207-db0c-4331-82e2-6c8f52b4249e",
                                                "sense_id": "f48ead67-310b-3e26-aacd-f65bf5815a07",
                                                "text": "Nor have the Physicians only neglected, but been ignorant of the Pharmaceutick Part. Neither can the Apothecaries any more than the Physicians pretend themselves compleat herein, being generally alike ignorant of the chief and most artful Part, Pyrotechny, leaving its most effectual Preparations to the Care of those, whose Care is only how they may make them, not most adapted to the Cure of Diseases, but to their best Advantage […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84dbecda-cb9a-3488-ba6f-3080fd41933d",
                                        "entry_id": "7dafb1af-d952-3916-9904-9f45eac341e0",
                                        "glosses": [
                                            "The manufacture and use of gunpowder, bombs etc."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2b6e9ed-a537-4b5f-959b-38ec571d82c5",
                                                "sense_id": "84dbecda-cb9a-3488-ba6f-3080fd41933d",
                                                "text": "Gunpowder and the compositions of pyrotechny are the means used, in modern warfare, to propel projectiles, explode mines, destroy ships and buildings, and furnish light and signals for the operations of an army at night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20410711-0422-4e74-bbd6-db76d4bc332b",
                        "source_entry_id": "7dee88aa-d1dc-32b0-83af-b001b236fd6e",
                        "source_sense_id": "8308c3a7-b387-3b73-b9cf-7dca4f499411",
