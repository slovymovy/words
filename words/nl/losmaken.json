{
    "word_family": [
        "los",
        "maken",
        "losmaking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a52902c3-4e5b-3d38-9b6c-3d2a783c06bd",
                    "sense_definition": "Ervoor zorgen dat iets of iemand niet meer vastzit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysiek_losmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten eerst die knoop <w>losmaken</w> voordat we het touw kunnen gebruiken.",
                            "target_lang_translations": {
                                "en": "We first need to <w>untie</w> that knot before we can use the rope."
                            }
                        },
                        {
                            "text": "Kun je de veters van je schoenen <w>losmaken</w>?",
                            "target_lang_translations": {
                                "en": "Can you <w>undo</w> your shoelaces?"
                            }
                        }
                    ],
                    "synonyms": [
                        "ontknopen",
                        "losdoen"
                    ],
                    "antonyms": [
                        "vastmaken"
                    ],
                    "common_phrases": [
                        "een knoop losmaken",
                        "de veters losmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "To ensure that something or someone is no longer attached or fastened."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "untie",
                                "target_lang_sense_clarification": "specifically for knots or laces"
                            },
                            {
                                "target_lang_word": "unfasten",
                                "target_lang_sense_clarification": "for buttons, belts, or mechanical attachments"
                            },
                            {
                                "target_lang_word": "loosen",
                                "target_lang_sense_clarification": "to make something less tight"
                            },
                            {
                                "target_lang_word": "detach",
                                "target_lang_sense_clarification": "to separate one thing from another"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e8a1c8f-0bca-3565-8f5e-639de5c1b222",
                    "sense_definition": "Sterke emoties, reacties of herinneringen oproepen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotioneel_effect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit oude liedje gaat een hoop herinneringen bij mij <w>losmaken</w>.",
                            "target_lang_translations": {
                                "en": "This old song is going to <w>stir up</w> a lot of memories for me."
                            }
                        },
                        {
                            "text": "Zijn toespraak wist veel emoties <w>los</w> te <w>maken</w> bij het publiek.",
                            "target_lang_translations": {
                                "en": "His speech managed to <w>evoke</w> many emotions in the audience."
                            }
                        }
                    ],
                    "synonyms": [
                        "teweegbrengen",
                        "oproepen"
                    ],
                    "common_phrases": [
                        "emoties losmaken",
                        "veel losmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "To evoke strong emotions, reactions, or memories."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stir up",
                                "target_lang_sense_clarification": "to provoke emotions or memories"
                            },
                            {
                                "target_lang_word": "evoke",
                                "target_lang_sense_clarification": "to bring a feeling or memory to mind"
                            },
                            {
                                "target_lang_word": "trigger",
                                "target_lang_sense_clarification": "to cause a sudden reaction"
                            },
                            {
                                "target_lang_word": "unleash",
                                "target_lang_sense_clarification": "to release powerful emotions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec5e8d6a-34df-335c-86cb-52d5d1d206b6",
                    "sense_definition": "Zichzelf emotioneel of sociaal onafhankelijker maken van iets of iemand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onafhankelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jullie moeten je echt wat meer <w>losmaken</w> van elkaar om zelfstandig te worden.",
                            "target_lang_translations": {
                                "en": "You really need to <w>detach yourselves</w> from each other a bit more to become independent."
                            }
                        },
                        {
                            "text": "Het is moeilijk om je <w>los</w> te <w>maken</w> van je verleden.",
                            "target_lang_translations": {
                                "en": "It is difficult to <w>break free</w> from your past."
                            }
                        }
                    ],
                    "synonyms": [
                        "distantiëren",
                        "ontworstelen"
                    ],
                    "common_phrases": [
                        "zich losmaken van"
                    ],
                    "target_lang_definitions": {
                        "en": "To make oneself emotionally or socially more independent from something or someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "detach oneself",
                                "target_lang_sense_clarification": "to become emotionally independent"
                            },
                            {
                                "target_lang_word": "break free",
                                "target_lang_sense_clarification": "to escape from a connection or influence"
                            },
                            {
                                "target_lang_word": "distance oneself",
                                "target_lang_sense_clarification": "to create social or emotional space"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb7f2432-c1fd-36e0-b897-80abc300a725",
                    "sense_definition": "Alle koopwaar van een verkoper opkopen zodat deze naar huis kan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verkoop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De marktkoopman riep aan het eind van de dag: Wie <w>maakt</w> me <w>los</w>?",
                            "target_lang_translations": {
                                "en": "At the end of the day, the market trader shouted: Who will <w>buy me out</w>?"
                            }
                        },
                        {
                            "text": "Ik heb de laatste appels gekocht om de boer <w>los</w> te <w>maken</w>.",
                            "target_lang_translations": {
                                "en": "I bought the last apples to <w>clear out</w> the farmer's stock."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wie maakt me los"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt door marktkooplieden"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To buy all of a seller's remaining goods so they can finish work and go home."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "buy out",
                                "target_lang_sense_clarification": "to purchase the remaining stock"
                            },
                            {
                                "target_lang_word": "clear out",
                                "target_lang_sense_clarification": "to help a seller finish their day by buying everything"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5766d5d4-7b18-3bed-94a2-0ddb4705ba3e",
                    "sense_definition": "Iets met moeite of door overreding van iemand verkrijgen, vaak geld of informatie.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verkrijgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb dit mooie huis voor een koopje bij hem kunnen <w>losmaken</w>.",
                            "target_lang_translations": {
                                "en": "I was able to <w>pry</w> this beautiful house <w>loose</w> from him for a bargain."
                            }
                        },
                        {
                            "text": "Het was lastig om wat extra budget voor het project <w>los</w> te <w>maken</w>.",
                            "target_lang_translations": {
                                "en": "It was difficult to <w>secure</w> some extra budget for the project."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemachtigen",
                        "verkrijgen"
                    ],
                    "common_phrases": [
                        "geld losmaken",
                        "budget losmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "To obtain something, often money or information, with effort or through persuasion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pry loose",
                                "target_lang_sense_clarification": "to obtain something difficult to get"
                            },
                            {
                                "target_lang_word": "secure",
                                "target_lang_sense_clarification": "to manage to get funding or resources"
                            },
                            {
                                "target_lang_word": "extract",
                                "target_lang_sense_clarification": "to get information or money with difficulty"
                            },
                            {
                                "target_lang_word": "free up",
                                "target_lang_sense_clarification": "to make budget or resources available"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}