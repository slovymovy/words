                "senses": [
                    {
                        "sense_id": "a5c46ee5-df94-3a41-a44d-db617d44a72f",
                        "entry_id": "d5199bf1-d7ea-3210-a938-ec2e5b2d020e",
                        "glosses": [
                            "Messwerte, die über die Bewegung (Mobilität) eines Objektes (einer Person) informieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28adc5e8-a498-4388-9baa-0351c790c36f",
                                "sense_id": "a5c46ee5-df94-3a41-a44d-db617d44a72f",
                                "text": "„So wird der deutsche Markt für Mobilitätsdaten derzeit auf einen zweistelligen Milliarden-Euro-Betrag geschätzt.“"
                            },
                            {
                                "example_id": "01a908ee-2672-4025-945a-34c36008f808",
                                "sense_id": "a5c46ee5-df94-3a41-a44d-db617d44a72f",
                                "text": "Wem gehören eigentlich die laufend im KFZ erfassten Mobilitätsdaten? Dem Autobauer oder dem Fahrzeugbesitzer?"
                            },
                            {
                                "example_id": "02c6dc8a-6f76-4570-b432-fbea6187f93a",
                                "sense_id": "a5c46ee5-df94-3a41-a44d-db617d44a72f",
                                "text": "„Apple hat ein neues Tool zur Auswertung von Mobilitätsdaten vorgestellt, das nach Konzernangaben die Bemühungen zur Eindämmung des Covid-19-Pandemie unterstützen könnte.“"
                            },
                            {
                                "example_id": "5de7ae5d-d7ad-4c1c-8c1f-b6de5e4e5488",
                                "sense_id": "a5c46ee5-df94-3a41-a44d-db617d44a72f",
                                "text": "„Apples Mobilitätsdaten sollen den Gesundheitsbehörden die Suche nach Möglichkeiten zur Eindämmung des Coronavirus erleichtern.“"
                            },
                            {
                                "example_id": "0f26e689-f29d-491e-b1c6-ea5c4bd600d7",
                                "sense_id": "a5c46ee5-df94-3a41-a44d-db617d44a72f",
                                "text": "„Gibt es denn etwas, von dem Sie sagen, wenn man Mobilitätsdaten erfasst, was man falsch machen könnte, also Eigenschaften, die eine solche Methodik nicht haben sollte?“"
                            },
                            {
                                "example_id": "039824be-9a5f-4cc1-8fec-0fed04b19208",
                                "sense_id": "a5c46ee5-df94-3a41-a44d-db617d44a72f",
                                "text": "„Die Analyse von Mobilitätsdaten hat eine lange Tradition. Zu den wichtigsten Arbeiten gehört die von Blau und Duncan, die Beschreibung der beruflichen Mobilität in den Vereinigten Staaten mit Hilfe der multidimensionalen Skalierung.“"
                            }
                        ],
