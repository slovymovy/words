        "fr-extract.jsonl": [
            {
                "entry_id": "3b14a7e3-3ad6-3db3-a54c-1d2cce7d1bee",
                "word": "gouverne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dac83031-02d2-4107-b446-7d0438ec1a2b",
                        "entry_id": "3b14a7e3-3ad6-3db3-a54c-1d2cce7d1bee",
                        "tags": [
                            "plural"
                        ],
                        "form": "gouvernes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d029b37e-12e8-32a1-8c11-57dec41d8760",
                        "entry_id": "3b14a7e3-3ad6-3db3-a54c-1d2cce7d1bee",
                        "glosses": [
                            "Ce qui doit servir de règle de conduite dans une affaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af3a8959-63c8-461a-81e0-f4f0d5298cda",
                                "sense_id": "d029b37e-12e8-32a1-8c11-57dec41d8760",
                                "text": "Cette lettre vous servira de gouverne."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c691aea-9918-3ae9-a416-02b887551a5b",
                        "entry_id": "3b14a7e3-3ad6-3db3-a54c-1d2cce7d1bee",
                        "glosses": [
                            "Règle de conduite dans la vie courante."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "493813b2-9951-43b9-958b-5ac31f4f4133",
                                "sense_id": "8c691aea-9918-3ae9-a416-02b887551a5b",
                                "text": "Rien n’est plus disgracieux, vois-tu, sache-le pour ta gouverne, que de venir dire aux gens : « Que feriez-vous en telle ou telle circonstance ? »"
                            },
                            {
                                "example_id": "af1be153-1c70-4e80-abf5-bbd1b3372a05",
                                "sense_id": "8c691aea-9918-3ae9-a416-02b887551a5b",
                                "text": "Pour ta gouverne, il vaut mieux éviter de scier la branche sur laquelle on est assis : on tombe."
                            },
                            {
                                "example_id": "371a6057-c3cd-48b5-9d82-158044dc2970",
                                "sense_id": "8c691aea-9918-3ae9-a416-02b887551a5b",
                                "text": "Pour votre gouverne, une caméra peut être très utile au tournage d'un film."
                            },
                            {
                                "example_id": "8cb26670-9218-4429-b939-1428ba41d209",
                                "sense_id": "8c691aea-9918-3ae9-a416-02b887551a5b",
                                "text": "Sachez, pour votre gouverne, que ChatGPT pourra sans problème élaborer le rétroplanning du rebranding de la marque avant le destock pour vous."
                            },
                            {
                                "example_id": "6c482c60-7eda-4e55-9e09-14fe2d21c91b",
                                "sense_id": "8c691aea-9918-3ae9-a416-02b887551a5b",
                                "text": "Arrête de me draguer. Pour ta gouverne, je suis gay."
                            }
                        ]
                    },
                    {
                        "sense_id": "9140f0fb-d3e9-302f-8cc0-2a5a2cba0e4b",
                        "entry_id": "3b14a7e3-3ad6-3db3-a54c-1d2cce7d1bee",
                        "glosses": [
                            "Pour votre gouverne : pour information, à titre de renseignement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "25f9de9c-f4e6-4a2c-a161-dae774288341",
                                "sense_id": "9140f0fb-d3e9-302f-8cc0-2a5a2cba0e4b",
                                "text": "Mais sachez cela pour votre gouverne : je me nomme Juve, je suis l’inspecteur Juve, et d’ailleurs, pour enlever tous vos doutes, je vous en prie, examinez cette carte."
                            },
                            {
                                "example_id": "5df3c304-db1e-4d8e-a4a6-694b0dd85c6a",
                                "sense_id": "9140f0fb-d3e9-302f-8cc0-2a5a2cba0e4b",
                                "text": "Ah ! pour votre gouverne : quand vous craignez d’être suivi, ne vous retournez pas ; simplement laissez tomber à terre votre canne, ou votre parapluie, suivant le temps qu’il fait, ou votre mouchoir, et, tout en ramassant l’objet, la tête en bas, regardez entre les jambes, derrière vous, par un mouvement naturel."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5a020aa-f46d-3533-a2a4-fac30522f456",
                        "entry_id": "3b14a7e3-3ad6-3db3-a54c-1d2cce7d1bee",
                        "glosses": [
                            "Action de diriger une embarcation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6acaa329-0d53-4423-a574-8d840fd3a606",
                                "sense_id": "d5a020aa-f46d-3533-a2a4-fac30522f456",
                                "text": "Aviron de gouverne."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8a1ecf1-af44-3e3c-b59e-eb0eeaa0d361",
                        "entry_id": "3b14a7e3-3ad6-3db3-a54c-1d2cce7d1bee",
                        "glosses": [
                            "Sorte de godille qui joue le rôle de gouvernail."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "fff88467-414c-428c-a177-05606050f541",
                                "sense_id": "f8a1ecf1-af44-3e3c-b59e-eb0eeaa0d361",
                                "text": "On place également deux taquets sur le serrage à l’arrière de la pirogue, pour servir à celui qui manie l’aviron de gouverne, à se hausser pour voir de plus loin autour de lui."
                            }
                        ]
                    },
                    {
                        "sense_id": "afffe117-c4ed-3a6c-800c-d28adfd56b42",
                        "entry_id": "3b14a7e3-3ad6-3db3-a54c-1d2cce7d1bee",
                        "glosses": [
                            "Tutelle, contrôle, direction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3f66e8c-5a98-49a1-a448-89f33f01ced1",
                                "sense_id": "afffe117-c4ed-3a6c-800c-d28adfd56b42",
                                "text": "La performance de l’économie américaine sous la gouverne de Donald Trump et avant la pandémie n’a pas été si mauvaise que ça, mais à quel coût ?"
                            },
                            {
                                "example_id": "6ca6fea6-a307-4099-a45f-6958c3e388a8",
                                "sense_id": "afffe117-c4ed-3a6c-800c-d28adfd56b42",
                                "text": "Christopher Wray, le directeur du FBI, a juré que ceux qui ont commis des crimes avec Epstein et Maxwell n'échapperaient pas à la justice sous sa gouverne."
                            },
                            {
                                "example_id": "8cd325d2-580c-48c5-9f18-cdd8d0eb90f6",
                                "sense_id": "afffe117-c4ed-3a6c-800c-d28adfd56b42",
                                "text": "Évoquer la pandémie ou les 15 ans de gouverne libérale pour justifier d'éventuels retards serait aussi bien malvenu."
                            }
                        ]
                    }
                ],
