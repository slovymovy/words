                                "target_senses": [
                                    {
                                        "sense_id": "a734c2c3-6a90-3866-9544-39e8b9bf7dac",
                                        "entry_id": "fe318f73-d5cf-315a-9db7-72bcd7db86a2",
                                        "glosses": [
                                            "Gros plomb dont on se sert pour tirer le chevreuil et autres gibiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a1a95ad-bc38-4953-a211-5769eab700fa",
                                                "sense_id": "a734c2c3-6a90-3866-9544-39e8b9bf7dac",
                                                "text": "Mon fusil est chargé de chevrotines, à chevrotines."
                                            },
                                            {
                                                "example_id": "3d2392f1-78ce-4371-8342-378cdacd5c0d",
                                                "sense_id": "a734c2c3-6a90-3866-9544-39e8b9bf7dac",
                                                "text": "Mateo n’aurait jamais tiré sur un mouflon avec des chevrotines, mais, à cent vingt pas, il l’abattait d’une balle dans la tête ou dans l’épaule, à son choix."
                                            },
                                            {
                                                "example_id": "834a484f-3489-45f0-aa08-a9427ff31fd2",
                                                "sense_id": "a734c2c3-6a90-3866-9544-39e8b9bf7dac",
                                                "text": "Le canon vomit avec un rugissement son paquet de chevrotines."
                                            },
                                            {
                                                "example_id": "9e2a156f-43f9-4479-a75c-435c46fae6aa",
                                                "sense_id": "a734c2c3-6a90-3866-9544-39e8b9bf7dac",
                                                "text": "« Parce que Chabert leur avait tiré un coup de fusil.\n– Un vrai coup de fusil ? dis-je.\n– Oui, mais de loin, avec du petit plomb… […] Mon père dit qu’il aurait dû tirer à chevrotines !"
                                            },
                                            {
                                                "example_id": "2f9ab1cc-7f30-4948-9638-60ac6131f41c",
                                                "sense_id": "a734c2c3-6a90-3866-9544-39e8b9bf7dac",
                                                "text": "Lucien hésita avant que les deux cartouches suivantes n’arrivent dans les tubes de son flingot juste à temps pour faire exploser la lunette arrière du véhicule qui s’évanouit dans la fumée, laissant sur le quai le moteur hors-bord marqué d’impacts de chevrotine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50ba84f9-cc0e-3e56-ab80-d52834ad1c1f",
                                        "entry_id": "fe318f73-d5cf-315a-9db7-72bcd7db86a2",
                                        "glosses": [
                                            "Chevrotement."
                                        ],
