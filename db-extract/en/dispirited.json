                        "glosses": [
                            "Without energy, gusto or drive, enervated, without the will to accomplish, disheartened."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f9ab481-87c3-44b0-ac1e-862e7653b41d",
                                "sense_id": "48edd76f-208a-37a0-b4bf-b9238344d811",
                                "text": "So dispirited were the troops after the loss of their beloved commander that they moped about and could barely be bothered to eat let alone load their guns."
                            },
                            {
                                "example_id": "53b91fbf-ff5f-4f24-95e5-1e70fb4fcdad",
                                "sense_id": "48edd76f-208a-37a0-b4bf-b9238344d811",
                                "text": "The shift in the balance of power online has allowed anyone to publish to the world, from dispirited teenagers in south London to an anonymous cyber-dissident in a Middle East autocracy."
                            }
                        ]
                    }
