                    {
                        "sense_id": "560622b0-0880-33aa-b624-755b3ca72a73",
                        "entry_id": "daa7319a-2e94-3353-9d45-7851e65efecb",
                        "glosses": [
                            "Phase de jeu qui consiste à gagner du terrain, à faire reculer l’adversaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738d566c-a615-45de-82ba-6131233c0a07",
                                "sense_id": "560622b0-0880-33aa-b624-755b3ca72a73",
                                "text": "À l’arrivée, rien de très spectaculaire, un gagne terrain laborieux, beaucoup de déchets, pas mal de gâchis et une impression générale de médiocrité."
                            },
                            {
                                "example_id": "81a00289-9ad2-4775-b42f-c31d8fcd322a",
                                "sense_id": "560622b0-0880-33aa-b624-755b3ca72a73",
                                "text": "Côté spectacle, le match tourna donc vite en un gagne-terrain, chaque équipe s'attachant à respecter le plus idéalement possible le nouveau programme du rugby professionnel sur l'occupation des sols."
                            },
                            {
                                "example_id": "bf33de57-2517-428b-a9c8-9969cae4b0fb",
                                "sense_id": "560622b0-0880-33aa-b624-755b3ca72a73",
                                "text": "C’est l’histoire d’une demi-finale de Coupe du monde disputée sous la pluie, d’un numéro 10 jouant sans cesse dans le dos de la défense et d’un gagne-terrain qui, à force de mettre l’adversaire sous pression, le pousse à la faute et sape son moral."
                            }
                        ]
                    }
