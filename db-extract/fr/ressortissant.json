                ],
                "senses": [
                    {
                        "sense_id": "d5115c25-68c1-3e23-a2f3-07549d3cf301",
                        "entry_id": "57b0efd9-c0eb-35f9-bed3-4f32e3e8a6ce",
                        "glosses": [
                            "Personne protégée par les représentants diplomatiques ou consulaires d’un pays donné, lorsqu’elle réside dans un autre pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c166d1e-43e5-47c9-858e-2ec5e7b569ac",
                                "sense_id": "d5115c25-68c1-3e23-a2f3-07549d3cf301",
                                "text": "Les ressortissants des États membres de l'Union européenne, des autres États parties à l'accord sur l'Espace économique européen ou de la Confédération suisse sont dispensés de l'obligation de déclaration prévue au premier alinéa."
                            },
                            {
                                "example_id": "ca0719f8-3d5c-40d3-ad98-a9d56826000b",
                                "sense_id": "d5115c25-68c1-3e23-a2f3-07549d3cf301",
                                "text": "Les ressortissants allemands, sarrois, dantzikois et étrangers de nationalité indéterminée, mais d'origine allemande, résidant dans le département de la Seine, devront se conformer aux prescriptions suivantes :\n 1. Les hommes de 17 à 55 ans rejoindront le Stade Buffalo à Montrouge.\n 2. Les femmes célibataires et mariées sans enfant rejoindront le Vélodrome d’Hiver, le 15 mai 1940."
                            },
                            {
                                "example_id": "67e66fa4-cc26-45a3-8ba5-bb348c1af8b0",
                                "sense_id": "d5115c25-68c1-3e23-a2f3-07549d3cf301",
                                "text": "Comment un ressortissant français a-t-il pu faire l’objet d’une mesure de rétention administrative normalement destinée à s’appliquer aux étrangers ? Comme l’a raconté l’Humanité lundi, c’est pourtant ce qui est arrivé à Timothée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78d72d61-cb9e-41ca-8458-a833360307c8",
                        "source_entry_id": "57b0efd9-c0eb-35f9-bed3-4f32e3e8a6ce",
                        "source_sense_id": "d5115c25-68c1-3e23-a2f3-07549d3cf301",
                        "target_lang_word": "Staatsbürger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staatsbürger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                        "entry_id": "0d625a23-8961-3f2c-b587-16ae0f69addb",
                                        "glosses": [
                                            "Angehöriger eines Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90bac686-a5a4-4757-9917-585b895004d9",
                                                "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                                "text": "Alle Staatsbürger sind aufgerufen, sich an den Wahlen zu beteiligen."
                                            },
                                            {
                                                "example_id": "3d5b6d6b-735f-4c0a-b25b-f67bb24f3fb7",
                                                "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                                "text": "„[…] Ende Januar wurde zudem ein deutscher Staatsbürger entführt und wird seitdem von einem Stamm gefangen gehalten, der damit Druck auf die Regierung ausüben will, um zwei in Sanaa inhaftierte Stammesangehörige freizupressen.“"
                                            },
                                            {
                                                "example_id": "4647729e-15f5-4368-bf55-830720faf2c5",
                                                "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                                "text": "„Jüngst veröffentlichten Daten zufolge verlassen täglich nahezu tausend türkische Staatsbürger das Land auf legalen Wegen.“"
                                            },
                                            {
                                                "example_id": "fb11cf1d-47a4-4eee-81db-390518f3ab43",
                                                "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                                "text": "„Apropos Bürger: Im 15. und 16. Jahrhundert hat es den Staatsbürger in unserem Sinne noch gar nicht gegeben.“"
                                            },
                                            {
                                                "example_id": "68779624-1522-4335-935e-9646ab82cdcb",
                                                "sense_id": "fedd9371-65f5-30aa-aa8b-2e989a020954",
                                                "text": "„Natürlich hätte ich das wissen müssen, als erwachsener Staatsbürger und ›vollverantwortliche männliche Person‹, aber ich wußte es einfach nicht, so wie ich bis vor kurzem nicht wußte, daß man Weißwein kalt und Rotwein angewärmt serviert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c664a158-af91-4ad0-8481-4ed6dfdee6bd",
                        "source_entry_id": "57b0efd9-c0eb-35f9-bed3-4f32e3e8a6ce",
