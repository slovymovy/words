                            },
                            {
                                "target_lang_word": "воротник-стойка",
                                "target_lang_sense_clarification": "фасон воротника"
                            },
                            {
                                "target_lang_word": "горловина",
                                "target_lang_sense_clarification": "часть одежды, охватывающая шею"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "380d1b7a-49ea-30d0-858b-98777a151768",
                    "sense_definition": "A slang term referring to the foreskin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained the anatomical function of the <w>turtleneck</w> during the consultation.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил анатомическую функцию <w>крайней плоти</w> во время консультации."
                            }
                        },
                        {
                            "text": "In certain informal contexts, people might use the word <w>turtleneck</w> to refer to that part of the body.",
                            "target_lang_translations": {
                                "ru": "В определенных неформальных контекстах люди могут использовать слово <w>turtleneck</w> для обозначения этой части тела."
                            }
                        }
