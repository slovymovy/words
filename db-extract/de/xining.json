                        "translation_id": "854b9806-0b59-4be3-8685-22af778d5d91",
                        "source_entry_id": "9e9d07d3-7d99-3a72-811f-6b8aa792547f",
                        "source_sense_id": "3c964f76-2a42-3d87-8db3-455f7a42ff59",
                        "source_sense_description": "Hauptstadt der chinesischen Provinz Qinghai",
                        "target_lang_word": "Xining",
