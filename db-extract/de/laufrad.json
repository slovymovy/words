                ],
                "senses": [
                    {
                        "sense_id": "38bb815f-27bb-37d6-a4f3-620ff9ca3a99",
                        "entry_id": "2fb7b7c0-cf10-3810-9fef-0053a639e538",
                        "glosses": [
                            "eine Fahrrad das beim Laufen hilft und auf dem man sitzend läuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e6305ca-0d05-4033-9da2-6af5fd2e9bba",
                                "sense_id": "38bb815f-27bb-37d6-a4f3-620ff9ca3a99",
                                "text": "Mit dem Laufrad laufen gehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d4c4bad3-9578-33ec-963a-e3fe239ee8ec",
                        "entry_id": "2fb7b7c0-cf10-3810-9fef-0053a639e538",
                        "glosses": [
                            "ein sich drehender Käfig in dem man laufen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89661c50-09c7-487f-a5f7-11314ab92946",
                                "sense_id": "d4c4bad3-9578-33ec-963a-e3fe239ee8ec",
                                "text": "Im Laufrad läuft der Hamster nur so zum Spaß!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "61d0f77c-629c-3f6c-b1a6-6ed908544e26",
                        "entry_id": "2fb7b7c0-cf10-3810-9fef-0053a639e538",
                        "glosses": [
                            "ein Rotor mit Flügeln oder Schaufeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8658b345-f38a-49d1-a4c0-2599c5b93683",
                                "sense_id": "61d0f77c-629c-3f6c-b1a6-6ed908544e26",
                                "text": "Das Laufrad im Ventilator wird durch einen Motor angetrieben und schaufelt Luft."
                            },
                            {
                                "example_id": "65875df0-32ca-4cc9-934a-0c44f5904bc2",
                                "sense_id": "61d0f77c-629c-3f6c-b1a6-6ed908544e26",
                                "text": "In einer Turbine wird das Laufrad durch das strömende Medium angetrieben und erzeugt Strom."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "6501853c-23fc-3274-a507-9a1f35661c8d",
                        "entry_id": "2fb7b7c0-cf10-3810-9fef-0053a639e538",
                        "glosses": [
                            "ein Rad am Fahrwerk auf/mit dem sich etwas rollend bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92c22f7-803e-4d8d-9664-bc6fa12a8532",
                                "sense_id": "6501853c-23fc-3274-a507-9a1f35661c8d",
                                "text": "An einer Dampflokomotive gibt es mehrere Räder, wobei einige als Laufrad bezeichnet werden, da diese nicht angetrieben werden und lediglich rollend die Lokomotive tragen."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
