                "senses": [
                    {
                        "sense_id": "5989968f-ff5f-3e77-852c-a2afc90cc95b",
                        "entry_id": "a0eca040-54b3-302b-94bc-b91992601382",
                        "glosses": [
                            "Donner un caractère méditerranéen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a2ad3f-aab4-48ee-aaa1-52a6d0f551ce",
                                "sense_id": "5989968f-ff5f-3e77-852c-a2afc90cc95b",
                                "text": "A-t-il ressenti, comme Nietzsche l’énoncera un siècle et demi plus tard, la nécessité de « méditerranéiser » la musique ?"
                            },
                            {
                                "example_id": "10261be9-91dd-4c47-9699-5f041f5f4734",
                                "sense_id": "5989968f-ff5f-3e77-852c-a2afc90cc95b",
                                "text": "Je ne dis pas qu’il faille aujourd’hui « augustiniser » la culture, au sens où Nietzsche voulait « méditerranéiser » la musique, ni même qu’il faille revenir aux dogmes judéo-chrétiens."
                            }
                        ]
                    }
