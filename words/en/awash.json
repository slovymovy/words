{
    "word_family": [
        "wash",
        "washer",
        "washable",
        "washout"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e7aa0517-037e-3a78-b203-723858bfaa26",
                    "sense_definition": "Covered or washed by water, especially when flush with the surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "water_coverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deck was <w>awash</w> with the sea that came over the rail.",
                            "target_lang_translations": {
                                "pl": "Pokład był <w>zalany</w> wodą morską, która przelewała się przez burtę."
                            }
                        },
                        {
                            "text": "The small boat was <w>awash</w> after the heavy storm hit the coast.",
                            "target_lang_translations": {
                                "pl": "Mała łódź była <w>zalana</w> po tym, jak silny sztorm uderzył w wybrzeże."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deck awash"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zalany wodą, znajdujący się pod wodą lub na poziomie lustra wody."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zalany",
                                "target_lang_sense_clarification": "pokryty wodą"
                            },
                            {
                                "target_lang_word": "podmyty",
                                "target_lang_sense_clarification": "znajdujący się w zasięgu fal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46907a31-1def-318e-bd1c-99ca7e5cbc03",
                    "sense_definition": "Filled or covered with a large amount of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city streets were <w>awash</w> with tourists during the summer festival.",
                            "target_lang_translations": {
                                "pl": "Ulice miasta były <w>zalane</w> turystami podczas letniego festiwalu."
                            }
                        },
                        {
                            "text": "His mind was <w>awash</w> with memories of his childhood home.",
                            "target_lang_translations": {
                                "pl": "Jego umysł był <w>pełen</w> wspomnień o rodzinnym domu."
                            }
                        }
                    ],
                    "synonyms": [
                        "aslosh"
                    ],
                    "common_phrases": [
                        "awash with"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wypełniony czymś w ogromnej ilości, pełen czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pełen",
                                "target_lang_sense_clarification": "w kontekście dużej ilości czegoś"
                            },
                            {
                                "target_lang_word": "zalany",
                                "target_lang_sense_clarification": "w przenośni, np. zalany turystami"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "10a935d0-d860-353c-b776-7d2716618562",
                    "sense_definition": "A market town in central Ethiopia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They traveled to <w>Awash</w> to visit the local market.",
                            "target_lang_translations": {
                                "pl": "Podróżowali do <w>Awash</w>, aby odwiedzić lokalny targ."
                            }
                        },
                        {
                            "text": "The train stopped briefly in <w>Awash</w> before continuing its journey.",
                            "target_lang_translations": {
                                "pl": "Pociąg zatrzymał się na chwilę w <w>Awash</w> przed kontynuowaniem podróży."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Miasto w środkowej Etiopii."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Awash",
                                "target_lang_sense_clarification": "nazwa własna miasta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "889d8b10-ce49-33ca-9f33-dcaa19e7d55d",
                    "sense_definition": "A river in Ethiopia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Awash</w> river flows through the Great Rift Valley.",
                            "target_lang_translations": {
                                "pl": "Rzeka <w>Auasz</w> przepływa przez Wielkie Rowy Afrykańskie."
                            }
                        },
                        {
                            "text": "Many communities rely on the <w>Awash</w> for irrigation and water.",
                            "target_lang_translations": {
                                "pl": "Wiele społeczności polega na rzece <w>Auasz</w> w kwestii nawadniania i wody."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Rzeka w Etiopii."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Auasz",
                                "target_lang_sense_clarification": "polska nazwa rzeki"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}