                            {
                                "example_id": "bb4c30e8-de37-4b6a-b6ea-d628ccb996f2",
                                "sense_id": "3e7f7a73-5709-332d-8598-4a4931a85f31",
                                "text": "— А он, на грех-то, может из начальства… Ну и дико́й же ты, Петрован! Петрован, нахмурившись, стал снимать зипун."
                            },
                            {
                                "example_id": "2b8a3bac-9858-48f4-956d-c3dfc20c4cf8",
                                "sense_id": "3e7f7a73-5709-332d-8598-4a4931a85f31",
                                "text": "— Баню, — спрашивает, — топить? // А он как дико́й. // — Занавесь-ка, — кричит, — окошки на улку!"
                            }
                        ]
                    }
