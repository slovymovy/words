                        "glosses": [
                            "een onregelmatige rand met kartels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efd7ab12-ca5b-4ada-825a-5ab4f019de06",
                                "sense_id": "a797b5bc-903f-3b6f-bd0e-b792d6389089",
                                "text": "Elk benoembaar voorwerp bezat een rafelige omtrek, een onregelmatige kartelrand, waar de vorm in onherleidbaar poeder verdampte."
                            },
                            {
                                "example_id": "6e86e383-31c5-4112-b706-8e7e740c0908",
                                "sense_id": "a797b5bc-903f-3b6f-bd0e-b792d6389089",
                                "text": "De Amerikaanse kustwacht noemt het verwijderen van de pijp een \"belangrijke stap voorwaarts\". Wel merkte een woordvoerder op dat doordat de pijp nu een kartelrand heeft, het moeilijker zal zijn de buis aan te sluiten op het afpompsysteem."
                            }
                        ]
                    }
