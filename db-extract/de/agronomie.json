                "translations": [
                    {
                        "translation_id": "e13c0466-3a6e-42ef-bea7-564d40eff120",
                        "source_entry_id": "131a2b68-1e13-3e70-ad39-b3512c0c4815",
                        "source_sense_id": "9a9507b3-d5fb-3d9e-8696-cbd44383dd64",
                        "source_sense_description": "wissenschaftliche Forschung über Ackerbau",
                        "target_lang_word": "agronomy",
                        "target_lang_code": "en",
