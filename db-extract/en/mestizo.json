                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mestize",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fef05b3-e250-3be0-ad09-7e7ffc924fc2",
                                        "entry_id": "3764a7a8-d3cb-3283-a9e7-a907aa9653e2",
                                        "glosses": [
                                            "Person mit einem weißen und einem indigenen Elternteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b98c869-2ac9-4b7c-8d8b-28a2241761d1",
                                                "sense_id": "4fef05b3-e250-3be0-ad09-7e7ffc924fc2",
                                                "text": "„Auf Anmarschrouten von 500 und mehr Kilometern bewegten sich die Plünderer aus der Tiefe der Wildnis heraus, um die spanischen Vorposten und Bauerndörfer anzugreifen, in denen Großgrundbesitzer Haciendas betrieben und die Felder von Mestizen und versklavten Indios bestellen ließen.“"
                                            },
                                            {
                                                "example_id": "07930de8-c875-4203-9cd5-236ae5dab8f5",
                                                "sense_id": "4fef05b3-e250-3be0-ad09-7e7ffc924fc2",
                                                "text": "„Es waren die Kinder der ersten Mestizen, Sklaven und alle, die Eltern aus zwei Kulturen hatten.“"
                                            },
                                            {
                                                "example_id": "22e4272f-b96a-4c65-95e3-2fe10364b500",
                                                "sense_id": "4fef05b3-e250-3be0-ad09-7e7ffc924fc2",
                                                "text": "„Die Insulaner schienen mit solchen Geschäften vertraut zu sein; nach kaum einer Stunde lag das breite Boot wieder versteckt neben den übrigen Kähnen, während die Pferde in den Ställen untergebracht waren und dort von einem jungen Mestizen versorgt und mit Nahrung versehen wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
