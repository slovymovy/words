                "senses": [
                    {
                        "sense_id": "72201851-b78c-3cef-b0c0-dde3bcf768e6",
                        "entry_id": "13436678-deec-3417-895d-e40c0c34b50d",
                        "glosses": [
                            "bounce, jump, hop"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c4856cee-c25c-3546-9e41-6e837d3ca79f",
                        "entry_id": "13436678-deec-3417-895d-e40c0c34b50d",
                        "glosses": [
                            "quick visit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29e0735-42ff-4e71-bf8f-351e00350467",
                                "sense_id": "c4856cee-c25c-3546-9e41-6e837d3ca79f",
                                "text": "Вы́кроить вре́мя для заско́ка домо́й: приня́ть душ, переоде́ться, не забы́ть про блонди́нистый пари́к…",
                                "translation": "To carve out some time for a quick visit home: to take a shower, to change, to not forget the blonde wig…",
                                "english": "To carve out some time for a quick visit home: to take a shower, to change, to not forget the blonde wig…"
                            }
                        ]
                    },
                    {
                        "sense_id": "fdb82caa-8680-3efd-bf53-2a2d9293cccf",
                        "entry_id": "13436678-deec-3417-895d-e40c0c34b50d",
                        "glosses": [
                            "oddity, eccentricity, peculiar habit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a978bc24-c966-4ad2-8855-9af1a8715a3d",
                                "sense_id": "fdb82caa-8680-3efd-bf53-2a2d9293cccf",
                                "text": "У го́рода был заско́к ― де́лать вид, что ничего́ не перемени́лось, а оста́лось совсе́м, совсе́м по-ста́рому.",
                                "translation": "The city had a peculiar habit: to pretend that nothing has changed, that everything has remained entirely the same as in the old days.",
                                "english": "The city had a peculiar habit: to pretend that nothing has changed, that everything has remained entirely the same as in the old days."
                            },
                            {
                                "example_id": "8634c860-10bf-4d47-bf9d-aa2f7f612a55",
                                "sense_id": "fdb82caa-8680-3efd-bf53-2a2d9293cccf",
                                "text": "Дед он тако́й, как бы сказа́ть, с заско́ками и́ли же с укло́ном на ста́рый режи́м.",
                                "translation": "The old man had – how do I put it – some oddities, or maybe an affinity for the old regime.",
                                "english": "The old man had – how do I put it – some oddities, or maybe an affinity for the old regime."
                            }
                        ]
                    },
                    {
                        "sense_id": "d401ca08-c820-3925-85d7-b57389e92a38",
                        "entry_id": "13436678-deec-3417-895d-e40c0c34b50d",
                        "glosses": [
                            "deviation, (extreme) position"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "acf4c2f7-6986-421e-b1be-27580632bf84",
                                "sense_id": "d401ca08-c820-3925-85d7-b57389e92a38",
                                "text": "Тут на́до пря́мо сказа́ть, что э́то ― не головокруже́ние от успе́хов, как гениа́льно вы́разился наш вождь това́рищ Ста́лин, а э́то ― прямо́й лева́цкий заско́к, наступле́ние на генера́льную ли́нию па́ртии.",
                                "translation": "We must say frankly that this isn't dizziness with success, as our leader Comrade Stalin had ingeniously put it, but a straightforward leftist deviation, an attack on the party's general line.",
                                "english": "We must say frankly that this isn't dizziness with success, as our leader Comrade Stalin had ingeniously put it, but a straightforward leftist deviation, an attack on the party's general line."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b09114a-62ac-31df-b04d-57c96ecec220",
                        "entry_id": "13436678-deec-3417-895d-e40c0c34b50d",
                        "glosses": [
                            "lapse (e.g. in one's memory, reason, or attention), absent-mindedness, blackout"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "86bb1952-0539-4243-85b3-693fa3944260",
                                "sense_id": "3b09114a-62ac-31df-b04d-57c96ecec220",
                                "text": "Я был гра́мотным ученико́м, оши́бок в правописа́нии почти́ не де́лал, э́то был заско́к в моём образова́нии.",
                                "translation": "I was a well-taught student, my spelling was almost perfect, but this was a rare lapse in my education.",
                                "english": "I was a well-taught student, my spelling was almost perfect, but this was a rare lapse in my education."
                            }
                        ]
                    }
                ],
