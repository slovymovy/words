                        "horaires normaux",
                        "température normale"
                    ]
                },
                {
                    "sense_id": "ef45a4c1-4602-3899-a836-25b9dabac691",
                    "sense_definition": "Qui est en bon état de santé et ne présente aucune altération ni maladie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a rassuré en disant que mon rythme cardiaque était parfaitement <w>normal</w>."
                        },
                        {
                            "text": "Après quelques jours de repos complet, le patient a retrouvé un état <w>normal</w>."
                        }
                    ],
                    "antonyms": [
                        "anormal"
                    ],
                    "common_phrases": [
                        "état normal",
                        "rythme cardiaque normal",
                        "tension normale"
