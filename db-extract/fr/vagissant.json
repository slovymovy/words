                        "entry_id": "d2b7f247-39d9-32aa-acef-ddd6803b5831",
                        "glosses": [
                            "Qui vagit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7133bf38-943d-4f07-8733-aaf72b3172e1",
                                "sense_id": "00c292ef-77c6-3611-ab79-8e7dbb77bce8",
                                "text": "Une voix vagissante."
                            },
                            {
                                "example_id": "268abc4f-6371-4a78-b43b-96478817f7eb",
                                "sense_id": "00c292ef-77c6-3611-ab79-8e7dbb77bce8",
                                "text": "Sa voix, faible d’abord et vagissante, devenait aiguë."
                            },
                            {
                                "example_id": "17b45e9e-e1ea-4e27-9dc9-9f3d1beee68c",
                                "sense_id": "00c292ef-77c6-3611-ab79-8e7dbb77bce8",
                                "text": "Et cette petite boule rougeaude et vagissante que tu étais, je la voyais surtout comme un poids sur mon existence et comme une entrave à ma liberté."
                            }
                        ]
                    }
                ],
