        "fr-extract.jsonl": [
            {
                "entry_id": "28ffabaa-7d19-35e1-8669-5c305cbf494f",
                "word": "possiblement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38bd689d-f227-3c84-8d23-0030f3adb330",
                        "entry_id": "28ffabaa-7d19-35e1-8669-5c305cbf494f",
                        "glosses": [
                            "D’une façon possible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a88f17a6-9cab-46f1-b88b-9e07b3ec4d35",
                                "sense_id": "38bd689d-f227-3c84-8d23-0030f3adb330",
                                "text": "De ce néant [des bâtards], ce qu’il [le roi] fit par degrés pour les conduire possiblement au trône est prodigieux,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29c3e816-6960-4e0f-883b-f2ca5c396073",
                        "source_entry_id": "28ffabaa-7d19-35e1-8669-5c305cbf494f",
                        "source_sense_id": "38bd689d-f227-3c84-8d23-0030f3adb330",
                        "target_lang_word": "möglicherweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "möglicherweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e97e039c-e649-343a-bbf1-f2d546698970",
                                        "entry_id": "e4987d77-592c-3d25-8319-6dce0f544cfd",
                                        "glosses": [
                                            "so, dass es sein kann, aber dennoch nicht sicher ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "065af60d-f478-45c4-8179-a2e8abad26ab",
                                                "sense_id": "e97e039c-e649-343a-bbf1-f2d546698970",
                                                "text": "Du hast möglicherweise richtig getippt."
                                            },
                                            {
                                                "example_id": "382f1383-9def-4054-9933-27717b1d9118",
                                                "sense_id": "e97e039c-e649-343a-bbf1-f2d546698970",
                                                "text": "Möglicherweise haben thailändische Behörden Flüchtlinge auf dem offenen Ozean ausgesetzt."
                                            },
                                            {
                                                "example_id": "a2e77fd9-3e03-42db-901b-c8030ba496e8",
                                                "sense_id": "e97e039c-e649-343a-bbf1-f2d546698970",
                                                "text": "Forscher aus Taiwan haben möglicherweise einen Weg gefunden, Insulin in Zukunft in Tablettenform verabreichen zu können."
                                            },
                                            {
                                                "example_id": "89ceef7e-8eda-4e29-9e24-fa5457cba1c2",
                                                "sense_id": "e97e039c-e649-343a-bbf1-f2d546698970",
                                                "text": "„Möglicherweise haben die Seleniten längst die Fahne auf ihren Polen aufgepflanzt, während die irdischen Polfahrten der Franklin, Ross, Kane, Dumont d'Urville und Lambert allesamt kläglich scheiterten.“"
                                            },
                                            {
                                                "example_id": "4c0aab95-7137-4bc3-9900-3c509e134825",
                                                "sense_id": "e97e039c-e649-343a-bbf1-f2d546698970",
                                                "text": "„Möglicherweise könnte ich Heini vom Nachbarzimmer dazu bewegen, mit mir zusammen hochzugehen.“"
                                            },
                                            {
                                                "example_id": "6d50752d-6347-4872-8dae-f60752198f89",
                                                "sense_id": "e97e039c-e649-343a-bbf1-f2d546698970",
                                                "text": "„Oder wirkt ein Gift, das ihm ein bestochener Mundschenk auf Geheiß von Basileios möglicherweise eingeflößt hat?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a706937-9fbc-434f-9409-9b3c31a4ca3e",
                        "source_entry_id": "28ffabaa-7d19-35e1-8669-5c305cbf494f",
                        "source_sense_id": "38bd689d-f227-3c84-8d23-0030f3adb330",
                        "target_lang_word": "womöglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "womöglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08c1cc85-eb66-3f23-a898-190b35193a01",
                                        "entry_id": "76b4c6fb-fd2a-3937-bfe2-72446a75d4b0",
                                        "glosses": [
                                            "eventuell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "543c3668-58d4-4930-8ae5-00d0af7966dc",
                                                "sense_id": "08c1cc85-eb66-3f23-a898-190b35193a01",
                                                "text": "Womöglich ist er gar nicht der, für den ihn alle halten."
                                            },
                                            {
                                                "example_id": "de3263e9-3464-4352-a00e-d3dcc453a25a",
                                                "sense_id": "08c1cc85-eb66-3f23-a898-190b35193a01",
                                                "text": "„Britische Touristen, die in die EU reisen, werden womöglich bald eine Visagebühr von 60 Euro bezahlen müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfd2f4cf-2372-4767-8e96-53b8fab2815a",
                        "source_entry_id": "28ffabaa-7d19-35e1-8669-5c305cbf494f",
                        "source_sense_id": "38bd689d-f227-3c84-8d23-0030f3adb330",
                        "target_lang_word": "eventuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eventuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                        "entry_id": "d403ed82-aba4-39a3-86fe-be1781490aea",
                                        "glosses": [
                                            "unter (bestimmten, gewissen) Umständen, in bestimmten Fällen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6530da4a-1f55-45ea-b93c-2713316f2785",
                                                "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                                "text": "adjektivisch: Für eine eventuelle Beschädigung der Ware sind wir nur bedingt haftbar zu machen."
                                            },
                                            {
                                                "example_id": "a9533eb9-2475-4620-b189-362717389172",
                                                "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                                "text": "adverbial: Eventuell komme ich morgen später."
                                            },
                                            {
                                                "example_id": "506e7758-6b65-4719-914e-9ca471398dd8",
                                                "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                                "text": "adverbial: Wir telefonieren eventuell heute noch einmal."
                                            },
                                            {
                                                "example_id": "b80629b6-7c68-4526-bcb7-c0e7809a3bb4",
                                                "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                                "text": "adverbial: Willst du eventuell ein zweites Mal probieren?"
                                            },
                                            {
                                                "example_id": "20de7dc1-28e3-4c8b-ac97-ae9c8316857e",
                                                "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                                "text": "adverbial: Er ist eventuell krank und sollte zum Arzt gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f10158d-7ff3-4e26-b715-f166c0fb1691",
                        "source_entry_id": "28ffabaa-7d19-35e1-8669-5c305cbf494f",
                        "source_sense_id": "38bd689d-f227-3c84-8d23-0030f3adb330",
                        "target_lang_word": "possibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "possibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                        "entry_id": "aa1d7883-731f-3425-a890-391933fcebea",
                                        "glosses": [
                                            "Perhaps; indicates that the proposition may be true (is not certainly false) regardless of any facts or circumstances known to, stated by or implied by the speaker."
                                        ],
                                        "tags": [
                                            "modifying a clause or predicate"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7deef97a-3ee5-4d06-ad06-94ac3d01c986",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "Near-synonyms: maybe, perhaps, mayhap, mayhaps, by chance, perchance, peradventure; conceivably"
                                            },
                                            {
                                                "example_id": "02df7048-c149-419f-88c4-124d63a6bb58",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "Possibly, they will make gains in the midterm elections."
                                            },
                                            {
                                                "example_id": "04493592-5c28-48fc-b83c-794fcdfa8453",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "It was possibly the costliest mistake in the organization's history."
                                            },
                                            {
                                                "example_id": "ff077c1b-bf07-4212-8b9a-e3ea94980206",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "This rare and possibly unique specimen must be conserved."
                                            },
                                            {
                                                "example_id": "97d3a85d-e4c3-42da-8017-6bf7a8427f96",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "“Well, everything does point to either a major epeirogenic deformation, or possibly just a simple disruption of isostasy throughout the entire plate network.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                        "entry_id": "aa1d7883-731f-3425-a890-391933fcebea",
                                        "glosses": [
                                            "In the realm of possibility; indicates that the action may successfully be performed (is not impossible) regardless of any facts or circumstances known to, stated by or implied by the speaker that might limit the performance."
                                        ],
                                        "tags": [
                                            "modifying a verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e9a4a0e-0e4d-4d8a-99fa-8b36b3e452cb",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "I couldn't possibly cheat on my wife."
                                            },
                                            {
                                                "example_id": "929cad39-c4ea-40fb-847a-3e8884cceb64",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "It seems unlikely, but, yes, they could possibly win even now."
                                            },
                                            {
                                                "example_id": "ebaa713b-5d95-4193-aba2-83681d849f23",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "I'm much stronger than you, so you can't possibly win."
                                            },
                                            {
                                                "example_id": "8abd20c2-52ca-433e-983d-ee3fa6309add",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "I couldn't possibly be there on time."
                                            },
                                            {
                                                "example_id": "c3662d54-b7b7-4b24-b657-128fab3fb7b2",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "The police don't know him, and the information they have leads them to think he could possibly have murdered his wife."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76ba1047-2151-46a9-a8e6-5b5fd501bbff",
                        "source_entry_id": "28ffabaa-7d19-35e1-8669-5c305cbf494f",
                        "source_sense_id": "38bd689d-f227-3c84-8d23-0030f3adb330",
