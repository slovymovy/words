        "fr-extract.jsonl": [
            {
                "entry_id": "04f10dcf-2805-3109-8924-2e2229c8876b",
                "word": "monte-plats",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ce539ad-958b-34d2-9fd7-bb29e86e5eb9",
                        "entry_id": "04f10dcf-2805-3109-8924-2e2229c8876b",
                        "glosses": [
                            "Sorte de petit monte-charge qui sert à faire monter ou descendre les plats quand la cuisine n’est pas au même étage que la salle à manger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e16368b3-9a1b-4912-8095-cd977f32e132",
                                "sense_id": "8ce539ad-958b-34d2-9fd7-bb29e86e5eb9",
                                "text": "Alors la bonne ouvrait une trappe, criait dans le vide du monte-plats :\n– La suite !\nEn bas, au plus profond de la cuisine grise, voûtée comme une chapelle, une petite femme maigre et laide qui mangeait sur un bout de table, se levait, prenait un plat dans le four, le glissait dans l'appareil élévateur."
                            },
                            {
                                "example_id": "ed5b1e96-3f10-4a5d-a61d-7960c2a43ff5",
                                "sense_id": "8ce539ad-958b-34d2-9fd7-bb29e86e5eb9",
                                "text": "[…] une grande cuisine semblable à une chambre de torture avec ses broches, ses roues de monte-plats, ses cuves, son odeur de graillon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
