                    {
                        "sense_id": "a70b4a1b-6195-37c3-919e-1cebba1eb6f9",
                        "entry_id": "b3d9ee64-bbe1-3c25-ac74-a0eba6097582",
                        "glosses": [
                            "An armed helicopter tasked to attack the enemy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8920aab6-2c3d-4b31-9bf6-78e5efcf22e3",
                                "sense_id": "a70b4a1b-6195-37c3-919e-1cebba1eb6f9",
                                "text": "I'm sending down five more dropships, combat EMVs, and a thopter gunship."
                            }
                        ]
                    },
                    {
                        "sense_id": "b102ba5f-adf9-32c4-bd77-c4bd178f3c95",
                        "entry_id": "b3d9ee64-bbe1-3c25-ac74-a0eba6097582",
                        "glosses": [
                            "A transport airplane equipped with large calibre guns typical of armoured fighting vehicles"
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "25453b5a-66c8-45bb-a084-83a6c45f47a0",
                                "sense_id": "b102ba5f-adf9-32c4-bd77-c4bd178f3c95",
                                "text": "Roger that, Hocus. Friendly gunship, coming in hot!"
                            }
                        ]
                    }
                ],
