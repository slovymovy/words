                {
                    "sense_id": "7ead07e3-e15b-3ea5-9d04-99e1c72fe536",
                    "sense_definition": "Extremely charmed, fascinated, or delighted by someone or something, as if under a spell.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enchanted_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was utterly <w>bewitched</w> by her charming smile and quick wit.",
                            "target_lang_translations": {
                                "fr": "Il était totalement <w>envoûté</w> par son charmant sourire et sa vivacité d'esprit.",
                                "zh": "他完全被她迷人的微笑和敏捷的机智弄得<w>神魂颠倒</w>。"
                            }
                        },
                        {
                            "text": "The tourists stood completely <w>bewitched</w> by the beauty of the ancient city.",
                            "target_lang_translations": {
                                "fr": "Les touristes restaient totalement <w>sous le charme</w> de la beauté de la cité antique.",
                                "zh": "游客们完全被这座古城的美丽所深深<w>着迷</w>，伫立不前。"
                            }
                        }
