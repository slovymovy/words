                        "sense_id": "f6c1b5e2-e160-3a2f-b00e-1fe5d76d1fe4",
                        "entry_id": "fad97f96-bf9c-35e0-9e2b-a4b3374a196a",
                        "glosses": [
                            "Qui peut ou pourrait se manifester."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b15162a8-a37b-470d-8d29-d980430f92eb",
                                "sense_id": "f6c1b5e2-e160-3a2f-b00e-1fe5d76d1fe4",
                                "text": "C’est de part et d’autre une qualité occulte, manifestable seulement par ses effets ; et susceptible de s’adapter à l’explication de tous les phénomènes."
                            },
                            {
                                "example_id": "5118a629-f199-453b-b161-ed87cfa01f91",
                                "sense_id": "f6c1b5e2-e160-3a2f-b00e-1fe5d76d1fe4",
                                "text": "La Vierge de la Lumière supérieure symbolise la Force manifestable, mais non encore manifestée, de l'Impensable, voilé du voile du mystère."
                            },
                            {
                                "example_id": "fd786fe5-8b4c-49c4-8e8c-d7825d3cda4b",
                                "sense_id": "f6c1b5e2-e160-3a2f-b00e-1fe5d76d1fe4",
                                "text": "L’injection sous-cutanée plusieurs fois répétée de venin de Cobra faite chez le lapin à dose non mortelle crée chez lui un état d’anaphylaxie manifestable par l’exagération de la réaction protéotoxique qui succède presque immédiatement à l’injection intra-veineuse du même venin."
                            },
                            {
                                "example_id": "5abfbb3f-21d5-4917-8636-8d0e12505b21",
                                "sense_id": "f6c1b5e2-e160-3a2f-b00e-1fe5d76d1fe4",
                                "text": "Lorsqu’il s’imagine mort, il se voit comme une conscience manifestable qui, faute d’organes des sens et de cerveau, ne parvient plus à se manifester."
                            }
                        ]
                    }
