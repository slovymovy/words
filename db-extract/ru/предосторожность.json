                                                "example_id": "784f161b-3197-4de5-9594-66a82ad457cc",
                                                "sense_id": "d99644cd-47ae-3e23-adc3-a167a2444b2d",
                                                "text": "utmost caution is required when travelling in this dangerous neighbourhood"
                                            },
                                            {
                                                "example_id": "305f9fe4-f3bf-486e-9671-31455a22a4de",
                                                "sense_id": "d99644cd-47ae-3e23-adc3-a167a2444b2d",
                                                "text": "In way of caution I must tell you."
                                            },
                                            {
                                                "example_id": "239882c0-959d-4116-ae1b-0e17158845ae",
                                                "sense_id": "d99644cd-47ae-3e23-adc3-a167a2444b2d",
                                                "text": "[...] and on the Saturday heavy seas pounded the W.R. on its exposed coastal stretch between Dawlish and Teignmouth, loosening the ballast and forcing trains to proceed with extreme caution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26989bac-1c8e-3c6f-ba81-835644cd5263",
                                        "entry_id": "36bac041-911d-3a41-9cf0-fbfcb55fa24c",
                                        "glosses": [
                                            "A careful attention to the probable effects of an act, in order that failure or harm may be avoided."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ba9c859-d455-42a7-a38e-418e1e1ea830",
                                                "sense_id": "26989bac-1c8e-3c6f-ba81-835644cd5263",
                                                "text": "The guideline expressed caution against excessive radiographic imaging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73fa069b-e8d3-3599-a87c-c693b6ac97e2",
                                        "entry_id": "36bac041-911d-3a41-9cf0-fbfcb55fa24c",
                                        "glosses": [
                                            "Security; guaranty; bail."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4853e59e-851e-4284-b9a8-3df2306d7d9e",
                                                "sense_id": "73fa069b-e8d3-3599-a87c-c693b6ac97e2",
                                                "text": "The Parliament would yet give his majesty sufficient caution that the war should be vigorously prosecuted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47e1f62b-10c1-3c68-896d-3511e5b92c72",
                                        "entry_id": "36bac041-911d-3a41-9cf0-fbfcb55fa24c",
                                        "glosses": [
                                            "One who draws attention or causes astonishment by their behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e47eeb2-a21e-4091-bf59-554d50e67ba1",
                                                "sense_id": "47e1f62b-10c1-3c68-896d-3511e5b92c72",
                                                "text": "Oh, that boy, he's a caution! He does make me laugh."
                                            },
                                            {
                                                "example_id": "f7b3fc1a-12ce-40a2-b578-d5823ad70255",
                                                "sense_id": "47e1f62b-10c1-3c68-896d-3511e5b92c72",
                                                "text": "‘You are a caution,’ she said, when she came out. ‘I don't understand you.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5c1b051-a182-3e87-b7af-f873ae4e0321",
                                        "entry_id": "36bac041-911d-3a41-9cf0-fbfcb55fa24c",
                                        "glosses": [
                                            "A formal warning given as an alternative to prosecution in minor cases."
                                        ],
