                "senses": [
                    {
                        "sense_id": "c6869f62-6c06-375c-91a0-b57a552d67b0",
                        "entry_id": "da46d6df-522b-3c6b-ae04-2dca7f629b7d",
                        "glosses": [
                            "Advocacy of rural life instead of urbanism or city living."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6e82a983-322e-4b30-b420-ec447417b387",
                                "sense_id": "c6869f62-6c06-375c-91a0-b57a552d67b0",
                                "text": "Ruralism conserves its isolation,..."
                            },
                            {
                                "example_id": "dc5a3c57-543e-41fa-879f-7038924657b2",
                                "sense_id": "c6869f62-6c06-375c-91a0-b57a552d67b0",
                                "text": "...'By \"ruralism\" I mean the glorification of country life, and a dissatisfaction with urbanism..."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac47624a-8031-36fc-90e6-c118bf94adbd",
                        "entry_id": "da46d6df-522b-3c6b-ae04-2dca7f629b7d",
                        "glosses": [
                            "Rural living."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6c8c9237-a689-46ee-ae85-890d67fc1542",
                                "sense_id": "ac47624a-8031-36fc-90e6-c118bf94adbd",
                                "text": "Here, for the first time, had Marcella been brought face to face with the agricultural world as it is--no stage ruralism, but the bare fact in one of its most pitiful aspects."
                            },
                            {
                                "example_id": "86a806b9-2084-49e9-8f85-2caf7ba5271b",
                                "sense_id": "ac47624a-8031-36fc-90e6-c118bf94adbd",
                                "text": "At the end of the cycle Roman culture was turning its back upon ruralism and moving into a culture that was to be chiefly urban during an entire millennium."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff4aab0e-7a1c-325f-b2bf-bd19a9113374",
                        "entry_id": "da46d6df-522b-3c6b-ae04-2dca7f629b7d",
                        "glosses": [
                            "The state or quality of being rustic."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7552c653-c343-4dd6-a9ef-d7865e90ce92",
                                "sense_id": "ff4aab0e-7a1c-325f-b2bf-bd19a9113374",
                                "text": "The beautifully hypnotic patterns that have become an earmark, of the Ritual Trio are well suited to Bang's varied solo flights; on the album's affecting \"Pedro,\" Bang's rough violin scrapes convey a backwoodsy ruralism, recalling the rootsy fiddle playing of southern prewar black string bands, while the title track with its propulsive near-swing finds him putting out a wild, Ornette-ish sound splash."
                            },
                            {
                                "example_id": "70747f6e-829a-4cdd-82e7-55f3e6c25e22",
                                "sense_id": "ff4aab0e-7a1c-325f-b2bf-bd19a9113374",
                                "text": "He had a robust earthiness that signified authenticity, especially to Americans of the postwar era who prized ruralism and took vernacular artists to be truer, more legitimate, than trained urban professionals."
                            }
                        ]
                    },
                    {
                        "sense_id": "19ca8990-983d-3bef-bd0a-4bff73bbe266",
                        "entry_id": "da46d6df-522b-3c6b-ae04-2dca7f629b7d",
                        "glosses": [
                            "A rural idiom or expression."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
