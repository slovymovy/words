                                "target_senses": [
                                    {
                                        "sense_id": "eb672d83-f82d-30f0-ab0e-6a1122a17156",
                                        "entry_id": "cf85d919-f26b-3666-8c5c-a89d805cdbcb",
                                        "glosses": [
                                            "geeft een toegeving aan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e4f7ed-fe27-4bd0-97b6-83e07300a28a",
                                                "sense_id": "eb672d83-f82d-30f0-ab0e-6a1122a17156",
                                                "text": "Hij is weliswaar nooit in China geweest, maar hij weet wél veel van de geschiedenis van het land."
                                            },
                                            {
                                                "example_id": "aff3d3b6-ed36-4011-af26-adf324e8b642",
                                                "sense_id": "eb672d83-f82d-30f0-ab0e-6a1122a17156",
                                                "text": "Het voelt nog steeds onwennig om hem te gebruiken, alsof ze een kostuum aantrekt dat weliswaar van haar is, maar niet goed past."
                                            },
                                            {
                                                "example_id": "42636641-6e97-4443-96d7-1c3b3014b705",
                                                "sense_id": "eb672d83-f82d-30f0-ab0e-6a1122a17156",
                                                "text": "Hoog niveau: Voorzitter Bob Hoogendoorn van het Koninklijk Nederlands Geologisch-Mijnbouwkundig Genootschap (KNGMG) valt hem bij. \"Er is echt geen werkloze afgestudeerde op dit moment. Er is enorm veel vraag naar.\" Bovendien is de kwaliteit van het onderwijs en onderzoek aan de VU van wereldniveau, benadrukt hij. Niet goedkoop weliswaar, mede door het veldwerk, maar wel erg goed."
                                            },
                                            {
                                                "example_id": "1c535999-bd67-4871-b343-361226b6693a",
                                                "sense_id": "eb672d83-f82d-30f0-ab0e-6a1122a17156",
                                                "text": "Wie het haalt tot de laatste bocht naar links, weet het antwoord. Daar ligt weliswaar weer wat asfalt, maar het is een onvervalste muur: 24 procent. Het is hier dat la belle fille op haar fiets om hulp van boven smeekt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0125f6a3-08c9-44d5-b4f3-25fb61bb0984",
                        "source_entry_id": "64417f4c-eb76-34f5-ad5f-3d12d7e525af",
                        "source_sense_description": "consession followed by counterpoint",
                        "target_lang_word": "zwar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "257b78d2-0039-3cae-82e2-dd7e436f859e",
                                        "entry_id": "d3d85131-df6b-3f14-8af2-c8863ebe367c",
                                        "glosses": [
                                            "Gegensätzliches einräumend (zwar – aber)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c53ae27d-034b-49e9-8285-d567149bbd31",
                                                "sense_id": "257b78d2-0039-3cae-82e2-dd7e436f859e",
                                                "text": "Das Gas selbst ist zwar unsichtbar, aber die hellblaue Farbe der Galaxien zeugt von Sternenentstehungen, die ohne Gas nicht möglich wären."
                                            },
                                            {
                                                "example_id": "3a5bfc39-d8c6-4957-b0e9-1079a7a5b7aa",
                                                "sense_id": "257b78d2-0039-3cae-82e2-dd7e436f859e",
                                                "text": "Er mag ihn zwar nicht, aber er hat ihn trotzdem eingeladen."
                                            },
                                            {
                                                "example_id": "383cded8-1db0-4e96-99f9-4dfe2461ad8e",
                                                "sense_id": "257b78d2-0039-3cae-82e2-dd7e436f859e",
                                                "text": "„Mehr Wettbewerb auf der Schiene wird zwar gefordert, aber nicht energisch durchgesetzt.“"
                                            },
                                            {
                                                "example_id": "3eeb01cf-1fbc-4ee1-8c86-b5a58a3467c4",
                                                "sense_id": "257b78d2-0039-3cae-82e2-dd7e436f859e",
                                                "text": "„Das Misstrauen gegenüber gentechnisch veränderten Lebensmitteln ist zwar groß, allerdings sind »Gene« natürlich in jedem Lebewesen und damit auch in allen Nahrungsmitteln enthalten.“"
                                            },
                                            {
                                                "example_id": "efa8e74b-026c-419f-9ddd-27694dc1d650",
                                                "sense_id": "257b78d2-0039-3cae-82e2-dd7e436f859e",
                                                "text": "„Obergärige Hefen sind zwar empfindlicher als untergärige, aber mit ihnen verläuft die Gärung deutlich schneller und ohne moderne Kühltechnik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c609d56-ff1b-39bd-af6d-c7df16d067f6",
                                        "entry_id": "d3d85131-df6b-3f14-8af2-c8863ebe367c",
                                        "glosses": [
                                            "genauere Beschreibung (und zwar)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15317b0e-8339-45a0-a728-a0a9f7e49441",
                                                "sense_id": "1c609d56-ff1b-39bd-af6d-c7df16d067f6",
                                                "text": "Der Teig besteht nur aus drei Zutaten, und zwar aus Mehl, Wasser und Salz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
