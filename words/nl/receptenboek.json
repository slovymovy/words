                    "frequency": "VeryLow",
                    "semantic_group_id": "boeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De apotheker controleerde het handgeschreven <w>receptenboek</w> uit de negentiende eeuw.",
                            "target_lang_translations": {
                                "en": "The pharmacist checked the handwritten <w>prescription book</w> from the nineteenth century."
