                                    {
                                        "sense_id": "f61e8a02-3450-301d-be6c-00ac51a8030e",
                                        "entry_id": "b32feb3f-b528-3459-a564-cb4f4bda5c47",
                                        "glosses": [
                                            "bekwaam door ondervinding"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34951cdc-27aa-48f7-b195-98ae530b252f",
                                                "sense_id": "f61e8a02-3450-301d-be6c-00ac51a8030e",
                                                "text": "Ze is een van de meest ervaren speelsters in het veld."
                                            },
                                            {
                                                "example_id": "dcf83118-ce95-49f5-8620-33652bb0c494",
                                                "sense_id": "f61e8a02-3450-301d-be6c-00ac51a8030e",
                                                "text": "Sarah verroerde zich niet, maar de konijnen, ervaren verstoppers, schoten alle kanten uit en verdwenen van de oppervlakte van de wachtende aarde."
                                            },
                                            {
                                                "example_id": "bead19ad-b465-443d-aa90-6a927fb14645",
                                                "sense_id": "f61e8a02-3450-301d-be6c-00ac51a8030e",
                                                "text": "De dagen erna moesten we ons concentreren op de uitdagingen die voor ons lagen zoals Glenn Pass, Pinchot Pass, Mather Pass en Muir Pass, allemaal meer dan 3.500 m hoog. England was een ervaren alpinist."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ervaren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6c21e685-fb9d-3cda-80db-76568751182a",
                                        "entry_id": "d4bdee2f-8a4d-3eb9-98df-ee421d56aeb3",
                                        "glosses": [
                                            "iets beleven, doormaken, ondervinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfe6c1cf-9a37-4c65-82fa-f6de17bb9237",
                                                "sense_id": "6c21e685-fb9d-3cda-80db-76568751182a",
                                                "text": "De meesten ervaren dit als onaangenaam."
                                            },
                                            {
                                                "example_id": "a7997eed-0cdc-4467-bd4d-e40f7f4251bf",
                                                "sense_id": "6c21e685-fb9d-3cda-80db-76568751182a",
                                                "text": "Zijn sturing werd ervaren als een anker."
                                            },
                                            {
                                                "example_id": "0956b38b-c5c6-415f-a897-9e22c6469639",
                                                "sense_id": "6c21e685-fb9d-3cda-80db-76568751182a",
                                                "text": "Er ontstaat een soort gelukscocktail zodra je de hele dag loopt. Een mix van endorfine, serotonine, dopamine, oxytocine en testosteron. Als je deze hormonen allemaal tegelijk ervaart geven ze een wonderlijk gevoel dat net zo verslavend is als elke harddrug."
                                            }
                                        ]
                                    }
                                ]
                            },
