                                "example_id": "77eb5917-8d58-4744-aa2b-f33eb64f8e92",
                                "sense_id": "39497aa4-519b-34ba-94a6-b0fecd0de868",
                                "text": "As one writer put it: “Wealth is counted in worldsful of gold.[…]”"
                            },
                            {
                                "example_id": "24d5ccc8-f3ad-4f47-b6af-84f31bc1d149",
                                "sense_id": "39497aa4-519b-34ba-94a6-b0fecd0de868",
                                "text": "\"[…]Entire worldsful of beings who look at yonder stars till it aches in them, and know that except for a few lucky individuals, none of them will ever get out there, nor will their descendants have any real say about the future, no, will instead remain nothing but potential victims—\""
                            }
                        ]
                    }
