    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7026cc10-5773-3c8e-a434-5755a78678dc",
                    "sense_definition": "Simple past and past participle of <w>observe</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists <w>observed</w> the behavior of the animals in their natural habitat.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>наблюдали</w> за поведением животных в их естественной среде обитания.",
                                "tr": "Bilim insanları hayvanların doğal ortamlarındaki davranışlarını <w>gözlemledi</w>."
                            }
                        },
                        {
                            "text": "No significant changes were <w>observed</w> in the patient's condition overnight.",
                            "target_lang_translations": {
                                "ru": "За ночь в состоянии пациента не <w>наблюдалось</w> существенных изменений.",
                                "tr": "Gece boyunca hastanın durumunda önemli bir değişiklik <w>gözlemlenmedi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "frequently observed",
                        "observed behavior",
                        "observed difference"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past simple and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола observe (наблюдать, замечать, соблюдать).",
                        "tr": "\"Observe\" fiilinin geçmiş zaman ve geçmiş zaman sıfat-fiil hali (gözlemlemek, fark etmek, uymak)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наблюдал",
                                "target_lang_sense_clarification": "следил, изучал"
                            },
                            {
                                "target_lang_word": "заметил",
                                "target_lang_sense_clarification": "обнаружил, увидел"
                            },
                            {
                                "target_lang_word": "соблюдал",
                                "target_lang_sense_clarification": "придерживался правил или обычаев"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gözlemledi",
                                "target_lang_sense_clarification": "izledi, inceledi"
                            },
                            {
                                "target_lang_word": "fark etti",
                                "target_lang_sense_clarification": "gördü, tespit etti"
                            },
                            {
                                "target_lang_word": "uydu",
                                "target_lang_sense_clarification": "kurallara veya geleneklere uydu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68e9fb45-0017-355e-897d-bd78367314c2",
                    "sense_definition": "Exceptionally celebrated on a date other than the usual date, often because the actual holiday falls on a weekend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since the Fourth of July is on a Sunday this year, Monday will be the holiday <w>observed</w>.",
                            "target_lang_translations": {
                                "ru": "Поскольку Четвертое июля в этом году выпадает на воскресенье, праздник будет <w>отмечаться</w> в понедельник.",
                                "tr": "Bu yıl 4 Temmuz Pazar gününe denk geldiği için tatil pazartesi günü <w>kutlanacak</w>."
                            }
                        },
                        {
                            "text": "Government offices are closed today for Independence Day <w>observed</w>.",
                            "target_lang_translations": {
                                "ru": "Правительственные учреждения сегодня закрыты в связи с <w>отмечаемым</w> Днем независимости.",
                                "tr": "Resmi daireler <w>kutlanan</w> Bağımsızlık Günü nedeniyle bugün kapalı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "holiday observed",
                        "date observed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отмечаемый в дату, отличную от календарной (обычно при переносе праздника, выпавшего на выходной).",
                        "tr": "Asıl tatil gününün hafta sonuna denk gelmesi nedeniyle alışılagelmiş tarihten farklı bir günde kutlanan veya resmi olarak uygulanan (tatil)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмечаемый",
                                "target_lang_sense_clarification": "празднуемый"
                            },
                            {
                                "target_lang_word": "перенесенный",
                                "target_lang_sense_clarification": "о дате праздника"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kutlanan",
                                "target_lang_sense_clarification": "resmi olarak idrak edilen"
                            },
                            {
                                "target_lang_word": "kaydırılan",
                                "target_lang_sense_clarification": "tarihi ertelenen/değiştirilen tatil günü"
                            }
                        ]
                    }
                }
            ]
        }
    ]
