                ],
                "senses": [
                    {
                        "sense_id": "0a2b5595-6bf8-3226-93e6-3e4b1e83bd6a",
                        "entry_id": "fe9fb872-baea-3d74-9834-647cac909174",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9182e52-0e08-4e2f-810d-92b6754c895a",
                                "sense_id": "0a2b5595-6bf8-3226-93e6-3e4b1e83bd6a",
                                "text": "Frau Steinle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "93318046-2ac3-4b97-b983-1967ed92ebed",
                                "sense_id": "0a2b5595-6bf8-3226-93e6-3e4b1e83bd6a",
                                "text": "Herr Steinle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "972dcf50-a591-4f4d-b23c-5087575eea84",
                                "sense_id": "0a2b5595-6bf8-3226-93e6-3e4b1e83bd6a",
                                "text": "Die Steinles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "9d235cbe-3d79-4ad1-b770-1e683c2fe98c",
                                "sense_id": "0a2b5595-6bf8-3226-93e6-3e4b1e83bd6a",
                                "text": "Der Steinle trägt nie die Pullover, die die Steinle ihm strickt."
                            },
                            {
                                "example_id": "d609bc45-5c20-439d-a504-68b7af182a9c",
                                "sense_id": "0a2b5595-6bf8-3226-93e6-3e4b1e83bd6a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Steinle kommt, geht der Herr Steinle.“"
                            },
                            {
                                "example_id": "94e69b16-4543-43e3-99d5-e9999379a6e7",
                                "sense_id": "0a2b5595-6bf8-3226-93e6-3e4b1e83bd6a",
                                "text": "Steinle kommt und geht."
                            },
                            {
                                "example_id": "694d1f49-f028-4ba9-9f6d-a2183f69f40e",
                                "sense_id": "0a2b5595-6bf8-3226-93e6-3e4b1e83bd6a",
                                "text": "Steinles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
