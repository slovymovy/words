                "senses": [
                    {
                        "sense_id": "b9cedb69-ea4b-3f44-b5b3-e7e7db8889e9",
                        "entry_id": "e769b707-3133-3a17-951e-fa2553411c4a",
                        "glosses": [
                            "Vorwärtsbewegung mehrerer Personen, die einzeln hintereinander in Reihe gehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "123661b4-20f9-46db-bb0a-9b14f4e37028",
                                "sense_id": "b9cedb69-ea4b-3f44-b5b3-e7e7db8889e9",
                                "text": "„Wir tappen uns vorwärts im Gänsemarsch durch die Gräben und Trichter und gelangen wieder in die Nebelzone.“"
                            },
                            {
                                "example_id": "de0a8102-4639-4630-915e-8ad5734803bc",
                                "sense_id": "b9cedb69-ea4b-3f44-b5b3-e7e7db8889e9",
                                "text": "Die zwölf Schüler gehen schweigend im Gänsemarsch hinter Norman."
                            },
                            {
                                "example_id": "cb57d946-0244-40d6-8663-62fac8048538",
                                "sense_id": "b9cedb69-ea4b-3f44-b5b3-e7e7db8889e9",
                                "text": "„Da schreiten in feierlichem Gänsemarsch die Richter durch die geöffnete Tür, drei Talare, zwei Uniformen und zwei Bratenröcke.“"
                            },
                            {
                                "example_id": "840d4627-5180-4a45-b46f-e0a4202d386d",
                                "sense_id": "b9cedb69-ea4b-3f44-b5b3-e7e7db8889e9",
                                "text": "„Im Gänsemarsch kamen sie aus dem Lagerhaus heraus, marschierten am Fabrikgebäude vorbei und verschwanden im Dschungel.“"
                            },
                            {
                                "example_id": "06181262-ca00-4f5d-b047-f8e4b78440e6",
                                "sense_id": "b9cedb69-ea4b-3f44-b5b3-e7e7db8889e9",
                                "text": "Da die Eingeborenen im Gänsemarsch, einer hinter dem andern, zu marschiren pflegen, ist der Weg nur 30 cm breit."
                            },
                            {
                                "example_id": "5a02e82d-56c0-40ce-82f8-1676a69be524",
                                "sense_id": "b9cedb69-ea4b-3f44-b5b3-e7e7db8889e9",
                                "text": "Zu dem Spiel waren fast 79.000 Zuschauer gekommen. Wegen der großen Menschenmassen in dem schmalen Korridor zur Metro ging es nur im Gänsemarsch voran."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d1d6ce9-e3b1-454f-87f4-af4c275d899f",
                        "source_entry_id": "e769b707-3133-3a17-951e-fa2553411c4a",
                        "source_sense_id": "b9cedb69-ea4b-3f44-b5b3-e7e7db8889e9",
