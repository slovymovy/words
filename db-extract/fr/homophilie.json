        "fr-extract.jsonl": [
            {
                "entry_id": "4ed8f985-7c1a-34dd-8dd4-24d9b15a7596",
                "word": "homophilie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "73ffa4f7-b1e5-4f44-9638-6ff00eafbf01",
                        "entry_id": "4ed8f985-7c1a-34dd-8dd4-24d9b15a7596",
                        "tags": [
                            "plural"
                        ],
                        "form": "homophilies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15cf3784-c058-3edf-9c80-5de6b968c16f",
                        "entry_id": "4ed8f985-7c1a-34dd-8dd4-24d9b15a7596",
                        "glosses": [
                            "Affinités préférentielles avec les personnes avec qui on partage des points communs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa0d06a7-712a-4098-9139-5af626950be4",
                                "sense_id": "15cf3784-c058-3edf-9c80-5de6b968c16f",
                                "text": "L’homophilie est un phénomène social bien établi par les sociologues. Une relation « homophile » est une relation entre deux personnes similaires (selon plusieurs caractéristiques), suivant le principe « qui se ressemble s'assemble »."
                            },
                            {
                                "example_id": "aae973ce-5e26-40d2-aed6-805440bea0f1",
                                "sense_id": "15cf3784-c058-3edf-9c80-5de6b968c16f",
                                "text": "Ensuite, l’homophilie, c’est simplement la tendance qu’on a à s’entourer de nos semblables. Il s’agit d’ailleurs d’un biais social qui n’est pas forcément lié à internet - il a juste été amplifié avec les réseaux sociaux."
                            },
                            {
                                "example_id": "bb9ab6c6-3923-4b03-8a46-3ec002b202c6",
                                "sense_id": "15cf3784-c058-3edf-9c80-5de6b968c16f",
                                "text": "D’un côté, l’homophilie sociale semble augmenter avec le degré d’intimité entre élèves ; de l’autre, les relations apparaissent plus mixtes au sein du collège qu’à l’extérieur de celui-ci. Or, ce que cette seconde interprétation implique, c’est que la fréquentation du collège augmente la mixité sociale des amitiés par rapport à ce que connaissent les élèves dans le reste de leur vie."
                            },
                            {
                                "example_id": "44409e5b-c7b2-44ec-a414-0b422501cd91",
                                "sense_id": "15cf3784-c058-3edf-9c80-5de6b968c16f",
                                "text": "L’homophilie réfère à la tendance qu'ont les gens de s’affilier à d'autres personnes qui leur ressemblent."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdc01571-0354-31ad-b705-a1b604030019",
                        "entry_id": "4ed8f985-7c1a-34dd-8dd4-24d9b15a7596",
                        "glosses": [
                            "Sympathie éprouvée envers les homosexuel(le)(s)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a60c608-1b2f-3bbb-bfaf-7bd5d7625dee",
                        "entry_id": "4ed8f985-7c1a-34dd-8dd4-24d9b15a7596",
                        "glosses": [
                            "Homosexualité."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7cc0e966-8442-4e0b-9393-7dde99438cc5",
                                "sense_id": "9a60c608-1b2f-3bbb-bfaf-7bd5d7625dee",
                                "text": "Si les Romains blâmaient l'homophilie, ils ne la blâmaient pas autrement que les courtisanes et les liaisons extra-conjugales."
                            },
                            {
                                "example_id": "8f2b6838-b2e2-4028-b943-8f71ca852fba",
                                "sense_id": "9a60c608-1b2f-3bbb-bfaf-7bd5d7625dee",
                                "text": "Car la plus grande partie de l’homophilie était tenue pour blâmable, mais pas selon notre morale à nous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca391c3f-8b1c-4cd6-81d0-0827c0b13fed",
                        "source_entry_id": "4ed8f985-7c1a-34dd-8dd4-24d9b15a7596",
                        "source_sense_description": "tendance à fréquenter les personnes similaires à soi-même",
                        "target_lang_word": "homophily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
