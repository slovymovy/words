                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2626eabb-52e7-4b1b-8393-c6889e17d08f",
                                "sense_id": "575bb6bb-7757-3a73-9fbc-577b305ecb70",
                                "text": "Une communication « très légère », déplore Paul Poulain, ingénieur consultant risques industriels au cabinet Riskcare, et auteur de Tout peut exploser (éd. Fayard)."
