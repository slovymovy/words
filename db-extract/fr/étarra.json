                "senses": [
                    {
                        "sense_id": "8fb2c5ca-f2cb-34ea-b90e-78547fca6ccc",
                        "entry_id": "31b062cd-937d-309d-a43e-5ddc39810179",
                        "glosses": [
                            "Militant de l’ETA."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b51f8c62-5add-4ad7-b467-b6af3db50b5a",
                                "sense_id": "8fb2c5ca-f2cb-34ea-b90e-78547fca6ccc",
                                "text": "Cet homme, âgé de trente-sept ans, serait le troisième étarra impliqué dans la mort de deux policiers espagnols suite à une fusillade à Capbreton, en décembre 2007."
                            },
                            {
                                "example_id": "8e0bf90b-f503-4ee1-945c-d6536306013a",
                                "sense_id": "8fb2c5ca-f2cb-34ea-b90e-78547fca6ccc",
                                "text": "Son lieutenant, Arkaitz Aguirregabiria del Barrio, également interpellé à Bayonne (sud-ouest de la France), était l’étarra le plus recherché par la France en raison de son implication présumée dans le meurtre d’un policier français, a déclaré Alfredo Perez Rubalcaba lors d’une conférence de presse."
                            }
                        ]
                    }
