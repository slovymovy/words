                        "glosses": [
                            "pierożek nadziewany surowym, mielonym mięsem wołowo-wieprzowym, podawany ze stopionym masłem lub śmietaną; tradycyjna potrawa kuchni ukraińskiej i rosyjskiej"
                        ],
