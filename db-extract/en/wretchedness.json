                        "cross_references": []
                    },
                    {
                        "translation_id": "c524d350-aab5-4cbd-ab15-d0024eddadf0",
                        "source_entry_id": "51f457fb-1554-30c8-99f8-1ac6e6f9d963",
                        "source_sense_description": "an unhappy state of mental or physical suffering",
                        "target_lang_word": "Armseligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armseligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4abd1d7-32c6-3f83-898a-4a9c5038c9d2",
                                        "entry_id": "f5011230-077a-3517-96a9-57c8f00a3f51",
                                        "glosses": [
                                            "Armseligsein; Eigenschaft, armselig, elend, ärmlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6cc7318-4417-4c15-b5a4-9f72226d68a5",
                                                "sense_id": "a4abd1d7-32c6-3f83-898a-4a9c5038c9d2",
                                                "text": "„Inmitten der Armseligkeit menschlicher Lebensumstände erstrahlt das Heil der Welt und verwandelt das Leben der Menschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "210ad41e-1f82-32c8-ab4a-45e2bc4f74a0",
                                        "entry_id": "f5011230-077a-3517-96a9-57c8f00a3f51",
                                        "glosses": [
                                            "Eigenschaft, armselig, erbärmlich, jämmerlich, unzureichend zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71c59731-7891-492a-9014-30a966761d93",
                                                "sense_id": "210ad41e-1f82-32c8-ab4a-45e2bc4f74a0",
                                                "text": "„Der Magistrat stellt die Armseligkeit seiner Verkehrspolitik erneut unter Beweis.“"
                                            },
                                            {
                                                "example_id": "81194814-161b-40b6-9f61-757519ef2e4e",
                                                "sense_id": "210ad41e-1f82-32c8-ab4a-45e2bc4f74a0",
                                                "text": "„Mit diesem Standardwerk «Weltgeschichte der Bekleidung» der wunderschönen Bekleidungs- und Lebenskultur wird die Armseligkeit, kulturlose «Amerikanisierung» und rücksichtslose Kommerzialisierung und Ausbeutungsmentalität der heutigen Modekonsum- und Lebenswelt deutlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "867e5f71-5402-4160-bc8c-30a8ba626788",
                        "source_entry_id": "51f457fb-1554-30c8-99f8-1ac6e6f9d963",
                        "source_sense_description": "an unhappy state of mental or physical suffering",
                        "target_lang_word": "Erbärmlichkeit",
