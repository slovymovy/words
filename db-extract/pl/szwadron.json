                    {
                        "translation_id": "5d706692-85f7-4f6f-b45c-1a183758613c",
                        "source_entry_id": "62acc8dd-c376-3c47-9539-47175e4b755e",
                        "source_sense_id": "f82d4d66-daa5-3ed2-a20c-d29d9f6943c6",
                        "target_lang_word": "Schwadron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwadron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                        "entry_id": "74a20aef-3042-3f6f-8aba-b7026919b91c",
                                        "glosses": [
                                            "kleinste Einheit der Kavallerie"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d67bdf6-d5e5-4206-9f42-49f885550f91",
                                                "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                                "text": "Die Schwadron ritt mit gezücktem Säbel ins Treffen, der Rittmeister vorneweg."
                                            },
                                            {
                                                "example_id": "d0c2f7f9-b7cd-4280-9247-da4b0d60eb24",
                                                "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                                "text": "„Sie mußten zur Seite springen, sich an eine Häuserwand drängen, denn die ganze Straße wurde von einer Schwadron roter Husaren eingenommen, die in so schnellem Trab in Kriegsausrüstung vorbeizogen, daß die Karabiner auf ihren Rücken hin und her hüpften.“"
                                            },
                                            {
                                                "example_id": "2294f473-dbee-4067-b357-a979b92120d1",
                                                "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                                "text": "„Die Schwadronen seiner Ausbildungsabteilung sind ebenfalls alarmiert worden; gleich in der nächsten Nacht sollen sie ausrücken.“"
                                            },
                                            {
                                                "example_id": "ec9bcd02-871e-4ddb-b9a3-a9e2722f0d04",
                                                "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                                "text": "„Zögernd ritt die Schwadron den steilen Berg der Vorstadt hinauf.“"
                                            },
                                            {
                                                "example_id": "cf71532b-0ece-4318-9f37-2e654f16ffbc",
                                                "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                                "text": "„Die Schwadron, der Nikolai Rostow als Junker angehörte, lag in dem deutschen Dorf Salzeneck im Quartier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
