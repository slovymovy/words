                "senses": [
                    {
                        "sense_id": "ab0039ca-a630-350e-8ab4-029f8efb39a9",
                        "entry_id": "e4bd5cf6-4830-3167-9cad-bb686b96f9a6",
                        "glosses": [
                            "elektrischer Leiter in einem Kabel, der einen berührbaren Teil eines elektrischen Geräts potentialfrei hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde60875-07b0-4b7d-9498-50cead9b89a6",
                                "sense_id": "ab0039ca-a630-350e-8ab4-029f8efb39a9",
                                "text": "„Der Schutzleiter, der dafür sorgt, dass bei einem Kurzschluss die Sicherung rausfliegt, sei gelb und grün. Den Strom führenden Leiter erkenne man an der schwarzen oder braunen Farbe.“"
                            },
                            {
                                "example_id": "cdd85b99-95a8-4407-92fa-d2ff4dbda865",
                                "sense_id": "ab0039ca-a630-350e-8ab4-029f8efb39a9",
                                "text": "„Dabei übersah er laut Gericht, dass ein Nagel im Haus den Schutzleiter des Lampenkabels durchtrennt hatte und das Gehäuse der Leuchte Strom führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
