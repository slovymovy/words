                    {
                        "sense_id": "c8a85fad-231c-332d-9138-baed872f8c56",
                        "entry_id": "7e954946-b144-32f7-9687-8ca21850d365",
                        "glosses": [
                            "Staub aus feinen Goldpartikeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51f54909-3241-43a1-a2b5-0ead1cfaa2f5",
                                "sense_id": "c8a85fad-231c-332d-9138-baed872f8c56",
                                "text": "„Alle Täfelungen waren mit Goldstaub belegt oder mit Blumen und Arabesken bemalt.“"
                            },
                            {
                                "example_id": "0dd94a2b-ea46-454c-9ba3-649c246782fd",
                                "sense_id": "c8a85fad-231c-332d-9138-baed872f8c56",
                                "text": "„Es soll ein Ritual darstellen, bei dem die Muisca-Indigenen ihre neuen Anführer mit Goldstaub einrieben.“"
                            },
                            {
                                "example_id": "d0b23249-fffa-48c1-8ec9-9c0a088ea0a0",
                                "sense_id": "c8a85fad-231c-332d-9138-baed872f8c56",
                                "text": "„Man nahm den Ureinwohnern den Goldstaub weg, raubte Goldschmuck aus ihren Gräbern, erpresste Goldstücke als Lösegeld und brachte deutsche Bergleute mit, um die Minen tiefer zu treiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
