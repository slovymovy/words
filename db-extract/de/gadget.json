                "senses": [
                    {
                        "sense_id": "57cbdac3-364c-3fc9-893c-d83a8541984d",
                        "entry_id": "ba509828-caba-321f-a14c-86beb180269c",
                        "glosses": [
                            "relativ kleiner, ansprechender, in der Regel innovativer Gegenstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1190417b-77f4-43a0-bc95-f587bb1a7848",
                                "sense_id": "57cbdac3-364c-3fc9-893c-d83a8541984d",
                                "text": "„Sollte ein Gadget für einen bestimmten Zweck noch nicht erfunden worden sein, dann erfand er es selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8220d4af-e7ab-471a-a978-a6af63d36c3c",
                        "source_entry_id": "ba509828-caba-321f-a14c-86beb180269c",
                        "source_sense_id": "57cbdac3-364c-3fc9-893c-d83a8541984d",
                        "source_sense_description": "relativ kleiner, ansprechender, in der Regel innovativer Gegenstand",
                        "target_lang_word": "gadget",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gadget",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb22b79b-8ce6-33d0-b7b4-d892f90ed806",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "A thing whose name cannot be remembered; thingamajig, doohickey."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0769c4-edf2-4481-92e6-26ae93a11654",
                                                "sense_id": "fb22b79b-8ce6-33d0-b7b4-d892f90ed806",
                                                "text": "Then the names of all the other things on board a ship! I don't know half of them yet; even the sailors forget at times, and if the exact name of anything they want happens to slip from their memory, they call it a chicken-fixing, or a gadjet, or a timmey-noggy, or a wim-wom—just pro tem., you know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcea0fb5-1539-33aa-9c1d-d4572793ac96",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "Any device or machine, especially one whose name cannot be recalled, often either clever or complicated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3ad6010-bbad-452f-96b8-acccb8965e4f",
                                                "sense_id": "bcea0fb5-1539-33aa-9c1d-d4572793ac96",
                                                "text": "He bought a neat new gadget for shredding potatoes."
                                            },
                                            {
                                                "example_id": "abfda18d-445c-4336-bd08-a30090db7787",
                                                "sense_id": "bcea0fb5-1539-33aa-9c1d-d4572793ac96",
                                                "text": "That's quite a lot of gadgets you have collected. Do you use any of them?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c64528b-9750-33de-a136-e46539f0f6d5",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "Any consumer electronics product."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "423a7057-17e8-4909-b3f2-f847fc43398c",
                                                "sense_id": "7c64528b-9750-33de-a136-e46539f0f6d5",
                                                "text": "From the Marvel Mixmaster to the Miracle Microwave, every time a new-fangled gadget has lobbed into the Aussie kitchen, Aussie mums have changed their cooking styles accordingly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9a4cd1b-0a57-34a9-b7d4-fedd68f29b58",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "A sequence of machine code instructions crafted as part of an exploit that attempts to divert execution to a memory location chosen by the attacker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f19f7e0f-9627-40f1-a64c-dfa154023122",
                                                "sense_id": "d9a4cd1b-0a57-34a9-b7d4-fedd68f29b58",
                                                "text": "A Spectre gadget was found in the Linux kernel's implementation of system interrupts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c98cad8f-d5fd-35a3-b6fc-b46157bff803",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "A technique for converting a part of one problem to an equivalent part of another problem, used in constructing reductions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ab871b-8cc2-47b1-808b-e4eb0155bcd2",
                                                "sense_id": "c98cad8f-d5fd-35a3-b6fc-b46157bff803",
                                                "text": "We reduce an instance of 3-SAT to an instance of bird-flock-optimization, using a gadget that converts each conjunctive Boolean clause to a group of birds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4af04bbd-6fcd-3671-8114-21d632dd814f",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "A spring clip attached to the end of a punty in order to grasp the foot of a glass without leaving a bullion while finishing the bowl."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
