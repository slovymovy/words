                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5d0488c-93b2-40c9-a332-d0dc2718c2c5",
                        "source_entry_id": "8d01781e-37cf-3b4d-83cc-e79e95f1ebc5",
                        "source_sense_id": "61efaa61-91ed-3869-96e5-ba9a1a67dd28",
                        "target_lang_word": "insister",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insister",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f900ba23-7cac-3a6e-b745-1d31fcb3c06e",
                                        "entry_id": "464479e0-ce98-3f14-9a4c-0275a224c3de",
                                        "glosses": [
                                            "Appuyer sur quelque chose, s’y arrêter avec force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "020c4e34-31cd-4e77-80b8-cb74a631c57d",
                                                "sense_id": "f900ba23-7cac-3a6e-b745-1d31fcb3c06e",
                                                "text": "Je n’insiste pas, car il existe des ouvrages sur ces questions, tels l’important mémoire de De Candolle [Augustin Pyrame de Candolle] et les travaux de A. Chevalier."
                                            },
                                            {
                                                "example_id": "47695edc-cbe5-4fe0-a727-55345234e35a",
                                                "sense_id": "f900ba23-7cac-3a6e-b745-1d31fcb3c06e",
                                                "text": "[…], de même que les représentants plus militants de l'islam radical, qui réclament aujourd'hui, à cor et à cri, le retour de la religion au cœur de la vie politique, insistent sur l'incompatibilité entre l'islam et la notion laïque de nationalisme arabe."
                                            },
                                            {
                                                "example_id": "6342751b-2ba0-4cf9-a8b4-210a69a2632d",
                                                "sense_id": "f900ba23-7cac-3a6e-b745-1d31fcb3c06e",
                                                "text": "Il insista beaucoup sur cette preuve."
                                            },
                                            {
                                                "example_id": "87d69e08-14b4-4abf-92f5-76992d382df3",
                                                "sense_id": "f900ba23-7cac-3a6e-b745-1d31fcb3c06e",
                                                "text": "L’avocat insista principalement sur ce moyen."
                                            },
                                            {
                                                "example_id": "e7de35f7-0e42-451f-b7ed-57e809a64082",
                                                "sense_id": "f900ba23-7cac-3a6e-b745-1d31fcb3c06e",
                                                "text": "Nous insistons sur les possibilités multi-plateformes de Python et présentons les bases pour étendre Python et l’intégrer dans d’autres applications en utilisant C ou Java."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "705aac83-da1e-320c-990c-5751ef30f4dd",
                                        "entry_id": "464479e0-ce98-3f14-9a4c-0275a224c3de",
                                        "glosses": [
                                            "Faire instance, persévérer à demander, à vouloir une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c7007f-ceb7-4d33-b239-8678da9f51e9",
                                                "sense_id": "705aac83-da1e-320c-990c-5751ef30f4dd",
                                                "text": "Ça va ! grommela Bob impatienté. L'autre n'insista pas et se mit à regarder par la portière."
                                            },
                                            {
                                                "example_id": "8fb66b0c-0ae2-4d50-b29d-5b679b8e2d16",
                                                "sense_id": "705aac83-da1e-320c-990c-5751ef30f4dd",
                                                "text": "Il fallut qu'Abdel Latif insistât, et elle accepta enfin, comme à regret."
                                            },
                                            {
                                                "example_id": "fbbb94c4-ad9e-48bb-af71-a9dcd68f4784",
                                                "sense_id": "705aac83-da1e-320c-990c-5751ef30f4dd",
                                                "text": "Mais Loïse, sa fille, insiste pour demeurer : elle aime la forêt, paraît-il, […], le père cède."
                                            },
                                            {
                                                "example_id": "c2561847-aded-4fc4-adea-b505952c48ce",
                                                "sense_id": "705aac83-da1e-320c-990c-5751ef30f4dd",
                                                "text": "Hier matin, vous n'êtes pas allé marcher avec le club, comme tous les mercredis. Comme par hasard, c'est le jour où votre voisin se fait assassiner. Il insista lourdement sur ce dernier mot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
