                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher pointed out that he had written <w>seperate</w> instead of using the correct spelling.",
                            "target_lang_translations": {
                                "tr": "Öğretmen, doğru yazımı kullanmak yerine <w>seperate</w> yazdığına dikkat çekti."
                            }
                        },
                        {
                            "text": "Although often seen in student essays, writing <w>seperate</w> rooms is considered an orthographic error.",
                            "target_lang_translations": {
                                "tr": "Öğrenci denemelerinde sıkça görülse de <w>seperate</w> rooms yazmak bir yazım hatası olarak kabul edilir."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "\"Separate\" (ayrı, bağımsız) sözcüğünün yaygın yapılan yanlış yazımı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ayrı",
                                "target_lang_sense_clarification": "yanlış yazım, separate anlamında"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7177f793-b136-371c-b0c1-4b6287df0268",
                    "sense_definition": "Common misspelling of <w>separate</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people erroneously write <w>seperate</w> when they mean to divide things apart.",
                            "target_lang_translations": {
                                "tr": "Birçok insan bir şeyleri ayırmayı kastederken yanlışlıkla <w>seperate</w> yazar."
                            }
                        },
                        {
                            "text": "The spellchecker flagged the sentence where she attempted to <w>seperate</w> the two items.",
                            "target_lang_translations": {
                                "tr": "Yazım denetleyicisi, iki ögeyi <w>ayırmaya</w> çalıştığı cümleyi işaretledi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "\"Separate\" (ayırmak, ayrılmak) eyleminin yaygın yapılan yanlış yazımı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ayırmak",
