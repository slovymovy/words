                ],
                "senses": [
                    {
                        "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                        "entry_id": "d7276746-22d6-3c58-bedc-4f7444ea6ca5",
                        "glosses": [
                            "Kind, das einen Kindergarten besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799b6b7f-97b9-4e1c-966f-e35a9b932f14",
                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                "text": "Die Kindergartenkinder stehen vor dem Affengehege und beobachten das Gorillamännchen."
                            },
                            {
                                "example_id": "1b67cce1-3da9-43de-959d-54aee88dff27",
                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                "text": "Ein Kindergartenkind spielt im Sand, ein anderes schaukelt."
                            },
                            {
                                "example_id": "f9850a83-c610-4a56-b37a-b0fb705e4970",
                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                "text": "„Ich habe mich schon als Kindergartenkind auf die Schule gefreut.“"
                            },
                            {
                                "example_id": "bf7249fd-8b56-4ae2-a979-c88cbd8285f7",
                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                "text": "„Kindergartenkinder lernten schneller, die waren in sechs Monaten fertig.“"
                            },
                            {
                                "example_id": "26f4c2a1-3c3d-4c72-a85e-e4187985dc31",
                                "sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                                "text": "„Auch die Untersuchung von Shields (1976) befaßt sich mit konversationellen Fähigkeiten, vor allem mit der Entwicklung des Dialogs bei drei- bis fünfjährigen Kindergartenkindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09fd515b-2108-4563-9408-11e134a708d5",
                        "source_entry_id": "d7276746-22d6-3c58-bedc-4f7444ea6ca5",
                        "source_sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                        "source_sense_description": "Kind, das einen Kindergarten besucht",
                        "target_lang_word": "kindergartner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kindergartner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                        "entry_id": "11bd5505-12e4-364d-a2a3-08765abd68e9",
                                        "glosses": [
                                            "A child who attends a kindergarten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c37748b-b396-4862-ad5b-1f9e1e314917",
                                                "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                                "text": "I partnered the older kids with my kindergartners and let everyone get a taste of teaching or learning from someone different."
                                            },
                                            {
                                                "example_id": "d86529c6-d43e-4742-91a5-11b83d4cbdf2",
                                                "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                                "text": "All 50 states have had school immunization requirements since the beginning of the 1980s, with incoming kindergartners needing shots to protect against diseases including measles, polio and tetanus. No states require a Covid-19 vaccine for schoolchildren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kindergartner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                        "entry_id": "4088fb6b-025f-3afb-a891-27d0f73065d8",
                                        "glosses": [
                                            "A person who teaches at a kindergarten."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb6578c-f73f-4f18-8266-2dbee4a58a79",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "But the heart is generally larger than the creed, as was once strikingly evidenced to me by Louisa Frankenberg, a dear, devout old German kindergartner, who had learned the art of kindergartning [...]"
                                            },
                                            {
                                                "example_id": "58e55518-e92f-4461-b872-7c0e2524c35d",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "[Jean-Jacques] Rousseau rightly insists that man’s education begins at his birth, and that what is acquired unconsciously far exceeds, in amount and importance, what is acquired consciously and through instruction.¹ […] ¹ This is a truth to which kindergærtners ought to give serious heed."
                                            },
                                            {
                                                "example_id": "86886290-7a47-48ff-8f5e-58b1eb80113b",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "I am a kindergartner, teaching in the Harrington School, New Bedford, Mass., and am a reader of the “Kindergarten Primary Magazine.”"
                                            },
                                            {
                                                "example_id": "948d7aa5-a130-4026-a46f-0788edb7f45c",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "The book that laid the groundwork for this new ideology was written by a German kindergartner who had emigrated to America in the late 1860s."
                                            },
                                            {
                                                "example_id": "a5d1004c-cb4f-4d3e-829e-fb62cfb676b9",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "She went to New York City in 1872 to train under German kindergartner Maria Kraus-Boelte[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ac8c37b-1490-4f31-aff0-27ad20dcaef2",
                        "source_entry_id": "d7276746-22d6-3c58-bedc-4f7444ea6ca5",
                        "source_sense_id": "ef2437c5-8f3c-35d7-b3c8-1a1265817c66",
                        "source_sense_description": "Kind, das einen Kindergarten besucht",
                        "target_lang_word": "préscolaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "préscolaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb202cde-d128-3038-96ae-6c660f871f20",
                                        "entry_id": "b84600a0-0669-372f-a2f4-bf9d5153cd10",
                                        "glosses": [
                                            "Qui concerne la maternelle, l’éducation des enfants avant l’école primaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c544db8-ccdb-4076-a705-b035e767a7ed",
                                                "sense_id": "cb202cde-d128-3038-96ae-6c660f871f20",
                                                "text": "Un apprentissage préscolaire."
                                            },
                                            {
                                                "example_id": "d3400dbc-4a30-449a-83cc-2e6f8c02e28a",
                                                "sense_id": "cb202cde-d128-3038-96ae-6c660f871f20",
                                                "text": "« A partir du semestre d’automne 2025, les frais de garde et d’éducation des enfants en dernière année d’école maternelle publique seront supprimés », a déclaré le Conseil des affaires de l’Etat, ajoutant souhaiter « promouvoir progressivement la gratuité de l’éducation préscolaire »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
