                                    {
                                        "sense_id": "3a9781c9-6d08-3eb4-8730-c536de383875",
                                        "entry_id": "f805f720-ea6d-3fa1-b308-ac05294e0ba8",
                                        "glosses": [
                                            "Of an animal, to use as a den; to take up residence in."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bae9f657-0e4a-4177-be52-3e57f3569822",
                                                "sense_id": "3a9781c9-6d08-3eb4-8730-c536de383875",
                                                "text": "Although present in virtually all habitats, it preferred to den in caves, so its distribution, especially in cold, northern areas, may have been limited to limestone and other rocky regions where caves form."
                                            },
                                            {
                                                "example_id": "9643ae33-6317-425a-ae11-859fde91ca38",
                                                "sense_id": "3a9781c9-6d08-3eb4-8730-c536de383875",
                                                "text": "“Denning” – behaviour around making dens – has changed and bears are swimming long distances, but, says Aars, there is still enough sea ice in the spring for the bears to hunt successfully."
                                            }
                                        ]
                                    }
                                ]
