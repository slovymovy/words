                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto reed met een <w>knallende</w> uitlaat door de stille straat van het dorp.",
                            "target_lang_translations": {
                                "en": "The car drove through the quiet street of the village with a <w>backfiring</w> exhaust."
                            }
