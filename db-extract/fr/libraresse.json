                        ],
                        "examples": [
                            {
                                "example_id": "f2c49602-29f5-4e73-ad16-74bb14930e87",
                                "sense_id": "4aa8311b-ae69-3713-bcbd-7251feaac639",
                                "text": "A Amſterdam ; & ſe trouve à Paris, chez la veuve Ducheſne, Librareſſe, rue Saint-Jacques […]. Permettez-moi de vous dire, Madame la Comteſſe, que j’aurois voulu que Madame Delaiſſe eût mis chez l’Autrice, comme j’ai mis Librareſſe. Ces qualifications ne ſont pas approuvées, il eſt vrai, par l’Académie Françaiſe, mais elles n’en ſont pas moins bonnes & ſignificatives ; d’ailleurs l’uſage les autoriſe : car nous diſons tous les jours à Paris, une Notareſſe, une Commiſſareſſe, une Librareſſe, &c.",
                                "translation": "À Amsterdam ; et se trouve à Paris, chez la veuve Duchesne, libraresse, rue Saint-Jacques […]. Permettez-moi de vous dire, Madame la Comtesse, que j’aurais voulu que Madame Delaisse eût mis chez l’autrice, comme j’ai mis libraresse. Ces qualifications ne sont pas approuvées, il est vrai, par l’Académie française, mais elles n’en sont pas moins bonnes et significatives ; d’ailleurs l’usage les autorise : car nous disons tous les jours à Paris, une notaresse, une commissaresse, une libraresse, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c15e98e-b29f-4d64-9680-07e1eaa89fbe",
                        "source_entry_id": "bf67062f-4819-3411-bd4a-6bcb359860f8",
                        "source_sense_id": "4aa8311b-ae69-3713-bcbd-7251feaac639",
                        "target_lang_word": "Buchhändlerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchhändlerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                        "entry_id": "3752e3c6-d82b-34a9-8d76-1588f564eb34",
                                        "glosses": [
                                            "weibliche Person, die vor allem mit Büchern handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cae1b85-2156-428e-a817-e2514524cea8",
                                                "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                                "text": "Buchhändlerinnen können ihre Kunden beraten, das richtige Buch zu finden."
                                            },
                                            {
                                                "example_id": "c419237d-6091-4569-8a54-9751b091792d",
                                                "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                                "text": "„Nun sitzt sie uns gegenüber, wortkarg und schüchtern, und sagt, dass sie nichts lieber wäre als Buchhändlerin, und wir wissen nicht warum, aber wir glauben ihr.“"
                                            },
                                            {
                                                "example_id": "fc9cd80c-72ab-4444-b865-eab53e5708fb",
                                                "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                                "text": "„Immerhin waren über zweihundert Zuhörer in den Saal gekommen, in den die Buchhändlerin noch schnell ausgewichen war.“"
                                            },
                                            {
                                                "example_id": "e17a3e6a-6740-4253-bca4-042f0b7d5624",
                                                "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                                "text": "„Die Buchhändlerinnen durchsuchten die Verlagsprogramme und fanden Reiseführer in Hülle und Fülle – und ansonsten nahezu nichts.“"
                                            },
                                            {
                                                "example_id": "274c3bc8-1b71-45c8-a122-f962e5424825",
                                                "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                                "text": "„Sie war damals Buchhändlerin, und der Kontakt zwischen den beiden war von da an nicht mehr abgerissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
