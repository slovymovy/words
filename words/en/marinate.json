                            "trait_type": "form",
                            "comment": "rare adjectival use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "находящийся в состоянии после маринования"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маринованный",
                                "target_lang_sense_clarification": "приготовленный в маринаде"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}