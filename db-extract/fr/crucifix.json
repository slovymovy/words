                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59f9a0f9-9c5c-46fe-ace8-5c643e6b9889",
                                                "sense_id": "60dd1f81-f3e5-315f-b548-ef97dabf9814",
                                                "text": "Kruzifix nochmal, jetzt habe ich den Karren vergessen."
