                                "sense_id": "201ce950-c7d9-3636-9b12-2ad5a1a2ef22",
                                "text": "Kupiłam sobie śliczną fuksję w doniczce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "19e7e742-728a-3eb1-b240-ea57dea5d3e8",
                        "entry_id": "b7958a89-c825-37ce-ae18-12b5296842d1",
                        "glosses": [
                            "fioletowo-czerwony kolor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b539127c-7568-440e-86e1-d97d84357923",
                                "sense_id": "19e7e742-728a-3eb1-b240-ea57dea5d3e8",
                                "text": "Uważam, że w fuksji jest ci zupełnie nie do twarzy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
