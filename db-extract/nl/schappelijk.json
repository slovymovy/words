                        "examples": [
                            {
                                "example_id": "a6025ec8-5d39-49ad-9c64-71a372cb8b39",
                                "sense_id": "99980ce8-b8b4-3deb-8939-bd8b23017226",
                                "text": "AH begon, Jumbo volgde wat later: acties waarbij je in een restaurant een tweede menu gratis krijgt. Zo eet je voor een zeer schappelijk prijsje buiten de deur. Het leek me zo’n aardige actie van AH. Voor ieder tientje aan boodschappen krijg je een zegel. Is je zegelkaart vol - en dat is hij gauw - dan kun je via Iens een tafel reserveren bij een van de deelnemende restaurants. Mooie beloning voor je klantentrouw."
                            }
                        ]
                    }
