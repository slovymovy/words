                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est bien trop <w>orgueilleux</w> pour admettre qu'il a commis une erreur devant ses collègues."
                        },
                        {
                            "text": "Son comportement <w>orgueilleux</w> a fini par agacer la plupart de ses amis les plus proches."
                        }
                    ],
