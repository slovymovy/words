                                        "entry_id": "81decef4-d23f-3235-bda3-68661ca2edf4",
                                        "glosses": [
                                            "La partie supérieure du pharynx au-dessus du voile du palais communicant par les choanes avec la cavité nasale ou fosses nasales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df9a806-63e0-48bc-b1e4-2b56e6387179",
                                                "sense_id": "89cdb5a7-e473-3c9e-b0b5-49f2e75afc9f",
                                                "text": "Le pharynx est divisé en trois segments, dont deux céphaliques, le rhinopharynx et l’oropharynx, et un cervical, l’hypopharynx."
                                            }
                                        ]
                                    }
                                ]
                            }
