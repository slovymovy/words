                ],
                "senses": [
                    {
                        "sense_id": "c0087f7d-d48b-3e48-b284-a06a3ae89e9b",
                        "entry_id": "a11f1ba0-83e6-3695-8baf-6a7bc12956c9",
                        "glosses": [
                            "Diminutiv von Turteltaube (Streptopelia turtur)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24d14b6e-bdb8-446b-a68b-7249bce115ec",
                                "sense_id": "c0087f7d-d48b-3e48-b284-a06a3ae89e9b",
                                "text": "[Aschenputtel:] Da kamen zum Küchenfenster zwei weiße Täubchen herein, und danach die Turteltäubchen, und endlich schwirrten und schwärmten alle Vöglein unter dem Himmel herein, und ließen sich um die Asche nieder."
                            },
                            {
                                "example_id": "310bc7d6-5b61-4c4b-9479-789203e98239",
                                "sense_id": "c0087f7d-d48b-3e48-b284-a06a3ae89e9b",
                                "text": "„O du liebes Einmaleins/Hätt’ ich dich im Köpfchen/Wie mein Turteltäubchen/Körnchen hat im Kröpfchen“. Mit solchen Sinnsprüchen wurden Ende des 19. Jahrhunderts Zeichnungen für das brave Kind garniert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c2b1a2f7-b2f2-3784-8118-f0cd1e0279f1",
                        "entry_id": "a11f1ba0-83e6-3695-8baf-6a7bc12956c9",
                        "glosses": [
                            "verliebtes Paar, das seine Liebe in der Öffentlichkeit zeigt, beispielsweise durch Blicke, Berührungen, Neckereien"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "34f0e6b3-fed5-40c6-8d01-adc8ca94668e",
                                "sense_id": "c2b1a2f7-b2f2-3784-8118-f0cd1e0279f1",
                                "text": "Das verfallene Häuschen Nummer 13 war das Liebesnest der zwei Turteltäubchen Don Ottavio und Lucrezia Vannozzi."
                            },
                            {
                                "example_id": "28ec3e0c-21b2-4f14-b995-610f4509835d",
                                "sense_id": "c2b1a2f7-b2f2-3784-8118-f0cd1e0279f1",
                                "text": "Händchenhaltend besuchten der 33-jährige Enkel der Queen und die 36-jährige „Suits“-Darstellerin ein Rollstuhl-Tennismatch […]. Auf der Tribüne nahmen die beiden Turteltäubchen anschließend nebeneinander Platz."
                            },
                            {
                                "example_id": "91b5de29-f764-4655-a5d3-72413ed7df36",
                                "sense_id": "c2b1a2f7-b2f2-3784-8118-f0cd1e0279f1",
                                "text": "Diese Turteltäubchen können einem ganz schön auf die Nerven gehen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1883a908-75a4-462f-96fc-e811875726fc",
                        "source_entry_id": "a11f1ba0-83e6-3695-8baf-6a7bc12956c9",
                        "source_sense_id": "c0087f7d-d48b-3e48-b284-a06a3ae89e9b",
                        "source_sense_description": "Diminutiv von Turteltaube",
                        "target_lang_word": "turtle dove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turtle dove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8260764-612b-3062-8996-5d8585fe9b3c",
                                        "entry_id": "740f31f1-632c-3b36-be6f-6213ebd49aa2",
                                        "glosses": [
                                            "Any of several (species of) birds, called by this traditional name, mainly in the genus Streptopelia, of the family Columbidae (doves and pigeons, which also included the extinct passenger pigeon, dodo, and solitaire)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4ec9e48-300b-3d09-afeb-7a86b657c2cb",
                                        "entry_id": "740f31f1-632c-3b36-be6f-6213ebd49aa2",
                                        "glosses": [
                                            "A lover or couple as a pair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cb6e881-cf10-471e-bba2-fa2477edfbc8",
                                                "sense_id": "d4ec9e48-300b-3d09-afeb-7a86b657c2cb",
                                                "text": "Out for their evening constitutional. A lovely pair of turtledoves. Around the jolly corner, and off to the park."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90a78636-f656-4411-8911-281e10c56f56",
                        "source_entry_id": "a11f1ba0-83e6-3695-8baf-6a7bc12956c9",
                        "source_sense_id": "c0087f7d-d48b-3e48-b284-a06a3ae89e9b",
                        "source_sense_description": "Diminutiv von Turteltaube",
                        "target_lang_word": "tourtereau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourtereau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d53d12b8-4d25-3d2f-827d-191c9a96bbb1",
                                        "entry_id": "45d5b0c0-1872-3533-81a3-a355b76d6ccd",
                                        "glosses": [
                                            "Jeune tourterelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4500d421-ee8f-437c-8255-a8c67621b6ea",
                                                "sense_id": "d53d12b8-4d25-3d2f-827d-191c9a96bbb1",
                                                "text": "Élever des tourtereaux."
                                            },
                                            {
                                                "example_id": "1f98de3b-4cd5-4cba-b439-6047b08f0c19",
                                                "sense_id": "d53d12b8-4d25-3d2f-827d-191c9a96bbb1",
                                                "text": "Manger des tourtereaux."
                                            },
                                            {
                                                "example_id": "d7dbef9b-dd2b-4466-990c-e3ca597f927f",
                                                "sense_id": "d53d12b8-4d25-3d2f-827d-191c9a96bbb1",
                                                "text": "Dans la volière une tourterelle picore un baiser au bec de son tourtereau et pieusement s’en gargarise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82a0a559-4d90-32ff-aaef-7f7bb99fbea2",
                                        "entry_id": "45d5b0c0-1872-3533-81a3-a355b76d6ccd",
                                        "glosses": [
                                            "Amoureux, avec une nuance de plaisanterie indulgente."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1984cbd4-7f39-4274-8b86-12ba6f6f18e8",
                                                "sense_id": "82a0a559-4d90-32ff-aaef-7f7bb99fbea2",
                                                "text": "Il tenait sa petite femme sous le bras ; elle était fraîche et gaie comme une enfant. Ils avaient l’air de deux tourtereaux."
                                            },
                                            {
                                                "example_id": "3167bfda-fbf5-433e-94b6-601978ad74b8",
                                                "sense_id": "82a0a559-4d90-32ff-aaef-7f7bb99fbea2",
                                                "text": "Évidemment ce ne seront plus de très jeunes époux. Ils seront ridicules s’ils veulent prendre des mines de tourtereaux."
                                            },
                                            {
                                                "example_id": "1416a2c7-efb1-48b4-8829-60ceb7877420",
                                                "sense_id": "82a0a559-4d90-32ff-aaef-7f7bb99fbea2",
