                ],
                "senses": [
                    {
                        "sense_id": "87bcc731-3564-3608-9adf-989b6d3aaa95",
                        "entry_id": "f018cc57-010f-326f-97a6-62c3750e18a3",
                        "glosses": [
                            "Réagir en réaction contre quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acae37c1-9fbe-4cc3-a630-e23295d1a2f0",
                                "sense_id": "87bcc731-3564-3608-9adf-989b6d3aaa95",
                                "text": "Il incombe donc aux soignants de l’institution de prendre en compte cette réalité clinique majeure, pour ne pas contreréagir à cette violence."
                            },
                            {
                                "example_id": "ace40651-bd1b-4cd4-a5f2-437b741be945",
                                "sense_id": "87bcc731-3564-3608-9adf-989b6d3aaa95",
                                "text": "Vérifie quand même avec le pharmacien, certains jus de fruit trop acide comme le jus d'ananas ou de pamplemousse contreréagissent avec certains médicaments."
                            },
                            {
                                "example_id": "6ab61318-a9e1-423a-8854-f33338d15cba",
                                "sense_id": "87bcc731-3564-3608-9adf-989b6d3aaa95",
                                "text": "Ensuite, Jacques Mali a contreréagi, et finalement, Ray a pris le contrôle."
                            }
                        ]
                    }
