{
    "word_family": [
        "matchbox",
        "matchmaker",
        "matchstick",
        "matchless",
        "mismatch",
        "rematch",
        "overmatch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "132e1ce6-f34c-3c39-a764-0dd5346d8e3e",
                    "sense_definition": "A small stick of wood or strip of cardboard with a chemical tip that produces fire when rubbed against a rough surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fire-starter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struck a <w>match</w> and lit his cigarette.",
                            "target_lang_translations": {
                                "ru": "Он чиркнул <w>спичкой</w> и прикурил сигарету."
                            }
                        },
                        {
                            "text": "Keep the box of <w>matches</w> away from children to prevent accidents.",
                            "target_lang_translations": {
                                "ru": "Держите коробок <w>спичек</w> подальше от детей во избежание несчастных случаев."
                            }
                        }
                    ],
                    "synonyms": [
                        "fuse",
                        "spunk"
                    ],
                    "common_phrases": [
                        "strike a match",
                        "box of matches"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая деревянная палочка или полоска картона с горючей головкой, которая воспламеняется при трении о шероховатую поверхность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спичка",
                                "target_lang_sense_clarification": "палочка для добывания огня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92698f76-2d66-310b-915d-47ad50d584ec",
                    "sense_definition": "A competitive sporting event or game between two people or teams.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My local team are playing in a <w>match</w> against their arch-rivals today.",
                            "target_lang_translations": {
                                "ru": "Моя местная команда сегодня играет в <w>матче</w> против своих главных соперников."
                            }
                        },
                        {
                            "text": "The tennis <w>match</w> lasted for over three hours in the heat.",
                            "target_lang_translations": {
                                "ru": "Теннисный <w>матч</w> на жаре длился более трех часов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "football match",
                        "tennis match",
                        "cricket match"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортивное соревнование или игра между двумя людьми или командами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матч",
                                "target_lang_sense_clarification": "спортивная игра"
                            },
                            {
                                "target_lang_word": "состязание",
                                "target_lang_sense_clarification": "соревнование на первенство"
                            },
                            {
                                "target_lang_word": "поединок",
                                "target_lang_sense_clarification": "встреча двух соперников"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "306628d5-97b8-341d-b835-1b12f4d5efd1",
                    "sense_definition": "A person or thing that is very similar to or goes well with another.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpet and curtains are a <w>match</w> in this room.",
                            "target_lang_translations": {
                                "ru": "Ковер и шторы в этой комнате — отличное <w>сочетание</w>."
                            }
                        },
                        {
                            "text": "They are a <w>match</w> made in heaven and seem very happy together.",
                            "target_lang_translations": {
                                "ru": "Они — <w>пара</w>, созданная на небесах, и кажутся очень счастливыми вместе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "perfect match",
                        "match made in heaven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, которые очень похожи на другие или хорошо с ними сочетаются."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пара",
                                "target_lang_sense_clarification": "подходящий по качествам человек или предмет"
                            },
                            {
                                "target_lang_word": "сочетание",
                                "target_lang_sense_clarification": "гармоничное единство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aebcf13-3ccf-39f2-a367-49a2110aaf91",
                    "sense_definition": "A person who is equal to another in ability, strength, or quality.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "equality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He knew he had finally met his <w>match</w> on the chessboard.",
                            "target_lang_translations": {
                                "ru": "Он понял, что наконец встретил <w>ровню</w> за шахматной доской."
                            }
                        },
                        {
                            "text": "Most adults are no <w>match</w> for him when it comes to video games.",
                            "target_lang_translations": {
                                "ru": "Большинство взрослых ему не <w>соперники</w>, когда дело касается видеоигр."
                            }
                        }
                    ],
                    "common_phrases": [
                        "meet your match",
                        "no match for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, равный другому по способностям, силе или качествам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ровня",
                                "target_lang_sense_clarification": "равный по положению или силе"
                            },
                            {
                                "target_lang_word": "достойный соперник",
                                "target_lang_sense_clarification": "равный по силе противник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8ad4075-fa90-3747-b9da-1464e28407de",
                    "sense_definition": "A person considered as a potential partner for marriage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was looked upon as the richest <w>match</w> of the West.",
                            "target_lang_translations": {
                                "ru": "Ее считали самой богатой <w>партией</w> Запада."
                            }
                        },
                        {
                            "text": "His parents were looking for a suitable <w>match</w> for their eldest son.",
                            "target_lang_translations": {
                                "ru": "Его родители искали подходящую <w>пару</w> для своего старшего сына."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good match",
                        "suitable match"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, рассматриваемый как потенциальный партнер для брака."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партия",
                                "target_lang_sense_clarification": "выгодный кандидат для брака"
                            },
                            {
                                "target_lang_word": "пара",
                                "target_lang_sense_clarification": "подходящий супруг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a20604a2-d216-38c6-b5c4-4f360029e523",
                    "sense_definition": "The act of marrying or a specific marriage arrangement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The families arranged a <w>match</w> to unite their business interests.",
                            "target_lang_translations": {
                                "ru": "Семьи устроили <w>брак</w>, чтобы объединить свои деловые интересы."
                            }
                        },
                        {
                            "text": "It was a <w>match</w> based on love rather than social status.",
                            "target_lang_translations": {
                                "ru": "Это был <w>союз</w>, основанный на любви, а не на социальном статусе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "arranged match"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт вступления в брак или конкретная договоренность о женитьбе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брак",
                                "target_lang_sense_clarification": "супружеский союз"
                            },
                            {
                                "target_lang_word": "союз",
                                "target_lang_sense_clarification": "объединение семей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "623b5e04-5387-31fa-8596-fbbd48732fbd",
                    "sense_definition": "To be the same as or very similar to something else in color, pattern, or quality.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His cummerbund <w>matched</w> the turban in gold lines.",
                            "target_lang_translations": {
                                "ru": "Его пояс <w>сочетался</w> с тюрбаном золотыми линиями."
                            }
                        },
                        {
                            "text": "I need to find a tie that <w>matches</w> my new blue shirt.",
                            "target_lang_translations": {
                                "ru": "Мне нужно найти галстук, который <w>подходит</w> к моей новой синей рубашке."
                            }
                        }
                    ],
                    "synonyms": [
                        "comport"
                    ],
                    "antonyms": [
                        "differ"
                    ],
                    "common_phrases": [
                        "match the color",
                        "perfectly match"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть таким же или очень похожим на что-то другое по цвету, узору или качеству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подходить",
                                "target_lang_sense_clarification": "гармонировать по цвету или стилю"
                            },
                            {
                                "target_lang_word": "сочетаться",
                                "target_lang_sense_clarification": "хорошо смотреться вместе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eba9fff9-fe44-3826-a1c3-59f65f569c44",
                    "sense_definition": "To correspond or be consistent with something else, such as data or interests.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their interests didn't <w>match</w>, so it took a long time to agree.",
                            "target_lang_translations": {
                                "ru": "Их интересы не <w>совпадали</w>, поэтому договориться удалось не сразу."
                            }
                        },
                        {
                            "text": "These two copies are supposed to be identical, but they don't <w>match</w>.",
                            "target_lang_translations": {
                                "ru": "Эти две копии должны быть идентичными, но они не <w>соответствуют</w> друг другу."
                            }
                        }
                    ],
                    "synonyms": [
                        "comport"
                    ],
                    "antonyms": [
                        "differ"
                    ],
                    "common_phrases": [
                        "match the description",
                        "match the data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствовать или быть последовательным по отношению к чему-то другому (данным, интересам)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "быть в соответствии с чем-либо"
                            },
                            {
                                "target_lang_word": "совпадать",
                                "target_lang_sense_clarification": "оказываться одинаковым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba4552f1-8d2e-3480-8407-38eebe880792",
                    "sense_definition": "To find things or people that go together or are suitable for each other.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pairing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They found out about his color-blindness when he couldn't <w>match</w> socks properly.",
                            "target_lang_translations": {
                                "ru": "О его дальтонизме узнали, когда он не смог правильно <w>подобрать</w> носки по парам."
                            }
                        },
                        {
                            "text": "The agency <w>matches</w> volunteers with local charities that need help.",
                            "target_lang_translations": {
                                "ru": "Агентство <w>подбирает</w> волонтеров для местных благотворительных организаций, нуждающихся в помощи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "match socks",
                        "match people"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находить вещи или людей, которые подходят друг другу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбирать",
                                "target_lang_sense_clarification": "находить подходящую пару"
                            },
                            {
                                "target_lang_word": "сопоставлять",
                                "target_lang_sense_clarification": "соотносить друг с другом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e6ccc51-0c4d-3922-9c55-7176dff9cb5c",
                    "sense_definition": "To be as good as or better than someone else in a particular activity or achievement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "equality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>matched</w> him at every turn: anything he could do, she could do as well.",
                            "target_lang_translations": {
                                "ru": "Она <w>сравнялась</w> с ним во всем: что бы он ни умел, она умела не хуже."
                            }
                        },
                        {
                            "text": "No one could <w>match</w> his performance on the opening night.",
                            "target_lang_translations": {
                                "ru": "Никто не смог <w>превзойти</w> его выступление в премьерный вечер."
                            }
                        }
                    ],
                    "common_phrases": [
                        "match the record",
                        "match the performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть не хуже или лучше кого-то другого в определенной деятельности или достижении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сравняться",
                                "target_lang_sense_clarification": "стать равным по достижениям"
                            },
                            {
                                "target_lang_word": "составить конкуренцию",
                                "target_lang_sense_clarification": "быть достойным соперником"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bdb6218-404c-3bc9-bf31-b9a25f3b3307",
                    "sense_definition": "To satisfy the conditions of a specific pattern, rule, or search criteria.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technical-match",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The behavior <w>matched</w> one or more rules and was rejected by the filter.",
                            "target_lang_translations": {
                                "ru": "Поведение <w>соответствовало</w> одному или нескольким правилам и было отклонено фильтром."
                            }
                        },
                        {
                            "text": "The search string did not <w>match</w> any files in the directory.",
                            "target_lang_translations": {
                                "ru": "Строка поиска не <w>совпала</w> ни с одним файлом в директории."
                            }
                        }
                    ],
                    "common_phrases": [
                        "match the pattern",
                        "match the criteria"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удовлетворять условиям определенного шаблона, правила или критерия поиска."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "отвечать критериям или правилам"
                            },
                            {
                                "target_lang_word": "совпадать",
                                "target_lang_sense_clarification": "полностью совмещаться с шаблоном"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}