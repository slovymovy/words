                                "target_senses": [
                                    {
                                        "sense_id": "db3afcec-3e4f-3f03-a69f-5bae445e7ee9",
                                        "entry_id": "88008684-cd7b-3833-8a00-474580065a0f",
                                        "glosses": [
                                            "eine Person über etwas informieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f502de01-b143-4473-8832-32117c6b62d2",
                                                "sense_id": "db3afcec-3e4f-3f03-a69f-5bae445e7ee9",
                                                "text": "Er teilte Peter mit, dass er in den Besprechungsraum kommen soll."
                                            },
                                            {
                                                "example_id": "23adea06-54f5-4ab3-983a-9b875b7892fa",
                                                "sense_id": "db3afcec-3e4f-3f03-a69f-5bae445e7ee9",
                                                "text": "„Außerdem hatte ich ihm in einem meiner Briefe mitgeteilt, dass ich das Chemiestudium zwar zu Ende führen würde, aber dann lieber Schriftsteller werden wolle.“"
                                            },
                                            {
                                                "example_id": "2e9a888c-90e6-4d99-af65-ea17f8beb8d9",
                                                "sense_id": "db3afcec-3e4f-3f03-a69f-5bae445e7ee9",
                                                "text": "„Die Täter rückten am Sonntag in den Morgenstunden mit einem Radlader an und durchbrachen damit die Außenwand einer Bankfiliale in Mellingen bei Weimar, wie die Polizei mitteilte.“"
                                            },
                                            {
                                                "example_id": "99ad935b-135a-4c5c-bca0-7cd921d4b562",
                                                "sense_id": "db3afcec-3e4f-3f03-a69f-5bae445e7ee9",
                                                "text": "„Der Klettersport erschließt mir die Möglichkeit, mich meiner Umwelt mitzuteilen und Kontakt herzustellen. Der Fels ist dabei mein Freund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
