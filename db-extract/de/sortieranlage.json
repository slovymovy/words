                                "target_senses": [
                                    {
                                        "sense_id": "e03de57d-4bd1-3354-a882-13c87518450a",
                                        "entry_id": "4024fedd-9c4e-354a-a398-dc05bb276bc1",
                                        "glosses": [
                                            "Plateforme centrale où convergent les objets postaux pour être triés rapidement, avant d’être acheminés vers leur destination finale."
                                        ],
                                        "tags": [
                                            "Poste"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ade44fc-2479-44bd-ae2b-168c57949f69",
                                                "sense_id": "e03de57d-4bd1-3354-a882-13c87518450a",
                                                "text": "Louis De Joy aura fait éliminer de nombreuses boîtes postales dans les États clés et réduit les équipes et les heures de travail dans les centres de tri."
                                            },
                                            {
                                                "example_id": "0e78cb43-7e06-44bb-954e-9c23cd8bc692",
                                                "sense_id": "e03de57d-4bd1-3354-a882-13c87518450a",
                                                "text": "Un intérimaire, travaillant au centre de tri de Moissy-Cramayel (Seine-et-Marne), a été démis de ses fonctions par La Poste, rapporte Le Parisien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968e9a1d-e69c-3223-a281-af28b759b4d7",
                                        "entry_id": "4024fedd-9c4e-354a-a398-dc05bb276bc1",
                                        "glosses": [
                                            "Plateforme où sont triés les déchets recyclables et non recyclables."
                                        ],
                                        "tags": [
                                            "Déchets"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c304238a-8b20-4f80-ba25-a998790c8667",
                                                "sense_id": "968e9a1d-e69c-3223-a281-af28b759b4d7",
                                                "text": "Les camions arrivent au centre de tri et sont pesés pour connaître la quantité de déchets réceptionnés."
                                            },
                                            {
                                                "example_id": "c17c885a-a8e2-4b42-986a-d2c8970bc67e",
                                                "sense_id": "968e9a1d-e69c-3223-a281-af28b759b4d7",
                                                "text": "Après avoir collecté les bacs bleus de leur secteur, les chauffeurs rentrent au centre de tri et passent sur le poste de pesée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
