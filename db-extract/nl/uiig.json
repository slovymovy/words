                ],
                "translations": [
                    {
                        "translation_id": "1794b14e-0d90-4791-a8b8-0c18720befb1",
                        "source_entry_id": "357b5eff-84f1-31e8-9ad0-a537b488cca8",
                        "source_sense_id": "e832396a-6233-356a-b701-5c645a75a2b6",
                        "source_sense_description": "grappig",
                        "target_lang_word": "amusing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amusing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d578877-ecef-3472-8b48-819b6b3d2de5",
                                        "entry_id": "0d01d279-10b7-3c8c-952a-10aa4dc07953",
                                        "glosses": [
                                            "present participle and gerund of amuse"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
