                        ],
                        "examples": [
                            {
                                "example_id": "08953370-c7c6-40bf-9ea6-8ab3fc882714",
                                "sense_id": "97d6c917-561f-3dc7-9460-200fdee640c9",
                                "text": "The heavily Botoxed, stylishly black-clad, elegantly blinged women who organized this evening may not want to imitate Bette's style, but they certainly love her sass."
                            },
                            {
                                "example_id": "0a8b100f-b68c-45c1-8f24-ca9cacda3d5d",
                                "sense_id": "97d6c917-561f-3dc7-9460-200fdee640c9",
                                "text": "His thirty year younger wife, Monica, has apparently graduated with a magna cum laude honors degree from an Ivy League, but obviously lost it somewhere down the line when she visited her plastic surgeon; double D silicones and Botoxed face!"
                            },
                            {
                                "example_id": "3cdb73fb-d717-4ccb-8d36-19aa60f3ab31",
                                "sense_id": "97d6c917-561f-3dc7-9460-200fdee640c9",
                                "text": "To be clear, I have no problem with anybody who Botoxes and fills."
                            },
                            {
                                "example_id": "d4e222f0-2b99-4dfb-bae4-a94f14e0a9c4",
                                "sense_id": "97d6c917-561f-3dc7-9460-200fdee640c9",
                                "text": "[…]I probably Botox twice a year."
                            }
                        ]
                    }
