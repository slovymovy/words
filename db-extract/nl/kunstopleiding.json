                        "examples": [
                            {
                                "example_id": "dcfbadae-ea14-43f1-bf94-2aa2b24a6476",
                                "sense_id": "e03d89f1-0a3e-352b-9799-14ad8f0cdbc3",
                                "text": "IJs was smetteloos wit en smolt dan tot bruin, of tot het sinistere zwart dat we leerden vrezen toen mijn vader op een decemberavond met de motor van de kunstopleiding naar huis reed, boven aan de steile Mound onderuitging en zijn rechterenkel verbrijzelde."
                            },
                            {
                                "example_id": "16c9a6c2-dc5b-417d-93d1-fd75dd232611",
                                "sense_id": "e03d89f1-0a3e-352b-9799-14ad8f0cdbc3",
                                "text": "Maar over wat hij nog meer heeft gezien voordat hij op zijn zestiende aan zijn kunstopleiding begon, tast ik in het duister."
                            },
                            {
                                "example_id": "722c2a5c-e83b-4205-b3a0-1b7b8405128f",
                                "sense_id": "e03d89f1-0a3e-352b-9799-14ad8f0cdbc3",
                                "text": "Daarnaast wordt met een campagne nieuw personeel geworven. Rikken: \"We hebben nieuwe groepen in onze cao opgenomen die bij de opvang kunnen werken, zoals laatstejaarsstudenten pedagogiek, pabo, hbo sociaal werk of mensen met een sport- en kunstopleiding.\""
                            }
                        ]
                    }
