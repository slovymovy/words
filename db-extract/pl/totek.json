                        "examples": [
                            {
                                "example_id": "4c555495-163b-4656-8ad5-d80412ad42a5",
                                "sense_id": "99933350-fc4f-3e7e-81f4-1a33543e2d90",
                                "text": "Groch się jakoś marnie łuska - wina Tuska, w Totku Ci nie wyszła szóstka - wina Tuska. Zaszkodziła Ci kapustka - wina Tuska. Cioci Zosi siadła trzustka - wina Tuska.",
                                "translation": "Nějak špatně se louská hrách - za to může [Donald] Tusk, v sazce ti nevyšla šestka - za to může Tusk. Udělalo se ti šoufl ze zelíčka - může za to Tusk. Hapruje slinivka tety Zosjy - Tuskova vina."
                            }
                        ]
                    }
