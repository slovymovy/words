                    },
                    {
                        "translation_id": "0e490cca-81f6-49b3-9cdd-04ae3add572c",
                        "source_entry_id": "3913d241-669d-3795-931e-17452961dd83",
                        "source_sense_description": "заполниться",
                        "target_lang_word": "inundate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inundate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f81f25c9-a91a-30a5-9ed7-24b39e5aa163",
                                        "entry_id": "bf68c756-726c-302d-9982-7fa3301e9583",
                                        "glosses": [
                                            "To cover with large amounts of water; to flood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c29f89-2873-4c01-9f75-41b1313285b4",
                                                "sense_id": "f81f25c9-a91a-30a5-9ed7-24b39e5aa163",
                                                "text": "The Dutch would sometimes inundate the land to hinder the Spanish army."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6637c90b-20c9-35f2-8cc7-2d6faf42a955",
                                        "entry_id": "bf68c756-726c-302d-9982-7fa3301e9583",
                                        "glosses": [
                                            "To overwhelm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d982d5c-bc39-4b31-b0d2-98170ae5d600",
                                                "sense_id": "6637c90b-20c9-35f2-8cc7-2d6faf42a955",
                                                "text": "The agency was inundated with phone calls."
                                            },
                                            {
                                                "example_id": "cb15a592-07b8-4456-b3df-c2159db33ca7",
                                                "sense_id": "6637c90b-20c9-35f2-8cc7-2d6faf42a955",
                                                "text": "I don't know any quarter in England where you get such undeniable mutton—mutton that eats like mutton, instead of the nasty watery, stringy, turnipy stuff, neither mutton nor lamb, that other countries are inundated with."
                                            },
                                            {
                                                "example_id": "0775774e-351f-4e1e-87ca-543f228685b6",
                                                "sense_id": "6637c90b-20c9-35f2-8cc7-2d6faf42a955",
                                                "text": "That books are pouring off the world’s presses at unprecedented rates is a fact often alluded to as a flood that is inundating libraries and the book trades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
