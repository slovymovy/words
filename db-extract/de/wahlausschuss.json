                "senses": [
                    {
                        "sense_id": "0596cd03-78a5-317e-b7c7-d9609bd3eebe",
                        "entry_id": "b0603145-0494-3320-9098-7a2b6eb739c7",
                        "glosses": [
                            "Ausschuss, der eine Wahl vorbereitet, durchführt und kontrolliert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15b99e03-fd2a-46dc-bfdb-bb6f308bd758",
                                "sense_id": "0596cd03-78a5-317e-b7c7-d9609bd3eebe",
                                "text": "Der Wahlausschuss des Bundestages besteht aus zwölf Abgeordneten."
                            },
                            {
                                "example_id": "3eea59f9-7c70-429c-bfb7-691f6c349dfb",
                                "sense_id": "0596cd03-78a5-317e-b7c7-d9609bd3eebe",
                                "text": "Die Parteien haben nun knapp eine Woche Zeit, dem Wahlausschuss ihre Kandidaten zu nennen."
                            },
                            {
                                "example_id": "28a964ee-c39d-4fc1-b89f-f56bcc2a61f2",
                                "sense_id": "0596cd03-78a5-317e-b7c7-d9609bd3eebe",
                                "text": "Der Wahlausschuss war zusammengetreten, nachdem vergangene Woche zweideutige Bilder der jungen Frau erschienen waren, die sie unter anderem als „Gekreuzigte“ auf dem Wasser treibend zeigten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
