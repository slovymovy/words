    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b217008c-43a6-3f5a-82d2-5faac631bc39",
                    "sense_definition": "A village located in a German-speaking region.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "settlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet little <w>dorf</w> was nestled deeply between two steep mountains.",
                            "target_lang_translations": {
                                "it": "Il tranquillo <w>paesino</w> era incastonato nel profondo tra due montagne scoscese."
                            }
                        },
                        {
                            "text": "They spent the entire summer living in a remote Austrian <w>dorf</w>.",
                            "target_lang_translations": {
                                "it": "Trascorsero l'intera estate vivendo in un remoto <w>villaggio</w> austriaco."
                            }
                        }
                    ],
                    "synonyms": [
                        "village",
                        "hamlet"
                    ],
                    "target_lang_definitions": {
                        "it": "Un villaggio o paesino situato in una regione di lingua tedesca."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "villaggio",
                                "target_lang_sense_clarification": "centro abitato rurale di lingua tedesca"
                            },
                            {
                                "target_lang_word": "paesino",
                                "target_lang_sense_clarification": "piccolo borgo o villaggio"
                            },
                            {
                                "target_lang_word": "borgo",
                                "target_lang_sense_clarification": "piccolo insediamento rurale montano o campestre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f2ba1a1-4cbb-3be6-87f9-3a9e0dc335c5",
                    "sense_definition": "A freak, foolish person, or social outcast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop acting like a complete <w>dorf</w> and listen to what I am saying.",
                            "target_lang_translations": {
                                "it": "Smettila di fare il perfetto <w>scemo</w> e ascolta quello che sto dicendo."
                            }
                        },
                        {
                            "text": "The school bullies called him a weird <w>dorf</w> because he wore mismatched shoes.",
                            "target_lang_translations": {
                                "it": "I bulli della scuola lo chiamavano uno strano <w>sfigato</w> perché portava scarpe spaiate."
                            }
                        }
                    ],
                    "synonyms": [
                        "freak",
                        "fool",
                        "misfit"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used as an insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Persona bizzarra, sciocca, stramba o emarginata socialmente (gergo offensivo)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scemo",
                                "target_lang_sense_clarification": "persona sciocca o ridicola"
                            },
                            {
                                "target_lang_word": "sfigato",
                                "target_lang_sense_clarification": "emarginato sociale, individuo imbranato"
                            },
                            {
                                "target_lang_word": "strambo",
                                "target_lang_sense_clarification": "persona bizzarra o stravagante"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a26d58ec-830f-383c-9df8-1ab450e76b9d",
                    "sense_definition": "A humorous or nonstandard representation of a <w>dwarf</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the silly fantasy story, the grumpy <w>dorf</w> carried an oversized wooden mallet.",
                            "target_lang_translations": {
                                "it": "Nella buffa storia fantasy, il burbero <w>nano</w> portava con sé un martello di legno gigante."
                            }
                        },
                        {
                            "text": "He chose to play as a stubborn <w>dorf</w> in the new roleplaying game.",
                            "target_lang_translations": {
                                "it": "Scelse di giocare nei panni di un caparbio <w>nano</w> nel nuovo gioco di ruolo."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwarf"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "humorous or nonstandard alteration of dwarf"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Forma umoristica, intenzionalmente errata o non standard per riferirsi a un nano (specie fantasy)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "nano",
                                "target_lang_sense_clarification": "creatura fantastica, reso in forma comica"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}