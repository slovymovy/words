                                    {
                                        "sense_id": "5e29ce83-56cf-30ba-b56a-d00189955e68",
                                        "entry_id": "de331a11-c904-3469-99ff-d719cbce2ba9",
                                        "glosses": [
                                            "dunner worden"
                                        ],
