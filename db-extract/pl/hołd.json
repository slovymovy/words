                ],
                "senses": [
                    {
                        "sense_id": "16ad355c-b174-3453-beae-c4a99078e08a",
                        "entry_id": "e45f163b-938f-3e27-9ecd-3df376ffb616",
                        "glosses": [
                            "wyraz czci, poważania, zachwytu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aa08d4f-14f2-4d61-a49f-4939e781c0b8",
                                "sense_id": "16ad355c-b174-3453-beae-c4a99078e08a",
                                "text": "Ja tylko przyszłam złożyć hołd kobiecie zbuntowanej przeciw tyranii przesądów…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e800c51a-d479-3755-95cb-c93cf1ff8356",
                        "entry_id": "e45f163b-938f-3e27-9ecd-3df376ffb616",
                        "glosses": [
                            "ceremonia uroczystego przekazania lenna przez seniora swojemu wasalowi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "901c2ec7-abd7-4f9e-a7e8-1bdb2a0822b0",
                                "sense_id": "e800c51a-d479-3755-95cb-c93cf1ff8356",
                                "text": "Zwycięską wojnę wiedzie z Moskalem, • Od Prus hołd lenny odbiera"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2767db7b-bfc6-4f5a-a942-41a8081805b2",
                        "source_entry_id": "e45f163b-938f-3e27-9ecd-3df376ffb616",
                        "source_sense_id": "16ad355c-b174-3453-beae-c4a99078e08a",
                        "target_lang_word": "obeisance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obeisance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fdec79a-c754-309b-ae1b-3d0bba8253e2",
                                        "entry_id": "07391505-c56c-3138-8872-7f820e9d9e20",
                                        "glosses": [
                                            "Demonstration of an obedient attitude, especially by bowing deeply; a deep bow which demonstrates such an attitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16f64986-fbe5-4960-8d18-8d10bd7c071c",
                                                "sense_id": "4fdec79a-c754-309b-ae1b-3d0bba8253e2",
                                                "text": "In there stepped a stately raven of the saintly days of yore; / Not the least obeisance made he; not a minute stopped or stayed he;"
                                            },
                                            {
                                                "example_id": "282692e9-85e3-493b-a815-0d9dcefc7f2f",
                                                "sense_id": "4fdec79a-c754-309b-ae1b-3d0bba8253e2",
                                                "text": "But looking upwards in the blaze of the moon I suddenly saw colossi sitting near, and towering up and blotting out the stars and filling the night with blackness; and at those idols’ feet I saw praying and making obeisance kings and the days that are and all times and all cities and all nations and all their gods."
                                            },
                                            {
                                                "example_id": "8ef9d522-c1b1-4534-afa9-a7e47f493fd9",
                                                "sense_id": "4fdec79a-c754-309b-ae1b-3d0bba8253e2",
                                                "text": "The situation in the case of actions which are non-linguistic but similar to performative utterances in that they are the performance of a conventional action (here ritual or ceremonial) is rather like this: suppose I bow deeply before you; it might not be clear whether I am doing obeisance to you or, say, stooping to observe the flora or to ease my indigestion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521f9b24-96fe-34c0-b06e-f1a2c83fbf61",
                                        "entry_id": "07391505-c56c-3138-8872-7f820e9d9e20",
                                        "glosses": [
                                            "An obedient attitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e515ef1a-4621-4cbe-9edb-e8769ca1b850",
                        "source_entry_id": "e45f163b-938f-3e27-9ecd-3df376ffb616",
                        "source_sense_id": "16ad355c-b174-3453-beae-c4a99078e08a",
                        "target_lang_word": "почтение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "почтение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "db14e3e8-1f0d-3ae9-9eb2-10649b581a5b",
                                        "entry_id": "1bf99706-f4ed-3d84-8854-06935e64c7d9",
                                        "glosses": [
                                            "действие по значению гл. почитать; уважение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63b9338a-5d91-43fd-8b75-e3e225d37e04",
                                                "sense_id": "db14e3e8-1f0d-3ae9-9eb2-10649b581a5b",
                                                "text": "Между равными, а особливо между вышними чинами была бы всегда дружба и согласие, от нижних к высшим пристойное почтение, от подчиненных к начальникам ― законное послушание."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
