                    ]
                },
                {
                    "sense_id": "8b64a54a-a946-382e-9a7f-b5ccb138d209",
                    "sense_definition": "Voile de secours carrée hissée en cas de gros temps ou d'avarie en mer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipage a gréé une <w>fortune</w> sur le mât avant pour naviguer au vent arrière."
                        },
                        {
                            "text": "Après la tempête qui a déchiré la grand-voile, le navire avançait sous sa seule <w>fortune</w>."
