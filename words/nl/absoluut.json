            "senses": [
                {
                    "sense_id": "707a793e-8d4d-321e-8c3c-0aca8bb3804e",
                    "sense_definition": "volledig en zonder enige beperking of uitzondering",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "volledigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er heerste een <w>absolute</w> stilte in de grote bibliotheek.",
                            "target_lang_translations": {
                                "en": "There was an <w>absolute</w> silence in the large library."
                            }
                        },
                        {
                            "text": "De aanwezige alcohol was <w>absoluut</w> helemaal verdampt na het koken.",
                            "target_lang_translations": {
                                "en": "The alcohol present had <w>absolutely</w> evaporated completely after cooking."
