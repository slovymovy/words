                "senses": [
                    {
                        "sense_id": "336caa17-1c9b-316b-b58e-aacbe9e409dd",
                        "entry_id": "9bdc4502-af36-3951-a402-371680949714",
                        "glosses": [
                            "Saft, der durch das Pressen von Apfelsinen hergestellt wird"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "ac83b1e3-961d-4843-a94a-796aa5b8d722",
                                "sense_id": "336caa17-1c9b-316b-b58e-aacbe9e409dd",
                                "text": "Zum Frühstück bieten wir neben warmen Getränken wie Kaffee oder Tee auch kalte Getränke (beispielsweise Mineralwasser oder Apfelsinensaft) an."
                            },
                            {
                                "example_id": "ee8867ef-68bf-43a6-acb6-a68084807d45",
                                "sense_id": "336caa17-1c9b-316b-b58e-aacbe9e409dd",
                                "text": "„Das gilt auch für Apfelsinensaft, dem heute oft aus Gründen der Farbe und des Geschmacks Mandarinensaft beigemischt wird, dann aber dennoch als „reiner Orangensaft“ verkauft wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
