{
    "word_family": [
        "hollow"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe1152e3-68a7-3f03-8b93-aefa485775c1",
                    "sense_definition": "To yell or shout loudly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>holler</w> at your friends when they are standing right next to you.",
                            "target_lang_translations": {
                                "cs": "Na své přátele <w>nekřič</w>, když stojí přímo vedle tebe.",
                                "ru": "Не надо <w>орать</w> на друзей, когда они стоят прямо рядом с тобой."
                            }
                        },
                        {
                            "text": "The angry man began to <w>holler</w> across the street to get someone's attention.",
                            "target_lang_translations": {
                                "cs": "Ten rozzlobený muž začal <w>křičet</w> přes ulici, aby na sebe upoutal pozornost.",
                                "ru": "Рассерженный мужчина стал <w>кричать</w> через улицу, чтобы привлечь к себе внимание."
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "scream",
                        "howl"
                    ],
                    "common_phrases": [
                        "holler at"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in American English, especially in Southern dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Křičet nebo hlasitě volat.",
                        "ru": "Кричать, орать или громко окликать кого-либо."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "křičet",
                                "target_lang_sense_clarification": "obecný výraz pro hlasitý projev"
                            },
                            {
                                "target_lang_word": "řvát",
                                "target_lang_sense_clarification": "hovorový, velmi hlasitý projev"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "издавать громкий крик или повышать голос"
                            },
                            {
                                "target_lang_word": "орать",
                                "target_lang_sense_clarification": "громко и грубо кричать (разговорное)"
                            },
                            {
                                "target_lang_word": "крикнуть",
                                "target_lang_sense_clarification": "громко позвать или воскликнуть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05892474-3596-3da2-8639-baf35ecfe6c3",
                    "sense_definition": "To complain or express dissatisfaction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "complain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to <w>holler</w> about the high prices at the grocery store every week.",
                            "target_lang_translations": {
                                "cs": "Každý týden si rád <w>stěžuje</w> na vysoké ceny v obchodě s potravinami.",
                                "ru": "Он каждую неделю любит <w>возмущаться</w> высокими ценами в продуктовом магазине."
                            }
                        },
                        {
                            "text": "There is no reason to <w>holler</w> about the rules when you already agreed to them.",
                            "target_lang_translations": {
                                "cs": "Není důvod <w>remcat</w> kvůli pravidlům, když jsi s nimi už souhlasil.",
                                "ru": "Нет причин <w>поднимать крик</w> из-за правил, если ты уже согласился с ними."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Stěžovat si nebo vyjadřovat nespokojenost.",
                        "ru": "Жаловаться, возмущаться или шумно выражать недовольство."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stěžovat si",
                                "target_lang_sense_clarification": "vyjadřovat nespokojenost"
                            },
                            {
                                "target_lang_word": "remcat",
                                "target_lang_sense_clarification": "hovorově si neustále stěžovat"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "жаловаться",
                                "target_lang_sense_clarification": "выражать недовольство"
                            },
                            {
                                "target_lang_word": "возмущаться",
                                "target_lang_sense_clarification": "проявлять громкое недовольство"
                            },
                            {
                                "target_lang_word": "поднимать крик",
                                "target_lang_sense_clarification": "шумно высказывать протест или претензии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70974770-486f-366d-a393-8225c94ef966",
                    "sense_definition": "A loud yell or shout.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard a loud <w>holler</w> coming from the backyard during the game.",
                            "target_lang_translations": {
                                "cs": "Během hry jsem ze dvora slyšel hlasitý <w>křik</w>.",
                                "ru": "Во время игры со двора послышался громкий <w>крик</w>."
                            }
                        },
                        {
                            "text": "The sudden <w>holler</w> startled everyone in the quiet library.",
                            "target_lang_translations": {
                                "cs": "Ten náhlý <w>výkřik</w> v tiché knihovně všechny vylekal.",
                                "ru": "Внезапный <w>выкрик</w> напугал всех в тихой библиотеке."
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "scream",
                        "cry"
                    ],
                    "common_phrases": [
                        "give a holler"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in American English, especially in Southern dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hlasitý výkřik nebo volání.",
                        "ru": "Громкий крик или возглас."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "křik",
                                "target_lang_sense_clarification": "hlasitý zvuk"
                            },
                            {
                                "target_lang_word": "výkřik",
                                "target_lang_sense_clarification": "náhlý hlasitý zvuk"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "громкий звук голоса"
                            },
                            {
                                "target_lang_word": "выкрик",
                                "target_lang_sense_clarification": "громкий возглас"
                            },
                            {
                                "target_lang_word": "вскрик",
                                "target_lang_sense_clarification": "внезапный короткий крик"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3f4127a-172d-33b1-add6-b2c36d35ac86",
                    "sense_definition": "A brief communication or signal to get someone's attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you need help with the project, just give me a <w>holler</w> later.",
                            "target_lang_translations": {
                                "cs": "Pokud budeš potřebovat s projektem pomoct, prostě se mi později <w>ozvi</w>.",
                                "ru": "Если тебе понадобится помощь с проектом, просто <w>дай мне знать</w> позже."
                            }
                        },
                        {
                            "text": "Give me a <w>holler</w> when you are ready to leave the office.",
                            "target_lang_translations": {
                                "cs": "<w>Dej mi vědět</w>, až budeš připraven odejít z kanceláře.",
                                "ru": "<w>Маякни мне</w>, когда будешь готов уходить из офиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a holler"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátké sdělení nebo signál k upoutání pozornosti.",
                        "ru": "Короткое обращение, звонок или весточка, чтобы привлечь внимание или дать знать о себе."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ozvat se",
                                "target_lang_sense_clarification": "dát o sobě vědět"
                            },
                            {
                                "target_lang_word": "dát vědět",
                                "target_lang_sense_clarification": "informovat někoho"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "оклик",
                                "target_lang_sense_clarification": "обращение с целью привлечь внимание"
                            },
                            {
                                "target_lang_word": "весточка",
                                "target_lang_sense_clarification": "короткое сообщение или сигнал (разговорное)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "091837d0-86d0-39df-bd08-ccefea6e2ccb",
                    "sense_definition": "A narrow valley between mountains, an alternative form of <w>hollow</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old cabin was hidden deep within the quiet <w>holler</w>.",
                            "target_lang_translations": {
                                "cs": "Stará chata byla skrytá hluboko v tichém <w>údolí</w>.",
                                "ru": "Старая хижина пряталась глубоко в тихой <w>лощине</w>."
                            }
                        },
                        {
                            "text": "They walked through the <w>holler</w> to reach the other side of the mountain.",
                            "target_lang_translations": {
                                "cs": "Prošli tím <w>údolím</w>, aby se dostali na druhou stranu hory.",
                                "ru": "Они пошли через <w>долину</w>, чтобы добраться до другой стороны горы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Appalachian dialect."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Úzké údolí mezi horami.",
                        "ru": "Узкая долина, лощина или овраг между холмами или горами (региональный вариант hollow)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "údolí",
                                "target_lang_sense_clarification": "nížina mezi horami"
                            },
                            {
                                "target_lang_word": "rokle",
                                "target_lang_sense_clarification": "úzké, hluboké údolí"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лощина",
                                "target_lang_sense_clarification": "небольшая долина с пологими склонами"
                            },
                            {
                                "target_lang_word": "долина",
                                "target_lang_sense_clarification": "узкая впадина между холмами"
                            },
                            {
                                "target_lang_word": "овраг",
                                "target_lang_sense_clarification": "крутая выемка или ложбина"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a437c81b-4e7f-35a4-9195-9bcd8e1644d4",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Holler</w> is the new teacher at our school.",
                            "target_lang_translations": {
                                "cs": "Pan <w>Holler</w> je nový učitel na naší škole.",
                                "ru": "Мистер <w>Холлер</w> — новый учитель в нашей школе."
                            }
                        },
                        {
                            "text": "The family name <w>Holler</w> has deep roots in this region.",
                            "target_lang_translations": {
                                "cs": "Rodinné jméno <w>Holler</w> má v tomto regionu hluboké kořeny.",
                                "ru": "Фамилия <w>Холлер</w> имеет глубокие корни в этом регионе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení.",
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Holler",
                                "target_lang_sense_clarification": "příjmení"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Холлер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}