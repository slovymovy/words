                "senses": [
                    {
                        "sense_id": "8691c26f-853c-3bac-89c1-2fb42d215c2b",
                        "entry_id": "d353443d-5a3a-338a-b2a4-039cc95b9424",
                        "glosses": [
                            "verletzte Stelle in einem (Haut-)Gewebe, in die etwas, zum Beispiel ein Geschoss/Projektil, eingedrungen (eingetreten) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c3d701-f8a0-430f-8db2-1830666108b3",
                                "sense_id": "8691c26f-853c-3bac-89c1-2fb42d215c2b",
                                "text": "„Eine Austrittswunde ist größer als eine Eintrittswunde und besitzt gezackte Ränder.“"
                            },
                            {
                                "example_id": "881b48a9-bbdc-4b6e-b022-4d1faf09a55e",
                                "sense_id": "8691c26f-853c-3bac-89c1-2fb42d215c2b",
                                "text": "„‚Er sah sie an und sah so etwas wie eine Eintrittswunde am Kopf.‘“"
                            },
                            {
                                "example_id": "6af2bdcb-d2c0-4358-b35b-64d68621dcef",
                                "sense_id": "8691c26f-853c-3bac-89c1-2fb42d215c2b",
                                "text": "„Kennzeichnend für den relativen Nahschuss sind Pulverschmauchablagerungen auf der Haut und der Kleidung um die Eintrittswunde herum.“"
                            },
                            {
                                "example_id": "a34e9c22-2e7e-4a4c-8fdd-f0dabaa9993f",
                                "sense_id": "8691c26f-853c-3bac-89c1-2fb42d215c2b",
                                "text": "„Sollte trotz einer Eintrittswunde […] keine Austrittswunde […] zu finden sein, ist eine klare Indikation zur chirurgischen Exploration gegeben.“"
                            },
                            {
                                "example_id": "440c27a8-e4bd-44e3-82c8-d00ba6516999",
                                "sense_id": "8691c26f-853c-3bac-89c1-2fb42d215c2b",
                                "text": "„‚Die Kugel stieg aufwärts, trat durch die Kehle des Präsidenten wieder hinaus und hinterließ eine kleine, enge Eintrittswunde.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
