            "senses": [
                {
                    "sense_id": "81eee058-87b9-39fe-a766-0c35ddb8b15f",
                    "sense_definition": "Genau abgemessene Menge eines Arzneimittels oder Wirkstoffs",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Medizin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Arzt hat die tägliche <w>Dosis</w> der Tabletten vorsichtig reduziert.",
                            "target_lang_translations": {
                                "en": "The doctor carefully reduced the daily <w>dose</w> of the tablets."
                            }
                        },
                        {
                            "text": "Eine zu hohe <w>Dosis</w> dieses Schmerzmittels kann gefährliche Nebenwirkungen verursachen.",
                            "target_lang_translations": {
                                "en": "Too high a <w>dose</w> of this painkiller can cause dangerous side effects."
                            }
                        }
                    ],
                    "common_phrases": [
                        "empfohlene Dosis",
                        "tägliche Dosis",
                        "hohe Dosis"
                    ],
                    "target_lang_definitions": {
                        "en": "A precisely measured quantity of a medicine or active ingredient."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dose",
                                "target_lang_sense_clarification": "medicine"
                            },
                            {
                                "target_lang_word": "dosage",
                                "target_lang_sense_clarification": "amount or regimen of medicine"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c583480d-e54e-3253-8b5b-79cd1b6e77dd",
                    "sense_definition": "Menge einer Droge, die bei einem einzelnen Konsumvorgang eingenommen wird",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "Drogen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Abhängige brauchte dringend die nächste <w>Dosis</w>, um die Schmerzen zu lindern.",
                            "target_lang_translations": {
                                "en": "The addict urgently needed the next <w>fix</w> to relieve the pain."
                            }
                        },
                        {
                            "text": "Eine verunreinigte <w>Dosis</w> Rauschgift führte bei mehreren Personen zu einer lebensgefährlichen Vergiftung.",
                            "target_lang_translations": {
                                "en": "A contaminated <w>dose</w> of narcotics led to life-threatening poisoning in several people."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tödliche Dosis",
                        "nächste Dosis"
                    ],
                    "target_lang_definitions": {
                        "en": "Amount of a drug taken during a single use."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dose",
                                "target_lang_sense_clarification": "drugs"
                            },
                            {
                                "target_lang_word": "hit",
                                "target_lang_sense_clarification": "slang, single dose of a drug"
                            },
                            {
                                "target_lang_word": "fix",
                                "target_lang_sense_clarification": "slang, dose taken to relieve withdrawal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2afa9d0-6128-3301-af3e-dc7918591aa2",
                    "sense_definition": "Bestimmte Menge an ionisierender Strahlung, die von einem Körper aufgenommen wird",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "Physik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim Röntgen ist der Patient nur einer sehr geringen <w>Dosis</w> ausgesetzt.",
                            "target_lang_translations": {
                                "en": "During an X-ray, the patient is exposed to only a very low <w>dose</w>."
                            }
                        },
                        {
                            "text": "Die Arbeiter müssen regelmäßig messen, welche <w>Dosis</w> an Strahlung sie aufgenommen haben.",
                            "target_lang_translations": {
                                "en": "The workers must regularly measure what <w>dose</w> of radiation they have absorbed."
                            }
                        }
                    ],
                    "synonyms": [
                        "Bestrahlungsdosis",
                        "Strahlendosis"
                    ],
                    "common_phrases": [
                        "geringe Dosis",
                        "gefährliche Dosis"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific amount of ionizing radiation absorbed by a body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dose",
                                "target_lang_sense_clarification": "radiation"
                            },
                            {
                                "target_lang_word": "radiation dose",
                                "target_lang_sense_clarification": "amount of ionizing radiation"
                            }
                        ]
                    }
                }
            ]
        }
