                        "cross_references": []
                    },
                    {
                        "translation_id": "216f9ba3-c588-4405-b8d3-ccba427860e8",
                        "source_entry_id": "e6f3c441-d9b0-3d9b-94cf-20eece939474",
                        "source_sense_id": "e6a6b8d0-3490-38e5-a4c2-e7db49d32a57",
                        "target_lang_word": "au hasard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au hasard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                        "entry_id": "a5752be6-fdc9-34de-914a-af9aad6222eb",
                                        "glosses": [
                                            "À l’aventure, inconsidérément, ou en faisant confiance au hasard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7148b69d-7408-4c7c-968d-5ecc50876713",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "Henri posa son porte-plume sur la table et ses regards errèrent au hasard."
                                            },
                                            {
                                                "example_id": "0bbe132b-cb37-41d7-bb9b-214bd639cead",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "– Le hasard ne fait rien au hasard, ajouta Robert. J’ai entendu cela un jour dans un film et cette phrase ne m’a pas quitté. Je devais en couver l’idée. Cet inconnu qui parlait l’a mise au monde. Finalement le hasard et le moins trompeur des dieux.."
                                            },
                                            {
                                                "example_id": "8f3686b3-407f-4afa-9b01-6437dc7fc7ec",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "Ne connaissant pas la route, ils étaient obligés d’aller, de marcher au hasard."
                                            },
                                            {
                                                "example_id": "c6b647c6-8928-47c5-baff-cad45202dece",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "Il ne sait pas jouer, il jette ses cartes au hasard."
                                            },
                                            {
                                                "example_id": "c2a34541-474b-46a8-ade1-442fedb48443",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "Répondre au hasard."
                                            },
                                            {
                                                "example_id": "5824e4c2-4e45-4a2a-ab5c-9bca6a4c158e",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "C’est un écervelé qui parle toujours au hasard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5346bda3-5ad5-4eba-9446-671431755de8",
                        "source_entry_id": "e6f3c441-d9b0-3d9b-94cf-20eece939474",
                        "source_sense_id": "e6a6b8d0-3490-38e5-a4c2-e7db49d32a57",
                        "target_lang_word": "sans réfléchir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "db62de24-2fcc-43ad-8879-f0f6b137de27",
                        "source_entry_id": "e6f3c441-d9b0-3d9b-94cf-20eece939474",
                        "source_sense_id": "e6a6b8d0-3490-38e5-a4c2-e7db49d32a57",
                        "target_lang_word": "au petit bonheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au petit bonheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                        "entry_id": "571a8d15-8719-3d9d-a068-255a02cf3444",
                                        "glosses": [
                                            "En faisant confiance au hasard, au sort, sans préparation ni réflexion préalable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c8b52cc-50b1-49d8-bd96-23b3433d5ec6",
                                                "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                                "text": "La fille à tout le monde a bon cœur,\nElle me donne, au petit bonheur,\nLes petits bouts de sa peau, bien cachés,\nQue les autres n’ont pas touchés."
                                            },
                                            {
                                                "example_id": "94a924ce-8bd0-4a86-b993-de9878626e15",
                                                "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                                "text": "Sur le palier qui empestait la poudre et les gravats, les bastos avaient ricoché au petit bonheur."
                                            },
                                            {
                                                "example_id": "bf19c034-2b7a-4b45-bd4b-28bc3396935f",
                                                "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                                "text": "Ces hommes-là se comportaient comme des individus chargés d’une électricité mystérieuse, extérieure, et qui la dépensaient au petit bonheur, ou plus exactement au petit malheur."
                                            },
                                            {
                                                "example_id": "2c285e8f-f4b7-4b75-a6ee-0a0ba44943f7",
                                                "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                                "text": "Au départ, vous aviez cinq voix, Coignet cinq, et les autres suffrages se répartissaient au petit bonheur sur vos concurrents."
                                            },
                                            {
                                                "example_id": "78c61f77-1716-4e71-ac90-d91844532172",
                                                "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                                "text": "Car la réalité est un piètre conteur. Elle entame ses récits au petit bonheur, en général bien avant le début de l’action, marche à l’aventure et décroche avant d’avoir dénoué les fils de l’intrigue…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
