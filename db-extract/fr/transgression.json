                        "target_lang_word": "Übertretung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e5c84be6-c914-4bb7-b571-d6f188595aaf",
                        "source_entry_id": "040e9029-1f07-38a7-8827-c0b3d67dddaa",
                        "source_sense_id": "655717e6-aac7-3673-9cd8-945de5d1c6e6",
                        "source_sense_description": "Action de transgresser",
                        "target_lang_word": "Verletzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verletzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                        "entry_id": "2a5a2490-5b86-385a-8cfe-f39ab89b127a",
                                        "glosses": [
                                            "eine Beschädigung von Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91166979-0281-4914-acc6-3ea838d69718",
                                                "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                                "text": "„Bei den von mir untersuchten Wagnissportarten Bergsteigen, Fallschirmspringen, Gleitschirm-, Drachen-, Segelfliegen und Bungeespringen wird – gemessen an der Anzahl der Einzelaktionen, der Betätigungsdauer und der Schwere der Verletzungen – ein Gefährdungslevel unterschritten, der in anderen gesellschaftlichen Bereichen (z.B. dem Straßenverkehr) und in Volkssportarten (Fußball, Abfahrtski) allgemein toleriert wird.“"
                                            },
                                            {
                                                "example_id": "43baee43-193d-45a1-b6b7-5bde7cfec572",
                                                "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                                "text": "Ich habe mir gestern eine Verletzung der Milz zugezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                        "entry_id": "2a5a2490-5b86-385a-8cfe-f39ab89b127a",
                                        "glosses": [
                                            "das Übertreten eines Gebotes, einer Grenze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e952727-0649-45db-914d-094ff0f1efb3",
                                                "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                                "text": "Es war eine schwere Verletzung der Aufsichtspflicht."
                                            },
                                            {
                                                "example_id": "b0c6ccb7-14cc-48a6-9b19-d9a5ae287a67",
                                                "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                                "text": "„Wir glauben kaum nötig zu haben, unsern Lesern die Tatsache zu bestätigen, die der Squire soeben erzählte und die, wie wir wissen, genau dahin ging, daß der berühmte Sieger wirklich zu dieser Geldstrafe wegen Verletzung der Habeascorpusakte während seines Oberbefehls verurteilt wurde: eine Strafe, der er sich auch willig unterzog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c94e215-fa29-4808-bff1-8423ba9c23f3",
                        "source_entry_id": "040e9029-1f07-38a7-8827-c0b3d67dddaa",
                        "source_sense_id": "655717e6-aac7-3673-9cd8-945de5d1c6e6",
                        "source_sense_description": "Action de transgresser",
                        "target_lang_word": "Verstoß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verstoß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0fc5d5b-2ee1-3688-bb1a-40ddb6c1d3ab",
                                        "entry_id": "fe8bfada-0c73-372b-bf01-c7cc0fe84b26",
                                        "glosses": [
                                            "Nichteinhaltung, Übertretung eines Gesetzes, einer Norm oder Abmachung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddef4939-ff12-492d-b970-d75b8620471c",
                                                "sense_id": "f0fc5d5b-2ee1-3688-bb1a-40ddb6c1d3ab",
                                                "text": "Der Verstoß gegen die Geschwindigkeitsbeschränkung kostete eine Menge Geld und drei Punkte."
                                            },
                                            {
                                                "example_id": "ed396e82-60a8-4653-9af4-f84007cc7a14",
                                                "sense_id": "f0fc5d5b-2ee1-3688-bb1a-40ddb6c1d3ab",
                                                "text": "„H. musste wegen vorsätzlichen Verstoßes gegen seine ärztlichen Berufspflichten 12000 Euro Buße zahlen.“"
                                            },
                                            {
                                                "example_id": "516c277f-3768-449f-8a4e-58ecc2547e91",
                                                "sense_id": "f0fc5d5b-2ee1-3688-bb1a-40ddb6c1d3ab",
                                                "text": "„Während sich die Wirkung eigentlicher Sprachlehre, hauptsächlich also Rechtschreibung und Grammatik, in der korrekten Beherrschung und Anwendung orthographischer und grammatischer Regeln überprüfbar äußert, vor allem auch darin, daß Verstöße gegen sie klar als »Fehler« identifiziert werden, läßt sich eine entsprechende Wirkung von Sprachkritik und Stillehre nicht strikt nachweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
