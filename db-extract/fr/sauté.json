            {
                "entry_id": "6161f1b7-2321-3c0a-b8c2-a8d2647dbced",
                "word": "sauté",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "07a7e8f4-bef5-3fb6-952c-fe7f3e5e9162",
                        "entry_id": "6161f1b7-2321-3c0a-b8c2-a8d2647dbced",
                        "glosses": [
                            "Plat consistant en morceaux (de viande, etc.) cuisinés à la poêle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0515e8d4-9b35-4454-b0e1-13deda883953",
                                "sense_id": "07a7e8f4-bef5-3fb6-952c-fe7f3e5e9162",
                                "text": "Pourquoi ce nom ? Parce qu'en hiver, l'on y sert des petits plats mijotés façon grand-mère et servis... en cocotte, tels le sauté de veau, le bœuf bourguignon, le coq au vin."
                            }
                        ]
                    },
                    {
                        "sense_id": "de7ec188-71cc-3ecb-816c-713292ea0445",
                        "entry_id": "6161f1b7-2321-3c0a-b8c2-a8d2647dbced",
                        "glosses": [
                            "Personne qui a perdu le sens des réalités."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "9b6ad8a4-4130-49de-a580-f686c44b6c9c",
                                "sense_id": "de7ec188-71cc-3ecb-816c-713292ea0445",
                                "text": "Le type est un honnête travailleur de la Mauricie, ni un sauté ni un illuminé. Mais il reconnaît avoir passé quelques années de sa vie obnubilé par les théories complotistes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
