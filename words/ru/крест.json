                                "target_lang_word": "Kreuz",
                                "target_lang_sense_clarification": "Orden oder staatliche Auszeichnung in Kreuzform"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3029dbff-442b-3317-9899-d27de3200b97",
