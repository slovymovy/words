                "senses": [
                    {
                        "sense_id": "aa5d0172-3bbd-334f-baed-de615aec283f",
                        "entry_id": "5d8beefc-06a6-319d-b10b-a4ccecc5a6e2",
                        "glosses": [
                            "Solarkraftwerk, das die Wärme der Sonne verwendet um ein Wärmeübertragungsmedium zu erhitzen und in Folge damit elektrischen Strom zu erzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c1bdd85-1e65-4d26-9e00-068d22b1dd9c",
                                "sense_id": "aa5d0172-3bbd-334f-baed-de615aec283f",
                                "text": "„In der Wüste Kaliforniens geht \"Ivanpah\" an den Start. Das größte Sonnenwärmekraftwerk der Welt wird 140 000 Haushalte mit Strom versorgen.“"
                            },
                            {
                                "example_id": "c66b3c9c-a497-42af-9a8f-9f9df0decf6c",
                                "sense_id": "aa5d0172-3bbd-334f-baed-de615aec283f",
                                "text": "„Sonnenwärmekraftwerke nutzen hunderte Spiegel, um Sonnenlicht auf einen zentralen Mast zu fokussieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
