                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e647ab6-ff91-49b2-9920-9ca5e8d6f76f",
                                "sense_id": "9ed04497-d143-3516-b281-47267a71f1f1",
                                "text": "Die Lebensmittelhandel der Landwirte findet jeden Dienstag am Marktplatz des Dorfes statt."
