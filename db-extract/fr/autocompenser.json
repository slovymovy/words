                ],
                "senses": [
                    {
                        "sense_id": "048dda2b-f25b-3df1-a168-35cf36ef5025",
                        "entry_id": "f50394fe-d35a-39bd-8d06-7ff5cda851f7",
                        "glosses": [
                            "Compenser par soi-même, sans avoir besoin d’une compensation extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "264ea799-b711-43ca-ba9a-696b742bc292",
                                "sense_id": "048dda2b-f25b-3df1-a168-35cf36ef5025",
                                "text": "Un tel amplificateur peut autocompenser des dégradations d’images (distorsions non linéaires, erreurs multiplicatives, aberrations des lentilles)."
                            },
                            {
                                "example_id": "adaf82b1-c725-4b4f-8ef8-75bac12ce45a",
                                "sense_id": "048dda2b-f25b-3df1-a168-35cf36ef5025",
                                "text": "Et ces parties bleues moins productives enverront moins de carbone vers les profondeurs, l’ensemble des océans formant un système qui s’autocompense."
                            }
                        ]
                    }
