    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e5a1871e-4fa6-3edf-8946-772c5733d42b",
                "word": "eugenicist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "40a222d9-e66f-4364-9b33-668fef2a351e",
                        "entry_id": "e5a1871e-4fa6-3edf-8946-772c5733d42b",
                        "tags": [
                            "plural"
                        ],
                        "form": "eugenicists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8458b96-c6b1-3c83-b657-492b79ea9079",
                        "entry_id": "e5a1871e-4fa6-3edf-8946-772c5733d42b",
                        "glosses": [
                            "A believer in, advocate of, or specialist regarding the principles of eugenics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a39dcfc9-d7f1-4fd4-80e4-2c9933e568ee",
                                "sense_id": "c8458b96-c6b1-3c83-b657-492b79ea9079",
                                "text": "I like Scandinavians, skiing, swimming and socialists who realize it is our business to promote social progress by peaceful methods. I dislike football, economists, eugenicists, Fascists, Stalinists, and Scottish conservatives."
                            },
                            {
                                "example_id": "feee207c-0605-43cc-baf5-5d39434af2fb",
                                "sense_id": "c8458b96-c6b1-3c83-b657-492b79ea9079",
                                "text": "“What makes a eugenicist is this overwhelming faith that everything in human nature is determined by your genes,” he says."
                            },
                            {
                                "example_id": "c04165e0-300f-487b-a7ce-a93e58b3e927",
                                "sense_id": "c8458b96-c6b1-3c83-b657-492b79ea9079",
                                "text": "Wading through history, he noted that some eugenicists believed that the “distinction between the fit and the unfit could be drawn along racial lines,” and others would define a person as “feeble-minded.”"
                            },
                            {
                                "example_id": "65db5d0c-8d06-4fc4-8a8e-ff8d27a22205",
                                "sense_id": "c8458b96-c6b1-3c83-b657-492b79ea9079",
                                "text": "This won't be easy. The pronatalists combine conservative social nudges (get married, start a family) with liberal policy objectives (give parents more money, upzone the suburbs), which makes for tricky politics. At a time of increased abortion restrictions, many liberals find them creepy—busybodies at best and eugenicists at worst."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "532f699c-956a-4dd7-add1-5dc85593ae81",
                        "source_entry_id": "e5a1871e-4fa6-3edf-8946-772c5733d42b",
                        "source_sense_id": "c8458b96-c6b1-3c83-b657-492b79ea9079",
                        "source_sense_description": "an advocate of or specialist in eugenics",
                        "target_lang_word": "Eugeniker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eugeniker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3334f36-2764-3c5c-946c-b767d42076f3",
                                        "entry_id": "bfd075cc-a9f9-3143-9a60-b93831078f9f",
                                        "glosses": [
                                            "Vertreter der Eugenik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bebc59b8-4edb-4f1c-93ee-cf2bf5cfba6a",
                                                "sense_id": "a3334f36-2764-3c5c-946c-b767d42076f3",
                                                "text": "„Es gab politisch links stehende Eugeniker, und das eugenische Gedankengut war auch in der bürgerlichen Frauenbewegung populär.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
