                                        "glosses": [
                                            "Action de griller ou de torréfier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c758019-e61e-4a9d-a65f-d87e43d8257c",
                                                "sense_id": "2f21e8a5-368e-3cf6-b4f0-7dfa71889fe0",
                                                "text": "Ces fragments, qui portent le nom de cossettes, sont torréfiés dans de grands brûloirs à café, […]. On ajoute quelquefois, après le grillage, un peu de beurre pour lustrer les cossettes et leur donner l'aspect du café brûlé."
                                            }
                                        ]
                                    },
