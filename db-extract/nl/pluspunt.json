                                                "sense_id": "eb0fc908-63ca-3d71-9125-7c9d158c7fab",
                                                "text": "„Natürlich sammeln die Eichsfelder fleißig Pluspunkte auf dem Weg zur ewigen Erlösung.“"
                                            },
                                            {
                                                "example_id": "b13b446f-f70c-47fc-8381-fa4c8cfcf3c1",
                                                "sense_id": "eb0fc908-63ca-3d71-9125-7c9d158c7fab",
                                                "text": "„Der einzige Pluspunkt an mir war meine Größe, allerdings wirkte ich schlaksig und ungelenk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
