                                        "sense_id": "a4e66721-3809-3059-9645-e2a9595a9a77",
                                        "entry_id": "0c512958-2f17-3643-b0aa-6c88193fd831",
                                        "glosses": [
                                            "разг. подчёркивает высокую степень, величину чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17f942da-20d8-476e-b79a-b261b277308d",
                                                "sense_id": "a4e66721-3809-3059-9645-e2a9595a9a77",
                                                "text": "Не смотрите, он таким общипанным кажет: он это так, для виду… у него деньги-то и-и!"
                                            },
                                            {
                                                "example_id": "147d088b-f11e-418c-9c88-62702348ba9d",
                                                "sense_id": "a4e66721-3809-3059-9645-e2a9595a9a77",
                                                "text": "― У́чится-то он хорошо? — И-и, как у́чится! первый ученик-с!"
                                            }
                                        ]
                                    }
                                ]
