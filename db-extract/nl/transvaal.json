                    },
                    {
                        "sense_id": "50974984-cd30-35b0-a1bb-247ae052ddba",
                        "entry_id": "19246dda-48df-3bcd-9d74-ab9107583e7d",
                        "glosses": [
                            "voormalige onafhankelijk land in Zuidelijk Afrika van 1852 tot 1902 dat geregeerd werd door Boeren"
                        ],
                        "tags": [],
