                },
                {
                    "sense_id": "34f6776b-d52d-34d4-9185-6b791829efc1",
                    "sense_definition": "vrouwelijke eigenaar of verzorgster van een huisdier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eigenaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De trouwe hond liep vrolijk achter zijn <w>bazin</w> aan.",
                            "target_lang_translations": {
                                "en": "The loyal dog happily followed behind his <w>owner</w>.",
                                "ru": "Верная собака весело бежала за своей <w>хозяйкой</w>."
                            }
                        },
                        {
                            "text": "Toen de bel ging, rende de kat direct naar zijn <w>bazin</w> toe.",
                            "target_lang_translations": {
                                "en": "When the doorbell rang, the cat ran straight to its <w>owner</w>.",
                                "ru": "Когда раздался звонок, кот сразу же подбежал к своей <w>хозяйке</w>."
                            }
                        }
                    ],
