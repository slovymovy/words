                    },
                    {
                        "translation_id": "8b4f347b-2691-4422-848b-8b8dc0a59584",
                        "source_entry_id": "56831c98-4ba4-38e6-8a6c-155b52951cfa",
                        "source_sense_id": "b492a75a-610d-3fe9-a803-ff8768404554",
                        "target_lang_word": "stunning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stunning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3c53ff-56ec-33e2-a7fc-5d8b1f081328",
                                        "entry_id": "a21658f1-319d-33fc-bae1-943a8805ccf6",
                                        "glosses": [
                                            "Having an effect that stuns."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e283ef83-f310-4d98-94de-aa97a9a1b3e8",
                                                "sense_id": "7e3c53ff-56ec-33e2-a7fc-5d8b1f081328",
                                                "text": "The stunning jolt from the taser gun made the criminal stop fleeing."
                                            },
                                            {
                                                "example_id": "def00f8a-ed4d-4b85-9d3d-18cb84458f88",
                                                "sense_id": "7e3c53ff-56ec-33e2-a7fc-5d8b1f081328",
                                                "text": "At length a univerſal hubbub wild,\nOf ſtunning ſounds and voices all confus'd,\nBorne through the hollow dark, aſſaults his ear"
                                            },
                                            {
                                                "example_id": "b868fd52-d5b0-4343-b376-7fa7742a1e93",
                                                "sense_id": "7e3c53ff-56ec-33e2-a7fc-5d8b1f081328",
                                                "text": "The ſtunning ſtroke his ſtubborn nerves unbound;"
                                            },
                                            {
                                                "example_id": "f1f9101a-4c67-4670-86a0-2f9770741de2",
                                                "sense_id": "7e3c53ff-56ec-33e2-a7fc-5d8b1f081328",
                                                "text": "[W]e put off our burdens, and sat down rather dispirited, amidst a stunning noise made by the chirping of myriads of grasshoppers, and an abominable little creature that made a constant croaking \"Caw, caw,\" producing a concert far from harmonious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b5a35d6-6f80-3c2a-a18a-e3a14f88eca1",
                                        "entry_id": "a21658f1-319d-33fc-bae1-943a8805ccf6",
                                        "glosses": [
                                            "Exceptionally beautiful or attractive."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3d00ab9-8ab5-432f-bf61-0a2a35ecb90b",
                                                "sense_id": "9b5a35d6-6f80-3c2a-a18a-e3a14f88eca1",
                                                "text": "That woman is stunning!"
                                            },
                                            {
                                                "example_id": "504a8daa-a569-4f41-bc02-f70decbfc050",
                                                "sense_id": "9b5a35d6-6f80-3c2a-a18a-e3a14f88eca1",
                                                "text": "What if the very things you like in me now—you'd hate sometime. What if the things I think are strong and stunning in you now, I'd think were pig-headed and kickable after a while?"
                                            },
                                            {
                                                "example_id": "8cde07fd-477b-47e4-9adf-a7bfb217f275",
                                                "sense_id": "9b5a35d6-6f80-3c2a-a18a-e3a14f88eca1",
                                                "text": "The line along the Northumbrian coast to Berwick and into Scotland is stunning (even on a Voyager!), and the weather is perfect - just sit back, relax, and enjoy the motion picture that plays beyond the window."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6f789b6-24fb-3012-8e39-8bac0024f6ba",
                                        "entry_id": "a21658f1-319d-33fc-bae1-943a8805ccf6",
                                        "glosses": [
                                            "Amazing; wonderfully good."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76da0c38-0686-44dd-9585-be8a813c9fd1",
                                                "sense_id": "b6f789b6-24fb-3012-8e39-8bac0024f6ba",
                                                "text": "The film was stunning."
                                            },
                                            {
                                                "example_id": "6d99454a-2d37-4819-a4c7-90abd860c065",
                                                "sense_id": "b6f789b6-24fb-3012-8e39-8bac0024f6ba",
                                                "text": "So it was against the run of play that their London rivals took the lead two minutes before the interval through Drogba. He rolled William Gallas inside the area before flashing a stunning finish high past keeper Carlo Cudicini."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
