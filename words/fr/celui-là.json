    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "3672a437-d03b-3bf3-9c42-3dd58d3eb469",
                    "sense_definition": "Désigne une personne ou une chose plus éloignée dans l'espace, le temps ou la pensée, par opposition à ce qui est proche.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "demonstratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne prends pas ce manteau bleu, choisis plutôt <w>celui-là</w>."
                        },
                        {
                            "text": "Regarde ces deux tableaux : je préfère nettement <w>celui-là</w>."
                        }
                    ],
                    "antonyms": [
                        "celui-ci"
                    ],
                    "common_phrases": [
                        "comme celui-là"
                    ]
                },
                {
                    "sense_id": "30ef8542-0c58-3f57-973e-78e2f854a0f1",
                    "sense_definition": "Désigne la première personne ou la première chose mentionnée parmi deux, par opposition à la seconde.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "demonstratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Entre Corneille et Racine, j'admire <w>celui-là</w> pour sa grandeur et celui-ci pour sa sensibilité."
                        },
                        {
                            "text": "L'argent et le bonheur sont recherchés, mais <w>celui-là</w> ne garantit nullement celui-ci."
                        }
                    ],
                    "synonyms": [
                        "ce premier"
                    ],
                    "antonyms": [
                        "celui-ci"
                    ]
                }
            ]
        }
    ]
