    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e1f384fe-3a76-3338-bded-0efb89ac9daa",
                "word": "dawnlight",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1f3f1ad3-e92f-36bf-959b-87af8bcf3837",
                        "entry_id": "e1f384fe-3a76-3338-bded-0efb89ac9daa",
                        "glosses": [
                            "The light of dawn."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e64d3d51-03ef-4690-a96e-99a0d6ec8771",
                                "sense_id": "1f3f1ad3-e92f-36bf-959b-87af8bcf3837",
                                "text": "It came from the southeast, a distant hissing, a sandwhisper. Presently he saw the faraway outline of the creature’s track against the dawnlight and realized he had never before seen a maker this large, never heard of one this size. It appeared to be more than half a league long, and the rise of the sandwave at its cresting head was like the approach of a mountain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b88e710-3da2-406c-b5f3-a25ed3f8671e",
                        "source_entry_id": "e1f384fe-3a76-3338-bded-0efb89ac9daa",
                        "source_sense_id": "1f3f1ad3-e92f-36bf-959b-87af8bcf3837",
                        "source_sense_description": "light of dawn",
                        "target_lang_word": "Dämmerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dämmerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                        "entry_id": "72d46aaf-fa49-3def-b210-bec63b91552d",
                                        "glosses": [
                                            "ein Lichtphänomen aufgrund des Sonnenlichts; der Übergang zwischen Tag und Nacht (unmittelbar nach Sonnenuntergang) oder umgekehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2279a9-19aa-49f6-9a53-53e00ad51936",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "Als sie aus dem Haus ging, war die Dämmerung bereits hereingebrochen."
                                            },
                                            {
                                                "example_id": "1d5fcf22-7207-43b0-9ecd-3a21ae1911d9",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Die Dämmerung kroch langsam über den Berg.“"
                                            },
                                            {
                                                "example_id": "31455010-9fd1-4c8a-ac4b-c05c12d4900f",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Die Dämmerung schlich in die Grabenwinkel.“"
                                            },
                                            {
                                                "example_id": "69d9e3f1-dc91-43fb-a0d8-21eaa20e2c54",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Die Dämmerung setzt ein, der Abendhimmel wird milchig.“"
                                            },
                                            {
                                                "example_id": "2e0595c4-063c-47ed-a453-4fd6768f0fa6",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Frieda, durch ihre Märsche nach Glowitz ermutigt, hat in der Dämmerung die Schwester heimlich besucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83211d25-fca9-4fb0-8434-c00a0a1fa812",
                        "source_entry_id": "e1f384fe-3a76-3338-bded-0efb89ac9daa",
                        "source_sense_id": "1f3f1ad3-e92f-36bf-959b-87af8bcf3837",
                        "source_sense_description": "light of dawn",
                        "target_lang_word": "Morgendämmerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morgendämmerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d258d9f8-97c4-3d12-9efc-a0d7f0ad2254",
                                        "entry_id": "0a4bec8b-b856-37b9-9ad6-d6b5442615af",
                                        "glosses": [
                                            "der Übergang zwischen Nacht und Tag (die Zeit vor Sonnenaufgang)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd177675-ad5a-4aec-bb63-71bce98f1338",
                                                "sense_id": "d258d9f8-97c4-3d12-9efc-a0d7f0ad2254",
                                                "text": "Bisweilen arbeitete er die ganze Nacht hindurch bis in die Morgendämmerung hinein."
                                            },
                                            {
                                                "example_id": "fe758e46-7232-4064-adc8-b16dce660c78",
                                                "sense_id": "d258d9f8-97c4-3d12-9efc-a0d7f0ad2254",
                                                "text": "„In der Morgendämmerung des ersten Mai gehe ich durch die stillen Straßen und weiß nicht wohin.“"
                                            },
                                            {
                                                "example_id": "c2272fb0-5db4-45d6-8145-af30aab19f37",
                                                "sense_id": "d258d9f8-97c4-3d12-9efc-a0d7f0ad2254",
                                                "text": "„Bei Morgendämmerung brachen wir auf; da auf der Portage ein Feuer gewütet hatte und die ganze Gegend verwüstet war, kamen wir nur sehr langsam und mühsam vorwärts und erreichten erst um vier Uhr nachmittags wieder den Fluß.“"
                                            },
                                            {
                                                "example_id": "2d09faba-6fd7-4f3c-984d-f9c6836e8e56",
                                                "sense_id": "d258d9f8-97c4-3d12-9efc-a0d7f0ad2254",
                                                "text": "„Vielleicht war die Morgendämmerung schon nahe.“"
                                            },
                                            {
                                                "example_id": "714f98e1-0731-4dc6-981a-b3d13eb34764",
                                                "sense_id": "d258d9f8-97c4-3d12-9efc-a0d7f0ad2254",
                                                "text": "„Noch in der Morgendämmerung aber, kurz vor Bielsko-Biała, treten die Höhenzüge der Beskiden als kompakte und vag bedrohliche Mauer aus der Ebene hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e9bcbb1-3dc2-492e-9dc6-664bd9c0fff5",
                        "source_entry_id": "e1f384fe-3a76-3338-bded-0efb89ac9daa",
                        "source_sense_id": "1f3f1ad3-e92f-36bf-959b-87af8bcf3837",
                        "source_sense_description": "light of dawn",
                        "target_lang_word": "Dämmerlicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dämmerlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40e4bcc8-025c-32c8-90cc-7d67d29f9f92",
                                        "entry_id": "cfc55d8d-1fce-36fa-8244-ae4364d64ed5",
                                        "glosses": [
                                            "nur schwacher Lichtschein – wie beim Übergang von Tag zu Nacht oder Nacht zu Tag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b2cf4f5-6cc6-4657-97c5-32e3edf8b293",
                                                "sense_id": "40e4bcc8-025c-32c8-90cc-7d67d29f9f92",
                                                "text": "„Zäh hängt der Nebel über der Stadt und lässt nicht mehr als mattes Dämmerlicht zu.“"
                                            },
                                            {
                                                "example_id": "7cf7d9fa-fa52-43ab-8d4c-49d905a46456",
                                                "sense_id": "40e4bcc8-025c-32c8-90cc-7d67d29f9f92",
                                                "text": "„Im Dämmerlicht erkannte ich, dass unser ganzes Bataillon da gewesen war, vielleicht noch mehr.“"
                                            },
                                            {
                                                "example_id": "c3e3b0a1-4780-45e1-bec7-66f64e2417c2",
                                                "sense_id": "40e4bcc8-025c-32c8-90cc-7d67d29f9f92",
                                                "text": "„Trotz des Dämmerlichts hatte er die Kleine ausreichend inspiziert und sie sich schon auf seiner Pritsche vorgestellt.“"
                                            },
                                            {
                                                "example_id": "4024bd17-7d6e-42af-88fe-6cecfe8845b2",
                                                "sense_id": "40e4bcc8-025c-32c8-90cc-7d67d29f9f92",
                                                "text": "„Doch der Raum war in Dämmerlicht getaucht, und es dauerte einige Augenblicke, bis sich ihre Augen an die Schummrigkeit gewöhnt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62a0fbb9-7e02-441f-89d5-f4ec74939ea1",
                        "source_entry_id": "e1f384fe-3a76-3338-bded-0efb89ac9daa",
                        "source_sense_id": "1f3f1ad3-e92f-36bf-959b-87af8bcf3837",
                        "source_sense_description": "light of dawn",
                        "target_lang_word": "Morgenlicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morgenlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99c737ef-01d2-3243-9950-e68c857aee2b",
                                        "entry_id": "598cb1e1-1520-390a-bb81-36040ac8bb92",
                                        "glosses": [
                                            "Lichtschein, der sich beim Übergang von der Nacht zum Tag einstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2e9bc68-9d39-4d9e-a5b5-35c73127c860",
                                                "sense_id": "99c737ef-01d2-3243-9950-e68c857aee2b",
                                                "text": "„Als das Morgenlicht kam, wurde mir wohler.“"
                                            },
                                            {
                                                "example_id": "8dad7be3-ba94-4084-ba37-6371665a8324",
                                                "sense_id": "99c737ef-01d2-3243-9950-e68c857aee2b",
                                                "text": "„Im Morgenlicht sieht dieses Café ganz anders aus.“"
                                            },
                                            {
                                                "example_id": "5f8317a9-19c9-4860-a100-b744a75f26af",
                                                "sense_id": "99c737ef-01d2-3243-9950-e68c857aee2b",
                                                "text": "„Ihr linker Arm ruhte auf seiner Brust, und im fahlen Morgenlicht betrachtete er die feinen Härchen darauf und ihre makellose Haut.“"
                                            },
                                            {
                                                "example_id": "6da714ce-883a-416c-9746-d39825f3e6ac",
                                                "sense_id": "99c737ef-01d2-3243-9950-e68c857aee2b",
                                                "text": "„Im Morgenlicht finde ich eine Straße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "582c5834-2570-4303-b6d6-19786a4f19f8",
                        "source_entry_id": "e1f384fe-3a76-3338-bded-0efb89ac9daa",
                        "source_sense_id": "1f3f1ad3-e92f-36bf-959b-87af8bcf3837",
