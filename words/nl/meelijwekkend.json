{
    "word_family": [
        "medelijden",
        "meelij",
        "wekkend"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "39585180-5954-3729-9b7c-5511a5d1458f",
                    "sense_definition": "zo ellendig of droevig dat het gevoelens van medelijden of deernis oproept",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gewonde hond zag er <w>meelijwekkend</w> uit terwijl hij zachtjes jankte in de regen.",
                            "target_lang_translations": {
                                "en": "The injured dog looked <w>pitiful</w> as it whimpered softly in the rain."
                            }
                        },
                        {
                            "text": "Het was een <w>meelijwekkend</w> gezicht om de oude man zo eenzaam op de bank te zien zitten.",
                            "target_lang_translations": {
                                "en": "It was a <w>pitiable</w> sight to see the old man sitting so lonely on the bench."
                            }
                        }
                    ],
                    "synonyms": [
                        "deerniswekkend",
                        "zielig",
                        "beklagenswaardig",
                        "ellendig",
                        "erbarmelijk",
                        "treurig"
                    ],
                    "antonyms": [
                        "verheugend"
                    ],
                    "common_phrases": [
                        "meelijwekkend gezicht",
                        "meelijwekkend figuur"
                    ],
                    "target_lang_definitions": {
                        "en": "so miserable or sad that it evokes feelings of pity or compassion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pitiful",
                                "target_lang_sense_clarification": "evoking pity or sadness"
                            },
                            {
                                "target_lang_word": "pathetic",
                                "target_lang_sense_clarification": "arousing pity through vulnerability or sadness"
                            },
                            {
                                "target_lang_word": "pitiable",
                                "target_lang_sense_clarification": "deserving of pity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f9c260e-711c-364c-bbe8-0d69acac9bfb",
                    "sense_definition": "van een zeer laag of teleurstellend niveau; pathetisch",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "pathetic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn excuses voor het te laat komen waren werkelijk <w>meelijwekkend</w> en ongeloofwaardig.",
                            "target_lang_translations": {
                                "en": "His excuses for being late were truly <w>pathetic</w> and unbelievable."
                            }
                        },
                        {
                            "text": "De ploeg leverde een <w>meelijwekkende</w> prestatie en verloor de wedstrijd met grote cijfers.",
                            "target_lang_translations": {
                                "en": "The team delivered a <w>pitiful</w> performance and lost the match by a large margin."
                            }
                        }
                    ],
                    "synonyms": [
                        "deplorabel",
                        "miserabel",
                        "abominabel"
                    ],
                    "common_phrases": [
                        "meelijwekkende vertoning",
                        "meelijwekkende poging"
                    ],
                    "target_lang_definitions": {
                        "en": "of a very low or disappointing level; pathetic"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pathetic",
                                "target_lang_sense_clarification": "miserably inadequate or low quality"
                            },
                            {
                                "target_lang_word": "pitiful",
                                "target_lang_sense_clarification": "contemptibly small or poor"
                            },
                            {
                                "target_lang_word": "miserable",
                                "target_lang_sense_clarification": "wretchedly bad or inadequate"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}