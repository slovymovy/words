                        "cross_references": [
                            {
                                "target_word": "bataille navale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "539433d7-d222-327d-9740-9748ca1c7bfb",
                                        "entry_id": "a550fd4b-5af7-3e8f-9f4b-97587f1b1381",
                                        "glosses": [
                                            "Bataille en mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "343219a3-346d-4022-abb8-4ff5411d3fe4",
                                                "sense_id": "539433d7-d222-327d-9740-9748ca1c7bfb",
                                                "text": "C’est ce que les Britanniques appellent « The battle of the Nile » – « la bataille du Nil », et les Français « la bataille navale d'Aboukir »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93cc9cb5-55c8-3043-a015-597deace9088",
                                        "entry_id": "a550fd4b-5af7-3e8f-9f4b-97587f1b1381",
                                        "glosses": [
                                            "Jeu de société dans lequel chacun des deux joueurs doit placer des « navires » sur sa grille tenue secrète et tenter de « torpiller » les navires adverses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120f55a8-8a7e-422c-90d7-11d9dd287c2d",
                                                "sense_id": "93cc9cb5-55c8-3043-a015-597deace9088",
                                                "text": "A la maison, il a plus de travail que moi ; mais il s’arrange toujours pour que nous jouions ensemble quelque temps, à chahuter sur le grand lit de la chambre, à faire « une bataille navale »."
                                            },
                                            {
                                                "example_id": "26b6d24c-4ebb-4033-a77c-38542317d6cb",
                                                "sense_id": "93cc9cb5-55c8-3043-a015-597deace9088",
                                                "text": "C’est comme à la bataille navale : c’est en pilonnant que tu finis par atteindre la cible. Pour toucher ton torpilleur, il faut en balancer, en balancer de la camelote. La vie, c’est du kif : tu finis par te la faire en la pilonnant de ta tendresse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
