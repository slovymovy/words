        "fr-extract.jsonl": [
            {
                "entry_id": "7a37c5b8-6e31-3686-a4d4-fd96d01fb858",
                "word": "décemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e32f71e6-855a-369b-a323-6778b579b726",
                        "entry_id": "7a37c5b8-6e31-3686-a4d4-fd96d01fb858",
                        "glosses": [
                            "D’une manière décente, conformément à la décence, aux convenances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b79c5ba8-0223-45a1-b23e-7e1a536dd4de",
                                "sense_id": "e32f71e6-855a-369b-a323-6778b579b726",
                                "text": "Se vêtir décemment, se comporter décemment."
                            },
                            {
                                "example_id": "8b2c0c9e-e796-4528-bb50-a79eee04c870",
                                "sense_id": "e32f71e6-855a-369b-a323-6778b579b726",
                                "text": "Dès qu'il put décemment se lever de table, il se précipita plutôt qu'il ne courut à l'écurie, sella lui-même son cheval, et partit au galop."
                            },
                            {
                                "example_id": "3f552e34-be9b-495b-ba65-80ad9ff48b1c",
                                "sense_id": "e32f71e6-855a-369b-a323-6778b579b726",
                                "text": "Il faut absolument que j’y aille, dit-elle, à pied ou à cheval ; mais je consens volontiers à m’habiller plus décemment."
                            }
                        ]
                    },
                    {
                        "sense_id": "354b3f2d-5e8d-3167-8f0b-5383a24d1042",
                        "entry_id": "7a37c5b8-6e31-3686-a4d4-fd96d01fb858",
                        "glosses": [
                            "Raisonnablement, pour être convenable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c844ed-5f88-419e-bc01-e270e190a38d",
                                "sense_id": "354b3f2d-5e8d-3167-8f0b-5383a24d1042",
                                "text": "Décemment, nous ne pouvons pas nous dispenser de lui faire une visite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9a3080c-7f89-4e8a-9a94-80b75fa149b1",
                        "source_entry_id": "7a37c5b8-6e31-3686-a4d4-fd96d01fb858",
                        "target_lang_word": "anständig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anständig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81e7135b-3fbd-3b9b-ac05-cd355c26d0ef",
                                        "entry_id": "a7d3b367-c354-3ec0-9007-19582205d18f",
                                        "glosses": [
                                            "im Einklang mit der (eher prüden) Sexualmoral"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56aae0ca-6951-435b-a801-8a2acbcbb4cf",
                                                "sense_id": "81e7135b-3fbd-3b9b-ac05-cd355c26d0ef",
                                                "text": "Zieh dir was Anständiges an!"
                                            },
                                            {
                                                "example_id": "bb266f17-826e-47de-9055-3034edeac7d3",
                                                "sense_id": "81e7135b-3fbd-3b9b-ac05-cd355c26d0ef",
                                                "text": "Eine anständige Frau tut so etwas nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "292f01d2-648f-3c81-846e-2c72b2c6fb94",
                                        "entry_id": "a7d3b367-c354-3ec0-9007-19582205d18f",
                                        "glosses": [
                                            "den Benimmregeln entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c9f1c13-9c8f-4fcc-99ab-e363ac5f8ac2",
                                                "sense_id": "292f01d2-648f-3c81-846e-2c72b2c6fb94",
                                                "text": "Benimm dich ja anständig!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bd1491dd-3f8f-37ea-9b14-b9fcf8858f13",
                                        "entry_id": "a7d3b367-c354-3ec0-9007-19582205d18f",
                                        "glosses": [
                                            "moralisch integer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d72e710f-dd90-4300-a865-e4de2ffcc64d",
                                                "sense_id": "bd1491dd-3f8f-37ea-9b14-b9fcf8858f13",
                                                "text": "Trotz allem ist er ein anständiger Kerl geblieben."
                                            },
                                            {
                                                "example_id": "a920066e-3e2c-4788-a3c4-722587998419",
                                                "sense_id": "bd1491dd-3f8f-37ea-9b14-b9fcf8858f13",
                                                "text": "Das war aber anständig von ihm!"
                                            },
                                            {
                                                "example_id": "7f34af93-1675-4938-b89a-52f345fd3a54",
                                                "sense_id": "bd1491dd-3f8f-37ea-9b14-b9fcf8858f13",
                                                "text": "„Seine Gläubiger waren so anständig gewesen, ihn im Besitz eines kleinen Restes seines väterlichen Vermögens zu lassen, dessen Zinsen bei äußerster Sparsamkeit zu einem sehr bescheidenen Leben hinreichten, ihm jedoch auch nicht den kleinsten Luxus gestatteten.“"
                                            },
                                            {
                                                "example_id": "64ef0018-d115-4f8d-adc1-803071391fa8",
                                                "sense_id": "bd1491dd-3f8f-37ea-9b14-b9fcf8858f13",
                                                "text": "Hier gibt es anständige Portionen zu anständigen Preisen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "64d08cbf-e2ad-3a5c-80c1-6d7e87ac01ad",
                                        "entry_id": "a7d3b367-c354-3ec0-9007-19582205d18f",
                                        "glosses": [
                                            "vollwertig, gut"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92322c18-37e0-4c72-8526-39f50fec7b3d",
                                                "sense_id": "64d08cbf-e2ad-3a5c-80c1-6d7e87ac01ad",
                                                "text": "Du brauchst mal wieder was Anständiges in den Magen!"
                                            },
                                            {
                                                "example_id": "fdc42ea3-6e4c-43ee-8d82-81e0a2545ab8",
                                                "sense_id": "64d08cbf-e2ad-3a5c-80c1-6d7e87ac01ad",
                                                "text": "Wollt ihr mal einen anständigen unanständigen Witz hören?"
                                            },
                                            {
                                                "example_id": "ff5616b9-3fab-4715-95c5-9d3d22f92c72",
                                                "sense_id": "64d08cbf-e2ad-3a5c-80c1-6d7e87ac01ad",
                                                "text": "Hier gibt es anständige Portionen zu anständigen Preisen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87c24cad-5c62-4259-806d-c919eac1ea43",
                        "source_entry_id": "7a37c5b8-6e31-3686-a4d4-fd96d01fb858",
                        "target_lang_word": "schicklich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schicklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ef5bfc6-1277-34a1-86b1-2ded82917413",
                                        "entry_id": "c1ca902a-1318-32d1-950b-ddcf452932e6",
                                        "glosses": [
                                            "den Sitten, Normen, Konventionen einer Gesellschaft entsprechend"
                                        ],
                                        "tags": [
                                            "literary",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de103e35-d3a2-4ac2-8aa9-b161b0b27eeb",
                                                "sense_id": "1ef5bfc6-1277-34a1-86b1-2ded82917413",
                                                "text": "„Dieses Kleid, was du da trägst, ist nicht schicklich genug für den Abend: Du musst deine Brüste nicht so herzeigen!“"
                                            },
                                            {
                                                "example_id": "0f681696-e515-43ed-80bd-a108ef0b7ddf",
                                                "sense_id": "1ef5bfc6-1277-34a1-86b1-2ded82917413",
                                                "text": "Es ist keineswegs schicklich, als Herr in geschlossenen Räumen seinen Hut aufzubehalten."
                                            },
                                            {
                                                "example_id": "98b624d0-c958-4183-afea-e3de03094e56",
                                                "sense_id": "1ef5bfc6-1277-34a1-86b1-2ded82917413",
                                                "text": "Es klingt indonesisch und sieht auch so aus. „The First Modest Fashion Show“ zeigt Designer-Mode aus islamischen Ländern: schick und schicklich zugleich, „modest“ eben."
                                            },
                                            {
                                                "example_id": "17ac5a9a-87df-4f85-9c77-97f664faffc5",
                                                "sense_id": "1ef5bfc6-1277-34a1-86b1-2ded82917413",
                                                "text": "In Sure 33, Vers 59, heißt es: „Sage, Prophet, deinen Frauen und Töchtern und den Frauen der Gläubigen, dass sie ihr Übergewand (über ihr Antlitz) ziehen sollen, wenn sie ausgehen; so ist es schicklich, damit man sie als ehrbare Frauen erkenne und sie nicht belästige.“"
                                            },
                                            {
                                                "example_id": "750836eb-d2b2-411a-b960-4cbb32edc228",
                                                "sense_id": "1ef5bfc6-1277-34a1-86b1-2ded82917413",
                                                "text": "Offenbar sah er [Klub-Chef Dietmar Beiersdorfer] es als wenig schicklich an, die sofortige Trennung [vom Trainer Bruno Labbadia] bekanntzugeben, als zur selben Zeit die Fans Labbadia mit Sprechchören feierten."
                                            },
                                            {
                                                "example_id": "9e5eb3a4-6100-4ff0-9714-10b1e72f6bb4",
                                                "sense_id": "1ef5bfc6-1277-34a1-86b1-2ded82917413",
                                                "text": "Es war [vor 300 Jahren] überhaupt nicht schicklich, von Porzellan zu speisen, sie haben das als sehr minderwertig empfunden, in besseren Kreisen hat man von Silber gegessen in allerhöchsten Kreisen von goldenen Tellern."
                                            },
                                            {
                                                "example_id": "dafa897e-383a-4455-b7a3-2591bbceb4f3",
                                                "sense_id": "1ef5bfc6-1277-34a1-86b1-2ded82917413",
                                                "text": "Damit verstieß sie [die französische Cellistin Lise Cristiani] gegen ein ungeschriebenes Gesetz der bürgerlichen Musikkultur: Vom öffentlichen Gebrauch der Musikinstrumente hatten Frauen sich fernzuhalten – allein das Spiel der Harfe und des Klaviers galt für sie als einigermaßen „schicklich“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98edfb21-f435-3dab-80cf-ffbbcdea2da8",
                                        "entry_id": "c1ca902a-1318-32d1-950b-ddcf452932e6",
                                        "glosses": [
                                            "einem Zweck / einer Bestimmung entsprechend"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50126140-fd1c-4a03-8e29-c476951cd1e4",
                                                "sense_id": "98edfb21-f435-3dab-80cf-ffbbcdea2da8",
                                                "text": "Über seine Heimat Königsberg, das heute russische Kaliningrad, sagte Immanuel Kant: „Ein schicklicher Platz zur Erweiterung sowohl der Menschenkenntnis als auch Welterkenntnis.“"
                                            },
                                            {
                                                "example_id": "d96ec86e-4f52-449f-90fe-96445a3b93ab",
                                                "sense_id": "98edfb21-f435-3dab-80cf-ffbbcdea2da8",
                                                "text": "40 Lauchstädter Sommeraufführungen brachten den Theaterleuten schließlich ebenso viel Geld in die Kasse wie 100 Vorstellungen in Weimar. Worauf der Geheimrat Goethe sich für den Bau eines „schicklicheren Schauspielhauses“ stark machte, das nach kurzer Bauzeit im Juni 1802 mit der Aufführung einer Mozart-Oper glanzvoll eröffnet wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
