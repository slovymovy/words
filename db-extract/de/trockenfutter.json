                "senses": [
                    {
                        "sense_id": "cf6753ce-b843-3c17-bd64-9ce8fe99539c",
                        "entry_id": "58703cb8-b466-3a2e-809e-b2b0d3e9e9d9",
                        "glosses": [
                            "pflanzliche oder fleischliche Tiernahrung mit sehr geringem Wassergehalt"
                        ],
                        "tags": [
                            "meist im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "b18387b8-08b2-4a51-90f5-eede7b7838c8",
                                "sense_id": "cf6753ce-b843-3c17-bd64-9ce8fe99539c",
                                "text": "Man sollte eine Katze nicht ausschließlich mit Trockenfutter ernähren."
                            },
                            {
                                "example_id": "7c0c3aa2-b421-450e-942f-6aa0b49ff0c7",
                                "sense_id": "cf6753ce-b843-3c17-bd64-9ce8fe99539c",
                                "text": "Dieter animiert seine Kater zur Bewegung, indem er Trockenfutter durch das Wohnzimmer wirft, dem die Tiere hinterherlaufen."
                            },
                            {
                                "example_id": "e1867aa4-6e60-4604-880e-129662e84c9b",
                                "sense_id": "cf6753ce-b843-3c17-bd64-9ce8fe99539c",
                                "text": "Der übergewichtige Hund bekommt kalorienreduziertes Trockenfutter."
                            },
                            {
                                "example_id": "a666df3a-abd7-4ba3-878a-a580eec6df9f",
                                "sense_id": "cf6753ce-b843-3c17-bd64-9ce8fe99539c",
                                "text": "„Stiftung Warentest hat 32 Trockenfutter für Hunde untersucht.“"
                            },
                            {
                                "example_id": "a039b08c-b9a1-45d0-a5ca-3483c5eaade2",
                                "sense_id": "cf6753ce-b843-3c17-bd64-9ce8fe99539c",
                                "text": "„Die Kühe bekommen auch kein Trockenfutter[,] sondern fressen nur Almgras und Kräuter, was sich natürlich auf den Geschmack auswirkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
