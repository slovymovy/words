                "senses": [
                    {
                        "sense_id": "1138f3a0-9349-34fa-8982-f66f6a6b7018",
                        "entry_id": "60f03cd4-0246-3c65-bd4b-0c82622662e3",
                        "glosses": [
                            "eigenhändige Niederschrift eines berühmten, herausragenden Verfassers (Schriftsteller, Komponist etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85164ef3-0c57-4906-9460-b9046ddd11c4",
                                "sense_id": "1138f3a0-9349-34fa-8982-f66f6a6b7018",
                                "text": "Freud fand noch nach dem Anschluss die Kraft, Weissman für das Buch zu danken, was in einem Autograf bei einer Erstausgabe vermerkt wurde."
                            },
                            {
                                "example_id": "7d7a0b21-9ff8-440a-abf0-af3e80d052c5",
                                "sense_id": "1138f3a0-9349-34fa-8982-f66f6a6b7018",
                                "text": "Das Autograf besaß Ferdinand Schubert, als op. 113 bei Diabelli im Stich erschienen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29253e78-8148-3303-820a-3fa71439bee5",
                        "entry_id": "60f03cd4-0246-3c65-bd4b-0c82622662e3",
                        "glosses": [
                            "im Beisein des Autors hergestellter erster Druck"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "093cc3bb-5bc3-44dd-9237-b681facc20e2",
                                "sense_id": "29253e78-8148-3303-820a-3fa71439bee5",
                                "text": "Stolz hielt der Verfasser das Autograf in seiner Hand."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bb8525c-db64-40e3-92ba-04b2e503785d",
                        "source_entry_id": "60f03cd4-0246-3c65-bd4b-0c82622662e3",
                        "source_sense_id": "1138f3a0-9349-34fa-8982-f66f6a6b7018",
                        "source_sense_description": "eigenhändige Niederschrift eines berühmten, herausragenden Verfassers",
                        "target_lang_word": "autograph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autograph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b38c18a1-b837-308c-b0c3-1c5fb302a7f0",
                                        "entry_id": "da6100fe-fb0c-3890-addd-caa430333de0",
                                        "glosses": [
                                            "A person’s own handwriting, especially the signature of a famous or admired person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5530ea-0c87-41ac-b9a7-29b5400b4292",
                                                "sense_id": "b38c18a1-b837-308c-b0c3-1c5fb302a7f0",
                                                "text": "Some autograph-hunters were pestering the players after the game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d44f5cd-cd75-37a3-8a1d-8abac2250a6c",
                                        "entry_id": "da6100fe-fb0c-3890-addd-caa430333de0",
                                        "glosses": [
                                            "A person's signature used as a mark of formal approval."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "301fe2bc-9fb9-47dc-ba99-318c0a8b38e9",
                                                "sense_id": "9d44f5cd-cd75-37a3-8a1d-8abac2250a6c",
                                                "text": "If you could just put your autograph on the ol’ contract, please…"
                                            },
                                            {
                                                "example_id": "40ba0a05-e22c-4b63-bf91-891d5731f2f1",
                                                "sense_id": "9d44f5cd-cd75-37a3-8a1d-8abac2250a6c",
                                                "text": "For me, identifying an autograph is one of the most exciting aspects of collecting. I enjoy the detective work that comes with discerning a fake from the real deal, and subsequently valuing the item against other examples."
                                            },
                                            {
                                                "example_id": "5b46c33b-7a77-4cf9-bb98-434db838b305",
                                                "sense_id": "9d44f5cd-cd75-37a3-8a1d-8abac2250a6c",
                                                "text": "“Based on the scarcity of signed images from this period, in general, coupled with the miniscule population of original Jackson autographs we cannot overstate the rarity of this offering,” it said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "923a99db-8c35-38c1-9c74-eb4116c1795b",
                                        "entry_id": "da6100fe-fb0c-3890-addd-caa430333de0",
                                        "glosses": [
                                            "A manuscript in the author’s handwriting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "autograph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a0f9d1b-4dad-35ce-ab0c-6511d69cfec2",
                                        "entry_id": "bc2bb2eb-cb11-326a-af5b-e8c96693d8b8",
                                        "glosses": [
                                            "Written in the author’s own handwriting."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1daa19a9-2673-350f-a21f-1c42e537b3e0",
                                        "entry_id": "bc2bb2eb-cb11-326a-af5b-e8c96693d8b8",
                                        "glosses": [
                                            "Made by the artist himself or herself; authentic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a238f4c-9ffd-4aed-b23e-a88d148edb99",
                                                "sense_id": "1daa19a9-2673-350f-a21f-1c42e537b3e0",
                                                "text": "Schiff […] believes most of the drawings are autograph."
                                            },
                                            {
                                                "example_id": "ca2b9d40-b93b-47a7-b732-fb00bf66f07a",
                                                "sense_id": "1daa19a9-2673-350f-a21f-1c42e537b3e0",
                                                "text": "Not surprisingly, he attributed to Kauffman two important works that are no longer accepted as autograph."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "autograph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23054cb2-41d1-39b1-8b9f-6935ecf8a0f8",
                                        "entry_id": "8902e017-cd87-3a45-bc4d-95751880a639",
                                        "glosses": [
                                            "To sign, or write one’s name or signature on a book, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e7a179-26bf-49c2-b19b-c13be3ee1441",
                                                "sense_id": "23054cb2-41d1-39b1-8b9f-6935ecf8a0f8",
                                                "text": "Diego Maradona is helping in the fight against coronavirus in his home city by autographing a replica of the Argentina jersey he wore in the country’s 1986 World Cup final triumph to raise money for an underprivileged community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "207ecdf1-8be1-3433-af09-d2fafa8b14a9",
                                        "entry_id": "8902e017-cd87-3a45-bc4d-95751880a639",
                                        "glosses": [
                                            "To write something in one's own handwriting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cc445f6-55cb-44ff-8aa6-3e6cd9839b49",
                        "source_entry_id": "60f03cd4-0246-3c65-bd4b-0c82622662e3",
                        "source_sense_id": "1138f3a0-9349-34fa-8982-f66f6a6b7018",
                        "source_sense_description": "eigenhändige Niederschrift eines berühmten, herausragenden Verfassers",
                        "target_lang_word": "autographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acd2fd13-e9b7-3e8f-b1ca-1892429e4311",
                                        "entry_id": "efc82a81-62fe-345b-b0cc-ed26f275dcf0",
                                        "glosses": [
                                            "Qui est écrit de la main même de l’auteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "455caad1-3424-4a03-a93f-3c58b14e86af",
                                                "sense_id": "acd2fd13-e9b7-3e8f-b1ca-1892429e4311",
                                                "text": "Ses chefs […] louaient aussi son calme, son tact et sa tenue. Aux yeux d’un graphologue, la dernière lettre autographe de lui, qui a été conservée, confirme ces notes. Elle révèle un esprit net et précis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "autographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6455512b-4cdc-30c9-b537-a99df22436d6",
                                        "entry_id": "dbda99dd-c0ed-355d-89de-21c4778f79f1",
                                        "glosses": [
                                            "Écrit de la main même d’un auteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e428cff9-fadc-45c8-be35-7d74204c15c8",
                                                "sense_id": "6455512b-4cdc-30c9-b537-a99df22436d6",
                                                "text": "J’ai répondu à des bourgeoises, à des sottes, à des intrigantes qui voulaient un autographe !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f84d0846-c3de-3b68-bca4-e313e36849fd",
                                        "entry_id": "dbda99dd-c0ed-355d-89de-21c4778f79f1",
                                        "glosses": [
                                            "Signature donnée à un admirateur à usage de relique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475274d9-f850-4c62-9d8e-c55396022f7f",
                                                "sense_id": "f84d0846-c3de-3b68-bca4-e313e36849fd",
                                                "text": "Et pour ne pas faire le coup des collectionneuses d’autographes, elle avait volontairement oublié d’envoyer son adresse."
                                            },
                                            {
                                                "example_id": "3d5232d3-a497-40bf-a6e9-6bb3b2996d5f",
                                                "sense_id": "f84d0846-c3de-3b68-bca4-e313e36849fd",
                                                "text": "Comme je sors du théâtre, une vingtaine de jeunes gens m’entourent, me présentent des carnets en me demandant un autographe. L’un d’eux me tend un stylo d’où l’encre dégouline et je m’en mets partout."
                                            },
                                            {
                                                "example_id": "f55ea159-1252-4a0c-a16c-93a2129d90be",
                                                "sense_id": "f84d0846-c3de-3b68-bca4-e313e36849fd",
                                                "text": "L’allocution se termine, le candidat se jette dans un énième bain de foule et signe des autographes sur les bons de retard des élèves – cheveux en pétard, sweat-shirts à capuche – qui l’approchent."
                                            },
                                            {
                                                "example_id": "6fdcc63b-e809-45f0-9acd-871a01a66475",
                                                "sense_id": "f84d0846-c3de-3b68-bca4-e313e36849fd",
                                                "text": "On découvre des acteurs qui signent des tribunes sans réfléchir, comme ils gribouillent des autographes avant de monter les marches du Festival de Cannes, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6232a4db-fd7b-4d59-8b54-1e3540f6fcb1",
                        "source_entry_id": "60f03cd4-0246-3c65-bd4b-0c82622662e3",
                        "source_sense_id": "1138f3a0-9349-34fa-8982-f66f6a6b7018",
