                    },
                    {
                        "translation_id": "ff0a5a23-aeb3-4b07-92a9-b52114305b61",
                        "source_entry_id": "8670b431-0724-3104-a16a-4e84d50940e1",
                        "source_sense_id": "8c9b1e0a-6154-327e-adea-fd8551c4fdbd",
                        "target_lang_word": "abuelos",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abuelos",
