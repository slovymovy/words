                    "frequency": "Low",
                    "semantic_group_id": "proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Całe to <w>zagmatwanie</w> sprawy wynikało z braku jasnych instrukcji dla pracowników.",
