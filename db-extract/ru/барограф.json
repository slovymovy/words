                    },
                    {
                        "translation_id": "bd93370f-cf70-4fef-8c0d-92bd573c111d",
                        "source_entry_id": "a098f1e3-0109-3548-9346-d18417635d84",
                        "source_sense_id": "883bde70-9dae-3025-992c-a1f69940e90a",
