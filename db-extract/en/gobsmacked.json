                        "form": "more gobsmacked"
                    },
                    {
                        "form_id": "09f7d625-87cf-48d0-a7e2-75e6ea991d7d",
                        "entry_id": "91175dab-5d70-3cb2-819f-13ed3012bce0",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most gobsmacked"
