                ],
                "senses": [
                    {
                        "sense_id": "21d6df7b-2a1f-3ee9-a168-bf8bcd770d85",
                        "entry_id": "70741aea-b80e-3cad-b83d-cb3d302a5fad",
                        "glosses": [
                            "kleine Pflanze, die erst seit kurzem aus der Erde gesprossen ist"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b0f4d95c-515c-305b-ab5c-1a35ccc4f25c",
                        "entry_id": "70741aea-b80e-3cad-b83d-cb3d302a5fad",
                        "glosses": [
                            "jemand, der aus einer bestimmten Familie stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8caf0f0a-e6c7-429f-9031-fc0a1685b628",
                                "sense_id": "b0f4d95c-515c-305b-ab5c-1a35ccc4f25c",
                                "text": "„Den Sprösslingen der Familie wies er entferntere Sitze zu, um ihre Macht zu teilen.“"
                            },
                            {
                                "example_id": "2b4efd40-b99d-4e93-b8e1-b020b290ffd3",
                                "sense_id": "b0f4d95c-515c-305b-ab5c-1a35ccc4f25c",
                                "text": "„Die Boisserée waren Sprösslinge einer Familie, die ursprünglich in der Gegend von Lüttich ansässig gewesen war.“"
                            },
                            {
                                "example_id": "ad3f831c-41dc-42d1-9b39-40938ca2c0a1",
                                "sense_id": "b0f4d95c-515c-305b-ab5c-1a35ccc4f25c",
                                "text": "„Dass diese Art von Bildungssegregation wiederzum zu sehr verschiedenen Wahrnehmungs- und Interpretationsmustern bei den Absolventen führt, ist kaum überraschend. Es bedeutet aber auch, dass die Sprösslinge der gesellschaftlichen Eliteschicht in ihrer Lebenswelt kaum noch etwas mit denen verbindet, die eine Koranschule besuchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80e6709a-95c9-4b10-ab58-2a7e8e004cb7",
                        "source_entry_id": "70741aea-b80e-3cad-b83d-cb3d302a5fad",
                        "source_sense_id": "21d6df7b-2a1f-3ee9-a168-bf8bcd770d85",
