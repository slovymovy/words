                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Abate</w> to speak at our annual conference on European history.",
                            "target_lang_translations": {
                                "cs": "Pozvali jsme pana <w>Abateho</w>, aby promluvil na naší výroční konferenci o evropských dějinách."
                            }
                        },
                        {
                            "text": "The local gallery is currently hosting an exhibition of paintings by the artist <w>Abate</w>.",
                            "target_lang_translations": {
                                "cs": "Místní galerie právě pořádá výstavu obrazů umělce <w>Abateho</w>."
