                    {
                        "translation_id": "8415133c-206f-46c1-a25f-84ce4e1068c8",
                        "source_entry_id": "85d243ef-0398-30fa-af26-67ed21e7e40d",
                        "source_sense_id": "7308a017-fe4c-3ede-b80e-8c22ef2b34e7",
                        "target_lang_word": "wrapped up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wrapped up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "499a87e5-122b-3e32-9d77-b82dff23ac7f",
                                        "entry_id": "48d81b47-d951-391f-b55e-ddea2e3d78c6",
                                        "glosses": [
                                            "Involved with; distracted by."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28ad31dc-9c73-41c9-9497-7ede26ab1026",
                                                "sense_id": "499a87e5-122b-3e32-9d77-b82dff23ac7f",
                                                "text": "I found my new master more wrapped up than ever in Seraphina; his Seraphina equally wrapped up in my master, and Don Cæsar just as much wrapped up as either in the contemplation of the happy couple."
                                            },
                                            {
                                                "example_id": "401d4ee1-bd57-4fba-8d95-1d99034d2807",
                                                "sense_id": "499a87e5-122b-3e32-9d77-b82dff23ac7f",
                                                "text": "Maybe during football season I'm more wrapped up with what Erik's doing."
                                            },
                                            {
                                                "example_id": "0f039e23-0dbc-4430-b108-23929367d95b",
                                                "sense_id": "499a87e5-122b-3e32-9d77-b82dff23ac7f",
                                                "text": "I think if he had had other relations, he would cope better, but he had no aunts or uncles or even grandparents to talk to, and as his dad got on with living with his girlfriend and his sister became more and more wrapped up in her boyfriend, he was sadly on his own."
                                            },
                                            {
                                                "example_id": "35611e1e-6a89-453a-bc5d-b59391fb7c06",
                                                "sense_id": "499a87e5-122b-3e32-9d77-b82dff23ac7f",
                                                "text": "She gives us all a lot of meaningless busy work, and she herself is so wrapped up in busy work that she doesn't know the difference between productive work and the appearance of working."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52ec921a-2e8b-36fa-aaf6-d0cc3b3d1123",
                                        "entry_id": "48d81b47-d951-391f-b55e-ddea2e3d78c6",
                                        "glosses": [
                                            "Entangled in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0223c32-4a05-4112-95f1-eccc895e65ae",
                                                "sense_id": "52ec921a-2e8b-36fa-aaf6-d0cc3b3d1123",
                                                "text": "In our secular society, the use and understanding of the mask, outside of entertainment, has become wrapped up in superstition, which one could argue is what happens to a society when it ditches its religious beliefs, beliefs central to that society."
                                            }
                                        ]
                                    }
                                ]
