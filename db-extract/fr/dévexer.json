                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06029007-11a1-47d9-bd07-17a10702234f",
                                "sense_id": "cb819481-2c5f-3f40-9c3f-5ae674542d84",
                                "text": "C’est clair, c’est net, merci Mamie, mais je suis vexée. Tant pis, je vais me dévexer, car voilà Nénène qui vient me chercher pour faire un tour dans le village."
                            },
                            {
                                "example_id": "b89fb061-2fe2-46ca-a113-6ca5be12443f",
                                "sense_id": "cb819481-2c5f-3f40-9c3f-5ae674542d84",
                                "text": "Pour cette raison, il ne sera avisé qu’après et, s’il se vexe, nous attendrons qu’il se « dévexe »."
                            },
                            {
                                "example_id": "414219fa-88c2-447b-9a8b-e5895ebf34a5",
                                "sense_id": "cb819481-2c5f-3f40-9c3f-5ae674542d84",
                                "text": "S’est-elle dévexée?"
                            }
                        ]
                    }
