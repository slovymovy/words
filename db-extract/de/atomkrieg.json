                        "form": "den Atomkrieg"
                    },
                    {
                        "form_id": "f723e938-68b2-47a0-a39f-be7ebfbbe799",
                        "entry_id": "c116c065-8d24-3dea-828c-d4800f17f3b1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Atomkriege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2864d291-b326-3f3c-a4bd-39fb71ff9bc5",
                        "entry_id": "c116c065-8d24-3dea-828c-d4800f17f3b1",
                        "glosses": [
                            "Krieg, der mit thermonuklearen Waffen (Atomwaffen) geführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "466706c3-7085-401f-bcda-c207c248acab",
                                "sense_id": "2864d291-b326-3f3c-a4bd-39fb71ff9bc5",
                                "text": "Ein Atomkrieg wäre ein Desaster für die Menschheit."
                            },
                            {
                                "example_id": "1c788cc6-7dd4-4018-a01f-816e77493d57",
                                "sense_id": "2864d291-b326-3f3c-a4bd-39fb71ff9bc5",
                                "text": "„Nun zeigt er mir in der Abendzeitung einen Artikel; da steht, eine von den Großmächten hätte gefragt, ob der isländische Staat ihr seine Hauptstadt Reykjavik, auch Smoky Bay genannt, oder irgendeine andre Bucht des Landes, die sich in einem Atomkriege sowohl zum Angriff wie zur Verteidigung eigne, verkaufen, verpachten oder verschenken wolle.“"
                            },
                            {
                                "example_id": "9c07e233-960f-4baf-8e02-7b19434741d0",
                                "sense_id": "2864d291-b326-3f3c-a4bd-39fb71ff9bc5",
                                "text": "„Ich wurde 1947 geboren; unseren ersten Fernseher bekamen wir 1958. Soweit ich mich erinnere, habe ich darin als erstes ‚Robot Monster‘ gesehen, einen Film, in dem ein Typ in einem Affenkostüm und einem Goldfischglas auf dem Kopf (er hiess Ro-Man) herumlief und versuchte, die letzten Überlebenden eines Atomkriegs zu vernichten.“"
                            },
                            {
                                "example_id": "ac2e5e89-2b96-4950-b8fb-6a59c1c6fb1d",
                                "sense_id": "2864d291-b326-3f3c-a4bd-39fb71ff9bc5",
                                "text": "„Die Wiederbewaffnung war ein großes Thema, Bundesverteidigungsminister Franz Josef Strauß eine Reiz- und Hassfigur, die Angst vor einem Atomkrieg durchaus präsent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03b82384-570b-44ef-87b6-22f70e858742",
                        "source_entry_id": "c116c065-8d24-3dea-828c-d4800f17f3b1",
                        "source_sense_id": "2864d291-b326-3f3c-a4bd-39fb71ff9bc5",
                        "source_sense_description": "Krieg, der mit thermonuklearen Waffen (Atomwaffen) geführt wird",
                        "target_lang_word": "nuclear war",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuclear war",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6e069e1-1717-32fe-8c5b-b5e15d442683",
                                        "entry_id": "25ff44d0-d0a4-3129-8113-9a5e9cc25e29",
                                        "glosses": [
                                            "A war fought using nuclear (fission and/or fusion) weapons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06d7144c-de94-4753-93fe-7311ec461109",
                                                "sense_id": "f6e069e1-1717-32fe-8c5b-b5e15d442683",
                                                "text": "IF JULY 1, 1968, figures in the history books of the future, it will be because of what happened that morning in the East Room of the White House. A few minutes after 11:30 A.M., in that gold-draped room, before hundreds of witnesses and in the glare of television floodlights, representatives of the Soviet Union, the United Kingdom, the United States, and more than fifty other nations signed the Treaty on the Nonproliferation of Nuclear Weapons. Under that treaty, nations without nuclear weapons promised not to make them or receive them from others; the treaty assured those nations that they would have access to the full benefits of the peaceful uses of nuclear power. Nations with nuclear weapons pledged to work toward effective arms control and disarmament.\nThis was the most significant step we had yet taken to reduce the possibility of nuclear war. In my remarks following the signing ceremony, I called the treaty \"the most important international agreement since the beginning of the nuclear age.\""
                                            },
                                            {
                                                "example_id": "04ede659-dc9a-4b3f-a268-134ff12b498e",
                                                "sense_id": "f6e069e1-1717-32fe-8c5b-b5e15d442683",
                                                "text": "Vladimir Putin has told Nato countries that they risk provoking a nuclear war if they send troops to fight in Ukraine, in an annual state of the nation speech ramping up his threats against Europe and the US."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af1d8051-1f28-4664-8252-4c3f2319c6c2",
                        "source_entry_id": "c116c065-8d24-3dea-828c-d4800f17f3b1",
                        "source_sense_id": "2864d291-b326-3f3c-a4bd-39fb71ff9bc5",
                        "source_sense_description": "Krieg, der mit thermonuklearen Waffen (Atomwaffen) geführt wird",
