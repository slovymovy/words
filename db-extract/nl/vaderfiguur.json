                        "examples": [
                            {
                                "example_id": "fbdc4bd9-d960-43e1-bb8d-8adfb3c84d50",
                                "sense_id": "7d5a6ab6-c537-3ceb-bbca-548518110967",
                                "text": "Het misbruik zou hebben plaatsgevonden tussen 2008 en 2019. Bij de jongste dochter gebeurde dat vanaf 2015. De officier van justitie stelt dat de meisjes P. zagen als vaderfiguur. Ook vriendinnetjes van de dochters zijn volgens het OM slachtoffer geworden van de man."
                            },
                            {
                                "example_id": "5d7885b2-d68b-4d87-8f5f-2c4d5c8c9108",
                                "sense_id": "7d5a6ab6-c537-3ceb-bbca-548518110967",
                                "text": "Een vaderfiguur voor spelers en trainers, de pater familias. Zo zal Harry van Raaij, die op 84-jarige leeftijd is overleden, herinnerd worden bij PSV."
                            }
                        ]
