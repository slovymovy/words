                    {
                        "sense_id": "969fdade-62e9-35e3-843f-10b2cb0b56e3",
                        "entry_id": "bca09997-6f7f-38d4-9dd7-ac121b199136",
                        "glosses": [
                            "Pâtes alimentaires annulaires farcies avec un mélange de viande ou de fromage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4700330b-a712-40cd-9f2b-87261ff4e648",
                                "sense_id": "969fdade-62e9-35e3-843f-10b2cb0b56e3",
                                "text": "Il y avait du carpaccio, de l’huile d’olive et du citron. Ensuite, ce serait des tortellinis avec des tomates fraîches coupées en dés, du basilic et de la roquette."
                            },
                            {
                                "example_id": "448ebbfb-8c9d-4153-b6a6-a7cea6c10da6",
                                "sense_id": "969fdade-62e9-35e3-843f-10b2cb0b56e3",
                                "text": "Les tortellini^([sic]) m'ont inspirée, ce midi."
                            },
                            {
                                "example_id": "87db4953-66be-40fa-b037-bb03cefb20f5",
                                "sense_id": "969fdade-62e9-35e3-843f-10b2cb0b56e3",
                                "text": "Elle avait à peine goûté à ses tortellinis mais elle avait déjà bu deux verres de vin blanc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
