                                    },
                                    {
                                        "sense_id": "c2369060-1ebf-3bfa-be2a-f74a81fe23e8",
                                        "entry_id": "b631d725-2438-3ad6-b4dc-43ee67cc2798",
                                        "glosses": [
                                            "Véhicule, souvent blindé, destiné au transport de troupes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9fc16e1-ad66-35f0-9f0f-72b1f0dece12",
                                        "entry_id": "b631d725-2438-3ad6-b4dc-43ee67cc2798",
                                        "glosses": [
                                            "Aéronef destiné au transport de troupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e713b73-ceda-467c-bc76-c818b7f70a78",
                                                "sense_id": "c9fc16e1-ad66-35f0-9f0f-72b1f0dece12",
                                                "text": "Quel autre pays que les États-Unis aurait envoyé ses soldats au casse-pipe [au Viêt Nam] dans des avions de ligne aussi luxueux que ceux de Braniff Airlines ? C’était une idée bizarre et, en définitive, plutôt cruelle. Je crois que j’aurais préféré faire le voyage à bord d’un transport de troupes, car ces engins avaient au moins le mérite d’offrir une transition moins brutale de la paix à la guerre, et de vous habituer d’emblée à une condition misérable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
