                                "example_id": "5c9b3240-de6c-475f-82a0-3c9b138ef282",
                                "sense_id": "da719f2b-bc22-3e8b-a379-0e217bb38182",
                                "text": "Although FW- and SW-acclimated milkfish have different levels of tolerance for hypothermal stress, to date, the molecular physiological basis of this difference has not been elucidated."
                            }
