                        "examples": [
                            {
                                "example_id": "68007d50-756f-42ff-97ad-b7b3b5b6192b",
                                "sense_id": "bf612860-f2a9-35be-99ff-4c1c1eec1bd9",
                                "text": "„Nach diesen Worten befahl die Alte eiligst einer Magd, den Türvorhang zu lüften.“"
                            },
                            {
                                "example_id": "3253549a-a95f-4f0a-8d18-a79862f6f20a",
                                "sense_id": "bf612860-f2a9-35be-99ff-4c1c1eec1bd9",
                                "text": "„Mein Männlein huschelte durch die Perlenschnüre des Türvorhangs.“"
                            },
                            {
                                "example_id": "d1ed1492-e37c-4611-9b7a-3eddccf5c42a",
                                "sense_id": "bf612860-f2a9-35be-99ff-4c1c1eec1bd9",
                                "text": "„Ein Geräusch am Türvorhang läßt ihn aufsehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
