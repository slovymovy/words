                "senses": [
                    {
                        "sense_id": "226b9659-10dd-3f64-88a7-5a8b7b2105c5",
                        "entry_id": "1848333a-be99-321c-a53a-dee3599fd1e2",
                        "glosses": [
                            "Professorat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "000172ce-2477-43ec-acea-f7116bc1c4f8",
                                "sense_id": "226b9659-10dd-3f64-88a7-5a8b7b2105c5",
                                "text": "Als er 1919 eine Professur an der Hochschule für bildende Künste in Weimar übernahm, gründete er die modernste und umstrittenste Kunstschule der damaligen Zeit: „Das Staatliche Bauhaus in Weimar“."
                            }
                        ]
                    }
