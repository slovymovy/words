{
    "word_family": [
        "dash",
        "dashing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "517e1400-234d-3fd4-8439-c5722ce330c8",
                    "sense_definition": "Made up of short lines with small gaps between each one and the next.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The map shows the hiking trail as a <w>dashed</w> line through the forest.",
                            "target_lang_translations": {
                                "ru": "На карте пешеходная тропа через лес обозначена <w>пунктирной</w> линией."
                            }
                        },
                        {
                            "text": "Please sign your name on the <w>dashed</w> line at the bottom of the page.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подпишитесь на <w>пунктирной</w> линии внизу страницы."
                            }
                        }
                    ],
                    "synonyms": [
                        "broken"
                    ],
                    "common_phrases": [
                        "dashed line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из коротких черточек с небольшими промежутками между ними."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пунктирный",
                                "target_lang_sense_clarification": "о линии, состоящей из штрихов"
                            },
                            {
                                "target_lang_word": "штриховой",
                                "target_lang_sense_clarification": "технический термин для обозначения прерывистой линии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9bef765-96f0-36f4-be44-0f8c433cd826",
                    "sense_definition": "Used as a mild expression of annoyance or emphasis, similar to damned.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>dashed</w> shame that the concert was cancelled at the last minute.",
                            "target_lang_translations": {
                                "ru": "Это просто <w>чертовски</w> обидно, что концерт отменили в последнюю минуту."
                            }
                        },
                        {
                            "text": "I will be <w>dashed</w> if I let him treat me like that again.",
                            "target_lang_translations": {
                                "ru": "Будь я <w>проклят</w>, если позволю ему снова так со мной обращаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "darned"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Commonly used in older British English as a euphemism."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как мягкое выражение досады или для усиления высказывания, аналог слова «чертов»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертов",
                                "target_lang_sense_clarification": "разговорное выражение досады"
                            },
                            {
                                "target_lang_word": "проклятый",
                                "target_lang_sense_clarification": "выражение сильного раздражения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "399e966d-cb84-3a91-8567-c79dedfd7e1a",
                    "sense_definition": "Past participle of <w>dash</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has <w>dashed</w> across the street to catch the bus.",
                            "target_lang_translations": {
                                "ru": "Он <w>бросился</w> через дорогу, чтобы успеть на автобус."
                            }
                        },
                        {
                            "text": "All our hopes were <w>dashed</w> when the team lost the final game.",
                            "target_lang_translations": {
                                "ru": "Все наши надежды были <w>разрушены</w>, когда команда проиграла финальную игру."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb dash."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола dash (бросаться, мчаться, разрушать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросившийся",
                                "target_lang_sense_clarification": "в значении быстрого движения"
                            },
                            {
                                "target_lang_word": "разрушенный",
                                "target_lang_sense_clarification": "в значении крушения надежд или планов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}