                                        "sense_id": "32a766e3-150d-324a-b5c3-92183d5b7704",
                                        "entry_id": "7de8f9f4-8c07-38dc-b9f1-9dd45709c757",
                                        "glosses": [
                                            "To cause to fall by shooting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45183700-7fc3-4489-afec-e74a44c6ac07",
                                                "sense_id": "32a766e3-150d-324a-b5c3-92183d5b7704",
                                                "text": "The carnival game involved shooting down tin cans."
                                            },
                                            {
                                                "example_id": "d3670152-a332-4dc6-bd73-ff7aa92c3d0c",
                                                "sense_id": "32a766e3-150d-324a-b5c3-92183d5b7704",
                                                "text": "My grandfather shot down several fighter planes in the war."
                                            },
                                            {
                                                "example_id": "3aa13695-6917-4bf6-b201-aebe5933d87c",
                                                "sense_id": "32a766e3-150d-324a-b5c3-92183d5b7704",
                                                "text": "Stop using your words as weapons / They're never gonna shoot me down / Stop, it's time that you learned a lesson / My love is gonna drown you out"
                                            },
                                            {
                                                "example_id": "adc64f10-c817-4130-86bc-38e5396e6dfd",
                                                "sense_id": "32a766e3-150d-324a-b5c3-92183d5b7704",
                                                "text": "In China, authorities said they might soon shoot down an unidentified flying object over waters near the northern city of Rizhao, The South China Morning Post reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff760045-4b35-31e4-bac6-bbd35654d15a",
                                        "entry_id": "7de8f9f4-8c07-38dc-b9f1-9dd45709c757",
                                        "glosses": [
                                            "To criticize (a request) to the point of preclusion."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be5fd502-6d0f-407d-bef3-b3322dd7ae15",
                                                "sense_id": "ff760045-4b35-31e4-bac6-bbd35654d15a",
                                                "text": "Every proposal I made was shot down at once."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
