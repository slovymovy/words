                "senses": [
                    {
                        "sense_id": "14028620-6820-3d67-822e-264e662f0619",
                        "entry_id": "fc71c230-92e7-300a-a834-ac0492c11f59",
                        "glosses": [
                            "Suche nach Lösungen zu gesellschaftlichen/wissenschaftlichen/technischen Problemstellungen aufgrund von möglichen Gefahren im Alltag oder bevorstehenden Ereignissen und Erarbeitung entsprechender Kompensationsmöglichkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54854f6f-fd94-4532-9fbc-2d0feaf57c00",
                                "sense_id": "14028620-6820-3d67-822e-264e662f0619",
                                "text": "„Der Kampfmittelbeseitigung ist die Gefahrenerforschung vorgelagert. Zur Gefahrenforschung zählen die Arbeitsschritte, die erforderlich sind, um eine Bewertung der Fläche an die örtliche Ordnungsbehörde geben zu können. Die Gefahrenforschung endet mit der Feststellung, ob ein staatliches Handlungserfordernis vorliegt.“"
                            },
                            {
                                "example_id": "bdcbd054-f2c1-40bb-9d26-3d180d4acf07",
                                "sense_id": "14028620-6820-3d67-822e-264e662f0619",
                                "text": "„Aus den Erläuterungen geht auch nicht hervor, weshalb hier auf weltanschaulich oder religiös motivierte Gewalt eingegrenzt wird und bei anderer Motivlage keine erweiterte Gefahrenforschung ermöglicht werden soll.“"
                            },
                            {
                                "example_id": "2a99c590-7c5a-494d-93e1-2a065b1d1396",
                                "sense_id": "14028620-6820-3d67-822e-264e662f0619",
                                "text": "„SPÖ-Abgeordneter Maier erklärt, er habe persönlich mit der Regelung zur Gefahrenforschung kein Problem mehr.“"
                            },
                            {
                                "example_id": "f0eec202-bd8e-466b-8f49-ffb6313582fa",
                                "sense_id": "14028620-6820-3d67-822e-264e662f0619",
                                "text": "„Mit einer Novelle zum Sicherheitspolizeigesetz wird die erweiterte Gefahrenforschung ausgedehnt.“"
                            },
                            {
                                "example_id": "8dd84b9a-8ac2-424b-a8e0-6b2128180558",
                                "sense_id": "14028620-6820-3d67-822e-264e662f0619",
                                "text": "„Erweiterte Gefahrenforschung soll auch bereits dann möglich sein, wenn eine Person sich Mittel und Kenntnisse verschafft, mit denen sie grundsätzlich in der Lage wäre, schwere Sachbeschädigung oder die Gefährdung von Menschen herbeizuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
