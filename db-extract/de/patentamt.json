                "senses": [
                    {
                        "sense_id": "bc14f4c1-c165-35b8-a7fd-c1d402670483",
                        "entry_id": "862513bf-6e32-393c-8cbb-e79590d4fc9d",
                        "glosses": [
                            "Behörde, die einer natürlichen oder juristischen Person ein Schutzrecht auf geistiges Eigentum bzw. auf einen Markennamen in Form eines Patents gewährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6ce1569-9cad-4171-84da-29b2e54738fe",
                                "sense_id": "bc14f4c1-c165-35b8-a7fd-c1d402670483",
                                "text": "Beim Patentamt können neue Erfindungen angemeldet werden."
                            },
                            {
                                "example_id": "ae1d6080-5f45-4935-9176-3f9cc55553c1",
                                "sense_id": "bc14f4c1-c165-35b8-a7fd-c1d402670483",
                                "text": "„Dessen chemische Zusammensetzung ließ er am 31. Mai 1960 beim Pariser Patentamt mit der Nummer 63471 als Erfindung eintragen und schützen.“"
                            },
                            {
                                "example_id": "6585c523-76d9-40a8-80cc-c10667935b37",
                                "sense_id": "bc14f4c1-c165-35b8-a7fd-c1d402670483",
                                "text": "„Allein im Patentamt Berlin verfilmten die Amerikaner über eine Million Seiten, bei den IG-Farben 311000 Seiten.“"
                            },
                            {
                                "example_id": "a9ba57b5-341d-43de-82ee-809b027f3a04",
                                "sense_id": "bc14f4c1-c165-35b8-a7fd-c1d402670483",
                                "text": "„Einstein konnte nun seine Kündigung am Patentamt in Bern einreichen, dem er mehr als sieben Jahre lang angehört hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
