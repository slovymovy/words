                    {
                        "sense_id": "47014925-bdf0-3caf-8291-5a52ae75b6c7",
                        "entry_id": "37717674-e275-3168-9728-4d9ff8a57495",
                        "glosses": [
                            "Maison construite en rondins de bois brut, ajustés les uns sur les autres de façon à constituer un mur étanche et solide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d77f6688-5972-4805-8ef3-ced6a6837a7c",
                                "sense_id": "47014925-bdf0-3caf-8291-5a52ae75b6c7",
                                "text": "Comme presque chaque année, l’association de La Fuste Enchantée organise une fête au jardin de la Fuste, dimanche 1ᵉʳ septembre à Vassy (Calvados). L’occasion de découvrir un coin de végétation unique et de se prêter à des activités créatives et artistiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be6793be-8033-4efb-89eb-a3ebb4205616",
                        "source_entry_id": "37717674-e275-3168-9728-4d9ff8a57495",
                        "source_sense_id": "47014925-bdf0-3caf-8291-5a52ae75b6c7",
                        "target_lang_word": "Blockbau",
