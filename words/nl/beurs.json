                    "common_phrases": [
                        "beurs fruit",
                        "een beurse appel",
                        "beurse plekken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставший мягким и коричневым от старости или повреждений (о фруктах).",
                        "en": "Become soft and brown due to age or damage, specifically said of fruit."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побитый",
                                "target_lang_sense_clarification": "с повреждениями"
                            },
                            {
                                "target_lang_word": "мятый",
                                "target_lang_sense_clarification": "мягкий от ударов"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "bruised",
                                "target_lang_sense_clarification": "damaged fruit"
                            },
                            {
                                "target_lang_word": "over-ripe",
                                "target_lang_sense_clarification": "too soft"
                            }
                        ]
                    }
                }
            ]
