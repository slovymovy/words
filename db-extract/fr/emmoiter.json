                "senses": [
                    {
                        "sense_id": "e618d6cd-e511-366c-9a9d-6185b94f5969",
                        "entry_id": "462c5586-aca0-3f67-a6cf-df9f6528b08c",
                        "glosses": [
                            "Rendre moite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2214776-c629-43de-ad79-4472ab9ca738",
                                "sense_id": "e618d6cd-e511-366c-9a9d-6185b94f5969",
                                "text": "Leur haleine tombe dans son cou, comme pour l’emmoiter sous le fétide."
                            },
                            {
                                "example_id": "8cf4bf5e-a2b4-4657-9353-68ae1651cd8b",
                                "sense_id": "e618d6cd-e511-366c-9a9d-6185b94f5969",
                                "text": "De temps en temps, Augustine venait nous ramener sur terre, bavarder, s’emmoiter de douceurs."
                            },
                            {
                                "example_id": "2e01d685-aa64-42e5-809d-e8a6bf7b21b5",
                                "sense_id": "e618d6cd-e511-366c-9a9d-6185b94f5969",
                                "text": "La manie qu'a ton mec de se coller à toi alors que tu as besoin d'air, que tu peux plus respirer, et qu'un corps moite ça va hein, pas besoin d'en avoir un deuxième qui gigote pour t'emmoiter encore plus !"
                            }
                        ]
                    }
