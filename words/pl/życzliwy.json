                    "semantic_group_id": "cecha_charakteru",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W nowej pracy szybko znalazł <w>życzliwych</w>, na których zawsze mógł liczyć w trudnych chwilach.",
                            "target_lang_translations": {
                                "ru": "На новой работе он быстро нашёл <w>доброжелателей</w>, на которых всегда мог положиться в трудные минуты."
                            }
