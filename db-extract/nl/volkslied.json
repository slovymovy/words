                                        "entry_id": "4a956804-68af-3906-adf5-dcea4b20a6fc",
                                        "glosses": [
                                            "The official song of a nation or sovereign state, generally of a patriotic nature and played at events to celebrate or honor said state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf49f17-d733-43b9-8ae0-e1b068f545ff",
                                                "sense_id": "1a2c62dd-c647-3410-9c3a-bdc5203b5b44",
                                                "text": "With such focus from within the footballing community this week on Remembrance Sunday, there was something appropriate about Colchester being the venue for last night’s game. Troops from the garrison town formed a guard of honour for both sets of players, who emerged for the national anthem with poppies proudly stitched into their tracksuit jackets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af37d36d-f316-3267-b1e6-bdf3828c45ac",
                                        "entry_id": "4a956804-68af-3906-adf5-dcea4b20a6fc",
                                        "glosses": [
                                            "The official song of a constituent state of a country."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9439ebb1-77b5-40c3-953a-9c994ce044ad",
                                                "sense_id": "af37d36d-f316-3267-b1e6-bdf3828c45ac",
                                                "text": "The national anthem of Wales"
                                            },
                                            {
                                                "example_id": "6722f3ec-6fe9-4594-9d02-0012f217cf3b",
                                                "sense_id": "af37d36d-f316-3267-b1e6-bdf3828c45ac",
                                                "text": "The national anthem of the Russian SFSR"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
