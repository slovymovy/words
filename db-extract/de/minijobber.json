                "senses": [
                    {
                        "sense_id": "dba0e74a-a544-3789-b5de-b09d45b4998e",
                        "entry_id": "f498fab4-ab36-32da-8ece-ed13f182c684",
                        "glosses": [
                            "jemand, der einen Minijob hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbaf3f0d-ca61-4cd1-b01e-92e0fa7314e4",
                                "sense_id": "dba0e74a-a544-3789-b5de-b09d45b4998e",
                                "text": "„[..] Schon zuvor hatte er für Rentner, Minijobber oder Saisonarbeiter Sonderregelungen verlangt.“"
                            },
                            {
                                "example_id": "80def9e0-875b-49e2-91ee-aa348613f0d1",
                                "sense_id": "dba0e74a-a544-3789-b5de-b09d45b4998e",
                                "text": "„Der Wirtschaftspolitiker fordert darüber hinaus, dass Minijobber, Erntehelfer und Praktikanten vom Mindestlohn ausgenommen werden.“"
                            },
                            {
                                "example_id": "4a2f9aba-27b8-4e6c-abcf-472fc58a4fc1",
                                "sense_id": "dba0e74a-a544-3789-b5de-b09d45b4998e",
                                "text": "„[..] Auch weil er mit dem Gehalt nur knapp über die Runden kommt – er ist in der Schule als Minijobber angestellt.“"
                            },
                            {
                                "example_id": "bdd9f940-bf81-48f0-9178-eff10129461c",
                                "sense_id": "dba0e74a-a544-3789-b5de-b09d45b4998e",
                                "text": "„Die Gewerkschaften kritisieren vor allem, dass die Unternehmen verschiedene Ausnahmeregelungen verlangen, unter anderem für Ehrenamtliche oder Minijobber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
