                    {
                        "sense_id": "7f209e99-b188-35e0-b232-2587974d3665",
                        "entry_id": "55d3d034-ac5e-3b82-88cc-4df6eda00036",
                        "glosses": [
                            "One who has right of possession of goods but not right of property; the registered owner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99294c38-fb8f-4b2d-926f-17b54c2e4283",
                                "sense_id": "7f209e99-b188-35e0-b232-2587974d3665",
                                "text": "1910, Georgia Supreme Court, Georgia Court of Appeals, West Publishing Company, North Carolina Supreme Court, South Carolina Supreme Court, West Virginia Supreme Court of Appeals, The Southeastern Reporter, Volume 65, page 443,\nThe warrant failed to allege that the cotton was sold “without the written consent of the lienee.”"
                            },
                            {
                                "example_id": "adde4d9c-4d13-4e96-95b8-223d316b78a0",
                                "sense_id": "7f209e99-b188-35e0-b232-2587974d3665",
                                "text": "But the position is that lienees are still protected and will be under this Bill which will not apply until the harvest of 1941."
                            },
                            {
                                "example_id": "30ce80cc-e48d-4e28-90be-ebc7dfadeb03",
                                "sense_id": "7f209e99-b188-35e0-b232-2587974d3665",
                                "text": "2004, Peter Gillies, Business Law, 12th Edition, The Federation Press, Australia, page 722,\nThe lienee has no right of sale in relation to the goods (in the absence of a provision in an express contractual lien conferring a power of sale)."
                            },
                            {
                                "example_id": "e76d0c36-c69b-463d-b71b-533f10738270",
                                "sense_id": "7f209e99-b188-35e0-b232-2587974d3665",
                                "text": "The right can only be exercised where the lienee has:\n(i) given notice to the bailor of his intention to sell goods; or\n(ii) taken reasonable steps to trace or communicate with the bailor but failed."
                            }
                        ]
                    }
