                ],
                "senses": [
                    {
                        "sense_id": "a69c9117-859c-360e-b2a3-3fa0e859f750",
                        "entry_id": "001b9264-38c0-3108-86de-315fdfb2271d",
                        "glosses": [
                            "einen wütenden, beunruhigten oder verzweifelten Ausdruck in den Augen habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2969bf4-f2dc-4e88-bdf6-eec7864449dc",
                                "sense_id": "a69c9117-859c-360e-b2a3-3fa0e859f750",
                                "text": "Im Spiegel starrte mich ein wildäugiger Fremder an, der offensichtlich verrückt geworden war."
                            },
                            {
                                "example_id": "de51b962-d717-4c84-acaa-419974c0e85e",
                                "sense_id": "a69c9117-859c-360e-b2a3-3fa0e859f750",
                                "text": "„Den besten Platz mit Rückendeckung hat ein großer, hartgesichtiger und wildäugiger Rotkopf.“"
                            },
                            {
                                "example_id": "640c4844-1ef0-4f37-bef1-e9e6bb9710b2",
                                "sense_id": "a69c9117-859c-360e-b2a3-3fa0e859f750",
                                "text": "„Da waren insbesondere die Brüder Erdmann, zwei kecke, wildäugige Burschen, als die Stärksten und Mutigsten geliebt und gefürchtet, von denen er viel zu leiden hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
