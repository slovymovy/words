                    {
                        "sense_id": "02cd93cd-fd0d-3627-ad58-6679aa7faaf6",
                        "entry_id": "a3eccd90-8c1a-3d87-99d5-2078e7ebf6fe",
                        "glosses": [
                            "Magasins où l’on vend, non seulement des parfums, mais tout ce qui est nécessaire à la toilette (crèmes, savons, peignes, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80d3f26-0052-4233-98ea-a105f833fabf",
                                "sense_id": "02cd93cd-fd0d-3627-ad58-6679aa7faaf6",
                                "text": "Ma femme adore aller à la parfumerie."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ecc95b1-830c-34fa-95f3-a4b8083ba883",
                        "entry_id": "a3eccd90-8c1a-3d87-99d5-2078e7ebf6fe",
                        "glosses": [
                            "Produits vendus dans ces magasins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99bdfb4c-9003-4a9e-b44a-f77127385132",
                                "sense_id": "3ecc95b1-830c-34fa-95f3-a4b8083ba883",
                                "text": "Ce furent les Croisades qui firent pénétrer en France l'usage des parfums : on introduisait ceux-ci sous forme de peaux odoriférantes destinées à faire des pourpoints, des ceintures, des gants. Aussi s'explique-t-on que le commerce de la parfumerie ait d'abord été aux mains des gantiers."
                            },
                            {
                                "example_id": "1d10b253-1ee3-4bf7-9711-5f1d9d5ce706",
                                "sense_id": "3ecc95b1-830c-34fa-95f3-a4b8083ba883",
                                "text": "Acheter de la parfumerie."
                            }
                        ]
                    }
