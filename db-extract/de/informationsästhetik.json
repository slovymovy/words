                            {
                                "example_id": "294592be-aeb5-4a99-8787-062d57ffb37e",
                                "sense_id": "059b741b-2551-3ce5-9db9-8ac0ab50fad6",
                                "text": "„In unserer Sprechweise ist das Ästhetikmaß der Informationsästhetik nur eine Stilcharakteristik unter vielen anderen.“"
                            },
                            {
                                "example_id": "75d8e126-1ae2-4a34-9d83-0c2e85bbd7c6",
                                "sense_id": "059b741b-2551-3ce5-9db9-8ac0ab50fad6",
                                "text": "„Neben der Semiotischen und der Numerischen Ästhetik, der Zeichenästhetik und Informationsästhetik, hat sich neuerdings noch ein dritter Zweig moderner Ästhetik entwickelt, die sogenannte Generative Ästhetik.“"
                            }
