                    },
                    {
                        "translation_id": "387194d5-d1c3-45fd-ac5d-0535090ea098",
                        "source_entry_id": "82aca731-83ee-39ed-b132-47923cea80e3",
                        "source_sense_id": "24e15482-e6df-332e-be05-3686a8e5b689",
                        "source_sense_description": "catamite",
                        "target_lang_word": "Lustknabe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lustknabe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9d55897-8943-3b79-b257-217d41840ca6",
                                        "entry_id": "1d0d42b2-c3d3-3766-a3fb-ae0d2e7a9edf",
                                        "glosses": [
                                            "Jugendlicher, der eine sexuelle Beziehung mit einem (meist homosexuellen) Mann hat"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eb7ac81-8685-4258-828e-608384c8f252",
                                                "sense_id": "f9d55897-8943-3b79-b257-217d41840ca6",
                                                "text": "Am Hofe des Fürsten gab es eine Reihe von Lustknaben."
                                            },
                                            {
                                                "example_id": "34c543e9-7202-41c0-b9ed-7b17733c392d",
                                                "sense_id": "f9d55897-8943-3b79-b257-217d41840ca6",
                                                "text": "„Und ich durfte, nachdem klar war, dass ich als Lustknabe ausfiel, zuschauen, wie sie die Gerätschaften einsetzten.“"
                                            },
                                            {
                                                "example_id": "82454b46-af9b-4e6d-9e1f-9afa02fc1baa",
                                                "sense_id": "f9d55897-8943-3b79-b257-217d41840ca6",
                                                "text": "„Nun ja, man hat es hin und wieder mit einem Lustknaben getrieben, dabei hat man gegenseitig sein Vorderstück betrachtet, so einer war gewöhnlich viel jünger und mit einem entsprechend kleineren Vorderstück ausgestattet als ich, darum hielt ich meines für groß.“"
                                            },
                                            {
                                                "example_id": "4c770082-789e-4d3b-8fa0-3c16e6c12601",
                                                "sense_id": "f9d55897-8943-3b79-b257-217d41840ca6",
                                                "text": "„Man erzählte mir, er habe in seiner Jugend Frauen geliebt, begnüge sich aber jetzt im Alter damit, die Frau von drei oder vier hübschen Lustknaben zu werden, die er sich zu Diensten hielt und die abwechselnd die Ehre genossen, mit ihm zu schlafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
